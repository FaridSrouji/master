/07INDIAjp7-superJumbo.jpg', 'height': 1517, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/06/07/dining/07INDIAjp7/07INDIAjp7-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/06/07/dining/07INDIAjp7/07INDIAjp7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/06/07/dining/07INDIAjp7/07INDIAjp7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What to Cook Right Now', 'kicker': 'What to Cook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-04-25T14:30:00+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7fa69fe9-adee-5566-aaf7-0eb3af880bb8', 'word_count': 680, 'uri': 'nyt://article/7fa69fe9-adee-5566-aaf7-0eb3af880bb8'}, {'abstract': 'Democrats are getting behind an old idea to face new challenges of technological disruption in the work force.', 'web_url': 'https://www.nytimes.com/2018/04/25/opinion/sanders-booker-gillibrand-humphrey-hawkins.html', 'snippet': 'Democrats are getting behind an old idea to face new challenges of technological disruption in the work force.', 'lead_paragraph': 'Employment numbers may look solid now, but economists, physicists and industrial engineers all say that automation will, in the not-so-distant future, drive higher unemployment. The Columbus Dispatch recently calculated that in Ohio, out of total state employment of about 5.5 million workers, 2.5 million jobs are at risk of automation.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/25/opinion/25loomisWeb/merlin_137267703_852060a6-a4e6-4d6c-8b52-4eeffed37fce-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/25/opinion/25loomisWeb/merlin_137267703_852060a6-a4e6-4d6c-8b52-4eeffed37fce-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/25/opinion/25loomisWeb/merlin_137267703_852060a6-a4e6-4d6c-8b52-4eeffed37fce-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/25/opinion/25loomisWeb/merlin_137267703_852060a6-a4e6-4d6c-8b52-4eeffed37fce-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/25/opinion/25loomisWeb/25loomisWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/25/opinion/25loomisWeb/25loomisWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/25/opinion/25loomisWeb/25loomisWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', '