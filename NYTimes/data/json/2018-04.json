/04/opinion/04kristofSub/04kristofSub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/04/opinion/04kristofSub/04kristofSub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Nation Will Pay if Trump Fires Mueller', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'The U.S. Will Pay if Trump Fires Mueller', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Russian Interference in 2016 US Elections and Ties to Trump Associates', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Special Prosecutors (Independent Counsel)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics and Official Misconduct', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cohen, Michael D (1966- )', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Mueller, Robert S III', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-04-11T23:29:51+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e5961966-fb0b-50d6-bd43-b027ee66a810', 'word_count': 825, 'uri': 'nyt://article/e5961966-fb0b-50d6-bd43-b027ee66a810'}, {'abstract': 'How the departing House speaker handles President Trump will define his legacy. It’s not too late for him to step up.', 'web_url': 'https://www.nytimes.com/2018/04/11/opinion/paul-ryan-trump-retirement-courage.html', 'snippet': 'How the departing House speaker handles President Trump will define his legacy. It’s not too late for him to step up.', 'lead_paragraph': 'Well, Paul Ryan, you’re a free man now — at least, much freer than you were before you announced on Wednesday that you’d be stepping down as House speaker and departing Congress in January. What an opportunity you have to serve the country and to demonstrate, despite all the ground you’ve created for eye-rolling, that you care about something more than short-term partisan advantage.', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/12/opinion/12thu1/merlin_136718019_e1f5c17b-aedd-4324-8565-1286ce2fdc7f-articleLarge.jpg', 'height': 351, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/12/opinion/12thu1/merlin_136718019_e1f5c17b-aedd-4324-8565-1286ce2fdc7f-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 351}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/12/opinion/12thu1/merlin_136718019_e1f5c17b-aedd-4324-8565-1286ce2fdc7f-jumbo.jpg', 'height': 599, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/12/opinion/12thu1/merlin_136718019_e1f5c17b-aedd-4324-8565-1286ce2fdc7f-superJumbo.jpg', 'height': 1053, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/12/opinion/12thu1/12thu1-thumbStandard.jpg', 'height': 75,