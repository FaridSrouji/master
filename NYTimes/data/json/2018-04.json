': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/15/travel/15FRUGAL/merlin_136378587_a8ab96a2-c682-4335-9a6b-e0fc6c765c68-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/15/travel/15FRUGAL/merlin_136378587_a8ab96a2-c682-4335-9a6b-e0fc6c765c68-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/15/travel/15FRUGAL/merlin_136378587_a8ab96a2-c682-4335-9a6b-e0fc6c765c68-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/15/travel/15FRUGAL/merlin_136378587_a8ab96a2-c682-4335-9a6b-e0fc6c765c68-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/15/travel/15FRUGAL/15FRUGAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/15/travel/15FRUGAL/15FRUGAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/15/travel/15FRUGAL/15FRUGAL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Navigate the Complicated World of Credit Card Points', 'kicker': None, 'content_kicker': None, 'print_headline': 'Navigating the Complex World of Credit Card Points', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Credit Cards', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Customer Loyalty Programs', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-04-11T09:00:07+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Lucas Peterson', 'person': [{'firstname': 'Lucas', 'middlename': None, 'lastname': 'Peterson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/33ab60dd-a873-55e9-a0a0-b9870d8c00e9', 'word_count': 1342, 'uri': 'nyt://article/33ab60dd-a873-55e9-a0a0-b9870d8c00e9'}, {'abstract': 'The answer to the disparity in death rates has everything to do with the lived experience of being a black woman in America.', 'web_url': 'https://www.nytimes.com/2018/04/11/magazine/black-mothers-babies-death-maternal-mortality.html', 'snippet': 'The answer to the disparity in death rates has everything to do with the lived experience of being a black woman in America.', 'lead_paragraph': 'When Simone Landrum felt tired and both nauseated and ravenous at the same time in the spring of 2016, she recognized the signs of pregnancy. Her beloved grandmother died earlier that year, and Landrum felt a sense of divine order when her doctor confirmed on Muma’s birthday that she was carrying a girl. She decided she would name her daughter Harmony. “I pictured myself teaching my daughter to sing,” says Landrum, now 23, who lives in New Orleans. “It was something I thought we could do together.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/04/magazine/15mag-maternity-image9/15mag-maternity-image9-articleLarge.jpg', 'height': 746, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/04/magazine/15mag-maternity-image9/15mag-maternity-image9-articleLarge.jpg', 'xlar