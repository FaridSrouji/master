/2018/04/16/t-magazine/16tmag-carolina/16tmag-carolina-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'On Set | Carolina Herrera', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Herrera, Carolina', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Herrera, Carolina, Ltd', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-04-16T16:59:33+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/9833206c-de2e-57d6-a7f4-a69c5b32ed17', 'word_count': 0, 'uri': 'nyt://video/9833206c-de2e-57d6-a7f4-a69c5b32ed17'}, {'abstract': '‘Dancer From the Dance,’ ‘Angels in America’ — and the decade that brought queer literature to the fore.', 'web_url': 'https://www.nytimes.com/2018/04/16/t-magazine/gay-literature-1980s.html', 'snippet': '‘Dancer From the Dance,’ ‘Angels in America’ — and the decade that brought queer literature to the fore.', 'lead_paragraph': 'ANDREW HOLLERAN’S 1978 novel, “Dancer From the Dance,” was not the first gay novel I read. It was, however, the first gay novel everybody read.', 'print_section': 'M2', 'print_page': '58', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-THCP/03tmag-hicart-slide-THCP-articleLarge.jpg', 'height': 391, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-THCP/03tmag-hicart-slide-THCP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-THCP/03tmag-hicart-slide-THCP-jumbo.jpg', 'height': 668, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-THCP/03tmag-hicart-slide-THCP-superJumbo.jpg', 'height': 1336, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-THCP/03tmag-hicart-slide-THCP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-THCP/03tmag-hicart-slide-THCP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-THCP/03tmag-hicart-slide-THCP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How the Early ’80s Changed Gay Writing Forever', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gay Literature', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality and Bisexuality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kushner, Tony', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-04-16T17:00:41+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Michael Cunningham', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cunningham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6877dbfa-5860-5c4e-ba85-0df073346f60', 'word_count': 1111, 'uri': 'nyt://article/6877dbfa-5860-5c4e-ba85-0df073346f60'}, {'abstract': 'As socially minded public installations in New York City became popular in the 1980s, political movements realized their marketing potential.', 'web_url': 'https://www.nytimes.com/2018/04/16/t-magazine/1980s-protest-movements.html', 'snippet': 'As socially minded public installations in New York City became popular in the 1980s, political movements realized their marketing potential.', 'lead_paragraph': 'STARTING IN 1979, when I was 21, I was an out reporter writing for underground queer newspapers, in which I covered key acts of political warfare in New York City. This was the beginning of President Reagan’s terrifying and far-reaching unification with the Christian right. As a particularly despised group of people, queers were fighting police brutality on one front and racist admission policies in gay and lesbian bars on the other, homophobia at home and the closet at work. At the time, there was still no gay rights bill in the city, and sodomy was illegal in more than half of the states. Simultaneously, there were people who insisted on being out and who created rich subcultures that forged new ground in sex, night life, imagination — and rebellion.', 'print_section': 'M2', 'print_page': '41', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-N71E/03tmag-hicart-slide-N71E-articleLarge.jpg', 'height': 927, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-N71E/03tmag-hicart-slide-N71E-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 927}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-N71E/03tmag-hicart-slide-N71E-jumbo.jpg', 'height': 1024, 'width': 663, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-N71E/03tmag-hicart-slide-N71E-superJumbo.jpg', 'height': 1230, 'width': 796, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-N71E/03tmag-hicart-slide-N71E-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-N71E/03tmag-hicart-slide-N71E-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-N71E/03tmag-hicart-slide-N71E-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Protest Movements Became Brands', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Art of Protesting How It Changed…', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Acquired Immune Deficiency Syndrome', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Slogans and Mottoes', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-04-16T17:01:44+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Sarah Schulman', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Schulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45055871-4d76-50e4-87d0-bf51f9e9ce74', 'word_count': 740, 'uri': 'nyt://article/45055871-4d76-50e4-87d0-bf51f9e9ce74'}, {'abstract': 'The city first embraced global ingredients in the early ’80s, and the rest of the world followed suit.', 'web_url': 'https://www.nytimes.com/2018/04/16/t-magazine/food-1980s.html', 'snippet': 'The city first embraced global ingredients in the early ’80s, and the rest of the world followed suit.', 'lead_paragraph': 'KIWI WAS THE gateway drug. Native to southern China, where it was known as mihoutao, or monkey peach, the hairy fruit with the chlorophyll-rich, jade-green interior first started coming in bulk to the U.S. via New Zealand in the 1950s under the name “Chinese gooseberry.” It made little headway — perhaps due to Cold War-era fears of Communist China — before it was rechristened in honor of the equally fuzzy kiwi bird. But not until the early ’80s did it begin appearing with merciless persistence at restaurants across Manhattan, in tart after tart, fruit salads, compotes and even savory dishes, lending an algal tinge to beurre blanc. By 1983, it was stocked in every supermarket and featured in recipes on the back of cake-mix boxes. The New York Times declared it passé.', 'print_section': 'M2', 'print_page': '42', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-CYFJ/03tmag-hicart-slide-CYFJ-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-CYFJ/03tmag-hicart-slide-CYFJ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-CYFJ/03tmag-hicart-slide-CYFJ-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-CYFJ/03tmag-hicart-slide-CYFJ-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-CYFJ/03tmag-hicart-slide-CYFJ-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-CYFJ/03tmag-hicart-slide-CYFJ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/t-magazine/03tmag-hicart-slide-CYFJ/03tmag-hicart-slide-CYFJ-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How the Kiwi Changed New York’s Food Scene', 'kicker': None, 'content_kicker': None, 'print_headline': 'Food', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Eighties', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-04-16T17:02:26+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Ligaya Mishan', 'person': [{'firstname': 'Ligaya', 'middlename': None, 'lastname': 'Mishan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/332b44a9-2fe8-53fc-a401-2c2c1cc84ea2', 'word_count': 1297, 'uri': 'nyt://article/332b44a9-2fe8-53fc-a401-2c2c1cc84ea2'}, {'abstract': '“Wade in the Water” is the latest collection by Pulitzer Prize winner Tracy K. Smith, while the prolific and acclaimed Kevin Young returns with “Brown.”', 'web_url': 'https://www.nytimes.com/2018/04/16/books/review-wade-in-water-tracy-k-smith-brown-kevin-young.html', 'snippet': '“Wade in the Water” is the latest collection by Pulitzer Prize winner Tracy K. Smith, while the prolific and acclaimed Kevin Young returns with “Brown.”', 'lead_paragraph': 'When Robert Frost was poet laureate in the late 1950s, he saw himself as a political as well as a literary eminence. He expected his advice to be sought on pressing matters of state.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/17/books/17bookyoung-1/17bookyoung-1-articleLarge.jpg', 'height': 674, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/17/books/17bookyoung-1/17bookyoung-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 674}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/17/books/17bookyoung-1/17bookyoung-1-jumbo.jpg', 'height': 1024, 'width': 913, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/17/books/17bookyoung-1/17bookyoung-1-superJumbo.jpg', 'height': 2048, 'width': 1825, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', '