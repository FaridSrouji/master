ages/2018/04/08/sunday-review/08Dowd-Sub/08Dowd-Sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What’s Lust Got to Do With It?', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'What’s Lust Got to Do With It?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sex', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dating and Relationships', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Online Dating', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Pornography', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Coles, Joanna', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Roupenian, Kristen', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'Love Rules: How to Find a Real Relationship in a Digital World (Book)', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-04-07T18:30:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Maureen Dowd', 'person': [{'firstname': 'Maureen', 'middlename': None, 'lastname': 'Dowd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d5d41be6-e727-56f9-958b-ef8ac2da8602', 'word_count': 1074, 'uri': 'nyt://article/d5d41be6-e727-56f9-958b-ef8ac2da8602'}, {'abstract': 'What Kevin Williamson and his critics have in common.', 'web_url': 'https://www.nytimes.com/2018/04/07/opinion/sunday/among-the-abortion-extremists.html', 'snippet': 'What Kevin Williamson and his critics have in common.', 'lead_paragraph': 'A few weeks ago, The Washington Post’s deputy editorial page editor, Ruth Marcus, wrote two columns explaining why, had either of her children been diagnosed with Down syndrome in utero, she would have accepted the “ghastly” nature of a second-trimester abortion and terminated the pregnancy. She conceded that people with Down syndrome can be happy and fulfilled, that both they and their parents might be understandably disturbed by the way abortion can effectively cull them from the world. But she concluded with self-acknowledged bluntness: “That was not the child I wanted.”', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/08/sunday-review/08Douthat/08Douthat-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/08/sunday-review/08Douthat/08Douthat-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/08/sunday-review/08Douthat/08Douthat-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/08/sunday-review/08Douthat/08Douthat-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/08/sunday-review/08Douthat/08Douthat-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/08/sunday-review/08Douthat/08Douthat-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/08/sunday-review/08Douthat/08Douth