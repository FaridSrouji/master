137558652_a69df828-a39c-4978-b3f4-f4662e41f631-superJumbo.jpg', 'height': 960, 'width': 1138, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/obituaries/01leiber-women/01leiber-women-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/01/obituaries/01leiber-women/01leiber-women-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/obituaries/01leiber-women/01leiber-women-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gerson Leiber, 96, Dies; Artist Created Museum With Designer Wife', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gerson Leiber, 96, Artist Who Created Museum With His Wife', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Leiber, Gerson (1921- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Leiber, Judith', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Handbags and Purses', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-04-30T23:27:11+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Obituaries', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/03c8a93c-b22f-5056-a031-fe220b34310c', 'word_count': 880, 'uri': 'nyt://article/03c8a93c-b22f-5056-a031-fe220b34310c'}, {'abstract': 'The wireless companies are trying to win over regulators with a laundry list of assurances. The regulators should be wary.', 'web_url': 'https://www.nytimes.com/2018/04/30/opinion/tmobile-sprint-merger-implausible.html', 'snippet': 'The wireless companies are trying to win over regulators with a laundry list of assurances. The regulators should be wary.', 'lead_paragraph': 'T-Mobile and Sprint are making some big promises to sell their proposed $26.5 billion merger. They assert that the merger — which would reduce the number of national wireless companies from four to three — would give them the scale they need to build a high-capacity wireless network with 5G, or fifth-generation, technology. If the Federal Communications Commission and the Department of Justice approve the deal, T-Mobile and Sprint say, the company won’t raise prices and it will hire more people, rather than reduce the work force, which is more often the case in such mergers. And they say all this will be done while costs are cut by $6 billion a year and profits rise substantially.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/opinion/01tue1web/merlin_137534445_ae34291e-6ebd-42bb-a061-2c788bcf729a-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/01/opinion/01tue1web/merlin_137534445_ae34291e-6ebd-42bb-a061-2c788bcf729a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/opinion/01tue1web/merlin_137534445_ae34291e-6ebd-42bb-a061-2c788bcf729a-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 