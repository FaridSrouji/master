or': 'N'}, {'name': 'subject', 'value': 'United States Attorneys', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Crime', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Bureau of Investigation', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Winter Hill Gang', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Bulger, James J', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Dershowitz, Alan M', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Hannity, Sean', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Limbaugh, Rush', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 12, 'major': 'N'}], 'pub_date': '2018-04-18T22:31:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Nancy Gertner', 'person': [{'firstname': 'Nancy', 'middlename': None, 'lastname': 'Gertner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/f0efb3b8-76a2-5903-b220-ba9d30862684', 'word_count': 1213, 'uri': 'nyt://article/f0efb3b8-76a2-5903-b220-ba9d30862684'}, {'abstract': 'In a speech to the European Parliament, the French president said Europe was facing a “civil war” over democratic values.', 'web_url': 'https://www.nytimes.com/2018/04/18/opinion/macron-europe-democracy-theatened.html', 'snippet': 'In a speech to the European Parliament, the French president said Europe was facing a “civil war” over democratic values.', 'lead_paragraph': 'Not long ago, the things Emmanuel Macron said this week would not have needed saying. Yet, addressing the European Parliament, the French president — barely 40 and not yet a year in office — sounded almost like a biblical prophet, warning of the rising fascination with antidemocratic and “il