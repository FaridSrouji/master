rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/books/review/27africanart-1art/27africanart-1art-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/27/books/review/27africanart-1art/27africanart-1art-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/books/review/27africanart-1art/27africanart-1art-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/books/review/27africanart-1art/27africanart-1art-superJumbo.jpg', 'height': 1361, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/books/review/27africanart-1art/27africanart-1art-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/27/books/review/27africanart-1art/27africanart-1art-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/books/review/27africanart-1art/27africanart-1art-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Two Projects Helping Female Artists in Africa Find Their Voices', 'kicker': None, 'content_kicker': None, 'print_headline': 'Two Projects Help Female African Artists Find Their Voices', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Pioneer Works Center for Art and Innovation (Brooklyn, NY)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lutaaya, Benon', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Johannesburg (South Africa)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Red Hook (Brooklyn, NY)', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-04-26T22:14:03+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Todd Pitock', 'person': [{'firstname': 'Todd', 'middlename': None, 'lastname': 'Pitock', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24d2bdff-f6a3-5171-8e13-b5a2a99a6b2b', 'word_count': 1120, 'uri': 'nyt://article/24d2bdff-f6a3-5171-8e13-b5a2a99a6b2b'}, {'abstract': 'Young and artist-run spaces are the dynamic specialties of these two boroughs, which have the city’s most dynamic art scene.', 'web_url': 'https://www.nytimes.com/2018/04/26/arts/design/art-galleries-to-see-in-brooklyn-and-queens.html', 'snippet': 'Young and artist-run spaces are the dynamic specialties of these two boroughs, which have the city’s most dynamic art scene.', 'lead_paragraph': 'These noteworthy gallery shows outside Manhattan are heavily tilted toward the L train axis that runs through Brooklyn and Queens, from Williamsburg to Ridgewood, and toward the young and artist-run spaces that are those boroughs’ specialties. (For two galleries on the southern edge of Williamsburg, Soloway and Black Ball Projects, take the J train.) Luhring Augustine is not on this list because its show “Sculpture,” running through May 5, was recently reviewed, but it is definitely worth a visit. Altogether, this guide will give you an extensive foundation from which to experience the city’s most dynamic art scene.', 'print_sectio