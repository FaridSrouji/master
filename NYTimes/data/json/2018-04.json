nk': 10, 'major': 'N'}], 'pub_date': '2018-04-18T14:30:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Shikha Dalmia', 'person': [{'firstname': 'Shikha', 'middlename': None, 'lastname': 'Dalmia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7c6e3153-b6f1-5196-ab19-76473640ab0e', 'word_count': 983, 'uri': 'nyt://article/7c6e3153-b6f1-5196-ab19-76473640ab0e'}, {'abstract': 'A quick look at some of the latest collections from top bridal designers.', 'web_url': 'https://www.nytimes.com/2018/04/18/fashion/weddings/what-we-saw-at-new-york-bridal-fashion-week.html', 'snippet': 'A quick look at some of the latest collections from top bridal designers.', 'lead_paragraph': 'The biggest names in bridal fashion showcased their spring and summer 2019 collections during Bridal Fashion Week April 11-14 in New York. It was no surprise that many designers, like Theia and Reem Acra,  drew inspiration from this year’s royal wedding in Britain, with reimagined contemporary looks for the soon-to-be-duchess, Meghan Markle. Other designers like Ines Di Santo and Vera Wang presented gowns that were both bold and unabashedly feminine, laden with floral appliqués and colorful details. Here’s a look at what we saw at Bridal Fashion Week.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/17/fashion/17BRIDALFASHIONWEEK7/17BRIDALFASHIONWEEK7-articleLarge.jpg', 'height': 314, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/17/fashion/17BRIDALFASHIONWEEK7/17BRIDALFASHIONWEEK7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 314}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/17/fashion/17BRIDALFASHIO