ction_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Adam Goldman and Matthew Rosenberg', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Goldman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Matthew', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1c5c09a7-4d79-5acb-9b43-2e0b4f745af1', 'word_count': 1482, 'uri': 'nyt://article/1c5c09a7-4d79-5acb-9b43-2e0b4f745af1'}, {'abstract': 'Covering Hillary Clinton’s campaign from before it started to the very last moment.', 'web_url': 'https://www.nytimes.com/2018/04/20/sunday-review/hillary-clinton-chasing-hillary.html', 'snippet': 'Covering Hillary Clinton’s campaign from before it started to the very last moment.', 'lead_paragraph': 'Things were already looking bad when, several people told me, Chelsea Clinton popped the Champagne. It was just after 9 p.m. on election night and she was having her hair and makeup done in the family’s suite at the Peninsula hotel. She stopped to pour what someone said was Veuve Clicquot into everyone’s glasses, figuring that in a couple of hours Donald Trump’s run of early victories in red states (West Virginia, Oklahoma, Alabama) would end and the map would turn back in her mom’s favor.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22chozick3/22chozick3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/22/opinion/sunday/22chozick3/22chozick3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'ur