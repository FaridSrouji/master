name': 'organizations', 'value': 'Border Patrol (US)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Guard', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Rio Grande Valley (Tex)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 8, 'major': 'N'}], 'pub_date': '2018-04-11T18:57:45+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Manny Fernandez', 'person': [{'firstname': 'Manny', 'middlename': None, 'lastname': 'Fernandez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3f677dc-1cc0-54d7-8282-da0827aacdd6', 'word_count': 1671, 'uri': 'nyt://article/c3f677dc-1cc0-54d7-8282-da0827aacdd6'}, {'abstract': 'Omnibus data privacy laws are too vulnerable to Silicon Valley lobbyists. Congress should pass specific protections instead.', 'web_url': 'https://www.nytimes.com/2018/04/11/opinion/silicon-valley-lobbyists-privacy.html', 'snippet': 'Omnibus data privacy laws are too vulnerable to Silicon Valley lobbyists. Congress should pass specific protections instead.', 'lead_paragraph': 'Mark Zuckerberg promises that Facebook can do better to protect our privacy. Three times during his testimony before Congress on Tuesday, he used the same example: Face recognition technology, he explained, should require “special consent” from users. He left out a key fact: This week, lobbyists paid by Facebook are working with Illinois lawmakers backed by Facebook to gut the state’s face recognition privacy law, the strongest in the nation.', 'print_section': 'A', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/11/opinion/11bedoya/11bedoya-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/11/opinion/11bedoya/11bedoya-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/11/opinion/11bedoya/11bedoya-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/11/opinion/11bedoya/11bedoya-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/11/opinion/11bedoya/11bedoya-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/11/opinion/11bedoya/11bedoya-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/11/opinion/11bedoya/11bedoya-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Silicon Valley Lobbyists Love Big, Broad Privacy Bills', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Protect People,  Not Data', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Law and Legislation', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Lobbying and Lobbyists', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'nam