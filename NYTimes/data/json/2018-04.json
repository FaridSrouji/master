, 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/23/opinion/17Kaposy/17Kaposy-articleLarge.jpg', 'height': 420, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/23/opinion/17Kaposy/17Kaposy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 420}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/23/opinion/17Kaposy/17Kaposy-jumbo.jpg', 'height': 717, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/23/opinion/17Kaposy/17Kaposy-superJumbo.jpg', 'height': 1434, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/23/opinion/17Kaposy/17Kaposy-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/23/opinion/17Kaposy/17Kaposy-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/23/opinion/17Kaposy/17Kaposy-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Ethical Case for Having a Baby With Down Syndrome', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'We Chose Our Child', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Down Syndrome', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Per