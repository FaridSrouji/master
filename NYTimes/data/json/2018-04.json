it/13beinecke1-jumbo.jpg', 'height': 1024, 'width': 712, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/14/obituaries/14beinecke-obit/13beinecke1-superJumbo.jpg', 'height': 2048, 'width': 1423, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/14/obituaries/14beinecke-obit/13beinecke1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/14/obituaries/14beinecke-obit/13beinecke1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/14/obituaries/14beinecke-obit/13beinecke1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'William Beinecke, Patron of Central Park and Yale, Dies at 103', 'kicker': None, 'content_kicker': None, 'print_headline': 'William Beinecke, 103, Head Of Central Park Conservancy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Beinecke, William S', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Park Conservancy', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Central Park (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Yale University', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-04-13T17:35:19+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Obituaries', 'byline': {'original': 'By Ben Casselman', 'person': [{'firstname': 'Ben', 'middlename'