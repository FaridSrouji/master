thumbnailheight': 75}}], 'headline': {'main': 'California Today: When Skyscraper Was a Dirty Word', 'kicker': 'California Today', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-04-17T13:01:22+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/7732d591-558c-597e-97f1-d68a1730b17b', 'word_count': 953, 'uri': 'nyt://article/7732d591-558c-597e-97f1-d68a1730b17b'}, {'abstract': 'Kim Gordon, Larry Gagosian, Nile Rodgers and many others revisit their wild nights and disjointed days.', 'web_url': 'https://www.nytimes.com/2018/04/17/t-magazine/24-hours-new-york-city-1980s-life.html', 'snippet': 'Kim Gordon, Larry Gagosian, Nile Rodgers and many others revisit their wild nights and disjointed days.', 'lead_paragraph': 'A chance encounter with David Bowie at a downtown nightclub. Boozy, drug-fueled parties that lasted until dawn. A walk across the Williamsburg Bridge — just to save a subway token. Mornings spent alone, writing in a studio in the West Village. Afternoon workouts. Dinner on the Upper East Side with a former president of the United States. These are the moments, large and small, recounted by 36 writers, artists, fashion designers, musicians and more who lived in New York City in the early ’80s. Together, this chorus of voices — assembled, edited and condensed — creates a compelling mosaic, revealing a city bustling with creativity but also slowly emerging from its recent near-bankruptcy, with upscale restaurants just blocks away from rubble-filled, graffiti-painted lots. Whether you were struggling, successful or just plain lucky, these stories remind us that in these years New York City — dirty, dangerous, derelict, dazzling — was the only place to be.', 'print_section': 'M2', 'print_page': '68', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/05/t-magazine/05tmag-24hrs-slide-961X/05tmag-24hrs-slide-961X-articleLarge.jpg', 'height': 424, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/05/t-magazine/05tmag-24hrs-slide-961X/05tmag-24hrs-slide-961X-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 424}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/05/t-magazine/05tmag-24hrs-slide-961X/05tmag-24hrs-slide-961X-jumbo.jpg', 'height': 724, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/05/t-magazine/05tmag-24hrs-slide-961X/05tmag-24hrs-slide-961X-superJumbo.jpg', 'height': 1449, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/05/t-magazine/05tmag-24hrs-slide-961X/05tmag-24hrs-slide-961X-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/05/t-magazine/05tmag-24hrs-slide-961X/05tmag-24hrs-slide-961X-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/05/t-magazine/05tmag-24hrs-slide-961X/05tmag-24hrs-slide-961X-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What New York Was Like in the Early ’80s — Hour by Hour ', 'kicker': None, 'content_kicker': None, 'pri