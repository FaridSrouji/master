522_042eba0d-8ada-45c1-9619-89edf79a4975-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/28/sports/28a3_conversation/sub-mayfield-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/28/sports/28a3_conversation/sub-mayfield-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/28/sports/28a3_conversation/sub-mayfield-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '2018 N.F.L. Draft Analysis: How All 32 Picks Fit (or Don’t Fit)', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Draft and Recruitment (Sports)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-04-26T21:18:50+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Benjamin Hoffman', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Hoffman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63b3d5c9-2b94-56ff-a373-698c15fcd7f6', 'word_count': 6349, 'uri': 'nyt://article/63b3d5c9-2b94-56ff-a373-698c15fcd7f6'}, {'abstract': 'How strong is the temptation to tinker with a published piece? T asked artists including Bill T. Jones, Laurie Anderson and Ntozake Shange to reconsider their celebrated 1980s works.', 'web_url': 'https://www.nytimes.com/2018/04/26/t-magazine/larry-clark-laurie-anderson-bill-t-jones-80s-work.html', 'snippet': 'How strong is the temptation to tinker with a published piece? T asked artists including Bill T. Jones, Laurie Anderson and Ntozake Shange to reconsider their celebrated 1980s works.', 'lead_paragraph': 'When Vladimir Nabokov’s 1928 novel “King, Queen, Knave” made its English-language debut in the 1960s, it was ornamented with hundreds of what its author called “lighthearted and highhanded” alterations. Previously chaste characters masturbated furiously, plain-Jane sentences were buffed to a brilliant sheen and a nameless department-store mannequin was christened “Ronald” — after Ronald Hingley, a Russian scholar who had recently displeased Nabokov.  “From the way Ronald held his racket,” Nabokov wrote in the revised text, “it was obvious he could not hit a single ball — even an abstract ball in his world of wood.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/t-magazine/art/27tmag-doonesbury-01/27tmag-doonesbury-01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/27/t-magazine/art/27tmag-doonesbury-01/27tmag-doonesbury-01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/t-magazine/art/27tmag-doonesbury-01/27tmag-doonesbury-01-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/27/t-magazine/art/27tmag-doonesbury-01/27tmag-doonesbury-01-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnai