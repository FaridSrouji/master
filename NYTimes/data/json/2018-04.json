/arts/24WEIWEI/merlin_137093046_3ed40049-5e24-48f4-89b7-88837576745c-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/24/arts/24WEIWEI/merlin_137093046_3ed40049-5e24-48f4-89b7-88837576745c-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/24/arts/24WEIWEI/merlin_137093046_3ed40049-5e24-48f4-89b7-88837576745c-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/24/arts/24WEIWEI/merlin_137093046_3ed40049-5e24-48f4-89b7-88837576745c-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/24/arts/24WEIWEI/merlin_137093046_3ed40049-5e24-48f4-89b7-88837576745c-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/24/arts/24WEIWEI/merlin_137093046_3ed40049-5e24-48f4-89b7-88837576745c-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ai Weiwei’s Little Blue Book on the Refugee Crisis', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Little Blue Book With Big Thoughts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ai Weiwei', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Humanity (Book)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 4, 'major': 'N'}, {'name': 'subject