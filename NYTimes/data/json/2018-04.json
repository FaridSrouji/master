bb'}, {'abstract': 'She was beyond politics. She represented something far greater: the power and grace of a mother’s love.', 'web_url': 'https://www.nytimes.com/2018/04/20/opinion/barbara-bush-james-mcbride.html', 'snippet': 'She was beyond politics. She represented something far greater: the power and grace of a mother’s love.', 'lead_paragraph': 'I met former first lady Barbara Bush about two decades ago. She had read my first book, “The Color of Water.” The book describes how my late mother, Ruth McBride Jordan, a white Jewish woman who was twice widowed to black men, raised 12 black children and sent them all to college. It led to an invitation to do a reading for the Barbara Bush Literacy Foundation and later a visit at her Houston home.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/20/opinion/20McBride/20McBride-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/20/opinion/20McBride/20McBride-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/20/opinion/20McBride/20McBride-jumbo.jpg', 'height': 694, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/20/opinion/20McBride/20McBride-superJumbo.jpg', 'height': 1388, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/20/opinion/20McBride/20McBride-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/20/opinion/20McBride/20McBride-thumbStandard.jpg', 'thumbnai