op_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/25/dining/23PANTRY1/23PANTRY1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/25/dining/23PANTRY1/23PANTRY1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What to Cook Right Now', 'kicker': 'What to Cook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-04-16T14:30:01+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d2827c17-bd99-5930-8c92-e3edf971956c', 'word_count': 535, 'uri': 'nyt://article/d2827c17-bd99-5930-8c92-e3edf971956c'}, {'abstract': 'High school seniors and their parents are invited to tell us how to make the process less stressful.', 'web_url': 'https://www.nytimes.com/2018/04/16/opinion/college-admissions.html', 'snippet': 'High school seniors and their parents are invited to tell us how to make the process less stressful.', 'lead_paragraph': 'Many high school seniors have completed the often harrowing process of applying to college and have heard where they were accepted — or not. What worked and what didn’t? How could the process be made less stressful, fairer and easier?', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url':