title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/4279a7f4-5926-515a-b6cb-6ab38d9c595b', 'word_count': 1465, 'uri': 'nyt://article/4279a7f4-5926-515a-b6cb-6ab38d9c595b'}, {'abstract': 'Appearing happy is a cultural expectation. And I was tired of it.', 'web_url': 'https://www.nytimes.com/2018/04/21/opinion/sunday/an-american-woman-quits-smiling.html', 'snippet': 'Appearing happy is a cultural expectation. And I was tired of it.', 'lead_paragraph': 'I decided to stop smiling because I was tired. Tired of the “Can I get a smile?” and “Smile, it’s not that bad!” comments that are a too common part of city life. Tired of things like the “Smile! You look tired” demand from the T.S.A. agent who recently inspected my bag at the airport.', 'print_section': 'SR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22ko/22ko-articleLarge.jpg', 'height': 239, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/22/opinion/sunday/22ko/22ko-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 239}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22ko/22ko-jumbo.jpg', 'height': 407, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22ko/22ko-superJumbo.jpg', 'height': 815, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22ko/22ko-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/22/opinion/sunday/22ko/22ko-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22ko/22ko-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An American Woman Quits Smiling', 'kicker': None, 'content_kicker': None, 'print_headline': 'My Smiling Boycott', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gender', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-04-21T18:30:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Lisa Ko', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': 'Ko', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7ac085c4-347a-5d0c-b3ad-e25d938fffb9', 'word_count': 895, 'uri': 'nyt://article/7ac085c4-347a-5d0c-b3ad-e25d938fffb9'}, {'abstract': 'Medical professionals know how to de-escalate volatile situations.', 'web_url': 'https://www.nytimes.com/2018/04/21/opinion/sunday/hospitals-police-violence.html', 'snippet': 'Medical professionals know how to de-escalate volatile situations.', 'lead_paragraph': 'When a police officer in Cambridge, Mass., punched a black male Harvard student in the stomach multiple times while subduing him this month, the nation was reminded yet again of how quickly confrontations between the police and civilians can intensify beyond what the situation seems to call for. (The student was naked in public and apparently behaving erratically.)', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22starr/22starr-articleLarge.jpg', 'height': 630, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/22/opinion/sunday/22starr/22starr-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 630}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22starr/22starr-jumbo.jpg', 'height': 1024, 'width': 975, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22starr/22starr-superJumbo.jpg', 'height': 2048, 'width': 1950, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22starr/22starr-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/22/opinion/sunday/22starr/22starr-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22starr/22starr-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Hospitals Can Teach the Police', 'kicker': None, 'content_kicker': None, 'print_headline': 'What Hospitals Can Teach the Police', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hospitals', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-04-21T18:30:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Douglas Starr', 'person': [{'firstname': 'Douglas', 'middlename': None, 'lastname': 'Starr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6d9bb1f0-edbe-566f-a64c-2a29c97fb4d8', 'word_count': 1080, 'uri': 'nyt://article/6d9bb1f0-edbe-566f-a64c-2a29c97fb4d8'}, {'abstract': 'Over time, mass migration to cities could be a driver of environmental progress.', 'web_url': 'https://www.nytimes.com/2018/04/21/opinion/sunday/earth-day-read-this.html', 'snippet': 'Over time, mass migration to cities could be a driver of environmental progress.', 'lead_paragraph': 'Before the environmental activist and gay rights lawyer David Buckel set himself afire in Prospect Park in Brooklyn on April 14, he wrote a letter explaining that he had chosen his “early death by fossil fuel” as an act of protest against the environmental catastrophe that we are bringing upon ourselves and the planet. It was a horrifying end, not least because in life Mr. Buckel had successfully taken on issues as seemingly intractable as the legalization of same-sex marriage. If someone so capable had given up on the environment, one woman remarked to a Times reporter, “What does that mean for the rest of us?”', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22conniff/22conniff-articleLarge.jpg', 'height': 601, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/22/opinion/sunday/22conniff/22conniff-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 601}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22conniff/22conniff-jumbo.jpg', 'height': 1024, 'width': 1023, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22conniff/22conniff-superJumbo.jpg', 'height': 1983, 'width': 1981, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22conniff/22conniff-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/22/opinion/sunday/22conniff/22conniff-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/22/opinion/sunday/22conniff/22conniff-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Despairing on Earth Day? Read This', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Earth Day Despair?  Read This', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Conservation of Resources', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Urban Areas', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Wildlife Conservation Society', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Earth Day', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-04-21T18:30:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Richard Conniff', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Conniff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://a