r': 'Fiction', 'content_kicker': None, 'print_headline': 'Cervantes and Snow White Walk Into a Bar', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Coover, Robert', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Going for a Beer (Book)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-04-27T09:00:06+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Yu-Yun Hsieh', 'person': [{'firstname': 'Yu-yun', 'middlename': None, 'lastname': 'Hsieh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ac1ce796-de9e-507f-9eb3-90bcaed9664c', 'word_count': 833, 'uri': 'nyt://article/ac1ce796-de9e-507f-9eb3-90bcaed9664c'}, {'abstract': '“Each of my five kids and two sons-in-law was assigned a portion to copy edit. I offered $20 for each typo.”', 'web_url': 'https://www.nytimes.com/2018/04/27/books/review/james-comey-higher-loyalty-best-seller.html', 'snippet': '“Each of my five kids and two sons-in-law was assigned a portion to copy edit. I offered $20 for each typo.”', 'lead_paragraph': 'FAMILY MAN: Unless you’ve been living under a rock, it won’t surprise you to learn that James Comey’s memoir, “A Higher Loyalty: Truth, Lies, and Leadership,” debuts at No. 1 on the nonfiction list after selling more than 600,000 copies in its first week. The book, which was announced last August, took the former F.B.I. director about six months to complete: “It was a continuous process of writing and then getting feedback from my wife and kids, my agents and my editor, and then rewriting,” he explains. “The final step was a daylong family gathering, where each of my five kids and two sons-in-law was assigned a portion to copy-edit. I offered $20 for each typo and then met in my office individually with each of the seven to review and debate their suggested changes. They made me much better.”', 'print_section': 'BR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/books/review/06-BKS-LIST/06-BKS-LIST-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/06/books/review/06-BKS-LIST/06-BKS-LIST-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/books/review/06-BKS-LIST/06-BKS-LIST-jumbo.jpg', 'height': 620, 'width': 620, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/books/review/06-BKS-LIST/06-BKS-LIST-superJumbo.jpg', 'height': 620, 'width': 620, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/books/review/06-BKS-LIST/06-BKS-LIST-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/06/books/review/06-BKS-LIST/06-BKS-LIST-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/books/review/06-BKS-LIST/06-BKS-LIST-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How James Comey Found Mistakes in His Manuscript', 'kicker': 'Inside the List', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value':