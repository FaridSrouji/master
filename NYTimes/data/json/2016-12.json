None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b2389842-a9b3-530a-8f89-2f78824f0195', 'word_count': 900, 'uri': 'nyt://article/b2389842-a9b3-530a-8f89-2f78824f0195'}, {'abstract': 'These are not normal times. Gen. James Mattis will be a restraint on Donald Trump’s impulsiveness.', 'web_url': 'https://www.nytimes.com/2016/12/02/opinion/the-general-who-should-lead-the-pentagon.html', 'snippet': 'These are not normal times. Gen. James Mattis will be a restraint on Donald Trump’s impulsiveness.', 'lead_paragraph': 'Nominating a retired general to be secretary of defense is an unusual move in American politics. Since just after World War II, when the Department of Defense was created, only one general has held the post. That was George C. Marshall, who was more a supreme administrator in the Army than a combat leader. In World War I, Marshall was an excellent staff officer. In World War II he oversaw the American war effort.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The General Who Should Lead the Pentagon', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'A General to Lead the Pentagon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ricks, Thomas E', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Flynn, Michael T', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mattis, James N', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-12-03T03:00:49+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Thomas E. Ricks', 'person': [{'firstname': 'Thomas', 'middlename': 'E.', 'lastname': 'Ricks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d9d814c7-de96-5766-bb01-3b4140a6fd2a', 'word_count': 835, 'uri': 'nyt://article/d9d814c7-de96-5766-bb01-3b4140a6fd2a'}, {'abstract': 'Gen. James Mattis could serve as a voice of reason in the next administration.', 'web_url': 'https://www.nytimes.com/2016/12/02/opinion/an-experienced-leader-for-the-pentagon.html', 'snippet': 'Gen. James Mattis could serve as a voice of reason in the next administration.', 'lead_paragraph': 'Earlier this year, as many Americans found the leading presidential contenders unpalatable, some conservatives enthusiastically urged retired Gen. James Mattis, who has a cult following in military circles, to jump in as a dark horse. He shot down that idea in April, seeming perplexed. Now it appears likely that he’ll have a second act, as President-elect Trump’s secretary of defense.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/03/opinion/03sat1/03sat1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/03/opinion/03sat1/03sat1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/03/opinion/03sat1/03sat1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credi