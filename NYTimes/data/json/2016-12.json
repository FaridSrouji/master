nail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/22/us/22EXECUTION/22EXECUTION-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/22/us/22EXECUTION/22EXECUTION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/22/us/22EXECUTION/22EXECUTION-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/22/us/22EXECUTION/22EXECUTION-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/22/us/22EXECUTION/22EXECUTION-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/22/us/22EXECUTION/22EXECUTION-superJumbo.jpg', 'height': 1370, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Executions Hit 25-Year Low and Support Is Falling, Report Finds', 'kicker': None, 'content_kicker': None, 'print_headline': 'Executions Hit 25-Year Low as Support Falls, Report Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Capital Punishment', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Death Penalty Information Center', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-12-21T15:10:42+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Richard Pérez-Peña', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Pérez-Peña', 'qualifier': None, 'title': None, 'rol