ERS1/18ELDERS1-articleLarge-v3.jpg', 'height': 802, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/18/arts/18ELDERS1/18ELDERS1-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 802}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/arts/18ELDERS1/18ELDERS1-jumbo-v3.jpg', 'height': 1024, 'width': 766, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/arts/18ELDERS1/18ELDERS1-superJumbo-v3.jpg', 'height': 2048, 'width': 1532, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In Jazz, Listen to the Timeless Elders', 'kicker': None, 'content_kicker': None, 'print_headline': 'Master Linguists of an Aural Tradition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jazz', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Country Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Age, Chronological', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cyrille, Andrew', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Bley, Carla', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Elderly', 'rank': 11, 'major': 'N'}], 'pub_date': '2016-12-14T20:21:22+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_i