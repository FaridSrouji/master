ame': 'subject', 'value': 'Air Pollution', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-12-09T08:21:21+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7361dd6f-b0fa-5e4b-b8c8-fc77275da171', 'word_count': 794, 'uri': 'nyt://article/7361dd6f-b0fa-5e4b-b8c8-fc77275da171'}, {'abstract': 'States and cities are getting ready to protect immigrant families and workers from the incoming administration.', 'web_url': 'https://www.nytimes.com/2016/12/09/opinion/california-looks-to-lead-the-trump-resistance.html', 'snippet': 'States and cities are getting ready to protect immigrant families and workers from the incoming administration.', 'lead_paragraph': 'Nobody knows yet what Donald Trump is going to do to immigration enforcement. Only a month has passed since the election, and the president-elect is no different from the candidate: erratic, self-contradictory, hazy on principles and policies.', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/09/opinion/09fri1/09fri1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/09/opinion/09fri1/09fri1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/09/opinion/09fri1/09fri1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': '