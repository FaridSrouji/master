6SHORTSTAY/16SHORTSTAY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16SHORTSTAY/16SHORTSTAY-articleLarge.jpg', 'height': 325, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/16/arts/16SHORTSTAY/16SHORTSTAY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 325}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16SHORTSTAY/16SHORTSTAY-jumbo.jpg', 'height': 555, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16SHORTSTAY/16SHORTSTAY-superJumbo.jpg', 'height': 1109, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Review: A ‘Short Stay,’ but Long Stuck in a Rut', 'kicker': None, 'content_kicker': None, 'print_headline': 'He’s Stuck in a Rut, Where He Belongs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Short Stay (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fendt, Ted (1989- )', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-12-15T22:23:49+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3856dcc5-a7ff-5035-9f49-e130be909683', 'word_count': 350, 'uri': 'nyt://article/3856dcc5-a7ff-5035-9f49-e130be909683'}, {'abstract': 'The movie, starring Will Smith, riffs on “A Christmas Carol” as it tells a story of a man who experiences the loss of a child.', 'web_url': 'https://www.nytimes.com/2016/12/15/movies/collateral-beauty-review-will-smith.html', 'snippet': 'The movie, starring Will Smith, riffs on “A Christmas Carol” as it tells a story of a man who experiences the loss of a child.', 'lead_paragraph': 'The five stages of grief sometimes seem applicable to movie reviewing, except that I usually skip denial, rarely get around to acceptance and generally just settle into anger, which is where I am with “Collateral Beauty.” Many of the words that I would like to use to describe this waste of talent and time, which riffs on Dickens’s eternal “A Christmas Carol” and tries to manufacture feeling by offing Tiny Tim, can’t be lobbed in a family publication. So, instead, I will just start by throwing out some permissible insults: artificial, clichéd, mawkish, preposterous, incompetent, sexist, laughable, insulting.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16COLLATERAL1/16COLLATERAL1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/16/arts/16COLLATERAL1/16COLLATERAL1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16COLLATERAL1/16COLLATERAL1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16COLLATERAL1/16COLLATERAL1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/16/arts/16COLLATERAL1/16COLLATERAL1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16COLLATERAL1/16COLLATERAL1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/arts/16COLLATERAL1/16COLLATERAL1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Review: Lots of Plastic in the Face of ‘Collateral Beauty’', 'kicker': None, 'content_kicker': None, 'print_headline': 'No Zombies Here. It Just Seems So.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Collateral Beauty (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Will', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Frankel, David', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mirren, Helen', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-12-15T22:31:39+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5dba1f66-326d-54d3-a4f8-6d52ff7e0d34', 'word_count': 580, 'uri': 'nyt://article/5dba1f66-326d-54d3-a4f8-6d52ff7e0d34'}, {'abstract': 'A team of about six people will draw on the resources of ABC News to get to the bottom of questionable articles, said James Goldston, the president of ABC News.', 'web_url': 'https://www.nytimes.com/2016/12/15/technology/facebook-fact-checking-fake-news.html', 'snippet': 'A team of about six people will draw on the resources of ABC News to get to the bottom of questionable articles, said James Goldston, the president of ABC News.', 'lead_paragraph': 'To fight the spread of fake news, Facebook on Thursday said it was trying a series of tests to limit the false articles, including working with several news organizations like The Associated Press, PolitiFact and Snopes. Those groups have formed a coalition to fact-check some of the items flagged as fake news across the social network.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/business/16ABC/16ABC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/16/business/16ABC/16ABC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/business/16ABC/16ABC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/business/16ABC/16ABC-articleLarge.jpg', 'height': 507, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/16/business/16ABC/16ABC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 507}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/business/16ABC/16ABC-jumbo.jpg', 'height': 865, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/16/business/16ABC/16ABC-superJumbo.jpg', 'height': 1730, 'width': 2048, '