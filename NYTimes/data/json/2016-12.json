ub_date': '2016-12-21T16:45:55+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Jonah Engel Bromwich', 'person': [{'firstname': 'Jonah', 'middlename': 'Engel', 'lastname': 'Bromwich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/877d298a-4f9b-5c65-b329-f8f1e6cc2858', 'word_count': 1090, 'uri': 'nyt://article/877d298a-4f9b-5c65-b329-f8f1e6cc2858'}, {'abstract': 'A show at the Oakland Museum of California looks at the ubiquitous footwear through time.', 'web_url': 'https://www.nytimes.com/2016/12/21/arts/design/out-of-the-box-explores-the-rise-of-the-sneaker.html', 'snippet': 'A show at the Oakland Museum of California looks at the ubiquitous footwear through time.', 'lead_paragraph': 'The complex life of the world’s most ubiquitous footwear may flash before the eyes in “Out of the Box: The Rise of Sneaker Culture” at the Oakland Museum of California. Organized by the estimable Bata Shoe Museum of Toronto with the American Federation of Arts in New York, the exhibition promises nearly 150 examples of this indispensable item. Some date to the first half of the 19th century and the onset of pre-vulcanized rubber overshoes. From there, the show traces the sneaker’s ascent; its role in sports, hip-hop and men’s style; and its evolving technology and breakthroughs.', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/25/arts/25GUIDE5/25GUIDE5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/25/arts/25GUIDE5/25GUIDE5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/25/arts/25GUIDE5/25GUIDE5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/25/arts/25GUIDE5/25GUIDE5-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/25/arts/25GUIDE5/25GUIDE5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/25/arts/25GUIDE5/25GUIDE5-jumbo.jpg', 'height': 662, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/25/arts/25GUIDE5/25GUIDE5-superJumbo.jpg', 'height': 1323, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '‘Out of the Box’ Explores the Rise of the Sneaker', 'kicker': None, 'content_kicker': None, 'print_headline': 'Art; Is It the Shoes? Why Yes, It Is', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Oakland Museum of California', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sneakers', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Out of the Box: The Rise of Sneaker Culture (Exhibit)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-12-21T16:47:36+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], '