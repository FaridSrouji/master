an-notes/haldeman-notes-articleLarge.gif', 'xlargewidth': 600, 'xlargeheight': 985}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/30/opinion/sunday/haldeman-notes/haldeman-notes-jumbo.gif', 'height': 1024, 'width': 625, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/30/opinion/sunday/haldeman-notes/haldeman-notes-superJumbo.gif', 'height': 1641, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/30/opinion/sunday/haldeman-notes/haldeman-notes-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/30/opinion/sunday/haldeman-notes/haldeman-notes-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/30/opinion/sunday/haldeman-notes/haldeman-notes-thumbLarge.gif', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': "H.R. Haldeman's Notes from Oct. 22, 1968", 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-12-31T19:41:43+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/7b14ac1b-fd23-5b2e-bdd9-a238b8d88e89', 'word_count': 0, 'uri': 'nyt://interactive/7b14ac1b-fd23-5b2e-bdd9-a238b8d88e89'}, {'abstract': 'New evidence proves that Richard Nixon sabotaged peace talk plans in 1968, a move that may be worse than Watergate.', 'web_url': 'https://www.nytimes.com/2016/12/31/opinion/sunday/nixons-vietnam-treachery.html', 'snippet': 'New evidence proves that Richard Nixon sabotaged peace talk plans in 1968, a move that may be worse than Watergate.', 'lead_paragraph': 'Richard M. Nixon always denied it: to David Frost, to historians and to Lyndon B. Johnson, who had the strongest suspicions and the most cause for outrage at his successor’s rumored treachery. To them all, Nixon insisted that he had not sabotaged Johnson’s 1968 peace initiative to bring the war in Vietnam to an early conclusion. “My God. I would never do anything to encourage” South Vietnam “not to come to the table,” Nixon told Johnson, in a conversation captured on the White House taping system.', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/sunday-review/01Farrell/01Farrell-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/01/01/sunday-review/01Farrell/01Farrell-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/sunday-review/01Farrell/01Farrell-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/sunday-review/01Farrell/01Farrell-articleLarge.jpg', 'height': 768, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/01/01/sunday-review/01Farrell/01Farrell-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 768}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/su