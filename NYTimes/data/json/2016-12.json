ank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a38d57b6-153f-5d05-87ce-61edb1bcca3d', 'word_count': 429, 'uri': 'nyt://article/a38d57b6-153f-5d05-87ce-61edb1bcca3d'}, {'abstract': 'Make meat pie for the holidays, and rejoice.', 'web_url': 'https://www.nytimes.com/2016/12/07/magazine/a-french-canadian-christmas-carol.html', 'snippet': 'Make meat pie for the holidays, and rejoice.', 'lead_paragraph': 'There are a great many reasons to recommend the Christmas season in Francophone Canada and northern New England (let it snow, let it snow, let it snow!), but chief among them is tourtière. A tourtière is a pie, and one of the most delicious: a savory confection that can variously be packed with ground pork or a mixture of ground pork and game, encased in lardish dough. At highflier temples of Montreal gastronomy like Au Pied de Cochon (and at New York outposts, like M. Wells Steakhouse in Queens), you’ll find a great variety of meats in the tourtières, and occasionally slices of truffle or coins of foie gras. The classic accompaniment is a fruit ketchup or green-tomato relish, something piquant and bright against the rich, cinnamon-and-clove-scented taste of the meat, the vague porkiness of the dough.', 'print_section': 'MM', 'print_page': '44', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11eat1-copy/11mag-11eat-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/11/magazine/11eat1-copy/11mag-11eat-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11eat1-copy/11mag-11eat-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11eat1-copy/11mag-11eat-t_CA0-articleLarge.jpg', 'height': 480, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/11/magazine/11eat1-copy/11mag-11eat-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 480}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11eat1-copy/11mag-11eat-t_CA0-jumbo.jpg', 'height': 820, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11eat1-copy/11mag-11eat-t_CA0-superJumbo.jpg', 'height': 1640, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A French-Canadian Christmas Carol', 'kicker': 'Eat', 'content_kicker': None, 'print_headline': 'A French-Canadian Christmas Carol', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recipes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sifton, Sam', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Joe Beef (Montreal, Quebec, Restaurant)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Montreal (Quebec)', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-12-07T10:00:06+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0efe3e93-7837-505f-9aab-bee21df26cab', 'word_count': 495, 'uri': 'nyt://article/0efe3e93-7837-505f-9aab-bee21df26cab'}, {'abstract': 'Well, at least it’s not Skeletor.', 'web_url': 'https://www.nytimes.com/2016/12/07/magazine/judge-john-hodgman-on-naming-your-daughter-after-a-tv-character.html', 'snippet': 'Well, at least it’s not Skeletor.', 'lead_paragraph': 'Phil writes: My wife and I have agreed on a name for our future daughter, but we disagree on the spelling. She wants “Mira”; I want “Meera.” She prefers her spelling because she says it looks better. I prefer “Meera” as a tribute of sorts to George R.R. Martin and his character of the same name — and because the name cannot be mispronounced.', 'print_section': 'MM', 'print_page': '38', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11hodgman/11mag-11hodgman-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/11/magazine/11hodgman/11mag-11hodgman-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11hodgman/11mag-11hodgman-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11hodgman/11mag-11hodgman-t_CA0-articleLarge.jpg', 'height': 585, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/11/magazine/11hodgman/11mag-11hodgman-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 585}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/11/magazine/11hodgman/11mag-11hodgman-t_CA0-jumbo.jpg'