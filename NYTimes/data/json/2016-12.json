1188, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The 12.11.16 Issue', 'kicker': 'The Thread', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-12-22T12:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e1727c03-f169-5dee-86bb-d579243c5368', 'word_count': 781, 'uri': 'nyt://article/e1727c03-f169-5dee-86bb-d579243c5368'}, {'abstract': 'Across the spectrum of photo books published this year are pleasures to be discovered. Here are 10 of the best.', 'web_url': 'https://www.nytimes.com/2016/12/22/magazine/the-best-photo-books-of-2016.html', 'snippet': 'Across the spectrum of photo books published this year are pleasures to be discovered. Here are 10 of the best.', 'lead_paragraph': 'The term “photo book” is a bit of a catchall. Is a photo book a book consisting entirely or predominantly of photographs? Or is it a book that advances its argument largely by means of photographs? Do the photos have to have been taken with the intent of making art, or are other kinds of photographic documents permissible? If you want to make a fair-minded assessment, you have to consider small, self-published items as well as large, scholarly catalogs produced by mighty institutions. The good news is that all across this spectrum, there are pleasures to be discovered. For more than a month now, I’ve been sifting through the enormous pile of photo books that I’ve bought or received this year. Here are 10, in no particular order, that I found outstanding.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/21/magazine/21mag-photobooks-0/21mag-photobooks-0-articleLarge.jpg', 'height': 318, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/21/magazine/21mag-photobooks-0/21mag-photobooks-0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 318}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/21/magazine/21mag-photobooks-0/21mag-photobooks-0-jumbo.jpg', 'height': 542, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/21/magazine/21mag-photobooks-0/21mag-photobooks-0-superJumbo.jpg', 'height': 1084, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/21/magazine/21mag-photobooks-0/21mag-photobooks-0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/21/magazine/21mag-photobooks-0/21mag-photobooks-0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/21/magazine/21mag-photobooks-0/21mag-photobooks-0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Best Photo Books of 2016', 'kicker': 'Notebook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-12-22T12:00:54+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Teju Cole', 'person': [{'firstname': 'Teju', 'middlename': None, 'lastname': 'Cole', 'qualifier': None, 'title': None, 'role':