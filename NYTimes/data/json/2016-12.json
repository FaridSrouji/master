ddlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/964ebc7d-cdb6-5431-8357-c4d10f14cae2', 'word_count': 810, 'uri': 'nyt://article/964ebc7d-cdb6-5431-8357-c4d10f14cae2'}, {'abstract': 'Josh Haner, a staff photographer and senior editor for photo technology at The New York Times, discusses new ways to visualize climate change.', 'web_url': 'https://lens.blogs.nytimes.com/2016/12/28/photographing-climate-change-refugees-drone-foot-josh-haner/', 'snippet': 'Josh Haner, a staff photographer and senior editor for photo technology at The New York Times, discusses new ways to visualize climate change.', 'lead_paragraph': 'Josh Haner has photographed eight stories across five countries this year about the effects of climate change, often employing drones to get unique vantage points. Mr. Haner is a staff photographer and a senior editor for photo technology at The New York Times. He talked with James Estrin about finding new ways to visualize climate change. The conversation has been edited for clarity and brevity.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photographing Climate Change Refugees, by Drone and on Foot', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Haner, Josh', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'ALASKA', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Bolivia', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-12-28T09:00:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aadd67e0-d5dd-5b90-8356-5e3065e9fb26', 'word_count': 1823, 'uri': 'nyt://article/aadd67e0-d5dd-5b90-8356-5e3065e9fb26'}, {'abstract': 'Time to avoid cheese, avoid sugar, trick your brain into making you feel less hungry, and learn to love yourself instead of dieting.', 'web_url': 'https://www.nytimes.com/2016/12/28/books/review/new-books-about-food-and-diets.html', 'snippet': 'Time to avoid cheese, avoid sugar, trick your brain into making you feel less hungry, and learn to love yourself instead of dieting.', 'lead_paragraph': 'I’ve never understood why January is diet season. Don’t people realize they still have many months during which they can layer their layers? Every diet book should come out on May 1. That’s when you realize you have less than two months before someone, somewhere, is going to force you to go to the beach. But O.K., fine, “new year, new you” and all that. Let’s get a jump-start on the panic, shall we?', 'print_section': 'BR', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/books/review/0101-BKS-HelpDesk/0101-BKS-HelpDesk-articleLarge-v2.jpg', 'height': 597, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/01/01/books/review/0101-BKS-HelpDesk/0101-BKS-HelpDesk-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 597}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/books/review/0101-BKS-HelpDesk/0101-BKS-HelpDesk-jumbo-v2.jpg', 'height': 1019, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/books/review/0101-BKS-HelpDesk/0101-BKS-HelpDesk-superJumbo-v2.jpg', 'height': 1265, 'width': 1271, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/books/review/0101-BKS-HelpDesk/0101-BKS-HelpDesk-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/01/01/books/review/0101-BKS-HelpDesk/0101-BKS-HelpDesk-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/books/review/0101-BKS-HelpDesk/0101-BKS-HelpDesk-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'And a Thinner New Year: Five New Books About Food and Diets', 'kicker': 'Help Desk', 'content_kicker': None, 'print_headline': 'How-To and Self-Help', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-12-28T10:00:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Judith Newman', 'person': [{'firstname': 'Judith', 'middlename': None, 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c024556b-e584-52ac-b9bd-ee8ea7463ba2', 'word_count': 1364, 'uri': 'nyt://article/c024556b-e584-52ac-b9bd-ee8ea7463ba2'}, {'abstract': 'The surgeon general on the Affordable Care Act, the historic campaign to curb tobacco use and whether or not the president takes his advice.', 'web_url': 'https://www.nytimes.com/2016/12/28/magazine/vivek-murthy-thinks-we-need-to-learn-how-to-deal-with-stress.html', 'snippet': 'The surgeon general on the Affordable Care Act, the historic campaign to curb tobacco use and whether or not the president takes his advice.', 'lead_paragraph': 'Why does the surgeon general wear a uniform? I wear the uniform of the U.S. Public Health Service Commissioned Corps, which evolved from a Marine hospital system headed by a supervising surgeon, later given the title of surgeon general. I like the uniform: There was a time when my friends wouldn’t let me leave the apartment without somebody first checking to make sure I wasn’t going to embarrass the group with what I was wearing, so having the uniform is helpful.', 'print_section': 'MM', 'print_page': '58', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01talk/01mag-01talk-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/01/01/magazine/01talk/01mag-01talk-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01talk/01mag-01talk-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01talk/01mag-01talk-t_CA0-articleLarge.jpg', 'height': 1137, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/01/01/magazine/01talk/01mag-01talk-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1137}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01talk/01mag-01talk-t_CA0-jumbo.jpg', 'height': 1024, 'width': 541, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01talk/01mag-01talk-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 1081, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Vivek Murthy Thinks We Need to Learn How to Deal With Stress', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'Vivek Murthy Thinks We Need to Learn How to Deal With Stress', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Surgeon General (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Murthy, Vivek H', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-12-28T10:00:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Ana Marie Cox', 'person': [{'firstname': 'Interview', 'middlename': 'Ana', 'lastname': 'Marie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3e4f26ab-8daf-56fd-876b-7c176530f5fa', 'word_count': 648, 'uri': 'nyt://article/3e4f26ab-8daf-56fd-876b-7c176530f5fa'}, {'abstract': 'The magazine’s Ethicist columnist on how to navigate a nephew’s health concerns and what to disclose of an illness when applying for college teaching jobs that are few and far between.', 'web_url': 'https://www.nytimes.com/2016/12/28/magazine/your-sister-wont-vaccinate-her-son-can-you-help-him.html', 'snippet': 'The magazine’s Ethicist columnist on how to navigate a nephew’s health concerns and what to disclose of an illness when applying for college teaching jobs that are few and far between.', 'lead_paragraph': 'My sister and her ex are against vaccinating their kids, and I completely disagree with them. Vaccines have helped usher in the modern age; our life spans have been lengthened by the eradication or suppression of smallpox, polio, measles, flu, and so on. Recently, my 12-year-old nephew told me out of the blue that he wasn’t vaccinated and wanted to be. He got swine flu a year or two ago. He was very sick and has no desire to repeat anything like that again. ', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01ethicist/01mag-01ethicist-t_CA0-articleLarge.jpg', 'height': 887, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/01/01/magazine/01ethicist/01mag-01ethicist-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 887}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01ethicist/01mag-01ethicist-t_CA0-jumbo.jpg', 'height': 1008, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01ethicist/01mag-01ethicist-t_CA0-superJumbo.jpg', 'height': 1008, 'width': 682, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/magazine/01ethicis