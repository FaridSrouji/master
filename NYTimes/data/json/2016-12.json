': 'images/2016/12/31/nyregion/31SKAKEL/31SKAKEL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/31/nyregion/31SKAKEL/31SKAKEL-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/31/nyregion/31SKAKEL/31SKAKEL-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Michael Skakel’s Murder Conviction Has Been Reinstated', 'kicker': None, 'content_kicker': None, 'print_headline': 'Skakel’s Murder Conviction Is Reinstated, 3 Years After Reversal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'False Arrests, Convictions and Imprisonments', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Skakel, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Moxley, Martha', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich (Conn)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-12-30T22:59:35+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Alan Feuer and Kristin Hussey', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Feuer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Kristin', 'middlename': None, 'lastname': 'Hussey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/201ae30a-9766-5af7-aa92-6abc2c11091a', 'word_count': 697, 'uri': 'nyt://art