, 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/15/business/15BBC/15BBC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/15/business/15BBC/15BBC-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/15/business/15BBC/15BBC-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'BBC and ITV to Offer Streaming Service of British Shows in U.S.', 'kicker': None, 'content_kicker': None, 'print_headline': 'BBC and ITV to Offer Shows to U.S.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'British Broadcasting Corp', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'ITV (TV Network)', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-12-14T18:37:45+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Mark Scott', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e462318-6727-599d-8c40-88fe5420535f', 'word_count': 502, 'uri': 'nyt://article/4e462318-6727-599d-8c40-88fe5420535f'}, {'abstract': 'Yolande Batteau of Callidus Guild and Randi Mates of Aesa launch their first official collaboration: a line of precious metal and wood earrings and pendants.', 'web_url': 'https://www.nytimes.com/2016/12/14/t-magazine/fashion/yakisugi-jewelry-yolande-batteau-callidus-guild-randi-mates-aesa.html', 'snippet': 'Yolande Batteau of Callidus Guild and Randi Mates of Aesa launch their first official collaboration: a line of precious metal and wood earrings and pendants.', 'lead_paragraph': 'Coming from different, and multiple, milieus, the close friends Yolande Batteau and Randi Mates meet in the middle — that is, 82nd Street and Fifth Avenue. “We have a mutual devotion to the Metropolitan Museum of Art, particularly the study rooms,” says Batteau, a painter and co-founder of the noted interiors studio Callidus Guild, of Mates (herself a classical goldsmith and Aesa jewelry founder). “The level of our mutuality is such that we can go to a museum together, separate to wander for an hour and then come together only to find we have taken photos of the same exact pieces,” Mates adds. “It’s a rare and thrilling experience to find another person who is as wholly enamored by history, the minutiae of objects and the deep physicality of materials as I am.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/t-magazine/fashion/14tmag-jewelry01/14tmag-jewelry01-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/14/t-magazine/fashion/14tmag-jewelry01/14tmag-jewelry01-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/t-magazine/fashion/14tmag-jewelry01/14tmag-jewelry01-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/t-magazine/fashion/14tmag-jewelry01/14tmag