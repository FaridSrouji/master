14marseillaise01sub-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/arts/14marseillaise01sub-web/14marseillaise01sub-web-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/arts/14marseillaise01sub-web/14marseillaise01sub-web-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The Twists and Turns of ‘La Marseillaise’', 'kicker': None, 'content_kicker': None, 'print_headline': 'The twists and turns of ‘La Marseillaise’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'National Anthems', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Paris Attacks (November 2015)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-12-13T09:43:56+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Alex Marshall', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Marshall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/59d941ba-acbf-53b6-b483-4a9a1f7792bf', 'word_count': 1203, 'uri': 'nyt://article/59d941ba-acbf-53b6-b483-4a9a1f7792bf'}, {'abstract': 'Social media companies aren’t just an open marketplace for ideas — they’re also amplifying the most dangerous ones.', 'web_url': 'https://www.nytimes.com/2016/12/13/magazine/whos-responsible-when-extremists-get-a-platform.html', 'snippet': 'Social media companies aren’t just an open marketplace for ideas — they’re also amplifying the most dangerous ones.', 'lead_paragraph': 'In the days immediately following the presidential election, one striking statement by Stephen K. Bannon, the president-elect’s chief strategist and former campaign chief executive, rose to particular prominence. Speaking in July in his capacity as the chairman of Breitbart News, Bannon told the journalist Sarah Posner, in an article for Mother Jones, that his site was “the platform for the alt-right.” The statement was interpreted as both a claim of credit and a sort of explanation. The man who helped guide Donald J. Trump to the White House, and who will guide him again as president, had revealed the connection between his candidate, his publication and America’s most noxious political faction — a recently emboldened white-nationalist movement. And not only that, he seemed proud of it.', 'print_section': 'MM', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18firstwords/18mag-18firstwords-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/18/magazine/18firstwords/18mag-18firstwords-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18firstwords/18mag-18firstwords-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18firstwords/18mag-18firstwords-t_CA0-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/18/magazine/18firstwords/18mag-18firstwords-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18firstwords/18mag-18firstwords-t_CA0-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18firstwords/18mag-18firstwords-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Who’s Responsible When Extremists Get a Platform?', 'kicker': 'First Words', 'content_kicker': None, 'print_headline': 'Stage Craft', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Herrman, John', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Zuckerberg, Mark E', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-12-13T10:00:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By John Herrman', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Herrman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44d54f3a-d8e0-521a-b2fe-81481cd6b1f1', 'word_count': 1516, 'uri': 'nyt://article/44d54f3a-d8e0-521a-b2fe-81481cd6b1f1'}, {'abstract': 'Societies roiled by populist anger could take a lesson from Japan’s attitude toward labor — and the importance of investing it with meaning.', 'web_url': 'https://www.nytimes.com/2016/12/13/magazine/what-the-west-can-learn-from-japan-about-the-cultural-value-of-work.html', 'snippet': 'Societies roiled by populist anger could take a lesson from Japan’s attitude toward labor — and the importance of investing it with meaning.', 'lead_paragraph': 'A few weeks ago, in a Kyoto tempura bar, I watched a lone chef, a man in late middle age, cooking behind a counter for his 11 customers. The set menu had 15 items on it. That meant that at any given moment, he was keeping track of 165 pieces of food, each subject to slightly different timing and technique. He wrote nothing down and expended no apparent effort. It was a demonstration of total mastery. This didn’t look so much like a job as a life: His work was his whole being.', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18onmoney1/18onmoney1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/18/magazine/18onmoney1/18onmoney1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18onmoney1/18onmoney1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/magazine/18onmoney1/18onmoney1-articleLarge.jpg', 'height': 500, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/18/magazine/18onmoney1/18onmoney1-articleLarge.jpg', 'xlargewidth': 600, 'xlargehe