gger and better.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/watching/14empire/14empire-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/14/watching/14empire/14empire-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/watching/14empire/14empire-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/watching/14empire/14empire-articleLarge.jpg', 'height': 415, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/14/watching/14empire/14empire-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 415}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/watching/14empire/14empire-jumbo.jpg', 'height': 709, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/14/watching/14empire/14empire-superJumbo.jpg', 'height': 1418, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '‘Empire’ Season 3, Episode 9: The Enemy Within', 'kicker': 'Empire', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Empire (TV Program)', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-12-15T02:01:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name