, 'major': 'N'}], 'pub_date': '2016-12-17T14:30:02+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Farhad Manjoo and Daisuke Wakabayashi', 'person': [{'firstname': 'Farhad', 'middlename': None, 'lastname': 'Manjoo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Daisuke', 'middlename': None, 'lastname': 'Wakabayashi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/749691c4-77d2-5ca7-b437-1b12cf865d1a', 'word_count': 1081, 'uri': 'nyt://article/749691c4-77d2-5ca7-b437-1b12cf865d1a'}, {'abstract': 'A co-op board is responsible for protecting its employees from shareholders behaving badly — even if they’re lawyers (or just litigious).', 'web_url': 'https://www.nytimes.com/2016/12/17/realestate/harassing-the-super.html', 'snippet': 'A co-op board is responsible for protecting its employees from shareholders behaving badly — even if they’re lawyers (or just litigious).', 'lead_paragraph': 'Q. I am on the board of a small co-op in Midtown Manhattan. For the past year, a shareholder has had frequent and noisy sexual encounters in his apartment, making it difficult for the superintendent, who lives in the apartment below, to sleep. After the super complained to the shareholder and to the board, the shareholder began harassing her. He would ring her bell as he entered the building, sometimes at 3 or 4 in the morning, awakening her before his noisy assignations began. Because the shareholder is a lawyer, the board members are afraid that if we confront him he will retaliate against the board and individual members. How can we stop his uncivil behavior?', 'print_section': 'RE', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/realestate/18ASK/18ASK-articleLarge.jpg', 'height': 122, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/18/realestate/18ASK/18ASK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 122}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/realestate/18ASK/18ASK-jumbo.jpg', 'height': 208, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/realestate/18ASK/18ASK-superJumbo.jpg', 'height': 416, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/realestate/18ASK/18ASK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/18/realestate/18ASK/18ASK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/18/realestate/18ASK/18ASK-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Harassing the Super', 'kicker': 'Ask Real Estate', 'content_kicker': None, 'print_headline': 'Noisy Neighbor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Workplace Hazards and Violations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Building Service Employees', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cooperatives', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-12-17T15:00:03+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Ronda Kaysen', 'person': [{'firstname': 'Ronda', 'middlename': None, 'lastname': 'Kaysen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7305d65f-8998-54a8-8358-df6032cbac04', 'word_count': 385, 'uri': 'nyt://article/7305d65f-8998-54a8-8358-df6032cbac04'}, {'abstract': 'Economics can’t explain it.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/12/17/what-do-trump-voters-want/', 'snippet': 'Economics can’t explain it.', 'lead_paragraph': 'Brad DeLong has an interesting meditation on markets and political demands — inspired by a note from Noah Smith — that offers food for thought. I wonder, however, if Brad’s discussion is too abstract; and I also wonder whether it fully recognizes the disconnect between what Trump voters think they want and reality. So, an entry of my own.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Do Trump Voters Want?', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-12-17T15:24:41+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/50324ffc-7c52-5755-b956-6a28927eeacb', 'word_count': 408, 'uri': 'nyt://article/50324ffc-7c52-5755-b956-6a28927eeacb'}, {'abstract': 'China’s seizure of the American underwater drone off the Philippines raised tensions between the countries as a new president prepared to take power.', 'web_url': 'https://www.nytimes.com/2016/12/17/world/asia/china-us-drone.html', 'snippet': 'China’s seizure of the American underwater drone off the Philippines raised tensions between the countries as a new president prepared to take power.', 'lead_paragraph': 'BEIJING — The Pentagon on Saturday said that Beijing had agreed to return an underwater drone seized by China in international waters, an indication that the two countries were moving to resolve an unusual incident that risked sharpening tensions in the run-up to the inauguration of President-elect Donald J. Trump.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'China Agrees to Return Seized Drone, Ending Standoff, Pentagon Says', 'kicker': None, 'content_kicker': None, 'print_headline': 'China Agrees to Return U.S. Naval Drone Seized Off Philippines', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Perlez, Jane', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rosenberg, Matthew', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Navy', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Scarborough Shoal (South China Sea)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'South China Sea', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-12-17T15:35:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Jane Perlez and Matthew Rosenberg', 'person': [{'firstname': 'Jane', 'middlename': None, 'lastname': 'Perlez', 'qual