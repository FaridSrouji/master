/09/arts/08AUCTION/09AUCTION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/09/arts/08AUCTION/09AUCTION-articleLarge.jpg', 'height': 454, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/09/arts/08AUCTION/09AUCTION-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 454}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/09/arts/08AUCTION/09AUCTION-jumbo.jpg', 'height': 774, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/09/arts/08AUCTION/09AUCTION-superJumbo.jpg', 'height': 1548, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Christie’s Contemporary Art Chief Departs to Become Dealer', 'kicker': None, 'content_kicker': None, 'print_headline': 'Christie’s Maestro to Leave Auctions for Private Art Sales', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Christie's", 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gorvy, Brett', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Levy, Dominique', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-12-07T14:58:31+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role'