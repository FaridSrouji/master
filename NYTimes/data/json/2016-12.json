 'print_headline': '8', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricanes and Tropical Storms', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wind', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Satellites', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Michigan', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Aeronautics and Space Administration', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-12-19T22:35:34+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Nicholas St. Fleur', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'St', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf686be3-0708-57d6-b61f-42a6c6bb7c19', 'word_count': 299, 'uri': 'nyt://article/cf686be3-0708-57d6-b61f-42a6c6bb7c19'}, {'abstract': 'The government is trying to keep to a schedule a judge has set for a trial in March in a case stemming from a bombing in Chelsea on Sept. 17 and an attempted bombing nearby.', 'web_url': 'https://www.nytimes.com/2016/12/19/nyregion/chelsea-bombing-ahmad-khan-rahimi.html', 'snippet': 'The government is trying to keep to a schedule a judge has set for a trial in March in a case stemming from a bombing in Chelsea on Sept. 17 and an attempted bombing nearby.', 'lead_paragraph': 'A federal prosecutor in Manhattan said on Monday that the government had decided not to introduce at trial an extensive statement by the man accused of recent bombings in New York and New Jersey as it tries to keep to a schedule a judge has set for a trial in March.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/20/nyregion/20RAHIMI