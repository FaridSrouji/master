le': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/f28d1908-e6ad-5a5c-9b22-a677d60d80f7', 'word_count': 0, 'uri': 'nyt://video/f28d1908-e6ad-5a5c-9b22-a677d60d80f7'}, {'abstract': 'In the fall, we visited one of the largest Syrian refugee camps in the world while live on Facebook. Here’s what we heard from the refugees and from you.', 'web_url': 'https://www.nytimes.com/2016/12/30/world/middleeast/syrian-refugees-on-the-war-their-camp-and-your-questions.html', 'snippet': 'In the fall, we visited one of the largest Syrian refugee camps in the world while live on Facebook. Here’s what we heard from the refugees and from you.', 'lead_paragraph': 'In September, we visited a Syrian refugee camp while live on Facebook, and brought The New York Times’s audience along. We went to the Zaatari refugee camp in Jordan, one of the largest Syrian camps in the world, after our audience said in countless comments that they wanted to see and interact with Syrian refugees.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Syrian Refugees on the War, Their Camp, and Your Questions', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Zaatari Refugee Camp (Jordan)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Jordan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and Africa Migrant Crisis', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-12-30T14:51:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Deborah Acosta', 'person': [{'firstname': 'Deborah', 'middlename': None, 'lastname': 'Acosta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aa6aa463-faa5-5dad-ae8d-ea762b0d8c22', 'word_count': 98, 'uri': 'nyt://article/aa6aa463-faa5-5dad-ae8d-ea762b0d8c22'}, {'abstract': 'For some first-time buyers, renting might actually be cheaper, both in the short- and long-term.', 'web_url': 'https://www.nytimes.com/2016/12/30/realestate/does-it-pay-to-buy-a-house-in-the-suburbs.html', 'snippet': 'For some first-time buyers, renting might actually be cheaper, both in the short- and long-term.', 'lead_paragraph': 'Q. My husband and I are in our 30s and used to rent in Brooklyn. After we had a baby, we moved to the suburbs. We’re now thinking about buying a house, but I can’t wrap my mind around how it would be financially advantageous. In Port Washington on Long Island, we pay $2,600 a month in rent for a beautiful apartment. For a barely livable house, we would pay at least $3,600 a month, not counting the additional expenses of ownership. From my estimates, we will save $12,000 a year if we continue to rent. What am I missing?', 'print_section': 'RE', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/realestate/01SUB2ASK/01SUB2ASK-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/01/01/realestate/01SUB2ASK/01SUB2ASK-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/realestate/01SUB2ASK/01SUB2ASK-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/realestate/01SUB2A