/28/fashion/28LAAR4/28LAAR4-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/28/fashion/28LAAR4/28LAAR4-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/28/fashion/28LAAR4/28LAAR4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/28/fashion/28LAAR4/28LAAR4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/28/fashion/28LAAR4/28LAAR4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Holiday Style, on and Off the Ice, at the Rockefeller Center Rink', 'kicker': None, 'content_kicker': None, 'print_headline': 'Glide, Glide Away, and Swirl in Style', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ice Skating', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Rockefeller Center (Manhattan, NY)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-12-30T17:45:39+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Max Berlinger', 'person': [{'firstname': 'Max', 'middlename': None, 'lastname': 'Berlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8412e167-1150-5d2f-a1a8-c52947f86768', 'word_count': 1878, 'uri': 'nyt://article/8412e167-1150-5d2f-a1a8-c52947f86768'}, {'abstract': 'The Spice Islands can teach us about the sins and virtues of globalization.', 'web_url': 'https://www.nytimes.com/2016/12/30/opinion/sunday/clove-trees-the-color-of-ash.html', 'snippet': 'The Spice Islands can teach us about the sins and virtues of globalization.', 'lead_paragraph': 'GOA, India — For many years the word “globalization” was used as shorthand for a promised utopia of free trade powered by the world’s great centers of technological and financial innovation. But the celebratory note has worn thin. The word is now increasingly invoked to explain a widespread recoiling from a cosmopolitan earth. People in many countries are looking nostalgically backward, toward less connected, supposedly more secure times.', 'print_section': 'SR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/sunday-review/01ghosh-2/01ghosh-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/01/01/sunday-review/01ghosh-2/01ghosh-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/sunday-review/01ghosh-2/01ghosh-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/sunday-review/01ghosh-2/01ghosh-2-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/01/01/sunday-review/01ghosh-2/01ghosh-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/01/sunday-review/01ghosh-2/0