ds': [{'name': 'subject', 'value': 'Automobile Racing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Andretti Autosport', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Indy Racing League', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Steinbrenner, Hank', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-12-15T11:00:16+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Auto Racing', 'byline': {'original': 'By Billy Witz', 'person': [{'firstname': 'Billy', 'middlename': None, 'lastname': 'Witz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b04bae79-64ce-55c0-8bd7-09e51ee142a9', 'word_count': 485, 'uri': 'nyt://article/b04bae79-64ce-55c0-8bd7-09e51ee142a9'}, {'abstract': 'Bill Simmons, Heben Nigatu, Tracy Clayton and Ezra Edelman discuss what stuck with them this year.', 'web_url': 'https://www.nytimes.com/2016/12/15/podcasts/unforgettable-cultural-moments-from-2016.html', 'snippet': 'Bill Simmons, Heben Nigatu, Tracy Clayton and Ezra Edelman discuss what stuck with them this year.', 'lead_paragraph': 'It’s the end of the year, which means a lot of parties that can end in sloppiness and chagrin. For us, it means jotting down what culture mattered this year and talking about that. We invited four pals to join us on Still Processing to talk about what they jotted: Bill Simmons, the chief executive of The Ringer and host of the “Bill Simmons Podcast”; Ezra Edelman, director of the documentary “O.J.: Made in America,” the movie Wesley thinks is the best of 2016; and Tracy Clayton and Heben Nigatu, who host the podcast “Another Round.” Their lists are published below, but their energy and explanations you have to hear for yourself. Next week, we’ll share our own lists.', 'source': 'The New York Times', 'm