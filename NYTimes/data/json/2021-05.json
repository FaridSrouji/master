Standard', 'legacy': {'thumbnail': 'images/2021/05/12/business/12economy-briefing-broadband/12economy-briefing-broadband-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/12/business/12economy-briefing-broadband/12economy-briefing-broadband-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Low-income households can now apply for a $50 monthly discount for internet.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rural Areas', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Laptop Computers', 'rank': 3, 'major': 'N'}], 'pub_date': '2021-05-12T15:54:48+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Cecilia Kang', 'person': [{'firstname': 'Cecilia', 'middlename': None, 'lastname': 'Kang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf0a2444-9473-5259-8f6a-84d2f6f8dc87', 'word_count': 323, 'uri': 'nyt://article/cf0a2444-9473-5259-8f6a-84d2f6f8dc87'}, {'abstract': 'Despite ongoing labor tensions, members of the company’s orchestra and chorus will perform with soloists and Yannick Nézet-Séguin.', 'web_url': 'https://www.nytimes.com/2021/05/12/arts/music/met-opera-concert.html', 'snippet': 'Despite ongoing labor tensions, members of the company’s orchestra and chorus will perform with soloists and Yannick Nézet-Séguin.', 'lead_paragraph': 'The Metropolitan Opera will perform again for a live audience, 430 days after the coronavirus shut down its theater.', 'print_section': 'C', 'print_pag