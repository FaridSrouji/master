r': 'N'}], 'pub_date': '2021-05-04T22:44:07+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Obituaries', 'byline': {'original': 'By Alex Traub', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Traub', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/75c02c29-fb7f-5863-8f85-935b39c9a868', 'word_count': 534, 'uri': 'nyt://article/75c02c29-fb7f-5863-8f85-935b39c9a868'}, {'abstract': 'Justin Lafferty, a state representative, was rebuked after offering a historical defense of the agreement, under which three-fifths of a state’s enslaved people counted toward its population.', 'web_url': 'https://www.nytimes.com/2021/05/04/us/politics/justin-lafferty-tennessee-three-fifths-compromise.html', 'snippet': 'Justin Lafferty, a state representative, was rebuked after offering a historical defense of the agreement, under which three-fifths of a state’s enslaved people counted toward its population.', 'lead_paragraph': 'NASHVILLE — The Three-Fifths Compromise, an agreement reached during the negotiations in 1787 to create the United States Constitution, found that, for the purposes of representation and taxation, only three-fifths of a state’s enslaved people would be counted toward its total population. It is regarded as one of the most racist deals among the states during the country’s founding.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/lens/04tennessee-photosub/merlin_187297377_4760a0fe-716c-4616-a23f-df17265a5ca0-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/04/lens/04tennessee-photosub/merlin_187297377_4760a0fe-716c-4616-a23f-df17265a5ca0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/lens/04tennessee-photosub/merlin_187297377_4760a0fe-716c-4616-a23f-df17265a5ca0-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/lens/04tennessee-photosub/merlin_187297377_4760a0fe-716c-4616-a23f-df17265a5ca0-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/lens/04tennessee-photosub/04tennessee-photosub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/05/04/lens/04tennessee-photosub/04tennessee-photosub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/lens/04tennessee-photosub/04tennessee-photosub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tennessee Lawmaker Is Criticized for Remarks on Three-Fifths Compromise', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lawmaker  Is Criticized  For Defending Notorious Deal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Tennessee', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lafferty, Justin (1971- )', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Slavery (Historical)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value'