one}, 'keywords': [{'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bread', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Service', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lahey, Jim', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bittman, Mark', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Sullivan Street Bakery', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 8, 'major': 'N'}], 'pub_date': '2021-05-03T20:15:59+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By J. Kenji López-Alt', 'person': [{'firstname': 'J.', 'middlename': 'Kenji', 'lastname': 'López-Alt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c0a866a7-3db4-5d1a-a5db-da48db7a6d30', 'word_count': 3359, 'uri': 'nyt://article/c0a866a7-3db4-5d1a-a5db-da48db7a6d30'}, {'abstract': 'Le Moulin, available this month at Williams Sonoma, offers a cook nine grind-size options.', 'web_url': 'https://www.nytimes.com/2021/05/03/dining/spice-mill-michel-bras.html', 'snippet': 'Le Moulin, available this month at Williams Sonoma, offers a cook nine grind-size options.', 'lead_paragraph': 'A sleek spice mill is the latest addition to the line of kitchen utensils developed by the chef Michel Bras with the KAI Group of Japan. It operates like many others: Unscrew the top, fill the cylinder, replace the top and grind by turning it. An important feature is the ease with which the texture can be adjusted, by turning the lower band with nine gradual markings. When you finish grinding a particular ingredient you can easily empty the inside. But then it pays to give the thing a few more turns to make sure you’ve gotten all those fennel seeds or cardamom pods out before using the mill for something else.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/05/dining/03burner-mill/merlin_187132917_25104d6f-c0b1-41d5-95c4-0fa6971194b4-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/05/dining/03burner-mill/merlin_187132917_25104d6f-c0b1-41d5-95c4-0fa6971194b4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/05/dining/03burner-mill/merlin_187132917_25104d6f-c0b1-41d5-95c4-0fa6971194b4-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/05/dining/03burner-mill/merlin_187132917_25104d6f-c0b1-41d5-95c4-0fa6971194b4-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/05/dining/03burner-mill/merlin_187132917_25104d6f-c0b1-41d5-95c4-0fa6971194b4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/05/05/dining/03burner-mill/merlin_187132917_25104d6f-c0b1-41d5-95c4-0fa6971194b4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/05/dining/03burner-mill/merlin_187132917_25104d6f-c0b1-41d5-95c4-0fa6971194b4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'he