'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/nyregion/04nyvirus-voices8/04nyvirus-voices8-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/nyregion/04nyvirus-voices8/04nyvirus-voices8-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/05/04/nyregion/04nyvirus-voices8/04nyvirus-voices8-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/04/nyregion/04nyvirus-voices8/04nyvirus-voices8-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sudden Decision to Reopen Leaves New Yorkers Dizzy and Divided', 'kicker': None, 'content_kicker': None, 'print_headline': 'New Yorkers on the Reopening: ‘It’s About Time’ or ‘It’s Too Fast’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus Reopenings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 5, 'major': 'N'}], 'pub_date': '2021-05-04T18:53:47+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael Wilson', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e176bc93-cfff-5597-bc6f-8a95b54f0056', 'word_count': 1242, 'uri': 'nyt://article/e176bc93-cfff-5597-bc6f-8a95b54f0056'}, {'abstract': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'web_url': 'https://www.nytimes.com/2021/05/04/style/tiny-modern-love-stories-every-morning-we-got-up-and-did-it-again.html', 'snippet': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'lead_paragraph': 'I fry cutlets for chicken parmigiana, doing math: In my 53 years, I have fried thousands. My mother taught me. When I was 7, we would fry chicken side by side, her hip touching mine. “Cover yourself,” she would say. “You’ll get hurt and dirty that shirt.” As a teenager, I’d snap, “Ma, I hate when you use ‘dirty’ as a verb.” But, no matter the age, I would listen and grab an apron. More math: It’s been over two decades without her. But still, like magic, she reminds me to separate the cutlets and back away from the flame. — Kathy Curto', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/05/fashion/00APRIL-TLS3/00APRIL-TLS3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/05/fashion/00APRIL-TLS3/00APRIL-TLS3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/05/fashion/00APRIL-TLS3/00APRIL-TLS3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/05/fashion/00APRIL-TLS3/00APRIL-TLS3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'capti