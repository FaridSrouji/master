umbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/25/dining/sd-shrimp-in-purgatory/merlin_188173062_99154f1d-c611-44ec-a2c0-d328e55d9721-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/25/dining/sd-shrimp-in-purgatory/merlin_188173062_99154f1d-c611-44ec-a2c0-d328e55d9721-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/05/25/dining/sd-shrimp-in-purgatory/merlin_188173062_99154f1d-c611-44ec-a2c0-d328e55d9721-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/25/dining/sd-shrimp-in-purgatory/merlin_188173062_99154f1d-c611-44ec-a2c0-d328e55d9721-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What to Cook This Weekend', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Service', 'rank': 2, 'major': 'N'}], 'pub_date': '2021-05-28T14:30:00+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67b2575a-8894-5135-a06d-40bd0acf2ced', 'word_count': 502, 'uri': 'nyt://article/67b2575a-8894-5135-a06d-40bd0acf2ced'}, {'abstract': 'Tell us how you’ve used The Times to teach. We love to publish ideas from our readers.', 'web_url': 'https://www.nytimes.com/2021/05/28/learning/reader-idea-submission-form.html', 'snippet': 'Tell us how you’ve used The Times to teach. We love to publish ideas from our readers.', 'lead_paragraph': 'Do you use The New York Times in your classroom? Whether you’re a teacher, parent, coach, librarian, tutor, counselor, adviser, administrator or even a student, we want to hear about your idea for teaching or learning with The Times.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/learning/ReaderIdeasLN/ReaderIdeasLN-jumbo.jpg', 'height': 422, 'width': 422, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/learning/ReaderIdeasLN/ReaderIdeasLN-superJumbo.jpg', 'height': 422, 'width': 422, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/learning/ReaderIdeasLN/ReaderIdeasLN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/30/learning/ReaderIdeasLN/ReaderIdeasLN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/learning/ReaderIdeasLN/ReaderIdeasLN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Great Ideas From Our Readers', 'kicker': 'Reader idea Submission Form', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2021-05-28T14:36:20+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By The Learning Network', 'person': [], 'organization': 'The Learning Network'}, 'type_of_material': 'News', '_id': 'nyt://article/01d5ebee-7440-534c-9ab4-f8065b4aefab', 'word_count': 131, 'uri': 'nyt://article/01d5ebee-7440-534c-9ab4-f8065b4aefab'}, {'abstract': 'The Manchester City midfielder is a rare player in the Champions League final: one with experience in the game. He wants to know what it feels like to win.', 'web_url': 'https://www.nytimes.com/2021/05/28/sports/soccer/champions-league-final-ilkay-gundogan.html', 'snippet': 'The Manchester City midfielder is a rare player in the Champions League final: one with experience in the game. He wants to know what it feels like to win.', 'lead_paragraph': 'Ilkay Gundogan is a little sheepish as he admits it. It is not what he is supposed to do, he knows. He is supposed to take each game as it comes. That is the professional’s mantra. Don’t get ahead of yourself. Think about today, rather than tomorrow. That is what a sports psychologist would advise. It is what his manager, certainly, would recommend.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/29/sports/29rorynewsletter1/merlin_127008572_5faf83a6-cc57-4496-98fe-3e8955f8ccb1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/29/sports/29rorynewsletter1/merlin_127008572_5faf83a6-cc57-4496-98fe-3e8955f8ccb1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/29/sports/29rorynewsletter1/merlin_127008572_5faf83a6-cc57-4496-98fe-3e8955f8ccb1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', '