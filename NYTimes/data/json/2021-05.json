': 'nyt://article/0cf0d7a4-a42d-599c-88e2-cd82ff2cbf90'}, {'abstract': 'Professional basketball players are buying and selling digital video highlights while preaching the tech industry’s cryptocurrency gospel.', 'web_url': 'https://www.nytimes.com/2021/05/13/business/nba-top-shot-moments.html', 'snippet': 'Professional basketball players are buying and selling digital video highlights while preaching the tech industry’s cryptocurrency gospel.', 'lead_paragraph': 'Late in the third quarter of a March game between the Utah Jazz and the New Orleans Pelicans, Rudy Gobert, the Jazz’s 7-foot-1 center, caught a pass and slammed down a dunk as the Pelicans’ Josh Hart leapt to contest the shot.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How ‘Put That on Top Shot!’ Became a New N.B.A. Mantra', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Cryptocurrency Becomes the N.B.A.’s New Trading Card', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Basketball Assn', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Virtual Currency', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Nonfungible Tokens (NFTs)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Dapper Labs Inc', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Barnes, Harrison', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Gobert, Rudy (1992- )', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Haliburton, Tyrese', 'rank': 9, 'major': 'N'}], 'pub_date': '2021-05-13T09:00:19+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Kellen Browning', 'person': [{'firstname': 'Kellen', 'middlename': None, 'lastna