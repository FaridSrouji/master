name': 'persons', 'value': 'Kuznetsova, Svetlana', 'rank': 10, 'major': 'N'}], 'pub_date': '2021-05-29T20:52:47+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Max Gendler', 'person': [{'firstname': 'Max', 'middlename': None, 'lastname': 'Gendler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21fd5f80-c338-58d5-8e27-1abe1beb1cb5', 'word_count': 865, 'uri': 'nyt://article/21fd5f80-c338-58d5-8e27-1abe1beb1cb5'}, {'abstract': 'Chelsea won the Champions League for the second time, defeating Manchester City in a battle for control of European soccer’s biggest prize.', 'web_url': 'https://www.nytimes.com/2021/05/29/sports/soccer/chelsea-champions-league.html', 'snippet': 'Chelsea won the Champions League for the second time, defeating Manchester City in a battle for control of European soccer’s biggest prize.', 'lead_paragraph': 'PORTO, Portugal — Manchester City’s players did not seem to want to leave. Not right away, at least. They stood, as if frozen in place, as Chelsea’s players heaved the prize City craves more than any other into the air. They could not go. To go, after all, would be to accept that it was real, that it was over.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/29/sports/29chelseatrophy/merlin_188486415_c93c99d1-7585-47c6-9be1-2af2c7693dc9-articleLarge.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/29/sports/29chelseatrophy/merlin_188486415_c93c99d1-7585-47c6-9be1-2af2c7693dc9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/29/sports/29chelseatrophy/me