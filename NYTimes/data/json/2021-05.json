rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd10e0db-8811-54cf-8873-b47cfaf23c40', 'word_count': 2258, 'uri': 'nyt://article/fd10e0db-8811-54cf-8873-b47cfaf23c40'}, {'abstract': 'Pitchers are better than ever. Hitters seem worse than ever. With six no-hitters by May 19, baseball is two away from tying the full-season record, which was set in 1884.', 'web_url': 'https://www.nytimes.com/article/no-hitters-2021-season-history.html', 'snippet': 'Pitchers are better than ever. Hitters seem worse than ever. With six no-hitters by May 19, baseball is two away from tying the full-season record, which was set in 1884.', 'lead_paragraph': 'It had been less than 24 hours since Spencer Turnbull of the Detroit Tigers completed baseball’s fifth no-hitter of the 2021 season when Corey Kluber of the Yankees threw the sixth.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/06/19/sports/19mlb-nohitters-klubertop/merlin_188023812_30a00ea6-1fc0-47ca-ba72-3408ad18949c-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/06/19/sports/19mlb-nohitters-klubertop/merlin_188023812_30a00ea6-1fc0-47ca-ba72-3408ad18949c-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/06/19/sports/19mlb-nohitters-klubertop/merlin_188023812_30a00ea6-1fc0-47ca-ba72-3408ad18949c-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/06/19/sports/19mlb-nohitters-klubertop/merlin_188023812_30a00ea6-1fc0-47ca-ba72-3408ad18949c-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo',