 None, 'lastname': 'Campbell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7c74922d-af68-50bd-a883-59df16cf7b59', 'word_count': 1151, 'uri': 'nyt://article/7c74922d-af68-50bd-a883-59df16cf7b59'}, {'abstract': 'For many midlevel engineers and food truck workers and longtime residents, a region filled with extremes has become increasingly inhospitable.', 'web_url': 'https://www.nytimes.com/2021/05/08/business/economy/seeing-the-real-faces-of-silicon-valley.html', 'snippet': 'For many midlevel engineers and food truck workers and longtime residents, a region filled with extremes has become increasingly inhospitable.', 'lead_paragraph': 'The workers of Silicon Valley rarely look like the men idealized in its lore. They are sometimes heavier, sometimes older, often female, often darker skinned. Many migrated from elsewhere. And most earn far less than Mark Zuckerberg or Tim Cook.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/07/business/siliconvalley-promo/siliconvalley-promo-articleLarge.png', 'height': 404, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/07/business/siliconvalley-promo/siliconvalley-promo-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 404}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/07/business/siliconvalley-promo/siliconvalley-promo-jumbo.png', 'height': 690, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/07/business/siliconvalley-promo/siliconvalley-promo-superJumbo.png', 'height': 759, 'width': 1127, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/07/business/siliconvalley-promo/siliconvalley-promo-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/05/07/business/siliconvalley-promo/siliconvalley-promo-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/07/business/siliconvalley-promo/siliconvalley-promo-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seeing the Real Faces of Silicon Valley', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Silicon Valley Divide', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Silicon Valley (Calif)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Homeless Persons', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Personal Profile', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-05-08T07:00:15+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73a021d0-c45a-5359-bf76-77d410d20e48', 'word_count': 1802, 'uri': 'nyt://article/73a021d0-c45a-5359-bf76-77d410d20e48'}, {'abstract': '“To the Lighthouse” and “Beloved” suggest how to envision a world we might actually want to re-enter.', 'web_url': 'https://www.nytimes.com/2021/05/08/books/review/virginia-woolf-toni-morrison-to-the-lighthouse-beloved.html', 'snippet': '“To the Lighthouse” and “Beloved” suggest how to envision a world we might actually want to re-enter.', 'lead_paragraph': 'A lesser mystery of the pandemic: how to square the rise in total book sales (roughly 10 percent in 2020) and the number of readers (roughly all of them) who over that same period described the struggle to conquer a single paragraph, much less all, of “Middlemarch.” A year of dread, loss and social tumult has stretched at both ends the extent to which taking a new book in hand constitutes an act of hope. If the ability to immerse oneself in another world has wavered, it would appear that the will to do so endures, bound up, for now, in the piles of un- and half-read books fortifying our respective holding cells.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/books/review/16Orange-web/16Orange-web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/16/books/review/16Orange-web/16Orange-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/books/review/16Orange-web/16Orange-web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/books/review/16Orange-web/16Orange-web-superJumbo.jpg', 'height': 1200, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/books/review/16Orange-web/16Orange-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/05/16/books/review/16Orange-web/16Orange-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/books/review/16Orange-web/16Orange-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trying to Imagine Post-Pandemic Life? Virginia Woolf and Toni Morrison Can Help.', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'Modern Elegies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Morrison, Toni', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Woolf, Virginia', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'TO THE LIGHTHOUSE (BOOK)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'BELOVED (BOOK)', 'rank': 9, 'major': 'N'}], 'pub_date': '2021-05-08T09:00:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Michelle Orange', 'person': [{'firstname': 'Michelle', 'middlename': None, 'lastname': 'Orange', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/712a2d53-3430-5db0-b789-7c58138fbd49', 'wor