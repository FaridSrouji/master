therwise end up in landfills. ', 'print_section': 'D', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/02/multimedia/04ah-ragrug1/04ah-ragrug1-articleLarge.jpg', 'height': 429, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/02/multimedia/04ah-ragrug1/04ah-ragrug1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 429}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/02/multimedia/04ah-ragrug1/04ah-ragrug1-jumbo.jpg', 'height': 732, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/02/multimedia/04ah-ragrug1/04ah-ragrug1-superJumbo.jpg', 'height': 1464, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/02/multimedia/04ah-ragrug1/04ah-ragrug1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/05/02/multimedia/04ah-ragrug1/04ah-ragrug1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/02/multimedia/04ah-ragrug1/04ah-ragrug1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Got Rags? Weave a Rug', 'kicker': None, 'content_kicker': None, 'print_headline': 'Got Rags?  Weave a Rug.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Service'