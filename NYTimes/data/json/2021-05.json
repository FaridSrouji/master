rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2511feb-095d-5832-b7fb-f224376d7ca4', 'word_count': 998, 'uri': 'nyt://article/c2511feb-095d-5832-b7fb-f224376d7ca4'}, {'abstract': 'A report that found that Martin Bashir of the BBC used deceit to secure the sit-down has set off a storm of criticism of the British broadcaster.', 'web_url': 'https://www.nytimes.com/2021/05/21/world/europe/bashir-bbc-diana-interview.html', 'snippet': 'A report that found that Martin Bashir of the BBC used deceit to secure the sit-down has set off a storm of criticism of the British broadcaster.', 'lead_paragraph': 'LONDON — Just a few weeks ago, the BBC looked as though it had emerged from a season of storms. Prime Minister Boris Johnson’s Conservative government held off on threats to overhaul its finances, while its wall-to-wall coverage of the coronavirus pandemic served as a timely reminder of the value of a public-service broadcaster.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/22/world/21subBBC-BASHIR-print/merlin_188081616_fd939a35-2870-488e-916b-01bb45f13d91-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/22/world/21subBBC-BASHIR-print/merlin_188081616_fd939a35-2870-488e-916b-01bb45f13d91-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/22/world/21subBBC-BASHIR-print/merlin_188081616_fd939a35-2870-488e-916b-01bb45f13d91-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/22/world/21subBBC-BASHIR-print/merlin_188081616_fd939a35-2870-488e-