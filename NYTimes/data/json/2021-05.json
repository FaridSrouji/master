name': 'Edmondson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7565825-b082-5ea4-9f5d-f286370f0d78', 'word_count': 463, 'uri': 'nyt://article/c7565825-b082-5ea4-9f5d-f286370f0d78'}, {'abstract': 'Graphs about income, education, health care and the pandemic can help students think critically about stubborn and growing inequalities in American society.', 'web_url': 'https://www.nytimes.com/2021/05/11/learning/lesson-plans/teach-about-inequality-with-these-28-new-york-times-graphs.html', 'snippet': 'Graphs about income, education, health care and the pandemic can help students think critically about stubborn and growing inequalities in American society.', 'lead_paragraph': 'Inequalities, by definition, involve a comparison between two or more things. In math, we can easily express inequalities with simple mathematical sentences, such as x<y. But how can we illustrate complicated inequalities deeply entrenched in our society that are often hidden from plain sight behind segregated neighborhoods, schools of varying quality and different health care systems? Graphs are one powerful tool.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/16/learning/NetWorthChangeGraph2LN-png/NetWorthChangeGraph2LN-png-articleLarge.png', 'height': 396, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/03/16/learning/NetWorthChangeGraph2LN-png/NetWorthChangeGraph2LN-png-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 396}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/16/learning/NetWorthChangeGraph2LN-png/NetWorthChangeGraph2LN-png-jumbo.png', 'height': 676, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/16/learning/NetWorthChangeGraph2LN-png/NetWorthChangeGraph2LN-png-superJumbo.png', 'height': 735, 'width': 1114, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/16/learning/NetWorthChangeGraph2LN-png/NetWorthChangeGraph2LN-png-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/03/16/learning/NetWorthChangeGraph2LN-png/NetWorthChangeGraph2LN-png-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/16/learning/NetWorthChangeGraph2LN-png/NetWorthChangeGraph2LN-png-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Teach About Inequality With These 28 New York Times Graphs', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2021-05-12T00:33:46+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'subsection_name': 'Lesson Plans', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39463194-db07-50e1-a538-09feba6798c2', 'word_count': 1147, 'uri': 'nyt://article/39463194-db07-50e1-a538-09feba6798c2'}, {'abstract': 'In this lesson, students will explore social inequalities in income, education and health care, many exacerbated by issues of race and gender, using New York Times graphs.', 'web_url': 'https://www.nytimes.com/2