ame': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cases of unruly airline passengers are soaring, and so are federal fines.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'internal-essential', 'rank': 1, 'major': 'N'}], 'pub_date': '2021-05-10T11:48:40+0000', 'document_type': 'article', 'news_desk': 'Express', 'section_name': 'Travel', 'byline': {'original': 'By Neil Vigdor', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Vigdor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a90284c1-b674-5518-8bb0-10c3f9509bce', 'word_count': 244, 'uri': 'nyt://article/a90284c1-b674-5518-8bb0-10c3f9509bce'}, {'abstract': 'Experts caution that it’s not yet clear just how much of a factor that the variant, B.1.617, has played in the catastrophic rise in cases in India, which are likely undercounted.', 'web_url': 'https://www.nytimes.com/2021/05/10/world/asia/india-covid-virus-variant.html', 'snippet': 'Experts caution that it’s not yet clear just how much of a factor that the variant, B.1.617, has played in the catastrophic rise in cases in India, which are likely undercounted.', 'lead_paragraph': 'Amid a deepening crisis in India, the World Health Organization announced Monday that it had designated the B.1.617 variant, which has been growing more common in the country, as a variant of concern. Scientists still don’t know much about the variant, but they are worried that it might be helping to fuel the rise in the nation’s coronavirus infections, which experts say are probably undercounted. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/10/world/10virus-briefing-india-modi1/10virus-briefing-india-m