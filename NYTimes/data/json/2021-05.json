 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/abdb3174-78d2-5c65-938a-071a0650cdb6', 'word_count': 1168, 'uri': 'nyt://article/abdb3174-78d2-5c65-938a-071a0650cdb6'}, {'abstract': 'A booming, renegade private intelligence industry is increasingly shaping (and misshaping) the news.', 'web_url': 'https://www.nytimes.com/2021/05/15/business/media/spooked-private-spies-news-media.html', 'snippet': 'A booming, renegade private intelligence industry is increasingly shaping (and misshaping) the news.', 'lead_paragraph': 'Some journalists are happy to knock on the doors of strangers. I was never one of them, but Christopher Steele, the ex-British spy behind the infamous Trump dossier, left me no choice.', 'print_section': 'BU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/business/16Spooked-cover-illo/16Spooked-cover-illo-articleLarge.jpg', 'height': 829, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/05/16/business/16Spooked-cover-illo/16Spooked-cover-illo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 829}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/business/16Spooked-cover-illo/16Spooked-cover-illo-jumbo.jpg', 'height': 1024, 'width': 741, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/business/16Spooked-cover-illo/16Spooked-cover-illo-superJumbo.jpg', 'height': 2048, 'width': 1482, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/05/16/business/16Spooked-cover-illo