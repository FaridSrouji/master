n/14bardach/12bardach-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/14/opinion/14bardach/12bardach-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/14/opinion/14bardach/12bardach-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/14/opinion/14bardach/12bardach-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/14/opinion/14bardach/12bardach-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/14/opinion/14bardach/12bardach-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kids Aren’t Big Covid-19 Spreaders. Really.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Don’t Call  Kids Covid Spreaders', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus Reopenings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus Risks and Safety Concerns', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-08-12T09:00:13+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Naomi Bardach', 'person': [{'firstname': 'Naomi', 'middlename': None, 'lastname': 'Bardach', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/5cd3642c-6b90-5f24-ae48-9772449ff6ea', 'word_count': 1023, 'uri': 'nyt://article/5cd3642c-6b90-5f24-ae48-9772449ff6ea'}, {'abstract': 'Many universities are asking students to wear masks and avoid parties — and to report on peers who break the rules. It could backfire.', 'web_url': 'https://www.nytimes.com/2020/08/12/opinion/coronavirus-college-reopening.html', 'snippet': 'Many universities are asking students to wear masks and avoid parties — and to report on peers who break the rules. It could backfire.', 'lead_paragraph': 'Hundreds of American colleges and universities have opted to begin the fall semester at least partly in person, allowing some or all of their students onto campus to live and study. These schools are going to great lengths to impress upon students that their behavior determines whether campuses can stay open or whether they will have to head back to their parents’ homes by October. In many cases, schools are requiring students to sign “social contracts” in which they promise not to party, have overnight dorm guests, walk across campus without masks or otherwise conduct themselves as college students normally do — and often attaching strict penalties if students violate the rules.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/13/opinion/13LevyKilgour2/merlin_175572420_0536b22c-294a-408d-88c2-22d1f996379f-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/13/opinion/13LevyKilgour2/merlin_175572420_0536b22c-294a-408d-88c2-22d1f996379f-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/13/opinion/13LevyKilgour2/merlin_175572420_0536b22c-294a-408d-88c2-22d1f996379f-jumbo.j