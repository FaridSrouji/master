e, 'type': 'image', 'url': 'images/2020/08/11/books/11BOOKLAVEAU-HARVIE1/11BOOKLAVEAU-HARVIE1-jumbo.jpg', 'height': 1024, 'width': 762, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/11/books/11BOOKLAVEAU-HARVIE1/11BOOKLAVEAU-HARVIE1-superJumbo.jpg', 'height': 2048, 'width': 1524, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/11/books/11BOOKLAVEAU-HARVIE1/11BOOKLAVEAU-HARVIE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/11/books/11BOOKLAVEAU-HARVIE1/11BOOKLAVEAU-HARVIE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/11/books/11BOOKLAVEAU-HARVIE1/11BOOKLAVEAU-HARVIE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘The Erratics’ Remembers a Mother With a Monstrous Talent for Twisting Reality', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sifting the Ruins in a Tempestuous Mother’s Wake', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'The Erratics (Book)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Laveau-Harvie, Vicki', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-08-11T16:07:41+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Parul Sehgal', 'person': [{'firstname': 'Parul', 'middlename': None, 'lastname': 'Sehgal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3236c22f-4f1d-56f3-81d2-7eb89da0c9a8', 'word_count': 1124, 'uri': 'nyt://article/3236c22f-4f1d-56f3-81d2-7eb89da0c9a8'}, {'abstract': 'The “blue shift” is real. Take it seriously.', 'web_url': 'https://www.nytimes.com/2020/08/11/opinion/voting-mail-election-night.html', 'snippet': 'The “blue shift” is real. Take it seriously.', 'lead_paragraph': 'Imagine a parallel universe in which the sitting president cares about holding a free and democratic election in the midst of a pandemic. Imagine that his administration is staffed with competent, incorruptible officials who devote every waking hour to stopping the virus, saving lives, rebuilding the economy and preserving democracy. Imagine that the Postal Service hires tens of thousands of extra workers to process the surge of mail-in ballots.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/13/opinion/13wegman-illo-sub/11wegman-illo-sub-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/13/opinion/13wegman-illo-sub/11wegman-illo-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/13/opinion/13wegman-illo-sub/11wegman-illo-sub-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/13/opinion/13wegman-illo-sub/11wegman-illo-sub-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/13/opinio