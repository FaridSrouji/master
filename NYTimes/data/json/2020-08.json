': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Sullivan, Jacob J (1976- )', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-08-25T19:00:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Emma Ashford', 'person': [{'firstname': 'Emma', 'middlename': None, 'lastname': 'Ashford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/70aff928-0bc1-5c67-ad7b-6b6537cdfc19', 'word_count': 1107, 'uri': 'nyt://article/70aff928-0bc1-5c67-ad7b-6b6537cdfc19'}, {'abstract': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'web_url': 'https://www.nytimes.com/2020/08/25/style/tiny-modern-love-stories-i-asked-my-husband-to-leave.html', 'snippet': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'lead_paragraph': 'Our house in Gloucestershire, England, is full of flowers that Dad buys for Mum. She’s allergic to lilies but adores every other kind of plant, tree or foliage. They fill our kitchen. Whenever a bunch of flowers dies, Mum delights in opening the windows and flinging the flowers onto the grass below to decompose and rejoin the earth. Dad knows flowers can’t decompose on the lawn but cannot bear to spoil Mum’s joy in being part of this circle of life. So, he sneaks outside, takes the dead flowers and puts them in the compost bin. — Lucy Hicks Beach', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO4/00TINYLOVE-ILLO4-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/07/29/fashion/00TINYLOVE-ILLO4/00TINYLOVE-ILLO4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO4/00TINYLOVE-ILLO4-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO4/00TINYLOVE-ILLO4-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO4/00TINYLOVE-ILLO4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/07/29/fashion/00TINYLOVE-ILLO4/00TINYLOVE-ILLO4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO4/00TINYLOVE-ILLO4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiny Love Stories: ‘I Asked My Husband to Leave for a Week’', 'kicker': 'Modern Love', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Love (Emotion)'