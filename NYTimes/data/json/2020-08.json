, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Qualcomm Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cellular Telephones', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': '5G (Wireless Communications)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Chips', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Trade Commission', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Koh, Lucy H', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-08-11T19:22:13+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Don Clark', 'person': [{'firstname': 'Don', 'middlename': None, 'lastname': 'Clark', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30de8c77-71ef-528f-b7c2-5134370f1d1b', 'word_count': 461, 'uri': 'nyt://article/30de8c77-71ef-528f-b7c2-5134370f1d1b'}, {'abstract': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'web_url': 'https://www.nytimes.com/2020/08/11/style/tiny-modern-love-stories-coronavirus-what-that-silence-told-me.html', 'snippet': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'lead_paragraph': 'Kim Jong-un wasn’t to blame. It turned out to be an employee error at the Hawaii Emergency Management Services that triggered a false North Korean missile alarm sent to those in the state, including my husband. He and his colleagues at the medical conference stopped discussing ocular herpes and took shelter. For 38 minutes, they faced their own imminent deaths. I wonder who he called or texted during that time; it wasn’t me. After a while, I couldn’t ignore what that silence told me. He didn’t even feel compelled to say goodbye to me, so that was goodbye. — Jennifer Byrne', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO3/00TINYLOVE-ILLO3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/07/29/fashion/00TINYLOVE-ILLO3/00TINYLOVE-ILLO3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO3/00TINYLOVE-ILLO3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO3/00TINYLOVE-ILLO3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO3/00TINYLOVE-ILLO3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/07/29/fashion/00TINYLOVE-ILLO3/00TINYLOVE-ILLO3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/07/29/fashion/00TINYLOVE-ILLO3/00TINYLOVE-ILLO3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiny Love Stories: ‘I Couldn’t Ignore What That Silence Told Me’', 'kicker': 'Modern Love', 'content_kicker': None, 'print_