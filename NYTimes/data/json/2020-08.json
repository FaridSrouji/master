 Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/23/nyregion/23nyvirus-subwayvandalism/23nyvirus-subwayvandalism-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/23/nyregion/23nyvirus-subwayvandalism/23nyvirus-subwayvandalism-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/23/nyregion/23nyvirus-subwayvandalism/23nyvirus-subwayvandalism-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/23/nyregion/23nyvirus-subwayvandalism/23nyvirus-subwayvandalism-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/23/nyregion/23nyvirus-subwayvandalism/23nyvirus-subwayvandalism-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/23/nyregion/23nyvirus-subwayvandalism/23nyvirus-subwayvandalism-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/23/nyregion/23nyvirus-subwayvandalism/23nyvirus-subwayvandalism-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Smashed Windows on Subway Cars Have Cost the M.T.A. $300,000', 'kicker': None, 'content_kicker': None, 'print_headline': 'Subway Windows Are Being Smashed By the Hundreds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name