vision', 'byline': {'original': 'By Lauren Messman', 'person': [{'firstname': 'Lauren', 'middlename': None, 'lastname': 'Messman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/52617c69-050a-511c-94b8-431af9e6e682', 'word_count': 494, 'uri': 'nyt://article/52617c69-050a-511c-94b8-431af9e6e682'}, {'abstract': 'How do prey animals stay safe in a world out to get them? And how would I?', 'web_url': 'https://www.nytimes.com/2020/08/02/sunday-review/horse-crazy-nir-language.html', 'snippet': 'How do prey animals stay safe in a world out to get them? And how would I?', 'lead_paragraph': 'Horses talk, but not like Mr. Ed. A horse may be trained to respond to “whoa” and “giddy up,” but if you speak to a horse, you’re not speaking in horse. They converse mostly through body language, and their most visible correspondence is a sign language of ears.', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'To Break a Horse, and a Woman', 'kicker': 'news analysis', 'content_kicker': None, 'print_headline': 'To Break a Horse, And a Woman', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Horses', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Animal Cognition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deer', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Robberies and Thefts', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Nir, Sarah Maslin', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Roberts, Monty', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Assaults', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-08-02T05:00:08+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Sunday Review', 'byline': {'original': 'By Sarah