k': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Staten Island (NYC)', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-08-14T09:00:33+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Robert Sullivan and Jade Doskow', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jade', 'middlename': None, 'lastname': 'Doskow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a10c7226-3129-553c-a946-920014397a41', 'word_count': 2269, 'uri': 'nyt://article/a10c7226-3129-553c-a946-920014397a41'}, {'abstract': 'A new generation of activists is trying to figure out where to concentrate its efforts. Residential desegregation is the final frontier.', 'web_url': 'https://www.nytimes.com/2020/08/14/opinion/sunday/blm-residential-segregation.html', 'snippet': 'A new generation of activists is trying to figure out where to concentrate its efforts. Residential desegregation is the final frontier.', 'lead_paragraph': 'Last year in San Mateo, Calif., a history teacher at Hillsdale High School conducted a mock hearing of South Africa’s Truth and Reconciliation Commission. Sophia Heath, then a freshman, played an anti-apartheid lawyer. She recalls that she “was really excited and that was the beginning of where my activism started.” On the web, she found Coalition Z, a youth group that registers voters and presses officials to combat climate change, provide more equitable school funding and enact gun control. Ms. Heath started a local chapter.', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/16/opinion/sunday/14RothsteinPrint/14RothsteinPrin