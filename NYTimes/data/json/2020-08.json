ds': [{'name': 'subject', 'value': 'Lacrosse', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Draft and Recruitment (Sports)', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-08-13T09:00:25+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Joe Drape and Jeré Longman', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Drape', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jeré', 'middlename': None, 'lastname': 'Longman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cb0332b5-294d-5583-8cc5-424cda0c7039', 'word_count': 1600, 'uri': 'nyt://article/cb0332b5-294d-5583-8cc5-424cda0c7039'}, {'abstract': 'The story of her career can be explained, in part, by a series of dramatic moments during congressional hearings and primary debates. Here are five of them.', 'web_url': 'https://www.nytimes.com/2020/08/13/us/politics/kamala-harris-pence-debate.html', 'snippet': 'The story of her career can be explained, in part, by a series of dramatic moments during congressional hearings and primary debates. Here are five of them.', 'lead_paragraph': 'The story of the political career of Kamala Harris can be told, in part, by videotape. Ms. Harris has risen to public attention — and more important, risen to the attention of Joseph R. Biden Jr., who picked her as his running mate on Tuesday — because of a series of often dramatic moments during congressional hearings, town halls and primary debates. Here are five of them, with our commentary.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/14/us/politics/14HARRIS-AN