Large.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Perfect the Art of Pickling and Ponder a Night of Poetry', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pack Your Week With New Poetry And Pickling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Content Type: Service', 'rank': 1, 'major': 'N'}], 'pub_date': '2020-08-08T15:00:06+0000', 'document_type': 'article', 'news_desk': 'AtHome', 'section_name': 'At Home', 'byline': {'original': 'By Adriana Balsamo and Hilary Moss', 'person': [{'firstname': 'Adriana', 'middlename': None, 'lastname': 'Balsamo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Hilary', 'middlename': None, 'lastname': 'Moss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd59c201-bd13-51e0-a0e6-dc6de35a42fa', 'word_count': 619, 'uri': 'nyt://article/dd59c201-bd13-51e0-a0e6-dc6de35a42fa'}, {'abstract': '100 years ago, Mamie Smith recorded a seminal blues hit that gave voice to outrage at violence against Black Americans.', 'web_url': 'https://www.nytimes.com/2020/08/08/opinion/sunday/crazy-blues-mamie-smith.html', 'snippet': '100 years ago, Mamie Smith recorded a seminal blues hit that gave voice to outrage at violence against Black Americans.', 'lead_paragraph': 'On Aug. 10, 1920, two African-American musicians, Mamie Smith and Perry Bradford, went into a New York studio and changed the course of music history. Ms. Smith, then a modestly successful singer from Cincinnati who had made only one other record, a sultry ballad that fizzled in the marketplace, recorded a new song by Mr. Bradford called “Crazy Blues.” A boisterous cry of outrage by a woman driven mad by mistreatment, the song spoke with urgency and fire to Black listeners across the country who had been ravaged by the abuses of race-hate groups, the police and military forces in the preceding year — the notorious “Red Summer” of 1919.', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/09/opinion/08hajdu/merlin_55302586_2b17a26d-671b-4ba0-b149-c51bad2394a2-articleLarge.jpg', 'height': 829, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/09/opinion/08hajdu/merlin_55302586_2b17a26d-671b-4ba0-b149-c51bad2394a2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 829}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/09/opinion/08hajdu/merlin_55302586_2b17a26d-671b-4ba0-b149-c51bad2394a2-jumbo.jpg', 'height': 1024, 'width': 742, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/09/opinion/08hajdu/merlin_55302586_2b17a26d-671b-4ba0-b149-c51bad2394a2-superJumbo.jpg', 'height': 2048, 'width': 1483, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/09/opinion/08hajdu/08hajdu-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/09/opinion/08hajdu/08hajdu-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/09/opinion/08hajdu/08hajdu-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Song That Changed Music Forever', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Song That Changed Music Forever', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blues Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Mamie (1891-1946)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Crazy Blues (Song)', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-08-08T15:00:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By David Hajdu', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Hajdu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/5063f88d-4712-5141-9d70-53b4a0d78431', 'word_count': 913, 'uri': 'nyt://article/5063f88d-4712-5141-9d70-53b4a0d78431'}, {'abstract': 'It’s one of the best performing assets in the world this year. That’s not a great sign.', 'web_url': 'https://www.nytimes.com/2020/08/08/opinion/gold-investment-coronavirus.html', 'snippet': 'It’s one of the best performing assets in the world this year. That’s not a great sign.', 'lead_paragraph': 'Gold bugs — investors perpetually bullish on gold — have long been seen as a paranoid fringe of the financial world, holding the shiny asset as a hedge against a disaster they always think is near. But lately, they appear to be on to something. This year, gold is the best performing traditional asset in the world. Its price just topped $2,000 an ounce for the first time. From serious investors to newly minted day traders, everyone is talking up its virtues.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None