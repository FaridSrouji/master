sons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-08-28T23:00:14+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': "By Damon Winter and Margaret O'Mara", 'person': [{'firstname': 'Damon', 'middlename': None, 'lastname': 'Winter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Margaret', 'middlename': None, 'lastname': "O'Mara", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/2c0ae539-4bee-5a9c-90ca-0dd67ccd74a4', 'word_count': 935, 'uri': 'nyt://article/2c0ae539-4bee-5a9c-90ca-0dd67ccd74a4'}, {'abstract': 'Fox News dominated ratings for the Republican convention, and MSNBC was the clear No. 1 for the Democrats’ gathering.', 'web_url': 'https://www.nytimes.com/2020/08/28/business/media/trump-biden-convention-ratings.html', 'snippet': 'Fox News dominated ratings for the Republican convention, and MSNBC was the clear No. 1 for the Democrats’ gathering.', 'lead_paragraph': 'Americans who watched the political conventions on television opted for news networks with partisan fan bases to a degree unseen in recent years, another sign of an increasingly divided electorate as the nation hurtles toward the November election.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/28/business/28partisan-ratings-01/28partisan-ratings-01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/28/business/28partisan-ra