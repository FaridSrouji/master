Standard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/21/us/politics/21DNC-p1/20biden-pic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/21/us/politics/21DNC-p1/20biden-pic-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Watch the Democratic National Convention', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Democratic National Convention', 'rank': 2, 'major': 'N'}], 'pub_date': '2020-08-20T09:00:19+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Maggie Astor', 'person': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'Astor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ac8ce02-99a0-54ad-9f30-fb218c06115d', 'word_count': 648, 'uri': 'nyt://article/9ac8ce02-99a0-54ad-9f30-fb218c06115d'}, {'abstract': 'With Kamala Harris accepting her nomination, Nancy Pelosi, Hillary Clinton and others lauded the advancement of women in the political process, but said there was still much ground to be covered.', 'web_url': 'https://www.nytimes.com/2020/08/20/us/politics/democratic-convention-womens-suffrage.html', 'snippet': 'With Kamala Harris accepting her nomination, Nancy Pelosi, Hillary Clinton and others lauded the advancement of women in the political process, but said there was still much ground to be covered.', 'lead_paragraph': 'As America marked the centennial of the 19th Amendment, Wednesday night’s installment of the Democratic National Convention embraced the milestone for women’s suffrage, with nods to the movement’s complicated history — only white women won the vote at first — and tributes to women who had “broken the marble ceiling,” in the words of the first female speaker of the House, Nancy Pelosi.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/09/19/us/politics/19-breakouts-suffrage/merlin_175924836_2ad758a6-06a1-4369-bfe7-d66e7440dff9-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/09/19/us/politics/19-breakouts-suffrage/merlin_175924836_2ad758a6-06a1-4369-bfe7-d66e7440dff9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/09/19/us/politics/19-breakouts-suffrage/merlin_175924836_2ad758a6-06a1-4369-bfe7-d66e7440dff9-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/09/19/us/politics/19-breakouts-suffrage/merlin_175924836_2ad758a6-06a1-4369-bfe7-d66e7440dff9-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/09/19/us/politics/19-breakouts-suffrage/19-breakouts-suffrage-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/09/19/us/politics/19-breakouts-suffrage/19-breakouts-suffrage-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge