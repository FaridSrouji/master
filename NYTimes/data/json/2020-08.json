/science/25SCI-HBOMB2/25SCI-HBOMB2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Video Shows Largest Hydrogen Bomb Ever Exploded', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Soviet H-Bomb: An Explosion as Powerful as 3,333 Hiroshimas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hydrogen', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'USSR (Former Soviet Union)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cold War Era', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Classified Information and State Secrets', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Rosatom', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-science', 'rank': 11, 'major': 'N'}], 'pub_date': '2020-08-25T16:58:49+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By William J. Broad', 'person': [{'firstname': 'William', 'middlename': 'J.', 'lastname': 'Broad', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8efe45f-3723-565d-a2de-9737bad6dade', 'word_count': 564, 'uri': 'nyt://article/e8efe45f-3723-565d-a2de-9737bad6dade'}, {'abstract': 'Employees of the radio station said they were shocked to see a colleague known as Paddy Duke in a new HBO documentary about the racist murder of a Brooklyn teenager in 1989.', 'web_url': 'https://www.nytimes.com/2020/08/25/arts/music/paddy-duke-yusuf-hawkins.html', 'snippet': 'Employees of the radio station said they were shocked to see a colleague known as Paddy Duke in a new HBO documentary about the racist murder of a Brooklyn teenager in 1989.', 'lead_paragraph': 'To those at Hot 97, the beloved and influential hip-hop radio station in New York, the man known as Paddy Duke was an upbeat and positive presence, working largely behind the scenes but earning frequent on-air shout-outs for more than 25 years. It was only in recent days, veterans of the station said, that they learned about a disturbing chapter in their co-worker’s past.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/26/arts/24paddy1/merlin_175435323_0aadde14-092a-4308-acd3-68caa1dc2f4e-articleLarge.jpg', 'height': 316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/26/arts/24paddy1/merlin_175435323_0aadde14-092a-4308-acd3-68caa1dc2f4e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/26/arts/24paddy1/merlin_175435323_0aadde14-092a-4308-acd3-68caa1dc2f4e-jumbo.jpg', 'height': 540, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/26/arts/24paddy1/merlin_175435323_0aadde14-092a-4308-acd3-68caa1dc2f4e-superJumbo.jpg', 'height': 1079, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/26/arts/24paddy1/24paddy1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail'