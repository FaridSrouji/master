: 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/04/science/03BRODY-STRANGERS-illo/03BRODY-STRANGERS-illo-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/04/science/03BRODY-STRANGERS-illo/03BRODY-STRANGERS-illo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/04/science/03BRODY-STRANGERS-illo/03BRODY-STRANGERS-illo-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/04/science/03BRODY-STRANGERS-illo/03BRODY-STRANGERS-illo-superJumbo.jpg', 'height': 1302, 'width': 1965, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/04/science/03BRODY-STRANGERS-illo/03BRODY-STRANGERS-illo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/04/science/03BRODY-STRANGERS-illo/03BRODY-STRANGERS-illo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/04/science/03BRODY-STRANGERS-illo/03BRODY-STRANGERS-illo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Benefits of Talking to Strangers', 'kicker': 'Personal Health', 'content_kicker': None, 'print_headline': 'The Weak Ties That Bind', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 