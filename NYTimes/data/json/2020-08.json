name': 'subject', 'value': 'United States Politics and Government', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-08-20T05:25:48+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nilo Tabrizy and Dmitriy Khavin', 'person': [{'firstname': 'Nilo', 'middlename': None, 'lastname': 'Tabrizy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Dmitriy', 'middlename': None, 'lastname': 'Khavin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/e7587df8-1e4a-574a-b930-f7d67cb48dd8', 'word_count': 0, 'uri': 'nyt://video/e7587df8-1e4a-574a-b930-f7d67cb48dd8'}, {'abstract': 'The prominent opposition leader was reported to be in serious but stable condition in intensive care in Siberia after his flight to Moscow was forced to make an emergency landing.', 'web_url': 'https://www.nytimes.com/2020/08/20/world/europe/navalny-poison-russia.html', 'snippet': 'The prominent opposition leader was reported to be in serious but stable condition in intensive care in Siberia after his flight to Moscow was forced to make an emergency landing.', 'lead_paragraph': 'MOSCOW — Booked on an early morning flight back to Moscow, Aleksei A. Navalny began his day with a rushed breakfast — just a cup of tea in a plastic cup — at the airport in the Siberian city of Tomsk. Soon after his flight took off Thursday, he rushed to the toilet feeling violently ill.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/20/world/20navalny-01/20navalny-01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/20/world/20navalny-01/20navalny-01-articleLa