 'rank': 4, 'major': 'N'}], 'pub_date': '2020-08-13T20:04:14+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Seth Mydans', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Mydans', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/1539030d-a8a7-53a9-b7a0-7f63eda9cf24', 'word_count': 563, 'uri': 'nyt://article/1539030d-a8a7-53a9-b7a0-7f63eda9cf24'}, {'abstract': 'The Houston rapper and singer has been making music with a close-knit team for five years. A 44-second track released in July brought his message to a larger audience.', 'web_url': 'https://www.nytimes.com/2020/08/13/arts/music/tobe-nwigwe-breonna-taylor.html', 'snippet': 'The Houston rapper and singer has been making music with a close-knit team for five years. A 44-second track released in July brought his message to a larger audience.', 'lead_paragraph': 'HOUSTON —\xa0Tobe Nwigwe has spent five years as an independent rapper and singer on the Houston scene, building an audience — including fans like Erykah Badu and Michelle Obama — with weekly song drops that unfailingly arrive with a brand-new video. His plan has always been consistency, not virality. But sudden, unexpected fame arrived last month after he released a track that called attention to the police killing of Breonna Taylor in Kentucky.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/15/arts/13nwigwe3/merlin_175548441_bd060583-cec8-4564-94d1-d305d753ca6e-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/15/arts/13nwigwe3/merlin_175548441_bd060583-cec8-4564-94d1-d305d753ca6e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/15/arts/13nwigwe3/merlin_175548441_bd060583-cec8-4564-94d1-d305d753ca6e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/15/arts/13nwigwe3/merlin_175548441_bd060583-cec8-4564-94d1-d305d753ca6e-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/15/arts/13nwigwe3/13nwigwe3-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/15/arts/13nwigwe3/13nwigwe3-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/15/arts/13nwigwe3/13nwigwe3-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tobe Nwigwe Never Planned to Go Viral. Then He Rapped About Breonna Taylor.', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Close-Knit Team Lifts a Conscientious Rapper', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'I Need You To (Breonna Taylor) (Song)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nwigwe, Tobe', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nwigwe, Fat', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Grant, LaNell (Music Producer)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Houston (Tex)', 'rank': 6, 'major': 'N'}]