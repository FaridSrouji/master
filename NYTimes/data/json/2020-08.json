-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/20/world/00beirut-youth-dispatch/00beirut-youth-dispatch-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Desperate to Leave Beirut, Young Lebanese Are Also the Ones Fixing It', 'kicker': 'Beirut Dispatch', 'content_kicker': None, 'print_headline': 'Many Long to Flee Their Blast-Tattered Capital. Meanwhile, They Fix It.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Beirut, Lebanon, Explosions (2020)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Volunteers and Community Service', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Beirut (Lebanon)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Lebanon', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-08-27T09:00:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Vivian Yee', 'person': [{'firstname': 'Vivian', 'middlename': None, 'lastname': 'Yee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/01cd770d-87ff-5f50-934d-8bfa1403943f', 'word_count': 1340, 'uri': 'nyt://article/01cd770d-87ff-5f50-934d-8bfa1403943f'}, {'abstract': 'Budget cuts have left some of New York City’s green spaces with unmown lawns, unemptied garbage cans and littered playgrounds.', 'web_url': 'https://www.nytimes.com/2020/08/27/nyregion/nyc-parks-trash.html', 'snippet': 'Budget cuts have left some of New York City’s green spaces with unmown lawns, unemptied garbage cans and littered playgrounds.', 'lead_paragraph': 'In a playground in the Morrisania section of the Bronx on a recent afternoon, two parents kept their toddler strapped in her stroller, afraid she might pick up the hamburger wrappers,  cigarettes or hypodermic needle lying on the pavement.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/25/nyregion/00nyvirus-parkstrash1/00nyvirus-parkstrash1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/25/nyregion/00nyvirus-parkstrash1/00nyvirus-parkstrash1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/25/nyregion/00nyvirus-parkstrash1/00nyvirus-parkstrash1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/25/nyregion/00nyvirus-parkstrash1/00nyvirus-parkstrash1-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/25/nyregion/00nyvirus-parkstrash1/00nyvirus-parkstrash1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/25/nyregion/00nyvirus-parkstrash1/00nyvirus-parkstrash1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/25/nyregion/00nyvirus-parkstrash1/00nyvirus-parkstrash1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trash Piles Up in Parks, Just When New Yorkers Need Them the Most', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pandemic Budget Cuts Take a Toll on City Parks Just as Use Is Soaring', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parks and Other Recreation Areas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Waste Materials and Disposal', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Budgets and Budgeting', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Parks and Recreation Department (NYC)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-08-27T09:00:26+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sarah Maslin Nir', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d044021-9279-5e7a-924d-df9c0dff18d2', 'word_count': 1220, 'uri': 'nyt://article/1d044021-9279-5e7a-924d-df9c0dff18d2'}, {'abstract': 'About two dozen states plan to host college football games this season. With thousands of fans expected for many of them, organizers are trying to balance public health with tradition.', 'web_url': 'https://www.nytimes.com/2020/08/27/sports/college-football-fans-stadiums.html', 'snippet': 'About two dozen states plan to host college football games this season. With thousands of fans expected for many of them, organizers are trying to balance public health with tradition.', 'lead_paragraph': 'At Texas A&M, the football stadium that normally holds about 110,000 people may allow fewer than 28,000 to start this season. Alabama and Auburn banned tailgating, and so did Mississippi’s governor. Marching bands are forbidden on the Atlantic Coast Conference’s fields, suites at Texas will not have self-service buffets and from Baylor to Boston College, hand sanitizer will be more common than printed tickets.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'College Football’s Pandemic Playbook: Fewer Fans, No Tailgating, No Bands', 'kicker': None, 'content_kicker': None, 'print_headline': 'Officials and Players Get Ready Not to Hear the Roar of the Crowd', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football (College)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stadiums and Arenas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus Reopenings', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-08-27T09:00:27+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Alan Blinder', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Blinder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c1c9f2b-2c10-5378-a9fa-95577e63fcd3', 'word_count': 1369, 'uri': 'nyt://article/3c1c9f2b-2c10-5378-a9fa-95577e63fcd3'}, {'abstract': 'The chip maker was selected for an Energy Department project meant to show American tech independence. But problems at Intel have thrown a wrench into the effort.', 'web_url': 'https://www.nytimes.com/2020/08/27/technology/intel-aurora-supercomputer.html', 'snippet': 'The chip maker was selected for an Energy Department project meant to show American tech independence. But problems at Intel have thrown a wrench into the effort.', 'lead_paragraph': 'OAKLAND, Calif. — When it selected Intel to help build a $500 million supercomputer last year, the Energy Department bet that computer chips made in the United States could help counter a technology challenge from China.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/29/business/00JPintel2-print/merlin_176159121_2bdf7841-530f-44eb-a7d4-17e1afae6cb2-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/08/29/business/00JPintel2-print/merlin_176159121_2bdf7841-530f-44eb-a7d4-17e1afae6cb2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/29/business/00JPintel2-print/merlin_176159121_2bdf7841-530f-44eb-a7d4-17e1afae6cb2-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/29/business/00JPintel2-print/merlin_176159121_2bdf7841-530f-44eb-a7d4-17e1afae6cb2-superJumbo.jpg', 'height': 900, 'width': 1600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/29/business/00JPintel2-print/00intel1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/08/29/business/00JPintel2-print/00intel1-thumbStandard.jpg', 'thumbn