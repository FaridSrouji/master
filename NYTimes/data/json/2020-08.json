ing/03burner-bird/03burner-bird-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/08/05/dining/03burner-bird/03burner-bird-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Marcus Samuelsson’s Streetbird Delivers to Your Door', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Sup: Marcus Samuelsson’s  Streetbird Delivers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Samuelsson, Marcus', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Streetbird Rotisserie (Manhattan, NY, Restaurant)', 'rank': 2, 'major': 'N'}], 'pub_date': '2020-08-03T21:30:41+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5072b6c7-2e58-5f91-975c-f1a99b59bc98', 'word_count': 100, 'uri': 'nyt://article/5072b6c7-2e58-5f91-975c-f1a99b59bc98'}, {'abstract': 'The Tennessee Valley Authority, an electric utility, quickly said it would reconsider its move to shift some work to contractors outside the United States.', 'web_url': 'https://www.nytimes.com/2020/08/03/us/politics/trump-tennessee-valley-authority.html', 'snippet': 'The Tennessee Valley Authority, an electric utility, quickly said it would reconsider its move to shift some work to contractors outside the United States.', 'lead_paragraph': 'WASHINGTON — President Trump abruptly announced on Monday the firing of two members of the Tennessee Valley Authority’s board of directors and demanded that the electric utility’s chief executive reverse what he