en-obit1/merlin_14334447_4b896409-b4b4-4d4f-b671-88388792fca6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/obituaries/21Loewen-obit1/merlin_14334447_4b896409-b4b4-4d4f-b671-88388792fca6-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/obituaries/21Loewen-obit1/merlin_14334447_4b896409-b4b4-4d4f-b671-88388792fca6-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/obituaries/21Loewen-obit1/merlin_14334447_4b896409-b4b4-4d4f-b671-88388792fca6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/21/obituaries/21Loewen-obit1/merlin_14334447_4b896409-b4b4-4d4f-b671-88388792fca6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/obituaries/21Loewen-obit1/merlin_14334447_4b896409-b4b4-4d4f-b671-88388792fca6-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'James W. Loewen, Who Challenged How History Is Taught, Dies at 79', 'kicker': None, 'content_kicker': None, 'print_headline': 'James W. Loewen, 79, Who Disputed History Lessons, Dies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Loewen, James W', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'History (Academic Subject)', 'rank': 3, 'major': 'N'}