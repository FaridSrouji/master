-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/15/fashion/15MINI-GraceyDewi/15MINI-GraceyDewi-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/15/fashion/15MINI-GraceyDewi/15MINI-GraceyDewi-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Matching on Words With Friends, a ‘Match of My Life’', 'kicker': 'mini-vows', 'content_kicker': None, 'print_headline': 'A Whole Lifetime of ‘Words’ Ahead', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 1, 'major': 'N'}], 'pub_date': '2021-08-13T09:00:08+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'subsection_name': 'Weddings', 'byline': {'original': 'By Judy Mandell', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Mandell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d2f36589-c733-5024-9de8-dd5091f7672a', 'word_count': 632, 'uri': 'nyt://article/d2f36589-c733-5024-9de8-dd5091f7672a'}, {'abstract': 'Mary Devon Dietzen was reluctant to ever date anyone at work — until she met Lance McDonald almost four years ago.', 'web_url': 'https://www.nytimes.com/2021/08/13/style/mary-devon-dietzen-lance-mcdonald-wedding.html', 'snippet': 'Mary Devon Dietzen was reluctant to ever date anyone at work — until she met Lance McDonald almost four years ago.', 'lead_paragraph': 'Mary Devon Dietzen thought she knew everyone at the RAND Corporation in Santa Monica, Calif., describing herself as a regular organizer of happy hours and other get-togethers with colleagues. But she didn’t know La