type_of_material': 'News', '_id': 'nyt://article/0c8831b3-458b-5f86-a11e-b538cae8d661', 'word_count': 1104, 'uri': 'nyt://article/0c8831b3-458b-5f86-a11e-b538cae8d661'}, {'abstract': 'In a broadcasting career that began when he was 17, he was a producer, editor and news director — and a voice listeners trusted.', 'web_url': 'https://www.nytimes.com/2021/08/11/business/media/neal-conan-dead.html', 'snippet': 'In a broadcasting career that began when he was 17, he was a producer, editor and news director — and a voice listeners trusted.', 'lead_paragraph': 'Neal Conan, a radio virtuoso who as a rigorous journalist and congenial raconteur anchored NPR’s flagship call-in program, “Talk of the Nation,” for 12 years, died on Tuesday at his farm in Hawi, Hawaii. He was 71.', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/12/obituaries/11Conan-new/11Conan-new-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/12/obituaries/11Conan-new/11Conan-new-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/12/obituaries/11Conan-new/11Conan-new-jumbo.jpg', 'height': 497, 'width': 745, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/12/obituaries/11Conan-new/11Conan-new-superJumbo.jpg', 'height': 497, 'width': 745, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/12/obituaries/11Conan-new/11Conan-new-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'le