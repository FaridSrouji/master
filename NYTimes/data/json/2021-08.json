or': 'N'}, {'name': 'organizations', 'value': 'Houston Community College', 'rank': 4, 'major': 'N'}], 'pub_date': '2021-08-30T09:00:08+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'byline': {'original': 'By Adam Liptak', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Liptak', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3595467c-2479-54d4-a349-84cbfa584f50', 'word_count': 861, 'uri': 'nyt://article/3595467c-2479-54d4-a349-84cbfa584f50'}, {'abstract': 'Global military dominance has not lived up to its hype for American interests.\xa0', 'web_url': 'https://www.nytimes.com/2021/08/30/opinion/american-military-afghanistan.html', 'snippet': 'Global military dominance has not lived up to its hype for American interests.\xa0', 'lead_paragraph': 'For much of its history, the United States was a big country with a small peacetime military. World War II changed that permanently: American leaders decided that a country with new global obligations needed a very large peacetime military, including a nuclear arsenal and a worldwide network of bases. They hoped overwhelming military capacity would avert another world war, deter adversaries and encourage foreign countries to follow our wishes.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/01/opinion/27Suri/merlin_34912510_e1522b19-1976-4985-bbfa-461c1b6ef2f2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/01/opinion/27Suri/merlin_34912510_e1522b19-1976-4985-bbfa-461c1b6ef2f2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'im