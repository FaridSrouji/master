omo1-promo/03cuomo1-promo-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/03/opinion/03cuomo1-promo/03cuomo1-promo-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/03/opinion/03cuomo1-promo/03cuomo1-promo-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'You Should Resign, Governor Cuomo', 'kicker': 'The Editorial Board', 'content_kicker': None, 'print_headline': 'Governor Cuomo, You Should Resign', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Governors (US)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sexual Harassment', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Hazards and Violations', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'internal-storyline-no', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-08-04T01:08:11+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/1a80923e-c35d-535c-91ad-ede3f980d1bf', 'word_count': 679, 'uri': 'nyt://article/1a80923e-c35d-535c-91ad-ede3f980d1bf'}, {'abstract': 'Calls of “help” and “over here” can be heard in the footage recorded by police officers who responded after much of the condominium complex in Surfside fell down, killing 98 people.', 'web_url': 'https://www.nytimes.com/2021/08/03/us/surfside-collapse-bodycam-video.html', 'snippet': 'Calls of “help” and “over here” can be heard in the footage recorded by police officers who responded after much of the condominium complex in Surfside fell down, killing 98 people.', 'lead_paragraph': 'A mother called to her son from a balcony. A woman yelled for help from a parking garage. And a security guard who called 911 said she was not sure how she made it out.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/03/us/03xp-surfside/03xp-surfside-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/03/us/03xp-surfside/03xp-surfside-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/03/us/03xp-surfside/03xp-surfside-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/03/us/03xp-surfside/03xp-surfside-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/03/us/03xp-surfside/03xp-surfside-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/03/us/03xp-surfside/03xp-surfside-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/03/us/03xp-surfside/03xp-surfside-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Body Camera Video S