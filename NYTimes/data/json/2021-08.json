'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7e5609fe-1bc7-5873-adb8-29f76e4ccf93', 'word_count': 672, 'uri': 'nyt://article/7e5609fe-1bc7-5873-adb8-29f76e4ccf93'}, {'abstract': 'Jennifer Hudson plays Aretha Franklin in a movie that follows many of the usual biographical beats but finds its own groove.', 'web_url': 'https://www.nytimes.com/2021/08/12/movies/respect-review-aretha-franklin.html', 'snippet': 'Jennifer Hudson plays Aretha Franklin in a movie that follows many of the usual biographical beats but finds its own groove.', 'lead_paragraph': 'Ray Charles said that Aretha Franklin “sang from her inners.” For her father, C.L. Franklin, she was “a stone singer.” That’s a good description for a great singer whose voice did something that even some brilliant, technically virtuosic vocalists can’t do. When Franklin was at her most sublime, her voice seemed to give shape to the entirety of human feeling — to the joy and the despair — so much so that it seemed as if she were birthing a twinned version of herself with each breath and soul-stirring note.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/13/arts/12respect1/12respect1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/13/arts/12respect1/12respect1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/13/arts/12respect1/12respect1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/13/arts/12respect1/12respect1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/13/arts/12respect1/12respect1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/13/arts/12respect1/12respect1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/13/arts/12respect1/12respect1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Respect’ Review: Giving a Queen Her Propers', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Polite Portrait of a Spirit in the Dark', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Respect (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hudson, Jennifer', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tommy, Liesl', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Franklin, Aretha', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Franklin, C L', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Personal Profile', 'rank': 8, 'major': 'N'}], 'pub_date': '2021-08-12T16:59:02+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c7853bb5-8313-54af-897b-6d5d1d024358', 'word_count': 1005, 'uri': 'nyt://article/c7853bb5-8313-54af-897b-6d5d1d024358'}, {'abstract': 'Welcome to our new newsletter dedicated to the delights of vegetarian cooking.', 'web_url': 'https://www.nytimes.com/2021/08/12/dining/3-vegetarian-recipes-that-changed-my-life.html', 'snippet': 'Welcome to our new newsletter dedicated to the delights of vegetarian cooking.', 'lead_paragraph': 'A few weeks ago, a friend sent me the cutest photo of her sweet, pudgy-cheeked baby eating a bit of kale-sauce pasta. The baby was in a high chair, grinning before the wreckage of her dinner — green sauce on her face and hands, bits of pasta up to her elbows. Now that baby knows how to enjoy her food, I thought with admiration.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/07/magazine/07mag-eat1-copy/07mag-07eat-t_CA0-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/07/magazine/07mag-eat1-copy/07mag-07eat-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/07/magazine/07mag-eat1-copy/07mag-07eat-t_CA0-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/07/magazine/07mag-eat1-copy/07mag-07eat-t_CA0-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/07/magazine/07mag-eat1-copy/07mag-eat1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/07/magazine/07mag-eat1-copy/07mag-eat1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/07/magazine/07mag-eat1-copy/07mag-eat1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '3 Recipes That Changed My Life', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Service', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}], 'pub_date': '2021-08-12T17:00:04+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Tejal Rao', 'person': [{'firstname': 'Tejal', 'middlename': None, 'lastname': 'Rao', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f2ed14c7-18ec-50e1-88c4-e70e3096a64a', 'word_count': 600, 'uri': 'nyt://article/f2ed14c7-18ec-50e1-88c4-e70e3096a64a'}, {'abstract': 'The C.D.C.’s advice about masking up again was not easy to parse. Some experts think simpler would have been better.', 'web_url': 'https://www.nytimes.com/2021/08/12/health/covid-masks-cdc.html', 'snippet': 'The C.D.C.’s advice about masking up again was not easy to parse. Some experts think simpler would have been better.', 'lead_paragraph': 'An internal presentation circulated within the Centers for Disease Control and Prevention last month, and eventually obtained by news organizations, offered clear advice for countering the contagious Delta variant: “Given higher transmissibility and current vaccine coverage, universal masking is essential.”', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlar