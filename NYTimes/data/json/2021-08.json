, 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Madness of Crowds (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Penny, Louise', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': '56 Days (Book)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Howard, Catherine Ryan (1982- )', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Family Plot (Book)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Collins, Megan (Author)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Moreno-Garcia, Silvia', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'Velvet Was the Night (Book)', 'rank': 9, 'major': 'N'}], 'pub_date': '2021-08-19T17:29:56+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'byline': {'original': 'By Sarah Weinman', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Weinman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5026c895-25b7-568c-bf17-d0ee17de831e', 'word_count': 812, 'uri': 'nyt://article/5026c895-25b7-568c-bf17-d0ee17de831e'}, {'abstract': 'Joshua Safran’s “Gossip Girl” reboot filmed a scene from an imaginary work by the “Slave Play” playwright. Then the Public Theater commissioned it.', 'web_url': 'https://www.nytimes.com/2021/08/19/theater/jeremy-o-harris-play-gossip-girl.html', 'snippet': 'Joshua Safran’s “Gossip Girl” reboot filmed a scene from an imaginary work by the “Slave Play” playwright. Then the Public Theater commissioned it.', 'lead_paragraph': 'We hear him before we see him come across the screen: Aaron howls and barks then gallops, on all fours, onto a white, wooden thrust stage, ringed on three sides by the audience. This enraged man — the son of Aaron the Moor from “Titus Andronicus” — is stark naked and covered in blood.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/arts/18gossip-harris-2/18gossip-harris-2-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/21/arts/18gossip-harris-2/18gossip-harris-2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/arts/18gossip-harris-2/18gossip-harris-2-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/arts/18gossip-harris-2/18gossip-harris-2-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/arts/18gossip-harris-2/18gossip-harris-2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/21/arts/18gossip-harris-2/18gossip-harris-2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/arts/18gossip-harris-2/18gossip-harris-2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Is Jeremy O. Harris’s Play for ‘Gossip Girl’ Real? Now It Is.', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Imaginary Play, Dreamed Into Existence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'na