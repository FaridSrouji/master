-chicken-corn-tartar-butter-copy/merlin_192666834_caaae15c-aecb-413b-9932-63a991d651fc-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/17/dining/kc-chicken-corn-tartar-butter-copy/merlin_192666834_caaae15c-aecb-413b-9932-63a991d651fc-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/17/dining/kc-chicken-corn-tartar-butter-copy/merlin_192666834_caaae15c-aecb-413b-9932-63a991d651fc-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/17/dining/kc-chicken-corn-tartar-butter-copy/kc-chicken-corn-tartar-butter-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/17/dining/kc-chicken-corn-tartar-butter-copy/kc-chicken-corn-tartar-butter-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/17/dining/kc-chicken-corn-tartar-butter-copy/kc-chicken-corn-tartar-butter-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Get That Corn', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Service', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}], 'pub_date': '2021-08-20T17:10:04+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Emily Weinstein', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': 'Weinstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2ddc08ab-8fb1-5880-92cf-1eaa6d1b4be6', 'word_count': 454, 'uri': 'nyt://article/2ddc08ab-8fb1-5880-92cf-1eaa6d1b4be6'}, {'abstract': 'In the 1990s, they banned the internet. Now they use it to threaten and cajole the Afghan people, in a sign of how they might use technology to build power.', 'web_url': 'https://www.nytimes.com/2021/08/20/technology/afghanistan-taliban-social-media.html', 'snippet': 'In the 1990s, they banned the internet. Now they use it to threaten and cajole the Afghan people, in a sign of how they might use technology to build power.', 'lead_paragraph': 'In one video, a Taliban official reassured female health workers that they could keep their jobs. In another, militants told Sikhs, a minority religious group, that they were free and protected. Still others suggested a new lawfulness in Kabul, with Talib fighters holding looters and thieves at gunpoint.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/20/world/20taliban-socialmedia-1/merlin_193436349_8531c9d3-fc6c-4f9f-8fe4-19d5c6b58b10-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/20/world/20taliban-socialmedia-1/merlin_193436349_8531c9d3-fc6c-4f9f-8fe4-19d5c6b58b10-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/20/world/20taliban-socialmedia-1/merlin_193436349_8531c9d3-fc6c-4f9f-8fe4-19d5c6b58b10-jumbo.jpg', 'height': 683, 'widt