ages/2021/08/16/t-magazine/16tmag-poems/16tmag-poems-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Read T a Poem | Ruby Ibarra', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poetry and Poets', 'rank': 1, 'major': 'N'}], 'pub_date': '2021-08-11T11:00:13+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Angel Zinovieff', 'person': [{'firstname': 'Angel', 'middlename': None, 'lastname': 'Zinovieff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/e3010712-ded5-55e7-8dae-f1dd3a031924', 'word_count': 0, 'uri': 'nyt://video/e3010712-ded5-55e7-8dae-f1dd3a031924'}, {'abstract': 'In the West, Asian musicians have long been marginalized. Now, though, a new generation of women are transforming their respective genres.', 'web_url': 'https://www.nytimes.com/2021/08/11/t-magazine/asian-women-pop-music.html', 'snippet': 'In the West, Asian musicians have long been marginalized. Now, though, a new generation of women are transforming their respective genres.', 'lead_paragraph': 'IN THE FALL of 1959 — 14 years after the United States dropped atomic bombs on Hiroshima and Nagasaki and released Japanese Americans from its domestic internment camps; 13 years after the American territory of the Philippines gained independence; six years after the end of the Korean War; and two months after American soldiers were killed by the Viet Cong just north of Saigon, among the first U.S. casualties in Vietnam — three young women from Seoul appeared on “The Ed Sullivan Show” on CBS. The show was an institution, a live cabaret every Sunday night that reached more than a quarter of all American households with a TV set. The women called themselves the Kim Sisters — evoking the beloved Andrews Sisters from Minnesota, who sold 50 million records in the 1930s and ’40s — but were in fact a cousin, Min Ja (Anglicized as Mia), 17, and two sisters, Sook Ja (later Sue), 21, and Ai-Ja, 18.', 'print_section': 'M2', 'print_page': '124', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/16/t-magazine/16tmag-asianpopstars-slide-3DKN/16tmag-asianpopstars-slide-3DKN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/16/t-magazine/16tmag-asianpopstars-slide-3DKN/16tmag-asianpopstars-slide-3DKN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/16/t-magazine/16tmag-asianpopstars-slide-3DKN/16tmag-asianpopstars-slide-3DKN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/16/t-magazine/16tmag-asianpopstars-slide-3DKN/16tmag-asianpopstars-slide-3DKN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/16/t-magazine/16tmag-asianpopstars-slide-3DKN/16tmag-asianpopstars-slide-3DKN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/16/t-magazine/16tmag-asianpopstars-slide-3DKN/16tmag-asianpopstars-slide-3DKN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/16/t-magazine/16tmag-asianpopstars-s