sub': None}, 'keywords': [], 'pub_date': '2021-08-08T04:15:43+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/7f746f8e-8c2c-5d0f-8dbc-58395f317f03', 'word_count': 46, 'uri': 'nyt://article/7f746f8e-8c2c-5d0f-8dbc-58395f317f03'}, {'abstract': 'Corrections that appeared in print on Saturday, Aug. 7, 2021.', 'web_url': 'https://www.nytimes.com/2021/08/08/pageoneplus/corrections-aug-7-2021.html', 'snippet': 'Corrections that appeared in print on Saturday, Aug. 7, 2021.', 'lead_paragraph': 'An article on Thursday about a debate over presidential war powers misidentified which Senate committee voted on legislation repealing two authorizations for use of military force. It was the Senate Foreign Relations Committee, not the Senate Armed Services Committee.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: Aug. 7, 2021', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2021-08-08T04:16:10+0000', 'document_type': 'article', 'news_desk': 'Corrections', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/29bbb931-f4de-5124-8358-e4e6fd2dce7a', 'word_count': 344, 'uri': 'nyt://article/29bbb931-f4de-5124-8358-e4e6fd2dce7a'}, {'abstract': 'Quotation of the Day for Sunday, August 8, 2021.', 'web_url': 'https://www.nytimes.com/2021/08/08/todayspaper/quotation-of-the-day-cuomo-used-a-movement-for-his-gain.html', 'snippet': 'Quotation of the Day for Sunday, August 8, 2021.', 'lead_paragraph': '“It’s not just about toughening the laws. You also have to change the mind-set of people who may believe that they’re above the law.”', 'print_section': 'A', 'print_page':