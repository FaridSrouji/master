', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/08/fashion/00CulbreathLoney/00CulbreathLoney-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/08/fashion/00CulbreathLoney/00CulbreathLoney-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/08/fashion/00CulbreathLoney/00CulbreathLoney-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/08/fashion/00CulbreathLoney/00CulbreathLoney-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/08/fashion/00CulbreathLoney/00CulbreathLoney-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/08/fashion/00CulbreathLoney/00CulbreathLoney-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/08/fashion/00CulbreathLoney/00CulbreathLoney-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Leaping Into Love and a Life of Spontaneity', 'kicker': 'mini-vows', 'content_kicker': None, 'print_headline': 'Leaping Into Love and a Life of Spontaneity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 1, 'major': 'N'}], 'pub_date': '2021-08-06T09:00:15+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline'