ank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/sports/20mlb-velazquez1-print/merlin_193377510_ffb01500-08ba-40d7-8f0e-4f82d7d4eebe-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/sports/20mlb-velazquez1-print/20mlb-velazquez-top-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/21/sports/20mlb-velazquez1-print/20mlb-velazquez-top-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/21/sports/20mlb-velazquez1-print/20mlb-velazquez-top-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Bronx Kid Is Living Something Wilder Than His Dreams', 'kicker': None, 'content_kicker': None, 'print_headline': 'For a Bronx Native, ‘In Real Life, It Was Way Better’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Velazquez, Andrew (1994- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Personal Profile', 'rank': 4, 'major': 'N'}], 'pub_date': '2021-08-20T11:00:07+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Gary Phillips', 'person': [{'firstname': 'Gary', 'middlename': None, 'lastname': 'Phillips', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39f16864-bb96-50fa-b561-064c295cfd25', 'word_count': 939, 'uri': 'nyt://article/39f16864-bb96-50fa-b561-064c295cfd25'}, {'abstract': 'Building on the legacy of luminaries such as James Baldwin and Josephine Baker, many Black creatives are seeking out new possibilities abroad.', 'web_url': 'https://www.nytimes.com/2021/08/20/t-magazine/black-artists-expatriates.html', 'snippet': 'Building on the legacy of luminaries such as James Baldwin and Josephine Baker, many Black creatives are seeking out new possibilities abroad.', 'lead_paragraph': 'WHEN THE VISUAL artist Ellen Gallagher was 20, she sailed on an oceanography expedition from her home in New England to Martinique. It was 1986, and students in the former French colony were agitating for the right to take qualifying exams to attend university in France. To the sea-weary Gallagher, their protest looked more like a celebration. But she also felt, in this nexus of “Europe and Africa in the Americas,” she says, the “whimsical cruelty” of the imperial powers that had sought to carve up the globe, imposing vast cultural distance between places — predominantly white, Anglophone New England and Black, Francophone Martinique — that were so close you could readily sail between them.', 'print_section': 'M2', 'print_page': '134', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/19/t-magazine/19tmag-blackexpats-slide-6MEV/19tmag-blackexpats-slide-6MEV-articleLarge.jpg', 'height': 487, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/19/t-magazine/19tmag-blackexpats-slide-6MEV/19tmag-blackexpats-slide-6MEV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 487}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/19/t-magazine/19tmag-blackexpats-slide-6MEV/19tmag-blackexpats-slide-6MEV-jumbo.jpg', 'height': 8