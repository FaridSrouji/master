name': 'organizations', 'value': 'New York City Ballet', 'rank': 15, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Oklahoma', 'rank': 16, 'major': 'N'}], 'pub_date': '2021-08-19T14:00:08+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Meryl Cates', 'person': [{'firstname': 'Meryl', 'middlename': None, 'lastname': 'Cates', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8f1fe881-10db-532d-b6f1-7b765926a66c', 'word_count': 1784, 'uri': 'nyt://article/8f1fe881-10db-532d-b6f1-7b765926a66c'}, {'abstract': 'A teenage girl is roped into her estranged aunt’s criminal activities in this psychodrama by the Danish filmmaker Jeanette Nordahl.', 'web_url': 'https://www.nytimes.com/2021/08/19/movies/wildland-review.html', 'snippet': 'A teenage girl is roped into her estranged aunt’s criminal activities in this psychodrama by the Danish filmmaker Jeanette Nordahl.', 'lead_paragraph': 'In “Wildland,” by the Danish filmmaker Jeanette Nordahl, the 17-year-old Ida (Sandra Guldberg Kampp) is roped into her mysterious aunt Bodil’s family business after a car accident kills Ida’s mother. Still in mourning, our soft-spoken yet observant protagonist is eased into the family circle, coming-of-age, so to speak, as the violent reality of their criminal affairs come into view.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/18/arts/wildland1/merlin_193190811_72fa149c-6eab-4800-9320-4d0ac05e2201-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/18/arts/wildland1/merlin_193190811_72fa149c-6eab-4800-9320-4d0ac05e2201-articleLarge.jpg', 'xlargewid