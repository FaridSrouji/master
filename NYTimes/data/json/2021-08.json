eight': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/23/opinion/23kang/23kang-superJumbo.png', 'height': 1080, 'width': 1080, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/23/opinion/23kang/23kang-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/23/opinion/23kang/23kang-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/23/opinion/23kang/23kang-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Zen and the Art of #VanLife Influencing', 'kicker': 'Jay Caspian Kang', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'internal-sub-only', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recreational Vehicles', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Millennial Generation', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Generation Z', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Hippies', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-08-23T19:00:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jay Caspian Kang', 'person': [{'firstname': 'Jay', 'middlename': 'Caspian', 'lastname': 'Kang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/523fd7b4-10dd-5d61-84be-a647c3aa9025', 'word_count': 1990, 'uri': 'nyt://article/523fd7b4-10dd-5d61-84be-a647c3aa9025'}, {'abstract': 'If human capital is an asset, how should Congress measure the payoff?', 'web_url': 'https://www.nytimes.com/2021/08/23/opinion/biden-infrastructure-CBO.html', 'snippet': 'If human capital is an asset, how should Congress measure the payoff?', 'lead_paragraph': 'One justification for the Biden administration’s “care economy” agenda is that it’s an investment in human capital that will pay dividends in the long run. The idea is that spending now on early childhood education and child care will make today’s children into productive workers who will earn more money, pay more taxes and thus help reduce future budget deficits.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/23/opinion/23coy_final2/23coy_final2-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/23/opinion/23coy_final2/23coy_final2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/23/opinion/23coy_final2/23coy_final2-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/23/opinion/23coy_final2/23coy_final2-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/23/opinion/23coy_final2/23coy_final2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'lega