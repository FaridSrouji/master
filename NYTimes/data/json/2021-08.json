.”', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/06/arts/05parody-musicals2/merlin_191858289_584e91ec-ff3e-444e-9701-adb5a672a8de-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/06/arts/05parody-musicals2/merlin_191858289_584e91ec-ff3e-444e-9701-adb5a672a8de-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/06/arts/05parody-musicals2/merlin_191858289_584e91ec-ff3e-444e-9701-adb5a672a8de-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/06/arts/05parody-musicals2/merlin_191858289_584e91ec-ff3e-444e-9701-adb5a672a8de-superJumbo.jpg', 'height': 1198, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/06/arts/05parody-musicals2/05parody-musicals2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/08/06/arts/05parody-musicals2/05parody-musicals2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/06/arts/05parody-musicals2/05parody-musicals2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The One Where It’s a Live Musical Parody of Your Favorite TV Show', 'kicker': None, 'content_kicker': None, 'print_headline': 'Musicals for People Who