'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day: France to Honor Baker With Panthéon Burial', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quote of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2021-08-23T04:07:55+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a53aae0b-ae8b-5321-9068-07d4870ae62f', 'word_count': 64, 'uri': 'nyt://article/a53aae0b-ae8b-5321-9068-07d4870ae62f'}, {'abstract': 'All democratic countries have a stake in the future of  Belarus.', 'web_url': 'https://www.nytimes.com/2021/08/23/opinion/belarus-tikhanovskaya-lukashenko.html', 'snippet': 'All democratic countries have a stake in the future of  Belarus.', 'lead_paragraph': 'Just over a year ago, on Aug. 9, 2020, I stood in Belarus’s presidential election against Aleksandr Lukashenko. The dictator, who has ruled the country for 27 years with an iron fist, stole victory from us, setting off widespread protests. We united in a national pro-democracy movement to demand the release of all political prisoners, an end to state violence and a free and fair election.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/24/opinion/23tikhanovskaya/23tikhanovskaya-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/08/24/opinion/23tikhanovskaya/23tikhanovskaya-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/08/24/opinion/23tikhanovskaya/23tikhanovskaya-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'su