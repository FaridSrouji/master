: {'main': 'Photo Replay: May 15', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-16T02:48:55+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/7accb01c-6350-57bb-bb18-71fc977455b8', 'word_count': 0, 'uri': 'nyt://slideshow/7accb01c-6350-57bb-bb18-71fc977455b8'}, {'abstract': 'Four Democrats were on hand at a ceremony to name a section of Broadway after a Dominican man thought to have been New York’s first non-Indian settler.', 'web_url': 'https://www.nytimes.com/2013/05/16/nyregion/in-washington-heights-4-mayoral-candidates-woo-hispanics.html', 'snippet': 'Four Democrats were on hand at a ceremony to name a section of Broadway after a Dominican man thought to have been New York’s first non-Indian settler.', 'lead_paragraph': 'Bill de Blasio, the public advocate, ventured a few sentences of Spanish. Christine C. Quinn, the City Council speaker, called on Congress to pass immigration legislation. William C. Thompson Jr., a former comptroller, reminded the audience that his grandparents immigrated from the Caribbean. Adolfo Carrión Jr., a former Bronx borough president, simply urged Hispanics to vote.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/16/nyregion/NYC-Mayors/NYC-Mayors-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/16/nyregion/NYC-Mayors/NYC-Mayors-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/16/nyregion/NYC-Mayors/NYC-Mayors-jumbo.jpg', 'height': 682, 'wid