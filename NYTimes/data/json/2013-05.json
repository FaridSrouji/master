.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/03/nyregion/tick-tock-1/tick-tock-1-articleLarge.jpg', 'height': 363, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/03/nyregion/tick-tock-1/tick-tock-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 363}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/03/nyregion/tick-tock-1/tick-tock-1-jumbo.jpg', 'height': 619, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/03/nyregion/tick-tock-1/tick-tock-1-superJumbo.jpg', 'height': 1238, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/03/nyregion/tick-tock-1/tick-tock-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/03/nyregion/tick-tock-1/tick-tock-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/03/nyregion/tick-tock-1/tick-tock-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Diner, a Family and a Murder Plot', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Diner, a Family and a Murder Plot', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Tick Tock Diner (Clifton, NJ, Diner)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Zernike, Kate', 'rank': 2, 'maj