3/06/02/magazine/homesteaders_1024-slide-ZBUT/homesteaders_1024-slide-ZBUT-superJumbo.jpg', 'height': 1127, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/magazine/homesteaders_1024-slide-ZBUT/homesteaders_1024-slide-ZBUT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/06/02/magazine/homesteaders_1024-slide-ZBUT/homesteaders_1024-slide-ZBUT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/magazine/homesteaders_1024-slide-ZBUT/homesteaders_1024-slide-ZBUT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stuck in the Shadow of Affluence', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Foreclosures', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Abandonment (Property)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Anti-Eviction Campaign', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Losier, Toussaint', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fleming, Willie', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-29T11:00:52+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/546e01c2-5b65-5a66-ab9c-579324b659ab', 'word_count': 0, 'uri': 'nyt://slideshow/546e01c2-5b65-5a66-ab9c-579324b659ab'}, {'abstract': 'An innovative campaign to move “home-less people into people-less homes.”', 'web_url': 'https://www.nytimes.com/2013/06/02/magazine/how-chicagos-housing-crisis-ignited-a-new-form-of-activism.html', 'snippet': 'An innovative campaign to move “home-less people into people-less homes.”', 'lead_paragraph': 'On a 100-degree day last summer, on Chicago’s southernmost edge, Willie Fleming, who goes by J. R. (“It stands for Just Righteousness”), crept up to an abandoned ranch house shrouded in overgrown weeds. The overwhelmingly poor and black neighborhood sits beside a 150-acre, 1,500-unit public-housing complex and is about as far — literally and figuratively — from the Loop as you can get and still be in Chicago. Nearly a quarter of the homes in the area had been empty for at least two years. Usually when J. R. scouts for properties to break into and take over, he looks for ones with unmown grass, a sign of vacancy and disregard. But this was excessive. “I don’t come back here without my air gun,” he said, backing away. A young couple next door had set up lawn chairs on the sidewalk. An infant in only a diaper tottered around them. “That’s the dead-dog cemetery,” the man announced, motioning to the ranch house.', 'print_section': 'MM', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/magazine/homesteaders1/homesteaders_600-slide-YVNY-articleLarge.jpg', 'height': 451, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/06/02/magazine/homesteaders1/homesteaders_600-slide-YVNY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 451}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/magazine/homesteaders1/homesteaders_600-slide-YVNY-jumbo.jpg', 'height': 769, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/magazine/homesteaders1/homesteaders_600-slide-YVNY-superJumbo.jpg', 'height': 1539, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/magazine/homesteaders1/homesteaders1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/06/02/magazine/homesteaders1/homesteaders1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/magazine/homesteaders1/homesteaders1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Death and Life of Chicago', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stuck in the Shadow of Affluence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Chicago Anti-Eviction Campaign', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Austen, Ben', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fleming, Willie', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Foreclosures', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Abandonment (Property)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Area Planning and Renewal', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Squatters', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Emanuel, Rahm', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Homeless Persons', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-05-29T11:00:58+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Ben Austen', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Austen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7d68a3dd-bd53-5e2e-8473-52f244dbd63e', 'word_count': 7287, 'uri': 'nyt://article/7d68a3dd-bd53-5e2e-8473-52f244dbd63e'}, {'abstract': 'The recoveries in the United States and Japan are driving growth, but unemployment in Europe continues to drag on the region.', 'web_url': 'https://www.nytimes.com/2013/05/30/business/global/global-economy-rebounding-oecd-says.html', 'snippet': 'The recoveries in the United States and Japan are driving growth, but unemployment in Europe continues to drag on the region.', 'lead_paragraph': 'BERLIN — The global economy is slowly regaining its strength, driven largely by the rebound of the United States and Japan, but record-high unemployment in Europe continues to drag on efforts to recover in that region, the Organization for Economic Cooperation and Development said Wednesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Global Economy Is Rebounding, O.E.C.D. Says', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Organization for Economic Cooperation and Development', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'European Central Bank', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-05-29T11:01:16+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Melissa Eddy', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Eddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0187ed76-da20-5e9b-a124-185a6548955c', 'word_count': 523, 'uri': 'nyt://article/0187ed76-da20-5e9b-a124-185a6548955c'}, {'abstract': 'The Human Rights Council measure also condemned intervention by foreign fighters supporting the Syrian president, Bashar al-Assad.', 'web_url': 'https://www.nytimes.com/2013/05/30/world/middleeast/un-rights-council-drafts-statement-on-fighting-in-syria.html', 'snippet': 'The Human Rights Council measure also condemned intervention by foreign fighters supporting the Syrian president, Bashar al-Assad.', 'lead_paragraph': 'GENEVA — The United Nations Human Rights Council overwhelmingly passed a resolution on Wednesday that calls for an immediate end to fighting around Qusayr, a strategic Syrian town, and condemns the intervention of foreign combatants on the government’s side in the Syrian civil war.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.N. Rights Council Passes Resolution Calling for End to Fighting in Syrian Town', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.N. Rights Council Passes Resolution Calling for End to Fighting in Syrian Town', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'United Nations Human Rights Council', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Al-Qusayr (Syria)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Hezbollah', 'rank': 5, '