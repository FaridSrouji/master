nk': 11, 'major': 'N'}], 'pub_date': '2013-05-16T02:50:00+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Kate Taylor', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3dbee4d7-353d-55d8-9987-99f21343c0c0', 'word_count': 674, 'uri': 'nyt://article/3dbee4d7-353d-55d8-9987-99f21343c0c0'}, {'abstract': 'Sanctions were imposed on a lawyer and his client, a woman whose husband died on Sept. 11, saying anti-Semitic references were made in court filings.', 'web_url': 'https://www.nytimes.com/2013/05/16/nyregion/slurs-were-used-in-a-filing-tied-to-9-11-court-says.html', 'snippet': 'Sanctions were imposed on a lawyer and his client, a woman whose husband died on Sept. 11, saying anti-Semitic references were made in court filings.', 'lead_paragraph': 'Hardball legal tactics are common in courts, but a California lawyer went too far when he filed court papers on behalf of his client, a widow whose husband died in the Sept. 11 terror attacks, that were “nothing more than a vehicle for making personal slurs” against a judge, a federal appeals court in Manhattan said on Wednesday. ', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Court Penalizes a Lawyer Over Slurs in a 9/11 Filing', 'kicker': None, 'content_kicker': None, 'print_headline': 'Court Penalizes a Lawyer Over Slurs in a 9/11 Filing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANTI-SEMITISM', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Leichty, Bruce', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mariani, Ellen', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hellerstein, Alvin K', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value':