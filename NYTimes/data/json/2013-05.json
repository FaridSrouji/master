gazine/svenson-blog3/svenson-blog3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 293}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/magazine/svenson-blog3/svenson-blog3-jumbo.jpg', 'height': 500, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/magazine/svenson-blog3/svenson-blog3-superJumbo.jpg', 'height': 733, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/magazine/svenson-blog3/svenson-blog3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/21/magazine/svenson-blog3/svenson-blog3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/magazine/svenson-blog3/svenson-blog3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Photography Imitates Voyeurism', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Svenson, Arne', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-23T20:58:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Kathy Ryan', 'person': [{'firstname': 'Kathy', 'middlename': None, 'lastname': 'Ryan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/18f9b918-a811-511e-937a-b642bf82add8', 'word_count': 573, 'uri': 'nyt://article/18f9b918-a811-511e-937a-b642bf82add8'}, {'abstract': 'The final volume of Rick Atkinson’s trilogy shows that the road to Berlin was far from smooth.', 'web_url': 'https://www.nytimes.com/2013/05/26/books/review/the-guns-at-last-light-by-rick-atkinson.html', 'snippet': 'The final volume of Rick Atkinson’s trilogy shows that the road to Berlin was far from smooth.', 'lead_paragraph': 'ON the day Paris was liberated from Nazi occupation, two trucks screeched to a halt in front of the Ritz. Out jumped several dozen French Resistance fighters, armed to the teeth and led by a burly American with a large mustache. The French “irregulars” were so in awe of the man they referred to as “le grand capitaine” that they had taken to copying what the photographer Robert Capa called his “sailor bear walk” and machine-gun diction, “spitting short sentences from the corners of their mouths.”', 'print_section': 'BR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26MACINTYRE/26MACINTYRE-articleLarge.jpg', 'height': 298, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/26/books/review/26MACINTYRE/26MACINTYRE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 298}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26MACINTYRE/26MACINTYRE-jumbo.jpg', 'height': 509, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26MACINTYRE/26MACINTYRE-superJumbo.jpg', 'height': 1017, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26MACINTYRE/26MACINTYRE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/26/books/review/26MACINTYRE/26MACINTYRE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26MACINTYRE/26MACINTYRE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Price of Victory', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Price of Victory', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Atkinson, Rick', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-23T21:03:21+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ben Macintyre', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Macintyre', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/291924d8-07aa-5e1a-8562-be1e4a990e7c', 'word_count': 1267, 'uri': 'nyt://article/291924d8-07aa-5e1a-8562-be1e4a990e7c'}, {'abstract': 'Janet Malcolm’s penetrating profiles are case studies in defeated amour-propre.', 'web_url': 'https://www.nytimes.com/2013/05/26/books/review/forty-one-false-starts-by-janet-malcolm.html', 'snippet': 'Janet Malcolm’s penetrating profiles are case studies in defeated amour-propre.', 'lead_paragraph': 'The most revealing moment in Janet Malcolm’s new collection of essays and profiles, “Forty-One False Starts,” comes toward the end of “A Girl of the Zeitgeist,” her 1986 piece about Ingrid Sischy, who was then the editor of Artforum. The reader can hardly help noticing that while Sischy is the titular girl, she is not much in evidence in the piece itself, which is largely a portrait gallery of various art-world blowhards and monomaniacs. Malcolm admits that she hoped Sischy would be “some sort of strikingly modern type, some astonishing new female sensibility loosed in the world.” What she found instead is that Sischy was, to put it simply, a good person: “a pleasant, intelligent, unassuming, responsible, ethical young woman.” Naturally, Malcolm concludes, “I . . . turned away in disappointment.”', 'print_section': 'BR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26KIRSH/26KIRSH-articleLarge.jpg', 'height': 793, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/26/books/review/26KIRSH/26KIRSH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 793}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26KIRSH/26KIRSH-jumbo.jpg', 'height': 1024, 'width': 775, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26KIRSH/26KIRSH-superJumbo.jpg', 'height': 2048, 'width': 1549, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26KIRSH/26KIRSH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 