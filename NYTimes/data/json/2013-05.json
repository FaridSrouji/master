/2013/05/25/nyregion/figoski-2/figoski-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/25/nyregion/figoski-2/figoski-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '3rd Conviction in Robbery That Left Officer Dead', 'kicker': None, 'content_kicker': None, 'print_headline': '3rd Conviction in Robbery That Left Officer Dead', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Morales, Nelson', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Secret, Mosi', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Figoski, Peter J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Robberies and Thefts', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Attacks on Police', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-05-24T16:28:37+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Mosi Secret', 'person': [{'firstname': 'Mosi', 'middlename': None, 'lastname': 'Secret', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a447c7db-f6f8-50cb-9c94-92333295dec0', 'word_count': 583, 'uri': 'nyt://article/a447c7db-f6f8-50cb-9c94-92333295dec0'}, {'abstract': 'In “The East,” director Zal Batmanglij returns to the theme of group dynamics run amok, this time with a political twist.', 'web_url': 'https://www.nytimes.com/2013/05/26/movies/the-east-is-the-new-film-from-zal-batmanglij.html', 'snippet': 'In “The East,” director Zal Batmanglij returns to the theme of group dynamics run amok, this time with a political twist.', 'lead_paragraph': 'Washington — On a recent muggy Friday, the director Zal Batmanglij was ranging up and down Georgetown’s brick sidewalks, giving a kind of tour of his past. Mr. Batmanglij lives in Los Angeles, but he grew up around here. There was Montrose Park, where he and his friends used to drink as teenagers; nearby was Rock Creek, which Mr. Batmanglij used to run along nearly every day after he graduated from college, during the year that he worked at a shampoo company and daydreamed about the films he wasn’t yet making.', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/arts/26ZAL1_SPAN/26ZAL1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/26/arts/26ZAL1_SPAN/26ZAL1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/arts/26ZAL1_SPAN/26ZAL1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/arts/26ZAL1_SPAN/26ZAL1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/arts/26ZAL1_SPAN/26ZAL1_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/26/arts/26ZAL1_SPAN/26ZAL1_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subty