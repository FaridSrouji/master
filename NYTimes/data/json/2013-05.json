ard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/05/dining/05POUR_SPAN/05POUR_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'If Only the Grapes Were the Whole Story', 'kicker': 'The Pour', 'content_kicker': None, 'print_headline': 'If Only the Grapes Were the Whole Story', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wines', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Asimov, Eric', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Behavior', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Labeling and Labels', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-30T20:51:52+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Eric Asimov', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Asimov', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd1f7730-6042-518c-bb83-85062fba68d1', 'word_count': 942, 'uri': 'nyt://article/dd1f7730-6042-518c-bb83-85062fba68d1'}, {'abstract': '“The Flower of Empire,” Tatiana Holway’s lively case for the importance of the Amazonian water lily, is one of the season’s crop of gardening books.', 'web_url': 'https://www.nytimes.com/2013/06/02/books/review/the-flower-of-empire-by-tatiana-holway-and-more.html', 'snippet': '“The Flower of Empire,” Tatiana Holway’s lively case for the importance of the Amazonian water lily, is one of the season’s crop of gardening books.', 'lead_paragraph': 'Why do we have to go all the way around the world to find what’s in our own backyard? Gardeners have the answer, and it isn’t philosophical; it’s botanical. The way much of our “plant material,” as the nurserymen call it, arrived on American soil is as varied and inspiring a story of immigration as you can hope to hear. And for those of you who like what I think of as the “grain of sand” trend — the world in a bowl of salt or a mackerel — you’re in luck. Now we can find the world in a water lily or a ginkgo.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/books/review/0602-bks-Gardening/0602-bks-Gardening-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/06/02/books/review/0602-bks-Gardening/0602-bks-Gardening-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/books/review/0602-bks-Gardening/0602-bks-Gardening-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/books/review/0602-bks-Gardening/0602-bks-Gardening-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/books/review/0602-bks-Gardening/0602-bks-Gardening-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/06/02/books/review/0602-bks-Gardening/0602-bks-Gardening-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/books/review/0602-bks-Gardening/0602-bks-Gardening-thumbLarge.jpg', 'height': 150, 'width': 150, '