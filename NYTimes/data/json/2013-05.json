ported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f7e74cbe-2ec8-527a-ab0d-e8a27528a2a3', 'word_count': 448, 'uri': 'nyt://article/f7e74cbe-2ec8-527a-ab0d-e8a27528a2a3'}, {'abstract': 'Local 1199 S.E.I.U.’s decision, to be announced next week, represents the most significant labor move yet in New York’s mayoral campaign.', 'web_url': 'https://www.nytimes.com/2013/05/18/nyregion/citys-largest-union-endorsing-de-blasio-for-mayor.html', 'snippet': 'Local 1199 S.E.I.U.’s decision, to be announced next week, represents the most significant labor move yet in New York’s mayoral campaign.', 'lead_paragraph': 'New York City’s largest union, Local 1199 of the Service Employees International Union, has decided to throw its considerable political weight and grass-roots muscle behind Public Advocate Bill de Blasio in the contest for mayor.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/nyregion/18-NYCMAYOR/18-NYCMAYOR-articleLarge.jpg', 'height': 833, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/18/nyregion/18-NYCMAYOR/18-NYCMAYOR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 833}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/nyregion/18-NYCMAYOR/18-NYCMAYOR-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/nyregion/18-NYCMAYOR/18-NYCMAYOR-superJumbo.jpg', 'height': 1436, 'width': 1034, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/nyregion/18-NYCM