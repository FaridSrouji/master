-rehcmc-5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/31/greathomesanddestinations/31iht-rehcmc-5/31iht-rehcmc-5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Renting a Vintage Home in Ho Chi Minh City', 'kicker': None, 'content_kicker': None, 'print_headline': 'China Is Fertile Ground\r\nFor Crop of Luxury Hotels', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Ho Chi Minh City (Vietnam)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-30T04:45:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Great Homes & Destinations', 'byline': {'original': 'By Mike Ives', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Ives', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0284ec85-9780-5be2-a36f-2cca5aea82a0', 'word_count': 865, 'uri': 'nyt://article/0284ec85-9780-5be2-a36f-2cca5aea82a0'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/05/30/arts/television/whats-on-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (Fox Movie Channel) THE DEPARTED (2006) Martin Scorsese directed and William Monahan wrote this adaptation of the Hong Kong film “Infernal Affairs” (2002). In Boston’s South End the Irish gangster Frank Costello (Jack Nicholson) reigns as the king of organized crime and stays one step ahead of the state police by inserting a snitch (Matt Damon) into the department. Responding in kind, a state police captain (Martin Sheen) asks Billy Costigan (Leonardo DiCaprio, at left above with Mr. Nicholson), a cadet with a propensity for violence, to go undercover and infiltrate Costello’s crew. “Mr. Scorsese’s sureness of touch, particularly when it comes to carving up space with the camera, keep the plot’s hall of mirrors from becoming a distraction,” Manohla Dargis wrote in The New York Times. “The plot thickens, then reaches full boil among further complications, dirty dealings, blood on the floor and excellent performances from Alec Baldwin and Mark Wahlberg (as detectives), who own their every scene.” The film won four Oscars, including ones for best picture, best director and best adapted screenplay.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-30T05:00:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/20f96714-c2ad-5d76-b068-b81dfdb9ac9c', 'word_count': 762, 'uri': 'nyt://article/20f96714-c2ad-5d76-b068-b81dfdb9ac9c'}, {'abstract': 'See what you know about the news of the day.', 'web_url': 'https://learning.blogs.nytimes.com/2013/05/30/news-quiz-may-30-2013/', 'snippet': 'See what you know about the news of the day.', 'lead_paragraph': 'See what you know about the news below. To prepare, you might scan the articles or summaries on today’s paper. Good luck!', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'News Quiz | May 30, 2013', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None},