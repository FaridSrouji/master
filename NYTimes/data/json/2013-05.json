er': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Software', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-16T20:26:38+0000', 'document_type': 'multimedia', 'news_desk': 'Business Day', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/6b81fc71-56d6-54e3-8958-0f2d2e972da0', 'word_count': 0, 'uri': 'nyt://interactive/6b81fc71-56d6-54e3-8958-0f2d2e972da0'}, {'abstract': 'Pam Tanowitz’s “Spectators” is an intense and complex work that borrows from ballet.', 'web_url': 'https://www.nytimes.com/2013/05/17/arts/dance/the-spectators-at-new-york-live-arts.html', 'snippet': 'Pam Tanowitz’s “Spectators” is an intense and complex work that borrows from ballet.', 'lead_paragraph': 'Pam Tanowitz is sometimes described as a deconstructionist of ballet and modern dance. This makes her sound formidably cerebral, and it’s true that throughout much of last year’s lecturelike “Untitled (Blue Ballet)” you had to pinch yourself to stay awake. But “The Spectators,” her new dance that opened at New York Live Arts on Wednesday, is almost unbearably exciting. It’s a return to form that pushes further. The experience it offers a spectator is exhilarating enough to make “spectating” an inadequate verb. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/17/arts/17SPECTATORS_SPAN/17SPECTATORS_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/17/arts/17SPE