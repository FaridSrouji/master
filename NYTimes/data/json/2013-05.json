d0-b04f-114984676bc4', 'word_count': 242, 'uri': 'nyt://article/2a6c37d2-4ae6-56d0-b04f-114984676bc4'}, {'abstract': 'The Recording Industry Association of America decides that 100 streams is about the same as one downloaded single.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/05/10/virtual-gold-recording-association-adds-streams-in-handing-out-awards/', 'snippet': 'The Recording Industry Association of America decides that 100 streams is about the same as one downloaded single.', 'lead_paragraph': ' There was a time when a gold-record single was simple to define: You got the designation from the Recording Industry Association of America when you sold 500,000 copies of your record. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Virtual Gold: Recording Association Adds Streams in Handing Out Awards', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Audio Recordings and Downloads', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Recording Industry Assn of America', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-10T14:26:30+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f521d8b-9666-5d81-9bbb-5c5d1d60cbaf', 'word_count': 374, 'uri': 'nyt://article/0f521d8b-9666-5d81-9bbb-5c5d1d60cbaf'}, {'abstract': 'Rick Riordan’s “Percy Jackson” series has been on the kids’ list for 287 weeks — the reigning champion, thanks to a recent change in how the lists are assembled.', 'web_url': 'https://www.nytimes.com/2013/05/19/books/review/inside-the-list.html', 'snippet': 'Rick Riordan’s “Percy Jackson” series has been on the kids’ list for 287 weeks — the reigning champion, thanks to a recent change in how the lists are assembled.', 'lead_paragraph': 'RESETTING THE CLOCK: What current best seller has been on the list the longest? At 287 weeks, the winner is “Percy Jackson & the Olympians,” by Rick Riordan, which you’ll find on the children’s series list at No. 8. Second place goes to “The Devil in the White City,” by Erik Larson, at No. 18 on the paperback nonfiction list after 267 weeks, while another children’s series, Jeff Kinney’s “Diary of a Wimpy Kid” (at No. 3 on that list), has stuck around for 225 weeks.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12list-img/12list-img-jumbo.jpg', 'height': 450, 'width': 456, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12list-img/12list-img-superJumbo.jpg', 'height': 450, 'width': 456, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12list-img/12list-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/books/review/12list-img/12list-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12list-img/12list-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'TBR: Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-10T14:27:50+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcfe3c5b-651f-5be8-ba54-4aa6f7210426', 'word_count': 626, 'uri': 'nyt://article/bcfe3c5b-651f-5be8-ba54-4aa6f7210426'}, {'abstract': 'When her husband deserts her, this novel’s protagonist becomes a public relations adviser for sinful celebrities.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/a-thousand-pardons-by-jonathan-dee.html', 'snippet': 'When her husband deserts her, this novel’s protagonist becomes a public relations adviser for sinful celebrities.', 'lead_paragraph': 'What does it mean to say “I’m sorry”? Increasingly, in this age of ceremonial, highly ritualized apology, it’s hard to distinguish between true remorse and savvy public relations. Jonathan Dee’s sixth novel, “A Thousand Pardons,” was written before Lance Armstrong’s public shaming, but it speaks to something similar in the zeitgeist: the idea of confession as business strategy. Is reputation just a form of capital? What does it mean to apologize publicly for private sins, or privately for public ones? When one person grants another forgiveness, which of them is redeemed?', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-NOEL/0512-bks-NOEL-articleLarge.jpg', 'height': 704, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/201