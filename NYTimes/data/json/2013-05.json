': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-superJumbo.jpg', 'height': 597, 'width': 670, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'College Plans Always Work Out, Even When They Don’t', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-20T09:50:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Will Walker', 'person': [{'firstname': 'Will', 'middlename': None, 'lastname': 'Walker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8fb78c25-e12b-579c-826f-35c7702cce7c', 'word_count': 653, 'uri': 'nyt://article/8fb78c25-e12b-579c-826f-35c7702cce7c'}, {'abstract': 'The Royal Bank of Scotland said on Monday that Donald Workman would succeed John McCormick as the executive chairman of its Asia unit, in the latest high-level management change at the bank.', 'web_url': 'https://dealbook.nytimes.com/2013/05/20/r-b-s-appoints-new-asia-chairman/', 'snippet': 'The Royal Bank of Scotland said on Monday that Donald Workman would succeed John McCormick as the executive chairman of its Asia unit, in the latest high-level management change at the bank.', 'lead_paragraph': 'The Royal Bank of Scotland announced a new chairman for Asia on Monday, in the latest high-level executive change at the bank. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'R.B.S. Appoints New Chairman for Asia', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Royal Bank of Scotland PLC', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Far East, South and Southeast Asia and Pacific Areas', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-20T10:00:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Neil Gough', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Gough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4984bce7-e9ff-50fb-9c84-e4b1544f208c', 'word_count': 211, 'uri': 'nyt://article/4984bce7-e9ff-50fb-9c84-e4b1544f208c'}, {'abstract': 'Yahoo’s move to buy the popular blogging service Tumblr aims to make up for years of missing out on the growth of social networks and mobile devices.', 'web_url': 'https://bits.blogs.nytimes.com/2013/05/20/daily-report-yahoos-deal-for-tumblr/', 'snippet': 'Yahoo’s move to buy the popular blogging service Tumblr aims to make up for years of missing out on the growth of social networks and mobile devices.', 'lead_paragraph': 'The board of Yahoo, the faded Web pioneer, agreed on Sunday to buy the popular blogging service Tumblr for about $1.1 billion in cash, people with direct knowledge of the matter said, a signal of how the company plans to reposition itself as the technology industry makes a headlong rush into social media, The New York Times reports in Monday’s editions.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Daily Report: Yahoo’s Deal for Tumblr', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Tumblr', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Yahoo! Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-20T10:08:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/d31612bb-03ee-594c-875e-bea020a9b222', 'word_count': 262, 'uri': 'nyt://article/d31612bb-03ee-594c-875e-bea020a9b222'}, {'abstract': 'A series of explosions and gunfire assaults that left scores of people dead deepened concerns that sectarian tensions could lead to widespread fighting.', 'web_url': 'https://www.nytimes.com/2013/05/21/world/middleeast/baghdad-basra-iraq-bombings.html', 'snippet': 'A series of explosions and gunfire assaults that left scores of people dead deepened concerns that sectarian tensions could lead to widespread fighting.', 'lead_paragraph': 'BAGHDAD — A wave of car bombings and shootings hit cities in Iraq late Sunday and on Monday, killing at least 76 people and wounding more than 250, medical and security officials said. Some news agency reports put the overall toll even higher, at 86 or more dead.', 'print_section': 'A', 'print_pa