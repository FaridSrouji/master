peal choreographically while remaining themselves.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/arts/14NYCB/14NYCB-articleLarge.jpg', 'height': 594, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/14/arts/14NYCB/14NYCB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 594}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/arts/14NYCB/14NYCB-jumbo.jpg', 'height': 1013, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/arts/14NYCB/14NYCB-superJumbo.jpg', 'height': 2000, 'width': 2021, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/arts/14NYCB/14NYCB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/14/arts/14NYCB/14NYCB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/arts/14NYCB/14NYCB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Transcendent, Populist and American All Over', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Transcendent, Populist and American All Over', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York City Ballet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Koch,