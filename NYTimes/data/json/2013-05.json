od baseball.” ', 'print_section': 'SP', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/sports/dimaggio-silo/dimaggio-silo-articleLarge.jpg', 'height': 848, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/sports/dimaggio-silo/dimaggio-silo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 848}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/sports/dimaggio-silo/dimaggio-silo-jumbo.jpg', 'height': 1024, 'width': 725, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/sports/dimaggio-silo/dimaggio-silo-superJumbo.jpg', 'height': 2048, 'width': 1449, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/sports/dimaggio-silo/dimaggio-silo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/sports/dimaggio-silo/dimaggio-silo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/sports/dimaggio-silo/dimaggio-silo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Brothers, Stars, Rivals', 'kicker': None, 'content_kicker': None, 'print_headline': 'Brothers, Stars, Rivals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Red Sox', 'rank': 3, 'major': 'N'}, {'name': 'organization