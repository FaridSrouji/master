: 'images/2013/05/12/arts/12OSCILLOSCOPE_SPAN/12OSCILLOSCOPE_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/arts/12OSCILLOSCOPE_SPAN/12OSCILLOSCOPE_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/arts/12OSCILLOSCOPE_SPAN/12OSCILLOSCOPE_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/arts/12OSCILLOSCOPE_SPAN/12OSCILLOSCOPE_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Still Licensed to Be Indie', 'kicker': None, 'content_kicker': None, 'print_headline': 'Still Licensed to Be Indie', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Roston, Tom', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Oscilloscope', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Yauch, Adam', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Reality (Movie)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Samsara (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-10T18:25:03+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Tom Roston', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Roston', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e968ed7-a286-5fe3-9bf3-e40a8d575f71', 'word_count': 1174, 'uri': 'nyt://article/6e968ed7-a286-5fe3-9bf3-e40a8d575f71'}, {'abstract': 'The artist-run SoHo restaurant FOOD, which is being revived this weekend at Frieze New York, was revolutionary a generation ago. Now it’s the norm.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/05/10/food-matters-when-eating-and-art-became-one/', 'snippet': 'The artist-run SoHo restaurant FOOD, which is being revived this weekend at Frieze New York, was revolutionary a generation ago. Now it’s the norm.', 'lead_paragraph': 'A few months before the artists Carol Goodden and Gordon Matta-Clark opened their restaurant-slash-art installation, FOOD, on the corner of Prince and Wooster Streets in New York City in the fall of 1971, they roasted a pig beneath the Brooklyn Bridge. Alanna Heiss, who would soon found P.S.1, installed work by Matta-Clark, Carl Andre, Sol Le Witt and Keith Sonnier in a raw, junk-filled space. On nearby Pier 14, Philip Glass performed and the year-old avant-garde theater company Mabou Mines staged a Samuel Beckett play. The artist Tina Girouard, who would cook at FOOD during its nearly three-year run, helped out with the hog. “The pig burnt on the outside,” she recalled, “and raw on the inside.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Food Matters | When Eating and Art Became One', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Matta-Clark, Gordon', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Roberta's (Brooklyn, NY, Restaurant)", 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'SoHo (Manhattan, NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-10T18:30:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Howie Kahn', 'person': [{'firstname': 'Howie', 'middlename': None, 'lastname': 'Kahn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e5d0b19-fee3-5c41-a310-8e6a12dc395b', 'word_count': 640, 'uri': 'nyt://article/9e5d0b19-fee3-5c41-a310-8e6a12dc395b'}, {'abstract': 'Cooper Union recently announced that it would begin charging tuition, a decision made after decades of bad financial choices and recent treacherous markets.', 'web_url': 'https://www.nytimes.com/2013/05/11/business/how-cooper-unions-endowment-failed-in-its-mission.html', 'snippet': 'Cooper Union recently announced that it would begin charging tuition, a decision made after decades of bad financial choices and recent treacherous markets.', 'lead_paragraph': 'Since Peter Cooper’s heirs gave the Cooper Union for the Advancement of Science and Art the land under the Chrysler Building in 1902, the school’s endowment has enabled it to offer students a high-quality, tuition-free education through two world wars, the Great Depression and multiple stock market crashes and financial crises.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Cooper Union’s Endowment Failed in Its Mission', 'kicker': 'Common Sense', 'content_kicker': None, 'print_headline': 'How Errors In Investing Cost a College Its Legacy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Endowments', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Cooper Union for the Advancement of Science and Art', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Tuition', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-10T18:31:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By James B. Stewart', 'perso