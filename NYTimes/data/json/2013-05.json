e': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Abbott, Gregory W (1957- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Cruz, Ted', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Gene', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson-Lee, Sheila', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Stein, Robert', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Battleground Texas', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-05-16T02:18:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Thomas B. Edsall', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/447d28aa-24ea-56fd-bc00-beef00474123', 'word_count': 1428, 'uri': 'nyt://article/447d28aa-24ea-56fd-bc00-beef00474123'}, {'abstract': 'Senator Kirsten Gillibrand will introduce a bill that would give military prosecutors rather than commanders the power to decide which sexual assault cases to try.', 'web_url': 'https://www.nytimes.com/2013/05/16/us/politics/multiple-proposals-on-assault-in-military-but-also-disagreement.html', 'snippet': 'Senator Kirsten Gillibrand will introduce a bill that would give military prosecutors rather than commanders the power to decide which sexual assault cases to try.', 'lead_paragraph': 'WASHINGTON — President Obama, military officials and lawmakers on Capitol Hill are in broad agreement that the sexual assault problem in the military has reached a level of severity that can no longer be tolerated. 