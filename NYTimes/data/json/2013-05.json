/05/10/arts/10INAYEAR/INAYEAR-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/arts/10INAYEAR/INAYEAR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/10/arts/10INAYEAR/INAYEAR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/arts/10INAYEAR/INAYEAR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Going to Pains for Love in a Flashy Urban Jungle', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Going to Pains for Love In a Flashy Urban Jungle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Yale Repertory Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Woodruff, Robert', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fassbinder, Rainer Werner', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Camp, Bill', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-09T21:08:49+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Rachel Saltz', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Saltz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/55f55703-53af-59fb-958d-14cdd7545f5f', 'word_count': 714, 'uri': 'nyt://article/55f55703-53af-59fb-958d-14cdd7545f5f'}, {'abstract': 'In the comedy “Sightseers,” a couple of Britons take a sometimes violent vacation.', 'web_url': 'https://www.nytimes.com/2013/05/10/movies/sightseers-with-alice-lowe-and-steve-oram.html', 'snippet': 'In the comedy “Sightseers,” a couple of Britons take a sometimes violent vacation.', 'lead_paragraph': 'Nasty, brutish and mercifully short, the woozy comedy “Sightseers” tells the tale of two ordinary British eccentrics who initially bring to mind the gargoyles, both amusing and alarming, that populate Mike Leigh movies. A droopy, passive-aggressive frowner, Tina (Alice Lowe), lives with her hectoring mother, Carol (Eileen Davies), in a house crammed with kitsch and collectibles, many dog-themed and portraying a beloved, recently deceased terrier. It’s the kind of domestic horror show that certain British filmmakers either mock or sentimentalize, and which the British director Ben Wheatley (“Down Terrace”) takes to with a very heavy, very unforgiving ax. ', 'print_section': 'C', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'These Two Really Need a Vacation, So Beware', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'These Two Really Need A Vacation, So Beware', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wheatley, Ben', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lowe, Alice', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-09T21:09:54+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8667ac16-c244-519c-be55-92287341b19f', 'word_count': 482, 'uri': 'nyt://article/8667ac16-c244-519c-be55-92287341b19f'}, {'abstract': 'Hezbollah’s leader, Hassan Nasrallah, suggested Syria would retaliate by providing his fighters with weapons that Israel wanted to keep out of the group’s hands.', 'web_url': 'https://www.nytimes.com/2013/05/10/world/middleeast/hezbollah-syria-israel.html', 'snippet': 'Hezbollah’s leader, Hassan Nasrallah, suggested Syria would retaliate by providing his fighters with weapons that Israel wanted to keep out of the group’s hands.', 'lead_paragraph': 'BEIRUT, Lebanon — The leader of Hezbollah, the powerful Lebanese militant group, escalated tensions with Israel on Thursday over the recent Israeli airstrikes near Damascus, suggesting that the Syrian government would respond by providing Hezbollah fighters with the same weapons that Israel wants to keep out of their hands.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/world/middleeast/10syria/10syria-articleLarge.jpg', 'height': 439, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/10/world/middleeast/10syria/10syria-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 439}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/world/middleeast/10syria/10syria-jumbo.jpg', 'height': 750, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/world/middleeast/10syria/10syria-superJumbo.jpg', 'height': 1500, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/world/middleeast/10syria/10syria-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', '