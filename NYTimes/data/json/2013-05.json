: '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/295f847b-f7c9-531b-a7a7-2799875df74a', 'word_count': 1555, 'uri': 'nyt://article/295f847b-f7c9-531b-a7a7-2799875df74a'}, {'abstract': 'Senator John McCain, the Arizona Republican who has called for the Obama administration to intervene militarily in Syria, was the first United States senator to visit Syria to meet with the rebels since the conflict there began two years ago.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/05/27/mccain-travels-to-syria-to-meet-with-rebel-forces/', 'snippet': 'Senator John McCain, the Arizona Republican who has called for the Obama administration to intervene militarily in Syria, was the first United States senator to visit Syria to meet with the rebels since the conflict there began two years ago.', 'lead_paragraph': 'WASHINGTON — Senator John McCain, the Arizona Republican who has called for the United States to intervene militarily in Syria, traveled to Syria on Monday to meet with rebel forces fighting the regime of President Bashar al-Assad, according to a spokesman for Mr. McCain. It was the first time that a United States senator had gone to Syria to meet with the rebels since the conflict there began two years ago. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'McCain Travels to Syria to Meet With Rebel Forces', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Idris, Salim', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McCain, John', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Free Syrian Army', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 6, 'major': 'N'}], 'pub_date':