o.jpg', 'height': 636, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/fashion/weddings/26KIRKORIANjpg/26KIRKORIANjpg-superJumbo.jpg', 'height': 1258, 'width': 2024, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/fashion/weddings/26KIRKORIANjpg/26KIRKORIANjpg-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/26/fashion/weddings/26KIRKORIANjpg/26KIRKORIANjpg-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/fashion/weddings/26KIRKORIANjpg/26KIRKORIANjpg-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Yasmine Kirkorian, Daniel Gonen', 'kicker': None, 'content_kicker': None, 'print_headline': 'Yasmine Kirkorian, Daniel Gonen', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-26T04:16:11+0000', 'document_type': 'article', 'news_desk': 'Society', 'section_name': 'Fashion & Style', 'subsection_name': 'Weddings', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29850b73-9a2a-5551-9003-705420ee8ca9', 'word_count': 256, 'uri': 'nyt://article/29850b73-9a2a-5551-9003-705420ee8ca9'}, {'abstract': 'Corrections appearing in print on May 26, 2013.', 'web_url': 'https://www.nytimes.com/2013/05/26/pageoneplus/corrections-may-26-2013.html', 'snippet': 'Corrections appearing in print on May 26, 2013.', 'lead_paragraph': 'NATIONAL', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: May 26, 2013', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-26T04:39:40+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/2e5010a1-a829-53e1-bd23-706e9856391c', 'word_count': 1594, 'uri': 'nyt://article/2e5010a1-a829-53e1-bd23-706e9856391c'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/05/26/arts/television/whats-on-sunday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (HBO) BEHIND THE CANDELABRA (2013) Michael Douglas, above, stars as the piano showman Liberace, and Matt Damon is Scott Thorson, his chauffeur, lover and adopted son, in this film biography from the director Steven Soderbergh and the screenwriter Richard LaGravenese. Set in Las Vegas, Los Angeles and Palm Springs, the film chronicles the men’s relationship as Liberace picks up and possesses Mr. Thorson, has him cosmetically altered in his image and legally adopts him before discarding him for a younger model. “There’s something uncanny, even brilliant,” about Mr. Douglas’s impersonation of Liberace, Mike Hale wrote in The New York Times. “Sashaying across Las Vegas stages and epic suburban living rooms with a drum major’s puffed-up grandeur and a lounge lizard’s predatory smile, Mr. Douglas gives a performance so assured, so free of camp or cringe, that you quickly surrender any doubts you might have had about his playing a \xa0famously flamboyant, closeted-in-plain-sight gay entertainer.” At the same time, he said, “there’s something limited, and limiting, about Mr. Douglas’s portrayal. Its brilliance feels as if it were all on the surface, a matter of expertise and professionalism.” And the same could be said of Mr. Soderbergh’s film, he added. “A cerebral gloss on, and satire of, a big old Hollywood biopic, it’s full of smart, funny details — perfectly sewn in place, like the rhinestones on one of Mr. Douglas’s blinding costumes — but it’s short on heart, or heat.”', 'print_section': 'MB', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Sunday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Sunday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-26T05:00:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/8879e909-fd5d-54b8-97d5-fca10f125347', 'word_count': 699, 'uri': 'nyt://article/8879e909-fd5d-54b8-97d5-fca10f125347'}, {'abstract': 'As the Bruins move on to play Pittsburgh in the conference finals, the Rangers face an off-season of self-reflection and of change.', 'web_url': 'https://www.nytimes.com/slideshow/2013/05/25/sports/hockey/RANGERS-BRUINS-Game-5.html', 'snippet': 'As the Bruins move on to play Pittsburgh in the conference finals, the Rangers face an off-season of self-reflection and of change.', 'lead_paragraph': 'As the Bruins move on to play Pittsburgh in the conference finals, the Rangers face an off-season of self-reflection and of change.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/25/sports/RANGERS-BRUINS-Game-5-slide-ZUFY/RANGERS-BRUINS-Game-5-slide-ZUFY-articleLarge.jpg', 'height': 436, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLa