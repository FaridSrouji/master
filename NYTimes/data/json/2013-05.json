7-dailydogear-jumbo-v2.png', 'height': 156, 'width': 190, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/17/magazine/17-dailydogear/17-dailydogear-superJumbo-v2.png', 'height': 156, 'width': 190, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/17/magazine/17-dailydogear/17-dailydogear-thumbStandard-v3.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/17/magazine/17-dailydogear/17-dailydogear-thumbStandard-v3.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/17/magazine/17-dailydogear/17-dailydogear-thumbLarge-v3.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Love of the Game', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-02T21:27:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Jon Kelly', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Kelly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bfbf34ed-e7fa-5c68-8b65-b433a89e125c', 'word_count': 466, 'uri': 'nyt://article/bfbf34ed-e7fa-5c68-8b65-b433a89e125c'}, {'abstract': 'The SculptureCenter exhibition “Better Homes” tries to answer the question: What is the ideal home?', 'web_url': 'https://www.nytimes.com/2013/05/03/arts/design/better-homes-at-sculp