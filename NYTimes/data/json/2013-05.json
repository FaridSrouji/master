f2-5ca292cfd04b', 'word_count': 486, 'uri': 'nyt://article/d3fa5f47-49c4-508c-b0f2-5ca292cfd04b'}, {'abstract': 'Apologize to your crab and praise the universe, then get on with it.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/05/21/how-to-clean-a-soft-shell-crab/', 'snippet': 'Apologize to your crab and praise the universe, then get on with it.', 'lead_paragraph': 'You may have a nice fishmonger who will clean your soft-shell crabs for you, a reasonable thing for a shopper to request. But if you’re not squeamish, it’s easy to do at home before preparing them for cooking, as I do in my column this week. It’s a simple a process of removing the gills and the apron, and snipping off the eyes and mouth, similar to cleaning a fish. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/dining/dj-crabtwo/dj-crabtwo-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/21/dining/dj-crabtwo/dj-crabtwo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/dining/dj-crabtwo/dj-crabtwo-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/dining/dj-crabtwo/dj-crabtwo-superJumbo.jpg', 'height': 720, 'width': 1080, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/dining/dj-crabtwo/dj-crabtwo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/21/dining/dj-crabtwo/dj-crabtwo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/21/dining/dj-crabtwo/dj-crabtwo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Clean a Soft-Shell Crab', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crabs', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-21T21:48:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/18e00824-7e3f-5c98-8eac-e46ed6d4ae25', 'word_count': 340, 'uri': 'nyt://article/18e00824-7e3f-5c98-8eac-e46ed6d4ae25'}, {'abstract': 'That’s the thing with a tornado — even when you know it’s coming, you’re helpless, because you don’t know precisely where it will hit.', 'web_url': 'https://www.nytimes.com/2013/05/22/opinion/after-the-tornado-in-oklahoma-a-war-zone.html', 'snippet': 'That’s the thing with a tornado — even when you know it’s coming, you’re helpless, because you don’t know precisely where it will hit.', 'lead_paragraph': 'OKLAHOMA CITY — THIS morning, the day after a monster tornado ripped through Moore, Okla., there was a moment between sleep and clear waking, when it was possible to forget what had happened and what lay ahead. But then we remembered. People we love are still missing. Our children are trapped.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After the Tornado, a War Zone', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'After the Tornado, a War Zone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wall, Carolyn', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tornadoes', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Oklahoma', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Moore (Okla)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-21T21:50:52+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Carolyn Wall', 'person': [{'firstname': 'Carolyn', 'middlename': None, 'lastname': 'Wall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0e88c587-1a11-5df4-8223-eccc425a6725', 'word_count': 864, 'uri': 'nyt://article/0e88c587-1a11-5df4-8223-eccc425a6725'}, {'abstract': 'Park officials say dunes lost and other damage at Fort Tilden on the Rockaway Peninsula will prevent the beach’s opening before 2014, but some people who hold it dear hope to change that.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/05/21/volunteers-try-to-restore-storm-scarred-beach-for-some-of-the-summer/', 'snippet': 'Park officials say dunes lost and other damage at Fort Tilden on the Rockaway Peninsula will prevent the beach’s opening before 2014, but some people who hold it dear hope to change that.', 'lead_paragraph': 'All along the Rockaway Peninsula in Queens, where Hurricane Sandy had laid waste, workers and officials are rushing to restore beaches in time for Memorial Day weekend. But while Rockaway Beach and Jacob Riis Park are slated to reopen for swimming on Saturday, one of the peninsula’s most remote – and, lately, most beloved – beaches will remain closed. ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/nyregion/CITYROOM-tilden1/CITYROOM-tilden1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/22/nyregion/CITYROOM-tilden1/CITYROOM-tilden1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/nyregion/CITYROOM-tilden1/CITYROOM-tilden1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/nyregion/CITYROOM-tilden1/CITYROOM-tilden1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/nyregion/CITYROOM-tilden1/CITYROOM-tilden1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/22/nyregion/CITYROOM-tilden1/CITYROOM-tilden1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/nyregion/CITYROOM-tilden1/CITYROOM-tilden1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rescue Team at a Beach Tries to Save the Summer', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': 'Trying to Save a Beach From a Lost Summer ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beaches', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dunes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Volunteers and Community Service', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Parks Service', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Fort Tilden (Queens, NY)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-21T21:53:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Colin Moynihan', 'person': [{'firstname': 'Colin', 'middlename': None, 'lastname': 'Moynihan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c39901f0-b30f-5761-af4b-70bcb448ac8c', 'word_count': 763, 'uri': 'nyt://article/c39901f0-b30f-5761-af4b-70bcb448ac8c'}, {'abstract': 'With its inspiration coming from samurai and kung fu films as well as manga, “Deadly She-Wolf Assassin at Armageddon!” delivers dancelike fight sequences.', 'web_url': 'https://www.nytimes.com/2013/05/22/theater/reviews/deadly-she-wolf-assassin-at-armageddon-at-lamama.html', 'snippet': 'With its inspiration coming from samurai and kung fu films as well as manga, “Deadly She-Wolf Assassin at Armageddon!” delivers dancelike fight sequences.', 'lead_paragraph': 'The first thing you notice about Fred Ho and Ruth Margraff’s “Deadly She-Wolf Assassin at Armageddon!,” now at La MaMa, is the elegant simplicity of the set, created by Anka Lupes and augmented by Chad McArver’s gentle lighting. A long stripe of fluorescent red, ornamented with shapes suggesting carvings on a sword hilt, crosses the floor; overhead, taut red lines of rope intersect, like laser beams in darkness. Red also predominates in the gorgeous costumes (also by Ms. Lupes) — red, and black, and leather. This meeting of cool design with blood-red passion drives this martial arts tale, which touches familiar bases yet feels fresh, dynamic and fully realized. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'cred