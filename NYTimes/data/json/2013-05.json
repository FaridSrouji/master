4, 'major': 'N'}], 'pub_date': '2013-05-02T16:54:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e7837a8-bea1-5d7b-b248-66a6ad872dc6', 'word_count': 358, 'uri': 'nyt://article/8e7837a8-bea1-5d7b-b248-66a6ad872dc6'}, {'abstract': 'Michael Urie’s one-man play will transfer from the 99-seat Rattlestick Playwrights Theater to the 199-seat Barrow Street Theater starting in June.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/05/02/buyer-cellar-moving-to-larger-theater/', 'snippet': 'Michael Urie’s one-man play will transfer from the 99-seat Rattlestick Playwrights Theater to the 199-seat Barrow Street Theater starting in June.', 'lead_paragraph': 'Solo shows are having a mixed reception on Broadway, with the early closing of “Testament of Mary” (starring Fiona Shaw) on Sunday and the shut-outs of “I’ll Eat You Last” (Bette Midler) and “Macbeth” (Alan Cumming) for Tony Award nominations this week. But Michael Urie’s one-man play “Buyer & Cellar” is flourishing Off Broadway: The critically acclaimed production, about a struggling actor who becomes an assistant of sorts to Barbra Streisand, will transfer from the 99-seat Rattlestick Playwrights Theater to a commercial run at the 199-seat Barrow Street Theater. After closing May 12 at Rattlestick, performances will resume June 18 at Barrow Street, initially for 10 weeks; the producers hope that ticket sales will be good enough to extend for an open-ended run.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/arts/02artsbeat-buyer/02artsbeat-buyer-articleLarge.jpg', 'height': 438, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/02/arts/02artsbeat-buyer/02artsbeat-buyer-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 438}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/arts/02artsbeat-buyer/02artsbeat-buyer-jumbo.jpg', 'height': 747, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/arts/02artsbeat-buyer/02artsbeat-buyer-superJumbo.jpg', 'height': 1494, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/arts/02artsbeat-buyer/02artsbeat-buyer-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/02/arts/02artsbeat-buyer/02artsbeat-buyer-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/arts/02artsbeat-buyer/02artsbeat-buyer-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Buyer & Cellar’ Moving to Larger Theater', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-02T16:58:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e2e6ed3e-8879-5c06-ac18-95924ee5071b', 'word_count': 344, 'uri': 'nyt://article/e2e6ed3e-8879-5c06-ac18-95924ee5071b'}, {'abstract': 'Korail, the Korean Railway, recently introduced two sightseeing trains that explore the country’s mountainous and rural areas.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/05/02/riding-the-rail-countryside/', 'snippet': 'Korail, the Korean Railway, recently introduced two sightseeing trains that explore the country’s mountainous and rural areas.', 'lead_paragraph': 'Korail, the Korean Railway, recently introduced two sightseeing trains that explore the country’s mountainous and rural areas. The O-train features observatory rooms and sightseeing monitors, and makes a five-hour loop around the central inland region, taking in deep gorges and stopping at 13 stations. The V-train travels round trip for 70 minutes down the Baekdudaegan mountain range, which runs most of the length of the Korean Peninsula.', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Riding the Rail, Countryside', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': 'Trains: Riding the Rail, Countryside', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Railroads', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-02T17:00:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Tanya Mohn', 'person': [{'firstname': 'Tanya', 'middlename': None, 'lastname': 'Mohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dc07d302-00b8-516f-93c2-0ec0ae08afd3', 'word_count': 67, 'uri': 'nyt://article/dc07d302-00b8-516f-93c2-0ec0ae08afd3'}, {'abstract': 'Is it possible to “shame” people who research products with local retailers and then buy online?', 'web_url': 'https://boss.blogs.nytimes.com/2013/05/02/finding-the-right-words-to-confront-a-showroomer/', 'snippet': 'Is it possible to “shame” people who research products with local retailers and then buy online?', 'lead_paragraph': 'Two years ago, as Charles Kuhn struggled to steer Kopp’s Cycle, the bicycle shop he owns in Princeton, N.J., through a tenuous economic recovery, he noticed that fewer and fewer of the nominal “customers” in his shop were actually buying anything. Instead, he told The Agenda at the time, “People come in with their smartphone and scan a bar code on a product that I have in my showroom, and what comes up on the phone is the three closest places and their price and then also what it is on Amazon.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Finding the Right Words to Confront a ‘Showroomer’', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customer Relations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sales and Excise Taxes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lieber, Ron', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-02T17:00:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Robb Mandelbaum', 'person': [{'firstname': 'Robb', 'middlename': None, 'lastname': 'Mandelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5390d403-0db1-5ee6-8138-981aae8a6d5b'