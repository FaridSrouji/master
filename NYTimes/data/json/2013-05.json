ited States Marine Corps', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Helmand Province (Afghanistan)', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Tennessee', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-05-16T03:02:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Zachary Bell', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b1c825b-3bfb-5254-8f93-25f6f370ff93', 'word_count': 680, 'uri': 'nyt://article/7b1c825b-3bfb-5254-8f93-25f6f370ff93'}, {'abstract': 'The Red River Women’s Clinic, in Fargo, argues that requiring its doctors to have local admitting privileges would effectively put it out of business.', 'web_url': 'https://www.nytimes.com/2013/05/16/us/north-dakotas-sole-abortion-clinic-sues-to-block-new-law.html', 'snippet': 'The Red River Women’s Clinic, in Fargo, argues that requiring its doctors to have local admitting privileges would effectively put it out of business.', 'lead_paragraph': 'The running battle over the regulation of abortions entered a North Dakota courtroom on Wednesday, as the state’s sole abortion clinic sued to block a new law that it says could force it to shut down. ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/16/us/DAKOTA/DAKOTA-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/16/us/DAKOTA/DAKOTA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013