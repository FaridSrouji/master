 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bad Week Is Merely Bump for Assembly’s Master of Power', 'kicker': None, 'content_kicker': None, 'print_headline': 'Very Bad Week Is Merely Bump For Assembly’s Master of Power', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sexual Harassment', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hakim, Danny', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Silver, Sheldon', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kaplan, Thomas', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lopez, Vito J', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kearns, Michael P', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-20T20:02:32+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Danny Hakim and Thomas Kaplan', 'person': [{'firstname': 'Danny', 'middlename': None, 'lastname': 'Hakim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Thomas', 'middlename': None, 'lastname': 'Kaplan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/48d75e6b-cce3-52f4-b773-df3346be829b', 'word_count': 1258, 'uri': 'nyt://article/48d75e6b-cce3-52f4-b773-df3346be829b'}, {'abstract': 'In this rendition of a classic cocktail, the rum is swapped for sauvignon blanc.', 'web_url': 'https://www.nytimes.com/2013/05/22/dining/a-moderated-mojito.html', 'snippet': 'In this rendition of a classic cocktail, the rum is swapped for sauvignon blanc.', 'lead_paragraph': 'I tend to prefer cocktails that follow classic recipes. But on a recent trip to southern Utah, I happily sipped a moderated mojito at Red Mountain Resort, which does not serve spirits, only beer and wine. The rum in this rendition had been swapped for sauvignon blanc. The general manager, Tracey Welsh, explained: “Our inspiration was to offer a lower alcohol content in cocktail favorites our guests love, allowing them to wake up feeling refreshed the next day, and ready to go for early morning hikes.” That’s providing you can drink just one. ', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/dining/22MOJITO/22MOJITO-articleLarge.jpg', 'height': 780, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/22/dining/22MOJITO/22MOJITO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 780}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/dining/22MOJITO/22MOJITO-jumbo.jpg', 'height': 1024, 'width': 788, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/dining/22MOJITO/22MOJITO-superJumbo.jpg', 'height': 2048, 'width': 1575, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/dining/22MOJITO/22MOJITO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/22/dining/22MOJITO/22MOJITO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/dining/22MOJITO/22MOJITO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Moderated Mojito', 'kicker': None, '