{'copyright': 'Copyright (c) 2020 The New York Times Company. All Rights Reserved.', 'response': {'docs': [{'abstract': 'NewSchools Venture Fund, a nonprofit that invests in education groups, is entering a partnership with Rethink Education that could result in millions more in financing.', 'web_url': 'https://www.nytimes.com/2013/05/01/education/newschools-venture-fund-links-with-rethink-education.html', 'snippet': 'NewSchools Venture Fund, a nonprofit that invests in education groups, is entering a partnership with Rethink Education that could result in millions more in financing.', 'lead_paragraph': 'NewSchools Venture Fund, a nonprofit that started out channeling philanthropic donations to charter schools and that now invests in a range of education groups and businesses, is entering into a partnership with a new venture capital fund that could result in millions more in financing.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'NewSchools Fund Attracts More Capital', 'kicker': None, 'content_kicker': None, 'print_headline': 'NewSchools Fund Attracts More Capital', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'NewSchools Venture Fund', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Venture Capital', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Charter Schools', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-01T00:13:25+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Education', 'byline': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}],