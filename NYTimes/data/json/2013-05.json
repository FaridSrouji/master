yline': {'original': 'By Micah Cohen', 'person': [{'firstname': 'Micah', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f33e38a-3447-5242-b176-bff7d5add050', 'word_count': 690, 'uri': 'nyt://article/3f33e38a-3447-5242-b176-bff7d5add050'}, {'abstract': 'A technological surprise on a layover in Finland.', 'web_url': 'https://pogue.blogs.nytimes.com/2013/05/06/genius-in-helsinki/', 'snippet': 'A technological surprise on a layover in Finland.', 'lead_paragraph': 'I wrote the other day about some of the technological advances that are commonplace in Europe, but not yet in America. As I flew home, I had a layover in the Helsinki airport, where I saw one more really smart idea.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/04/technology/04pogue-pic/04pogue-pic-articleLarge.png', 'height': 325, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/04/technology/04pogue-pic/04pogue-pic-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 325}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/04/technology/04pogue-pic/04pogue-pic-jumbo.png', 'height': 390, 'width': 721, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/04/technology/04pogue-pic/04pogue-pic-superJumbo.png', 'height': 390, 'width': 721, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/04/technology/04pogue-pic/04pogue-pic-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'th