ogram.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tip of the Week: Make a Mac Screen Recording', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Software', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-31T13:00:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By J.d. Biersdorfer', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65e9009b-2c29-53bb-934f-086c2d57fe7b', 'word_count': 191, 'uri': 'nyt://article/65e9009b-2c29-53bb-934f-086c2d57fe7b'}, {'abstract': 'Just a short walk from bustling Piazza San Marco, the little-known neighborhood of Castello Orientale — with its tourist-free streets and old-fashioned way of life — feels worlds away.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/05/31/hidden-venice/', 'snippet': 'Just a short walk from bustling Piazza San Marco, the little-known neighborhood of Castello Orientale — with its tourist-free streets and old-fashioned way of life — feels worlds away.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'print_section': 'M2', 'print_page': '72', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hidden Venice', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Hidden Venice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 