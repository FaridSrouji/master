e, 'content_kicker': None, 'print_headline': 'Gardner Turns a Misplay Into a Highlight Catch', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Arangure, Jorge Jr', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gardner, Brett', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-28T03:30:34+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Jorge Arangure Jr', 'person': [{'firstname': 'Jorge', 'middlename': None, 'lastname': 'Arangure', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b34775f2-cacd-52c0-8344-c94b776dd4aa', 'word_count': 400, 'uri': 'nyt://article/b34775f2-cacd-52c0-8344-c94b776dd4aa'}, {'abstract': 'Japanese rescuers saved an American fighter pilot from the waters off southern Japan after his F-15 fighter crashed into the ocean early Tuesday, Japanese officials said.', 'web_url': 'https://www.nytimes.com/2013/05/28/world/asia/japan-us-pilot-rescued-off-okinawa.html', 'snippet': 'Japanese rescuers saved an American fighter pilot from the waters off southern Japan after his F-15 fighter crashed into the ocean early Tuesday, Japanese officials said.', 'lead_paragraph': ' Japanese rescuers saved an American fighter pilot from the waters off southern Japan after his F-15 fighter crashed into the ocean early Tuesday, Japanese officials said. The F-15, which flew out of Kadena Air Base on Okinawa, crashed in the Pacific about 70 miles east of the island at 9 a.m. Tuesday, American military officials said. The Japanese authorities immediately sent boats and aircraft to the scene and spotted the pi