ravel/12HEADSUP_SPAN/12HEADSUP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 309}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/travel/12HEADSUP_SPAN/12HEADSUP-jumbo.jpg', 'height': 527, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/travel/12HEADSUP_SPAN/12HEADSUP-superJumbo.jpg', 'height': 1053, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/travel/12HEADSUP_SPAN/12HEADSUP_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/travel/12HEADSUP_SPAN/12HEADSUP_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/travel/12HEADSUP_SPAN/12HEADSUP_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A ‘New Louvre’ North of Paris', 'kicker': None, 'content_kicker': None, 'print_headline': 'A ‘New Louvre’ North of Paris', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Louvre Museum', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-08T16:34:42+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Ratha Tep', 'person': [{'firstname': 'Ratha', 'middlename': None, 'lastname': 'Tep', 'qualifier': None,