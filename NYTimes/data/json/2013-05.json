 None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections, Mayors', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-13T14:36:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Michael Barbaro', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Barbaro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed67bb7d-5a7e-53f3-bdfe-283ca641e47e', 'word_count': 727, 'uri': 'nyt://article/ed67bb7d-5a7e-53f3-bdfe-283ca641e47e'}, {'abstract': 'Easy flatbreads made with whole-wheat flour are a terrific vehicle for all kinds of vegetables and herbs.', 'web_url': 'https://www.nytimes.com/2013/05/13/health/whole-wheat-focaccia.html', 'snippet': 'Easy flatbreads made with whole-wheat flour are a terrific vehicle for all kinds of vegetables and herbs.', 'lead_paragraph': 'A couple of weeks ago I gave you a recipe for a walnut fougasse, or focaccia. The bread was so easy to make, and such a great vehicle for the walnuts, that I got onto a focaccia kick and started making it just about every day, topping it with vegetables and sometimes filling it with them. I tried different proportions of whole-wheat and all-purpose flour, never using less than half whole-wheat, and found that the same overall recipe worked no matter how I varied the proportions. I’m working with a terrific whole-wheat flour produced in California, available online and now carried by Fairway, called Community Grains. But I also made the focaccia with King Arthur white whole-wheat flour (I used 100 percent in that version; the result had a slightly denser, tighter texture than the other focacce).', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/science/13recipehealth2/13recipehealth2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/14/science/13recipehealth2/13recipehealth2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/science/13recipehealth2/13recipehealth2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/science/13recipehealth2/13recipehealth2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/science/13recipehealth2/13recipehealth2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/14/science/13recipehealth2/13recipehealth2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/science/13recipehealth2/13recipehealth2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Focaccia: One Basic Bread, Endless Delicious Options', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Bread', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-13T14:43:57+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/bdbb8804-67df-5b86-9306-193fb22155b5', 'word_count': 1122, 'uri': 'nyt://article/bdbb8804-67df-5b86-9306-193fb22155b5'}, {'abstract': 'The N.H.L. could hardly ask for more drama from its first round: 16 overtime games with two Game 7s remaining.', 'web_url': 'https://www.nytimes.com/2013/05/14/sports/hockey/in-the-nhl-overtimes-seventh-games-and-deja-vu.html', 'snippet': 'The N.H.L. could hardly ask for more drama from its first round: 16 overtime games with two Game 7s remaining.', 'lead_paragraph': 'Apparently, the remedy for everything wrong in the N.H.L. is a Game 7. It’s as if the league went to a doctor — O.K., a faith healer, because hockey’s gatekeepers are not keen on all that actual medical information — and said: “We had this shameless money grab of a lockout, our players keep trying to take one another’s heads off even though we’ve mildly suggested they stop, our tickets are astronomically expensive and casual sports fans have to keep being reminded we exist. So what do we do?”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/sports/hockey/14leadingpic/14leadingpic-articleLarge.jpg', 'height': 445, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/14/sports/hockey/14leadingpic/14leadingpic-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 445}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/spo