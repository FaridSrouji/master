es', 'multimedia': [], 'headline': {'main': 'Aerosmith and James Taylor Join Benefit for Boston Bombing Victims', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Concert to Benefit Boston Bombing Survivors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Boston Marathon Bombings (2013)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Aerosmith', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-03T17:38:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76d5e586-3470-5600-826a-31e1a9969804', 'word_count': 116, 'uri': 'nyt://article/76d5e586-3470-5600-826a-31e1a9969804'}, {'abstract': 'A team at the Ellen Degeneres show came up with an idea for an iPhone game. The day of its release, it quickly became the bestselling app in the App Store.', 'web_url': 'https://bits.blogs.nytimes.com/2013/05/03/ellen-degeneres-iphone-game/', 'snippet': 'A team at the Ellen Degeneres show came up with an idea for an iPhone game. The day of its release, it quickly became the bestselling app in the App Store.', 'lead_paragraph': 'On her talk show, Ellen DeGeneres plays a game with celebrity guests where she holds a card up to her forehead showing a word or name, like “Justin Bieber.” The guest then gives clues to Ms. DeGeneres to help her guess the word.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/03/business/03bits-ellen/03bits-ellen-articleLarge.jpg', 'height': 331, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy':