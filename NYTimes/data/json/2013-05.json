caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/28/business/28adnews/28adnews-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Grape-Nuts Wants You to Climb Every Mountain', 'kicker': 'Campaign Spotlight', 'content_kicker': None, 'print_headline': 'Grape-Nuts Wants You to Climb Every Mountain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cereals', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'General Foods Corp', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-28T17:55:43+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Stuart Elliott', 'person': [{'firstname': 'Stuart', 'middlename': None, 'lastname': 'Elliott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cbd308ab-3805-595d-a843-dc44da6802d6', 'word_count': 1299, 'uri': 'nyt://article/cbd308ab-3805-595d-a843-dc44da6802d6'}, {'abstract': 'It’s a good thing.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/05/28/taxing-the-rich/', 'snippet': 'It’s a good thing.', 'lead_paragraph': 'For my sins (and, yes, an honorarium too), I’m doing this. So it’s worth putting out some of the basics.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Taxing the Rich', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-28T17:59:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30fe1dc9-eca6-5fd2-abbf-7e47559aca76', 'word_count': 244, 'uri': 'nyt://article/30fe1dc9-eca6-5fd2-abbf-7e47559aca76'}, {'abstract': 'More than 30 states are organizing events around a Wednesday promotion to encourage enrollment in their 529 plans.', 'web_url': 'https://bucks.blogs.nytimes.com/2013/05/28/incentives-to-start-a-529-college-savings-plan/', 'snippet': 'More than 30 states are organizing events around a Wednesday promotion to encourage enrollment in their 529 plans.', 'lead_paragraph': 'College graduation season is in full swing, marking an annual rite of passage — and serving as a reminder that higher education isn’t getting any cheaper. One option available to help families put away money for college, and avoid borrowing too much, is a 529 college savings plan.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Incentives to Start a 529 College Savings Plan', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Savings', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tuition', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Utah', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (State)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-28T18:00:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ef665ff-229a-5416-8dc4-f06f0d17cdfd', 'word_count': 314, 'uri': 'nyt://article/9ef665ff-229a-5416-8dc4-f06f0d17cdfd'}, {'abstract': 'A response to Ezra Klein on the plight of the conservative policy wonk.', 'web_url': 'https://douthat.blogs.nytimes.com/2013/05/28/the-world-as-wonkblog-sees-it/', 'snippet': 'A response to Ezra Klein on the plight of the conservative policy wonk.', 'lead_paragraph': 'Jonathan Chait’s Atlantic profile of Josh Barro, the Bloomberg View blogger and columnist who’s gradually transitioned from reform-minded center-right pundit to entertaining scourge of the contemporary G.O.P., has launched a lot of discussion about conservative reform projects in general, and (for my sins) I’ll probably write a post or two on that theme later this week. To start with, though, I think it’s worth saying something in response to this post from Ezra Klein, which uses Barro’s recent arc as a case study in the Republican Party’s intellectual self-marginalization:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The World As Wonkblog Sees It', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Global Warming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Dorgan, Byron L', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Jordan, Barbara', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Klein, Ezra', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Copenhagen (Denmark)', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-05-28T18:10:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/79c0c52c-f42e-5038-88ab-28c10fe71d89', 'word_count': 1317, 'uri': 'nyt://article/79c0c52c-f42e-5038-88ab-28c10fe71d89'}, {'abstract': 'Comes with the job.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/05/28/a-brief-useless-note-on-being-bashed/', 'snippet': 'Comes with the job.', 'lead_paragraph': 'Fairly often I receive comments or other communications asking me to respond to X or Y, who has said Z about me and/or my arguments. For the most part, I am not going to oblige. Why?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Brief, Useless Note On Being Bashed', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-28T18:11:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b149a27-1d3e-5290-ae87-2cab0e5b4c8d', 'word_count': 122, 'uri': 'nyt://article/5b149a27-1d3e-5290-ae87-2cab0e5b4c8d'}, {'abstract': 'Despite the expense and hassle, more chefs are embracing the oldest of cooking styles, wood-fired grilling.', 'web_url': 'https://www.nytimes.com/2013/05/29/dining/more-chefs-are-enthusiastic-about-wood-fired-grilling.html', 'snippet': 'Despite the expense and hassle, more chefs are embracing the oldest of cooking styles, wood-fired grilling.', 'lead_paragraph': 'When Matthew Semmelhack and Mark Liberman, the owners of AQ in San Francisco, open their new restaurant nearby later this year, they won’t have a stove. Or an oven. ', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/dining/29GRILLS1_SPAN/29GRILLS1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/29/dining/29GRILLS1_SPAN/29GRILLS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/dining/29GRILLS1_SPAN/29GRILLS1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/dining/29GRILLS1_SPAN/29GRILLS1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/dining/29GRILLS1_SPAN/29GRILLS1_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/29/dining/29GRILLS1_SPAN/29GRILLS1_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/dining/29GRILLS1_SPAN/29GRILLS1_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Returning Wood to the Cooking Fire', 'kicker': None, 'content_kicke