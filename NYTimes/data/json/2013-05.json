': {'xlarge': 'images/2013/05/26/realestate/26TICKET/26TICKET-articleLarge-v7.jpg', 'xlargewidth': 600, 'xlargeheight': 526}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/realestate/26TICKET/26TICKET-jumbo-v7.jpg', 'height': 898, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/realestate/26TICKET/26TICKET-superJumbo-v7.jpg', 'height': 954, 'width': 1088, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/realestate/26TICKET/26TICKET-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/26/realestate/26TICKET/26TICKET-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/realestate/26TICKET/26TICKET-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Big Ticket | Diplomatic Crash Pad for $11.59 Million', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': 'The Dakota | Diplomatic Crash Pad', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Dakota (Manhattan, NY, Apartments)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Upper West Side (Manhattan, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-24T15:52:13+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Robin Finn', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Finn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30a5f669-dedc-59d8-9c74-655103b67cc7', 'word_count': 265, 'uri': 'nyt://article/30a5f669-dedc-59d8-9c74-655103b67cc7'}, {'abstract': 'A new film recalls how, 50 years ago, Hannah Arendt’s “Eichmann in Jerusalem” set off furious debates and coined the phrase “the banality of evil.”', 'web_url': 'https://www.nytimes.com/2013/05/26/movies/hannah-arendt-directed-by-margarethe-von-trotta.html', 'snippet': 'A new film recalls how, 50 years ago, Hannah Arendt’s “Eichmann in Jerusalem” set off furious debates and coined the phrase “the banality of evil.”', 'lead_paragraph': 'Fifty years ago, a small book called “Eichmann in Jerusalem: A Report on the Banality of Evil,” by a New School philosophy professor named Hannah Arendt set off a storm like few books before or since. Among Upper West Side intellectuals it sparked, as the critic Irving Howe put it, “a civil war,” siring vicious debates and souring lifelong friendships. It also sold more than 100,000 copies and reshaped the way people have thought about the Holocaust, genocide and the puzzle of evil ever since.', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/arts/26ARENDT2_SPAN/26ARENDT2-articleLarge.jpg', 'height': 339, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/26/arts/26ARENDT2_SPAN/26ARENDT2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 339}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/arts/26ARENDT2_SPAN/26ARENDT2-jumbo.jpg', 'height': 579, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'captio