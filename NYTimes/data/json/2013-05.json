jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/22/travel/05222013WALES-slide-J69M/05222013WALES-slide-J69M-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/travel/05222013WALES-slide-J69M/05222013WALES-slide-J69M-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/travel/05222013WALES-slide-J69M/05222013WALES-slide-J69M-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/travel/05222013WALES-slide-J69M/05222013WALES-slide-J69M-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/22/travel/05222013WALES-slide-J69M/05222013WALES-slide-J69M-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/22/travel/05222013WALES-slide-J69M/05222013WALES-slide-J69M-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Taking a Walk Where Wales Meets the Sea', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Walking', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Wales', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-24T17:03:36+0000', 'document_type': 'multimedia', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/6647779b-5095-5839-8098-323adfb020b4', 'word_count': 0, 'uri': 'nyt://slideshow/6647779b-5095-5839-8098-323adfb020b4'}, {'abstract': 'This week, jazz critic Nate Chinen talks to host Ben Ratliff about Pat Metheny’s new album “Tap: John Zorn’s Book of Angels, Vol. 20.', 'web_url': 'https://www.nytimes.com/audio/2013/05/24/arts/music/24popcast_pod.html', 'snippet': 'This week, jazz critic Nate Chinen talks to host Ben Ratliff about Pat Metheny’s new album “Tap: John Zorn’s Book of Angels, Vol. 20.', 'lead_paragraph': 'This week, jazz critic Nate Chinen talks to host Ben Ratliff about Pat Metheny’s new album “Tap: John Zorn’s Book of Angels, Vol. 20.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pat Metheny and John Zorn’s Surprising Mind-Meld', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-24T17:07:40+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/34b24599-7aa0-53f1-9414-a07e822d3bcb', 'word_count': 0, 'uri': 'nyt://audio/34b24599-7aa0-53f1-9414-a07e822d3bcb'}, {'abstract': 'An Indiana officer records the slaughter at the gates of Vicksburg.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/05/24/the-hoosier-yell/', 'snippet': 'An Indiana officer records the slaughter at the gates of Vicksburg.', 'lead_paragraph': 'Monday, May 25, 1863, broke hot and thick over the southern end of the Mississippi Delta. As Union artillery units began a day of shelling the rebel stronghold at Vicksburg, Maj. Edward J. Wood of the 48th Indiana Volunteer Infantry regiment sat down in his tent to write a long letter to his wife. His previous letter was dated May 8, and in the intervening weeks he and his regiment had fought four sharp battles. With his colonel sick and his lieutenant colonel’s having resigned, he was now its effective commander. He had much to write about.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Hoosier Yell', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Indiana', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Vicksburg (Miss)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-24T17:10:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Stephen E. Towne', 'person': [{'firstname': 'Stephen', 'middlename': 'E.', 'lastname': 'Towne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da425bc2-604a-5264-96af-d88a41c3f7fa', 'word_count': 1489, 'uri': 'nyt://article/da425bc2-604a-5264-96af-d88a41c3f7fa'}, {'abstract': 'Mary Higgins Clark, whose novel “Daddy’s Gone a Hunting” is at No. 16 after six weeks on the hardcover fiction list, recently chatted with some fellow suspense writers at a New York bar.', 'web_url': 'https://www.nytimes.com/2013/06/02/books/review/inside-the-list.html', 'snippet': 'Mary Higgins Clark, whose novel “Daddy’s Gone a Hunting” is at No. 16 after six weeks on the hardcover fiction list, recently chatted with some fellow suspense writers at a New York bar.', 'lead_paragraph': 'BRING UP THE BODIES: “These people here,” the writer Frank Delaney said recently at the Half King bar and restaurant in Chelsea, “have killed more people between them than most people you’ll ever meet. You will never be in a room with as many killers again.” The occasion was the Pen, Paper and Palate literary salon sponsored by the Irish Arts Center, and, with crime and suspense writing in the spotlight, the panelists included the perennial best sellers Lawrence Block, Harlan Coben, Nelson DeMille and Mary Higgins Clark, whose novel “Daddy’s Gone a Hunting” is at No. 16 in its sixth week on the hardcover fiction list. (The filmmaker Christine Vachon also sat in.)', 'print_section': 'BR', 'print_page': '54', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/arts/02bkr-inside/02bkr-inside-jumbo-v2.jpg', 'height': 450, 'width': 453, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/arts/02bkr-inside/02bkr-inside-superJumbo-v2.jpg', 'height': 450, 'width': 453, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/arts/02bkr-inside/02bkr-inside-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/06/02/arts/02bkr-inside/02bkr-inside-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/02/arts/02bkr-inside/02bkr-inside-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'TBR: Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-24T17:12:45+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 