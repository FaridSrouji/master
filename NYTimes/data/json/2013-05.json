o': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Foreign Workers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Waiters and Waitresses', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-09T09:00:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By David Gonzalez', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gonzalez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d452e6b3-f988-522b-beb4-2cf805e12038', 'word_count': 1112, 'uri': 'nyt://article/d452e6b3-f988-522b-beb4-2cf805e12038'}, {'abstract': 'Both Windows and Mac OS X can quickly give you information about your computer’s wireless network connection, along with built-in troubleshooting tools.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2013/05/09/tip-of-the-week-getting-wireless-network-details/', 'snippet': 'Both Windows and Mac OS X can quickly give you information about your computer’s wireless network connection, along with built-in troubleshooting tools.', 'lead_paragraph': 'Want quick information about your computer’s wireless connection? Clicking the Wireless Network Connection icon in the Notification area of the Windows desktop taskbar opens a panel that shows the name of the current network. Passing the mouse cursor over the network’s name displays a ScreenTip listing the signal strength, type of encryption security and other details. A link at the bottom of the panel opens the Network and Sharing control panel for wireless-network management and settings.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tip of the Week: Getting Wireless Network Details', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Desktop Computers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Lenovo Group', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-09T09:01:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By J.d. Biersdorfer', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e36583a-4f0f-5410-973b-a5df92068400', 'word_count': 231, 'uri': 'nyt://article/0e36583a-4f0f-5410-973b-a5df92068400'}, {'abstract': 'If you were in charge of planning a little free library for your community, where would you put it, what would it look like, and what books would you put in it to start? Why?', 'web_url': 'https://learning.blogs.nytimes.com/2013/05/09/what-kind-of-little-free-library-would-you-create-for-your-community/', 'snippet': 'If you were in charge of planning a little free library for your community, where would you put it, what would it look like, and what books would you put in it to start? Why?', 'lead_paragraph': 'Last weekend, 10 “little free libraries” popped up in and around Lower Manhattan. As you can see in the slide show above, they are installed in different places and take different forms, but each is a miniature lending library where anyone can take or leave a book under the honor system.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Kind of ‘Little Free Library’ Would You Create for Your Community?', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-09T09:05:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad99a4e9-1790-5d15-bb41-b3f7690c2870', 'word_count': 445, 'uri': 'nyt://article/ad99a4e9-1790-5d15-bb41-b3f7690c2870'}, {'abstract': 'Political news from today’s Times, plus a look at what’s happening in Washington.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/05/09/the-early-word-credibility/', 'snippet': 'Political news from today’s Times, plus a look at what’s happening in Washington.', 'lead_paragraph': 'In Today’s Times:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Early Word: Credibility', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-09T10:00:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Southall', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Southall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2c3806c-02b4-5d81-9e0d-48d5741aebaf', 'word_count': 432, 'uri': 'nyt://article/c2c3806c-02b4-5d81-9e0d-48d5741aebaf'}, {'abstract': 'Leobardo Espinoza Jr., a high school senior in Kansas, will never have a final decision from Stanford or Brown Universities, and he’s “perfectly fine with that.”', 'web_url