ne}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Venice Biennale', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Just, Jesper', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-28T22:10:27+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kevin McGarry', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'McGarry', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/00421a57-13f7-59fc-9b4e-2ea1af314980', 'word_count': 301, 'uri': 'nyt://article/00421a57-13f7-59fc-9b4e-2ea1af314980'}, {'abstract': 'On Wednesday at 2 p.m. ET, The Times’ Declan Walsh and the filmmakers of the PBS ‘Frontline’ documentary, “Outlawed in Pakistan” will discuss sexual violence and the justice system in Pakistan.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/05/28/discuss-rape-and-justice-in-pakistan-with-reporters-from-the-times-and-frontline/', 'snippet': 'On Wednesday at 2 p.m. ET, The Times’ Declan Walsh and the filmmakers of the PBS ‘Frontline’ documentary, “Outlawed in Pakistan” will discuss sexual violence and the justice system in Pakistan.', 'lead_paragraph': 'Readers of The Lede are invited to join a discussion of the issues raised by the documentary “Outlawed in Pakistan,” to be broadcast Tuesday night on PBS. The film, part of the “Frontline” series, followed the case of Kainat Soomro, a young woman who accused four men of gang-raping her when she was just 13 years old. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Discuss Rape and Justice in Pakistan With Reporters From The Times and ‘Frontline’', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sex Crimes', 'rank': 2, 'major': 'N'}, {'nam