 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seeing Chechnya’s Wonders, Long Before Getting There', 'kicker': None, 'content_kicker': None, 'print_headline': 'Seeing Chechnya’s Wonders, Long Before Getting There', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Marra, Anthony', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McGrath, Charles', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'A Constellation of Vital Phenomena (Book)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Chechnya (Russia)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-29T20:47:46+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/538fe35e-034d-5c21-be21-f8ab1eeabf45', 'word_count': 1211, 'uri': 'nyt://article/538fe35e-034d-5c21-be21-f8ab1eeabf45'}, {'abstract': 'This firm step into fictional territory brings out Jeannette Walls’s ear for homespun speech as well as allusions to Charles Dickens, Lewis Carroll and Harper Lee.', 'web_url': 'https://www.nytimes.com/2013/05/30/books/the-silver-star-a-novel-by-jeannette-walls.html', 'snippet': 'This firm step into fictional territory brings out Jeannette Walls’s ear for homespun speech as well as allusions to Charles Dickens, Lewis Carroll and Harper Lee.', 'lead_paragraph': 'Jeannette Walls’s new novel, “The Silver Star,” is systematically built, each brick put in place for a reason. It’s easy to understand why writing fiction makes Ms. Walls so methodical. Her memoir, “The Glass Castle,” told a far more painful story, and Ms. Walls surely knows that her personal history colors perceptions of whatever else she writes. “The Glass Castle” remains on best-seller lists eight years after it first appeared. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/30/arts/30BOOK/30BOOK-articleLarge.jpg', 'height': 985, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/30/arts/30BOOK/30BOOK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 985}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/30/arts/30BOOK/30BOOK-jumbo.jpg', 'height': 1024, 'width': 624, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/30/arts/30BOOK/30BOOK-superJumbo.jpg', 'height': 2048, 'width': 1247, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/30/arts/30BOOK/30BOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/30/arts/30BOOK/30BOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/30/arts/30BOOK/30BOOK-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A New Castle in the Realm of Fiction', 'kicker': 'Books Of the Times', 'content_kicker': None, 'print_headline': 'A New Castle In the Realm Of Fiction', 'name': None, 'seo': None, 'sub': N