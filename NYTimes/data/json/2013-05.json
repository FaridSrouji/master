sue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-24T14:25:19+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/f06aee79-4bdc-5881-9b2e-a0586e61653a', 'word_count': 702, 'uri': 'nyt://article/f06aee79-4bdc-5881-9b2e-a0586e61653a'}, {'abstract': 'A hit series, a cultural elitist and a comeuppance.', 'web_url': 'https://www.nytimes.com/2013/05/26/magazine/i-love-the-big-bang-theory-and-you-should-too.html', 'snippet': 'A hit series, a cultural elitist and a comeuppance.', 'lead_paragraph': 'There is probably no more grievous transgression in the current culture wars than being a late adopter, missing the boat, signing on to something that the rest of the plugged-in world absorbed, analyzed, digitized and deleted last year, last month, five minutes ago. Even though the avalanche of movies, TV shows, music, e-books, apps, social media, gadgets, etc., has made it impossible for anyone to be a prescient expert on everything — even everything good.', 'print_section': 'MM', 'print_page': '44', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/magazine/26riff/mag-26riff-t_CA0-articleLarge.jpg', 'height': 98, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/26/magazine/26riff/mag-26riff-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 98}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/magazine/26riff/mag-26riff-t_CA0-jumbo.jpg', 'height': 167, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/magazine/26riff/mag-26riff-t_CA0-super