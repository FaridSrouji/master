alifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1c120116-3949-5f4b-824b-1e6cb051fd0b', 'word_count': 1183, 'uri': 'nyt://article/1c120116-3949-5f4b-824b-1e6cb051fd0b'}, {'abstract': 'There are probably better ways to improve people’s lives.', 'web_url': 'https://www.nytimes.com/2013/05/05/opinion/sunday/douthat-what-health-insurance-doesnt-do.html', 'snippet': 'There are probably better ways to improve people’s lives.', 'lead_paragraph': 'IN one of the most famous studies of health insurance, conducted across the 1970s, thousands of participants were divided into five groups, with each receiving a different amount of insurance coverage. The study, run by the RAND Corporation, tracked the medical care each group sought out, and not surprisingly found that people with more comprehensive coverage tended to make use of it, visiting the doctor and checking into the hospital more often than people with less generous insurance.', 'print_section': 'SR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo'