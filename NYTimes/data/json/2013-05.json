nk': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Accidents and Safety', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-16T04:43:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Keith Bradsher', 'person': [{'firstname': 'Keith', 'middlename': None, 'lastname': 'Bradsher', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03a79f59-ec3e-540a-9b69-633804819a44', 'word_count': 245, 'uri': 'nyt://article/03a79f59-ec3e-540a-9b69-633804819a44'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/05/16/arts/television/whats-on-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (NBC) THE OFFICE The series comes to an end as, months after the documentary is broadcast, Dunder Mifflin employees past and present reunite for a wedding and a final round of interviews in which hatchets are buried and mysteries are solved. Mindy Kaling, B. J. Novak, Rachael Harris, Dakota Johnson, Joan Cusack and Ed Begley Jr. guest star. A retrospective, featuring interviews with writers, producers and actors; clips of favorite moments; and a behind-the-scenes look at the finale, leads in at 8. Above, a scene from the show.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-16T05:00:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck