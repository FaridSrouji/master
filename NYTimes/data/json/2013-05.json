': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/nyregion/20130526-JOINT-slide-L670/20130526-JOINT-slide-L670-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Neighborhood Joint: Connolly’s', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bars and Nightclubs', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Midtown Area (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Connolly's (Manhattan, NY, Bar)", 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-23T23:28:39+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/e55872bc-d454-56d5-95dd-80984832fbda', 'word_count': 0, 'uri': 'nyt://slideshow/e55872bc-d454-56d5-95dd-80984832fbda'}, {'abstract': 'Still not a game.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/05/23/its-not-about-you-3/', 'snippet': 'Still not a game.', 'lead_paragraph': 'Brad DeLong and Dan Drezner wearily continue the policing of Michael Kinsley. I’ll leave it in their hands. But may I say that there is a serious pundit lesson here — namely, that it’s not about you. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'It’s Not About You', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-23T23:32:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92e1623f-ea16-597a-9807-91d9b3121487', 'word_count': 260, 'uri': 'nyt://article/92e1623f-ea16-597a-9807-91d9b3121487'}, {'abstract': '“A Wedding Invitation” centers on a young couple who break up to pursue individual careers and promise to get back together if neither is married after five years.', 'web_url': 'https://www.nytimes.com/2013/05/24/movies/a-wedding-invitation-directed-by-oh-ki-hwan.html', 'snippet': '“A Wedding Invitation” centers on a young couple who break up to pursue individual careers and promise to get back together if neither is married after five years.', 'lead_paragraph': 'If we learned anything at all from “Avatar,” it’s that insulting the intelligence of the audience is no guarantee of a film’s downfall. Which is good news for “A Wedding Invitation,” a Pan-Asian romantic melodrama that virtually pokes you in the eye with its fakery. After going to the trouble of hiring attractive stars, placing them in glossy locations and photographing everything with the slickness of a BP public relations campaign, the South Korean director Oh Ki-hwan sacrifices all to a story (by Qin Haiyan) less grounded in reality than a convention of alien abductees.', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/24RDP_WEDDING_SPAN/24RDP_WEDDING_SPAN-articleLarge-v2.jpg', 'height': 379, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/24/arts/24RDP_WEDDING_SPAN/24RDP_WEDDING_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 379}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/24RDP_WEDDING_SPAN/24RDP_WEDDING_SPAN-jumbo-v2.jpg', 'height': 648, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 