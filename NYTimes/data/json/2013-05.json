bject', 'value': 'Murders and Attempted Murders', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Robberies and Thefts', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Bars and Nightclubs', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-05-16T19:49:58+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Randal C. Archibold', 'person': [{'firstname': 'Randal', 'middlename': 'C.', 'lastname': 'Archibold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3740918-ee14-598c-9589-cf36c9414ef1', 'word_count': 878, 'uri': 'nyt://article/e3740918-ee14-598c-9589-cf36c9414ef1'}, {'abstract': 'James Naughton hosted a Bobby Short tribute, with performances by Barbara Carroll, Paula West, Billy Stritch and the rising cabaret star T. Oliver Reid.', 'web_url': 'https://www.nytimes.com/2013/05/17/arts/music/tribute-to-bobby-short-at-lincoln-center.html', 'snippet': 'James Naughton hosted a Bobby Short tribute, with performances by Barbara Carroll, Paula West, Billy Stritch and the rising cabaret star T. Oliver Reid.', 'lead_paragraph': 'Year after year, the pianist and singer Barbara Carroll recalled on Wednesday evening, she and her close friend Bobby Short used to share tea, cookies and gossip before his shows at the Café Carlyle, where he held forth for three and a half decades. Ms. Carroll worked as the resident pianist across the hall at Bemelmans Bar for almost as many years. Short’s jovial exit line after their tête-à-têtes: “I gotta go in and cook them greens.” ', 'print_section': 'C', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/17/arts/SHORT/SHORT-articleLarge.jpg', 'h