n': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/sports/basketball/18spurs/18spurs-superJumbo.jpg', 'height': 1437, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/sports/basketball/18spurs/18spurs-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/18/sports/basketball/18spurs/18spurs-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/sports/basketball/18spurs/18spurs-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In the West, Old and Bland May Win the Race', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'San Antonio Spurs', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Duncan, Tim', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Popovich, Gregg', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Parker, Tony', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-17T15:21:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Jason Turbow', 'person': [{'firstname': 'Jason', 'middlename': None, 'lastname': 'Turbow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/14874c31-3c72-5096-8694-e15c84edbc56', 'word_count': 946, 'uri': 'nyt://article/14874c31-3c72-5096-8694-e15c84edbc56'}, {'abstract': 'A novel and essay collection by Elinor Lipman showcase her urbanity and optimism.', 'web_url': 'https://www.nytimes.com/2013/05/19/books/review/a-novel-and-essay-collection-by-elinor-lipman.html', 'snippet': 'A novel and essay collection by Elinor Lipman showcase her urbanity and optimism.', 'lead_paragraph': 'What an easy, delightful way to spend a weekend, curled up on the sofa, a vase of daffodils unfurling in a warm room as rain streams down the window and, close at hand, two new books by Elinor Lipman. More addictive than that bag of peanut M&M’s: a collection called “I Can’t Complain: (All Too) Personal Essays.” More delicious than my cup of steaming cocoa: a new novel, “The View From Penthouse B,” a tender, funny story of two middle-aged sisters. Food was constantly on my mind as I read, because Lipman’s books are marvelous pantries. The pages of her 10th novel are replete with bouillabaisse and roast chicken, ripe with exotic fruits and rich with marzipan and macaroons.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BROWNING/19BROWNING-articleLarge.jpg', 'height': 578, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/19/books/review/19BROWNING/19BROWNING-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 578}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BROWNING/19BROWNING-jumbo.jpg', 'height': 693, 'width': 719, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BROWNING/19BROWNING-superJumbo.jpg', 'height': 693, 'width': 719, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BROWNING/19BROWNING-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/19/books/review/19BROWNING/19BROWNING-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BROWNING/19BROWNING-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Humane Society', 'kicker': None, 'content_kicker': None, 'print_headline': 'Humane Society', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Browning, Dominique', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lipman, Elinor', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-17T15:21:24+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Dominique Browning', 'person': [{'firstname': 'Dominique', 'middlename': None, 'lastname': 'Browning', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f61231d6-d7ea-5b7e-86b9-258d9c0676f6', 'word_count': 1276, 'uri': 'nyt://article/f61231d6-d7ea-5b7e-86b9-258d9c0676f6'}, {'abstract': 'Our filled-to-the-brim schedule went on for years. One day, I realized I’d had enough.', 'web_url': 'https://parenting.blogs.nytimes.com/2013/05/17/a-solo-trip-takes-a-mother-home/', 'snippet': 'Our filled-to-the-brim schedule went on for years. One day, I realized I’d had enough.', 'lead_paragraph': 'For years, I was lost in that delicate dance of working and raising young children. Breakfast at 7. Clothes picked out. Backpacks filled. Off to school. Drive to sports … or music lessons … or friends’ houses. Dinner. Homework. Bed. And in between babies’ naps and play dates and taxiing, I fit in my “real” job — online teaching and academic advising. Phew.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Solo Trip Takes a Mother Home', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parenting', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-17T15:24:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Lynn Cianfarani', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Cianfarani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f25c235-47f8-5947-8f73-f208e15a2e2b', 'word_count': 775, 'uri': 'nyt://article/3f25c235-47f8-5947-8f73-f208e15a2e2b'}, {'abstract': 'William Gaddis’s letters reveal the struggle and self-doubt behind the novels.', 'web_url': 'https://www.nytimes.com/2013/05/19/books/review/the-letters-of-william-gaddis.html', 'snippet': 'William Gaddis’s letters reveal the struggle and self-doubt behind the novels.', 'lead_paragraph': 'For an author who spent seven years writing “The Recognitions” (1955), a big, elbow-straining novel that most people didn’t read, and the next 20 years writing “J R” (1975), an almost-as-big novel that most people also didn’t read, it will come as no surprise that William Gaddis’s selected letters are consumed with worries about how little money his books are making, how few people understand them and how he plans to pay his bills until the next book comes along. As he writes his literary agent, Candida Donadio, in the mid-1970s, just when “J R” was failing to secure a much-needed paperback rights advance:', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BRADFEILD/19BRADFEILD-articleLarge.jpg', 'height': 753, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/19/books/review/19BRADFEILD/19BRADFEILD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 753}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BRADFEILD/19BRADFEILD-jumbo.jpg', 'height': 1024, 'width': 816, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BRADFEILD/19BRADFEILD-superJumbo.jpg', 'height': 2048, 'width': 1632, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BRADFEILD/19BRADFEILD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/19/books/review/19BRADFEILD/19BRADFEILD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/books/review/19BRADFEILD/19BRADFEILD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Man of His Words', 'kicker': None, 'content_kicker': None, 'print_headline': 'Man of His Words', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gaddis, William', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-17T15:25:07+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Scott Bradfield', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Bradfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4e5c0105-e986-5306-bbc0-858ff757e9f6', 'word_count': 1212, 'uri': 'nyt://article/4e5c0105-e986-5306-bbc0-858ff757e9f6'}, {'abstract': '“The Office” ended on a modest, and slightly saccharine, note.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/05/17/the-office-ends-the-way-it-began-modestly/', 'snippet': '“The Office” ended on a modest, and slightly saccharine, note.', 'lead_paragraph': 'There’s a temptation for a long-running television comedy to go out with a high-concept twist — the “Seinfeld” trial, the “Newhart” bad dream, the “Frasier” plane ride. “The Office” was having none of that on Thursday night, when it closed its nine-season run on NBC with an episode that was in keeping with the show’s modest, utilitarian style. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/arts/officeep/officeep-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/18/arts/officeep/officeep-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/18/arts/officeep/officeep-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': Non