atter-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/05/opinion/sunday/05graymatter-LN/05graymatter-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/opinion/sunday/05graymatter-LN/05graymatter-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Reading Club | Digital Distraction', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-09T18:36:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten and Amanda Christy Brown', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Amanda', 'middlename': 'Christy', 'lastname': 'Brown', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ab4dffe5-4cb8-5bee-b9f9-4b7e050d318c', 'word_count': 577, 'uri': 'nyt://article/ab4dffe5-4cb8-5bee-b9f9-4b7e050d318c'}, {'abstract': 'A publisher’s decision to remove copy protection from its e-books revives a debate over whether such features hurt or help revenue — and not just for books.', 'web_url': 'https://pogue.blogs.nytimes.com/2013/05/09/the-e-book-piracy-debate-revisited/', 'snippet': 'A publisher’s decision to remove copy protection from its e-books revives a debate over whether such features hurt or help revenue — and not just for books.', 'lead_paragraph': 'The other day, I saw an interesting announcement from Tor Books UK, a publisher of science fiction and fantasy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The E-Book Piracy Debate, Revisited', 'kicker': 'Pogue&#039;s Posts', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Copyrights and Copyright Violations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'E-Books and Readers', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-09T18:39:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By David Pogue', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Pogue', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f5e8b4d-ca52-50fd-bbb8-4530ee5a78c8', 'word_count': 864, 'uri': 'nyt://article/3f5e8b4d-ca52-50fd-bbb8-4530ee5a78c8'}, {'abstract': 'Wedge brings unusual cheeses to Brooklyn.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/05/09/a-cheese-shop-in-a-slim-crown-heights-space/', 'snippet': 'Wedge brings unusual cheeses to Brooklyn.', 'lead_paragraph': 'The new cheese shop in Crown Heights may be called Wedge, but Sliver would be more like it. The owners of the narrow but well-equipped storefront, Kate Blumm and Michael de Zayas, have done their homework. And with the expertise of Lilith Spencer, who had been at Bklyn Larder, the cheese and provisions shop, they are stocking their bright little place with some real finds. Among them are a goat’s milk ricotta from Edgwick Farm in Cornwall, N.Y.; a couple of tommes from the Kokoborrego Cheese Company in Mount Gilead, Ohio; and an organic Parmigiano-Reggiano from Italy. They also carry pistachios and almonds from Sicily, a mead vinegar from Italy, breads from Bien Cuit in Brooklyn, and a sweet white miso made in Conway, Mass. Charcuterie is sliced on what Ms. Spencer says is the Rolls-Royce of slicing machines; Wedge, 728 Franklin Avenue (Sterling Place), Crown Heights, Brooklyn, wedgeonfranklin@gmail.com, facebook.com/wedgeonfranklin.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Cheese Shop in a Slim Crown Heights Space', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': 'Front Burner: To Shop:\r\nIn a Tiny Store,\r\nShow-Off Cheeses', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cheese', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Crown Heights (Brooklyn, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-09T18:45:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f3f65c32-9635-5adf-a60a-324a51d4933c', 'word_count': 151, 'uri': 'nyt://article/f3f65c32-9635-5adf-a60a-324a51d4933c'}, {'abstract': 'A slide show depicting the first aid procedure for convulsions.', 'web_url': 'https://www.nytimes.com/slideshow/2007/08/01/health/100212Convulsionsfirstaidseries_index.html', 'snippet': 'A slide show depicting the first aid procedure for convulsions.', 'lead_paragraph': 'A slide show depicting the first aid procedure for convulsions.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2007/08/01/health/adam/thumbnails/19590t.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2007/08/01/health/adam/thumbnails/19590t.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headlin