, 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': ' Visitors From Outer Space, Real or Not, Are Focus of Discussion in Washington ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Visitors From Outer Space, Real or Not, Are Focus of Discussion in Washington', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Unidentified Flying Objects (UFO)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Siddons, Andrew', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Extraterrestrial Life', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-03T20:46:06+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Andrew Siddons', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Siddons', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b47ca27-3358-559d-b346-6e308f30096e', 'word_count': 856, 'uri': 'nyt://article/5b47ca27-3358-559d-b346-6e308f30096e'}, {'abstract': 'Food-related events around New York.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/05/03/weekend-fare-140/', 'snippet': 'Food-related events around New York.', 'lead_paragraph': 'For home cooks who want to rub elbows with some of the most well-known chefs, the New York Culinary Experience on Saturday and Sunday at the International Culinary Center, 462 Broadway in SoHo, offers a chance to learn from and cook side by side with chefs like Andre Soltner and April Bloomfield. Tickets, at $1,395 per person for the all day affair are limited and can be purchased by calling (646) 314-4413 or e-mailing nyce@nymag.com.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'