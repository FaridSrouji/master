ption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/us/SUB-NRA/SUB-NRA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/05/us/SUB-NRA/SUB-NRA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/us/SUB-NRA/SUB-NRA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'N.R.A. Leadership Rallies Members for 2014 Elections', 'kicker': None, 'content_kicker': None, 'print_headline': 'N.R.A. Leadership Rallies Members for 2014 Elections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dao, James', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Rifle Assn', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'LaPierre, Wayne', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-04T19:03:01+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By James Dao', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Dao', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b9c0809-164d-5196-9327-970c3d929cb5', 'word_count': 1065, 'uri': 'nyt://article/7b9c0809-164d-5196-9327-970c3d929cb5'}, {'abstract': 'Trevor, a goat at Bret Calhoun’s barn at Churchill Downs, provides companionship to two fillies, but he lives life on his own terms.', 'web_url': 'https://therail.blogs.nytimes.com/2013/05/04/trevor-the-goat-a-stubborn-sweetheart/', 'snippet': 'Trevor, a goat at Bret Calhoun’s barn at Churchill Downs, provides companionship to two fillies, but he lives life on his own terms.', 'lead_paragraph': 'LOUISVILLE, Ky. — In a world of flashy, lean thoroughbreds, skinny jockeys, slender exercise riders and bony barn kitties, Trevor stands out from the moment you see him. Trevor looks like a heavy, swollen water barrel balanced precariously on four skinny legs and swings his head around to stare at you when you say hello. Whether curled up on a bale of hay or standing between barn rows, Trevor surveys all he sees through his raccoon-masked face with weird horizontal eyes that would seem more appropriate in a science fiction movie. If he decides to move, it might be with purpose. But then again, he might just stop and stare as he decides whether he wishes to move. You might swear that he is smiling at you the entire time.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Trevor the Goat: A Stubborn Sweetheart', 'kicker': 'The Rail', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANIMALS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Goats', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Churchill Downs Inc', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-04T19:09:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Julie June Stewart', 'person': [{'firstname': 'Julie', 'middlename': 'June', 'lastname': 'Stewart', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0c0ce77d-596c-5a22-9812-6766d19824f6', 'word_count': 568, 'uri': 'nyt://article/0c0ce77d-596c-5a22-9812-6766d19824f6'}, {'abstract': 'Google Glass, the computer eyewear, offers much technological wonder. But for one early user, it raises questions about the future of new technology and who gains access to it first.', 'web_url': 'https://www.nytimes.com/2013/05/05/technology/google-glass-offers-more-tech-magic-if-you-can-afford-it.html', 'snippet': 'Google Glass, the computer eyewear, offers much technological wonder. But for one early user, it raises questions about the future of new technology and who gains access to it first.', 'lead_paragraph': 'LAST week, I glimpsed the future. I tried on Google Glass, the much-anticipated computer eyewear that lets you skim e-mail and shoot video. ', 'print_section': 'BU', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/business/Bits/Bits-articleLarge.jpg', 'height': 857, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/05/business/Bits/Bits-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 857}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/business/Bits/Bits-jumbo.jpg', 'height': 1024, 'width': 717, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/business/Bits/Bits-superJumbo.jpg', 'height': 2048, 'width': 1434, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/business/Bits/Bits-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/05/business/Bits/Bits-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/05/business/Bits/Bits-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy'