byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7aa514b8-f36d-52f1-ad46-9c85e1feb601', 'word_count': 1014, 'uri': 'nyt://article/7aa514b8-f36d-52f1-ad46-9c85e1feb601'}, {'abstract': 'Daniel Hernández-Salazar’s life has been shaped by his quest — as an artist and Guatemalan — to see justice for the crimes committed during that country’s civil war. Last week, his vigil ended.', 'web_url': 'https://lens.blogs.nytimes.com/2013/05/14/a-quest-for-justice-in-guatemala/', 'snippet': 'Daniel Hernández-Salazar’s life has been shaped by his quest — as an artist and Guatemalan — to see justice for the crimes committed during that country’s civil war. Last week, his vigil ended.', 'lead_paragraph': 'Daniel Hernández-Salazar is used to waiting. Two decades ago he abandoned his photojournalistic career to devote himself to documenting the search for justice in the wake of Guatemala’s 36-year civil war. He stood at exhumations alongside indigenous Maya, as they waited to spy a bracelet or scrap of muddy fabric that would allow them to finally locate the bones of a loved one. More recently, he stood among them in a Guatemala City courtroom as the former dictator, Gen. Efraín Ríos Montt, was sentenced to 80 years for genocide and crimes against humanity.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Quest for Justice in Guatemala', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civilian Casualties', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Coups D'Etat and Attempted Coups D'Etat", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Espionage and Intelligence Services', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rios Montt, Efrain', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Guatemala', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-05-14T17:45:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By David Gonzalez', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gonzalez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/05fd636f-985a-5552-8ba0-8169bf4b7b73', 'word_count': 725, 'uri': 'nyt://article/05fd636f-985a-5552-8ba0-8169bf4b7b73'}, {'abstract': 'A beekeeper handling an artificial hive on the outskirts of Srinagar, Jammu and Kashmir.', 'web_url': 'https://india.blogs.nytimes.com/2013/05/14/image-of-the-day-may-14-2/', 'snippet': 'A beekeeper handling an artificial hive on the outskirts of Srinagar, Jammu and Kashmir.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/world/asia/14-POD-honey-IndiaInk/14-POD-honey-IndiaInk-articleLarge.jpg', 'height': 413, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/14/world/asia/14-POD-honey-IndiaInk/14-POD-honey-IndiaInk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 413}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/world/asia/14-POD-honey-IndiaInk/14-POD-honey-IndiaInk-jumbo.jpg', 'height': 704, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'c