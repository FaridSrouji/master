ualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/148a40e9-b57d-5197-982f-3e990c55214d', 'word_count': 672, 'uri': 'nyt://article/148a40e9-b57d-5197-982f-3e990c55214d'}, {'abstract': 'An Israeli government review panel asserted that a French television report broadcast that appeared to show the death of a 12-year-old Palestinian boy named Muhammad al-Dura during clashes in Gaza was deeply flawed.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/05/20/complete-text-of-israels-report-on-the-muhammad-al-dura-video/', 'snippet': 'An Israeli government review panel asserted that a French television report broadcast that appeared to show the death of a 12-year-old Palestinian boy named Muhammad al-Dura during clashes in Gaza was deeply flawed.', 'lead_paragraph': 'As my colleague Isabel Kershner reported, an Israeli government review panel asserted on Sunday that a French television report broadcast in 2000, which appeared to show the death of a 12-year-old Palestinian boy named Muhammad al-Dura during clashes in Gaza, was so deeply flawed that it was possible that the boy had been neither shot nor killed during the incident. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Complete Text of Israel’s Report on the Muhammad al-Dura Video', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Palestinians', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dura, Muhammad al-', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Enderlin, Charles', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Gaza Strip', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-21T00:20:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'o