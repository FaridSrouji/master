2/JPBOCHNER2-articleLarge.jpg', 'height': 296, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/24/arts/JPBOCHNER2/JPBOCHNER2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 296}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/JPBOCHNER2/JPBOCHNER2-jumbo.jpg', 'height': 505, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/JPBOCHNER2/JPBOCHNER2-superJumbo.jpg', 'height': 1010, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/JPBOCHNER2/JPBOCHNER2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/24/arts/JPBOCHNER2/JPBOCHNER2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/JPBOCHNER2/JPBOCHNER2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Calculus With Chalk, Stones and Walnuts', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'A Calculus With Chalk, Stones and Walnuts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bochner, Mel', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-23T20:30:55+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ff453e94-e3ca-510f-9278-37356e85653c', 'word_count': 972, 'uri': 'nyt://article/ff453e94-e3ca-510f-9278-37356e85653c'}, {'abstract': 'For the first time, President Obama clearly stated that the current state of war is unsustainable for a democracy.', 'web_url': 'https://www.nytimes.com/2013/05/24/opinion/obama-vows-to-end-of-the-perpetual-war.html', 'snippet': 'For the first time, President Obama clearly stated that the current state of war is unsustainable for a democracy.', 'lead_paragraph': 'President Obama’s speech on Thursday was the most important statement on counterterrorism policy since the 2001 attacks, a momentous turning point in post-9/11 America. For the first time, a president stated clearly and unequivocally that the state of perpetual warfare that began nearly 12 years ago is unsustainable for a democracy and must come to an end in the not-too-distant future.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The End of the Perpetual War', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The End of the Perpetual War', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Obama, Barack', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Targeted Killings', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Detainees', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Awlaki, Anwar al-', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Guantanamo Bay Naval Base (Cuba)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of the Press', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-05-23T20:36:00+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/2aa6d858-4f09-5fee-b0ae-01b66a8fee8b', 'word_count': 1421, 'uri': 'nyt://article/2aa6d858-4f09-5fee-b0ae-01b66a8fee8b'}, {'abstract': 'The exhibition “Diaghilev and the Ballets Russes, 1909-1929,” at the National Gallery of Art in Washington, celebrates the synergy of dance with music and visual arts.', 'web_url': 'https://www.nytimes.com/2013/05/24/arts/design/diaghilev-and-the-ballets-russes-at-national-gallery.html', 'snippet': 'The exhibition “Diaghilev and the Ballets Russes, 1909-1929,” at the National Gallery of Art in Washington, celebrates the synergy of dance with music and visual arts.', 'lead_paragraph': 'WASHINGTON — Any exhibition honoring Diaghilev’s Ballets Russes is likely to be a blast of color. When the company was born in 1909, its designers Alexandre Benois, Léon Bakst and Nicholas Roerich combined hues with an intensity hitherto unknown on Western stages. Its final premiere, in 1929, was George Balanchine’s ballet “The Prodigal Son,” whose designs by Georges Rouault had, deliberately, the glow of stained-glass windows. In between, great colorists like Picasso, Matisse, Sonia and Robert Delaunay, Mikhail Larionov and Natalia Goncharova passed through like a shower of meteors. ', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/24DIAGHILEV/24DIAGHILEV-articleLarge.jpg', 'height': 1059, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/24/arts/24DIAGHILEV/24DIAGHILEV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1059}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/24DIAGHILEV/24DIAGHILEV-jumbo.jpg', 'height': 1024, 'width': 581, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/24DIAGHILEV/24DIAGHILEV-superJumbo.jpg', 'height': 2048, 'width': 1161, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/24DIAGHILEV/24DIAGHILEV-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/24/arts/24DIAGHILEV/24DIAGHILEV-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/24/arts/24DIAGHILEV/24DIAGHILEV-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Changing the World, Step by Step', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Changing The World, Step by Step', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Ballets Russes', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Gallery of Art', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Diaghilev, Serge', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Gallery (London)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-23T20:40:53+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0f3a5d64-0ac9-5087-8122-ee15a6158c08', 'word_count': 1237, 'uri': 'nyt://article/0f3a5d64-0ac9-5087-8122-ee15a6158c08'}, {'abstract': 'A new restaurant in London’s vibrant neighborhood of Farringdon, Bird of Smithfield, offers a mix of British comfort food and steakhouse classics.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/05/23/food-matters-alan-birds-new-eatery-opens-in-a-five-story-town-house/', 'snippet': 'A new restaurant in London’s vibrant neighborhood of Farringdon, Bird of Smithfield, offers a mix of British comfort food and steakhouse classics.', 'lead_paragraph': 'After heading the kitchen for 15 years at the Ivy, an iconic and celebrity-studded restaurant and private club in London, the chef Alan Bird decided it was time to depart and spread his wings. “We wanted to create a stylish space that had the feel of a members club, but also felt inclusive rather than exclusive,” he said of his newest restaurant, Bird of Smithfield, which opened in the industrial and vibrant neighborhood of Farringdon last week.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Food Matters | Alan Bird’s New Eatery Opens in a Five-Story Town House', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-23T20:47:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Katie Chang', 'person': [{'firstname': 'Katie', 'middlename': None, 'lastname': 'Chang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5aa47fa8-9e7a-588e-a037-96c904dab8dc', 'word_count': 492, 'uri': 'nyt://article/5aa47fa8-9e7a-588e-a037-96c904dab8dc'}, {'abstract': 'The movie industry ignored the growing German menace.', 'web_url': 'https://www.nytimes.com/2013/05/26/books/review/hollywood-and-hitler-by-thomas-doherty.html', 'snippet': 'The movie industry ignored the growing German menace.', 'lead_paragraph': 'Sixty-eight years after the collapse of the Thousand Year Reich, Nazis remain a persistent presence on American screens. With their eye-\xadgrabbing iconography, they provide easy cartoon villains for action films (“Inglourious Basterds”), add moral import to dubious melodramas (“The Reader”), fuel entire cable channels with documentary reconstructions of their crimes and on rare occasions motivate actual works of art.', 'print_section': 'BR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26KEHR/26KEHR-articleLarge.jpg', 'height': 453, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/26/books/review/26KEHR/26KEHR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 453}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26KEHR/26KEHR-jumbo.jpg', 'height': 773, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/26/books/review/26KEHR/26KEHR-superJumbo.jpg', 'height': 926, 'width': 1226, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': 