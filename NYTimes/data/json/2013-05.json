ot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Julien, Claude', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Marchand, Brad', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Tortorella, John', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Bruins', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-16T17:30:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da8fc628-cc67-55d3-a8a2-5658bdb9f6d6', 'word_count': 407, 'uri': 'nyt://article/da8fc628-cc67-55d3-a8a2-5658bdb9f6d6'}, {'abstract': 'The committee voted 10-to-8 along partisan lines to send the nomination of Gina McCarthy to the Senate floor.', 'web_url': 'https://www.nytimes.com/2013/05/17/us/politics/senate-panel-advances-nominee-for-epa.html', 'snippet': 'The committee voted 10-to-8 along partisan lines to send the nomination of Gina McCarthy to the Senate floor.', 'lead_paragraph': 'WASHINGTON — A sharply divided Senate committee on Thursday approved the nomination of Gina McCarthy to serve as administrator of the Environmental Protection Agency.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Senate Panel Advances Nominee for E.P.A.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McCarthy, Gina', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 