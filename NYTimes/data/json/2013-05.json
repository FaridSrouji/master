ncoln', 'middlename': None, 'lastname': 'Chafee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/8aca8061-7597-594a-adc2-510890abcd2a', 'word_count': 1232, 'uri': 'nyt://article/8aca8061-7597-594a-adc2-510890abcd2a'}, {'abstract': 'The trial of two former aides to Comptroller John C. Liu went to the jury after lawyers portrayed them as victims of prosecutorial zeal.', 'web_url': 'https://www.nytimes.com/2013/05/02/nyregion/fraud-trial-of-ex-aides-to-john-c-liu-goes-to-jury.html', 'snippet': 'The trial of two former aides to Comptroller John C. Liu went to the jury after lawyers portrayed them as victims of prosecutorial zeal.', 'lead_paragraph': 'Lawyers for two former associates of John C. Liu, the New York City comptroller, asked a jury on Wednesday to acquit their clients of conspiring in an illegal campaign finance scheme that was to benefit Mr. Liu, now a Democratic candidate for mayor.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Defense in Fraud Trial Blames Failed U.S. Effort to Charge Liu', 'kicker': None, 'content_kicker': None, 'print_headline': 'Defense in Fraud Trial Blames Failed U.S. Effort to Charge Liu', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Liu, John C', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pan, Xing Wu', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hou, Jia', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Comptrollers', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-05-02T0