dlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c9a3b2d7-0c04-5398-816a-107197b41124', 'word_count': 571, 'uri': 'nyt://article/c9a3b2d7-0c04-5398-816a-107197b41124'}, {'abstract': 'The recovery since the recession that ended in 2009 has been the weakest in decades, as measured by the change in gross domestic product. That is mainly due to a shrinking government sector and to relatively slow growth in consumer spending.', 'web_url': 'https://www.nytimes.com/interactive/2013/05/03/business/For-Business-a-Strong-Recovery.html', 'snippet': 'The recovery since the recession that ended in 2009 has been the weakest in decades, as measured by the change in gross domestic product. That is mainly due to a shrinking government sector and to relatively slow growth in consumer spending.', 'lead_paragraph': 'The recovery since the recession that ended in 2009 has been the weakest in decades, as measured by the change in gross domestic product. That is mainly due to a shrinking government sector and to relatively slow growth in consumer spending.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Off the Charts: For Business, a Strong Recovery', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recession and Depression', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-03T11:50:52+0000', 'document_type': 'multimedia', 'news_desk': 'Business Day', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/42e76d48-c09c-590c-8b45-fef79a06b69e', 'word_count': 0, 'uri': 'nyt://interactive/42e76d48-c09c-590c-8b45-fef79a06b69e'}, {'abstract': 'Students are able to join the Hawaiian expedition and help in recording hump