.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'So Bake Sales Are Taboo? Try Selling Hand Sanitizer', 'kicker': None, 'content_kicker': None, 'print_headline': 'So Bake Sales Are Taboo? Try Selling Hand Sanitizer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Education Department (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Miller, Jennifer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Snack Foods', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Obesity', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Carlson, Lynn', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-05-27T01:02:44+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Jennifer Miller', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6dba76f0-fe1f-5d8f-ac20-ba22769af6ea', 'word_count': 1047, 'uri': 'nyt://article/6dba76f0-fe1f-5d8f-ac20-ba22769af6ea'}, {'abstract': 'A chasm has opened between our citizens and our men and women in uniform. Soldier and citizen must once again be brought to stand side by side.', 'web_url': 'https://www.nytimes.com/2013/05/27/opinion/americans-and-their-military-drifting-apart.html', 'snippet': 'A chasm has opened between our citizens and our men and women in uniform. Soldier and citizen must once again be brought to stand side by side.', 'lead_paragraph': 'STANFORD, Calif. — AFTER fighting two wars in nearly 12 years, the United States military is at a turning point. So are the American people. The armed forces must rethink their mission. Though the nation has entered an era of fiscal constraint, and though President Obama last week effectively declared an end to the “global war on terror” that began on Sept. 11, 2001, the military remains determined to increase the gap between its war-fighting capabilities and those of any potential enemies. But the greatest challenge to our military is not from a foreign enemy — it’s the widening gap between the American people and their armed forces. ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/27/opinion/0527OPEDplunkert/0527OPEDplunkert-articleLarge.jpg', 'height': 527, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/27/opinion/0527OPEDplunkert/0527OPEDplunkert-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 527}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/27/opinion/0527OPEDplunkert/0527OPEDplunkert-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/27/opinion/0527OPEDplunkert/0527OPEDplunkert-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/27/opinion/0527OPEDplunkert/0527OPEDplunkert-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/27/opinion/0527OPEDplunkert/0527OPEDplunkert-thumbStandar