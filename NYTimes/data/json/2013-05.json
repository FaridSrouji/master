Type': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Theater', 'kicker': 'Summer Stages', 'content_kicker': None, 'print_headline': 'Theater', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-16T16:50:33+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Theater', 'byline': {'original': 'By Steven McElroy', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'McElroy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/629d98d6-7c1b-5287-899a-419ea96f61d8', 'word_count': 5706, 'uri': 'nyt://article/629d98d6-7c1b-5287-899a-419ea96f61d8'}, {'abstract': 'The behavior of some individuals at the tax agency is inexcusable. What it reveals about our election laws is worse.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/05/16/behind-the-i-r-s-mess-a-campaign-finance-scandal/', 'snippet': 'The behavior of some individuals at the tax agency is inexcusable. What it reveals about our election laws is worse.', 'lead_paragraph': 'Let’s stipulate that the scandal involving the Internal Revenue Service’s targeting of conservative nonprofit groups portrays government as if drawn in caricature — an almost Keystone Kops-style comedy of errors on the part of low-level staffers, with a vein of possible political bias.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Behind the I.R.S. Mess: A Campaign-Finance Scandal', 'kicker': 'Steven Rattner', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-16T16:58:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Steven Rattner', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Rattner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a9e46253-9471-50bb-bcd4-44a2d102112d', 'word_count': 722, 'uri': 'nyt://article/a9e46253-9471-50bb-bcd4-44a2d102112d'}, {'abstract': 'Car2Go, the car-sharing service in Austin, Tex., has plans to add up to five cities to its North American roster this year.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/05/16/swipe-a-card-get-a-car/', 'snippet': 'Car2Go, the car-sharing service in Austin, Tex., has plans to add up to five cities to its North American roster this year.', 'lead_paragraph': 'Car2Go, the car-sharing service in Austin, Tex., from the German luxury-car maker Daimler, has plans to add up to five cities, including Denver, Minneapolis and Montreal, to its North American roster this year. The service’s fleet of electric and standard Smart cars allows for rentals by the minute and in one direction. It frees drivers from picking up and returning cars to a specific location by letting them use their smartphones to locate available cars and unlock them by scanning their membership cards.', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Swipe a Card, Get a Car', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': 'Rental Cars: Swipe a Card, Get a Car', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Car2go', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-16T17:00:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Emily Brennan', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': 'Brennan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a76466f7-cd99-5224-9a74-b1ef15563086', 'word_count': 83, 'uri': 'nyt://article/a76466f7-cd99-5224-9a74-b1ef15563086'}, {'abstract': 'For those frequent fliers, a primer on what to pack for this season.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/05/16/market-report-carry-on-essentials-for-spring-jet-setters/', 'snippet': 'For those frequent fliers, a primer on what to pack for this season.', 'lead_paragraph': 'This season’s spring basics are unusually versatile, coming together to carry an outfit from day to night, business class to cocktail hour, the flyover states to the South of France — say, for the Cannes Film Festival, which kicked off yesterday. Here, a roundup of what should be in the jet-setter’s carry-on, including neutral accessories to complement any outfit and ballet flats with a punch of color. The only thing missing is the trip.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Market Report | Carry-On Essentials for Spring Jet-Setters', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cannes International Film Festival', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-05-16T17:11:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1f1dab7f-0332-5575-b922-370a26dddc32', 'word_count': 83, 'uri': 'nyt://article/1f1dab7f-0332-5575-b922-370a26dddc32'}, {'abstract': 'Chris Nelson’s stay with the Yankees was brief, but Jayson Nix wanted him to know that if he continued to work hard at his game, he would be back.', 'web_url': 'https://www.nytimes.com/2013/05/17/sports/baseball/yankees-jayson-nix-tells-chris-nelson-hell-be-back-in-majors.html', 'snippet': 'Chris Nelson’s stay with the Yankees was brief, but Jayson Nix wanted him to know that if he continued to work hard at his game, he would be back.', 'lead_paragraph': 'Shortly after he heard the news that his brief stay with the Yankees was over, Chris Nelson stood in a hallway near the team’s clubhouse talking to someone who had been in the same situation: depressed, frustrated and returning to the minor leagues.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/17/sports/baseball/17nelson/17nelson-articleLarge.jpg', 'height': 363, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/17/sports/baseball/17nelson/17nelson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 363}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/17/sports/baseball/17nelson/17nelson-jumbo.jpg', 'height': 620, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/17/sports/baseball/17nelson/17nelson-superJumbo.jpg', 'height': 1239, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/17/sports/baseball/17nelson/17nelson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/17/sports/baseball/17nelson/17nelson-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/17/sports/baseball/17nelson/17nelson-thumbLarge