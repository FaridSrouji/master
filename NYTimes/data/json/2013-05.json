s_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Jessica Silver-Greenberg and Susanne Craig', 'person': [{'firstname': 'Jessica', 'middlename': None, 'lastname': 'Silver-Greenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Susanne', 'middlename': None, 'lastname': 'Craig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2d7281ab-b3b9-53f2-9565-82f7e883ae4b', 'word_count': 1426, 'uri': 'nyt://article/2d7281ab-b3b9-53f2-9565-82f7e883ae4b'}, {'abstract': 'Rhonda Glenn, who literally wrote the book on women’s golf, retired last week after nearly 50 years as a journalist and an employee of the United States Golf Association.', 'web_url': 'https://www.nytimes.com/2013/05/13/sports/golf/for-rhonda-glenn-a-career-of-giving-a-voice-to-womens-golf.html', 'snippet': 'Rhonda Glenn, who literally wrote the book on women’s golf, retired last week after nearly 50 years as a journalist and an employee of the United States Golf Association.', 'lead_paragraph': 'SUMMERFIELD, Fla. — When Rhonda Glenn was a young woman in 1966, she was the publicity coordinator for the L.P.G.A.’s Louise Suggs Invitational in Delray Beach, Fla. She was an amateur at that event and was paired in the first round with Mickey Wright and Betsy Rawls, who went on to become Hall of Famers.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/13/sports/ONPAR/ONPAR-articleLarge.jpg', 'height': 789, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/13/sports/ONPAR/ONPAR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 789}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/