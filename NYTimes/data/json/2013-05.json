_count': 577, 'uri': 'nyt://article/d062df5e-287d-57ea-b06e-654cc16154f4'}, {'abstract': 'A report released by the Organization of American States encouraged “flexibility” in how the drug war is carried out, including considering the legalization of marijuana.', 'web_url': 'https://www.nytimes.com/2013/05/18/world/americas/nations-in-americas-urged-to-consider-legalizing-pot.html', 'snippet': 'A report released by the Organization of American States encouraged “flexibility” in how the drug war is carried out, including considering the legalization of marijuana.', 'lead_paragraph': 'MEXICO CITY — A comprehensive report on drug policy in the Americas released Friday by a consortium of nations suggests that the legalization of marijuana, but not other illicit drugs, be considered among a range of ideas to reassess how the drug war is carried out.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Americas Coalition Puts Marijuana Legalization Up for Discussion', 'kicker': None, 'content_kicker': None, 'print_headline': 'Americas Coalition Suggests Marijuana Laws Be Relaxed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Archibold, Randal C', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Marijuana', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Summit of the Americas', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Organization of American States', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Latin America', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-18T01:50:56+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Randal C. Archibold', 'person': [{'firstname': 'Randal', 'middlename': 'C.', 'lastname': 'Archibold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c2b14ea-4e14-5281-ac1e-9c675b5d4f72', 'word_count': 726, 'uri': 'nyt://article/4c2b14ea-4e14-5281-ac1e-9c675b5d4f72'}, {'abstract': 'Questions have been raised about Mayor Rob Ford’s conduct, temperament and public statements since his early days as a member of the Toronto City Council.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/05/17/long-before-crack-cocaine-allegations-toronto-mayor-was-a-source-of-controversy/', 'snippet': 'Questions have been raised about Mayor Rob Ford’s conduct, temperament and public statements since his early days as a member of the Toronto City Council.', 'lead_paragraph': 'As our colleague Ian Austen reports, Mayor Rob Ford of Toronto angrily dismissed allegations on Friday that he had used crack cocaine in a 90-second cellphone video that is being peddled to United States and Canadian news organizations for more than $100,000. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Long Before Crack Cocaine Allegations, Toronto Mayor Was a Source of Controversy', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cocaine and Crack Cocaine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings and Downloads', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Gawker.com', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Toronto Star', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Toronto (Ontario)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-18T01:51:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Jennifer Preston and Liam Stack', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'l