/travel/07frugal-sites/07frugal-sites-jumbo-v2.jpg', 'height': 596, 'width': 947, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/07/travel/07frugal-sites/07frugal-sites-superJumbo-v2.jpg', 'height': 596, 'width': 947, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/07/travel/07frugal-sites/07frugal-sites-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/07/travel/07frugal-sites/07frugal-sites-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/07/travel/07frugal-sites/07frugal-sites-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Five Travel Problems and the Sites That Try to Solve Them', 'kicker': 'Frugal Traveler', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Budget Travel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Flightfox Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'GetGoing Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Mosey LLC', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Pintrips Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Zofari Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-07T19:17:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Seth Kugel', 'person': [{'firstname':