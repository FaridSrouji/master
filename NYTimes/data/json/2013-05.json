_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tests (Sobriety)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-29T13:26:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Finkel', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Finkel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3832482b-b578-54f6-ac3a-f396f6942c36', 'word_count': 688, 'uri': 'nyt://article/3832482b-b578-54f6-ac3a-f396f6942c36'}, {'abstract': 'Mr. Sarsgaard, a star of films like “Boys Don’t Cry,” talks about being cast on “The Killing,” and why its notorious first-season finale made him more eager to be involved.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/05/29/you-wouldnt-like-him-when-hes-angry-peter-sarsgaard-joins-the-killing/', 'snippet': 'Mr. Sarsgaard, a star of films like “Boys Don’t Cry,” talks about being cast on “The Killing,” and why its notorious first-season finale made him more eager to be involved.', 'lead_paragraph': 'When you sign up Peter Sarsgaard to be on a show like “The Killing,” it’s probably safe to assume you don’t want him to play the rigidly moral chief of police or the squeaky-clean neighbor next door. Sure enough, when Mr. Sarsgaard joins this AMC crime procedural for its third season, and in his first television role since starring in films like “Boys Don’t Cry,” “Kinsey” and “Shattered Glass,” he will be playing the part of Ray Seward, “a death row inmate, set to be executed in 30 days 