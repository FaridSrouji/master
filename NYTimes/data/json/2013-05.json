ar-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/19/world/anwar/anwar-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/world/anwar/anwar-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Disputed Election Sends Malaysian Politician Back to Fight on the Streets', 'kicker': None, 'content_kicker': None, 'print_headline': 'Disputed Election Sends Malaysian Politician Back to Fight on the Streets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fuller, Thomas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ibrahim, Anwar', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Malaysia', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Political Prisoners', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-18T23:45:47+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5e90d11c-14cb-5d77-a669-f18b3abc12e9', 'word_count': 1189, 'uri': 'nyt://article/5e90d11c-14cb-5d77-a669-f18b3abc12e9'}, {'abstract': 'With a peace center planned for Maze prison, home of an I.R.A. hunger strike, some in Northern Ireland are revisiting the complex story of the Troubles.', 'web_url': 'https://www.nytimes.com/2013/05/19/world/europe/maze-prisons-future-stirs-up-ghosts-of-its-past.html', 'snippet': 'With a peace center planned for Maze prison, home of an I.R.A. hunger strike, some in Northern Ireland are revisiting the complex story of the Troubles.', 'lead_paragraph': 'MAZE, Northern Ireland — On a quiet country road south of Belfast, only the sudden appearance of a watchtower and portions of walls offer any hint of what was once Europe’s most notorious prison. After the last inmates walked out the gates in 2000, the bulldozers moved in, leaving little of the top security fortress intact. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/world/SUB-IRELAND-2/SUB-IRELAND-2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/19/world/SUB-IRELAND-2/SUB-IRELAND-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/world/SUB-IRELAND-2/SUB-IRELAND-2-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/world/SUB-IRELAND-2/SUB-IRELAND-2-superJumbo.jpg', 'height': 1306, 'width': 1960, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/19/world/SUB-IRELAND-2/SUB-IRELAND-2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/19/world/SUB-IRELAND-2/SUB-IRELAND-2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit