 the academic fashions of the moment.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/arts/29HANNAH/29HANNAH-articleLarge.jpg', 'height': 325, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/29/arts/29HANNAH/29HANNAH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 325}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/arts/29HANNAH/29HANNAH-jumbo.jpg', 'height': 555, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/arts/29HANNAH/29HANNAH-superJumbo.jpg', 'height': 1109, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/arts/29HANNAH/29HANNAH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/29/arts/29HANNAH/29HANNAH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/arts/29HANNAH/29HANNAH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How It Looks to Think: Watch Her', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'How It Looks to Think: Watch Her', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'von Trotta, Margarethe', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'ARENDT, HANNAH', 'rank': 3