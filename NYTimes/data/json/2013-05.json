.nytimes.com/2013/05/01/in-brown-vitter-bill-a-banking-overhaul-with-possible-teeth/', 'snippet': 'Senators Sherrod Brown and David Vitter introduced a bill that could be a barbaric yawp of anger at big banks or something with actual force.', 'lead_paragraph': 'The biggest banks have done an excellent job of delaying and undermining the Dodd-Frank financial overhaul law and staving off criminal investigations into wrongdoing.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Brown-Vitter Bill, a Banking Overhaul With Possible Teeth', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Sherrod', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Vitter, David', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-01T16:00:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Jesse Eisinger', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'Eisinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9268fc5a-d0c2-532f-92b1-277279a69094', 'word_count': 1223, 'uri': 'nyt://article/9268fc5a-d0c2-532f-92b1-277279a69094'}, {'abstract': 'Patients see overweight doctors as less credible than “normal weight” doctors, a new study by Yale University researchers found.', 'web_url': 'https://well.blogs.nytimes.com/2013/05/01/when-the-doctor-is-overweight/', 'snippet': 'Patients see overweight doctors as less credible than “normal weight” doctors, a new study by Yale University researchers found.', 'lead_paragraph': 'Dr. George Fielding, a pioneer of weight loss surgery in Australia, remembers how patients treated him in the late 1990s, when his weight reached 330 pounds on his six-foot frame. He would meet new patients, dressed in Armani suits and feeling on top of the world, and then be abruptly upended.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/26/health/26well_fatdoc/26well_fatdoc-articleLarge.jpg', 'height': 1207, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/26/health/26well_fatdoc/26well_fatdoc-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1207}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/26/health/26well_fatdoc/26well_fatdoc-jumbo.jpg', 'height': 1024, 'width': 510, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/26/health/26well_fatdoc/26well_fatdoc-superJumbo.jpg', 'height': 1565, 'width': 778, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/26/health/26well_fatdoc/26well_fatdoc-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/26/health/26well_fatdoc/26well_fatdoc-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/26/health/26well_fatdoc/26well_fatdoc-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When the Doctor Is Overweight', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Doctors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Obesity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Weight', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fielding, George', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'International Journal of Obesity', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-01T16:03:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Jan Hoffman', 'person': [{'firstname': 'Jan', 'middlename': None, 'lastname': 'Hoffman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e09c939-fe91-53f5-8090-56cbcd4f241b', 'word_count': 898, 'uri': 'nyt://article/0e09c939-fe91-53f5-8090-56cbcd4f241b'}, {'abstract': 'I wasn’t aware that the sanctity of the Second Amendment included the principle that any gun, once made, must exist forever.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/05/01/keeping-guns-in-circulation/', 'snippet': 'I wasn’t aware that the sanctity of the Second Amendment included the principle that any gun, once made, must exist forever.', 'lead_paragraph': 'While Senator Joe Manchin decides whether to reintroduce his failed background checks bill, other lawmakers are busy passing new gun measures that decrease rather than increase regulation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Keeping Guns in Circulation', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brewer, Jan', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-01T16:05:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5c12c718-d396-5b55-b9a1-65e9b429938c', 'word_count': 394, 'uri': 'nyt://article/5c12c718-d396-5b55-b9a1-65e9b429938c'}, {'abstract': 'A new exhibit at the Yogi Berra Museum and Learning Center will detail the evolution of acceptance in sports regardless of race, religion, ethnicity, gender or sexual orientation.', 'web_url': 'https://bats.blogs.nytimes.com/2013/05/01/berra-museum-to-highlight-inclusion-in-sports/', 'snippet': 'A new exhibit at the Yogi Berra Museum and Learning Center will detail the evolution of acceptance in sports regardless of race, religion, ethnicity, gender or sexual orientation.', 'lead_paragraph': 'The Yogi Berra Museum and Learning Center in Little Falls, N.J., is creating a new exhibit, Championing Respect, which will detail the evolution of attitudes from Jackie Robinson breaking the color barrier to the latest news of gay athletes openly competing.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Berra Museum to Highlight Inclusion in Sports', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Hudson', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Athlete Ally', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Yogi Berra Museum', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-01T16:15:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By John Branch', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Branch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0846e13b-180b-54b5-b033-cad9608d541c', 'word_count': 278, 'uri': 'nyt://article/0846e13b-180b-54b5-b033-cad9608d541c'}, {'abstract': 'Within a seeming contradiction in the long-term national pay trends is a statistical aberration.', 'web_url': 'https://economix.blogs.nytimes.com/2013/05/01/can-every-group-be-worse-than-average-yes/', 'snippet': 'Within a seeming contradiction in the long-term national pay trends is a statistical aberration.', 'lead_paragraph': 'My Off the Charts column last week noted that pay disparities had grown in the United States since 2000. The real income necessary to reach the 90th percentile — the top 10 percent of all wage owners — was 9 percent higher in the first quarter than it had been 13 years earlier. The income necessary to be in the 10th percentile was down 3 percent over the same period. The pay needed to be at the median was up 1 percent.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Can Every Group Be Worse Than Average?  Yes.', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Statistics', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-01T16:17:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Floyd Norris', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f41f2c0-303f-5da0-83bd-533baf618898', 'word_count': 319, 'uri': 'nyt://article/4f41f2c0-303f-5da0-83bd-533baf618898'}, {'abstract': 'The oil giant has about 7 percent of global liquefied natural gas production, and wants to more than double that with new investments and acquisitions.', 'web_url': 'https://www.nytimes.com/2013/05/02/business/energy-environment/02iht-shell02.html', 'snippet': 'The oil giant has about 7 percent of global liquefied natural gas production, and wants to more than double that with new investments and acquisitions.', 'lead_paragraph': 'LONDON — As Big Oil increasingly becomes Big Gas, no major petroleum player may have more at stake in the shift than Royal Dutch Shell.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/business/Shell/Shell-articleLarge.jpg', 'height': 336, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/02/business/Shell/Shell-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 336}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/business/Shell/Shell-jumbo.jpg', 'height': 573, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/02/business/Shell/Shell-superJumbo.jpg', 'height': 1147, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Shell Makes Big Bet on Boom in Natural Gas', 'kicker': None, 'content_kicker': None, 'print_headline': 'Shell Makes a Heavy Bet On a Boom in Natural Gas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Reed, Stanley', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Royal Dutch Shell Plc', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Natural Gas', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-01T16:23:22+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Energy & Environment ', 'byline': {'original': 'By Stanley Reed', 'person': [{'firstname': 'Stanley', 'middlename': None, 'lastname': 'Reed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/85d911ad-cc9b-56b1-bb9a-e24eaa571f1a', 'word_count': 1351, 'uri': 'nyt://article/85d911ad-cc9b-56b1-bb9a-e24eaa571f1a'}, {'abstract': 'Saddles in flight: the windows of Hermès’s new boutique in Greenwich, Conn., feature art by Pamen Pereira and the brand’s new equestrian collection.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/05/01/feeling-for-hermes-equestrian-collection/', 'snippet': 'Saddles in flight: the windows of Hermès’s new boutique in Greenwich, Conn., feature art by Pamen Pereira and the brand’s new equestrian collection.', 'lead_paragraph': 'Although it is perhaps better known for its iconic handbags, the French brand Hermès originated as a harness and bridle maker in the 19th century for European nobility. Last month, the brand introduced its new Cavale saddle and Jumping Lady boot at Le Saut Hermès competition at the Grand Palais in Paris. And starting May 4, these pieces become the focus of the Spanish artist Pamen Pereira‘s windows for the brand’s new boutique in Greenwich, Conn. Pereira, whose previous installations for Hermès stores in Taiwan and Barcelona featured birds, elevated her usual flight concept with an avant-garde interpretation of the equestrian competition by way of winged saddles and motorized riding boots (as pictured above in T’s exclusive peek at the artist’s window plans). ', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Feeling For | Hermès Equestrian Collection', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Feeling For | Hermès Equestrian Collection', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shoes and Boots', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hermes International SA', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich (Conn)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-01T16:25:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5596de7-775e-5357-a598-eb43f01e3205', 'word_count': 148, 'uri': 'nyt://article/e5596de7-775e-5357-a598-eb43f01e3205'}, {'abstract': 'A few of the HTML5 Dev Conf talks we recently recommended are now available.', 'web_url': 'https://open.blogs.nytimes.com/2013/05/01/html5-dev-conf-videos/', 'snippet': 'A few of the HTML5 Dev Conf talks we recently recommended are now available.', 'lead_paragraph': 'A few of the HTML5 Dev Conf talks we recently recommended are now available on the event video sessions page. Don’t miss the two keynotes (Steve Souders and Christian Heillmann).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'HTML5 Dev Conf Videos', 'kicker': 'Open', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-01T16:26:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Marci Windsheimer', 'person': [{'firstname': 'Marci', 'middlename': None, 'lastname': 'Windsheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organiza