/books/review/12saltzstein/12saltzstein-articleLarge.jpg', 'height': 1304, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/books/review/12saltzstein/12saltzstein-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1304}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12saltzstein/12saltzstein-jumbo.jpg', 'height': 1024, 'width': 472, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12saltzstein/12saltzstein-superJumbo.jpg', 'height': 1595, 'width': 734, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12saltzstein/12saltzstein-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/books/review/12saltzstein/12saltzstein-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12saltzstein/12saltzstein-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trash and the City', 'kicker': None, 'content_kicker': None, 'print_headline': 'Trash and the City', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Saltzstein, Dan', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nagle, Robin', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Waste Materials and Disposal', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-10T14:32:07+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Dan Saltzstein', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Saltzstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/30c539fa-da40-51a3-9ec4-00641dac7eb7', 'word_count': 639, 'uri': 'nyt://article/30c539fa-da40-51a3-9ec4-00641dac7eb7'}, {'abstract': 'A journalist finds flaws in the care of mothers and infants.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/the-business-of-baby-by-jennifer-margulis.html', 'snippet': 'A journalist finds flaws in the care of mothers and infants.', 'lead_paragraph': 'Americans, you may have noticed, live in a capitalist society. In practical terms, this means someone is often trying to sell us something. John Updike saw a kind of glory in this: “America is a vast conspiracy to make you happy,” he wrote. Jennifer Margulis sees a vast conspiracy too, only its purpose is to make you miserable, sick and quite possibly dead, especially if you are a pregnant woman or a new mother.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-PAUL/0512-bks-PAUL-articleLarge.jpg', 'height': 1023, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/books/review/0512-bks-PAUL/0512-bks-PAUL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1023}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-PAUL/0512-bks-PAUL-jumbo.jpg', 'height': 1024, 'width': 601, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-PAUL/0512-bks-PAUL-superJumbo.jpg', 'height': 1622, 'width': 951, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-PAUL/0512-bks-PAUL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/books/review/0512-bks-PAUL/0512-bks-PAUL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-PAUL/0512-bks-PAUL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bad News for Baby', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bad News for Baby', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Paul, Annie Murphy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Babies and Infants', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Margulis, Jennifer', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-10T14:32:38+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Annie Murphy Paul', 'person': [{'firstname': 'Annie', 'middlename': 'Murphy', 'lastname': 'Paul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/75436477-d379-5f26-9e37-db10f2b66889', 'word_count': 1215, 'uri': 'nyt://article/75436477-d379-5f26-9e37-db10f2b66889'}, {'abstract': 'A British astronomer attempts to signal Mars in Ken Kalfus’s novel.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/equilateral-by-ken-kalfus.html', 'snippet': 'A British astronomer attempts to signal Mars in Ken Kalfus’s novel.', 'lead_paragraph': 'Set in the scorching heat of the Egyptian desert at the end of the 19th century, Ken Kalfus’s new novel follows a fictional British astronomer’s attempt to make contact with Mars. Hundreds of thousands of men are digging the gigantic equilateral triangle with which Sanford Thayer intends to send a signal to his fellow astronomers on the red planet. Once finished, each side will consist of a paved trench more than 300 miles long and exactly one seventy-third of Earth’s circumference. The trenches, five miles wide, are deep enough to be filled with a 12-inch layer of petroleum that will flow from 309 taps connected to a pipeline. The huge black triangle set against the white desert sand will prove the existence of terrestrial intelligence to the Martians, Thayer argues, because the equal-sided triangle is part of the two planets’ “shared knowledge of trigonometry.” The equilateral triangle is, he believes, the “basis for all human art and construction.”', 'print_section': 'BR', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-WULF/0512-bks-WULF-articleLarge.jpg', 'height': 934, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/books/review/0512-bks-WULF/0512-bks-WULF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 934}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-WULF/0512-bks-WULF-jumbo.jpg', 'height': 1024, 'width': 659, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank':