le': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/19b185b4-4e12-523d-ad31-6d61e1af26f6', 'word_count': 570, 'uri': 'nyt://article/19b185b4-4e12-523d-ad31-6d61e1af26f6'}, {'abstract': 'Peace, quiet, a chair, and a connection.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/05/09/in-praise-of-public-libraries-personal-and-trivial/', 'snippet': 'Peace, quiet, a chair, and a connection.', 'lead_paragraph': 'Nothing professional or deep here, just an interesting (to me) discovery I’ve made. For complicated reasons, mainly family-duty-related, I’ve lately had to do a lot of hopscotching around central New Jersey, with various appointments and tasks here and there but often with gaps of several hours in between. And, as always, lots of work to get done in the cracks. What to do?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Praise of Public Libraries (Personal and Trivial)', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-09T23:38:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/32ca5136-0e55-5471-b369-f0f43dd5533b', 'word_count': 191, 'uri': 'nyt://article/32ca5136-0e55-5471-b369-f0f43dd5533b'}, {'abstract': 'Andrew Simpson, a British sailor and Olympic gold medalist, was caught beneath the capsized boat, the team said. Simpson had been sailing for Artemis, Sweden’s entry in the America’s Cup.', 'web_url': 'https://www.nytimes.com/2013/05/10/sports/sailor-andrew-simpson-dies-in-americas-cup-accident.html', 'snippet': 'Andrew Simpson, a British sailor and Olympic gold medalist, was caught beneath the capsized boat, the team said. Simpson had been sailing for Artemis, Sweden’s entry in the America’s Cup.', 'lead_paragraph': 'Andrew Simpson, a 36-year-old British sailor and Olympic gold medalist, died Thursday after a 72-foot America’s Cup yacht owned by the Swedish team Artemis Racing capsized during training in San Francisco Bay.', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/sports/10sailing1-img/10sailing1-img-articleLarge.jpg', 'height': 373, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/10/sports/10sailing1-img/10sailing1-img-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 373}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/sports/10sailing1-img/10sailing1-img-jumbo.jpg', 'height': 636, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/sports/10sailing1-img/10sailing1-img-superJumbo.jpg', 'height': 1242, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/sports/10sailing1-img/10sailing1-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/10/sports/10sailing1-img/10sailing1-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/10/sports/10sailing1-img/10sailing1-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLar