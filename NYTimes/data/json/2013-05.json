th': 719, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/16/business/Tsujihara-media/Tsujihara-media-superJumbo.jpg', 'height': 2048, 'width': 1437, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/16/business/Tsujihara-media/Tsujihara-media-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/16/business/Tsujihara-media/Tsujihara-media-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/16/business/Tsujihara-media/Tsujihara-media-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Chief Revamps Warner Brothers, Clearing Way for Rival to Leave', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Warner Brothers', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tsujihara, Kevin', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-15T18:55:29+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b1aca5bd-9233-5910-a230-065285ed3256', 'word_count': 202, 'uri': 'nyt://article/b1aca5bd-9233-5910-a230-065285ed3256'}, {'abstract': 'Shining along with the stars at Cannes: a new collection of one-of-a-kind pieces from the Swiss-based company.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/05/15/objects-chopards-red-carpet-collection/', 'snippet': 'Shining along with the stars at Cannes: a new collection of one-of-a-kind pieces from the Swiss-based company.', 'lead_paragraph': 'The French premiere of “The Great Gatsby” isn’t the only high-profile event at the opening of the 66th annual Cannes Film Festival. Also making its debut this evening is Chopard’s decadent collection of 66 one-of-a-kind pieces, one for each year of the festival’s history. Jewelry made with pastel-colored gems like kunzite, paraiba tourmaline and mauve spinel plays a supporting role to diamond pieces. But the real showstopper is a choker and ring set (above) featuring poppy flowers fashioned with rubies, emeralds and tsavorites. Festivalgoers will get to view the collection up close on beguiling beauties on the red carpet, where the likes of Cara Delevingne and other A-listers will model it over the course of the festival.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Objects | Chopard’s Red Carpet Collection', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cannes International Film Festival', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jewels and Jewelry', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chopard', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Cannes (France)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-15T18:59:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b1bc4ba1-fc4c-55ea-8307-5f192f9ca38b', 'word_count': 117, 'uri': 'nyt://article/b1bc4ba1-fc4c-55ea-8307-5f192f9ca38b'}, {'abstract': 'Photographing frying foods can be physically and artistically challenging.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/05/15/the-suggestion-of-fried-chicken/', 'snippet': 'Photographing frying foods can be physically and artistically challenging.', 'lead_paragraph': 'Outtakes is a behind-the-scenes glimpse of images in the Dining section. Andrew Scrivani (@AndrewScrivani on Twitter and Instagram) is a freelance photographer and a regular contributor to The New York Times. He writes the blog making SundaySauce.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Suggestion of Fried Chicken', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-15T18:59:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Andrew Scrivani', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Scrivani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/13f8b45a-8f77-5d4e-98b1-100a72db3f08', 'word_count': 335, 'uri': 'nyt://article/13f8b45a-8f77-5d4e-98b1-100a72db3f08'}, {'abstract': 'We have to be careful not to conflate Jolie’s situation and choices with those of an average woman or even with those of a woman who receives a diagnosis of low-grade breast cancer.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2013/05/15/reacting-to-angelina-jolies-breast-cancer-news/', 'snippet': 'We have to be careful not to conflate Jolie’s situation and choices with those of an average woman or even with those of a woman who receives a diagnosis of low-grade breast cancer.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [{'rank': 0, '