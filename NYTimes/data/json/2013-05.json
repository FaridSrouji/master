omy/video-mastectomy-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/14/us/video-mastectomy/video-mastectomy-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Revisiting a ‘Previvor’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Breast Cancer', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jolie, Angelina', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mastectomy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-14T22:01:21+0000', 'document_type': 'multimedia', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'Kassie Bracken and Ben Werschkul', 'person': [{'firstname': 'Kassie', 'middlename': None, 'lastname': 'Bracken', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ben', 'middlename': None, 'lastname': 'Werschkul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/52f639e8-da0f-5f87-8231-4d3d1788e4b1', 'word_count': 0, 'uri': 'nyt://video/52f639e8-da0f-5f87-8231-4d3d1788e4b1'}, {'abstract': '“Todd the God,” as Mr. Edwards is known to fans, talks about his role on the electronic duo’s new album and the state of dance music today.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/05/14/q-a-daft-punks-secret-weapon-producer-todd-edwards/', 'snippet': '“Todd the God,” as Mr. Edwards is known to fans, talks about his role on the electronic duo’s new album and the state of dance music today.', 'lead_paragraph': 'The storied house music producer Todd Edwards is two decades into a groundbreaking career in which he pioneered the cut-up sample technique that gave birth to the U.K. garage style of dance music, earning him the nickname “Todd the God” with aficionados. But it feels like he’s only been warming up the decks. A frequent collaborator with Daft Punk — he wrote and sang “Face to Face” from their 2001 album “Discovery” — Mr. Edwards reunites with the helmet-wearing pair for a track on their much-anticipated album “Random Access Memories,” out May 21 (and streaming now on iTunes). ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Q. & A. | Daft Punk’s Secret Weapon: Producer Todd Edwards', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Daft Punk (Music Group)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-14T22:04:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alex Hawgood', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Hawgood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5062e945-b124-5d66-acb7-d630990ad2d0', 'word_count': 839, 'uri': 'nyt://article/5062e945-b124-5d66-acb7-d630990ad2d0'}, {'abstract': 'The service is expected to be announced as early as Wednesday, and reflects agreements the company has made with the three major music labels.', 'web_url': 'https://www.nytimes.com/2013/05/15/business/media/google-set-to-introduce-music-service-to-compete-with-spotify.html', 'snippet': 'The service is expected to be announced as early as Wednesday, and reflects agreements the company has made with the three major music labels.', 'lead_paragraph': 'Google is set to introduce a subscription music feature to compete against fast-growing st