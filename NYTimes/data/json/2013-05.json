, {'name': 'subject', 'value': 'International Relations', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'East China Sea', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Senkaku Islands', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Okinawa and Other Ryukyu Islands (Japan)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-11T17:51:12+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/ddeee5ea-25ad-5aa4-9ad7-f6c0298755cb', 'word_count': 452, 'uri': 'nyt://article/ddeee5ea-25ad-5aa4-9ad7-f6c0298755cb'}, {'abstract': 'The most important diagnostic manual for mental illnesses lacks scientific validity.', 'web_url': 'https://www.nytimes.com/2013/05/12/opinion/sunday/shortcomings-of-a-psychiatric-bible.html', 'snippet': 'The most important diagnostic manual for mental illnesses lacks scientific validity.', 'lead_paragraph': 'Patients and parents concerned about mental illness have every right to be confused. The head of the federal agency that finances mental health research has just declared that the most important diagnostic manual for psychiatric diseases lacks scientific validity and needs to be bolstered by a new classification system based on biology, not just psychiatric opinion. The hitch is that such a biology-based system will not be available for a decade or more.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Shortcomings of a Psychiatric Bible', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Shortcomings of a Psychiatric Bible', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Diagnostic and Statistical Manual of Mental Disorders (Book)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Psychiatry and Psychiatrists', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Insel, Thomas R', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Institute of Mental Health', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-11T17:51:12+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/e1c6a496-d902-5ec9-af14-9b60bb81a547', 'word_count': 390, 'uri': 'nyt://article/e1c6a496-d902-5ec9-af14-9b60bb81a547'}, {'abstract': 'The classics of the genre relied on intimacy and a sense of the familiar.', 'web_url': 'https://www.nytimes.com/2013/05/12/opinion/sunday/the-zombie-next-door-may-be-the-scariest-of-all.html', 'snippet': 'The classics of the genre relied on intimacy and a sense of the familiar.', 'lead_paragraph': 'The term “zombie” has traditionally referred to a corpse that has been reanimated through supernatural means and rendered into an automaton that does its master’s will. Look it up in a dictionary and you will find the traditional definition firmly in place. But pop culture, of course, has its own definition.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/sunday-review/12editorial/12editorial-articleLarge.jpg', 'height': 529, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/su