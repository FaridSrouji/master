chael', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Soderbergh, Steven', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-05-24T21:16:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/225022ea-6b56-5f19-81c8-9a85d56432c2', 'word_count': 848, 'uri': 'nyt://article/225022ea-6b56-5f19-81c8-9a85d56432c2'}, {'abstract': 'The Repast Baroque Ensemble presented a decorous concert of works by Dietrich Buxtehede, Matthew Locke, Christopher Simpson and Johann Jakob Froberger.', 'web_url': 'https://www.nytimes.com/2013/05/25/arts/music/repast-baroque-ensemble-at-the-baruch-performing-arts-center.html', 'snippet': 'The Repast Baroque Ensemble presented a decorous concert of works by Dietrich Buxtehede, Matthew Locke, Christopher Simpson and Johann Jakob Froberger.', 'lead_paragraph': 'You probably shouldn’t give too much weight to the title of a concert, especially one obviously chosen for its chiming quality. But with “A Spring Fling!” at the Baruch Performing Arts Center on Wednesday evening, the Repast Baroque Ensemble came dangerously close to false advertising.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Via the Baroque, the Flip Side of Spring Frolics ', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Via the Baroque, the Flip Side of Spring Frolics', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Baruch Performing Arts Center', 'rank': 2, 'major': 'N'}, {'nam