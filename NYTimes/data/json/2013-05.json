humbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/dining/29FLEXITARIAN/29FLEXITARIAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Make Peace With Meat', 'kicker': 'The Flexitarian', 'content_kicker': None, 'print_headline': 'Make Peace With Meat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bittman, Mark', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Meat', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Local Food', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-28T21:38:52+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ba9b7dc-fa23-580a-95c2-9ce6dd379bf8', 'word_count': 1098, 'uri': 'nyt://article/9ba9b7dc-fa23-580a-95c2-9ce6dd379bf8'}, {'abstract': 'Eager to increase his name recognition, John A. Catsimatidis commissioned this highly biographical 60-second ad which will be shown on cable and broadcast television.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/05/28/the-ad-campaign-catsimatidis-emphasizes-business-background/', 'snippet': 'Eager to increase his name recognition, John A. Catsimatidis commissioned this highly biographical 60-second ad which will be shown on cable and broadcast television.', 'lead_paragraph': 'It is perhaps no surprise that the first mayoral candidate to begin running a costly television advertisement is the wealthy businessman John A. Catsimatidis, a Republican with a $3 billion fortune at his disposal. (His ad went up a few days before one for a Republican rival, Joseph J. Lhota, is to appear.) Eager to increase his name recognition and unhampered by spending limits because he is not participating in New York City’s voluntary public matching funds program, Mr. Catsimatidis commissioned this highly biographical 60-second ad, which will be shown on cable and broadcast television, from the Victory Group, which is based in Florida. The firm has worked with former Mayor Rudolph W. Giuliani.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Ad Campaign: Catsimatidis Emphasizes Business Background', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': 'Citing Humble Origins, Catsimatidis Plays to His Strengths', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections, Mayors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Catsimatidis, John A', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-28T21:39:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Michael M. Grynbaum', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2418001d-1680-537b-a8b0-e928fd5043e1', 'word_count': 607, 'uri': 'nyt://article/2418001d-1680-537b-a8b0-e928fd5043e1'}, {'abstract': 'A selection of recipes by Mark Bittman, all of which use pork, beef, lamb or veal as supporting or even bit players, letting vegetables and grains move to center stage.', 'web_url': 'https://www.nytimes.com/interactive/2013/05/28/dining/bittman-meat-recipes.html', 'snippet': 'A selection of recipes by Mark Bittman, all of which use pork, beef, lamb or veal as supporting or even bit players, letting vegetables and grains move to center stage.', 'lead_paragraph': 'A selection of recipes by Mark Bittman, all of which use pork, beef, lamb or veal as supporting or even bit players, letting vegetables and grains move to center stage.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '16 Not-Quite-Meatless Recipes', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Meat', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-28T21:44:19+0000', 'document_type': 'multimedia', 'news_desk': 'Food', 'section_name': 'Food', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/c476dc66-48ce-5498-a882-b054c7c00368', 'word_count': 0, 'uri': 'nyt://interactive/c476dc66-48ce-5498-a882-b054c7c00368'}, {'abstract': 'A son will operate the restaurant his father ran for three decades.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/05/28/historic-tujagues-will-remain-open-in-new-orleans/', 'snippet': 'A son will operate the restaurant his father ran for three decades.', 'lead_paragraph': 'Tujague’s, the historic New Orleans restaurant in the French Quarter whose fate had hung in the balance since its owner died in February, will continue serving brisket and Sazeracs, it was announced Tuesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Historic Tujague’s Will Remain Open in New Orleans', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "Tujague's (New Orleans, La, Restaurant)", 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New Orleans (La)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-28T21:54:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Robert Simonson', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Simonson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/84b5afa8-1f6e-5fdd-9186-c37cde64e26e', 'word_count': 303, 'uri': 'nyt://article/84b5afa8-1f6e-5fdd-9186-c37cde64e26e'}, {'abstract': 'This week, what to do with Italian puntarelle, a chicken-beef mix called Cluck ‘n Moo, and paintings of Mexico’s lush produce by Pedro Diego Alvarado-Rivera.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/05/28/front-burner-19/', 'snippet': 'This week, what to do with Italian puntarelle, a chicken-beef mix called Cluck ‘n Moo, and paintings of Mexico’s lush produce by Pedro Diego Alvarado-Rivera.', 'lead_paragraph': 'To View: The Influence of His HomelandLike his grandfather Diego Rivera, the artist Pedro Diego Alvarado-Rivera takes his inspiration from his native Mexico. His oils are vibrant, ripe still-life and landscape paintings that focus on the country’s fruits and vegetables, like his “Sandia Melonera,” right. A sampling will be on display through June 30: Refined Abundance II is at Ruiz-Healy Art, 900 Park Avenue (79th Street) by appointment from 10 a.m. to 6 p.m. Monday to Friday, ruizhealyart.com, (212) 452-1662.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Front Burner', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': 'Front Burner', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-28T22:01:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/461accfd-0977-5d1c-81c1-f09abe49bfe5', 'word_count': 641, 'uri': 'nyt://article/461accfd-0977-5d1c-81c1-f09abe49bfe5'}, {'abstract': 'You could open either red or white with this vegetable-and-veal stew.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/05/28/wines-for-an-asian-style-stew/', 'snippet': 'You could open either red or white with this vegetable-and-veal stew.', 'lead_paragraph': 'Wine with Chinese food may seem counterintuitive, but the combination can work quite well, especially with the gentler spicing of Cantonese cuisine. Many wine lovers take advantage of bring-your-own-bottle policies to drink great wines at Cantonese restaurants. You could open either red or white with the Asian-style vegetable-and-veal stew in Mark Bittman’s Flexitarian column this week, as long as the wine has lively acidity so it isn’t buried under the assertive flavors of the food. I would lean toward a white, like a peppery grüner veltliner, especially one of the more age-worthy specimens. An Austrian riesling would also work well, and for a full dose of umami, why not a fino sherry? Among reds, a fresh, fragrant Chinon or Bourgueil from the Loire Valley would match well, and if you prefer a bolder wine, maybe a zinfandel from the lighter side of the spectrum. ', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wines for an Asian-Style Stew', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': 'And To Drink...', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chinese Food (Cuisine)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wines', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-28T22:02:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Eric Asimov', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Asimov', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9c786bc-ae9b-5ed5-9a21-4d561f6589de', 'word_count': 164, 'uri': 'nyt://article/e9c786bc-ae9b-5ed5-9a21-4d561f6589de'}, {'abstract': 'A political split over the cause of a 2010 air crash that killed 96 members of Poland’s political and military elite has spilled over into the country’s arts sphere.', 'web_url': 'https://www.nytimes.com/2013/05/29/movies/polands-divide-over-smolensk-film-on-2010-air-crash.html', 'snippet': 'A political split over the cause of a 2010 air crash that killed 96 members of Poland’s political and military elite has spilled over into the country’s arts sphere.', 'lead_paragraph': 'WARSAW — On a foggy April morning in 2010, the Polish president’s plane crashed over Smolensk in western Russia, killing him and 95 other members of Poland’s political and military elite, traumatizing the nation and opening a bitter political divide over what caused the disaster. Now the fissures have spread to the cultural realm, as filmmakers, writers and artists fiercely debate how — or even whether — to portray this still-visceral history.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/arts/29CRASH/29CRASH-articleLarge.jpg', 'height': 356, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/29/arts/29CRASH/29CRASH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 356}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/arts/29CRASH/29CRASH-jumbo.jpg', 'height': 608, 'width': 1024, 'subTyp