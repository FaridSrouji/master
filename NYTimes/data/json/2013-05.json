eported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0b2c7193-2874-5f62-8834-e9ff908edfc8', 'word_count': 701, 'uri': 'nyt://article/0b2c7193-2874-5f62-8834-e9ff908edfc8'}, {'abstract': 'President Obama has become imprisoned not at Guantanamo but by it.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/05/29/gitmos-other-prisoner/', 'snippet': 'President Obama has become imprisoned not at Guantanamo but by it.', 'lead_paragraph': 'On the front page of its Memorial Day weekend edition last Friday, USA Today ran an arresting article under the headline: From Boyhood to the Battlefield. The photo of a young boy with a baseball bat over his shoulder, staring forthrightly into the camera, promised a feel-good holiday story, a promise quickly dashed by the headline’s smaller type: “These children of 9/11 died fighting its war.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gitmo’s Other Prisoner', 'kicker': 'Opinionator', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Detainees', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Habeas Corpus', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Military Tribunals', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Boumediene, Lakhdar', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Latif, Adnan Farhan Abdul', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 11, 'major': 'N'}, {'name': 'glocat