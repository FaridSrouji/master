: 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Week in Culture Pictures, May 10', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Frieze Art Fair', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-10T21:25:25+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'subsection_name': 'Arts', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/bfa2f2f5-2dc0-5cb6-a47a-c65870a65260', 'word_count': 0, 'uri': 'nyt://slideshow/bfa2f2f5-2dc0-5cb6-a47a-c65870a65260'}, {'abstract': 'The museum’s fund-raising has slipped, its days of operation have been slashed from six to four, and roughly a fifth of its staff was laid off this year.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/05/10/el-museo-del-barrios-board-president-to-leave/', 'snippet': 'The museum’s fund-raising has slipped, its days of operation have been slashed from six to four, and roughly a fifth of its staff was laid off this year.', 'lead_paragraph': 'El Museo del Barrio’s board president, who was named in a recent discrimination claim by the museum’s former director, will leave her position at the end of her term on June 30, museum officials said on Friday. The official, Yaz Hernández, is departing as the museum searches for a new director and struggles to find its fiscal footing. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'El Museo del Barrio’s Board President to Leave', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Suspensions, Dismissals and Resignations', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Aguilar, Margarita', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'El Museo del Barrio', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-10T21:26:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4b5dfdc6-806a-5b66-9aa7-56f885a49c52', 'word_count': 293, 'uri': 'nyt://article/4b5dfdc6-806a-5b66-9aa7-56f885a49c52'}, {'abstract': 'A slide show of photographs of cultural highlights from this week.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/05/10/the-week-in-culture-pictures-may-10/', 'snippet': 'A slide show of photographs of cultural highlights from this week.', 'lead_paragraph': ' More photographs.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Week in Culture Pictures, May 10', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-05-10T21:31:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/8f180c9b-ecab-5295-885b-4aa8bdf51a85', 'word_count': 13, 'uri': 'nyt://article/8f180c9b-ecab-5295-885b-4aa8bdf51a85'}, {'abstract': 'With “Family Tree” on HBO, Christopher Guest brings the mockumentary format he pioneered in film to a television scene that’s been saturated with imitations of his work.', 'web_url': 'https://www.nytimes.com/2013/05/11/arts/television/family-tree-on-hbo-directed-by-christopher-guest.html', 'snippet': 'With “Family Tree” on HBO, Christopher Guest brings the mockumentary format he pioneered in film to a television scene that’s been saturated with imitations of his work.', 'lead_paragraph': '“Family Tree” is a half-hour HBO comedy about a lethargic, unemployed young British man who becomes obsessed with tracking down his ancestors. It’s largely improvised and poses as a documentary, though to such a slight degree that it hardly matters. That this does not sound like a terrible idea for a television show is largely because of the past work of Christopher Guest, who, as it happens, created and wrote “Family Tree” with Jim Piddock. Depending on your taste, that’s either a tribute or a reproach.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/arts/11FAMILYjp/11FAMILYjp-articleLarge.jpg', 'height': 378, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/11/arts/11FAMILYjp/11FAMILYjp-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 378}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/arts/11FAMILYjp/11FAMILYjp-jumbo.jpg', 'height': 644, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/arts/11FAMILYjp/11FAMILYjp-superJumbo.jpg', 'height': 1289, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/arts/11FAMILYjp/11FAMILYjp-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/11/arts/11FAMILYjp/11FAMILYjp-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/arts/11FAMILYjp/11FAMILYjp-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Searching for Roots, Finding Characters', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Searching For Roots, Finding Characters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Guest, Christopher', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': "O'Dowd, Chris", 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-10T21:37:10+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/427a6b8c-69d8-5555-a302-866c3001fb2e', 'word_count': 545, 'uri': 'nyt://article/427a6b8c-69d8-5555-a302-866c3001fb2e'}, {'abstract': 'An interview with Doug Weinstein, a building manager for luxury co-ops and condominiums in New York City.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/05/10/keeping-peace-in-a-vertical-village/', 'snippet': 'An interview with Doug Weinstein, a building manager for luxury co-ops and condominiums in New York City.', 'lead_paragraph': 'As director of operations and compliance for AKAM Associates, a property management company for luxury co-op and condominium buildings in New York City, Doug Weinstein is responsible for all physical projects in 125 buildings. He fields daily calls from cooperative and condominium boards about everything from code issues to job bids. Mr. Weinstein started in the business nearly 30 years ago, working for his cousin, Martin Raynes, of M. J. Raynes Inc., a large real estate developer in the city in the 1980s.', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12QUESTIONS/12QUESTIONS-articleLarge.jpg', 'height': 1878, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/nyregion/12QUESTIONS/12QUESTIONS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1878}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12QUESTIONS/12QUESTIONS-jumbo.jpg', 'height': 1024, 'width': 328, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12QUESTIONS/12QUESTIONS-superJumbo.jpg', 'height': 2048, 'width': 655, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12QUESTIONS/12QUESTIONS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/nyregion/12QUESTIONS/12QUESTIONS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12QUESTIONS/12QUESTIONS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Keeping Peace in a Vertical Village', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': 'Keeping Peace in a Vertical Village', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-10T21:37:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Sarah Kramer', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Kramer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/db94ce65-52cc-5618-9cf8-d099e1c82b1f', 'word_count': 1004, 'uri': 'nyt://article/db94ce65-52cc-5618-9cf8-d099e1c82b1f'}, {'abstract': 'The conductor Paul Haas led a concert on Wednesday under dimmed lights at the Church of the Ascension in Manhattan.', 'web_url': 'https://www.nytimes.com/2013/05/11/arts/music/sympho-orchestra-at-the-church-of-the-ascension.html', 'snippet': 'The conductor Paul Haas led a concert on Wednesday under dimmed lights at the Church of the Ascension in Manhattan.', 'lead_paragraph': 'The Austrian composer Georg Friedrich Haas has written several works to be performed in pitch darkness, including “In Vain,” his hourlong masterpiece for chamber orchestra. With artificial light everywhere, “we do not have any night in our modern life,” he said in an interview in 2011. “But I think our body and our souls desire night, and I give this in my art.” ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Using Darkness, With Enlightenment in Mind', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Using Darkness, With Enlightenment in Mind', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schweitzer, Vivien', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sympho Orchestra', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Haas, Paul', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-10T21:39:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c7d26e86-642b-54c5-9aaf-c538d8e7afc9', 'word_count': 330, 'uri': 'nyt://article/c7d26e86-642b-54c5-9aaf-c538d8e7afc9'}, {'abstract': 'Scott Thorson knew the high life as Liberace’s lover and the low life as his ex. Now, an HBO movie is about to revisit the days of wine and sequins.', 'web_url': 'https://www.nytimes.com/2013/05/12/fashion/scott-thorson-the-boy-toys-story.html', 'snippet': 'Scott Thorson knew the high life as Liberace’s lover and the low life as his ex. Now, an HBO movie is about to revisit the days of wine and sequins.', 'lead_paragraph': 'RENO, Nev. — Soon after moving into Liberace’s gaudy Las Vegas mansion in 1977, Scott Thorson, then a teenage hunk in the foster care system, learned that the jewel-smitten showman could love just as extravagantly as he decorated. Touring the premises before their relationship began, Liberace pointed out some decorative highlights, which included 17 pianos, a casino, a quarry’s worth of marble and a canopied bed with an ermine spread. On the ceiling was a reproduction of the Sistine Chapel with Liberace’s face painted among the cherubs.', 'print_section': 'ST', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/fashion/12THORSEN1_SPAN/12THORSEN1-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/fashion/12THORSEN1_SPAN/12THORSEN1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeh