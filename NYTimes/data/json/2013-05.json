/sports/yTOMIC/yTOMIC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/sports/yTOMIC/yTOMIC-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/sports/yTOMIC/yTOMIC-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/sports/yTOMIC/yTOMIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/29/sports/yTOMIC/yTOMIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/29/sports/yTOMIC/yTOMIC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tomic Retires From First-Round Match, Drama Trailing as He Limps Off', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tomic Quits Match, Drama Trailing as He Limps Off', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'French Open (Tennis)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tomic, John', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tomic, Bernard', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-05-28T20:26:32+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6fa0a59e-b1fe-5119-b13c-a51663ac6fb3', 'word_count': 865, 'uri': 'nyt://article/6fa0a59e-b1fe-5119-b13c-a51663ac6fb3'}, {'abstract': 'The new “Arrested Development” episodes have had their critics, but plenty of viewers found jokes that made them laugh.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/05/28/criticisms-favorite-gags-and-other-reactions-to-the-new-arrested-development/', 'snippet': 'The new “Arrested Development” episodes have had their critics, but plenty of viewers found jokes that made them laugh.', 'lead_paragraph': 'It’s been just over 60 hours since the new season of “Arrested Development” started streaming on Netflix. Some superfans had the\xa0 fortitude to watch all 15 episodes not long after sunrise on Sunday morning. Many of the rest of us are working our way through the show as much as the commitments of daily life\xa0 will allow. But just about everyone has an opinion about\xa0 favorite Bluth family moments from the new episodes, and whether it’s been worth the time to binge on the show.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/28/arts/AD/AD-articleLarge.jpg', 'height': 353, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/28/arts/AD/AD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 353}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/28/arts/AD/AD-jumbo.jpg', 'height': 602, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, '