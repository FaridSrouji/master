s, “The government is systematically ruining this country.”', 'print_section': 'CT', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12ARTSCT1_SPAN/12ARTSCT1-articleLarge.jpg', 'height': 361, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/nyregion/12ARTSCT1_SPAN/12ARTSCT1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 361}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12ARTSCT1_SPAN/12ARTSCT1-jumbo.jpg', 'height': 616, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12ARTSCT1_SPAN/12ARTSCT1-superJumbo.jpg', 'height': 1071, 'width': 1779, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12ARTSCT1_SPAN/12ARTSCT1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/nyregion/12ARTSCT1_SPAN/12ARTSCT1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/nyregion/12ARTSCT1_SPAN/12ARTSCT1_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Meals of Imagined Bounty', 'kicker': 'Theater Review | Connecticut', 'content_kicker': None, 'print_headline': 'Meals of Imagined Bounty', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 