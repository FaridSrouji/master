, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Zimmerman, George', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Alvarez, Lizette', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': "O'Mara, Mark M", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, Trayvon', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Immunity from Prosecution', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Sanford (Fla)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Self-Defense', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Nelson, Debra S', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-05-01T02:30:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Lizette Alvarez', 'person': [{'firstname': 'Lizette', 'middlename': None, 'lastname': 'Alvarez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b23b5d5-f9c0-58fd-9731-429aa85c13e3', 'word_count': 827, 'uri': 'nyt://article/7b23b5d5-f9c0-58fd-9731-429aa85c13e3'}, {'abstract': 'The Marlins scored twice in the bottom of the ninth and won when Juan Pierre scored on a wild pitch thrown by Mets reliever Brandon Lyon.', 'web_url': 'https://www.nytimes.com/2013/05/01/sports/baseball/three-outs-from-win-mets-throw-it-away.html', 'snippet': 'The Marlins scored twice in the bottom of the ninth and won when Juan Pierre scored on a wild pitch thrown by Mets reliever Brandon Lyon.', 'lead_paragraph': 'MIAMI — Caught in the baseball vortex that had vaporized their offense and drained their confidence, the Mets searched for an escape route before Tuesday’s game at Marlins Park. Some of the players spent additional time analyzing video. Some took extra cuts in the batting cage. Others simply stuck to routine, hopeful that this would be the night they unearthed the ability to score a couple of runs, maybe more.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/sports/METS/METS-articleLarge.jpg', 'height': 446, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/01/sports/METS/METS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 446}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/sports/METS/METS-jumbo.jpg', 'height': 761, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/sports/METS/METS-superJumbo.jpg', 'height': 1521, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/sports/METS/METS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/01/sports/METS/METS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/sports/METS/METS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Three Outs From Win, Mets Throw It Away', 'kicker': 'Marlins 2, Mets 1', 'content_kicker': None, 'print_headline': 'Three Outs From Win, Mets Throw It Away', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Marlins', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hefner, Jeremy', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pierre, Juan', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-01T02:33:50+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Scott Cacciola', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Cacciola', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36c7baf0-f6eb-561f-be57-397554211762', 'word_count': 757, 'uri': 'nyt://article/36c7baf0-f6eb-561f-be57-397554211762'}, {'abstract': 'The Seahawks’ quarterback controversy last year may hold lessons for the Jets.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2013/04/30/looking-ahead-to-the-jets-quarterback-roulette/', 'snippet': 'The Seahawks’ quarterback controversy last year may hold lessons for the Jets.', 'lead_paragraph': 'There were once three quarterbacks: the uninspiring veteran, the free-agent addition and the recent draft pick. They would all compete, team officials said, and compete they did until the winner was selected.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Looking Ahead to the Jets’ Quarterback Roulette', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Flynn, Matt', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Garrard, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Idzik, John', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson, Tarvaris', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sanchez, Mark', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Geno', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Wils