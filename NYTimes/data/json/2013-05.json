150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ask Well: Replacing a Dental Crown', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Teeth and Dentistry', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-05-10T14:36:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Catherine Saint Louis', 'person': [{'firstname': 'Catherine', 'middlename': 'Saint', 'lastname': 'Louis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f59ae022-37bf-5f6a-84f3-e5f33c964564', 'word_count': 413, 'uri': 'nyt://article/f59ae022-37bf-5f6a-84f3-e5f33c964564'}, {'abstract': 'A diary washes ashore, linking a teenager in Japan and an author in Canada in Ruth Ozeki’s latest novel.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/a-tale-for-the-time-being-by-ruth-ozeki.html', 'snippet': 'A diary washes ashore, linking a teenager in Japan and an author in Canada in Ruth Ozeki’s latest novel.', 'lead_paragraph': 'Nao, a 16-year-old schoolgirl, is in a cafe in Tokyo, writing in her diary. She is, she declares, a “time being,” with all the ambiguity that phrase implies. Many months later, after Japan’s devastating earthquake and tsunami, a Japanese-American novelist named Ruth, living on an island off the coast of British Columbia, finds a barnacle-encrusted freezer bag washed up on the beach. It contains, it appears, a copy of Proust’s “In Search of Lost Time” and a broken watch, along with some letters. But Proust’s book is no more than a cover. Inside is Nao’s diary, written in purple ink.', 'print_section': 'BR', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lost and Found', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lost and Found', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ozeki, Ruth L', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-10T14:36:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Lesley Downer', 'person': [{'firstname': 'Lesley', 'middlename': None, 'lastname': 'Downer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6a02dd6d-f3d1-5a78-a730-6efa3688d720', 'word_count': 693, 'uri': 'nyt://article/6a02dd6d-f3d1-5a78-a730-6efa3688d720'}, {'abstract': 'In Jennifer Haigh’s linked stories, restlessness and regret loom over a Pennsylvania coal-mining town for generations.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/news-from-heaven-by-jennifer-haigh.html', 'snippet': 'In Jennifer Haigh’s linked stories, restlessness and regret loom over a Pennsylvania coal-mining town for generations.', 'lead_paragraph': '“For a certain kind of teenager, a small town is a prison. For another kind, it is a stage.” The speaker is a smart high school girl working at the town’s diner, watching “the athletes and beauty queens who’d blossomed early and fierce,” and the setting is Bakerton, a western Pennsylvania coal-mining town, where Jennifer Haigh’s 2005 novel “Baker Towers” was also set. The 10 stories in “News From Heaven” move chronologically from the town’s modest boom before World War II to its postindustrial depletion as the mines close, one by one:', 'print_section': 'BR', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12SILBER/12SILBER-articleLarge.jpg', 'height': 867, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/books/review/12SILBER/12SILBER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 867}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12SILBER/12SILBER-jumbo.jpg', 'height': 1024, 'width': 709, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12SILBER/12SILBER-superJumbo.jpg', 'height': 2048, 'width': 1418, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12SILBER/12SILBER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/books/review/12SILBER/12SILBER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12SILBER/12SILBER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Things Haven’t Gone Exactly as Planned', 'kicker': None, 'content_kicker': None, 'print_headline': 'Things Haven’t Gone Exactly as Planned', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Haigh, Jennifer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-05-10T14:36:09+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joan Silber', 'person': [{'firstname': 'Joan', 'middlename': None, 'lastname': 'Silber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/97965678-fd21-5ffc-9bcc-eed7ebae84e3', 'word_count': 593, 'uri': 'nyt://article/97965678-fd21-5ffc-9bcc-eed7ebae84e3'}, {'abstract': 'Jill McCorkle returns to the fictional Fulton, N.C., in her sixth novel.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/life-after-life-by-jill-mccorkle.html', 'snippet': 'Jill McCorkle returns to the fictional Fulton, N.C., in her sixth novel.', 'lead_paragraph': 'From the knowing grandmother in the novel “Tending to Virginia” to the failing mother stressing out her daughter in the short story “Going Away Shoes,” elderly characters have always played their parts in Jill McCorkle’s small-town, intergenerational fiction. But the “manly voice” with “pipes and whistles in his sound,” as Shakespeare put it, reverberates in its own distinctive fashion in the retirement home setting of McCorkle’s new novel, where the yoga class finds “a whole roomful of old folks breathing deeply and chanting — one sounding like a sewing machine and another a squirrel.”', 'print_section': 'BR', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Late Bloomers', 'kicker': None, 'content_kicker': None, 'print_headline': 'Late Bloomers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hoffman, Roy', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Life After Life (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McCorkle, Jill', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-10T14:36:20+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Roy Hoffman', 'person': [{'firstname': 'Roy', 'middlename': None, 'lastname': 'Hoffman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/aaeda94f-eaab-5572-b2af-4b0abf5d4f6c', 'word_count': 580, 'uri': 'nyt://article/aaeda94f-eaab-5572-b2af-4b0abf5d4f6c'}, {'abstract': 'A primer on the Federalist Society and its extraordinary influence.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/the-federalist-society-by-michael-avery-and-danielle-mclaughlin.html', 'snippet': 'A primer on the Federalist Society and its extraordinary influence.', 'lead_paragraph': 'More than two decades ago, when I was a law student, I used to sneak into meetings of the conservative Federalist Society for lunchtime conversations about constitutional issues. Although neither conservative nor a Republican, I had libertarian leanings and appreciated the society’s openness to debating its political opponents. I felt slightly illicit in crossing ideological lines: once, when the dean spotted me leaving a meeting, I felt as if I’d been caught walking out of an X-rated movie. But the discussions themselves were always intellectually engaging, and my fellow law students seemed more interested in converging around a shared approach to interpreting the Constitution than in squabbling about partisan differences. ', 'print_section': 'BR', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-Rosen/0512-bks-Rosen-articleLarge.jpg', 'height': 612, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/12/books/review/0512-bks-Rosen/0512-bks-Rosen-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 612}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-Rosen/0512-bks-Rosen-jumbo.jpg', 'height': 1024, 'width': 1004, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-Rosen/0512-bks-Rosen-superJumbo.jpg', 'height': 1962, 'width': 1923, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-Rosen/0512-bks-Rosen-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/12/books/review/0512-bks-Rosen/0512-bks-Rosen-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/0512-bks-Rosen/0512-bks-Rosen-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Packing the Courts', 'kicker': None, 'content_kicker': None, 'print_headline': 'Packing the Courts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rosen, Jeffrey', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Federalist Society', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Avery, Michael', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'McLaughlin, Danielle', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-05-10T14:36:40+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jeffrey Rosen', 'person': [{'firstname': 'Jeffrey', 'middlename': None, 'lastname': 'Rosen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/98ef5b14-90c7-5da5-b84a-ffffa5367c92', 'word_count': 1214, 'uri': 'nyt://article/98ef5b14-90c7-5da5-b84a-ffffa5367c92'}, {'abstract': 'Deborah Turness, who worked at ITV News in Britain, would become the first woman to lead the news division at a major network.', 'web_url': 'https://www.nytimes.com/2013/05/11/business/media/nbc-to-name-new-head-of-news-division.html', 'snippet': 'Deborah Turness, who worked at ITV News in Britain, would become the first woman to lead the news division at a major network.', 'lead_paragraph': 'NBC News is on the verge of naming Deborah Turness, the head of ITV News in Britain, as its next president, according to several people with knowledge of the appointment.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/business/NBC/NBC-articleLarge.jpg', 'height': 833, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/11/business/NBC/NBC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 833}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/business/NBC/NBC-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/business/NBC/NBC-superJumbo.jpg', 'height': 1611, 'width': 1160, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/business/NBC/NBC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/05/11/business/NBC/NBC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/11/business/NBC/NBC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'NBC News Is Said to Pick a Woman as Its Chief', 'kicker': None, 'content_kicker': None, 'print_headline': 'NBC News Said to Pick A Woman As Its Chief', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Stelter, Brian', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'NBC News', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Capus, Steve', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Turness, Deborah M', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-05-10T14:36:57+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a7bbf584-c3e5-5661-b34b-a2f9a7917cb1', 'word_count': 495, 'uri': 'nyt://article/a7bbf584-c3e5-5661-b34b-a2f9a7917cb1'}, {'abstract': 'Brandon Sanderson’s hero longs to join a magical cadre.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/the-rithmatist-by-brandon-sanderson.html', 'snippet': 'Brandon Sanderson’s hero longs to join a magical cadre.', 'lead_paragraph': 'There’s always a boy, and there’s always a girl. They may not like each other at first, but they find a way to work together. Friendship always blossoms, sometimes romance. There’s a society they have to fight against and a secret to uncover that changes the world. They win in the end, though there’s heartbreak along the way and more danger ahead.', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The One Least Likely', 'kicker': None, 'content_kicker': None, 'print_headline': 'The One Least Likely', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sanderson, Brandon', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-05-10T14:37:24+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Patrick Ness', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Ness', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/09f76a31-18f8-5b86-a5c9-172ec335b23e', 'word_count': 658, 'uri': 'nyt://article/09f76a31-18f8-5b86-a5c9-172ec335b23e'}, {'abstract': 'The plain heroine of Paul Rudnick’s novel is transformed.', 'web_url': 'https://www.nytimes.com/2013/05/12/books/review/gorgeous-by-paul-rudnick.html', 'snippet': 'The plain heroine of Paul Rudnick’s novel is transformed.', 'lead_paragraph': 'When I was 5 years old, my mother explained the world to me: “Beauty is pain,” she said, yanking my hair into submission with Dippity Do-slimed fingers and some bobby pins. If I didn’t sleep in scalp-scraping pin curls to look my best for Sunday school, the terrorists would win. ', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/12/books/review/12BRAY/12BRAY-jumbo.jpg', 'height': 407, 'width': 407, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/0