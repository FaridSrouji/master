n': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8afea917-f3b2-53cc-bcaa-0a746e447d74', 'word_count': 787, 'uri': 'nyt://article/8afea917-f3b2-53cc-bcaa-0a746e447d74'}, {'abstract': 'The Science Guy is optimistic about his new talk show, “Bill Nye Saves the World,” which will premiere April 21 on Netflix.', 'web_url': 'https://www.nytimes.com/2017/02/09/science/bill-nye-netflix.html', 'snippet': 'The Science Guy is optimistic about his new talk show, “Bill Nye Saves the World,” which will premiere April 21 on Netflix.', 'lead_paragraph': 'As he prepares to launch a fact-filled show into a fact-challenged world, Bill Nye, a.k.a. the Science Guy, is looking on the bright side.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/science/10Nye_xp/10Nye_xp-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/10/science/10Nye_xp/10Nye_xp-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/science/10Nye_xp/10Nye_xp-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/science/10Nye_xp/10Nye_xp-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/10/science/10Nye_xp/10Nye_xp-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/science/10Nye_xp/10Nye_xp-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/science/10Nye_xp/10Nye_xp-superJumbo-v2.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In an Age of Alternative Facts, Bill Nye’s New Show Brings Real Ones', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Bill Nye Saves the World (TV Program)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Nye, Bill', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-02-09T21:33:04+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Jacey Fortin', 'person': [{'firstname': 'Jacey', 'middlename': None, 'lastname': 'Fortin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/83daa603-71fa-53e4-93c7-5dfceac87dc9', 'word_count': 646, 'uri': 'nyt://article/83daa603-71fa-53e4-93c7-5dfceac87dc9'}, {'abstract': 'This sequel is an altogether more solemn affair than the original, weighed down by the philosophy that more is always more.', 'web_url': 'https://www.nytimes.com/2017/02/09/movies/john-wick-chapter-2-review-keanu-reeves.html', 'snippet': 'This sequel is an altogether more solemn affair than the original, weighed down by the philosophy that more is always more.', 'lead_paragraph': 'They just couldn’t leave it alone. The original “John Wick,” about an über assassin who’s reluctantly drawn out of retirement, was a near perfect synergy of simple premise and intricate movement — an action movie that danced. But the lightness and winking quality that softened the slaughter are less evident in “John Wick: Chapter 2,” an altogether more solemn affair weighed down by the philosophy that more is always more.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Review: ‘John Wick: Chapter 2,’ a Roman Holiday With Shots Not Sparks', 'kicker': None, 'content_kicker': None, 'print_headline': 'John Wick: Chapter 2', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'John Wick: Chapter 2 (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stahelski, Chad', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Reeves, Keanu', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-09T21:33:42+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b69c693a-f7e8-5bb8-8208-05a8e7721d71', 'word_count': 277, 'uri': 'nyt://article/b69c693a-f7e8-5bb8-8208-05a8e7721d71'}, {'abstract': 'This second feature by the Thai director Pimpaka Towira finds three young adults on an enigmatic journey.', 'web_url': 'https://www.nytimes.com/2017/02/09/movies/the-island-funeral-review.html', 'snippet': 'This second feature by the Thai director Pimpaka Towira finds three young adults on an enigmatic journey.', 'lead_paragraph': 'The Thai director Pimpaka Towira’s second feature, “The Island Funeral,” is a road movie that’s as mesmerizing as it is tense. The film begins with three young adults — Laila (Heen Sasithorn); her brother, Zugood (Aukrit Pornsumpunsuk); and his unnamed pal (Yossawat Sittiwong) — standing by their idling car, wondering how to get to where they’re going. Laila is disdainful of her brother’s map-reading abilities, while the pal is frustrated that he can’t access GPS from his phone.', 'print_section': 'C', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Review: ‘The Island Funeral’ Goes on a Restless Road Trip', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Island Funeral', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Towira, Pimpaka', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-09T21:39:52+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Glenn Kenny', 'person': [{'firstname': 'Glenn', 'middlename': None, 'lastname': 'Kenny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/91bad6ff-edb5-5712-80c2-d96a652fe218', 'word_count': 290, 'uri': 'nyt://article/91bad6ff-edb5-5712-80c2-d96a652fe218'}, {'abstract': 'After a hiatus of almost seven years since her last exhibition, Ms. Celmins returns with a new body of work, at Matthew Marks.', 'web_url': 'https://www.nytimes.com/2017/02/09/arts/design/vija-celmins-matthew-marks-gallery.html', 'snippet': 'After a hiatus of almost seven years since her last exhibition, Ms. Celmins returns with a new body of work, at Matthew Marks.', 'lead_paragraph': 'There’s something fitting about interviewing the painter and sculptor Vija Celmins after sundown. And not only because she’s a night owl, known to labor over canvases long into the evening in her studio on Crosby Street in SoHo, with a cat named Raymond Carver twining around her ankles.', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail',