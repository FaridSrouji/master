17/01/29/nyregion/00crimescene1/00crimescene1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/29/nyregion/00crimescene1/00crimescene1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/01/29/nyregion/00crimescene1/00crimescene1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Corner Store Owner Denies Family Ties. All Five Families.', 'kicker': 'Crime Scene', 'content_kicker': None, 'print_headline': 'Corner Store Cultivates Ties to the Wrong Kind of Family, Prosecutors Say', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gambling', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Genovese Crime Family', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Crime', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Carroll Gardens (Brooklyn, NY)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Smith Union Market (Brooklyn, NY, Retailer)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Taliercio, Vincent', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-02-01T20:44:29+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael Wilson', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a2089d0-d2fd-5a33-a419-6b87bdc1830e', 'word_count': 776, 'uri': 'nyt://article/4a2089d0-d2fd-5a33-a419-6b87bdc1830e'}, {'abstract': 'Katherine Rundell’s work, directed by Jessica Lazar, begins previews at the Fourth Street Theater.', 'web_url': 'https://www.nytimes.com/2017/02/01/theater/life-according-to-saki-in-the-trenches-of-world-war-i.html', 'snippet': 'Katherine Rundell’s work, directed by Jessica Lazar, begins previews at the Fourth Street Theater.', 'lead_paragraph': 'The Edwardian era never looked quite as beguilingly sinister as it did through the gimlet eyes of Hector Hugh Munro, better known by his pen name, Saki. Celebrated for short stories of filigree sentences and blood-freezing endings, Munro (1870-1916) is being reincarnated with suitably macabre elegance at the Fourth Street Theater, where Katherine Rundell’s “Life According to Saki” begins previews on Wednesday, Feb. 8. Directed by Jessica Lazar, this production (which took the Carol Tambor Best of Edinburgh Award at last year’s Edinburgh Festival Fringe) places the dapper Munro in the trenches during World War I, where he entertains the lads with narratives that twist like a corkscrew. (His fellow Tommies assist in the tale-telling, as do some Bunraku puppets.) Evidently, that greatest of concluding Saki lines — “Romance at short notice was her specialty” — applied to its creator as well. (Through March 5; 866-811-4111, tinyurl.com/Life-Saki.)', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/05/arts/05GUIDE2/05GUIDE2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/05/arts/05GUIDE2/05GUIDE2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/05/arts/05GUIDE2/05GUIDE2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'cre