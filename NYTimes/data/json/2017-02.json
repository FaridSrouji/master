e, 'type': 'image', 'url': 'images/2017/02/19/sports/19nba-web/19nba-web-jumbo.jpg', 'height': 795, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/sports/19nba-web/19nba-web-superJumbo.jpg', 'height': 1589, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Carmelo Anthony, Reluctant All-Star, Earns Respite From Knicks’ Drama', 'kicker': None, 'content_kicker': None, 'print_headline': 'Reluctant All-Star at Least Enjoys Break From Knicks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ALL STAR GAMES', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Knicks', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ANTHONY, CARMELO', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Dolan, James L', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson, Phil (1945- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Oakley, Charles', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Silver, Adam (1962- )', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-02-19T03:12:20+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Scott Cacciola', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Cacciola', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5db321db-3b82-542f-b0c4-86fca105033f', 'word_count': 972, 'uri': 'nyt://article/5db321db-3b82-542f-b0c4-86fca105033f'}, {'abstract': 'Mr. Stubblefield was best known for a drum solo near the end of a 1969 Brown song he “didn’t like” that became the ubiquitous breakbeat of hip-hop’s sampling era.', 'web_url': 'https://www.nytimes.com/2017/02/18/arts/music/clyde-stubblefield-dead.html', 'snippet': 'Mr. Stubblefield was best known for a drum solo near the end of a 1969 Brown song he “didn’t like” that became the ubiquitous breakbeat of hip-hop’s sampling era.', 'lead_paragraph': 'It took only 20 seconds for Clyde Stubblefield to drum his way to immortality. They came near the end of James Brown’s “Funky Drummer,” recorded in a Cincinnati studio in late 1969. Brown counts him in — “1, 2, 3, 4. Hit it!” — and Mr. Stubblefield eases into a cool pattern, part bendy funk and part hard march. It’s calm, slick and precise, and atop it, Brown asks over and over, “Ain’t it funky?”', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/arts/19STUBBLEFIELD-obit/19STUBBLEFIELD-obit-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/19/arts/19STUBBLEFIELD-obit/19STUBBLEFIELD-obit-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/arts/19STUBBLEFIELD-obit/19STUBBLEFIELD-obit-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/arts/19STUBBLEFIELD-obit/19STUBBLEFIELD-obit-articleLarge.jpg', 'height': 385, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/arts/19STUBBLEFIELD-obit/19STUBBLEFIELD-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 385}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/