ubtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08MIXERS1/08MIXERS1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08MIXERS1/08MIXERS1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'If You Liked Our Gin, Try Our Tonic', 'kicker': None, 'content_kicker': None, 'print_headline': 'Like Our Gin? Try Our Tonic', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cocktails and Mixed Drinks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Soft Drinks', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Polar Beverages (Polar Corp)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Goslings Rum Ltd', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Stolichnaya', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-02-06T15:08:28+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Robert Simonson', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Simonson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f50bc21-6cf9-515f-a78e-d822d62d2752', 'word_count': 601, 'uri': 'nyt://article/4f50bc21-6cf9-515f-a78e-d822d62d2752'}, {'abstract': '“The Pho Cookbook” covers the finer points of Vietnam’s most famous culinary export.', 'web_url': 'https://www.nytimes.com/2017/02/06/dining/pho-cookbook-andrea-nguyen.html', 'snippet': '“The Pho Cookbook” covers the finer points of Vietnam’s most famous culinary export.', 'lead_paragraph': 'In Vietnam, pho knows no seasons. But a steaming bowl of meaty broth thick with noodles, beef, greens and herbs is certainly welcome when you need mufflers and boots. “The Pho Cookbook” covers the traditions, political significance, ramenlike preparation and pronunciation (usually “fuh”) of Vietnam’s best-known dish. Recipes for Vietnamese salads, dumplings and drinks are included, along with 10 basic recipes and inventive variations for the soup: “The Pho Cookbook: Easy to Adventurous Recipes for Vietnam’s Favorite Soup and Noodles” by Andrea Nguyen (Ten Speed Press, $22).', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-book/08burner-book-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/08/dining/08burner-book/08burner-book-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-book/08burner-book-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-book/08burner-book-articleLarge.jpg', 'height': 636, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/08/dining/08burner-book/08burner-book-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 636}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-book/08burner-book-jumbo.jpg', 'height': 1024, 'width': 967, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-book/08burner-book-superJumbo.jpg', 'height': 1389, 'width': 1311, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A History of Pho With Recipes', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Slurp: A History of Pho, and Recipe Variations', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Soups', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': "The Pho Cookbook: Easy to Adventurous Recipes for Vietnam's Favorite Soup and Noodles (Book)", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nguyen, Andrea', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-06T15:26:46+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67f0cdd5-de5b-54db-9a3d-a7d8b4eda3b3', 'word_count': 87, 'uri': 'nyt://article/67f0cdd5-de5b-54db-9a3d-a7d8b4eda3b3'}, {'abstract': 'Snake Oil Hot Sauce, from the chef Spike Gjerde, is made with the heirloom fish pepper.', 'web_url': 'https://www.nytimes.com/2017/02/06/dining/snake-oil-hot-sauce-baltimore.html', 'snippet': 'Snake Oil Hot Sauce, from the chef Spike Gjerde, is made with the heirloom fish pepper.', 'lead_paragraph': 'This may be good for what ails your crab-meat salad or ceviche. Snake Oil Hot Sauce balances its pure heat with acidity and fruity richness. Dispense it by the droplet from the apothecary-style bottle. The recipe is from Spike Gjerde, the chef at Woodberry Kitchen in Baltimore, who uses red heirloom fish peppers grown by family farms around Chesapeake Bay: Snake Oil Hot Sauce, $8 for 3.4 ounces, $12 for 6 ounces, snakeoilhotsauce.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-sauce/08burner-sauce-articleLarge.jpg', 'height': 249, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/08/dining/08burner-sauce/08burner-sauce-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 249}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-sauce/08burner-sauce-jumbo.jpg', 'height': 425, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-sauce/08burner-sauce-superJumbo.jpg', 'height': 850, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-sauce/08burner-sauce-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/08/dining/08burner-sauce/08burner-sauce-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/dining/08burner-sauce/08burner-sauce-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Baltimore Brings the Heat', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Spike: Baltimore Brings the Heat, Drop by Peppery Drop', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Woodbe