role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/da8f0f6a-99db-5811-abc6-4f1d22a2d501', 'word_count': 0, 'uri': 'nyt://video/da8f0f6a-99db-5811-abc6-4f1d22a2d501'}, {'abstract': 'What happens when man’s best friend is a capuchin monkey?', 'web_url': 'https://www.nytimes.com/2017/02/28/opinion/long-live-benjamin.html', 'snippet': 'What happens when man’s best friend is a capuchin monkey?', 'lead_paragraph': 'I’ve always struggled to be human, to know how to act and to what purpose. As a young New York artist, living in a tiny commercial storefront downtown on Crosby Street, I documented this process through drawing and painting self-portraits, which faithfully recorded the shifting moods and musings that swirled through my mind. This practice brought few answers, but did conjure the questions, which gazed back out at me starkly from the canvas.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Long Live Benjamin', 'kicker': 'Op-Docs', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Venezuela', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Monkeys and Apes', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Pets', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-28T14:50:12+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Allen Hirsch', 'person': [{'firstname': 'Allen', 'middlename': None, 'lastname': 'Hirsch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/f3126e0e-587e-56ce-bc30-260864a756bd', 'word_count': 775, 'uri': 'nyt://article/f3126e0e-587e-56ce-bc30-260864a756bd'}, {'abstract': 'Scientists are reporting a sharp rise in colorectal cancers in adults as young as their 20s and 30s, though the reasons are unclear.', 'web_url': 'https://www.nytimes.com/2017/02/28/well/live/colon-and-rectal-cancers-rising-in-young-people.html', 'snippet': 'Scientists are reporting a sharp rise in colorectal cancers in adults as young as their 20s and 30s, though the reasons are unclear.', 'lead_paragraph': 'Cancers of the colon and rectum have been declining in older adults in recent decades and have always been considered rare in young people. But scientists are reporting a sharp rise in colorectal cancers in adults as young as their 20s and 30s, an ominous trend.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/01/us/01colon-freiborg-01p/28COLoN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/01/us/01colon-freiborg-01p/28COLoN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/01/us/01colon-freiborg-01p/28COLoN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/01/us/01colon-freiborg-01p/28colon-freiborg-articleLarge-v2.jpg', 'height': 573, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/01/us/01colon-freiborg-01p/28colon-freiborg-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 573}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/01/us/01colon-freiborg-01p/28colon-freiborg-jumbo-v2.jpg', 'height': 978, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'ju