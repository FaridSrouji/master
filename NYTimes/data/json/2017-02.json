arge.jpg', 'height': 732, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/11/opinion/10lewisWeb/10lewisWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 732}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/11/opinion/10lewisWeb/10lewisWeb-jumbo.jpg', 'height': 1024, 'width': 840, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/11/opinion/10lewisWeb/10lewisWeb-superJumbo.jpg', 'height': 2048, 'width': 1680, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'What Happened to Elizabeth Warren Has Roots in Racism', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'King, Coretta Scott', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'McConnell, Mitch', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'ADAMS, JOHN QUINCY', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-02-10T22:23:51+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By James Grimmelmann and Jan Ellen Lewis', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Grimmelmann', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jan', 'middlename': 'Ellen', 'lastname': 'Lewis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/f0518de0-9db3-5412-aea8-7821094e1488', 'word_count': 715, 'uri': 'nyt://article/f0518de0-9db3-5412-aea8-7821094e1488'}, {'abstract': 'At heart, ‘Billions’ is a show about the benefits and limits of alpha-male aggression.', 'web_url': 'https://www.nytimes.com/2017/02/10/arts/television/billions-season-2-episode-1-premiere-recap.html', 'snippet': 'At heart, ‘Billions’ is a show about the benefits and limits of alpha-male aggression.', 'lead_paragraph': 'Sliding along an earth-trembling bass line, Harry Nilsson’s “Jump into the Fire” is the first music cue on this season of “Billions,” and for a show that’s always curated its soundtrack thoughtfully, the choice is significant. Cinephiles will instantly recognize it from the final third of “Goodfellas,” when the story of Henry Hill suddenly shifts from a decades-spanning gangster epic to a frantic, paranoid, cocaine-fueled day in the life. “You can climb a mountain, you can swim in the sea,” Nilsson sings, “You can jump into the fire, but you’ll never be free.” Those doom-laden lyrics suggest that even powerful men cannot transcend their situation, and Season 2 seems intent on putting the squeeze on Chuck Rhoades and Bobby Axelrod.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/watching/10billions/10billions-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/10/watching/10billions/10billions-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/watching/10billions/10billions-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thum