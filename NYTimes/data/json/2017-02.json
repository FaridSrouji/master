e': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Vietnam War', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Lyndon Baines', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kennedy, John Fitzgerald', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Vietnam', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-25T02:52:30+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Mark K. Updegrove', 'person': [{'firstname': 'Mark', 'middlename': 'K.', 'lastname': 'Updegrove', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/62c3ce42-c7b5-582a-a6fd-efd2b41164b7', 'word_count': 1367, 'uri': 'nyt://article/62c3ce42-c7b5-582a-a6fd-efd2b41164b7'}, {'abstract': 'Corrections appearing in print on Saturday, February 25, 2017.', 'web_url': 'https://www.nytimes.com/2017/02/24/pageoneplus/editors-note-february-25-2017.html', 'snippet': 'Corrections appearing in print on Saturday, February 25, 2017.', 'lead_paragraph': 'NEW YORK', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Note: February 25, 2017', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-02-25T02:55:44+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/d419a860-8ce2-5dcd-847c-7dad2288e746', 'word_count': 726, 'uri': 'nyt://article/d419a860-8ce2-5dcd-847c-7dad2288e746'}, {'abstract': 'Mark Diehl returns to remind us that Saturdays are for streak-breaking.', 'web_url': 'https://www.nytimes.com/2017/02/24/crosswords/all-things-being-equal-verrazano-battle-of-dien.html', 'snippet': 'Mark Diehl returns to remind us that Saturdays are for streak-breaking.', 'lead_paragraph': 'SATURDAY PUZZLES — I’m not sure what just happened to me, but you don’t want it. If you touch the column, make sure to wash your hands vigorously afterward. And many thanks to Martin “This is What I Get For Asking” Herbach and the surprisingly dangerous Caitlin Lovinger for making sure the Wordplay show went on in my absence.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/25/crosswords/25wordplay-armadillo/25wordplay-armadillo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/25/crosswords/25wordplay-armadillo/25wordplay-armadillo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/25/crosswords/25wordplay-armadillo/25wordplay-armadillo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/25/crosswords/25wordplay-armadillo/25wordplay-armadillo-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/25/crosswords/25wordplay-armadillo/25wordplay-armadillo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/25/crosswords/25wordplay-armadillo/25wordplay-armadillo-jumbo.jpg', 'height': 666, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/25/crosswords/25wordplay-armadillo/25wordplay-armadillo-superJumbo.jpg', 'height': 1332, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'All Things Being Equal', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-02-25T03:00:19+0000', 'document_type': 'article', 'news_desk': 'Games', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8f4efab4-47d8-5c3d-88fd-6029dfd459f7', 'word_count': 717, 'uri': 'nyt://article/8f4efab4-47d8-5c3d-88fd-6029dfd459f7'}, {'abstract': 'The larger the entity, the greater the torment. And so it has been with the Department of Veterans Affairs.', 'web_url': 'https://www.nytimes.com/2017/02/24/opinion/designs-on-the-va.html', 'snippet': 'The larger the entity, the greater the torment. And so it has been with the Department of Veterans Affairs.', 'lead_paragraph': 'We proceed with certain routine activities expecting the worst. We will face long lines when we go to the D.M.V. We will struggle to reach the right representative when calling the I.R.S. We will be on hold forever while attempting to challenge an insurance claim or change a flight reservation or cancel cable. We anticipate an ordeal in these instances and are rarely disappointed.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/24/opinion/25arieff5web/25arieff5web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/24/opinio