, 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/sports/15MCGRAW/15MCGRAW-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/15/sports/15MCGRAW/15MCGRAW-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/sports/15MCGRAW/15MCGRAW-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/sports/15MCGRAW/15MCGRAW-superJumbo.jpg', 'height': 1362, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Tug McGraw’s ’73 Mets Rallying Cry? It’s Now on a Phillies Wall', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Phillies', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McGraw, Tug', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-14T22:14:58+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tyler Kepner', 'person': [{'firstname': 'Tyler', 'middlename': None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0cad07aa-68cd-5222-8ced-a26c962624ad', 'word_count': 348, 'uri': 'nyt://article/0cad07aa-68cd-5222-8ced-a26c962624ad'}, {'abstract': 'Almost eight years after Cunningham’s death, a museum exhibition in Minneapolis makes his choreographic style crystal-clear.', 'web_url': 'https://www.nytimes.com/2017/02/14/arts/dance/merce-cunningham-and-the-drama-of-sheer-motion.html', 'snippet': 'Almost eight years after Cunningham’s death, a museum exhibition in Minneapolis makes his choreographic style crystal-clear.', 'lead_paragraph': 'MINNEAPOLIS — No choreographer in history has so naturally prompted museum exhibitions as Merce Cunningham. For more than 65 years, his form of radical dance theater was a vehicle for historic artistic experimentation, with brave breakthroughs of color, idiom, content. Musicians and visual artists were stimulated by the new directions that dance was taking.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/arts/15COMMONTIME/15COMMONTIME-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/15/arts/15COMMONTIME/15COMMONTIME-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/arts/15COMMONTIME/15COMMONTIME-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/arts/15COMMONTIME/15COMMONTIME-articleLarge.jpg', 'height': 545, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/15/arts/15COMMONTIME/15COMMONTIME-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 545}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/arts/15COMMONTIME/15COMMONTIME-jumbo.jpg', 'height': 931, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/arts/15COMMONTIME/15COMMONTIME-superJumbo.jpg', 'height': 1862, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Merce Cunningham and the Drama of Sheer Motion', 'kicker': "Critic's Notebook", 'content_kicker': None, 'print_headline': 'The Drama of Sheer Motion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Walker Art Center', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cunningham, Merce', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-14T22:16:17+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1ca79bbd-1a49-5971-a4b3-608a05871b76', 'word_count': 1003, 'uri': 'nyt://article/1ca79bbd-1a49-5971-a4b3-608a05871b76'}, {'abstract': 'To get the most out of a museum visit, don’t stay too long, focus on an area of interest, and use audio tours.', 'web_url': 'https://www.nytimes.com/2017/02/14/travel/how-to-navigate-a-museum.html', 'snippet': 'To get the most out of a museum visit, don’t stay too long, focus on an area of interest, and use audio tours.', 'lead_paragraph': 'Whether it’s the Louvre in Paris, the Prado Museum in Madrid or the Egyptian Museum in Cairo, museums are major tourist destinations. There are ways to get the most out a museum visit, according to Natasha Schlesinger, an art historian, curator and the founder of ArtMuse, a company that provides private tours of museums and galleries in New York City and Europe. “You want to do the museum justice and have fun at the same time,” she said.', 'print_section': 'TR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRANSITTIPS/19TRANSITTIPS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/19/travel/19TRANSITTIPS/19TRANSITTIPS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRANSITTIPS/19TRANSITTIPS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRANSITTIPS/19TRANSITTIPS-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/travel/19TRANSITTIPS/19TRANSITTIPS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRANSITTIPS/19TRANSITTIPS-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRANSITTIPS/19TRANSITTIPS-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'How to Navigate a Museum', 'kicker': 'Travel Tips', 'content_kicker': None, 'print_headline': 'Getting the Most Out of a Museum', 'name': None, 'seo': None, 'sub': None}, 'keyw