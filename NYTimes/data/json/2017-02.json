ame': 'Carol', 'middlename': None, 'lastname': 'Pogash', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/004341b3-904a-5038-b42d-5bb48bb4bbcd', 'word_count': 1441, 'uri': 'nyt://article/004341b3-904a-5038-b42d-5bb48bb4bbcd'}, {'abstract': 'A new game, Night in the Woods, is one of several in recent years that have tapped into themes of the decline of working-class towns and economic despair.', 'web_url': 'https://www.nytimes.com/2017/02/15/technology/personaltech/coming-to-video-games-near-you-depressed-towns-dead-end-characters.html', 'snippet': 'A new game, Night in the Woods, is one of several in recent years that have tapped into themes of the decline of working-class towns and economic despair.', 'lead_paragraph': 'In the coming video game Night in the Woods, a young woman named Mae decides to drop out of college and return to the former mining town where she grew up. It’s a place where there is little opportunity and most people are struggling to make ends meet.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/business/16VIDGAME-1/16VIDGAME-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/15/business/16VIDGAME-1/16VIDGAME-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/business/16VIDGAME-1/16VIDGAME-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/business/16VIDGAME-1/16VIDGAME-1-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/15/business/16VIDGAME-1/16VIDGAME-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/business/16VIDGAME-1/16VIDGAME-1-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/business/16VIDGAME-1/16VIDGAME-1-superJumbo.jpg', 'height': 1080, 'width': 1919, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Coming to Video Games Near You: Depressed Towns, Dead-End Characters', 'kicker': None, 'content_kicker': None, 'print_headline': 'Video Games Trade Fantasy for the Despair of Rust Belt Reality', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computer and Video Games', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Night in the Woods (Video Game)', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Kentucky Route Zero (Video Game)', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-15T15:12:18+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Laura Hudson', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Hudson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b38902ad-fdd3-53f5-83dd-447327a07b07', 'word_count': 954, 'uri': 'nyt://article/b38902ad-fdd3-53f5-83dd-447327a07b07'}, {'abstract': 'Villas at the just opened Hoshinoya Bali are connected by a winding network of waterways.', 'web_url': 'https://www.nytimes.com/2017/02/15/t-magazine/travel/hoshinoya-bali-japanese-hotel.html', 'snippet': 'Villas at the just opened Hoshinoya Bali are connected by a winding network of waterways.', 'lead_paragraph': 'Purists and grouches will say it peaked 20 years ago, but that hasn’t stopped hippies, hopefuls and everyone in between from descending on Ubud, the rice-paddy-and-Hindu-temple-punctuated town in southern Bali. Now the storied Japanese hotel group Hoshino Resorts has joined the wave, opening its doors in a quiet village about 10 minutes’ drive outside of town. The just opened Hoshinoya Bali has 30 thatch-roofed, multi-floor villas, all of which flank the three long, interconnected pools that run through the property like a river; guests are able to step directly from their villas’ living rooms into the water. After a swim, they can go skyward and drink a coconut water mojito in one of the elevated open-air gazebo lounges that seem to float above the treetops. What really distinguishes Hoshinoya, though, isn’t Balinese at all, but its exquisite Japanese-inflected menu (try the sashimi and wagyu beef) — as good as anything you might find in Kyoto, and a lovely, if unexpected, complement to the lush surroundings.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/t-magazine/travel/15tmag-hoshinoya01/15tmag-hoshinoya01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/15/t-magazine/travel/15tmag-hoshinoya01/15tmag-hoshinoya01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/15/t-magazine/travel/15tmag-hoshinoya01/15tmag-hoshinoya01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subty