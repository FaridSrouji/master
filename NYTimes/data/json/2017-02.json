 gown made of off-white denim and a checked patent leather blazer.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/t-magazine/09tmag-newdesigners-slide-SFRA/09tmag-newdesigners-slide-SFRA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/09/t-magazine/09tmag-newdesigners-slide-SFRA/09tmag-newdesigners-slide-SFRA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/t-magazine/09tmag-newdesigners-slide-SFRA/09tmag-newdesigners-slide-SFRA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/t-magazine/09tmag-newdesigners-slide-SFRA/09tmag-newdesigners-slide-SFRA-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/09/t-magazine/09tmag-newdesigners-slide-SFRA/09tmag-newdesigners-slide-SFRA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/t-magazine/09tmag-newdesigners-slide-SFRA/09tmag-newdesigners-slide-SFRA-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/t-magazine/09tmag-newdesigners-slide-SFRA/09tmag-newdesigners-slide-SFRA-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '5 New Designers to Watch This Season', 'kicker': None, 'c