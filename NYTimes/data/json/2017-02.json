cle', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Leonhardt', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9d6c6aa8-7b08-5e6d-b893-a64035413ec1', 'word_count': 804, 'uri': 'nyt://article/9d6c6aa8-7b08-5e6d-b893-a64035413ec1'}, {'abstract': 'Focus on progressive Obama coalition defectors, not on conservative white working-class voters.', 'web_url': 'https://www.nytimes.com/2017/02/21/opinion/move-left-democrats.html', 'snippet': 'Focus on progressive Obama coalition defectors, not on conservative white working-class voters.', 'lead_paragraph': 'The Democratic National Committee will choose its next leader on Saturday, and when it does it should choose a leader who will resist the pressure to pursue the wrong white people. Hundreds of articles have been written about the imperative of attracting more support from white working-class voters who supported Barack Obama in 2012 but then bolted to back Donald J. Trump.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/21/opinion/21phillipsWeb/21phillipsWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/21/opinion/21phillipsWeb/21phillipsWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/21/opinion/21phillipsWeb/21phillipsWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/21/opinion/21phillipsWeb/21phillipsWeb-articleLarge.jpg', 'height': 392, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/21/opinion/21phillipsWeb/21phillipsWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 392}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/21/opinion/21phillipsWeb/21phillipsWeb-jumbo.jpg', 'height': 668, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/21/opinion/21phillipsWeb/21phillipsWeb-superJumbo.jpg', 'height': 1337, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Move Left, Democrats', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Move Left, Democrats', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Third-Party Politics (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Whites', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic National Committee', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Perez, Thomas E', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Michigan', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank':