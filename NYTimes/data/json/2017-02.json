acy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/05/travel/05QA/05QA-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/05/travel/05QA/05QA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/05/travel/05QA/05QA-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/05/travel/05QA/05QA-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'For the Disabled Traveler, Strategies for a Successful Trip', 'kicker': 'Q AND A', 'content_kicker': None, 'print_headline': 'Barry Cohen on How to Travel With a Disability.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Disabilities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ALASKA', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Thailand', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-02-03T11:00:03+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Elaine Glusac', 'person': [{'firstname': 'Elaine', 'middlename': None, 'lastname': 'Glusac', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ffdddfcd-9b96-57af-b7fa-b371b185563e', 'word_count': 593, 'uri': 'nyt://article/ffdddfcd-9b96-57af-b7fa-b371b185563e'}, {'abstract': '“A Great Place to Have a War” by Jo