ultimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/technology/personaltech/10techtipwebART/10techtipwebART-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/10/technology/personaltech/10techtipwebART/10techtipwebART-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/technology/personaltech/10techtipwebART/10techtipwebART-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/technology/personaltech/10techtipwebART/10techtipwebART-jumbo.jpg', 'height': 550, 'width': 505, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/10/technology/personaltech/10techtipwebART/10techtipwebART-superJumbo.jpg', 'height': 550, 'width': 505, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Digitize Your CDs and Reclaim Your Closet', 'kicker': 'Tech Tip', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Compact Discs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Audio Recordings, Downloads and Streaming', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-02-09T16:48:23+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By J. D. Biersdorfer', 'person': [{'firstname': 'J.', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/f7cccf95-6386-5d58-afb1-1b19283a856c', 'word_count': 328, 'uri': 'nyt://article/f7cccf95-6386-5d58-afb1-1b19283a856c'}, {'abstract': 'Ryan Adams recalls the night at the Ryman Auditorium in Nashville when a distracting voice in the crowd shouted out a request: a song by Bryan Adams.', 'web_url': 'https://www.nytimes.com/2017/02/09/arts/music/ryan-adams-the-first-time-i-was-rattled-by-a-heckler.html', 'snippet': 'Ryan Adams recalls the night at the Ryman Auditorium in Nashville when a distracting voice in the crowd shouted out a request: a song by Bryan Adams.', 'lead_paragraph': 'I remember the day very well. It was so hot outside, the mugginess made my hair curl. The window to the nameless hotel room in the fine Detroit suburb of Royal Oak, Mich., was cracked open a bit as the phone rang. I had been waiting for a call from my manager at the time, a quick, sarcastic man who finished his sentences with phrases like “How you like that, buddy boy?” with a cartoonish 1950s movie drag on the “budddy boy.”', 'print_section': 'AR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12FIRSTTIME-RYANADAMS/12FIRSTTIME-RYANADAMS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/arts/12FIRSTTIME-RYANADAMS/12FIRSTTIME-RYANADAMS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12FIRSTTIME-RYANADAMS/12FIRSTTIME-RYANADAMS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12FIRSTTI