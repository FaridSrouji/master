ht': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/nyregion/19ALBUM-slide-IKXX/19ALBUM-slide-IKXX-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/nyregion/19ALBUM-slide-IKXX/19ALBUM-slide-IKXX-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/nyregion/19ALBUM-slide-IKXX/19ALBUM-slide-IKXX-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/nyregion/19ALBUM-slide-IKXX/19ALBUM-slide-IKXX-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/nyregion/19ALBUM-slide-IKXX/19ALBUM-slide-IKXX-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Welcome Guests', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dogs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cats', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Westminster Kennel Club Dog Show', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-14T22:20:55+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/5811cb83-ab51-5be4-a5ef-ba6f6db9406f', 'word_count': 0, 'uri': 'nyt://slideshow/5811cb83-ab51-5be4-a5ef-ba6f6db9406f'}, {'abstract': 'Cats at Westminster? While some fur may have been ruffled and human hackles raised, the felines don’t seem to care.', 'web_url': 'https://www.nytimes.com/2017/02/14/nyregion/dog-show-cats.html', 'snippet': 'Cats at Westminster? While some fur may have been ruffled and human hackles raised, the felines don’t seem to care.', 'lead_paragraph': 'Some would say that the true stars of this year’s Westminster Kennel Club Dog Show, which arrived in New York this week, are the cats. Featured as part of a collaboration with the International Cat Association, the cats drew consternation from some dog handlers, who felt the parvenus did not belong. The cats, being cats, did not care. They dressed up or dressed down, leapt through the occasional hoop and gazed witheringly on the efforts of their human and canine compatriots. Oh, to be a cat and be above it all.', 'print_section': 'MB', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/nyregion/19ALBUM1/19ALBUM1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/19/nyregion/19ALBUM1/19ALBUM1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/nyregion/19ALBUM1/19ALBUM1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/nyregion/19ALBUM1/19ALBUM1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/nyregion/19ALBUM1/19ALBUM1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type'