 'value': 'Democratic Party', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gorsuch, Neil M', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-02-03T08:21:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Alec MacGillis', 'person': [{'firstname': 'Alec', 'middlename': None, 'lastname': 'MacGillis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d290626e-2376-5cef-990e-da594563f0b8', 'word_count': 1285, 'uri': 'nyt://article/d290626e-2376-5cef-990e-da594563f0b8'}, {'abstract': 'The true American myth is dynamic and universal, yet the countermyth of Trump and Bannon is winning.', 'web_url': 'https://www.nytimes.com/2017/02/03/opinion/a-return-to-national-greatness.html', 'snippet': 'The true American myth is dynamic and universal, yet the countermyth of Trump and Bannon is winning.', 'lead_paragraph': 'The Library of Congress’s main building is one of the most magnificent buildings in Washington, or in the country. It was built in a pivotal, tumultuous time. During the 23 years in the late 19th century that it took to design and build the structure, industrialization transformed America. More people immigrated to America than in the previous 250 years combined.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/03/opinion/03brooksWeb/03brooksWeb-articleLarge.jpg', 'height': 451, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/03/opinion/03brooksWeb/03brooksWeb