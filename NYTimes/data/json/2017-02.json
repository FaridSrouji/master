 [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Courts and the Judiciary', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-10T08:21:20+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/033b162f-6100-53e8-80df-4a6eaad1709e', 'word_count': 779, 'uri': 'nyt://article/033b162f-6100-53e8-80df-4a6eaad1709e'}, {'abstract': 'Our acts of moral courage defend America as surely as any act of violence.', 'web_url': 'https://www.nytimes.com/2017/02/10/opinion/sunday/what-were-fighting-for.html', 'snippet': 'Our acts of moral courage defend America as surely as any act of violence.', 'lead_paragraph': 'When his convoy was ambushed during the 2003 invasion of Iraq, First Lt. Brian Chontosh ordered his Humvee driver to head straight into the oncoming machine gun fire. They punched through, landing in a trench full of heavily armed Iraqi soldiers. Lieutenant Chontosh and his Marines leapt out and he ran down the trench firing away, dropping one enemy soldier after another. First his rifle jammed, then he ran out of ammunition, so he switched to his pistol. He shot it dry, reloaded, and shot it dry again. So he picked up an AK-47 from a dead Iraqi, fired that dry, picked up another AK, fired that dry, picked up a rocket-propelled grenade, fired it, and led the group back to the Humvee, their attack having almost completely cleared the trench. Almost.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/opinion/sunday/12KLAY/12KLAY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/opinion/sunday/12KLAY/12KLAY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/opinion/sunday/12KLAY/12KLAY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/opinion/sunday/12KLAY/12KLAY-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/opinion/sunday/12KLAY/12KLAY-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/opinion/sunday/12KLAY/12KLAY-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/opinion/sunday/12KLAY/12KLAY-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What We’re Fighting For', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'What We’re Fighting For', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Torture', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ABU GHRAIB (IRAQ)', 'rank': 4, 'major': 'N'}, 