', 'value': 'Awards, Decorations and Honors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Contests and Prizes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'World Press Photo Foundation', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-02-13T10:30:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9a1d7ae-f222-5148-b8ee-3e05d6821163', 'word_count': 970, 'uri': 'nyt://article/e9a1d7ae-f222-5148-b8ee-3e05d6821163'}, {'abstract': 'The top prize in the World Press Photo contest went to a dramatic image of the assassination of Russia’s ambassador to Turkey. Here are the top photos in various categories.', 'web_url': 'https://www.nytimes.com/slideshow/2017/02/13/blogs/the-worlds-best-photo.html', 'snippet': 'The top prize in the World Press Photo contest went to a dramatic image of the assassination of Russia’s ambassador to Turkey. Here are the top photos in various categories.', 'lead_paragraph': 'The top prize in the World Press Photo contest went to a dramatic image of the assassination of Russia’s ambassador to Turkey. Here are the top photos in various categories.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/13/blogs/13-lens-WPress-slide-KZFI/13-lens-WPress-slide-KZFI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/13/blogs/13-lens-WPress-slide-KZFI/13-lens-WPress-slide-KZFI-thum