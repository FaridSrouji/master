: None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4fbcc46a-cf3e-533e-96b7-74274855d55a', 'word_count': 151, 'uri': 'nyt://article/4fbcc46a-cf3e-533e-96b7-74274855d55a'}, {'abstract': 'Alexei Jawlensky, who helped created the genre with Kandinsky, is having his first full museum retrospective in the United States.', 'web_url': 'https://www.nytimes.com/2017/02/08/arts/design/german-expressionisms-other-painter-at-neue-galerie.html', 'snippet': 'Alexei Jawlensky, who helped created the genre with Kandinsky, is having his first full museum retrospective in the United States.', 'lead_paragraph': 'In the same way that Bill Wyman doesn’t leap to mind when you think of the Rolling Stones, or Zeppo when you think of the Marx Brothers, the painter Alexei Jawlensky (1864-1941) has never been — at least for most Americans — a household name in German Expressionism, the movement he helped create with his friend Wassily Kandinsky.', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE2/12GUIDE2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/arts/12GUIDE2/12GUIDE2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE2/12GUIDE2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE2/12GUIDE2-articleLarge.jpg', 'height': 465, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/arts/12GUIDE2/12GUIDE2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 465}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE2/12GUIDE2-jumbo.jpg', 'height': 794, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE2/12GUIDE2-superJumbo.jpg', 'height': 1588, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'German Expressionism’s ‘Other’ Painter, at Neue Galerie', 'kicker': None, 'content_kicker': None, 'print_headline': 'Art; The ‘Other’ Expressionist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Neue Galerie', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jawlensky, Alexei (1864-1941)', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-08T15:41:42+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0bc90ba-0138-5866-8637-686f43489c8a', 'word_count': 153, 'uri': 'nyt://article/e0bc90ba-0138-5866-8637-686f43489c8a'}, {'abstract': 'Mr. Maya’s “Latente: A Flamenco Journey,” at the Schimmel Center, takes inspiration from the Gypsy singer Juana la del Pipa.', 'web_url': 'https://www.nytimes.com/2017/02/08/arts/dance/jose-mayas-magical-flamenco-tour.html', 'snippet': 'Mr. Maya’s “Latente: A Flamenco Journey,” at the Schimmel Center, takes inspiration from the Gypsy singer Juana la del Pipa.', 'lead_paragraph': 'Flamenco enthusiasts generally mark their calendars for March, when the annual Flamenco Festival comes to New York. But there will be an early treat on Friday, Feb. 17, for those in need of a flamenco fix, when the Spanish dancer José Maya presents his “Latente: A Flamenco Journey” at the Schimmel Center at Pace University. The show, a New York premiere (for one night only), takes inspiration from the great Gypsy singer Juana la del Pipa, who will join the explosive Mr. Maya onstage, along with the vocalists Enrique el Extremeño and Manuel Tañe and the guitarist Pino Losada.', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE6/12GUIDE6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/arts/12GUIDE6/12GUIDE6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE6/12GUIDE6-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE6/12GUIDE6-articleLarge.jpg', 'height': 908, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/arts/12GUIDE6/12GUIDE6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 908}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE6/12GUIDE6-jumbo.jpg', 'height': 1024, 'width': 677, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE6/12GUIDE6-superJumbo.jpg', 'height': 1448, 'width': 957, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'José Maya’s Magical Flamenco Tour', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dance; One Man’s Magical Flamenco Tour', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Flamenco (Dance)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Maya, Jose (1983- )', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Pace University', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-08T15:43:05+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Siobhan Burke', 'person': [{'firstname': 'Siobhan', 'middlename': None, 'lastname': 'Burke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/23d41c5a-7035-5774-81b4-b08405be4b54', 'word_count': 153, 'uri': 'nyt://article/23d41c5a-7035-5774-81b4-b08405be4b54'}, {'abstract': 'On Season 2, a ghostly young woman stumbles into a German town and says she’s Alice Webster, who disappeared more than a decade earlier.', 'web_url': 'https://www.nytimes.com/2017/02/08/arts/television/the-missing-returns-to-starz-raising-questions-and-hopes.html', 'snippet': 'On Season 2, a ghostly young woman stumbles into a German town and says she’s Alice Webster, who disappeared more than a decade earlier.', 'lead_paragraph': 'In its first season, “The Missing” chronicled the anguished search for Oliver Hughes, a 5-year-old British boy vacationing with his parents in France who vanished as his father watched a World Cup game in a crowded bar. Now, in this anthology series’s second installment, which becomes available on Starz on Sunday, Feb. 12, a ghostly young woman stumbles into a German town and announces herself to be Alice Webster, who disappeared more than a decade earlier. She seems changed, enough so that her mother (Keeley Hawes) starts to wonder whether Alice is who she says she is, while her father (David Morrissey) insists on suspending disbelief.', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE8/12GUIDE8-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/arts/12GUIDE8/12GUIDE8-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE8/12GUIDE8-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE8/12GUIDE8-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/arts/12GUIDE8/12GUIDE8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE8/12GUIDE8-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE8/12GUIDE8-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '‘The Missing’ Returns to Starz, Raising Questions and Hopes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Television; Raising Questions and Raising Hopes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Starz', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Missing (TV Program)', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-08T15:46:09+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/97459a08-c5bb-5b41-bbe7-100fd92d82ab', 'word_count': 156, 'uri': 'nyt://article/97459a08-c5bb-5b41-bbe7-100fd92d82ab'}, {'abstract': 'Ms. Sultana, who enjoys being in a comfortable nest of guitars, will appear at Mercury Lounge and Rough Trade NYC.', 'web_url': 'https://www.nytimes.com/2017/02/08/arts/music/tash-sultana-a-bedroom-busker-leaves-her-nest.html', 'snippet': 'Ms. Sultana, who enjoys being in a comfortable nest of guitars, will appear at Mercury Lounge and Rough Trade NYC.', 'lead_paragraph': 'Tash Sultana, a self-taught singer, songwriter and guitarist, found a local audience by busking on the streets of Melbourne and a worldwide one on YouTube, with songs recorded live and solo in her bedroom. Sometimes, like YouTube hopefuls worldwide, she has performed with just an acoustic guitar. But more often, she has appeared in a nest of guitars, keyboards, amplifiers and gizmos. With looping equipment, she layers guitar and keyboard lines, beats and vocal parts that can be sweetly melodic, raspy and untamed or speedy enough to reach the verge of rapping. She can assemble webs of folky fingerpicking or stack up distorted hard-rock guitars, and she often touches down in reggae. But her most promising songs are the ones in which she is less bound to any genre. (Wednesday, Feb. 15, Mercury Lounge, mercuryloungenyc.com; Feb. 17, Rough Trade NYC in Williamsburg, roughtradenyc.com.)', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE1/12GUIDE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/arts/12GUIDE1/12GUIDE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE1/12GUIDE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE1/12GUIDE1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/arts/12GUIDE1/12GUIDE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE1/12GUIDE1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE1/12GUIDE1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Tash Sultana: A Bedroom Busker Leaves Her Nest', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pop; Bedroom Busker Leaves Her Nest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sultana, Tash', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-02-08T15:47:11+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/167d13b0-cf0f-52aa-8ff6-24987ef7f993', 'word_count': 143, 'uri': 'nyt://article/167d13b0-cf0f-52aa-8ff6-24987ef7f993'}, {'abstract': 'This musical drama, opening at the Brooklyn Academy of Music on Feb. 15, is a production of the Young Vic and the South African Isango Ensemble.', 'web_url': 'https://www.nytimes.com/2017/02/08/theater/a-man-of-good-hope-a-refugee-tale-for-the-moment.html', 'snippet': 'This musical drama, opening at the Brooklyn Academy of Music on Feb. 15, is a production of the Young Vic and the South African Isango Ensemble.', 'lead_paragraph': 'It seems as if the entire world is on edge, with xenophobia the word of our times, and though it has been long-planned, the United States premiere of “A Man of Good Hope” could hardly be better timed. The musical drama, which begins at the Brooklyn Academy of Music on Wednesday, Feb. 15, is based on a book (by Jonny Steinberg) about the true story of Asad Abdullahi, born in Somalia and orphaned as a boy, who trekked to South Africa only to face violence there.', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/arts/12GUIDE7/12GUIDE7-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/arts/12GUIDE7/12GUIDE7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/