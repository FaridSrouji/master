2/09/fashion/09FRONTROW/09FRONTROW-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/fashion/09FRONTROW/09FRONTROW-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/09/fashion/09FRONTROW/09FRONTROW-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/fashion/09FRONTROW/09FRONTROW-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/09/fashion/09FRONTROW/09FRONTROW-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Where Have You Gone, Angelina Jolie? Celebrities Vanish From Fashion’s Front Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Disappearing Front Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Celebrities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'New York Fashion Week', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-08T09:38:51+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Ruth La Ferla', 'person': [{'firstname': 'Ruth', 'middlename': None, 'lastname': 'La Ferla', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3ca01dce-05ca-5138-ad00-9e119158736c', 'word_count': 1637, 'uri': 'nyt://article/3ca01dce-05ca-5138-ad00-9e119158736c'}, {'abstract': 'The magazine’s Ethicist columnist on self-administering an untested therapy, lying to your dementia-afflicted mother and unequal pay.', 'web_url': 'https://www.nytimes.com/2017/02/08/magazine/can-a-researcher-studying-an-alzheimers-treatment-try-it-on-himself.html', 'snippet': 'The magazine’s Ethicist columnist on self-administering an untested therapy, lying to your dementia-afflicted mother and unequal pay.', 'lead_paragraph': 'I’m an older scientist who has spent decades leading a small laboratory at a well-known medical center. Much of our work is purely for the joy of discovery, but we also seek badly needed cures for illnesses. A cure for Alzheimer’s disease is beginning to look attainable with technology we are pioneering. While investigating genes for early-onset Alzheimer’s, we invented a gene-transfer method that stopped the brain damage and restored cognitive function. Eureka! Sadly, my doctor has just given me a diagnosis of early-stage Alzheimer’s. Given that no truly effective treatment is out there yet, can I try dosing myself with our potential cure? Do I have the right, given that I will otherwise die of dementia before a clinical trial could even begin? I plan to do this alone. None of my people will know about it. It’s something like a high-altitude, low-opening jump. It is not reversible and may be dangerous. But is it wrong? Name Withheld', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12ethicist/12mag-12ethicist-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/magazine/12ethicist/12mag-12ethicist-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12ethicist/12mag-12ethicist-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12ethicist/12mag-12ethicist-t_CA0-articleLarge.jpg', 'height': 872, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/magazine/12ethicist/12mag-12ethicist-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 872}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12ethicist/12mag-12ethicist-t_CA0-jumbo.jpg', 'height': 977, 'width': 672, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12ethicist/12mag-12ethicist-t_CA0-superJumbo.jpg', 'height': 977, 'width': 672, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Can a Researcher Studying an Alzheimer’s Treatment Try It on Himself?', 'kicker': 'The Ethicist', 'content_kicker': None, 'print_headline': 'My Lab Is Studying an Alzheimer’s Treatment. Can I Try It on Myself?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Alzheimer's Disease", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Lying', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dementia', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-08T10:00:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Kwame Anthony Appiah', 'person': [{'firstname': 'Kwame', 'middlename': 'Anthony', 'lastname': 'Appiah', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f638cd49-6bef-5a58-aa61-d1283f3cec78', 'word_count': 1415, 'uri': 'nyt://article/f638cd49-6bef-5a58-aa61-d1283f3cec78'}, {'abstract': 'The Christian obstetrician on the “religious conversion” that led him to become an abortion provider.', 'web_url': 'https://www.nytimes.com/2017/02/08/magazine/willie-j-parker-changed-his-mind-about-abortion.html', 'snippet': 'The Christian obstetrician on the “religious conversion” that led him to become an abortion provider.', 'lead_paragraph': 'Your book, “Life’s Work,” is rooted in the fact that you have a moral and spiritual argument in favor of abortion rights, and you talk about your shift from someone who, for religious reasons, didn’t want to provide abortion to someone who, for religious reasons, did. Why did you consider that a “conversion”? I had to come to a crisis moment regarding a religious understanding that left me unable to help women when I felt deeply for their situation. So I needed to convert from a religious understanding that left me paralyzed to act on my deepest sense of connection to one that empowered me to do what I felt to be the right thing. It felt as life-altering for me to move from being unable to do abortions to being able to do them as it did to move from being a nonbeliever to becoming a believer.', 'print_section': 'MM', 'print_page': '66', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12talk/12mag-12talk-t_CA0-articleLarge.jpg', 'height': 1031, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/magazine/12talk/12mag-12talk-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1031}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12talk/12mag-12talk-t_CA0-jumbo.jpg', 'height': 1024, 'width': 597, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12talk/12mag-12talk-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 1193, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12talk/12mag-12talk-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/magazine/12talk/12mag-12talk-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12talk/12mag-12talk-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Willie J. Parker Changed His Mind About Abortion', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'Willie J. Parker Changed His Mind About Abortion ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ALABAMA', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-02-08T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Ana Marie Cox', 'person': [{'firstname': 'Interview', 'middlename': 'Ana', 'lastname': 'Marie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4325cf96-22b2-5681-b7de-9cc9f5099f09', 'word_count': 691, 'uri': 'nyt://article/4325cf96-22b2-5681-b7de-9cc9f5099f09'}, {'abstract': 'The Frugal Traveler looks back at his first year on the job, and finds some travel techniques were learned more painfully than others.', 'web_url': 'https://www.nytimes.com/2017/02/08/travel/budget-travel-frugal-traveler-top-tips-2017.html', 'snippet': 'The Frugal Traveler looks back at his first year on the job, and finds some travel techniques were learned more painfully than others.', 'lead_paragraph': 'The new year has already brought about significant changes to our world, including the way some of us travel. It also commemorates, less significantly, the one-year anniversary of my taking over the Frugal Traveler column. (No applause, please.) The old cliché “time flies” rings true: It really does seem like yesterday that I wrote my first column from Las Vegas. I’ve also spent entirely too much time actually flying this past year. But at least all that airtime has yielded lessons — some more painful than others. Here are five of them, picked up during my travels through 10 countries and a dozen states in 2016.', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/travel/12FRUGAL/12FRUGAL-articleLarge.jpg', 'height': 473, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/travel/12FRUGAL/12FRUGAL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 473}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/travel/12FRUGAL/12FRUGAL-jumbo.jpg', 'height': 806, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/travel/12FRUGAL/12FRUGAL-superJumbo.jpg', 'height': 949, 'width': 1205, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url':