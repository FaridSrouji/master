ts/17LISTINGSCOMEDY/17LISTINGSCOMEDY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 830}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17LISTINGSCOMEDY/17LISTINGSCOMEDY-jumbo.jpg', 'height': 1024, 'width': 741, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17LISTINGSCOMEDY/17LISTINGSCOMEDY-superJumbo.jpg', 'height': 1876, 'width': 1356, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17LISTINGSCOMEDY/17LISTINGSCOMEDY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/17/arts/17LISTINGSCOMEDY/17LISTINGSCOMEDY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17LISTINGSCOMEDY/17LISTINGSCOMEDY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Comedy in NYC This Week', 'kicker': None, 'content_kicker': None, 'print_headline': 'Comedy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Comedy and Humor', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-02-16T23:11:38+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Elise Czajkowski', 'person': [{'firstname': 'Elise', 'middlename': None, 'lastname': 'Czajkowski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dbb7b8a7-e992-5b46-a9bd-f33ca436b032', 'word_count': 396, 'uri': 'nyt://article/dbb7b8a7-e992-5b46-a9bd-f33ca436b032'}, {'abstract': 'It’s the last day of school, and two teachers are getting ready to rumble in this comedy directed by Richie Keen.', 'web_url': 'https://www.nytimes.com/2017/02/16/movies/fist-fight-review-ice-cube-charlie-day.html', 'snippet': 'It’s the last day of school, and two teachers are getting ready to rumble in this comedy directed by Richie Keen.', 'lead_paragraph': 'I’ll be honest with you. I was in a pretty foul mood when I went to see “Fist Fight.” It was Wednesday. It was February. It was 2017. And while I can’t exactly say that the movie cheered me up, it did give me something I needed. Not catharsis or uplift but a bracing dose of profane, sloppy, reasonably well-directed hostility. We take what we can get.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17FISTGIGHT/17FISTGIGHT-articleLarge.jpg', 'height': 480, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/17/arts/17FISTGIGHT/17FISTGIGHT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 480}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17FISTGIGHT/17FISTGIGHT-jumbo.jpg', 'height': 820, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17FISTGIGHT/17FISTGIGHT-superJumbo.jpg', 'height': 1022, 'width': 1277, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17FISTGIGHT/17FISTGIGHT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/17/arts/17FISTGIGHT/17FISTGIGHT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/arts/17FISTGIGHT/17FISTGIGHT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Ice Cube and Charlie Day Face Off in ‘Fist Fight’', 'kicker': None, 'content_kicker': None, 'print_headline': 'School’s Out: Rumble Time (Teacher Style)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Fist Fight (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Day, Charlie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ice Cube (1969- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Keen, Richie', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Robichaux, Van', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Susser, Evan', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-02-16T23:12:33+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/930c741b-5a36-53bc-bdd2-eee370b62dd3', 'word_count': 585, 'uri': 'nyt://article/930c741b-5a36-53bc-bdd2-eee370b62dd3'}, {'abstract': 'The outline of the plan points to a simpler system that would give every American a flat tax credit varying by age, but not by income.', 'web_url': 'https://www.nytimes.com/2017/02/16/upshot/republican-health-proposal-would-redirect-money-from-poor-to-rich.html', 'snippet': 'The outline of the plan points to a simpler system that would give every American a flat tax credit varying by age, but not by income.', 'lead_paragraph': 'Republicans in Congress have been saying for months that they are working on a plan to repeal and replace Obamacare in the Trump era. Now we have the outline of that plan, and it looks as if it would redirect federal support away from poorer Americans and toward people who are wealthier.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/upshot/17up-ryanplan/17up-ryanplan-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/17/upshot/17up-ryanplan/17up-ryanplan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/upshot/17up-ryanplan/17up-ryanplan-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/upshot/17up-ryanplan/17up-ryanplan-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/upshot/17up-ryanplan/17up-ryanplan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/17/upshot/17up-ryanplan/17up-ryanplan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/17/upshot/17up-ryanplan/17up-ryanplan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headlin