rstname': 'Ariana', 'middlename': None, 'lastname': 'Tobin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/82746e82-3aef-5b60-a7cd-eafd7ddf8995', 'word_count': 1018, 'uri': 'nyt://article/82746e82-3aef-5b60-a7cd-eafd7ddf8995'}, {'abstract': 'The writer and director discusses a sequence from his film.', 'web_url': 'https://www.nytimes.com/2017/02/23/movies/jordan-peele-narrates-a-scene-from-get-out.html', 'snippet': 'The writer and director discusses a sequence from his film.', 'lead_paragraph': 'A young black man goes to visit the parents of his white girlfriend and things get very, very weird in “Get Out,” the thriller from Jordan Peele. In this scene, Chris (Daniel Kaluuya) is attending a party and feeling very out of place until he spots another black man (Lakeith Stanfield). But the man, who goes by the name of Logan, seems disconnected and not reassuring in the ways Chris had hoped. In an interview, Mr. Peele talked about the racial tension in the scene. Here are excerpts from that conversation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jordan Peele Narrates a Scene From ‘Get Out’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Get Out (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Peele, Jordan', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-23T20:39:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/38572b1d-fed1-5