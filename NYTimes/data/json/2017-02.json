 'xlargewidth': 600, 'xlargeheight': 446}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/books/review/0219-BKS-Ozick-COVER/0219-BKS-Ozick-COVER-jumbo-v2.jpg', 'height': 761, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/books/review/0219-BKS-Ozick-COVER/0219-BKS-Ozick-COVER-superJumbo-v2.jpg', 'height': 1523, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Death and Disaster Stalk the Characters in Margaret Drabble’s New Novel', 'kicker': 'Fiction', 'content_kicker': None, 'print_headline': 'The Last Road Trip', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Dark Flood Rises (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Drabble, Margaret', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-02-14T10:00:04+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Cynthia Ozick', 'person': [{'firstname': 'Cynthia', 'middlename': None, 'lastname': 'Ozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b8362517-b6bd-5f0d-a4a3-466d42cd521d', 'word_count': 1373, 'uri': 'nyt://article/b8362517-b6bd-5f0d-a4a3-466d42cd521d'}, {'abstract': 'Call it the Trini-fication of Carnival. Trinidad-style fetes are full-on productions that now happen almost monthly.', 'web_url': 'https://www.nytimes.com/2017/02/14/travel/trinidad-caribbean-carnival-island.html', 'snippet': 'Call it the Trini-fication of Carnival. Trinidad-style fetes are full-on productions that now happen almost monthly.', 'lead_paragraph': 'We Caribbean carnival devotees, counting down the days until the region’s biggest bacchanal erupts on the streets of Port of Spain, Trinidad, on Feb. 27 and 28, have a dream. A dream that one day carnival will grace us with its life-affirming presence not once a year but once a month. That one day all of humanity can pause during mundane daily routines and take solace in the fact that right now, somewhere in the world, life is being measured out in music and dance and feathers and glitter, not conference calls and crowded commutes: Somewhere, it is carnival.', 'print_section': 'TR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRINIDADCOVER/19TRINIDADCOVER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/19/travel/19TRINIDADCOVER/19TRINIDADCOVER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRINIDADCOVER/19TRINIDADCOVER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRINIDADCOVER/19TRINIDADCOVER-articleLarge.jpg', 'height': 632, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/travel/19TRINIDADCOVER/19TRINIDADCOVER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 632}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRINIDADCOVER/19TRINIDADCOVER-jumbo.jpg', 'height': 1024, 'width': 972, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/travel/19TRINIDADCOVER/19TRINIDADCOVER-superJumbo.jpg', 'height': 2048, 'width': 1943, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Caribbean’s Carnivals Tip Their Hats to Trinidad', 'kicker': 'Pursuits', 'content_kicker': None, 'print_headline': 'Carnival  Goes Global', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Carnival (Pre-Lenten)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Caribbean Area', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Trinidad and Tobago', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-14T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Baz Dreisinger', 'person': [{'firstname': 'Baz', 'middlename': None, 'lastname': 'Dreisinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7bf589f-40a9-5a97-bb79-65c91a4c273d', 'word_count': 1305, 'uri': 'nyt://article/d7bf589f-40a9-5a97-bb79-65c91a4c273d'}, {'abstract': 'How the current moment has changed the pressures on players, coaches and other to speak out or be silent.', 'web_url': 'https://www.nytimes.com/2017/02/14/magazine/should-athletes-stick-to-sports.html', 'snippet': 'How the current moment has changed the pressures on players, coaches and other to speak out or be silent.', 'lead_paragraph': 'For the past few months, the sports media has been embroiled in a fight over “stick to sports.” The phrase comes from a common online rebuke directed at sportswriters and pundits and players and coaches and anyone in the world of sports, really, who takes a political stance on anything that doesn’t occur on a field or a court or in a locker room or front office. The dividing line is predictable: Many jocks and traditionalists argue for a separation of church and state; many young fans say that sports, just like everything else, is politics. But as the sports media critic Bryan Curtis has pointed out in The Ringer, the debate is mostly moot now: Trump’s presidency, with its daily explosions, has made it impossible to cover pro sports, even in the simplest box-score ways, without detouring onto the White House lawn. This comes, in part, from the way basic sports coverage works. Reporters ask questions before and after every game, and when the only thing anyone wants to talk about is Trump, some of those questions will be about the president.', 'print_section': 'MM', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19onsports1-copy/19onsports1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/19/magazine/19onsports1-copy/19onsports1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19onsports1-copy/19onsports1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19onsports1-copy/19mag-19onsports-t_CA0-articleLarge.jpg', 'height': 698, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/magazine/19onsports1-copy/19mag-19onsports-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 698}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19onsports1-copy/19mag-19onsports-t_CA0-jumbo.jpg', 'height': 1024, 'width': 881, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19onsports1-copy/19mag-19onsports-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 1762, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Should Athletes Stick to Sports?', 'kicker': 'On Sports', 'content_kicker': None, 'print_headline': 'Should Athletes Stick to Sports?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kaepernick, Colin', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Women's National Basketball Assn", 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Brady, Tom', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Curry, Stephen', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-02-14T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Jay Caspian Kang', 'person': [{'firstname': 'Jay', 'middlename': 'Caspian', 'lastname': 'Kang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f7acdc08-e012-56e4-bc6d-67085f6443b9', 'word_count': 1302, 'uri': 'nyt://article/f7acdc08-e012-56e4-bc6d-67085f6443b9'}, {'abstract': 'When some climate scientists began saying we’d entered a new epoch, they meant to draw attention to human effects on climate. Now, to their dismay, it’s become a tech call to arms for more disruption.', 'web_url': 'https://www.nytimes.com/2017/02/14/magazine/is-the-anthropocene-era-a-condemnation-of-human-interference-or-a-call-for-more.html', 'snippet': 'When some climate scientists began saying we’d entered a new epoch, they meant to draw attention to human effects on climate. Now, to their dismay, it’s become a tech call to arms for more disruption.', 'lead_paragraph': 'Perhaps you’ve noticed, amid the hot invective and dry mockery of daily events in your social-media feeds, reports of the glaciers melting at each pole. Arctic ice cover reached record lows this summer and fall, while in Antarctica, we saw the continuing enlargement of an already massive crack in the region’s fourth-largest ice sheet, threatening its continued stability. The year 2016 was the hottest ever recorded, surpassing the previous record in 2015, which had in turn exceeded that of the previous hottest year ever recorded, 2014. Just as the world seemed poised to embark on a collective effort to wean itself off dependency on fossil fuels, its leading power elected as president a man who has claimed that global warming is a conspiracy invented by the Chinese and who went on to select as his secretary of state the chairman of Exxon Mobil. The choices they make will shape the future of all planetary life.', 'print_section': 'MM', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19firstwords/19firstwords-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/19/magazine/19firstwords/19firstwords-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19firstwords/19firstwords-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19firstwords/19firstwords-articleLarge-v3.jpg', 'height': 572, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/magazine/19firstwords/19firstwords-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 572}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19firstwords/19firstwords-jumbo-v3.jpg', 'height': 976, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19firstwords/19firstwords-superJumbo-v3.jpg', 'height': 1440, 'width': 1511, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Is the ‘Anthropocene’ Epoch a Condemnation of Human Interference — or a Call for More?', 'kicker': 'First Words', 'content_kicker': None, 'print_headline': 'Only Human', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Geology', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Homo Deus: A Brief History of Tomorrow (Book)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Harari, Yuval Noah', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-02-14T10:00:15+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Wesley Yang', 'person': [{'firstname': 'Wesley', 'middlename': None, 'lastname': 'Yang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41e29a88-09d8-59c3-a283-0f17f6ddb201', 'word_count': 1230, 'uri': 'nyt://article/41e29a88-09d8-59c3-a283-0f17f6ddb201'}, {'abstract': 'Republicans spent almost seven years waging a battle to repeal the Affordable Care Act. Finally, they are set up for victory — or a new kind of disappointment.', 'web_url': 'https://www.nytimes.com/2017/02/14/magazine/will-obamacare-really-go-under-the-knife.html', 'snippet': 'Republicans spent almost seven years waging a battle to repeal the Affordable Care Act. Finally, they are set up for victory — or a new kind of disappointment.', 'lead_paragraph': 'Six days after he was sworn in as America’s 45th president, Donald J. Trump traveled to Philadelphia to address Republican lawmakers at their annual retreat. Standing behind a lectern emblazoned with the presidential seal, Trump predicted, “This Congress is going to be the busiest Congress we’ve had in decades.” Being Trump, he could not resist ad-libbing a superlative: “Maybe ever. Maybe ever. Think of that.”', 'print_section': 'MM', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19cover/19cover-articleLarge-v5.jpg', 'height': 356, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/19/magazine/19cover/19cover-articleLarge-v5.jpg', 'xlargewidth': 600, 'xlargeheight': 356}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19cover/19cover-jumbo-v10.jpg', 'height': 608, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/19/magazine/19cover/19cover-superJumbo-v10.jpg', 'height': 734, 'width': 1236, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'c