pe': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/magazine/12thread1/12thread1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 743}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12thread1/12thread1-jumbo.jpg', 'height': 1024, 'width': 827, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12thread1/12thread1-superJumbo.jpg', 'height': 1480, 'width': 1195, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The 1.29.17 Issue', 'kicker': 'The Thread', 'content_kicker': None, 'print_headline': 'The 1.29.17 Issue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-02-10T10:00:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/09dc0daf-2048-55f1-8282-7665029939cb', 'word_count': 646, 'uri': 'nyt://article/09dc0daf-2048-55f1-8282-7665029939cb'}, {'abstract': 'Start with the atmosphere. Don’t worry about wrapping everything up.', 'web_url': 'https://www.nytimes.com/2017/02/10/magazine/how-to-tell-a-ghost-story.html', 'snippet': 'Start with the atmosphere. Don’t worry about wrapping everything up.', 'lead_paragraph': '“The most important thing is the setting,” says Ruth Robbins, professor of Victorian literature at Leeds Beckett University in England. “In the 19th century, ghost stories were read aloud so that the atmosphere set people up to be pleasurably scared in a communal way.” Britons in the Victorian era were obsessed with ghost stories because they reflected uncertain times — the Industrial Revolution, a move to urban living and technological advances like the telegraph, a supernatural-seeming invention. “Start with elements that you may be afraid of because of that atavistic, primitive danger,” Robbins says. “Bodies that are apparently human but might not be, like dolls and portraits. If the narrative begins in a room with those items, you’re more likely to be haunted by that space.” Material detail is powerful, because ghost stories are often about objects. “People become possessed by possessions,” Robbins says.', 'print_section': 'MM', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12tip/12tip-articleLarge.jpg', 'height': 494, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/12/magazine/12tip/12tip-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 494}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12tip/12tip-jumbo.jpg', 'height': 844, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12tip/12tip-superJumbo.jpg', 'height': 1174, 'width': 1425, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12tip/12tip-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/12/magazine/12tip/12tip-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/12/magazine/12tip/12tip-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Tell a Ghost Story', 'kicker':