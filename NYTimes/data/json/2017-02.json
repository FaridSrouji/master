middlename': None, 'lastname': 'Gessen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Martina', 'middlename': None, 'lastname': 'Navratilova', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6521d98d-ed81-5ce7-a367-d69525b61ad4', 'word_count': 1235, 'uri': 'nyt://article/6521d98d-ed81-5ce7-a367-d69525b61ad4'}, {'abstract': 'Trump’s refugee mess may be a sign of things to come.', 'web_url': 'https://www.nytimes.com/2017/02/01/opinion/how-populism-stumbles.html', 'snippet': 'Trump’s refugee mess may be a sign of things to come.', 'lead_paragraph': 'Populisms vary, but their genesis is generally the same. Some set of ideas commands public support but lacks purchase in elite policy debates. Then a combination of elite failure and popular pressure makes that tension ripe for exploitation, and some new figure or movement emerges, promising to follow the will of the people and override the ruling class.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/01/opinion/01douthatWeb/01douthatWeb-articleLarge.jpg', 'height': 382, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/01/opinion/01douthatWeb/01douthatWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 382}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/01/opinion/01douthatWeb/01douthatWeb-jumbo.jpg', 'height': 652, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/01/opinion/01douthatWeb/01douthatWeb-superJumbo.jpg', 'height': 1305, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy