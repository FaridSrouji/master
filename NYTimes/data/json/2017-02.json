://article/80ace33c-a4ac-5b40-86e5-da849b7c2ea7'}, {'abstract': 'Corrections appearing in print on Saturday, February 18, 2017.', 'web_url': 'https://www.nytimes.com/2017/02/17/pageoneplus/corrections-february-18-2017.html', 'snippet': 'Corrections appearing in print on Saturday, February 18, 2017.', 'lead_paragraph': 'FRONT PAGE', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: February 18, 2017', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-02-18T02:15:49+0000', 'document_type': 'article', 'news_desk': 'Corrections', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/4be212ef-f510-58d8-b216-8c12d5dcd09b', 'word_count': 413, 'uri': 'nyt://article/4be212ef-f510-58d8-b216-8c12d5dcd09b'}, {'abstract': "The country's missile test this month gave weapons monitors a status report on the progress of North Korea's nuclear program. They said there was a significant advance.", 'web_url': 'https://www.nytimes.com/2017/02/17/world/asia/north-korea-nuclear-threat.html', 'snippet': "The country's missile test this month gave weapons monitors a status report on the progress of North Korea's nuclear program. They said there was a significant advance.", 'lead_paragraph': 'When North Korea tested a missile that fell harmlessly into the sea this month, it was more than just an attempt by its 33-year-old leader, Kim Jong-un, to jolt a new American president. Arms experts observed something new: solid-fuel technology that makes such missiles easier to hide and launch quickly. North Korea’s nuclear weapons program has progressed in four areas that bear watching: arsenal size, bomb strength, missile technology and ability to elude detection.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': 