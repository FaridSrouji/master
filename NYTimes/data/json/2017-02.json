 None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/business/26VIEW/26VIEW-jumbo.jpg', 'height': 782, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/business/26VIEW/26VIEW-superJumbo.jpg', 'height': 1563, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Economists Have Been Demoted in Washington. That’s a Bad Idea.', 'kicker': 'Economic View', 'content_kicker': None, 'print_headline': 'The Disappearing Economist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Military Bases and Installations', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-02-24T15:52:56+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'The Upshot', 'byline': {'original': 'By Sendhil Mullainathan', 'person': [{'firstname': 'Sendhil', 'middlename': None, 'lastname': 'Mullainathan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee33dcd1-03a4-5d60-a84e-e542178449d7', 'word_count': 1011, 'uri': 'nyt://article/ee33dcd1-03a4-5d60-a84e-e542178449d7'}, {'abstract': 'There is only one Patricia Kopatchinskaja. And she performs Prokofiev with the London Philharmonic Orchestra at David Geffen Hall.', 'web_url': 'https://www.nytimes.com/2017/02/24/arts/music/patricia-kopatchinskaja-violinist-david-geffen-hall.html', 'snippet': 'There is only one Patricia Kopatchinskaja. And she performs Prokofiev with the London Philharmonic Orchestra at David Geffen Hall.', 'lead_paragraph': 'Of the many excellent, polished violinists in the classical world, there is only one Patricia Kopatchinskaja. She takes the standard repertory and makes it seem vividly, sometimes harrowingly new. Take, for example, her recording of Tchaikovsky’s Violin Concerto with her fellow provocateur Teodor Currentzis and his ensemble Musica Aeterna, a raw, fearless, ferocious take on what’s often a comfortable chestnut.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE9/26GUIDE9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/26/arts/26GUIDE9/26GUIDE9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE9/26GUIDE9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE9/26GUIDE9-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/26/arts/26GUIDE9/26GUIDE9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE9/26GUIDE9-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE9/26GUIDE9-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A Fearless, Ferocious Violinist Takes New York', 'kicker': None, 'content_kicker': None, 'print_headline': 'Classical; Fearless  and Ferocious', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Geffen, David, Hall (Manhattan, NY)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kopatchinskaja, Patricia', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'London Philharmonic', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jurowski, Vladimir', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-02-24T15:54:42+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2161eb48-0222-5bc1-a144-d3eaf7b62b01', 'word_count': 137, 'uri': 'nyt://article/2161eb48-0222-5bc1-a144-d3eaf7b62b01'}, {'abstract': 'This Chicago rapper, who appeared with Chance the Rapper on “Saturday Night Live,” appears on March 2 at Le Poisson Rouge.', 'web_url': 'https://www.nytimes.com/2017/02/24/arts/music/noname-still-unsigned-but-a-presence.html', 'snippet': 'This Chicago rapper, who appeared with Chance the Rapper on “Saturday Night Live,” appears on March 2 at Le Poisson Rouge.', 'lead_paragraph': 'The Chicago rapper Noname, a disciple of spoken word and Def Poetry Jam, has nimble wordplay and a warm, unruffled voice that work even better over beats. After appearing as a guest on Chance the Rapper’s two breakthrough mixtapes, she released her own debut project, “Telefone,” as a free download last summer, blending what she has referred to as sunny Los Angeles instrumentation and grim Chicago subject matter. “Too many babies in suits,” Noname raps over the cooing of a child on “Casket Pretty,” about her city’s plague of gun violence. But there is hope in the music, too, and in her onstage demeanor, best exemplified by a “Saturday Night Live” cameo alongside Chance in December; an unsigned rapper gliding onto the national television stage, Noname gave a master class in poise, delivery and self-assuredness. (Thursday, March 2, at Le Poisson Rouge; 212-505-3474, lpr.com)', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE8/26GUIDE8-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/26/arts/26GUIDE8/26GUIDE8-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE8/26GUIDE8-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE8/26GUIDE8-articleLarge.jpg', 'height': 890, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/26/arts/26GUIDE8/26GUIDE8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 890}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE8/26GUIDE8-jumbo.jpg', 'height': 1024, 'width': 691, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE8/26GUIDE8-superJumbo.jpg', 'height': 1999, 'width': 1348, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Noname, Still Unsigned but a Presence', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pop; Still Unsigned, but a Presence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Noname (Rapper)', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-02-24T15:57:42+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Joe Coscarelli', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Coscarelli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6da06248-0f31-5a80-9c0a-d6750e031eac', 'word_count': 144, 'uri': 'nyt://article/6da06248-0f31-5a80-9c0a-d6750e031eac'}, {'abstract': 'The program, by Wendy Whelan and Brian Brooks, shows off inner feelings. With Brooklyn Rider, at the Joyce.', 'web_url': 'https://www.nytimes.com/2017/02/24/arts/dance/some-of-a-thousand-words-wendy-whelan-joyce-theater.html', 'snippet': 'The program, by Wendy Whelan and Brian Brooks, shows off inner feelings. With Brooklyn Rider, at the Joyce.', 'lead_paragraph': 'Some dance presentations of solos and duets are little more than flash and glitter. “Some of a Thousand Words,” a new program by Wendy Whelan and the choreographer and dancer Brian Brooks, is quite another matter. In 2015, Ms. Whelan, an eloquent former New York City Ballet ballerina, offered a program by several choreographers, and Mr. Brooks’s contributions attracted special attention. Now they reveal how the interactions of two dancing people — their lifts, falls, changes of weight and entangling of bodies — can reveal inner feelings as well as technical prowess. Live music will be provided by Brooklyn Rider, a quartet that champions contemporary music; composers include Philip Glass, John Luther Adams, Tyondai Braxton, Jacob Cooper and Colin Jacobsen, a violinist with the quartet. (Tuesday, Feb. 28, through March 5 at the Joyce Theater; 212-242-0800, joyce.org.)', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE7/26GUIDE7-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/26/arts/26GUIDE7/26GUIDE7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE7/26GUIDE7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE7/26GUIDE7-articleLarge.jpg', 'height': 890, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/26/arts/26GUIDE7/26GUIDE7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 890}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE7/26GUIDE7-jumbo.jpg', 'height': 1024, 'width': 691, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/arts/26GUIDE7/26GUIDE7-superJumbo.jpg', 'height': 2001, 'width': 1349, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Duets in ‘Some of a Thousand Words’ Say It All', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dance; Two People, Many Feelings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Joyce Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Whelan, Wendy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brooks, Brian', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Some of a Thousand Words (Dance)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Rider', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-02-24T15:59:43+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Jack Anderson', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Anderson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6410f979-a3da-53f2-a5b9-db2d09c0c67e', 'word_count': 137, 'uri': 'nyt://article/6410f979-a3da-53f2-a5b9-db2d09c0c67e'}, {'abstract': 'A new book aims to correct the record on Mr. Lehman, a New York Democrat who served as governor and then senator during the mid-20th century.', 'web_url': 'https://www.nytimes.com/2017/02/24/nyregion/herbert-lehman-biography.html', 'snippet': 'A new book aims to correct the record on Mr. Lehman, a New York Democrat who served as governor and then senator during the mid-20th century.', 'lead_paragraph': 'On election night 1928, after his first campaign for public office, Herbert H. Lehman and his wife left a note on their bedroom door for their children: “Don’t wake us. Daddy has been beaten, but he doesn’t feel badly.”', 'print_section': 'MB', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/26/nyregion/26BOOKSHELF1/26BOOKSHELF1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/26/nyregion/26BOOKSHELF1/26BOOKSHE