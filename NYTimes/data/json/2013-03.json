inal': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b40a171-ccbe-5e96-aa3c-da61310d7828', 'word_count': 508, 'uri': 'nyt://article/0b40a171-ccbe-5e96-aa3c-da61310d7828'}, {'abstract': 'Charts compare changes in gross domestic product and unemployment in the United States during the five years after 1929 with the changes in Greece during the five years after 2007.', 'web_url': 'https://www.nytimes.com/2013/03/16/business/economy/seen-from-greece-great-depression-data-looks-good.html', 'snippet': 'Charts compare changes in gross domestic product and unemployment in the United States during the five years after 1929 with the changes in Greece during the five years after 2007.', 'lead_paragraph': 'FIVE years into the Great Depression, one out of five workers in the United States was unemployed. The economy was nearly 20 percent smaller in 1934 than it had been at the peak, in 1929.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Seen From Greece, Great Depression Looks Good', 'kicker': 'Off the Charts', 'content_kicker': None, 'print_headline': 'Seen From Greece, Great Depression Looks Good', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recession and Depression', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Greece', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': "Great Depression (1930's)", 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Gross Domestic Product', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-15T18:07:53+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline':