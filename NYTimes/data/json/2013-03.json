HER-obit-jumbo.jpg', 'height': 1024, 'width': 985, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/24/nyregion/dog-KUTSHER-obit/dog-KUTSHER-obit-superJumbo.jpg', 'height': 1548, 'width': 1489, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/24/nyregion/dog-KUTSHER-obit/dog-KUTSHER-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/24/nyregion/dog-KUTSHER-obit/dog-KUTSHER-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/24/nyregion/dog-KUTSHER-obit/dog-KUTSHER-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Helen Kutsher, Pampering Matriarch of a Grand Borscht Belt Resort, Dies at 89', 'kicker': None, 'content_kicker': None, 'print_headline': 'Helen Kutsher, 89, Matriarch Of Grand Borscht Belt Resort', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kutsher, Helen (1923-2013)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Berger, Joseph', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': "Kutsher's Country Club", 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hotels and Travel Lodgings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Catskills (NYS Area)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-24T00:56:58+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joseph Berger', 'person': [{'fi