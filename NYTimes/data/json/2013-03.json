n/31SPOTLI_SPAN/31SPOTLI-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/31/nyregion/31SPOTLI_SPAN/31SPOTLI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/nyregion/31SPOTLI_SPAN/31SPOTLI-jumbo.jpg', 'height': 427, 'width': 640, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/nyregion/31SPOTLI_SPAN/31SPOTLI-superJumbo.jpg', 'height': 427, 'width': 640, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/nyregion/31SPOTLI_SPAN/31SPOTLI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/31/nyregion/31SPOTLI_SPAN/31SPOTLI-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/nyregion/31SPOTLI_SPAN/31SPOTLI-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Young Germans Who Stood Up to the Nazis', 'kicker': 'Spotlight | Holocaust Lecture', 'content_kicker': None, 'print_headline': 'The Young Germans Who Stood Up to the Nazis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Northport (NY)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Newborn, Jud', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Scholl, Sophie (1921-43)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-30T00:28:37+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Karin Lipson', 'person': [{'firstname': 'Karin', 'middlename': None, 'lastname': 'Lipson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5a5b4423-3fba-5951-a446-19a6249e12bc', 'word_count': 467, 'uri': 'nyt://article/5a5b4423-3fba-5951-a446-19a6249e12bc'}, {'abstract': 'In response to new federal regulations, institutions are spending millions to help patients avoid returning to the hospital, but some say that the penalties they seek to avoid are unjust.', 'web_url': 'https://www.nytimes.com/2013/03/30/business/hospitals-question-fairness-of-new-medicare-rules.html', 'snippet': 'In response to new federal regulations, institutions are spending millions to help patients avoid returning to the hospital, but some say that the penalties they seek to avoid are unjust.', 'lead_paragraph': 'It is no longer enough for hospitals to make patients healthy enough to leave. Now, as part of the Obama administration’s health care overhaul, they are spending millions of dollars to keep those patients from coming back, often acting like personal assistants to help them manage their post-hospital lives.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/business/Care/Care-articleLarge.jpg', 'height': 424, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/30/business/Care/Care-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 424}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/business/Care/Care-jumbo.jpg', 'height': 723, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank