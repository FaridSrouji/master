': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-30T02:01:19+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Corey Kilgannon', 'person': [{'firstname': 'Corey', 'middlename': None, 'lastname': 'Kilgannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5a245aee-48dd-536e-8ec8-c08846bcc7a9', 'word_count': 824, 'uri': 'nyt://article/5a245aee-48dd-536e-8ec8-c08846bcc7a9'}, {'abstract': 'It is in America’s interest that Congress ratify proposed changes to the fund.', 'web_url': 'https://www.nytimes.com/2013/03/30/opinion/strengthening-the-imf.html', 'snippet': 'It is in America’s interest that Congress ratify proposed changes to the fund.', 'lead_paragraph': 'Let’s face it: the International Monetary Fund is not widely loved. It has forced countries in financial distress to adopt counterproductive austerity policies, and it failed to anticipate the financial crisis. But in recent years the I.M.F. has helped stabilize the global economy, most recently by providing loans to troubled European countries like Greece and Ireland. That is why Congress needs to strengthen its governance and bolster its resources by ratifying reforms to the organization that were agreed to in 2010 by its 188 member countries.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Strengthening the I.M.F.', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Strengthening the I.M.F.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'International Monetary Fund', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-30T02:02:08+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/c28f885e-737f-5104-bee1-c81210f856e8', 'word_count': 401, 'uri': 'nyt://article/c28f885e-737f-5104-bee1-c81210f856e8'}, {'abstract': 'Although Sven Olaf Kamphuis says he did not orchestrate a large-scale cyberattack this week and has not been charged, he is at the heart of an international investigation.', 'web_url': 'https://www.nytimes.com/2013/03/30/business/global/after-cyberattack-sven-olaf-kamphuis-is-at-heart-of-investigation.html', 'snippet': 'Although Sven Olaf Kamphuis says he did not orchestrate a large-scale cyberattack this week and has not been charged, he is at the heart of an international investigation.', 'lead_paragraph': 'Sven Olaf Kamphuis calls himself the “minister of telecommunications and foreign affairs for the Republic of CyberBunker.” Others see him as the Prince of Spam.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/business/Cyber2/Cyber2-articleLarge.jpg', 'height': 392, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/30/business/Cyber2/Cyber2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 392}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/business/Cyber2/Cyber2-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 