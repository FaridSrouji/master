ords': [{'name': 'subject', 'value': 'Mobile Applications', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-21T04:29:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd18c314-4eee-5d75-9c22-0bb2378ef48f', 'word_count': 671, 'uri': 'nyt://article/dd18c314-4eee-5d75-9c22-0bb2378ef48f'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/03/21/arts/television/whats-on-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (13) THE TEMPEST The British composer Thomas Adès conducts the Metropolitan Opera premiere of his English-language opera based on the Shakespeare play, in a production staged by Robert Lepage. Simon Keenlyside leads the cast as the exiled magician Prospero, who in this setting imagines himself an impresario of 18th-century opera and has recreated on his island the opera house La Scala, from his hometown, Milan. Isabel Leonard plays his daughter, Miranda; Alek Shrader is the shipwrecked prince, Ferdinand; Alan Oke (above), is the monstrous island native Caliban; and Audrey Luna is the spirit Ariel. Writing in The New York Times, Anthony Tommasini called the production, presented here by “Great Performances at the Met,” “one of the most inspired, audacious and personal operas to have come along in years.” Mr. Adès, he added, “drew a textured, glittering and suspenseful account of his opera from the great Met orchestra.”', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 