 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f93df3a-fe69-5038-b4c7-437cd7257f4c', 'word_count': 803, 'uri': 'nyt://article/7f93df3a-fe69-5038-b4c7-437cd7257f4c'}, {'abstract': 'It could be years before scientists succeed in bringing species back from extinction, but they are thinking of ways to give new life to creatures like woolly mammoths and weird frogs.', 'web_url': 'https://www.nytimes.com/2013/03/19/science/earth/research-to-bring-back-extinct-frog-points-to-new-path-and-quandaries.html', 'snippet': 'It could be years before scientists succeed in bringing species back from extinction, but they are thinking of ways to give new life to creatures like woolly mammoths and weird frogs.', 'lead_paragraph': 'Until recently, the arrow of natural selection seemed to go only one way. A species could form, then it could flourish, then it could go extinct. And once it was extinct, it could not come back.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'So You’re Extinct? Scientists Have Gleam in Eye', 'kicker': None, 'content_kicker': None, 'print_headline': 'So You’re Extinct? Scientists Have Gleam in Eye', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kolata, Gina', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Endangered and Extinct Species', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cloning', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Genetic Engineering', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'DNA (Deoxyribonucleic Acid)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Woolly Mammoths', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-19T03:55:00+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Gina Kolata', 'person': [{'firstname': 'Gina', 'middlename': None, 'l