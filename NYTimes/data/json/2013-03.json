nk': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03aa11fb-0893-5bde-bf9a-a9a0a13ff199', 'word_count': 1303, 'uri': 'nyt://article/03aa11fb-0893-5bde-bf9a-a9a0a13ff199'}, {'abstract': 'In a carefully crafted speech that was enthusiastically welcomed by a youthful audience of Israelis, President Obama advocated a vision of a future Israel at peace with the Palestinians.', 'web_url': 'https://www.nytimes.com/2013/03/22/world/middleeast/obama-lays-out-case-for-israel-to-revive-peace-talks.html', 'snippet': 'In a carefully crafted speech that was enthusiastically welcomed by a youthful audience of Israelis, President Obama advocated a vision of a future Israel at peace with the Palestinians.', 'lead_paragraph': 'Laying out his case for a future Israel at peace with the Palestinians, President Obama delivered an enthusiastically welcomed speech on Thursday before an audience of youthful Israelis in Jerusalem, assuring them of America’s strong support but asking them to empathize with their Israeli-occupied neighbors and “look at the world through their eyes.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama Lays Out Case for Israel to Revive Peace Talks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obama Lays Out Case for Israel to Revive Peace Talks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Palestinians', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-21T16:44:16+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Rick Gladstone', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Gladstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08f62a03-1736-577a-8ad8-79e1ad2a9872', 'word_count': 934, 'uri': 'nyt://article/08f62a03-1736-577a-8ad8-79e1ad2a9872'}, {'abstract': 'Chris Paul of the Los Angeles Clippers is the rarest of stars: he makes a massive contribution to his team while being one of the N.B.A.’s most efficient players.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2013/03/21/keeping-score-the-clippers-game-changer/', 'snippet': 'Chris Paul of the Los Angeles Clippers is the rarest of stars: he makes a massive contribution to his team while being one of the N.B.A.’s most efficient players.', 'lead_paragraph': 'LeBron James and Kevin Durant have received a lot of attention this season, and deservedly so. James and Durant are the two best players in the N.B.A., but there should be room in the spotlight for a player who is not too far behind: Chris Paul of the Los Angeles Clippers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Keeping Score: The Clippers’ Game Changer', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Chris', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Clippers', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-21T16:51:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Justin Kubatko', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Kubatko', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8284a6ca-8805-5a47-ade7-8683eb4a6923', 'word_count': 545, 'uri': 'nyt://article/8284a6ca-8805-5a47-ade7-8683eb4a6923'}, {'abstract': 'For months, the Obama administration has promised to create a more lasting legal framework for its drone program, but the only proposal to surface so far may have little short-term effect.', 'web_url': 'https://www.nytimes.com/2013/03/22/us/influential-ex-aide-to-obama-voices-concern-on-drone-strikes.html', 'snippet': 'For months, the Obama administration has promised to create a more lasting legal framework for its drone program, but the only proposal to surface so far may have little short-term effect.', 'lead_paragraph': 'CHICAGO — Under growing pressure to bring greater transparency and accountability to its use of targeted killing, the Obama administration is struggling to transform a program that was conceived under pressure, has operated in a secretive and often haphazard manner and has left the United States increasingly isolated even from its allies. ', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/world/0322DRONES/0322DRONES-articleLarge.jpg', 'height': 474, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/22/world/0322DRONES/0322DRONES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 474}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/world/0322DRONES/0322DRONES-jumbo.jpg', 'height': 808, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/world/0322DRONES/0322DRONES-superJumbo.jpg', 'height': 1617, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/world/0322DRONES/0322DRONES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/22/world/0322DRONES/0322DRONES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/world/0322DRONES/0322DRONES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As New Drone Policy Is Weighed, Few Practical Effects Are Seen', 'kicker': None, 'content_kicker': None, 'print_headline': 'As New Drone Policy Is Weighed, Few Practical Effects Are Seen', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mazzetti, Mark', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Targeted Killings', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cartwright, James E', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Special Operations Command', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Brennan, John O', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-03-21T16:53:18+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'U.S.', 'byline': {'original': 'By Mark Mazzetti and Scott Shane', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Mazzetti', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Scott', 'middlename': None, 'lastname': 'Shane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b2434ec5-1969-5e83-9cf9-f146673a7569', 'word_count': 1173, 'uri': 'nyt://article/b2434ec5-1969-5e83-9cf9-f146673a7569'}, {'abstract': 'The role of a general manager evolves dramatically in the first few years; unfortunately, only about half of our G.M.’s survive the transition.', 'web_url': 'https://boss.blogs.nytimes.com/2013/03/21/the-risks-of-expanding-into-australia-part-2/', 'snippet': 'The role of a general manager evolves dramatically in the first few years; unfortunately, only about half of our G.M.’s survive the transition.', 'lead_paragraph': 'In my last post, I wrote about our plans to open our 22nd foreign office in Australia. We have checked the very important first few boxes in our process to conduct a successful foreign-office opening with limited risk and investment — including finding a general manager, Anna Minns, who will start drawing a salary as soon as we start invoicing. Most important, we have a few partnership deals that are close to closing.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Risks of Expanding Into Australia, Part 2', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hiring and Promotion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recycling of Waste Materials', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'TerraCycle', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-21T17:00:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Tom Szaky', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Szaky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2fca04d3-39ff-56c7-8dba-e79bf27edd6f', 'word_count': 775, 'uri': 'nyt://article/2fca04d3-39ff-56c7-8dba-e79bf27edd6f'}, {'abstract': 'The Hertz Corporation recently expanded its Supercar rental offerings in Europe.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/03/21/the-red-one-next-to-the-fiat/', 'snippet': 'The Hertz Corporation recently expanded its Supercar rental offerings in Europe.', 'lead_paragraph': 'The Hertz Corporation recently expanded its Supercar rental offerings in Europe, increasing the number of cars and models available in Britain and Spain, and adding Italy, France and (beginning in April) the Netherlands, to the countries where the premium cars can be rented. Renters can now choose brands including McLaren, Lamborghini (shown) and Aston Martin. What European financial crisis?', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Red One, Next to the Fiat', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': 'Rental Cars: The Red One, Next to the Fiat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hertz Global Holdings Inc', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-21T17:00:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Tanya Mohn', 'person': [{'firstname': 'Tanya', 'middlename': None, 'lastname': 'Mohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be89ee37-954b-586d-85a3-7b49b4fb9590', 'word_count': 59, 'uri': 'nyt://article/be89ee37-954b-586d-85a3-7b49b4fb9590'}, {'abstract': 'Plays written and directed by women make up a significant share of the Off Broadway company’s 2013-14 season.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/21/playwrights-horizons-season-to-range-from-simpsons-to-kama-sutra/', 'snippet': 'Plays written and directed by women make up a significant share of the Off Broadway company’s 2013-14 season.', 'lead_paragraph': 'Playwrights Horizons is once again putting women front and center in the company’s 2013-2014 season, staging four plays by women, including two world premieres. Three of the first five plays the Off Broadway company announced on Thursday will also be directed by women.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Playwrights Horizons Season To Range From Simpsons to Kama Sutra', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cosson, Steven', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'George, Madeleine', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kauffman, Anne', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Meyer, Marlane', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mitnick, Michael', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Peterson, Lisa', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Rosenstock, Kim', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Silverman, Leigh', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Washburn, Anne', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Playwrights Horizons', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Woolly Mammoth Theater Company', 'rank': 12, 'major': 'N'}], 'pub_date': '2013-03-21T17:10:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James McKinley, Jr', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef2f5bcb-1c24-5173-a825-d6c3c7c26169', 'word_count': 337, 'uri': 'nyt://article/ef2f5bcb-1c24-5173-a825-d6c3c7c26169'}, {'abstract': 'The National Gallery’s new exhibition of works by Albrecht Dürer covers his career from beginning to end.', 'web_url': 'https://www.nytimes.com/2013/03/22/arts/design/albrecht-durer-master-drawings-watercolors-and-prints-at-the-national-gallery.html', 'snippet': 'The National Gallery’s new exhibition of works by Albrecht Dürer covers his career from beginning to end.', 'lead_paragraph': 'WASHINGTON — Albrecht Dürer had it all: the eye of a Raphael, the brains of a Leonardo, the looks of a cleaned-up Kurt Cobain. He produced the earliest known self-portrait drawing in European art when he was 13, and some of the first stand-alone landscapes. He brought the pliant warmth of Italian Classical painting to the shivery Gothic north, and transformed the woodcut medium from semi-folk art to fine art, and very fine art indeed.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22DURER/22DURER-articleLarge.jpg', 'height': 889, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/22/arts/22DURER/22DURER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 889}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22DURER/22DURER-jumbo.jpg', 'height': 1024, 'width': 691, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22DURER/22DURER-superJumbo.jpg', 'height': 2048, 'width': 1382, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22DURER/22DURER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/22/arts/22DURER/22DURER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22DURER/22DURER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Renaissance Followed Him North', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'The Renaissance Followed Him North', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cotter, Holland', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Durer, Albrecht', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Gallery of Art', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-21T17:12:17+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6c17d774-a522-5a89-9033-a900a50bd9bf', 'word_count': 1486, 'uri': 'nyt://article/6c17d774-a522-5a89-9033-a900a50bd9bf'}, {'abstract': 'Graham Rahal of the Rahal Letterman Lanigan racing team takes a turn presenting the Top 10 List on “The Late Show.”', 'web_url': 'https://wheels.blogs.nytimes.com/2013/03/21/wheelies-the-top-10-li