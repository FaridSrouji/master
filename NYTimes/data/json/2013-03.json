e': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/007a0afb-bc13-5501-abc9-9e21c7ba499c', 'word_count': 808, 'uri': 'nyt://article/007a0afb-bc13-5501-abc9-9e21c7ba499c'}, {'abstract': 'Widespread anecdotal evidence suggests that children are suffering as parents live the hard life in China’s cities.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2013/03/06/city-life-takes-a-toll-on-chinas-children/', 'snippet': 'Widespread anecdotal evidence suggests that children are suffering as parents live the hard life in China’s cities.', 'lead_paragraph': 'BEIJING — Life in China isn’t cheap any more, despite its reputation as a low-cost center. While many families have prospered from economic liberalization, others struggle to get by. And that includes many considered to be doing fairly well. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'City Life Takes a Toll on China’s Children', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Beijing (China)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-06T17:14:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Didi Kirsten Tatlow', 'person': [{'firstname': 'Didi', 'middlename': 'Kirsten', 'lastname': 'Tatlow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/51892631-c071-5791-bbda-c03749b46aea', 'word_count': 367, 'uri': 'nyt://article/51892631-c071-5791-bbda-c03749b46aea'}, {'abstract': 'Is it legal for the president to authorize lethal force against a citizen on American soil?', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/03/06/targeted-killing-in-the-u-s-a/', 'snippet': 'Is it legal for the president to authorize lethal force against a citizen on American soil?', 'lead_paragraph': 'The Obama administration finally answered a simple question today: Does the president think he has the power to authorize lethal force, such as a drone strike, against an American citizen, in the United States, without trial.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Targeted Killing in the U.S.A.', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Targeted Killings', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Holder, Eric H Jr', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Rand', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-06T17:24:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/71e56275-6946-5e7c-8e56-4f0a1575dc88', 'word_count': 448, 'uri': 'nyt://article/71e56275-6946-5e7c-8e56-4f0a1575dc88'}, {'abstract': 'Amazon’s production arm said Wednesday that it had ordered a children’s pilot called “Sara Solves It,” which was co-developed by WGBH in Boston and Out of the Blue Enterprises.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2013/03/06/wgbh-to-partner-on-childrens-pilot-for-amazon/', 'snippet': 'Amazon’s production arm said Wednesday that it had ordered a children’s pilot called “Sara Solves It,” which was co-developed by WGBH in Boston and Out of the Blue Enterprises.', 'lead_paragraph': 'One of the biggest suppliers of programming for PBS, WGBH, is the latest to climb aboard Amazon’s television pilot process.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'WGBH to Partner on Children’s Pilot for Amazon', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'DreamWorks Animation SKG Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Nickelodeon', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Out of the Blue Enterprises', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'WGBH', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Boston (Mass)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-06T17:26:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f2faf23b-5db6-589d-9ff6-4aee4ef21c8a', 'word_count': 319, 'uri': 'nyt://article/f2faf23b-5db6-589d-9ff6-4aee4ef21c8a'}, {'abstract': 'The new Dyson AM05 bladeless fan and heater has an unusual redesigned impeller that moves more air.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2013/03/06/dysons-bladeless-fan-a-little-cooler/', 'snippet': 'The new Dyson AM05 bladeless fan and heater has an unusual redesigned impeller that moves more air.', 'lead_paragraph': 'The Dyson AM05 bladeless fan and heater is much cooler than its predecessor. Its new motor spins 33 percent faster, moving more air, hence: cooler.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/technology/05gw-fan/05gw-fan-articleLarge.jpg', 'height': 1252, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/05/technology/05gw-fan/05gw-fan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1252}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/technology/05gw-fan/05gw-fan-jumbo.jpg', 'height': 1024, 'width': 491, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/technology/05gw-fan/05gw-fan-superJumbo.jpg', 'height': 2048, 'width': 982, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/technology/05gw-fan/05gw-fan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/05/technology/05gw-fan/05gw-fan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/technology/05gw-fan/05gw-fan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dyson’s Bladeless Fan: A Little Cooler', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': 'It Heats and Cools, and Does It With 33% More Air Power', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-06T17:28:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Roy Furchgott', 'person': [{'firstname': 'Roy', 'middlename': None, 'lastname': 'Furchgott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d0eee064-fdbe-52ed-82af-7eec24a737c0', 'word_count': 351, 'uri': 'nyt://article/d0eee064-fdbe-52ed-82af-7eec24a737c0'}, {'abstract': 'The travel blogger known as Nomadic Matt offers tips on setting a daily travel budget, choosing the right credit cards and avoiding transaction fees abroad.', 'web_url': 'https://www.nytimes.com/2013/03/10/travel/as-you-travel-making-money-work-for-you.html', 'snippet': 'The travel blogger known as Nomadic Matt offers tips on setting a daily travel budget, choosing the right credit cards and avoiding transaction fees abroad.', 'lead_paragraph': 'When the travel blogger Matt Kepnes, a k a Nomadic Matt, set off on a six-and-a-half-year backpacking trip that would take him to a staggering 70 countries, the relative merits of his bank account and credit card were an afterthought, he said. Two years into his journey, he realized he was needlessly racking up bank fees and missing out on free flights, so he sat down and figured out how to manage his personal finances abroad. These tips and others he shares in his new book, “How to Travel the World on $50 a Day: Travel Cheaper, Longer, Smarter.” Below are edited excerpts from a conversation with Mr. Kepnes on which bank accounts and credit cards help you stick to your budget.\xa0', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/10/travel/10QNA/10QNA-articleLarge.jpg', 'height': 403, 'width': 600, 'subType'