rge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Haider Ackermann: Fall 2013 RTW', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-02T12:10:19+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'subsection_name': "Women's Runway", 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/83d2d939-b9ab-5101-91fb-df63003d4a56', 'word_count': 0, 'uri': 'nyt://slideshow/83d2d939-b9ab-5101-91fb-df63003d4a56'}, {'abstract': 'Junya Watanabe gave his customers a nice bunch of clothes along a familiar story line. Haider Ackerman’s show began in a fog.', 'web_url': 'https://runway.blogs.nytimes.com/2013/03/02/piece-goods-and-misty-irreverence/', 'snippet': 'Junya Watanabe gave his customers a nice bunch of clothes along a familiar story line. Haider Ackerman’s show began in a fog.', 'lead_paragraph': 'PARIS — Junya Watanabe’s shows are always held on Saturday morning, prompting the usual sullen greeting, “Hello, and where’s the coffee?” Mr. Watanabe provides. He also gave his customers a nice bunch of clothes along familiar Watanabe story lines. These included couture-shaped dresses and loose-back jackets that combined leather and tweed, motorcycle jackets mixed with knitting, and cute, low-riding patchwork jeans. Among the fresher looks were skimmy dresses made from oblong scraps of plaid wool and silk, and worn over black tights.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Piece Goods and Misty Irreverence', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-02T13:43:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Cathy Horyn', 'person': [{'firstname': 'Cathy', 'middlename': None, 'lastname': 'Horyn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe3d9423-d761-5946-8068-86f1f93e8c90', 'word_count': 268, 'uri': 'nyt://article/fe3d9423-d761-5946-8068-86f1f93e8c90'}, {'abstract': 'A day in the life of armed America.', 'web_url': 'https://nocera.blogs.nytimes.com/2013/03/02/the-gun-report-march-2-2013/', 'snippet': 'A day in the life of armed America.', 'lead_paragraph': 'March 1 marked the 19th anniversary of the shooting death of Ari Halberstam, a 16-year-old Brooklyn Yeshiva student, who was traveling by van on the Brooklyn Bridge with his fellow students when an anti-Semite who’d been following them fired 18 bullets into the van, using a Cobray submachine gun and a Glock. Halberstam was killed. The gunman, Rashid Baz, admitted last year that he targeted the boys because they were Jews. The FBI classified the act as terrorism.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Gun Report: March 2, 2013', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Flushing (Queens, NY)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Louisiana', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Montana', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Philadelphia (Pa)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Wasilla (Alaska)', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Yonkers (NY)', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-03-02T14:00:07+0000', 'document_type': 'article', 'news_desk': '', 'sectio