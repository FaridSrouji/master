': 'images/2013/03/09/blogs/dothudsonjack/dothudsonjack-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/blogs/dothudsonjack/dothudsonjack-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/blogs/dothudsonjack/dothudsonjack-superJumbo.jpg', 'height': 1329, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/blogs/dothudsonjack/dothudsonjack-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/09/blogs/dothudsonjack/dothudsonjack-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/blogs/dothudsonjack/dothudsonjack-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Billion Years of Time and Toil Are Etched in These Old Hills', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Folk Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Geology', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'History (Academic Subject)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Maple Syrup and Sugar', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Revkin, Andrew C', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Hudson River', 'rank': 7, 'major': 'N'}, {'na