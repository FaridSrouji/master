jor': 'N'}, {'name': 'persons', 'value': 'Mount, Anson', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-01T23:05:37+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fb842290-4327-509c-8775-86d95553f537', 'word_count': 603, 'uri': 'nyt://article/fb842290-4327-509c-8775-86d95553f537'}, {'abstract': 'Ravi Coltrane is playing with three different sets of musicians in his run at the Jazz Standard, celebrating his new release, “Spirit Fiction.”', 'web_url': 'https://www.nytimes.com/2013/03/02/arts/music/ravi-coltrane-quartet-at-jazz-standard.html', 'snippet': 'Ravi Coltrane is playing with three different sets of musicians in his run at the Jazz Standard, celebrating his new release, “Spirit Fiction.”', 'lead_paragraph': 'In the saxophonist Ravi Coltrane’s new album, “Spirit Fiction” (Blue Note), he works with two different groups, destabilizing the idea that he has a current group sound, or maybe enlarging it. In his Jazz Standard run he’s pushing the idea further, playing with three different bands over the course of a six-day week. The third one, playing this weekend, is as close as it gets to his latest going concern. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/02/arts/sub-02RAVI/sub-02RAVI-articleLarge.jpg', 'height': 376, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/02/arts/sub-02RAVI/sub-02RAVI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 376}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type