mage', 'url': 'images/2013/03/20/books/20childrens-1/20childrens-1-jumbo.jpg', 'height': 564, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/books/20childrens-1/20childrens-1-superJumbo.jpg', 'height': 1127, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/books/20childrens-1/20childrens-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/20/books/20childrens-1/20childrens-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/books/20childrens-1/20childrens-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘The Rite of Spring’', 'kicker': "Children's Books", 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Stringer, Lauren', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-20T14:30:13+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Pamela Paul', 'person': [{'firstname': 'Pamela', 'middlename': None, 'lastname': 'Paul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/23232cc3-f012-5bbb-834a-e5a5e8b8d720', 'word_count': 534, 'uri': 'nyt://article/23232cc3-f012-5bbb-834a-e5a5e8b8d720'}, {'abstract': 'A day in the life of armed America.', 'web_url': 'https://nocera.blogs.nytimes.com/2013/03/20/the-gun-report-march-20-2013/', 'snippet': 'A day in the life of armed America.', 'lead_paragraph': 'What if there were a technology that insured that only the person who owned a gun could shoot it?\xa0No child who stumbled across the gun could accidentally shoot his brother.\xa0No one could make use of a stolen gun.\xa0No one could buy a gun on someone else’s behalf because it wouldn’t work for anyone but the buyer.\xa0Such a technology would not eliminate gun violence, of course, but it certainly would decrease it.\xa0It would greatly diminish, and perhaps even eliminate, fatal accidents involving children finding guns in their homes, which I find the most wrenching stories to read in The Gun Report.\xa0Such a technology, it turns out, does exist.\xa0I plan to write about it soon.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Gun Report: March 20, 2013', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-20T14:30:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Joe Nocera', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Nocera', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d2f69d28-55c9-5854-b6f5-12257caf9e83', 'word_count': 763, 'uri': 'nyt://article/d2f69d28-55c9-5854-b6f5-12257caf9e83'}, {'abstract': 'Metropolitan Diary: The pianist’s recent death prompted a boyhood recollection of parental admonishments: “Why can’t you be more like …?”', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/03/20/van-cliburn-my-nemesis/', 'snippet': 'Metropolitan Diary: The pianist’s recent death prompted a boyhood recollection of parental admonishments: “Why can’t you be more like …?”', 'lead_paragraph': 'Dear Diary:', 'source': 