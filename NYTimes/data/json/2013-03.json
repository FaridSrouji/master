DV-articleLarge.jpg', 'height': 628, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/26/world/asia/26PengRDV/26PengRDV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 628}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/26/world/asia/26PengRDV/26PengRDV-jumbo.jpg', 'height': 1024, 'width': 979, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/26/world/asia/26PengRDV/26PengRDV-superJumbo.jpg', 'height': 2048, 'width': 1957, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/26/world/asia/26PengRDV/26PengRDV-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/26/world/asia/26PengRDV/26PengRDV-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/26/world/asia/26PengRDV/26PengRDV-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'China’s New-Style First Lady and Old-Style Fears', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-26T13:16:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Didi Kirsten Tatlow', 'person': [{'firstname': 'Didi', 'middlename': 'Kirsten', 'lastname': 'Tatlow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3dc99cf8-1588-5616-aca5-785f8d2de0c2', 'word_count': 386, 'uri': 'nyt://article/3dc99cf8-1588-5616-aca5-785f8d2de0c2'}, {'abstract': 'The important question is not whether Israel does want peace but just how much it does.', 'web_url': 'https://www.nytimes.com/2013/03/26/opinion/global/the-mideast-peace-gap.html', 'snippet': 'The important question is not whether Israel does want peace but just how much it does.', 'lead_paragraph': 'Regarding “Bits, bytes and bombs” (Views, March 25): Thomas L. Friedman aptly criticizes Israel’s dream of permanent occupation of the West Bank — especially now with extreme annexationists in the cabinet. Of course not all Israelis have this dream, but many do, and many more wish for more continued settlement expansion beyond today’s 320,000 settlers. What is hard to square with either of these wishes is the other wish that Israel claims to have — for peace. Doubtless Israel does want peace. The important question is not whether Israel does want peace — for who doesn’t — but just how much it does.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Mideast Peace Gap', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Israeli Settlements', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'West Bank', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-26T13:22:50+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'subsection_name': 'Global Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/330e9c26-dd24-5d12-afc3-d4f3268202c1', 'word_count': 170, 'uri': 'nyt://article/330e9c26-dd24-5d12-afc3-d4f3268202c1'}, {'abstract': 'The inquiry, which has already ensnared major international giants like Barclays, JPMorgan Chase and Deutsche Bank, has been broadened to include the International Swaps and Derivatives Association, a trade organization for market participants.', 'web_url': 'https://dealbook.nytimes.com/2013/03/26/europe-expands-investigation-into-derivatives-market/', 'snippet': 'The inquiry, which has already ensnared major international giants like Barclays, JPMorgan Chase and Deutsche Bank, has been broadened to include the International Swaps and Derivatives Association, a trade organization for market participants.', 'lead_paragraph': 'BRUSSELS — European Union antitrust regulators have expanded their investigation into whether a small network of big banks unfairly controls the derivatives market.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Europe Expands Investigation Into Derivatives Market', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Derivatives (Financial Instruments)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'International Swaps and Derivatives Assn', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-26T13:32:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By James Kanter', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Kanter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/22533d39-962a-523c-97c3-8bb0fa4c8254', 'word_count': 400, 'uri': 'nyt://article/22533d39-962a-523c-97c3-8bb0fa4c8254'}, {'abstract': 'Most Web browsers let you save user names and passwords for frequently visited sites, but this information can be deleted.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2013/03/26/qa-erasing-saved-web-site-passwords/', 'snippet': 'Most Web browsers let you save user names and passwords for frequently visited sites, but this information can be deleted.', 'lead_paragraph': 'March 29, 2013, 4:03 p.m. | Updated  Added alternate ways to reach the Settings screen on Chrome for the Macintosh in response to reader questions. ', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Q&A: Erasing Saved Web Site Passwords', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': 'Erasing Passwords Saved in a Browser', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chrome (Browser)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Web Browsers', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Mozilla Foundation', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-26T13:45:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By J.d. Biersdorfer', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/152dbc45-b522-5133-8477-c82824243628', 'word_count': 389, 'uri': 'nyt://article/152dbc45-b522-5133-8477-c82824243628'}, {'abstract': 'Beckham’s Web site now offers e-commerce for her Victoria, Victoria Beckham label and a new collection created exclusively for online shoppers.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/03/26/site-to-be-seen-victoria-beckham/', 'snippet': 'Beckham’s Web site now offers e-commerce for her Victoria, Victoria Beckham label and a new collection created exclusively for online shoppers.', 'lead_paragraph': 'Victoria Beckham, whose eponymous fashion line was heretofore available exclusively at specialty retailers including Bergdorf Goodman, Neiman Marcus and FortyFiveTen and online powerhouses Net-A-Porter and MyTheresa, is now offering e-commerce for her Victoria, Victoria Beckham label and accessories like handbags, denim and eyewear. “It’s all about modern luxury, and the ability to shop online and have anything delivered to your door is very much a modern convenience,” says Beckham. Although her mainline collection is not currently available on the site, a new collection called ICON, which Beckham created exclusively for online shoppers, will feature a selection of her iconic dresses.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Site to Be Seen | Victoria Beckham', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'E-Commerce', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Beckham, Victoria', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-26T13:46:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/48d13abf-de8b-5edd-8c2d-3d7f7668d954', 'word_count': 232, 'uri': 'nyt://article/48d13abf-de8b-5edd-8c2d-3d7f7668d954'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/03/26/what-were-reading-657/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'Mother Jones: As long as moms and dads are getting worked up over the yellow dyes in Kraft Macaroni and Cheese, they might want to look at the product’s other ingredients. The authors here found them not that different from the stuff in Cheez-Its – which use natural coloring. — Patrick Farrell', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-26T13:47:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/632b8491-e83d-5769-8d73-3c8fcbcd420b', 'word_count': 395, 'uri': 'nyt://article/632b8491-e83d-5769-8d73-3c8fcbcd420b'}, {'abstract': 'Circle your calendar: March 2, 2014, will be Oscar night.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/26/oscar-dates-set-for-next-year-and-2015/', 'snippet': 'Circle your calendar: March 2, 2014, will be Oscar night.', 'lead_paragraph': 'LOS ANGELES — The Oscars will be held on March 2 next year, slightly later than this year’s Feb. 24 date, and on Feb. 22 in 2015, the Academy of Motion Picture Arts and Sciences said. The date for next year is the first Sunday after the end of the Winter Olympics in Sochi, Russia. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Oscar Dates Set for Next Year and 2015', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Oscar Dates Announced', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Hollywood (Calif)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-26T13:51:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62384494-8240-52be-b9d6-14510c069f38', 'word_count': 126, 'uri': 'nyt://article/62384494-8240-52be-b9d6-14510c069f38'}, {'abstract': 'Golf fans do not love the underdog the way college basketball fans do, and they really love it when Tiger Woods is winning.', 'web_url': 'https://www.nytimes.com/2013/03/27/sports/return-of-woods-to-no-1-soothes-golf-leading-off.html', 'snippet': 'Golf fans do not love the underdog the way college basketball fans do, and they really love it when Tiger Woods is winning.', 'lead_paragraph': 'For the traditionalists who had a tough weekend, the status quo fought back for you Monday. There were a lot of people rattled by the rise of Florida Gulf Coast and La Salle and Wichita State — you could spot them staring balefully at brackets dominated by colleges they had actually heard of — but their world grew a little brighter Monday. That is because Tiger Woods showed he could dominate golf again, returning to No. 1 after a long climb from his ignominious fall. This comforted people, unlikeable as he has become. If you cannot count on Woods scowling his way around postcard-pretty golf courses and collecting gobs of money, what can you count on in this world?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'capti