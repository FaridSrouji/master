': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Harpers Ferry, Redux', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, John (1800-59)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Higginson, Thomas Wentworth', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Jacksonville (Fla)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-06T16:42:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ethan J. Kytle', 'person': [{'firstname': 'Ethan', 'middlename': 'J.', 'lastname': 'Kytle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a4601ab4-fb68-59f7-9fac-c30dd29d1bb4', 'word_count': 2337, 'uri': 'nyt://article/a4601ab4-fb68-59f7-9fac-c30dd29d1bb4'}, {'abstract': 'Paris', 'web_url': 'https://www.nytimes.com/slideshow/2013/03/06/fashion/runway-womens/miu-miu-fall-2013-rtw.html', 'snippet': 'Paris', 'lead_paragraph': 'Paris', 'source': 