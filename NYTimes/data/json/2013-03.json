_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/arts/card/card-jumbo.jpg', 'height': 329, 'width': 190, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/arts/card/card-superJumbo.jpg', 'height': 329, 'width': 190, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/arts/card/card-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/20/arts/card/card-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/arts/card/card-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Spring North American Championships', 'kicker': 'Bridge', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cards and Card Games', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bridge (Card Game)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-20T22:21:30+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Crosswords & Games', 'subsection_name': 'Bridge', 'byline': {'original': 'By Phillip Alder', 'person': [{'firstname': 'Phillip', 'middlename': None, 'lastname': 'Alder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1eb9b02c-e686-541f-a104-01e0934ae001', 'word_count': 334, 'uri': 'nyt://article/1eb9b