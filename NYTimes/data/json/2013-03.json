ef'}, {'abstract': 'Major League Baseball barred the minor leaguer Cesar Carrillo for 100 games amid its investigation of Biogenesis, a South Florida clinic.', 'web_url': 'https://www.nytimes.com/2013/03/16/sports/baseball/pitcher-said-to-be-barred-in-clinic-case.html', 'snippet': 'Major League Baseball barred the minor leaguer Cesar Carrillo for 100 games amid its investigation of Biogenesis, a South Florida clinic.', 'lead_paragraph': 'WASHINGTON — Major League Baseball suspended the journeyman minor league pitcher Cesar Carrillo on Friday, in the first instance of discipline linked to a South Florida anti-aging clinic. The clinic is under investigation for reportedly providing players with performance-enhancing drugs.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pitcher Is Said to Be Suspended for Ties to Anti-Aging Clinic', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pitcher Barred\r\nFor 100 Games', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Carillo, Cesar', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schmidt, Michael S', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Biogenesis of America LLC', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Suspensions, Dismissals and Resignations', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Steroids', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Human Growth Hormone', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Testosterone', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-03-16T02:02:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Michael S. Schmidt', 'person': [{'firstname': 'Michael', 'middlename':