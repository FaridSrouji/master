jp/y-miss-jp-superJumbo.jpg', 'height': 1212, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/sports/y-miss-jp/y-miss-jp-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/23/sports/y-miss-jp/y-miss-jp-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/sports/y-miss-jp/y-miss-jp-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Opening With a Clang, a Rebel Recovers', 'kicker': 'West Region: No. 12 Mississippi 57, No. 5 Wisconsin 46', 'content_kicker': None, 'print_headline': 'Opening With a Clang, a Rebel Recovers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Borzi, Pat', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball (College)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'NCAA Basketball Championships (Men)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Mississippi', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Wisconsin-Madison', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Henderson, Marshall', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-23T00:46:41+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Basketball', 'byline': {'original': 'By Pat Borzi', 'person': [{'firstname': 'Pat', 'middlename': None, 'lastname': 'Borzi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/37bf9a6c-1b1e-5e0f-9e82-8e8f43e4f347', 'word_count': 833, 'uri': 'nyt://article/37bf9a6c-1b1e-5e0f-9e82-8e8f43e4f347'}, {'abstract': 'Dozens of people were injured Friday when thousands of supporters and opponents of the ruling Muslim Brotherhood clashed outside the group’s Cairo headquarters.', 'web_url': 'https://www.nytimes.com/2013/03/23/world/middleeast/egypt-dozens-injured-in-protests.html', 'snippet': 'Dozens of people were injured Friday when thousands of supporters and opponents of the ruling Muslim Brotherhood clashed outside the group’s Cairo headquarters.', 'lead_paragraph': ' Dozens of people were injured Friday when thousands of supporters and opponents of the ruling Muslim Brotherhood clashed outside the group’s Cairo headquarters, many of them armed with weapons like meat cleavers, cattle prods and pistols. The police fired tear gas as protesters tried to approach the headquarters. Anti-Brotherhood protesters also attacked the offices of the Freedom and Justice Party, the Brotherhood’s political wing, in Alexandria and Mahalla, according to local reports. The confrontations in Cairo were among the most violent between Brotherhood supporters and opponents since deadly clashes outside the presidential palace in December. For months, opposition groups and protesters have called on President Mohamed Morsi, above, a former Brotherhood leader, to make political concessions, including replacing his cabinet with a national unity government. Mr. Morsi has resisted those calls, deepening Egypt’s political stalemate. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/world/0323BRIEF/0323BRIEF-articleLarge.jpg', 'height': 847, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/23/world/0323BRIEF/0323BRIEF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 847}}, {'rank': 0, 'subtype': 'jumbo