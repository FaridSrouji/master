Type': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/AUBURNrefer/AUBURNrefer-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/21/sports/AUBURNrefer/AUBURNrefer-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/AUBURNrefer/AUBURNrefer-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Now a Coach, Drew Aims to Take Valparaiso on Another N.C.A.A. Run', 'kicker': None, 'content_kicker': None, 'print_headline': 'Now a Coach, Drew Aims to Take Valparaiso on Another N.C.A.A. Run', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'NCAA Basketball Championships (Men)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball (College)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Drew, Bryce', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Valparaiso University', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Drew, Homer', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-21T00:17:01+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Basketball', 'byline': {'original': 'By Tim Rohan', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Rohan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21664aa3-d549-59df-a86f-b2fd213fb9cf', 'word_count': 835, 'uri': 'nyt://article/21664aa3-d549-59df-a86f-b2fd213fb9cf'}, {'abstract': 'John Pedicone, the superintendent of the Tucson Unified School District, which has been shaken by a dispute over its Mexican-American studies program, announced his resignation on Wednesday.', 'web_url': 'https://www.nytimes.com/2013/03/21/education/arizona-tucson-schools-chief-resigns.html', 'snippet': 'John Pedicone, the superintendent of the Tucson Unified School District, which has been shaken by a dispute over its Mexican-American studies program, announced his resignation on Wednesday.', 'lead_paragraph': 'The superintendent of the Tucson Unified School District, which has been shaken by a dispute over its Mexican-American studies program, announced his resignation on Wednesday. The superintendent, John Pedicone, is leaving on June 30, a year before his contract ends. Mr. Pedicone, the district’s fifth superintendent in 10 years, said the departure would allow the district’s governing board to choose a replacement in a nonelection year. Internal disagreements over the way the district handled the state’s targeting of its Mexican-American studies program, banned by legislation that said it fostered hatred against white people, pushed other educational efforts off course, he said. The district eliminated the program last year under financial threat from the state, but it must now create “culturally relevant” courses as part of an agreement to lift a federal desegregation order. ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Arizona: Tucson Schools Chief Resigns', 'kicker': 'National Briefing | Southwest', 'content_kicker': None, 'print_headline': 'Arizona: Tucson Schools Chief Resigns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Suspensions, Dismissals and Resignations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Tucson (Ariz)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ARIZONA', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mexican-Americans', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-21T00:19:17+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Education', 'byline': {'original': 'By Sarah Garrecht Gassen', 'person': [{'firstname': 'Sarah', 'middlename': 'Garrecht', 'lastname': 'Gassen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/f425acf6-bee9-599c-8bdd-9f035a9c3b51', 'word_count': 133, 'uri': 'nyt://article/f425acf6-bee9-599c-8bdd-9f035a9c3b51'}, {'abstract': 'The Mets’ David Wright was prescribed five days of rest and treatment Friday because of a strained intercostal muscle in his left rib cage. He still cannot do much more than rest.', 'web_url': 'https://bats.blogs.nytimes.com/2013/03/20/wright-still-has-sights-set-on-opening-day/', 'snippet': 'The Mets’ David Wright was prescribed five days of rest and treatment Friday because of a strained intercostal muscle in his left rib cage. He still cannot do much more than rest.', 'lead_paragraph': 'PORT ST. LUCIE, Fla. — David Wright of the Mets was prescribed five days of rest and treatment Friday when he was diagnosed with a strained intercostal muscle in his left rib cage. Five days have passed, and Wright still cannot do much more than rest and receive treatment.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wright Still Has Sights Set on Opening Day', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': "Mets' Wright Still Struggling", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wright, David', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-21T00:23:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Andrew Keh', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Keh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5aa89c68-358b-5d2b-8241-8c278d1ad6b0', 'word_count': 307, 'uri': 'nyt://article/5aa89c68-358b-5d2b-8241-8c278d1ad6b0'}, {'abstract': 'Five former officials from Bell, one of the poorest cities in Los Angeles County, were convicted Tuesday of misappropriating public money in a scheme to pay themselves inflated salaries.', 'web_url': 'https://www.nytimes.com/2013/03/21/us/california-former-officials-guilty-of-inflating-pay.html', 'snippet': 'Five former officials from Bell, one of the poorest cities in Los Angeles County, were convicted Tuesday of misappropriating public money in a scheme to pay themselves inflated salaries.', 'lead_paragraph': 'Five former officials from Bell, one of the poorest cities in Los Angeles County, were convicted Tuesday of multiple counts of misappropriating public money in a scheme to pay themselves inflated salaries of up to $100,000. The former mayor of the working-class city of 36,000, Oscar Hernandez, and four former City Council members — Teresa Jacobo, George Mirabal, George Cole and Victor Bello — were acquitted on other counts. The five appointed themselves to an oversight board, which met only once but increased their pay by more than $10,000. Another former council member, Luis Artiga, was acquitted on all counts. Mr. Artiga joined the council later than his co-defendants, after members’ salaries had already been raised. The defendants accused the former city manager, Robert Rizzo, who made nearly $800,000 a year, of masterminding the scheme. He will be tried separately. ', 'print_section': 'A', 'print_page': '17', 'so