name': None, 'lastname': 'Wadler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03b90487-bbd1-5ab4-bf76-0affc1f56204', 'word_count': 983, 'uri': 'nyt://article/03b90487-bbd1-5ab4-bf76-0affc1f56204'}, {'abstract': 'Despite the availability of mobile health programs, they’ve floundered in developing countries.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/03/13/the-benefits-of-mobile-health-on-hold/', 'snippet': 'Despite the availability of mobile health programs, they’ve floundered in developing countries.', 'lead_paragraph': 'The world now has 5 billion mobile phones – one for every person over 15.\xa0 Africa has a billion people and 750 million phones, and mobile is growing so fast there that in a few years there will be more phones than people.\xa0\xa0 In some countries this is already true — South Africa has 47 million people, but 52 million SIM cards.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Benefits of Mobile Health, on Hold', 'kicker': 'Fixes', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cellular Telephones', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Text Messaging', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Uganda', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-13T13:00:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Tina Rosenberg', 'person': [{'firstname': 'Tina', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3667f18-ef6e-5081-9fdb-1dfb5e75b209', 'word_count': 1646, 'uri': 'nyt://article/e3667f18-ef6e-5081-9fdb-1dfb5e75b209'}, {'abstract': 'A day in the life of armed America.', 'web_url': 'https://nocera.blogs.nytimes.com/2013/03/13/the-gun-report-march-13-2013/', 'snippet': 'A day in the life of armed America.', 'lead_paragraph': 'Take a close look at the first item here. It shows exactly how perverse the gun show loophole is—which, of course, has been staunchly defended over the years by the National Rifle Association. The killer, a felon who had just been released from prison, actually researched gun shows either just before or just after he killed his grandparents so that he could buy a gun without a background check. It boggles the mind. But no state can prevent someone from buying a gun elsewhere and bringing it across state lines. And the beat goes on.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Gun Report: March 13, 2013', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ALABAMA', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Durham (NC)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Jacksonville (Fla)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Montgomery (Ala)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Nevada', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Oakland (Calif)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (State)', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-13T13:00:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Joe Nocera and Jennifer Mascia', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Nocera', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jennifer', 'midd