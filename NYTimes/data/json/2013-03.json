 'height': 688, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/21/sports/GOLF/GOLF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 688}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/GOLF/GOLF-jumbo.jpg', 'height': 1024, 'width': 893, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/GOLF/GOLF-superJumbo.jpg', 'height': 2048, 'width': 1786, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/GOLF/GOLF-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/21/sports/GOLF/GOLF-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/GOLF/GOLF-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Woods Is Smiling Now, and He Has Reasons', 'kicker': None, 'content_kicker': None, 'print_headline': 'Woods Is Smiling Now, And He Has Reasons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Woods, Tiger', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Vonn, Lindsey', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'PGA Tour Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-20T23:45:43+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middl