od.', 'lead_paragraph': 'Dear Diary:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Waiting for Radiation Treatment, an Inspiration', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cancer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Radiation', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Memorial Sloan-Kettering Cancer Center', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Central Park (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-08T14:16:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By E. Anne Lipman', 'person': [{'firstname': 'E.', 'middlename': 'Anne', 'lastname': 'Lipman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8447b194-13ef-5136-a2cf-e257d378b429', 'word_count': 392, 'uri': 'nyt://article/8447b194-13ef-5136-a2cf-e257d378b429'}, {'abstract': 'The six-film retrospective in May will include William Friedkin’s films “The French Connection” and “The Exorcist,” as well as “Sorcerer,” “The Boys in the Band,” “The Brink’s Job” and “Cruising.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/08/friedkin-retrospective-coming-to-brooklyn-academy-of-music-in-may/', 'snippet': 'The six-film retrospective in May will include William Friedkin’s films “The French Connection” and “The Exorcist,” as well as “Sorcerer,” “The Boys in the Band,” “The Brink’s Job” and “Cruising.”', 'lead_paragraph': 'The filmmaker who taught moviegoers to be terrified of the New York City subway system (and also made Georgetown seem like a pretty horrific place) will be getting a warm welcome from Brooklyn. William Friedkin, the Academy Award-winning director of “The French Connection” and “The Exorcist,” will be the s