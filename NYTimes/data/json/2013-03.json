umbnail': 'images/2013/03/18/technology/18bits-drone/18bits-drone-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/technology/18bits-drone/18bits-drone-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Civilian Drones, the Sky is the Limit', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'University of North Dakota', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-18T19:34:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Matthew L. Wald', 'person': [{'firstname': 'Matthew', 'middlename': 'L.', 'lastname': 'Wald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1eff3d16-2732-57b4-9bb6-04037b7bcdab', 'word_count': 774, 'uri': 'nyt://article/1eff3d16-2732-57b4-9bb6-04037b7bcdab'}, {'abstract': 'Finally getting a glimpse of Ina Drew, the subject of my October article who I had previously never met or caught on video or heard on tape.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2013/03/18/ina-drew-takes-risk-goes-on-the-defensive/', 'snippet': 'Finally getting a glimpse of Ina Drew, the subject of my October article who I had previously never met or caught on video or heard on tape.', 'lead_paragraph': 'Writing a profile about someone who is not cooperating with your story starts to feel a little bit like an exercise in stalking. I did not actually stalk Ina Drew, the chief investment officer\xa0who resigned from JPMorgan Chase following the bank’s $6 billion loss, as I reported on her for the magazine last October. But I did think about her for many of my waking moments throughout the summer of 2012, as I reported the story. I also showed up at her home once. I rang the doorbell, and met her husband, a tall, genial-looking man who told me that she was not available and would not talk to me, not that day and not anytime soon.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/magazine/18-ina-drew-waiting/18-ina-drew-waiting-articleLarge.jpg', 'height': 386, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/18/magazine/18-ina-drew-waiting/18-ina-drew-waiting-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 386}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/magazine/18-ina-drew-waiting/18-ina-drew-waiting-jumbo.jpg', 'height': 658, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/magazine/18-ina-drew-waiting/18-ina-drew-waiting-superJumbo.jpg', 'height': 1316, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/magazine/18-ina-drew-waiting/18-ina-drew-waiting-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/18/magazine/18-ina-drew-waiting/18-ina-drew-waiting-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/magazine/18-ina-drew-waiting/18-ina-drew-waiting-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 't