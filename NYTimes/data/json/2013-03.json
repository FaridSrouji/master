'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-03-22T22:11:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/1819d5b3-9b32-5f8c-af6f-06ac55e0f876', 'word_count': 25, 'uri': 'nyt://article/1819d5b3-9b32-5f8c-af6f-06ac55e0f876'}, {'abstract': 'Cultural and political figures weigh in on the legacy of Chinua Achebe, author of “Things Fall Apart.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/22/nigerians-react-to-news-of-achebes-death/', 'snippet': 'Cultural and political figures weigh in on the legacy of Chinua Achebe, author of “Things Fall Apart.”', 'lead_paragraph': 'LAGOS, Nigeria— The news of the death of Chinua Achebe, the influential Nigerian author renowned for his novel “Things Fall Apart,” reverberated across the country’s cultural and political circles on Friday. “I must say it’s a most painful death for me,” said Odia Ofeimun, a poet and the former president of Association of Nigerian Authors. “Just when we were learning to argue with him, he died.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22artsbeat-achebe/22artsbeat-achebe-articleLarge.jpg', 'height': 807, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/22/arts/22artsbeat-achebe/22artsbeat-achebe-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 807}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22artsbeat-achebe/22artsbeat-achebe-jumbo.jpg', 'height': 1024, 'width': 761, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22artsbeat-achebe/22artsbeat-achebe-superJumbo.jpg', 'height': 2048, 'width': 1522, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22artsbeat-achebe/22artsbeat-achebe-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/22/arts/22artsbeat-achebe/22artsbeat-achebe-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22artsbeat-achebe/22artsbeat-achebe-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nigerians React to News of Achebe’s Death', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'ACHEBE, CHINUA', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jonathan, Goodluck', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-22T22:20:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Ben Ezeamalu', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ezeamalu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e6f9d0d-4b19-56d0-9686-304a16bc0a0f', 'word_count': 506, 'uri': 'nyt://article/9e6f9d0d-4b19-56d0-9686-304a16bc0a0f'}, {'abstract': 'The exhibition “David Bowie Is,” at the Victoria and Albert Museum in London, looks to show the many guises Mr. Bowie has created over a nearly 50-year career.', 'web_url': 'https://www.nytimes.com/2013/03/23/arts/music/david-bowie-is-opens-at-the-victoria-and-albert-in-london.html', 'snippet': 'The exhibition “David Bowie Is,” at the Victoria and Albert Museum in London, looks to show the many guises Mr. Bowie has created over a nearly 50-year career.', 'lead_paragraph': 'LONDON — A photograph hangs inconspicuously near the entrance of “David Bowie Is,” a Victoria and Albert Museum exhibition opening on Saturday that has already sold a record number of tickets. It shows the young man who began life as David Jones, seated, in a dark suit and tie, with a leg propped up on his chair, beneath which sits a drum bearing the name of his band, the Kon-rads. One hand grips a saxophone, the other rests delicately against his face, and he looks out at the world with a mesmerizing blend of reserve and come-hither allure.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/arts/23BOWIE/23BOWIE-articleLarge-v2.jpg', 'height': 333, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/23/arts/23BOWIE/23BOWIE-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 333}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/arts/23BOWIE/23BOWIE-jumbo-v2.jpg', 'height': 569, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/arts/23BOWIE/23BOWIE-superJumbo-v2.jpg', 'height': 1138, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/arts/23BOWIE/23BOWIE-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStand