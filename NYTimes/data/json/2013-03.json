cb5e0eb-f272-57b2-91c3-34c397ffe899', 'word_count': 854, 'uri': 'nyt://article/fcb5e0eb-f272-57b2-91c3-34c397ffe899'}, {'abstract': 'The French luxury group PPR will henceforth be known as Kering.', 'web_url': 'https://runway.blogs.nytimes.com/2013/03/22/for-the-caring-generation-a-new-name-in-luxury/', 'snippet': 'The French luxury group PPR will henceforth be known as Kering.', 'lead_paragraph': 'The French luxury group PPR will henceforth be known as Kering. In a statement today, the group said its new moniker (pronounced “caring”) reflects “the distinctive way in which we look after our brands, our staff, our customers and our stakeholders.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For the Caring Generation, a New Name in Luxury', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Trademarks and Trade Names', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dore, Garance', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pinault, Francois-Henri', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'PPR', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-22T15:20:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Cathy Horyn', 'person': [{'firstname': 'Cathy', 'middlename': None, 'lastname': 'Horyn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8eb14072-2291-54b3-8b36-1aaa63072322', 'word_count': 208, 'uri': 'nyt://article/8eb14072-2291-54b3-8b36-1aaa63072322'}, {'abstract': 'Even after three years, some women with a false positive mammogram test result displayed higher levels of distress than t