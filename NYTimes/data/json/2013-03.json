 {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/realestate/17DEBIEF_SPAN/17DEBIEF_SPAN-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/17/realestate/17DEBIEF_SPAN/17DEBIEF_SPAN-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/realestate/17DEBIEF_SPAN/17DEBIEF_SPAN-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When This Stranger Knocks, It’s Thrilling', 'kicker': 'Debriefing', 'content_kicker': None, 'print_headline': 'When This Stranger Knocks, It’s Thrilling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rosenblum, Constance', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kostick, Paul', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-14T22:52:56+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Constance Rosenblum', 'person': [{'firstname': 'Constance', 'middlename': None, 'lastname': 'Rosenblum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad61ddcf-8590-5d23-9fad-8cdbc031cf21', 'word_count': 1284, 'uri': 'nyt://article/ad61ddcf-8590-5d23-9fad-8cdbc031cf21'}, {'abstract': 'People borrow? Who knew?', 'web_url': 'https://krugman.blogs.nytimes.com/2013/03/14/running-government-like-a-business-or-family/', 'snippet': 'People borrow? Who knew?', 'lead_paragraph': 'I’ve spent a lot of time trying to knock down the bad analogy between governments and individuals, and the line that the government should act like an individual family or business, and cut back when times are tough. The key point is realizing interdependence: your spending is my income, my spending is your income, and if we all try to slash spending at the same time the result is a depression. Somebody needs to step up and spend when others won’t — and the government can and should be that somebody.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Running Government Like A Business or Family', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-14T22:53:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f91a755-3198-5d1e-8166-c87000ff3dbd', 'word_count': 151, 'uri': 'nyt://article/0f91a755-3198-5d1e-8166-c87000ff3dbd'}, {'abstract': 'Addressing teachable moments, smelly feet, parents in the dark and a roommate who shops at secondhand stores.', 'web_url': 'https://www.nytimes.com/2013/03/17/fashion/talking-to-children-social-qs.html', 'snippet': 'Addressing teachable moments, smelly feet, parents in the dark and a roommate who shops at secondhand stores.', 'lead_paragraph': 'While I was driving a group of elementary school students on a field trip, one of my child’s classmates commented on a homeless person we saw (“I hate homeless people”) and a wheelchair-bound person (“He’s icky”). Other students responded by telling her “That’s not nice,” which led me to a teachable moment about compassion. But should I share this girl’s comments with her parents, whom I do not know? If our roles were reversed, I would want to know.', 'print_section': 'ST', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-jumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-superJumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Use Your Words', 'kicker': 'Social Q’s', 'content_kicker': None, 'print_headline': 'Use Your Words', 'name': None