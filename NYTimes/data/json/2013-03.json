 None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Citizenship and Naturalization', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Organizing for Action', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Carson, Jon', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-25T04:01:58+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/86c7712d-a447-561e-a410-9c8936a83605', 'word_count': 605, 'uri': 'nyt://article/86c7712d-a447-561e-a410-9c8936a83605'}, {'abstract': 'DeAndre Yedlin, 19, has been a revelation since signing with the Seattle Sounders as a homegrown player in January. A berth on the United States under-20 team could be next.', 'web_url': 'https://goal.blogs.nytimes.com/2013/03/25/sounders-have-found-something-in-yedlin/', 'snippet': 'DeAndre Yedlin, 19, has been a revelation since signing with the Seattle Sounders as a homegrown player in January. A berth on the United States under-20 team could be next.', 'lead_paragraph': 'When Major League Soccer created the homegrown player rule in 2008, it was an attempt to offer an incentive for teams to invest in youth development by allowing clubs to directly sign their academy players instead of having them go potentially to other teams through the SuperDraft.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sounders Have Found Something in Yedlin', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{