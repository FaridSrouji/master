k': 5, 'major': 'N'}], 'pub_date': '2013-03-28T21:11:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Tim Arango', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Arango', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/909e368e-20af-5db9-9e22-2fb9cdcd5541', 'word_count': 889, 'uri': 'nyt://article/909e368e-20af-5db9-9e22-2fb9cdcd5541'}, {'abstract': 'City officials should deny the arena’s request to live on top of Pennsylvania Station “in perpetuity.”', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/03/28/transplanting-madison-square-garden/', 'snippet': 'City officials should deny the arena’s request to live on top of Pennsylvania Station “in perpetuity.”', 'lead_paragraph': 'Anybody who takes a hard look at the ill-fated marriage of Pennsylvania Station and Madison Square Garden in New York City eventually comes to the same conclusion.\xa0We will have to untangle these two giant structures if there is any hope of converting Manhattan’s depressing subterranean transit hub into an economic and cultural plus for the Northeast region.\xa0 And the first crucial step will be finding a suitable new home for Madison Square Garden, now perched directly on top of the station.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Transplanting Madison Square Garden', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pennsylvania Station (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Moynihan, Daniel Patrick', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stringer, Scott M', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-28T21:12:37+0000', 'document_type': 'article', 'news_desk': '', 'section_n