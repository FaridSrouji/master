], 'headline': {'main': 'Election of a Pope Tests Betting Markets', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cardinals (Roman Catholic Prelates)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Popes', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Scola, Angelo', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-13T02:24:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By David Leonhardt', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/75d7530c-2a2f-5b2e-bb4b-271d76d49bd1', 'word_count': 1165, 'uri': 'nyt://article/75d7530c-2a2f-5b2e-bb4b-271d76d49bd1'}, {'abstract': 'Mr. von Kleist was believed to be the last surviving member of an elaborate German assassination plan led by Col. Claus von Stauffenberg in 1944.', 'web_url': 'https://www.nytimes.com/2013/03/13/world/europe/ewald-heinrich-von-kleist-anti-hitler-plotter-dies-at-90.html', 'snippet': 'Mr. von Kleist was believed to be the last surviving member of an elaborate German assassination plan led by Col. Claus von Stauffenberg in 1944.', 'lead_paragraph': 'Ewald-Heinrich von Kleist, believed to be the last surviving member of an elaborate plot to kill Adolf Hitler during World War II, died on Friday at his home in Munich. He was 90.', 'print_section': 'B', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/world/KLEIST1-obit/KLEIST1-obit-jumbo.jpg', 'height': 769, 'width': 532, 'subType': 'jumbo', 'cro