print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-15T19:42:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Juliet Lapidos', 'person': [{'firstname': 'Juliet', 'middlename': None, 'lastname': 'Lapidos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2691a050-2713-5c99-9655-c10d81e349dd', 'word_count': 219, 'uri': 'nyt://article/2691a050-2713-5c99-9655-c10d81e349dd'}, {'abstract': '“Beautiful: The Carole King Musical,” featuring Ms. King’s music and the story of her life, is scheduled to open on Broadway in spring 2014, with a book by Douglas McGrath.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/15/a-carole-king-musical-is-broadway-bound/', 'snippet': '“Beautiful: The Carole King Musical,” featuring Ms. King’s music and the story of her life, is scheduled to open on Broadway in spring 2014, with a book by Douglas McGrath.', 'lead_paragraph': 'In 1960, the Shirelles recorded “Will You Love Me Tomorrow,” which turned out to be the first No. 1 hit by a young, married songwriting team, Carole King and Gerry Goffin. Their marriage ended in 1968, but the pop music world continued to love their work, and the songs Ms. King continued to write, for decades.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Carole King Musical Is Broadway Bound', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'King, Carole', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McGrath, Douglas', 'rank': 3, 'major': '