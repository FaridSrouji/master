t_kicker': None, 'print_headline': 'Two Mets Are Pushing To Be Ready For Opener', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Collins, Terry L', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'den Dekker, Matt', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-24T22:10:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Andrew Keh', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Keh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/81040a86-3fc0-5486-aab1-a83ee696f010', 'word_count': 230, 'uri': 'nyt://article/81040a86-3fc0-5486-aab1-a83ee696f010'}, {'abstract': 'Vladimir Nabokov’s first major work, the play “The Tragedy of Mister Morn,” pits a mysterious king, who has brought peace to a fairy-tale land, against a group of revolutionaries.', 'web_url': 'https://www.nytimes.com/2013/03/25/books/the-tragedy-of-mister-morn-by-vladimir-nabokov.html', 'snippet': 'Vladimir Nabokov’s first major work, the play “The Tragedy of Mister Morn,” pits a mysterious king, who has brought peace to a fairy-tale land, against a group of revolutionaries.', 'lead_paragraph': 'The Russian Revolution upended the lives of Vladimir Nabokov and his family. Leaving behind an aristocratic world of colossal wealth and privilege (a world about which he could speak of “the smallest and oldest of our gardeners”), Nabokov would become an exile in Berlin, where he supported himself as a tutor, teaching French, English and tennis. On March 28, 1922, his father, a liberal politician, was shot and killed at a Berlin lecture while trying to protect another man from an assassin — a loss that would reverberate throughout Nabokov’s life and fiction. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/25/arts/jpbook/jpbook-articleLarge.jpg', 'height': 733, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/25/arts/jpbook/jpbook-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 733}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/25/arts/jpbook/jpbook-jumbo.jpg', 'height': 1024, 'width': 839, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/25/arts/jpbook/jpbook-superJumbo.jpg', 'height': 2026, 'width': 1658, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/25/arts/jpbook/jpbook-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/25/arts/jpbook/jpbook-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/25/arts/jpbook/jpbook-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Master’s Blueprint, Born of Revolution', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Master’s Blueprint, Born of Revolution', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nabokov, Vladimir', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank