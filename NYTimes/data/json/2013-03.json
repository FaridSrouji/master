t a hospital in Atlanta.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/us/11SUBMANNINGOBIT/11SUBMANNINGOBIT-articleLarge.jpg', 'height': 825, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/11/us/11SUBMANNINGOBIT/11SUBMANNINGOBIT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 825}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/us/11SUBMANNINGOBIT/11SUBMANNINGOBIT-jumbo.jpg', 'height': 1024, 'width': 745, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/us/11SUBMANNINGOBIT/11SUBMANNINGOBIT-superJumbo.jpg', 'height': 2048, 'width': 1490, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/us/11SUBMANNINGOBIT/11SUBMANNINGOBIT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/11/us/11SUBMANNINGOBIT/11SUBMANNINGOBIT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/us/11SUBMANNINGOBIT/11SUBMANNINGOBIT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mildred Manning, ‘Angel’ of Corregidor, Dies at 98', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mildred Manning, 98, ‘Angel’ of Corregidor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Goldstein, Richard', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'v