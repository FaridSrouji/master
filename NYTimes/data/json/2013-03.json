ank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Factories and Manufacturing', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Carbon Dioxide', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-03-16T02:19:33+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Joe Nocera', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Nocera', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9f5ae4f9-d99f-5e53-947e-a54a50b7a8f1', 'word_count': 831, 'uri': 'nyt://article/9f5ae4f9-d99f-5e53-947e-a54a50b7a8f1'}, {'abstract': 'The Knicks’ slump has given the Nets new hope in their pursuit of the Atlantic Division title, and the ensuing playoff advantages.', 'web_url': 'https://www.nytimes.com/2013/03/16/sports/basketball/knicks-and-nets-wont-meet-again-but-race-is-on.html', 'snippet': 'The Knicks’ slump has given the Nets new hope in their pursuit of the Atlantic Division title, and the ensuing playoff advantages.', 'lead_paragraph': 'When the Knicks and the Nets last met, the lasting image was of Joe Johnson, rising over J. R. Smith to sink the jump shot that clinched the game, tied the season series and silenced Madison Square Garden. That was Jan. 21.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/16/sports/KNICKS1/KNICKS1-articleLarge.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/16/sports/KNICKS1/KNICKS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': N