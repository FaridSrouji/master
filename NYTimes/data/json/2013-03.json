icle/c16bebd6-5769-587b-bf86-64b4c25fcf98'}, {'abstract': 'The administration searched staff e-mails to try to root out the source of leaks to the news media in a cheating scandal, and the staff members were not told until months later.', 'web_url': 'https://www.nytimes.com/2013/03/10/education/harvard-searched-staff-e-mails.html', 'snippet': 'The administration searched staff e-mails to try to root out the source of leaks to the news media in a cheating scandal, and the staff members were not told until months later.', 'lead_paragraph': 'Harvard secretly searched the e-mail accounts of several of its staff members last fall, looking for the source of news media leaks about its recent cheating scandal, but did not tell them about the searches for several months, people briefed on the matter said on Saturday.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Harvard Searched E-Mails for Source of Media Leaks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Harvard Hacked E-Mails In Search of Media Leaks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Harvard University', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'E-Mail', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cheating', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Globe', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Cambridge (Mass)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-03-10T04:04:57+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Education', 'byline': {'original': 'By Richard Pérez-Peña', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Pérez-Peña', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fa315dc2-5539-5137-94e7-b61650dfb294', 'word_count': 501, 'uri': 'nyt://article/fa315dc2-5539-5137-94e7-b61650dfb294'}, {'abstract': 'Quotation of the Day for Sunday, March 10.', 'web_url': 'https://www.nytimes.com/2013/03/10/pageoneplus/quotation-of-the-day-for-sunday-march-10.html', 'snippet': 'Quotation of the Day for Sunday, March 10.', 'lead_paragraph': '“I would still eat these meatballs. No problem.”', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day for Sunday, March 10', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-10T04:44:39+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/f620244c-6b12-50e7-81fd-29c2f83758ab', 'word_count': 31, 'uri': 'nyt://article/f620244c-6b12-50e7-81fd-29c2f83758ab'}, {'abstract': 'John Isner’s loss in the second round at Indian Wells means that no American man will be ranked in the top 20.', 'web_url': 'https://straightsets.blogs.nytimes.com/2013/03/09/with-loss-isner-takes-a-big-step-down/', 'snippet': 'John Isner’s loss in the second round at Indian Wells means that no American man will be ranked in the top 20.', 'lead_paragraph': 'INDIAN WELLS, Calif. — On the court where he had stepped up a year earlier, John Isner stepped down.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'With Loss, Isner Takes a Big Step Down', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-10T04:50:01+0000', 'document_t