ument_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcacbc2c-847e-5830-af1b-5e6391cb7ed0', 'word_count': 1107, 'uri': 'nyt://article/bcacbc2c-847e-5830-af1b-5e6391cb7ed0'}, {'abstract': 'America’s $250 million in aid should inspire Mohamed Morsi and his opponents to stop the infighting and turn around their failing state.', 'web_url': 'https://www.nytimes.com/2013/03/05/opinion/egypt-needs-to-act.html', 'snippet': 'America’s $250 million in aid should inspire Mohamed Morsi and his opponents to stop the infighting and turn around their failing state.', 'lead_paragraph': 'President Obama’s decision to provide $250 million in aid to Egypt is a vote of confidence in a country that is critical to stability in the region but is also teetering on the edge of economic disaster. It is now up to Egypt’s government — and its opponents — to create the political and economic consensus that can leverage the American money to turn around their failing state.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Egypt Needs to Act', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Egypt Needs to Act', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'State Department', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Muslim Brotherhood (Egypt)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Morsi, Mohamed', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kerry, John', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Foreign Aid', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-03-05T02:05:33+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/865eea5b-b8e4-5c25-a458-8c7f445a5298', 'word_count': 448, 'uri': 'nyt://article/865eea5b-b8e4-5c25-a458-8c7f445a5298'}, {'abstract': 'Li Hangbin was convicted of manslaughter last month in the death of his 2-month-old daughter, Annie.', 'web_url': 'https://www.nytimes.com/2013/03/05/nyregion/father-in-shaken-baby-case-gets-5-to-15-years.html', 'snippet': 'Li Hangbin was convicted of manslaughter last month in the death of his 2-month-old daughter, Annie.', 'lead_paragraph': 'A Chinese immigrant convicted last month of manslaughter in the death of his 2-month-old daughter was sentenced on Monday to 5 to 15 years in prison. ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/nyregion/BABY/BABY-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/05/nyregion/BABY/BABY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/nyregion/BABY/BABY-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/nyregion/BABY/BABY-superJumbo.jpg', 'height': 1354, 'width': 2048, 'subType': 'superJumbo