umbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/24/nyregion/24data-illustration-small/24data-illustration-small-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/24/nyregion/24data-illustration-small/24data-illustration-small-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/24/nyregion/24data-illustration-small/24data-illustration-small-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Mayor’s Geek Squad', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Mayor’s Geek Squad', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Feuer, Alan', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Office of Policy and Strategic Planning (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Flowers, Michael P', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Data-Mining and Database Marketing', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-23T04:49:00+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Alan Feuer', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Feuer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b41cf226-6ec1-5661-b6a4-e35208ae03eb', 'word_count': 2429, 'uri': 'nyt://article/b41cf226-6ec1-5661-b6a4-e35208ae03eb'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/03/23/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (Starz) SPARKLE (2012) Whitney Houston, above, who died before this film was released, portrays Emma, a performer turned prim church lady in late-1960s Detroit in this remake of the 1976 movie starring Irene Cara and Lonette McKee, with a score by Curtis Mayfield. The “American Idol” winner Jordin Sparks plays Sparkle, Emma’s youngest daughter, who breaks free from the ranks of the girl group she has formed with her sisters (Carmen Ejogo and Tika Sumpter) and ascends to stardom against her mother’s wishes. “Houston dominates the new ‘Sparkle’ and gives its most compelling vocal performance in her rendition of ‘His Eye Is on the Sparrow,’\xa0” Stephen Holden wrote in The New York Times. “Her vocal stamina was considerably diminished by the time she filmed the movie, but her disciplined, slightly hoarse rendition of that gospel standard gives ‘Sparkle’ much of its heart.” He added: “If the new songs on the soundtrack are effective Motown pastiches, most of them pale beside their prototypes. But diluted Motown is better than none.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-23T05:00:15+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/f4c65575-d619-513b-ae2b-6996da685eef', 'word_count': 718, 'uri': 'nyt://article/f4c65575-d619-513b-ae2b-6996da685eef'}, {'abstract': 'The context for the high court’s hearings on gay marriage is a profound social and political revolution.', 'web_url': 'https://www.nytimes.com/2013/03/24/opinion/sunday/bruni-marriage-and-the-supremes.html', 'snippet': 'The context for the high court’s hearings on gay marriage is a profound social and political revolution.', 'lead_paragraph': 'I’M not sure I’ve ever seen advocates of gay rights — of equal rights, I should say — as revved up as they are right now, with the Supreme Court poised, on Tuesday and Wednesday, to consider same-sex marriage in two separate cases.', 'print_section': 'SR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Marriage and the Supremes', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Marriage and the Supremes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Defense of Marriage Act (1996)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-23T05:14:58+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Frank Bruni', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d4095662-d407-5cb6-879e-de73019fa31f', 'word_count': 1262, 'uri': 'nyt://article/d4095662-d407-5cb6-879e-de73019fa31f'}, {'abstract': 'Cyprus partly approves a formula to obtain a bailout; Israel apologizes to Turkey; the writer Chinua Achebe dies; cargo ships in trouble; and the Malaysian Grand Prix.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2013/03/23/iht-quick-read-march-23/', 'snippet': 'Cyprus partly approves a formula to obtain a bailout; Israel apologizes to Turkey; the writer Chinua Achebe dies; cargo ships in trouble; and the Malaysian Grand Prix.', 'lead_paragraph': 'NEWS Lawmakers in Cyprus took steps late Friday to revise a formula for obtaining a bailout of the country’s banks but faced strong signals that the plan would not pass muster with international lenders. The Parliament put off until later this weekend a vote on a crucial new proposal that would confiscate 22 to 25 percent of uninsured deposits above €100,000 through a new tax on account holders in one of the nation’s most troubled banks. Liz Alderman reports from Nicosia.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/books/23achebe_337/23achebe_337-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/23/books/23achebe_337/23achebe_337-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/books/23achebe_337/23achebe_337-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/books/23achebe_337/23achebe_337-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/books/23achebe_337/23achebe_337-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/23/books/23achebe_337/23achebe_337-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/23/books/23achebe_337/23achebe_337-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'IHT Quick Read: March 23', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-23T05:23:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By The International Herald Tribune', 'person': [], 'organization': 'The International Herald Tribune'}, 'type_of_material': 'News', '_id': 'nyt://article/e9238805-5f8c-5856-a011-c7de5a35f44e', 'word_count': 662, 'uri': 'nyt://article/e9238805-5f8c-5856-a011-c7de5a35f44e'}, {'abstract': 'A round-up of news from across India.', 'web_url': 'https://india.blogs.nytimes.com/2013/03/23/newswallah-bharat-edition-79/', 'snippet': 'A round-up of news from across India.', 'lead_paragraph': 'Jammu and Kashmir: Assailants suspected of being terrorists killed an 18-year-old boy in the Sopore district on Tuesday night, IBNLive reported. Initial investigations have pointed to the involvement of the militant group Lashkar-e-Taiba. The attack came on the heels of a suicide attack on a Central Reserve Police Force camp in Bemina last week. The police have arrested four people, including a Lashkar-e-Taiba operative, in connection with that attack, according to NDTV. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Newswallah: Bharat Edition', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mukherjee, Pranab', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rajapaksa, Mahinda', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Lashkar-e-Taiba', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Goa (India)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Kashmir and Jammu (India)', 'rank': 7, 'major': 'N'}, {'name': 'gloca