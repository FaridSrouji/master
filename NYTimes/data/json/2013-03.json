': 'N'}, {'name': 'glocations', 'value': 'New Delhi (India)', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-13T13:39:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Hari Kumar', 'person': [{'firstname': 'Hari', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80b5c7d9-b0b1-5aff-a23f-223d2b1166a6', 'word_count': 642, 'uri': 'nyt://article/80b5c7d9-b0b1-5aff-a23f-223d2b1166a6'}, {'abstract': 'A study traces government use of an off-the-shelf program called FinSpy to monitor the electronic activities of individuals, often in countries with a record of political repression.', 'web_url': 'https://bits.blogs.nytimes.com/2013/03/13/researchers-find-25-countries-using-surveillance-software/', 'snippet': 'A study traces government use of an off-the-shelf program called FinSpy to monitor the electronic activities of individuals, often in countries with a record of political repression.', 'lead_paragraph': 'Last May, two security researchers volunteered to look at a few suspicious e-mails sent to some Bahraini activists. Almost one year later, the two have uncovered evidence that some 25 governments, many with questionable records on human rights, may be using off-the-shelf surveillance software to spy on their own citizens.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/technology/13bits-tracking/13bits-tracking-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/13/technology/13bits-tracking/13bits-tracking-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/technology/13bits-tracking/13bits-tracking-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/technology/13bits-tracking/13bits-tracking-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/technology/13bits-tracking/13bits-tracking-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/13/technology/13bits-tracking/13bits-tracking-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/technology/13bits-tracking/13bits-tracking-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Researchers Find 25 Countries Using Surveillance Software', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Gamma Group International', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-13T13:45:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nicole Perlroth', 'person': [{'firstname': 'Nicole', 'middlename': None, 'lastname': 'Perlroth', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/93fe334b-ef78-5d92-aa93-b1dd83187441', 'word_count': 762, 'uri': 'nyt://article/93fe334b-ef78-5d92-aa93-b1dd83187441'}, {'abstract': 'The project, for the National Gallery’s East Building, is estimated to cost $38.4 million.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/13/national-gallery-of-arts-renovation-plan-envisions-two-new-tower-galleries/', 'snippet': 'The project, for the National Gallery’s East Building, is estimated to cost $38.4 million.', 'lead_paragraph': 'Buildings often start to age after 35 years, and generally it’s the unglamorous bits – the staircases or skylights – that need attention. Such is the case with the National Gallery of Art’s renowned I.M. Pei-designed East Building. “When we were beginning to look into things that required work, Perry Chin, who works with I. M. Pei, would say, ‘If you’re going to do this you might consider …,’ ’’ recalled Earl A. Powell III, the Gallery’s director. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'National Gallery of Art’s Renovation Plan Envisions Two New Tower Galleries', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pei, I M', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Museum of Contemporary Art', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'National Gallery of Art', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-13T13:58:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd4ea842-adf6-5bec-b682-b147e3113ed0', 'word_count': 350, 'uri': 'nyt://article/fd4ea842-adf6-5bec-b682-b147e3113ed0'}, {'abstract': 'The Karma Hotspot is a portable hotspot that gives away 100 megabytes of free data when you share it with new users.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2013/03/13/karma-hotspot-gives-out-free-data/', 'snippet': 'The Karma Hotspot is a portable hotspot that gives away 100 megabytes of free data when you share it with new users.', 'lead_paragraph': 'I hate when products make me a shill by alerting everyone on Facebook when I use them. Maybe I don’t want to share what pictures I’ve viewed on EyeEm, and I certainly don’t want Spotify telling anyone I listened to the Archies.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/08/technology/08gw-karma/08gw-karma-articleLarge.jpg', 'height': 699, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/08/technology/08gw-karma/08gw-karma-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 699}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/08/technology/08gw-karma/08gw-karma-jumbo.jpg', 'height': 1024, 'width': 879, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/08/technology/08gw-karma/08gw-karma-superJumbo.jpg', 'height': 1160, 'width': 995, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/08/technology/08gw-karma/08gw-karma-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/08/technology/08gw-karma/08gw-karma-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/08/technology/08gw-karma/08gw-karma-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Karma Hotspot Gives Out Free Data', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': 'A Hot Spot That Connects to the Mobile Phone Network', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-13T13:59:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Roy Furchgott', 'person': [{'firstname': 'Roy', 'middlename': None, 'lastname': 'Furchgott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2825c9c9-c48f-5612-bf28-706404c4e22f', 'word_count': 423, 'uri': 'nyt://article/2825c9c9-c48f-5612-bf28-706404c4e22f'}, {'abstract': 'A Japanese airline hires a renowned sommelier to produce wine exclusively for its passengers.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/03/13/boutique-wines-aloft/', 'snippet': 'A Japanese airline hires a renowned sommelier to produce wine exclusively for its passengers.', 'lead_paragraph': 'A number of airlines in recent years have hired famous chefs to develop their in-flight meals. The Japanese airline All Nippon Airways has taken the indulgence one step further; it has brought on Ned Goodwin, a holder of the Master of Wine title and former sommelier at the restaurant Veritas in New York City, to produce wines exclusively for its passengers. The wines, made from grapes from the Languedoc and Roussillon wine regions in France and blended and matured by the boutique winery Hecht & Bannier, will be served through August. ', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Boutique Wines Aloft', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': 'Airlines: Boutique Wines Aloft', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Goodwin, Ned', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'ALL NIPPON AIRWAYS', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-13T14:00:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Ratha Tep', 'person': [{'firstname': 'Ratha', 'middlename': None, 'lastname': 'Tep', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b4cc1773-a40c-5b99-97c5-b5444b5787eb', 'word_count': 92, 'uri': 'nyt://article/b4cc1773-a40c-5b99-97c5-b5444b5787eb'}, {'abstract': 'The “Made Here” project includes Web video intended to inform and inspire performing artists in New York City.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/13/new-york-performing-artists-share-inspiration-on-made-here/', 'snippet': 'The “Made Here” project includes Web video intended to inform and inspire performing artists in New York City.', 'lead_paragraph': '“Made Here,” a documentary series and interactive Web site that gathers interviews, performances and other footage to showcase the lives of New York City performing artists, is headed into its third and fourth seasons.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York Performing Artists Share Inspiration on ‘Made Here’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jones, Bill T', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Cherry', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Selvaratnam, Tanya', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-13T14:00:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3388f4d2-35d3-55df-ae99-650b0a5a88db', 'word_count': 378, 'uri': 'nyt://article/3388f4d2-35d3-55df-ae99-650b0a5a88db'}, {'abstract': 'No wonder it’s the Democrats who want to enlarge the franchise.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/03/13/voter-turnout/', 'snippet': 'No wonder it’s the Democrats who want to enlarge the franchise.', 'lead_paragraph': 'On Monday the group Nonprofit VOTE released a report on turnout in the November election.\xa0 Much of the information isn’t new—like the fact that an estimated 58.7 percent of eligible voters actually went to the polls, below the 2008 benchmark but still above most elections from the last 40 years.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Voter Turnout', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Voting and Voters', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-13T14:02:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Juliet Lapidos', 'person': [{'firstname': 'Juliet', 'middlename': No