name': 'persons', 'value': 'Ramchandani, Mohanbhai', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-06T01:31:20+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Russ Buettner', 'person': [{'firstname': 'Russ', 'middlename': None, 'lastname': 'Buettner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ce6e9cba-3695-5a63-b7b0-afbc6754f8b7', 'word_count': 643, 'uri': 'nyt://article/ce6e9cba-3695-5a63-b7b0-afbc6754f8b7'}, {'abstract': 'Chávez might blow kisses, denounce the United States, ride a bike, a tank — anything to keep the focus on him, not his performance.', 'web_url': 'https://www.nytimes.com/2013/03/06/opinion/in-the-end-chavez-was-an-awful-manager.html', 'snippet': 'Chávez might blow kisses, denounce the United States, ride a bike, a tank — anything to keep the focus on him, not his performance.', 'lead_paragraph': 'IN Caracas, Venezuela, you could tell a summit meeting mattered to Hugo Chávez when government workers touched up the city’s rubble. Before dignitaries arrived, teams with buckets and brushes would paint bright yellow lines along the route from the airport into the capital, trying to compensate for the roads’ dilapidation with flashes of color.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In the End, an Awful Manager', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'In the End, An Awful Manager', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Venezuela', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Chavez, Hugo', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Corruption (Institutional)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Socialism (Theory and Philosophy)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-06T01:33:54+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Rory Carroll', 'person': [{'firstname': 'Rory', 'middlename': None, 'lastname': 'Carroll', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/de79ddc4-d0be-5936-b10e-4d2d704aef77', 'word_count': 1221, 'uri': 'nyt://article/de79ddc4-d0be-5936-b10e-4d2d704aef77'}, {'abstract': 'One of the region’s most intractable conflicts may be nearing a close, thanks to the determination of the prime minister, yet ending violence will not end tension.', 'web_url': 'https://www.nytimes.com/2013/03/06/world/europe/turkey-renews-focus-on-peace-with-kurds.html', 'snippet': 'One of the region’s most intractable conflicts may be nearing a close, thanks to the determination of the prime minister, yet ending violence will not end tension.', 'lead_paragraph': 'DIYARBAKIR, Turkey — When three prominent Kurdish women activists were murdered in Paris in January, analysts worried that the killings would derail the fledgling peace talks, begun late last year. Just the opposite appears to have happened, as both sides have moved forward with more determination to end one of the region’s most intractable conflicts, which has claimed almost 40,000 lives over nearly three decades.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/06/world/KURDS/KURDS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/06/world/KURDS/KURDS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/06/world/