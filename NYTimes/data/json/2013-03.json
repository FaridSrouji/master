150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Burmese Laureate Heckled Over Backing Copper Mine', 'kicker': None, 'content_kicker': None, 'print_headline': 'Burmese Laureate Heckled Over Backing Copper Mine', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Myanmar', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fuller, Thomas', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Aung San Suu Kyi', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mines and Mining', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Agriculture and Farming', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Thein Sein', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-15T00:16:40+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/510608fe-2151-5717-b771-0c22f9586940', 'word_count': 666, 'uri': 'nyt://article/510608fe-2151-5717-b771-0c22f9586940'}, {'abstract': 'Gov. Robert Bentley signed a law on Thursday granting tax credits to families who want to send their children to private schools or better-performing public schools.', 'web_url': 'https://www.nytimes.com/2013/03/15/education/alabama-governor-signs-law-granting-private-school-tax-credits.html', 'snippet': 'Gov. Robert Bentley signed a law on Thursday granting tax credits to families who want to send their children to private schools or better-performing public schools.', 'lead_paragraph': '\xa0 \xa0Gov. Robert Bentley signed a law on Thursday granting tax credits to families who want to send their children to private schools or better-performing public schools. The act was passed amid heated controversy, not only about its substance, but about the way it was passed: A conference committee that was to reconcile versions of a school-related bill already passed by the House and Senate added the tax credit, and more than tripled the original bill’s length. The new version was then voted on quickly by both houses. Republican leaders said the maneuver was necessary for passage, but Democrats were left fuming. A circuit court initially blocked the bill from going forward out of the House, but the State Supreme Court lifted that hold on Wednesday. The legal fight is far from over, however, and even now at least one Republican legislator has raised questions about the bill’s passage. ', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Alabama: Governor Signs Law Granting Private School Tax Credits', 'kicker': 'National Briefing | South', 'content_kicker': None, 'print_headline': 'Alabama: Governor Signs Law Granting Private School Tax Credits', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Private and Sectarian Schools', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bentley, Robert J', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'ALABAMA', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Credits, Deductions and Exemptions', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-15T00:17:57+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Education', 'byline': {'original': 'By Campbell Robertson', 'person': [{'firstname': 'Campbell', 'middlename': None, 'lastname': 'Robertson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/784218e1-3432-5a47-8cb8-b2f70670960a', 'word_count': 148, 'uri': 'nyt://article/784218e1-3432-5a47-8cb8-b2f70670960a'}, {'abstract': 'After the former publicist for the troubled musical seeks dismissal of a lawsuit against him, the producers respond with details of phony emails sent to warn a potential investor.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/14/dueling-court-filings-by-rebecca-combatants-reveal-backstage-drama/', 'snippet': 'After the former publicist for the troubled musical seeks dismissal of a lawsuit against him, the producers respond with details of phony emails sent to warn a potential investor.', 'lead_paragraph': 'The Broadway publicist who used to represent the troubled musical “Rebecca” has asked a State Supreme Court judge to dismiss a lawsuit that accuses him of torpedoing the show last fall, arguing that he simply warned a potential investor that its producers had fallen prey to a fraud scheme.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dueling Court Filings by ‘Rebecca’ Combatants Reveal Backstage Drama', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hotton, Mark C', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sprecher, Ben', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Thibodeau, Marc', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-15T00:18:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2e83b5f-0517-5398-86e6-d7e411609afc', 'word_count': 660, 'uri': 'nyt://article/c2e83b5f-0517-5398-86e6-d7e411609afc'}, {'abstract': 'Ousting the University of Virginia president last year was “a failure of judgment and, alas, of common sense,” the American Association of University Professors said in a scathing report.', 'web_url': 'https://www.nytimes.com/2013/03/15/education/virginia-report-by-professors-faults-university-in-firing-of-president.html', 'snippet': 'Ousting the University of Virginia president last year was “a failure of judgment and, alas, of common sense,” the American Association of University Professors said in a scathing report.', 'lead_paragraph': 'Ousting the University of Virginia president last year was “a failure of judgment and, alas, of common sense,” the American Association of University Professors said in a scathing report released Thursday, adding that the episode looked like “a crude exercise of naked power.” Amid a storm of protest, the Board of Visitors reinstated President Teresa A. Sullivan last June, 16 days after forcing her out. The rector, or board chief, Helen E. Dragas, orchestrated the removal, offering what the professors’ group called vague, unfounded reasons. Neither woman would comment. ', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Virginia: Report by Professors Faults University in Firing of President', 'kicker': 'National Briefing | South', 'content_kicker': None, 'print_headline': 'Virginia: Report By Professors Faults University In Firing of President', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'American Assn of University Professors', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Virginia', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sullivan, Teresa A', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Dragas, Helen E', 'rank': 6, 'major': 'N'}],