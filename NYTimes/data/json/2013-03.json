': [{'name': 'subject', 'value': 'NCAA Basketball Championships (Men)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Borzi, Pat', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball (College)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'University of North Carolina', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Kansas', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Roy A', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-25T00:48:44+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Basketball', 'byline': {'original': 'By Pat Borzi', 'person': [{'firstname': 'Pat', 'middlename': None, 'lastname': 'Borzi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a1e713d4-fcd3-58cc-8c03-b804332e92dd', 'word_count': 845, 'uri': 'nyt://article/a1e713d4-fcd3-58cc-8c03-b804332e92dd'}, {'abstract': 'Taking a cue from fans of endangered shows, the network made a commercial to keep a low-rated sitcom on the air.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2013/03/24/abc-creates-commercial-to-save-its-happy-endings/', 'snippet': 'Taking a cue from fans of endangered shows, the network made a commercial to keep a low-rated sitcom on the air.', 'lead_paragraph': 'The impulse among television superfans to create “save our show” campaigns for every imperiled sitcom and drama has been co-opted by one of the very networks that shows have to be saved from.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'ABC Creates Commercial to Save Its ‘Happy Endings’', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'ABC Asks Fans to Save a Show', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'ran