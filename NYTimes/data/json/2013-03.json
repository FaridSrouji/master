, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/06/sports/RANGERS/RANGERS-superJumbo.jpg', 'height': 1228, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/06/sports/RANGERS/RANGERS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/06/sports/RANGERS/RANGERS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/06/sports/RANGERS/RANGERS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nash and His 2 Goals Power Rangers Over Flyers', 'kicker': 'Rangers 4, Flyers 2', 'content_kicker': None, 'print_headline': 'Nash and His 2 Goals Power Rangers Over Flyers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Klein, Jeff Z', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hockey, Ice', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Flyers', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Nash, Rick', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Richards, Brad', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Staal, Marc', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-06T04:15:18+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e6bcda2-80f2-5ba6-86a1-2d332cc40b76', 'word_count': 707, 'uri': 'nyt://article/8e6bcda2-80f2-5ba6-86a1-2d332cc40b76'}, {'abstract': 'As Yoani Sanchez started her worldwide book tour, questions swirled — about both her future and her country’s.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2013/03/05/around-the-world-in-80-days-for-cubas-most-famous-dissident-blogger/', 'snippet': 'As Yoani Sanchez started her worldwide book tour, questions swirled — about both her future and her country’s.', 'lead_paragraph': 'WASHINGTON — Yoani Sanchez, Cuba’s most famous dissident blogger, arrived in Brazil looking like a ’60s hippie, her hair falling below her waist, her dark ankle-length skirt floating under a summery flower-child top. It was the first stop on Ms. Sanchez’s 80-day tour of South America, Europe and the United States. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/blogs/05rdv-yoani-sanchez-cameras/05rdv-yoani-sanchez-cameras-articleLarge.jpg', 'height': 419, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/05/blogs/05rdv-yoani-sanchez-cameras/05rdv-yoani-sanchez-cameras-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 419}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/blogs/05rdv-yoani-sanchez-cameras/05rdv-yoani-sanchez-cameras-jumbo.jpg', 'height': 714, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/05/blogs/05rdv-yoani-sanchez-cameras/05rdv-yoani-sanchez-cameras-superJumbo.jpg', 'height': 1429, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo'