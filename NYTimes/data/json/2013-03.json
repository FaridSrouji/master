ail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-chandler-buckingham/envpls13-chandler-buckingham-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/03/education/envpls13-chandler-buckingham/envpls13-chandler-buckingham-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-chandler-buckingham/envpls13-chandler-buckingham-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'College Interview Survivor Awaits Scholarship Decisions', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Scholarships and Fellowships', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'John Brown University', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ARKANSAS', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-12T16:03:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Chandler Buckingham', 'person': [{'firstname': 'Chandler', 'middlename': None, 'lastname': 'Buckingham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bfd6a966-04c6-5c77-b1db-9ccb1e7248ea', 'word_count': 794, 'uri': 'nyt://article/bfd6a966-04c6-5c77-b1db-9ccb1e7248ea'}, {'abstract': 'Megan Marshall’s “Margaret Fuller,” a biography of the 19th-century scholar, editor and feminist, has the texture of a serious novel.', 'web_url': 'https://www.nytimes.com/2013/03/13/books/margaret-fuller-a-new-american-life-by-megan-marshall.html', 'snippet': 'Megan Marshall’s “Margaret Fuller,” a biography of the 19th-century scholar, editor and feminist, has the texture of a serious novel.', 'lead_paragraph': 'When Margaret Fuller died in a shipwreck off Fire Island in 1850, her friend Ralph Waldo Emerson was devastated. He sent a mutual friend, Henry David Thoreau, to the scene of the disaster.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/books/13book-1/13book-1-articleLarge.jpg', 'height': 856, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/13/books/13book-1/13book-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 856}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/books/13book-1/13book-1-jumbo.jpg', 'height': 1024, 'width': 718, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/books/13book-1/13book-1-superJumbo.jpg', 'height': 1731, 'width': 1213, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/books/13book-1/13book-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/13/books/13book-1/13book-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/books/13book-1/13book-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Outsize Intellect