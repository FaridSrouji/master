/VATICAN-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/world/VATICAN/VATICAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/11/world/VATICAN/VATICAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/world/VATICAN/VATICAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'No Stumping for Papacy, but Babies Do Get Kisses', 'kicker': None, 'content_kicker': None, 'print_headline': 'No Stumping For Papacy, But Babies Do Get Kisses', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cardinals (Roman Catholic Prelates)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Popes', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-11T00:58:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Jim Yardley', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Yardley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a5f850ac-3e90-5797-87cb-241ef342bfaf', 'word_count': 1213, 'uri': 'nyt://article/a5f850ac-3e90-5797-87cb-241ef342bfaf'}, {'abstract': 'Computer algorithms are capable of trading stocks, arranging dates and winning “Jeopardy.” But increasingly, behind the curtain, there is a human