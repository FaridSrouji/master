: 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21d6aaea-aa30-5517-b7fb-45ee7d3a4d0a', 'word_count': 109, 'uri': 'nyt://article/21d6aaea-aa30-5517-b7fb-45ee7d3a4d0a'}, {'abstract': 'Baked in the Sun has three options under the new law: offer insurance, pay the penalty or reduce head count.', 'web_url': 'https://boss.blogs.nytimes.com/2013/03/20/should-a-bakery-with-more-than-50-employees-offer-health-insurance/', 'snippet': 'Baked in the Sun has three options under the new law: offer insurance, pay the penalty or reduce head count.', 'lead_paragraph': 'We just published a case study about Baked in the Sun, a wholesale bakery and distributor trying to decide how best to comply with the Affordable Care Act, which requires businesses with 50 or more employees to offer health insurance or pay a penalty. The company, owned by Rachel Shein and Steve Pilarski, who are married, started out making scones 16 years ago and expanded with the growth of coffeehouses. Baked in the Sun now produces nearly 20,000 items per day — almost 200 different products, including brownies, coffee cakes, muffins and cookies — and employs nearly 100 people in San Marcos, Calif.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Should a Bakery With More Than 50 Employees Offer Health Insurance?', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Outsourcing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gruber, Jonathan', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-20T16:08:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Julie Weed', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Weed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/312d714b-37da-5792-8949-e5ffd897d5d8', 'word_count': 623, 'uri': 'nyt://article/312d714b-37da-5792-8949-e5ffd897d5d8'}, {'abstract': 'Sanford I. Weill, and his wife, Joan, and their Weill Family Foundation make a $10 million grant, with Carnegie Hall asked to raise $20 million.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/20/a-challenge-grant-from-weills-to-spur-carnegie-hall-renovation/', 'snippet': 'Sanford I. Weill, and his wife, Joan, and their Weill Family Foundation make a $10 million grant, with Carnegie Hall asked to raise $20 million.', 'lead_paragraph': 'Carnegie Hall has received a $10 million challenge grant from its chairman, Sanford I. Weill, and his wife, Joan, and their Weill Family Foundation toward the completion of its $230 million renovation. The project, known as the Studio Towers Renovation, will create new spaces for music education on the landmark building’s upper floors and upgrade the concert hall’s backstage areas. It is scheduled to be completed in 2014.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Challenge Grant From Weills to Spur Carnegie Hall Renovation', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Weill, Sanford I', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Carnegie Hall', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-20T16:10:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d960bdb1-e302-5c76-91f0-3fbc2e25ed29', 'word_count': 273, 'uri': 'nyt://article/d960bdb1-e302-5c76-91f0-3fbc2e25ed29'}, {'abstract': 'A team within Morgan Stanley’s wealth management division is starting a new portfolio that seeks to invest in companies that have demonstrated a commitment to including women on their boards.', 'web_url': 'https://dealbook.nytimes.com/2013/03/20/from-morgan-stanley-investing-in-women-on-corporate-boards/', 'snippet': 'A team within Morgan Stanley’s wealth management division is starting a new portfolio that seeks to invest in companies that have demonstrated a commitment to including women on their boards.', 'lead_paragraph': 'The lack of women on corporate boards has been a hot topic in financial circles recently, especially after a debate in Europe last year over imposing quotas.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From Morgan Stanley, Investing in Women on Corporate Boards', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Boards of Directors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Morgan Stanley', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-20T16:13:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a865bccd-a9c7-56d6-86fa-38baca0c9404', 'word_count': 356, 'uri': 'nyt://article/a865bccd-a9c7-56d6-86fa-38baca0c9404'}, {'abstract': 'The cult-favorite series “Enlightened” won’t return for a third season.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/20/hbo-cancels-enlightened/', 'snippet': 'The cult-favorite series “Enlightened” won’t return for a third season.', 'lead_paragraph': 'Despite some critical acclaim, a second-season ratings spike and a Golden Globe award for best actress, HBO’s “Enlightened” will be no more. After two seasons, the series, created by Mike White and Laura Dern, who also starred, has been canceled, The Hollywood Reporter said.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'HBO Cancels ‘Enlightened’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dern, Laura', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'WHITE, MIKE', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-20T16:14:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/053d47a2-e8dd-5b54-8c76-e22f8286ad2c', 'word_count': 166, 'uri': 'nyt://article/053d47a2-e8dd-5b54-8c76-e22f8286ad2c'}, {'abstract': 'Every day that the banks stay shut, the people of Cyprus may begin to appreciate the advantages of doing a deal with the euro zone.', 'web_url': 'https://dealbook.nytimes.com/2013/03/20/all-the-plan-bs-for-cyprus-look-dreadful/', 'snippet': 'Every day that the banks stay shut, the people of Cyprus may begin to appreciate the advantages of doing a deal with the euro zone.', 'lead_paragraph': 'The Cypriots have an expression, “eninboro allo.” It means: I cannot take any more of it.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'All the Plan B’s for Cyprus Look Dreadful', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Euro (Currency)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'European Central Bank', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Cyprus', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-20T16:19:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Hugo Dixon', 'person': [{'firstname': 'Hugo', 'middlename': None, 'lastname': 'Dixon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/926d410c-1f17-59b7-86dc-af6166fb0915', 'word_count': 927, 'uri': 'nyt://article/926d410c-1f17-59b7-86dc-af6166fb0915'}, {'abstract': 'A comprehensive study of Civil War casualties shows that the conflict’s psychological impact was less extensive than we thought.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/03/20/minds-at-war/', 'snippet': 'A comprehensive study of Civil War casualties shows that the conflict’s psychological impact was less extensive than we thought.', 'lead_paragraph': 'Any attempt to calculate the carnage of the Civil War, the number of sick, wounded, dismembered and dead, leaves one numb in the struggle to make sense of it all. The conditions and horrors faced by those who fought the war exacted a horrific toll. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Minds at War', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Depression (Mental)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-20T16:21:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jeffrey Allen Smith and B. Christopher Frueh', 'person': [{'firstname': 'Jeffrey', 'middlename': 'Allen', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4bbd987d-deaa-5920-b957-d8c4617c1032', 'word_count': 1408, 'uri': 'nyt://article/4bbd987d-deaa-5920-b957-d8c4617c1032'}, {'abstract': 'Social practice artists blur the lines among object making, performance and activism, creating participatory work that often flourishes beyond galleries and museums.', 'web_url': 'https://www.nytimes.com/2013/03/24/arts/design/outside-the-c