gewidth': 600, 'xlargeheight': 702}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/16/sports/baseball/16leadingpic/16leadingpic-jumbo.jpg', 'height': 1024, 'width': 876, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/16/sports/baseball/16leadingpic/16leadingpic-superJumbo.jpg', 'height': 1954, 'width': 1670, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/16/sports/baseball/16leadingpic/16leadingpic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/16/sports/baseball/16leadingpic/16leadingpic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/16/sports/baseball/16leadingpic/16leadingpic-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Baseball Grabs Some March Gladness', 'kicker': 'Leading Off', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Southeastern Conference', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Pacific-12 Conference', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Atlanta Falcons', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'St Louis Rams', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Louisville', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Cano, Robinson', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kolb, Kevin', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Wright, David', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Nadal, Rafael', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Federer, Roger', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'World Baseball Classic', 'rank': 12, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 13, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 14, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 15, 'major': 'N'}], 'pub_date': '2013-03-15T15:03:40+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ae77d82-4173-5aa9-b255-7b43294ce826', 'word_count': 661, 'uri': 'nyt://article/5ae77d82-4173-5aa9-b255-7b43294ce826'}, {'abstract': 'Lately, an indie surf-meets-art-meets-fashion scene has sprung up, as cool young Parisians settle into this grand old town overlooking the Atlantic.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/03/15/the-californication-of-biarritz/', 'snippet': 'Lately, an indie surf-meets-art-meets-fashion scene has sprung up, as cool young Parisians settle into this grand old town overlooking the Atlantic.', 'lead_paragraph': 'Biarritz has long been known as the surfing capital of France — ever since the American screenwriter Peter Viertel arrived on its beach during the filming of “The Sun Also Rises” in 1956. Nowadays, major surf brands like Quiksilver and O’Neill have offices, shops and competitions in the area. But lately, a more indie surf-meets-art-meets-fashion scene has sprung up, as cool young Parisians settle into this grand old town overlooking the Atlantic. Their presence — not just in summer but increasingly year-round — has transformed Biarritz and its surrounding beach towns from what was once a resort for bourgeois retirees into a breezy bohemian outpost that has come to be called “the French California.” It’s sunnier, friendlier and more rough-hewn than much of France, tied by its hardy Basque roots to its Spanish neighbors just over the border.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Californication of Biarritz', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Surfing', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Biarritz (France)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-15T15:05:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Tim Murphy', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8508b659-7c01-52bb-9218-08140aed9a99', 'word_count': 602, 'uri': 'nyt://article/8508b659-7c01-52bb-9218-08140aed9a99'}, {'abstract': 'At CPAC, the senator insisted that everyone’s wrong about the character of the two parties.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/03/15/mossy-mitch-mcconnell/', 'snippet': 'At CPAC, the senator insisted that everyone’s wrong about the character of the two parties.', 'lead_paragraph': 'OXON HILL, Md. — At last year’s Conservative Political Action Convention, Senator Mitch McConnell called Democrats “liberal thugs.” It was a rousing speech, if you go in for that sort of thing: Totally unapologetic. On Friday, addressing the same meeting of minds, and coming off his party’s 2012 election loss, he was just as unapologetic, clinging to the possibility that if Republicans keep doing the same thing over and over again they’ll eventually get different results, like the old definition of insanity.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mossy Mitch McConnell', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McConnell, Mitch', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-03-15T15:05:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Juliet Lapidos', 'person': [{'firstname': 'Juliet', 'middlename': None, 'lastname': 'Lapidos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5002edfb-6e30-509c-b898-4f2fe6a95fc0', 'word_count': 458, 'uri': 'nyt://article/5002edfb-6e30-509c-b898-4f2fe6a95fc0'}, {'abstract': 'Even with a budget of only $50 a day, Shanghai is more than manageable.', 'web_url': 'https://www.nytimes.com/2013/03/17/travel/in-the-alleys-of-shanghai-the-funky-charm-of-china.html', 'snippet': 'Even with a budget of only $50 a day, Shanghai is more than manageable.', 'lead_paragraph': 'Street signs in English, not-so-spicy cuisine, locals who don’t stare, contemporary art galleries, modern youth hostels and even interpreter hot lines for cabdrivers who don’t speak English. For independent travelers about to start an expedition into the huge, mysterious nation of China, I have some advice: stop in Shanghai and take a deep breath.', 'print_section': 'TR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17SHANGHAI_SPAN/SUB17SHANGHAI-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/17/travel/17SHANGHAI_SPAN/SUB17SHANGHAI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17SHANGHAI_SPAN/SUB17SHANGHAI-jumbo.jpg', 'height': 578, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17SHANGHAI_SPAN/SUB17SHANGHAI-superJumbo.jpg', 'height': 1155, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17SHANGHAI_SPAN/SUB17SHANGHAI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/17/travel/17SHANGHAI_SPAN/SUB17SHANGHAI-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17SHANGHAI_SPAN/SUB17SHANGHAI-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Shanghai on a Dime? Pretty Close', 'kicker': 'Frugal Traveler', 'content_kicker': None, 'print_headline': 'Shanghai on a Dime? Pretty Close', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Budget Travel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kugel, Seth', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Shanghai (China)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-15T15:08:27+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Seth Kugel', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Kugel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aca2fa16-dcc0-5b64-b0cd-40e06f985801', 'word_count': 1156, 'uri': 'nyt://article/aca2fa16-dcc0-5b64-b0cd-40e06f985801'}, {'abstract': 'A few rookie mistakes and some grand discoveries while traveling in China on a budget.', 'web_url': 'https://www.nytimes.com/2013/03/17/travel/frugal-traveler-along-the-yangtze-river.html', 'snippet': 'A few rookie mistakes and some grand discoveries while traveling in China on a budget.', 'lead_paragraph': 'As the Hai Nei Guan Guang 2 blasted its deafening foghorn and pulled into the Yangtze River port of Fengjie, I brimmed with confidence. Two days earlier, I had nervously boarded a similar workaday passenger boat along another leg of the Yangtze, no idea what was in store. But now, I knew the routine. I’d say san-deng (third-class), hand over some cash, receive a handwritten slip with my cabin number, step over sunflower-seed-spitting passengers camped on the floor and settle into whatever rock-hard bunk remained in a room of instant-noodle-slurping Chinese passengers.', 'print_section': 'TR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17YANGTZE1_SPAN/17YANGTZE1_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/17/travel/17YANGTZE1_SPAN/17YANGTZE1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17YANGTZE1_SPAN/17YANGTZE1_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17YANGTZE1_SPAN/17YANGTZE1_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17YANGTZE1_SPAN/17YANGTZE1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/17/travel/17YANGTZE1_SPAN/17YANGTZE1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/travel/17YANGTZE1_SPAN/17YANGTZE1_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Up the Yangtze River With a $50 Paddle', 'kicker': 'Frugal Traveler', 'content_kicker': None, 'print_headline': 'Up the Yangtze River With a $50 Paddle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Shanghai (China)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kugel, Seth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Budget Travel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-15T15:08:59+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Seth Kugel', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Kugel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1f8097f-8f14-53