.', 'lead_paragraph': 'It was wild, and it was wintry, but it was a win. The United States national team righted its teetering World Cup qualifying campaign with a 1-0 win over Costa Rica on Friday night in Commerce City, Colo., in a game that nearly descended into farce as inch after inch of snow piled up.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/soccer/usloggo/usloggo-jumbo.jpg', 'height': 75, 'width': 75, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/soccer/usloggo/usloggo-superJumbo.jpg', 'height': 75, 'width': 75, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/21/sports/soccer/usloggo/usloggo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/21/sports/soccer/usloggo/usloggo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'World Cup Qualifying: U.S. vs. Costa Rica', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "United States Men's National Soccer Team", 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-23T01:15:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Andrew Das', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Das', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2