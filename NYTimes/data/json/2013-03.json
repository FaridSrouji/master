/cuba/cuba-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/07/world/cuba/cuba-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/07/world/cuba/cuba-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/07/world/cuba/cuba-superJumbo.jpg', 'height': 1356, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/07/world/cuba/cuba-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/07/world/cuba/cuba-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/07/world/cuba/cuba-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'With Worries for Its Economic Future, Cuba Bids a Sad Goodbye to a Generous Ally', 'kicker': None, 'content_kicker': None, 'print_headline': 'With Worries for Its Economic Future, Cuba Bids a Sad Goodbye to a Generous Ally', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Chavez, Hugo', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Burnett, Victoria', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Castro, Raul', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Venezuela', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-06T18:37:42+0000', 'document_t