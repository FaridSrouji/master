ddlename': None, 'lastname': 'Paul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3049eca8-3a5e-525b-9d37-6eca9871624e', 'word_count': 623, 'uri': 'nyt://article/3049eca8-3a5e-525b-9d37-6eca9871624e'}, {'abstract': 'Weeks after the Sept. 11 attacks, Sulaiman Abu Ghaith, a son-in-law of Osama bin Laden, praised the attacks in a video message broadcast on Al Jazeera.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/03/08/a-bin-laden-son-in-laws-video-messages/', 'snippet': 'Weeks after the Sept. 11 attacks, Sulaiman Abu Ghaith, a son-in-law of Osama bin Laden, praised the attacks in a video message broadcast on Al Jazeera.', 'lead_paragraph': 'As my colleagues Marc Santora and William Rashbaum report, Sulaiman Abu Ghaith, a son-in-law of Osama bin Laden who once served as a spokesman for Al Qaeda, was charged with conspiracy to kill Americans in federal court in Manhattan on Friday. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Bin Laden Son-in-Law’s Video Messages', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'September 11 (2001)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Abu Ghaith, Sulaiman', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'bin Laden, Osama', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'AL QAEDA', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-08T19:24:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ae4d5cf-b120-5a20-ab3b-c1c089abd082', 'word_count': 137, 'uri': 'nyt://article/5ae4d5cf-b120-5a20-ab3b-c1c089abd082'}, {'abstract': 'A series of injuries has kept Minnesota from establishing a consistent starting lineup this season.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2013/03/08/timberwolves-still-hoping-to-see-what-they-can-do/', 'snippet': 'A series of injuries has kept Minnesota from establishing a consistent starting lineup this season.', 'lead_paragraph': 'This isn’t the season the Minnesota Timberwolves thought they were going to have. With nearly three-quarters of their games played, they should have been on the road to the playoffs. The new additions Andrei Kirilenko, Chase Budinger and — they hoped — Brandon Roy were supposed to shore up the wing rotation and keep things on track until the return of Ricky Rubio from last season’s anterior cruciate ligament injury.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/sports/basketball/09rubio/09rubio-articleLarge.jpg', 'height': 418, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/09/sports/basketball/09rubio/09rubio-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 418}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/sports/basketball/09rubio/09rubio-jumbo.jpg', 'height': 713, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/sports/basketball/09rubio/09rubio-superJumbo.jpg', 'height': 1426, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/sports/basketball/09rubio/09rubio-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/09/sports/basketball/09rubio/09rubio-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/09/sports/basketball/09rubio/09rubio-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Timberwolves Still Hoping to See What They Can Do', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Adelman, Rick', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ridnour, Luke', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Roy, Brandon', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Ricky', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Minnesota Timberwolves', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-08T19:31:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Steve McPherson', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'McPherson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b46bc6d6-2193-522e-9a17-c0ca398882b6', 'word_count': 629, 'uri': 'nyt://article/b46bc6d6-2193-522e-9a17-c0ca398882b6'}, {'abstract': 'On a bed of arugula and garnished with Parmesan, a dish of grilled sliced steak is impressive to behold.', 'web_url': 'https://www.nytimes.com/2013/03/13/dining/tagliata-italian-for-sliced-steak.html', 'snippet': 'On a bed of arugula and garnished with Parmesan, a dish of grilled sliced steak is impressive to behold.', 'lead_paragraph': 'Italians enjoy going out for a good steak, but a steak in Italy isn’t necessarily an individual slab. Yes, there is the famous Florentine bistecca, a large T-bone steak served blood rare. But just as often, restaurants offer a sliced steak, called tagliata, essentially a nice thick piece of beef that is grilled, then carved. It’s simple and delicious but impressive nonetheless, and you really don’t have to go to a restaurant to enjoy it. In fact, it is quite easily prepared at home, year round. Tagliata is what I make for dinner whenever a fuss-free meal is required.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/dining/13KITCH1/13KITCH1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/13/dining/13KITCH1/13KITCH1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/dining/13KITCH1/13KITCH1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/dining/13KITCH1/13KITCH1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/13/dining/13KITCH1/13KITCH1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/dining/13KITCH1/13KITCH1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/dining/13KITCH1/13KITCH1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Beef, Pepper and Parmesan: It’s Italian', 'kicker': 'City Kitchen', 'content_kicker': None, 'print_headline': 'Italy in a Slice of Steak', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tanis, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Beef', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-08T19:42:20+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/791b7d3b-e46d-53ff-a882-d0a36a349d3b', 'word_count': 472, 'uri': 'nyt://article/791b7d3b-e46d-53ff-a882-d0a36a349d3b'}, {'abstract': 'The first annual awards will be handed out Sunday in Portland, Ore.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/08/a-magazine-a-plan-a-contest-symmys/', 'snippet': 'The first annual awards will be handed out Sunday in Portland, Ore.', 'lead_paragraph': 'Awards season isn’t over quite yet. On Sunday the winners of the first annual Symmys awards, for outstanding palindrome achievement, will be announced in Portland, Ore. The name of the awards is a palindrome, of course, and so is the date on which they’re being handed out: March 10, or 3/10/2013.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Magazine, a Plan, a Contest — Symmys!', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'su