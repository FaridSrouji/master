ge', 'url': 'images/2013/03/25/world/middleeast/25diplo/25diplo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/25/world/middleeast/25diplo/25diplo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/25/world/middleeast/25diplo/25diplo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In ‘Spirited’ Talks, Kerry Tells Iraq to Help Stop Arms Shipments to Syria', 'kicker': None, 'content_kicker': None, 'print_headline': 'In ‘Spirited’ Talks, Kerry Tells Iraq to Help Stop Arms Shipments to Syria', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iran', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Arango, Tim', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gordon, Michael R', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kerry, John', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-24T08:57:28+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Michael R. Gordon and Tim Arango', 'person': [{'firstname': 'Michael', 'middlename': 'R.', 'lastname': 'Gordon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Tim', 'middlename': None, 'lastname': 'Arango', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6eb6b70a-68b6-560a-8237-cd4ef259dab8', 'word_count': 1043, 'uri': 'nyt://article/6eb6b70a-68b6-560a-8237-cd4ef259dab8'}, {'abstract': 'It is easy to trace disasters like the Euro and the Arab Spring to the bursts of unfounded optimism that gave rise to them. So why is pessimism so often ignored?', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/03/24/when-hope-tramples-truth/', 'snippet': 'It is easy to trace disasters like the Euro and the Arab Spring to the bursts of unfounded optimism that gave rise to them. So why is pessimism so often ignored?', 'lead_paragraph': 'Apollo granted to his Trojan priestess Cassandra the gift of prophecy. But because she resisted his advances he punished her by ensuring that nobody would ever believe what she said. Such has been the fate of pessimists down the ages. Those who interrupt the good cheer of their fellows with the thought that the things about which they are all agreed might go badly wrong are either dismissed as madmen or condemned as fools. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'When Hope Tramples Truth', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Evolution', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pessimism', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-24T09:00:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Roger Scruton', 'person': [{'firstname': 'Roger', 'middlename': None, 'lastname': 'Scruton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://arti