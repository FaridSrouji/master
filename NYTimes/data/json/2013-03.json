f1f0a-3165-5812-937c-52ecc3d8f34b', 'word_count': 0, 'uri': 'nyt://interactive/c7ff1f0a-3165-5812-937c-52ecc3d8f34b'}, {'abstract': 'The police department of Redding, Calif., has asked the public for help in identifying a suspect whose failed attempt to rob a market was caught on tape.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/03/28/failed-robbery-immortalized-on-video/', 'snippet': 'The police department of Redding, Calif., has asked the public for help in identifying a suspect whose failed attempt to rob a market was caught on tape.', 'lead_paragraph': 'When police officers in the California town of Redding arrived at the scene of an attempted burglary one night earlier this month, they had little to go on, save for a blaring alarm and a broken window. Then they looked at the security-camera video. The tape revealed, as Anthony DeRosa of Reuters observed, an 18-second master class in “How Not to Rob a Convenience Store.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Failed Burglary Immortalized on Video', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crime and Criminals', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-03-28T22:56:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c628000c-b56c-5236-88fc-4b86d0554ffd', 'word_count': 167, 'uri': 'nyt://article/c628000c-b56c-5236-88fc-4b86d0554ffd'}, {'abstract': 'The Crystal Bridges Museum of American Art, opened in late 2011 in Bentonville, Ark., by the Wal-Mart heiress Alice Walton, brought in 565,488 visitors in its first full year, more than double the number the museum expected.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/28/a-newcomer-makes-a-splash-in-museum-attendance-standings/', 'snippet': 'The Crystal Bridges Museum of American Art, opened in late 2011 in Bentonville, Ark., by the Wal-Mart heiress Alice Walton, brought in 565,488 visitors in its first full year, more than double the number the museum expected.', 'lead_paragraph': 'The Art Newspaper’s annual roundup of international museum attendance numbers for 2012 found a lineup of heavyweights whose positions haven’t changed much – the Louvre is still the world’s most popular, with 9.7 million visitors, topping the Metropolitan Museum of Art, in second place with 6.1 million. But the survey found a surprising bump in an out-of-the-way place: the Crystal Bridges Museum of American Art, opened in late 2011 in Bentonville, Ark., by the Wal-Mart heiress Alice Walton, brought in 565,488 visitors in its first full year, more than double the number the museum expected.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Newcomer Makes a Splash in Museum Attendance Standings', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Walton, Alice L', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ART NEWSPAPER', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Crystal Bridges Museum of American Art', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Museum of Contemporary Art', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Louvre Museum', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-28T22:57:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2bbe6b7d-ac9f-51da-affa-96bddd6b32c5', 'word_count': 211, 'uri': 'nyt://article/2bbe6b7d-ac9f-51da-affa-96bddd6b32c5'}, {'abstract': 'William Bunker Tubby was the go-to architect of the Pratt family of Brooklyn.', 'web_url': 'https://www.nytimes.com/2013/03/31/realestate/william-bunker-tubby-the-pratt-familys-architect.html', 'snippet': 'William Bunker Tubby was the go-to architect of the Pratt family of Brooklyn.', 'lead_paragraph': 'An architect can claim exceptional good fortune to find a client loyal through two decades. Such was William Bunker Tubby, who enjoyed the patronage of the oil-rich family of Charles Pratt, and speckled Brooklyn with picturesque, usually Richardsonian-Romanesque-style houses, schools and factories from the 1880s through the early 20th century. And thanks to one very unusual commission, Tubby took care of the Pratts even in the afterlife. ', 'print_section': 'RE', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/realestate/streets1/streets1-articleLarge.jpg', 'height': 441, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/31/realestate/streets1/streets1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 441}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/realestate/streets1/streets1-jumbo.jpg', 'height': 753, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/realestate/streets1/streets1-superJumbo.jpg', 'height': 1506, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail'