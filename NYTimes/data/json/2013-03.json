value': 'Bank of England', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Financial Conduct Authority (Great Britain)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Financial Services Authority (Great Britain)', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Prudential Regulation Authority (Great Britain)', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-28T14:59:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Mark Scott', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/13817ca4-ab60-572c-848c-d683b3058f81', 'word_count': 756, 'uri': 'nyt://article/13817ca4-ab60-572c-848c-d683b3058f81'}, {'abstract': 'The first exhibition dedicated solely to the artist and composer’s photographs, opens on Friday in San Francisco.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/03/28/christian-marclays-things-ive-heard/', 'snippet': 'The first exhibition dedicated solely to the artist and composer’s photographs, opens on Friday in San Francisco.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Christian Marclay’s ‘Things I’ve Heard’', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Marclay, Christian', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Clock (Movie)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-28T15:00:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Erica Bellman', 'person': [{'firstname': 'Erica', 'middlename': None, 'lastname': 'Bellman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7abfb14f-9edb-505d-b009-992112de0403', 'word_count': 238, 'uri': 'nyt://article/7abfb14f-9edb-505d-b009-992112de0403'}, {'abstract': 'E. L. Doctorow, the author of “The Book of Daniel” and “Ragtime” among many other novels, has a new work, “Andrew’s Brain,” coming in early 2014.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/28/a-new-doctorow-novel/', 'snippet': 'E. L. Doctorow, the author of “The Book of Daniel” and “Ragtime” among many other novels, has a new work, “Andrew’s Brain,” coming in early 2014.', 'lead_paragraph': 'E. L. Doctorow, the author of “The Book of Daniel” and “Ragtime” among many other novels, has a work coming in early 2014, his publisher, Random House, said on Wednesday. Mr. Doctorow, best known for works of historical fiction like “World’s Fair,” which won the National Book Award for fiction, appears to be taking a new tack in the novel, “Andrew’s Brain.” In a news release Kate Medina, his editor, said: “It’s an of-the-moment novel whose main character, speaking from an unknown place and to an unknown interlocutor, unfurls his life, his loves and the circumstances that have led him to commit a mysterious act.” Besides the National Book Award, Mr. Doctorow has won two PEN/Faulkner Awards, three National Book Critics Circle Awards and the National Humanities Medal.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Doctorow Novel', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Doctorow, E L', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-28T15:08:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Leslie Kaufman', 'person': [{'firstname': 'Leslie', 'middlename': None, 'lastname': 'Kaufman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d2bf4c73-0813-5592-abc1-cb2104f276bb', 'word_count': 128, 'uri': 'nyt://article/d2bf4c73-0813-5592-abc1-cb2104f276bb'}, {'abstract': 'Sprint Nextel and its Japanese suitor, SoftBank, have assured lawmakers that they will not use equipment from China’s Huawei in Sprint’s cellphone network, the chairman of the House intelligence committee said on Thursday.', 'web_url': 'https://dealbook.nytimes.com/2013/03/28/sprint-and-softbank-pledge-to-forgo-huawei-equipment-lawmaker-says/', 'snippet': 'Sprint Nextel and its Japanese suitor, SoftBank, have assured lawmakers that they will not use equipment from China’s Huawei in Sprint’s cellphone network, the chairman of the House intelligence committee said on Thursday.', 'lead_paragraph': 'Sprint Nextel and its Japanese suitor, SoftBank, have assured lawmakers that they would not use equipment from China’s Huawei Technologies in Sprint’s cellphone network, the chairman of the House intelligence committee said on Thursday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sprint and SoftBank Pledge to Forgo Huawei Equipment, Lawmaker Says', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 3, 'm