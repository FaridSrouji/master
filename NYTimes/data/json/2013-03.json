education/AID/AID-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Great Aid Gap', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Great Aid Gap', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Financial Aid (Education)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Greenhouse, Steven', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ADULT EDUCATION', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-18T20:44:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Education', 'byline': {'original': 'By Steven Greenhouse', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Greenhouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3424ea17-b38e-55ee-bd3c-28826f5a91fc', 'word_count': 2038, 'uri': 'nyt://article/3424ea17-b38e-55ee-bd3c-28826f5a91fc'}, {'abstract': 'Not the typical program for older students, the academy includes required reading and homework and aims to transform the Aquarium of the Pacific into a serious adult-learning environment.', 'web_url': 'https://www.nytimes.com/2013/03/19/education/aquatic-academy-schools-over-50-age-group.html', 'snippet': 'Not the typical program for older students, the academy includes required reading and homework and aims to transform the Aquarium of the Pacific into a serious adult-learning environment.', 'lead_paragraph': '“ATTENTION,” reads a sign at the Aquarium of the Pacific in Long Beach, Calif., “Sharks Ahead.”', 'print_section': 'F', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/19/education/AQUARI