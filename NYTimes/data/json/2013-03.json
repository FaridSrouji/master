: '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-14T05:30:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Anastasia Economides', 'person': [{'firstname': 'Anastasia', 'middlename': None, 'lastname': 'Economides', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb8878fc-4279-504a-823b-8ab0e5d9595b', 'word_count': 22, 'uri': 'nyt://article/bb8878fc-4279-504a-823b-8ab0e5d9595b'}, {'abstract': 'Mr. Ieng Sary was part of an inner circle of communists who led the movement that caused the deaths of 1.7 million people in Cambodia from 1975 to 1979.', 'web_url': 'https://www.nytimes.com/2013/03/15/world/asia/ieng-sary-khmer-rouge-leader-tied-to-genocide-dies-at-87.html', 'snippet': 'Mr. Ieng Sary was part of an inner circle of communists who led the movement that caused the deaths of 1.7 million people in Cambodia from 1975 to 1979.', 'lead_paragraph': 'Ieng Sary, the former foreign minister of the Khmer Rouge who was one of three elderly leaders on trial on charges of genocide, crimes against humanity and war crimes, died on Thursday in a hospital in Phnom Penh, Cambodia, where he had been taken from his holding cell. He was 87.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/16/obituaries/sary3/sary3-articleLarge.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/16/obituaries/sary3/sary3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/16/obituaries/sary3/sary3-jumbo.jpg', 'height': 693, 'width': 1024, 'subType': 'jumbo', 'crop_name':