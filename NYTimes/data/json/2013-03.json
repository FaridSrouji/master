major': 'N'}], 'pub_date': '2013-03-29T05:35:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Matt Wolf', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Wolf', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/98e897a4-8e7e-55d0-80c3-a8171f203b7e', 'word_count': 1011, 'uri': 'nyt://article/98e897a4-8e7e-55d0-80c3-a8171f203b7e'}, {'abstract': 'The ninth-seeded Shockers used their size advantage to outrebound the Explorers, 47-29, and score 40 points in the paint.', 'web_url': 'https://www.nytimes.com/2013/03/29/sports/ncaabasketball/wichita-state-muscles-past-la-salle-into-the-round-of-8.html', 'snippet': 'The ninth-seeded Shockers used their size advantage to outrebound the Explorers, 47-29, and score 40 points in the paint.', 'lead_paragraph': 'LOS ANGELES — For about 10 minutes Thursday night, as part of its pregame warm-up in the Round of 16, La Salle practiced rebounding. First, the Explorers shadowed one another and boxed out. Then, one by one, as Coach John Giannini tossed basketballs at the rim, they maneuvered around one person, grabbed the rebound and shot the ball, over another, taller person, in the paint. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/29/sports/ncaabasketball/29wichita1-img/29wichita1-img-articleLarge.jpg', 'height': 431, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/29/sports/ncaabasketball/29wichita1-img/29wichita1-img-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 431}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/29/sports/ncaabasketball/29wichita1-img/29wichita1-img-jumbo.jpg', 'height': 735, 'width': 1024, 'subType': 'j