umbnail': 'images/2013/03/29/arts/wayne/wayne-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/29/arts/wayne/wayne-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Popcast: Lil Wayne, Sobriety and the Damage Done', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-29T15:40:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/d96a8a5f-ad09-5958-b8da-22be3b2433fb', 'word_count': 164, 'uri': 'nyt://article/d96a8a5f-ad09-5958-b8da-22be3b2433fb'}, {'abstract': 'Serving more than the four favorite species of fish is wise advice for the home cook trying to eat more seafood.', 'web_url': 'https://www.nytimes.com/2013/04/01/health/oven-poached-pacific-sole-with-lemon-caper-sauce-recipes-for-health.html', 'snippet': 'Serving more than the four favorite species of fish is wise advice for the home cook trying to eat more seafood.', 'lead_paragraph': 'Trying to include more fish and seafood in your diet can be confusing. Fish is healthy and nourishing, and I love to cook and eat it. But whenever I think about the environmental impacts of both farming and overfishing I feel torn. I am not the only one with these concerns, as was made clear by the recent Too Few Fish in the Sea Room For Debate feature.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/science/01recipehealth/01recipehealth-articleLarge.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {