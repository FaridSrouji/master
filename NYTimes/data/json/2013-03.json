d_count': 1005, 'uri': 'nyt://article/8fe5ef38-4c40-518f-a80d-d37aa1432786'}, {'abstract': 'Why is Mexico so cool to Cuba’s most famous dissident?', 'web_url': 'https://latitude.blogs.nytimes.com/2013/03/15/castros-appeal-half-a-century-old-endures-in-mexico/', 'snippet': 'Why is Mexico so cool to Cuba’s most famous dissident?', 'lead_paragraph': 'MEXICO CITY — In a country with barely any Internet access, the activist Yoani Sánchez has managed, with a blog and a Twitter account as her only tools, to tell the outside world about repression in Cuba. This has brought her a couple of arrests and a dozen international awards, including a special mention from the Maria Moors Cabot Prize committee and the Ortega y Gasset prize for online journalism.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Faithful to Fidel', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil Rights and Liberties', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sanchez, Yoani', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-03-15T09:09:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Carlos Puig', 'person': [{'firstname': 'Carlos', 'middlename': None, 'lastname': 'Puig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d37b9ea4-c6c0-5586-bf30-cb718f7aca78', 'word_count': 795, 'uri': 'nyt://article/d37b9ea4-c6c0-5586-bf30-cb718f7aca78'}, {'abstract': '“I haven’t received my admissions decisions yet,” writes Candice Childress, a student in Las Vegas, “but it’s looking sunny here in the heart of cactus country.”', 'web_url': 'https://thechoice.blogs.nytimes.com/2013/03/15/wooed-by-a-campus-visit-an-applicant-awaits-word-from-a-scholastic-suitor/', 'snippet': '“I haven’t received my admissions decisions yet,” writes Candice Childress, a student in Las Vegas, “but it’s looking sunny here in the heart of cactus country.”', 'lead_paragraph': 'If my college adventure was the “Wheel of Fortune,” the National Merit board would be Pat, the University of Arizona, Arizona State University and the University of New Mexico would be the buzzer-clutching contestants, and the Fafsa folks would be Vanna, clad in a horrific $100-patterned empire waist gown with blinding orange accents.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-candice/envpls13-candice-jumbo-v2.jpg', 'height': 386, 'width': 408, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-candice/envpls13-candice-superJumbo-v2.jpg', 'height': 386, 'width': 408, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-candice/envpls13-candice-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/03/education/envpls13-candice/envpls13-candice-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-candice/envpls13-candice-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'W