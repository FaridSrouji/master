: None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Arsu, Sebnem', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sierra, Sarai', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Staten Island (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-17T16:56:58+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sebnem Arsu and J. David Goodman', 'person': [{'firstname': 'Sebnem', 'middlename': None, 'lastname': 'Arsu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'J.', 'middlename': 'David', 'lastname': 'Goodman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/26b0711d-4a35-5ad0-a246-1b469721a0d1', 'word_count': 647, 'uri': 'nyt://article/26b0711d-4a35-5ad0-a246-1b469721a0d1'}, {'abstract': 'Meet a trim, sassy television personality, Soraya Sobreidad, who preaches the gospel of healthy Puerto Rican cuisine.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/03/17/a-low-carb-low-budget-cooking-show-fiercely-seasoned/', 'snippet': 'Meet a trim, sassy television personality, Soraya Sobreidad, who preaches the gospel of healthy Puerto Rican cuisine.', 'lead_paragraph': 'Television cooking shows, with their globe-trotting superstar chefs, are no longer humble small-studio affairs. But there is one program, glamorous in its own way, that gleefully bucks the trend. It is taped in a cramped apartment kitchen in Jackson Heights, Queens, and appears on public access. Its star is a trim, sassy drag queen named Soraya Sobreidad who preaches the gospel of healthful Puerto Rican cuisine.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multi