stname': 'Mireya', 'middlename': None, 'lastname': 'Navarro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/102b78d8-08c3-5dd3-b2e8-83c767acb899', 'word_count': 947, 'uri': 'nyt://article/102b78d8-08c3-5dd3-b2e8-83c767acb899'}, {'abstract': 'The Bloomberg administration wanted all cabs to be Nissan NV200s, but relented and said some large hybrids could be allowed.', 'web_url': 'https://www.nytimes.com/2013/03/30/nyregion/some-hybrids-could-be-used-as-cabs-under-proposed-rule.html', 'snippet': 'The Bloomberg administration wanted all cabs to be Nissan NV200s, but relented and said some large hybrids could be allowed.', 'lead_paragraph': 'Faced with a lawsuit aimed at blocking New York’s so-called Taxi of Tomorrow because it is not a hybrid, the Bloomberg administration has proposed a compromise: Some owners can buy hybrids, as long as they are big enough.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Cabs Could Avoid Hybrid Ban', 'kicker': None, 'content_kicker': None, 'print_headline': 'New Cabs Could Avoid Hybrid Ban', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Electric and Hybrid Vehicles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Taxicabs and Taxicab Drivers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Taxi and Limousine Commission', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Greater New York Taxi Assn', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-30T02:13:12+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c37ff9a-d9fe-53e1-8af3-8dc097c85202', 'word_count': 409, 'uri': 'nyt://article/3c37ff9a-d9fe-53e1-8af3-8dc097c85202'}, {'abstract': 'A huge landslide buried 83 workers at a gold mining site in western China on Friday, setting off a frantic rescue effort, China’s state-run Xinhua news agency reported.', 'web_url': 'https://www.nytimes.com/2013/03/30/world/asia/china-landslide-buries-workers-at-mine-in-tibet.html', 'snippet': 'A huge landslide buried 83 workers at a gold mining site in western China on Friday, setting off a frantic rescue effort, China’s state-run Xinhua news agency reported.', 'lead_paragraph': 'A huge landslide buried 83 workers at a gold mining site in western China on Friday, setting off a frantic rescue effort, China’s state-run Xinhua news agency reported. The government said more than 1,000 rescue workers had been called in to stabilize the area and search for the victims, who had been working at a subsidiary of the China Gold Group Corporation. The authorities said the landslide occurred in Maizhokunggar County, about 45 miles east of Lhasa, the capital of Tibet. There were no details about casualties.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'China: Landslide Buries Workers at Mine in Tibet', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'China: Landslide Buries Workers at Mine in Tibet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Barboza, David', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Tibet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mines and Mining', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Landslides and Mudslides', 'rank': 4, 'major': 'N'}, {'name': 'g