 York Times', 'multimedia': [], 'headline': {'main': 'A Universal Right to Vote', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Universal Right to Vote', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Voting Rights Act (1965)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Voter Registration and Requirements', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Miller, Candice S', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-03-12T01:18:12+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/be8f7234-0f33-5ebc-88e1-c541d7a2480f', 'word_count': 595, 'uri': 'nyt://article/be8f7234-0f33-5ebc-88e1-c541d7a2480f'}, {'abstract': 'Carmelo Anthony returned to the Knicks on Monday after missing three games because of a knee injury. On Wednesday he faces his former team, the Nuggets, in Denver.', 'web_url': 'https://www.nytimes.com/2013/03/12/sports/basketball/carmelo-anthony-will-return-to-lineup-then-to-denver.html', 'snippet': 'Carmelo Anthony returned to the Knicks on Monday after missing three games because of a knee injury. On Wednesday he faces his former team, the Nuggets, in Denver.', 'lead_paragraph': 'SAN FRANCISCO — Carmelo Anthony has been primed for his return: to the city he shunned, to the lineup that needs him, to a Knicks season that is teetering uncomfortab