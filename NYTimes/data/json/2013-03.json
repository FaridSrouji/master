ank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Puerto Ricans', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Queens Public Television', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Jackson Heights (Queens, NY)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-17T17:34:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Alex Vadukul', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Vadukul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f206318-e1f8-56d7-914c-9a55051e41e5', 'word_count': 869, 'uri': 'nyt://article/4f206318-e1f8-56d7-914c-9a55051e41e5'}, {'abstract': 'The comedy Web site intends to unveil “iSteve,” starring Justin Long, on April 15.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/17/funny-or-die-makes-a-steve-jobs-movie/', 'snippet': 'The comedy Web site intends to unveil “iSteve,” starring Justin Long, on April 15.', 'lead_paragraph': 'LOS ANGELES — Techies have been keeping a hot eye on dueling Steve Jobs biopics, one an indie starring Ashton Kutcher and the other, written by Aaron Sorkin, in the works at Sony, which made “The Social Network.”', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Funny or Die Makes a Steve Jobs Movie', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Funny or Die Web Site Makes a Steve Jobs Movie', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jobs, Steven P', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Long, Justin', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'FunnyOrDie.com', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-03-17T17:36:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35078b92-2e93-5336-9805-fc7056f7ab4d', 'word_count': 419, 'uri': 'nyt://article/35078b92-2e93-5336-9805-fc7056f7ab4d'}, {'abstract': 'The bipartisan group’s overhaul of an immigration law would decrease the amount of time it takes to become a naturalized citizen, but increase the wait for a green card.', 'web_url': 'https://www.nytimes.com/2013/03/18/us/politics/senate-groups-immigration-plan-would-alter-waiting-periods.html', 'snippet': 'The bipartisan group’s overhaul of an immigration law would decrease the amount of time it takes to become a naturalized citizen, but increase the wait for a green card.', 'lead_paragraph': 'WASHINGTON — The nation’s 11 million illegal immigrants would have to wait a full decade for a green card but could earn citizenship just three years after that, under a provision being finalized by a bipartisan group of eight senators working to devise an overhaul of immigration law, several people with knowledge of the negotiations said.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/us/IMMIG/IMMIG-articleLarge.jpg', 'height': 387, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/18/us/IMMIG/IMMIG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 387}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/18/us/IMMIG/IMMIG-jumbo.jpg', 'height': 660, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': No