-stocking set.', 'print_section': 'C', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22ARMORY_SPAN/ARMORY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/22/arts/22ARMORY_SPAN/ARMORY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22ARMORY_SPAN/ARMORY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22ARMORY_SPAN/ARMORY-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22ARMORY_SPAN/ARMORY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/22/arts/22ARMORY_SPAN/ARMORY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/22/arts/22ARMORY_SPAN/ARMORY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Space You Can Still Hear the Drones', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'In Space You Can Still Hear the Drones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Park Avenue Armory (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tommasini, Anthony', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'C