'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/business/retirementspecial/HOUSING1/HOUSING1-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/13/business/retirementspecial/HOUSING1/HOUSING1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/business/retirementspecial/HOUSING1/HOUSING1-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/business/retirementspecial/HOUSING1/HOUSING1-superJumbo.jpg', 'height': 1331, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/business/retirementspecial/HOUSING1/HOUSING1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/13/business/retirementspecial/HOUSING1/HOUSING1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/13/business/retirementspecial/HOUSING1/HOUSING1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Retiree Housing, Talking About Multigenerations', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Retiree Housing, Talking About Multigenerations', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Korkki, Phyllis', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Retirement Communities and Assisted Living', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cohousing Communities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Retirement', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ithaca (NY)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-12T23:00:03+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Retirement', 'byline': {'original': 'By Phyllis Korkki', 'person': [{'firstname': 'Phyllis', 'middlename': None, 'lastname': 'Korkki', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4ae14d77-5285-5146-b4e2-877918111324', 'word_count': 957, 'uri': 'nyt://article/4ae14d77-5285-5146-b4e2-877918111324'}, {'abstract': 'On its Web site, Windermere, a real estate firm, has begun using an online tool from Inrix, a company that does crowdsourced traffic estimates. It gives those looking for a home an hour-by-hour prediction of the drive times to their workplaces.', 'web_url': 'https://bits.blogs.nytimes.com/2013/03/12/predicting-commutes-more-accurately-for-would-be-home-buyers/', 'snippet': 'On its Web site, Windermere, a real estate firm, has begun using an online tool from Inrix, a company that does crowdsourced traffic estimates. It gives those looking for a home an hour-by-hour prediction of the drive times to their workplaces.', 'lead_paragraph': 'One of the first things people shopping for a house want to know is how agonizing the commute will be. It’s not that hard to get an idea of how bad the pain will be in this era of smartphones and apps. You can punch your work address into Google Maps while you’re standing in front of your dream house to get a ballpark estimate of how long you will spend in a car, on a bus or riding a bike to your office. A start-up called Walk Score even has a search engine that lets you find apartment listings within a selected commuting range — say, a half-hour by bus or 15 minutes by car. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/12/technology/12bits-drivetime/12bits-drivetime-jumbo.jpg', 'height': 484, 'width': 329, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/12/technology/12bits-drivetime/12bits-drivetime-superJumbo.jpg', 'height': 484, 'width': 329, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/12/technology/12bits-drivetime/12bits-drivetime-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/12/technology/12bits-drivetime/12bits-drivetime-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/12/technology/12bits-drivetime/12bits-drivetime-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Predicting Commutes More Accurately for Would-Be Home Buyers', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-03-12T23:28:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nick Wingfield', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Wingfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': N