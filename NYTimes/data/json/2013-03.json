mage', 'url': 'images/2013/03/20/world/asia/20-Modi-3D-IndiaINk/20-Modi-3D-IndiaINk-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Google Hosts Narendra Modi at Tech Summit', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Modi, Narendra', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Gujarat State (India)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-20T14:08:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Neha Thirani Bagri', 'person': [{'firstname': 'Neha', 'middlename': 'Thirani', 'lastname': 'Bagri', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c28820a6-9384-5357-823e-b0ffc77b6791', 'word_count': 732, 'uri': 'nyt://article/c28820a6-9384-5357-823e-b0ffc77b6791'}, {'abstract': 'Hugo Chávez, the leader of Venezuela who died recently, played a big role in elevating the quality of soccer in Venezuela.', 'web_url': 'https://goal.blogs.nytimes.com/2013/03/20/hugo-chavezs-unlikely-soccer-legacy/', 'snippet': 'Hugo Chávez, the leader of Venezuela who died recently, played a big role in elevating the quality of soccer in Venezuela.', 'lead_paragraph': 'In death, Hugo Chávez may conjure more debate and split more opinions than he ever did in life. Whether the former Venezuelan leader is remembered as a man of the people who brought millions out of extreme poverty or castigated as a deranged autocrat who drove his country in to debt and hyperinflation, the true measure of his time as a president will lie in the legacy and future he has left for Venezuela. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/sports/soccer/chavezmaradona/chavezmaradona-articleLarge.jpg', 'height': 363, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/20/sports/soccer/chavezmaradona/chavezmaradona-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 363}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/sports/soccer/chavezmaradona/chavezmaradona-jumbo.jpg', 'height': 620, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/sports/soccer/chavezmaradona/chavezmaradona-superJumbo.jpg', 'height': 1239, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/sports/soccer/chavezmaradona/chavezmaradona-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/20/sports/soccer/chavezmaradona/chavezmaradona-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/20/sports/soccer/chavezmaradona/chavezmaradona-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hugo Chávez’s Unlikely Soccer Legacy', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World Cup 2014 (Soccer)', 'ran