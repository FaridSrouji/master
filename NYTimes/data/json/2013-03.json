-v2.jpg', 'height': 635, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/14/world/europe/Vatican-1/Vatican-1-superJumbo-v2.jpg', 'height': 1271, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/14/world/europe/Vatican-1/Vatican-1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/14/world/europe/Vatican-1/Vatican-1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/14/world/europe/Vatican-1/Vatican-1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Conservative With a Common Touch', 'kicker': 'Man in the News | Jorge Mario Bergoglio', 'content_kicker': None, 'print_headline': 'A Conservative With a Common Touch', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Francis', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ARGENTINA', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-14T00:03:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Emily Schmall and Larry Rohter', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': 'Schmall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Larry', 'middlename': None, 'lastname': 'Rohter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30e1e46a-5b6d-558a-a328-7600a7418354', 'word_count': 1324, 'uri': 'nyt://article/30e1e46a-5b6d-558a-a328-7600a7418354'}, {'abstract': 'David Wright, a Met, and Robinson Cano, a Yankee, have led their teams — the United States and the Dominican Republic — to strong showings in the tournament.', 'web_url': 'https://www.nytimes.com/2013/03/14/sports/baseball/wright-and-cano-bring-new-york-flair-to-world-baseball-classic.html', 'snippet': 'David Wright, a Met, and Robinson Cano, a Yankee, have led their teams — the United States and the Dominican Republic — to strong showings in the tournament.', 'lead_paragraph': 'MIAMI — While David Wright drove in five runs for the United States in the World Baseball Classic on Tuesday night, Robinson Cano went to the Miami Heat game with some of his Dominican Republic teammates. Cano sat courtside, underneath the basket near the Heat bench, and watched LeBron James generate 15 points, 7 rebounds and 7 assists on what was considered an off night. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/14/sports/14wbc-wright/14wbc-wright-articleLarge.jpg', 'height': 396, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/14/sports/14wbc-wright/14wbc-wright-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 396}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/14/sports/14wbc-wright/14wbc-wright-jumbo.jpg', 'height': 676, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/14/sports/14wbc-wright/14wbc-wright-superJumbo.jpg', 'height': 1352, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}