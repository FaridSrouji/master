t_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARTERIOSCLEROSIS AND ATHEROSCLEROSIS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mummies and Mummification', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Peru', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-11T00:19:25+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Nicholas Bakalar', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Bakalar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2023d78a-9044-5981-b7ed-f02840ce3299', 'word_count': 376, 'uri': 'nyt://article/2023d78a-9044-5981-b7ed-f02840ce3299'}, {'abstract': 'A 29-year-old student says he was abducted from Kandahar University in an episode cited by President Hamid Karzai as he rebuked American forces and banned them from Afghan schools.', 'web_url': 'https://www.nytimes.com/2013/03/11/world/asia/afghan-says-he-was-beaten-by-cia-trained-force.html', 'snippet': 'A 29-year-old student says he was abducted from Kandahar University in an episode cited by President Hamid Karzai as he rebuked American forces and banned them from Afghan schools.', 'lead_paragraph': 'KANDAHAR, Afghanistan — The 29-year-old engineering student was standing outside his classroom here on Saturday morning when he said two pickup trucks full of armed men pulled up. The men, said to be members of a C.I.A.-backed Afghan strike force, grabbed him, tied his hands behind his back, draped a black hood over his head and drove him to an undisclosed location where, the student says, he was beaten and whipped.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Afghan Says Force Backed by the C.I.A. Beat Him', 'kicker': None, 'content_kicker': None, 'print_headline': 'Afghan Says Force Backed By the C.I.A. Beat Him', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Shah, Taimoor', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ahmed, Azam', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Kandahar (Afghanistan)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Karzai, Hamid', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-03-11T00:26:14+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Taimoor Shah and Azam Ahmed', 'person': [{'firstname': 'Taimoor', 'middlename': None, 'lastname': 'Shah', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Azam', 'middlename': None, 'lastname': 'Ahmed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e88a0d34-672f-5cbd-8274-974d54f51b3d', 'word_count': 711, 'uri': 'nyt://article/e88a0d34-672f-5cbd-8274-974d54f51b3d'}, {'abstract': 'Elliot Driben, who suffers from cerebral palsy, has attended more than 5,000 B.U. sporting events and has earned honors and reciprocal loyalty from the university community.', 'web_url': 'https://www.nytimes.com/2013/03/11/sports/elliot-driben-is-the-caretaker-of-boston-university-athletics.html', 'snippet': 'Elliot Driben, who suffers from cerebral palsy, has attended more than 5,000 B.U. sporting events and has earned honors and reciprocal loyalty from the university community.', 'lead_paragraph': 'BOSTON — In Section 111, Row Q, Seat 1, above a corner of the Agganis Arena ice, a gray-haired man observed the action. Wearing a scarlet team jacket and a white Friends of Boston University Hockey cap pulled over enormous eyeglasses with brown frames, he was easy to miss. A trumpeter’s brief toot from the opposite end of the rink projected greater sound than the man’s enthusiastic clapping after each Terriers goal in a victory against Merrimack.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/sports/11bu-pic1/11bu-pic1-articleLarge-v2.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/11/sports/11bu-pic1/11bu-pic1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/sports/11bu-pic1/11bu-pic1-jumbo-v2.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/sports/11bu-pic1/11bu-pic1-superJumbo-v2.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/11/sports/11bu-pic1/11bu-pic1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/11/sports/11bu-pic1/11bu-pic1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'i