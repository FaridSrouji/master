/books/review/0317-Cover/0317-Cover-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/17/books/review/0317-Cover/0317-Cover-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/books/review/0317-Cover/0317-Cover-jumbo.jpg', 'height': 860, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/books/review/0317-Cover/0317-Cover-superJumbo.jpg', 'height': 1720, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/books/review/0317-Cover/0317-Cover-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/17/books/review/0317-Cover/0317-Cover-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/17/books/review/0317-Cover/0317-Cover-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bride of Hades', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bride of Hades', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'King, Stephen', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Oates, Joyce Carol', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-14T20:54:23+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Stephen King', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'King', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c2406494-57df-5c28-8711-6ff129b16c8a', 'word_count': 1620, 'uri': 'nyt://article/c2406494-57df-5c28-8711-6ff129b16c8a'}, {'abstract': '92YTribeca opened in October 2008 but is no longer seen as “critical to our mission.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/03/14/92nd-street-y-to-leave-its-downtown-space/', 'snippet': '92YTribeca opened in October 2008 but is no longer seen as “critical to our mission.”', 'lead_paragraph': 'The 92nd Street Y will leave its space at 200 Hudson Street, known as 92YTribeca, because “a second, physical location is not critical to our mission,” according to a letter sent Thursday afternoon to the workers at both sites. The decision was made by the 92nd Street Y board Wednesday night. The 92nd Street Y expects to be out of the Hudson Street space sometime this summer, according to the letter signed by Sol Adler, the Y’s executive director. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '92nd Street Y to Leave Its Downtown Space', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Adler, Sol', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Ninety-Second Street Y', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-03-14T21:00:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f4bb491-9381-5dbb-8966-f538a3a899c1', 'word_count': 255, 'uri': 'nyt://article/7f4bb491-9381-5dbb-8966-f538a3a899c1'}, {'abstract': 'We caught up with one of the stars from HBO’s hit series “Girls” for an exclusive peek at her own beauty look book.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/03/14/asked-answered-allison-williams/', 'snippet': 'We caught up with one of the stars from HBO’s hit series “Girls” for an exclusive peek at her own beauty look book.', 'lead_paragraph': 'Allison Williams, from HBO’s hit series “Girls,” has got that whole enviable Brooke Shields beauty thing going on. As the polished but somewhat angst-ridden Marnie on the show, her character is a little more disheveled. We caught up with Williams in New York for an exclusive peek at her own beauty look book. The season finale of “Girls” is this Sunday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Asked & Answered | Allison Williams', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cosmetics and Toiletries', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Allison (1988- )', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Bushwick (Brooklyn, NY)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Girls (TV Program)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-03-14T21:00:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Julie Earle-Levine', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Earle-Levine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d3d6b905-76f8-587d-857f-3de96de1e19d', 'word_count': 876, 'uri': 'nyt://article/d3d6b905-76f8-587d-857f-3de96de1e19d'}, {'abstract': 'JPMorgan Chase ignored internal controls and manipulated documents, as the nation’s biggest