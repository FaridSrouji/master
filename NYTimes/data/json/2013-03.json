/31APPCITY/31APP-CITY-superJumbo.jpg', 'height': 1124, 'width': 1124, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/nyregion/31APPCITY/31APP-CITY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/31/nyregion/31APPCITY/31APP-CITY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/31/nyregion/31APPCITY/31APP-CITY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Ride Home That’s Not a Taxi, Maybe', 'kicker': 'App City', 'content_kicker': None, 'print_headline': 'A Ride Home That’s Not a Taxi, Maybe', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Brustein, Joshua', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Taxicabs and Taxicab Drivers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Car-Pooling and Ride-Sharing', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Side.Cr LLC', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-03-30T02:14:35+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joshua Brustein', 'person': [{'firstname': 'Joshua', 'middlename': None, 'lastname': 'Brustein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf7692fc-89bb-5300-acec-bddd641c5d1a', 'word_count': 609, 'uri': 'nyt://article/bf7692fc-89bb-5300-acec-bddd641c5d1a'}, {'abstract': 'The operator of the stricken Fukushima Daiichi nuclear power plant acknowledged Friday that it had been ill prepared for the tsunami that swept over the site two years ago.', 'web_url': 'https://www.nytimes.com/2013/03/30/world/asia/japan-nuclear-plants-operator-cites-poor-preparation.html', 'snippet': 'The operator of the stricken Fukushima Daiichi nuclear power plant acknowledged Friday that it had been ill prepared for the tsunami that swept over the site two years ago.', 'lead_paragraph': ' The operator of the stricken Fukushima Daiichi nuclear power plant acknowledged Friday that it had been ill prepared for the tsunami that swept over the site two years ago. “Though it was difficult to anticipate a giant tsunami, we should not simply blame nature for this accident,” said a report prepared by an internal task force of the plant’s operator, the Tokyo Electric Power Company. “We must sincerely accept that we were unable to draw on human wisdom to prevent it.” The acknowledgment was a reversal from the company’s earlier assertion that the waves were bigger than it could have predicted. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Japan: Nuclear Plant’s Operator Cites Poor Preparation', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'Japan: Nuclear Plant’s Operator Cites Poor Preparation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Japan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Japan Earthquake and Tsunami (2011)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fukushima Daiichi Nuclear Power Plant (Japan)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Energy', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Tokyo Electric Power Co', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-03-30T02:15:06+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Hiroko Tabuchi', 'person': [{'firstname': 'Hiroko', 'middlename': None, 'lastname': 'Tabuchi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/9dd146ce-88f3-5068-8d15-f2cbbe57859e', 'word_count': 101, 'uri': 'nyt://article/9dd146ce-88f3-5068-8d15-f2cbbe57859e'}, {'abstract': 'Cyprus is struggling to comply with the conditions that Europe is demanding of it before it gets a desperately needed 10 billion euro loan.', 'web_url': 'https://www.nytimes.com/2013/03/30/business/global/some-savers-in-cyprus-may-lose-60-percent.html', 'snippet': 'Cyprus is struggling to comply with the conditions that Europe is demanding of it before it gets a desperately needed 10 billion euro loan.', 'lead_paragraph': 'LONDON — Big-ticket savers at the Bank of Cyprus may be forced to accept losses on their deposits that exceed 60 percent in order to keep the stricken bank afloat, bankers briefed on the negotiations said on Friday.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/business/30cyprus_inline/30cyprus_inline-articleLarge.jpg', 'height': 439, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/03/30/business/30cyprus_inline/30cyprus_inline-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 439}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/business/30cyprus_inline/30cyprus_inline-jumbo.jpg', 'height': 749, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/30/business/30cyprus_inline/30cyprus_inline-