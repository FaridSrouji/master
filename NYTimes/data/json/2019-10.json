_0849be5e-eecd-4478-860a-3262bcafddf3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/27/arts/27silicon-valley1/merlin_163120014_0849be5e-eecd-4478-860a-3262bcafddf3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/27/arts/27silicon-valley1/merlin_163120014_0849be5e-eecd-4478-860a-3262bcafddf3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/27/arts/27silicon-valley1/merlin_163120014_0849be5e-eecd-4478-860a-3262bcafddf3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/27/arts/27silicon-valley1/27silicon-valley1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/27/arts/27silicon-valley1/27silicon-valley1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/27/arts/27silicon-valley1/27silicon-valley1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Silicon Valley,’ Darker Than Ever, Captures the Bleak Mood of Tech', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside Tech’s Valley of Darkness', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Silicon Valley (TV Program)', 'rank': 2, 'major': 'N'}, {'name': 'subject', '