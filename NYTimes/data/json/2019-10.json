firstname': 'Stephen', 'middlename': None, 'lastname': 'Castle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a75eca42-63d8-53e5-b5e2-1407493426eb', 'word_count': 1188, 'uri': 'nyt://article/a75eca42-63d8-53e5-b5e2-1407493426eb'}, {'abstract': 'The Vermont senator had two stents inserted in an artery after experiencing chest discomfort at an event. His campaign canceled his events and said he would be resting for several days.', 'web_url': 'https://www.nytimes.com/2019/10/02/us/politics/bernie-sanders-health.html', 'snippet': 'The Vermont senator had two stents inserted in an artery after experiencing chest discomfort at an event. His campaign canceled his events and said he would be resting for several days.', 'lead_paragraph': 'Senator Bernie Sanders was recovering in a Las Vegas hospital on Wednesday after being treated for blockage of an artery, forcing him to cancel his events in the coming days and casting uncertainty over a candidacy already struggling to win new voters.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/02/us/politics/02sandershealth-promo/02sandershealth-promo-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/02/us/politics/02sandershealth-promo/02sandershealth-promo-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/02/us/politics/02sandershealth-promo/02sandershealth-promo-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10