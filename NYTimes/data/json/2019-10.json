 'organizations', 'value': 'Conservative Party (Great Britain)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Unionist Party (Northern Ireland)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Labour Party (Great Britain)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Boris', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Northern Ireland', 'rank': 11, 'major': 'N'}], 'pub_date': '2019-10-18T15:47:20+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Stephen Castle', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Castle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65e2021c-6488-5ad0-9b3c-ecc0f5a07f15', 'word_count': 1244, 'uri': 'nyt://article/65e2021c-6488-5ad0-9b3c-ecc0f5a07f15'}, {'abstract': 'Most L.G.B.T.Q. adults could not openly explore their sexuality as children, but the Netflix series provides a template (and hope) for future generations.', 'web_url': 'https://www.nytimes.com/2019/10/18/opinion/big-mouth.html', 'snippet': 'Most L.G.B.T.Q. adults could not openly explore their sexuality as children, but the Netflix series provides a template (and hope) for future generations.', 'lead_paragraph': 'At first glance, Matthew of “Big Mouth,” Netflix’s adult animated series about puberty, appears to be a gay stereotype, a queer foil off which the more important characters can play. He’s flamboyant, snarky and judgmental, even running a tabloid-like morning gossip broadcast at school.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'su