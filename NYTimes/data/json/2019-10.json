: 'images/2019/10/24/us/politics/24dc-mulvaney/merlin_162859608_75ec1557-7afa-4ab1-bca1-00f9e311eb74-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/24/us/politics/24dc-mulvaney/merlin_162859608_75ec1557-7afa-4ab1-bca1-00f9e311eb74-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/24/us/politics/24dc-mulvaney/merlin_162859608_75ec1557-7afa-4ab1-bca1-00f9e311eb74-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Conservatives Voice Support for Mulvaney', 'kicker': None, 'content_kicker': None, 'print_headline': 'Activists On Right Rally to Aid Mulvaney', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Trump-Ukraine Whistle-blower Complaint and Impeachment Inquiry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mulvaney, Mick', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Impeachment', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-10-25T00:33:55+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Maggie Haberman', 'person': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f67d0c2-fba8-5e56-aec7-6d82185d92f4', 'word_count': 521, 'uri': 'nyt://article/5f67d0c2-fba8-5e56-aec7-6d82185d92f4'}, {'abstract': '“We failed in our final game, but it wasn’t a failed season,” the general manager said in a wrap-up news conference for the 2019 season. Manager Aaron Boone was less sanguine about the A.L.C.S. loss.', 'web_url': 'https://www.nytimes.com/2019/10/24/sports/baseball/brian-cashman-yankees-future.html', 'snippet': '“We failed in our final game, but it wasn’t a failed season,” the general manager said in a wrap-up news conference for the 2019 season. Manager Aaron Boone was less sanguine about the A.L.C.S. loss.', 'lead_paragraph': 'It has been almost a week since Jose Altuve’s monster home run ended the Yankees’ season, and yet Aaron Boone hasn’t moved on. Images from Game 6 of the American League Championship Series are stuck in a painful loop in the manager’s memory bank: Aroldis Chapman’s hanging slider, Altuve sending it over the left-field wall and the Astros mobbing him at home plate, kicking off a party on Saturday that made it that much tougher for the Yankees to accept the stunning 6-4 loss.', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/25/sports/24yankees-print/merlin_162756954_269ee0d2-7193-473a-a845-3c337716c6cf-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/25/sports/24yankees-print/merlin_162756954_269ee0d2-7193-473a-a845-3c337716c6cf-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/25/sports/24yankees-print/merlin_162756954_269ee0d2-7193-473a-a845-3c337716c6cf-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/25/sports/24yankees-print/merlin_162756954_269ee0d2-7193-473a-a845-3c337716c6cf-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/25/sports/24yankees-print/merlin_162756954_269ee0d2-7193-473a-a845-3c337716c6cf-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/25/sports/24yankees-print/merlin_162756954_269ee0d2-7193-473a-a845-3c337716c6cf-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/25/sports/24yankees-print/merlin_162756954_269ee0d2-7193-473a-a845-3c337716c6cf-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Brian Cashman, Yankees’ Sad Ending Won’t Mean a Roster Reboot', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Yankees Consider What Might Have Been', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Free Agents (Sports)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Boone, Aaron', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cashman, Brian', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-10-25T00:56:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Bob Klapisch', 'person': [{'firstname': 'Bob', 'middlename': None, 'lastname': 'Klapisch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bbf5f0c4-1e92-5409-8f2b-0abffa9b0f53', 'word_count': 852, 'uri': 'nyt://article/bbf5f0c4-1e92-5409-8f2b-0abffa9b0f53'}, {'abstract': 'I have a proposal that is supported not just by environmentalists but also by labor and large automakers.', 'web_url': 'https://www.nytimes.com/2019/10/24/opinion/chuck-schumer-electric-car.html', 'snippet': 'I have a proposal that is supported not just by environmentalists but also by labor and large automakers.', 'lead_paragraph': 'Scientists tell us that to avoid the most devastating effects of climate change, the world needs to be carbon neutral — to have net-zero carbon dioxide emissions — by midcentury. At the moment, we are not remotely on track to meet that target. We need to act urgently and ambitiously, which will require building diverse coalitions of political support.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chuck Schumer: A Bold Plan for Clean Cars', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Bold Plan for Zero-Emission Cars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Electric and Hybrid Vehicles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-10-25T01:00:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Chuck Schumer', 'person': [{'firstname': 'Chuck', 'middlename': None, 'lastname': 'Schumer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/dbf7426d-7d1b-5449-9593-c485a8ccb1b6', 'word_count': 752, 'uri': 'nyt://article/dbf7426d-7d1b-5449-9593-c485a8ccb1b6'}, {'abstract': 'A $450 billion climate change proposal from Senator Chuck Schumer would give consumers vouchers to buy American-made electric and hybrid cars and trucks.', 'web_url': 'https://www.nytimes.com/2019/10/24/climate/climate-change-schumer-electric-cars.html', 'snippet': 'A $450 billion climate change proposal from Senator Chuck Schumer would give consumers vouchers to buy American-made electric and hybrid cars and trucks.', 'lead_paragraph': 'WASHINGTON — Senator Chuck Schumer of New York, the Democratic leader, is preparing a $450 billion climate change initiative that aims to replace about a fifth of the nation’s traditional gasoline-powered vehicles with hybrid, electric or hydrogen fuel-cell cars and trucks in the next 10 years.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/24/climate/24CLI-SCHUMER/24CLI-SCHUMER-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/24/climate/24CLI-SCHUMER/24CLI-SCHUMER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/24/climate/24CLI-SCHUMER/24CLI-SCHUMER-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/24/climate/24CLI-SCHUMER/24CLI-SCHUMER-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/24/climate/24CLI-SCHUMER/24CLI-SCHUMER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/24/clima