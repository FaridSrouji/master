major': 'N'}, {'name': 'glocations', 'value': 'Williamsburg (Brooklyn, NY)', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-10-18T17:00:17+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Alice Newell-Hanson', 'person': [{'firstname': 'Alice', 'middlename': None, 'lastname': 'Newell-Hanson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f95d7d9-8714-5e92-9bb8-74019d09282f', 'word_count': 1105, 'uri': 'nyt://article/0f95d7d9-8714-5e92-9bb8-74019d09282f'}, {'abstract': 'Every sport needs a good commentator, and these shows offer everything from postgame analysis to historical storytelling.', 'web_url': 'https://www.nytimes.com/2019/10/18/arts/sports-podcasts.html', 'snippet': 'Every sport needs a good commentator, and these shows offer everything from postgame analysis to historical storytelling.', 'lead_paragraph': 'Commentary is integral to sports, and some of the best commentary out there now exists in podcast form. Whatever your game or your team, you can find a show — or several — with tailored postgame analysis, while other podcasts offer a deep dive into news stories with implications beyond sports itself, like China’s clash with the N.B.A. And since it was true crime that brought podcasting into the mainstream, it’s no surprise that there are also plenty of deeply reported audio documentaries exploring the darker side of athleticism, including the death of Aaron Hernandez and the disgraced guru behind Bikram yoga.', 'print_section': 'AR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/arts/20SportsPodcasts/20SportsPodcasts-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/20/arts/20SportsPodcasts/20SportsPodcasts-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/arts/20SportsPodcasts/20SportsPodcasts-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/arts/20SportsPodcasts/20SportsPodcasts-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/arts/20SportsPodcasts/20SportsPodcasts-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/20/arts/20SportsPodcasts/20SportsPodcasts-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/arts/20SportsPodcasts/20SportsPodcasts-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '7 Podcasts for the Sports Fan', 'kicker': None, 'content_kicker': None, 'print_headline': 'It’s the Wide World  Of Sports, in Audio', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Podcasts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Choudhury, Bikram', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Simmons, Bill (1969- )', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': '30 for 30 (Radio Program)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Against the Rules with Michael Lewis (Radio Program)', 'rank': 6, 'major': '