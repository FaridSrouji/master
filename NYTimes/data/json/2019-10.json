.jpg', 'height': 1024, 'width': 854, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24surfacing-koolherc1/18surfacing-koolherc1-superJumbo.jpg', 'height': 2048, 'width': 1707, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24surfacing-koolherc1/18surfacing-koolherc1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/24/arts/24surfacing-koolherc1/18surfacing-koolherc1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24surfacing-koolherc1/18surfacing-koolherc1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'This Hip-Hop Legend’s True Passion? Kites', 'kicker': None, 'content_kicker': None, 'print_headline': 'Before the Breakbeat, A Hip-Hop Legend Took to the Sky', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kites', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-10-18T15:05:49+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Walter Thompson-Hernández and Tonje Thilesen', 'person': [{'firstname': 'Walter', 'middlename': None, 'lastname': 'Thompson-Hernández', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Tonje', 'mid