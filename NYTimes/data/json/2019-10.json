lin_162489783_81693ceb-9ed1-4020-b578-fe3438d79486-jumbo.jpg', 'height': 718, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/17/arts/17jojorabbit/merlin_162489783_81693ceb-9ed1-4020-b578-fe3438d79486-superJumbo.jpg', 'height': 1435, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/17/arts/17jojorabbit/17jojorabbit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/17/arts/17jojorabbit/17jojorabbit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/17/arts/17jojorabbit/17jojorabbit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Jojo Rabbit’ Review: The Third Reich Wasn’t All Fun and Games', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Third Reich Wasn’t All Fun and Games', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Jojo Rabbit (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Waititi, Taika', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Roman Griffin', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-10-17T18:18:29+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0254550c-1f03-56f5-89f3-0f2f0b4629a2', 'word_count': 789, 'uri': 'nyt://article/0254550c-1f03-56f5-89f3-0f2f0b4629a2'}, {'abstract': 'In a new book, the photographer revisits his images of properties owned by Ugo Rondinone, Rick Owens and Dries Van Noten.', 'web_url': 'https://www.nytimes.com/slideshow/2019/10/17/t-magazine/design/francois-halards-intimate-photographs-of-artists-and-designers-living-spaces.html', 'snippet': 'In a new book, the photographer revisits his images of properties owned by Ugo Rondinone, Rick Owens and Dries Van Noten.', 'lead_paragraph': 'In a new book, the photographer revisits his images of properties owned by Ugo Rondinone, Rick Owens and Dries Van Noten.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-M8LX/francois-halard-slide-M8LX-articleLarge.jpg', 'height': 764, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/16/t-magazine/design/francois-halard-slide-M8LX/francois-halard-slide-M8LX-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 764}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-M8LX/francois-halard-slide-M8LX-jumbo.jpg', 'height': 1024, 'width': 805, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-M8LX/francois-halard-slide-M8LX-superJumbo.jpg', 'height': 2048, 'width': 1610, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-M8LX/francois-halard-slide-M8LX-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/16/t-magazine/design/francois-halard-slide-M8LX/francois-halard-slide-M8LX-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-M8LX/francois-halard-slide-M8LX-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'François Halard’s Intimate Photographs of Artists’ and Designers’ Living Spaces', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-10-17T18:20:38+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Design & Interiors', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/b0174e43-7cd9-5385-8c12-ab36362bf0a6', 'word_count': 0, 'uri': 'nyt://slideshow/b0174e43-7cd9-5385-8c12-ab36362bf0a6'}, {'abstract': 'The photographer François Halard’s new book documents the private spaces of some of the world’s most influential creative forces.', 'web_url': 'https://www.nytimes.com/2019/10/17/t-magazine/francois-halard.html', 'snippet': 'The photographer François Halard’s new book documents the private spaces of some of the world’s most influential creative forces.', 'lead_paragraph': 'To understand François Halard’s vision, you need look no further than his own home in the Provençal city of Arles. The French interiors and architecture photographer, who has spent more than 40 years documenting the private spaces of artists and designers, has had a residence in the city since the ’90s. Formerly inhabited by a single aristocratic family, Halard’s early 18th-century hôtel particulier has become a living record of his own tastes and obsessions. With its original hand-painted canvas wall coverings depicting the goddess Athena, displays of African masks, Picasso lithographs, Giacometti plaster lamps and Brassaï prints, it’s a fascinating footnote to his vast body of photographic work. “It was totally decaying when I first saw it,” he says of the building. “It had the same sensibility as the photographs I’d seen of Cy Twombly’s house as a teenager. I fell in love with it.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-B3G4/francois-halard-slide-B3G4-articleLarge.jpg', 'height': 764, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/16/t-magazine/design/francois-halard-slide-B3G4/francois-halard-slide-B3G4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 764}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-B3G4/francois-halard-slide-B3G4-jumbo.jpg', 'height': 1024, 'width': 805, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-B3G4/francois-halard-slide-B3G4-superJumbo.jpg', 'height': 2048, 'width': 1609, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/francois-halard-slide-B3G4/francois-halard-slide-B3G4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/16/t-magazine/design/francois-halard-slide-B3G4/francois-halard-slide-B3G4-thumbStandard.jpg', 'thumb