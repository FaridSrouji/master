r': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 10, 'major': 'N'}], 'pub_date': '2019-10-17T18:58:30+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Sarah Kerr and Maya Blackstone', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Kerr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Maya', 'middlename': None, 'lastname': 'Blackstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/d330667e-cb5f-5e28-89c9-bea91384aa2d', 'word_count': 0, 'uri': 'nyt://video/d330667e-cb5f-5e28-89c9-bea91384aa2d'}, {'abstract': 'The benefits do not come close to outweighing the risks.', 'web_url': 'https://www.nytimes.com/2019/10/17/opinion/facial-recognition-ban.html', 'snippet': 'The benefits do not come close to outweighing the risks.', 'lead_paragraph': 'Facial recognition technology, once a darling of Silicon Valley with applications for policing, spying and authenticating identities, is suddenly under fire. Conservative Republicans like Representative Jim Jordan of Ohio and liberal Democrats like Representative Alexandria Ocasio-Cortez of New York have strongly criticized the technology. San Francisco, Oakland, Berkeley and Somerville, Mass., have barred all of their government agencies, including the police, from using it. And several Democratic candidates for president have raised deep concerns about it, with one, Senator Bernie Sanders, calling for an outright ban for policing. ', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/07/opinion/sunday/07selinger/07selinger-articleLarge.jpg', 'height': 588, 'width': 600, 'subType': 'xlarge', 'crop_name': 'a