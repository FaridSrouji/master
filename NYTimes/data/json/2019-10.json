: 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/fashion/18LOVE-DOORMAN1/merlin_161949240_48f73248-f4d0-44c2-8e2e-083633bc3df8-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/fashion/18LOVE-DOORMAN1/merlin_161949240_48f73248-f4d0-44c2-8e2e-083633bc3df8-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/fashion/18LOVE-DOORMAN1/18LOVE-DOORMAN1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/20/fashion/18LOVE-DOORMAN1/18LOVE-DOORMAN1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/fashion/18LOVE-DOORMAN1/18LOVE-DOORMAN1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'To Her, He Was More Than a Doorman', 'kicker': 'MODERN LOVE', 'content_kicker': None, 'print_headline': 'To Her, He Was More Than a Doorman', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-10-18T04:00:02+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Daniel Jones', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Jones', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf452a58-6aba-5759-84f1-18ba5139e48a', 'word_count': 1274, 'uri': 'nyt://article/bf452a58-6aba-5759-84f1-18ba5139e48a'}, {'abstract': 'The popular column, which began in 2004, has become a podcast, a book and an Amazon Prime streaming series. Here are some of its greatest hits.', 'web_url': 'https://www.nytimes.com/2019/10/18/style/essential-modern-love-essays.html', 'snippet': 'The popular column, which began in 2004, has become a podcast, a book and an Amazon Prime streaming series. Here are some of its greatest hits.', 'lead_paragraph': 'Whether you’re new to Modern Love or a longtime fan, we think you’ll enjoy this collection of some of our most memorable essays. You’ll find some of our most read and most shared of all time, and others that really got readers talking (and tweeting, and sharing). We present, in no particular order, the quirky, the profound, the head scratching and the heartbreaking. (A handful of these essays and dozens more of our most memorable columns can also be found in the Modern Love anthology.)', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/11/26/fashion/26ODE/26ODE-articleLarge.jpg', 'height': 756, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/11/26/fashion/26ODE/26ODE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 756}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/11/26/fashion/26ODE/26ODE-jumbo.jpg', 'height': 1024, 'width': 813, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/11/26/fashion/26ODE/26ODE-superJumbo.jpg', 'height': 2048, 'width': 1626, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/11/26/fashion/26ODE/26ODE-thumbStandard-v2.jpg', 'height': 75, 'width': 75, '