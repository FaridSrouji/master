uerra/13guerra-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/13/opinion/sunday/13guerra/13guerra-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cuban Women Await Their #MeToo Moment', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cuban Women Need a Revolution', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Women's Rights", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': '#MeToo Movement', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Castro, Fidel', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-10-12T18:29:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Wendy Guerra', 'person': [{'firstname': 'Wendy', 'middlename': None, 'lastname': 'Guerra', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/86f50283-ad79-597a-aa6d-78d8ca254783', 'word_count': 1227, 'uri': 'nyt://article/86f50283-ad79-597a-aa6d-78d8ca254783'}, {'abstract': 'There might be fewer arguments about bathrooms, for starters.', 'web_url': 'https://www.nytimes.com/2019/10/12/opinion/sunday/what-if-the-supreme-court-had-an-lgbt-justice.html', 'snippet': 'There might be fewer arguments about bathrooms, for starters.', 'lead_paragraph': 'Near the end of this year’s hit Broadway show “What the Constitution Means to Me,” the audience hears a scratchy old recording of an oral argument at the Supreme Court. The year is 1965, and the justices are debating the topic of married women’s right to birth control. Or that’s the idea, anyway;\xa0for what feels like an eternity, the nine black-robed men do little but stammer and clear their throats.', 'print_section': 'SR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/13/opinion/13lbgt_sub/13lbgt_sub-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/13/opinion/13lbgt_sub/13lbgt_sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/13/opinion/13lbgt_sub/13lbgt_sub-jumbo.jpg', 'height': 631, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/13/opinion/13lbgt_sub/13lbgt_sub-superJumbo.jpg', 'height': 865, 'width': 1404, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/13/opinion/13lbgt_sub/13lbgt_sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/13/opinion/13lbgt_sub/13lbgt_sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/13/opinion/13lbgt_sub/13lbgt_sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What if the Supreme Court Had an L.G.B.T. Justice?', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Supreme Court Needs an L.G.B.T. Justice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 1, 'major': 'N'}, {'name':