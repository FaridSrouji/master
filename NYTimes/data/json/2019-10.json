bLarge', 'legacy': {}}], 'headline': {'main': 'Syria, N.B.A., Nobels: Your Monday Evening Briefing', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-10-07T22:07:09+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Victoria Shannon and Hiroko Masuike', 'person': [{'firstname': 'Victoria', 'middlename': None, 'lastname': 'Shannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Hiroko', 'middlename': None, 'lastname': 'Masuike', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/5829bae5-07f2-574e-93b1-a36f0e65f07b', 'word_count': 1113, 'uri': 'nyt://article/5829bae5-07f2-574e-93b1-a36f0e65f07b'}, {'abstract': 'Judge Tammy Kemp said she turned to her faith when a former Dallas police officer asked her for advice and a hug in the courtroom. Not everyone is happy with that.', 'web_url': 'https://www.nytimes.com/2019/10/07/us/tammy-kemp-amber-guyger.html', 'snippet': 'Judge Tammy Kemp said she turned to her faith when a former Dallas police officer asked her for advice and a hug in the courtroom. Not everyone is happy with that.', 'lead_paragraph': 'Judge Tammy Kemp is a woman of faith. For more than 25 years, she has attended the same church in Dallas, where she serves as a deaconess. She keeps a Bible in her chambers, positioned on top of her laptop to remind herself to start her day with prayer. And she believes in redemption: In her courtroom, she encourages defendants to use their time in prison to remake their lives.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/07/us/00GUYGER-JUDGE/merlin_162021990_2528