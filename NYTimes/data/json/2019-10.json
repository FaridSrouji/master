il an enemy thus defined was exterminated.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/opinion/16Snyder/16Snyder-articleLarge.jpg', 'height': 899, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/16/opinion/16Snyder/16Snyder-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 899}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/opinion/16Snyder/16Snyder-jumbo.jpg', 'height': 1024, 'width': 684, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/opinion/16Snyder/16Snyder-superJumbo.jpg', 'height': 2048, 'width': 1367, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/opinion/16Snyder/16Snyder-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/16/opinion/16Snyder/16Snyder-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/opinion/16Snyder/16Snyder-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Hitler Pioneered ‘Fake News’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Propaganda', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hitler, Adolf', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': '