one, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/books/17MEANY-COMBO/00HEANY-COMBO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When James Baldwin Squared Off Against William F. Buckley Jr.', 'kicker': 'Nonfiction', 'content_kicker': None, 'print_headline': 'Battle Cry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Fire Is upon Us: James Baldwin, William F. Buckley Jr., and the Debate over Race in America (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Buccola, Nicholas', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Baldwin, James (1924-87)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Buckley, William F Jr', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights Movement (1954-68)', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Sixties', 'rank': 11, 'major': 'N'}], 'pub_date': '2019-10-18T20:18:19+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Thomas Meaney', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Meaney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/17333cb0-11d3-5f2b-b0d2-6cb6ff9fe8f4', 'word_count': 1573, 'uri': 'nyt://article/17333cb0-11d3-5f2b-b0d2-6cb6ff9fe8f4'}, {'abstract': '“Collected Poems of Bob Kaufman” showcases the poet’s distinctive and subversive voice, and Reginald Dwayne Betts’s sensitive third collection, “Felon,” finds the writer in transition.', 'web_url': 'https://www.nytimes.com/2019/10/18/books/review-collected-poems-bob-kaufman-felon-reginald-dwayne-betts.html', 'snippet': '“Collected Poems of Bob Kaufman” showcases the poet’s distinctive and subversive voice, and Reginald Dwayne Betts’s sensitive third collection, “Felon,” finds the writer in transition.', 'lead_paragraph': '“I am writing the Great American Suicide Note,” Bob Kaufman (1925-1986) once declared. He was a street poet, an African-American surrealist and one of the original Beats — he founded a magazine with Allen Ginsberg. Kaufman had a natural aptitude for subversion and distinctive utterance. He was arrested umpteen times in San Francisco on disorderly charges, and spent time in psychiatric institutions. He appeared before the world as if in angry comic dishabille. In a poem titled “Suicide,” he wrote: “The first man was an idealist, but he died, / he couldn’t survive the first truth.”', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/18/books/18bookkaufman1/18bookkaufman1-articleLarge.jpg', 'height': 889, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/18/books/18bookkaufman1/18bookkaufman1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 889}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/18/books/18bookkaufman1/18bookkaufman1-jumbo.jpg', 'height': 1024, 'width': 692, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/18/books/18bookkaufman1/18bookkaufman1-superJumbo.jpg', 'height': 2048, 'width': 1383, 'subType': 