s-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/29/opinion/29Ldems-1/29Ldems-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Searching for a Democratic Savior', 'kicker': 'letters', 'content_kicker': None, 'print_headline': 'Searching for a Democratic Savior', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 2, 'major': 'N'}], 'pub_date': '2019-10-29T16:49:28+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'subsection_name': 'Letters', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/d3343c13-999d-5b2b-9677-85a319d5ccf0', 'word_count': 814, 'uri': 'nyt://article/d3343c13-999d-5b2b-9677-85a319d5ccf0'}, {'abstract': 'The rap duo’s last album was released in 2003. After the death of its M.C., Guru, and an ongoing dispute between the producers DJ Premier and DJ Solar, a posthumous release is on the way.', 'web_url': 'https://www.nytimes.com/2019/10/29/arts/music/gang-starr-album.html', 'snippet': 'The rap duo’s last album was released in 2003. After the death of its M.C., Guru, and an ongoing dispute between the producers DJ Premier and DJ Solar, a posthumous release is on the way.', 'lead_paragraph': 'The last time DJ Premier saw Guru, his partner in the influential 1980s and ’90s rap group Gang Starr, it was March 2010. Gang Starr hadn’t dropped an album in seven years, and the duo had stopped communicating entirely. But the time to make amends had come too late: The 48-year-old rapper was in a medically induced coma at Good Samaritan Hospital in Rockland County, N.Y., living out his last days with multiple myeloma, a rare form of cancer.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/30/arts/22gangstarr2/22gangstarr2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/30/arts/22gangstarr2/22gangstarr2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/30/arts/22gangstarr2/22gangstarr2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/30/arts/22gangstarr2/22gangstarr2-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/30/arts/22gangstarr2/22gangstarr2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/30/arts/22gangstarr2/22gangstarr2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/30/arts/22gangstarr2/22gangstarr2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fans Were Surprised to Get More Gang Starr. They Almost Didn’t.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Death Can’t Stop Rap Duo', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Gang Starr (Music Group)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Guru', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'DJ Premier (1966- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mosher, John (DJ Solar)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'One of the Best Yet (Album)', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-10-29T16:54:32+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Paul Cantor', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Cantor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39cc43e2-3070-5551-8c60-e73ffeaa7aa4', 'word_count': 1594, 'uri': 'nyt://article/39cc43e2-3070-5551-8c60-e73ffeaa7aa4'}, {'abstract': 'His single-screen cinemas in and around New York brought foreign and other hard-to-find films to hungry audiences.', 'web_url': 'https://www.nytimes.com/2019/10/29/movies/meyer-ackerman-dead.html', 'snippet': 'His single-screen cinemas in and around New York brought foreign and other hard-to-find films to hungry audiences.', 'lead_paragraph': 'Meyer Ackerman, whose movie theaters brought hard-to-find films to audiences in and around New York City in the decades before home video and the internet made hidden cinematic gems easier to access, died on Oct. 21 in White Plains, N.Y. He was 96.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/01/obituaries/28Ackerman1/merlin_163479411_dc70ffd4-205d-4c10-90b7-eb51d916ee77-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/01/obituaries/28Ackerman1/merlin_163479411_dc70ffd4-205d-4c10-90b7-eb51d916ee77-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/01/obituaries/28Ackerman1/merlin_163479411_dc70ffd4-205d-4c10-90b7-eb51d916ee77-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/01/obituaries/28Ackerman1/merlin_163479411_dc70ffd4-205d-4c10-90b7-eb51d916ee77-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/01/obituaries/28Ackerman1/28Ackerman1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/01/obituaries/28Ackerman1/28Ackerman1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/01/obituaries/28Ackerman1/28Ackerman1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Meyer Ackerman, 96, Whose Theaters Were Loved by Cinephiles, Dies', 'kicker': None, 'content_kicker': None, 'print_headline': 'Meyer Ackerman, 96, Whose Theaters Catered to Cinephiles, Dies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'ACKERMAN, MEYER', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theaters (Buildings)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-10-29T16:54:50+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Movies', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/ec22b6c8-847d-513e-9717-0016fbefc574', 'word_count': 1110, 'uri': 'nyt://article/ec22b6c8-847d-513e-9717-0016fbefc574'}, {'abstract': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'web_url': 'https://www.nytimes.com/2019/10/29/style/tiny-modern-love-stories-too-cool-to-wear-a-costume.html', 'snippet': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'lead_paragraph': 'Thirteen years into our friendship, when we were finally both single, Angie and I met for a screening of “Harold and Maude” in San Francisco’s Dolores Park. I waited at her door wearing a faux-leather miniskirt, a midriff-bearing top and platform boots. She came out in a button-down shirt, a tie, dark jeans and men’s Italian loafers. Instantly, we knew that, in different ways, we had each dressed for a date. Two children later, we still differ in many things: how to load the dishwasher and enforce bedtimes, but also, most importantly, how to lure each other back in. — Elizabeth Stark', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/14/fashion/00OCT-ML-TINY-LOVE-ILLO4/00OCT-ML-TINY-LOVE-ILLO4-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/14/fashion/00OCT-ML-TINY-LOVE-ILLO4/00OCT-ML-TINY-LOVE-ILLO4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/14/fashion/00OCT-