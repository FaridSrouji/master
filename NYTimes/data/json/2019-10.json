4, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/22/autossell/op-kurds-thumbnail/op-kurds-thumbnail-superJumbo.jpg', 'height': 1306, 'width': 1912, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/22/autossell/op-kurds-thumbnail/op-kurds-thumbnail-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/22/autossell/op-kurds-thumbnail/op-kurds-thumbnail-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/22/autossell/op-kurds-thumbnail/op-kurds-thumbnail-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Joined the Army to Prevent Genocide, Not to Pave the Way for One', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Syria', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Army', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kurds', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-10-18T22:11:14+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Alan Kennedy', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/e796c614-ee74-5026-9805-032cc7c13947', 'word_count': 0, 'uri': 'nyt://video/e796c614-ee74-5026-9805-032cc7c13947'}, {'abstract': 'A captain wonders if the Kurdish soldiers he served alongside in Syria three months ago are now dead.', 'web_url': 'https://www.nytimes.com/2019/10/18/opinion/trump-turkey-kurds-syria.html', 'snippet': 'A captain wonders if the Kurdish soldiers he served alongside in Syria three months ago are now dead.', 'lead_paragraph': 'In the Video Op-Ed above, Alan Kennedy, a captain in the Colorado Army National Guard who served this summer in northern Syria, condemns President Trump’s decision to fully withdraw American troops from the area and abandon our Kurdish allies to a Turkish incursion. He calls a recently negotiated 120-hour cease-fire, which reports suggest Turkey has already violated, “too little too late.” He fears that the lack of American commitment and credibility has cleared the way for an ethnic cleansing of the Kurds and a resurgence of the Islamic State.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'I Did Not Join the Army to Abandon Our Allies', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kurds', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Army', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-10-18T22: