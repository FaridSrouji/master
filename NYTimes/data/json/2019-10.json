major': 'N'}], 'pub_date': '2019-10-20T23:01:04+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Neal E. Boudette', 'person': [{'firstname': 'Neal', 'middlename': 'E.', 'lastname': 'Boudette', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8621996b-89ed-57aa-aabe-18075539625e', 'word_count': 1056, 'uri': 'nyt://article/8621996b-89ed-57aa-aabe-18075539625e'}, {'abstract': 'Though the Mexican authorities have been criticized for releasing one of El Chapo’s sons back to gunmen, residents of Culiacán say the decision saved lives.', 'web_url': 'https://www.nytimes.com/2019/10/20/world/americas/culiacan-mexico-chapo-son.html', 'snippet': 'Though the Mexican authorities have been criticized for releasing one of El Chapo’s sons back to gunmen, residents of Culiacán say the decision saved lives.', 'lead_paragraph': 'CULIACÁN, Mexico — In the days following the siege of the city of Culiacán by the Sinaloa cartel, residents were overcome with relief: Relief that the terror is over. That more people did not die. And that government forces, which had captured the son of the former cartel leader Joaquín Guzmán Loera, known as “El Chapo,” handed back their target rather than keep waging  a bloody battle.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/20/world/20mexico3/merlin_163020930_ca36c48c-ad48-4265-b84a-b4617017484a-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/20/world/20mexico3/merlin_163020930_ca36c48c-ad48-4265-b84a-b4617017484a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'typ