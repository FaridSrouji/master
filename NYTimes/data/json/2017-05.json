ported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/750299ae-af9d-5399-9eac-8c93b87b6ae0', 'word_count': 1330, 'uri': 'nyt://article/750299ae-af9d-5399-9eac-8c93b87b6ae0'}, {'abstract': 'The former Fox News chief expanded the reach of conservative media — and paved the way to its decline.', 'web_url': 'https://www.nytimes.com/2017/05/19/opinion/roger-ailes-fox-news-wrecked-conservatism.html', 'snippet': 'The former Fox News chief expanded the reach of conservative media — and paved the way to its decline.', 'lead_paragraph': 'Friends and colleagues who knew Roger Ailes better than I did attest that he was a nicer and more considerate man than most liberal obituarists will ever give him credit for. They add (and the same obituarists concede) that the creator of Fox News understood the art of political messaging better than just about anybody in the last 50 years.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/20stephensWeb/20stephensWeb-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/20/opinion/20stephensWeb/20stephensWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/20stephensWeb/20stephensWeb-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/20stephensWeb/20stephensWeb-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/20stephensWeb/20stephensWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/20/opinion/20stephensWeb/20stephensWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/20stephensWeb/20stephensWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Roger Ailes: The Man Who Wrecked Conservatism', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'The Man Who Wrecked Conservatism', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'AILES, ROGER E', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': "O'Reilly, Bill", 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Will, George F', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Killing Reagan: The Violent Assault That Changed a Presidency (Book)', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-05-20T01:04:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Bret Stephens', 'person': [{'firstname': 'Bret', 'middlename': None, 'lastname': 'Stephens', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/2da8027f-32eb-5c3b-a8d9-97585126bbca', 'word_count': 779, 'uri': 'nyt://article/2da8027f-32eb-5c3b-a8d9-97585126bbca'}, {'abstract': 'A statue of Robert E. Lee, ensconced on a 80-foot perch for 133 years, was removed Friday. It was the last of four Confederate monuments taken down in New Orleans.', 'web_url': 'https://www.nytimes.com/2017/05/19/us/confederate-monument-new-orleans-lee.html', 'snippet': 'A statue of Robert E. Lee, ensconced on a 80-foot perch for 133 years, was removed Friday. It was the last of four Confederate monuments taken down in New Orleans.', 'lead_paragraph': 'NEW ORLEANS — With the yank of a crane and to a cheer from the crowd, Robert E. Lee was lifted off his 80-foot perch, where he had been standing gazing north for most of 133 years, and slowly lowered to the ground.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From Lofty Perch, New Orleans Monument to Confederacy Comes Down', 'kicker': None, 'content_kicker': None, 'print_headline': 'Robert E. Lee Brought Down From Lofty 133-Year Perch', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Monuments and Memorials (Structures)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lee, Robert E', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Landrieu, Mitch', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Beauregard, Pierre Gustave Toutant', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New Orleans (La)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-05-20T01:07:46+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Campbell Robertson', 'person': [{'firstname': 'Campbell', 'middlename': None, 'lastname': 'Robertson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d987a5d-aa9c-5d27-9cd1-1a7df84769e8', 'word_count': 575, 'uri': 'nyt://article/0d987a5d-aa9c-5d27-9cd1-1a7df84769e8'}, {'abstract': 'Defense Se