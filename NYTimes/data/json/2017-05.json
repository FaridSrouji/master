': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Impeachment', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-18T18:13:50+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/5344799d-6b66-5f5c-bec0-676b4ea3bdbc', 'word_count': 243, 'uri': 'nyt://article/5344799d-6b66-5f5c-bec0-676b4ea3bdbc'}, {'abstract': 'Even after Wednesday’s sell-off, the market is still trading at a multiple that is hard to justify in the absence of President Trump’s promised tax cut.', 'web_url': 'https://www.nytimes.com/2017/05/18/business/dealbook/stocks-are-responding-to-washington-thats-bad-news-for-markets.html', 'snippet': 'Even after Wednesday’s sell-off, the market is still trading at a multiple that is hard to justify in the absence of President Trump’s promised tax cut.', 'lead_paragraph': 'Wall Street is finally waking up to the reality in Washington. The Standard & Poor’s 500-stock index fell 1.8 percent on Wednesday in the most notable reversal to the so-called Trump rally since last year’s election. Stockholders nevertheless remain too optimistic about any policy uplift.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Stocks Are Responding to Washington. That’s Bad News for Markets.', 'kicker': 'Breakingviews', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Standard & Poor's 500-Stock Index", 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Bureau of Investigation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Comey, James B', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-05-18T18:32:08+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Jeffrey Goldfarb', 'person': [{'firstname': 'Jeffrey', 'middlename': None, 'lastname': 'Goldfarb', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9221fe0b-121a-5d0b-80d7-29ac62fb90b0', 'word_count': 379, 'uri': 'nyt://article/9221fe0b-121a-5d0b-80d7-29ac62fb90b0'}, {'abstract': 'The Fox News creator made a fortune creating a cultural safe space for Americans pining for the way things were.', 'web_url': 'https://www.nytimes.com/2017/05/18/business/media/roger-ailes-jim-rutenberg.html', 'snippet': 'The Fox News creator made a fortune creating a cultural safe space for Americans pining for the way things were.', 'lead_paragraph': 'Before Donald Trump rode the anger of forgotten (white) America to an “America First” presidency, before Breitbart News became a “platform for the alt-right” and before there were “alternative facts” and dueling versions of reality, Roger Ailes saw a divided country but an undivided news media. And he set out to change it.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/19/us/19ailesportrait/19ailesportrait-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/19/us/19ailesportrait/19ailesportrait-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/19/us/19ailesportrait/19ailesportrait-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge