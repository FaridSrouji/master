t-magazine/24tmag-wylie-slide-IPJM/24tmag-wylie-slide-IPJM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-IPJM/24tmag-wylie-slide-IPJM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-IPJM/24tmag-wylie-slide-IPJM-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Day With Wylie Dufresne', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-05-01T09:50:41+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/21747bcc-2d8b-526d-aa4e-502da514e017', 'word_count': 0, 'uri': 'nyt://slideshow/21747bcc-2d8b-526d-aa4e-502da514e017'}, {'abstract': 'Despite being known for inventive molecular gastronomy, Wylie Dufresne buys sandwiches from a bodega — and Pret a Manger — nearly every day.', 'web_url': 'https://www.nytimes.com/2017/05/01/t-magazine/wylie-dufresne-dus-donuts-food-diary.html', 'snippet': 'Despite being known for inventive molecular gastronomy, Wylie Dufresne buys sandwiches from a bodega — and Pret a Manger — nearly every day.', 'lead_paragraph': 'The deli menu at the Gramercy Food Market, a 24-hour bodega at the corner of East 22nd Street and Second Avenue, offers half a dozen grilled chicken sandwiches named for men of a certain stature: There’s the Al Pacino (with spicy dressing), the Larry King (with Russian dressing) and the John Lennon (with chipotle sauce). Each comes with a free bag of Lay’s and a Pepsi. But Wylie Dufresne doesn’t do lunch here. Only breakfast. And only before 11 a.m. (to avoid the $1 late-breakfast fee). And so frequently that the guy behind the counter knows his order: one egg on a roll ($2). Except Dufresne takes two eggs (for an extra 50 cents). “It’s a classic New York egg-and-cheese — the best,” says the chef, who lives nearby. “There are so many bad ones. It’s so satisfying when it’s done right.”', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-389W/24tmag-wylie-slide-389W-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-389W/24tmag-wylie-slide-389W-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-389W/24tmag-wylie-slide-389W-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-389W/24tmag-wylie-slide-389W-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-389W/24tmag-wylie-slide-389W-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/04/24/t-magazine/24tmag-wylie-slide-389W/24tmag-wylie-slide-389W-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017