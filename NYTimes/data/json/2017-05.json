_xp-superJumbo.jpg', 'height': 850, 'width': 1280, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/06/science/06Peiades_xp/06Peiades_xp-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/06/science/06Peiades_xp/06Peiades_xp-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/06/science/06Peiades_xp/06Peiades_xp-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Geniuses Wanted: NASA Challenges Coders to Speed Up Its Supercomputer', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Aeronautics and Space Administration', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Supercomputers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Crowdsourcing (Internet)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-08T15:00:48+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Jacey Fortin', 'person': [{'firstname': 'Jacey', 'middlename': None, 'lastname': 'Fortin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/710bfded-15f2-5362-87ca-520cb8bea3b3', 'word_count': 769, 'uri': 'nyt://article/710bfded-15f2-5362-87ca-520cb8bea3b3'}, {'abstract': 'The signature soup from Something Good to Eat is a blend of beets and pomegranate juice.', 'web_url': 'https://www.nytimes.com/2017/05/08/dining/soup-something-good-to-eat.html', 'snippet': 'The signature soup from Something Good to Eat is a blend of beets and pomegranate juice.', 'lead_paragraph': 'Sandy Khorrami was 12 when she and her mother arrived in the United States from Iran during the revolution and settled in Great Neck, N.Y., where her sister and her family lived. Now, nearly 40 years later, Ms. Khorrami has gone into the soup business. Her signature soup, a deep ruby blend of pomegranate juice and beets, reflects her Iranian heritage. The tart soup, bolstered with rice and herbs, can be served cold, and benefits at any temperature from a dollop of yogurt. Her other soup flavors are Tuscan vegetable with buckwheat, lightly spiced mushroom with lemongrass and quinoa, and butternut squash with quinoa: $51.91 for four 25-ounce jars, one variety or assorted, somethinggoodtoeatnyc.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/dining/10BURNER-SOUP/10BURNER-SOUP-articleLarge.jpg', 'height': 625, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/10/dining/10BURNER-SOUP/10BURNER-SOUP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 625}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/dining/10BURNER-SOUP/10BURNER-SOUP-jumbo.jpg', 'height': 1024, 'width': 984, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/dining/10BURNER-SOUP/10BURNER-SOUP-superJumbo.jpg', 'height': 1297, 'width': 1246, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/dining/10BURNER-SOUP/10BURNER-SOUP-thumbStand