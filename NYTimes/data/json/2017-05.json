r.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/sports/10ONSOCCER-1494369506945/10ONSOCCER-1494369506945-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/10/sports/10ONSOCCER-1494369506945/10ONSOCCER-1494369506945-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/sports/10ONSOCCER-1494369506945/10ONSOCCER-1494369506945-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/sports/10ONSOCCER-1494369506945/10ONSOCCER-1494369506945-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/10/sports/10ONSOCCER-1494369506945/10ONSOCCER-1494369506945-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/sports/10ONSOCCER-1494369506945/10ONSOCCER-1494369506945-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/sports/10ONSOCCER-1494369506945/10ONSOCCER-1494369506945-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Admiring Juventus’s Greatness, and Dreaming About Monaco’s Potential', 'kicker': None, 'content_kicker': None, 'print_headline': 'Monaco’s Future Glows, If It Can Stay Together', 'name': None,