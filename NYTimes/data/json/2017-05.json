8/blogs/18-lens-museum-slide-71E2/18-lens-museum-slide-71E2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/18/blogs/18-lens-museum-slide-71E2/18-lens-museum-slide-71E2-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/18/blogs/18-lens-museum-slide-71E2/18-lens-museum-slide-71E2-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Museum of the Future: Portable and Personal', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-05-22T07:05:56+0000', 'document_type': 'multimedia', 'news_desk': 'Blogs', 'section_name': 'Blogs', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/755e0770-f1e5-5aee-b0fd-e62fd93d5921', 'word_count': 0, 'uri': 'nyt://slideshow/755e0770-f1e5-5aee-b0fd-e62fd93d5921'}, {'abstract': 'When seen in the light of pure machine learning (think IBM’s Watson), his behavior actually makes sense.', 'web_url': 'https://www.nytimes.com/2017/05/22/opinion/donald-trump-our-ai-president.html', 'snippet': 'When seen in the light of pure machine learning (think IBM’s Watson), his behavior actually makes sense.', 'lead_paragraph': 'It is hard to imagine a more scathing indictment of our ability to read another’s thoughts and intentions than our inability to predict Donald Trump’s next move. From the gross pre-election misjudgments to postelection bafflement, the best pundits are at a loss to accurately anticipate his response to matters like North Korean military aggressiveness or his moment-by-moment political gyrations and opinion reversals. Labeling Trump a narcissist, psychopath, megalomaniac or attention-impaired, or all of the above, might feel explanatory, but even when armed with the best psychoanalytic insights, we have no idea what he will do when presented with a new or unforeseen circumstance.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/opinion/22STONE-promo/22STONE-promo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/22/opinion/22STONE-promo/22STONE-promo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/opinion/22STONE-promo/22STONE-promo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/opinion/22STONE-promo/22STONE-promo-articleLarge.jpg', 'height': 446, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/22/opinion/22STONE-promo/22STONE-promo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 446}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/opinion/22STONE-promo/22STONE-promo-jumbo.jpg', 'height': 760, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/opinion/22STONE-promo/22STONE-promo-superJumbo.jpg', 'height': 1114, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Donald Trump, Our A.I. President', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Artificial Intelligence', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Supercomputers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'International Business Machines Corporation', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-05-22T07:20:33+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Robert A. Burton', 'person': [{'firstname': 'Robert', 'middlename': 'A.', 'lastname': 'Burton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/2fc8922b-2a92-5564-96a4-5e4653b027fb', 'word_count': 1108, 'uri': 'nyt://article/2fc8922b-2a92-5564-96a4-5e4653b027fb'}, {'abstract': 'Attorney General Jeff Sessions is living in the 1980s. The states don’t have to follow him.', 'web_url': 'https://www.nytimes.com/2017/05/22/opinion/jeff-sessions-justice-reform.html', 'snippet': 'Attorney General Jeff Sessions is living in the 1980s. The states don’t have to follow him.', 'lead_paragraph': 'When it comes to criminal justice, Attorney General Jeff Sessions is a man out of time — stuck defiantly in the 1980s, when crime in America was high and politicians scrambled to out-tough one another by passing breathtakingly severe sentencing laws. This mind-set was bad enough when Mr. Sessions was a senator from Alabama working to thwart sentencing reforms in Congress. Now that he is the nation’s top law enforcement officer, he’s trying to drag the country backward with him, even as most states are moving toward more enlightened policies.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/22mon2web/22mon2web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/20/opinion/22mon2web/22mon2web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/22mon2web/22mon2web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/22mon2web/22mon2web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/20/opinion/22mon2web/22mon2web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/22mon2web/22mon2web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/20/opinion/22mon2web/22mon2web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Lurching Backward on Justice Reform', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Lurching Backward on Justice Reform', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sessions, Jefferson B III', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mandatory Sentencing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Crime and Criminals', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-05-22T07:21:05+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/d37e057a-4ecb-53d7-9b37-e043d068f54a', 'word_count': 505, 'uri': 'nyt://article/d37e057a-4ecb-53d7-9b37-e043d068f54a'}, {'abstract': 'Progress by two of the world’s top greenhouse gas producers is a huge lesson for the United States.', 'web_url': 'https://www.nytimes.com/2017/05/22/opinion/paris-agreement-climate-china-india.html', 'snippet': 'Progress by two of the world’s top greenhouse gas producers is a huge lesson for the United States.', 'lead_paragraph': 'Until recently, China and India have been cast as obstacles, at the very least reluctant conscripts, in the battle against climate change. That reputation looks very much out-of-date now that both countries have greatly accelerated their investments in cost-effective renewable energy sources — and reduced their reliance on fossil fuels. It’s America — Donald Trump’s America — that now looks like the laggard.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/opinion/23solar-sub/23solar-sub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/23/opinion/23solar-sub/23solar-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype'