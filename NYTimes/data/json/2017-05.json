e', 'url': 'images/2017/05/23/opinion/23secorWeb/23secorWeb-articleLarge.jpg', 'height': 392, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/23/opinion/23secorWeb/23secorWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 392}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/opinion/23secorWeb/23secorWeb-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/opinion/23secorWeb/23secorWeb-superJumbo.jpg', 'height': 1337, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/opinion/23secorWeb/23secorWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/23/opinion/23secorWeb/23secorWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/opinion/23secorWeb/23secorWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Patient Resilience of Iran’s Reformers', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The Resilience of Iran’s Reformers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Voting and Voters', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-05-22T21:37:40+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Laura Secor', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Secor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6de51f5e-f45d-5ed2-ab70-7e052ba1b3a4', 'word_count': 1005, 'uri': 'nyt://article/6de51f5e-f45d-5ed2-ab70-7e052ba1b3a4'}, {'abstract': 'This tame exhibition fails to capture the realities of a world that has changed drastically in recent months.', 'web_url': 'https://www.nytimes.com/2017/05/22/arts/design/venice-biennale-whose-reflection-do-you-see.html', 'snippet': 'This tame exhibition fails to capture the realities of a world that has changed drastically in recent months.', 'lead_paragraph': 'VENICE — Timing isn’t everything, but it’s a lot. If the bland, soft-power 2017 Venice Biennale, called “Viva Arte Viva,” had arrived two, or four, or six years ago, it might have passed muster, even made sense. But coming post-Brexit and post-Trump, it feels almost perversely out of sync with the political moment, and nowhere near strong enough to define a moment of its own.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/arts/23biennalerevu162/23biennalerevu162-articleLarge-v3.jpg', 'height': 436, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/23/arts/23biennalerevu162/23biennalerevu162-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 436}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/arts/23biennalerevu162/23biennalerevu162-jumbo-v3.jpg', 'height': 745, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/arts/23bi