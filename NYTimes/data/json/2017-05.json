ua-1495469547132/26Joshua-1495469547132-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/arts/26Joshua-1495469547132/26Joshua-1495469547132-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/arts/26Joshua-1495469547132/26Joshua-1495469547132-superJumbo.jpg', 'height': 1080, 'width': 1919, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Review: ‘Joshua: Teenager vs. Superpower,’ a War That Isn’t Fiction', 'kicker': None, 'content_kicker': None, 'print_headline': 'Underdog, Unafraid To Fight', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Joshua: Teenager vs. Superpower (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wong, Joshua (1996- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Piscatella, Joe', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Scholarism (Hong Kong)', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-05-25T21:07:29+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Ken Jaworowski', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Jaworowski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/cd690700-8ce0-52f7-b361-df60528e13aa', 'word_count': 413, 'uri': 'nyt://article/cd690700-8ce0-52f7-b361-df60528e13aa'}, {'abstract': 'The International Center of Photography’s summer exhibition features the work of 75 professionals for Magnum Photos, including Henri Cartier-Bresson.', 'web_url': 'https://www.nytimes.com/2017/05/25/arts/design/magnum-manifesto-a-70-year-history-lesson-in-photojournalism.html', 'snippet': 'The International Center of Photography’s summer exhibition features the work of 75 professionals for Magnum Photos, including Henri Cartier-Bresson.', 'lead_paragraph': 'When the International Center of Photography reopened last year in its new home on the Bowery, it seemed to be swerving into a new lane — or, perhaps, careering off the road altogether. New York’s leading photography institution, it opened uptown in 1974, with a mandate from its founder, Cornell Capa, to showcase photojournalism, documentary images and other kinds of “concerned photography.” But since then, the medium of photography has fractured; lens-based imagery has moved from the darkroom to the social media screen; and the center has changed, too. The new location includes no space for its permanent collection — those 200,000 prints are out in Jersey City — and its first show was a digital hodgepodge that drew as many snipes as cheers.', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/arts/26MAGNUM1/26MAGNUM1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/26/arts/26MAGNUM1/26MAGNUM1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/arts/26MAGNUM1/26MAGNUM1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'ur