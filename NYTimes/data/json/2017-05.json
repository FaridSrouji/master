humbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/31/dining/31RAMADAN1/31RAMADAN1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/31/dining/31RAMADAN1/31RAMADAN1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/31/dining/31RAMADAN1/31RAMADAN1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/31/dining/31RAMADAN1/31RAMADAN1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'During Ramadan, Home Cooks Shine', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Nourishing Fast', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ramadan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Muslim Americans', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-05-26T18:57:27+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Tejal Rao', 'person': [{'firstname': 'Tejal', 'middlename': None, 'lastname': 'Rao', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a084f920-752d-57de-8637-da20d53c6e62', 'word_count': 1557, 'uri': 'nyt://article/a084f920-752d-57de-8637-da20d53c6e62'}, {'abstract': 'I’m in mourning for the state I thought I knew, but trying to be hopeful for the future.', 'web_url': 'https://www.nytimes.com/2017/05/26/opinion/the-lessons-of-montana.html', 'snippet': 'I’m in mourning for the state I thought I knew, but trying to be hopeful for the future.', 'lead_paragraph': 'After I finished college, I worked on a ballot issue campaign in Montana, where I grew up. The other side had enormous popular support, and we had eight weeks. My dad told me not to take the job because we were going to lose and it was going to be depressing. I took it anyway. We made our case in the press and in ads, and people listened, and we won. And Montana was better for it. That election was one of the most thrilling nights of my life.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26meloyWeb/26meloyWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/26/opinion/26meloyWeb/26meloyWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26meloyWeb/26meloyWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26meloyWeb/26meloyWeb-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/26/opinion/26meloyWeb/26meloyWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26meloyWeb/26meloyWeb-jumbo.jpg', 'height': 664, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26meloyWeb/26meloyWeb-superJumbo.jpg', 'height': 1327, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The Lessons of Montana', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections, House of Representatives', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gianforte, Greg (1961- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jacobs, Benjamin C (1984- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Quist, Robert (1948- )', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Montana', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-05-26T19:00:16+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Maile Meloy', 'person': [{'firstname': 'Maile', 'middlename': None, 'lastname': 'Meloy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/69e8df70-a779-5f5a-b319-5df852e67d28', 'word_count': 748, 'uri': 'nyt://article/69e8df70-a779-5f5a-b319-5df852e67d28'}, {'abstract': 'A close look at the numbers suggests that the levitating 2016 stock market was a powerful driver of C.E.O. pay.', 'web_url': 'https://www.nytimes.com/2017/05/26/business/the-trump-effect-on-ceo-pay.html', 'snippet': 'A close look at the numbers suggests that the levitating 2016 stock market was a powerful driver of C.E.O. pay.', 'lead_paragraph': 'After the November election, the stock market experienced a Trump bump. The surge in share prices thrilled investors, but some corporate executives had even more reason to celebrate. That’s because rising prices can fuel higher pay even if other corporate results are so-s