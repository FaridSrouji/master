one, 'type': 'image', 'url': 'images/2017/05/09/opinion/09szala/09szala-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/opinion/09szala/09szala-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/09/opinion/09szala/09szala-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/opinion/09szala/09szala-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/opinion/09szala/09szala-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A Woman’s Decision to Give Birth or Abort', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'A Woman’s Decision to Give Birth or Abort', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-05-19T19:10:58+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/f1bbd14a-9314-5dea-b6ca-5ad2913ff042', 'word_count': 577, 'uri': 'nyt://article/f1bbd14a-9314-5dea-b6ca-5ad2913ff042'}, {'abstract': 'Highlights from the worlds of fashion, food and art.', 'web_url': 'https://www.nytimes.com/2017/05/19/t-magazine/frank-lloyd-wright-elyse-graham-talitha.html', 'snippet': 'Highlights from the worlds of fashion, food and art.', 'lead_paragraph': 'Frank\xa0Lloyd Wright was funny about his birthday, occasionally fudging the year in favor of youth, but 2017 marks his actual sesquicentennial — to be celebrated with various exhibitions across the country. Here in New York, Wright aficionados who might otherwise be straining their necks at the Guggenheim will head to MoMA for “Frank Lloyd Wright at 150: Unpacking the Archive,” not your typical monograph of the architect’s masterpieces. Curator Barry Bergdoll invited a handpicked group of scholars to explore the vast Wright archive that the museum comanages with Columbia’s Avery Library, then organized the show around the objects they found most compelling. The historian Jennifer Gray used a little-known Wright-designed logo for a conservation group to examine his ideas about the prairie. Ken Tadashi Oshima, a specialist on East-West influences in design, found an old book of images of the Imperial Hotel, with rickshaws and automobiles pictured out front. “It’s not some big statement,” Bergdoll says. “More a kaleidoscope of facets meant to open new lines of inquiry.” — KATE GUADAGNINO', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/16/t-magazine/wright-slide-U1CA/wright-slide-U1CA-articleLarge.jpg', 'height': 280, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/16/t-magazine/wright-slide-U1CA/wright-slide-U1CA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 280}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/16/t-magazine/wright-slide-U1CA/wright-slide-U1CA-jumbo.jpg', 'height': 477, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'im