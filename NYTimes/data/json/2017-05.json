-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 841}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/arts/09BOOKLEHANE/09BOOKLEHANE-jumbo-v2.jpg', 'height': 1024, 'width': 731, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/arts/09BOOKLEHANE/09BOOKLEHANE-superJumbo-v2.jpg', 'height': 1927, 'width': 1374, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In Dennis Lehane’s ‘Since We Fell,’ a Troubled Woman Seeks Answers', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Daddy Issues Turn Deadly', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Since We Fell (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lehane, Dennis', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-05-08T21:46:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Janet Maslin', 'person': [{'firstname': 'Janet', 'middlename': None, 'lastname': 'Maslin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e7d02c60-0642-53b3-9070-cb7f88bd4b4c', 'word_count': 832, 'uri': 'nyt://article/e7d02c60-0642-53b3-9070-cb7f88bd4b4c'}, {'abstract': 'Yuval Sharon’s staging of the work with the Cleveland Orchestra is an object lesson in how an orchestra can properly stage an opera.', 'web_url': 'https://www.nytimes.com/2017/05/08/arts/music/review-debussys-pelleas-but-this-time-all-boxed-in.html', 'snippet': 'Yuval Sharon’s staging of the work with the Cleveland Orchestra is an object lesson in how an orchestra can properly stage an opera.', 'lead_paragraph': 'CLEVELAND — “How beautiful it is in the shadows,” Pelléas sings in the climactic fourth act of Debussy’s “Pelléas et Mélisande.” How beautiful, indeed, for the lovers in the opera’s title, as well as for lovers of Debussy’s score: murky, wispy and allusive, yet somehow also touching, penetrating and direct. The opera takes its unearthly power from metaphors of blindness, from the Symbolist taste for leaving things half-said, for making things only half-clear. No wonder that productions of it so often feel half-baked.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/arts/09PELLEAS/09PELLEAS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/09/arts/09PELLEAS/09PELLEAS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/arts/09PELLEAS/09PELLEAS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/arts/09PELLEAS/09PELLEAS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/09/arts/09PELLEAS/09PELLEAS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/arts/09PELLEAS/09PELLEAS-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/09/arts/09PELLEAS/09PELLEAS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo'