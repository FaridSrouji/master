86-51e8-982b-136d2dc34342', 'word_count': 872, 'uri': 'nyt://article/b23d5724-ff86-51e8-982b-136d2dc34342'}, {'abstract': 'Quotation of the Day for Wednesday, May 17, 2017.', 'web_url': 'https://www.nytimes.com/2017/05/16/todayspaper/quotation-of-the-day-trump-appealed-to-comey-to-halt-inquiry-of-flynn.html', 'snippet': 'Quotation of the Day for Wednesday, May 17, 2017.', 'lead_paragraph': '“I hope you can see your way clear to letting this go, to letting Flynn go. He is a good guy.”', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day: Trump Appealed to Comey to Halt Inquiry Into Aide', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quote of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-05-17T02:34:29+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/fa147647-267a-5ec5-a9b9-179b7411eaaf', 'word_count': 70, 'uri': 'nyt://article/fa147647-267a-5ec5-a9b9-179b7411eaaf'}, {'abstract': 'Removal, not impeachment, for a president unfit for office.', 'web_url': 'https://www.nytimes.com/2017/05/16/opinion/25th-amendment-trump.html', 'snippet': 'Removal, not impeachment, for a president unfit for office.', 'lead_paragraph': 'It was just three days and a lifetime ago that I wrote a column about Donald Trump’s unfitness for the presidency that affected a world-weary tone. Nothing about this White House’s chaos was surprising given the style of Trump’s campaign, I argued. None of the breaking scandals necessarily suggested high crimes as opposed to simple omni-incompetence. And given that Republicans made their peace with Trump’s unfitness many months ago, it seemed pointless to expect their leaders to move against him unless something far, far worse came out.', 'source': 'The New York Times',