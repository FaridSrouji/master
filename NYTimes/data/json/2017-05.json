/05/06/us/06abortion1/06abortion1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/06/us/06abortion1/06abortion1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/06/us/06abortion1/06abortion1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Abortion Foes See Ally in Trump, but Wonder: Will He Go Far Enough?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Opponents of Abortion Warily Measure Progress', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Planned Parenthood Federation of America', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Orders and Memorandums', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-05-05T21:31:35+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jeremy W. Peters', 'person': [{'firstname': 'Jeremy', 'middlename': 'W.', 'lastname': 'Peters', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/02127d4e-503e-57e6-9473-8b2bfc7e696e', 'word_count': 1160, 'uri': 'nyt://article/02127d4e-503e-57e6-9473-8b2bfc7e696e'}, {'abstract': 'Chimamanda Ngozi Adichie talks about demystifying feminism in her new book, “Dear Ijeawele, or A Feminist Manifesto in Fifteen Suggestions.”', 'web_url': 'https://www.nytimes.com/2017/05/05/books/in-conversation-with-chimamanda-ngozi-adichie.html', 'snippet': 'Chimamanda Ngozi Adichie talks about demystifying feminism in her new book, “Dear Ijeawele, or A Feminist Manifesto in Fifteen Suggestions.”', 'lead_paragraph': 'Chimamanda Ngozi Adichie, a feminist icon and mainstay in conversations about women’s equality, did not originally intend for her newly released book, “Dear Ijeawele; Or, A Feminist Manifesto in Fifteen Suggestions,” to be published. It started first as a private letter to a friend who sought Ms. Adichie’s advice on how to raise her newborn daughter “so she doesn’t take the kind of nonsense that I took,” before being published on her Facebook page and now, finally, in print.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/books/booksupdate/Chimamanda-Ngozie-Times-Talks/Chimamanda-Ngozie-Times-Talks-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/05/books/booksupdate/Chimamanda-Ngozie-Times-Talks/Chimamanda-Ngozie-Times-Talks-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/books/booksupdate/Chimamanda-Ngozie-Times-Talks/Chimamanda-Ngozie-Times-Talks-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/books/booksupdate/Chimamanda-Ngozie-Times-Talks/Chimamanda-Ngozie-Times-Talks-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/05/books/booksupdate/Chimama