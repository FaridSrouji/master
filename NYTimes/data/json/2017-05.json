': {'thumbnail': 'images/2017/05/07/arts/07GUIDE5/07GUIDE5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07GUIDE5/07GUIDE5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Enda Walsh in NYC,’ a Double Dose of Bracing Irish Isolation', 'kicker': None, 'content_kicker': None, 'print_headline': 'Theater; A Double Dose Of Irish Isolation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Irish Arts Center', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': "St Ann's Warehouse (Brooklyn, NY)", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Walsh, Enda', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Arlington (Play)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Rooms (Play)', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-05-03T14:20:09+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Theater', 'byline': {'original': 'By Steven McElroy', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'McElroy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8799d3ab-65ab-5f63-85bd-e15bd81fd5e8', 'word_count': 160, 'uri': 'nyt://article/8799d3ab-65ab-5f63-85bd-e15bd81fd5e8'}, {'abstract': 'The director Larry Cohen’s low-budget offerings are being shown at the restored theater. This one features David Carradine, Michael Moriarty and some leathery wings.', 'web_url': 'https://www.nytimes.com/2017/05/03/movies/q-at-quad-cinema-oh-on-the-wings-of-serpents.html', 'snippet': 'The director Larry Cohen’s low-budget offerings are being shown at the restored theater. This one features David Carradine, Michael Moriarty and some leathery wings.', 'lead_paragraph': 'Beginning in the early 1970s, the writer and director Larry Cohen, a veteran of series television (with episodes of “The Defenders” and “Columbo” to his credit), began making low-budget movies of a distinct and slyly subversive kind. Among them were the outrageous race comedy “Bone” and the infamous killer-baby grindhouse mainstay, “It’s Alive.” Manhattan’s newly restored Quad Cinema is revisiting a handful of Mr. Cohen’s New York films this weekend. On Sunday, May 7, it’s showing “Q,” also known as “Q: The Winged Serpent,” from 1982.', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07GUIDE3/07GUIDE3-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/07/arts/07GUIDE3/07GUIDE3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07GUIDE3/07GUIDE3-jumbo.jpg', 'height': 719, 'width': 959, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07GUIDE3/07GUIDE3-superJumbo.jpg', 'height': 719, 'width': 959, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07GUIDE3/07GUIDE3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/07/arts/07GUIDE3/07GUIDE3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'c