': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Family Leaves', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Ivanka', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'King, Peter T', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 10, 'major': 'N'}], 'pub_date': '2017-05-22T01:02:55+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Maggie Haberman', 'person': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8ca7481d-68a5-59d1-bc79-61fe3517abe7', 'word_count': 807, 'uri': 'nyt://article/8ca7481d-68a5-59d1-bc79-61fe3517abe7'}, {'abstract': 'The circus held its last show at Nassau Coliseum on Long Island after declining ticket sales led its operator, Feld Entertainment, to decide to shut it down.', 'web_url': 'https://www.nytimes.com/2017/05/21/nyregion/ringling-brothers-circus-takes-final-bow.html', 'snippet': 'The circus held its last show at Nassau Coliseum on Long Island after declining ticket sales led its operator, Feld Entertainment, to decide to shut it down.', 'lead_paragraph': 'UNIONDALE, N.Y. — The lights went up on the Ringling Brothers and Barnum & Bailey circus on Sunday evening to reveal 14 lions and tigers sitting in a circle, surrounding a man in a sparkling suit. It was a sight too implausible to seem real yet such an iconic piece of Americana that it was impossible to believe the show would not go on.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/nyregion/22CIRCUS-01-SUB/22CIRCUS-01-SUB-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/22/nyregion/22CIRCUS-01-SUB/22CIRCUS-01-SUB-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/nyregion/22CIRCUS-01-SUB/22CIRCUS-01-SUB-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/nyregion/22CIRCUS-01-SUB/22CIRCUS-01-SUB-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/22/nyregion/22CIRCUS-01-SUB/22CIRCUS-01-SUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/nyregion/22CIRCUS-01-SUB/22CIRCUS-01-SUB-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/nyregion/22CIRCUS-01-SUB/22CIRCUS-01-SUB-superJumbo.jpg', 'height': 1354, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'After 146 Years, Ringling Brothers Circus Takes Its Final Bow', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Final Bow for the Greatest Show on Earth', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Circuses', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Feld Entertainment', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Nassau Veterans Memorial Coliseum', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Ringling Bros and Barnum & Bailey Circus', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Shutdowns (Institutional)', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-05-22T01:05:30+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sarah Maslin Nir and Nate Schweber', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Nate', 'middlename': None, 'lastname': 'Schweber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d5ecf60-5dca-565f-92c9-95b0ddf6ee7b', 'word_count': 1192, 'uri': 'nyt://article/6d5ecf60-5dca-565f-92c9-95b0ddf6ee7b'}, {'abstract': 'On Saturday, about 200 people rallied in Brighton Beach to protest discrimination in what was described as the country’s first Russian-speaking march for lesbian, gay, bisexual and transgender people.', 'web_url': 'https://www.nytimes.com/2017/05/21/nyregion/bias-gay-russians-brooklyn.html', 'snippet': 'On Saturday, about 200 people rallied in Brighton Beach to protest discrimination in what was described as the country’s first Russian-speaking march for lesbian, gay, bisexual and transgender people.', 'lead_paragraph': 'For many years, Denis Kruglenko treated life as if it were a delicately calibrated performance. A gay man living in Belgorod, Russia, he knew that even appearing to be homosexual could be perilous. He did what he could to conceal his sexual orientation but it never seemed to be enough. Once, he was beaten up for wearing a pair of pink socks.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/nyregion/22PRIDE-01/22PRIDE-01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/23/nyregion/22PRIDE-01/22PRIDE-01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/nyregion/22PRIDE-01/22PRIDE-01-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/nyregion/22PRIDE-01/22PRIDE-01-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/nyregion/22PRIDE-01/22PRIDE-01-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/23/nyregion/22PRIDE-01/22PRIDE-01-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/23/nyregion/22PRIDE-01/22PRIDE-01-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Fleeing Bias at Home, Gay Russians Say It Persists in Brooklyn', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fleeing Bias in Russia, Only to Find Brooklyn Isn’t Entirely Welcoming', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality and Bisexuality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brighton Beach (Brooklyn, NY)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-22T01:16:55+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Noah Remnick', 'person': [{'firstname': 'Noah', 'middlename': None, 'lastname': 'Remnick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/488819a6-0367-5701-ad03-15c541d40b03', 'word_count': 768, 'uri': 'nyt://article/488819a6-0367-5701-ad03-15c541d40b03'}, {'abstract': 'Quotation of the day for Monday, May 22, 2017.', 'web_url': 'https://www.nytimes.com/2017/05/21/todayspaper/quotation-of-the-day-shifting-tone-president-saves-dark-words-for-a-faiths-fringe.html', 'snippet': 'Quotation of the day for Monday, May 22, 2017.', 'lead_paragraph': '“Love your shoes. Boy, those shoes. Man!”', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day: Shifting Tone, President Saves Dark Words for a Faith’s Fringe', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quote of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-05-22T01:33:19+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/a12104df-37fb-5d01-b800-3633af3e268f', 'word_count': 37, 'uri': 'nyt://article/a12104df-37fb-5d01-b800-3633af3e268f'}, {'abstract': 'The suit accuses Apple Pay of using technology that was pitched to Apple and Visa officials, but the companies never signed a license agreement.', 'web_url': 'https://www.nytimes.com/2017/05/21/technology/apple-pay-patent-lawsuit.html', 'snippet': 'The suit accuses Apple Pay of using technology that was pitched to Apple and Visa officials, but the companies never signed a license agreement.', 'lead_paragraph': 'SAN FRANCISCO — A small Boston company, founded by the inventor of a popular corporate encryption technology called RSA SecurID, sued Apple and Visa on Sunday, arguing that the Apple Pay digital payment technology violates its patents.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/technology/22apple/22apple-jumbo.jpg', 'height': 320, 'width': 234, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/technology/22apple/22apple-superJumbo.jpg', 'height': 320, 'width': 234, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/technology/22apple/22apple-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/22/technology/22apple/22apple-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/22/technology/22apple/22apple-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Apple Pay Violates Patents Held by Security Technology Inventor, Lawsuit Alleges', 'kicker': None, 'content_kicker': None, 'print_headline': 'Apple Pay Violates Patents Held by Security Technology Inventor, Lawsuit Alleges', 'name': None, 'seo': None