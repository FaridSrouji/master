height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/05/arts/05BOOKBABITZ2/05BOOKBABITZ2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/arts/05BOOKBABITZ2/05BOOKBABITZ2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Eve Babitz, a Glamour Girl Who Refused to Be Dull', 'kicker': 'American Beauties', 'content_kicker': None, 'print_headline': 'A Glamour Girl Who Refused to Be Dull', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': "Eve's Hollywood (Book)", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Babitz, Eve (1943- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-04T20:14:26+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Books', 'byline': {'original': 'By Dwight Garner', 'person': [{'firstname': 'Dwight', 'middlename': None, 'lastname': 'Garner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5e110fed-1655-5fe2-a5ef-e5afadbffeb8', 'word_count': 1068, 'uri': 'nyt://article/5e110fed-1655-5fe2-a5ef-e5afadbffeb8'}, {'abstract': 'In town now is Tefaf, an art fair where Thomas Hart Benton is a showstopper and you can trade your string of pearls for a wearable Giacometti.', 'web_url': 'https://www.nytimes.com/2017/05/04/arts/design/tefaf-an-old-masters-star-freshens-up-for-its-first-spring-on-park-avenue.html', 'snippet': 'In town now is Tefaf, an art fair where Thomas Hart Benton is a showstopper and you can trade your string of pearls for a wearable Giacometti.', 'lead_paragraph': 'Before Frieze set up its swinging shop in London’s Regent’s Park, before Art Basel transposed its staid Swiss self onto Miami Beach, art fairs were small, concentrated events that targeted a narrow class of specialists. None was more connoisseur-driven than the European Fine Art Fair, or Tefaf, the granddaddy of old masters events, held every March in the southern tip of the Netherlands. Tefaf recently hosted its 30th edition in Maastricht, and it remains the go-to trading post for Flemish still lifes and Sienese altarpieces. But collectors’ tastes have changed, and a global network of fairs has forced a rethinking of even the old-school events.', 'print_section': 'C', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/arts/05TEFAF1/05TEFAF1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/05/arts/05TEFAF1/05TEFAF1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/arts/05TEFAF1/05TEFAF1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/arts/05TEFAF1/05TEFAF1-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/05/arts/05TEFAF1/05TEFAF1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/05/arts/05TEFAF1/05TEFAF1-jumbo.jpg', 'height': 575, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank'