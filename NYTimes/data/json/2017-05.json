, 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/nyregion/10fire2/10fire2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/10/nyregion/10fire2/10fire2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/nyregion/10fire2/10fire2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/nyregion/10fire2/10fire2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Woman’s Body Is Set on Fire in East Harlem Complex, Police Say', 'kicker': None, 'content_kicker': None, 'print_headline': 'Blood and a Burning Body In an East Harlem Building', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Harlem Hospital Center', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'East Harlem (Manhattan, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-05-09T19:24:12+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Eli Rosenberg and Ashley Southall', 'person': [{'firstname': 'Eli', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ashley', 'middlename': None, 'lastname': 'Southall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f7510ae6-e0f1-52a2-9712-9690b47b34f5', 'word_count': 484, 'uri': 'nyt://article/f7510ae6-e0f1-52a2-9712-9690b47b34f5'}, {'abstract': 'The conductor Leon Botstein talks about his favorite page from “The Apostles,” the oratorio he leads on Friday at Carnegie Hall.', 'web_url': 'https://www.nytimes.com/2017/05/09/arts/music/a-rare-performance-of-elgars-gigantic-work.html', 'snippet': 'The conductor Leon Botstein talks about his favorite page from “The Apostles,” the oratorio he leads on Friday at Carnegie Hall.', 'lead_paragraph': '“I am now plotting GIGANTIC WORK,” the British composer Edward Elgar wrote in 1902, when he spent the summer in Bayreuth, Germany, and saw Wagner’s “Parsifal” no fewer than three times. Flush with the success of “The Dream of Gerontius,” he planned out a grand trilogy of oratorios, a heady brew of devout Wagnerism and High Church Anglicanism. Only two were finished — “The Apostles” and “The Kingdom,” leaving “The Last Judgment” only as fragments — and completing even those contributed to Elgar’s declining religious faith.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/arts/10ELGAR2/10ELGAR2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/10/arts/10ELGAR2/10ELGAR2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/arts/10ELGAR2/10ELGAR2-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/10/arts/10ELGAR2/10ELGAR2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank'