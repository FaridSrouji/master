icleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 432}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/06/02/arts/02WONDER/02WONDER-jumbo.jpg', 'height': 738, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/06/02/arts/02WONDER/02WONDER-superJumbo.jpg', 'height': 1475, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/06/02/arts/02WONDER/02WONDER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/06/02/arts/02WONDER/02WONDER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/06/02/arts/02WONDER/02WONDER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Wonder Woman’ Is a Blockbuster That Lets Itself Have Fun', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Hero for Our Times', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Wonder Woman (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jenkins, Patty', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gadot, Gal (1985- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-31T14:10:00+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 