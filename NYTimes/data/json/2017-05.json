acy': {'thumbnail': 'images/2017/05/31/us/31chicago-01/31chicago-01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/31/us/31chicago-01/31chicago-01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/31/us/31chicago-01/31chicago-01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/31/us/31chicago-01/31chicago-01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/31/us/31chicago-01/31chicago-01-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/31/us/31chicago-01/31chicago-01-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In Chicago’s Crisis of Violence, Some Signs of Hope', 'kicker': None, 'content_kicker': None, 'print_headline': 'Drop in Violence Gives a City Hope', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Memorial Day', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Gangs', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-30T14:23:49+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Monica Davey', 'person': [{'firstname': 'Monica', 'middlename': None, 'lastname': 'Davey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ee86213-73d7-514b-ac9d-5356c57a9c28', 'word_count': 1106, 'uri': 'nyt://article/0ee86213-73d7-514b-ac9d-5356c57a9c28'}, {'abstract': 'Meaty ribs from a magazine publisher who turned his hobby into a second career.', 'web_url': 'https://www.nytimes.com/2017/05/30/dining/baby-back-ribs-bbq-hero.html', 'snippet': 'Meaty ribs from a magazine publisher who turned his hobby into a second career.', 'lead_paragraph': 'At 75, the magazine publisher Stephen Sheanin has turned his hobby into a second career. Mr. Sheanin, a lifelong backyard griller, went into the smoked ribs business after his chef friends started selling his baby back ribs at their restaurants in Los Angeles. A smokehouse in California produces them, and he sells them online and in some stores. These ribs are smoky, meaty and succulent. They need but a quick reheat: BBQ Hero Ribs, $79.95 for two racks, bbqheroribs.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerribs-1/31burnerribs-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/30/dining/31burnerribs-1/31burnerribs-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerribs-1/31burnerribs-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerribs-1/31burnerribs-1-articleLarge.jpg', 'height': 328, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/30/dining/31burnerribs-1/31burnerribs-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 328}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerribs-1/31burnerribs-1-jumbo.jpg', 'height': 560, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerribs-1/31burnerribs-1-superJumbo.jpg', 'height': 1120, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Smoked Baby Back Ribs Ready for Summer Barbecues', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Serve: Smoked Ribs All Set  For Summer Barbecues', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Barbecue', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'BBQ Hero Ribs LLC', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sheanin, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mail Order Companies', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-30T14:26:17+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90573d55-a25b-59be-af21-9cdf3c343e36', 'word_count': 79, 'uri': 'nyt://article/90573d55-a25b-59be-af21-9cdf3c343e36'}, {'abstract': '“Cooking With Adrienne” chronicles the trips and recipes of a gastronome who has degenerative dementia.', 'web_url': 'https://www.nytimes.com/2017/05/30/dining/cooking-with-adrienne-book-france-recipes.html', 'snippet': '“Cooking With Adrienne” chronicles the trips and recipes of a gastronome who has degenerative dementia.', 'lead_paragraph': 'Gastronomy, and not just the Eiffel Tower, has always lured some travelers to France. Adrienne Zausner; her husband, Martin Zausner; and their friend Joan M. Harper were among those gastronomes, dining at Michelin three-star restaurants the way safarigoers checked the “Big Five” off their lists. Ms. Zausner went beyond exquisite dinners by befriending chefs, cooking with them and serving their recipes at home. Now, afflicted with primary progressive aphasia, a type of degenerative dementia, Ms. Zausner can no longer prepare lobster in Champagne sauce from L’Auberge de L’Ill or salmon in sorrel sauce from Jean Troisgros. Ms. Harper has assembled a cookbook of recipes, stories about Ms. Zausner’s travels and useful kitchen advice. Ten percent of the proceeds goes to the Association for Frontotemporal Degeneration: “Cooking With Adrienne: A Story of Friendship and Food” by Joan M. Harper (Harper Publications, $19.99), cookingwithadrienne.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerbook-1/31burnerbook-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/30/dining/31burnerbook-1/31burnerbook-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerbook-1/31burnerbook-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerbook-1/31burnerbook-1-articleLarge.jpg', 'height': 791, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/30/dining/31burnerbook-1/31burnerbook-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 791}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerbook-1/31burnerbook-1-jumbo.jpg', 'height': 1024, 'width': 777, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/dining/31burnerbook-1/31burnerbook-1-superJumbo.jpg', 'height': 2048, 'width': 1554, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Food Memories of Travels to France', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Appreciate: A Cookbook of Memories From Travels to France', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Cooking With Adrienne: A Story of Friendship and Food (Book)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Harper, Joan M', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Zausner, Adrienne', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Frontotemporal Dementia', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-05-30T14:32:22+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e97fe1f-18d4-5682-8b67-74080b979fc4', 'word_count': 142, 'uri': 'nyt://article/1e97fe1f-18d4-