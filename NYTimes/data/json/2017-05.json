21gopnik-superJumbo-v2.jpg', 'height': 1458, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/opinion/sunday/21gopnik/21gopnik-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/21/opinion/sunday/21gopnik/21gopnik-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/opinion/sunday/21gopnik/21gopnik-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '4-Year-Olds Don’t Act Like Trump', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': '4-Year-Olds Don’t Act Like This', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-20T18:30:32+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Alison Gopnik', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Gopnik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/2a6b8b9b-e058-58c5-9dbf-e226fe02f578', 'word_count': 693, 'uri': 'nyt://article/2a6b8b9b-e058-58c5-9dbf-e226fe02f578'}, {'abstract': 'The president’s revolution has already evaporated.', 'web_url': 'https://www.nytimes.com/2017/05/20/opinion/donald-trump-establishment-sellout.html', 'snippet': 'The president’s revolution has already evaporated.', 'lead_paragraph': 'WHICH side are you on? Are you with Donald Trump, or with the Washington insiders who want to undo his election? Do you favor the legitimate president of the United States, or an unelected “deep state” — bureaucrats, judges, former F.B.I. directors, the media — that’s determined not to let him govern? Are you going to let a counterrevolution by elites bring down a man who was elevated to the White House precisely because the country knows that its elite is no longer fit to govern?', 'print_section': 'SR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/opinion/sunday/21Douthat/21Douthat-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/21/opinion/sunday/21Douthat/21Douthat-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/opinion/sunday/21Douthat/21Douthat-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/opinion/sunday/21Douthat/21Douthat-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/21/opinion/sunday/21Douthat/21Douthat-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/opinion/sunday/21Douthat/21Douthat-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/opinion/sunday/21Douthat/21Douthat-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Donald Trump, Establishment Sellout', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Mr. Trump, Establishment  Sellout', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Trump, Donald J', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-20T18:30:34+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e035c293-aba1-5a60-94ec-b568d5ef5f09', 'word_count': 815, 'uri': 'nyt://article/e035c293-aba1-5a60-94ec-b568d5ef5f09'}, {'abstract': 'I grew up without money. My financial plan includes all the lipstick I want.', 'web_url': 'https://www.nytimes.com/2017/05/20/opinion/sunday/rainy-day-savings-money.html', 'snippet': 'I grew up without money. My financial plan includes all the lipstick I want.', 'lead_paragraph': 'The only time I ever saw my mother in an actual bank was the day my parents sat down at the kitchen table and decided, much to the relief of every family within earshot of our suburban home, to finally get a divorce. They shook hands amicably, and Mom excused herself, then drove us both straight to the bank to withdraw all but one dollar from my