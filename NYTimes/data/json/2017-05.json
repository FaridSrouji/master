/21mag-21eat-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/magazine/21eat1-copy/21mag-21eat-t_CA0-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/magazine/21eat1-copy/21mag-21eat-t_CA0-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/magazine/21eat1-copy/21eat1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/21/magazine/21eat1-copy/21eat1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/21/magazine/21eat1-copy/21eat1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chowder-Soaked Toast Any Chef Would Want to Claim', 'kicker': 'Eat', 'content_kicker': None, 'print_headline': 'Cooking in My Own Voice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soups', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Prune (Manhattan, NY, Restaurant)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Merriman, Ashley', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-05-18T09:00:28+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Gabrielle Hamilton', 'perso