bo.jpg', 'height': 703, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/24/world/24TrumpManchesterSub/24TrumpManchesterSub-superJumbo.jpg', 'height': 1406, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/24/world/24TrumpManchesterSub/24TrumpManchesterSub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/24/world/24TrumpManchesterSub/24TrumpManchesterSub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/24/world/24TrumpManchesterSub/24TrumpManchesterSub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Manchester Attack Changes the Conversation for Trump’s Trip', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Attack Changes the Conversation as the President Travels On to Europe', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Terrorism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Manchester Arena Bombing (May, 2017)', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-05-23T08:54:52+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90348976-7d98-5843-a5a5-56939df64b34', 'word_count': 1052, 'uri': 'nyt://article/90348976-7d98-5843-a5a5-56939df64b34'}, {'abstract': 'Americans may be losing faith in the idea that any figure or institution can rise entirely above the partisan fray.', 'web_url': 'https://www.nytimes.com/2017/05/23/magazine/can-anyone-be-truly-independent-in-todays-polarized-politics.html', 'snippet': 'Americans may be losing faith in the idea that any figure or institution can rise entirely above the partisan fray.', 'lead_paragraph': 'Late in the 19th century, America was besieged by grave problems: rising economic inequality, violent labor struggles, deep conflicts over immigration and race. But the nation’s leaders seemed incapable of addressing any of these things; they frittered away their hours in disputes over tariffs and trade, and when election time came, they lined up in their respective parties, each one hoping for the chance to distribute the federal spoils to itself. Presidential elections were achingly close: In 1888, Grover Cleveland won the popular vote but lost to Benjamin Harrison in the Electoral College, fueling a sense that the political process no longer worked properly.', 'print_section': 'MM', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28firstwords/28mag-28firstwords-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/28/magazine/28firstwords/28mag-28firstwords-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28firstwords/28mag-28firstwords-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28firstwords/28mag-28firstwords-t_CA0-articleLarge.jpg', 'height': 516, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/28/magazine/28firstwords/28mag-28firstwords-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 516}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28firstwords/28mag-28firstwords-t_CA0-jumbo.jpg', 'height': 881, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28firstwords/28mag-28firstwords-t_CA0-superJumbo.jpg', 'height': 1762, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Can Anyone Be Truly ‘Independent’ In Today’s Polarized Politics?', 'kicker': 'First Words', 'content_kicker': None, 'print_headline': 'Free Agents', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Comey, James B', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mueller, Robert S III', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-23T09:00:05+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Beverly Gage', 'person': [{'firstname': 'Beverly', 'middlename': None, 'lastname': 'Gage', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35b5da34-1cbc-5566-9cec-bda128c3ff18', 'word_count': 1493, 'uri': 'nyt://article/35b5da34-1cbc-5566-9cec-bda128c3ff18'}, {'abstract': 'In an era of analysts and HD broadcasts, audiences don’t see the players as larger-than-life characters anymore.', 'web_url': 'https://www.nytimes.com/2017/05/23/magazine/where-did-the-great-hollywood-baseball-movie-go.html', 'snippet': 'In an era of analysts and HD broadcasts, audiences don’t see the players as larger-than-life characters anymore.', 'lead_paragraph': 'This spring, trying to bring some routine to my life as a new father, I made a pledge to watch a lot more baseball. It started out well enough: The Mets, my adopted team, ran out to a reasonably strong start before the injuries and losses started piling up in late April. But my attention also wandered, much more so than it does when I watch basketball or football. My pseudoscientific interest in the sport has long since passed — there was a time when I would dive into any statistical study with the same delight as a biology student first dissecting a frog and seeing how all the organs connect beneath the surface. Now that baseball has become more of a therapeutic diversion, I find myself wishing I knew how to put the frog back together.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28onsports1-copy/28onsports1-articleLarge.jpg', 'height': 721, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/28/magazine/28onsports1-copy/28onsports1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 721}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28onsports1-copy/28onsports1-jumbo.jpg', 'height': 1024, 'width': 853, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28onsports1-copy/28onsports1-superJumbo.jpg', 'height': 2048, 'width': 1706, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28onsports1-copy/28onsports1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/28/magazine/28onsports1-copy/28onsports1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/28/magazine/28onsports1-copy/28onsports1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Where Did the Great Hollywood Baseball Movie Go?', 'kicker': 'On Sports', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Bull Durham (Play)', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-05-23T09:00:05+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Jay Caspian Kang', 'person': [{'firstname': 'Jay', 'middlename': 'Caspian', 'lastname': 'Kang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f736231b-5aa6-5576-b1f6-1c773a038576', 'word_count': 1291, 'uri': 'nyt://article/f736231b-5aa6-5576-b1f6-1c773a038576'}, {'abstract': 'In a special travel edition of Match Book,