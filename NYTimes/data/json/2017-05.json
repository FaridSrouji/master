'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'War Hero’s Family Suing in Its Decades-Long Fight to Identify Remains', 'kicker': None, 'content_kicker': None, 'print_headline': 'Decades-Long Fight to Identify War Hero’s Remains', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Nininger, Alexander Ramsey Jr', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cemeteries', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Medal of Honor (US)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Military Academy', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-05-29T04:01:27+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Dave Philipps', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Philipps', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f23e51e1-7959-5267-8270-2684973bfbc2', 'word_count': 1356, 'uri': 'nyt://article/f23e51e1-7959-5267-8270-2684973bfbc2'}, {'abstract': 'The North has recently test-fired missiles based on a technology that would give the United States little warning of an attack. And they seem to work.', 'web_url': 'https://www.nytimes.com/2017/05/29/us/politics/north-koreas-missiles-us-defense.html', 'snippet': 'The North has recently test-fired missiles based on a technology that would give the United States little warning of an attack. And they seem to work.', 'lead_paragraph': 'WASHINGTON — As the Pentagon prepares to conduct its first test in three years of the multibillion-dollar effort to intercept a North Korean warhead, it hopes to demonstrate that