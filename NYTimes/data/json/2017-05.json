one}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Icaros: A Vision (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Caraballo, Leonor', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Norzi, Matteo', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Farman, Abou', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-05-18T20:50:43+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/21058640-fabb-5e02-a2d0-8a247383f8f4', 'word_count': 266, 'uri': 'nyt://article/21058640-fabb-5e02-a2d0-8a247383f8f4'}, {'abstract': 'The author, Beatrice Trum Hunter, who died at 98, credited the natural ingredients she used for helping her live longer than people who relied on processed foods.', 'web_url': 'https://www.nytimes.com/2017/05/18/us/beatrice-trum-hunter-natural-foods-cookbook-recipes.html', 'snippet': 'The author, Beatrice Trum Hunter, who died at 98, credited the natural ingredients she used for helping her live longer than people who relied on processed foods.', 'lead_paragraph': 'Decades before “organic,” “raw” and “natural” became watchwords in some quarters for the most desirable of foods, Beatrice Trum Hunter published “The Natural Foods Cookbook,” which scorned sugar while promoting whole grains, vegetables and fruits.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Sampling of ‘Natural Foods Cookbook’ Recipes', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Taste of the Cookbook', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cook