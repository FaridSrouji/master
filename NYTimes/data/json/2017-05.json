ne, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07BADASS1/07BADASS1-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07BADASS1/07BADASS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/07/arts/07BADASS1/07BADASS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07BADASS1/07BADASS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Women Who Have the Chops (and the Punches and the Kicks)', 'kicker': None, 'content_kicker': None, 'print_headline': 'Women Who Have the Chops', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Michelle', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Theron, Charlize', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Yeoh, Michelle', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Jovovich, Milla', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-05-05T14:00:26+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Julie Bloom', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bloom', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5454ac7d-38fc-50f7-a8a6-9cc5d7466c2c', 'word_count': 1402, 'uri': 'nyt://article/5454ac7d-38fc-50f7-a8a6-9cc5d7466c2c'}, {'abstract': 'This cult feminist novel has been adapted, and updated, by the creator of “Transparent” for Amazon.', 'web_url': 'https://www.nytimes.com/2017/05/05/arts/television/i-love-dick-amazon-chris-kraus-and-jill-soloway.html', 'snippet': 'This cult feminist novel has been adapted, and updated, by the creator of “Transparent” for Amazon.', 'lead_paragraph': 'Twenty years ago, “I Love Dick” — Chris Kraus’s novel chronicling her one-sided obsession with a cultural critic named Dick and how she staked out her own identity as a writer through a wild series of letters to him — was published to little notice. Since then, it has grown into a feminist cult classic. The book anticipated an era of popular female autofiction — from Emily Gould’s “And the Heart Says Whatever” to Sheila Heti’s “How Should a Person Be?” — and with a cheeky title that feels made to be Instagrammed, it has taken on new resonance as a text for women in the social media age. This month, it will continue its pop cultural rise with a television adaptation by another feminist auteur.', 'print_section': 'AR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07ILOVEDICK1/07ILOVEDICK1-articleLarge.jpg', 'height': 878, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/07/arts/07ILOVEDICK1/07ILOVEDICK1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 878}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07ILOVEDICK1/07ILOVEDICK1-jumbo.jpg', 'height': 1024, 'width': 700, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/07/arts/07ILOVEDICK1/07ILOVEDICK