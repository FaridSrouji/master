iew/04bailey/04bailey-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/06/04/books/review/04bailey/04bailey-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Late — and Maybe Last — Collection of F. Scott Fitzgerald’s ‘Lost’ Stories', 'kicker': 'Fiction', 'content_kicker': None, 'print_headline': 'Lost and Found', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fitzgerald, F Scott', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': "I'd Die for You And Other Lost Stories (Book)", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-05-30T15:01:18+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Blake Bailey', 'person': [{'firstname': 'Blake', 'middlename': None, 'lastname': 'Bailey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2de016e6-3129-59c5-a964-2de121116132', 'word_count': 1683, 'uri': 'nyt://article/2de016e6-3129-59c5-a964-2de121116132'}, {'abstract': 'The latest jarred sauces from Casablanca Foods give cooks a head start making a dinner inspired by a North African favorite.', 'web_url': 'https://www.nytimes.com/2017/05/30/dining/mina-tagine-cooking-sauce-casablanca-foods.html', 'snippet': 'The latest jarred sauces from Casablanca Foods give cooks a head start making a dinner inspired by a North African favorite.', 'lead_paragraph': 'Mina Kallamni, a native of Morocco, has gradually expanded the North African products she carries since she founded Casablanca Foods seven years ago. A set of tagine sauces, each tailored to a different protein, is the latest addition. The sauces do not let the home cook completely off the hook, because the recipes call for additional ingredients, careful assembly and cooking. The tagine sauce for fish is thick, tomato-y and warmly spiced. With the fairly thin citric sauce for poultry, you are on you way to classic lemon chicken. The sauce for beef and lamb is complex and robust: Mina Tagine sauces, $6 for 12 ounces, casablancafoods.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/dining/31burnersauce-1/31burnersauce-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/26/dining/31burnersauce-1/31burnersauce-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/dining/31burnersauce-1/31burnersauce-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/dining/31burnersauce-1/31burnersauce-1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/26/dining/31burnersauce-1/31burnersauce-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/dining/31burnersauce-1/31burnersauce-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/dining/31burnersauce-1/31burnersauce-1-sup