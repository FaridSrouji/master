.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/30/opinion/30tues2web/30tues2web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/opinion/30tues2web/30tues2web-jumbo.jpg', 'height': 693, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/opinion/30tues2web/30tues2web-superJumbo.jpg', 'height': 1387, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Show HUD’s Budget Cuts the Door', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Show HUD’s Budget Cuts the Door', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Public and Subsidized Housing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Poverty', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Affordable Housing', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Housing and Urban Development Department', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Carson, Benjamin S', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-05-30T07:21:04+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/e232b969-6a35-5d84-ac7e-a35f5d5dacc7', 'word_count': 474, 'uri': 'nyt://article/e232b969-6a35-5d84-ac7e-a35f5d5dacc7'}, {'abstract': 'Republicans say their pass-through tax cut will help small businesses. But the big winners are the 1 percent.', 'web_url': 'https://www.nytimes.com/2017/05/30/opinion/trump-tax-plan-pass-through-business.html', 'snippet': 'Republicans say their pass-through tax cut will help small businesses. But the big winners are the 1 percent.', 'lead_paragraph': 'One of the major goals of tax reform is to reduce the opportunities for savvy taxpayers to game the system. But if President Trump and House Republicans have their way, we will have a new contender for the tax code’s largest loophole: a new special cap on the tax rate for so-called pass-through business income.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26batchelderWeb/26batchelderWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/26/opinion/26batchelderWeb/26batchelderWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26batchelderWeb/26batchelderWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26batchelderWeb/26batchelderWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/26/opinion/26batchelderWeb/26batchelderWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26batchelderWeb/26batchelderWeb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/26/opinion/26batchelderWeb/26batchelderWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Trump’s Giant Loophole', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Trump’s Giant Tax Loophole', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Tax', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Corporate Taxes', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-05-30T07:21:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Lily Batchelder', 'person': [{'firstname': 'Lily', 'middlename': None, 'lastname': 'Batchelder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/02ff430e-8e1d-54d4-8a3c-e5a8eec384fa', 'word_count': 815, 'uri': 'nyt://article/02ff430e-8e1d-54d4-8a3c-e5a8eec384fa'}, {'abstract': 'The Supreme Court needs to set limits on how lawmakers draw district lines to gain partisan advantage.', 'web_url': 'https://www.nytimes.com/2017/05/30/opinion/gerrymandering-supreme-court.html', 'snippet': 'The Supreme Court needs to set limits on how lawmakers draw district lines to gain partisan advantage.', 'lead_paragraph': 'Partisan gerrymandering — the dark art of drawing legislative district lines to specifically favor Republicans or Democrats — is as old as it is corrosive to a representative democracy. Self-interested politicians have no business making maps with the sole purpose of keeping themselves and their party in power.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/opinion/30tue1/30tue1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/05/30/opinion/30tue1/30tue1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/opinion/30tue1/30tue1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/opinion/30tue1/30tue1-articleLarge.jpg', 'height': 722, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/05/30/opinion/30tue1/30tue1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 722}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/opinion/30tue1/30tue1-jumbo.jpg', 'height': 1024, 'width': 852, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/05/30/opinion/30tue1/30tue1-superJumbo.jpg', 'height': 1198, 'width': 996, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'When Politicians Pick Their Voters', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'When Politicians Pick Their Voters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Redistricting and Reapportionment', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'r