 many as 400 sacks of salt and dozens of empty turpentine barrels. By 5:30 that afternoon, the expedition had returned unscathed to Beaufort. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Salt Wars', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Salt', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-26T15:28:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Rick Beard', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Beard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c9ce363-0a53-56c7-b71b-9492fc76466a', 'word_count': 1743, 'uri': 'nyt://article/3c9ce363-0a53-56c7-b71b-9492fc76466a'}, {'abstract': 'Women in Chennai, Tamil Nadu, commemorating the ninth anniversary of a tsunami that killed more than 200,000 people in Asia.', 'web_url': 'https://india.blogs.nytimes.com/2013/12/26/image-of-the-day-december-26/', 'snippet': 'Women in Chennai, Tamil Nadu, commemorating the ninth anniversary of a tsunami that killed more than 200,000 people in Asia.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/26/world/asia/26-pod-tsunami-IndiaInk/26-pod-tsunami-IndiaInk-articleLarge.jpg', 'height': 383, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/26/world/asia/26-pod-tsunami-IndiaInk/26-pod-tsunami-IndiaInk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 383}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': 