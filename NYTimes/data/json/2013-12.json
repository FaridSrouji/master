ine': {'main': 'Radio Stations Find Ratings ‘Rocket Fuel’ in Switch to Christmas Format ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Radio Finds Ratings ‘Rocket Fuel’ in Switch to Christmas Format', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christmas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Radio', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Salem Communications Corporation', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Clear Channel Communications Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-21T01:16:54+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Mark Oppenheimer', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Oppenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/495ba34c-3627-5743-88f5-f2781799fa9d', 'word_count': 967, 'uri': 'nyt://article/495ba34c-3627-5743-88f5-f2781799fa9d'}, {'abstract': 'A Manhattan public relations executive loses her job after a post on Twitter about AIDS, race and Africa created an online furor.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/12/20/a-twitter-message-about-aids-africa-and-race/', 'snippet': 'A Manhattan public relations executive loses her job after a post on Twitter about AIDS, race and Africa created an online furor.', 'lead_paragraph': 'Updated, 12 p.m. A message about race and AIDS in Africa posted on the Twitter account of a Manhattan public relations executive at an Internet media giant on Friday caused a global outcry on Twitter and around the web. The executive apologized on Sunday after she was fired on Saturday.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/21/blogs/21Sacco_Tweet/2