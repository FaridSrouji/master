/02eads/02eads-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/02/business/international/02eads/02eads-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/02/business/international/02eads/02eads-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/02/business/international/02eads/02eads-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/02/business/international/02eads/02eads-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/02/business/international/02eads/02eads-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/02/business/international/02eads/02eads-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'French Court Orders Criminal Trial for EADS Shareholders', 'kicker': None, 'content_kicker': None, 'print_headline': 'Trial Ordered in EADS Insider Trading Case', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Daimler AG', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Lagardere SCA', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Insider Trading', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'European Aeronautic Defense and Space Co', 'rank': 5, 'major': 'N'}, {'name'