one, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-31T02:07:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5de62d9d-77cb-53b8-b7a5-4c774de7651b', 'word_count': 0, 'uri': 'nyt://article/5de62d9d-77cb-53b8-b7a5-4c774de7651b'}, {'abstract': 'A burst of enrollment in the health insurance exchange continued even after the Dec. 24 deadline for coverage starting Jan. 1.', 'web_url': 'https://www.nytimes.com/2013/12/31/nyregion/sign-ups-surge-in-new-york-states-health-exchange.html', 'snippet': 'A burst of enrollment in the health insurance exchange continued even after the Dec. 24 deadline for coverage starting Jan. 1.', 'lead_paragraph': 'After a rush of 11th-hour interest, 230,624 people had enrolled in either private or public insurance through New York State’s health insurance exchange by the Dec. 24 deadline, qualifying them for coverage on the first day of the new year, state officials said on Monday.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sign-Ups Surge in New York State’s Health Exchange', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sign-Ups Surge in State’s Health Exchange', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'HealthCare.gov', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-31T02:08:59+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Anemona Hartocollis', 'person': [{'firstname': 'Anemona', 'middlename': None, 'lastname': 'Hartocollis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1874d63a-f1b2-5018-96b5-c26f46e46287', 'word_count': 363, 'uri': 'nyt://article/1874d63a-f1b2-5018-96b5-c26f46e46287'}, {'abstract': 'Paying tribute to luminaries like Julie Harris, James Gandolfini, Edward I. Koch, Margaret Thatcher, Nelson Mandela and many others.', 'web_url': 'https://www.nytimes.com/2013/12/31/us/a-moment-for-the-flames-that-went-out-in-2013.html', 'snippet': 'Paying tribute to luminaries like Julie Harris, James Gandolfini, Edward I. Koch, Margaret Thatcher, Nelson Mandela and many others.', 'lead_paragraph': 'They were headline names, and when accompanied by just one profound word, “died,” nothing more needed to be explained. The news could startle or even shock when it was unexpected, arouse a sympathetic sigh when it seemed to be in the natural order of things, shake loose a memory.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Moment for the Flames That Went Out in 2013', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Moment for the Flames That Went Out in 2013', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McDonald, William', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-31T02:17:50+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'U.S.', 'byline': {'original': 'By William McDonald', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'McDonald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organi