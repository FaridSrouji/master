8a74-bf056725ab8d', 'word_count': 620, 'uri': 'nyt://article/3c05d970-a6c0-5a5f-8a74-bf056725ab8d'}, {'abstract': 'A video chat with Catherine Mann, a finance professor at Brandeis, about whether the Federal Reserve is helping only the rich with its stimulus policies.', 'web_url': 'https://economix.blogs.nytimes.com/2013/12/03/whom-the-fed-is-enriching/', 'snippet': 'A video chat with Catherine Mann, a finance professor at Brandeis, about whether the Federal Reserve is helping only the rich with its stimulus policies.', 'lead_paragraph': 'At a November confirmation hearing, Janet Yellen was asked whether Federal Reserve policies had mostly benefited wealthy people, while doing little to improve life for the common man. After all, ultra-low interest rates and quantitative easing likely contributed to the run-up in stock prices over the last few years.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Whom the Fed Is Enriching', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Quantitative Easing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mann, Catherine L', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Yellen, Janet L', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-03T19:43:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cdeb74f9-a31d-5760-b208-e796d1e5458f', 'word_count': 122, 'uri': 'nyt://article/cd