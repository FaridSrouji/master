type': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/Adco/Adco-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/17/business/Adco/Adco-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/Adco/Adco-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/Adco/Adco-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/Adco/Adco-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/17/business/Adco/Adco-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/Adco/Adco-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seinfeld’s Deliberately Inept Web Campaign for Acura', 'kicker': None, 'content_kicker': None, 'print_headline': 'Seinfeld’s Deliberately Inept Web Campaign for Acura', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Newman, Andrew Adam', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ACURA DIVISION OF HONDA MOTOR CO', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Seinfeld, Jerry', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-17T02:03:07+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Andrew Adam Newman', 'person': [{'firstname': 'Andrew', 'middlename': 'Adam', 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/191c4501-982f-5297-a843-01f7e05d4a9c', 'word_count': 950, 'uri': 'nyt://article/191c4501-982f-5297-a843-01f7e05d4a9c'}, {'abstract': 'Even officials who support the stimulus agree that the Federal Reserve should taper off on its bond buying and focus on stimulating the economy by other means. It’s just a matter of timing.', 'web_url': 'https://www.nytimes.com/2013/12/17/business/economy/many-detect-shift-by-fed-on-program-to-buy-bonds.html', 'snippet': 'Even officials who support the stimulus agree that the Federal Reserve should taper off on its bond buying and focus on stimulating the economy by other means. It’s just a matter of timing.', 'lead_paragraph': 'WASHINGTON — The beginning of the end probably will not come on Wednesday, but it is coming soon. The Federal Reserve has made clear that its bond-buying campaign will not continue at the present pace for much longer.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/international/17fed/17fed-articleLarge.jpg', 'height': 422, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/17/business/international/17fed/17fed-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 422}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/international/17fed/17fed-jumbo.jpg', 'height': 720, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/international/17fed/17fed-superJumbo.jpg', 'height': 1441, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/international/17fed/17fed-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/17/business/international/17fed/17fed-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/business/international/17fed/17fed-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Many Detect End of Line for Stimulus by the Fed', 'kicker': None, 'content_kicker': None, 'print_headline': 'Many Detect End of Line For Stimulus by the Fed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Appelbaum, Binyamin', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Quantitative Easing', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-17T02:05:03+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/22440a57-d17b-5a29-8853-94be1b413afd', 'word_count': 1002, 'uri': 'nyt://article/22440a57-d17b-5a29-8853-94be1b413afd'}, {'abstract': 'The European Union will provide “an unprecedented package of European political, economic and security support” to the Israelis and Palestinians if they reach a permanent peace deal, the union said in a statement.', 'web_url': 'https://www.nytimes.com/2013/12/17/world/europe/eu-pledges-aid-for-mideast-peace.html', 'snippet': 'The European Union will provide “an unprecedented package of European political, economic and security support” to the Israelis and Palestinians if they reach a permanent peace deal, the union said in a statement.', 'lead_paragraph': ' The European Union will provide “an unprecedented package of European political, economic and security support” to the Israelis and Palestinians if they reach a permanent peace deal, the union said in a statement on Monday after a foreign affairs council meeting in Brussels. The package will offer Israel and the future Palestinian state a special privileged partnership, including increased access to the European markets, closer cultural and scientific links, facilitation of trade and investments as well as promotion of business-to-business relations, the statement added. The European Union also condemned continued Israeli settlement construction and expressed concern over incitement and episodes of violence, actions it said undermined peace negotiations. Secretary of State John Kerry brokered a resumption of Israeli-Palestinian talks in July after years of stagnation. ', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'E.U. Pledges Aid for Mideast Peace', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'E.U. Pledges Aid for Mideast Peace', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'European Union', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-17T02:05:25+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Isabel Kershner', 'person': [{'firstname': 'Isabel', 'middlename': None, 'lastname': 'Kershner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/e6ce1b11-aef5-5bc5-876e-1788a84be39d', 'word_count': 125, 'uri': 'nyt://article/e6ce1b11-aef5-5bc5-876e-1788a84be39d'}, {'abstract': 'Ryan Freel, who committed suicide last year, has become the first baseball player linked to chronic traumatic encephalopathy, a disease more commonly associated with football players.', 'web_url': 'https://www.nytimes.com/2013/12/17/sports/baseball/playing-with-abandon-may-have-exacted-toll.html', 'snippet': 'Ryan Freel, who committed suicide last year, has become the first baseball player linked to chronic traumatic encephalopathy, a disease more commonly associated with football players.', 'lead_paragraph': 'A special Mass at a Roman Catholic church on Sunday in Jacksonville, Fla., was planned as a remembrance for Ryan Freel, a former major leaguer who committed suicide nearly one year ago at 36. It became more than that, however, after Freel’s family had learned four days earlier of a factor that might have precipitated his death on Dec. 22, 2012.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/sports/jpFREEL/jpFREEL-articleLarge.jpg', 'height': 528, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/17/sports/jpFREEL/jpFREEL-articleLarge.jpg', 'xlargewidth'