one, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/fashion/05BRITMORIN1_SPAN/05BRITMORIN1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/05/fashion/05BRITMORIN1_SPAN/05BRITMORIN1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/fashion/05BRITMORIN1_SPAN/05BRITMORIN1_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Millennial D.I.Y.-er With the Digitized Touch', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Millennial D.I.Y.-er With the Digitized Touch', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Social Media', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Marikar, Sheila', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Morin, Brittany', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Brit & Co', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Do It Yourself', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-04T23:31:26+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Sheila Marikar', 'person': [{'firstname': 'Sheila', 'middlename': None, 'lastname': 'Marikar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b2cddc09-5317-580c-829c-2d86ad11a518', 'word_count': 1224, 'uri': 'nyt://article/b2cddc09-5317-580c-829c-2d86ad11a518'}, {'abstract': 'Vintage pieces repaired and resold by Stanley Furniture in North Carolina.', 'web_url': 'https://www.nytimes.com/2013/12/05/garden/classics-from-midcentury-given-a-second-chance.html', 'snippet': 'Vintage pieces repaired and resold by Stanley Furniture in North Carolina.', 'lead_paragraph': 'While developing a line of midcentury-inspired products, employees of Stanley Furniture in North Carolina collected 40 of the company’s original pieces from the 1950s and ’60s by scouring sources like eBay and Craigslist. Each item was stripped down and restored to its original condition with updated paints, finishes and upholstery. Twenty-nine of the pieces — part of a group now known as the Heritage Collection — will be sold online starting Thursday at One Kings Lane. The pieces are “true to what midcentury furniture was all about: a great attention to detail, a precise design, honest materials and construction that can withstand the test of time,” said Adam Tilley, Stanley Furniture’s vice president for product. “It’s nice to see that all those things we held dear are still alive today.” The Mix’N Match Armchair is $1,199. Information: onekingslane.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/garden/05FURNITURE/05CURR6-jumbo.jpg', 'height': 589, 'width': 432, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/garden/05FURNITURE/05CURR6-superJumbo.jpg', 'height': 589, 'width': 432, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/garden/05FURNITURE/05CURR6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/05/garden/05FURNITURE/05CURR6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013