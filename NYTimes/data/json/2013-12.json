th': 600, 'xlargeheight': 367}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/09/blogs/20131209-lens-fremson-slide-6OJS/20131209-lens-fremson-slide-6OJS-jumbo.jpg', 'height': 627, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/09/blogs/20131209-lens-fremson-slide-6OJS/20131209-lens-fremson-slide-6OJS-superJumbo.jpg', 'height': 1254, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/09/blogs/20131209-lens-fremson-slide-6OJS/20131209-lens-fremson-slide-6OJS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/09/blogs/20131209-lens-fremson-slide-6OJS/20131209-lens-fremson-slide-6OJS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/09/blogs/20131209-lens-fremson-slide-6OJS/20131209-lens-fremson-slide-6OJS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Brooklyn, Photographing an Invisible Child', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-12T10:00:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Ruth Fremson', 'person': [{'firstname': 'Ruth', 'middlename': None, 'lastname': 'Fremson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/32149782-9e06-55f2-8808-ee48f2f9874e', 'word_count': 690, 'uri': 'nyt://article/32149782-9e06-55f2-8808-ee48f2f9874e'}, {'abstract': 'It has been a year since the Newtown shootings. Federal gun laws haven’t changed. Here is why.', 'web_url': 'https://www.nytimes.com/2013/12/15/magazine/inside-the-power-of-the-nra.html', 'snippet': 'It has been a year since the Newtown shootings. Federal gun laws haven’t changed. Here is why.', 'lead_paragraph': 'To get to Joe Manchin’s private office in the Hart Senate Office Building, you first pass through a lobby where you encounter a small bronze statue of an Old West lawman holding a firearm — an award given to Manchin several years ago by a chapter of the National Rifle Association for his unswerving defense of gun rights. Then you turn down a hallway, past several framed photographs of children who were victims of the massacre a year ago at Sandy Hook Elementary School in Newtown, Conn. The combination of the bronze rifleman in the lobby and the young faces on the wall suggests a particular viewpoint — I stand with gun lovers; I stand with victims of gun violence  — that qualifies, in Washington anyway, as being nuanced, which is to say politically ill advised if not suicidal.', 'print_section': 'MM', 'print_page': '48', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15nra1/15nra1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/15/magazine/15nra1/15nra1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15nra1/15nra1-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15nra1/15nra1-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15nra1/15nra1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/15/magazine/15nra1/15nra1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15nra1/15nra1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the Power of the N.R.A.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the Power of the N.R.A.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Rifle Assn', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Draper, Robert', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Manchin, Joe III', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Newtown, Conn, Shooting (2012)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'LaPierre, Wayne', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Lobbying and Lobbyists', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Cox, Chris W', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Baker, James Jay', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-12-12T10:00:09+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Robert Draper', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Draper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/612a12de-6554-5813-8231-49989f17d6bc', 'word_count': 6695, 'uri': 'nyt://article/612a12de-6554-5813-8231-49989f17d6bc'}, {'abstract': 'Do you find your teachers to be fair graders? What do you think “A” work looks like? How is it different than A- or B+ work?', 'web_url': 'https://learning.blogs.nytimes.com/2013/12/12/does-your-school-hand-out-too-many-as/', 'snippet': 'Do you find your teachers to be fair graders? What do you think “A” work looks like? How is it different than A- or B+ work?', 'lead_paragraph': 'According to an article in its own school paper, The Crimson, the most common grade at Harvard is an A. On the Economix blog, the reporter Catherine Rampell points out that A’s have actually been the most common grade at Harvard not just recently, but also for the last 20 years — and that an A-range grade has also has been the most common grade awarded nationwide at colleges since 1997.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/09/business/economy/economix-09gradedistribution-LN/economix-09gradedistribution-articleLarge.png', 'height': 427, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/09/business/economy/economix-09gradedistribution-LN/economix-09gradedistribution-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 427}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/09/business/economy/economix-09gradedistribution-LN/economix-09gradedistribution-jumbo.png', 'height': 473, 'width': 664, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': 