s', 'value': 'Khodorkovsky, Mikhail B', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Genscher, Hans-Dietrich', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-23T21:01:40+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Alison Smale', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Smale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96d700b3-8543-5322-8371-bfb7f729ea87', 'word_count': 694, 'uri': 'nyt://article/96d700b3-8543-5322-8371-bfb7f729ea87'}, {'abstract': 'Few things say Christmas in New York quite as vividly as the “Radio City Christmas Spectacular.”', 'web_url': 'https://www.nytimes.com/slideshow/2013/12/24/arts/dance/20131224ROCKETTES.html', 'snippet': 'Few things say Christmas in New York quite as vividly as the “Radio City Christmas Spectacular.”', 'lead_paragraph': 'Few things say Christmas in New York quite as vividly as the “Radio City Christmas Spectacular.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/arts/20131224ROCKETTES-slide-69DO/20131224ROCKETTES-slide-69DO-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/23/arts/20131224ROCKETTES-slide-69DO/20131224ROCKETTES-slide-69DO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12