: 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08OPM-thumb/08OPM-thumb-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sarita Choudhury’s Anti-Education', 'kicker': 'The One-Page Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-06T15:37:38+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/55fd8c4d-96f2-57b6-b619-3a696506205d', 'word_count': 0, 'uri': 'nyt://interactive/55fd8c4d-96f2-57b6-b619-3a696506205d'}, {'abstract': 'The musician on his Bed-Stuy nickname, designing condos and living to 100.', 'web_url': 'https://www.nytimes.com/2013/12/08/magazine/lenny-kravitzs-halfway-mark.html', 'snippet': 'The musician on his Bed-Stuy nickname, designing condos and living to 100.', 'lead_paragraph': 'You grew up between the Upper East Side and Bed-Stuy. Which neighborhood did you feel more comfortable in?  Well, after I was in first grade, Monday through Friday was Upper East Side going to P.S. 6, and Friday night through Sunday night was Bed-Stuy. But I didn’t like one more than the other. I had two different lives, and in fact two different names. My name in Bed-Stuy was Eddie.', 'print_section': 'MM', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08talk/mag-08Talk-t_CA0-articleLarge.jpg', 'height': 1624, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/magazine/08talk/mag-08Talk-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1624}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08talk/mag-08Talk-t_CA0-jumbo.jpg', 'height': 1024, 'width': 379, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08talk/mag-08Talk-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 757, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08talk/mag-08Talk-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/magazine/08talk/mag-08Talk-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08talk/mag-08Talk-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lenny Kravitz’s Halfway Mark', 'kicker': None, 'content_kicker': None, 'print_headline': '‘I Still Don’t Know to This Day What Stopped Me’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kravitz, Lenny', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Kravitz Design', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-06T15:37:41+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Amy Chozick', 'person': [{'firstname': 'Interview', 'middlename': 'Amy', 'lastname': 'Chozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/ceb0b4a8-5a6b-59ea-9042-d177cf54a2c2', 'word_count': 705, 'uri': 'nyt://article/ceb0b4a8-5a6b-59ea-9042-d177cf54a2c2'}, {'abstract': 'The Asian imports that gave us Red Bull, Monster and Rockstar.', 'web_url': 'https://www.nytimes.com/2013/12/08/magazine/who-made-that-energy-drink.html', 'snippet': 'The Asian imports that gave us Red Bull, Monster and Rockstar.', 'lead_paragraph': 'The energy drink, as we know it, started in Japan. In the postwar period, amphetamines were very popular until laws were passed to curb their use in the 1950s. Then in 1962, a company called Taisho introduced Lipovitan D — a legal, energizing tonic sold in minibar-size bottles. By the 1980s, such vitamin-fortified, extra-caffeinated beverages were being regularly consumed by Japanese executives struggling to get ahead. One television ad showed Arnold Schwarzenegger bursting from a flagon like a juiced-up genie. Another had a hero in suit and tie, signing deals and making presentations as he raced around the world. “Can you fight for 24 hours a day?” he chanted with his chin upturned. “Businessman, businessman, Japanese businessman!”', 'print_section': 'MM', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08wmt/mag-08WMT-t_CA0-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/magazine/08wmt/mag-08WMT-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08wmt/mag-08WMT-t_CA0-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/magazine/08wmt/mag-08WMT-t_CA0-superJumbo.jpg', 'height': 750, 'wid