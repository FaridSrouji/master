 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/938a00f7-7356-5486-94b4-8c627c94fc33', 'word_count': 1632, 'uri': 'nyt://article/938a00f7-7356-5486-94b4-8c627c94fc33'}, {'abstract': 'The ruling on behalf of nearly 300 investors — the first of its kind in Hong Kong — is a big victory for regulators. Insider trading wasn’t even a criminal offense there before 2003.', 'web_url': 'https://dealbook.nytimes.com/2013/12/13/rare-victory-in-hong-kong-for-victims-of-insider-trading/', 'snippet': 'The ruling on behalf of nearly 300 investors — the first of its kind in Hong Kong — is a big victory for regulators. Insider trading wasn’t even a criminal offense there before 2003.', 'lead_paragraph': 'Nearly 300 Hong Kong investors are about to share an early $3 million Christmas present. That’s the amount that the former Morgan Stanley banker Du Jun has been told to pay the unwitting victims of his insider trading in 2007. White-collar criminals should beware, but investors shouldn’t expect a rush of future payments.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rare Victory in Hong Kong for Victims of Insider Trading', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Insider Trading', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'China International Trust & Investment Corp', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-13T19:20:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter Thal Larsen', 'person': [{'firstname': 'Peter', 'middlename': 'Thal', 'lastname': 'Larsen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aa8b27f7-c977-50cc-a8ea-79a0522aba79', 'word_count': 329, 'uri': 'nyt://article/aa8b27f7-c977-50cc-a8ea-79a0522aba79'}, {'abstract': 'Although its first impression left something to be desired, Chevrolet’s engineers worked on the new Malibu, curing what ailed it.', 'web_url': 'https://www.nytimes.com/2013/12/14/automobiles/video-chevrolet-breathes-new-life-into-the-2014-malibu-with-a-turbo.html', 'snippet': 'Although its first impression left something to be desired, Chevrolet’s engineers worked on the new Malibu, curing what ailed it.', 'lead_paragraph': 'When Chevrolet introduced the 2013 Malibu in the spring of 2012, the only model available for the first six months was the Eco. Critics were not impressed. Its eAssist mild hybrid power plant added cost and wasn’t overly fuel-efficient. The trunk-mounted battery cut into cargo capacity and flexibility. The back seat was tight on knee and legroom. Despite a quiet and stylish cabin, Malibu failed to make the all-important good first impression.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video: Chevrolet Breathes New Life Into the 2014 Malibu With a Turbo', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'General Motors', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chevrolet Division of General Motors Corp', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-13T19:24:22+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Automobiles', 'byline': {'original': 'By Tom Voelk', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Voelk', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2f54db32-6834-504a-8952-bea60ef524d1', 'word_count': 307, 'uri': 'nyt://article/2f54db32-6834-504a-8952-bea60ef524d1'}, {'abstract': 'Ben Ratliff, Jon Caramanica and Jon Pareles discuss their picks for the year’s best in pop and jazz.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/13/popcast-the-best-albums-and-songs-of-2013/', 'snippet': 'Ben Ratliff, Jon Caramanica and Jon Pareles discuss their picks for the year’s best in pop and jazz.', 'lead_paragraph': 'This week: The New York Times pop and jazz critics discuss their top 10 albums of 2013. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/arts/popcast-drake/popcast-drake-articleLarge.jpg', 'height': 372, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/13/arts/popcast-drake/popcast-drake-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 372}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/arts/popcast-drake/popcast-drake-jumbo.jpg', 'height': 635, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/arts/popcast-drake/popcast-drake-superJumbo.jpg', 'height': 1269, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/arts/popcast-drake/popcast-drake-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/13/arts/popcast-drake/popcast-drake-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/arts/popcast-drake/popcast-drake-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Popcast: The Best Albums and Songs of 2013', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T19:26:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/df4acf67-30bb-5707-8819-ce5be4dceae3', 'word_count': 162, 'uri': 'nyt://article/df4acf67-30bb-5707-8819-ce5be4dceae3'}, {'abstract': 'Juicy escapism predominated on television this year, with series like “Scandal,” “Revenge” and “House of Cards” eclipsing offerings like ‘The Newsroom.’', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/television/alessandra-stanley-sizes-up-2013-tv-fare.html', 'snippet': 'Juicy escapism predominated on television this year, with series like “Scandal,” “Revenge” and “House of Cards” eclipsing offerings like ‘The Newsroom.’', 'lead_paragraph': 'This was the year that prose turned purple, binge viewing trumped appointment television, and “Scandal” took the place of “Breaking Bad” as the hot drama everyone wanted to talk about. Television is still in a golden age, but the best of 2013 looked a little brassy, more Aaron Spelling than Aaron Sorkin.', 'print_section': 'AR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlar