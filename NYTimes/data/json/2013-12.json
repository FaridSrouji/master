stname': 'Maïa', 'middlename': None, 'lastname': 'de la Baume', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5eae2b65-294c-501a-852b-1047690f9a4e', 'word_count': 230, 'uri': 'nyt://article/5eae2b65-294c-501a-852b-1047690f9a4e'}, {'abstract': 'The Food and Drug Administration has approved eight injections to be used to treat the sometimes painful and embarrassing curvature known as Peyronie’s disease.', 'web_url': 'https://www.nytimes.com/2013/12/07/business/fda-approves-treatment-for-curved-penis.html', 'snippet': 'The Food and Drug Administration has approved eight injections to be used to treat the sometimes painful and embarrassing curvature known as Peyronie’s disease.', 'lead_paragraph': 'The first drug to treat Peyronie’s disease — an embarrassing and sometimes painful curvature of the penis — won approval on Friday from the Food and Drug Administration.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Injections to Treat an Embarrassing Ailment Win U.S. Approval ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Injections to Treat an Embarrassing Ailment Win U.S. Approval', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pollack, Andrew', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Penis', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Auxilium Pharmaceuticals Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-06T22:50:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Andrew Pollack', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Pollack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da07e55b-5644-5480-94ed-795e0c59e86e', 'word_count': 359, 'uri': 'nyt://article/da07e55b-5644-5480-94ed-795e0c59e86e'}, {'abstract': 'João Silva, a New York Times staff photographer who grew up in apartheid South Africa, recalls his awakening as a photojournalist, on the eve of Nelson Mandela’s release from prison in 1990.', 'web_url': 'https://lens.blogs.nytimes.com/2013/12/06/photographing-outside-apartheids-white-bubble/', 'snippet': 'João Silva, a New York Times staff photographer who grew up in apartheid South Africa, recalls his awakening as a photojournalist, on the eve of Nelson Mandela’s release from prison in 1990.', 'lead_paragraph': 'João Silva was among a handful of photographers who made their reputation chronicling the fall of apartheid in South Africa. While he has gone on to cover conflicts in Iraq, Afghanistan and elsewhere, he still lives and works in South Africa, even photographing mourners gathering in front of Nelson Mandela’s home on Friday (below). Mr. Silva recalls covering those momentous years leading up to and after Mr. Mandela’s election as South Africa’s first black president in a conversation with Shreeya Sinha, an editor at the international desk, which has been edited. More photos by Mr. Silva of Mr. Mandela, and recollections by other photographers, were published Friday in a multimedia feature.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/06/blogs/20131206-lens-silva-slide-1BBM/20131206-lens-silva-slide-1BBM-articleLarge.jpg', 'height': 911, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/06/blogs/20131206-lens-silva-slide-1BBM/20131206-lens-silva-slide-1BBM-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 91