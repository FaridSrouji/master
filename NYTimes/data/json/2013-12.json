ations', 'value': 'Communist Party of China', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Shenzhen (China)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-13T12:26:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Chris Buckley', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Buckley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ddb03327-2c9a-5a8b-817a-2f38aff9e12f', 'word_count': 267, 'uri': 'nyt://article/ddb03327-2c9a-5a8b-817a-2f38aff9e12f'}, {'abstract': 'France tries to stop the killing in the Central African Republic.', 'web_url': 'https://www.nytimes.com/2013/12/13/opinion/chappatte-going-it-alone.html', 'snippet': 'France tries to stop the killing in the Central African Republic.', 'lead_paragraph': 'France tries to stop the killing in the Central African Republic.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/14/opinion/14chappatte/14chappatte-articleLarge.jpg', 'height': 424, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/14/opinion/14chappatte/14chappatte-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 424}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/14/opinion/14chappatte/14chappatte-jumbo.jpg', 'height': 723, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/14/opinion/14chappatte/14chappatte-superJumbo.jpg', 'height': 723, 'width': 1024, 'subType': 'superJumbo', 'crop_name': 'superJumbo'