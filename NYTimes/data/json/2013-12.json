'name': 'organizations', 'value': "Baby's All Right (Brooklyn, NY, Music Venue)", 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Forney, Ali, Center', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-27T16:54:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c602f6c5-342c-5556-9c80-5c06043d5b7c', 'word_count': 206, 'uri': 'nyt://article/c602f6c5-342c-5556-9c80-5c06043d5b7c'}, {'abstract': 'When websites go wrong.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/12/27/the-big-screwup/', 'snippet': 'When websites go wrong.', 'lead_paragraph': 'You know how it went. They made big promises: just go to the website, provide the information, and all will be well. What actually happened was nothing like that. It’s true that many, perhaps most people did in the end manage to get what they sought; but millions found themselves frustrated and angry. Was it a disaster? That depends on which anecdotes you choose to emphasize. Will it have long-run consequences? Too soon to tell.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Big Screwup', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-27T16:55:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/694cf4b4-97dd-58f3-9693-8aa0cfc9632c', 'word_count': 242, 'uri': 'nyt://article/694