r': 'N'}], 'pub_date': '2013-12-05T22:34:03+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Lisa Prevost', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': 'Prevost', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f53ef054-718e-5369-ac61-37d8c4524547', 'word_count': 610, 'uri': 'nyt://article/f53ef054-718e-5369-ac61-37d8c4524547'}, {'abstract': 'Memories of Nelson Mandela by Ian Fisher, who was Nairobi bureau chief from 1998 to 2001.', 'web_url': 'https://www.nytimes.com/2013/12/05/world/africa/memories-of-mandela-the-power-of-a-man-speaking-truth.html', 'snippet': 'Memories of Nelson Mandela by Ian Fisher, who was Nairobi bureau chief from 1998 to 2001.', 'lead_paragraph': 'I will give away the story of my only encounter with Nelson Mandela by saying my wife was just pregnant at the time with our second child. We saddled this small creature with the very big name of Nelson, and here is why:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Power of a Man Speaking Truth', 'kicker': 'Memories of Mandela', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mandela, Nelson', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'South Africa', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Burundi', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Rwanda', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-05T22:35:11+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Ian Fisher', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Fisher', 'qualifier': None, 'title': None, 'ro