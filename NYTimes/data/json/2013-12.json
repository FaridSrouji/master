: 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elder Care', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-02T18:09:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Paula Span', 'person': [{'firstname': 'Paula', 'middlename': None, 'lastname': 'Span', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e8b0236-12a3-5563-a2a0-2f17ee8baa4f', 'word_count': 685, 'uri': 'nyt://article/9e8b0236-12a3-5563-a2a0-2f17ee8baa4f'}, {'abstract': 'Ms. Kaplan says being a white woman in the field of black studies helped her sympathize with the women in her new book, “Miss Anne in Harlem.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/02/the-read-around-carla-kaplan/', 'snippet': 'Ms. Kaplan says being a white woman in the field of black studies helped her sympathize with the women in her new book, “Miss Anne in Harlem.”', 'lead_paragraph': 'In “The Read Around,” a weekly video feature, authors discuss the when, where and how behind their books. Below, Carla Kaplan, the author of “Miss Anne in Harlem: The White Women of the Black Renaissance,” talks about her research habits, why this project took longer to write than she expected, and how being a white woman in the field of black studies helped her sympathize with the people in her book.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Read Around: Carla Kaplan', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kaplan, Carla', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-02T18:14:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e82a784-6c04-5ec4-85a9-fb52f531e544', 'word_count': 71, 'uri': 'nyt://article/8e82a784-6c04-5ec4-85a9-fb52f531e544'}, {'abstract': 'The general public may think preventing inflation should be a priority, but many economists disagree, and a new paper is the latest evidence.', 'web_url': 'https://economix.blogs.nytimes.com/2013/12/02/economists-are-different-from-you-and-me/', 'snippet': 'The general public may think preventing inflation should be a priority, but many economists disagree, and a new paper is the latest evidence.', 'lead_paragraph': 'The newly minted Nobel laureate Robert Shiller reported in a 1997 paper, based on polling data, that economists worry much less about inflation than does the general public. The poll asked, for example, whether “preventing high inflation is an important national priority, as important as preventing drug abuse or preventing deterioration in the quality of our schools.” Eighty-four percent of Americans agreed but, among economists, only 46 percent agreed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Economists Are Different From You and Me', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economics (Theory and Philosophy)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Inflation (Economics)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shiller, Robert J', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Yellen, Janet L', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-12-02T18:16:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/79976939-1a19-5115-863a-812472831f7c', 'word_count': 698, 'uri': 'nyt://article/79976939-1a19-5115-863a-812472831f7c'}, {'abstract': 'A Penn and Teller film documents a quest to find out whether the Dutch painter Johannes Vermeer had help from an optical device. And a Manhattan event involves the Flatiron Building, hundreds of volunteers and glow sticks.', 'web_url': 'https://www.nytimes.com/2013/12/03/science/image-mysteries-and-flatiron-glow-sticks.html', 'snippet': 'A Penn and Teller film documents a quest to find out whether the Dutch painter Johannes Vermeer had help from an optical device. And a Manhattan event involves the Flatiron Building, hundreds of volunteers and glow sticks.', 'lead_paragraph': 'December events at the intersection of science and culture. ', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Image Mysteries and Flatiron Glow Sticks', 'kicker': 'The Scan', 'content_kicker': None, 'print_headline': 'Image Mysteries and Flatiron Glow Sticks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Physics', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Flatiron Building (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Penn, Jillette', 'rank': 7, 'major': 'N'}, {'name