value': 'Connecticut', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-23T02:07:33+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/df499d91-8ee1-5930-a5ac-0fa741140827', 'word_count': 194, 'uri': 'nyt://article/df499d91-8ee1-5930-a5ac-0fa741140827'}, {'abstract': 'The failure to pass meaningful gun safety laws is part of the tragedy of the Newtown school massacre.', 'web_url': 'https://www.nytimes.com/2013/12/23/opinion/congresss-temerity-on-gun-safety.html', 'snippet': 'The failure to pass meaningful gun safety laws is part of the tragedy of the Newtown school massacre.', 'lead_paragraph': 'Despite lawmakers’ copious sympathy for the 26 victims of the Newtown, Conn., school massacre, all members of Congress were able to manage in the way of gun safety as they left town was renewal of the ban on the manufacture of plastic firearms. This is a type of arcane weapon that figured not at all in the Sandy Hook Elementary School rampage in 2012, nor in the mass shootings featuring adapted weapons of war that have occurred on average every two weeks somewhere in America.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Congress’s Temerity on Gun Safety', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Congress’s Temerity on Gun Safety', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Newtown, Conn, Shooting (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-23T02:09:25+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/4fa0ddd7-2076-5428-957b-b783067d843c', 'word_count': 265, 'uri': 'nyt://article/4fa0ddd7-2076-5428-957b-b783067d843c'}, {'abstract': 'Mr. Kitchen rose through the ranks of the aerospace company during a 30-year career and led the company through rocky tussles with governments during the 1980s.', 'web_url': 'https://www.nytimes.com/2013/12/23/business/lawrence-o-kitchen-a-former-lockheed-chief-dies-at-90.html', 'snippet': 'Mr. Kitchen rose through the ranks of the aerospace company during a 30-year career and led the company through rocky tussles with governments during the 1980s.', 'lead_paragraph': 'Lawrence O. Kitchen, a former Marine who never finished college but successfully led the Lockheed Corporation, the aerospace company, through turbulent times, died on Dec. 15 in Woodland Hills, Calif. He was 90.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/business/kitchenobit/kitchenobit-articleLarge.jpg', 'height': 805, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/23/business/kitchenobit/kitchenobit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 805}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/business/kitchenobit/kitchenobit-jumbo.jpg', 'height': 1024, 'width': 764, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/business/kitchenobit/kitchenobit-superJumbo.jpg', 'height': 2048, 'width': 1527