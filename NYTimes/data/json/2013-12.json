e, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/business/Hilton/Hilton-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/13/business/Hilton/Hilton-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/business/Hilton/Hilton-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/business/Hilton/Hilton-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/business/Hilton/Hilton-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/13/business/Hilton/Hilton-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/business/Hilton/Hilton-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Surprise From Hilton: Big Profit for Blackstone', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'A Surprise From Hilton: Big Profit for Blackstone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hotels and Travel Lodgings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Initial Public Offerings', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Private Equity', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Hilton Worldwide', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'The Blackstone Group', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-13T01:38:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By David Gelles', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gelles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73cb720b-084c-5b38-a513-6fdb62407b3b', 'word_count': 1010, 'uri': 'nyt://article/73cb720b-084c-5b38-a513-6fdb62407b3b'}, {'abstract': 'After a tumultuous eight-year term, Iftikhar Muhammad Chaudhry, 65, stepped down as Pakistan’s chief justice on Thursday.', 'web_url': 'https://www.nytimes.com/2013/12/13/world/asia/pakistan-justices-crusade-closes.html', 'snippet': 'After a tumultuous eight-year term, Iftikhar Muhammad Chaudhry, 65, stepped down as Pakistan’s chief justice on Thursday.', 'lead_paragraph': ' After a tumultuous eight-year term in which he defied and outplayed the military ruler Pervez Musharraf, terminated a prime minister and changed the Supreme Court’s role from political pawn to power player, Iftikhar Muhammad Chaudhry, 65, stepped down as Pakistan’s chief justice on Thursday. As his legacy, he leaves a court that has now proved able to call even the country’s powerful generals to account. But he also polarized public debate, drawing accusations that he had become a power-drunk crusader who brought an elected Pakistani government to the brink of collapse. His successor, Justice Tassaduq Hussain Jillani, is generally considered to be more mild-mannered, and he will have less than a year in the post before reaching the retirement age of 65. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pakistan: Justice’s Crusade Closes', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'Pakistan: Justice’s Crusade Closes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Pakistan', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Chaudhry, Iftikhar Muhammad', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jillani, Tassaduq Hussain', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court of Pakistan', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-13T01:42:45+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Douglas Schorzman', 'person': [{'firstname': 'Douglas', 'middlename': None, 'lastname': 'Schorzman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/a4997ae3-6d2b-595d-a343-5a79f01cdd4e', 'word_count': 122, 'uri': 'nyt://article/a4997ae3-6d2b-595d-a343-5a79f01cdd4e'}, {'abstract': 'Mayor-elect Bill de Blasio on Thursday tapped Lilliam Barrios-Paoli, commissioner of the Department for the Aging, to help shape policies on issues like homelessness.', 'web_url': 'https://www.nytimes.com/2013/12/13/nyregion/de-blasio-picks-bloomberg-official-to-head-social-services.html', 'snippet': 'Mayor-elect Bill de Blasio on Thursday tapped Lilliam Barrios-Paoli, commissioner of the Department for the Aging, to help shape policies on issues like homelessness.', 'lead_paragraph': 'Citing a deep concern about New York City’s approach to homelessness, Mayor-elect Bill de Blasio on Thursday tapped a senior Bloomberg administration official to be his primary architect for all social service policies.', 'print_section': 'A', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/nyregion/sub-13-Deblasio/sub-13-Deblasio-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'art