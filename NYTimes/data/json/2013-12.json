 '_id': 'nyt://article/ce02359b-3264-5eed-8a34-e9fd9175eb18', 'word_count': 1118, 'uri': 'nyt://article/ce02359b-3264-5eed-8a34-e9fd9175eb18'}, {'abstract': 'Inequality is eroding our faith in institutions and our way of life.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/12/21/in-no-one-we-trust/', 'snippet': 'Inequality is eroding our faith in institutions and our way of life.', 'lead_paragraph': 'In America today, we are sometimes made to feel that it is naïve to be preoccupied with trust. Our songs advise against it, our TV shows tell stories showing its futility, and incessant reports of financial scandal remind us we’d be fools to give it to our bankers.', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In No One We Trust', 'kicker': 'The Great Divide', 'content_kicker': None, 'print_headline': 'In No One We Trust', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-21T19:39:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Joseph E. Stiglitz', 'person': [{'firstname': 'Joseph', 'middlename': 'E.', 'lastname': 'Stiglitz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b081dae0-782d-580b-9c58-859642242a23', 'word_count': 2097, 'uri': 'nyt://article/b081dae0-782d-580b-9c58-859642242a23'}, {'abstract': 'N.F.L. coaches try to plan the final minutes of a game, but desperation is the mother of invention, and the making of great moments.', 'web_url': 'https://www.nytimes.com/slideshow/2013/12/22/sports/football/22endings-SS.html', 'snip