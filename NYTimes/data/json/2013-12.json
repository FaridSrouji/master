 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/56dabf97-f126-5ff4-899d-b1b158bc8f4c', 'word_count': 886, 'uri': 'nyt://article/56dabf97-f126-5ff4-899d-b1b158bc8f4c'}, {'abstract': 'Dolce Suono Ensemble of Philadelphia and Lucy Shelton, soprano, performed a program of new music with a lunar motif at Roulette in Brooklyn.', 'web_url': 'https://www.nytimes.com/2013/12/10/arts/music/dolce-suono-ensemble-and-lucy-shelton-at-roulette.html', 'snippet': 'Dolce Suono Ensemble of Philadelphia and Lucy Shelton, soprano, performed a program of new music with a lunar motif at Roulette in Brooklyn.', 'lead_paragraph': 'From ancient Greece to the moon by way of Monteverdi, Mahler and Puccini: Wednesday evening’s concert by the Dolce Suono Ensemble at Roulette in Brooklyn drew a wide arc. Dolce Suono, which appeared there as part of the inventive Ear Heart Music series, is a Philadelphia-based chamber ensemble founded by the flutist Mimi Stillman that eloquently advocates for new music while placing it in a historical context. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The New, in Context, for Ear, Heart and Brain', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'The New, in Context, for Ear, Heart and Brain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Dolce Suono Ensemble', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Roulette (Brooklyn, NY, Performance Space)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Shelton, Lucy', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-10T18:21:46+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fd74be64-30b2-5e20-801b-c7bd9b072982', 'word_count': 415, 'uri': 'nyt://article/fd74be64-30b2-5e20-801b-c7bd9b072982'}, {'abstract': 'Acrimony over a new farm bill in Congress is mirrored by the conflicting views in the Mississippi Delta about cutting food stamps and overhauling the farm subsidy program.', 'web_url': 'https://www.nytimes.com/2013/12/11/us/politics/in-mississippi-a-divide-on-farm-aid-and-food-stamps.html', 'snippet': 'Acrimony over a new farm bill in Congress is mirrored by the conflicting views in the Mississippi Delta about cutting food stamps and overhauling the farm subsidy program.', 'lead_paragraph': 'BELZONI, Miss. — Thomas Bond, a cotton grower whose onetime 8,500-acre partnership of farms received $4 million in federal subsidies in the last seven years, thinks that many residents in the surrounding Mississippi Delta need food stamps. But he says the program is too big and rife with fraud.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/11/us/11FARM/11FARM-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/11/us/11FARM/11FARM-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/11/us/11FARM/11FARM-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/11/us/11FARM/11FARM-superJumbo.jpg', 'h