acy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/05/21/health/well_patterns/well_patterns-superJumbo.jpg', 'height': 214, 'width': 215, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/05/21/health/well_patterns/well_patterns-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/05/21/health/well_patterns/well_patterns-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/05/21/health/well_patterns/well_patterns-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Food Allergies Less Deadly Than Accidents', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'Nutrition: Estimating Food Allergy Risks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ALLERGIES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Peanuts', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-06T15:47:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Nicholas Bakalar', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Bakalar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a7fcf35-d3b1-5df5-b245-3d1db088cc70', 'word_count': 216, 'uri': 'nyt://article/2a7fcf35-d3b1-5df5-b245-3d1db088cc70'}, {'abstract': 'Terry Teachout’s biography of the enigmatic jazz titan Duke Ellington.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/duke-a-life-of-duke-ellington-by-terry-teachout.html', 'snippet': 'Terry Teachout’s biography of the enigmatic jazz titan Duke Ellington.', 'lead_paragraph': 'Eighty years before “branding” had become the familiar hard-nosed term for the packaging and selling of entertainers, Duke Ellington was a dreamlike synthesis of image, talent and social relevance. As a black jazz titan in a racist age — he rose to stardom in the 1920s — the aristocratic maestro took on a weighty double role: to lift jazz to the level of concert music and to win respect for his race. ', 'print_section': 'BR', 'print_page': '50', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08GAVIN/08GAVIN-articleLarge.jpg', 'height': 528, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/08GAVIN/08GAVIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 528}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08GAVIN/08GAVIN-jumbo.jpg', 'height': 900, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08GAVIN/08GAVIN-superJumbo.jpg', 'height': 991, 'width': 1127, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08GAVIN/08GAVIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/08GAVIN/08GAVIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08GAVIN/08GAVIN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Big Band', 'kicker': None, 'content_kicker': None, 'print_headline': 'Big Band', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ellington, Duke', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Teachout, Terry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Jazz', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-06T15:48:36+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By James Gavin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Gavin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d0ff019a-6dc4-5e44-92e2-d22db86555a5', 'word_count': 1258, 'uri': 'nyt://article/d0ff019a-6dc4-5e44-92e2-d22db86555a5'}, {'abstract': 'Two new biographies of the revered and influential saxophonist and composer Charlie Parker.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/kansas-city-lightning-and-bird.html', 'snippet': 'Two new biographies of the revered and influential saxophonist and composer Charlie Parker.', 'lead_paragraph': 'When you’re writing about the movies, the film critic and painter Manny Farber said, the language ought to emulate the art. “I don’t think you can be mimetic enough,” Farber told an interviewer. That is to say, screen violence calls for barbarous prose; romance requires a warmness of tone. This principle could be applied to writing about all the arts, or most of them — including jazz, as the cultural critic and novelist Stanley Crouch has demonstrated with his judicious, strategically crafted new book about Charlie Parker, the revered and immeasurably influential alto saxophonist and composer. “Kansas City Lightning: The Rise and Times of Charlie Parker” is, like the music made by its subject in his abbreviated life, free-flowing and severe, volatile, expansive, allusive and indulgent. From bravura sentence to serpentine paragraph, the book is a virtuoso performance of musical-literary mimesis. ', 'print_section': 'BR', 'print_page': '51', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208HAJDU/1208HAJDU-articleLarge.jpg', 'height': 680, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/1208HAJDU/1208HAJDU-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 680}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208HAJDU/1208HAJDU-jumbo.jpg', 'height': 1024, 'width': 904, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208HAJDU/1208HAJDU-superJumbo.jpg', 'height': 2048, 'width': 1807, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208HAJDU/1208HAJDU-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/1208HAJDU/1208HAJDU-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208HAJDU/1208HAJDU-thumbLarge.jpg', 'height': 