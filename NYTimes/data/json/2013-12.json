 [{'name': 'subject', 'value': 'Exploration and Explorers', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'AMUNDSEN, ROALD', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Scott, Robert Falcon', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'South Pole', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-13T11:45:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Claire Barthelemy', 'person': [{'firstname': 'Claire', 'middlename': None, 'lastname': 'Barthelemy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b11f4f20-89f0-5204-9f3f-964d34115ae3', 'word_count': 358, 'uri': 'nyt://article/b11f4f20-89f0-5204-9f3f-964d34115ae3'}, {'abstract': 'The victory by Rakhi Birla, the party’s youngest candidate, in the Delhi assembly elections stunned many political observers.', 'web_url': 'https://india.blogs.nytimes.com/2013/12/13/youth-trumps-experience-and-wealth-in-unlikely-aam-aadmi-party-win/', 'snippet': 'The victory by Rakhi Birla, the party’s youngest candidate, in the Delhi assembly elections stunned many political observers.', 'lead_paragraph': 'NEW DELHI – Of all the David-and-Goliath battles the Aam Aadmi Party faced in the Delhi assembly elections last week, the one in Mangolpuri, a gritty district in the northern part of the capital, was among the least likely to result in a win for the upstart party.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/world/asia/13-AAP-IndiaInk/13-AAP-IndiaInk-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/13/world/asia/13-AAP-IndiaInk/13-AAP-IndiaInk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'ca