 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/02/multimedia/video-nytm-120213-6pm/video-nytm-120213-6pm-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/02/multimedia/video-nytm-120213-6pm/video-nytm-120213-6pm-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Times Minute: Dec. 02 at 6 p.m.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Metro-North Commuter Railroad', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Railroad Accidents and Safety', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Transportation Safety Board', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-02T22:38:53+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'Flora Lichtman', 'person': [{'firstname': 'Flora', 'middlename': None, 'lastname': 'Lichtman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/ee7144f2-164c-580b-84d8-5ae6bce19a83', 'word_count': 0, 'uri': 'nyt://video/ee7144f2-164c-580b-84d8-5ae6bce19a83'}, {'abstract': 'The Mark Morris Dance Group presented several recent works in two programs at Sadler’s Wells Theater in London, a much larger space than its center in Brooklyn.', 'web_url': 'https://www.nytimes.com/2013/12/03/arts/dance/on-an-expansive-stage-a-company-spreads-its-wings.html', 'snippet': 'The Mark Morris Dance Group presented several recent works in two programs at Sadler’s Wells Theater in London, a much larger space than its center in Brooklyn.', 'lead_paragraph': 'LONDON — The mind of the choreographer Mark Morris, as we read it in his dances, is bewilderingly diverse. I first saw his work 29 years ago, in its first London season, and he is as mysterious to me now as he was then — but more marvelously so. Last week, the week after the Mark Morris Dance Group’s 25th-anniversary performances of “L’Allegro, il Penseroso ed il Moderato” at Lincoln Center, Mr. Morris presented seven recent works in two programs at Sadler’s Wells Theater here. They ranged from the tender celebration of eccentricity in “A Wooden Tree” to the controlled philosophical imagery of “Socrates,” from the male-female intimate duet of “Jenn and Spencer” to the intermeshing group patterns of “Crosswalk.”', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/03/arts/03MORRIS1/03MORRIS1-articleLarge.jpg', 'height': 367, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/03/arts/03MORRIS1/03MORRIS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 367}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/03/arts/03MORRIS1/03MORRIS1-jumbo.jpg', 'height': 626, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/03/arts/03MORRIS1/03MORRIS1-superJumbo.jpg', 'height': 1251, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/03/arts/03MORRIS1/03MORRIS1-thumbStanda