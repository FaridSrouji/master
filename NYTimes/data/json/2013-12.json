o.jpg', 'height': 2048, 'width': 1412, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/business/15microsoft-web/15microsoft-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/16/business/15microsoft-web/15microsoft-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/business/15microsoft-web/15microsoft-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Microsoft Star Goes to Google', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Google Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-16T00:50:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nick Wingfield', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Wingfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2ff666a0-50b6-59e9-9ab7-64d74924a6ac', 'word_count': 339, 'uri': 'nyt://article/2ff666a0-50b6-59e9-9ab7-64d74924a6ac'}, {'abstract': 'We constantly interrupt our experiences to make a record of them.', 'web_url': 'https://www.nytimes.com/2013/12/16/opinion/the-documented-life.html', 'snippet': 'We constantly interrupt our experiences to make a record of them.', 'lead_paragraph': 'CAMBRIDGE, Mass. — LAST spring, I had the occasion to spend a day with the actor and comedian Aziz Ansari discussing our mutual interest in the psychology of texting. As we walked through Los Angeles, people approached him every few minutes not to ask for an autograph, but to demand a photograph. Mr. Ansari is gracious to his fans. He explained that instead of a photograph, he would offer a conversation. He inquired about their taste in music, what they liked about his performances, his stand-up, his sitcom “Parks and Recreation.” His fans were mollified but they were rarely happy. They had to walk away with nothing on their phones.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Documented Life', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The Documented Life', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Turkle, Sherry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ansari, Aziz', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Text Messaging', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-16T00:57:13+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Sherry Turkle', 'person': [{'firstname': 'Sherry', 'middlename': None, 'lastname': 'Turkle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/562a41fd-a96f-5653-acea-22823c67405c', 'word_count': 820, 'uri': 'nyt://article/562a41fd-a96f-5653-acea-22823c67405c'}, {'abstract': 'Misclassifying workers as independent contractors harms the employees and costs billions in lost tax revenue.', 'web_url': 'https://www.nytimes.com/2013/12/16/opinion/victims-of-misclassification.html', 'snippet': 'Misclassifying workers as independent contractors harms the employees and costs billions in lost tax revenue.', 'lead_paragraph': 'WASHINGTON — LAST month, a Michigan construction worker named Matt Anderson testified in a Senate hearing about being a victim of employee misclassification. Mr. Anderson said that his employer forced him, after six years as an employee, to switch to “independent contractor” status. Though the move stripped Mr. Anderson of basic employee rights and protections, he went along with the change, he said, because “my fellow workers and I had families to support and we saw how bad the economy was.”', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Victims of Misclassification', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Victims of Misclassification', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Freelancing, Self-Employment and Independent Contracting', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Casey, Robert P Jr', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Collective Bargaining', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-16T01:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Marjorie Elizabeth Wood', 'person': [{'firstname': 'Marjorie', 'middlename': 'Elizabeth', 'lastname': 'Wood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/68f329e1-a079-5dd5-b435-6d23880b9441', 'word_count': 490, 'uri': 'nyt://article/68f329e1-a079-5dd5-b435-6d23880b9441'}, {'abstract': 'The grants, to be announced Monday, come just three months after NPR, which is facing financial difficulties, said it would cut 10 percent of its staff.', 'web_url': 'https://www.nytimes.com/2013/12/16/business/media/npr-gets-17-million-in-grants-to-expand-coverage-and-develop-digital-platform.html', 'snippet': 'The grants, to be announced Monday, come just three months after NPR, which is facing financial difficulties, said it would cut 10 percent of its staff.', 'lead_paragraph': 'NPR has amassed nearly $17 million in grants to increase substantially its coverage of education and global health and development, and finance creation of a new mobile and web platform that is expected to allow it to reach more listeners and better compete with outside aggregators of public radio content.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/business/npr/npr-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/16/business/npr/npr-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/business/npr/npr-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/business/npr/npr-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/business/npr/npr-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy