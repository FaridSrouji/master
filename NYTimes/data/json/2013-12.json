2013/12/06/world/asia/06-pod-mandela-IndiaInk/06-pod-mandela-IndiaInk-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Image of the Day: December 6', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Johannesburg (South Africa)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'South Africa', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-06T16:09:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/840dfc0a-aa27-5e48-82bc-84197c628839', 'word_count': 1, 'uri': 'nyt://article/840dfc0a-aa27-5e48-82bc-84197c628839'}, {'abstract': 'A panoramic celebration of Hollywood fashion in words, still photographs and drawings.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/hollywood-costume-edited-by-deborah-nadoolman-landis.html', 'snippet': 'A panoramic celebration of Hollywood fashion in words, still photographs and drawings.', 'lead_paragraph': 'It may approach a Tom Swifty, but costume designers have an image problem. As fashion designers have inflated to dirigible proportions — stamping their initials on baby bootees, plotting I.P.O.’s and presiding like some kind of self-appointed Warren court over the quivery aspirants of “Project Runway” — their kinfolk in the movie business have receded ever more into the shadows. They emerge only around Oscar time, even then making little impression on the culture at large. Almost two decades have passed since Lizzy Gardiner, one-half of the Australian team that outfitted “The Adventures of Priscilla, Queen of the Desert,” accepted her statuette, jangling gently in a dress she’d made from 254 American Express gold cards. “I’m broke,” she explained, “and I didn’t have anything to wear.” ', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08JACOBS/08JACOBS-articleLarge.jpg', 'height': 768, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/08JACOBS/08JACOBS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 768}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08JACOBS/08JACOBS-jumbo.jpg', 'height': 1024, 'width': 801, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08JACOBS/08JACOBS-superJumbo.jpg', 'height': 2048, 'width': 1601, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08JACOBS/08JACOBS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/08JACOBS/08JACOBS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08JACOBS/08JACOBS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Star Style', 'kicker': None, 'content_kicker': None, 'print_headline': 'Star Style', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Landis, Deborah Nadoolman', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Costumes', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-06T16:09:48+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Alexandra Jacobs', 'person': [{'firstname': 'Alexandra', 'middlename': None, 'lastname': 'Jacobs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b1714952-7f70-5754-a495-6d2da92debf0', 'word_count': 1021, 'uri': 'nyt://article/b1714952-7f70-5754-a495-6d2da92debf0'}, {'abstract': '“The Libertine” is a new volume of 18th-century French erotica edited by the literary historian Michel Delon.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/the-libertine-edited-by-michel-delon.html', 'snippet': '“The Libertine” is a new volume of 18th-century French erotica edited by the literary historian Michel Delon.', 'lead_paragraph': 'Long before Cole Porter observed that birds, bees and educated fleas do it, the French poet Alexis Piron made the same point in his X-rated “Ode to Priapus.” Anthologized in “The Libertine,” the literary historian Michel Delon’s delectable new volume of 18th-century French erotica, it catalogs an array of fauna (“Dromedary, whale, and duck, / Insect, critter, man”) united in their lusty predilection for verbs and nouns too obscene to print in this newspaper, though collectively identifiable by Porter’s own euphemistic pronoun of choice: “Everything does it, reasonable or not.” Reminiscent, too, of the catalog aria from Mozart’s “Don Giovanni” — an enumeration of the skirt-chasing hero’s thousands of conquests by age, rank, nationality and hair color — Piron’s dirty laundry list underscores both the dogged ubiquity of the sex instinct and the inexhaustible variety of its \xadexpressions.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08WEBER/08WEBER-articleLarge.jpg', 'height': 381, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/08WEBER/08WEBER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 381}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08WEBER/08WEBER-jumbo.jpg', 'height': 651, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08WEBER/08WEBER-superJumbo.jpg', 'height': 1302, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08WEBER/08WEBER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/08WEBER/08WEBER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08WEBER/08WEBER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'L’Amour', 'kicker': None, 'content_kicker': None, 'print_headline': 'L’Amour', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Weber, Caroline', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Delon, Michel', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-06T16:10:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Caroline Weber', 'person': [{'firstname': 'Caroline', 'middlename': None, 'lastname': 'Weber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/665d7c05-4fa4-59db-9e4c-df7f54ac5412', 'word_count': 483, 'uri': 'nyt://article/665d7c05-4fa4-59db-9e4c-df7f54ac5412'}, {'abstract': 'Alisa Solomon’s look at the making of “Fiddler on the Roof” and the way the show reflects evolving Jewish cultural identity in America and around the world.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/wonder-of-wonders-by-alisa-solomon.html', 'snippet': 'Alisa Solomon’s look at the making of “Fiddler on the Roof” and the way the show reflects evolving Jewish cultural identity in America and around the world.', 'lead_paragraph': 'In my family, we have a ritual. (Tradition!) After a particularly wonderful Shabbat or holiday dinner, we channel my great-grandmother Pearl Gottler and chant in unison, “Ach, I’m stoffed. I’m bloated. I couldn’t eat another bite.” ', 'print_section': 'BR', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208INGALL/1208INGALL-articleLarge.jpg', 'height': 287, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/1208INGALL/1208INGALL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 287}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208INGALL/1208INGALL-jumbo.jpg', 'height': 490, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208INGALL/1208INGALL-superJumbo.jpg', 'height': 981, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208INGALL/1208INGALL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/1208INGALL/1208INGALL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208INGALL/1208INGALL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tradition!', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tradition!', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ingall, Marjorie', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Solomon, Alisa', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Fiddler on the Roof (Movie)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-06T16:10:48+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marjorie Ingall', 'person': [{'firstname': 'Marjorie', 'middlename': None, 'lastname': 'Ingall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/83be454f-5c9e-5867-876e-17eadcd4c178', 'word_count': 993, 'uri': 'nyt://article/83be454f-5c9e-5867-876e-17eadcd4c178'}, {'abstract': 'Alexis Turner, the founder of London Taxidermy, shows off some of his stuffed and pickled props.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/taxidermy-by-alexis-turner.html', 'snippet': 'Alexis Turner, the founder of London Taxidermy, shows off some of his stuffed and pickled props.', 'lead_paragraph': 'The 337 images in “Taxidermy” are artful and immaculate — everything that a taxidermy workshop, with its dust, fumes, stench, viscera and decay, is not. This book is eye candy (the frontispiece is, in fact, a surprisingly delectable array of glass eyes), which makes sense because Alexis Turner is the founder of London Taxidermy, a business that supplies natural history artifacts to the fashion and film industries, among other clients. You can see his stuffed and pickled props in the “Harry Potter” films, “Sherlock \xadHolmes,” “Pirates of the Caribbean,” “Les \xadMisérables,” “Anna Karenina,” “Skyfall” — and now in this book.', 'print_section': 'BR', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08CALHOUN/08CALHOUN-articleLarge.jpg', 'height': 488, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/08CALHOUN/08CALHOUN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 488}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08CALHOUN/08CALHOUN-jumbo.jpg', 'height': 833, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08CALHOUN/08CALHOUN-superJumbo.jpg', 'height': 1575, 'width': 1935, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08CALHOUN/08CALHOUN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/08CALHOUN/08CALHOUN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08CALHOUN/08CALHOUN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stuffed Animals', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stuffed Animals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Taxidermy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Turner, Alexis', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-06T16:10:58+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Melissa Milgrom', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Milgrom', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/24cf40a4-3983-554f-a0ea-2388090bd118', 'word_count': 880, 'uri': 'nyt://article/24cf40a4-3983-554f-a0ea-2388090bd118'}, {'abstract': 'Two new books combine rich storytelling with science to explain dogs — the roles they play in our lives and we in theirs.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/how-dogs-love-us-and-what-the-dog-knows.html', 'snippet': 'Two new books combine rich storytelling with science to explain dogs — the roles they play in our lives and we in theirs.', 'lead_paragraph': 'Gregory Berns wasn’t sure if his pug Newton really loved him. Newton wagged his tail and gave kisses, but that wasn’t enough. Berns, a neuroscientist, wanted hard data. He also hoped to uncover “what makes for a strong dog-human bond” and how that might improve canine welfare. So he built a special M.R.I. machine, and trained dogs to lie still inside it, allowing him to study their brains. Though the results may seem obvious to dog lovers (that humans and dogs experience emotions similarly), they’re not a given for science. Berns’s book is a beautiful story about dogs, love and neurology that shows how nonhuman relationships are inspiring researchers to look at animals in new ways, for their benefit and ours. ', 'print_section': 'BR', 'print_page': '40', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208SKLOOT/1208SKLOOT-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/1208SKLOOT/1208SKLOOT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208SKLOOT/1208SKLOOT-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208SKLOOT/1208SKLOOT-superJumbo.jpg', 'height': 855, 'width': 1303, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208SKLOOT/1208SKLOOT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/1208SKLOOT/1208SKLOOT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208SKLOOT/1208SKLOOT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Release the Hounds', 'kicker': None, 'content_kicker': None, 'print_headline': 'Release the Hounds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Skloot, Rebecca', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Berns, Gregory S', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Cat', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Dogs', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-06T16:11:09+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Rebecca Skloot', 'person': [{'firstname': 'Rebecca', 'middlename': None, 'lastname': 'Skloot', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f7aa060b-ddf5-59ab-8075-7c50c985dd8d', 'word_count': 560, 'uri': 'nyt://article/f7aa060b-ddf5-59ab-8075-7c50c985dd8d'}, {'abstract': '“Murals of New York City: The Best of New York’s Public Paintings From Bemelmans to Parrish” features more than 30 large-scale works around the city.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/murals-of-new-york-city-by-glenn-palmer-smith.html', 'snippet': '“Murals of New York City: The Best of New York’s Public Paintings From Bemelmans to Parrish” features more than 30 large-scale works around the city.', 'lead_paragraph': 'Walls in New York sometimes do more than divide space. A few of them are also pages of the city’s history writ large — testament to the shifting civic vision of generations of New Yorkers. In “Murals of New York City: The Best of New York’s Public Paintings From Bemelmans to Parrish,” which features more than 30 large-scale works around the city, the muralist Glenn Palmer-Smith and the photographer Joshua McHugh tutor natives and tourists alike in how these walls — and a few ceilings — can best be appreciated. ', 'print_section': 'BR', 'print_page': '42', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208FAN/1208FAN-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/1208FAN/1208FAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208FAN/1208FAN-jumbo.jpg', 'height': 663, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208FAN/1208FAN-superJumbo.jpg', 'height': 1325, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208FAN/1208FAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/1208FAN/1208FAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208FAN/1208FAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Public Painting', 'kicker': None, 'content_kicker': None, 'print_headline': 'Public Painting', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fan, Jiayang', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Murals', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Palmer-Smith, Glenn', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'McHugh, Joshua', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-06T16:11:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jiayang Fan', 'person': [{'firstname': 'Jiayang', 'middlename': None, 'lastname': 'Fan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/690d945d-a318-5911-aae9-45a9da21783c', 'word_count': 550, 'uri': 'nyt://article/690d945d-a318-5911-aae9-45a9da21783c'}, {'abstract': 'Sam Wasson’s biography of Bob Fosse explains the choreographer’s achievement in prose meant to summon the spirit of a Fosse show.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/sam-wassons-fosse.html', 'snippet': 'Sam Wasson’s biography of Bob Fosse explains the choreographer’s achievement in prose meant to summon the spirit of a Fosse show.', 'lead_paragraph': 'An instructive way of getting a sense of the power of Bob Fosse’s choreography is by listening to the original cast album of a 1959 musical called “Redhead.” The show ran for 452 performances, a head-\xadscratcher since the songs are merely serviceable. But the photos reveal all. The songs were irrelevant: What made “Redhead” a hit was the genius of Fosse’s dances.', 'print_section': 'BR', 'print_page': '49', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208MCWHORTER01/1208MCWHORTER01-articleLarge.jpg', 'height': 1238, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/1208MCWHORTER01/1208MCWHORTER01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1238}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208MCWHORTER01/1208MCWHORTER01-jumbo.jpg', 'height': 1024, 'width': 497, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208MCWHORTER01/1208MCWHORTER01-superJumbo.jpg', 'height': 2048, 'width': 993, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208MCWHORTER01/1208MCWHORTER01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/1208MCWHORTER01/1208MCWHORTER01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/1208MCWHORTER01/1208MCWHORTER01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Razzle Dazzle', 'kicker': None, 'content_kicker': None, 'print_headline': 'Razzle Dazzle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McWhorter, John', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wasson, Sam', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fosse, Bob', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-06T16:12:36+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By John McWhorter', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'McWhorter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fe5af96d-087b-5335-9cc7-e88d77161561', 'word_count': 1286, 'uri': 'nyt://article/fe5af96d-087b-5335-9cc7-e88d77161561'}, {'abstract': 'Ben Bradlee Jr.’s biography of Ted Williams does not materially alter our picture of the Red Sox star, but fills it in with much greater detail and nuance.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/the-kid-the-immortal-life-of-ted-williams-by-ben-bradlee-jr.html', 'snippet': 'Ben Bradlee Jr.’s biography of Ted Williams does not materially alter our picture of the Red Sox star, but fills it in with much greater detail and nuance.', 'lead_paragraph': 'The people at the Alcor cryonics facility, in Scottsdale, Ariz., would have us believe that Ted Williams really is immortal. They have his body there, the head severed from the rest, flash-frozen in a giant thermos-like tank and awaiting only the scientific advancement that will allow him to be thawed, resuscitated and rejuvenated. Meanwhile, with every passing season, his longevity in the statistical department seems more and more certain. While other baseball records fall with actuarial regularity, Williams’s 1941 batting average of .406, the highest in nearly 90 years, shimmers ever more brightly, a landmark that even a hitter like Barry Bonds was unable to approach.', 'print_section': 'BR', 'print_page': '54', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08MCGRATH/08MCGRATH-articleLarge.jpg', 'height': 748, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/08MCGRATH/08MCGRATH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 748}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08MCGRATH/08MCGRATH-jumbo.jpg', 'height': 1024, 'width': 822, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08MCGRATH/08MCGRATH-superJumbo.jpg', 'height': 1382, 'width': 1109, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08MCGRATH/08MCGRATH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/books/review/08MCGRATH/08MCGRATH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08MCGRATH/08MCGRATH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Splendid Splinter', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Splendid Splinter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McGrath, Charles', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Ted S', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bradlee, Ben Jr', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-06T16:12:57+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4862650e-f337-5573-b540-76c84dd9ccb3', 'word_count': 1627, 'uri': 'nyt://article/4862650e-f337-5573-b540-76c84dd9ccb3'}, {'abstract': 'Paintings of cats and girls by Balthus, and poetry and prose about cats from The New Yorker.', 'web_url': 'https://www.nytimes.com/2013/12/08/books/review/balthus-cats-and-girls-and-the-big-new-yorker-book-of-cats.html', 'snippet': 'Paintings of cats and girls by Balthus, and poetry and prose about cats from The New Yorker.', 'lead_paragraph': 'Look — how can you not? — at the supple creature stretched across the divan. Legs bent and parted, arms folded overhead, eyes trained on some distant vision. She could lounge that way for hours, it seems, staring at the wall, or through the human who gazes on her, he confounded by her aloofness, tormented by what he cannot know: What does she feel? What does she desire? What does she think of me?', 'print_section': 'BR', 'print_page': '56', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08MCDONALD/08MCDONALD-articleLarge.jpg', 'height': 574, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/books/review/08MCDONALD/08MCDONALD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 574}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/books/review/08MCDONALD/08MCDONALD-jumbo.jpg', 'height': 980, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype':