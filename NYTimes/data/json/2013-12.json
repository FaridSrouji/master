ISTAN/UZBEKISTAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/18/world/UZBEKISTAN/UZBEKISTAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/world/UZBEKISTAN/UZBEKISTAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Uzbekistan, the Practice of Forced Labor Lives On During the Cotton Harvest', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Uzbekistan, the Practice of Forced Labor Lives On During the Cotton Harvest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Uzbekistan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cotton', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Agriculture and Farming', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Forced Labor', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-17T16:12:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Mansur Mirovalev and Andrew E. Kramer', 'person': [{'firstname': 'Mansur', 'middlename': None, 'lastname': 'Mirovalev', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Andrew', 'middlename': 'E.', 'lastname': 'Kramer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ea57212f-bb0b-547e-a6fb-1d522d8edcc4', 'word_count': 1248, 'uri': 'nyt://article/ea57212f-bb0b-547e-a6fb-1d522d8edcc4'}, {'abstract': 'President Vladimir V. Putin said Russia would provide $15 billion in loans and a sharp discount on natural gas prices, a bold move in his recent diplomatic battle with the West.', 'web_url': 'https://www.nytimes.com/2013/12/18/world/europe/russia-offers-ukraine-financial-lifeline.html', 'snippet': 'President Vladimir V. Putin said Russia would provide $15 billion in loans and a sharp discount on natural gas prices, a bold move in his recent diplomatic battle with the West.', 'lead_paragraph': 'MOSCOW — In a sharp rebuff to the West in the diplomatic wrangle over Ukraine, President Vladimir V. Putin said Tuesday that Russia would come to the rescue of its financially troubled neighbor, providing $15 billion in loans and a steep discount on natural gas prices.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/world/europe/18ukraine/18ukraine-articleLarge.jpg', 'height': 412, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/18/world/europe/18ukraine/18ukraine-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 412}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/world/europe/18ukraine/18ukraine-jumbo.jpg', 'height': 703, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/world/europe/18ukraine/18ukraine-superJumbo.jpg', 'height': 1407, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/world/europe/18ukraine/18ukraine-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/18/world/europe/18ukraine/18ukraine-thumbStandard-v3.jpg',