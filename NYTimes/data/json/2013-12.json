', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-12-18T22:30:41+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8308a5bc-5624-56a9-8881-6e4a200aaa22', 'word_count': 521, 'uri': 'nyt://article/8308a5bc-5624-56a9-8881-6e4a200aaa22'}, {'abstract': 'Photos from Syria, South Sudan, Greece and Ukraine.', 'web_url': 'https://lens.blogs.nytimes.com/2013/12/18/pictures-of-the-day-syria-and-elsewhere-70/', 'snippet': 'Photos from Syria, South Sudan, Greece and Ukraine.', 'lead_paragraph': 'Photos from Syria, South Sudan, Greece and Ukraine.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/blogs/20131218POD-slide-DVLA/20131218POD-slide-DVLA-articleLarge.jpg', 'height': 431, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/18/blogs/20131218POD-slide-DVLA/20131218POD-slide-DVLA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 431}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/blogs/20131218POD-slide-DVLA/20131218POD-slide-DVLA-jumbo.jpg', 'height': 736, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/blogs/20131218POD-slide-DVLA/20131218POD-slide-DVLA-superJumbo.jpg', 'height': 1472, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJ