': 'N'}, {'name': 'persons', 'value': 'Robinson, Ruairi', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-05T23:07:54+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2b7850f7-b66f-5b43-969a-1878b0b1bf86', 'word_count': 335, 'uri': 'nyt://article/2b7850f7-b66f-5b43-969a-1878b0b1bf86'}, {'abstract': 'I wept for an awakening I had given up on, that around the corner I might love again.', 'web_url': 'https://www.nytimes.com/2013/12/08/fashion/A-Warrior-Learns-a-Different-Pose-modern-love.html', 'snippet': 'I wept for an awakening I had given up on, that around the corner I might love again.', 'lead_paragraph': 'It’s important to understand that my husband, Peter, refuses to take baths. He does shower, yes, but he finds baths unmanly, just like soccer — or any other sport that does not require players to crash into one another like angry apes and beat their chests.', 'print_section': 'ST', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/06/fashion/05MODERNLOVE/05MODERNLOVE-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/06/fashion/05MODERNLOVE/05MODERNLOVE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/06/fashion/05MODERNLOVE/05MODERNLOVE-jumbo.jpg', 'height': 662, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'im