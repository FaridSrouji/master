 Times', 'multimedia': [], 'headline': {'main': 'U.S. Senators Say South Korea Should Not Hire China Firm', 'kicker': None, 'content_kicker': None, 'print_headline': 'Senators Say South Korea Should Not Hire China Firm', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Telephones and Telecommunications', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Huawei Technologies Co Ltd', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Menendez, Robert', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Feinstein, Dianne', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Kerry, John', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Clapper, James R Jr', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Hagel, Chuck', 'rank': 13, 'major': 'N'}, {'name': 'subject', 'value': 'Cyberattacks and Hackers', 'rank': 14, 'major': 'N'}], 'pub_date': '2013-12-04T02:42:56+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By David E. Sanger', 'person': [{'firstname': 'David', 'middlename': 'E.', 'lastname': 'Sanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c1f9e24-3e87-5098-ac77-6746ede5715d', 'word_count': 448, 'uri': 'nyt://article/9c1f9e24-3e87-5098-ac77-6746ede5715d'}, {'abstract': 'White House officials are under mounting pressure to hold senior-level people accountable for the troubled introduction of the Affordable Care Act’s