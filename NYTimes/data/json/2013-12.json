0c96ded4', 'word_count': 610, 'uri': 'nyt://article/1f733e0c-0a36-5b2a-be52-9a540c96ded4'}, {'abstract': 'The soul singer Ricky Spicer is suing Mr. West for what he says is the unauthorized use of his voice on the track “Bound 2.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/25/kanye-west-faces-lawsuit-over-song-sample/', 'snippet': 'The soul singer Ricky Spicer is suing Mr. West for what he says is the unauthorized use of his voice on the track “Bound 2.”', 'lead_paragraph': 'The Kanye West track “Bound 2” has already become one of the most recognizable songs from his album “Yeezus,” helped along by a video in which he and his fiancée, Kim Kardashian, recreate an amorous moment, and by widespread online parodies of said video. But the song proved especially familiar to Ricky Spicer, a soul singer who is suing Mr. West for what he says is the unauthorized use of his voice on the track, according to The Hollywood Reporter.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kanye West Faces Lawsuit Over Song Sample', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'West, Kanye', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Hollywood Reporter', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-25T17:02:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6648a6bf-67c4-57ad-b590-45b147def07a', 'word_count': 189, 'uri': 'nyt://article/6648a6bf-67c4-57ad-b590-45b147def07a'}, {'abstract': 'The band had been scheduled to perform in Israel in 2010 but withdrew amid international pressure over an Israeli naval raid.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/25/the-pixies-join-festival-lineup-in-israel/', 'snippet': 'The band had been scheduled to perform in Israel in 2010 but withdrew amid international pressure over an Israeli naval raid.', 'lead_paragraph': 'More than three years after canceling a planned performance in Israel, the Pixies are once again scheduled to play there as part of a new music festival in June. The Israeli newspaper Haaretz reported that the band would perform on a bill that also includes Soundgarden at a two-day festival scheduled for June 17 and 18 at Bloomfield Stadium in Tel Aviv.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Pixies Join Festival Lineup in Israel', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Keys, Alicia', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Pixies (Music Group)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Soundgarden (Music Group)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Tel Aviv (Israel)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-25T17:11:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7469ad9c-6e96-5c53-9da9-07b040c95155', 'word_count': 183, 'uri': 'nyt://article/7469ad9c-6e96-5c53-9da9-07b040c95155'}, {'abstract': 'Promotional material for “12 Years a Slave” emphasizes white actors instead of the film’s black leading man.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/25/italian-posters-for-12-years-a-slave-prompt-race-debate/', 'snippet': 'Promotional material for “12 Years a Slave” emphasizes white actors instead of the film’s black leading man.', 'lead_paragraph': 'In America and throughout the world, the Steve McQueen film “12 Years a Slave” is known for its searing depiction of a black man’s life in bondage during the 1800s and a widely praised performance by its leading man, Chiwetel Ejiofor. But, in the eyes of a company distributing the movie in Italy, the film was apparently more notable for its white co-stars Brad Pitt and Michael Fassbender.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Italian Posters for ‘12 Years a Slave’ Prompt Race Debate', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ejiofor, Chiwetel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fassbender, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McQueen, Steve', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pitt, Brad', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-25T17:17:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/daa3eb7d-1743-5d5b-a547-46d621364290', 'word_count': 190, 'uri': 'nyt://article/daa3eb7d-1743-5d5b-a547-46d621364290'}, {'abstract': 'Shivering in frosty temperatures where you are? Thaw out with a trip to South Beach, where the attractions extend far beyond the warm weather.', 'web_url': 'https://www.nytimes.com/2013/12/29/travel/36-hours-in-south-beach-miami-beach.html', 'snippet': 'Shivering in frosty temperatures where you are? Thaw out with a trip to South Beach, where the attractions extend far beyond the warm weather.', 'lead_paragraph': 'A weekend in South Beach ought not to begin with “What to pack?” but rather, “What to pursue?” Do you long for the South Beach of painted-on dresses, frozen margaritas and electric neon? The South Beach of stylish new (or renovated) hotels (Gale, Lord Balfour, SLS South Beach) and restaurants (Yardbird Southern Table & Bar, Khong River House, Tongue & Cheek)? Or the South Beach of yesteryear, of pastel Art Deco buildings, museums and monuments? Perhaps you simply crave ...the beach. Miami can be whatever you want it to be — laid back, decked out, gay, straight, a family recess, a single’s playground — which is precisely what makes it such an effortless getaway. In this dreamland at the southern tip of Miami Beach, you can choose your own adventure.', 'print_section': 'TR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/29/travel/29-hours-span-sf/29-hours-span-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/29/travel/29-hours-span-sf/29-hours-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/29/travel/29-hours-span-sf/29-hours-span-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/29/travel/29-hours-span-sf/29-hours-span-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': '