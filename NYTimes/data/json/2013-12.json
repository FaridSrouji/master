: 7, 'major': 'N'}], 'pub_date': '2013-12-20T21:19:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Robb Mandelbaum', 'person': [{'firstname': 'Robb', 'middlename': None, 'lastname': 'Mandelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bde74200-ac02-5827-a4ad-f1faff05883d', 'word_count': 657, 'uri': 'nyt://article/bde74200-ac02-5827-a4ad-f1faff05883d'}, {'abstract': 'A reader wanted to know how many windows there were in all the buildings in Manhattan, a question that might be asked during an internship interview.', 'web_url': 'https://www.nytimes.com/2013/12/22/nyregion/calculating-the-number-of-windows-on-buildings-in-manhattan.html', 'snippet': 'A reader wanted to know how many windows there were in all the buildings in Manhattan, a question that might be asked during an internship interview.', 'lead_paragraph': 'Q. Like many first-year M.B.A. students, I am preparing to interview for summer internship positions. A typical interviewer may ask a question such as “How many windows are there in all the buildings in Manhattan?” to test your critical reasoning skills. There are ways to estimate, but I’d love to know for sure: Just how many buildings are there on the island of Manhattan, and how many windows do they contain?\xa0', 'print_section': 'WE', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/22/nyregion/22FYI/22FYI-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/22/nyregion/22FYI/22FYI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/22/nyregion/22FYI/22FYI-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/22/nyregion/22FYI/22FYI-superJumbo.jpg', 'height': 1359, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/22/nyregion/22FYI/22FYI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/22/nyregion/22FYI/22FYI-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/22/nyregion/22FYI/22FYI-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Calculating the Number of Windows in Buildings in Manhattan', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Windows', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Buildings (Structures)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-20T21:22:19+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael Pollak', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Pollak', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/280b9427-ce42-5c53-9347-39bd369e7bb9', 'word_count': 505, 'uri': 'nyt://article/280b9427-ce42-5c53-9347-39bd369e7bb9'}, {'abstract': 'Megan Kendzior’s “Witness” invokes the horrors of the Holocaust with slow footsteps, shivers and shoes as props at Danspace Project.', 'web_url': 'https://www.nytimes.com/2013/12/21/arts/dance/megan-kendziors-witness-a-dance-invoking-the-holocaust.html', 'snippet': 'Megan Kendzior’s “Witness” invokes the horrors of the Holocaust with slow footsteps, shivers and shoes as props at Danspace Project.', 'lead_paragraph': 'At the heart of Megan Kendzior’s dance “Witness” is a question: How can we observe atrocities and look away? The production, an exploration of indifference and trauma, was inspired by her research into the Holocaust and her visit to the Auschwitz death camp. Her tools are bodies — 15 dancers, to be exact — the plaintive sound of the accordion and many pairs of shoes, which refer to the horrifying room of victims’ shoes at Auschwitz. ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/21/arts/21KENDZIOR/21KENDZIOR-articleLarge.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/21/arts/21KENDZIOR/21KENDZIOR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/21/arts/21KENDZIOR/21KENDZIOR-jumbo.jpg', 'height': 674, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/21/arts/21KENDZIOR/21KENDZIOR-superJumbo.jpg', 'height': 1348, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/21/arts/21KENDZIOR/21KENDZIOR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/21/arts/21KENDZIOR/21KENDZIOR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/21/arts/21KENDZIOR/21KENDZIOR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trudging Somberly to Their Deaths, as a Lone Soul Mourns', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Trudging Somberly to Their Deaths, as a Lone Soul Mourns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Danspace Project', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kendzior, Megan', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-20T21:26:30+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Gia Kourlas', 'person': [{'firstname': 'Gia', 'middlename': None, 'lastname': 'Kourlas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e586a925-9521-50f5-a48b-e3830c544489', 'word_count': 403, 'uri': 'nyt://article/e586a925-9521-50f5-a48b-e3830c544489'}, {'abstract': 'The Mike Stern Band, led by the guitarist Mike Stern, reaches a blues-rock bliss state in its shows at the Iridium.', 'web_url': 'https://www.nytimes.com/2013/12/21/arts/music/the-mike-stern-band-brings-jazz-rock-to-the-iridium.html', 'snippet': 'The Mike Stern Band, led by the guitarist Mike Stern, reaches a blues-rock bliss state in its shows at the Iridium.', 'lead_paragraph': 'The guitarist Mike Stern reached peak combustion at an unlikely point in his first set at the Iridium on Thursday night, while cutting a path from one guileless ballad to the next. 