irstname': 'Laura', 'middlename': None, 'lastname': 'Collins-Hughes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c6034b0a-f7c7-5515-99f7-ff76e0e5c7bb', 'word_count': 367, 'uri': 'nyt://article/c6034b0a-f7c7-5515-99f7-ff76e0e5c7bb'}, {'abstract': 'Study find that art auction market in China suffered significant slump in 2012, with total sales down to $4 billion, just half of what had been reported in 2011.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/19/study-documents-2012-downturn-in-chinese-art-market/', 'snippet': 'Study find that art auction market in China suffered significant slump in 2012, with total sales down to $4 billion, just half of what had been reported in 2011.', 'lead_paragraph': 'SHANGHAI — China’s art auction market suffered a sharp downturn in 2012, amid a global slump in demand for Chinese art, fueled in part by concern about the many fakes that are offered for sale.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Study Documents 2012 Downturn in Chinese Art Market', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Art Auction Sales Plummet in China', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-19T22:33:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By David Barboza and Graham Bowley', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Barboza', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Graham', 'middlename': None, 'lastname': 'Bowley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/98313f8a-5371-5e82-9a0c-018ea1b5a873', 'word_count': 485, 'uri': 'nyt://article/98313f8a-5371-5e82-9a0c-018ea1b5a873'}, {'abstract': 'Economists’ responses to a question about whether gift-giving is inefficient.', 'web_url': 'https://economix.blogs.nytimes.com/2013/12/19/economists-less-scrooge-like-than-you-thought/', 'snippet': 'Economists’ responses to a question about whether gift-giving is inefficient.', 'lead_paragraph': 'A few years ago Joel Waldfogel wrote “Scroogeonomics: Why You Shouldn’t Buy Presents for the Holidays,” an economic manifesto about the wastefulness of gift-giving. The Initiative on Global Markets at the University of Chicago’s Booth School of Business recently queried its panel of 46 economic experts on the subject, and the responses were surprisingly less Grinch-like.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Economists: Less Scrooge-Like Than You Thought', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economics (Theory and Philosophy)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gifts', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-19T22:36:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bc83014a-3444-57ab-aee0-26438699160a', 'word_count': 283, 'uri': 'nyt://article/bc83014a-3444-57ab-aee0-26438699160a'}, {'abstract': 'The “Make Music Winter” festival celebrates the solstice, and “The Anna Copa Cabanna Show” presents its final cabaret comedy act at Joe’s Pub.', 'web_url': 'https://www.nytimes.com/2013/12/20/nyregion/making-music-outdoors.html', 'snippet': 'The “Make Music Winter” festival celebrates the solstice, and “The Anna Copa Cabanna Show” presents its final cabaret comedy act at Joe’s Pub.', 'lead_paragraph': 'Perhaps it’s somewhat perverse, given the season, for the Miser to recommend joining a series of outdoor musical parades across the city this weekend. But looking over the lineup for this year’s “Make Music Winter” festival on Saturday, you might conclude that coat weather never sounded so good. ', 'print_section': 'C', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Making Music Outdoors', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': "Joe's Pub", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Make Music New York (Festival)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-19T22:38:24+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'New York', 'byline': {'original': 'By A. C. Lee', 'person': [{'firstname': 'A.', 'middlename': 'C.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80ef02fb-af7e-5d6a-b00e-979eb98d082e', 'word_count': 451, 'uri': 'nyt://article/80ef02fb-af7e-5d6a-b00e-979eb98d082e'}, {'abstract': 'The American Academy of Pediatrics recommends that pediatricians not display formula advertising in their offices, yet it allows a formula manufacturer to place the A.A.P. logo on branded hospital discharge bags.', 'web_url': 'https://parenting.blogs.nytimes.com/2013/12/19/does-the-a-a-p-logo-belong-on-formula-gift-bags/', 'snippet': 'The American Academy of Pediatrics recommends that pediatricians not display formula advertising in their offices, yet it allows a formula manufacturer to place the A.A.P. logo on branded hospital discharge bags.', 'lead_paragraph': 'If you walked out of a hospital with a new baby and an Enfamil-sponsored gift bag of formula during the past year, you might be wondering why it sported the American Academy of Pediatrics’ logo on its tag, just a little over a year after the same group released a lengthy policy statement reaffirming its recommendation that babies be exclusively breast-fed for the first six months, and up to one year with complementary foods. The logo appears on a safety tag attached to a bag containing gifts of formula as well as a booklet published by the American Academy of Pediatrics, “New Mother’s Breastfeeding Essentials,” with, according to Crystal Lewis of Women’s eNews, “Mead Johnson’s name prominently displayed on the inside of the cover page.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/19/style/motherlode-bag-tag/motherlode-bag-tag-jumbo.jpg', 'height': 418, 'width': 402, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/19/style/motherlode-bag-tag/motherlode-bag-tag-superJumbo.jpg', 'height': 418, 'width': 402, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/19/style/motherlode-bag-tag/motherlode-bag-tag-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/19/style/motherlode-bag-tag/motherlode-bag-tag-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/19/style/motherlode-bag-tag/motherlode-bag-tag-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Does the A.A.P. Logo Belong on Formula Gift Bags?', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Babies and Infants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Infant Formulas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN ACADEMY OF PEDIATRICS', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-19T22:39:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Kimberly Seals Allers', 'person': [{'firstname': 'Kimberly', 'middlename': 'Seals', 'lastname': 'Allers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8756ee0-cd1f-5f81-9011-02ce8674bfb5', 'word_count': 834, 'uri': 'nyt://article/f8756ee0-cd1f-5f81-9011-02ce8674bfb5'}, {'abstract': 'An Animated World, a festival at the IFC Center made up of films distributed by Gkids, includes several foreign productions.', 'web_url': 'https://www.nytimes.com/2013/12/20/movies/festival-of-gkids-films-at-ifc-center.html', 'snippet': 'An Animated World, a festival at the IFC Center made up of films distributed by Gkids, includes several foreign productions.', 'lead_paragraph': 'One way to look at An Animated World, a retrospective of films distributed by the New York-based company Gkids, is in terms of dollars. Of the 18 films in this festival, which begins Friday at the IFC Center in Manhattan, those that have already been released commercially in American theaters have made a total of about $2.8 million. That’s 1 ½ percent of what Disney’s “Frozen” has earned in less than a month.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20GKIDS_SPAN/20GKIDS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/20/arts/20GKIDS_SPAN/20GKIDS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20GKIDS_SPAN/20GKIDS-jumbo.jpg', 'height': 648, 'width': 972, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20GKIDS_SPAN/20GKIDS-superJumbo.jpg', 'height': 648, 'width': 972, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20GKIDS_SPAN/20GKIDS_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/20/arts/20GKIDS_SPAN/20GKIDS_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20GKIDS_SPAN/20GKIDS_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Animation of the Imagination', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'The Animation Of the Imagination', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ANIMATED FILM