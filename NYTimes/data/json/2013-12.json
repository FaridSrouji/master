/12/23/magazine/23-homer/23-homer-superJumbo.jpg', 'height': 375, 'width': 250, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/magazine/23-homer/23-homer-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/23/magazine/23-homer/23-homer-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/magazine/23-homer/23-homer-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Purrpose Driven Life', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-31T17:57:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By The Staff', 'person': [], 'organization': 'The Staff'}, 'type_of_material': 'News', '_id': 'nyt://article/3e9f57dd-c5ce-5cfc-adf1-3e88d1ff5f11', 'word_count': 1140, 'uri': 'nyt://article/3e9f57dd-c5ce-5cfc-adf1-3e88d1ff5f11'}, {'abstract': 'This pair of black, satin pumps is festive enough for ringing in 2014, and classy enough to wear all year through.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/12/31/feeling-for-nicholas-kirkwoods-timeless-sparkling-shoes/', 'snippet': 'This pair of black, satin pumps is festive enough for ringing in 2014, and classy enough to wear all year through.', 'lead_paragraph': 'Black, gold and a hint of sparkle — the usual makings of a New Year’s Eve outfit — beautifully converge on these towering, architectural shoes from the “It” Brit designer Nicholas Kirkwood. The glittering ball mounted under the arch of black satin is fun and festive for ringing in 2014, a tiny ode to the Times Square ball drop. And with the sculptural swaths of gold-trimmed black satin that hug the feet, this pair of high-heeled sandals from Kirkwood’s resort collection is also classy enough to complete party looks all year long.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/31/t-magazine/31kirkwood-lanphear/31kirkwood-lanphear-articleLarge.jpg', 'height': 552, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/31/t-magazine/31kirkwood-lanphear/31kirkwood-lanphear-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 552}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/31/t-magazine/31kirkwood-lanphear/31kirkwood-lanphear-jumbo.jpg', 'height': 943, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/31/t-magazine/31kirkwood-lanphear/31kirkwood-lanphear-superJumbo.jpg', 'height': 1886, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/31/t-magazine/31kirkwood-lanphear/31kirkwood-lanphear-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/31/t-magazine/31kirkwood-lanphear/31kirkwood-lanphear-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/31/t-magazine/31kirkwood-lanphear/31kirkwood-lanphear-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Feeling For | Nicholas Kirkwood’s Timeless, Sparkling Shoes', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Feeling For: Artful Arches', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-31T18:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6ac8a3f-bfd2-5b83-a00e-191c526790fd', 'word_count': 111, 'uri': 'nyt://article/f6ac8a3f-bfd2-5b83-a00e-191c526790fd'}, {'abstract': 'The actor discusses working with Martin Scorsese on “The Wolf of Wall Street.”', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2013/12/31/video-jonah-hill-on-the-wolf-of-wall-street/', 'snippet': 'The actor discusses working with Martin Scorsese on “The Wolf of Wall Street.”', 'lead_paragraph': 'Jonah Hill donned fake teeth and colorful shirts to play Donnie Azoff, the protégé of the stock trader Jordan Belfort (Leonardo DiCaprio) in “The Wolf of Wall Street.”\xa0 In this video from a luncheon with some of the film’s cast and crew, he discusses his excitement about getting the opportunity to work with Martin Scorsese.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video: Jonah Hill on ‘The Wolf of Wall Street’', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hill, Jonah', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-31T18:00:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastn