'value': 'Liverpool (Soccer Team)', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'Manchester City (Soccer Team)', 'rank': 15, 'major': 'N'}, {'name': 'organizations', 'value': 'Manchester United (Soccer Team)', 'rank': 16, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 17, 'major': 'N'}], 'pub_date': '2013-12-19T17:09:16+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By John F. Burns', 'person': [{'firstname': 'John', 'middlename': 'F.', 'lastname': 'Burns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/710f0839-c9d1-5374-a671-a6011d285970', 'word_count': 1105, 'uri': 'nyt://article/710f0839-c9d1-5374-a671-a6011d285970'}, {'abstract': 'Jeffrey Gonano, a 25-year old project manager in Wexford, Penn., won a 1914 Picasso gouache in an international raffle.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/19/its-not-the-powerball-but-a-prize-picasso/', 'snippet': 'Jeffrey Gonano, a 25-year old project manager in Wexford, Penn., won a 1914 Picasso gouache in an international raffle.', 'lead_paragraph': 'As ways to start an art collection go, there’s nothing quite like getting a Picasso. Accomplishing that takes a little luck, of course, but Jeffrey Gonano, a 25-year-old project manager for a fire sprinkler company in Wexford, Pa., had luck in his corner on Wednesday, when his ticket was drawn at a charity raffle run by Sotheby’s in Paris. The ticket cost 100 euros (about $137). The prize, Picasso’s “Man With Opera Hat,” a small gouache that dates to 1914, was estimated by Sotheby’s to be worth $1 million.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/19/arts/19artsbeat-picas