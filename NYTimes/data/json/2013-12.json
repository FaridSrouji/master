an/17southsudan-jumbo.jpg', 'height': 709, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/world/middleeast/17southsudan/17southsudan-superJumbo.jpg', 'height': 1419, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/world/middleeast/17southsudan/17southsudan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/17/world/middleeast/17southsudan/17southsudan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/17/world/middleeast/17southsudan/17southsudan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'President Says a Coup Failed in South Sudan', 'kicker': None, 'content_kicker': None, 'print_headline': 'President Says A Coup Failed In South Sudan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': "Kushkush, Isma'il", 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kiir Mayardit, Salva', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Sudan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': "Coups D'Etat and Attempted Coups D'Etat", 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-16T21:33:39+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': "By Isma'il Kushkush", 'person': [{'firstname': "Isma'il", 'middlename': None, 'lastname': 'Kushkush', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3977055c-c294-539c-a4b0-ee9bb93c2cd8', 'word_count': 327, 'uri': 'nyt://article/3977055c-c294-539c-a4b0-ee9bb93c2cd8'}, {'abstract': 'A Q. and A. with Jon Rafman, whose blog, 9 Eyes, features enigmatic scenes randomly captured on Google’s Street View cameras.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2013/12/16/poaching-memories-from-googles-wandering-eye/', 'snippet': 'A Q. and A. with Jon Rafman, whose blog, 9 Eyes, features enigmatic scenes randomly captured on Google’s Street View cameras.', 'lead_paragraph': 'In this past weekend’s issue, Adam Fisher explained Google’s ambitious plan to populate its maps with Street View images from all over the world — even the walls of the Grand Canyon, as seen from the rapids of the Colorado River. It called to mind a favorite Tumblr of mine, 9 Eyes, by the Canadian artist Jon Rafman. The blog, named for the nine cameras initially used to capture Street View images (Google has added six cameras since the project began), features enigmatic scenes taken from Rafman’s travels throughout this growing virtual universe. What follows is an edited version of our conversation.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/magazine/16-tiger/16-tiger-articleLarge.jpg', 'height': 375, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/16/magazine/16-tiger/16-tiger-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 375}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/magazine/16-tiger/16-tiger-jumbo.jpg', 'height': 640, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/magazine/16-tiger/16-tiger-superJumbo.jpg', 'height': 80