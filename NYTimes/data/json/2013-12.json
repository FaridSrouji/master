 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7d8d1ce6-d9ae-574c-9f57-a5c1a35df194', 'word_count': 405, 'uri': 'nyt://article/7d8d1ce6-d9ae-574c-9f57-a5c1a35df194'}, {'abstract': 'The musical “Wicked” and the play “Betrayal” set box office records, and 18 shows grossed over $1 million.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/30/a-record-setting-week-on-broadway/', 'snippet': 'The musical “Wicked” and the play “Betrayal” set box office records, and 18 shows grossed over $1 million.', 'lead_paragraph': 'Santa was in an especially generous mood last week on Broadway, where several shows looked under their trees and saw record-setting receipts. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/theater/30wicked/30wicked-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/30/theater/30wicked/30wicked-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/theater/30wicked/30wicked-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/theater/30wicked/30wicked-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/theater/30wicked/30wicked-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/30/theater/30wicked/30wicked-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/theater/30wicked/30wicked-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Record-Setting Week on Broadway', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '‘Wicked’ Has Best Week in Broadway History', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Wicked (Play)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-30T21:21:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e41df4b-28f5-5d71-8548-88f777a4e005', 'word_count': 337, 'uri': 'nyt://article/1e41df4b-28f5-5d71-8548-88f777a4e005'}, {'abstract': 'This version of the classic Italian drink substitutes dry sparkling wine for gin, which makes for a lighter libation that’s easier to drink and is\xa0perfect for the holidays.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/12/30/cocktail-culture-a-bubbly-twist-on-the-negroni/', 'snippet': 'This version of the classic Italian drink substitutes dry sparkling wine for gin, which makes for a lighter libation that’s easier to drink and is\xa0perfect for the holidays.', 'lead_paragraph': 'When a bartender at Bar Basso in Milan mistakenly grabbed a bottle of spumante instead of gin while making a Negroni (comprised of the holy trinity of the cocktail world: Campari, Italian vermouth and gin), he inadvertently created a simple, endlessly drinkable twist on a classic: the Negroni Sbagliato (“sbagliato” is Italian for “mistaken”). By substituting effervescent wine for the piney, citrusy sweetness of gin, he’d somehow stripped the Negroni down to its essence. Sbagliatos retain that pleasing chalkiness and minerality of Campari and the herby qualities of vermouth, but these flavors stretch out across the bubbles and somehow lead one to drink more slowly, savoring the medley. Unlike Negronis, which are all booze but taste like adult candy, Sbagliatos are less likely to put one’s party-appropriate sobriety at risk. But if they do wind up going down a little too quickly, rest easy — the Sbagliato is significantly lower in alcohol by volume than its brawnier big brother, a key consideration in the holiday marathon drinking season.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/t-magazine/30spagliato-rowan1/30spagliato-rowan1-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/30/t-magazine/30spagliato-rowan1/30spagliato-rowan1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/t-magazine/30spagliato-rowan1/30spagliato-rowan1-jumbo.jpg', 'height': 767, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/t-magazine/30spagliato-rowan1/30spagliato-rowan1-superJumbo.jpg', 'height': 1407, 'width': 1878, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/t-magazine/30spagliato-rowan1/30spagliato-rowan1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 