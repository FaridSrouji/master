 'A', 'print_page': '39', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/opinion/12burkeman/12burkeman-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/12/opinion/12burkeman/12burkeman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/opinion/12burkeman/12burkeman-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/opinion/12burkeman/12burkeman-superJumbo.jpg', 'height': 1293, 'width': 1293, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/opinion/12burkeman/12burkeman-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/12/opinion/12burkeman/12burkeman-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/opinion/12burkeman/12burkeman-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Who Goes to Work to Have Fun?', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Who Goes to Work to Have Fun?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Workplace Environment', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Burkeman, Oliver', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Happiness', 'r