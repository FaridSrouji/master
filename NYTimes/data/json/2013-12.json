gacy': {'xlarge': 'images/2013/12/16/arts/MGMT/MGMT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/MGMT/MGMT-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/MGMT/MGMT-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/MGMT/MGMT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/16/arts/MGMT/MGMT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/MGMT/MGMT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Wide Repertory Invites Plenty of Meandering', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Wide Repertory Invites Plenty of Meandering', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'MGMT', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-15T22:24:48+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3481d2e1-7c73-5f31-9fcb-a401013406c3', 'word_count': 485, 'uri': 'nyt://article/3481d2e1-7c73-5f31-9fcb-a401013406c3'}, {'abstract': 'Layers of fun and vitality mark American Ballet Theater’s “Nutcracker” production at the Brooklyn Academy of Music.', 'web_url': 'https://www.nytimes.com/2013/12/16/arts/dance/the-nutcracker-from-american-ballet-theater-at-bam.html', 'snippet': 'Layers of fun and vitality mark American Ballet Theater’s “Nutcracker” production at the Brooklyn Academy of Music.', 'lead_paragraph': 'Watching American Ballet Theater perform “The Nutcracker”\xa0at the Brooklyn Academy of Music this month is entirely a pleasure, mixed with several elements of happy surprise. It’s just so unusual for American ballet to display character acting as vivid and widespread as it is here from a large number of performers. The servants, mice, parents and guests of the opening scenes seem to have stepped out of Gogol or Dickens. They’re played with varying degrees of caricature, very finely judged; the degrees of subtle, funny exaggeration are in proportion to their psychological distance from the child heroine. Everyone seems to be bubbling over with vitality.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/NUTCRACKER/NUTCRACKER-articleLarge.jpg', 'height': 359, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/16/arts/NUTCRACKER/NUTCRACKER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 359}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/NUTCRACKER/NUTCRACKER-jumbo.jpg', 'height': 613, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/NUTCRACKER/NUTCRACKER-superJumbo.jpg', 'height': 1226, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/NUTCRACKER/NUTCRACKER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/16/arts/NUTCRACKER/NUTCRACKER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/NUTCRACKER/NUTCRACKER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mining Tchaikovsky, and Finding More Amid the Snowflakes', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Mining Tchaikovsky, and Finding More Amid the Snowflakes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Nutcracker (Ballet)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN BALLET THEATER', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ratmansky, Alexei', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Academy of Music', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-15T22:25:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3b0ad02c-e68d-58df-a489-bcc57b3711f3', 'word_count': 1042, 'uri': 'nyt://article/3b0ad02c-e68d-58df-a489-bcc57b3711f3'}, {'abstract': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'web_url': 'https://www.nytimes.com/2013/12/16/business/treasury-auctions-set-for-the-week-of-dec-16.html', 'snippet': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'lead_paragraph': 'The Treasury’s schedule of financing this week includes Monday’s regular weekly auction of new three- and six-month bills and an auction of four-week bills on Tuesday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Treasury Auctions Set for This Week ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Treasury Auctions Set for This Week', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-15T22:25:50+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ebb7da9a-5633-5b6e-a02f-5ee4967c4d6c', 'word_count': 280, 'uri': 'nyt://article/ebb7da9a-5633-5b6e-a02f-5ee4967c4d6c'}, {'abstract': '“Playwright: From Page to Stage,” on the PBS series “Independent Lens,” follows two playwrights, Rajiv Joseph and Tarell Alvin McCraney, as they have new works produced.', 'web_url': 'https://www.nytimes.com/2013/12/16/arts/television/playwrights-with-rajiv-joseph-and-tarell-alvin-mccraney-on-pbs.html', 'snippet': '“Playwright: From Page to Stage,” on the PBS series “Independent Lens,” follows two playwrights, Rajiv Joseph and Tarell Alvin McCraney, as they have new works produced.', 'lead_paragraph': 'Capturing the creative process in a documentary is next to impossible, and “Playwright: From Page to Stage,” on Monday on PBS’s “Independent Lens,” doesn’t succeed any better than previous efforts. But the film, which follows two young playwrights as they have new works produced in prominent regional theaters (culminating, for one, in a Broadway run), does have a few candid moments that go deeper than we’re used to seeing.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ambitions That Rise Long Before Curtains Do', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Ambitions That Rise Long Before Curtains Do', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Joseph, Rajiv', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McCraney, Tarell Alvin', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Independent Lens (TV Program)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-15T22:26:45+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/802308b2-2c5e-5103-a89e-b8b17a2ad50f', 'word_count': 401, 'uri': 'nyt://article/802308b2-2c5e-5103-a89e-b8b17a2ad50f'}, {'abstract': 'An interactive public art installation in Detroit has been the site of eight suspicious fires since May, The Associated Press reported.', 'web_url': 'https://www.nytimes.com/2013/12/16/arts/design/fire-investigation-at-detroit-art-site.html', 'snippet': 'An interactive public art installation in Detroit has been the site of eight suspicious fires since May, The Associated Press reported.', 'lead_paragraph': 'The Heidelberg Project, an interactive public art installation covering two blocks in Detroit, has been the site of eight suspicious fires since May, causing investigators to wonder why the project, which has existed in some form since 1986, has become a target, The Associated Press reported. The most recent fire took place on Dec. 8, destroying an abandoned house that had been repurposed as a canvas for paintings, recycled materials and found objects. Since October, five structures have been destroyed by fire. This is not the first time parts of the site have been destroyed. In 1991 and 1999, the city bulldozed large portions of the installation, viewing the collection of random items and hodgepodge paintings not as art, but as trash. Originally created by the artist Tyree Guyton to combat urban blight and decay, the Heidelberg Project has expanded its goals to provide art education and to promote community development. It is also something of a tourist destination, with over 275,000 visitors annually. There are no suspects in the fires. A private donor has offered a $25,000 reward in the case.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fire Investigation at Detroit Art Site', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Fire Investigation At Detroit Art Site', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Guyton, Tyree', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ARSON', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-15T22:27:38+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'Compiled by Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/684d64b2-da4e-56c8-a27b-30c1bd0784bb', 'word_count': 182, 'uri': 'nyt://article/684d64b2-da4e-56c8-a27b-30c1bd0784bb'}, {'abstract': 'A musical stage version of “A Christmas Story,” the Jean Shepherd holiday classic, looks as if it will settle in as a seasonal perennial.', 'web_url': 'https://www.nytimes.com/2013/12/16/theater/reviews/a-christmas-story-at-theater-at-madison-square-garden.html', 'snippet': 'A musical stage version of “A Christmas Story,” the Jean Shepherd holiday classic, looks as if it will settle in as a seasonal perennial.', 'lead_paragraph': 'Making a musical out of “A Christmas Story” must have hardly seemed like work to Joseph Robinette, the book writer, and Benj Pasek and Justin Paul, who provided the music and lyrics. How easy was it? When the second-act curtain went up on opening night of the production now running at the Theater at Madison Square Garden, a flagpole received a smattering of applause. ', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/christory/christory-articleLarge.jpg', 'height': 576, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/16/arts/christory/christory-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 576}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/christory/christory-jumbo.jpg', 'height': 983, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/16/arts/christory/christory-superJumbo.jpg', 'height': 1966, 'width': 2048, 'subType