, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/health/05well_gubar/05well_gubar-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/05/health/05well_gubar/05well_gubar-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/health/05well_gubar/05well_gubar-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Living With Cancer: Nude Mice', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mice', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ovarian Cancer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tests (Medical)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-05T20:11:29+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Susan Gubar', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Gubar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a9ddf3bc-0a5e-5f70-a94c-60b2c6ffcca5', 'word_count': 876, 'uri': 'nyt://article/a9ddf3bc-0a5e-5f70-a94c-60b2c6ffcca5'}, {'abstract': 'An exhibition about mansions and millionaires and the servants they employed on the East End of Long Island.', 'web_url': 'https://www.nytimes.com/2013/12/08/nyregion/downton-abbey-the-long-island-version.html', 'snippet': 'An exhibition about mansions and millionaires and the servants they employed on the East End of Long Island.', 'lead_paragraph': 'Among the most noticeable residents of Southampton in the early 1900s was Samuel Longstreth Parrish, a local benefactor who donated the land for Southampton’s hospital, helped establish its library and founded its art museum. His former home, headquarters of the Southampton Historical Museum, is now the setting for “Downton Abbey Style in Southampton: 1900 to 1920,” an exhibition about mansions and millionaires and their many servants.', 'print_section': 'LI', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/nyregion/08ARTSLI2_SPAN/08ARTSLI2_SPAN-articleLarge-v2.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/08/nyregion/08ARTSLI2_SPAN/08ARTSLI2_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/nyregion/08ARTSLI2_SPAN/08ARTSLI2_SPAN-jumbo-v2.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/nyregion/08ARTSLI2_SPAN/08ARTSLI2_SPAN-superJumbo-v2.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/nyregion/08ARTSLI2_SPAN/08ARTSLI2_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/08/nyregion/08ARTSLI2_SPAN/08ARTSLI2_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/08/nyregion/08ARTSLI2_SPAN/08ARTSLI2_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Downton Abbey,’ the Long Island Version', 'kicker': 'Arts | Long Island', 'content_kicker': None, 'print_headline': '‘Downton Abbey,’ the Long Island Version', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jacobson, Aileen', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Southampton Historical Museum (Southampton, NY)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Southampton (NY)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Downton Abbey (TV Program)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Edmonds, Tom', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Ballou, Emma', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Parrish, Samuel', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Hamptons (NY)', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-12-05T20:11:41+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Aileen Jacobson', 'person': [{'firstname': 'Aileen', 'middlename': None, 'lastname': 'Jacobson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3fa778a6-923f-556d-aedf-8a65bf7f7ba3', 'word_count': 902, 'uri': 'nyt://article/3fa778a6-923f-556d-aedf-8a65bf7f7ba3'}, {'abstract': 'For 13 years, Dennis and Debra Scholl have invited a guest curator to select works from their collection for display in their home.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/05/aficionados-on-walkabout-at-art-basel-miami-beach/', 'snippet': 'For 13 years, Dennis and Debra Scholl have invited a guest curator to select works from their collection for display in their home.', 'lead_paragraph': 'And then on the second day, they had brunch. After the frenzied opening hours of the Art Basel art fair in Miami, ambitious shoppers and browsers ambled into Thursday a bit more leisurely, taking in coffee and bagels with their art at the homes of some of Miami’s top collectors. Dennis Scholl, a vice-president at the John S. and James L. Knight Foundation, and his wife, Debra, have donated 300 works to the newly christened Pérez Art Museum Miami. But they still had plenty left to show off at their terraced apartment, which sits a stone’s throw from the convention center, home base for the fair.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/arts/05artsbeat-art/05artsbeat-art-articleLarge.jpg', 'height': 453, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/05/arts/05artsbeat-art/05artsbeat-art-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 453}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/arts/05artsbeat-art/05artsbeat-art-jumbo.jpg', 'height': 773, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/arts/05artsbeat-art/05artsbeat-art-superJumbo.jpg', 'height': 1510, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/arts/05artsbeat-art/05artsbeat-art-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/05/arts/05artsbeat-art/05artsbeat-art-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/05/arts/05artsbeat-art/05artsbeat-art-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Aficionados on Walkabout at Art Basel Miami Beach', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORIGINES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art Basel Miami Beach', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-05T20:20:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Patricia', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c59dd1bf-2875-5adf-9683-841e2a612e86', 'word_count': 392, 'uri': 'nyt://article/c59dd1bf-2875-5adf-9683-841e2a612e86'}, {'abstract': 'Georgia and Mississippi refuse to accept the post-DOMA reality.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/12/05/two-remaining-rebel-states/', 'snippet': 'Georgia and Mississippi refuse to accept the post-DOMA reality.', 'lead_paragraph': 'What a difference a day (sometimes) makes.\xa0 On Tuesday, I reported here that three states — Mississippi, Georgia and Louisiana — were still refusing to comply with Defense Secretary Chuck Hagel’s order issued in August that same-sex spouses of military personnel be given spousal and family benefits. That was down from eight states as of mid-November that were refusing to process applications for benefits at Guard facilities, or issue identification cards required to claim benefits, including\xa0medical services on the Guard member’s home base.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Two Remaining Rebel States', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hagel, Chuck', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-12-05T20:33:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Dorothy J. Samuels', 'person': [{'firstname': 'Dorothy', 'middlename': 'J.', 'lastname': 'Samuels', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8bf514fb-0eb0-5112-ad44-a6ce05057651', 'word_count': 238, 'uri': 'nyt://article/8bf514fb-0eb0-5112-ad44-a6ce05057651'}, {'abstract': 'Addressing matters of being young at the theater, charitable donations as gifts, meeting online friends in person and when jokes stop the laughter.', 'web_url': 'https://www.nytimes.com/2013/12/08/fashion/Old-Enough-at-Heart-social-qs.html', 'snippet': 'Addressing matters of being young at the theater, charitable donations as gifts, meeting online friends in person and when jokes stop the laughter.', 'lead_paragraph': 'I am a seventh grader in New York City, and I love going to the theater, especially with my friends. Now that I can no longer buy under-12 tickets, mine cost just as much as everyone else’s in the theater, but I am still treated like a child who can’t behave. How should I respond when anxious ushers tell me not to kick the seats in front of me before I’m even seated? Or when adults warn me that taking pictures is not allowed, which everyone knows? I don’t want to whine (like a child), but I don’t want to be patronized, either. Any suggestions?', 'print_section': 'ST', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-jumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-superJumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Old Enough at Heart', 'kicker': None, 'content_kicker': None, 'print_headline': 'Old-Enough at Heart', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-05T20:39:07+0000', 'document_type': 'art