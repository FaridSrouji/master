 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'HealthCare.gov', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Office of Management and Budget (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-12-23T01:29:02+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear and Annie Lowrey', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3922420-a382-5d64-96c0-9cb13126bc78', 'word_count': 1356, 'uri': 'nyt://article/c3922420-a382-5d64-96c0-9cb13126bc78'}, {'abstract': 'The rise of skyscrapers that dwarf their neighbors, sometimes elegantly but too often not, has prompted an argument: Should New York City put more limits on its skyline?', 'web_url': 'https://www.nytimes.com/2013/12/23/arts/design/seeing-a-need-for-oversight-of-new-yorks-lordly-towers.html', 'snippet': 'The rise of skyscrapers that dwarf their neighbors, sometimes elegantly but too often not, has prompted an argument: Should New York City put more limits on its skyline?', 'lead_paragraph': 'They’re arriving along 57th Street like a clutch of preening runway models, super-tall and skinny, the expensive playthings of Russian oligarchs and Chinese tycoons. A coupling of technology and wealth has bred this new, local hothouse species: leggy, cloud-piercing, sliver-thin residential towers.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/arts/JPSKYSCRAPER1-sub/JPSKYSCRAPER1-sub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/23/arts/JPSKYSCRAPER1-sub/JPSKYSCRAPER1-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/arts/JPSKYSCRAPER1-sub/JPSKYSCRAPER1-sub-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/arts/JPSKYSCRAPER1-sub/JPSKYSCRAPER1-sub-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/arts/JPSKYSCRAPER1-sub/JPSKYSCRAPER1-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/23/arts/JPSKYSCRAPER1-sub/JPSKYSCRAPER1-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/23/arts/JPSKYSCRAPER1-sub/JPSKYSCRAPER1-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seeing a Need for Oversight of New York’s Lordly Towers', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Seeing a Need for Oversight of New York’s Lordly Towers', 'name': None, 'se