': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/books/review/1215-bks-CHIRA/1215-bks-CHIRA-superJumbo.jpg', 'height': 1163, 'width': 1644, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/books/review/1215-bks-CHIRA/1215-bks-CHIRA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/15/books/review/1215-bks-CHIRA/1215-bks-CHIRA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/books/review/1215-bks-CHIRA/1215-bks-CHIRA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Strange Moors', 'kicker': None, 'content_kicker': None, 'print_headline': 'Strange Moors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Chira, Susan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mizumura, Minae', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Carpenter, Juliet Winters', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-13T16:00:23+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Susan Chira', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Chira', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/69577e75-b644-5777-8c86-907edccf1e18', 'word_count': 905, 'uri': 'nyt://article/69577e75-b644-5777-8c86-907edccf1e18'}, {'abstract': 'In these novellas, Jim Harrison lets his hero, B. D., loose in Michigan’s Upper Peninsula.', 'web_url': 'https://www.nytimes.com/2013/12/15/books/review/jim-harrisons-brown-dog.html', 'snippet': 'In these novellas, Jim Harrison lets his hero, B. D., loose in Michigan’s Upper Peninsula.', 'lead_paragraph': 'My all-boys high school A.P. English class was presided over by a glamorous, overqualified woman known to us as Dr. Lerner. I might have been in love with her. She smelled wonderful, like lemon trees on a hot day. Knowing she was a doctor of literature didn’t prevent me from imagining various medical situations in which she saved my life.', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/books/review/1215-bks-DOERR/1215-bks-DOERR-articleLarge.jpg', 'height': 664, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/15/books/review/1215-bks-DOERR/1215-bks-DOERR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 664}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/books/review/1215-bks-DOERR/1215-bks-DOERR-jumbo.jpg', 'height': 1024, 'width': 926, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/books/review/1215-bks-DOERR/1215-bks-DOERR-superJumbo.jpg', 'height': 1559, 'width': 1409, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/books/review/1215-bks-DOERR/1215-bks-DOERR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/15/books/review/1215-bks-DOERR/1215-bks-DOERR-t