ths Soar', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dolphins and Porpoises', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Alvarez, Lizette', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Oceans and Seas', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Oceanic and Atmospheric Administration', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Viruses', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-23T00:49:42+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Lizette Alvarez', 'person': [{'firstname': 'Lizette', 'middlename': None, 'lastname': 'Alvarez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0551417a-3613-5c88-a472-adadf22adc29', 'word_count': 1032, 'uri': 'nyt://article/0551417a-3613-5c88-a472-adadf22adc29'}, {'abstract': 'In October, 1,375 employees at the Resorts World Casino had their paychecks doubled after a ruling ordered the casino management to pay them a living wage.', 'web_url': 'https://www.nytimes.com/2013/12/23/nyregion/living-wage-ruling-gives-queens-casino-workers-a-fighting-chance.html', 'snippet': 'In October, 1,375 employees at the Resorts World Casino had their paychecks doubled after a ruling ordered the casino management to pay them a living wage.', 'lead_paragraph': 'For the fast-food workers who demonstrated across the country this month, it is only a dream. For many economists and policy makers, it is the subject of intense debate. But there is nothing hypothetical about the living wage for Sandra Charles, a security officer and single mother. For her, it is real, tangible and gloriously life-changing.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption':