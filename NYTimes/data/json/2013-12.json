pe': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Austin Ramzy', 'person': [{'firstname': 'Austin', 'middlename': None, 'lastname': 'Ramzy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96655a04-8aed-5351-8490-30123ee5e257', 'word_count': 570, 'uri': 'nyt://article/96655a04-8aed-5351-8490-30123ee5e257'}, {'abstract': 'Why won’t public health advocates lend support to smokers using a device that could ultimately save lives?', 'web_url': 'https://www.nytimes.com/2013/12/07/opinion/two-cheers-for-e-cigarettes.html', 'snippet': 'Why won’t public health advocates lend support to smokers using a device that could ultimately save lives?', 'lead_paragraph': 'Imagine a product — a legal but lethal one — that kills 400,000 Americans a year. Public health advocates have been trying for decades to persuade Americans not to use it. The industry has been sued and sued again, but it is still operating profitably. One out of every five Americans is addicted to the product.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/nocera-circular/nocera-circular-jumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/nocera-circular/nocera-circular-superJumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/nocera-circular/nocera-circular-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_na