{'name': 'creative_works', 'value': 'Torch Song Trilogy (Movie)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lucas, Craig', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Letts, Tracy', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Bogosian, Eric', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-12-19T23:33:56+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'Interviews by Erik Piepenburg', 'person': [{'firstname': 'Interviews', 'middlename': 'Erik', 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3e5a4862-16a9-5748-aa44-f9d0e71ab644', 'word_count': 2141, 'uri': 'nyt://article/3e5a4862-16a9-5748-aa44-f9d0e71ab644'}, {'abstract': 'Stars of the Lid, the ambient-music duo composed of Brian McBride and Adam Wiltzie, appeared in a rare concert at the Basilica of Our Lady of Perpetual Help in Brooklyn.', 'web_url': 'https://www.nytimes.com/2013/12/20/arts/music/stars-of-the-lid-in-a-rare-concert-in-brooklyn.html', 'snippet': 'Stars of the Lid, the ambient-music duo composed of Brian McBride and Adam Wiltzie, appeared in a rare concert at the Basilica of Our Lady of Perpetual Help in Brooklyn.', 'lead_paragraph': 'It’s not hard to concoct a list of likely inspirations for Stars of the Lid, the persuasive ambient-music duo formed in 1993 by Brian McBride and Adam Wiltzie. Seminal tape-loop meditations by Robert Fripp and Brian Eno, the haunting tidal wash of Gavin Bryars’s most influential handful of works, the infinite sadness of Gorecki’s Third Symphony, the unsettling disquiet of Angelo Badalamenti’s “Twin Peaks” music: All this and more resonates in the duo’s work.', 'print_section': 'C', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20WORD_SPAN/WORD-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/20/arts/20WORD_SPAN/WORD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20WORD_SPAN/WORD-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20WORD_SPAN/WORD-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20WORD_SPAN/WORD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/20/arts/20WORD_SPAN/WORD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/20/arts/20WORD_SPAN/WORD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'From Simple Chords, Trance-Inducing Effects', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'From Simple Chords, Trance-Inducing Effects', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Stars of the Lid (Music Group)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McBride, Brian', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-19T23:34:34+0000', 'document_type': 'article', 'news_desk': 'Weekend', 