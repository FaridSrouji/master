nk': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lapine, James', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Shalhoub, Tony', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Lincoln Center Theater', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-08T18:01:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/883e5e2d-76b2-5548-8f49-c4feb8f57183', 'word_count': 173, 'uri': 'nyt://article/883e5e2d-76b2-5548-8f49-c4feb8f57183'}, {'abstract': '“Frozen” took in about $31.6 million for a two-week total of $134.3 million. Some Oscar hopefuls, meanwhile, performed well in select theaters.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/12/08/disneys-frozen-leads-wintry-weekend-box-office/', 'snippet': '“Frozen” took in about $31.6 million for a two-week total of $134.3 million. Some Oscar hopefuls, meanwhile, performed well in select theaters.', 'lead_paragraph': 'It was the box-office calm before the Christmas storm: “Out of the Furnace,” the only new movie in wide release in North American theaters over the weekend, had terrible ticket sales, while holdovers skated along and Oscar hopefuls like “Inside Llewyn Davis” started their slow rollout.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Disney’s ‘Frozen’ Leads Wintry Weekend Box Office', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bale, Christian', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mandela, Nelson', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Rentrak Corp', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-08T18:11: