role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/464e99fa-a713-5242-aadf-cc9d778976a1', 'word_count': 1195, 'uri': 'nyt://article/464e99fa-a713-5242-aadf-cc9d778976a1'}, {'abstract': 'The Obama administration said it had reduced the error rate in enrollment data sent to insurance companies, even as insurers said that files they received were riddled with mistakes.', 'web_url': 'https://www.nytimes.com/2013/12/15/us/enrollment-errors-cut-officials-say-fixes-are-overstated-insurers-report.html', 'snippet': 'The Obama administration said it had reduced the error rate in enrollment data sent to insurance companies, even as insurers said that files they received were riddled with mistakes.', 'lead_paragraph': 'WASHINGTON — The Obama administration said Saturday that it had reduced the error rate in enrollment data sent to insurance companies under the new health care law, even as insurers said that the government’s records were still riddled with mistakes. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Enrollment Errors Cut, Officials Say; Fixes Are Overstated, Insurers Report', 'kicker': None, 'content_kicker': None, 'print_headline': 'Enrollment Errors Cut, Officials Say; Fixes Are Overstated, Insurers Report', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pear, Robert', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'HealthCare.gov', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-12-14T21:39:13+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Rober