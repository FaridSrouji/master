me': 'William', 'middlename': None, 'lastname': 'Yardley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/2cc6c771-c0af-5344-ba90-b2536cbd20f7', 'word_count': 519, 'uri': 'nyt://article/2cc6c771-c0af-5344-ba90-b2536cbd20f7'}, {'abstract': 'A weekly capsule of travel news curated by our writers and editors.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/12/17/walkabout-ski-movies-that-dont-just-melt-away-divorce-parties-in-vegas/', 'snippet': 'A weekly capsule of travel news curated by our writers and editors.', 'lead_paragraph': 'Once known as “ski porn” by powder enthusiasts, ski movies have evolved to include actual stories. (The New York Times)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Walkabout: Ski Movies That Don’t Just Melt Away; Divorce Parties in Vegas', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Hawaii', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Las Vegas (Nev)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-17T16:28:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/0b91b28e-4f00-56ce-9703-9341c7aba2dc', 'word_count': 77, 'uri': 'nyt://article/0b91b28e-4f00-56ce-9703-9341c7aba2dc'}, {'abstract': 'Same-sex spouses of military personnel are now able to obtain benefits in every state.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/12/17/the-national-guard-rebellion-is-over/', 'snippet': 'Same-sex spouses of military personnel are now able to obtain benefits in every state.', 'lead_paragraph': 'It shouldn’t have taken so long. But it appears that the Great National Guard Rebellion, in which units in nine states refused to comply with Defense Secretary Chuck Hagel’s order that same-sex spouses of military personnel be given full spousal benefits, is finally over.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The National Guard Rebellion Is Over', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hagel, Chuck', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Guard', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-17T16:35:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Dorothy J. Samuels', 'person': [{'firstname': 'Dorothy', 'middlename': 'J.', 'lastname': 'Samuels', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2c92d3b5-840f-5ea3-b52f-fb6bd2e55d86', 'word_count': 242, 'uri': 'nyt://article/2c92d3b5-840f-5ea3-b52f-fb6bd2e55d86'}, {'abstract': 'It’s hard to go wrong when choosing a wine to drink with this bird.', 'web_url': 'https://www.nytimes.com/2013/12/18/dining/pinot-noir-and-duck-a-match-made-in-heaven.html', 'snippet': 'It’s hard to go wrong when choosing a wine to drink with this bird.', 'lead_paragraph': 'Let’s not mince words: the conventional and excellent pairing for duck is pinot noir. It’s a beautiful combination that tends to work with many different accents and flavorings.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pinot Noir and Duck: A Match Made in Heaven', 'kicker': None, 'content_kicker': None, 'print_headline': 'And to Drink...', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Asimov, Eric', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wines', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-17T16:36:38+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Eric Asimov', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Asimov', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/40bda379-e1bf-5e60-acd4-81778b78f06d', 'word_count': 128, 'uri': 'nyt://article/40bda379-e1bf-5e60-acd4-81778b78f06d'}, {'abstract': 'A downside for investors, writes Christopher Swann of Reuters Breakingviews, is that they cannot rely on Aubrey McClendon’s attention or loyalty.', 'web_url': 'https://dealbook.nytimes.com/2013/12/17/mcclendons-new-venture-echoes-dealings-at-chesapeake-energy/', 'snippet': 'A downside for investors, writes Christopher Swann of Reuters Breakingviews, is that they cannot rely on Aubrey McClendon’s attention or loyalty.', 'lead_paragraph': 'Aubrey McClendon’s new public offering plan is an echo of the bad old Chesapeake Energy. He lost his job as chief executive of the energy company over excessive spending and conflicts of interest. A new $2 billion venture would allow him to cherry-pick assets ahead of his investors and reward him generously. Despite Mr. McClendon’s knack for buying oil and gas properties, investor skepticism is in order.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-mcclendon/dbpix-mcclendon-articleLarge.jpg', 'height': 382, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/18/business/dbpix-mcclendon/dbpix-mcclendon-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 382}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-mcclendon/dbpix-mcclendon-jumbo.jpg', 'height': 651, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-mcclendon/dbpix-mcclendon-superJumbo.jpg', 'height': 1303, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-mcclendon/dbpix-mcclendon-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/18/business/dbpix-mcclendon/dbpix-mcclendon-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-mcclendon/dbpix-mcclendon-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'McClendon’s New Venture Echoes Dealings at Chesapeake Energy', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Conflicts of Interest', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McClendon, Aubrey K', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chesapeake Energy Corporation', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-17T16:46:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Christopher Swann', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Swann', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a079398c-8c47-5a93-88d6-68c2f224c04b', 'word_count': 397, 'uri': 'nyt://article/a079398c-8c47-5a93-88d6-68c2f224c04b'}, {'abstract': 'Tom Hayes, a former trader at UBS and Citigroup, has been charged criminally in Britain and the United States in the scandal.', 'web_url': 'https://dealbook.nytimes.com/2013/12/17/former-trader-pleads-not-guilty-in-rate-rigging-case/', 'snippet': 'Tom Hayes, a former trader at UBS and Citigroup, has been charged criminally in Britain and the United States in the scandal.', 'lead_paragraph': 'LONDON — A former trader at UBS and Citigroup pleaded not guilty Tuesday to allegations that he manipulated a crucial benchmark interest rate.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-libor/dbpix-libor-articleLarge.jpg', 'height': 417, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/18/business/dbpix-libor/dbpix-libor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 417}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-libor/dbpix-libor-jumbo.jpg', 'height': 711, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-libor/dbpix-libor-superJumbo.jpg', 'height': 1422, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-libor/dbpix-libor-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/18/business/dbpix-libor/dbpix-libor-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/business/dbpix-libor/dbpix-libor-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Former Trader Pleads Not Guilty in Rate-Rigging Case', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Rate-Rigging Case', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Libor (London Interbank Offered Rate)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Citigroup Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Serious Fraud Office (United Kingdom)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'UBS AG', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-17T16:51:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Chad Bray', 'person': [{'firstname': 'Chad', 'middlename': None, 'lastname': 'Bray', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c310fcb3-09bd-5a02-b3d1-ab1e2522225a', 'word_count': 250, 'uri': 'nyt://article/c310fcb3-09bd-5a02-b3d1-ab1e2522225a'}, {'abstract': 'The Seattle Seahawks’ pass defense in the current pass-happy N.F.L. can be placed in the same category as those of the 2002 Buccaneers, the 1985 Bears and the 1974 Steelers.', 'web_url': 'https://www.nytimes.com/2013/12/18/sports/football/seahawks-pass-defense-thrives-in-a-tough-environment.html', 'snippet': 'The Seattle Seahawks’ pass defense in the current pass-happy N.F.L. can be placed in the same category as those of the 2002 Buccaneers, the 1985 Bears and the 1974 Steelers.', 'lead_paragraph': 'As the passing revolution overtakes the N.F.L., football fans have become immune to the avalanche of falling records. Teams are averaging 239 passing yards per game and completing 61.3 percent of passes, metrics that would be single-season records. Peyton Manning is on a pace to break the single-season record for passing yards and passing touchdowns, and there was discussion last week that he was not even the most valuable player in the league. Josh Gordon set records for receiving yards in a two-, three- and four-game stretch this season, and the Cleveland Browns lost each of those games. You can forgive fans for not being impressed by gaudy passing numbers when Philadelphia Eagles quarterback Nick Foles started the season with 19 touchdowns and no interceptions.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/sports/football/18nflscore/18nflscore-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/18/sports/football/18nflscore/18nflscore-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/sports/football/18nflscore/18nflscore-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/18/sports/football/18nflscore/18nflscore-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, '