'}, {'name': 'subject', 'value': 'Tablet Computers', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Toys', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-11T16:41:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef3c9827-f6fc-5fbc-88bc-b6a5f2f72f72', 'word_count': 661, 'uri': 'nyt://article/ef3c9827-f6fc-5fbc-88bc-b6a5f2f72f72'}, {'abstract': 'The move was a major shift that could have far-reaching implications for industrial farming and human health.', 'web_url': 'https://www.nytimes.com/2013/12/12/health/fda-to-phase-out-use-of-some-antibiotics-in-animals-raised-for-meat.html', 'snippet': 'The move was a major shift that could have far-reaching implications for industrial farming and human health.', 'lead_paragraph': 'WASHINGTON — The Food and Drug Administration on Wednesday put in place a major new policy to phase out the indiscriminate use of antibiotics in cows, pigs and chickens raised for meat, a practice that experts say has endangered human health by fueling the growing epidemic of antibiotic resistance.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/us/JP-ANTIBIOTIC/JP-ANTIBIOTIC-articleLarge.jpg', 'height': 901, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/12/us/JP-ANTIBIOTIC/JP-ANTIBIOTIC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 901}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/us/JP-ANTIBIOTIC/JP-ANTIBIOTIC-jumbo.jpg', 'height': 1024, 'width': 683, 'su