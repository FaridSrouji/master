ame': None, 'lastname': 'Fox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/acb9b680-fba8-5f6c-ab7e-314554934179', 'word_count': 597, 'uri': 'nyt://article/acb9b680-fba8-5f6c-ab7e-314554934179'}, {'abstract': 'On Wednesday, a review board issued more than 40 suggested changes at the National Security Agency.', 'web_url': 'https://www.nytimes.com/interactive/2013/12/19/us/politics/19nsa-review.html', 'snippet': 'On Wednesday, a review board issued more than 40 suggested changes at the National Security Agency.', 'lead_paragraph': 'On Wednesday, a review board issued more than 40 suggested changes at the National Security Agency.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Presidential Advisory Committee’s Recommendations for N.S.A.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Security Agency', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-12-18T21:00:07+0000', 'document_type': 'multimedia', 'news_desk': 'U.S.', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/74686a69-f37d-5e25-aa59-7f0d8991dbe5', 'word_count': 0, 'uri': 'nyt://interactive/74686a69-f37d-5e25-aa59-7f0d8991dbe5'}, {'abstract': 'On the “curious absence” of social conservatives in economics (and other fields as well).', 'web_url': 'https://douthat.blogs.nytimes.com/2013/12/18/social-conservatives-and-social-science/', 'snippet': 'On the “curious absence” of social conservatives in economics (and other fields as well).', 'lead_paragraph': "In a foray with some relevance to my last post\xa0on the social science surrounding premarital sex, Bryan Caplan wonders about what he calls “the curious absence of socially conservative economics.” Noting that “academic economists range from liberal to libertarian,”\xa0he asks: “What can we learn from conservative economics’ failure to launch?”\xa0One possibility, he allows, is that social conservatism simply doesn’t have any solid economic arguments behind it, but that “has an obvious problem:\xa0Rationalizing social conservatism using Econ 101 is child’s play.\xa0 Just close your eyes, tap your heels three times, and say ‘Negative externalities.'” (From risky sex, drug and alcohol use, family breakdown, etc.) And yet, Caplan says, “almost no social conservative bothers to make [economic] arguments. Why don’t they?”", 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Social Conservatives and Social Science', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Birth Control and Family Planning', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sociology', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Berry, Wendell', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Chesterton, G.K.', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cowen, Tyler', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Neuhaus, Richard John', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'NOVAK, MICHAEL', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Regenerus, Mark', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Whitehead, Barbara Dafoe', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, James Q', 'rank': 13, 'major': 'N'}], 'pub_date': '2013-12-18T21:08:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d178822e-4ccd-56a1-bb74-ef76f74eab50', 'word_count': 1115, 'uri': 'nyt://article/d178822e-4ccd-56a1-bb74-ef76f74eab50'}, {'abstract': 'Angela Merkel said her government’s policy of exempting hundreds of companies from a surcharge on electricity was meant to protect jobs.', 'web_url': 'https://www.nytimes.com/2013/12/19/business/international/germany-defends-surcharge-exemptions.html', 'snippet': 'Angela Merkel said her government’s policy of exempting hundreds of companies from a surcharge on electricity was meant to protect jobs.', 'lead_paragraph': 'BERLIN — Chancellor Angela Merkel of Germany vowed Wednesday to fight a European Union investigation into her government’s policy of exempting hundreds of companies from a surcharge on electricity that is used to promote renewable resources.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Germany Defends Surcharge Exemptions', 'kicker': None, 'content_kicker': None, 'print_headline': 'E.U. Opens Inquiry Into Germany Energy Surcharge Exemptions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Alternative and Renewable Energy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-12-18T21:15:27+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Melissa Eddy', 'person': [{'firstname': 'Melissa', 'middlename': Non