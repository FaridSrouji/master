or': 'N'}, {'name': 'persons', 'value': 'Bircher, Mark William', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Peters, Kathleen M', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-12-24T02:38:24+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Lizette Alvarez', 'person': [{'firstname': 'Lizette', 'middlename': None, 'lastname': 'Alvarez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c32ac339-b243-5454-a8c6-492aa866510f', 'word_count': 1246, 'uri': 'nyt://article/c32ac339-b243-5454-a8c6-492aa866510f'}, {'abstract': 'Candlestick Park, home to the San Francisco 49ers and at one time the Giants, will be torn down. “It was a dump,” said a former 49ers wide receiver. “But it was our dump.”', 'web_url': 'https://www.nytimes.com/2013/12/24/sports/candlestick-park-fades-from-a-spotlight-it-made-a-habit-of-stealing.html', 'snippet': 'Candlestick Park, home to the San Francisco 49ers and at one time the Giants, will be torn down. “It was a dump,” said a former 49ers wide receiver. “But it was our dump.”', 'lead_paragraph': 'SAN FRANCISCO — Nostalgia crept over Candlestick Park like summer fog Monday as the 49ers played what was quite possibly the final game at a stadium that few ever loved.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/24/sports/SUB-CANDLESTICK2/SUB-CANDLESTICK2-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/24/sports/SUB-CANDLESTICK2/SUB-CANDLESTICK2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/