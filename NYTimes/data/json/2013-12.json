, 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/243b3ec6-c10b-5850-9d30-7aa51e153bbd', 'word_count': 632, 'uri': 'nyt://article/243b3ec6-c10b-5850-9d30-7aa51e153bbd'}, {'abstract': 'The South African authorities said they were aware of news media reports that Thamsanqa Jantjie had been accused of murder in 2003.', 'web_url': 'https://www.nytimes.com/2013/12/14/world/africa/south-africa-interpreter.html', 'snippet': 'The South African authorities said they were aware of news media reports that Thamsanqa Jantjie had been accused of murder in 2003.', 'lead_paragraph': 'QUNU, South Africa — The South African government said on Friday that it was looking into news media reports that the man hired to provide deaf interpretation at Nelson Mandela’s memorial service had once been accused of murder and other serious crimes. The reports added intrigue to the scandal surrounding the supposed interpreter, who used incomprehensible sign language and later said he was a violence-prone schizophrenic who hallucinated.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/world/interpreter/interpreter-articleLarge.jpg', 'height': 299, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/12/world/interpreter/interpreter-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 299}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/world/interpreter/interpreter-jumbo.jpg', 'height': 510, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/world/interpreter/interpreter-superJumbo.jpg', 'height': 1019, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/world/interpreter/interpreter-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/12/world/interpreter/interpreter-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/12/world/interpreter/interpreter-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'South Africa Looks Into Claims of Interpreter’s Criminal Past', 'kicker': None, 'content_kicker': None, 'print_headline': 'South Africa Looks Into Claims Of Interpreter’s Criminal Past', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mandela, Nelson', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jantjie, Thamsanqa', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sign Language', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Funerals and Memorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-13T18:30:48+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By John Eligon', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Eligon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/528ba464-f19c-57c5-aebb-7836394b4180', 'word_count': 426, 'uri': 'nyt://article/528ba464-f19c-57c5-aebb-7836394b4180'}, {'abstract': 'Hardship probably isn’t the first word that springs to mind when you think of the actress Gwyneth Paltrow.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/television/body-and-mind-rebounding.html', 'snippet': 'Hardship probably isn’t the first word that springs to mind when you think of the actress Gwyneth Paltrow.', 'lead_paragraph': 'Hardship probably isn’t the first word that springs to mind when you think of the actress Gwyneth Paltrow and the trainer Tracy Anderson, who helped Ms. Paltrow firm up her jiggly bits with such success that they became business partners. Now the twosome is moving beyond the starry realm with “The Restart Project,” available for streaming starting Monday on AOL On, that celebrates mere mortals who have overcome adversity, whether career-ending injuries or debilitating obesity, through fitness and diet.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Body and Mind, Rebounding', 'kicker': 'The Week Ahead | Television', 'content_kicker': None, 'print_headline': 'Body and Mind, Rebounding', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:31:16+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/acc56093-c236-5a24-887c-9fbdcfd8d020', 'word_count': 184, 'uri': 'nyt://article/acc56093-c236-5a24-887c-9fbdcfd8d020'}, {'abstract': 'Critics like to rib Leon Botstein for excessively square conducting that can drain some of the flair from the music.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/music/a-straussian-tale-of-thwarted-lust.html', 'snippet': 'Critics like to rib Leon Botstein for excessively square conducting that can drain some of the flair from the music.', 'lead_paragraph': 'Critics like to rib Leon Botstein for excessively square conducting that can drain some of the flair from the music. But his style has improved over the years, and he remains one of the most creative minds in American music, known for restless — some might say relentless — advocacy of the unexplored and underappreciated. He has long been a champion of Richard Strauss’s lesser-known operas, and\xa0on Sunday\xa0he leads his American Symphony Orchestra in “Feuersnot,” whose difficult-to-translate title the ensemble has rendered as “In Need of Fire.” ', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Straussian Tale of Thwarted Lust', 'kicker': 'The Week Ahead | Classical Music', 'content_kicker': None, 'print_headline': 'A Straussian Tale Of Thwarted Lust', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:31:38+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1cca1694-e493-5450-be15-fe299eda61be', 'word_count': 174, 'uri': 'nyt://article/1cca1694-e493-5450-be15-fe299eda61be'}, {'abstract': 'Museum of ruined dinners; the tipsy witness; how to ask smart questions.', 'web_url': 'https://www.nytimes.com/interactive/2013/12/15/magazine/15-one-page-magazine.html', 'snippet': 'Museum of ruined dinners; the tipsy witness; how to ask smart questions.', 'lead_paragraph': 'Museum of ruined dinners; the tipsy witness; how to ask smart questions.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15OPM-thumb/15OPM-thumb-jumbo.png', 'height': 150, 'width': 150, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15OPM-thumb/15OPM-thumb-superJumbo.png', 'height': 150, 'width': 150, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15OPM-thumb/15OPM-thumb-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/15/magazine/15OPM-thumb/15OPM-thumb-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/magazine/15OPM-thumb/15OPM-thumb-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mistletoe, Vindicated', 'kicker': 'The One-Page Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:32:38+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/6590a5e4-3347-5d35-9179-efdc00505e22', 'word_count': 0, 'uri': 'nyt://interactive/6590a5e4-3347-5d35-9179-efdc00505e22'}, {'abstract': 'Groups of students from the Tanztheater Wuppertal and Juilliard are performing “Wind von West,” offering a rare glimpse of Pina Bausch’s early career.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/dance/a-bausch-rarity-set-to-stravinsky.html', 'snippet': 'Groups of students from the Tanztheater Wuppertal and Juilliard are performing “Wind von West,” offering a rare glimpse of Pina Bausch’s early career.', 'lead_paragraph': 'In 1975, not much more than a year after Pina Bausch had become the director of the Tanztheater Wuppertal and well before she had become an international name, she choreographed a three-part Stravinsky evening for her company. The final section was “The Rite of Spring,” now one of the most famous dance versions of the piece, but the first two works were not to be seen again until a recent revival in Wuppertal brought together students from the local Folkwangschule and Juilliard to collaborate on a revival of “Wind von West” (“Wind from the West”), set to Stravinsky’s 1952 “Cantata.” ', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Bausch Rarity Set to Stravinsky', 'kicker': 'The Week Ahead | Dance', 'content_kicker': None, 'print_headline': 'A Bausch Rarity Set to Stravinsky', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:32:51+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b595083-d977-5d46-80c8-eb902589101f', 'word_count': 191, 'uri': 'nyt://article/6b595083-d977-5d46-80c8-eb902589101f'}, {'abstract': 'Albums from Drake, Kanye West and Ashley Monroe are among Jon Caramanica’s favorite releases of the year.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/music/drake-kanye-west-and-ashley-monroe.html', 'snippet': 'Albums from Drake, Kanye West and Ashley Monroe are among Jon Caramanica’s favorite releases of the year.', 'lead_paragraph': '1. Drake “Nothing Was the Same” (Young Money/Cash Money/Republic) Drake is all the emoji: the prayer hands, the dancing girls, the diamond ring, the blown kiss, the laughing through tears. This is his rowdiest album so far, but all that means is he’s matured enough to know how to punch hard while still hopelessly lost in his feelings.', 'print_section': 'AR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CARAMANICA1_SPAN/15CARAMANICA1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/15/arts/15CARAMANICA1_SPAN/15CARAMANICA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CARAMANICA1_SPAN/15CARAMANICA1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CARAMANICA1_SPAN/15CARAMANICA1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CARAMANICA1_SPAN/15CARAMANICA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/15/arts/15CARAMANICA1_SPAN/15CARAMANICA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CARAMANICA1_SPAN/15CARAMANICA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Abrasive Tactics Lead to Notable Tunes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Abrasive Tactics Lead to Notable Tunes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pusha T', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Drake', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ferreira, Sky', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-13T18:32:53+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/9d8ae7fb-1ae5-5e39-902a-1a7c82637fb5', 'word_count': 618, 'uri': 'nyt://article/9d8ae7fb-1ae5-5e39-902a-1a7c82637fb5'}, {'abstract': 'Jim Jarmusch’s “Down by Law” would have been attention-getting for its casting alone.', 'web_url': 'https://www.nytimes.com/2013/12/15/movies/unlikely-trio-on-the-lam.html', 'snippet': 'Jim Jarmusch’s “Down by Law” would have been attention-getting for its casting alone.', 'lead_paragraph': 'Jim Jarmusch’s “Down by Law” would have been attention-getting for its casting alone. The three misfits at the center of the story, who find themselves in a New Orleans jail, are played by John Lurie, Tom Waits and Roberto Benigni. But what makes this odd comedy really distinctive is the black-and-white cinematography by Robby Muller. “We are seeing a true filmmaker at work,” wrote Vincent Canby, reviewing the movie in The New York Times in 1986, “using film to create a narrative that couldn’t exist on the stage or the printed page of a novel.” ', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Unlikely Trio on the Lam', 'kicker': 'The Week Ahead | Film', 'content_kicker': None, 'print_headline': 'Unlikely Trio On the Lam', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:33:23+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1257e118-8446-51b7-b3a9-c536959b1762', 'word_count': 210, 'uri': 'nyt://article/1257e118-8446-51b7-b3a9-c536959b1762'}, {'abstract': 'Much of what you need to know about Geri Allen can be found in the second track of her most recent album.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/music/modern-jazz-spin-on-the-sad-jester.html', 'snippet': 'Much of what you need to know about Geri Allen can be found in the second track of her most recent album.', 'lead_paragraph': 'Much of what you need to know about Geri Allen can be found in the second track of her most recent album, “Grand River Crossings” (Motéma), which bears the subtitle “Motown & Motor City Inspirations.” The track is a solo piano version of Smokey Robinson’s “Tears of a Clown,” refurbished with modern-jazz harmony but otherwise faithful to the structure of the tune. Ms. Allen’s fondness for the material shines through her erudition; she isn’t dabbling, showing off, or using the song merely as a springboard. Her elaborations feel grounded in earthly realities and respect.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Modern-Jazz Spin on the Sad Jester', 'kicker': 'The Week Ahead | Pop', 'content_kicker': None, 'print_headline': 'Modern-Jazz Spin On the Sad Jester', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:33:46+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/188723e3-6117-5a00-8ba7-42d30f39730e', 'word_count': 182, 'uri': 'nyt://article/188723e3-6117-5a00-8ba7-42d30f39730e'}, {'abstract': 'The lyrics of the chestnut “The Wheel of the Wagon Is Broken” mourn an Old West irretrievably passed.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/design/the-old-west-exalted-in-bronze.html', 'snippet': 'The lyrics of the chestnut “The Wheel of the Wagon Is Broken” mourn an Old West irretrievably passed.', 'lead_paragraph': 'The lyrics of the chestnut “The Wheel of the Wagon Is Broken” mourn an Old West irretrievably passed: “My days on the prairie are over. There’s weeds round the old ranch door.” The sculptor Frederic Remington, who probably more than any other artist enshrined the myth of the frontier in art, put it even more mournfully: “My West passed utterly out of existence so long ago as if to make it merely a dream. It put on its hat, took up its blankets and marched off the board.”', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Old West, Exalted in Bronze', 'kicker': 'The Week Ahead | Art', 'content_kicker': None, 'print_headline': 'The Old West, Exalted in Bronze', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:34:12+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2e1b04e-b95c-52ae-8e1f-e76a2f448014', 'word_count': 198, 'uri': 'nyt://article/c2e1b04e-b95c-52ae-8e1f-e76a2f448014'}, {'abstract': 'Standout records from Wayne Shorter, Andy Bey, Earl Sweatshirt and Cécile McLorin Salvant.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/music/craig-taborn-wayne-shorter-and-bill-callahan-achieve.html', 'snippet': 'Standout records from Wayne Shorter, Andy Bey, Earl Sweatshirt and Cécile McLorin Salvant.', 'lead_paragraph': '1. Craig Taborn Trio “Chants” (ECM) The deep, seductive intelligence at work in “Chants,” Craig Taborn’s first piano trio album in a dozen years, suggests an ocean of influences distilled into an original potion. Unpacking his terse compositions in communion with the bassist Thomas Morgan and the drummer Gerald Cleaver, Mr. Taborn gives each oblique maneuver a purpose, and often a flicker of intrepid grace.', 'print_section': 'AR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CHINEN2_SPAN/15CHINEN2_SPAN-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/15/arts/15CHINEN2_SPAN/15CHINEN2_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CHINEN2_SPAN/15CHINEN2_SPAN-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CHINEN2_SPAN/15CHINEN2_SPAN-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CHINEN2_SPAN/15CHINEN2_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/15/arts/15CHINEN2_SPAN/15CHINEN2_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15CHINEN2_SPAN/15CHINEN2_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Mix of Sounds, Generations and Styles', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Mix of Sounds, Generations and Styles', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jazz', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Shorter, Wayne, Quartet', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Earl Sweatshirt', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shorter, Wayne', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Salvant, Cecile McLorin', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Perez, Danilo', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Taborn, Craig', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-12-13T18:35:10+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/c4071e8c-b1b6-51b0-9b5b-10d847098f90', 'word_count': 678, 'uri': 'nyt://article/c4071e8c-b1b6-51b0-9b5b-10d847098f90'}, {'abstract': 'President Obama called again for more accountability in sub-Saharan Africa, but some see a gap between his words and deeds on the continent.', 'web_url': 'https://www.nytimes.com/2013/12/14/world/africa/in-obamas-praise-of-mandela-a-nudge-to-africa.html', 'snippet': 'President Obama called again for more accountability in sub-Saharan Africa, but some see a gap between his words and deeds on the continent.', 'lead_paragraph': 'WASHINGTON — When President Obama delivered his eulogy of Nelson Mandela in Soweto, South Africa, on Tuesday, he intended it as both a celebration of Mr. Mandela and a chastisement, not just of himself for failing to live up to the Mandela legacy, but of the African leaders who listened to him in the pelting rain.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Obama’s Praise of Mandela, a Nudge to Africa', 'kicker': 'Listening Post', 'content_kicker': None, 'print_headline': 'In Obama’s Praise of Mandela, a Nudge to Africa', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States International Relations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Landler, Mark', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mandela, Nelson', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-13T18:38:22+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Mark Landler', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Landler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/719c19b0-0778-5c0d-9bf8-38acc9877bf7', 'word_count': 1026, 'uri': 'nyt://article/719c19b0-0778-5c0d-9bf8-38acc9877bf7'}, {'abstract': 'A reader protests and an editor responds about the use of a charged word', 'web_url': 'https://publiceditor.blogs.nytimes.com/2013/12/13/is-entitlements-the-best-word-for-social-security-and-medicare/', 'snippet': 'A reader protests and an editor responds about the use of a charged word', 'lead_paragraph': 'A New York City reader, Judith Abrams, wrote with a complaint about the use of the term “entitlements” in federal budget articles. In so doing, she raised other questions that are worth consideration.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is ‘Entitlements’ the Best Word for Social Security and Medicare?', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-13T18:39:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9ca8c1c-2867-56d7-a9ae-ca01b41d85cd', 'word_count': 699, 'uri': 'nyt://article/f9ca8c1c-2867-56d7-a9ae-ca01b41d85cd'}, {'abstract': 'Popular acts like Laura Marling, Nine Inch Nails, M.I.A., Janelle Monáe and David Bowie made room for the newcomer Lorde among a list of the best albums of the year.', 'web_url': 'https://www.nytimes.com/2013/12/15/arts/music/lorde-rules-a-year-end-list.html', 'snippet': 'Popular acts like Laura Marling, Nine Inch Nails, M.I.A., Janelle Monáe and David Bowie made room for the newcomer Lorde among a list of the best albums of the year.', 'lead_paragraph': '1. Lorde “Pure Heroine” (Universal) In hip-hop, keyboard-centered processionals often accompany self-congratulatory boasts. “Pure Heroine,” the debut album by Lorde — the songwriter and singer Ella Yelich-O’Connor, from New Zealand — commandeers those wide-open spaces with her lustrous voice and angel-choir harmonies carrying serious thoughts. Lorde writes about suburban provincialism, peer pressure, insecurity, determination and — in the irresistible “Royals” — about pop-culture fantasies and class-conscious realities. She’s 17.', 'print_section': 'AR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15PARELES1/15PARELES1-articleLarge.jpg', 'height': 806, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/15/arts/15PARELES1/15PARELES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 806}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15PARELES1/15PARELES1-jumbo.jpg', 'height': 1024, 'width': 762, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15PARELES1/15PARELES1-superJumbo.jpg', 'height': 2048, 'width': 1524, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15PARELES1/15PARELES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/15/arts/15PARELES1/15PARELES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/15/arts/15PARELES1/15PARELES1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'And a Teenager Shall Lead Them', 'kicker': None, 'content_kicker': None, 'print_headline': 'And a Teenager Shall Lead Them', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lorde', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'M I A', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Marling, Laura', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Monae, Janelle', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Bowie, David', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Nine Inch Nails (Music Group)', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Tal National (Music Group)', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Vampire Weekend (Music Group)', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Mvula, Laura', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-12-13T18:39:31+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/01082bcf-e324-542e-a5ea-6cc3d1c508e6', 'word_count': 778, 'uri': 'nyt://article/01082bcf-e324-542e-a5ea-6cc3d1c508e6'}, {'abstract': 'Ben Ratliff, Jon Caramanica and Jon Pareles discuss their picks for the year’s best in pop and jazz.', 'web_url': 'https://www.nytimes.com/audio/2013/12/13/arts/music/13popcast_pod.html', 'snippet': 'Ben Ratliff, Jon Caramanica and Jon Pareles discuss their picks for the year’s best in pop and jazz.', 'lead_paragraph': 'Ben Ratliff, Jon Caramanica and Jon Pareles discuss their picks for the year’s best in pop and jazz.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Best Albums and Songs of 2013', 'kicker': None, 'content_kicker': None, 'print_