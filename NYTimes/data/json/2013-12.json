s.html', 'snippet': 'Letters and comments to the Editor.', 'lead_paragraph': ' ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Families, in Many Shapes and Sizes (5 Comments)', 'kicker': 'Comment', 'content_kicker': None, 'print_headline': 'Families, in Many Shapes and Sizes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Families and Family Life', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-12-02T22:03:10+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/168a31ab-2a65-5814-a515-72e3f53ef858', 'word_count': 231, 'uri': 'nyt://article/168a31ab-2a65-5814-a515-72e3f53ef858'}, {'abstract': 'Male roundworms shorten the life spans of females, according to a new study, and the researchers believe their findings are linked to sex.', 'web_url': 'https://www.nytimes.com/2013/12/03/science/men-can-be-such-worms-and-vice-versa.html', 'snippet': 'Male roundworms shorten the life spans of females, according to a new study, and the researchers believe their findings are linked to sex.', 'lead_paragraph': 'Studies have repeatedly shown that married people live longer. But not if you’re a roundworm: Having a man around can kill you.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Men Can Be Such Worms (and Vice Versa)', 'kicker': None, 'content_kicker': None, 'print_headline': 'In The Lab: Men Can Be Such Worms (and Vice Versa)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Quenqua, Douglas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Worms', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Stanford University', 'rank': 4, 'major': '