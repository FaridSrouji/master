': 'nyt://article/29a3af84-f619-5ba3-8068-d438a7bd0705'}, {'abstract': 'Answers for those tricky situations we all face at this time of year.', 'web_url': 'https://www.nytimes.com/2013/12/24/opinion/a-christmas-manners-quiz.html', 'snippet': 'Answers for those tricky situations we all face at this time of year.', 'lead_paragraph': 'YOU arrive for Christmas dinner. Your mother has left your father for a woman and you are meeting her for the first time. ', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/24/opinion/1224OPEWDroumieu/1224OPEWDroumieu-articleLarge.jpg', 'height': 439, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/24/opinion/1224OPEWDroumieu/1224OPEWDroumieu-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 439}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/24/opinion/1224OPEWDroumieu/1224OPEWDroumieu-jumbo.jpg', 'height': 749, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/24/opinion/1224OPEWDroumieu/1224OPEWDroumieu-superJumbo.jpg', 'height': 1498, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/24/opinion/1224OPEWDroumieu/1224OPEWDroumieu-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/24/opinion/1224OPEWDroumieu/1224OPEWDroumieu-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/24/opinion/1224OPEWDrou