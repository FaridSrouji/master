': 'nyt://article/eeccf5d6-11f1-556a-a2ff-f02baea2147a', 'word_count': 800, 'uri': 'nyt://article/eeccf5d6-11f1-556a-a2ff-f02baea2147a'}, {'abstract': 'President Hassan Sheik Mohamud nominated a Somali-Canadian as the country’s new prime minister after the previous prime minister was removed by Parliament in a no-confidence vote.', 'web_url': 'https://www.nytimes.com/2013/12/13/world/africa/somalia-from-canada-a-candidate.html', 'snippet': 'President Hassan Sheik Mohamud nominated a Somali-Canadian as the country’s new prime minister after the previous prime minister was removed by Parliament in a no-confidence vote.', 'lead_paragraph': ' President Hassan Sheik Mohamud on Thursday nominated a Somali-Canadian as the country’s new prime minister after the previous prime minister, Abdi Farah Shirdon, was removed by Parliament in a no-confidence vote. The nominee, Abdiweli Sheikh Ahmed Mohamed, has a background in economics and development work around the world. He will have to be endorsed by Parliament before taking office. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Somalia: From Canada, a Candidate', 'kicker': 'World Briefing | Africa', 'content_kicker': None, 'print_headline': 'Somalia: From Canada, a Candidate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ibrahim, Mohammed', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Somalia', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mohamud, Hassan Sheikh', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Shirdon, Abdi Farah', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ahmed Mohamed, Abdiweli Sheikh', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-13T01:05:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Mohamed Ibrahim', 'person': [{'firstname': 'Mohamed', 'middlename': None, 'lastname': 'Ibrahim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/a3729ee2-b500-5b6b-afa0-8296dc31707a', 'word_count': 59, 'uri': 'nyt://article/a3729ee2-b500-5b6b-afa0-8296dc31707a'}, {'abstract': 'Catalonia, Spain’s economic powerhouse, headed toward a standoff with Madrid on Thursday after separatist parties in the region announced a date next year for an independence referendum.', 'web_url': 'https://www.nytimes.com/2013/12/13/world/europe/spain-catalonia-calls-vote-on-split.html', 'snippet': 'Catalonia, Spain’s economic powerhouse, headed toward a standoff with Madrid on Thursday after separatist parties in the region announced a date next year for an independence referendum.', 'lead_paragraph': ' Catalonia, Spain’s economic powerhouse, headed toward a standoff with Madrid on Thursday after separatist parties in the region announced a date next year for an independence referendum. The threat to hold a vote — and potentially break apart Spain — drew an immediate rebuke from Spanish officials who called it a violation of the Constitution. Catalan officials, however, say the vote would not be a constitutionally defined binding referendum, but rather “a popular consultation.” ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spain: Catalonia Calls Vote on Split', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'Spain: Catalonia Calls Vote on Split', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Constitutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Referendums', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Catalonia (Spain)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Madrid (Spain)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-13T01:05:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Raphael Minder', 'person': [{'firstname': 'Raphael', 'middlename': None, 'lastname': 'Minder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/b21a41cb-29de-56c4-9fcc-95f5f32f1c7b', 'word_count': 74, 'uri': 'nyt://article/b21a41cb-29de-56c4-9fcc-95f5f32f1c7b'}, {'abstract': 'Public schools are adopting web-based services that collect data about students but do not adequately safeguard it from potential misuse, new research has found.', 'web_url': 'https://www.nytimes.com/2013/12/13/education/schools-use-web-tools-and-data-is-seen-at-risk.html', 'snippet': 'Public schools are adopting web-based services that collect data about students but do not adequately safeguard it from potential misuse, new research has found.', 'lead_paragraph': 'Public schools around the country are adopting web-based services that collect and analyze personal details about students without adequately safeguarding the information from potential misuse by service providers, according to new research.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/us/EDTECH/EDTECH-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/13/us/EDTECH/EDTECH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/13/us/EDTECH/EDTECH-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': '