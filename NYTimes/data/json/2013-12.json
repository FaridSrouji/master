n': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd8a9449-003c-56d2-b705-b91faadc03d5', 'word_count': 890, 'uri': 'nyt://article/bd8a9449-003c-56d2-b705-b91faadc03d5'}, {'abstract': 'It’s technically great, so it must be important, right?', 'web_url': 'https://krugman.blogs.nytimes.com/2013/12/29/an-ubernerd-weighs-in/', 'snippet': 'It’s technically great, so it must be important, right?', 'lead_paragraph': 'My old college roommate John R. Levine, who was a techie before anyone knew such creatures existed (let alone that they would rule the world), sends me a note about Bitcoin that confirms some of my own suspicions:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Ubernerd Weighs In', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-12-29T19:39:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff85eeb7-0554-5b33-bc51-00c27e15da64', 'word_count': 340, 'uri': 'nyt://article/ff85eeb7-0554-5b33-bc51-00c27e15da64'}, {'abstract': 'Mayor-elect Bill de Blasio and his family have ties to smaller museums, and Mr. de Blasio’s abrupt rise has set off anxious speculation about what kind of artistic patron he might be as mayor.', 'web_url': 'https://www.nytimes.com/2013/12/30/arts/a-new-mayor-brings-hope-for-a-populist-arts-revival.html', 'snippet': 'Mayor-elect Bill de Blasio and his family have ties to smaller museums, and Mr. de Blasio’s abrupt rise has set off anxious speculation about what kind of artistic patron he might be as mayor.', 'lead_paragraph': 'When Laurie Cumbo, the founder of the Museum of Contemporary African Diasporan Arts in Fort Greene, Brooklyn, was planning a trip to Ghana for her curators, she turned to a friend and longtime patron: Chirlane McCray.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/artsmayor/artsmayor-articleLarge.jpg', 'height': 385, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/30/arts/artsmayor/artsmayor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 385}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/artsmayor/artsmayor-jumbo.jpg', 'height': 658, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/artsmayor/artsmayor-superJumbo.jpg', 'height': 1315, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/artsmayor/artsmayor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/30/arts/artsmayor/artsmayor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/artsmayor/artsmayor-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'De Blasio Brings Hope for a Populist Arts Revival', 'kicker': None, 'content_kicker': None, 'print_headline': 'A New Mayor Brings Hope for a Populist Arts Revival', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-29T19:52:38+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Michael M. Grynbaum', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d83ac399-1efb-5305-a4dc-2f9dea032062', 'word_count': 1147, 'uri': 'nyt://article/d83ac399-1efb-5305-a4dc-2f9dea032062'}, {'abstract': 'The Twelfth Night Festival, in its third year, offers an enviable variety of repertory, from proto-opera to Baroque opera, and from Italian instrumental works to late-Romantic Russian choral music.', 'web_url': 'https://www.nytimes.com/2013/12/30/arts/music/trinity-wall-streets-twelfth-night-festival-has-begun.html', 'snippet': 'The Twelfth Night Festival, in its third year, offers an enviable variety of repertory, from proto-opera to Baroque opera, and from Italian instrumental works to late-Romantic Russian choral music.', 'lead_paragraph': 'The early-music scene in New York is decades old, yet is still growing. The network of performers and ensembles has become broader and tighter in recent years, fed by a steady influx of young artists trained in historical-performance programs at the Juilliard School, Yale University, Queens College, New York University and elsewhere.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/trinity/trinity-articleLarge.jpg', 'height': 895, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/30/arts/trinity/trinity-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 895}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/trinity/trinity-jumbo.jpg', 'height': 1024, 'width': 687, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/trinity/trinity-superJumbo.jpg', 'height': 2048, 'width': 1374, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/trinity/trinity-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/12/30/arts/trinity/trinity-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/trinity/trinity-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Wide Sampling of Early Music for the Masses', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Wide Sampling of Early Music for the Masses', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Woolfe, Zachary', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wachner, Julian', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Gotham Early Music Scene', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Gotham Chamber Opera', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-29T20:02:13+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5808a4b7-ac3b-5f57-8201-a1ba94c2d8ab', 'word_count': 459, 'uri': 'nyt://article/5808a4b7-ac3b-5f57-8201-a1ba94c2d8ab'}, {'abstract': 'Jaime Laredo conducted the New York String Orchestra in a Carnegie Hall program that included Tchaikovsky.', 'web_url': 'https://www.nytimes.com/2013/12/30/arts/music/the-new-york-string-orchestra-at-carnegie-hall.html', 'snippet': 'Jaime Laredo conducted the New York String Orchestra in a Carnegie Hall program that included Tchaikovsky.', 'lead_paragraph': 'Tchaikovsky’s Symphony No. 6, titled “Pathétique” and completed in August 1893, is a beautiful time bomb with a faulty firing pin — or so it can seem, given the response its unorthodox construction almost inevitably compels. Played at the conclusion of a concert by the New York String Orchestra at Carnegie Hall on Saturday night, the piece inspired a rousing ovation after its triumphal Allegro molto vivace movement, and another after the Adagio lamentoso, its actual ending.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/string1/string1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/12/30/arts/string1/string1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/12/30/arts/string1/string1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': '