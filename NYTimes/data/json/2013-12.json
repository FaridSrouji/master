t', 'value': 'Power Failures and Blackouts', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco 49ers', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Baltimore Ravens', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Knowles, Beyonce', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-12-31T17:29:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Justin Sablich', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Sablich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/900438b0-a952-5f20-ab59-79bc26ce3a48', 'word_count': 425, 'uri': 'nyt://article/900438b0-a952-5f20-ab59-79bc26ce3a48'}, {'abstract': 'At an interfaith breakfast, Michael R. Bloomberg was showered with praise, and in his speech, he simply thanked those in the room for the work they do.', 'web_url': 'https://www.nytimes.com/2014/01/01/nyregion/for-bloomberg-on-his-final-day-as-mayor-many-thank-yous.html', 'snippet': 'At an interfaith breakfast, Michael R. Bloomberg was showered with praise, and in his speech, he simply thanked those in the room for the work they do.', 'lead_paragraph': 'On the last day of his last term as mayor of New York, Michael R. Bloomberg put on a pinstripe gray-and-blue suit, tied a red-and-white tie, and soaked up something that is rarely proffered: the unabashed gratitude of a brusque city.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/01/nyregion/Y-BLOOMBERGsub/Y-BLOOMBERGsub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'im