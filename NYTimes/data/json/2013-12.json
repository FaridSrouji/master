schools.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Teachers Tell Us How to Fix Science and Math', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mathematics', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-09T21:55:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Firestone', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Firestone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4cd97051-ee4f-55fe-ad57-49785b265f15', 'word_count': 566, 'uri': 'nyt://article/4cd97051-ee4f-55fe-ad57-49785b265f15'}, {'abstract': 'Augustin Hadelich and Charles Owen performed in recital at the Frick Collection’s Music Room on Sunday.', 'web_url': 'https://www.nytimes.com/2013/12/10/arts/music/augustin-hadelich-and-charles-owen-at-frick-collection.html', 'snippet': 'Augustin Hadelich and Charles Owen performed in recital at the Frick Collection’s Music Room on Sunday.', 'lead_paragraph': 'The Frick Collection’s Music Room, which seats just 175, is an ideally intimate space for chamber music. This is especially so when the performers are as excellent as the brilliant young German violinist Augustin Hadelich and the fine British pianist Charles Owen, who played a memorable recital there on Sunday afternoon, a highlight of the Frick’s valued concert series, now in its 75th-anniversary season.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', '