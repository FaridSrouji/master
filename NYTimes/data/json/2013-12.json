://article/4d21f8f3-4406-5425-8c82-2c2cfe6bd59b'}, {'abstract': 'A House panel investigating the health care rollout questioned Kathleen Sebelius, the health secretary, on Wednesday as new data showed a sharp rise in signups for coverage.', 'web_url': 'https://www.nytimes.com/2013/12/12/us/politics/health-care-law.html', 'snippet': 'A House panel investigating the health care rollout questioned Kathleen Sebelius, the health secretary, on Wednesday as new data showed a sharp rise in signups for coverage.', 'lead_paragraph': 'WASHINGTON — The number of people selecting health insurance plans in the federal and state marketplaces increased last month at a brisk pace, bringing the overall figure to nearly 365,000, the Obama administration said on Wednesday. The November number was more than double the one for October, but still well below the administration’s goal.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Cites Rise in Health Plan Signups as Sebelius Testifies', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sharp Rise in Health Plan Sign-Ups Is Reported', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pear, Robert', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sebelius, Kathleen', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Health and Human Services Department', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House Committee on Energy and Commerce', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'HealthCare.gov', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-12-11T14:01:56+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Robert Pear', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Pear', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a17f664b-55b9-5272-9a23-da4fbbc6d41b', 'word_count': 910, 'uri': 'nyt://article/a17f664b-55b9-5272-9a23-da4fbbc6d41b'}, {'abstract': 'A groundbreaking new law allowing Mexicans to re-elect many officials will further entrench the dominant party.', 'web_url': 'https://latitude.blogs.nytimes.com/2013/12/11/mexicos-incumbency-trap/', 'snippet': 'A groundbreaking new law allowing Mexicans to re-elect many officials will further entrench the dominant party.', 'lead_paragraph': 'MEXICO CITY — For almost one hundred years, all official stationery from the Mexican government bore this motto: “Sufragio efectivo, no reelección” (Effective suffrage, no re-election). That was the rallying cry of the Mexican Revolution of 1910, which began in protest, among other things, of the seventh re-election of President Porfirio Díaz.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mexico’s Incumbency Trap', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Institutional Revolutionary Party (Mexico)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-12-11T14:17:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Carlos Puig', 'person': [{'firstname': 'Carlos', 'middlename': None, 'lastname': 'Puig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'N