], 'pub_date': '2013-01-24T16:40:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Christopher Hanlon', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Hanlon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/13285a5a-a70b-5820-bd9c-b625cf2feecf', 'word_count': 1328, 'uri': 'nyt://article/13285a5a-a70b-5820-bd9c-b625cf2feecf'}, {'abstract': 'National Girl Child Day celebrated in Hyderabad, Andhra Pradesh.', 'web_url': 'https://india.blogs.nytimes.com/2013/01/24/image-of-the-day-jan-24/', 'snippet': 'National Girl Child Day celebrated in Hyderabad, Andhra Pradesh.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Image of the Day: Jan. 24', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-24T16:45:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/70c8dd1e-5d71-56c0-88f9-77f3db47c885', 'word_count': 1, 'uri': 'nyt://article/70c8dd1e-5d71-56c0-88f9-77f3db47c885'}, {'abstract': 'The agency says New York State must figure out how to alleviate the turbidity caused by discharges from an upstate reservoir.', 'web_url': 'https://green.blogs.nytimes.com/2013/01/24/e-p-a-directs-n-y-to-act-on-muddy-waterway/', 'snippet': 'The agency says New York State must figure out how to alleviate the turbidity caused by discharges from an upstate reservoir.', 'lead_paragraph': ' After a public comment period, the federal Environmental Protection Agency has decided that the lower portion of the Esopus Creek in New York’s Catskills region must b