iano/19rdv-galliano-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/blogs/19rdv-galliano/19rdv-galliano-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can Armstrong Be Redeemed? How About Galliano?', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANTI-SEMITISM', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bicycles and Bicycling', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'ARMSTRONG, LANCE', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Galliano, John', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-01-19T13:54:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Harvey Morris', 'person': [{'firstname': 'Harvey', 'middlename': None, 'lastname': 'Morris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c842729e-c0d9-578c-a9e8-8ac595cd806c', 'word_count': 506, 'uri': 'nyt://article/c842729e-c0d9-578c-a9e8-8ac595cd806c'}, {'abstract': 'New DVDs from VCI Entertainment resurrect the films of the British comedians Will Hay and Norman Wisdom.', 'web_url': 'https://www.nytimes.com/2013/01/20/movies/homevideo/will-hay-and-norman-wisdom-comedies-on-dvd.html', 'snippet': 'New DVDs from VCI Entertainment resurrect the films of the British comedians Will Hay and Norman Wisdom.', 'lead_paragraph': 'WE often hear that comedy is universal — that laughter is the common language, transcending cultural barriers — but in fact it may be the most difficult genre to export. A pratfall is a pratfall, but anything more advanced requires a sense of cultural context and an instinctive understanding of local norms. Hence a film like Dany Boon’s “Bienvenue Chez les Ch’tis,” a comedy that broke box office records in France when it was released in 2008, barely made a ripple elsewhere. (Its humor focused on cultural differences between the sunny south of the Midi and the leaden-skied economic devastation of northern France.) An announced American remake with Will Smith appears to have vanished into the turnaround ether.', 'print_section': 'AR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20KEHR1_SPAN/20KEHR1_SPAN-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/20/arts/20KEHR1_SPAN/20KEHR1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20KEHR1_SPAN/20KEHR1-jumbo.jpg', 'height': 795, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20KEHR1_SPAN/20KEHR1-superJumbo.jpg', 'height': 1590, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20KEHR1_SPAN/20KEHR1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/20/arts/20KEHR1_SPAN/20KEHR1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit