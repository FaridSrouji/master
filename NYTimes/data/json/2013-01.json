ion': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/sports/15ski_ss-slide-ZSBR/15ski_ss-slide-ZSBR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/15/sports/15ski_ss-slide-ZSBR/15ski_ss-slide-ZSBR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/sports/15ski_ss-slide-ZSBR/15ski_ss-slide-ZSBR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Carving Her Path at Her Pace', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World Cup (Skiing)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Shiffrin, Mikaela', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-15T05:21:23+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Skiing', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/8f047d50-3538-51ef-bd9e-303f5ea7d71d', 'word_count': 0, 'uri': 'nyt://slideshow/8f047d50-3538-51ef-bd9e-303f5ea7d71d'}, {'abstract': 'Serena Williams rolled her ankle at the Australian Open on Tuesday early in her first match with Edina Gallovits-Hall of Romania. After a medical timeout to apply tape, Williams strode back on to the court and breezed to a 6-0, 6-0 victory in 54 minutes.', 'web_url': 'https://straightsets.blogs.nytimes.com/2013/01/15/williams-twists-ankle-but-breezes-to-win/', 'snippet': 'Serena Williams rolled her ankle at the Australian Open on Tuesday early in her first match with Edina Gallovits-Hall of Romania. After a medical timeout to apply tape, Williams strode back on to the court and breezed to a 6-0, 6-0 victory in 54 m...', 'lead_paragraph': 'MELBOURNE, Australia — A routine first-round match at the Australian Open on Tuesday suddenly turned into a bit of a scare midway through the first set when Serena Williams rolled her right ankle. Leading Edina Gallovits-Hall of Romania by 4-0, Williams was pulled into the short court by a slice backhand by Gallovits-Hall. Gallovits-Hall then swept a wide forehand to the far court. Williams stretched but lost her balance and fell to the court. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Williams Twists Ankle but Breezes to Win', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-15T05:29:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By BEN ROTHENBERG', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'ROTHENBERG', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8d8fa87f-14c8-5fbd-b40d-1bc89ff27022', 'word_count': 242, 'uri': 'nyt://article/8d8fa87f-14c8-5fbd-b40d-1bc89ff27022'}, {'abstract': 'At a Bronx plant that has been plagued by problems, a firm is said to have evaded requirements on oversight by an electrician and on hiring companies owned by women or minorities.', 'web_url': 'https://www.nytimes.com/2013/01/15/nyregion/company-defrauded-city-at-bronx-water-plant-contractor-says.html', 'snippet': 'At a Bronx plant that has been plagued by problems, a firm is said to have evaded requirements on oversight by an electrician and on hiring companies owned by women or minorities.', 'lead_paragraph': 'An electrical contractor controlled by the German engineering conglomerate Siemens AG admitted on Monday that a related company had defrauded New York City in connection with work it performed on the troubled $3.2 billion Croton water-filtration plant by evading requirements that they hire companies owned by women or minorities and have a licensed master electrician overseeing the work.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Company Defrauded City in Water Plant Work, Contractor Says', 'kicker': None, 'content_kicker': None, 'print_headline': 'Company Defrauded City in Water Plant Work, Contractor Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Infrastructure (Public Works)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Schlesinger-Siemens Electrical', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Siemens AG', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-15T05:54:46+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By William K. Rashbaum', 'person': [{'firstname': 'William', 'middlename': 'K.', 'lastname': 'Rashbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/53a1d288-977e-5cb6-80a8-cbc4be4cab1a', 'word_count': 1225, 'uri': 'nyt://article/53a1d288-977e-5cb6-80a8-cbc4be4cab1a'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/01/15/arts/television/whats-on-tuesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8:30 P.M. (Sundance) CAREER GIRLS (1997) Two former college roommates — Hannah (Katrin Cartlidge) and Annie (Lynda Steadman, above left, with Ms. Cartlidge) — once locked in constant battle try to re-establish their relationship over a weekend in this Mike Leigh drama. Joe Tucker plays Adrian, a smug real estate agent selling a flat who barely remembers the time he once lounged around their druggy lair and broke their hearts. “With his usual deep, engrossing attention to behavioral detail, Mr. Leigh uses ‘Career Girls’ to visit and fuse these contrasting chapters into a continuum of the women’s lives,” Janet Maslin wrote in The New York Times. “Over the course of their brief reunion, Hannah and Annie reveal the present while they talk about the past, and the film explodes with jittery, hand-held flashbacks to match their buried emotions.” The movie, she added, “doesn’t impose any false closure on its wistful portraits, nor does it contrive more than a few strained coincidences (like Adrian’s reappearance) to create a conventional story.” ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Tuesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-15T06:00:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/591dbb5e-c4d3-5ac1-b092-b5320d142678', 'word_count': 706, 'uri': 'nyt://article/591dbb5e-c4d3-5ac1-b092-b5320d142678'}, {'abstract': 'Dr. John C. Reed, the chief executive of the Sanford-Burnham Medical Research Institute, will become head of Roche’s pharmaceutical research and early development group in April.', 'web_url': 'https://www.nytimes.com/2013/01/15/business/roche-hires-dr-john-reed-to-lead-research-operations.html', 'snippet': 'Dr. John C. Reed, the chief executive of the Sanford-Burnham Medical Research Institute, will become head of Roche’s pharmaceutical research and early development group in April.