dit': None, 'type': 'image', 'url': 'images/2013/01/24/arts/24rdv-sugarman/24rdv-sugarman-superJumbo.jpg', 'height': 1621, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/24/arts/24rdv-sugarman/24rdv-sugarman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/24/arts/24rdv-sugarman/24rdv-sugarman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/24/arts/24rdv-sugarman/24rdv-sugarman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'France Is Sweet on ‘Sugar Man’', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-25T11:29:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Olivia Snaije', 'person': [{'firstname': 'Olivia', 'middlename': None, 'lastname': 'Snaije', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c568be97-b78c-532c-8be5-008d2487422a', 'word_count': 598, 'uri': 'nyt://article/c568be97-b78c-532c-8be5-008d2487422a'}, {'abstract': 'Beginning in 2010, the Italian oil company and a rival, Anadarko Petroleum, made a series of finds in Mozambique that add up to the largest natural gas trove of recent years.', 'web_url': 'https://www.nytimes.com/2013/01/26/business/energy-environment/eni-makes-a-push-toward-the-top.html', 'snippet': 'Beginning in 2010, the Italian oil company and a rival, Anadarko Petroleum, made a series of finds in Mozambique that add up to the largest natural gas trove of recent years.', 'lead_paragraph': 'MILAN — Tucked away in a building on the outskirts of Milan is the “nirvana room,” so called perhaps because of the good tidings it contains. There, geologists working for the Italian oil company Eni don 3-D glasses to contemplate fluorescent images of underground geological formations and try to divine which might be worth tens of millions of dollars in exploratory drilling. ', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/business/energy-environment/26eni/26eni-articleLarge.jpg', 'height': 413, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/26/business/energy-environment/26eni/26eni-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 413}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/business/energy-environment/26eni/26eni-jumbo.jpg', 'height': 706, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/business/energy-environment/26eni/26eni-superJumbo.jpg', 'height': 1411, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/business/energy-environment/26eni/26eni-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/26/business/energy-environment/26eni/26eni-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/business/energy-environment/26eni/26eni-t