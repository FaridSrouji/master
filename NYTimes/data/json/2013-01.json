rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/1f719bf2-b567-5751-87c3-fa49fd6a72a1', 'word_count': 0, 'uri': 'nyt://video/1f719bf2-b567-5751-87c3-fa49fd6a72a1'}, {'abstract': 'A meeting held in Manhattan came amid efforts to win passage of legislation this year to set up a system of public financing for state candidates.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/01/24/critics-of-states-campaign-finance-laws-seek-philanthropists-help/', 'snippet': 'A meeting held in Manhattan came amid efforts to win passage of legislation this year to set up a system of public financing for state candidates.', 'lead_paragraph': 'ALBANY – Advocates of overhauling New York’s campaign fund-raising laws met with 40 philanthropists in Manhattan on Thursday in an effort to enlist additional supporters as they ramp up their lobbying efforts.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Critics of State’s Campaign Finance Laws Seek Philanthropists’ Help', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, State Legislature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Eldridge, Sean', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Schneiderman, Eric T', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Soros, George', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Soros, Jonathan Tivadar', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-01-24T19:44:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Thomas Kaplan', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Kaplan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/201feb72-b61e-5c58-8f9f-ed47b2c6c86a', 'word_count': 481, 'uri': 'nyt://article/201feb72-b61e-5c58-8f9f-ed47b2c6c86a'}, {'abstract': 'Arizona sent Justin Upton to Atlanta, where he will join his brother B. J., in a seven-player deal that sent infielder Martin Prado to the Diamondbacks.', 'web_url': 'https://www.nytimes.com/2013/01/25/sports/baseball/trade-brings-upton-brothers-together-with-braves.html', 'snippet': 'Arizona sent Justin Upton to Atlanta, where he will join his brother B. J., in a seven-player deal that sent infielder Martin Prado to the Diamondbacks.', 'lead_paragraph': 'So many things must align just right for brothers to play on the same major league team, at the same time, at roughly the same skill level. Ask Larry Reynolds, the agent for Justin and B. J. Upton, now united in the outfield of the Atlanta Braves.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/25/sports/UPTON/UPTON-articleLarge.jpg', 'height': 432, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/25/sports/UPTON/UPTON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 432}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/25/sports/UPTON/UPTON-jumbo.jpg', 'height': 737, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/25/sports/UPTON/UPTON-superJumbo.jpg', 'height': 1475, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subt