one, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Torture', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rubin, Alissa Johannsen', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Detainees', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-01-20T22:22:15+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Alissa J. Rubin', 'person': [{'firstname': 'Alissa', 'middlename': 'J.', 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35db8365-2f27-57f5-a4ae-79a309f05cab', 'word_count': 1171, 'uri': 'nyt://article/35db8365-2f27-57f5-a4ae-79a309f05cab'}, {'abstract': 'Parsons Dance presented works by David Parsons, the company’s artistic director, and Katarzyna Skarpetowska at the Joyce Theater.', 'web_url': 'https://www.nytimes.com/2013/01/21/arts/dance/works-by-david-parsons-and-katarzyna-skarpetowska-at-joyce.html', 'snippet': 'Parsons Dance presented works by David Parsons, the company’s artistic director, and Katarzyna Skarpetowska at the Joyce Theater.', 'lead_paragraph': 'Parsons Dance returned to the Joyce Theater on Tuesday with works by the choreographer David Parsons, including his new “Dawn to Dusk,” as well as a commission by a former company member, Katarzyna Skarpetowska. Each serve watered-down versions of dances by master choreographers: Mr. Parsons, as usual, draws from Paul Taylor, with whom he danced. Ms. Skarpetowska, at least in her new “Black Flowers,” channels Martha Graham.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/21/arts/PARSONS/PARSONS-articleLarge.jpg', 'height': 371, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/21/arts/PARSONS/PARSONS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 371}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/21/arts/PARSONS/PARSONS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/21/arts/PARSONS/PARSONS-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/21/arts/PARSONS/PARSONS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/21/arts/PARSONS/PARSONS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/21/arts/PARSONS/PARSONS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Romp Through Nature With a Breath of Florida, Alligators Included', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'A Romp Through Nature With a Breath of Florida, Alligators Included', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'organizations', '