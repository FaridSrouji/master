sia/tell-all-on-the-internet-fells-chinese-official.html', 'snippet': 'Yi Junqing, China’s top guardian of Communist literature, was dismissed from his job on Thursday after an online posting said he had an extramarital affair.', 'lead_paragraph': 'BEIJING — Viewed through the lens of the Marxist tenets he so ardently promoted, Yi Junqing’s relationship with a female researcher would have probably been categorized as exploitive. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/world/19chinaimage1/19chinaimage1-jumbo.jpg', 'height': 647, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/world/19chinaimage1/19chinaimage1-superJumbo.jpg', 'height': 1294, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/world/19chinaimage1/19chinaimage1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/19/world/19chinaimage1/19chinaimage1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/world/19chinaimage1/19chinaimage1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Web Tell-All on an Affair Brings Down a Chinese Official', 'kicker': None, 'content_kicker': None, 'print_headline': 'Web Tell-All on an Affair Brings Down a Chinese Official', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jacobs, Andrew', 'rank': 1, 'major': '