DUKA_SPAN/03MADUKA_SPAN-jumbo-v2.jpg', 'height': 687, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/fashion/03MADUKA_SPAN/03MADUKA_SPAN-superJumbo-v2.jpg', 'height': 1373, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/fashion/03MADUKA_SPAN/03MADUKA_SPAN-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/03/fashion/03MADUKA_SPAN/03MADUKA_SPAN-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/fashion/03MADUKA_SPAN/03MADUKA_SPAN-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Uzoamaka Maduka Leaves a Paper Trail With the American Reader', 'kicker': None, 'content_kicker': None, 'print_headline': 'Looking To Leave A Paper Trail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': "O'Leary, Amy", 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Maduka, Uzoamaka', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'American Reader, The (Journal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Magazines', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-02T22:14:25+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': "By Amy O'Leary", 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': "O'Leary", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76cfce58-7a7e-5cf9-b167-337d70e16458', 'word_count': 1518, 'uri': 'nyt://article/76cfce58-7a7e-5cf9-b167-337d70e16458'}, {'abstract': 'Christopher Tinker, an automobile mechanic, memorialized his great-grandfather Joe Tinker, the Cubs Hall of Famer, with a tattoo when he lost his baseball card.', 'web_url': 'https://www.nytimes.com/2013/01/03/sports/baseball/tinker-to-evers-to-chassis-a-baseball-story.html', 'snippet': 'Christopher Tinker, an automobile mechanic, memorialized his great-grandfather Joe Tinker, the Cubs Hall of Famer, with a tattoo when he lost his baseball card.', 'lead_paragraph': 'BALTIMORE — Early each weekday morning, a 47-year-old man with graying hair takes a timecard and punches in at his job. He retreats to a room for a moment and emerges wearing a blue-gray uniform whose shirt bears his stitched surname: Tinker. The man seizes the tools of his trade and gets to work.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/sports/baseball/03tinker-1/03tinker-1-articleLarge-v2.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/03/sports/baseball/03tinker-1/03tinker-1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/sports/baseball/03tinker-1/03tinker-1-jumbo-v2.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/sports/baseball/03tinker-1/03tinker-1-superJumbo-v2.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/sports/baseball/03tinker-1/03tinker-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/03/sports/baseball/03tinker-1/03tinker-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/sports/baseball/03tinker-1/03tinker-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tinker to Evers to Chassis', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tinker to Evers to Chassis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tinker, Joe', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Evers, Johnny', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Cubs', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-02T22:24:09+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Hillel Kuttler', 'person': [{'firstname': 'Hillel', 'middlename': None, 'lastname': 'Kuttler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a5162633-7008-5d68-9edb-d3a697bc75d2', 'word_count': 1370, 'uri': 'nyt://article/a5162633-7008-5d68-9edb-d3a697bc75d2'}, {'abstract': 'Matthew Bourne’s reimagining of “Sleeping Beauty,” which runs through Jan. 26 at Sadler’s Wells, opens the action in 1890, the year of the ballet’s creation.', 'web_url': 'https://www.nytimes.com/2013/01/03/arts/dance/matthew-bournes-sleeping-beauty-at-sadlers-wells.html', 'snippet': 'Matthew Bourne’s reimagining of “Sleeping Beauty,” which runs through Jan. 26 at Sadler’s Wells, opens the action in 1890, the year of the ballet’s creation.', 'lead_paragraph': 'LONDON — No small amount of anticipation has attended the opening of Matthew Bourne’s new “Sleeping Beauty,” the final piece in his reworking of the famous Tchaikovsky ballets. He created “Nutcracker!” in 1992, and, in 1995, “Swan Lake” which, as even nondance fans know, boasted a corps de ballet of virile male swans and enjoyed enormous international success. Mr. Bourne’s work remains extremely popular, particularly in Britain, where his company, New Adventures, has the kinds of lengthy runs and huge audiences more associated with Broadway than ballet. “Sleeping Beauty,” for example, opened Dec. 4 and runs through Jan. 26 at Sadler’s Wells, where Mr. Bourne is an associate artist. There are good reasons for Mr. Bourne’s success. He is a masterly storyteller. He is brilliant at finding a kernel of emotional truth in, and a fresh approach to, familiar dance narratives that make them resonate in new ways. And he has a collaborator of genius: Lez Brotherston, whose designs are both visually exciting and a vital part of the storytelling aspect of the productions.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/arts/BOURNE/BOURNE-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/03/arts/BOURNE/BOURNE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/arts/BOURNE/BOURNE-jumbo.jpg', 'height': 667, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/arts/BOURNE/BOURNE-superJumbo.jpg', 'height': 1335, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/arts/BOURNE/BOURNE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/03/arts/BOURNE/BOURNE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/arts/BOURNE/BOURNE-thumbLarge.jpg', 'height': 149, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fangs, Zombies and Other Stuff Tchaikovsky Never Dreamed Of', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Fangs, Zombies and Other Stuff Tchaikovsky Never Dreamed Of', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bourne, Matthew', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sulcas, Roslyn', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Sleeping Beauty (Ballet)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Sadler's Wells", 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-01-02T22:26:30+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2dbdc6f8-1fd9-51a4-927d-ab8bc00a8c6a', 'word_count': 1056, 'uri': 'nyt://article/2dbdc6f8-1fd9-51a4-927d-ab8bc00a8c6a'}, {'abstract': 'Lawrence Wright’s book “Going Clear: Scientology, Hollywood, and the Prison of Belief” explains that more people appear willing to discuss Scientology’s image problems.', 'web_url': 'https://www.nytimes.com/2013/01/03/books/scientology-fascinates-the-author-lawrence-wright.html', 'snippet': 'Lawrence Wright’s book “Going Clear: Scientology, Hollywood, and the Prison of Belief” explains that more people appear willing to discuss Scientology’s image problems.', 'lead_paragraph': 'AUSTIN, Tex. — The writer Lawrence Wright doesn’t seem at all the sort of person you’d find in public wearing a black cowboy shirt emblazoned with big white buffalos. He’s shy, soft-spoken, a little professorial. But as if he didn’t have enough to do, besides working on three plays simultaneously and getting ready to publish a new book in two weeks, Mr. Wright has been taking piano lessons with Floyd Domino, the two-time Grammy winner, and on a recent Saturday, in his buffalo shirt, he played in a concert at the Victory Grill here with the band WhoDo. Mr. Wright was at the keyboard, and sang solo on “Sixty-Minute Man” and the Count Basie tune “She’s Funny That Way.” Not bad for a bookworm.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/arts/03SCIENTOLOGY-front/03SCIENTOLOGY-front-articleLarge.jpg', 'height': 762, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/03/arts/03SCIENTOLOGY-front/03SCIENTOLOGY-front-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 762}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/03/arts/03SCIENTOLOGY-front/03SCIENTOLOGY-front-jumbo-v2.jpg', 'height': 1024, 'width': 807, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 