fier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67811841-173a-5e2b-8cbc-603cd54fbc60', 'word_count': 1286, 'uri': 'nyt://article/67811841-173a-5e2b-8cbc-603cd54fbc60'}, {'abstract': 'The fear that technology might threaten our survival is is often dismissed as outlandish. But it is cause for concern.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/01/27/cambridge-cabs-and-copenhagen-my-route-to-existential-risk/', 'snippet': 'The fear that technology might threaten our survival is is often dismissed as outlandish. But it is cause for concern.', 'lead_paragraph': 'In Copenhagen the summer before last, I shared a taxi with a man who thought his chance of dying in an artificial intelligence-related accident was as high as that of heart disease or cancer. No surprise if he’d been the driver, perhaps (never tell a taxi driver that you’re a philosopher!), but this was a man who has spent his career with computers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cambridge, Cabs and Copenhagen: My Route to Existential Risk', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Artificial Intelligence', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Biotechnology', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-27T22:00:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Huw Price', 'person': [{'firstname': 'Huw', 'middlename': None, 'lastname': 'Price', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'o