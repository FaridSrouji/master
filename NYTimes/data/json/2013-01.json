ns', 'value': 'Senate', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-01-02T18:09:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Brooks and Gail Collins', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Gail', 'middlename': None, 'lastname': 'Collins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aeae9875-41c4-5204-b79c-eabd6b18049e', 'word_count': 1283, 'uri': 'nyt://article/aeae9875-41c4-5204-b79c-eabd6b18049e'}, {'abstract': 'A parent’s lost car inspires a test run through a batch of find-your-car apps. Some include the ability to snap a photo and take notes, or keep track of how much time is on the parking meter.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2013/01/02/can-your-phone-find-your-car/', 'snippet': 'A parent’s lost car inspires a test run through a batch of find-your-car apps. Some include the ability to snap a photo and take notes, or keep track of how much time is on the parking meter.', 'lead_paragraph': 'Two years ago, my parents celebrated their 40th anniversary. Toasts were given, tears were shed and when the last of the dishes were put away, my mom surprised everyone with a slide show of never-before-seen photos of my parents skiing around the Western United States — she five months pregnant with my eldest brother — celebrating the last of their days sans children.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/01/technology/01gw-carapps/01gw-carapps-jumbo-v2.jpg', 'height': 425, 'width': 270, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', '