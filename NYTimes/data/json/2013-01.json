: 'By Paul Greenberg', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Greenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4992469f-9060-56d6-ba87-5a2d0361a188', 'word_count': 1214, 'uri': 'nyt://article/4992469f-9060-56d6-ba87-5a2d0361a188'}, {'abstract': 'New poetry collections by Michael Robbins, Rowan Ricardo Phillips, Paula Bohince and Natalie Diaz.', 'web_url': 'https://www.nytimes.com/2013/01/27/books/review/alien-vs-predator-by-michael-robbins-and-more.html', 'snippet': 'New poetry collections by Michael Robbins, Rowan Ricardo Phillips, Paula Bohince and Natalie Diaz.', 'lead_paragraph': ' ALIEN VS. PREDATOR  By Michael Robbins.  Penguin Poets, paper, $18.  ', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/books/review/27MCHENRY/27MCHENRY-articleLarge.jpg', 'height': 754, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/27/books/review/27MCHENRY/27MCHENRY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 754}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/books/review/27MCHENRY/27MCHENRY-jumbo.jpg', 'height': 1024, 'width': 816, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/books/review/27MCHENRY/27MCHENRY-superJumbo.jpg', 'height': 2048, 'width': 1631, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/books/review/27MCHENRY/27MCHENRY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', '