k': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kerry, John', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lynch, Stephen F (1955- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Markey, Edward J', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-01-31T22:26:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Katharine Q. Seelye', 'person': [{'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b4a9bb8-5dfd-5922-ad30-d70802432283', 'word_count': 714, 'uri': 'nyt://article/1b4a9bb8-5dfd-5922-ad30-d70802432283'}, {'abstract': 'In the documentary “The Last Gladiators,” Alex Gibney Shows the tough-guy caste in hockey.', 'web_url': 'https://www.nytimes.com/2013/02/01/movies/alex-gibneys-last-gladiators-looks-at-hockeys-tough-guys.html', 'snippet': 'In the documentary “The Last Gladiators,” Alex Gibney Shows the tough-guy caste in hockey.', 'lead_paragraph': 'At one point in the 1967 spy spoof “The President’s Analyst,” the psychiatrist portrayed by James Coburn marvels at the psychological benefits of being a secret agent: “You can vent your aggressive feelings by actually killing people!” Hockey players can’t go quite that far, but they can whack, body-block and generally pummel their opponents in the melees that arise in the course of games. ', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/01/arts/LAST/LAST-articleLarge-v2.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLa