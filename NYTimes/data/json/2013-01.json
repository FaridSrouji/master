nk': 11, 'major': 'N'}], 'pub_date': '2013-01-04T17:45:44+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Nicolas Rapold', 'person': [{'firstname': 'Nicolas', 'middlename': None, 'lastname': 'Rapold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d535b8c-8171-5dbf-9613-d32667d3a838', 'word_count': 1332, 'uri': 'nyt://article/9d535b8c-8171-5dbf-9613-d32667d3a838'}, {'abstract': 'A huge collection of Buster Keaton silents (including the previously unrestored “College”) hits Blu-ray, as well as the original “Jazz Singer” and a second “Vitaphone Varieties.”', 'web_url': 'https://www.nytimes.com/2013/01/06/movies/homevideo/new-dvds-buster-keaton-collection-the-jazz-singer.html', 'snippet': 'A huge collection of Buster Keaton silents (including the previously unrestored “College”) hits Blu-ray, as well as the original “Jazz Singer” and a second “Vitaphone Varieties.”', 'lead_paragraph': 'ARRIVING a tad too late for holiday giving, Kino’s spectacular 14-disc “Buster Keaton Collection” nevertheless demands attention as an infinitely rewarding anthology of the major works of a major artist. Here is Keaton’s richest creative period, essentially intact: all 19 of the shorts he made as a star between 1920 and 1923, and all 11 of the silent features he made as an independent (including, for the first time on Blu-ray, the 1927 “College”).', 'print_section': 'AR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/arts/06KEHR1_SPAN/06KEHR1_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/06/arts/06KEHR1_SPAN/06KEHR1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank