7d-53c2-8924-4d367b41b94a', 'word_count': 542, 'uri': 'nyt://article/4046548b-fb7d-53c2-8924-4d367b41b94a'}, {'abstract': 'Rotgut, a speakeasy opened by Duke Riley, a tattooist and installation artist by profession, closed this weekend, but not before a visit from the police.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/01/28/before-word-got-out-the-partys-over-at-a-brooklyn-speakeasy/', 'snippet': 'Rotgut, a speakeasy opened by Duke Riley, a tattooist and installation artist by profession, closed this weekend, but not before a visit from the police.', 'lead_paragraph': 'The room at the corner of Greenpoint Avenue and Franklin Street in Brooklyn fell silent on Saturday night as several loud bangs were heard at the door. A latecomer to the party unfolding inside, Stephanie Han-yu, was on the phone and reported that three squad cars were on the street. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/28cityroom-speakeasy/28cityroom-speakeasy-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/29/nyregion/28cityroom-speakeasy/28cityroom-speakeasy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/28cityroom-speakeasy/28cityroom-speakeasy-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/28cityroom-speakeasy/28cityroom-speakeasy-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'u