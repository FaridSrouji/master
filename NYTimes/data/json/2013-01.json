son': [{'firstname': 'Mary', 'middlename': None, 'lastname': 'Pilon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/735a14b7-ec58-5419-b932-43041adc405b', 'word_count': 806, 'uri': 'nyt://article/735a14b7-ec58-5419-b932-43041adc405b'}, {'abstract': 'Dr. Bryan Kelly of the Hospital for Special Surgery in Manhattan will perform the procedure and said he expected the Yankees third baseman to return after the All-Star break.', 'web_url': 'https://bats.blogs.nytimes.com/2013/01/08/rodriguez-to-have-hip-surgery-on-jan-16/', 'snippet': 'Dr. Bryan Kelly of the Hospital for Special Surgery in Manhattan will perform the procedure and said he expected the Yankees third baseman to return after the All-Star break.', 'lead_paragraph': 'Alex Rodriguez will have surgery on his injured left hip Jan. 16, and Dr. Bryan Kelly, who will perform the procedure, said he expected Rodriguez to return to full function after the All-Star break.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rodriguez to Have Hip Surgery on Jan. 16', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Alex', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-09T01:26:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e41bfe0-5da3-5452-a8af-90606f0e2250', 'word_count': 304, 'uri': 'nyt:/