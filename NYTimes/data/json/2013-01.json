k': '', 'section_name': 'Health', 'byline': {'original': 'By Laura Geggel', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Geggel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/33d702e8-a069-5653-be62-006238d40170', 'word_count': 719, 'uri': 'nyt://article/33d702e8-a069-5653-be62-006238d40170'}, {'abstract': 'A recent advisory reducing the dosage of sleeping aids for women highlights how men and women often respond differently to various medicines.', 'web_url': 'https://well.blogs.nytimes.com/2013/01/28/the-drug-dose-gender-gap/', 'snippet': 'A recent advisory reducing the dosage of sleeping aids for women highlights how men and women often respond differently to various medicines.', 'lead_paragraph': 'Most sleeping pills are designed to knock you out for eight hours. When the Food and Drug Administration was evaluating a new short-acting pill for people to take when they wake up in the middle of the night, agency scientists wanted to know how much of the drug would still be in users’ systems come morning.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/29CONSclr/29CONSclr-articleLarge.jpg', 'height': 500, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/29/science/29CONSclr/29CONSclr-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 500}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/29CONSclr/29CONSclr-jumbo.jpg', 'height': 854, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/29CONSclr/29CONSclr-superJumbo.j