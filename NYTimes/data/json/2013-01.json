e': 'image', 'url': 'images/2013/01/26/world/africa/26safrica/26safrica-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/26/world/africa/26safrica/26safrica-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/world/africa/26safrica/26safrica-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '15,000 Crocodiles Escape From South African Farm', 'kicker': None, 'content_kicker': None, 'print_headline': '15,000 Crocodiles Escape From South African Farm', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'South Africa', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Crocodiles', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Botswana', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Floods', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-25T17:22:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Dave Mayers', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Mayers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1c1e015-6633-5571-b9cb-e9efa89c0bbd', 'word_count': 342, 'uri': 'nyt://article/f1c1e015-6633-5571-b9cb-e9efa89c0bbd'}, {'abstract': 'Hoda Kotb and her “Today” show drinking partner, Kathie Lee Gifford, made things hard on themselves when they swore off wine just before the release of Kotb’s best-selling new book, “Ten Years Later.”', 'web_url': 'https://www.nytimes.com/2013/02/03/books/review/inside-the-list.html', 'snippet': 'Hoda Kotb and her “Today” show drinking partner, Kathie Lee Gifford, made things hard on themselves when they swore off wine just before the release of Kotb’s best-selling new book, “Ten Years Later.”', 'lead_paragraph': 'THE PLEDGE: Regular viewers of the “Today” show on NBC know Hoda Kotb as Kathie Lee Gifford’s chipper co-host and frequent drinking partner during the show’s fourth hour, when glasses of wine are such a staple that “Saturday Night Live” has taken note. So when Kotb and Gifford swore off alcohol for all of January, it was an eventful pledge — and an ill-conceived one, as it turned out, since it coincided with the publication of Kotb’s new book and the parties to celebrate its release. According to The New York Post, Gifford was spotted drinking chardonnay at a luncheon she organized for Kotb, just nine days after the announcement on the air of their alcohol sabbatical. “You caught me,” Gifford said through a representative. “You can’t celebrate a book launch without it.”', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/books/review/03LIST/03LIST-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/02/03/books/review/03LIST/03LIST-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/books/review/03LIST/03LIST-jumbo.jpg', 'height': 812, 'width': 812, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/books/review/03LIST/03LIST-superJumbo.jpg', 'height': 812, 'width': 812, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/books/review/03LIST/03LIST-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/02/03/books/review/03LIST/03LIST-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/books/review/03LIST/03LIST-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'TBR: Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-25T17:24:57+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e1f86a22-ac3a-5b57-9914-e6bf69a2d5a1', 'word_count': 595, 'uri': 'nyt://article/e1f86a22-ac3a-5b57-9914-e6bf69a2d5a1'}, {'abstract': 'If the financial crisis made anything clear, the author contends, it’s that banks should be forced to defend their business models and corporate governance — regularly.', 'web_url': 'https://dealbook.nytimes.com/2013/01/25/on-wall-street-putting-shareholders-second/', 'snippet': 'If the financial crisis made anything clear, the author contends, it’s that banks should be forced to defend their business models and corporate governance — regularly.', 'lead_paragraph': 'Wall Street has found a new way to put shareholders second. Many banks are finally bowing to pressure to restrain compensation, but Goldman Sachs and JPMorgan Chase are now trying to