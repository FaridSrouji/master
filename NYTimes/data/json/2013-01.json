': None, 'content_kicker': None, 'print_headline': 'Gun Enthusiast With Popular Online Videos Is Shot to Death in Georgia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ratliff, Keith', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Robbie', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-01-11T01:35:04+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Robbie Brown', 'person': [{'firstname': 'Robbie', 'middlename': None, 'lastname': 'Brown', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ffc7e05f-88fb-5418-91c0-d67cb7e50a19', 'word_count': 546, 'uri': 'nyt://article/ffc7e05f-88fb-5418-91c0-d67cb7e50a19'}, {'abstract': 'Detective Chief Inspector April Casburn became the first person to be convicted of a criminal offense in the phone hacking scandal that has enveloped Rupert Murdoch’s newspaper empire in Britain.', 'web_url': 'https://www.nytimes.com/2013/01/11/world/europe/scotland-yard-officer-guilty-in-phone-hacking-trial.html', 'snippet': 'Detective Chief Inspector April Casburn became the first person to be convicted of a criminal offense in the phone hacking scandal that has enveloped Rupert Murdoch’s newspaper empire in Britain.', 'lead_paragraph': 'LONDON — With a jury’s unanimous guilty vote on Thursday, one of the most senior female officers at Scotland Yard became the first person to be convicted of a criminal offense in the phone hacking scandal that has en