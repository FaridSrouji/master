 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-15T06:30:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Anastasia Economides', 'person': [{'firstname': 'Anastasia', 'middlename': None, 'lastname': 'Economides', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/500ce5e9-d0c4-5aa9-9a04-b20f675804ed', 'word_count': 22, 'uri': 'nyt://article/500ce5e9-d0c4-5aa9-9a04-b20f675804ed'}, {'abstract': 'A court case filed by Precision Cars India, an auto importer, has led to warrants for nine Porsche executives and calls by the Indian government for help from Interpol.', 'web_url': 'https://india.blogs.nytimes.com/2013/01/15/indian-court-issues-warrant-for-porsche-ceos-arrest/', 'snippet': 'A court case filed by Precision Cars India, an auto importer, has led to warrants for nine Porsche executives and calls by the Indian government for help from Interpol.', 'lead_paragraph': 'An Indian court has issued an arrest warrant for Matthias Müller, chief executive and chairman of Porsche, the German carmaker, and eight other executives from the company.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Indian Court Issues Warrant for Porsche C.E.O.’s Arrest', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': 'India Seeks To Arrest Chief Of Porsche', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Porsche AG', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Volkswagen AG', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-15T06:56:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Neha Thirani', 'person': [{'firstname': 'Neha', 'middlename': None, 'lastname': 'Thirani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9540b88-c500-5e31-92a5-448bde1056bf', 'word_count': 288, 'uri': 'nyt://article/e9540b88-c500-5e31-92a5-448bde1056bf'}, {'abstract': 'As military tensions rise in Asia over China’s territorial disputes with neighbors, how does its military view the world? An American scholar digs deep after a recent forum in Beijing.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2013/01/15/talking-trust-with-chinas-army/', 'snippet': 'As military tensions rise in Asia over China’s territorial disputes with neighbors, how does its military view the world? An American scholar digs deep after a recent forum in Beijing.', 'lead_paragraph': 'BEIJING — China will soon publish a new country map that expands its claims to disputed territories. Japan has announced its  first increase in defense spending in 11 years in a move widely perceived as countering China. Recently, fighter planes and other aircraft have been used by both countries as tensions grow over a group of islands in the East China Sea that both claim, called the Diaoyu in Chinese and Senkaku in Japanese.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/world/asia/15ArmyTrustRdv/15ArmyTrustRdv-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/world/asia/15ArmyTrustRdv/15ArmyTrustRdv-superJumbo.jpg', 'height': 1379, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/world/asia/15ArmyTrustRdv/15ArmyTrustRdv-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/15/world/asia/15ArmyTrustRdv/15ArmyTrustRdv-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/world/asia/15ArmyTrustRdv/15ArmyTrustRdv-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Talking Trust With China’s Army', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': "Chinese People's Liberation Army", 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Hudson Institute', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'East China Sea', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Far East, South and Southeast Asia and Pacific Areas', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Senkaku Islands', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-01-15T07:21:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Didi Kirsten Tatlow', 'person': [{'firstname': 'Didi', 'middlename': 'Kirsten', 'lastname': 'Tatlow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/06eda076-8b68-5474-b1f4-166a41419a80', 'word_count': 893, 'uri': 'nyt://article/06eda076-8b68-5474-b1f4-166a41419a80'}, {'abstract': 'Islamists gain ground in Mali; Chinese censors in Los Angeles; another Washington showdown looms; men’s wear in Milan.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2013/01/15/iht-quick-read-jan-15/', 'snippet': 'Islamists gain ground in Mali; Chinese censors in Los Angeles; another Washington showdown looms; men’s wear in Milan.', 'lead_paragraph': 'NEWS Despite intensive airstrikes by French warplanes, Islamist fighters overran a strategic village and military post in central Mali on Monday, indicating that the war against extremists who have carved out a jihadist state in the nation’s north could be a long and difficult one. Steven Erlanger, Alan Cowell and Adam Nossiter report. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/blogs/mali-rdv/mali-rdv-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/blogs/mali-rdv/mali-rdv-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/blogs/mali-rdv/mali-rdv-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/15/blogs/mali-rdv/mali-rdv-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/blogs/mali-rdv/mali-rdv-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'IHT Quick Read: Jan. 15', 'kicker': 'I