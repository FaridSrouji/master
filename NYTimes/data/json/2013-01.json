Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/sunday-review/06BAKER/06BAKER-articleLarge.jpg', 'height': 897, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/06/sunday-review/06BAKER/06BAKER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 897}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/sunday-review/06BAKER/06BAKER-jumbo-v2.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/sunday-review/06BAKER/06BAKER-superJumbo-v2.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/sunday-review/06BAKER/06BAKER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/06/sunday-review/06BAKER/06BAKER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/sunday-review/06BAKER/06BAKER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can Social Media Sell Soap?', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'Can Social Media Sell Soap?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Online Advertising', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baker, Stephen', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-05T18:49:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Stephen Baker', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Baker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/08b953e2-21e0-54e8-a836-b4955c0c180c', 'word_count': 1333, 'uri': 'nyt://article/08b953e2-21e0-54e8-a836-b4955c0c180c'}, {'abstract': 'G. J. Hart, the chief executive of California Pizza Kitchen, says good leaders need several qualities, all surrounded by the courage to be different.', 'web_url': 'https://www.nytimes.com/2013/01/06/business/california-pizza-kitchens-chief-on-6-steps-to-leadership.html', 'snippet': 'G. J. Hart, the chief executive of California Pizza Kitchen, says good leaders need several qualities, all surrounded by the courage to be different.', 'lead_paragraph': 'This interview with  G.J. Hart,  executive chairman, C.E.O. and president of California Pizza Kitchen, was conducted and condensed by  Adam Bryant.', 'print_section': 'BU', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/business/06CORNER/06CORNER-articleLarge.jpg', 'height': 916, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/06/business/06CORNER/06CORNER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 916}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/business/06CORNER/06CORNER-jumbo.jpg', 'height': 1024, 'width': 671, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image',