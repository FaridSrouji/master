able2/08huxtable2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/arts/08huxtable2/08huxtable2-jumbo-v2.jpg', 'height': 649, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/arts/08huxtable2/08huxtable2-superJumbo-v2.jpg', 'height': 1297, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/arts/08huxtable2/08huxtable2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/08/arts/08huxtable2/08huxtable2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/arts/08huxtable2/08huxtable2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ada Louise Huxtable, Champion of Livable Architecture, Dies at 91', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ada Louise Huxtable, Champion of Livable Architecture, Dies at 91', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Huxtable, Ada Louise', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-08T00:34:15+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By David W. Dunlap