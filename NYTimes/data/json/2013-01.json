source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-18T14:53:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/71a41c90-1393-59e9-9a5d-b72b750133f2', 'word_count': 380, 'uri': 'nyt://article/71a41c90-1393-59e9-9a5d-b72b750133f2'}, {'abstract': 'Understanding the Republican divide.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/01/18/extortionists-versus-con-men/', 'snippet': 'Understanding the Republican divide.', 'lead_paragraph': 'It’s looking increasingly as if House Republicans won’t crash the world economy by refusing to raise the debt ceiling, at least not right now. Score a big one for the White House (provisionally); its bet that it wouldn’t need a way to bypass the ceiling is looking like a winner (although it ain’t over until the tanned guy cries).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Extortionists Versus Con Men', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-18T14:59:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3664ffa1-2c3b-5994-83c7-b19262b4855a', 'word_count': 387, 'uri': 'nyt://article/3664ffa1-2c3b-5994-83c7-b19262b4855a'}, {'abstract': 'Netflix is investing hundreds of millions in original programming, including “House of Cards,” an adaptation of a 1990 BBC mini-series set in Parliament.', 'web_url': 'https://www.nytimes.com/2013/01/20/arts/television/house-of-cards-arrives-as-a-netflix-series.html', 'snippet': 'Netflix is investing hundreds of millions in original programming, including “House of Cards,” an adaptation of a 1990 BBC mini-series set in Parliament.', 'lead_paragraph': 'EARLY in the new Netflix series “House of Cards” the narrator and card player Representative Francis Underwood, played by Kevin Spacey, looks straight into the camera and tells viewers: “Power is a lot like real estate. It’s all about location, location, location. The closer you are to the source, the higher your property value.” ', 'print_section': 'AR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20HOUSE2_SPAN/20HOUSE2_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/20/arts/20HOUSE2_SPAN/20HOUSE2_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20HOUSE2_SPAN/20HOUSE2_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20HOUSE2_SPAN/20HOUSE2_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/arts/20HOUSE2_SPAN/20HOUSE2_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/20/arts/20HOUSE2_SPAN/20HOUSE2_SPAN-thumbStan