t_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Credit Scores', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mortgages', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Experian Group Ltd', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-16T17:28:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1cab9e7-ec34-5c5f-9087-25293681d345', 'word_count': 770, 'uri': 'nyt://article/c1cab9e7-ec34-5c5f-9087-25293681d345'}, {'abstract': 'Eleven have been taken in southern Florida in a monthlong competition aimed at halting the Burmese python’s advance.', 'web_url': 'https://green.blogs.nytimes.com/2013/01/16/on-our-radar-the-python-hunting-contest/', 'snippet': 'Eleven have been taken in southern Florida in a monthlong competition aimed at halting the Burmese python’s advance.', 'lead_paragraph': 'Eleven Burmese pythons have been captured in Florida since a hunting contest for the snakes, an invasive species, began in southern Florida on Saturday. [The Miami Herald]', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Our Radar: The Python Hunting Contest', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-16T17:29:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/e729d71f-c77d-534d-ba42-fa9bd564d6c5', 'word_count': 140, 'uri': 'nyt://article/e729d71f-c77d-534d-ba42-fa9bd564d6c5'}, {'abstract': 'How an East Coast geological feature drove the course of the Civil War.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/01/16/the-fall-lines-fault/', 'snippet': 'How an East Coast geological feature drove the course of the Civil War.', 'lead_paragraph': 'The warehouses that once serviced the wharves of Richmond, Va., now house restaurants and stores, including the venerable independent Fountain Bookstore. A heron rookery bustles in the riverside treetops, the nestlings nourished by the fish that crowd the turbulent, oxygen-rich shallows below. The rapids offer the best urban kayaking in the United States.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Fall Line’s Fault', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Geology', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rivers', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Fredericksburg (Va)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Richmond (Va)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-16T17:30:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jean Huets', 'person': [{'firstname': 'Jean', 'middlename': None, 'lastname': 'Huets', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd896ac7-92ab-5de0-9e4c-19934231b07e', 'word_count': 1357, 'uri': 'nyt://article/cd896ac7-92ab-5de0-9e4c-19934231b07e'}, {'abstract': '“Henry and the Cannons,” written and illustrated by Don Brown, tells the true story of a Boston bookstore owner who got involved in the American Revolutionary War.', 'web_url': 'https://www.nytimes.com/2013/01/16/books/henry-and-the-cannons-by-don-brown.html', 'snippet': '“Henry and the Cannons,” written and illustrated by Don Brown, tells the true story of a Boston bookstore owner who got involved in the American Revolutionary War.', 'lead_paragraph': 'Today’s booksellers, surrounded by tablets and e-book readers of varying gigabytes and styles, are by all appearances in the throes of a daunting battle. But in 1775, Henry Knox, a bookseller in colonial America, got tangled in a war of a more traditional stripe.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/16/books/16childrens-1/16childrens-1-articleLarge.jpg', 'height': 232, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/16/books/16childrens-1/16childrens-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 232}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/16/books/16childrens-1/16childrens-1-jumbo.jpg', 'height': 386, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/16/books/16childrens-1/16childrens-1-superJumbo.jpg', 'height': 386, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/16/books/16childrens-1/16childrens-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/16/books/16childrens-1/16childrens-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/16/books/16childrens-1/16childrens-1-thumbLarge.jpg', 'height': 14