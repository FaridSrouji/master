le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ab231216-5224-557c-8428-4898fe31693e', 'word_count': 1223, 'uri': 'nyt://article/ab231216-5224-557c-8428-4898fe31693e'}, {'abstract': 'Sellers in a hurry to close deals before new tax laws kicked in drove up sales by as much as 40 percent, though inventory continued to fall, leading many to predict higher prices in 2013.', 'web_url': 'https://www.nytimes.com/2013/01/03/nyregion/late-rush-in-manhattan-home-sales-brings-2012-to-a-robust-close.html', 'snippet': 'Sellers in a hurry to close deals before new tax laws kicked in drove up sales by as much as 40 percent, though inventory continued to fall, leading many to predict higher prices in 2013.', 'lead_paragraph': 'The Manhattan real estate market went out with a bang in 2012, with the number of sales rising by as much as 40 percent in the last three months of the year — mainly because sellers were in a hurry to close deals before new tax laws kicked in with the new year. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Manhattan’s Housing Market Ends 2012 With a Sales Rush', 'kicker': None, 'content_kicker': None, 'print_headline': 'Manhattan’s Housing Market Ends 2012 With a Sales Rush', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-03T05:01:17+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michelle Higgins', 'person': [{'firstname': 'Michelle', 'middlename': None, 'lastname': 'Higgins', 'q