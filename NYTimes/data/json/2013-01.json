inter-regional-in-manhattan.html', 'snippet': 'Peter Clark and Jess Jurkovic of New York City tied for the Greater New York Bridge Association Flight B Player of the Year award.', 'lead_paragraph': 'Peter Clark and Jess Jurkovic of New York City tied for the Greater New York Bridge Association Flight B Player of the Year award.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/arts/card/card-jumbo-v2.jpg', 'height': 367, 'width': 190, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/arts/card/card-superJumbo-v2.jpg', 'height': 367, 'width': 190, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/arts/card/card-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/09/arts/card/card-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/arts/card/card-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Edgar Kaplan Winter Regional in Manhattan', 'kicker': 'Bridge', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cards and Card Games', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bridge (Card Game)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-09T22:57:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Crosswords & Games', 'subsection_name': 'Bridge', 'byline': {'ori