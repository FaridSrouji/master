summer-web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/theater/17midsummer-web/17midsummer-web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/theater/17midsummer-web/17midsummer-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/17/theater/17midsummer-web/17midsummer-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/theater/17midsummer-web/17midsummer-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Scots Cut Loose, They Go All the Way', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'When These Scots Cut Loose,\r\nThere’s Sex, Thievery and Singing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Greig, David', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Traverse Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-16T20:40:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/052f0a72-8325-5268-8d22-5622e70435a0', 'word_count': 619, 'uri': 'nyt://article/052f0a72-8325-5268-8d22-5622e70435a0'}, {'abstract': 'A naturally reserved woman who dislikes public speaking, she has taken more opportunities to defend her film and its portrayal of torture as a tactic used by the C.I.A. in its manhunt.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2013/01/16/kathryn-bigelow-steps-up-defense-of-zero-dark-thirty/', 'snippet': 'A naturally reserved woman who dislikes public speaking, she has taken more opportunities to defend her film and its portrayal of torture as a tactic used by the C.I.A. in its manhunt.', 'lead_paragraph': 'As the political and film industry tensions around “Zero Dark Thirty” rise, Kathryn Bigelow, a naturally reserved woman who dislikes public speaking, has taken more opportunities to defend her film, about the hunt for Osama bin Laden, and its portrayal of torture as a tactic used by the C.I.A. in its manhunt.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kathryn Bigelow Steps Up Defense of “Zero Dark Thirty”', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Torture', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bigelow, Kathryn', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Boal, Mark', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-16T20:42:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad17d730-35d2-524e-aa15-0d4ff87bc211', 'word_count': 348, 'uri': 'nyt://article/ad17d730-35d2-524e-aa15-0d4ff87bc211'}, {'abstract': 'New comic novels by Dave Barry and Tim Dorsey feature hapless tourists and overlapping humor.', 'web_url': 'https://www.nytimes.com/2013/01/17/books/new-comic-novels-from-dave-barry-and-tim-dorsey.html', 'snippet': 'New comic novels by Dave Barry and Tim Dorsey feature hapless tourists and overlapping humor.', 'lead_paragraph': 'Dave Barry has written a comic novel that features lost luggage, beaches, hapless tourists from Michigan, exotic animal life, drugs, wild mix-ups, laughable oldsters and the trademarked zaniness of Florida. Not at all coincidentally Tim Dorsey’s new comic novel features these same ingredients, although Mr. Dorsey’s hapless tourists come from Wisconsin.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/books/17barry/17barry-jumbo.jpg', 'height': 1024, 'width': 789, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/books/17barry/17barry-superJumbo.jpg', 'height': 2048, 'width': 1578, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/books/17barry/17barry-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/17/books/17barry/17barry-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/books/17barry/17barry-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pot Goes to Florida, and Vice Versa', 'kicker': 'Books of The Times', 'content_kicker': None, 'p