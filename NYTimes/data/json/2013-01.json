.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/blogs/27rdv-clinton-doctrine/27rdv-clinton-doctrine-articleLarge.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/27/blogs/27rdv-clinton-doctrine/27rdv-clinton-doctrine-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/blogs/27rdv-clinton-doctrine/27rdv-clinton-doctrine-jumbo.jpg', 'height': 661, 'width': 957, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/blogs/27rdv-clinton-doctrine/27rdv-clinton-doctrine-superJumbo.jpg', 'height': 661, 'width': 957, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/blogs/27rdv-clinton-doctrine/27rdv-clinton-doctrine-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/27/blogs/27rdv-clinton-doctrine/27rdv-clinton-doctrine-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/blogs/27rdv-clinton-doctrine/27rdv-clinton-doctrine-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Clinton Doctrine of American Foreign Policy', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States International Relations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-27T10:00:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By David Rohde', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Rohde', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65b5557e-faab-5248-9579-61004f9b2714', 'word_count': 1055, 'uri': 'nyt://article/65b5557e-faab-5248-9579-61004f9b2714'}, {'abstract': 'Myanmar, the host of the 2013 Southeast Asian Games, is being criticized for stacking the competition with obscure sports so that its athletes have a good chance of winning.', 'web_url': 'https://www.nytimes.com/2013/01/28/sports/28iht-games28.html', 'snippet': 'Myanmar, the host of the 2013 Southeast Asian Games, is being criticized for stacking the competition with obscure sports so that its athletes have a good chance of winning.', 'lead_paragraph': 'BANGKOK — It has been promoted as a showcase for the new Myanmar, a regional sporting event in December that will celebrate the country’s embrace of democracy and the end of a hermetic and oppressive era.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Myanmar, Sports Choices Raise Concerns', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Myanmar, Sports Choices Raise Concerns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fuller, Thomas', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Myanmar', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Assn of Southeast Asian Nations', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-27T11:17:24+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8bd199d4-dc66-586b-b794-a9c4d203a55f', 'word_count': 693, 'uri': 'nyt://article/8bd199d4-dc66-586b-b794-a9c4d203a55f'}, {'abstract': 'Long-form articles on a leadership crisis in India and Indo-Pak relations.', 'web_url': 'https://india.blogs.nytimes.com/2013/01/27/newswallah-long-reads-edition-57/', 'snippet': 'Long-form articles on a leadership crisis in India and Indo-Pak relations.', 'lead_paragraph': 'As India’s rival national parties, the incumbent Congress and the principal opposition, the Bharatiya Janata Party, begin preparing for the general elections scheduled for 2014, Open Magazine’s Jatin Gandhi analyzes the country’s potential choices for prime minister: Narendra Modi, the controversial chief minister of Gujarat, who was welcomed amid feverish chants of “P.M.! P.M.!” at his party’s New Delhi office last month, and Rahul Gandhi, the 42-year-old heir apparent of the Gandhi dynasty, who took charge last week as vice president of the Congress party.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Newswallah: Long Reads Edition', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gandhi, Rahul', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Modi, Narendra', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bharatiya Janata Party', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Indian National Congress', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-27T12:17:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Wor