', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-07T20:18:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/18d81fe7-dbfa-50f0-9dfb-adba36eb924d', 'word_count': 368, 'uri': 'nyt://article/18d81fe7-dbfa-50f0-9dfb-adba36eb924d'}, {'abstract': 'The search for the missing aircraft carrying Vittorio Missoni continued off the coast of Venezuela for a fourth day on Monday.', 'web_url': 'https://runway.blogs.nytimes.com/2013/01/07/missoni-family-keeps-anxious-watch/', 'snippet': 'The search for the missing aircraft carrying Vittorio Missoni continued off the coast of Venezuela for a fourth day on Monday.', 'lead_paragraph': 'The search for the missing aircraft carrying Vittorio Missoni continued off the coast of Venezuela for a fourth day on Monday. In the absence of any sign of wreckage, members of the Missoni family said they were exploring other possibilities of what might have happened.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Missoni Family Keeps Anxious Watch', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kidnapping', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Missoni, Angela', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Missoni, Vittorio', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Missoni', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Roques (Venezuela)', '