nt_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-13T19:04:36+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/b5c2e725-79e0-570c-ac6c-c1b653baaad2', 'word_count': 0, 'uri': 'nyt://slideshow/b5c2e725-79e0-570c-ac6c-c1b653baaad2'}, {'abstract': 'A state where gun ownership crosses political divides is becoming a test case for what kind of regulations can garner support.', 'web_url': 'https://www.nytimes.com/2013/01/14/us/colorado-may-pass-major-gun-control-legislation.html', 'snippet': 'A state where gun ownership crosses political divides is becoming a test case for what kind of regulations can garner support.', 'lead_paragraph': 'DENVER — With politicians in Washington deeply divided over new gun regulations, an urgent national debate ignited by the massacre at Sandy Hook Elementary School is storming into state legislatures across the country. And nowhere is that debate more emotionally charged or politically consequential than here in Colorado, a reluctant crucible for the battle over guns.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Debate on Gun Laws Is Put to a Test in Colorado', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.S. Debate On Gun Laws Is Put to a Test In Colorado', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Colorado', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Frosch, Dan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-13T19:30:32+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jack Healy and Dan Frosch', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Dan', 'middlename': None, 'lastname': 'Frosch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5e8d27fc-0440-5110-bdd9-0f5b1c750299', 'word_count': 1134, 'uri': 'nyt://article/5e8d27fc-0440-5110-bdd9-0f5b1c750299'}, {'abstract': 'Scenes from the Milan fashion week photo diary of Danilo Scarpati.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/01/13/photos-of-the-moment-neil-barrett-3/', 'snippet': 'Scenes from the Milan fashion week photo diary of Danilo Scarpati.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photos of The Moment | Neil Barrett', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-13T20:33:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Danilo Scarpati', 'person': [{'firstname': 'Danilo', 'middlename': None, 'lastname': 'Scarpati', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7fccc546-1c72-5f7f-b930-932bf7601e0b', 'word_count': 36, 'uri': 'nyt://article/7fccc546-1c72-5f7f-b930-932bf7601e0b'}, {'abstract': 'Ed Asner says he, Martin Sheen and David Clennon are drafting a letter to fellow Academy members asking that matters of conscience be considered when voting on Oscars.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2013/01/13/ed-asner-adds-his-voice-to-zero-dark-thirty-protest/', 'snippet': 'Ed Asner says he, Martin Sheen and David Clennon are drafting a letter to fellow Academy members asking that matters of conscience be considered when voting on Oscars.', 'lead_paragraph': 'LOS ANGELES — Sunday dawned crisp and clear here, with wintry (for Southern California) temperatures lingering in the 40s and 50s. But the rhetoric was already hot, as Hollywood got ready for a Golden Globes ceremony at which the table talk — if not the stage banter — almost inevitably will turn to the political flare-up around “Zero Dark Thirty.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ed Asner Adds His Voice to ‘Zero Dark Thirty’ Protest', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Golden Globes (Awards)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Asner, Ed', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Sony Pictures Entertainment', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-13T20:36:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e62f91f-3281-599a-8c6c-71a7a7fb44bf', 'word_count': 250, 'uri': 'nyt://article/6e62f91f-3281-599a-8c6c-71a7a7fb44bf'}, {'abstract': 'Carmelo Anthony had 27 points, and the Knicks played solid defense to end a three-game skid.', 'web_url': 'https://www.nytimes.com/2013/01/14/sports/basketball/knicks-dispatch-hornets-with-ease.html', 'snippet': 'Carmelo Anthony had 27 points, and the Knicks played solid defense to end a three-game skid.', 'lead_paragraph': 'The Knicks called it a must-win game, a first for them this season. They vowed to be the more aggressive, more physical team on their home court. And they said they were going to use this game, a Sunday matinee against the\xa0New Orleans Hornets, as a way to start a new winning streak after their first three-game skid.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/sports/basketball/14knicks-pic2/14knicks-pic2-jumbo.jpg', 'height': 1024, 'width': 805, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/sports/basketball/14knicks-pic2/14knicks-pic2-superJumbo.jpg', 'height': 2048, 'width': 1610, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/sports/basketball/14knicks-pic2/14knicks-pic2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/14/sports/basketball/14knicks-pic2/14knicks-pic2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/sports/basketball/14knicks-pic2/14knicks-pic2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seeking Fresh Start, Knicks Dispatch Hornets With Ease', 'kicker': 'Knicks 100, Hornets 87', 'content_kicker': None, 'print_headline': 'Seeing Game as New Beginning, Knicks Recapture Early-Season Form', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Taylor, Nate', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Knicks', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New Orleans Hornets', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ANTHONY, CARMELO', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-13T20:36:54+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Nate Taylor', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fec341ed-cac2-5567-9587-ef8647697d7a', 'word_count': 863, 'uri': 'nyt://article/fec341ed-cac2-5567-9587-ef8647697d7a'}, {'abstract': 'The Italian design house held its show despite the disappearance of its chief executive whose plane disappeared more than a week ago after takeoff from the Los Roques archipelago, off the coast of Venezuela.', 'web_url': 'https://runway.blogs.nytimes.com/2013/01/13/applause-at-missoni-but-an-empty-stage/', 'snippet': 'The Italian design house held its show despite the disappearance of its chief executive whose plane disappeared more than a week ago after takeoff from the Los Roques archipelago, off the coast of Venezuela.', 'lead_paragraph': 'MILAN — Rising for a standing ovation at the end of the Missoni show, as much in respectful sympathy as praise, the crowd here this afternoon found itself clapping for no one. ', 'print_section': 'E', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Applause at Missoni, but an Empty Stage', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': 'Applause At Missoni, But an Empty Stage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-13T20:41:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Guy Trebay', 'person': [{'firstname': 'Guy', 'middlename': None, 'lastname': 'Trebay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ace2f11b-01b6-5f91-9ca9-b2acea5fb74d', 'word_count': 313, 'uri': 'nyt://article/ace2f11b-01b6-5f91-9ca9-b2acea5fb74d'}, {'abstract': 'For the first time in its four-decade existence the 92nd Street Y’s Lyrics & Lyricists series devoted a program to W. S. Gilbert.', 'web_url': 'https://www.nytimes.com/2013/01/14/arts/music/w-s-gilbert-and-broadway-he-inspired-at-92nd-street-y.html', 'snippet': 'For the first time in its four-decade existence the 92nd Street Y’s Lyrics & Lyricists series devoted a program to W. S. Gilbert.', 'lead_paragraph': 'Try to imagine how American musical comedy might have evolved without the precedent of Gilbert and Sullivan, and be thankful for the elevated standard of satirical nonsense this British team’s delirious patter songs established for the 20th century. In the words of Alan J. Lerner, W. S. Gilbert raised lyric writing “from a serviceable craft to a legitimate popular art form.” Johnny Mercer bluntly declared, “We all come from Gilbert.” Would it be stretching a point to suggest that rap songs’ fusillades of rhyme also owe something to Gilbert?', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/LYRICS/LYRICS-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/14/arts/LYRICS/LYRICS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/LYRICS/LYRICS-jumbo.jpg', 'height': 615, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/LYRICS/LYRICS-superJumbo.jpg', 'height': 1231, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/LYRICS/LYRICS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/14/arts/LYRICS/LYRICS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/LYRICS/LYRICS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Very Model of a Modern Major Lyricist', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'The Very Model of a Modern Major Lyricist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gilbert, William S', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fisher, Rob', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-13T21:06:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/61c8c30e-0509-50af-88d8-aef9941a85fe', 'word_count': 485, 'uri': 'nyt://article/61c8c30e-0509-50af-88d8-aef9941a85fe'}, {'abstract': 'Megan James and Corin Roddick, who make up a duo called Purity Ring, performed every song from their latest album, “Shrines,” at Webster Hall on Saturday.', 'web_url': 'https://www.nytimes.com/2013/01/14/arts/music/purity-ring-at-webster-hall.html', 'snippet': 'Megan James and Corin Roddick, who make up a duo called Purity Ring, performed every song from their latest album, “Shrines,” at Webster Hall on Saturday.', 'lead_paragraph': 'Gaping holes and deliberate convolutions define the songs of Purity Ring, the Canadian duo that performed at Webster Hall on Saturday night, the second of two nights. Megan James is the singer and occasional percussionist; Corin Roddick controls the electronics and keeps busy in real time with drumsticks, tapping on lanterns that light up as they trigger individual notes. Purity Ring combines programmed tracks that are overtly artificial with idiosyncratic content, creating a carnal presence in a digital environment. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/RING/RING-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/RING/RING-superJumbo.jpg', 'height': 1362, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/RING/RING-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/14/arts/RING/RING-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/14/arts/RING/RING-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At a Temple of Electronica, Drumming Up Lights to Carry the Rest', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'At a Temple of Electronica, Drumming Up Lights to Carry the Rest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Purity Ring (Music Group)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-13T21:06:37+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a13e77ab-ccc7-54ef-9f27-418b12d62f50', 'word_count': 431, 'uri': 'nyt://article/a13e77ab-ccc7-54ef-9f27-418b12d62f50'}, {'abstract': 'Television executives are coming under increasing pressure over the content of their programming in the wake of recent mass killings.', 'web_url': 'https://www.nytimes.com/2013/01/14/arts/television/real-violence-puts-pressure-on-tv-fiction.html', 'snippet': 'Television executives are coming under increasing pressure over the content of their programming in the wake of recent mass killings.', 'lead_paragraph': 'LOS ANGELES — When Kevin Reilly, the chairman for entertainment at the Fox network, commissioned an ambitious thriller series called “The Following,” about a Hannibal Lecter-like serial killer who inspires a legion of deranged followers, his intention was to challenge the cable business, not the culture.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'ca