umbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/us/Y-BELIEFS/Y-BELIEFS-superJumbo.jpg', 'height': 2048, 'width': 1474, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/us/Y-BELIEFS/Y-BELIEFS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/19/us/Y-BELIEFS/Y-BELIEFS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/us/Y-BELIEFS/Y-BELIEFS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Christian Pioneer of Home Schooling Looks to Its Future', 'kicker': 'Beliefs', 'content_kicker': None, 'print_headline': 'A Christian Pioneer of Home Schooling Looks to Its Future', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christians and Christianity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Home Schooling', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Pride, Mary', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Evangelical Movement', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-01-18T18:26:45+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Mark Oppenheimer', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Oppenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/277374a8-ff08-5b09-993d-f720afe55f09', 'word_count': 1020, 'uri': 'nyt://article/277374a8-ff08-5b09-993d-f720afe55f09'}, {'abstract': 'In winter, when the sun sets early and darkness dominates, Reykjavik offers plenty of options to escape hibernation.', 'web_url': 'https://www.nytimes.com/2013/01/20/travel/the-lights-and-nights-of-reykjavik.html', 'snippet': 'In winter, when the sun sets early and darkness dominates, Reykjavik offers plenty of options to escape hibernation.', 'lead_paragraph': 'THE sky above Reykjavik was as dark as black ice, save for a handful of diamond stars. As a cutting wind whipped off the frigid sea and blew down the narrow streets lined with brightly painted storefronts, shivering pedestrians tightened their scarves and scurried into cozy bars and restaurants to find warmth.', 'print_section': 'TR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/travel/20-cultured-combo/20-cultured-combo-articleLarge-v2.jpg', 'height': 150, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/20/travel/20-cultured-combo/20-cultured-combo-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 150}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/travel/20-cultured-combo/20-cultured-combo-jumbo-v2.jpg', 'height': 150, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/travel/20-cultured-combo/20-cultured-combo-superJumbo-v2.jpg', 'height': 150, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/travel/20-cultured-combo/20-culture