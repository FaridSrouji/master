nk': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Kachin Independence Army', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Myanmar', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Thein Sein', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-20T22:42:41+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fcf809d8-19ee-55a1-a0f8-43c4fc3646ec', 'word_count': 934, 'uri': 'nyt://article/fcf809d8-19ee-55a1-a0f8-43c4fc3646ec'}, {'abstract': 'The J. Paul Getty Museum announced Friday that it had been conducting a review since last summer of some 45,000 objects in its collection to verify their origin and ownership history.', 'web_url': 'https://www.nytimes.com/2013/01/21/arts/design/a-sweeping-review-by-the-getty-museum.html', 'snippet': 'The J. Paul Getty Museum announced Friday that it had been conducting a review since last summer of some 45,000 objects in its collection to verify their origin and ownership history.', 'lead_paragraph': 'The J. Paul Getty Museum announced Friday that it had been conducting a review since last summer of some 45,000 objects in its collection to verify their origin and ownership history. The review is likely to reveal that hundreds of ancient artifacts still in the museum’s collection are of dubious provenance, The Los Angeles Times reported. Since 2007 the Getty has returned close to 50 objects that were found to be looted, according to museum records and interviews with former museum officials and antiquity dealers. This month the museum voluntarily returned a terra cotta head to Sicily after a two-year investigation revealed that it was illicitly removed from a site of a sanctuary of Demeter in the 1970s.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Sweeping Review by the Getty Museum', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'A Sweeping Review By the Getty Museum', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Getty, J Paul, Museum', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Looting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-20T22:43:23+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'Compiled by Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/9a5b40f6-6d1b-529d-9a43-9280192c0873', 'word_count': 118, 'uri': 'nyt://article/9a5b40f6-6d1b-529d-9a43-9280192c0873'}, {'abstract': '“Snapshots: A Musical Scrapbook” will feature songs from “Wicked,” “Godspell” and “Pippin.”', 'web_url': 'https://www.nytimes.com/2013/01/21/theater/musical-to-feature-stephen-schwartz-songs.html', 'snippet': '“Snapshots: A Musical Scrapbook” will feature songs from “Wicked,” “Godspell” and “Pippin.”', 'lead_paragraph': 'A compilation musical showcasing the catalog of the composer Stephen Schwartz, “Snapshots: A Musical Scrapbook,” is scheduled for the fall at the Norma Terris Theater in Chester, Conn., Goodspeed Musicals has announced. With a book by David Stern, the musical will feature over 20 songs by Mr. Schwartz, including compositions from “Wicked,” “Godspell” and “Pippin.” Some of the lyrics and orchestrations will be revised to match a new story that focuses on a married couple reliving memories captured in a box of photographs in their attic. No casting information was announced.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Musical to Feature Stephen Schwartz Songs', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Musical to Feature Stephen Schwartz Songs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Schwartz, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Goodspeed Musicals', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-20T22:45:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'Compiled by Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/1968902e-5f09-5a53-baa6-2d6419b8429f', 'word_count': 91, 'uri': 'nyt://article/1968902e-5f09-5a53-baa6-2d6419b8429f'}, {'abstract': 'Timur Gareev said his experience playing blindfolded against 27 opponents at once helped him win the North American Open with his eyes wide open.', 'web_url': 'https://www.nytimes.com/2013/01/20/crosswords/chess/chess-gareev-wins-north-american-open.html', 'snippet': 'Timur Gareev said his experience playing blindfolded against 27 opponents at once helped him win the North American Open with his eyes wide open.', 'lead_paragraph': 'Just before New Year’s, Timur Gareev won the North American Open in Las Vegas with a score of 8 (out of 9) points — a full point ahead of his nearest rival.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/