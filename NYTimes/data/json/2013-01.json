name': 'glocations', 'value': 'Siberia', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'World Wildlife Fund', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-01-09T00:32:40+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Andrew E. Kramer', 'person': [{'firstname': 'Andrew', 'middlename': 'E.', 'lastname': 'Kramer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3ceadf44-9f7c-5629-a3af-9d79dc8b778d', 'word_count': 609, 'uri': 'nyt://article/3ceadf44-9f7c-5629-a3af-9d79dc8b778d'}, {'abstract': 'The Supreme Court decision said federal courts should not automatically suspend postconviction challenges from death row inmates who are mentally incompetent to help their lawyers.', 'web_url': 'https://www.nytimes.com/2013/01/09/us/justices-rule-mental-incompetence-does-not-merit-automatic-stays-of-death-row-suits.html', 'snippet': 'The Supreme Court decision said federal courts should not automatically suspend postconviction challenges from death row inmates who are mentally incompetent to help their lawyers.', 'lead_paragraph': 'WASHINGTON — The Supreme Court on Tuesday unanimously ruled that federal courts should not automatically suspend postconviction challenges from death row inmates who are mentally incompetent to help their lawyers. The decision left open the possibility that such suspensions may sometimes be warranted, but it said that they should not be indefinite.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Justices Rule on Staying Death Row Challenges', 'kicker': None, 'content_kicker': None, 'print_headline': 'Justices Rule On Staying Death Row Challenges', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Supreme Court', 'rank': 2, 'major':