height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/30/dining/3DEAD1_SPAN/30SUBDEAD1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/30/dining/3DEAD1_SPAN/30SUBDEAD1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/30/dining/3DEAD1_SPAN/30SUBDEAD1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Gang’s All Here, at Least in Spirits', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Gang’s All Here, At Least in Spirits', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Simonson, Robert', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bars and Nightclubs', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-29T20:07:24+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Robert Simonson', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Simonson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/956d9e0c-f75c-51ca-8c89-c7c615271b74', 'word_count': 564, 'uri': 'nyt://article/956d9e0c-f75c-51ca-8c89-c7c615271b74'}, {'abstract': 'The infantry is not for everyone, male or female. I suspect that only a small fraction of women will even attempt to join. But for those who do, I can only hope my skepticism is proved wrong and that they succeed.', 'web_url': 'https://atwar.blogs.nytimes.com/2013/01/29/women-in-combat-some-marines-react/', 'snippet': 'The infantry is not for everyone, male or female. I suspect that only a small fraction of women will even attempt to join. But for those who do, I can only hope my skepticism is proved wrong and that they succeed.', 'lead_paragraph': 'When my squad arrived at our outpost in Afghanistan in 2010, one of the first things we did was outfit our living quarters with trash bags, cardboard and salvaged wood to ease the vicious winds. Going to the bathroom proved equally challenging. We urinated into a metal pipe fed through a Hesco barricade filled with dirt and burned our feces in a metal drum. There were no showers or water for showers, so, after each day’s long and grueling foot patrols we pulled on new socks and used baby wipes and body powder. It was miserable but we endured the misery together.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Women in Combat? Some Marines React', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sexual Harassment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Dempsey, Martin E', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Panetta, Leon V', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Marine Corps', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Marine Corps Base Camp Lejeune (SC)', 'rank': 12, 'major': 'N'}], 'pub_date': '2013-01-29T20:11:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Thomas James Brennan', 'person': [{'firstname': 'Thomas', 'middlename': 'James', 'lastname': 'Brennan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80646cf2-e2d3-5584-98af-63dc095b81e1', 'word_count': 1557, 'uri': 'nyt://article/80646cf2-e2d3-5584-98af-63dc095b81e1'}, {'abstract': 'Andrew S. Penson isn’t much for publicity, but it’s his company, not some government entity, that owns the 100-year-old train station and is paid the rent.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/01/29/grand-centrals-flesh-and-blood-landlord/', 'snippet': 'Andrew S. Penson isn’t much for publicity, but it’s his company, not some government entity, that owns the 100-year-old train station and is paid the rent.', 'lead_paragraph': 'There is some confusion over whether Andrew S. Penson had even been invited to the gala celebration of Grand Central Terminal’s centennial on Friday night. Regardless, Mr. Penson says characteristically, he will be the man who didn’t come to dinner.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Grand Central’s Flesh-and-Blood Landlord', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grand Central Terminal (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Penson, Andrew S', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Argent Ventures', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Transportation Authority', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Midtown Area (Manhattan, NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-29T20:16:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'bylin