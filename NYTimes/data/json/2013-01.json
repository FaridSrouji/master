ts/13ETHAN_SPAN/13ETHAN_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/13/arts/13ETHAN_SPAN/13ETHAN_SPAN-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/13/arts/13ETHAN_SPAN/13ETHAN_SPAN-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/13/arts/13ETHAN_SPAN/13ETHAN_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/13/arts/13ETHAN_SPAN/13ETHAN_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/13/arts/13ETHAN_SPAN/13ETHAN_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In His Comfort Zone', 'kicker': None, 'content_kicker': None, 'print_headline': 'In His Comfort Zone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Carr, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hawke, Ethan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New Group Theater Co', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-01-10T13:00:07+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Theater', 'byline': {'original': 'By David Carr', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Carr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f02ecd64-4677-529a-ad3f-24b503721829', 'word_count': 1740, 'uri': 'nyt://article/f02ecd64-4677-529a-ad3f-24b503721829'}, {'abstract': 'Jimmy Kimmel joined the 11:35 p.m. late-night sweepstakes with Jay Leno and David Letterman on Tuesday night, but it was Mr. Leno who won the night’s ratings race; the man behind a Puerto Rican puppet that was the subject of a media firestorm in November has resigned; Lipton is launching a new advertising campaign for the company’s black tea that urges consumers to “Drink positive.”', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2013/01/10/the-breakfast-meeting-a-late-night-ratings-race-and-a-controversial-puppeteer-resigns/', 'snippet': 'Jimmy Kimmel joined the 11:35 p.m. late-night sweepstakes with Jay Leno and David Letterman on Tuesday night, but it was Mr. Leno who won the night’s ratings race; the man behind a Puerto Rican puppet that was the subject of a media firestorm in N...', 'lead_paragraph': 'It was Jimmy Kimmel who joined the 11:35 p.m. late-night sweepstakes with Jay Leno and David Letterman on Tuesday, but it was Mr. Leno who won the night’s ratings race. Mr. Leno on NBC pulled in 3.27 million viewers, edging Mr. Kimmel on ABC, who had 3.1 million. The total for Mr. Kimmel was his second highest. It also put him in second place, ahead of David Letterman on CBS, who had 2.88 million viewers. As Bill Carter reports, Mr. Leno was also the winner in the audience of most interest to late-night advertisers — viewers between the ages of 18 and 49. Mr. Leno had 1.084 million viewers in that group to 887,000 for Mr. Kimmel and 683,000 for Mr. Letterman.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Breakfast Meeting: A Late-Night Ratings Race, and a Controversial Puppeteer Resigns', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Boycotts', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Puerto Ricans', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Puppets', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Tea', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Fallon, Jimmy', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Kimmel, Jimmy', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Leno, Jay', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Letterman, David', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Santarrosa, Antulio Kobbo', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'ABC INC', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'AT&T Inc', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'CBS Corporation', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 15, 'major': 'N'}, {'name': 'organizations', 'value': 'Unilever NV', 'rank': 16, 'major': 'N'}, {'name': 'organizations', 'value': 'Wal-Mart Stores Inc', 'rank': 17, 'major': 'N'}, {'name': 'organizations', 'value': 'WAPA-TV', 'rank': 18, 'major': 'N'}, {'name': 'glocations', 'value': 'Puerto Rico', 'rank': 19, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 20, 'major': 'N'}], 'pub_date': '2013-01-10T13:00:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By The Editors', 'person': [], 'organization': 'The Editors'}, 'type_of_material': 'News', '_id': 'nyt://article/01191c77-367d-5447-876b-30c0f9cd209a', 'w