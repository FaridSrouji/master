a': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/booming/17question-booming-worry/17question-booming-worry-jumbo.jpg', 'height': 1024, 'width': 573, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/booming/17question-booming-worry/17question-booming-worry-superJumbo.jpg', 'height': 2000, 'width': 1120, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/booming/17question-booming-worry/17question-booming-worry-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/17/booming/17question-booming-worry/17question-booming-worry-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/17/booming/17question-booming-worry/17question-booming-worry-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Am I Getting Mellower?', 'kicker': 'Question Mark', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Age, Chronological', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-17T16:29:49+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Eric Nagourney', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Nagourney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c4d657e6-7ddb-5de0-b767-c88dc7aacaca', 'word_count': 642, 'uri': 'nyt://article/c4d657e6-7ddb-5de0-b767-c88dc7aacaca'}, {'abstract': 'The best way to celebrate a Scottish poet is with Scotch whisky. And vice versa.', 'web_url': 'https://www.nytimes.com/2013/01/20/magazine/drinking-like-a-poet.html', 'snippet': 'The best way to celebrate a Scottish poet is with Scotch whisky. And vice versa.', 'lead_paragraph': 'One chilly evening more than a decade ago, my Glasgow-born-and-bred friend Angus Robertson greeted me at his Brooklyn Heights doorway in his kilt and sporran and welcomed me to my first Burns supper, the Scottish celebration on Jan. 25 that honors the poet Robert Burns. About 20 of us gathered around the haggis (nothing to be afraid of, basically a big mealy sausage), neeps and tatties (that’s turnips and potatoes) and whisky-fortified gravy. Then the time arrived for dessert, poetry, song and whisky. Lots of Scotch whisky, selected with care by our hosts.', 'print_section': 'MM', 'print_page': '48', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20drink/20drink-articleLarge-v2.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/20/magazine/20drink/20drink-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20drink/20drink-jumbo-v2.jpg', 'height': 1024, 'width': 937, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20drink/20drink-superJumbo-v2.jpg', 'height': 1586, 'width': 1452, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'lega