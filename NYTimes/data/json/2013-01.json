r': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b450ee4-f308-5641-ae7d-a4537fe87cff', 'word_count': 261, 'uri': 'nyt://article/0b450ee4-f308-5641-ae7d-a4537fe87cff'}, {'abstract': 'The Fed chairman opens up in an appearance before University of Michigan students in a way he rarely does in Washington.', 'web_url': 'https://economix.blogs.nytimes.com/2013/01/14/bernanke-unplugged/', 'snippet': 'The Fed chairman opens up in an appearance before University of Michigan students in a way he rarely does in Washington.', 'lead_paragraph': 'Much is made of the fact that Ben S. Bernanke, the Federal Reserve chairman, is more open and candid than his predecessors, but in fairness, that’s a low bar. His public appearances are infrequent by comparison with other national leaders, his remarks are guarded and his personal life is carefully obscured.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bernanke Unplugged', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bernanke, Ben S', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Michigan', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-14T23:32:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e079f68-1286-5736-b695-08cc18cef484', 'word_count': 454, 'uri': 'nyt://article/9e079f68-1286-5736-b695-08cc18cef484'}, {'abstract': 'The T.S.A. plans to expand its PreCheck program, which allows certain “known and trusted” travelers expedited passage through security checkpoints.', 'web_url': 'https://www.nytimes.com/2013/01/15/business/security-check-programs-tend-to-create-an-elite-class-on-the-road.html', 'snippet': 'The T.S.A. plans to expand its PreCheck program, which allows certain “known and trusted” travelers expedited passage through security checkpoints.', 'lead_paragraph': 'THE Transportation Security Administration plans to widen the pool of travelers who qualify for PreCheck, its 14-month-old expedited security program that allows selected passengers to pass through special checkpoints without having to remove laptops from bags or take off their shoes, belts or outer coats.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/business/Road/Road-jumbo.jpg', 'height': 593, 'width': 504, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/business/Road/Road-superJumbo.jpg', 'height': 593, 'width': 504, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Expanding Elite Status to the Security Line', 'kicker': 'On the Road', 'content_kicker': None, 'print_headline': 'Expanding Elite Status To the Security Line', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sharkey, Joe', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Airport Security', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Transportation Security Administration', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'American Civil Liberties Union', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Data-Mining and Database Marketing', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-14T23:40:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Joe Sharkey', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Sharkey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3d3820d0-ea9e-59cb-b77b-b5b9e1ba20e4', 'word_count': 874, 'uri': 'nyt://article/3d3820d0-ea9e-59cb-b77b-b5b9e1ba20e4'}, {'abstract': 'The RS7 is an asphalt-scorching take on Audi’s elegant A7 sedan, and the SQ5 is a high performance version of Audi’s Q5 sporty utility.', 'web_url': 'https://wheels.blogs.nytimes.com/2013/01/14/with-the-rs7-and-sq5-audi-adds-more-power/', 'snippet': 'The RS7 is an asphalt-scorching take on Audi’s elegant A7 sedan, and the SQ5 is a high performance version of Audi’s Q5 sporty utility.', 'lead_paragraph': 'Introduced on Monday, Jan. 14: Audi RS7 Sportback and 2013 SQ5What is it? The RS7 is an asphalt-scorching, 560-horsepower take on the German automaker’s elegant A7 sedan – Audi would prefer you not call the A7 a hatchback, but it is one. Meanwhile, the SQ5 is a high performance take on Audi’s Q5 sporty utility.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'With the RS7 and SQ5, Audi Adds More Power', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Audi Division of Volkswagen AG', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-14T23:46:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Nick Kurczewski', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Kurczewski', 'qualifier': None, 'title': None