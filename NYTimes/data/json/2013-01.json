icker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Next Round of Tax Increases', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ALTERNATIVE MINIMUM TAX', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Income Tax', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Corporate Taxes', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-01-07T01:56:30+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/75406f9f-4891-5699-bbee-6e31cb7b517c', 'word_count': 457, 'uri': 'nyt://article/75406f9f-4891-5699-bbee-6e31cb7b517c'}, {'abstract': 'The American Prospect is subletting part of its Washington offices to The American Conservative.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2013/01/06/american-prospect-and-the-american-conservative-to-share-office-space/', 'snippet': 'The American Prospect is subletting part of its Washington offices to The American Conservative.', 'lead_paragraph': 'The financial crisis did not bring bipartisanship to Congress, but a difficult media environment may have brought that spirit to two political standard-bearers.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Magazines on Left and Right Unite to Share Office Space', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'Magazines on Left and Right Unite to Share Office Space', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Magazines', 'rank': 2, 'major': 'N'}, {'na