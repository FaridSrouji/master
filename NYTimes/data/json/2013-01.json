5e-bbf2-5db53ba2c6dd', 'word_count': 233, 'uri': 'nyt://article/50435617-e968-5f5e-bbf2-5db53ba2c6dd'}, {'abstract': 'Imagine a house that can go without heating for two days in a bitterly cold winter. Or a greenhouse with what may be the largest hot-air solar panel array in North America.', 'web_url': 'https://green.blogs.nytimes.com/2013/01/11/in-rural-minnesota-a-70-acre-lab-for-sustainable-living/', 'snippet': 'Imagine a house that can go without heating for two days in a bitterly cold winter. Or a greenhouse with what may be the largest hot-air solar panel array in North America.', 'lead_paragraph': 'Paul Hunt still remembers the dilemma that he and his wife, Lynn, faced in early January 2010 at their home in rural north-central Minnesota. The couple had just moved into their ultra-efficient house, on the outskirts of Pine River, population 944, but still lacked a thermostat and were about to go out of town for more than two days. It was bitterly cold, and an exterior sensor, one of the many dotting their house, suggested that the nighttime temperature would dip far below zero. Should they leave the heat on or turn it off?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/11/blogs/hug1/hug1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/11/blogs/hug1/hug1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/11/blogs/hug1/hug1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/11/blogs/hug1/hug1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/11/blogs/hug1/hug1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Rural Minnesota, a 70-Acre Lab for Sustainable Living', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-11T17:07:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Bryn Nelson', 'person': [{'firstname': 'Bryn', 'middlename': None, 'lastname': 'Nelson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9770b4fd-2dbf-55ec-80fd-0bf7e62505fb', 'word_count': 1382, 'uri': 'nyt://article/9770b4fd-2dbf-55ec-80fd-0bf7e62505fb'}, {'abstract': 'A veteran House Republican from Georgia told a group in suburban Atlanta that the former Republican senatorial candidate Todd Akin of Missouri was “partially right” when he said that women do not become pregnant when raped.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/01/11/republican-says-akin-was-partially-right-about-rape/', 'snippet': 'A veteran House Republican from Georgia told a group in suburban Atlanta that the former Republican senatorial candidate Todd Akin of Missouri was “partially right” when he said that women do not become pregnant when raped.', 'lead_paragraph': 'Two months after the incendiary issues of rape and abortion helped defeat two Republican Senate candidates, a veteran House Republican from Georgia reopened the subjects on Friday, telling a group in suburban Atlanta that the former Republican senatorial candidate Todd Akin of Missouri was “partially right” when he said that women do not become pregnant when raped.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Republican Says Akin Was ‘Partially Right’ About Rape', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-11T17:08:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Weisman', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Weisman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/360b0d3c-aa4b-5dde-8906-6761855374c3', 'word_count': 528, 'uri': 'nyt://article/360b0d3c-aa4b-5dde-8906-6761855374c3'}, {'abstract': 'Is grinding your own spices really worth the effort? Melissa Clark explains why the answer is yes.', 'web_url': 'https://www.nytimes.com/video/dining/100000001987017/toasting-and-grinding-spices.html', 'snippet': 'Is grinding your own spices really worth the effort? Melissa Clark explains why the answer is yes.', 'lead_paragraph': 'Is grinding your own spices really worth the effort? Melissa Clark explains why the answer is yes.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/11/dining/video-clarkspices/video-clarkspices-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/11/dining/video-clarkspices/video-clarkspices-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/11/dining/video-clarkspices/video-clarkspices-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/11/dining/video-clarkspices/video-clarkspices-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Toasting and Grinding Spices', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Spices', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clark, Melissa', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-11T17:16:46+0000', 'document_type': 'multimedia', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'David Frank', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Frank', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/5088e322-0e90-5bac-9c3f-c44d4d882614', 'word_count': 0, 'uri': 'nyt://video/5088e322-0e90-5bac-9c3f-c44d4d882614'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/01/11/arts/television/whats-on-friday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '10 P.M. (TMC) MY WEEK WITH MARILYN (2011) Michelle Williams, above, in an Oscar-nominated role, steps into the pumps and pencil skirts of Marilyn Monroe, and Eddie Redmayne plays Colin Clark, a documentary filmmaker who claimed to have spent an intimate interlude with her in 1956 while they were making “The Prince and the Showgirl.” This film, an adaptation of his diaries, also features Kenneth Branagh, in another nominated role, as Laurence Olivier, Monroe’s co-star and director, whose infatuation and ego clashes with Monroe caused him to call her “the stupidest, most self-indulgent little tart I’ve ever come across.” When the shoot went from bad to worse, he told her: “Just be sexy. Isn’t that what you do?” Manohla Dargis wrote in The New York Times, “He didn’t get Monroe, and she is similarly out of the grasp of this movie,” adding: “Ms. Williams tries her best, and sometimes that’s almost enough. She’s too thin for the role, more colorlessly complected than creamy, but she whispers and wobbles nicely.” Still, Ms. Dargis said: “The problem isn’t Ms. Williams or the serviceable work of the director, Simon Curtis, but a script by Adrian Hodges that hews faithfully to Clark’s clichés. Instead of the complex woman familiar from the better books about her, the film offers a catalog of Monroe stereotypes: child, woman, smiling exhibitionist, shrieking neurotic, the barefooted free spirit and, lamentably, the martyr teetering in heels toward her doom. The tragic Monroe is obviously dramatic, but the intimations of disaster don’t fit a movie that works so hard to be breezily, easily likable.” ', 'print_section': 'C', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Friday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-11T17:17:07+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/eb0e7f13-f2f9-58da-9026-ddd98728dd3c', 'word_count': 761, 'uri': 'nyt://article/eb0e7f13-f2f9-58da-9026-ddd98728dd3c'}, {'abstract': 'How an ancient faith shapes modern spirituality and modern atheism alike.', 'web_url': 'https://douthat.blogs.nytimes.com/2013/01/11/the-divided-influence-of-gnosticism/', 'snippet': 'How an ancient faith shapes modern spirituality and modern atheism alike.', 'lead_paragraph': 'In the latest First Things, David Bentley Hart has an interesting essay on Carl Jung’s eccentric, esoteric, solipsistic and impenetrable “Red Book,” which includes some perceptive remarks on the difference between the modern manifestations of Gnosticism and the more ancient variety:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Divided Influence of Gnosticism', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-11T17:17:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5cee71e-0dd4-5f44-8587-2d3be3eb3224', 'word_count': 1204, 'uri': 'nyt://article/c5cee71e-0dd4-5f44-8587-2d3be3eb3224'}, {'abstract': 'Salads, cakes and main courses like fish all benefit from the addition of the crimson-fleshed blood orange, now in season.', 'web_url': 'https://www.nytimes.com/2013/01/16/dining/blood-oranges-add-color-to-dishes-and-desserts.html', 'snippet': 'Salads, cakes and main courses like fish all benefit from the addition of the crimson-fleshed blood orange, now in season.', 'lead_paragraph': 'THE last bottle of holiday wine has been drunk, the discarded Christmas trees have been pulped to mulch and my local farmers’ market has shrunk to a few crates of muddy roots and yellowing kale. It’s time to celebrate something new: the arrival of blood oranges.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/16/dining/16APPE2/16APPE2-articleLarge-v2.jpg', 'height': 465, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/16/dining/16APPE2/16APPE2-articleLarg