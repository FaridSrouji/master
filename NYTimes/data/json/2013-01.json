height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/10/arts/10LAVIN/10LAVIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/10/arts/10LAVIN/10LAVIN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'No Caution in the Eye of the Storm', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'No Caution in the Eye of the Storm', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lavin, Linda', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-09T22:58:51+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/194fa965-3248-565e-86a0-2d11a7cf0515', 'word_count': 416, 'uri': 'nyt://article/194fa965-3248-565e-86a0-2d11a7cf0515'}, {'abstract': 'Although Charlie Ergen’s takeover bid is unlikely to go very far, it could pressure Sprint to pay more — or strike a deal with Dish.', 'web_url': 'https://dealbook.nytimes.com/2013/01/09/dishs-potemkin-offer-for-clearwire/', 'snippet': 'Although Charlie Ergen’s takeover bid is unlikely to go very far, it could pressure Sprint to pay more — or strike a deal with Dish.', 'lead_paragraph': 'Sprint and Softbank are being forced into tactical warfare. U.S. satellite-TV company Dish Network, run by the enigmatic Charlie Ergen, put forward a highly conditional offer for Clearwire, a spectrum owner integral to the ambitions 