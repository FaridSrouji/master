: 'https://www.nytimes.com/2013/01/19/nyregion/recuperating-and-focusing-anew-on-elusive-goals.html', 'snippet': 'Chola Mapoma immigrated from Zambia in hopes of getting a great job and helping his family back home, but it has not worked out that way.', 'lead_paragraph': 'Although Chola Mapoma is recovering from a battle with prostate cancer, the last thing on his mind is rest.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/nyregion/NEEDIEST/NEEDIEST-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/nyregion/NEEDIEST/NEEDIEST-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/nyregion/NEEDIEST/NEEDIEST-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/19/nyregion/NEEDIEST/NEEDIEST-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/19/nyregion/NEEDIEST/NEEDIEST-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Recuperating, and Focusing Anew on Elusive Goals', 'kicker': 'The Neediest Cases', 'content_kicker': None, 'print_headline': 'Recuperating, and Focusing Anew on Elusive Goals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Anderson, Marvin', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Catholic Charities Brooklyn and Queens', 'ra