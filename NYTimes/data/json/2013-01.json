, 'major': 'N'}, {'name': 'persons', 'value': 'Xi Jinping', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Southern Weekend (Chinese Newspaper)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-01-06T23:18:02+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Ian Johnson', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/3f022e4d-0366-5e2d-989b-809854182f5b', 'word_count': 968, 'uri': 'nyt://article/3f022e4d-0366-5e2d-989b-809854182f5b'}, {'abstract': 'Dr. Li’s calculations in the early 1960s helped guide the development of the laser and propel the dizzying increase in the speed of fiber-optic communication.', 'web_url': 'https://www.nytimes.com/2013/01/07/business/tingye-li-instrumental-in-the-lasers-development-dies-at-81.html', 'snippet': 'Dr. Li’s calculations in the early 1960s helped guide the development of the laser and propel the dizzying increase in the speed of fiber-optic communication.', 'lead_paragraph': 'Tingye Li, an electrical engineer whose calculations in the early 1960s helped guide the development of the laser and propel the dizzying increase in the speed of fiber-optic communication, died on Dec. 27 in Snowbird, Utah. He was 81. ', 'print_section': 'D', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/07/business/li-obit/li-obit-jumbo.jpg', 'height': 852, 'width': 590, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/07/business/li-obit/li-obit-superJumbo.jpg', 'height': 852, 'width': 590, 'subType': 'superJumbo'