s/mag-20Lives-t_CA0-superJumbo.jpg', 'height': 450, 'width': 450, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20lives/20lives-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/20/magazine/20lives/20lives-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20lives/20lives-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Squash’s Preppy Problem', 'kicker': 'Lives', 'content_kicker': None, 'print_headline': 'Court of Public Opinion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Squash (Sport)', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-18T16:16:31+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Ivy Pochoda', 'person': [{'firstname': 'Ivy', 'middlename': None, 'lastname': 'Pochoda', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6ba4c6e7-e5b3-5c01-affc-7015bd6fb527', 'word_count': 712, 'uri': 'nyt://article/6ba4c6e7-e5b3-5c01-affc-7015bd6fb527'}, {'abstract': 'The community buzz about a family’s hive.', 'web_url': 'https://www.nytimes.com/2013/01/20/magazine/should-your-neighbors-allergy-be-your-concern.html', 'snippet': 'The community buzz about a family’s hive.', 'lead_paragraph': 'Our daughter and her husband own their home, and on their property, they keep a beehive as a hobby. A family of four just moved in next door (a father, mother and two small children). The father told our daughter that three members of the family are allergic to bee stings. He is concerned about the beehive. Assuming that keeping bees on your property is legal, what should prevail here — the law or ethics? NAME WITHHELD', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20ethicist/20ethicist-jumbo.jpg', 'height': 402, 'width': 402, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20ethicist/20ethicist-superJumbo.jpg', 'height': 402, 'width': 402, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20ethicist/20ethicist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/20/magazine/20ethicist/20ethicist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20ethicist/20ethicist-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Should Your Neighbor’s Allergy Be Your Concern?', 'kicker': 'The Ethicist', 'content_kicker': None, 'print_headline': 'Neighborhood Buzz', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bees', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Klosterman, Chuck', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wills and Estates', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-18T16:16:32+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Chuck Klosterman', 'person': [{'firstname': 'Chuck', 'middlename': None, 'lastname': 'Klosterman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/0f9fbd4a-c2e1-531b-b9f4-aeaeb6a72903', 'word_count': 504, 'uri': 'nyt://article/0f9fbd4a-c2e1-531b-b9f4-aeaeb6a72903'}, {'abstract': 'Plus: Tips from an Emmy-winning makeup artist.', 'web_url': 'https://www.nytimes.com/2013/01/20/magazine/who-made-those-false-eyelashes.html', 'snippet': 'Plus: Tips from an Emmy-winning makeup artist.', 'lead_paragraph': 'One day in 1916, while filming “Intolerance,” D. W. Griffith studied an actress in a Babylonian costume and felt something wasn’t right. Seena Owen’s eyes, he said, should be twice as large and “supernatural.” He ordered his wigmaker to use spirit gum to glue a pair of lashes made from human hair onto Owen’s eyelids. “One morning she arrived at the studio with her eyes swollen nearly shut,” the actress Lillian Gish, who was also in the movie, wrote in her memoir. “Fortunately, Mr. Griffith had already shot the important scenes.” Within a decade, false lashes became standard equipment for actresses — and for flappers who imitated the “baby doll” eyes that they saw on-screen.', 'print_section': 'MM', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/20/magazine/20wmt/20wmt-articleLarge-v2.jpg', 'height': 322, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/20/magazine/20wmt/20wmt-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 322}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'image