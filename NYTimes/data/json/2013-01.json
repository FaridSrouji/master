ce': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Was Dear Abby’s Most Helpful Advice?', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Phillips, Pauline (1918-2013)', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-17T20:13:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Michael Roston', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Roston', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92be81c9-f410-55ca-955c-b6cb439ab293', 'word_count': 518, 'uri': 'nyt://article/92be81c9-f410-55ca-955c-b6cb439ab293'}, {'abstract': 'The French actress wears a tartanesque dress to the Conan O’Brien show.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/01/17/look-of-the-moment-marion-cotillard-3/', 'snippet': 'The French actress wears a tartanesque dress to the Conan O’Brien show.', 'lead_paragraph': 'The Look: Mad for Plaid. A dress with a trompe l’oeil tartanesque effect in sequins is made even prettier with pastel rose appliqués.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Look of The Moment | Marion Cotillard', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cotillard, Marion', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-17T20:18:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c9a51be8-ec4a-58a3-9c4f