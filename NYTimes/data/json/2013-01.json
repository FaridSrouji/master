 'lastname': 'Davidson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a9939a7-06fe-5990-98e4-83650dc23209', 'word_count': 1215, 'uri': 'nyt://article/4a9939a7-06fe-5990-98e4-83650dc23209'}, {'abstract': 'President Obama likes most parts of an immigration proposal devised by a bipartisan group of senators.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/01/29/obama-speech-expected-to-embrace-immigration-plan/', 'snippet': 'President Obama likes most parts of an immigration proposal devised by a bipartisan group of senators.', 'lead_paragraph': 'WASHINGTON – President Obama is expected to embrace an ambitious proposal by a bipartisan group of senators to overhaul the nation’s immigration laws, using a speech in Las Vegas Tuesday as a call to arms for one of his top legislative priorities.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama Speech Expected to Embrace Immigration Plan', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Carney, Jay', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Las Vegas (Nev)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Nevada', 'rank': 11, 'ma