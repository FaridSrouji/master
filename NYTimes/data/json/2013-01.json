Large', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/us/20130129-LAND-slide-7TAE/20130129-LAND-slide-7TAE-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Changing Face of a Small Kentucky Town', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Kentucky', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Vicco (Ky)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-29T01:41:53+0000', 'document_type': 'multimedia', 'news_desk': 'U.S.', 'section_name': 'U.S.', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4bc2d654-e866-5adc-9128-673154b84dfb', 'word_count': 0, 'uri': 'nyt://slideshow/4bc2d654-e866-5adc-9128-673154b84dfb'}, {'abstract': 'The Supreme Court announced Monday that six former leaders of Colonia Dignidad, a German sect in southern Chile, had been sentenced to 5 to 11 years in prison.', 'web_url': 'https://www.nytimes.com/2013/01/29/world/americas/former-leaders-of-german-sect-in-chile-sentenced.html', 'snippet': 'The Supreme Court announced Monday that six former leaders of Colonia Dignidad, a German sect in southern Chile, had been sentenced to 5 to 11 years in prison.', 'lead_paragraph': ' The Supreme Court announced Monday that six former leaders of Colonia Dignidad, a German sect in southern Chile, had been sentenced to 5 to 11 years in prison for acting as accomplices to the sect’s leader, Paul Schäfer, in the sexual abuse of minors in the 1990s. Ten other defendants received suspended sentences. One of the six, Dr. Harmut Hopp, fled to Germany in 2011, and the German government has denied Chile’s requests for his extradition. Mr. Schäfer founded the self-sufficient religious sect in 1961 after fleeing West Germany, where he was accused of sexually abusing boys. He died in prison in 2010 while serving a 20-year sentence for the sexual abuse of 25 minors at the sect’s compound. Colonia Dignidad also served as a clandestine torture center during the dictatorship of Gen. Augusto Pinochet, according to official human rights reports. ', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chile: Former Leaders of German Sect Sentenced', 'kicker': 'World Briefing | The Americas', 'content_kicker': None, 'print_headline': 'Chile: Former Leaders of German Sect Sentenced', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Colonia Dignidad', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Chile', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Schafer, Paul', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-01-29T01:41:54+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Pascale Bonnefoy', 'person': [{'firstname': 'Pascale', 'middlename': None, 'lastname': 'Bonnefoy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/406936a6-a622-57a7-b0ac-ea31b980f579', 'word_count': 141, 'uri': 'nyt://article/406936a6-a622-57a7-b0ac-ea31b980f579'}, {'abstract': 'The minister of prisons, Iris Varela, said Monday that a prison clash that broke out Friday between inmates and National Guard soldiers had killed 58 people and injured 95.', 'web_url': 'https://www.nytimes.com/2013/01/29/world/americas/official-death-toll-in-venezuela-prison-clash-is-58.html', 'snippet': 'The minister of prisons, Iris Varela, said Monday that a prison clash that broke out Friday between inmates and National Guard soldiers had killed 58 people and injured 95.', 'lead_paragraph': ' The minister of prisons, Iris Varela, said Monday that a prison clash that broke out Friday between inmates and National Guard soldiers had killed 58 people and injured 95. The director of a hospital where the bodies were taken had previously said that 61 people had been killed and 120 injured. Most of the dead were inmates. On Sunday, officials said that they had moved more than 2,000 prisoners from the prison in Barquisimeto, a northwestern city, and sent them to other prisons around the country. The mayhem occurred after troops were sent to search the notoriously violent prison for weapons and establish order. Government opponents have criticized the handling of the episode and say that moving prisoners to other overcrowded facilities will make conditions at those prisons worse. ', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Venezuela: Official Death Toll in Prison Clash Is 58', 'kicker': 'World Briefing | The Americas', 'content_kicker': None, 'print_headline': 'Venezuela: Official Death Toll in Prison Clash Is 58', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Venezuela', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-29T01:42:19+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By William Neuman', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Neuman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/0376405d-8272-53f0-876a-622c692f9f11', 'word_count': 129, 'uri': 'nyt://article/0376405d-8272-53f0-876a-622c692f9f11'}, {'abstract': 'In a move condemned by critics as a tacit surrender, the Transportation Department has begun removing all “Don’t Honk” signs from the streets.', 'web_url': 'https://www.nytimes.com/2013/01/29/nyregion/new-york-removes-no-honking-signs.html', 'snippet': 'In a move condemned by critics as a tacit surrender, the Transportation Department has begun removing all “Don’t Honk” signs from the streets.', 'lead_paragraph': 'Cabbies do it from the back of a taxi line at the Port Authority Bus Terminal, coaxing their colleagues to move up a spot. Commuters do it at the mouth of the Holland Tunnel, flabbergasted that others in a city of eight million might share their route. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/HONKING1/HONKING1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/29/nyregion/HONKING1/HONKING1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/HONKING1/HONKING1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/HONKING1/HONKING1-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/HONKING1/HONKING1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/29/nyregion/HONKING1/HONKING1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/HONKING1/HONKING1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stop the Honking? New York Suggests It’s a Lost Cause', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stop the Honking? New York Suggests It’s a Lost Cause', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Noise', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Roads and Traffic', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Transportation Department (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Traffic Signals and Signs', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-01-29T01:45:47+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a5ca249f-d084-52a8-8482-15bd7c7a8469', 'word_count': 985, 'uri': 'nyt://article/a5ca249f-d084-52a8-8482-15bd7c7a8469'}, {'abstract': 'The plan released by eight senators sets the stage for reform. It is encouraging that a path to citizenship for illegal immigrants exists at all.', 'web_url': 'https://www.nytimes.com/2013/01/29/opinion/immigration-reform-has-finally-begun.html', 'snippet': 'The plan released by eight senators sets the stage for reform. It is encouraging that a path to citizenship for illegal immigrants exists at all.', 'lead_paragraph': 'The thousand-mile journey to comprehensive immigration reform has begun, as you might expect for Washington, with a single memo. Eight senators, four from each party, released it on Monday: a statement of principles behind a deal to overhaul the system in one big bill. It calls for more border and workplace enforcement, more visas for needed workers and legalization — with a path to citizenship — for 11 million undocumented immigrants. ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Now We’re Talking', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Now We’re Talking', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Citizenship and Naturalization', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Schumer, Charles E', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'McCain, John', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Durbin, Richard J', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Graham, Lindsey', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Menendez, Robert', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Bennet, Michael Farrand', 'rank': 13, 'major': 'N'}, {'name': 'persons', 'value': 'Flake, Jeffrey L', 'rank': 14, 'major': 'N'}], 'pub_date': '2013-01-29T01:49:53+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/3ad53714-16fb-558f-b0e0-64d84f607bc5', 'word_count': 694, 'uri': 'nyt://article/3ad53714-16fb-558f-b0e0-64d84f607bc5'}, {'abstract': 'The Metropolitan Transportation Authority said installing safety doors could be prohibitively expensive, but put forth the idea of a system to detect when someone is on the tracks.', 'web_url': 'https://www.nytimes.com/2013/01/29/nyregion/mta-says-subway-platform-gates-could-cost-1-billion.html', 'snippet': 'The Metropolitan Transportation Authority said installing safety doors could be prohibitively expensive, but put forth the idea of a system to detect when someone is on the tracks.', 'lead_paragraph': 'Amid a spate of deaths on New York’s subway tracks, Metropolitan Transportation Authority officials cautioned on Monday that any plan to install platform safety doors throughout the system could be prohibitively expensive, but they introduced another possibility: a high-tech system that would detect a person on the tracks.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/Y-SUBWAY/Y-SUBWAY-articleLarge.jpg', 'height': 550, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/29/nyregion/Y-SUBWAY/Y-SUBWAY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 550}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/Y-SUBWAY/Y-SUBWAY-jumbo.jpg', 'height': 866, 'width': 944, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/nyregion/Y-SUBWAY/Y-SUBWAY-superJumbo.jpg', 'height': 866,