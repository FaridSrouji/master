': 'N'}], 'pub_date': '2013-01-09T22:41:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Vikas Bajaj', 'person': [{'firstname': 'Vikas', 'middlename': None, 'lastname': 'Bajaj', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d19b0b7c-6e64-5c73-98fe-774883cde0c6', 'word_count': 357, 'uri': 'nyt://article/d19b0b7c-6e64-5c73-98fe-774883cde0c6'}, {'abstract': 'The departure of Secretary of Labor Hilda L. Solis removes another woman from the cabinet as President Obama’s personnel choices are drawing scrutiny for lack of female candidates.', 'web_url': 'https://www.nytimes.com/2013/01/10/business/solis-stepping-down-as-labor-secretary.html', 'snippet': 'The departure of Secretary of Labor Hilda L. Solis removes another woman from the cabinet as President Obama’s personnel choices are drawing scrutiny for lack of female candidates.', 'lead_paragraph': 'WASHINGTON – Secretary of Labor Hilda L. Solis announced on Wednesday that she was stepping down, becoming the latest woman to leave President Obama’s cabinet at a time when his personnel choices are drawing scrutiny for their lack of female candidates.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Solis Stepping Down as Labor Secretary', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Solis, Hilda L', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Labor Department (US)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Suspensions, Dismissals and Resignations', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-09T22:51:02+0000', 'document_type': 'ar