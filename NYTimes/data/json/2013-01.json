+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/1e0ee380-69f0-531f-9f14-4550ae85ab4e', 'word_count': 828, 'uri': 'nyt://article/1e0ee380-69f0-531f-9f14-4550ae85ab4e'}, {'abstract': 'The public domain hero discusses a bulldozer safety video and his recipe for durian cheesecake.', 'web_url': 'https://www.nytimes.com/2013/01/27/opinion/sunday/catching-up-with-carl-malamud.html', 'snippet': 'The public domain hero discusses a bulldozer safety video and his recipe for durian cheesecake.', 'lead_paragraph': 'Carl Malamud is the founder and president of the nonprofit Public.Resource.Org. An activist archivist, he has become a public domain hero by making local, state and federal documents freely available online.', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/sunday-review/0127download/0127download-articleLarge.jpg', 'height': 1029, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/27/sunday-review/0127download/0127download-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1029}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/sunday-review/0127download/0127download-jumbo.jpg', 'height': 1024, 'width': 598, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/sunday-review/0127download/0127download-superJumbo.jpg', 'height': 2048, 'width': 1195, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url'