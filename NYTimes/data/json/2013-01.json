': {'xlarge': 'images/2013/01/31/business/Auto/Auto-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/business/Auto/Auto-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/business/Auto/Auto-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/business/Auto/Auto-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/31/business/Auto/Auto-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/business/Auto/Auto-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chrysler’s Earnings Soar, Raising Fiat’s With Them', 'kicker': None, 'content_kicker': None, 'print_headline': 'Chrysler’s Earnings Soar, Raising Fiat’s With Them', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Chrysler Group LLC', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Company Reports', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Fiat SpA', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-30T13:01:00+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Bill Vlasic', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Vlasic', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ce6b8e25-d5aa-5151-b2cc-56e8bedffcea', 'word_count': 720, 'uri': 'nyt://article/ce6b8e25-d5aa-5151-b2cc-56e8bedffcea'}, {'abstract': 'Visceral dislike of easy money does not a sound analysis make.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/01/30/calvinist-monetary-economics/', 'snippet': 'Visceral dislike of easy money does not a sound analysis make.', 'lead_paragraph': 'Aha. In his latest op-ed, John Taylor comes out as a full-fledged monetary Calvinist. No, not a disciple of John Calvin, the preacher — a disciple of Calvin of Calvin and Hobbes.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Calvinist Monetary Economics', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-30T13:01:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6fb5e183-f0c6-50b4-8e7e-8c88b664d5d8', 'word_count': 347, 'uri': 'nyt://article/6fb5e183-f0c6-50b4-8e7e-8c88b664d5d8'}, {'abstract': 'When a cubicle is the classroom, who is grading the companies? Research suggests many colleges are ignoring their oversight responsibilities.', 'web_url': 'https://www.nytimes.com/2013/02/03/education/edlife/internships-for-credit-merited-or-not.html', 'snippet': 'When a cubicle is the classroom, who is grading the companies? Research suggests many colleges are ignoring their oversight responsibilities.', 'lead_paragraph': 'JOB listings on Craigslist these days are full of companies looking for young people willing to work for no salary. In New York, internships are available at businesses ranging from advertising agencies in midtown to a “cake studio” in Brooklyn. They want people who are “positive” and “energetic.” And one more thing: they want college students. As one agency looking for an unpaid videographer put it, “PLEASE NOTE: You must be in school and receive school credit in order to join us.”', 'print_section': 'ED', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/education/edl-03work-t_CA0/edl-03work-t_CA0-jumbo.jpg', 'height': 1024, 'width': 514, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/education/edl-03work-t_CA0/edl-03work-t_CA0-superJumbo.jpg', 'height': 1116, 'width': 560, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/education/edl-03work-t_CA0/edl-03work-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/02/03/education/edl-03work-t_CA0/edl-03work-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/03/education/edl-03work-t_CA0/edl-03work-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Giving Credit, but Is It Due?', 'kicker': 'Internships | Viewpoint', 'content_kicker': None, 'print_headline': 'Giving Credit, But Is It Due?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Internships', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges a