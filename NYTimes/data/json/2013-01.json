: 'N'}, {'name': 'persons', 'value': 'Laurer, George', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Bar Codes', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-04T16:18:29+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Pagan Kennedy', 'person': [{'firstname': 'Pagan', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/999ee09d-d882-545a-99d9-be3718336e2b', 'word_count': 433, 'uri': 'nyt://article/999ee09d-d882-545a-99d9-be3718336e2b'}, {'abstract': 'Readers respond.', 'web_url': 'https://www.nytimes.com/2013/01/06/magazine/the-12-23-12-issue.html', 'snippet': 'Readers respond.', 'lead_paragraph': 'JERRY SEINFELD', 'print_section': 'MM', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The 12.23.12 Issue', 'kicker': 'Reply All | Letters', 'content_kicker': None, 'print_headline': 'The 12.23.12 Issue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-04T16:18:32+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/02528e80-edf0-5db3-97aa-8d656657892f', 'word_count': 728, 'uri': 'nyt://article/02528e80-edf0-5db3-97aa-8d656657892f'}, {'abstract': 'Yes. But that’s the point.', 'web_url': 'https://www.nytimes.com/2013/01/06/magazine/does-an-honor-code-make-it-too-easy-to-cheat.html', 'snippet': 'Yes. But that’s the point.', 'lead_paragraph': 'I’m a student at a university with an honor code that is taken very seriously. Professors place a lot of trust in students’ integrity: they assign take-home exams with conditions (no access to textbooks, notes or Internet) and they leave offices containing answer keys unlocked at all hours. Although I have never taken advantage of this trust, it has occurred to me that it would be easy to do so with little probability of being caught. I imagine this puts struggling students in an ethically precarious position. Do professors (and people in general) have an obligation to avoid creating situations in which it is both tempting and easy for others to behave unethically? ILANA WALDER-BIESANZ, BOSTON', 'print_section': 'MM', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06ethicist/06ethicist-jumbo.jpg', 'height': 402, 'width': 402, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06ethicist/06ethicist-superJumbo.jpg', 'height': 402, 'width': 402, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06ethicist/06ethicist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/06/magazine/06ethicist/06ethicist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06ethicist/06ethicist-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Does an Honor Code Make It Too Easy to Cheat?', 'kicker': 'The Ethicist', 'content_kicker': None, 'print_headline': 'Honor Among Students', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Klosterman, Chuck', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Lying', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cheating', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Ethicist, The (Times Column)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Tips and Tipping', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Blood Donation', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-01-04T16:18:33+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Chuck Klosterman', 'person': [{'firstname': 'Chuck', 'middlename': None, 'lastname': 'Klosterman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/6090f50a-20b8-508a-a355-14bc243158e4', 'word_count': 869, 'uri': 'nyt://article/6090f50a-20b8-508a-a355-14bc243158e4'}, {'abstract': 'The former presidential hopeful says being known as the sane, honest Republican doesn’t play well in primaries.', 'web_url': 'https://www.nytimes.com/2013/01/06/magazine/jon-huntsman-could-do-without-bill-clintons-kudos.html', 'snippet': 'The former presidential hopeful says being known as the sane, honest Republican doesn’t play well in primaries.', 'lead_paragraph': 'So if you’re running for president in 2016, you probably have to start laying the groundwork now, right?  Can you imagine we’re even talking about this? It’s mind-numbing that within 24 hours, people want to start talking about 2016.', 'print_section': 'MM', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06subtalk/06subtalk-jumbo-v3.jpg', 'height': 845, 'width': 316, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06subtalk/06subtalk-superJumbo-v3.jpg', 'height': 845, 'width': 316, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06subtalk/06subtalk-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/06/magazine/06subtalk/06subtalk-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06subtalk/06subtalk-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jon Huntsman Could Do Without Bill Clinton’s Kudos', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'Frontier House', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Huntsman, Jon M Jr', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Goldman, Andrew', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-04T16:18:37+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Andrew Goldman', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Goldman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/3a75b32e-8c5d-5174-beaf-31dd947f86ac', 'word_count': 688, 'uri': 'nyt://article/3a75b32e-8c5d-5174-beaf-31dd947f86ac'}, {'abstract': 'What’s the value of a million-dollar idea that you never follow up on?', 'web_url': 'https://www.nytimes.com/2013/01/06/magazine/be-wrong-as-fast-as-you-can.html', 'snippet': 'What’s the value of a million-dollar idea that you never follow up on?', 'lead_paragraph': 'Here’s a partial, redacted-for-the-sake-of-my-dignity list of stuff I once aspired to write but never did: a “Mamma Mia!”-esque rock opera called “Bastards of Young,” based on the songs of the Replacements. A sitcom set in Brooklyn that inverts “I Love Lucy,” so that the wife plays the stable, amiable breadwinner while her lovable loon of a husband hatches ridiculous schemes, often involving the production of artisanal goods. A thriller about the ultimate rogue trader who concocts a single, diabolical transaction to blow up the financial system. An HBO show, called “Upstate,” about a burned-out corporate raider who returns to his hometown outside Buffalo to save his father’s failing liquor store and ends up trying to rescue the whole town from the double scourge of unemployment and alcoholism. Too depressing? How about this: A reality show in which retired hockey greats like Wayne Gretzky and Mark Messier compete against each other coaching teams of — ready for the deal clincher? — inner-city kids who’ve never been on ice skates.', 'print_section': 'MM', 'print_page': '44', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06riff/06riff-articleLarge-v2.jpg', 'height': 96, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/06/magazine/06riff/06riff-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 96}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06riff/06riff-jumbo-v2.jpg', 'height': 163, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06riff/06riff-superJumbo-v2.jpg', 'height': 249, 'width': 1562, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06riff/06riff-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/06/magazine/06riff/06riff-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06riff/06riff-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Be Wrong as Fast as You Can’', 'kicker': 'Riff', 'content_kicker': None, 'print_headline': '‘Be Wrong As Fast As You Can’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lindren, Hugo', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Creativity', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-04T16:18:38+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Hugo Lindgren', 'person': [{'firstname': 'Hugo', 'middlename': None, 'lastname': 'Lindgren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2e662652-84a5-5e0c-9a45-f2f3ade9eb2e', 'word_count': 1901, 'uri': 'nyt://article/2e662652-84a5-5e0c-9a45-f2f3ade9eb2e'}, {'abstract': 'I said goodbye to my husband. Could I do the same with his stuff?', 'web_url': 'https://www.nytimes.com/2013/01/06/magazine/my-personal-storage-wars.html', 'snippet': 'I said goodbye to my husband. Could I do the same with his stuff?', 'lead_paragraph': 'When my husband, Mike, died of lung cancer five years ago at age 36, I was a very sad widow. I cried a lot. I took to bed. But eventually, I decided I’d had enough. ', 'print_section': 'MM', 'print_page': '50', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06lives1/06lives1-jumbo-v2.jpg', 'height': 302, 'width': 413, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06lives1/06lives1-superJumbo-v2.jpg', 'height': 302, 'width': 413, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06lives1/06lives1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/06/magazine/06lives1/06lives1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/06/magazine/06lives1/06lives1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Personal ‘Storage Wars’', 'kicker': 'Lives', 'content_kicker': None, 'print_headline': 'Store No More', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schwartz, Karen', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Storage', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Death and Dying', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-04T16:18:40+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Karen Schwartz', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/831665fe-e7ec-505c-b302-334c46aa0baf', 'word_count': 816, 'uri': 'nyt://article/831665fe-e7ec-505c-b302-334c46aa0baf'}, {'abstract': 'Since offering to name a character in his next novel after the person who finds his lost beagle, Tessa, Dennis Lehane has not yet located the dog. But an online search effort continues.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/01/04/lehane-continues-search-for-missing-dog/', 'snippet': 'Since offering to name a character in his next novel after the person who finds his lost beagle, Tessa, Dennis Lehane has not yet located the dog. But an online search effort continues.', 'lead_paragraph': 'More than a week after appealing to the public for help in finding his lost dog, Tessa — and offering a role in his next novel as a reward to the person who finds her — the author Dennis Lehane has not yet located his missing pet, but he has not given up hope.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/04/arts/lehane/lehane-jumbo.jpg', 'height': 423, 'width': 630, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/04/arts/lehane/lehane-superJumbo.jpg', 'height': 423, 'width': 630, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013