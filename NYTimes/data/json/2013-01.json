ic', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rattle, Simon', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Berlin Philharmonic', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Berlin (Germany)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-10T17:09:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melissa Eddy', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Eddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2eabbcae-0119-5f6e-84bc-40e8c052b746', 'word_count': 373, 'uri': 'nyt://article/2eabbcae-0119-5f6e-84bc-40e8c052b746'}, {'abstract': '“Planning and system failures” were largely responsible for cutting off millions of people from emergency 911 call centers after the derecho storm in June, the Federal Communications Commission said.', 'web_url': 'https://www.nytimes.com/2013/01/11/business/911-failure-in-storm-was-preventable-fcc-says.html', 'snippet': '“Planning and system failures” were largely responsible for cutting off millions of people from emergency 911 call centers after the derecho storm in June, the Federal Communications Commission said.', 'lead_paragraph': 'WASHINGTON — Two days before a fast-moving, powerful windstorm swept across the mid-Atlantic last June, Verizon tested the backup power generator at its central office in Arlington, Va., and it failed.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/11/business/FCC/FCC-articleLarge.jpg', 'height': 316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/11/business/FC