_of_material': 'News', '_id': 'nyt://article/8180bc8a-5727-5590-b4f3-be464993a2cf', 'word_count': 409, 'uri': 'nyt://article/8180bc8a-5727-5590-b4f3-be464993a2cf'}, {'abstract': 'Two masked gunmen wearing tactical-style vests shot Mark E. Hasse as he walked to the courthouse, officials said.', 'web_url': 'https://www.nytimes.com/2013/02/01/us/prosecutor-fatally-shot-in-town-near-dallas.html', 'snippet': 'Two masked gunmen wearing tactical-style vests shot Mark E. Hasse as he walked to the courthouse, officials said.', 'lead_paragraph': 'KAUFMAN, Tex. — A county prosecutor in this small town southeast of Dallas was fatally shot on Thursday morning near the courthouse by one or perhaps two gunmen, whom witnesses described as wearing masks, black clothing and tactical-style vests, the authorities said.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/01/us/PROSECUTOR2/PROSECUTOR2-articleLarge.jpg', 'height': 847, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/02/01/us/PROSECUTOR2/PROSECUTOR2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 847}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/01/us/PROSECUTOR2/PROSECUTOR2-jumbo.jpg', 'height': 1024, 'width': 726, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/01/us/PROSECUTOR2/PROSECUTOR2-superJumbo.jpg', 'height': 1265, 'width': 896, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/02/01/us/PROSECUTOR2/PROSECUTOR2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy