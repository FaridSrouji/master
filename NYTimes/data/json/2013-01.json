 None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6e93342-0d16-5b56-8481-443183e288ee', 'word_count': 569, 'uri': 'nyt://article/d6e93342-0d16-5b56-8481-443183e288ee'}, {'abstract': 'The American designer brings his idiosyncratic, organic and slightly surreal furniture to Friedman Benda in Chelsea.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/01/10/art-house-wendell-castle/', 'snippet': 'The American designer brings his idiosyncratic, organic and slightly surreal furniture to Friedman Benda in Chelsea.', 'lead_paragraph': 'The American designer Wendell Castle is known for his idiosyncratic, organic and slightly surreal furniture, which he has been producing in laminated wood, plastic and other materials since the 1960s, and which is highly collectible. Castle, who turned 80 in 2012, showed his work at Design Miami last month, and today his exhibition “A New Environment” opens at Friedman Benda in Chelsea. (Another Castle show, “Volumes and Voids,” is on view just upstairs from Friedman Benda at the Barry Friedman Gallery through Jan. 26.)', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Art House | Wendell Castle', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Living High', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Castle, Wendell', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-10T20:00:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Pilar Viladas', 'person': [{'firstname': 'Pilar', 'middlename': None, 'lastname': 'Viladas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39b7b78b-db4c-5d3c-9752-b8dc043e75bc', 'word_count': 469, 'uri': 'nyt://article/39b7b78b-db4c-5d3c-9752-b8dc043e75bc'}, {'abstract': 'John Gatins spent years on the screenplay for “Flight” and still can’t quite believe he was nominated for an Oscar.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2013/01/10/flights-screenwriter-is-just-thrilled-his-name-was-pronounced-right/', 'snippet': 'John Gatins spent years on the screenplay for “Flight” and still can’t quite believe he was nominated for an Oscar.', 'lead_paragraph': 'Sure, John Gatins managed to somehow turn a grim script he’d repeatedly abandoned over more than a decade into an acclaimed studio film, “Flight,” that netted him his first Oscar nomination. But the improbable part of the whole thing, for Mr. Gatins, was that Emma Stone managed to pronounce his name correctly when she announced his Oscar nomination early Thursday morning.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Flight’s’ Screenwriter Is Just Thrilled His Name Was Pronounced Right', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-10T20:00:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Jeremy Egner', 'person': [{'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Egner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2352a11f-881c-5d39-8eb4-2673096d33c3', 'word_count': 647, 'uri': 'nyt://article/2352a11f-881c-5d39-8eb4-2673096d33c3'}, {'abstract': 'The foreign ministers of Japan and the Philippines proclaimed their nations to be strategic partners that would collaborate more in resolving their separate territorial disputes with China.', 'web_url': 'https://www.nytimes.com/2013/01/11/world/asia/japan-and-philippines-to-bolster-maritime-cooperation.html', 'snippet': 'The foreign ministers of Japan and the Philippines proclaimed their nations to be strategic partners that would collaborate more in resolving their separate territorial disputes with China.', 'lead_paragraph': 'TOKYO — In a telling sign of how China’s rise has helped turn former wartime foes into allies, Japan and the Philippines agreed on Thursday to cooperate more closely on maritime security.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'To Counter China, Japan and Philippines Will Bolster Maritime Cooperation', 'kicker': None, 'content_kicker': None, 'print_headline': 'Japan: Deal Reached With Philippines\r\nAs a Security Counterweight to China', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Japan', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Philippines', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-10T20:00:55+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Martin Fackler', 'person': [{'firstname': 'Martin', 'middlename': None, 'lastname': 'Fackler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b3af2a7-bbe9-59c5-aa46-aeda44eb9f0e', 'word_count': 561, 'uri': 'nyt://article/6b3af2a7-bbe9-59c5-aa46-aeda44eb9f0e'}, {'abstract': 'Is the coin solution a bad idea precisely because it will work?', 'web_url': 'https://krugman.blogs.nytimes.com/2013/01/10/thinking-about-the-brink/', 'snippet': 'Is the coin solution a bad idea precisely because it will work?', 'lead_paragraph': 'The platinum coin discussion has moved with startling speed, from an idea nobody took seriously (and which, as I’ve mentioned, senior officials were unaware of just last month), to assertions that it’s ridiculous and illegal, to grudging acknowledgment that it’s almost surely legal coupled with strained attempts to dismiss it as an option nonetheless. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Thinking About the Brink', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-10T20:02:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d38d7f70-44d6-50f4-bb5e-abc1ea772bab', 'word_count': 689, 'uri': 'nyt://article/d38d7f70-44d6-50f4-bb5e-abc1ea772bab'}, {'abstract': '“The Civil War in America,” a Library of Congress exhibition to commemorate the war’s 150th anniversary, displays more than 200 letters, diaries, documents and images.', 'web_url': 'https://www.nytimes.com/2013/01/11/arts/design/the-civil-war-in-america-at-library-of-congress.html', 'snippet': '“The Civil War in America,” a Library of Congress exhibition to commemorate the war’s 150th anniversary, displays more than 200 letters, diaries, documents and images.', 'lead_paragraph': 'WASHINGTON — In the pursuit of justice, what is unjustified? Are there limits to what may be done in service to a righteous cause? Abstract philosophical questions, perhaps, but also political ones. And in thinking about the Civil War, the answers affect our understanding of that bloody conflict.', 'print_section': 'C', 'print_page': '33', 'source': 'The New Yo