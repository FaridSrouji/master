redit': None, 'type': 'image', 'url': 'images/2013/01/28/arts/28artsbeat-ross/28artsbeat-ross-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Shots Fired at Car Driven by Rick Ross', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Shots Fired at Car Driven by Rick Ross', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ross, Rick', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Fort Lauderdale (Fla)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-28T16:24:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/87867f47-830b-5555-8eac-32b9a3597224', 'word_count': 155, 'uri': 'nyt://article/87867f47-830b-5555-8eac-32b9a3597224'}, {'abstract': 'The celebrated value investor Warren E. Buffett ultimately did not raise his bid to top IntercontinentalExchange’s $8.2 billion proposal.', 'web_url': 'https://dealbook.nytimes.com/2013/01/28/buffett-said-to-have-expressed-interest-in-buying-nyse-euronext/', 'snippet': 'The celebrated value investor Warren E. Buffett ultimately did not raise his bid to top IntercontinentalExchange’s $8.2 billion proposal.', 'lead_paragraph': 'Warren E. Buffett has built one of the world’s great fortunes looking for companies undervalued by the markets. For a short while, it appears, he considered the New York Stock Exchange’s parent company one of those potential deal targets.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Buffett Said to Have Weighed Deal for NYSE Euronext', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Buffett Said to Have Weighed NYSE Euronext', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Buffett, Warren E', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Berkshire Hathaway Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'IntercontinentalExchange Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'NYSE Euronext', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-28T16:27:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7228d9e-94b7-58f7-9b5b-7871251b38cb', 'word_count': 613, 'uri': 'nyt://article/d7228d9e-94b7-58f7-9b5b-7871251b38cb'}, {'abstract': 'The English design house has created a dual-function bag: a purse with a removable, zip-off envelope pouch.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/01/28/feeling-for-mulberrys-willow-tote/', 'snippet': 'The English design house has created a dual-function bag: a purse with a removable, zip-off envelope pouch.', 'lead_paragraph': 'The English design house Mulberry has named its bags after pop culture obsessions like Alexa Chung and Lana del Rey, but its latest\xa0— prominently featured on the spring runways\xa0—\xa0is named after the brand’s newest factory, the Willow. As functional as its namesake, the purse features a removable, zip-off envelope pouch that sits atop a large tote without looking bulky. “I wanted to explore the simplicity of an elegant envelope shape,” the creative director Emma Hill says. “The idea of having two bags in one means you have a clutch bag at the ready and then the tote has plenty of space inside.” Hill confesses to hoarding an assortment of things for her son inside hers, but “it’s important that a bag becomes part of you, and not the other way around.” It’s available in three sizes\xa0—\xa0the smallest is a cross-body style and the biggest is weekend-ready. Hill’s favorite: “The Willow tote in black ostrich feels special, luxurious and a bag to keep for life.”', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Feeling For | Mulberry’s Willow Tote', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'A Workhorse Of a Tote', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-28T16:30:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a2a92856-5945-5172-8ddc-615b0842c739', 'word_count': 175, 'uri': 'nyt://article/a2a92856-5945-5172-8ddc-615b0842c739'}, {'abstract': 'TimesCast: Egyptian authorities try to contain widening unrest. | French legislature to debate same-sex marriage bill. | Behind a bipartisan Senate plan to reform immigration.', 'web_url': 'https://www.nytimes.com/video/world/100000002029626/morsis-state-of-emergency.html', 'snippet': 'TimesCast: Egyptian authorities try to contain widening unrest. | French legislature to debate same-sex marriage bill. | Behind a bipartisan Senate plan to reform immigration.', 'lead_paragraph': 'TimesCast: Egyptian authorities try to contain widening unrest. | French legislature to debate same-sex marriage bill. | Behind a bipartisan Senate plan to reform immigration.', 's