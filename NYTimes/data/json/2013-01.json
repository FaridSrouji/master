7b-b0dc-2286e98c7dc2', 'word_count': 171, 'uri': 'nyt://article/86df98ca-1668-5c7b-b0dc-2286e98c7dc2'}, {'abstract': 'Raymond Felton, out since breaking his pinkie in late December, is expected to start on Saturday against the 76ers.', 'web_url': 'https://www.nytimes.com/2013/01/26/sports/basketball/return-of-raymond-felton-will-give-knicks-healthy-core.html', 'snippet': 'Raymond Felton, out since breaking his pinkie in late December, is expected to start on Saturday against the 76ers.', 'lead_paragraph': 'PHILADELPHIA — It has taken nearly half the season, but the Knicks are finally in a position to evaluate their core as constructed. Their new bench star, Amar’e Stoudemire, returned from injury this month, and their athletic wing, Iman Shumpert, came back last week. But with their older role players beginning to wear out, the Knicks were starting to show their age.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'With Felton Ready, Knicks Can Field Healthy Core', 'kicker': None, 'content_kicker': None, 'print_headline': 'Felton’s Return\r\nTo Give Knicks\r\nA Healthy Core', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Knicks', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Felton, Raymond', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kidd, Jason', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shumpert, Iman', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': "Stoudemire, Amar'e", 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'ANTHONY, CARMELO', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, J R', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-01-26T02:41:15+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Tim Rohan', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Rohan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/acafa480-1648-52f0-a04e-9c2ce671509f', 'word_count': 512, 'uri': 'nyt://article/acafa480-1648-52f0-a04e-9c2ce671509f'}, {'abstract': 'Bistro Latino, the third name for Rafael Palomino’s restaurant in Old Greenwich, comes from the title of a cookbook written by the chef.', 'web_url': 'https://www.nytimes.com/2013/01/27/nyregion/a-review-of-bistro-latino-in-old-greenwich.html', 'snippet': 'Bistro Latino, the third name for Rafael Palomino’s restaurant in Old Greenwich, comes from the title of a cookbook written by the chef.', 'lead_paragraph': 'Bistro Latino is the third name for Rafael Palomino’s restaurant on the Post Road in Old Greenwich, and this time he seems to have gotten it right. It began as Palomino, became Greenwich Tavern and was recently transformed into this Spanish-South American place. Considering that Señor Palomino himself is from Colombia, the Latin American theme would seem to be a natural fit. When I asked Moe Gad, his partner, about the significance of the new name, he said: “Bistro Latino was the name of Chef Palomino’s first cookbook in 1996. It’s like returning to our roots.” ', 'print_section': 'CT', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/nyregion/27DINECT1/27DINECT1-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/27/nyregion/27DINECT1/27DINECT1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/27/nyregion/27DINECT1/27DINECT1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo'