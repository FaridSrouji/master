None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/905bb331-daff-5fa4-a60d-14f9c33cf4d2', 'word_count': 309, 'uri': 'nyt://article/905bb331-daff-5fa4-a60d-14f9c33cf4d2'}, {'abstract': 'Hillary Rodham Clinton received a lighthearted offering from her staff at the State Department, where she returned for the first time after being treated for a blot clot in her brain.', 'web_url': 'https://www.nytimes.com/2013/01/08/us/politics/clinton-returns-to-work-at-state-department.html', 'snippet': 'Hillary Rodham Clinton received a lighthearted offering from her staff at the State Department, where she returned for the first time after being treated for a blot clot in her brain.', 'lead_paragraph': 'WASHINGTON — Secretary of State Hillary Rodham Clinton got some padded protection to go along with her security entourage when she returned to work Monday.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/us/08clinton-click/08clinton-click-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/us/08clinton-click/08clinton-click-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/us/08clinton-click/08clinton-click-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/08/us/08clinton-click/08clinton-click-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type'