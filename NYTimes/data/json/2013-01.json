'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Flannery, Tony', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Wills, Garry', 'rank': 9, 'major': 'N'}, {'name': 'creative_works', 'value': 'Why Priests? A Failed Tradition (Book)', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-01-26T18:34:05+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Frank Bruni', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/4d28f7fd-f407-5893-b110-3e1c16e7e813', 'word_count': 1111, 'uri': 'nyt://article/4d28f7fd-f407-5893-b110-3e1c16e7e813'}, {'abstract': 'The British prime minister is ambivalent about his country’s future in the European Union, but he can’t pretend to have it both ways.', 'web_url': 'https://www.nytimes.com/2013/01/27/opinion/sunday/prime-minister-camerons-european-fantasy.html', 'snippet': 'The British prime minister is ambivalent about his country’s future in the European Union, but he can’t pretend to have it both ways.', 'lead_paragraph': 'Prime Minister David Cameron, like much of the British public, is ambivalent about his country’s future in the European Union. He correctly recognizes that a Britain outside the union would count for less in world affairs, forfeit the privileged access it now enjoys to its largest trading partner, and lose its seat at the European table where matters of great importance to Britain are discussed — from cross-border banking rules to environmental regulation. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mr. Cameron’s European Fantasy', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Mr. Cameron’s European Fantasy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Great Britain', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cameron, David', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-26T18:34:05+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/dc960855-5b51-5729-938a-8b98a851d204', 'word_count': 494, 'uri': 'nyt://article/dc960855-5b51-5729-938a-8b98a851d204'}, {'abstract': 'Sheryl Sandberg, the No. 2 executive at Facebook, offers a provocative take on why women are so underrepresented in leadership positions.', 'web_url': 'https://www.nytimes.com/2013/01/27/opinion/sunday/kristof-shes-rarely-the-boss.html', 'snippet': 'Sheryl Sandberg, the No. 2 executive at Facebook, offers a provocative take on why women are so underrepresented in leadership positions.', 'lead_paragraph': 'DAVOS, Switzerland', 'print_section': 'SR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-articleLarge-v2.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-articleLarge-v2.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-jumbo-v2.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'imag