on': [{'firstname': 'Didi', 'middlename': 'Kirsten', 'lastname': 'Tatlow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03df442a-9e3b-551e-a97f-f8d4e5cf7181', 'word_count': 1346, 'uri': 'nyt://article/03df442a-9e3b-551e-a97f-f8d4e5cf7181'}, {'abstract': 'Chinese demonstrators call for a free press; global cooperation on Syria and chemical arms; another delay for Berlin’s new airport; Google’s chairman goes to Pyongyang.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2013/01/08/iht-quick-read-jan-8/', 'snippet': 'Chinese demonstrators call for a free press; global cooperation on Syria and chemical arms; another delay for Berlin’s new airport; Google’s chairman goes to Pyongyang.', 'lead_paragraph': 'NEWS A battle over media censorship in China intensified Monday with an outpouring of support for journalists at a Guangzhou newspaper who are protesting what they called overbearing censorship by provincial officials. Edward Wong reports from Beijing. Also Monday, state media said China would start reforming its draconian system of re-education through labor, as Andrew Jacobs reports from Beijing.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/blogs/china-rdv/china-rdv-jumbo.jpg', 'height': 637, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/blogs/china-rdv/china-rdv-superJumbo.jpg', 'height': 1274, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/blogs/china-rdv/china-rdv-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/08/blogs/china-rdv/china-rdv-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/blogs/china-rdv/china-rdv-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'IHT Quick Read: Jan. 8', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-08T08:19:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By The International Herald Tribune', 'person': [], 'organization': 'The International Herald Tribune'}, 'type_of_material': 'News', '_id': 'nyt://article/422697d6-e5cb-5023-8007-61b5220fdd90', 'word_count': 357, 'uri': 'nyt://article/422697d6-e5cb-5023-8007-61b5220fdd90'}, {'abstract': 'An agreement to defuse a strike by Chinese journalists had been reached by early Wednesday, although several reporters said the deal could fall apart.', 'web_url': 'https://www.nytimes.com/2013/01/09/world/asia/faceoff-in-chinese-city-over-censorship-of-newspaper.html', 'snippet': 'An agreement to defuse a strike by Chinese journalists had been reached by early Wednesday, although several reporters said the deal could fall apart.', 'lead_paragraph': 'GUANGZHOU, China — A tentative agreement to defuse a newsroom strike by Chinese journalists over censorship controls in this southeastern provincial capital had been reached by early Wednesday, and some reporters working for Southern Weekend, the newspaper at the heart of the dispute, were told that the paper would publish as usual on Thursday, one journalist in the newsroom said.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/world/asia/09china-span/09china-span-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/09/world/asia/09china-span/09china-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/world/asia/09china-span/09china-span-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/world/asia/09china-span/09china-span-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/world/asia/09china-span/09china-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/09/world/asia/09china-span/09china-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/09/world/asia/09china-span/09china-span-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tentative Deal Reported in Chinese Censorship Dispute', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tentative Deal Is Reached With Journalists Protesting Censorship at Chinese Newspaper', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Southern Weekend (Chinese Newspaper)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank':