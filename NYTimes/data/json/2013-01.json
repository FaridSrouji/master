'}], 'pub_date': '2013-01-03T21:27:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jason Polan', 'person': [{'firstname': 'Jason', 'middlename': None, 'lastname': 'Polan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf3c8c48-15b9-5461-b695-fac589afa62f', 'word_count': 21, 'uri': 'nyt://article/cf3c8c48-15b9-5461-b695-fac589afa62f'}, {'abstract': 'An exhibition match between one of Italy’s leading soccer teams and a lower division club was abandoned on Thursday after a black player responded to racist chanting from fans by kicking a ball into the stands and walking off the field.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/01/03/soccer-team-walks-out-on-racist-fans-in-italy/', 'snippet': 'An exhibition match between one of Italy’s leading soccer teams and a lower division club was abandoned on Thursday after a black player responded to racist chanting from fans by kicking a ball into the stands and walking off the field.', 'lead_paragraph': 'As my colleague Jack Bell reports, an exhibition match between one of Italy’s leading soccer teams and a lower division club was abandoned on Thursday after a black player responded to racist chanting from fans by kicking a ball into the stands and walking off the field in Busto Arsizio, outside Milan.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Soccer Team Walks Out on Racist Fans in Italy', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Discrimination', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Milan (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-