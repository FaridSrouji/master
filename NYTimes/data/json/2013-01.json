es on YouTube. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/arts/31CARPETBAGGER-jp1/31CARPETBAGGER-jp1-articleLarge.jpg', 'height': 323, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/31/arts/31CARPETBAGGER-jp1/31CARPETBAGGER-jp1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 323}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/arts/31CARPETBAGGER-jp1/31CARPETBAGGER-jp1-jumbo.jpg', 'height': 551, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/arts/31CARPETBAGGER-jp1/31CARPETBAGGER-jp1-superJumbo.jpg', 'height': 1101, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/arts/31CARPETBAGGER-jp1/31CARPETBAGGER-jp1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/31/arts/31CARPETBAGGER-jp1/31CARPETBAGGER-jp1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/arts/31CARPETBAGGER-jp1/31CARPETBAGGER-jp1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Animation Basks in Oscar Spotlight', 'kicker': 'The Carpetbagger', 'content_kicker': None, 'print_headline': 'Animation Basks In Oscar Spotlight', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 2, 'major': 