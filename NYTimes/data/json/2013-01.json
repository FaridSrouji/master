5-standardinline/norris-75-standardinline-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2010/04/19/business/norris-75-standardinline/norris-75-standardinline-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Housing Offers Hope of Strength in the Economy', 'kicker': 'High & Low Finance', 'content_kicker': None, 'print_headline': 'Housing Offers Hope Of Strength In Economy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-01-24T20:36:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Floyd Norris', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8eadd97-cf16-5f24-aa6b-f0c00af9969f', 'word_count': 1226, 'uri': 'nyt://article/f8eadd97-cf16-5f24-aa6b-f0c00af9969f'}, {'abstract': 'Shaun Marcum, a right-handed pitcher, agreed to a one-year deal with the Mets. But outfielder Scott Hairston agreed to a two-year deal with the Cubs, according to a published report.', 'web_url': 'https://bats.blogs.nytimes.com/2013/01/24/mets-to-gain-marcum-but-lose-hairston/', 'snippet': 'Shaun Marcum, a right-handed pitcher, agreed to a one-year deal with the Mets. But outfielder Scott Hairston agreed to a two-year deal with the Cubs, according to a published report.', 'lead_paragraph': 'The Mets became the last of the 30 baseball teams to acquire a major league free agent this off-season when they agreed to terms with Shaun Marcum on Thursday. A veteran right-handed pitcher, Marcum agreed to a one-year deal, according to a Major League Baseball official with direct knowledge of the agreement.', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mets Acquiring Marcum but Losing Hairston', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': 'Quiet Mets Are Said To Acquire A Starter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hairston, Scott', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-24T20:38:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3a56fc2c-efc1-56a5-98e5-50e3b6ff2cac', 'word_count': 315, 'uri': 'nyt://article/3a56fc2c-efc1-56a5-98e5-50e3b6ff2cac'}, {'abstract': 'At Han Joo, each tabletop grill uses infrared heat to cook everything to an eerie evenness. You miss the drama of a typical Korean barbecue joint, but it’s hard to argue with results.', 'web_url': 'https://www.nytimes.com/2013/01/30/dining/reviews/hungry-city-han-joo-in-the-east-village.html', 'snippet': 'At Han Joo, each tabletop grill uses infrared heat to cook everything to an eerie evenness. You miss the drama of a typical Korean barbecue joint, but it’s hard to argue with results.', 'lead_paragraph': 'ON A CRYSTAL SLAB lie scarlet ribbons of meat with a bridal trim of fat, hissing and collapsing. Gone is the thunderhead of smoke you expect at a Korean barbecue joint, the constant scraping of the hot plate, the burned debris. At Han Joo, each tabletop grill uses infrared heat to cook everything to an eerie evenness.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/30/dining/30HUNGRY_SPAN/30HUNGRY_SPAN-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/30/dining/30HUNGRY_SPAN/30HUNGRY_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/30/dining/30HUNGRY_SPAN/30HUNGRY_SPAN-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/30/dining/30HUNGRY_SPAN/30HUNGRY_SPAN-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/30/dining/30HUNGRY_SPAN/30HUNGRY_SPAN-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/30/dining/30HUNGRY_SPAN/30HUNGRY_SPAN-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/30/dining/30HUNGRY_SPAN/30HUNGRY_SPAN-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'There’s No Smoke, but You’ll Find Fire', 'kicker': 'Hungry City', 'content_kicker': None, 'print_headline': 'There’s No Smoke, but You’ll Find Fire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'East