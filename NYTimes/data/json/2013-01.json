b9-9635-5ba3f046ec2d'}, {'abstract': 'The trade journal, which reported on consumer product marketing for almost 20 years until its closing in April 2011, is being revived, at least in name.', 'web_url': 'https://www.nytimes.com/2013/01/15/business/media/brandweeks-obituary-proves-premature.html', 'snippet': 'The trade journal, which reported on consumer product marketing for almost 20 years until its closing in April 2011, is being revived, at least in name.', 'lead_paragraph': 'A FAMILIAR name on Madison Avenue is making a kind of comeback.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/business/ADCO-1/ADCO-1-articleLarge.jpg', 'height': 297, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/15/business/ADCO-1/ADCO-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 297}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/business/ADCO-1/ADCO-1-jumbo.jpg', 'height': 447, 'width': 903, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/15/business/ADCO-1/ADCO-1-superJumbo.jpg', 'height': 447, 'width': 903, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Brandweek’s Obituary Proves Premature', 'kicker': 'Advertising', 'content_kicker': None, 'print_headline': 'A Trade Journal’s Obituary Proves Premature', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Elliott, Stuart', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'ADWEEK', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Brandweek', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Mediaweek', 'rank': 4, 'major': 'N'}, {'na