ne': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c08ccbc8-3d56-5d00-a917-50d81d0ca270', 'word_count': 752, 'uri': 'nyt://article/c08ccbc8-3d56-5d00-a917-50d81d0ca270'}, {'abstract': 'ABC’s Tuesday-night comedy block has run into ratings difficulties.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/01/25/trouble-on-tuesday-nights/', 'snippet': 'ABC’s Tuesday-night comedy block has run into ratings difficulties.', 'lead_paragraph': 'Every broadcast television network has a slate with shows that do not perform to expectations. Take Tuesdays on ABC. This week, the series premiere of “The Taste,” a cooking competition show in the mold of “The Voice” on NBC, drew 5.8 million total viewers, according to Nielsen data. That is a decent audience sampling, but ultimately unimpressive considering its time slot competitor, the very popular “NCIS” on CBS, was a repeat.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Trouble on Tuesday Nights', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'ABC INC', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-25T19:53:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Adam Kepler', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8fe9655-a19d-5577-833c-3504f2b63eb1', 'word_count': 258, 'uri': 'nyt://article/f8fe9655-a19d-5577-833c-3504f2b63eb1'}, {'abstract': 'The star-laden Lakers entered Friday’s game 17-25, with conditions worsening by the day.', 'web_url': 'https://www.nytimes.com/2013/01/26/sports/basketball/lakers-glass-appears-empty-at-halfway-mark.html', 'snippet': 'The star-laden Lakers entered Friday’s game 17-25, with conditions worsening by the day.', 'lead_paragraph': 'LOS ANGELES — As Kobe Bryant tries to make sense of this train wreck of a season, he may want to note that Lakers stars of the past sometimes felt miserable, too.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/sports/26lakers/26lakers-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/26/sports/26lakers/26lakers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/sports/26lakers/26lakers-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/sports/26lakers/26lakers-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/sports/26lakers/26lakers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/26/sports/26lakers/26lakers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/sports/26lakers/26lakers-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline'