 '_id': 'nyt://article/602f681c-e674-533c-b527-b6ad8672d6c4', 'word_count': 828, 'uri': 'nyt://article/602f681c-e674-533c-b527-b6ad8672d6c4'}, {'abstract': 'The National Transportation Safety Board said an examination of an undamaged battery with the same design as one that caught fire in a parked plane in Boston found nothing out of the ordinary.', 'web_url': 'https://www.nytimes.com/2013/01/28/business/backup-battery-in-787-had-no-obvious-anomalies-report-says.html', 'snippet': 'The National Transportation Safety Board said an examination of an undamaged battery with the same design as one that caught fire in a parked plane in Boston found nothing out of the ordinary.', 'lead_paragraph': 'WASHINGTON — Although a fire destroyed one of two big batteries on a Boeing 787 parked at Logan Airport in Boston three weeks ago, a quick examination of the second battery found “no obvious anomalies,” the National Transportation Safety Board said on Sunday.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Defect Is Found in Another 787 Battery', 'kicker': None, 'content_kicker': None, 'print_headline': 'No Defect Is Found In Another 787 Battery', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Boeing Company', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Batteries', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Transportation Safety Board', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Aviation Accidents and Safety', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-01-27T20:51:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Matthew L. Wald', 'person': [{'firstname': 'Matthew', 'middlename': 'L.', 'lastname': 'Wald', 'qualifier': None, 'title': None, 'role': 'reported', 'organ