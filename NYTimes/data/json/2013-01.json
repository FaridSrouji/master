: 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/13/travel/13FRUGAL/13FRUGAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/13/travel/13FRUGAL/13FRUGAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/13/travel/13FRUGAL/13FRUGAL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Travel Savings in 2013, Go Retro', 'kicker': 'Frugal Traveler', 'content_kicker': None, 'print_headline': 'For Savings in 2013, Go Retro', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Budget Travel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-08T20:26:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Seth Kugel', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Kugel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/47c3bb25-0399-5a81-ba8b-fd86b1fed542', 'word_count': 1191, 'uri': 'nyt://article/47c3bb25-0399-5a81-ba8b-fd86b1fed542'}, {'abstract': 'Who wins and who loses in the Directors Guild of America nominations.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2013/01/08/a-setback-for-david-o-russell-a-boon-for-ang-lee-and-tom-hooper/', 'snippet': 'Who wins and who loses in the Directors Guild of America nominations.', 'lead_paragraph': '“The problem is, there are six guys for five slots,” a veteran awards watcher has been telling the Bagger all season long, and today, with the Directors Guild announcing its nominees, it appears that David O. Russell may be the odd man out.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Setback for David O. Russell, a Boon for Ang Lee and Tom Hooper', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-08T20:32:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f83b7e1a-0652-542d-bb18-84a3619cd3b5', 'word_count': 321, 'uri': 'nyt://article/f83b7e1a-0652-542d-bb18-84a3619cd3b5'}, {'abstract': 'To believe in the MenScience skin care line, you have to believe in the program, which is why the products have a medicinal air. They’re efficient, to the point.', 'web_url': 'https://www.nytimes.com/2013/01/10/fashion/menscience-opens-flagship-store-in-new-york.html', 'snippet': 'To believe in the MenScience skin care line, you have to believe in the program, which is why the products have a medicinal air. They’re efficient, to the point.', 'lead_paragraph': 'YES, I slept terribly last night. And the one before. And the month before that. The why matters, but only somewhat. Bad sleep is an effect game, because there will always be a cause. The problem is going to persist — how do you mask it?', 'print_section': 'E', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/10/fashion/10CRITICAL1_SPAN/10zCRITICAL1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'art