', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/25/arts/artsspecial/20130127BEST-slide-LHMQ/20130127BEST-slide-LHMQ-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Week in Culture Pictures, Jan. 25', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-25T20:20:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/c846059d-f3d2-5ef8-96b6-632826785746', 'word_count': 13, 'uri': 'nyt://article/c846059d-f3d2-5ef8-96b6-632826785746'}, {'abstract': 'When parents feel like the baby sitter ranks higher than they do on a child’s list of “my favorite people.”', 'web_url': 'https://parenting.blogs.nytimes.com/2013/01/25/does-your-child-like-your-baby-sitter-best/', 'snippet': 'When parents feel like the baby sitter ranks higher than they do on a child’s list of “my favorite people.”', 'lead_paragraph': 'This week’s quandary comes via Michelle Cove and Facebook. Michelle (the author of “I Love Mondays, and Other Confessions From Devoted Working Moms”) was speaking at a “Parent Talk” event when a parent put up a hand and asked, “What do you do when you truly believe your kid likes the nanny/baby sitter better?”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Does Your Child Like Your Baby Sitter Best?', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parenting', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-25T20:22:22+0000', 'document_type': 'article', 'news_desk': '', 'section_nam