 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The South’s Orneriest General', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Tennessee', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-07T18:20:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Terry L. Jones', 'person': [{'firstname': 'Terry', 'middlename': 'L.', 'lastname': 'Jones', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c900af1-91ed-53ac-878c-510c12269335', 'word_count': 1963, 'uri': 'nyt://article/6c900af1-91ed-53ac-878c-510c12269335'}, {'abstract': 'Amid recession and violence, the resilience of Chatham, on Chicago’s South Side, bolsters a theory that sees a community’s character as the key to its success.', 'web_url': 'https://www.nytimes.com/2013/01/08/science/lessons-in-community-from-chicagos-south-side.html', 'snippet': 'Amid recession and violence, the resilience of Chatham, on Chicago’s South Side, bolsters a theory that sees a community’s character as the key to its success.', 'lead_paragraph': 'CHICAGO — The neighborhood’s best-known restaurants were failing, its crime rate was on the rise, and for the first time that anyone could remember there were foreclosures, with once tidy bungalows sitting empty and dark.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/science/08CHIC2_SPAN/08CHIC2_SPAN-articleLarge-v3.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/08/science/08CHIC2_SPAN/08CHIC2_SPAN