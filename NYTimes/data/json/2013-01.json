two shots at his head.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/world/26israeliwomen_inline/26israeliwomen_inline-articleLarge.jpg', 'height': 405, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/26/world/26israeliwomen_inline/26israeliwomen_inline-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 405}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/world/26israeliwomen_inline/26israeliwomen_inline-jumbo.jpg', 'height': 691, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/world/26israeliwomen_inline/26israeliwomen_inline-superJumbo.jpg', 'height': 1381, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/world/26israeliwomen_inline/26israeliwomen_inline-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/26/world/26israeliwomen_inline/26israeliwomen_inline-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/26/world/26israeliwomen_inline/26israeliwomen_inline-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Looking to Israel for Clues on Women in Combat', 'kicker': None, 'content_kicker': None, 'print_headline': 'Looking to Israel for Clues on Women in Combat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1