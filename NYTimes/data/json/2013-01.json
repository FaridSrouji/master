ations', 'value': 'National Football League', 'rank': 16, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco 49ers', 'rank': 17, 'major': 'N'}, {'name': 'organizations', 'value': 'Baltimore Ravens', 'rank': 18, 'major': 'N'}, {'name': 'persons', 'value': 'Murray, Andy (1987- )', 'rank': 19, 'major': 'N'}], 'pub_date': '2013-01-28T16:06:24+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd18bee2-6c5a-5831-a2a1-fe20b16d5512', 'word_count': 797, 'uri': 'nyt://article/dd18bee2-6c5a-5831-a2a1-fe20b16d5512'}, {'abstract': 'A foray into gluten-free baking results in some delicious muffins.', 'web_url': 'https://www.nytimes.com/2013/01/28/health/gluten-free-banana-chocolate-muffins.html', 'snippet': 'A foray into gluten-free baking results in some delicious muffins.', 'lead_paragraph': 'My son Liam still doesn’t know that the muffins he has been devouring all week are gluten-free. I am a big believer that there is no need to forego gluten unless you are truly gluten intolerant; indeed, nutritionists are concerned that a gluten-free diet can be lacking in essential nutrients and digestive enzymes. But I have a sister who is gluten intolerant, so this year I finally made some forays into gluten-free baking in preparation for her annual visit. When she comes I make sure to pick up plenty of gluten-free pasta and bread for her, and we go to holiday parties armed with gluten-free crackers so she doesn’t have to forego hors d’oeuvres.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/28recipehealth/28recipehealth-articleLarge-v2.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/29/science/28recipehealth/28recipehealth-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 403}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/28recipehealth/28recipehealth-jumbo-v2.jpg', 'height': 688, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/28recipehealth/28recipehealth-superJumbo-v2.jpg', 'height': 1375, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/28recipehealth/28recipehealth-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/29/science/28recipehealth/28recipehealth-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/29/science/28recipehealth/28recipehealth-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Hodgepodge of Muffins, All Gluten-Free', 'kicker': 'Recipes for Health', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gluten', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Muffins', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-28T16:15:37+0000', 'document