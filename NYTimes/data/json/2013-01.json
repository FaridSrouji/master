itle': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6198b2e8-118f-5cb4-9a0f-7e84e2d6783c', 'word_count': 1042, 'uri': 'nyt://article/6198b2e8-118f-5cb4-9a0f-7e84e2d6783c'}, {'abstract': 'The 49ers are only one month removed from their last — and worst — loss of the season, a thumping by Seattle that almost cost them a first-round bye.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2013/01/29/can-the-ravens-learn-anything-from-42-13/', 'snippet': 'The 49ers are only one month removed from their last — and worst — loss of the season, a thumping by Seattle that almost cost them a first-round bye.', 'lead_paragraph': 'San Francisco and Colin Kaepernick scored a lot of points (73) and gained a lot of yards (952) in their impressive run in the N.F.C. playoffs, one reason they’re favored to win the Super Bowl against Baltimore.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Can the Ravens Learn Anything From 42-13?', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Baltimore Ravens', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco 49ers', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-29T11:00:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By George Bretherton', 'person': [{'firstname': 'George', 'middlename': None, 'lastname': 'Bretherton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/93f897d7-c065-52d7-aaaa-08c4ff1ff6fb', 'word_count': 611, 'uri': 'nyt://article/93f897d7-c065-5