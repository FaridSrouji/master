fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photos of the Moment | Alexander McQueen', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-01-09T17:12:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Roberta Ridolfi', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Ridolfi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5460484c-1fa2-54f9-ae0b-0f078856d76b', 'word_count': 36, 'uri': 'nyt://article/5460484c-1fa2-54f9-ae0b-0f078856d76b'}, {'abstract': 'After several delays and setbacks, the makers of the Pebble wristwatch, a device that can wirelessly link to a smartphone and that raised more than $10 million on Kickstarter, say they are finally ready to start shipping to eager customers.', 'web_url': 'https://bits.blogs.nytimes.com/2013/01/09/after-delays-pebble-smartwatch-will-ship-january-23/', 'snippet': 'After several delays and setbacks, the makers of the Pebble wristwatch, a device that can wirelessly link to a smartphone and that raised more than $10 million on Kickstarter, say they are finally ready to start shipping to eager customers.', 'lead_paragraph': 'Pebble, the much-hyped wristwatch designed to connect wirelessly to smartphones to display information like text messages, whipped the Web into a frenzy last May when the project raised more than $10 million through Kickstarter, one of the crowdfunding platform’s largest campaigns to date.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/blogs/pebble/pebble-jumb