rd Plantation Course.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/sports/YJPGOLF/YJPGOLF-articleLarge.jpg', 'height': 402, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/08/sports/YJPGOLF/YJPGOLF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 402}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/sports/YJPGOLF/YJPGOLF-jumbo.jpg', 'height': 686, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/sports/YJPGOLF/YJPGOLF-superJumbo.jpg', 'height': 1372, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/sports/YJPGOLF/YJPGOLF-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/08/sports/YJPGOLF/YJPGOLF-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/08/sports/YJPGOLF/YJPGOLF-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stricker Hangs In While Cutting Back', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stricker Hangs In While Cutting Back', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Stricker, Steve', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Pettersson, Carl', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Golf', 'rank': 4, 'major': 'N'}, {'name'