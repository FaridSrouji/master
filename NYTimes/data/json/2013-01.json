mes', 'multimedia': [], 'headline': {'main': 'Hiring Outside Advisers Is as Important as Hiring Employees', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hiring and Promotion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-01-24T18:00:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Josh Patrick', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Patrick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a79bac8f-29f3-5bef-8f96-def86f02151b', 'word_count': 716, 'uri': 'nyt://article/a79bac8f-29f3-5bef-8f96-def86f02151b'}, {'abstract': 'Marriott International will double the number of its hotels in Latin America and the Caribbean in the next five years.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/01/24/more-marriotts-in-latin-america/', 'snippet': 'Marriott International will double the number of its hotels in Latin America and the Caribbean in the next five years.', 'lead_paragraph': 'Marriott International this year plans to open properties in Santiago, Chile (above); Cali, Colombia; and several cities across Mexico as part of a five-year expansion in which it will double the number of its hotels in Latin America and the Caribbean. Most of those new hotels are geared toward business travelers, a focus that allows Marriott to profit from the region’s recent economic boom.', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'More Marriotts in Latin America', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': 'Hotels: More Marriotts in Latin America', 'name': None, 's