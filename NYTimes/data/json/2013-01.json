'name': 'glocations', 'value': 'Syria', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Damascus (Syria)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ALEPPO (SYRIA)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-01-02T00:14:04+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Anne Barnard', 'person': [{'firstname': 'Anne', 'middlename': None, 'lastname': 'Barnard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/cca15e45-f216-5509-b736-52c0feea6f92', 'word_count': 104, 'uri': 'nyt://article/cca15e45-f216-5509-b736-52c0feea6f92'}, {'abstract': 'Emmanuelle Riva, revered for her role in “Hiroshima Mon Amour,” is getting prizes for her work in Michael Haneke’s “Amour,” but says she never wanted to be a star.', 'web_url': 'https://www.nytimes.com/2013/01/02/movies/emmanuelle-riva-of-amour-from-new-wave-to-new-stardom.html', 'snippet': 'Emmanuelle Riva, revered for her role in “Hiroshima Mon Amour,” is getting prizes for her work in Michael Haneke’s “Amour,” but says she never wanted to be a star.', 'lead_paragraph': 'PARIS — The actress Emmanuelle Riva, a symbol of the French New Wave and now an octogenarian, wasn’t giving much thought to success or even finding a lead role in a film after her last one some 20 years ago. But when the Austrian director Michael Haneke, whose work she had long admired, offered her a starring part in “Amour,” a poignant tale of love and death set in a book-filled Paris apartment, she said yes instantly. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/02/arts/02RIVA/02RIVA-articleLarge-v2.jpg', 'height': 386, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleL