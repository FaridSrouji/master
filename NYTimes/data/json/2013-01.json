 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bc913f3-11b1-5cf7-a692-b01ebd5dd982', 'word_count': 151, 'uri': 'nyt://article/6bc913f3-11b1-5cf7-a692-b01ebd5dd982'}, {'abstract': 'A new gadget replicates a television’s winking light to scare off prowlers.', 'web_url': 'https://www.nytimes.com/2013/01/31/garden/faketv-can-fool-intruders.html', 'snippet': 'A new gadget replicates a television’s winking light to scare off prowlers.', 'lead_paragraph': 'You might not be home every evening watching television, but no burglar needs to know that. The coruscating light of a television set — signature feature of an occupied home — might be enough to scare prowlers off.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31SECURITY/31CURR5-articleLarge.jpg', 'height': 510, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/31/garden/31SECURITY/31CURR5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 510}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31SECURITY/31CURR5-jumbo.jpg', 'height': 870, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31SECURITY/31CURR5-superJumbo.jpg', 'height': 1641, 'width': 1932, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31SECURITY/31CURR5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/31/garden/31SECURITY/31CURR5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31SECURITY/31CURR5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stay Tuned for Another Flicker', 'kicker': 'Currents | Security', 'content_kicker': None, 'print_headline': 'Stay Tuned For Another Flicker', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cohen, Joyce', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Security and Warning Systems', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Readler, Blaine', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-01-30T23:33:40+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Joyce Cohen', 'person': [{'firstname': 'Joyce', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7dbcb88c-7e22-550b-8915-f960dc0bfee0', 'word_count': 159, 'uri': 'nyt://article/7dbcb88c-7e22-550b-8915-f960dc0bfee0'}, {'abstract': 'A sculptor creates tiny colorful houses that combat the winter blues.', 'web_url': 'https://www.nytimes.com/2013/01/31/garden/tiny-houses-that-brighten-the-day.html', 'snippet': 'A sculptor creates tiny colorful houses that combat the winter blues.', 'lead_paragraph': 'The Vermont artist Leslie Fry is known for her large outdoor sculptures, often fanciful creatures that are part flora, part fauna. Last year, in South Korea, she created a 10-foot-long piece for the Songchu Art Valley of a human head with flowers, which seems, like many of her works, to be growing up out of the ground. Recently Ms. Fry attempted sculptures scaled for inside the house. “I have a lot of architectural elements in my work” she said, “and I wanted to try pieces that were small and inexpensive.” The result, a perfect antidote to the gray days of winter, is the Rainbow Rowhouse, a translucent resin house 5 inches tall and 3 inches wide. The houses can be ordered individually for $25, or as a set of eight for $150. Upon request, a hole will be drilled in each house to enable it to be hung. Information: etsy.com/shop/FryDay.\xa0', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31GOODS/31CURR6-articleLarge.jpg', 'height': 815, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/01/31/garden/31GOODS/31CURR6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 815}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31GOODS/31CURR6-jumbo.jpg', 'height': 1024, 'width': 755, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31GOODS/31CURR6-superJumbo.jpg', 'height': 1872, 'width': 1379, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31GOODS/31GOODS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/01/31/garden/31GOODS/31GOODS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/01/31/garden/31GOODS/31GOODS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'leg