perience.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ten Hard-Earned Lessons About Selling a Business', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Small Business', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-01-16T12:00:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Josh Patrick', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Patrick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7d5b3ae6-406c-54ab-9606-6096a8715443', 'word_count': 853, 'uri': 'nyt://article/7d5b3ae6-406c-54ab-9606-6096a8715443'}, {'abstract': 'JPMorgan Chase trumpeted a strong quarter of earnings, although the bank sharply cut the pay of its chief executive, Jamie Dimon, by 50 percent, in light of a multibillion-dollar trading loss last year.', 'web_url': 'https://dealbook.nytimes.com/2013/01/16/jpmorgan-4th-quarter-profit-jumps-53-to-5-7-billion/', 'snippet': 'JPMorgan Chase trumpeted a strong quarter of earnings, although the bank sharply cut the pay of its chief executive, Jamie Dimon, by 50 percent, in light of a multibillion-dollar trading loss last year.', 'lead_paragraph': 'Even as profit surged, the board of JPMorgan Chase cut the pay package of its chief executive, Jamie Dimon, by 50 percent, in light of a multibillion-dollar trading loss last year.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'JPMorgan Cuts Dimon’s Pay, Even as Profit Surges', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Braunstein, Douglas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dimon