_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Hiroko Tabuchi', 'person': [{'firstname': 'Hiroko', 'middlename': None, 'lastname': 'Tabuchi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/192c5d20-e7d9-58e3-9889-0ae46eb21ec7', 'word_count': 802, 'uri': 'nyt://article/192c5d20-e7d9-58e3-9889-0ae46eb21ec7'}, {'abstract': 'Tottenham would move Gareth Bale, its talented Welsh wing, to Real Madrid for a price that would almost certainly top the world-record fee that Madrid paid to acquire Cristiano Ronaldo in 2009.', 'web_url': 'https://www.nytimes.com/2013/08/24/sports/soccer/transfer-of-bale-to-madrid-is-near.html', 'snippet': 'Tottenham would move Gareth Bale, its talented Welsh wing, to Real Madrid for a price that would almost certainly top the world-record fee that Madrid paid to acquire Cristiano Ronaldo in 2009.', 'lead_paragraph': 'The Gareth Bale transfer drama appeared Friday to be reaching its merciful, and seemingly inevitable, end. Tottenham Hotspur worked to complete a deal to move Bale, its talented Welsh wing, to Real Madrid for a price that would almost certainly top the world-record fee that Madrid paid to acquire Cristiano Ronaldo in 2009. ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Biggest Sale of Year in Europe Appears to Be Near Finish', 'kicker': None, 'content_kicker': None, 'print_headline': 'Biggest Sale of Year In Europe Appears To Be Near Finish', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Borden, Sam', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bale, Gareth', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Tottenham Hotspur (Soccer Team)', 'rank': 4, 'major': 'N'}, {'nam