ntirely at odds with the dominant culture.', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/18ALMOND/18ALMOND-articleLarge.jpg', 'height': 638, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/18/books/review/18ALMOND/18ALMOND-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 638}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/18ALMOND/18ALMOND-jumbo.jpg', 'height': 1024, 'width': 963, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/18ALMOND/18ALMOND-superJumbo.jpg', 'height': 1168, 'width': 1098, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/18ALMOND/18ALMOND-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/18/books/review/18ALMOND/18ALMOND-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/18ALMOND/18ALMOND-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Service Jobs', 'kicker': None, 'content_kicker': None, 'print_headline': 'Service Jobs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Almond, Steve', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sayrafiezadeh, Said', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': '