orted', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b6fca313-1bd6-56c1-a1a4-5b4c3dcfe3d9', 'word_count': 356, 'uri': 'nyt://article/b6fca313-1bd6-56c1-a1a4-5b4c3dcfe3d9'}, {'abstract': 'The recent sales of The Boston Globe and The Washington Post make The New York Times the nation’s last major newspaper run by a family.', 'web_url': 'https://www.nytimes.com/2013/08/08/business/media/times-co-chairman-declares-paper-not-for-sale.html', 'snippet': 'The recent sales of The Boston Globe and The Washington Post make The New York Times the nation’s last major newspaper run by a family.', 'lead_paragraph': 'After a week in which both The Boston Globe and The Washington Post were purchased by new owners, the publisher of The New York Times emphatically declared Wednesday night that the publication was not for sale.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Times Isn’t for Sale, Its Publisher Declares', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Times Isn’t for Sale, Its Publisher Declares', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Times Company', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Haughney, Christine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Newspapers', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sulzberger, Arthur Jr', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington Post Company', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Globe', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Golden, Michael', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-08-07T23:16:57+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'by