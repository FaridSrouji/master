nail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '50 Years Later', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': '50 Years Later', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Blow, Charles M', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Segregation', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'King, Martin Luther Jr', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-08-24T01:51:10+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Charles M. Blow', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a576140c-b922-5366-b3aa-2b263a6514f4', 'word_count': 739, 'uri': 'nyt://article/a576140c-b922-5366-b3aa-2b263a6514f4'}, {'abstract': 'If Santonio Holmes is able to return for the Jets’ season opener, he will provide a lift to an unproven receiving corp, as well as to the quarterback.', 'web_url': 'https://www.nytimes.com/2013/08/24/sports/football/nfl-roundup.html', 'snippet': 'If Santonio Holmes is able to return for the Jets’ season opener, he will provide a lift to an unproven receiving corp, as well as to the quarterback.', 'lead_paragraph': 'Santonio Holmes was removed from the physically unable to perform list and added to the active roster Friday, a sign that he could be available for the Sept. 8 season opener. If Holmes is able to return then — or soon after — he will provide a lift to an unproven receiving corps, as well as to the quarterback, whoever wins that job. ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jets Activate Holmes, Who May Make Opener', 'kicker': 'N.F.L. Roundup', 'content_kicker': None, 'print_headline': 'Jets Activate Holmes, Who May Make Opener', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Steelers', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Eagles', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Antonio', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Houston Texans', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Felix', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Holmes, Santonio', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Robinson, Adrian Jr (1989-2015)', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-08-24T01:54:08+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1690febf-6059-5454-8b78-8fecc1b8a234', 'word_count': 285, 'uri': 'nyt://article/1690febf-6059-5454-8b78-8fecc1b8a234'}, {'abstract': 'Corrections appearing in print on August 24, 2013.', 'web_url': 'https://www.nytimes.com/2013/08/24/pageoneplus/corrections-august-24-2013.html', 'snippet': 'Corrections appearing in print on August 24, 2013.', 'lead_paragraph': 'INTERNATIONAL', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: August 24, 2013', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-24T02:00:05+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd8e7717-b657-556b-b9d1-f35dcc843c43', 'word_count': 630, 'uri': 'nyt://article/cd8e7717-b657-556b-b9d1-f35dcc843c43'}, {'abstract': 'Kick-start your Saturday with this puzzle from Frederick J. Healy.', 'web_url': 'https://wordplay.blogs.nytimes.com/2013/08/23/flip-a-coin/', 'snippet': 'Kick-start your Saturday with this puzzle from Frederick J. Healy.', 'lead_paragraph': 'SATURDAY’S PUZZLE — The Zairian ZAIRE, a now-defunct currency that bore the portrait of Mobuto Sese Seko, was replaced in 1998 by the Congolese franc after the nation changed its name to Democratic Republic of Congo. The zaire was one of just a handful of world currencies whose name matched, or roughly matched, the name of the country that issued it. Other examples include Afghanistan’s afghani, Bolivia’s boliviano and of course the French franc. This currency club is as varied in membership as THE UN, which is itself one of several internationally oriented answers in the all-encompassing Saturday puzzle from Frederick J. Healy that manages to touch on geography in GHANA and animal species in ASIA.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Flip a Coin', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-24T02:00:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Thomas Gaffney', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Gaffney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e53a7ca1-2368-526e-b002-952a4d76473f', 'word_count': 336, 'uri': 'nyt://article/e53a7ca1-2368-526e-b002-952a4d76473f'}, {'abstract': 'Fears of climate change are no reason to revive a doomed energy source.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/08/23/the-new-nuclear-craze/', 'snippet': 'Fears of climate change are no reason to revive a doomed energy source.', 'lead_paragraph': 'There is a new discussion about nuclear energy, prompted by well-founded concerns about carbon emissions and fueled by a pro-nuclear documentary called “Pandora’s Promise.” Add a statement by James E. Hansen — who famously sounded the alarm on climate change — and, of course, industry propaganda, and presto: We Love Nukes.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The New Nuclear Craze', 'kicker': 'Mark Bittman', 'content_kicker': None, 'print_headline': 'The New Nuclear Craze', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Alternative and Renewable Energy', 'rank': 1, 'major': 'N'