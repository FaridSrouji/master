DINECT2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/nyregion/18DINECT2/18DINECT2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/nyregion/18DINECT2/18DINECT2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/18/nyregion/18DINECT2/18DINECT2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/nyregion/18DINECT2/18DINECT2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Digging In to Generous Portions', 'kicker': 'Dining Review | Connecticut', 'content_kicker': None, 'print_headline': 'Digging In to Generous Portions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Plainville (Conn)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cottage Restaurant and Cafe (Plainville, Conn)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-15T22:32:07+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Christopher Brooks', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d4aa193e-4757-516d-99b9-60aec038583e', 'word_count': 728, 'uri': 'nyt://article/d4aa193e-4757-516d-99b9-60aec038583e'}, {'abstract': 'The Italian aperitif has gained popularity in spritzes and sours, but it also works well in more ambitious drinks like this one.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/08/15/feeling-for-an-aperol-cocktail-with-a-tropical-twist/', 'snippet': 'The Italian aperitif has gained popularity in spritzes and sours, but it also works well in more ambitious drinks like this one.', 'lead_paragraph': 'Aperol is here to stay. The Italian aperitif, which had a moment last summer, is best known for drinks in which it takes a starring role: topped with Prosecco and seltzer in an Aperol spritz or paired with simple syrup and fresh lemon juice in an Aperol sour. But lately it’s also become a valuable supporting act in specialty cocktails around New York City, showing up in the salty foam rim in the Paloma cocktail at The Butterfly in TriBeCa and alongside Old Overholt and Pamplemousse in the Sour Patch Rye cocktail at the Brooklyn location of Fatty Cue. The restaurant Brucie, in Brooklyn’s Cobble Hill neighborhood, even started an Aperol happy hour last month.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Feeling For | An Aperol Cocktail With a Tropical Twist', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cocktails', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-15T22:33:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alainna Lexie Beddie', 'person': [{'firstname': 'Alainna', 'middlename': 'Lexie', 'lastname': 'Beddie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/487bb6d6-3981-59b0-aa7a-e43e95dc519d', 'word_count': 328, 'uri': 'nyt://article/487bb6d6-3981-59b0-aa7a-e43e95dc519d'}, {'abstract': '“Austenland,” directed by Jerusha Hess, is a comedy about an English resort that caters to women obsessed with Jane Austen’s novels.', 'web_url': 'https://www.nytimes.com/2013/08/16/movies/austenland-stars-keri-russell.html', 'snippet': '“Austenland,” directed by Jerusha Hess, is a comedy about an English resort that caters to women obsessed with Jane Austen’s novels.', 'lead_paragraph': 'Keri Russell’s neck does most of the heavy lifting in “Austenland,” and if you pay attention to its many undulations, you might just make it through this embarrassingly juvenile comedy without groaning aloud. Whether tilting delicately upward to allow its owner to converse with her towering co-star, Jennifer Coolidge, or contracting in tendon-tightening shame at each new insult suffered by Ms. Russell’s put-upon character, Jane Hayes, that neck — ruthlessly exposed by Regency frocks and updos — is a gift.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/16/arts/16AUSTEN01_SPAN/16AUSTEN01_SPAN-articleLarge-v2.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/16/arts/16AUSTEN01_SPAN/16AUSTEN01_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/16/arts/16AUSTEN01_SPAN/16AUSTEN01_SPAN-jumbo-v2.jpg', 'height': 706, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/16/arts/16AUSTEN01_SPAN/16AUSTEN01_SPAN-superJumbo-v2.jpg', 'height': 1412, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/16/arts/16AUSTEN01_SPA