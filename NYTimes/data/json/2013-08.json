': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McIlroy, Rory', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wozniacki, Caroline', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-24T16:13:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By David Cox', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Cox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e6a8a5d-cabb-5db6-9c56-dcf54a711521', 'word_count': 757, 'uri': 'nyt://article/9e6a8a5d-cabb-5db6-9c56-dcf54a711521'}, {'abstract': 'Patrick Reed, in his first full season, is the first golfer in 17 years to win on the PGA Tour with his wife — Justine Reed — as his caddie.', 'web_url': 'https://www.nytimes.com/2013/08/25/sports/golf/to-love-and-honor-him-and-read-the-greens-for-him.html', 'snippet': 'Patrick Reed, in his first full season, is the first golfer in 17 years to win on the PGA Tour with his wife — Justine Reed — as his caddie.', 'lead_paragraph': 'JERSEY CITY — Patrick Reed hit balls on the driving range while listening to the indie rock band Imagine Dragons on his MP3 player, which was in the left front pocket of his golf pants. Upon completing his warm-up, he pulled his ear buds out. For the rest of an abbreviated workday Friday at Liberty National Golf Club, Reed’s wife, Justine, was in his ear. ', 'print_section': 'SP', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/25/sports/golf-2/golf-2-articleLarge.jpg', 'height': 447, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/25/sports/golf-2/golf-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 447}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/25/sports/golf-2/golf-2-jumbo.jpg', 'height': 763, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/25/sports/golf-2/golf-2-superJumbo.jpg', 'height': 1526, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/25/sports/golf-2/golf-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/25/sports/golf-2/golf-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/25/sports/golf-2/golf-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Golf Couple’s Vows: To Love and to Honor, and to Read Greens', 'kicker': None, 'content_kicker': None, 'print_headline': 'Golf Couple’s Vows: To Love and to Honor, And to Read Greens', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Reed, Patrick', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Golf', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'PGA Tour Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-24T16:25:13+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7e9da666-e4c2-5e8d-8e4a-b29fe38dd4a4', 'word_count': 1150, 'uri': 'nyt://article/7e9da666-e4c2-5e8d-8e4a-b29fe38dd4a4'}, {'abstract': 'His teammate and friend Earl Monroe recalls how valuable Meminger was on the 1973 Knicks championship team.', 'web_url': 'https://www.nytimes.com/2013/08/25/sports/basketball/dean-meminger-was-a-delight-to-coach.html', 'snippet': 'His teammate and friend Earl Monroe recalls how valuable Meminger was on the 1973 Knicks championship team.', 'lead_paragraph': 'What Willis Reed liked to call “Dean’s game” was remarkable not only because the Knicks handed the Celtics their first Game 7 playoff defeat on their home floor. It was also because the great Earl Monroe never got off the bench after Dean Meminger replaced him at the start of the second quarter.', 'print_section': 'SP', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dean Meminger: The Dream Who Was a Delight to Coach', 'kicker': 'An Appraisal', 'content_kicker': None, 'print_headline': 'The Dream Was A Delight To Coach', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Knicks', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Meminger, Dean (1948-2013)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Monroe, Earl', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Reed, Willis', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-24T16:35:48+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Harvey Araton', 'person': [{'firstname': 'Harvey', 'middlename': None, 'lastname': 'Araton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'An Appraisal', '_id': 'nyt://article/032a6945-eab5-500e-9516-e99f1d6786f5', 'word_count': 640, 'uri': 'nyt://article/032a6945-eab5-500e-9516-e99f1d6786f5'}, {'abstract': 'The authors of “The System: The Glory and Scandal of Big-Time College Football” may never watch a game in the way they once did.', 'web_url': 'https://www.nytimes.com/2013/08/25/sports/ncaafootball/a-new-book-offers-a-view-of-the-game-that-tailgaters-rarely-encounter.html', 'snippet': 'The authors of “The System: The Glory and Scandal of Big-Time College Football” may never watch a game in the way they once did.', 'lead_paragraph': 'Getting inside the body of the college football industry and examining it, organ by organ, might be compared to an exploration of the human body. The resulting emotions range wider than the country in which the sport is played — amazement and anxiety, wonderment and worry. ', 'print_section': 'SP', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Book Offers a View of the Game That Tailgaters Rarely Encounter', 'kicker': None, 'content_kicker': None, 'print_headline': 'A New Book Offers a View of the Game That Tailgaters Rarely Encounter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'College Athletics', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Football (College)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Keteyian, Armen', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-24T16:37:32+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Harvey Araton', 'person': [{'firstname': 'Harvey', 'middlename': None, 'lastname': 'Araton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization':