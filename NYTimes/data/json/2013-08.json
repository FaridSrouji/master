: None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f0ae2e2-b441-5e85-80fe-fd45d1ed5686', 'word_count': 878, 'uri': 'nyt://article/7f0ae2e2-b441-5e85-80fe-fd45d1ed5686'}, {'abstract': 'An exhibition of Michael Kamber’s photographs ponders the relationship between his portraits from the Bronx and from troubled places abroad.', 'web_url': 'https://lens.blogs.nytimes.com/2013/08/14/connecting-with-neighbors-in-baghdad-or-the-bronx/', 'snippet': 'An exhibition of Michael Kamber’s photographs ponders the relationship between his portraits from the Bronx and from troubled places abroad.', 'lead_paragraph': 'Michael Kamber photographed internationally for The New York Times from 2002 to 2012 and is a co-founder of the Bronx Documentary Center. His book “Photojournalists on War” is an oral history of the Iraq war as recounted by those who documented it from the front lines. An exhibition of portraits he made in the Bronx — grouped with portraits made in Africa, Afghanistan and Iraq — opens Wednesday evening at the Bronx Art Space. He spoke with James Estrin this week about that exhibition. The conversation has been edited.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Connecting With Neighbors, in Baghdad or the Bronx', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kamber, Michael', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-14T09:00:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'first