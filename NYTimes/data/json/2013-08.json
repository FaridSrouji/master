': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-20T21:47:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Andrew Jacobs', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Jacobs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30ba9ce5-cf5b-55b6-b17b-886138cf43b9', 'word_count': 1125, 'uri': 'nyt://article/30ba9ce5-cf5b-55b6-b17b-886138cf43b9'}, {'abstract': 'The Indian dancer Rama Vaidyanathan performed “Mad and Divine” at the Drive East festival at La MaMa.', 'web_url': 'https://www.nytimes.com/2013/08/21/arts/dance/drive-east-festival-highlights-indian-dance-and-song.html', 'snippet': 'The Indian dancer Rama Vaidyanathan performed “Mad and Divine” at the Drive East festival at La MaMa.', 'lead_paragraph': 'Drive East at La MaMa — accurately subtitled a Journey Through South Asian Music and Dance — is an extraordinary feat, covering more ground than many other festivals. In seven days, it presents 26 performances, none repeated, of music and dance. Six of India’s classical dance forms — Bharata Natyam, Odissi, Kathak, Kuchipudi, Mohiniattam and Kathakali — will be represented. The music includes Carnatic and Hindustani vocals and individual performances devoted to the tabla, sitar, flute and other instruments. Few of us in the West know nearly enough about these rich and compelling genres; I hope this festival recurs in years to come. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/21/arts/RAMA/RAMA-articleLarge.jpg', 'height': 688, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge',