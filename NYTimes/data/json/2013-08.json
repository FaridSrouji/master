e acquired the patina of the hallowed.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10BREAKINGBAD2/10BREAKINGBAD1-1376066267513-articleLarge.jpg', 'height': 220, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/10/arts/10BREAKINGBAD2/10BREAKINGBAD1-1376066267513-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 220}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10BREAKINGBAD2/10BREAKINGBAD1-1376066267513-jumbo.jpg', 'height': 375, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10BREAKINGBAD2/10BREAKINGBAD1-1376066267513-superJumbo.jpg', 'height': 751, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10BREAKINGBAD2/10BREAKINGBAD2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/10/arts/10BREAKINGBAD2/10BREAKINGBAD2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10BREAKINGBAD2/10BREAKINGBAD2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Eerily Normal, the Real Star of ‘Breaking Bad’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Eerily Normal, the Real Star of ‘Breaking Bad’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Breakin