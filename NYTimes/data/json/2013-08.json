ion': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Editors’ Choice | Recent books of particular interest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-16T15:57:25+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/590402d3-ca17-5664-9677-931f5eccc2d3', 'word_count': 263, 'uri': 'nyt://article/590402d3-ca17-5664-9677-931f5eccc2d3'}, {'abstract': 'Andy Revkin performs his song about humanity’s love affair with fossil fuels for a room full of climate scientists and communicators.', 'web_url': 'https://dotearth.blogs.nytimes.com/2013/08/16/liberated-carbon-itll-turn-your-night-to-day/', 'snippet': 'Andy Revkin performs his song about humanity’s love affair with fossil fuels for a room full of climate scientists and communicators.', 'lead_paragraph': 'Via Climate Nexus and Daniel M.N. Turner, here’s video of my performance of “Liberated Carbon,” my short musical history of humanity’s love affair with fossil fuels, at the ScienceOnline Climate conference in Washington, D.C., yesterday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Liberated Carbon, It’ll Turn Your Night to Day’', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coal', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Energy and Power', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Persian Gulf War', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-16T15:59:36+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew C. Revkin', 'person': [{'firstname': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a5c6e48-f060-51cd-bf32-c031c0e6a24d', 'word_count': 399, 'uri': 'nyt://article/0a5c6e48-f060-51cd-bf32-c031c0e6a24d'}, {'abstract': 'Brie Larson discusses her first leading role, in “Short Term 12,” as well as other coming films.', 'web_url': 'https://www.nytimes.com/2013/08/18/movies/brie-larson-talks-about-short-term-12.html', 'snippet': 'Brie Larson discusses her first leading role, in “Short Term 12,” as well as other coming films.', 'lead_paragraph': 'Brie Larson could have been another teenage actor who never graduated to adult roles. After an early start in forgettable sitcoms, like the 2001 Bob Saget series “Raising Dad,” she began a side career in bubble gum pop music. She also played a rebellious wild child on three seasons of Showtime’s “United States of Tara” and in the movie “Scott Pilgrim vs. the World.”', 'print_section': 'AR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/arts/18SNAPSHOT/18SNAPSHOT-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/18/arts/18SNAPSHOT/18SNAPSHOT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/arts/18SNAPSHOT/18SNAPSHOT-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 