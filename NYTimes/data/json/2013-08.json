gn-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/13/multimedia/video-thompson-adcampaign/video-thompson-adcampaign-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': "'Believe'", 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-13T15:22:30+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'YouTube', 'person': [{'firstname': 'Youtube', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/1fe12de8-ae98-5ae8-9751-f04a57ac6b43', 'word_count': 0, 'uri': 'nyt://video/1fe12de8-ae98-5ae8-9751-f04a57ac6b43'}, {'abstract': 'Grand Bargains are a bad thing if they take you in the wrong direction.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/08/13/a-tale-of-two-flat-countries/', 'snippet': 'Grand Bargains are a bad thing if they take you in the wrong direction.', 'lead_paragraph': 'Simon Wren-Lewis writes about the rise of extremist parties in the UK and the Netherlands. As he notes, in a way this shouldn’t be surprising. The Netherlands, in particular, has the kind of Grand Bargain the Washington Post editorial page dreams of — a government of national unity committed to fiscal austerity. It’s as if Harry Reid, John Boehner, and President Obama had all agreed to implement Simpson-Bowles, with some extra front-loaded cuts thrown into the bargain too. And here’s the thing: it’s not working. So what you have is a frustrated populace, finding no “respectable” politicians willing to challenge a failing orthodoxy:', 'source': 'The New York Times', 'multimedia': [], 'headli