ction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Murphy, Mary Jo', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Seaford (NY)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Parkside Cafe (Seaford, NY, Restaurant)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-29T23:22:53+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Mary Jo Murphy', 'person': [{'firstname': 'Mary', 'middlename': 'Jo', 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/df6a3bc1-df3b-5813-bb66-6ce9f024dceb', 'word_count': 734, 'uri': 'nyt://article/df6a3bc1-df3b-5813-bb66-6ce9f024dceb'}, {'abstract': '“The Lifeguard” centers on a young woman whose New York life goes off the tracks, so she moves back home to take up her old summer job.', 'web_url': 'https://www.nytimes.com/2013/08/30/movies/kristen-bell-on-poolside-patrol-in-the-lifeguard.html', 'snippet': '“The Lifeguard” centers on a young woman whose New York life goes off the tracks, so she moves back home to take up her old summer job.', 'lead_paragraph': 'Tales of summertime (or lifelong) regression have tended to involve comically adrift men, but “The Lifeguard” follows a woman just shy of 30 as she moves back in with her family in Connecticut. This directorial debut by Liz W. Garcia, a writer for television, bears some echoes of its creator’s origins, going from deft to trite in its drama and setting up character arcs that feel sappily resolved within its feature length.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30RDP_LIFEGUARD_SPAN/0830FILMRDUP01