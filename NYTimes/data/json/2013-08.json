gacy': {}}], 'headline': {'main': 'Women, Bought and Sold in Nepal', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-31T18:37:29+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/58cddd25-39e1-5c53-bf28-ae95d36602a1', 'word_count': 0, 'uri': 'nyt://slideshow/58cddd25-39e1-5c53-bf28-ae95d36602a1'}, {'abstract': 'From the March on Washington to the fast-food strikes, workers have fought for a decent living, but little progress has been made.', 'web_url': 'https://www.nytimes.com/2013/09/01/opinion/sunday/labor-then-and-now.html', 'snippet': 'From the March on Washington to the fast-food strikes, workers have fought for a decent living, but little progress has been made.', 'lead_paragraph': 'On Thursday, the day after the 50th anniversary of the March on Washington, thousands of fast-food workers in 60 cities walked off their jobs, the latest in an escalating series of walkouts by low-wage workers demanding higher pay and the right to organize without retaliation.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Labor, Then and Now', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Labor, Then and Now', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wages and Salaries', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Minimum Wage', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fast Food Industry', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-31T18:39:53+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/2202c747-17e8-5368-b61e-3aa32c0c8aa6', 'word_count': 531, 'uri': 'nyt://article/2202c747-17e8-5368-b61e-3aa32c0c8aa6'}, {'abstract': 'A proposal from Malaysia would allow health considerations to take precedence over expanded trade.', 'web_url': 'https://www.nytimes.com/2013/09/01/opinion/sunday/the-hazard-of-free-trade-tobacco.html', 'snippet': 'A proposal from Malaysia would allow health considerations to take precedence over expanded trade.', 'lead_paragraph': 'Give thanks to Malaysia for heading off, at least temporarily, an American effort to weaken the ability of countries to impose stiff rules on the sale of cigarettes and other tobacco products within their own borders. The Malaysian proposal to preserve that ability led to a stalemate at a Trans-Pacific Partnership trade meeting in Brunei last week and forced the deferral of the issue to future meetings.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Hazard of Free-Trade Tobacco', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Hazard of Free-Trade Tobacco', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Malaysia', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-31T18:39:53+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_n