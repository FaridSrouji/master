st sisters?”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'IVF, Embryos and Choices', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'In Vitro Fertilization', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Infertility', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Multiple Births', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Twins', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-04T12:46:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Carla Naumburg', 'person': [{'firstname': 'Carla', 'middlename': None, 'lastname': 'Naumburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9f26ed8a-948a-5fae-8295-503d1452589f', 'word_count': 750, 'uri': 'nyt://article/9f26ed8a-948a-5fae-8295-503d1452589f'}, {'abstract': 'The candidates’ daily campaign schedule at a glance.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/08/04/aug-4-where-the-candidates-are-today/', 'snippet': 'The candidates’ daily campaign schedule at a glance.', 'lead_paragraph': 'Planned events for the mayoral candidates, according to the campaigns and organizations they are affiliated with. Times are listed as scheduled but frequently change.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Aug. 4: Where the Candidates Are Today', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections, Mayors', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}],