umbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/14/world/middleeast/20130815-EGYPT-slide-UJCS/20130815-EGYPT-slide-UJCS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fierce and Swift Raids on Islamists Bring Sirens, Gunfire, Then Screams', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Fierce and Swift Attack on Camps: Sirens, Gunfire, Then Screams of Pain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fahim, Kareem', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sheikh, Mayy El', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Cairo (Egypt)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Morsi, Mohamed', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Muslim Brotherhood (Egypt)', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-08-15T01:03:56+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Kareem Fahim and Mayy El Sheikh', 'person': [{'firstname': 'Kareem', 'middlename': None, 'lastname': 'Fahim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Mayy', 'middlename': 'El', 'lastname': 'Sheikh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/55f46106-7f06-5463-9ec3-330f463fdb0b', 'word_count': 1040, 'uri': 'nyt://article/55f46106-7f06-5463-9ec3-330f463fdb0b'}, {'abstract': 'Holder’s announcement is only a first step.', 'web_url': 'https://www.nytimes.com/2013/08/15/opinion/how-to-really-end-mass-incarceration.html', 'snippet': 'Holder’s announcement is only a first step.', 'lead_paragraph': 'WASHINGTON — IN 2003, I represented dozens of African-American residents in Tulia, Tex., who had been convicted after a botched drug sting. Jason Jerome Williams, a 22-year-old with no prior criminal record, had been sentenced to 45 years in prison for four sales of an eighth of an ounce of cocaine. Freddie Brookins Jr., 25, had received 20 years for a first-time offense of selling less than four grams of cocaine. Joe Moore, a 56-year-old hog farmer, had gotten 90 years for two cocaine sales totaling under five grams. Others accepted plea deals to try to avoid such lengthy prison terms. ', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How to Really End Mass Incarceration', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'How to Really End Mass Incarceration', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gupta, Vanita', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Holder, Eric H Jr', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Crime and Criminals', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mandatory Sentencing', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-08-15T01:04:14+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Vanita Gupta', 'person': [{'firstname': 'Vanita', 'middlename': None, 'lastname': 'Gupta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/878b675a-4cac-5f23-9822-d8dbc6f97f14', 'word_count': 913, 'uri': 'nyt://article/878b675a-4cac-5f23-9822-d8dbc6f97f14'}, {'abstract': 'After tearing a knee ligament for a third time, Giants cornerback Terrell Thomas found inspiration in a fellow rehabilitation patient he met in Florida.', 'web_url': 'https://www.nytimes.com/2013/08/15/sports/football/after-injuring-knee-giants-thomas-repaired-spirit.html', 'snippet': 'After tearing a knee ligament for a third time, Giants cornerback Terrell Thomas found inspiration in a fellow rehabilitation patient he met in Florida.', 'lead_paragraph': 'EAST RUTHERFORD, N.J. — After tearing the anterior cruciate ligament in his right knee for a third time during training camp in 2012, Giants cornerback Terrell Thomas left his family and his new home in New Jersey and moved to Pensacola, Fla., to begin an arduous rehabilitation. He rented an apartment near the Gulf of Mexico, hoping the vista and the solitude would soothe him.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/sports/CITY-GIANTS/CITY-GIANTS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/15/sports/CITY-GIANTS/CITY-GIANTS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/sports/CITY-GIANTS/CITY-GIANTS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/sports/CITY-GIANTS/CITY-GIANTS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/sports/CITY-GIANTS/CITY-GIANTS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/15/sports/CITY-GIANTS/CITY-GIANTS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/sports/CITY-GIANTS/CITY-GIANTS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Injuring Knee, Giants’ Thomas Repaired Spirit', 'kicker': None, 'content_kicker': None, 'print_headline': 'After Injuring Knee Again, A Giant Repaired His Spirit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Thomas, Terrell', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Thomas', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-08-15T01:12:18+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Zach Schonbrun', 'person': [{'firstname': 'Zach', 'middlename': None, 'lastname': 'Schonbrun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2e3bce47-43b7-5f5a-85ee-8df3864a6056', 'word_count': 1035, 'uri': 'nyt://article/2e3bce47-43b7-5f5a-85ee-8df3864a6056'}, {'abstract': 'If only all our problems were carved out of butter. Instead, we have men behaving badly.', 'web_url': 'https://www.nytimes.com/2013/08/15/opinion/collins-things-to-skip-in-august.html', 'snippet': 'If only all our problems were carved out of butter. Instead, we have men behaving badly.', 'lead_paragraph': 'August. A dead shark was found on a New York City subway. Meanwhile, at the Iowa State Fair, vegan activists broke into a refrigerated case in the Dairy Building and threw red paint on the butter cow. In San Diego, the mayor claimed the city should pay the costs of defending him in a sexual harassment lawsuit because he had never been given sensitivity training.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/gail-collins/gail-collins-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/gail-collins/gail-collins-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/gail-collins/gail-collins-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/gail-collins/gail-collins-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinio