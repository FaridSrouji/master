dline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-06T11:07:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Frank Longo', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Longo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f97ab527-e6bf-55bb-af0f-a6851fc6729a', 'word_count': 77, 'uri': 'nyt://article/f97ab527-e6bf-55bb-af0f-a6851fc6729a'}, {'abstract': 'Hezbollah’s open support for President Bashar al-Assad in Syria has tarnished the group’s reputation back home in Lebanon.', 'web_url': 'https://latitude.blogs.nytimes.com/2013/08/06/hezbollahs-choice/', 'snippet': 'Hezbollah’s open support for President Bashar al-Assad in Syria has tarnished the group’s reputation back home in Lebanon.', 'lead_paragraph': 'BEIRUT — When\xa0Hassan Nasrallah, the charismatic leader of Hezbollah, the Shiite political party and militia, gave a public speech in Beirut on Friday — something he rarely does these days for fear of assassination — he told his Arab audience to stay focused on resisting Israel. “We the Shiites of Ali bin Abi Taleb will not abandon Palestine,” he declared to the rapturous applause of several thousand supporters in a party stronghold in the southern suburb of the capital. Shiites consider Ali bin Abi Taleb, the cousin and son-in-law of the Prophet Muhammad, to be his rightful successor rather than Abu Bakr, who became Islam’s leader upon the Prophet’s death.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hezbollah’s Choice', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shiite Muslims', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nasrallah, Hassan', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Hezbollah', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Beirut (Lebanon)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-06T11:09:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Sarah Birke', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Birke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf9782c2-7e59-5823-9e53-d916bb4bc1ec', 'word_count': 643, 'uri': 'nyt://article/cf9782c2-7e59-5823-9e53-d916bb4bc1ec'}, {'abstract': "Sully Romero, who grew up in the Rockaways, describes herself as a “'90s, Salvation Army, thrifter babe, tomboy, New Yorker.”", 'web_url': 'https://www.nytimes.com/video/fashion/100000002367570/intersection-beach-style-in-the-rockaways.html', 'snippet': "Sully Romero, who grew up in the Rockaways, describes herself as a “'90s, Salvation Army, thrifter babe, tomboy, New Yorker.”", 'lead_paragraph': "Sully Romero, who grew up in the Rockaways, describes herself as a “'90s, Salvation Army, thrifter babe, tomboy, New Yorker.”", 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/06/fashion/video-intersectionrockaways/video-intersectionrockaways-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/06/fashion/video-intersectionrockaways/video-intersectionrockaways-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/06/fashion/video-intersectionrockaways/video-inter