ce1-82e1-4a0fcf19e8f1', 'word_count': 1, 'uri': 'nyt://article/4113ebea-10f0-5ce1-82e1-4a0fcf19e8f1'}, {'abstract': 'Michael White’s new restaurant takes him back where he started.', 'web_url': 'https://www.nytimes.com/2013/08/14/dining/reviews/restaurant-review-costata-in-soho.html', 'snippet': 'Michael White’s new restaurant takes him back where he started.', 'lead_paragraph': 'So this is where he decides to bring us: back to the same place on Spring Street where it all started. The year was 2002, the restaurant was called Fiamma, and he was just another hungry 29-year-old chef from the Midwest. We didn’t know yet that his name was Michael White. We just knew that when he cooked Italian food, he could make us forget about all the others for a while.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/14/dining/14REST_SPAN/14REST_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/14/dining/14REST_SPAN/14REST_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/14/dining/14REST_SPAN/14REST_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/14/dining/14REST_SPAN/14REST_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/14/dining/14REST_SPAN/14REST_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/14/dining/14REST_SPAN/14REST_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/14/dining/14REST_SPAN/14REST_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Old Flame, Whispering ‘Steak’', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Old Flame, Whispering ‘Steak’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Costata (Manhattan, NY, Restaurant)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'White, Michael (Chef)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'SoHo (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-13T17:10:40+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Pete Wells', 'person': [{'firstname': 'Pete', 'middlename': None, 'lastname': 'Wells', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d541e3ad-2341-5349-8c4e-ea359b7ac965', 'word_count': 1136, 'uri': 'nyt://article/d541e3ad-2341-5349-8c4e-ea359b7ac965'}, {'abstract': 'A fine piece of steak is an open invitation to a world of red wines to show their stuff.', 'web_url': 'https://www.nytimes.com/2013/08/14/dining/wines-to-accompany-grilled-flank-steak.html', 'snippet': 'A fine piece of steak is an open invitation to a world of red wines to show their stuff.', 'lead_paragraph': 'A fine piece of grilled flank steak is an open invitation to a world of red wines to show their stuff. But what happens when you add chile’s heat, to say nothing of nomadic travelers in the wine world like tomatillo and pineapple? Not to worry. The char of the meat will still be the dominant flavor, though amplified and augmented by the additions. I recommend a dry Loire red, like one of the less-structured Chinons, Bourgueils or Saumur-Champignys. Unless they are too tannic, they seem to have an affinity for chiles. What’s more, their fruit, spice and acidity will take naturally to the fruitiness of the tomatillo, pineapple and, indeed, the chile. Other options: cru Beaujolais and West Coast gamays, if you can find them; lighter-bodied Ribeira Sacra and Bierzos, made from the mencía grape; and Austrian blaufränkisches and zweigelts.\xa0', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wines to Accompany Grilled Flank Steak', 'kicker': 'And to Drink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wines', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Asimov, Eric', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-13T17:28:45+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Eric Asimov', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Asimov', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08b15d61-b60b-56ec-838f-d55e8d737bb3', 'word_count': 141, 'uri': 'nyt://article/08b15d61-b60b-56ec-838f-d55e8d737bb3'}, {'abstract': 'Avivo’s cases offer interchangeability with a frame, a rail and a jacket that fit together in a modular design and can be swapped for other parts.', 'web_url': 'https://www.nytimes.com/2013/08/15/technology/personaltech/avivos-custom-cellphone-cases-pretty-but-tricky.html', 'snippet': 'Avivo’s cases offer interchangeability with a frame, a rail and a jacket that fit together in a modular design and can be swapped for other parts.', 'lead_paragraph': 'For ease of use, most cellphone cases typically have a single, integrated design. To change the look, you have to change the entire case. Avivo thinks owners should be able to swap a few parts instead.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/technology/personaltech/GW-Avivo/GW-Avivo-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/15/technology/personaltech/GW-Avivo/GW-Avivo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/technology/personaltech/GW-Avivo/GW-Avivo-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/technology/personaltech/GW-Avivo/GW-Avivo-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/technology/personaltech/GW-Avivo/GW-Avivo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/15/technology/personaltech/GW-Avivo/GW-Avivo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/technology/personaltech/GW-Avivo/GW-Avivo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Avivo’s Custom Cellphone Cases, Pretty but Tricky', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': 'Custom Cellphone Cases, Pretty but Tricky', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Smartphones', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Avivo', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-13T17:30:41+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Gregory Schmidt', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Schmidt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Web Log', '_id': 'nyt://article/cfc9e8f9-ab23-5941-9f46-caab03dfb5a9', 'word_count': 353, 'uri': 'nyt://article/cfc9e8f9-ab23-5941-9f46-caab03dfb5a9'}, {'abstract': 'Addressing poor umbrella design, the Brolly has a handle with an ergonomic, four-finger grip that frees your thumb to text.', 'web_url': 'https://www.nytimes.com/2013/08/15/technology/personaltech/brolly-umbrella-frees-thumbs-for-texting.html', 'snippet': 'Addressing poor umbrella design, the Brolly has a handle with an ergonomic, four-finger grip that frees your thumb to text.', 'lead_paragraph': 'Umbrellas are decidedly low-tech devices. They really serve only to keep our gadgets, and heads, dry. Unfortunately, holding an umbrella usually precludes the use of said gadgets, but Brollytime, a company based in Chicago, has come up with an innovation to change that.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/15/technology/personaltech/GW-Brolly/GW-Brolly-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge',