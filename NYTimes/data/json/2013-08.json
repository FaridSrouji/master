ntract is finalized.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04lopez/04lopez-articleLarge.jpg', 'height': 843, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/04/arts/04lopez/04lopez-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 843}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04lopez/04lopez-jumbo.jpg', 'height': 1024, 'width': 729, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04lopez/04lopez-superJumbo.jpg', 'height': 2048, 'width': 1458, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04lopez/04lopez-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/04/arts/04lopez/04lopez-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04lopez/04lopez-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jennifer Lopez Nears Deal for ‘American Idol’ Return', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lopez, Jennifer', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox Broadcasting Co', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-04T16:14:13+0000', 'document_type': 'arti