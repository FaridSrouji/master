umbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/28/nyregion/28nytoday/28nytoday-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New York Today: Commute of the Future', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-28T10:08:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Ravi Somaiya', 'person': [{'firstname': 'Ravi', 'middlename': None, 'lastname': 'Somaiya', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b722dd7-6e7b-52ba-ab17-761af8859f0a', 'word_count': 786, 'uri': 'nyt://article/0b722dd7-6e7b-52ba-ab17-761af8859f0a'}, {'abstract': 'I was surprised to learn how many people didn’t realize that Saul Berenson from “Homeland” was also the swashbuckling Inigo Montoya from “The Princess Bride.”', 'web_url': 'https://6thfloor.blogs.nytimes.com/2013/08/28/my-favorite-mandy-moments/', 'snippet': 'I was surprised to learn how many people didn’t realize that Saul Berenson from “Homeland” was also the swashbuckling Inigo Montoya from “The Princess Bride.”', 'lead_paragraph': 'After writing about Mandy Patinkin in this past weekend’s issue of the magazine, I got to thinking about my favorite moments from his long career, and came up with three — one from the movies, one from the stage and one from TV. You can see them below, and then have a chance to weigh in with your own favorite Mandy moments. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'My Favorite Mandy Moments', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-28T10:26:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Alex Witchel', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Witchel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d175e221-5bd9-5308-9a06-94c6cbd3c105', 'word_count': 225, 'uri': 'nyt://article/d175e221-5bd9-5308-9a06-94c6cbd3c105'}, {'abstract': 'Before it would endorse military strikes in Syria, Britain signaled it would await the findings of a United Nations investigation into a suspected chemical attack near Damascus and hold a parliamentary vote.', 'web_url': 'https://www.nytimes.com/2013/08/29/world/middleeast/syria.html', 'snippet': 'Before it would endorse military strikes in Syria, Britain signaled it would await the findings of a United Nations investigation into a suspected chemical attack near Damascus and hold a parliamentary vote.', 'lead_paragraph': 'LONDON — The prospect of an imminent Western military strike on Syrian government targets appeared to encounter a delay on Wednesday when Britain signaled it would first await the findings of a United Nations inquiry into the suspected use of chemical weapons in an attack that killed hundreds near Damascus last week, and then hold a separate parliamentary vote, which could be days away.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/29/world/29syria/29syria-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/29/world/29syria/29syria-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/29/world/29syria/2