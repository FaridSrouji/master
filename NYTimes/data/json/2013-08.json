ne': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Negro League', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Negro Leagues Baseball Museum', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kendrick, Bob', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-08-24T04:22:00+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/2c279061-8e98-56e1-9409-02c81e8b58a3', 'word_count': 0, 'uri': 'nyt://slideshow/2c279061-8e98-56e1-9409-02c81e8b58a3'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/08/24/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (HBO) LIFE OF PI (2012) Based on the novel by Yann Martel and directed by Ang Lee, this tale chronicles the life of Pi Patel (Suraj Sharma, above), the son of an Indian zoo owner who becomes stranded on a boat in the Pacific and must fight not only dehydration and starvation, but also a Bengal tiger, to survive. Writing in The New York Times, A. O. Scott said that this film, which received four Oscars, including best director, best cinematography and best special effects, “unfolds in a setting that is one of the great achievements of digital cinema, and a reminder that the eclectic Mr. Lee is, among other things, an exuberant and inventive visual artist.” He added: “There are images in ‘Life of Pi’ that are so beautiful, so surprising, so right that I hesitate to describe them. Suffice it to say that the simple, elemental facts of sky, sea and animal life are captured with sweetness and sublimity.” ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-24T05:00:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/d2fef817-b52c-56a1-a402-d437a942d578', 'word_count': 767, 'uri': 'nyt://article/d2fef817-b52c-56a1-a402-d437a942d578'}, {'abstract': 'Bo Xilai, the fallen Communist Party star, faced off in court with Wang Lijun, the former police chief who told American officials that Mr. Bo’s wife had poisoned a British businessman.', 'web_url': 'https://www.nytimes.com/2013/08/25/world/asia/trial-delves-further-into-chinese-politicians-family-life.html', 'snippet': 'Bo Xilai, the fallen Communist Party star, faced off in court with Wang Lijun, the former police chief who told American officials that Mr. Bo’s wife had poisoned a British businessman.', 'lead_paragraph': 'JINAN, China — In a dramatic high point of his trial, Bo Xilai, the fallen Communist Party star, faced off in court on Saturday with Wang Lijun, the former police chief whose flight to an American consulate last year set off the biggest scandal to shake the party in decades.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/25/world/china/china-1377356498347-articleLarge.jpg', 'height': 262, 'width': 600, 'subType