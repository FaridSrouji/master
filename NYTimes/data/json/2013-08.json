d43f2-7445-5889-9b69-b1f533a8e3c0', 'word_count': 851, 'uri': 'nyt://article/56ed43f2-7445-5889-9b69-b1f533a8e3c0'}, {'abstract': 'John Farmer spreads the good fortune around.', 'web_url': 'https://wordplay.blogs.nytimes.com/2013/08/31/persons-of-note/', 'snippet': 'John Farmer spreads the good fortune around.', 'lead_paragraph': 'SUNDAY’S PUZZLE — “Money doesn’t grow on trees,” my father always told me, but today it’s literally bursting out of our crossword puzzle in denominations of all kinds, if you know where to find it. You have John Farmer and Will Shortz to thank for that, and if you are doing this puzzle in the paper version of The New York Times, then my father was clearly wrong. I can’t wait to tell him.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Persons of Note', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-31T22:00:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/753b235c-395d-5528-b6b0-93f66c6a6e97', 'word_count': 772, 'uri': 'nyt://article/753b235c-395d-5528-b6b0-93f66c6a6e97'}, {'abstract': 'Behind Ivan Nova, the Yankees defeated Baltimore for the second game in a row and moved up in the wild-card race.', 'web_url': 'https://www.nytimes.com/2013/09/01/sports/baseball/a-tense-moment-in-the-9th-but-nova-shuts-out-orioles.html', 'snippet': 'Behind Ivan Nova, the Yankees defeated Baltimore for the second game in a row and moved up in the wild-card race.', 'lead_paragraph': 'The ball hit by Baltimore Orioles first baseman Chris Davis in the nin