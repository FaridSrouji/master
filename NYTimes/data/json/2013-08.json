ct', 'value': 'Prostitution', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-25T18:30:50+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By David Barboza', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Barboza', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45eea807-7379-56ab-9a5d-fbf219a4b7d7', 'word_count': 259, 'uri': 'nyt://article/45eea807-7379-56ab-9a5d-fbf219a4b7d7'}, {'abstract': 'A professor in England studied the supply chain of a tennis ball and found it went more than 50,000 miles to get to Wimbledon.', 'web_url': 'https://straightsets.blogs.nytimes.com/2013/08/25/the-long-journey-to-become-a-tennis-ball/', 'snippet': 'A professor in England studied the supply chain of a tennis ball and found it went more than 50,000 miles to get to Wimbledon.', 'lead_paragraph': 'Athletes have arrived from all over the world to compete at the United States Open this week. It may be a surprise that the balls they play with typically travel far greater distances on the road to completion. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Long Journey to Become a Tennis Ball', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-08-25T18:50:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Benjamin Snyder', 'person': [{'firstname': 'Benj