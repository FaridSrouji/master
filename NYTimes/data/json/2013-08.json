rsons', 'value': 'Killen, Louisa Jo (1934-2013)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Vitello, Paul', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Folk Music', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-26T02:29:15+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Paul Vitello', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Vitello', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/a24896ea-b745-5d16-92ca-240176e20fdb', 'word_count': 931, 'uri': 'nyt://article/a24896ea-b745-5d16-92ca-240176e20fdb'}, {'abstract': 'In Williamsburg, Grand Ferry is a place to steal time with the water, separated from the concrete by no more than a jumble of boulders.', 'web_url': 'https://www.nytimes.com/2013/08/26/nyregion/in-williamsburg-riverside-interludes-amid-the-tumult.html', 'snippet': 'In Williamsburg, Grand Ferry is a place to steal time with the water, separated from the concrete by no more than a jumble of boulders.', 'lead_paragraph': 'They come strolling slowly down Grand Street, around sunset, the young couples and the people accompanied only by their worries, each claiming a boulder or a faded bench as the lights of Manhattan begin to streak the East River.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/nyregion/Y-SHORELINES1/Y-SHORLINES1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/26/nyregion/Y-SHORELINES1/Y-SHORLINES1-