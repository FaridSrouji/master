: 873, 'uri': 'nyt://article/066da08d-37df-5458-8de4-8265ab99ff8a'}, {'abstract': 'Republican legislators in Missouri seek to pronounce federal gun safety laws null and void in their state.', 'web_url': 'https://www.nytimes.com/2013/08/30/opinion/statehouse-swagger-in-the-gun-debate.html', 'snippet': 'Republican legislators in Missouri seek to pronounce federal gun safety laws null and void in their state.', 'lead_paragraph': 'As a measure of the gun culture’s dangerous sway over statehouse politicians, it is hard to top the pending proposal in Missouri that would pronounce all federal gun safety laws null and void in the state and allow the arrest of federal agents who try to enforce them. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Statehouse Swagger in the Gun Debate', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Statehouse Swagger in the Gun Debate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Missouri', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-30T01:39:57+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/26b30742-e540-5eea-8733-f6c3fbfb2630', 'word_count': 572, 'uri': 'nyt://article/26b30742-e540-5eea-8733-f6c3fbfb2630'}, {'abstract': 'After James Blake was defeated in his first-round match against Ivo Karlovic, he took to the podium with an unusual crispness and focus after the last singles match of his career ended.', 'web_url': 'https://www.nytimes.com/2013/08/30/sports/tennis/blake-lost-command-of-his-match-but-not-his-exit.html', 'snippet': 'After James Blake was defeated in his first-round match against Ivo Karlovic, he took to the podium with an unusual crispness and focus after the last singles match of his career ended.', 'lead_paragraph': 'Two and a half days after he had announced his career was ending, James Blake found himself saying goodbye Thursday just after midnight, giving an emotional on-court interview after his loss in a fifth-set tiebreaker in his first-round match against Ivo Karlovic.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/Y-BLAKE/Y-BLAKE-articleLarge.jpg', 'height': 902, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/30/sports/Y-BLAKE/Y-BLAKE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 902}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/Y-BLAKE/Y-BLAKE-jumbo.jpg', 'height': 1024, 'width': 681, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/Y-BLAKE/Y-BLAKE-superJumbo.jpg', 'height': 1999, 'width': 1329, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/Y-BLAKE/Y-BLAKE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/30/sports/Y-BLAKE/Y-BLAKE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/Y-B