1c4', 'word_count': 763, 'uri': 'nyt://article/fdd88c83-88c4-537a-8a4f-b3cf268c11c4'}, {'abstract': 'Rachel McAdams and Noomi Rapace negotiate a dangerous office environment in Brian De Palma’s “Passion.”', 'web_url': 'https://www.nytimes.com/2013/08/30/movies/brian-de-palma-passion-stars-rachel-mcadams.html', 'snippet': 'Rachel McAdams and Noomi Rapace negotiate a dangerous office environment in Brian De Palma’s “Passion.”', 'lead_paragraph': '“There’s no back-stabbing here. It’s just business.” That line is uttered twice in Brian De Palma’s “Passion,” once disingenuously, once sarcastically, even though it is, literally speaking, true. A slashed throat is not the same as a stabbed back. And the kinky, convoluted plot is all about business if you expand the definition to include romantic obsession, sexual jealousy and sadomasochistic mind games.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30PASSION_SPAN/30PASSION-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/30/arts/30PASSION_SPAN/30PASSION-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30PASSION_SPAN/30PASSION-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30PASSION_SPAN/30PASSION-superJumbo.jpg', 'height': 1067, 'width': 1600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30PASSION_SPAN/30PASSION-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/30/arts/30PASSION_SPAN/30PASSION-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30PASSION_SPAN/30PASSION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Glass Ceilings Can Be Cutting', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Glass Ceilings Can Be Cutting', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'de Palma, Brian', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McAdams, Rachel', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rapace, Noomi', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Passion (Movie)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-29T22:04:27+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d0a96b0f-e2d4-5c67-a359-123cd5eaaf47', 'word_count': 702, 'uri': 'nyt://article/d0a96b0f-e2d4-5c67-a359-123cd5eaaf47'}, {'abstract': 'A critical guide to the visual arts in New York and the region.', 'web_url': 'https://www.nytimes.com/2013/08/30/arts/design/museum-and-gallery-listings-for-aug-30-sept-5.html', 'snippet': 'A critical guide to the visual arts in New York and the region.', 'lead_paragraph': ' Museums and galleries are in Manhattan unless otherwise noted. Full reviews of recent art shows: nytimes.com/art. A searchable guide to these and many other art shows is at nytimes.com/events.', 'print_section': 'C', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Museum and Gallery Listings for Aug. 30-Sept. 5', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Listings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-08-29T22:04:55+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/5f830489-12af-5111-8aec-2539af8ed7af', 'word_count': 4705, 'uri': 'nyt://article/5f830489-12af-5111-8aec-2539af8ed7af'}, {'abstract': 'The White Box gallery in Lower Manhattan displays a series of late-in-life paintings by Hyman Bloom, a popular midcentury artist, that feature Jewish leaders with Torahs.', 'web_url': 'https://www.nytimes.com/2013/08/30/arts/design/hyman-blooms-rabbi-paintings-at-white-box.html', 'snippet': 'The White Box gallery in Lower Manhattan displays a series of late-in-life paintings by Hyman Bloom, a popular midcentury artist, that feature Jewish leaders with Torahs.', 'lead_paragraph': 'The contemporary art world is a forgetful place. It can stay aware of only a limited number of artists, so as exciting names emerge, formerly celebrated phenomena fall down the memory hole. They don’t necessarily disappear, though. Many continue to make interesting art and enjoy lives of quiet fulfillment. Hyman Bloom (1913-2009) was one of those, and an exhibition of paintings of rabbis that he made late in life, at White Box gallery in Lower Manhattan, offers surprisingly much to ponder.', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30HYMAN/0830HYMAN-articleLarge.jpg', 'height': 808, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/30/arts/30HYMAN/0830HYMAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 808}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30HYMAN/0830HYMAN-jumbo.jpg', 'height': 1024, 'width': 761, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30HYMAN/0830HYMAN-superJumbo.jpg', 'height': 2021, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30HYMAN/0830HYMAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/30/arts/30HYMAN/0830HYMAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30HYMAN/0830HYMAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Walk Along the Boundaries of Faith and Flesh', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'A Walk Along The Boundaries Of Faith and Flesh', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bloom, Hyman', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-29T22:07:30+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original':