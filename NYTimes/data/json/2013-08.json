, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-jumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-superJumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Girls Not Allowed', 'kicker': None, 'content_kicker': None, 'print_headline': 'Girls Not Allowed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blogs and Blogging (Internet)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-01T18:38:46+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Philip Galanes', 'person': [{'firstname': 'Philip', 'middlename': None, 'lastname': 'Galanes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/94cb66c1-4c2f-559e-ab74-e314ab6e1e85', 'word_count': 866, 'uri': 'nyt://article/94cb66c1-4c2f-559e-ab74-e314ab6e1e85'}, {'abstract': 'For those of us stuck in the sweltering city on summer weekends, there are plenty of free places to get in the water.', 'web_url': 'https://www.nytimes.com/2013/08/02/nyregion/a-double-dose-of-water-delights-at-barretto-point-park.html', 'snippet': 'For those of us stuck in the sweltering city on summer weekends, there are plenty of free places to get in the water.', 'lead_paragraph': 'The Miser has gone off on vacation; he didn’t say where, but we imagine that he is perhaps surfing the waves somewhere sandy. Maybe we just have water on the mind — it sure seems to call in the summertime. Or, as E. E. Cummings put it, more poetically: “For whatever we lose (like a you or a me)/it’s always ourselves we find in the sea.”', 'print_section': 'C', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Double Dose of Water Delights at Barretto Point Park', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Double Dose of Water Delights at Barretto Point Park', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Swimming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Swimming Pools', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-01T19:00:11+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'New York', 'byline': {'original': 'By Steven McElroy', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'McElroy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of