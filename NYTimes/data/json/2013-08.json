e': None, 'lastname': 'Herrington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a5d1b787-61fb-5fa0-af19-4456bb095fc2', 'word_count': 277, 'uri': 'nyt://article/a5d1b787-61fb-5fa0-af19-4456bb095fc2'}, {'abstract': 'Alex Rodriguez said he wanted a positive welcome from the fans in his 2013 home debut.', 'web_url': 'https://www.nytimes.com/2013/08/09/sports/baseball/rodriguez-hoping-for-an-unlikely-reception.html', 'snippet': 'Alex Rodriguez said he wanted a positive welcome from the fans in his 2013 home debut.', 'lead_paragraph': 'Alex Rodriguez tried many different ways — denial, platitudes, flattery — to answer persistent questions about what might he might face at Yankee Stadium on Friday night when he makes his 2013 home debut. ', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rodriguez Hoping for an Unlikely Reception', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hoping for an Unlikely Reception', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Waldstein, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Alex', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-09T00:34:44+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/86b0c8d4-e86c-50be-814a-b1d