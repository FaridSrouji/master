ation': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74caf36f-b6c4-586a-b42e-4a4749e5d439', 'word_count': 1441, 'uri': 'nyt://article/74caf36f-b6c4-586a-b42e-4a4749e5d439'}, {'abstract': 'Health officials said the step would help the three million Americans with celiac disease and bring uniformity to the $4 billion market for gluten-free foods.', 'web_url': 'https://www.nytimes.com/2013/08/03/health/fda-sets-standard-for-foods-labeled-gluten-free.html', 'snippet': 'Health officials said the step would help the three million Americans with celiac disease and bring uniformity to the $4 billion market for gluten-free foods.', 'lead_paragraph': 'WASHINGTON — The federal government on Friday set a standard for gluten-free claims on food labels, a step that health officials said would help the three million Americans with celiac disease and bring uniformity to the $4 billion market for gluten-free products.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'F.D.A. Sets a Standard on Labeling ‘Gluten Free’', 'kicker': None, 'content_kicker': None, 'print_headline': 'F.D.A. Sets A Standard On Labeling ‘Gluten Free’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gluten', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tavernise, Sabrina', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Celiac Disease', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Labeling and Labels', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Massachusetts General Hospital', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Michael R', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-08-02T13:00:11+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Health', 'byline': {'original': 'By Sabrina Tavernise', 'person': [{'firstname': 'Sabrina', 'middlename': None, 'lastname': 'Tavernise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/23dc29b1-dcfb-5dd0-bc6d-8df8b0e5ac49', 'word_count': 577, 'uri': 'nyt://article/23dc29b1-dcfb-5dd0-bc6d-8df8b0e5ac49'}, {'abstract': 'How does The Times decide which online comments to highlight?', 'web_url': 'https://publiceditor.blogs.nytimes.com/2013/08/02/perfectly-reasonable-question-no-5-on-comment-picks/', 'snippet': 'How does The Times decide which online comments to highlight?', 'lead_paragraph': 'Each weekday, about 10,000 comments from readers come to The Times’s Web site. Not all are published but of those that are, some — perhaps 10 percent – are awarded a beribboned notation called an “NYT Pick.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Perfectly Reasonable Question No. 5: On Comment ‘Picks’', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Times', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-02T13:03:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c0e38a6-964c-5489-8033-daf3e2ba51f2', 'word_count': 653, 'uri': 'nyt://article/4c0e38a6-964c-5489-8033-daf3e2ba51f2'}, {'abstract': 'Anthology Film Archives celebrates the work of Georges Simenon with 14 feature films that have been adapted from his stories.', 'web_url': 'https://www.nytimes.com/2013/08/04/movies/anthology-film-archives-celebrates-georges-simenon.html', 'snippet': 'Anthology Film Archives celebrates the work of Georges Simenon with 14 feature films that have been adapted from his stories.', 'lead_paragraph': 'The worldwide Georges Simenon fan club is large — you don’t publish 400 to 500 books during your lifetime if you’re not striking a chord — and moviemakers make up one of its most active chapters. More than 120 feature films and at least 7 television series have been based on novels and short stories by Simenon, the prodigious Belgian writer who died in 1989. These days, entire studios, networks and streaming-video services are built on less content than that.', 'print_section': 'AR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04SIMENON1_SPAN/04SIMENON1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/04/arts/04SIMENON1_SPAN/04SIMENON1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04SIMENON1_SPAN/04SIMENON1-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04SIMENON1_SPAN/04SIMENON1-superJumbo.jpg', 'height': 801, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04SIMENON1_SPAN/04SIMENON1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/04/arts/04SIMENON1_SPAN/04SIMENON1-thumbStandard.jpg', 'thum