er': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d90cfe78-75d6-5ee6-ab8f-05872c619552', 'word_count': 312, 'uri': 'nyt://article/d90cfe78-75d6-5ee6-ab8f-05872c619552'}, {'abstract': 'Corrections appearing in print on August 22, 2013.', 'web_url': 'https://www.nytimes.com/2013/08/22/pageoneplus/corrections-august-22-2013.html', 'snippet': 'Corrections appearing in print on August 22, 2013.', 'lead_paragraph': 'FRONT PAGE', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: August 22, 2013', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-22T02:00:05+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/420fc5c3-fd70-5a54-964a-669e3d56bc55', 'word_count': 1024, 'uri': 'nyt://article/420fc5c3-fd70-5a54-964a-669e3d56bc55'}, {'abstract': 'Alex Rodriguez has instructed his representatives to refrain from the combative public approach they had adopted in recent days, saying the focus instead should be 100 percent on baseball.', 'web_url': 'https://www.nytimes.com/2013/08/22/sports/baseball/rodriguez-calls-end-to-public-feuding.html', 'snippet': 'Alex Rodriguez has instructed his representatives to refrain from the combative public approach they had adopted in recent days, saying the focus instead should be 100 percent on baseball.', 'lead_paragraph': 'After a series of explosive interviews and one awkward television appearance by his lawyer, Joseph Tacopina, Alex Rodriguez has instructed his representatives to stand down and refrain from the combative public approach they had adopted in recent days.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rodriguez Calls End to Public Feuding', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rodriguez Calls End To Public Feuding', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Waldstein, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tacopina, Joseph', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Alex', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Baseball', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-08-22T02:00:23+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f2a2d69c-e5b0-55d6-82d1-2a29c925ad73', 'word_count': 675, 'uri': 'nyt://article/f2a2d69c-e5b0-55d6-82d1-2a29c925ad73'}, {'abstract': 'The charred carcass of one of Queen Elizabeth’s own swans was found after having been barbecued and eaten, according to the police and a charity called Swan Lifeline.', 'web_url': 'https://www.nytimes.com/2013/08/22/world/europe/england-queens-swan-is-barbecued-and-eaten.html', 'snippet': 'The charred carcass of one of Queen Elizabeth’s own swans was found after having been barbecued and eaten, according to the police and a charity called Swan Lifeline.', 'lead_paragraph': ' The charred carcass of one of Queen Elizabeth’s own swans was found on a riverbank near Windsor Castle after having been barbecued and eaten, according to the police and a charity called Swan Lifeline. The swan was one of about 200 that live on Baths Island and belong to the queen. Until 1998, under a law dating to the 12th century, killing or injuring a swan was classified as treason, and the crown retains ownership of all unmarked mute swans in areas along the River Thames. Wild swans are also protected under a 1981 act, and to injure or kill a swan — let alone eat one — is against the law. Wendy Hermon of Swan Lifeline said that “the whole breast had been removed, and it looked like it had been eaten for lunch.” There was “just a swan skeleton left,” she said. “It’s absolutely disgusting, I can’t imagine the kind of people that would do this.” She said the carcass, with its feathers still attached, was taken by her group to be cremated. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'England: Queen’s Swan Is Barbecued and Eaten', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'England: Queen’s Swan Is Barbecued and Eaten', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Erlanger, Steven', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'England', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Swans', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Elizabeth II, Queen of Great Britain', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-22T02:05:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Steven Erlanger', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Erlanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/94da0f42-f852-5554-9d40-d28cd9f37e95', 'word_count': 175, 'uri': 'nyt://article/94da0f42-