rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Federal-State Relations (US)', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-08-28T16:18:05+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By John Schwartz', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e76cbd53-9569-5d95-aefb-4873c8d617d4', 'word_count': 1188, 'uri': 'nyt://article/e76cbd53-9569-5d95-aefb-4873c8d617d4'}, {'abstract': 'The state never banned same-sex unions, and it never specifically permitted them.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/08/28/marriage-equality-in-new-mexico/', 'snippet': 'The state never banned same-sex unions, and it never specifically permitted them.', 'lead_paragraph': 'When arguing against same-sex marriage, opponents often stress that marriage has always been defined as a union between a man and a woman.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Marriage Equality in New Mexico', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New Mexico', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-08-28T16:18:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f425c7b-3efe-541b-a5cb-ea30d4c2189d', 'word_count': 326, 'uri': 'nyt://article/5f425c7b-3efe-541b-a5cb-ea30d4c2189d'}, {'abstract': 'The lineup for the 40th-anniversary edition of the Telluride Film Festival is announced.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/08/28/at-telluride-redford-the-coens-and-the-zapruder-film/', 'snippet': 'The lineup for the 40th-anniversary edition of the Telluride Film Festival is announced.', 'lead_paragraph': 'TELLURIDE, Colo. — To celebrate its 40th anniversary, the Telluride Film Festival — which devotes each Labor Day weekend to restored classics, world cinema discoveries and possible Oscar contenders — has added an extra day of screenings. This means that the festival’s lineup, a closely guarded secret, has been announced a day earlier than usual.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/28/movies/all-is-lost/all-is-lost-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/28/movies/all-is-lost/all-is-lost-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/28/movies/all-is-lost/all-is-lost-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/28/movies/all-is-lost/all-is-lost-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/28/movies/all-is-lost/all-is-lost-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/28/movies/all-is-lost/