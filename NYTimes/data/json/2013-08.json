ub/11GRAYMATTERsub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11GRAYMATTERsub/11GRAYMATTERsub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dr. Google Will See You Now', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dr. Google Will See You Now', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Search Engines', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Depression (Mental)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-09T20:08:23+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Seth Stephens-Davidowitz', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Stephens-Davidowitz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/47a2fd92-e40b-569c-b987-6846bb020f99', 'word_count': 775, 'uri': 'nyt://article/47a2fd92-e40b-569c-b987-6846bb020f99'}, {'abstract': 'The Chinese Embassy urged an investigation to determine whether its citizens were specifically targeted.', 'web_url': 'https://www.nytimes.com/2013/08/10/world/asia/three-chinese-workers-found-dead-in-kabul-apartment.html', 'snippet': 'The Chinese Embassy urged an investigation to determine whether its citizens were specifically targeted.', 'lead_paragraph': 'KABUL, Afghanistan — Three Chinese workers were found dead under mysterious circumstances in an apartment in central Kabul on Friday, officials said, prompting the Chinese Embassy to urge the Afghan government to investigate to determine whether its citizens were specifically targeted.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bodies of 3 Chinese Workers Found in a Kabul Apartment', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bodies of 3 Chinese Workers Found in a Kabul Apartment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ahmed, Azam', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sahak, Sharifullah', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Prostitution', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-09T20:12:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Sharifullah Sahak and Azam Ahmed', 'person': [{'firstname': 'Sharifullah', 'middlename': None, 'lastname': 'Sahak', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Azam', 'middlename': None, 'lastname': 'Ahmed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed5f51bd-cfa5-58f9-bfe6-d50fa61bfb49', 'word_count': 664, 'uri': 'nyt://article/ed5f51bd-cfa5-58f9-bfe6-d50fa61bfb49'}, {'abstract': 'Dance Heginbotham presented the premiere of “Manhattan Research,” a work set to the music of Raymond Scott, at Lincoln Center Out of Doors.', 'web_url': 'https://www.nytimes.com/2013/08/10/arts/dance/dance-heginbotham-presents-manhattan-research.html', 'snippet': 'Dance Heginbotham presented the premiere of “Manhattan Research,” a work set to the music of Raymond Scott, at Lincoln Center Out of Doors.', 'lead_paragraph': 'You may have known his music all your life without knowing his name. In the 1930s, Raymond Scott was at the forefront of avant-garde jazz. Later, he was an early inventor of electronic music and instruments. But in the 1940s, his compositions, zany yet fastidious, were adopted as the soundtracks for Warner Brothers cartoons. Much as European modernism became the sound of horror films, Scott’s experimental music became associated with Bugs Bunny and Daffy Duck.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10HEGINBOTHAM/10HEGINBOTHAM-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/10/arts/10HEGINBOTHAM/10HEGINBOTHAM-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10HEGINBOTHAM/10HEGINBOTHAM-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10HEGINBOTHAM/10HEGINBOTHAM-superJumbo.jpg', 'height': 1983, 'width': 1983, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/arts/10HEGINBOTHAM/10HEGINBOTHAM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/10/arts/10HEGINBOTHAM/10HEGINBOTHAM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'cap