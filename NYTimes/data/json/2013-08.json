/16HERMITAGE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Every Cat Has Its Day: Hermitage Museum’s Mouse Catchers Are Immortalized in Portraits', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Every Cat Has Its Day At the Hermitage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cats', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Hermitage Museum (Saint Petersburg, Russia)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'St Petersburg (Russia)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-16T18:19:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Sophia Kishkovsky', 'person': [{'firstname': 'Sophia', 'middlename': None, 'lastname': 'Kishkovsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cbd99bbb-e69a-5334-834a-a35d7b8ab48f', 'word_count': 634, 'uri': 'nyt://article/cbd99bbb-e69a-5334-834a-a35d7b8ab48f'}, {'abstract': 'Staff members at hotels are offering expertise in beer, cava and whiskey, among other spirits.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/08/16/hotel-drinking-gets-specialized/', 'snippet': 'Staff members at hotels are offering expertise in beer, cava and whiskey, among other spirits.', 'lead_paragraph': 'Bartenders are a mainstay at most upscale hotels, but some properties today have staff members who are specialists in just one type of alcohol.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hotel Drinking Gets Specialized', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keyw