rds': [{'name': 'glocations', 'value': 'North Korea', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Kaesong (North Korea)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-14T12:52:52+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Choe Sang-Hun', 'person': [{'firstname': 'Choe', 'middlename': None, 'lastname': 'Sang-Hun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac2e7fcc-4f5e-550b-80df-87513c7aac49', 'word_count': 657, 'uri': 'nyt://article/ac2e7fcc-4f5e-550b-80df-87513c7aac49'}, {'abstract': 'The stock sales by Michael Rapino, the chief executive, represent about 38 percent of his direct holdings in Live Nation Entertainment.', 'web_url': 'https://www.nytimes.com/2013/08/15/business/media/live-nation-chief-sells-nearly-12-million-in-stock.html', 'snippet': 'The stock sales by Michael Rapino, the chief executive, represent about 38 percent of his direct holdings in Live Nation Entertainment.', 'lead_paragraph': 'Michael Rapino, the chief executive of Live Nation Entertainment, has sold $11.7 million of stock in the company in recent days, representing about 38 percent of his direct holdings, the company revealed in a regulatory filing late Tuesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Live Nation Chief Sells Nearly $12 Million in Stock', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Ticketmaster', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Live Nation Entertainment Inc', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rapino, Michael', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hubbard, Nathan', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-14T12:59:51+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/40de8e33-6037-566a-941a-2ee1fc92dfe4', 'word_count': 343, 'uri': 'nyt://article/40de8e33-6037-566a-941a-2ee1fc92dfe4'}, {'abstract': 'The trailblazing New York restaurateurs Ken Friedman and April Bloomfield have rescued and revamped the North Beach cafe Tosca — with a little help from Sean Penn.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/08/14/by-design-a-second-act-for-a-legendary-san-francisco-watering-hole/', 'snippet': 'The trailblazing New York restaurateurs Ken Friedman and April Bloomfield have rescued and revamped the North Beach cafe Tosca — with a little help from Sean Penn.', 'lead_paragraph': 'Last summer the actor Sean Penn heard that the owner of the legendary Tosca Cafe in North Beach, San Francisco’s iconic Italian neighborhood, was being evicted, so he sent a text to his friend Ken Friedman, the New York restaurateur behind the Spotted Pig and the Breslin. Friedman used to hang out at Tosca when he worked for the concert promoter Bill Graham, mixing with local power players like former Mayor Willie Brown and Gov. Jerry Brown. In fact, generations of cultural figures ranging from Hunter S. Thompson to Sam Shepard to Johnny Depp have gathered within Tosca’s muraled walls to swap stories and make deals, often over the “house cappuccino” — a variation on Irish coffee made with cocoa and brandy that was invented there during Prohibition. “There was always opera on the jukebox, and I remember the drinks being better than they actually were,” Friedman said. “From Sean’s text on, it was, ‘Let’s save Tosca from becoming a Subway shop or a whiskey bar.”', 'print_section': 'M2', 'print_page': '102', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'By Design | A Second Act for a Legendary San Francisco Watering Hole', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Food Matters: Restaging Tosca', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomfield, April', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Penn, Sean', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-14T13:00:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Jesse Ashlock', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'Ashlock', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/40d68ec7-957d-57ce-a147-23b77e93a3f7', 'word_count': 270, 'uri': 'nyt://article/40d68ec7-957d-57ce-a147-23b77e93a3f7'}, {'abstract': 'Learn more about the Civil Rights Movement by playing our crossword, either online or in print.', 'web_url': 'https://learning.blogs.nytimes.com/2013/08/14/student-crossword-the-civil-rights-movement/', 'snippet': 'Learn more about the Civil Rights Movement by playing our crossword, either online or in print.', 'lead_paragraph': 'Learn more about the Civil Rights Movement by playing our crossword (PDF). You can find the answers here.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/06/06/us/EVERS-3-LN/EVERS-3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge