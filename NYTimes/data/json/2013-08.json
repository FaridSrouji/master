lename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e58f2b0-0f29-5d1d-a123-6342533fd4d6', 'word_count': 939, 'uri': 'nyt://article/4e58f2b0-0f29-5d1d-a123-6342533fd4d6'}, {'abstract': 'The restrictive agreement between the government and the family of the unknowing HeLa cells donor was welcome and long overdue.', 'web_url': 'https://www.nytimes.com/2013/08/11/opinion/sunday/another-twist-in-the-saga-of-henrietta-lacks.html', 'snippet': 'The restrictive agreement between the government and the family of the unknowing HeLa cells donor was welcome and long overdue.', 'lead_paragraph': 'When Henrietta Lacks was stricken with an aggressive cancer more than 60 years ago, doctors who treated her at Johns Hopkins Hospital in Baltimore took cells from her tumor without her permission or knowledge, as was common practice at the time. They soon learned that the cells were just as aggressive in a laboratory dish. Instead of dying quickly as previous cell lines had, they kept replicating at an astonishing rate, earning them the label “immortal” and making them immensely valuable to any scientist who wanted a stable base for experiments. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Another Twist in the Saga of Henrietta Lacks', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Another Twist in the Saga of Henrietta Lacks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lacks, Henrietta', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'DNA (Deoxyribonucleic Acid)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Genetics and Heredity', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-10T17:58:47+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/72728969-e87e-51de-b600-2c4aded6c2c0', 'word_count': 340, 'uri': 'nyt://article/72728969-e87e-51de-b600-2c4aded6c2c0'}, {'abstract': 'Having more hybrid and electric vehicles on the road will help reduce greenhouse gas emissions.', 'web_url': 'https://www.nytimes.com/2013/08/11/opinion/sunday/a-clean-car-boom.html', 'snippet': 'Having more hybrid and electric vehicles on the road will help reduce greenhouse gas emissions.', 'lead_paragraph': 'In a welcome development for the planet, the cars on American streets are becoming much more climate-friendly much sooner than many had expected. Consumers are increasingly buying fuel-efficient hybrid and electric vehicles thanks to breakthrough innovations and supportive government policies. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Clean-Car Boom', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Clean-Car Boom', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electric and Hybrid Vehicles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fuel Efficiency', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-10T17:58:51+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/effa469b-3397-5b31-80fe-7bba1a54ff5b', 'word_count': 361, 'uri': 'nyt://article/effa469b-3397-5b31-80fe-7bba1a54ff5b'}, {'abstract': 'The Supreme Court orders the release of 10,000 more inmates, but the state’s criminal justice problems run deeper.', 'web_url': 'https://www.nytimes.com/2013/08/11/opinion/sunday/californias-continuing-prison-crisis.html', 'snippet': 'The Supreme Court orders the release of 10,000 more inmates, but the state’s criminal justice problems run deeper.', 'lead_paragraph': 'California has long been held up as the land of innovation and fresh starts, but on criminal justice and incarceration, the Golden State remains stubbornly behind the curve. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'California’s Continuing Prison Crisis', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'California’s Continuing Prison Crisis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'California', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-10T17:59:57+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/12bb3aaa-8009-5a2f-a2cf-7ddecd8057ef', 'word_count': 930, 'uri': 'nyt://article/12bb3aaa-8009-5a2f-a2cf-7ddecd8057ef'}, {'abstract': 'Jim Furyk made impressive putts on Nos. 17 and 18 to card a 68 and take a one-stroke lead over Jason Dufner, who settled for a one-over-par 71 at the third round of the P.G.A. Championship.', 'web_url': 'https://www.nytimes.com/2013/08/11/sports/pga-day-3-perfect-conditions-for-low-scores.html', 'snippet': 'Jim Furyk made impressive putts on Nos. 17 and 18 to card a 68 and take a one-stroke lead over Jason Dufner, who settled for a one-over-par 71 at the third round of the P.G.A. Championship.', 'lead_paragraph': 'PITTSFORD, N.Y. — At the P.G.A. Championship on Saturday, the weather stopped fluctuating and the leader board began to rock back and forth. The third round at Oak Hill Country Club, played in abundant sunshine, low humidity and gentle breezes, turned into a seesaw ride with Jason Dufner and Jim Furyk taking turns going up and down.', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sports/pga/pga-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/11/sports/pga/pga-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sports/pga/pga-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sports/pga/pga-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sports/pga/pga-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/11/sports/pga/pga-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sports/pga/pga-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Men of Few Words Are Talk of the Tournament', 'kicker': None, 'content_kicker': None, 'print_headline': 'Men of Few Words Are Talk of the Tournament', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'PGA Championship', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dufner, Jason', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Furyk, Jim', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Golf', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'PGA Tour Inc', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-10T18:12:40+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35a1cd41-414e-531a-ab79-650a291d0b26', 'word_count': 1034, 'uri': 'nyt://article/35a1cd41-414e-531a-ab79-650a291d0b26'}, {'abstract': 'Socialbots are being designed to sway elections, to influence the stock market, even to flirt with people and one another.', 'web_url': 'https://www.nytimes.com/2013/08/11/sunday-review/i-flirt-and-tweet-follow-me-at-socialbot.html', 'snippet': 'Socialbots are being designed to sway elections, to influence the stock market, even to flirt with people and one another.', 'lead_paragraph': 'FROM the earliest days of the Internet, robotic programs, or bots, have been trying to pass themselves off as human. Chatbots greet users when they enter an online chat room, for example, or kick them out when they get obnoxious. More insidiously, spambots indiscriminately churn out e-mails advertising miracle stocks and unattended bank accounts in Nigeria. Bimbots deploy photos of gorgeous women to hawk work-from-home job ploys and illegal pharmaceuticals.', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11BOTS/11BOTS-articleLarge.jpg', 'height': 326, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/11/sunday-review/11BOTS/11BOTS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 326}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11BOTS/11BOTS-jumbo.jpg', 'height': 556, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11BOTS/11BOTS-superJumbo.jpg', 'height': 1112, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11BOTS/11BOTS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/11/sunday-review/11BOTS/11BOTS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11BOTS/11BOTS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Flirt and Tweet. Follow Me at #Socialbot.', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'I Flirt and Tweet. Follow Me at #Socialbot.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Urbina, Ian', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-10T18:13:52+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Sunday Review', 'byline': {'original': 'By Ian Urbina', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Urbina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/e59e1b1f-0a1d-5137-bc8c-b1029850c1ea', 'word_count': 968, 'uri': 'nyt://article/e59e1b1f-0a1d-5137-bc8c-b1029850c1ea'}, {'abstract': 'When a prisoner asked for my\r\nbooks, I learned his horrifying story.', 'web_url': 'https://www.nytimes.com/2013/08/11/opinion/sunday/after-guantanamo-another-injustice.html', 'snippet': 'When a prisoner asked for my\r\nbooks, I learned his horrifying story.', 'lead_paragraph': 'ABOUT two months ago I learned that some of my books had been banned at Guantánamo Bay. Apparently detainees were requesting them, and their lawyers were delivering them to the prison, but they were not being allowed in because of “impermissible content.”', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11GRISHAM/11GRISHAM-articleLarge.jpg', 'height': 456, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/11/sunday-review/11GRISHAM/11GRISHAM-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 456}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11GRISHAM/11GRISHAM-jumbo.jpg', 'height': 778, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11GRISHAM/11GRISHAM-superJumbo.jpg', 'height': 1555, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11GRISHAM/11GRISHAM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/11/sunday-review/11GRISHAM/11GRISHAM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11GRISHAM/11GRISHAM-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Guantánamo, Another Injustice', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'After Guantánamo, Another Injustice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Detainees', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Grisham, John', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Guantanamo Bay Naval Base (Cuba)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-10T18:14:35+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By John Grisham', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Grisham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/bcc20ac7-f595-5d78-85f0-adef1a3b8e22', 'word_count': 1232, 'uri': 'nyt://article/bcc20ac7-f595-5d78-85f0-adef1a3b8e22'}, {'abstract': 'Does “leaning in” pay off differently for men and women?', 'web_url': 'https://www.nytimes.com/2013/08/11/opinion/sunday/when-leaning-in-doesnt-pay-off.html', 'snippet': 'Does “leaning in” pay off differently for men and women?', 'lead_paragraph': 'WHY do women not have as many leadership roles in the workplace as men do? Some have pointed to internal barriers, suggesting that the problem is partly attributable to something about women themselves — they are not “ambitious enough” at work (while pursuing meaningful family goals), or are deeply committed to work but too hesitant to climb leadership ladders in organizations. Others cite structural or institutional barriers, like bias, discrimination or inadequate work-family flexibility. Sheryl Sandberg, in her now famous phrase, would have women “lean in,” to be more assertive at work and not let biases keep them from pushing forward. By leaning in, women would obtain more authority.', 'print_section': 'SR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11LEANIN/11LEANIN-articleLarge.jpg', 'height': 539, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/11/sunday-review/11LEANIN/11LEANIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 539}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11LEANIN/11LEANIN-jumbo.jpg', 'height': 919, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11LEANIN/11LEANIN-superJumbo.jpg', 'height': 1838, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11LEANIN/11LEANIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/11/sunday-review/11LEANIN/11LEANIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11LEANIN/11LEANIN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Leaning In Doesn’t Pay Off', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'When Leaning In Doesn’t Pay Off', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schieman, Scott', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Schafer, Markus', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McIvor, Mitchell', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Environment', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Work-Life Balance', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Sociological Perspectives (Journal)', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-08-10T18:14:59+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Scott Schieman, Markus Schafer and Mitchell McIvor', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Schieman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Markus', 'middlename': None, 'lastname': 'Schafer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Mitchell', 'middlename': None, 'lastname': 'McIvor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e576090c-3843-5882-b06b-d61081ed2c56', 'word_count': 992, 'uri': 'nyt://article/e576090c-3843-5882-b06b-d61081ed2c56'}, {'abstract': 'American soldiers need help understanding the veiled meanings behind the stories of their allies and enemies.', 'web_url': 'https://www.nytimes.com/2013/08/11/opinion/sunday/how-to-read-afghanistan.html', 'snippet': 'American soldiers need help understanding the veiled meanings behind the stories of their allies and enemies.', 'lead_paragraph': 'ON a sunny, crisp November day in 2008, three American civilians joined a platoon of United States soldiers on a foot patrol in Maiwand District, a flat, yellow patch of earth crowned by black-rock mountains in southern Afghanistan. The civilians were part of the Human Terrain System, an ambitious, troubled Army program that sends social scientists into conflict zones to help soldiers understand local culture, politics and economics. ', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11AFGHANISTAN/11AFGHANISTAN-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/11/sunday-review/11AFGHANISTAN/11AFGHANISTAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/sunday-review/11AFGHANISTAN/11AFGHANISTAN-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type':