le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d0c2afcd-8d6c-5ce8-bb51-c61b1b47635c', 'word_count': 63, 'uri': 'nyt://article/d0c2afcd-8d6c-5ce8-bb51-c61b1b47635c'}, {'abstract': 'Large numbers of students failed the state exams, which were aligned with a more rigorous set of standards known as the Common Core.', 'web_url': 'https://www.nytimes.com/2013/08/08/nyregion/under-new-standards-students-see-sharp-decline-in-test-scores.html', 'snippet': 'Large numbers of students failed the state exams, which were aligned with a more rigorous set of standards known as the Common Core.', 'lead_paragraph': 'The number of New York students passing state reading and math exams dropped drastically this year, education officials reported on Wednesday, unsettling parents, principals and teachers and posing new challenges to a national effort to toughen academic standards.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/nyregion/08scores-web/08scores-web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/08/nyregion/08scores-web/08scores-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/nyregion/08scores-web/08scores-web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/nyregion/08scores-web/08scores-web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': No