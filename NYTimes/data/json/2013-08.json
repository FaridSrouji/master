': 'images/2013/09/04/dining/04KITCH3_SPAN/04KITCH3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/04/dining/04KITCH3_SPAN/04KITCH3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Whole Fish and Nothing But', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Whole Fish and Nothing But', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tanis, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Seafood', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-30T17:52:05+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ea5ea2fa-5038-5080-aef4-72455f9fcb3e', 'word_count': 507, 'uri': 'nyt://article/ea5ea2fa-5038-5080-aef4-72455f9fcb3e'}, {'abstract': 'Because many Israelis don’t own cars, bus travel is the way to get around. Sooner or later, most people there will end up passing through Tel Aviv’s huge, jarring central bus station.', 'web_url': 'https://wheels.blogs.nytimes.com/2013/08/30/mediterranean-escher-a-glimpse-inside-tel-avivs-central-bus-station/', 'snippet': 'Because many Israelis don’t own cars, bus travel is the way to get around. Sooner or later, most people there will end up passing through Tel Aviv’s huge, jarring central bus station.', 'lead_paragraph': 'TEL AVIV – As Labor Day weekend approaches, hundreds of thousands of bus passengers, eager to savor summer’s last gasp, will pass through the Port Authority Bus Terminal. As baffling as some tourists – and even New Yorkers – find the place, imagine that sort of human traffic scurrying through a labyrinth of oddly placed stairways and market stalls. Picture that in your mind’s eye, and you’ll know what it’s like to travel by bus through Tel Aviv.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/automobiles/wheels/TLV-top-with-5/TLV-top-with-5-articleLarge.jpg', 'height': 411, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/23/automobiles/wheels/TLV-top-with-5/TLV-top-with-5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 411}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/automobiles/wheels/TLV-top-with-5/TLV-top-with-5-jumbo.jpg', 'height': 701, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/automobiles/wheels/TLV-top-with-5/TLV-top-with-5-superJumbo.jpg', 'height': 1401, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/automobiles/wheels/TLV-top-with-5/TLV-top-with-5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/23/automobiles/wheels/TLV-top-with-5/TLV-top-with-5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/automobiles/wheels/TLV-top-with-5/TLV-top-with-5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'