rge.jpg', 'xlargewidth': 600, 'xlargeheight': 767}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/0901-Holt/0901-Holt-jumbo.jpg', 'height': 1024, 'width': 802, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/0901-Holt/0901-Holt-superJumbo.jpg', 'height': 1799, 'width': 1408, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/0901-Holt/0901-Holt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/09/01/books/review/0901-Holt/0901-Holt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/0901-Holt/0901-Holt-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Big Brother', 'kicker': None, 'content_kicker': None, 'print_headline': 'Big Brother', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Holt, Elliott', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bock, Dennis', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-30T14:26:16+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Elliott Holt', 'person': [{'firstname': 'Elliott', 'middlename': None, 'lastname': 'Holt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/41cfe84c-2fe4-5fce-85af-99709c26eccb', 'word_count': 1155, 'uri': 'nyt://article/41cfe84c-2fe4-5fce-85af-99709c26eccb'}, {'abstract': 'A poet whose work inhabited a variety of subjects and forms.', 'web_url': 'https://www.nytimes.com/2013/09/01/books/review/louis-macneices-collected-poems.html', 'snippet': 'A poet whose work inhabited a variety of subjects and forms.', 'lead_paragraph': 'Major poets, like trick-or-treaters, tend to arrive in pairs or small groups (whether this is a matter of fate or academic convenience may be debated). And yet from roughly 1930 to 1950, British and Irish poetry seemed to fall under the sway of a single writer: W. H. Auden. Auden was hardly a solitary figure, of course — his compatriots included Louis MacNeice, Stephen Spender and Cecil Day-Lewis (father of Daniel), and the four writers were once thought to be so intimately related that the poet Roy Campbell referred to them as “MacSpaunday.” But it wasn’t a relationship of equals: the MacSpaunday poets were usually considered notable not because of how closely they resembled one another, but because of how much the other three looked like Auden.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01SUBORR/01SUBORR-articleLarge.jpg', 'height': 677, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/09/01/books/review/01SUBORR/01SUBORR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 677}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01SUBORR/01SUBORR-jumbo.jpg', 'height': 1024, 'width': 909, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01SUBORR/01SUBORR-superJumbo.jpg', 'height': 2048, 'width': 1817, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01SUBORR/01SUBORR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/09/01/books/review/01SUBORR/01SUBORR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01SUBORR/01SUBORR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Free Range', 'kicker': None, 'content_kicker': None, 'print_headline': 'Free Range', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poetry and Poets', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'MacNeice, Louis', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-30T14:26:32+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By David Orr', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Orr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c1a8f0c2-4103-511a-ad45-e5c9bd3dbf5d', 'word_count': 1171, 'uri': 'nyt://article/c1a8f0c2-4103-511a-ad45-e5c9bd3dbf5d'}, {'abstract': 'A biography of the nationalist poet Gabriele d’Annunzio, whose theatrical sense of political style influenced Mussolini.', 'web_url': 'https://www.nytimes.com/2013/09/01/books/review/gabriele-dannunzio-by-lucy-hughes-hallett.html', 'snippet': 'A biography of the nationalist poet Gabriele d’Annunzio, whose theatrical sense of political style influenced Mussolini.', 'lead_paragraph': 'As capitalism transformed European economies during the second half of the 19th century, the rise of the masses revolutionized political life. Searching for identity and purpose in a confusing and changing world, many took refuge in nationalism — a continentwide phenomenon that found its most virulent expression in newly created countries like Germany and Italy, where it soon upended culture along with everything else.', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01BERMAN/01BERMAN-articleLarge.jpg', 'height': 511, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/09/01/books/review/01BERMAN/01BERMAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 511}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01BERMAN/01BERMAN-jumbo.jpg', 'height': 872, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01BERMAN/01BERMAN-superJumbo.jpg', 'height': 1358, 'width': 1595, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/review/01BERMAN/01BERMAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/09/01/books/review/01BERMAN/01BERMAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/books/