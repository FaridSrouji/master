None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bac121d5-2bed-540a-ae34-99e796c693bb', 'word_count': 1038, 'uri': 'nyt://article/bac121d5-2bed-540a-ae34-99e796c693bb'}, {'abstract': 'Back in the United States after losing too many comrades in Afghanistan, Staff Sgt. Ty Michael Carter has become a symbol of the courage not only to face the enemy, but to face what comes next.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/08/26/obama-honors-soldier-for-bravery-under-fire-and-afterward/', 'snippet': 'Back in the United States after losing too many comrades in Afghanistan, Staff Sgt. Ty Michael Carter has become a symbol of the courage not only to face the enemy, but to face what comes next.', 'lead_paragraph': 'For generations, soldiers have been honored at the White House for valor under fire. And no one questions the heroism of Staff Sgt. Ty Michael Carter, who raced through a hail of bullets to rescue a wounded comrade and helped keep Taliban fighters from overrunning a combat post in Afghanistan.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama Honors Soldier for Bravery Under Fire, and Afterward', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medal of Honor (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Post-Traumatic Stress Disorder', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Carter, Ty Michael', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-26T21:25:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Peter Baker', 'person': [{'firstname': 'Peter', 'middlename': None,