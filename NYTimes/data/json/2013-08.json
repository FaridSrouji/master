nt_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Puzzles', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-17T16:00:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/13bc0da5-8d1d-5708-b064-015de4688567', 'word_count': 288, 'uri': 'nyt://article/13bc0da5-8d1d-5708-b064-015de4688567'}, {'abstract': 'Kelli White’s positive test 10 years ago began a new era in track and field because she decided to help anti-doping organizations in their fight.', 'web_url': 'https://www.nytimes.com/2013/08/18/sports/olympics/out-of-a-doping-scandal-redemption-for-Kelli-White-and-progress-for-track.html', 'snippet': 'Kelli White’s positive test 10 years ago began a new era in track and field because she decided to help anti-doping organizations in their fight.', 'lead_paragraph': 'MOSCOW — Ten years ago this month, the American sprinter Kelli White tested positive for modafinil, a stimulant used to treat narcolepsy, after winning the 100- and 200-meter gold medals at the world track and field championships in Paris. It was the first time a track athlete from the United States had tested positive during a world or Olympic championship event.', 'print_section': 'SP', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/sports/yDOPING1-dog/yDOPING1-dog-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/18/sports/yDOPING1-dog/yDOPING1-dog-articleLarge.