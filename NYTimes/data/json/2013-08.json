iew: 'Kick-Ass 2'", 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-16T16:28:06+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Movies', 'byline': {'original': 'Vijai Singh', 'person': [{'firstname': 'Vijai', 'middlename': None, 'lastname': 'Singh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/02a9431b-1fb5-5acb-8d84-866611d65ae0', 'word_count': 0, 'uri': 'nyt://video/02a9431b-1fb5-5acb-8d84-866611d65ae0'}, {'abstract': 'The service, Patch, has been losing money and has been a frustration for AOL’s chief executive, Tim Armstrong. The company is expected to shed many of its 900 local sites.', 'web_url': 'https://www.nytimes.com/2013/08/17/business/media/aol-to-cut-up-to-500-jobs-at-local-news-service.html', 'snippet': 'The service, Patch, has been losing money and has been a frustration for AOL’s chief executive, Tim Armstrong. The company is expected to shed many of its 900 local sites.', 'lead_paragraph': 'AOL on Friday moved to cut losses at Patch, its struggling local news service, eliminating as many as 500 positions and closing or consolidating many of its sites across the country.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Deep Cuts at Patch, AOL’s Local News Sites', 'kicker': None, 'content_kicker': None, 'print_headline': 'Deep Cuts At Patch, AOL’s Local News Sites', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'AOL Inc', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Armstrong, Tim', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-08-16T16:28:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/99759a6b-fcc9-5a15-b7fe-e000e8eebf05', 'word_count': 428, 'uri': 'nyt://article/99759a6b-fcc9-5a15-b7fe-e000e8eebf05'}, {'abstract': 'A Tennessee judge last week forcibly changed a baby’s name from Messiah to Martin. The case raises two questions, one legal and the other religious.', 'web_url': 'https://www.nytimes.com/2013/08/17/us/in-the-name-of-god-or-baby-messiah-competing-claims-of-religious-freedom.html', 'snippet': 'A Tennessee judge last week forcibly changed a baby’s name from Messiah to Martin. The case raises two questions, one legal and the other religious.', 'lead_paragraph': 'Last week, when a Tennessee judge forcibly changed an infant’s name from Messiah to Martin, it was hard to decide which was more noteworthy, the parents’ grandiosity in naming their child for the one they consider their Savior or the judge’s religious zealotry in prohibiting the name.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/16/us/beliefs-inline1/beliefs-inline1-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/16/us/beliefs-inline1/beliefs-inline1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/16/us/beliefs-inline1/beliefs-inline1-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/16/us/beliefs-inline1/beliefs-inline1-superJumbo.jpg', 'height': 1125, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'super