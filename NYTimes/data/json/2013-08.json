word_count': 115, 'uri': 'nyt://article/45736b91-9b42-5ee8-8d21-4d85d2e6792c'}, {'abstract': 'After years of delays and stagnating fund-raising, New York’s Museum for African Art is assuming a new identity.', 'web_url': 'https://www.nytimes.com/2013/08/24/arts/design/museum-for-african-art-regroups-with-a-broader-mandate.html', 'snippet': 'After years of delays and stagnating fund-raising, New York’s Museum for African Art is assuming a new identity.', 'lead_paragraph': 'Soon after construction began in 2007 on the Museum for African Art’s new headquarters, engineers discovered a quicksand-like layer of sediment under the site, at Fifth Avenue and 110th Street. The structural problems were surmounted, but in other ways, the museum has had trouble finding stable ground since. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Museum for African Art Broadens Its Mandate', 'kicker': None, 'content_kicker': None, 'print_headline': 'Museum for African Art Broadens Its Mandate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum for African Art', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Thompson, Elsie McCabe', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Harlem (Manhattan, NY)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-08-23T18:24:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Patricia', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/40521138-82