eadline': {'main': 'Summer of the Big Dud', 'kicker': 'Timothy Egan', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-23T01:00:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70d06f78-f2eb-58f1-8478-03e605df211d', 'word_count': 877, 'uri': 'nyt://article/70d06f78-f2eb-58f1-8478-03e605df211d'}, {'abstract': 'What The Daily Mail hates is not Brussels, but today’s Britain.', 'web_url': 'https://www.nytimes.com/2013/08/23/opinion/cohen-britains-brussels-syndrome.html', 'snippet': 'What The Daily Mail hates is not Brussels, but today’s Britain.', 'lead_paragraph': 'LONDON — The basic tenet of The Daily Mail is that Britain is not what it was (true enough, it isn’t) and that it would go a long way toward recovering its gritty greatness without wind farms, safety obsessions, green lunacy, overregulation and — above all — the European Union with its meddling bureaucrats.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/cohen-circular/cohen-circular-articleLarge-v2.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/01/opinion/cohen-circular/cohen-circular-articleLarge-v2.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/cohen-circular/cohen-circular-jumbo-v4.png', 'height': 512, 'width': 1024, 