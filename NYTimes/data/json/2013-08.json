ilheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/fashion/08SKIN1_SPAN/08zSKIN1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Telling Stories, Selling Beauty', 'kicker': None, 'content_kicker': None, 'print_headline': 'Telling Stories, Selling Beauty', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Howard, Hilary', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cosmetics and Toiletries', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Beauty', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'QVC Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-07T21:47:23+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Hilary Howard', 'person': [{'firstname': 'Hilary', 'middlename': None, 'lastname': 'Howard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74d4e774-841e-5e82-a5c6-c41afe2278e5', 'word_count': 1039, 'uri': 'nyt://article/74d4e774-841e-5e82-a5c6-c41afe2278e5'}, {'abstract': 'A photographer’s new book documents the artistic spirit of the Hotel Chelsea.', 'web_url': 'https://www.nytimes.com/2013/08/08/garden/hotel-chelsea-by-victoria-cohen.html', 'snippet': 'A photographer’s new book documents the artistic spirit of the Hotel Chelsea.', 'lead_paragraph': 'In 2011, when the photographer Victoria Cohen heard that the Hotel Chelsea — the talent-suffused West 23rd Street building that housed the likes of Virgil Thomson, Bob Dylan, Janis Joplin, Charles Bukowski, Arthur C. Clarke, Allen Ginsberg and Sid Vicious — was to be sold and gut-renovated, she set out to document the rooms. “It became a responsibility, not just an artistic endeavor to capture the essence,” she said. “I was not photographing empty rooms, I was taking portraits.” The images in her new book, “Hotel Chelsea” (Pointed Leaf Press, $95), are as vivid and haunting as characters in a Fellini film. Shot in natural light, they summon the ghosts of those who lived with blood-red walls, spartan corner sinks or broken-down beds. An exhibition runs from Sept. 17 to Oct. 25 at Third Streaming, 10 Greene Street (Canal Street); pointedleafpress.com.\xa0', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/garden/08DEALS_SPAN/CURR-1-articleLarge.jpg', 'height': 428, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/08/garden/08DEALS_SPAN/CURR-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 428}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/garden/08DEALS_SPAN/CURR-1-jumbo.jpg', 'height': 731, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/garden/08DEALS_SPAN/CURR-1-superJumbo.jpg', 'height': 1462, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/garden/08DEALS_SPAN/CURR-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/08/garden/08DEALS_SPAN/CURR-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/garden/08DEALS_SPAN/CU