: [], 'headline': {'main': 'Video Reviews of ‘The Canyons,’ ‘Our Children’ and ‘2 Guns’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-02T12:59:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/a5463eef-5b00-5a82-b528-d323ae14c93b', 'word_count': 23, 'uri': 'nyt://article/a5463eef-5b00-5a82-b528-d323ae14c93b'}, {'abstract': 'This 11-disc compendium from Shout! Factory combines Lee’s four-feature oeuvre with copious supplemental material.', 'web_url': 'https://www.nytimes.com/2013/08/04/movies/homevideo/the-bruce-lee-legacy-collection-is-a-kick.html', 'snippet': 'This 11-disc compendium from Shout! Factory combines Lee’s four-feature oeuvre with copious supplemental material.', 'lead_paragraph': 'Forty years ago this summer, Bruce Lee died unexpectedly of a cerebral edema in the Hong Kong apartment of a colleague. The New York Times ran only a brief, news agency obituary for the 32-year-old actor and martial artist, who had been given star billing in only three, modestly budgeted Hong Kong films by the time of his death. But in a sense, his career was just beginning.', 'print_section': 'AR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04KEHR3_SPAN/04KEHR3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/04/arts/04KEHR3_SPAN/04KEHR3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/04/arts/04KEHR3_