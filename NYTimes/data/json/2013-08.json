umbLarge', 'legacy': {}}], 'headline': {'main': 'A Conservative Catholic Now Backs Same-Sex Marriage', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Conservative Catholic Now Backs Same-Sex Marriage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bottum, Joseph', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-23T18:01:22+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Mark Oppenheimer', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Oppenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cccdb13e-872d-5e64-ba6f-ad857a7deb89', 'word_count': 1094, 'uri': 'nyt://article/cccdb13e-872d-5e64-ba6f-ad857a7deb89'}, {'abstract': 'What a Russian official called evidence of Syria rebel propaganda on YouTube appears to be based on widespread confusion about how the video-sharing site, based in California, assigns dates to clips uploaded by users around the world.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/08/23/confused-by-how-youtube-assigns-dates-russians-cite-false-claim-on-syria-videos/', 'snippet': 'What a Russian official called evidence of Syria rebel propaganda on YouTube appears to be based on widespread confusion about how the video-sharing site, based in California, assigns dates to clips uploaded by users around the world.', 'lead_paragraph': 'Citing “reports circulating on the Internet,” a spokesman for Russia’s foreign ministry claimed on Friday that video posted online by opposition activists in Syria, said to show victims sufferi