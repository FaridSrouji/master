hout-t_CA3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/magazine/01lindhout4/mag-01lindhout-t_CA3-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/magazine/01lindhout4/mag-01lindhout-t_CA3-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/magazine/01lindhout4/01lindhout4-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/09/01/magazine/01lindhout4/01lindhout4-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/magazine/01lindhout4/01lindhout4-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '12 Minutes of Freedom in 460 Days of Captivity', 'kicker': None, 'content_kicker': None, 'print_headline': '460 Days', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lindhout, Amanda', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brennan, Nigel', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Corbett, Sara', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Somalia', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Kidnapping', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Hostages', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', '