': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/business/18-PRE/18-PRE-articleLarge.jpg', 'height': 566, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/18/business/18-PRE/18-PRE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 566}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/business/18-PRE/18-PRE-jumbo.jpg', 'height': 967, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/business/18-PRE/18-PRE-superJumbo.jpg', 'height': 1934, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/business/18-PRE/18-PRE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/18/business/18-PRE/18-PRE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/business/18-PRE/18-PRE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Leave ’Em Laughing, and Enlightened', 'kicker': None, 'content_kicker': None, 'print_headline': 'Leave ’Em Laughing, But Also Enlightened', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Buddhism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Careers and Professions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Income', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Meditation', 'rank': 5, 'major