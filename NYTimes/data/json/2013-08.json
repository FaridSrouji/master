/08/11/travel/11UPDATE/11UPDATE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 312}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/travel/11UPDATE/11UPDATE-jumbo.jpg', 'height': 531, 'width': 1022, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/travel/11UPDATE/11UPDATE-superJumbo.jpg', 'height': 531, 'width': 1022, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/travel/11UPDATE/11UPDATE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/11/travel/11UPDATE/11UPDATE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/11/travel/11UPDATE/11UPDATE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As Detroit Flounders, Its Art Scene Flourishes', 'kicker': 'Update', 'content_kicker': None, 'print_headline': 'As a City Flounders, Its Art Scene Flourishes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bankruptcies', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-06T21:07:11+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Courtney Balestier', 'person': [{'firstname': 'Courtney', 'middlename': None, 'lastname': 'Balestier', 'qualifier': None, 'title