ace.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Thursday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-01T05:00:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/53b68928-c164-5fd9-a1f2-9699ba2e164f', 'word_count': 733, 'uri': 'nyt://article/53b68928-c164-5fd9-a1f2-9699ba2e164f'}, {'abstract': 'See what you know about the news of the day.', 'web_url': 'https://learning.blogs.nytimes.com/2013/08/01/news-quiz-august-1-2013/', 'snippet': 'See what you know about the news of the day.', 'lead_paragraph': 'See what you know about the news below. To prepare, you might scan the articles or summaries on today’s paper. Good luck!', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'News Quiz | August 1, 2013', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-01T05:30:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Anastasia Economides', 'person': [{'firstname': 'Anastasia', 'middlename': None, 'lastname': 'Economides', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b023a560-5a93-509e-8515-26e07323fb31', 'word_count': 22, 'uri': 'nyt://article/b023a560-5a93-509e-8515-26e07323fb31'}, {'abstract': 'Pinch-hitter Lyle Overbay singled in the go-ahead run in the ninth after Hiroki Kuroda and Clayton Kershaw pitched a combined 15 scoreless innings.', 'web_url': 'https://www.nytimes.com/2013/08/01/sports/baseball/overbay-steps-in-for-yankees-and-breaks-up-pitchers-duel.html', 'snippet': 'Pinch-hitter Lyle Overbay singled in the go-ahead run in the ninth after Hiroki Kuroda and Clayton Kershaw pitched a combined 15 scoreless innings.', 'lead_paragraph': 'LOS ANGELES — Clayton Kershaw showered and dressed before returning to his locker to speak with reporters late Wednesday night, but the wet hair that he arrived with did little to cool him down.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01yanksgame1-img/01yanksgame1-img-articleLarge.jpg', 'height': 427, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/01/sports/baseball/01yanksgame1-img/01yanksgame1-img-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 427}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01yanksgame1-img/01yanksgame1-img-jumbo.jpg', 'height': 728, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01yanksgame1-img/01yanksgame1-img-superJumbo.jpg', 'height': 1456, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01yanksgame1-img/01yanksgame1-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/01/sports/baseball/01yanksgame1-img/01yanksgame1-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01yanksgame1-img/01yanksgame1-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Overbay Steps In for Yankees and Breaks Up Pitchers’ Duel', 'kicker': 'Yankees 3, Dodgers 0', 'content_kicker': None, 'print_headline': 'Overbay Steps In for Yankees and Breaks Up Pitchers&#8217; Duel', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Dodgers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Overbay, Lyle', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kuroda, Hiroki', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-01T05:38:59+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Billy Witz', 'person': [{'firstname': 'Billy', 'middlename': None, 'lastname': 'Witz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36558b82-11f4-5e46-a5bb-67504ef8d379', 'word_count': 131, 'uri': 'nyt://article/36558b82-11f4-5e46-a5bb-67504ef8d379'}, {'abstract': 'With a sweep of a single-admission doubleheader over the visiting Cardinals on Tuesday, the Pirates reclaimed the N.L. Central lead from St. Louis.', 'web_url': 'https://www.nytimes.com/2013/08/01/sports/baseball/a-rare-sight-in-pittsburgh-as-the-pirates-enter-august-in-first-place.html', 'snippet': 'With a sweep of a single-admission doubleheader over the visiting Cardinals on Tuesday, the Pirates reclaimed the N.L. Central lead from St. Louis.', 'lead_paragraph': 'PITTSBURGH — In the sixth inning of the nightcap of Tuesday’s doubleheader, a black bat circled above the seats just behind the Pirates’ third-base on-deck circle and ultimately settled high on the fans’ side of the screen. There it remained for the duration, utterly immobile and impervious to those who soon rocked the sold-out stadium in celebrating the Pirates’ twin-bill sweep of the St. Louis Cardinals that reclaimed the National League Central division lead from the visitors.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01bucs1-img/01bucs1-img-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/01/sports/baseball/01bucs1-img/01bucs1-img-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01bucs1-img/01bucs1-img-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01bucs1-img/01bucs1-img-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01bucs1-img/01bucs1-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/01/sports/baseball/01bucs1-img/01bucs1-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/sports/baseball/01bucs1-img/01bucs1-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Rare Sight in Pittsburgh as the Pirates Enter August in First Place', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Pittsburgh, a Rare Sight as the Pirates Enter August in First Place', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Pirates', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Melancon, Mark (1985- )', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-01T05:43:30+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Hillel Kuttler', 'person': [{'firstname': 'Hillel', 'middlename': None, 'lastname': 'Kuttler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/50711bf6-327c-535d-ad9f-89cf02186b33', 'word_count': 1337, 'uri': 'nyt://article/50711bf6-327c-535d-ad9f-89cf02186b33'}, {'abstract': 'The results for the world’s largest steel company were hurt by continued losses in Europe, which continues to be a challenging environment.', 'web_url': 'https://www.nytimes.com/2013/08/02/business/global/arcelormittal-reports-big-drop-in-operating-income.html', 'snippet': 'The results for the world’s largest steel company were hurt by continued losses in Europe, which continues to be a challenging environment.', 'lead_paragraph': 'LONDON — ArcelorMittal, the world’s largest steel company, reported on Thursday a net loss of $780 million for the second quarter, compared with net income of about $1 billion in the same period a year earlier. The company also reported $1.7 billion in earnings before interest, taxes, depreciation and amortization, the commonly used metric in the steel industry, a figure that was in line with analysts’ consensus forecasts.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'ArcelorMittal Reports 2nd Quarter Net Loss of $780 Million', 'kicker': None, 'content_kicker': None, 'print_headline': 'ArcelorMittal Reports 2nd Quarter Net Loss of $780 Million', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'ArcelorMittal SA', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Company Reports', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Steel and Iron', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-01T06:45:03+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Stanley Reed', 'person': [{'firstname': 'Stanley', 'middlename': None, 'lastname': 'Reed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/790d4801-a22f-5ec9-88b6-90f57f1fe655', 'word_count': 529, 'uri': 'nyt://article/790d4801-a22f-5ec9-88b6-90f57f1fe655'}, {'abstract': 'The callous lexicon India’s politicians deploy to describe the challenge of poverty.', 'web_url': 'https://india.blogs.nytimes.com/2013/08/01/how-not-to-talk-about-poverty-in-india/', 'snippet': 'The callous lexicon India’s politicians deploy to describe the challenge of poverty.', 'lead_paragraph': 'Growing up, I remember seeing young couples munching peanuts, idly walking past the banks of Dhakuria Lake, across the expanse of the open fields, in the heart of Kolkata, as dusk settled in. “Poor man’s romance” ran the wry joke drawing attention to the city’s severe economic plight and the benighted Calcuttan couple’s dwindling purchasing power. Predictably, the city’s peanut-munching, hand-holding subaltern lovers featured in many Bengali films, with Bengals’ joblessness and ubiquitous impoverishment at the heart of the narratives.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/world/asia/01-poverty-IndiaInk/01-poverty-IndiaInk-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/01/world/asia/01-poverty-IndiaInk/01-poverty-IndiaInk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/world/asia/01-poverty-IndiaInk/01-poverty-IndiaInk-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/world/asia/01-poverty-IndiaInk/01-poverty-IndiaInk-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/world/asia/01-poverty-IndiaInk/01-poverty-IndiaInk-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/01/world/asia/01-poverty-IndiaInk/01-poverty-IndiaInk-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/01/world/asia/01-poverty-IndiaInk/01-poverty-IndiaInk-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Not to Talk About Poverty in India', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Food', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Indian Rupee (Currency