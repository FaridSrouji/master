s', 'value': 'Lewis, Paul (1972- )', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-08T23:13:06+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/58f6312e-356f-5c91-9aea-8d6a9807fbfc', 'word_count': 508, 'uri': 'nyt://article/58f6312e-356f-5c91-9aea-8d6a9807fbfc'}, {'abstract': 'Two fraternal detectives wrestle with murder and morality in Nick Murphy’s crime drama “Blood.”', 'web_url': 'https://www.nytimes.com/2013/08/09/movies/blood-a-crime-drama-by-nick-murphy.html', 'snippet': 'Two fraternal detectives wrestle with murder and morality in Nick Murphy’s crime drama “Blood.”', 'lead_paragraph': 'Trying to cram a six-part BBC television series into a 92-minute movie means inevitable narrative tinkering, but “Blood” feels more damaged than most. Dark, airless and packed with psychological hurt that seems to spring from nowhere, this angry morality play, tucked inside a police procedural, suffers from a crippling lack of back story and characters whose relationships are fraught with unexplained complexity.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/arts/09RDP_BLOOD_SPAN/09RDP_BLOOD_SPAN-articleLarge-v2.jpg', 'height': 345, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/09/arts/09RDP_BLOOD_SPAN/09RDP_BLOOD_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 345}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/arts/09RDP_BLOOD_SPAN/09RDP_BLOOD_SPAN-jumbo