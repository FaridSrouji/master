9/fashion/29BROWSE1_SPAN-copy/29zBROWSE1-articleLarge.jpg', 'height': 317, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/29/fashion/29BROWSE1_SPAN-copy/29zBROWSE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 317}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/29/fashion/29BROWSE1_SPAN-copy/29zBROWSE1-jumbo.jpg', 'height': 541, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/29/fashion/29BROWSE1_SPAN-copy/29zBROWSE1-superJumbo.jpg', 'height': 1081, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/29/fashion/29BROWSE1_SPAN-copy/29zBROWSE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/29/fashion/29BROWSE1_SPAN-copy/29zBROWSE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/29/fashion/29BROWSE1_SPAN-copy/29zBROWSE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Men’s Fall Wardrobe That Women Can Use, Too', 'kicker': 'Browsing', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coats', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-28T22:17:41+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', '