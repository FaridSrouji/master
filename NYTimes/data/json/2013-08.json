document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Steven Davidoff', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Davidoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/170c27fd-4f0e-5cbd-9f57-7dd78f6d1403', 'word_count': 1298, 'uri': 'nyt://article/170c27fd-4f0e-5cbd-9f57-7dd78f6d1403'}, {'abstract': 'A 1944 letter from Oskar Schindler, the German businessman whose effort to save Jews from the Nazis was depicted in “Schindler’s List,” is being auctioned online.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/08/08/schindler-letter-headed-to-auction/', 'snippet': 'A 1944 letter from Oskar Schindler, the German businessman whose effort to save Jews from the Nazis was depicted in “Schindler’s List,” is being auctioned online.', 'lead_paragraph': 'The letter, dated Aug. 22, 1944, gives permission to relocate an enamelware factory from Krakow, Poland, to Czechoslovakia.\xa0What makes this otherwise routine correspondence special is that it is signed in blue pencil by Oskar Schindler, the German businessman whose effort to save 1,200 Jews from the Nazi death machine was depicted in the 1993 Academy Award-winning film “Schindler’s List.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/arts/08artsbeat-schindler/08artsbeat-schindler-articleLarge.jpg', 'height': 834, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/08/arts/08artsbeat-schindler/08artsbeat-schindler-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 834}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/arts/08artsbeat-schindler/08artsbeat-schindler-jumbo.jpg', 'height': 1024, 'width': 737, 'sub