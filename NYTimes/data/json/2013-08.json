 are getting a refund.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/24/business/Wealth1/Wealth1-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/24/business/Wealth1/Wealth1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/24/business/Wealth1/Wealth1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/24/business/Wealth1/Wealth1-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A Guessing Game for Taxpayers on What They Owe', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Guessing Game for Taxpayers on What They Owe', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sullivan, Paul', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rebates and Refunds', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ACCOUNTING AND ACCOUNTANTS', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ALTERNATIVE MINIMUM TAX', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Internal Revenue Service', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Personal Finances', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'High Net Worth Individuals', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Income Tax', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-08-23T15:56:03+0000', 'document_type': 'article', 'news_desk': 'Business', '