nservatism', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lauren, Ralph', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cartier SA', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chanel SA', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-23T19:18:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c0716a83-e755-5eeb-9c44-c23f3fd8bb9d', 'word_count': 31, 'uri': 'nyt://article/c0716a83-e755-5eeb-9c44-c23f3fd8bb9d'}, {'abstract': 'A co-op apartment at 640 Park Avenue originally had 18 rooms but was reconfigured 40 years ago as a five-bedroom, six-bath home.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/08/23/big-ticket-23-million-for-a-floor-on-park-avenue/', 'snippet': 'A co-op apartment at 640 Park Avenue originally had 18 rooms but was reconfigured 40 years ago as a five-bedroom, six-bath home.', 'lead_paragraph': 'A magisterial floor-through residence at 640 Park Avenue, an opulent limestone building designed by J. E. R. Carpenter as a luxury rental oasis for the millionaires of 1914, sold for $23 million and was the week’s most expensive residential transaction, according to city records. The building, at the northwest corner of Park Avenue and 66th Street, went co-op in 1946; the monthly maintenance fee for the simplex, No. 8, is $15,981.', 'print_section': 'RE', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/25/realestate/25TICKET/25-Ticket-articleLarge.jpg', 'height': 867, 'width': 600, 'sub