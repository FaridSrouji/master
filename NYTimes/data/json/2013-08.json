'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cef7c9b2-c9a3-5a9f-b125-799af625b086', 'word_count': 194, 'uri': 'nyt://article/cef7c9b2-c9a3-5a9f-b125-799af625b086'}, {'abstract': 'The World Anti-Doping Agency prevented researchers from publishing a study that indicated many track and field athletes were doping.', 'web_url': 'https://www.nytimes.com/2013/08/23/sports/research-finds-wide-doping-study-withheld.html', 'snippet': 'The World Anti-Doping Agency prevented researchers from publishing a study that indicated many track and field athletes were doping.', 'lead_paragraph': 'Doping experts have long known that drug tests catch only a tiny fraction of the athletes who use banned substances because athletes are constantly finding new drugs and techniques to evade detection. So in 2011, the World Anti-Doping Agency convened a team of researchers to try to determine more accurately how many athletes use performance-enhancing drugs.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Antidoping Agency Delays Publication of Research', 'kicker': None, 'content_kicker': None, 'print_headline': 'Study Revealing Doping in Track Strikes Hurdle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'World Anti-Doping Agency', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Track and Field', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'International Assn of Athletics Federations', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Tests (Drug Use)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-08-23T02:16:59+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Tim Rohan', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Rohan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80636033-e48c-5331-a64e-ab4d382a706a', 'word_count': 999, 'uri': 'nyt://article/80636033-e48c-5331-a64e-ab4d382a706a'}, {'abstract': 'A congressman who visited Guantánamo recently said the most requested book among the detainees was the erotic novel “Fifty Shades of Grey,” but an Associated Press report casts doubt on the claim.', 'web_url': 'https://thelede.blogs.nytimes.com/2013/08/22/guantanamo-officials-accused-of-inventing-fifty-shades-of-grey-rumor/', 'snippet': 'A congressman who visited Guantánamo recently said the most requested book among the detainees was the erotic novel “Fifty Shades of Grey,” but an Associated Press report casts doubt on the claim.', 'lead_paragraph': 'Updated, Friday, 10:34 a.m. | After a Congressional delegation was given a tour of the Guantánamo Bay prison recently, one member of the group recounted an anecdote he heard from officials there. “Rather than the Koran, the book that is requested most” by the detainees is “Fifty Shades of Grey,” Representative Jim Moran, Democrat of Virginia, told The Huffington Post in July. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Guantánamo Officials Accused of Inventing ‘Fifty Shades of Grey’ Rumor', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Detainees', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Moran, Jim', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Guantanamo Bay Naval Base (Cuba)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-23T02:22:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Ravi Somaiya and Robert Mackey', 'person': [{'firstname': 'Ravi', 'middlename': None, 'lastname': 'Somaiya', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9f7458e-9560-55a7-b397-7c3b49a87f7c', 'word_count': 696, 'uri': 'nyt://article/f9f7458e-9560-55a7-b397-7c3b49a87f7c'}, {'abstract': 'A pilot who tested 130 different types of aircraft for the Air Force and NASA, and flew two shuttle missions, as the commander on the Challenger and one of two pilots on the Columbia.', 'web_url': 'https://www.nytimes.com/2013/08/23/us/c-gordon-fullerton-early-space-shuttle-pilot-dies-at-76.html', 'snippet': 'A pilot who tested 130 different types of aircraft for the Air Force and NASA, and flew two shuttle missions, as the commander on the Challenger and one of two pilots on the Columbia.', 'lead_paragraph': 'Col. C. Gordon Fullerton, an astronaut who performed the first flight test of a space shuttle in 1977, then piloted two shuttle missions — including one in which an engine failed shortly after takeoff — died on Wednesday in Lancaster, Calif. He was 76.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/business/FULLERTON-obit/FULLERTON-obit-articleLarge.jpg', 'height': 928, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/23/business/FULLERTON-obit/FULLERTON-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 928}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/business/FULLERTON-obit/FULLERTON-obit-jumbo.jpg', 'height': 1024, 'width': 663, 'subType': 'jumbo', 'crop_name': 'ju