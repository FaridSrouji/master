': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bombing in Pakistan', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-08-08T18:20:58+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'Reuters', 'person': [], 'organization': 'Reuters'}, 'type_of_material': 'Video', '_id': 'nyt://video/7b7d04f3-702a-53d1-a931-d7a804fcee08', 'word_count': 0, 'uri': 'nyt://video/7b7d04f3-702a-53d1-a931-d7a804fcee08'}, {'abstract': 'The 10 most popular blog posts in the history of The 6th Floor.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2013/08/08/this-blog-has-in-fact-published-stuff-other-than-the-george-saunders-graduation-speech/', 'snippet': 'The 10 most popular blog posts in the history of The 6th Floor.', 'lead_paragraph': 'The first rule of going viral is that you should never plan to go viral. And with that rule in no way in mind — that’s the point! you can’t think about it! — Joel Lovell let a casual e-mail correspondence with George Saunders morph into a blog post that reached a level of Internet popularly normally reserved for Lindsay Lohan and counterintuitive arguments about yoga. His reproduction of Saunders’s graduation speech at Syracuse University was by orders of magnitude the most popular thing ever to run on The 6th Floor blog — which has, since its inception, been a strong believer in the first rule of going viral. As the magazine’s editor, Hugo Lindgren, wrote in his inaugural post in March 2011, “This blog is meant as a humble complement to the magazine — a place to let readers listen in on the conversations that happen in the office.” We never planned to be the fastest, nor the buzziest, nor to have the most cat GIFs (a staple of the second rule of going viral). We just planned to do the sort of stuff that magazine editors do — “allow our curiosity to wander and see where it leads,” as Lindgren put it — but do it a little more publicly.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/magazine/08-cat-computer/08-cat-computer-articleLarge.jpg', 'height': 481, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/08/magazine/08-cat-computer/08-cat-computer-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 481}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/magazine/08-cat-computer/08-cat-computer-jumbo.jpg', 'height': 821, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/magazine/08-cat-computer/08-cat-computer-superJumbo.jpg', 'height': 1641, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/magazine/08-cat-computer/08-cat-computer-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/08/magazine/08-cat-computer/08-cat-computer-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/08/magazine/08-cat-computer/08-cat-computer-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'This Blog Has in Fact Published Stuff Other Than the George Saunders Graduation Speech', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blogs and Blogging (Internet)', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-08-08T18:27:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Samantha Henig', 'person': [{'firstname': 'Samantha', 'middlename': None, 'lastname': 'Henig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7085390e-cd91-5733-b562-5d6085003dcb', 'word_count': 459, 'uri': 'nyt://article/7085390e-cd91-5733-b562-5d6085003dcb'}, {'abstract': 'Shares of Penney surged after CNBC reported that William A. Ackman had written a letter to his fellow board members urging them to speed up a search for a permanent chief executive.', 'web_url': 'https://dealbook.nytimes.com/2013/08/08/j-c-penney-shares-jump-on-report-of-an-ackman-push-for-a-permanent-chief/', 'snippet': 'Shares of Penney surged after CNBC reported that William A. Ackman had written a letter to his fellow board members urging them to speed up a search for a permanent chief executive.', 'lead_paragraph': 'Updated, 5:38 p.m. | William A. Ackman isn’t happy with the status quo of J.C. Penney once more — and that has made other shareholders in the struggling department store chain fairly pleased.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'J.C. Penney Shares Jump on Report of Push for Permanent Chief', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Call for Action', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ackman, William A', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Ronald B (1959- )'