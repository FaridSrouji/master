umbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/07/travel/07-frugal-chicken/07-frugal-chicken-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Kansas, Museums, Fried Chicken and, Yes, ‘Oz’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Budget Travel', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Kansas', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-07T18:58:05+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Seth Kugel', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Kugel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b3196a53-c3ad-5ade-944e-28a42419b5ee', 'word_count': 1733, 'uri': 'nyt://article/b3196a53-c3ad-5ade-944e-28a42419b5ee'}, {'abstract': 'The trio chat about the joys of working small and going off-script.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/08/07/in-conversation-david-gordon-green-paul-rudd-and-emile-hirsch-on-making-prince-avalanche/', 'snippet': 'The trio chat about the joys of working small and going off-script.', 'lead_paragraph': 'For his latest film, “Prince Avalanche,” David Gordon Green sought a decidedly stripped-down approach to filmmaking. Inspired by his experience directing the now-infamous Super Bowl XLVI Chrysler commercial featuring Clint Eastwood — a process Green describes as “10 guys in a van” — the director, known for his early indie dramas like “George Washington” and lighter fare like the 2008 stoners-with-guns action-comedy “Pineapple Express,” resolved to make a movie that was similarly devoid of clutter.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'David Gordon Green, Paul Rudd and Emile Hirsch on Making “Prince Avalanche”', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Green, David Gordon', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hirsch, Emile', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rudd, Paul', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-07T19:09:21+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Jeff Oloizia', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Oloizia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f2e72f9e-61bf-5e44-a326-f9d82a183614', 'word_count': 1527, 'uri': 'nyt://article/f2e72f9e-61bf-5e44-a326-f9d82a183614'}, {'abstract': 'The director David Gordon Green narrates a scene from his film.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/08/07/anatomy-of-a-scene-video-prince-avalanche/', 'snippet': 'The director David Gordon Green narrates a scene from his film.', 'lead_paragraph': 'In this video, the writer and director David Gordon Green narrates a scene from his film “Prince Avalanche,” about two men who repaint traffic lines on a Texas road that has been damaged by a forest fire. This scene involves an encounter between one of those men, Alvin (Paul Rudd) and a woman (Joyce Payne) searching through rubble for her pilot’s license.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Anatomy of a Scene Video: ‘Prince Avalanche’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': Non