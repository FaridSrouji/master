me': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Image of the Day: August 28', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Birthdays', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Assam State (India)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Guwahati (India)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-28T17:20:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/cfe6d178-04ce-5aad-8993-20ca6cd87d4a', 'word_count': 1, 'uri': 'nyt://article/cfe6d178-04ce-5aad-8993-20ca6cd87d4a'}, {'abstract': 'The military knows how to turn on hypervigilance. A transition center at Ramstein Air Base in Germany teaches service members how to turn it off.', 'web_url': 'https://atwar.blogs.nytimes.com/2013/08/28/building-a-bridge-from-combat-to-civilian-life/', 'snippet': 'The military knows how to turn on hypervigilance. A transition center at Ramstein Air Base in Germany teaches service members how to turn it off.', 'lead_paragraph': 'Small things kill in combat. This truism is as old as war itself, but it proved especially correct in Iraq and Afghanistan, where a new pile of dirt or the glint off a wire in the desert sun could be the sole indication that a bomb lay beneath your feet. So at its heart, military training — from the first day of boot camp to the final predeployment war game — has always really been about paying attention to details. The military knows how to turn on hypervigilance. The question is how to turn it off.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Building a Bridge From Combat to Civilian Life', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name':