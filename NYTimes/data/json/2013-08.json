8, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/SUB-CITY-ENCORE/SUB-CITY-ENCORE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/30/sports/SUB-CITY-ENCORE/SUB-CITY-ENCORE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/SUB-CITY-ENCORE/SUB-CITY-ENCORE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Teenage Qualifier Shows Her Potential, and Age, in a Second-Round Defeat', 'kicker': None, 'content_kicker': None, 'print_headline': 'Teenage Qualifier Shows Her Potential, and Age, in a Second-Round Defeat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Nate', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hantuchova, Daniela', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Evans, Daniel (1990- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Duval, Victoria (1995- )', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-30T03:48:42+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Nate Taylor', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fbbc19fc-dc22-5700-8c19-3be75b89d230', 'word_count': 795, 'uri': 'nyt://article/fbbc19fc-dc22-5700-8c19-3be75b89d230'}, {'abstract': 'The Los Angeles-based chef traveled to Denmark with his brother and fellow chef Bryan Voltaggio for a symposium curated this year by David Chang.', 'web_url': 'https://www.nytimes.com/2013/08/30/t-magazine/travel-diary-michael-voltaggio-copenhagen.html', 'snippet': 'The Los Angeles-based chef traveled to Denmark with his brother and fellow chef Bryan Voltaggio for a symposium curated this year by David Chang.', 'lead_paragraph': 'Earlier this week, the brothers Michael and Bryan Voltaggio, American chefs and former “Top Chef” contestants, traveled to Copenhagen for the third MAD Symposium, an annual food festival that brings together chefs and farmers. Curated by David Chang and his Lucky Peach team, this year’s two-day sold-out symposium was dedicated to guts — meaning both innards and courage. Chang introduced the theme literally, however, by bringing out the butcher Dario Cecchini, who proceeded to carve a pig on the stage. Between events, Michael, the chef and owner of Ink in Los Angeles, and Bryan, the executive chef of Volt restaurant in Maryland, caught up with fellow chefs and friends. Here, Michael shares his photos from the event.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Michael Voltaggio’s Gutsy Food Adventure in Copenhagen', 'kicker': 'Food Matters', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-30T04:00:00+0000', 'document_type': 'article', 'news_desk': 'TDesign', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1634c49a-75ca-56a8-a24e-3002d3de7dd6', 'word_count': 117, 'uri': 'nyt://article/1634c49a-75ca-56a8-a24e-3002d3de7dd6'}, {'abstract': 'Without wealthier households sharing more costs of health care, many Americans will continue to find health care unaffordable, an economist writes.', 'web_url': 'https://economix.blogs.nytimes.com/2013/08/30/the-central-challenge-in-u-s-health-policy/', 'snippet': 'Without wealthier households sharing more costs of health care, many Americans will continue to find health care unaffordable, an economist writes.', 'lead_paragraph': 'Uwe E. Reinhardt is an economics professor at Princeton. He has some financial interests in the health care field.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Central Challenge in U.S. Health Policy', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Kaiser Family Foundation', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-30T04:01:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Uwe E. Reinhardt', 'person': [{'firstname': 'Uwe', 'middlename': 'E.', 'lastname': 'Reinhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/38e57616-f0c5-58af-bae6-e3d7d39cf395', 'word_count': 1106, 'uri': 'nyt://article/38e57616-f0c5-58af-bae6-e3d7d39cf395'}, {'abstract': 'This word has appeared in 390 New York Times articles in the past year.', 'web_url': 'https://learning.blogs.nytimes.com/2013/08/30/word-of-the-day-mishap/', 'snippet': 'This word has appeared in 390 New York Times articles in the past year.', 'lead_paragraph': 'mishap •\\ˈmis-ˌhap, mis-ˈ\\• noun', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Word of the Day |