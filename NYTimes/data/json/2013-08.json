ge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/21/world/middleeast/EGYPT/EGYPT-articleLarge.jpg', 'height': 667, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/21/world/middleeast/EGYPT/EGYPT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 667}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/21/world/middleeast/EGYPT/EGYPT-jumbo.jpg', 'height': 862, 'width': 775, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/21/world/middleeast/EGYPT/EGYPT-superJumbo.jpg', 'height': 862, 'width': 775, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/21/world/middleeast/EGYPT/EGYPT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/21/world/middleeast/EGYPT/EGYPT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/21/world/middleeast/EGYPT/EGYPT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Egypt Arrest, and a Brotherhood on the Run', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Egypt Arrest, and a Brotherhood on the Run', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Egypt', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kirkpatrick, David D', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Muslim Brotherhood (Egypt)', 'rank'