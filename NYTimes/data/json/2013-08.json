': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/85e7125d-6057-5d09-8a92-c22bc82414da', 'word_count': 0, 'uri': 'nyt://audio/85e7125d-6057-5d09-8a92-c22bc82414da'}, {'abstract': 'By Andrew Bird', 'web_url': 'https://www.nytimes.com/audio/2013/08/31/opinion/bird-begging-questions-instrumental.html', 'snippet': 'By Andrew Bird', 'lead_paragraph': 'By Andrew Bird', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '“Begging Questions,” Instrumental', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-29T22:48:10+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/e0110770-73c4-5cc9-adad-1acba8fd0285', 'word_count': 0, 'uri': 'nyt://audio/e0110770-73c4-5cc9-adad-1acba8fd0285'}, {'abstract': 'By Andrew Bird', 'web_url': 'https://www.nytimes.com/audio/2013/08/31/opinion/bird-begging-questions.html', 'snippet': 'By Andrew Bird', 'lead_paragraph': 'By Andrew Bird', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '“Begging Questions”', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-08-29T22:49:08+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/e52f9a1b-660c-53dc-bc2f-34d3509e9400', 'word_count': 0, 'uri': 'nyt://audio/e52f9a1b-660c-53dc-bc2f-34d3509e9400'}, {'abstract': 'Lee Isaac Chung’s “Abigail Harm,” starring Amanda Plummer, tracks the lonely lulls and strange eruptions of a lonely, isolated woman.', 'web_url': 'https://www.nytimes.com/2013/08/30/movies/abigail-harm-stars-amanda-plummer-as-a-lonely-woman.html', 'snippet': 'Lee Isaac Chung’s “Abigail Harm,” starring Amanda Plummer, tracks the lonely lulls and strange eruptions of a lonely, isolated woman.', 'lead_paragraph': 'The independent movie “Abigail Harm” opens with the curiously named title character (Amanda Plummer) reading aloud to a blind man from “Through the Looking-Glass, and What Alice Found There.” The two are seated apart in a poorly lighted room, and she’s reading from Chapter 3, the part after Alice has read “Jabberwocky” and discovered a garden with talking flowers. Now, in some woods “where things have no names,” Alice meets a fawn. Together, they walk a bit, her arms around the fawn. But when they leave the forest, the animal recognizes what they are — “\xa0‘I’m a Fawn!’ it cried out in a voice of delight, ‘and, dear me! you’re a human child!’\xa0” — and darts away. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30ABIGAIL_SPAN/0830ABIGAIL-articleLarge.jpg', 'height': 353, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/30/arts/30ABIGAIL_SPAN/0830ABIGAIL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 353}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30ABIGAIL_SPAN/0830ABIGAIL-jumbo.jpg', 'height': 603, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30ABIGAIL_SPAN/0830ABIGAIL-superJumbo.jpg', 'height': 1206, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/arts/30ABIGAIL_SPAN/0830ABIGAIL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop