: [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3866f079-b805-521e-bb05-28e2ef33c73b', 'word_count': 477, 'uri': 'nyt://article/3866f079-b805-521e-bb05-28e2ef33c73b'}, {'abstract': 'Ms. Clare discusses the movie adaptation of the first volume of her best-selling series of fantasy novels.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/08/27/q-a-cassandra-clare-talks-about-the-mortal-instruments/', 'snippet': 'Ms. Clare discusses the movie adaptation of the first volume of her best-selling series of fantasy novels.', 'lead_paragraph': '“City of Bones,” the film adaptation of the first book in Cassandra Clare’s young adult fantasy series “The Mortal Instruments,” opened last week. In a recent phone interview, Ms. Clare spoke about the film, her forthcoming middle-grade series, writing with Holly Black (author of “Doll Bones” and “The Spiderwick Chronicles”) and what readers can expect from “City of Heavenly Fire,” the final novel in the “Mortal Instruments” series, due\xa0 next May. Below are edited excerpts from the conversation:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Q. & A.: Cassandra Clare on ‘The Mortal Instruments’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-27T18:50:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Blanca Melendez', 'person': [{'firstname': 'Blanca', 'middlename': None, 'lastname': 'Melendez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_i