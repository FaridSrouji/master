/2013/08/13/science/13CONS/13CONS-jumbo.jpg', 'height': 1024, 'width': 937, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/13/science/13CONS/13CONS-superJumbo.jpg', 'height': 1968, 'width': 1799, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/13/science/13CONS/13CONS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/13/science/13CONS/13CONS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/13/science/13CONS/13CONS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Glut of Antidepressants', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'A Glut of Antidepressants', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANTIDEPRESSANTS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Depression (Mental)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-12T18:53:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Roni Caryn Rabin', 'person': [{'firstname': 'Roni', 'middlename': 'Caryn', 'lastname': 'Rabin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2c12e7d0-3cde-5440-b85c-f10426a7ff2b', 'word_count': 997, 'uri': 'nyt://article/2c12e7d0-3cde-5440-b85c-f10426a7ff2b'}, {'abstract': 'Inspired by a signature Korean noodle dish, there are a variety of ways to make this recipe, depending on your preferences.', 'web_url': 'https://www.nytimes.com/2013/08/15/health/korean-chilled-buckwheat-noodles-with-chilled-broth-and-kimchi.html', 'snippet': 'Inspired by a signature Korean noodle dish, there are a variety of ways to make this recipe, depending on your preferences.', 'lead_paragraph': 'This recipe is inspired by the signature Korean summer noodle dish, naeng myung. The traditional dish is made with a strong beef broth. I’m using a vegetarian broth I make with dried mushrooms and kelp, adapted from a recipe in Deborah Madison’s “Vegetarian Cooking for Everybody.” You could also use chicken stock. The dish can include chicken or meat, or it can be vegetarian, as this version is, with tofu standing in for chicken. It can also be vegan if you omit the boiled eggs. Make the broth a day ahead so that it will be nice and cold.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/science/15recipehealthuse/15recipehealthuse-articleLarge.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/09/science/15recipehealthuse/15recipehealthuse-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/science/15recipehealthuse/15recipehealthuse-jumbo.jpg', 'height': 707, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/science/15recipehealthuse/15recipehealthuse-superJumbo.jpg', 'height': 1414, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/science/15recipehealthuse/15recipehealthuse-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/09/science/15recipehealthuse/15recipehealthuse-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/science/15recipehealthuse/15recipehealthuse-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Korean Buckwheat Noodles With Chilled Broth and Kimchi', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Noodles', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-12T19:00:05+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/f3ff42f1-694b-5c7a-b68e-ad0a418f3b05', 'word_count': 551, 'uri': 'nyt://article/f3ff42f1-694b-5c7a-b68e-ad0a418f3b05'}, {'abstract': 'Hotels, like the airlines, have begun to charge fees for services that used to be free, like having the bellhop carry bags to your room.', 'web_url': 'https://www.nytimes.com/2013/08/13/business/barrage-of-fees-starts-to-follow-fliers-to-the-hotel.html', 'snippet': 'Hotels, like the airlines, have begun to charge fees for services that used to be free, like having the bellhop carry bags to your room.', 'lead_paragraph':