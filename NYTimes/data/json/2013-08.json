in November.', 'print_section': 'TR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/travel/18BITES_SPAM/18BITES-articleLarge.jpg', 'height': 382, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/18/travel/18BITES_SPAM/18BITES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 382}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/travel/18BITES_SPAM/18BITES-jumbo.jpg', 'height': 652, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/travel/18BITES_SPAM/18BITES-superJumbo.jpg', 'height': 1304, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/travel/18BITES_SPAM/18BITES_SPAM-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/18/travel/18BITES_SPAM/18BITES_SPAM-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/travel/18BITES_SPAM/18BITES_SPAM-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Restaurant Report: &Samhoud Places in Amsterdam', 'kicker': None, 'content_kicker': None, 'print_headline': 'Chemistry in the Kitchen', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lobrano, Alexander', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'va