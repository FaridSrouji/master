ht': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Political Journalism Chronicle', 'kicker': None, 'content_kicker': None, 'print_headline': 'Political Journalism Chronicle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Alter, Jonathan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Balz, Dan', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Goodale, James C', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-08-16T16:17:39+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jeffrey Frank', 'person': [{'firstname': 'Jeffrey', 'middlename': None, 'lastname': 'Frank', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e0fb0d58-eac3-5dff-bee4-6fba7bb41f64', 'word_count': 1183, 'uri': 'nyt://article/e0fb0d58-eac3-5dff-bee4-6fba7bb41f64'}, {'abstract': 'In examining the ways stories keep us company during crises, Rebecca Solnit creates links between seemingly disparate ideas.', 'web_url': 'https://www.nytimes.com/2013/08/18/books/review/the-faraway-nearby-by-rebecca-solnit.html', 'snippet': 'In examining the ways stories keep us company during crises, Rebecca Solnit creates links between seemingly disparate ideas.', 'lead_paragraph': 'Rebecca Solnit’s latest book, a series of essays loosely about story\xadtelling, has a table of contents that sits on the page like a mountain tipped on its side. The essays’ titles mirror or refract one another, imparting symmetry. The summit, a chapter titled “Knot,” evokes another of the book’s metaphors, the bringing together of narrative threads. The tipped mountain shape resembles the traditional rise and fall of story structure. But this isn’t the only visual conceit. “Imagine all the sentences in this book as a single thread around the spool that is a book,” Solnit writes. You needn’t imagine it, though: One unspooled essay runs like a news ticker along the base of every page.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/0818-bks-ROMM1/0818-bks-ROMM1-articleLarge.jpg', 'height': 845, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/18/books/review/0818-bks-ROMM1/0818-bks-ROMM1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 845}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/0818-bks-ROMM1/0818-bks-ROMM1-jumbo.jpg', 'height': 1024, 'width': 727, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/0818-bks-ROMM1/0818-bks-ROMM1-superJumbo.jpg', 'height': 2048, 'width': 1454, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/0818-bks-ROMM1/0818-bks-ROMM1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/18/books/review/0818-bks-ROMM1/0818-bks-ROMM1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/0818-bks-ROMM1/0818-bks-ROMM1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fruit of Knowledge', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fruit of Knowledge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Solnit, Rebecca', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-16T16:17:48+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Robin Romm', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Romm', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8de5e94b-c0a1-5d4c-a845-f30d921c5a57', 'word_count': 1173, 'uri': 'nyt://article/8de5e94b-c0a1-5d4c-a845-f30d921c5a57'}, {'abstract': 'Serving as nurses, two Australian sisters confront the horrors of Gallipoli and the Western Front.', 'web_url': 'https://www.nytimes.com/2013/08/18/books/review/thomas-keneallys-daughters-of-mars.html', 'snippet': 'Serving as nurses, two Australian sisters confront the horrors of Gallipoli and the Western Front.', 'lead_paragraph': 'Long before I could locate the peninsula of Gallipoli on a map, as a Briton I knew it as a place where we did something awful to the Australians. Down Under they have a clearer memory. Having fought bravely and loyally for king and empire in two world wars, they have never shaken the belief that they were used as cannon fodder when Britain (and France) launched a disastrous attack on this strategic outpost of the Ottoman Empire in 1915.', 'print_section': 'BR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/18/books/review/0818-bks-RIDING/0818-bks-RIDING-articleLarge.jpg', 'height': 695, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/18/books/review/