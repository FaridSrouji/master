ges/2013/08/09/business/08bits-herzog/08bits-herzog-superJumbo.jpg', 'height': 1758, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/business/08bits-herzog/08bits-herzog-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/09/business/08bits-herzog/08bits-herzog-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/business/08bits-herzog/08bits-herzog-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hollywood Director Takes On Texting While Driving', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': 'Film Takes On\r\nIssue of Texting\r\nWhile Driving', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Text Messaging', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Traffic Accidents and Safety', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-08-09T17:27:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Matt Richtel', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Richtel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee8436e7-66bf-570d-98af-9658cebe59c5', 'word_count': 350, 'uri': 'nyt://article/ee8436e7-66bf-570d-98af-9658cebe59c5'}, {'abstract': 'The New York Times, one of the last of the family-owned newspapers, is optimistic about staying competitive in an increasingly digital world. Should it be?', 'web_url': 'https://www.nytimes.com/2013/08/10/business/after-post-sale-spotlight-shines-more-intensely-on-the-times.html', 'snippet': 'The New York Times, one of the last of the family-owned newspapers, is optimistic about staying competitive in an increasingly digital world. Should it be?', 'lead_paragraph': 'It’s surely not just coincidence that great journalism was pioneered, nurtured and celebrated at America’s great family-owned newspapers: The Wall Street Journal under the Bancrofts, The Los Angeles Times under the Chandlers, The Washington Post under the Grahams and The New York Times under the Sulzbergers.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/business/Stewart/Stewart-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/10/business/Stewart/Stewart-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/business/Stewart/Stewart-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/business/Stewart/Stewart-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/business/Stewart/Stewart-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/10/business/Stewart/Stewart-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/business/Stewart/Stewart-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Post Sale, Spotlight Shines More Intensely on The Times', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Times In a Spotlight After the Sale Of The Post', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Times', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington Post Company', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Newspapers', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Sulzberger, Arthur Jr', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Graham, Donald E', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Bezos, Jeffrey P', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-08-09T17:30:26+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By James B. Stewart', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f507c930-d70f-5574-b071-e5ad45c9b2af', 'word_count': 1847, 'uri': 'nyt://article/f507c930-d70f-5574-b071-e5ad45c9b2af'}, {'abstract': 'Duesenberg is often considered America’s most historically significant automotive brand and, now, after a three-year restoration, the first of the company’s cars sold to the public is to compete at the Pebble Beach concours.', 'web_url': 'https://www.nytimes.com/2013/08/11/automobiles/its-a-duesie-the-first-in-fact.html', 'snippet': 'Duesenberg is often considered America’s most historically significant automotive brand and, now, after a three-year restoration, the first of the company’s cars sold to the public is to compete at the Pebble Beach concours.', 'lead_paragraph': 'Scotts Valley, Calif. — Nobody would have called the car a beauty. Impossibly high-waisted, cloaked entirely in black, with boxy hips and awkward lines, it stood primly erect on the shop floor, a lonely figure amid seductive shapes.', 'print_section': 'AU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/automobiles/video-duesenberg/video-duesenberg-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/09/automobiles/video-duesenberg/video-duesenberg-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/automobiles/video-duesenberg/video-duesenberg-jumbo.jpg', 'height': 507, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/automobiles/video-duesenberg/video-duesenberg-superJumbo.jpg', 'height': 507, 'width': 768, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/automobiles/video-duesenberg/video-duesenberg-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/09/automobiles/video-duesenberg/video-duesenberg-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/09/automobiles/video-duesenberg/video-duesenberg-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'It’s a Duesie. The First, in Fact.', 'kicker': None, 'content_kicker': None, 'print_headline': 'It’s a Duesie. The First, in Fact.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Pebble Beach Concours D'Elegance (Car Show)", 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Antique and Classic Cars', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-09T17:47:06+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'byline': {'original': 'By Robert C. Yeager', 'person': [{'firstname': 'Robert', 'middlename': 'C.', 'lastname': 'Yeager', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a0fdf5b6-020c-5a7b-9215-f54138c719db', 'word_count': 1241, 'uri': 'nyt://article/a0fdf5b6-020c-5a7b-9215-f54138c719db'}, {'abstract': 'Duesenbergs have won more Best of Show awards at Pebble Beach than any American marque. Indeed, they are regarded as so superior to their domestic peers that Duesenbergs compete in their own class.', 'web_url': 'https://www.nytimes.com/2013/08/11/automobiles/collectibles/the-american-standard-setter.html', 'snippet': 'Duesenbergs have won more Best of Show awards at Pebble Beach than any American marque. Indeed, they are regarded as so superior to their domestic peers that Duesenbergs compete in their own class.', 'lead_paragraph': '“With its DNA in motorsports, its advanced engineering and coachbuilders like Rollston, LeBaron and Murphy, Duesenberg was the most impressive and important American car of its era,” said Sandra Button, chairman of America’s premier automotive judged competition, the Pebble Beach Concours d’Élégance.', 'print_section