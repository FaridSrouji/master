rtinez', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stickland, Jonathan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-08-09T03:13:58+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Ross Ramsey', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Ramsey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63b1d866-70db-5311-83cd-8ca445c07aab', 'word_count': 746, 'uri': 'nyt://article/63b1d866-70db-5311-83cd-8ca445c07aab'}, {'abstract': 'Lavabit shut down, hinting at a secret government order, and Silent Circle, a similar end-to-end encrypted e-mail provider, followed suit.', 'web_url': 'https://bits.blogs.nytimes.com/2013/08/08/two-providers-of-encrypted-e-mail-shut-down/', 'snippet': 'Lavabit shut down, hinting at a secret government order, and Silent Circle, a similar end-to-end encrypted e-mail provider, followed suit.', 'lead_paragraph': 'The shutdown of two small e-mail providers on Thursday illustrates why it is so hard for Internet companies to challenge secret government surveillance: to protect their customers’ data from federal authorities, the two companies essentially committed suicide.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/business/EMAIL/EMAIL-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/10/business/EMAIL/EMAIL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/10/business/EMAIL/EMAIL-jumbo.jpg', 'height': 587, 'width': 8