istration.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/07/nyregion/CUOMO1/CUOMO1-articleLarge.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/07/nyregion/CUOMO1/CUOMO1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/07/nyregion/CUOMO1/CUOMO1-jumbo.jpg', 'height': 706, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/07/nyregion/CUOMO1/CUOMO1-superJumbo.jpg', 'height': 1413, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/07/nyregion/CUOMO1/CUOMO1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/07/nyregion/CUOMO1/CUOMO1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/07/nyregion/CUOMO1/CUOMO1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Many Mayoral Candidates Have Been What Bloomberg Is Not: Close to Cuomo', 'kicker': None, 'content_kicker': None, 'print_headline': 'Many Mayoral Candidates Have Been What Bloomberg Is Not: Close to Cuomo', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kaplan, Thomas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Catsimatidis, John A', 'rank': 2, 'major': 'N'}, {'name':