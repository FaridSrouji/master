redit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23SCENIC_SPAN/0823SCENIC-superJumbo.jpg', 'height': 1078, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23SCENIC_SPAN/0823SCENIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/23/arts/23SCENIC_SPAN/0823SCENIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23SCENIC_SPAN/0823SCENIC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Desert Foils Friendly Scheming', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'The Desert Foils Friendly Scheming', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fogler, Dan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Duhamel, Josh', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Goetz, Michael', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Goetz, Kevin', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-08-22T21:22:52+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ac334dae-e592-5d5e-a372-b587a5655458', 'word_count': 444, 'uri': 'nyt://article/ac334dae-e592-5d5e-a372-b587a5655458'}, {'abstract': 'Wong Kar-wai’s “Grandmaster” is a film about Ip Man, a 20th-century Chinese martial arts legend, but also an exploration of opposing forces like loyalty and love.', 'web_url': 'https://www.nytimes.com/2013/08/23/movies/the-grandmaster-wong-kar-wais-new-film.html', 'snippet': 'Wong Kar-wai’s “Grandmaster” is a film about Ip Man, a 20th-century Chinese martial arts legend, but also an exploration of opposing forces like loyalty and love.', 'lead_paragraph': '“The Grandmaster,” a hypnotically beautiful dream from the Hong Kong filmmaker Wong Kar-wai, opens with curls of smoke, eddies of water and men soaring and flying across the frame as effortlessly as silk ribbons. The men are warriors, street fighters with furious fists and winged feet, who have massed together on a dark, rainy night to take on Ip Man (Tony Leung), a still figure in a long coat and an elegant white hat. Even amid the violent whirlpools of rain and bodies, that hat never leaves his head. It’s as unyielding as its owner. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23GRAND_SPAN/23GRAND-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/23/arts/23GRAND_SPAN/23GRAND-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23GRAND_SPAN/23GRAND-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23GRAND_SPAN/23GRAND-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23GRAND_SPAN/23GRAND-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/23/arts/23GRAND_SPAN/23GRAND-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23GRAND_SPAN/23GRAND-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Style and Kinetics Triumph in a Turbulent China', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Style and Kinetics Triumph in a Turbulent China', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wong Kar-Wai', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Grandmaster (Movie)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-22T21:25:05+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4138e1ef-6373-5115-8f1c-23ba222aa033', 'word_count': 1142, 'uri': 'nyt://article/4138e1ef-6373-5115-8f1c-23ba222aa033'}, {'abstract': 'Older patients can benefit from surgery, but doctors tend not to do full assessments of their ability to recover.', 'web_url': 'https://newoldage.blogs.nytimes.com/2013/08/22/a-surgical-center-for-older-patients/', 'snippet': 'Older patients can benefit from surgery, but doctors tend not to do full assessments of their ability to recover.', 'lead_paragraph': 'How well will a particular patient withstand the stresses of surgery? To make that determination, surgeons typically order cardiovascular tests. Is his heart pumping efficiently? Are her lungs providing enough oxygen? But Dr. Mark Katlic never found that sufficient for older patients. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/22/health/surgery/surgery-articleLarge.jpg', 'height': 429, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/22/health/surgery/surgery-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 429}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/22/health/surgery/surgery-jumbo.jpg', 'height': 458, 'width': 641, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/22/health/surgery/surgery-superJumbo.jpg', 'height': 458, 'width': 641, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/22/health/surgery/surgery-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/22/health/surgery/surgery-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/22/health/surgery/surgery-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Surgical Center for Older Patients', 'kicker': 'The New Old Age', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elder Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Surgery and Surgeons', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-08-22T21:26:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Paula Span', 'person': [{'firstname': 'Paula', 'middlename': None, 'lastname': 'Span', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/89868854-2cfe-5f93-9996-d489c966c492', 'word_count': 808, 'uri': 'nyt://article/89868854-2cfe-5f93-9996-d489c966c492'}, {'abstract': '“The Trials of Muhammad Ali” traces the road to Mr. Ali’s refusal in 1967 to serve in the Vietnam War, which cost him his license to box.', 'web_url': 'https://www.nytimes.com/2013/08/23/movies/trials-of-muhammad-ali-traces-alis-battle-over-vietnam.html', 'snippet': '“The Trials of Muhammad Ali” traces the road to Mr. Ali’s refusal in 1967 to serve in the Vietnam War, which cost him his license to box.', 'lead_paragraph': 'Muhammad Ali, born Cassius Clay, was not the only American to refuse to serve during the Vietnam War, but he was, by some measures, the most famous, the loudest and the baddest. Tracing the road to Mr. Ali’s act of defiance in 1967, Bill Siegel’s film “The Trials of Muhammad Ali” tries to recover the cultural éclat of the moment after decades of pop-history shorthand have reduced it to sound bites about the Vietcong.', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23TRIALS_SPAN/0823TRIALS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/23/arts/23TRIALS_SPAN/0823TRIALS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/23/arts/23TRIALS_SPAN/0823TRIALS-jumbo.jpg', 'height'