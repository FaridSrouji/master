01/nyregion/01TABLE_SPAN/01TABLE-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/09/01/nyregion/01TABLE_SPAN/01TABLE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/nyregion/01TABLE_SPAN/01TABLE-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/nyregion/01TABLE_SPAN/01TABLE-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/nyregion/01TABLE_SPAN/01TABLE_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/09/01/nyregion/01TABLE_SPAN/01TABLE_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/09/01/nyregion/01TABLE_SPAN/01TABLE_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tennis in the Background', 'kicker': 'At the Table | Mojito Bar and Restaurant', 'content_kicker': None, 'print_headline': 'Tennis in the Background', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Robbins, Liz', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Flushing (Queens, NY)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Mojit