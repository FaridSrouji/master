kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Evolution (Biology)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-08-19T01:00:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Thomas Nagel', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Nagel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b3f314a9-418c-5e68-8f19-cdc3b2b1d8f1', 'word_count': 971, 'uri': 'nyt://article/b3f314a9-418c-5e68-8f19-cdc3b2b1d8f1'}, {'abstract': 'In a time when speech is subjected to unprecedented scrutiny, the safest way to express a subversive thought is to clothe it in unfamiliar garb.', 'web_url': 'https://www.nytimes.com/2013/08/19/opinion/learn-to-talk-in-beggars-cant.html', 'snippet': 'In a time when speech is subjected to unprecedented scrutiny, the safest way to express a subversive thought is to clothe it in unfamiliar garb.', 'lead_paragraph': 'RULERS have long kept certain powers hidden from their subjects. But this summer’s disclosures concerning the surveillance practices of the National Security Agency have made it clear that today’s freedom of expression comes at the price of a new power: the state’s ability to burrow ever deeper, by technological means, into the private language of ordinary citizens. ', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/17/opinion/0819OPEDdoyle/0819OPEDdoyle-articleLarge.jpg', 'height': 443, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/0