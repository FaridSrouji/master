/sports/METS-ILLO/METS-ILLO-jumbo.jpg', 'height': 687, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/METS-ILLO/METS-ILLO-superJumbo.jpg', 'height': 1375, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/METS-ILLO/METS-ILLO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/30/sports/METS-ILLO/METS-ILLO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/30/sports/METS-ILLO/METS-ILLO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Mets, Brought to You in ...', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Mets, Brought to You in ...', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Arangure, Jorge Jr', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Names, Personal', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'den Dekker, Matt', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': "d'Arnaud, Travis", 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'deGrom, Jacob', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-08-30T03:42:40+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Jorge Arangure Jr', 'person': [{'firstname': 'Jorge', 'middlename': None, 'lastname': 'Ara