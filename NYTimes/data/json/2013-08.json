, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/arts/jpbook/jpbook-superJumbo.jpg', 'height': 1299, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/arts/jpbook/jpbook-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/08/26/arts/jpbook/jpbook-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/arts/jpbook/jpbook-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hunting Again for Salinger Within the Silences and Secrets', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hunting Again for Salinger Within the Silences and Secrets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Salinger, J D', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Salerno, Shane', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Shields, David', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-08-25T21:13:09+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Michiko Kakutani', 'person': [{'firstname': 'Michiko', 'middlename': None, 'lastname': 'Kakutani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a008015c-9dce-5be1-83cb-c0d06c6fafb0', 'word_count': 1471, 'uri': 'nyt://article/a008015c-9dce-5be1-83cb-c0d06c6fafb0'}, {'abstract': 'The Charlie Parker Jazz Festival this year included Cécile McLorin Salvant, the Jimmy Heath Big Band and Kenny Garrett.', 'web_url': 'https://www.nytimes.com/2013/08/26/arts/music/cecile-mclorin-salvant-and-kenny-garrett-at-jazz-festival.html', 'snippet': 'The Charlie Parker Jazz Festival this year included Cécile McLorin Salvant, the Jimmy Heath Big Band and Kenny Garrett.', 'lead_paragraph': 'Like a lunar event or a geyser, it came at the expected hour: 5:45 on a late-August Saturday afternoon at the Charlie Parker Jazz Festival in Marcus Garvey Park in Harlem. (My notes from last year mark it at 5:30.) It’s not planned, it just happens: the tempo shifts down and it becomes time for a few dozen audience members — mostly retirement age, probably sharper looking than you — to go down in front of the stage and dance together, full of grace. It’s something you ought to see.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/arts/parker1/parker1-articleLarge.jpg', 'height': 333, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/08/26/arts/parker1/parker1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 333}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/arts/parker1/parker1-jumbo.jpg', 'height': 569, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/arts/parker1/parker1-superJumbo.jpg', 'height': 1138, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/08/26/arts/parker1/parker1-thumbStandard.jpg', 'height': 75, 'width'