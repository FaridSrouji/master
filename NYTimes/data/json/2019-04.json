og.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/arts/16jackson-authors/merlin_151374567_ee604689-2f77-4235-85a4-14c41189b670-articleLarge.jpg', 'height': 439, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/16/arts/16jackson-authors/merlin_151374567_ee604689-2f77-4235-85a4-14c41189b670-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 439}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/arts/16jackson-authors/merlin_151374567_ee604689-2f77-4235-85a4-14c41189b670-jumbo.jpg', 'height': 750, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/arts/16jackson-authors/merlin_151374567_ee604689-2f77-4235-85a4-14c41189b670-superJumbo.jpg', 'height': 1500, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/arts/16jackson-authors/16jackson-authors-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/16/arts/16jackson-authors/16jackson-authors-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/arts/16jackson-authors/16jackson-authors-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Michael Jackson Biographers Face History, and the Mirror', 'kicker': None, 'content_kicker': None, 'print_headline': 'Jackson Biographers Rethink Their Work', 