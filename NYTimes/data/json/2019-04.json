': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McGahn, Donald F II', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mueller, Robert S III', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Russian Interference in 2016 US Elections and Ties to Trump Associates', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Special Prosecutors (Independent Counsel)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Privilege, Doctrine of', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-04-22T10:00:05+0000', 'document_type': 'article', 'news_desk': 'Podcasts', 'section_name': 'Podcasts', 'subsection_name': 'The Daily', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c9385870-d3ad-5ec4-b4bf-67472d57673b', 'word_count': 305, 'uri': 'nyt://article/c9385870-d3ad-5ec4-b4bf-67472d57673b'}, {'abstract': 'The world wants to help. The terrorists won’t allow it.', 'web_url': 'https://www.nytimes.com/2019/04/22/opinion/gaza-hamas-israel.html', 'snippet': 'The world wants to help. The terrorists won’t allow it.', 'lead_paragraph': 'Hamas has left Gaza in shambles. Life there is difficult, sad and abnormal. Only buildings with generators actually maintain steady power. The lack of power affects everything from preserving fresh food to treating sewage. If a person in Gaza falls ill, he is likely to find trained medical professionals unable to help because of the lack of equipment and medicines. The people there — even the talented and educated — can’t find jobs. The store shelves are empty. The shoreline, which in many other places in the Mediterranean would be filled with beach resorts, is covered in the raw sewage and debris from successive wars. The cost of conflict is seen in all aspects of life in Gaza.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/22/opinion/22greenblattWeb/merlin_152938950_40bd504b-89e8-449c-b27c-e2f4f995131a-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/22/opinion/22greenblattWeb/merlin_152938950_40bd504b-89e8-449c-b27c-e2f4f995131a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/22/opinion/22greenblattWeb/merlin_152938950_40bd504b-89e8-449c-b27c-e2f4f995131a-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/22/opinion/22greenblattWeb/merlin_152938950_40bd504b-89e8-449c-b27c-e2f4f995131a-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/22/opinion/22greenblattWeb/22greenblattWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/22/opinion/22greenblattWeb/22greenblattWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/22/opinion/22greenblattWeb/22greenblattWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Care About Gaza? Blame Hamas', 'kicker': None, 'content_kick