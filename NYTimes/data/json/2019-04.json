: None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/02/world/02iran1/02iran1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/02/world/02iran1/02iran1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/02/world/02iran1/02iran1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Iran Says Trump’s Sanctions Have Frustrated Flood Relief Efforts', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sanctions  Have Stalled  Flood Relief, Iran Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iran', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Floods', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'International Federation of Red Cross and Red Crescent Societies', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Disasters and Emergencies', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Humanitarian Aid', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-04-02T19:33:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Rick Gladstone', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Gladstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/72814568-5719-5970-96d1-387ba1caca75', 'word_count': 595, 'uri': 'nyt://article/72814568-5719-5970-96d1-387ba1caca75'}, {'abstract': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'web_url': 'https://www.nytimes.com/2019/04/02/style/tiny-modern-love-stories-i-kept-falling-in-love-with-other-people.html', 'snippet': 'Modern Love in miniature, featuring reader-submitted stories of no more than 100 words.', 'lead_paragraph': 'I fell in love with a boy when I was only 18. Both of us were raised in conservative Christian households, and we said “I do” at 20. Twelve years and two children later, we’re still in love. But I kept falling in love with other people, too. So now we’re polyamorous. I have a boyfriend. He has a girlfriend. And we share a relationship with another woman. I enjoy it, but what I think I like most is watching other people fall in love with the same boy I fell for years ago. It’s like, “Yeah, you get it, right?” — Jennifer Martin', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/03/11/fashion/XXTINYLOVE-SPRINGPROMO4/XXTINYLOVE-SPRINGPROMO4-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/03/11/fashion/XXTINYLOVE-SPRINGPROMO4/XXTINYLOVE-SPRINGPROMO4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 393}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/03/11/fashion/XXTINYLOVE-SPRINGPROMO4/XXTINYLOVE-SPRINGPROMO4-jumbo.jpg', 'height': 670, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/03/11/fashion/XXTINYLOVE-SPRINGPROMO4/XXTINYLOVE-SPRINGPROMO4-superJumbo.jpg', 'height': 1260, 'width': 1926, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/03/11/fashion/XXTINYLOVE-SPRINGPROMO4/XXTINYLOVE-SPRINGPROMO4-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/03/11/fashion/XXTINYLOVE-SPRINGPROMO4/XXTINYLOVE-SPRINGPROMO4-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/03/11/fashion/XXTINYLOVE-SPRINGPROMO4/XXTINYLOVE-SPRINGPROMO4-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiny Love Stories: ‘I Kept Falling in Love With Other People’', 'kicker': 'MODERN LOVE', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Love (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Modern Love (Times Column)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dating and Relationships', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-04-02T19:53:45+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/222db0ef-c7ac-5309-a6ad-57a6520217e0', 'word_count': 548, 'uri': 'nyt://article/222db0ef-c7ac-5309-a6ad-57a6520217e0'}, {'abstract': '“There are old friends and new friends,” the owner said. “Are you going to sing?”', 'web_url': 'https://www.nytimes.com/2019/04/02/style/winnies-karaoke-bar-chinatown.html', 'snippet': '“There are old friends and new friends,” the owner said. “Are you going to sing?”', 'lead_paragraph': 'For three decades, Winnie’s, an old-school dive and raucous karaoke bar, lured Chinatown residents and fashionable visitors for boozy singalongs in the shadow of the Tombs (otherwise known as the Manhattan Detention Complex). When it shut in 2015, it became another casualty of a gilded city.