acy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/28/sports/28mets-nido/28mets-nido-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/28/sports/28mets-nido/28mets-nido-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/28/sports/28mets-nido/28mets-nido-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mets Bid Travis d’Arnaud Adieu, Then Beat Brewers', 'kicker': 'Mets 5, Brewers 2', 'content_kicker': None, 'print_headline': 'Catcher Gets  Promotion,  Then Gives  Mets a Lift', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Milwaukee Brewers', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Matz, Steven (1991- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': "d'Arnaud, Travis", 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Nido, Tomas (1994- )', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cano, Robinson', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Yelich, Christian (1991- )', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-04-28T22:50:00+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Kevin Armstrong', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'Armstrong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/95865bf3-9a88-5898-9e13-ef04edba90af', 'word_count': 729, 'uri': 'nyt://article/95865bf3-9a88-5898-9e13-ef04edba90af'}, {'abstract': 'But some worry that the grass-roots demonstrations — including egging officials’ homes — are little more than mob justice.', 'web_url': 'https://www.nytimes.com/2019/04/28/opinion/paraguay-corruption.html', 'snippet': 'But some worry that the grass-roots demonstrations — including egging officials’ homes — are little more than mob justice.', 'lead_paragraph': 'The global anticorruption watchdog Transparency International describes Paraguay as a “monolith in the study of corruption,” a country that offers a case study on the difficulty of recovering from a dictatorship that institutionalized corruption. Such studies may have to write a new chapter now that Paraguayans have introduced new weapons into the battle — toilet paper and eggs.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/28/opinion/28paraguay/merlin_154031463_fa596766-c386-4970-819f-440fa0e9e515-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/28/opinion/28paraguay/merlin_154031463_fa596766-c386-4970-819f-440fa0e9e515-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/28/opinion/28paraguay/merlin_154031463_fa596766-c386-4970-819f-440fa0e9e515-jumbo.jpg', 'height': 598, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/28/opinion/28paraguay/merlin_154031463_fa596766-c386-4970-819f-440fa0e9e515-superJumbo.jpg', 'height': 1196, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legac