ion': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/10/opinion/tech-companies-privacy-1554943133137/tech-companies-privacy-1554943133137-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/10/opinion/tech-companies-privacy-1554943133137/tech-companies-privacy-1554943133137-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/10/opinion/tech-companies-privacy-1554943133137/tech-companies-privacy-1554943133137-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tech Companies Say They Care', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Facebook Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corp', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMAZON.COM INC', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cyberattacks and Hackers', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-04-11T00:46:49+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Charlie Warzel and Stuart A. Thompson', 'person': [{'firstname': 'Charlie', 'middlename': None, 'lastname': 'Warzel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Stuart', 'middlename': 'A.', 'lastname': 'Thompson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/e5135e3e-1665-5bac-acfb-013443622105', 'word_count': 0, 'uri': 'nyt://interactive/e5135e3e-1665-5bac-acfb-013443622105'}, {'abstract': 'In China, facial recognition cameras are celebrated, and many citizens believe the rest of the world is dangerous without them.', 'web_url': 'https://www.nytimes.com/2019/04/10/opinion/china-internet-surveillance.html', 'snippet': 'In China, facial recognition cameras are celebrated, and many citizens believe the rest of the world is dangerous without them.', 'lead_paragraph': 'In China, we have an old saying: “tian gao, huangdi yuan,” or, “the emperor is as far away as the sky.” We use it to reassure ourselves that in a country that is so big, with so many people, we can lose only so much freedom — the central government can’t monitor everyone.', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Qian/52a53439887f4c1693664b425f540be4-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/14/opinion/sunday/14Qian/52a53439887f4c1693664b425f540be4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Qian/52a53439887f4c1693664b425f540be4-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Qian/52a53439887f4c1693664b425f540be4-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Qian/14Qian-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/14/opinion/sunday/14Qian/14Qian-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Qian/14Qian-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Feeling Safe in the Surveillance State', 'kicker': None, 'content_kicker': None, 'print_headline': 'Feeling Safe and Secure Under the Gaze Of Facial Recognition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-04-11T00:48:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Jianan Qian', 'person': [{'firstname': 'Jianan', 'middlename': None, 'lastname': 'Qian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e82cb0d2-5a3c-574d-a1cb-60cecd596b45', 'word_count': 1272, 'uri': 'nyt://article/e82cb0d2-5a3c-574d-a1cb-60cecd596b45'}, {'abstract': 'Sure, electronic eyes are spying. But look at everything this pocket computer can do!', 'web_url': 'https://www.nytimes.com/2019/04/10/opinion/iphone-privacy.html', 'snippet': 'Sure, electronic eyes are spying. But look at everything this pocket computer can do!', 'lead_paragraph': 'My phone is my favorite possession. I wish I could pretend it has been some torrid courtship, that after much cat-and-mousing the two of us succumbed to our mutual attraction and decided to settle down and make an honest go of it, but I can’t: I am in breathless pursuit, hustling to keep her updated and paid for, wooing her with expensive protective cases and as many off-brand charging cords as there are outlets in my home. She acknowledges this attention with occasional notifications, blinking on the screen, reminders to update, so many needs. That makes me want her even more.', 'print_section': 'SR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14irby/2a079fe330144d2788a029139d4a4842-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/14/opinion/sunday/14irby/2a079fe330144d2788a029139d4a4842-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14irby/2a079fe330144d2788a029139d4a4842-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14irby/2a079fe330144d2788a029139d4a4842-superJumbo.jpg', 'height': 1801, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14irby/14irby-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/14/opinion/sunday/14irby/14irby-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/20