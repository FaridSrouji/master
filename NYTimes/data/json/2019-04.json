ajor': 'N'}], 'pub_date': '2019-04-11T00:19:55+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Stuart A. Thompson', 'person': [{'firstname': 'Stuart', 'middlename': 'A.', 'lastname': 'Thompson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/632ee4ec-70d6-5a1f-80a5-30492a712a5b', 'word_count': 0, 'uri': 'nyt://interactive/632ee4ec-70d6-5a1f-80a5-30492a712a5b'}, {'abstract': 'The forces of wealth creation once fostered the right to be left alone. But that has changed.', 'web_url': 'https://www.nytimes.com/2019/04/10/opinion/sunday/privacy-capitalism.html', 'snippet': 'The forces of wealth creation once fostered the right to be left alone. But that has changed.', 'lead_paragraph': 'For much of human history, what we now call “privacy” was better known as being rich. Privacy, like wealth, was something that most people had little or none of. Farmers, slaves and serfs resided in simple dwellings, usually with other people, sometimes even sharing space with animals. They had no expectation that a meaningful part of their lives would be unwatchable or otherwise off limits to others. That would have required homes with private rooms. And only rich people had those.', 'print_section': 'SR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Wu/14Wu-articleLarge.gif', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/14/opinion/sunday/14Wu/14Wu-articleLarge.gif', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Wu/14Wu-jumbo.gif', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Wu/14Wu-superJumbo.gif', 'height': 1050, 'width': 1050, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Wu/634fbafb23154672b77e8a59b264a0d9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/14/opinion/sunday/14Wu/634fbafb23154672b77e8a59b264a0d9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/14/opinion/sunday/14Wu/634fbafb23154672b77e8a59b264a0d9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Capitalism Betrayed Privacy', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Way Capitalism Betrayed the Right to Be Left Alone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Privacy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Data-Mining and Database Marketing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-04-11T00:30:55+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Tim Wu', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Wu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_i