: 'image', 'url': 'images/2019/04/15/opinion/15goldbergWeb/merlin_149970873_3c9d8edc-3353-4ec6-9c4e-efc353c0e399-superJumbo.jpg', 'height': 1346, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/15/opinion/15goldbergWeb/15goldbergWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/15/opinion/15goldbergWeb/15goldbergWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/15/opinion/15goldbergWeb/15goldbergWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'On B.D.S. and Free Speech', 'kicker': 'letter', 'content_kicker': None, 'print_headline': 'On B.D.S. and Free Speech', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Boycott, Divestment and Sanctions (BDS)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Barghouti, Omar', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-04-17T18:33:45+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'subsection_name': 'Letters', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/e80216d5-0748-5358-8873-488f7bb3d8ec', 'word_count': 213, 'uri': 'nyt://article/e80216d5-0748-5358-8873-488f7bb3d8ec'}, {'abstract': 'For the past 30 years, Vivian Suter has been quietly working in her home on Lake Atitlán, Guatemala. Now, she’s found international recognition.', 'web_url': 'https://www.nytimes.com/2019/04/17/t-magazine/vivian-suter.html', 'snippet': 'For the past 30 years, Vivian Suter has been quietly working in her home on Lake Atitlán, Guatemala. Now, she’s found international recognition.', 'lead_paragraph': 'WHEN VIVIAN SUTER arrived at the lake in the early 1980s, it took her three days to summon the courage to look at it. At the time, the Swiss-Argentine artist was in her early 30s and recently divorced. She had spent the previous few months driving through Central America on a solitary tour of Mesoamerican ruins. In Guatemala, where she’d come to see the Mayan Tikal architectural site, she arrived one night in a town on the outskirts of Lake Atitlán, which fills the crater of a volcano. Though she couldn’t see the lake, the thought of it unsettled her. “I was very emotional about the lake, and I didn’t dare to go and look at it,” she remembers, sitting in her garden on the northeastern side of Lake Atitlán, across from an imposing matapalo, or strangler fig. “I felt it would have an incredible attraction. I felt it would be powerful.”', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/17/t-magazine/17tmag-suter-slide-BBMK/17tmag-suter-slide-BBMK-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/17/t-magazine/17tmag-suter-slide-BBMK/17tmag-suter-slide-BBMK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/17/t-magazine/17tmag-suter-slide-BBMK/17tmag-suter-slide-BBMK-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/17/t-magazine/17tmag-suter-slide-BBMK/1