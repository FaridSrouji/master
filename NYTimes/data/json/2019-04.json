r': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-04-02T09:00:01+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'subsection_name': 'Self-Care', 'byline': {'original': 'By Tariro Mzezewa and Sam Cannon', 'person': [{'firstname': 'Tariro', 'middlename': None, 'lastname': 'Mzezewa', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sam', 'middlename': None, 'lastname': 'Cannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/37f81e7a-cea4-5cf4-b4d2-e2cdd3e5effa', 'word_count': 1119, 'uri': 'nyt://article/37f81e7a-cea4-5cf4-b4d2-e2cdd3e5effa'}, {'abstract': 'A 71-year-old woman in Scotland has never felt pain. What can we learn from her unusual case?', 'web_url': 'https://www.nytimes.com/2019/04/02/learning/would-you-want-to-live-a-life-without-ever-feeling-pain.html', 'snippet': 'A 71-year-old woman in Scotland has never felt pain. What can we learn from her unusual case?', 'lead_paragraph': 'Imagine you could live your life without experiencing pain. Not quite as a superhero, you wouldn’t be super strong — you just wouldn’t feel any pain, physical or emotional. Ever.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Would You Want to Live a Life Without Ever Feeling Pain?', 'kicker': 'Student Opinion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-04-02T09:00:01+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Jeremy Engle', 'person': [{'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Engle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3d185dbe-6efe-5986-bc83-613c916b3a6c', 'word_count': 949, 'uri': 'nyt://article/3d185dbe-6efe-5986-bc83-613c916b3a6c'}, {'abstract': 'Get permission from local officials. Make no assumptions about what will be unearthed.', 'web_url': 'https://www.nytimes.com/2019/04/02/magazine/how-to-dig-up-a-grave.html', 'snippet': 'Get permission from local officials. Make no assumptions about what will be unearthed.', 'lead_paragraph': '“You never want to just go in and start digging,” says Lori E. Baker, a forensic anthropologist at Baylor University in Waco, Tex., who has dug up hundreds of graves in public and private cemeteries since founding Reuniting Families, an organization that tries to locate and repatriate the remains of migrants who died crossing the border. Don’t start digging before receiving permission from local officials. If the grave is unmarked, use ground-penetrating radar. Don’t assume anything about what you’ll unearth. “We’ve found burials with seven people in one grave haphazardly thrown in, some in body bags, some in garbage bags, some in biohazard bags,” Baker says.', 'print_section': 'MM', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/07/magazine/07Mag-Tip-1/07Mag-Tip-1-articleLarge.jpg', 'height': 539, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/07/magazine/07Mag-Tip-1/07Mag-Tip-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 539}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/07/magazine/07Mag-Tip-1/07Mag-Tip-1-jumbo.jpg', 'height': 920, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'imag