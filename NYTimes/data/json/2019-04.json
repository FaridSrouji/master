int_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/10/nyregion/10killer-print/5294a66133264a55af97e93e916b9350-articleLarge.jpg', 'height': 298, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/10/nyregion/10killer-print/5294a66133264a55af97e93e916b9350-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 298}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/10/nyregion/10killer-print/5294a66133264a55af97e93e916b9350-jumbo.jpg', 'height': 508, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/10/nyregion/10killer-print/5294a66133264a55af97e93e916b9350-superJumbo.jpg', 'height': 993, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/10/nyregion/10killer-print/09BROADNAX-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/10/nyregion/10killer-print/09BROADNAX-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/10/nyregion/10killer-print/09BROADNAX-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '2 Women Were Killed on a Beach Vacation in 1973. A DNA Test Just Led to an Arrest.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cold-Case Squad Finds DNA in Virginia Deaths Tied to Octogenarian', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'v