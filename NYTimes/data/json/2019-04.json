2019/04/04/style/04rites-therapy-1/04rites-therapy-1-superJumbo.jpg', 'height': 748, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/04/style/04rites-therapy-1/04rites-therapy-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/04/style/04rites-therapy-1/04rites-therapy-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/04/style/04rites-therapy-1/04rites-therapy-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Will You Stay With Me Until I Die?’', 'kicker': 'Rites of passage', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Death and Dying', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Funerals and Memorials', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Breast Cancer', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-selfcare', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-science', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-04-18T09:00:01+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Lori Gottlieb', 'person': [{'firstname': 'Lori', 'middlename': None, 'lastname': 'Gottlieb', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0411f43-1234-50a8-a1f6-b9f3ed2b351d', 'word_count': 1516, 'uri': 'nyt://article/e0411f43-1234-50a8-a1f6-b9f3ed2b351d'}, {'abstract': 'The relatively straight line that we hope our lives might follow can veer suddenly, plunging us into chaos or ecstasy; choices can turn frantically ominous or prudently providential.', 'web_url': 'https://www.nytimes.com/2019/04/18/magazine/poem-just-to-be-clear.html', 'snippet': 'The relatively straight line that we hope our lives might follow can veer suddenly, plunging us into chaos or ecstasy; choices can turn frantically ominous or prudently providential.', 'lead_paragraph': 'Despite its pellucid language and forthright syntax, this poem is not as innocuous as its title suggests. The relatively straight line that we hope our lives might follow can veer suddenly, plunging us into chaos or ecstasy; choices can turn frantically ominous or prudently providential. And even if we manage to dodge unexpected bullets and dislodged boulders tumbling our way, in the end the delicate menace of old age, with its multitudinous possibilities of physical failure, awaits us. The question isn’t how we’ll get there, but when. Selected by Rita Dove', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/21/magazine/21mag-Poem-1/21mag-Poem-1-jumbo-v4.png', 'height': 87, 'width': 247, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/21/magazine/21mag-Poem-1/21mag-Poem-1-superJumbo-v4.png', 'height': 87, 'width': 247, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Poem: Just to Be Clear', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poetry and Poets', 'rank': 1, 'major': 'N'}], 'pub_date': '2019-04-18T09:00:02+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'by