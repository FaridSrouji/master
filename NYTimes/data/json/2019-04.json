th': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Is Hard About Being a Boy?', 'kicker': 'Student Opinion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-04-03T09:00:02+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Jeremy Engle', 'person': [{'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Engle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b077f04-2fdd-57ce-8a78-b779070c9b3c', 'word_count': 1364, 'uri': 'nyt://article/5b077f04-2fdd-57ce-8a78-b779070c9b3c'}, {'abstract': 'After years of misdiagnoses, Stephen Hopkins learned that lead in his bones was making him sick. Now he’s calling for the military to increase testing for metal poisoning in troops.', 'web_url': 'https://www.nytimes.com/2019/04/03/magazine/lead-poisoning-military-soldiers.html', 'snippet': 'After years of misdiagnoses, Stephen Hopkins learned that lead in his bones was making him sick. Now he’s calling for the military to increase testing for metal poisoning in troops.', 'lead_paragraph': 'At age 30, Stephen Hopkins was back in the Army for a second time. After serving as an enlisted soldier from 1991 to 1995, he returned as an officer in 2000. He was a man who routinely maxed fitness tests and endured physical hardship while deployed to rural locales in Afghanistan. Selected for Special Forces training, Hopkins tackled the demanding courses with gusto, later returning to combat for a total of seven deployments. He had a job he loved and excelled at, and his star was ascending.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/07/magazine/07atwar-LEADPOISONING-1/07at