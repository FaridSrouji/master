_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/05/arts/04osipova-hallberg-print1/merlin_153043449_933b0b15-3a17-4736-9f15-478ad2cd01f8-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/05/arts/04osipova-hallberg-print1/merlin_153043449_933b0b15-3a17-4736-9f15-478ad2cd01f8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/05/arts/04osipova-hallberg-print1/merlin_153043449_933b0b15-3a17-4736-9f15-478ad2cd01f8-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/05/arts/04osipova-hallberg-print1/merlin_153043449_933b0b15-3a17-4736-9f15-478ad2cd01f8-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/05/arts/04osipova-hallberg-print1/merlin_153043449_933b0b15-3a17-4736-9f15-478ad2cd01f8-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/05/arts/04osipova-hallberg-print1/merlin_153043449_933b0b15-3a17-4736-9f15-478ad2cd01f8-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/05/arts/04osipova-hallberg-print1/merlin_153043449_933b0b15-3a17-4736-9f15-478ad2cd01f8-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Osipova Stretches, and Reconnects With Hallberg', 'kicker': None, 'content_kicker': None, 'print_headline': 'Colluding, Gloriously, For All to See', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Center Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Osipova, Natalia', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ratmansky, Alexei', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hallberg, David', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Valse Triste (Ballet)', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-04-04T16:51:43+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Siobhan Burke', 'person': [{'firstname': 'Siobhan', 'middlename': None, 'lastname': 'Burke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/52b2be75-72f8-5ff8-83b4-b3138979cdf7', 'word_count': 514, 'uri': 'nyt://article/52b2be75-72f8-5ff8-83b4-b3138979cdf7'}, {'abstract': 'With Britain facing a long extension, the idea is to add a provision for shortening the delay if Parliament should agree on an exit deal.', 'web_url': 'https://www.nytimes.com/2019/04/04/world/europe/brexit-extension.html', 'snippet': 'With Britain facing a long extension, the idea is to add a provision for shortening the delay if Parliament should agree on an exit deal.', 'lead_paragraph': 'LONDON — After months of tortured debate over Britain’s departure from the European Union, a new word has entered the jargon-strewn Brexit lexicon: “flextension.” It could hold the key to the next phase.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'image