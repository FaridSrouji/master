hgate1/19Southgate1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/19/books/review/19Southgate1/19Southgate1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Peerless Chronicler of the 1970s and ’80s Turns Her Gaze on Generation Y', 'kicker': 'Fiction', 'content_kicker': None, 'print_headline': 'School Daze', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Beattie, Ann', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'A Wonderful Stroke of Luck: A Novel (Book)', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-04-02T18:53:58+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Martha Southgate', 'person': [{'firstname': 'Martha', 'middlename': None, 'lastname': 'Southgate', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/23c4d316-0e19-5127-87d7-f0fed7fe3025', 'word_count': 1278, 'uri': 'nyt://article/23c4d316-0e19-5127-87d7-f0fed7fe3025'}, {'abstract': 'Toews’s eighth book was inspired by a real-life series of attacks in a Mennonite community.', 'web_url': 'https://www.nytimes.com/2019/04/02/books/review-women-talking-miriam-toews.html', 'snippet': 'Toews’s eighth book was inspired by a real-life series of attacks in a Mennonite community.', 'lead_paragraph': 'They were called the “ghost rapes.” In 2005, Mennonite women living in a secluded colony in Bolivia reported waking up bleeding, with dirty fingerprints on their bodies and fraying rope around their wrists. The elders dismissed their complaints or blamed them on “wild female imagination” — until it was discovered that men from the community had been creeping through windows at night, sedating whole households with bovine anesthetic and raping the women. At least 300 female members of the colony had been attacked, from toddlers to grandmothers. When the eight culprits were put on trial, in 2011, the women were forbidden to testify; their fathers and husbands spoke against the defendants instead.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/arts/02booktoews1/02booktoews1-articleLarge.jpg', 'height': 877, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/03/arts/02booktoews1/02booktoews1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 877}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/arts/02booktoews1/02booktoews1-jumbo.jpg', 'height': 1024, 'width': 701, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/arts/02booktoews1/02booktoews1-superJumbo.jpg', 'height': 1838, 'width': 1258, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/arts/02booktoews1/02booktoews1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/03/arts/02booktoews1/02booktoews1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/arts/02booktoews1/02booktoews1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In ‘Women Talking,’ Miriam Toews Ponders Punishment and Justice After Horrifying Crimes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Survivors Of Rape Consider What’s Left', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Toews, Miriam', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Women Talking (Book)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-04-02T18:55:10+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Parul Sehgal', 'person': [{'firstname': 'Parul', 'middlename': None, 'lastname': 'Sehgal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/47f8692c-0de8-56cb-ad7b-3ce0cf77c77f', 'word_count': 1119, 'uri': 'nyt://article/47f8692c-0de8-56cb-ad7b-3ce0cf77c77f'}, {'abstract': 'Sexual harassment is a problem. Dismissing women’s ideas is a more pervasive problem.', 'web_url': 'https://www.nytimes.com/2019/04/02/opinion/joe-biden-metoo-president.html', 'snippet': 'Sexual harassment is a problem. Dismissing women’s ideas is a more pervasive problem.', 'lead_paragraph': 'This week it’s Joe Biden’s turn in the #MeToo barrel, and like many Democrats, I’m torn about what to think. The allegations by Lucy Flores — that in 2014, when she was running for lieutenant governor of Nevada, the vice president touched her shoulders  and kissed the back of her head — cannot exactly be dismissed as an outlier, given that another allegation of guerrilla nuzzling followed just 72 hours later (this time from 2009)  and that multiple photo montages online suggest a similar pattern.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/02/opinion/02senior/02senior-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/02/opinion/02senior/02senior-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/02/opinion/02senior/02senior-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/02/opinion/02senior/02senior-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/02/opinion/02senior/02senior-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/02/opinion/02senior/02senior-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/02/opinion/02senior/02senior-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What We’re Not Talking About When We Talk About Joe Biden', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sexual Harassment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': '#MeToo Movement', 'rank': 5, 'major': 'N'}, {'name': 'org