, 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rumors and Misinformation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bloomberg News', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'BuzzFeed Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Bosworth, Andrew (1982- )', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-04-03T18:46:37+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Charlie Warzel', 'person': [{'firstname': 'Charlie', 'middlename': None, 'lastname': 'Warzel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/bc8c4077-f14c-53f1-b8db-db8970611544', 'word_count': 1002, 'uri': 'nyt://article/bc8c4077-f14c-53f1-b8db-db8970611544'}, {'abstract': 'Steve Jobs wanted to put a ding in the universe. Today, Apple wants to ding your pocketbook.', 'web_url': 'https://www.nytimes.com/2019/04/03/opinion/apple-steve-jobs.html', 'snippet': 'Steve Jobs wanted to put a ding in the universe. Today, Apple wants to ding your pocketbook.', 'lead_paragraph': 'The Steve Jobs Theater on Apple’s spendy new campus in Cupertino, Calif., is a majestic temple to pomp. An ethereal glass-and-marble cylinder set high on a serene hill, the venue feels like the architectural manifestation of the Apple co-founder’s famous “reality-distortion field.” It is an edifice meant to recall those moments when Mr. Jobs, smirking joyfully, would bound up to the stage, teasingly pull a black shroud off some new invention and instantly alter your picture of the future.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/opinion/03MANJOO/fileupload-1554315680895-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/04/03/opinion/03MANJOO/fileupload-1554315680895-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/opinion/03MANJOO/fileupload-1554315680895-jumbo.jpg', 'height': 694, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/opinion/03MANJOO/fileupload-1554315680895-superJumbo.jpg', 'height': 1389, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/opinion/03MANJOO/03MANJOO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/04/03/opinion/03MANJOO/03MANJOO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/04/03/opinion/03MANJOO/03MANJOO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Incredible Shrinking Apple', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Apple Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major':