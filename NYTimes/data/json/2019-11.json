eau', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Aaron', 'middlename': None, 'lastname': 'Byrd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/234a779c-cf27-5173-8727-3c2c2723e252', 'word_count': 0, 'uri': 'nyt://video/234a779c-cf27-5173-8727-3c2c2723e252'}, {'abstract': 'Martin Cruz Smith’s latest Russian thriller leads off Marilyn Stasio’s Crime column, which also includes a new Jack Reacher novel from Lee Child.', 'web_url': 'https://www.nytimes.com/2019/11/15/books/review/crime-fiction-marilyn-stasio-martin-cruz-smith-lee-child.html', 'snippet': 'Martin Cruz Smith’s latest Russian thriller leads off Marilyn Stasio’s Crime column, which also includes a new Jack Reacher novel from Lee Child.', 'lead_paragraph': 'If this is a Martin Cruz Smith mystery, we must be in Moscow, maybe in Gorky Park. But in a thrilling change of pace, THE SIBERIAN DILEMMA (Simon & Schuster, $27) takes us out of the city and into Russia’s untamed wilderness in search of a journalist who’s gone missing while on a dangerous, perhaps foolhardy, assignment. The case is of special importance to Smith’s detective, Arkady Renko, because the reporter, Tatiana Petrovna, is his lover. Tatiana’s boss, Sergei Obolensky, publisher of the newsmagazine Russia Now, laughingly dismisses Arkady as an anxious boyfriend, but Arkady is well aware of the dangers facing Russian journalists. If it isn’t a cup of poisoned tea today, it could be a shot between the eyes tomorrow.', 'print_section': 'BR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/books/review/17Crime/17Crime-articleLarge.jpg', 'height': 1104, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/17/books/review/17Crime/17Crime-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1104}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/books/review/17Crime/17Crime-jumbo.jpg', 'height': 1024, 'width': 557, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/books/review/17Crime/17Crime-superJumbo.jpg', 'height': 2048, 'width': 1114, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/books/review/17Crime/17Crime-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/17/books/review/17Crime/17Crime-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/books/review/17Crime/17Crime-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Arkady Renko Has Been Sent to Siberia. And He’s Fine With That.', 'kicker': 'Crime', 'content_kicker': None, 'print_headline': 'A Deadly Deadline?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Siberian Dilemma (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Martin Cruz', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Nothing More Dangerous (Book)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Eskens, Allen (1963- )', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Blue Moon: A Jack Reacher Novel (Book)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': '