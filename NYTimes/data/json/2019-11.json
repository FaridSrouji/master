o': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Country Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Combs, Luke', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'What You See Is What You Get (Album)', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-11-18T18:11:20+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d3db9bda-db86-5c55-9876-244790c1a146', 'word_count': 305, 'uri': 'nyt://article/d3db9bda-db86-5c55-9876-244790c1a146'}, {'abstract': 'In 2018, he was told he had Stage 4 prostate cancer and months to live. This week, he released his 15th album and is more dedicated than ever to finding humanity in music.', 'web_url': 'https://www.nytimes.com/2019/11/18/arts/music/joe-henry.html', 'snippet': 'In 2018, he was told he had Stage 4 prostate cancer and months to live. This week, he released his 15th album and is more dedicated than ever to finding humanity in music.', 'lead_paragraph': 'PASADENA, Calif. — “The shoe dropped,” as the songwriter and producer Joe Henry dryly puts it, on Nov. 15, 2018. He had been suffering from incapacitating back pain that doctors insisted was temporary; he finally demanded an M.R.I. scan. The first doctor who read it recognized Stage 4 prostate cancer that had metastasized into his bones, and told him he had three to seven months to live. That doctor was wrong. Henry’s cancer is in remission, and he is vigorous and happily making music.', 'print_section': 'AR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24henry1/merlin_164008839_35b585ce-9267-42ba-944a-d3b96ed75a67-articleLarge.jpg', 'height': 480, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/24/arts/24henry1/merlin_164008839_35b585ce-9267-42ba-944a-d3b96ed75a67-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 480}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24henry1/merlin_164008839_35b585ce-9267-42ba-944a-d3b96ed75a67-jumbo.jpg', 'height': 819, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24henry1/merlin_164008839_35b585ce-9267-42ba-944a-d3b96ed75a67-superJumbo.jpg', 'height': 1637, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24henry1/24henry1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/24/arts/24henry1/24henry1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/24/arts/24henry1/24henry1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Joe Henry and the Art of Disappearing Into a Song', 'kicker': None, 'content_kicker': None, 'print_headline': 'Spurn the Facts, Unveil the Truth', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Henry, Joe', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Gospel According to Water (Album)', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-11-18T18:14:22+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90822c32-b3fa-5d1b-9cc5-29a375ba39a0', 'word_count': 1867, 'uri': 'nyt://article/90822c32-b3fa-5d1b-9cc5-29a375ba39a0'}, {'abstract': 'Gov. John Bel Edwards was called the “accidental governor” when he was first elected to lead Louisiana four years ago. After winning again, no one is calling him an accident now.', 'web_url': 'https://www.nytimes.com/2019/11/18/us/John-bel-edwards-louisiana-democrat.html', 'snippet': 'Gov. John Bel Edwards was called the “accidental governor” when he was first elected to lead Louisiana four years ago. After winning again, no one is calling him an accident now.', 'lead_paragraph': 'BATON ROUGE, La. — The first time that John Bel Edwards was elected to lead Louisiana, his critics derided him as the “accidental governor.” In their view, he won in 2015 only because the Republican front-runner had been hobbled by a tsunami of scandal and political misfortune. As his re-election bid geared up, once again the G.O.P. pegged him as vulnerable. The Republican Governors Association classified Louisiana as a “top pickup.”', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/23/us/18edwards-01/merlin_164508456_3d53ef6a-44c6-4998-a9c8-a1834441c43e-articleLarge.jpg', 'height': 902, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlar