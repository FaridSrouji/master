rucker/06Drucker-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/09/opinion/06Drucker/06Drucker-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'If Keanu Reeves’s Date Can Embrace Looking Her Age, I Can Too', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Age, Chronological', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dating and Relationships', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Reeves, Keanu', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Grant, Alexandra', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Celebrities', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-11-06T20:00:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ali Drucker', 'person': [{'firstname': 'Ali', 'middlename': None, 'lastname': 'Drucker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/ce267035-2a03-59ee-9830-a25105b24d56', 'word_count': 996, 'uri': 'nyt://article/ce267035-2a03-59ee-9830-a25105b24d56'}, {'abstract': '“Ok billionaire” is a better rallying cry than “ok boomer.”', 'web_url': 'https://www.nytimes.com/2019/11/06/opinion/ok-boomer-billionaire.html', 'snippet': '“Ok billionaire” is a better rallying cry than “ok boomer.”', 'lead_paragraph': 'Generations are pretty bogus. The labels we use to casually slice up society — boomer, millennial, Gen X, Gen Z — are a nearly useless way of thinking about politics, culture or business in America. The very idea that tens of millions of people across different classes and races and geographies might hold similar views on a range of subjects just because they happened to be born during the same 20-year span of American history — the whole thing sounds a bit too much like astrology, doesn’t it?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/09/opinion/06manjooWeb/merlin_162983814_44e81099-5f38-4cdc-8c27-8ca40b729eea-articleLarge.jpg', 'height': 376, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/09/opinion/06manjooWeb/merlin_162983814_44e81099-5f38-4cdc-8c27-8ca40b729eea-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 376}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/09/opinion/06manjooWeb/merlin_162983814_44e81099-5f38-4cdc-8c27-8ca40b729eea-jumbo.jpg', 'height': 642, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/09/opinion/06manjooWeb/merlin_162983814_44e81099-5f38-4cdc-8c27-8ca40b729eea-superJumbo.jpg', 'height': 1283, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/09/opinion/06manjooWeb/06manjooWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/09/opinion/06manjooWeb/06manjooWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/09/opinion/06manjooWeb/06manjooWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Instead of a Generational Culture War, Let’s Fight the Rich', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Millennial Generation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Elderly', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-11-06T20:00:27+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Farhad Manjoo', 'person': [{'firstname': 'Farhad', 'middlename': None, 'lastname': 'Manjoo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/575d8e37-6585-5e79-943a-1f7bd99d3a64', 'word_count': 1212, 'uri': 'nyt://article/575d8e37-6585-5e79-943a-1f7bd99d3a64'}, {'abstract': 'Research shows that one of the most important differences between those who maintain their wealth and those who don’t is communication.', 'web_url': 'https://www.nytimes.com/2019/11/06/your-money/wealth-100-year-family.html', 'snippet': 'Research shows that one of the most important differences between those who maintain their wealth and those who don’t is communication.', 'lead_paragraph': 'Dennis Jaffe, a sociologist by training, has spent years trying to figure out the answer to a pressing question: what makes a hundred-year family?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/06/multimedia/06SP-JAFFE-1/merlin_163491615_42c462a2-266f-4