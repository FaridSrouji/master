er. ', 'print_section': 'AR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/arts/17JIM-SULLIVAN3/merlin_164000652_3d899df8-029e-49f1-8a1c-2afe1e0cb3d9-articleLarge.jpg', 'height': 463, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/17/arts/17JIM-SULLIVAN3/merlin_164000652_3d899df8-029e-49f1-8a1c-2afe1e0cb3d9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 463}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/arts/17JIM-SULLIVAN3/merlin_164000652_3d899df8-029e-49f1-8a1c-2afe1e0cb3d9-jumbo.jpg', 'height': 790, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/arts/17JIM-SULLIVAN3/merlin_164000652_3d899df8-029e-49f1-8a1c-2afe1e0cb3d9-superJumbo.jpg', 'height': 1581, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/arts/17JIM-SULLIVAN3/17JIM-SULLIVAN3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/17/arts/17JIM-SULLIVAN3/17JIM-SULLIVAN3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/arts/17JIM-SULLIVAN3/17JIM-SULLIVAN3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jim Sullivan, a Rock ’n’ Roll Mystery That Remains Stubbornly Unsolved', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ballad of a Doomed Troubadour', 'name': None