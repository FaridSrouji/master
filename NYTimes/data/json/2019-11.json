ge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/26/science/19TB-LICHEN1/19TB-LICHEN1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/26/science/19TB-LICHEN1/19TB-LICHEN1-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/26/science/19TB-LICHEN1/19TB-LICHEN1-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/26/science/19TB-LICHEN1/19TB-LICHEN1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/26/science/19TB-LICHEN1/19TB-LICHEN1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/26/science/19TB-LICHEN1/19TB-LICHEN1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In the Race to Live on Land, Lichens Didn’t Beat Plants', 'kicker': 'Trilobites', 'content_kicker': None, 'print_headline': 'Parallel Tracks: In the Race  To Live on Land,  Lichens Trailed Plants', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lichens', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fungi', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ALGAE', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Flowers and Plants', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Evolution (Biology)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Rese