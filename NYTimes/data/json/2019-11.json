/arts/19crown-anne1/19crown-anne1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/21/arts/19crown-anne1/19crown-anne1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘The Crown’: Who Is Princess Anne?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Princess Anne, the Royal Family and ‘The Crown’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Anne, Princess Royal (1950- )', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Crown (TV Program)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Royal Families', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-11-18T15:06:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Nancy Coleman', 'person': [{'firstname': 'Nancy', 'middlename': None, 'lastname': 'Coleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a85e3330-bac5-5d5c-8f0f-1106c1adff21', 'word_count': 753, 'uri': 'nyt://article/a85e3330-bac5-5d5c-8f0f-1106c1adff21'}, {'abstract': 'Order in! And buckle down to clean your pantry in advance of Thanksgiving.', 'web_url': 'https://www.nytimes.com/2019/11/18/dining/what-to-cook-tonight-nothing.html', 'snippet': 'Order in! And buckle down to clean your pantry in advance of Thanksgiving.', 'lead_paragraph': 'Good morning. No cooking tonight. I want you to order a pizza from your favorite source for ordered pizza; or call in to the Chinese restaurant that’s pretty good; or pick up Indian food from the spot near the highway. You could get a rotisserie chicken. I suppose you could heat water for some blue-ribbon cup ramen (above). What’s important is that you build some time into your evening so you can do something radical: Clean out your fridge, freezer and pantry, in advance of Thanksgiving, just 10 days away.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/dining/01COOKING-PERFECTINSTANTRAMEN1/01COOKING-PERFECTINSTANTRAMEN1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/01/dining/01COOKING-PERFECTINSTANTRAMEN1/01COOKING-PERFECTINSTANTRAMEN1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/dining/01COOKING-PERFECTINSTANTRAMEN1/01COOKING-PERFECTINSTANTRAMEN1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/dining/01COOKING-PERFECTINSTANTRAMEN1/01COOKING-PERFECTINSTANTRAMEN1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/dining/01COOKING-PERFECTINSTANTRAMEN1/01COOKING-PERFECTINSTANTRAMEN1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/01/dining/01COOKING-PERFECTINSTANTRAMEN1/01COOKING-PERFECTINSTANTRAMEN1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/dining/01COOKING-PERFECTINSTANTRAMEN1/01COOKING-PERFECTINSTANTRAMEN1-thumbLarge.jpg', 'height': 150, 'wid