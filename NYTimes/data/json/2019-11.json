rga', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/12/fashion/12ML-TINYLOVE-ILLO2/12ML-TINYLOVE-ILLO2-articleLarge-v2.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/12/fashion/12ML-TINYLOVE-ILLO2/12ML-TINYLOVE-ILLO2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/12/fashion/12ML-TINYLOVE-ILLO2/12ML-TINYLOVE-ILLO2-jumbo-v2.jpg', 'height': 673, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/12/fashion/12ML-TINYLOVE-ILLO2/12ML-TINYLOVE-ILLO2-superJumbo-v2.jpg', 'height': 1345, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/12/fashion/12ML-TINYLOVE-ILLO2/12ML-TINYLOVE-ILLO2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/12/fashion/12ML-TINYLOVE-ILLO2/12ML-TINYLOVE-ILLO2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/12/fashion/12ML-TINYLOVE-ILLO2/12ML-TINYLOVE-ILLO2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiny Love Stories: She Lost Her Acrylic Nail in a Pie', 'kicker': 'Modern Love', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Love (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 