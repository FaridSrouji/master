'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-11-18T18:25:06+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Rick Rojas and Jeremy Alford', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Rojas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Alford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63c8881c-22ec-53bd-8fba-15ae17f2e18c', 'word_count': 1474, 'uri': 'nyt://article/63c8881c-22ec-53bd-8fba-15ae17f2e18c'}, {'abstract': 'John Roberts blocked an appeals court ruling requiring disclosure of the records while the Supreme Court considers how to proceed.', 'web_url': 'https://www.nytimes.com/2019/11/18/us/politics/trump-supreme-court-tax-returns.html', 'snippet': 'John Roberts blocked an appeals court ruling requiring disclosure of the records while the Supreme Court considers how to proceed.', 'lead_paragraph': 'WASHINGTON — Chief Justice John G. Roberts Jr. on Monday temporarily blocked an appeals court ruling that required President Trump to turn over financial records to a House committee. The brief order gave no reasons and served to maintain the status quo while the justices decided how to proceed.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/18/nyregion/00dc-scotus/merlin_164402418_0800c8fd-1ed6-439e-b132-e4f284d9735c-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/18/nyregion/00dc-scotus/merlin_164402418_0800c8fd-1ed6-439e-b132-e4f284d9735c-articleLarge.jpg', 'xlargewidth': 