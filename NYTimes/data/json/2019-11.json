ker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Young, Neil', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Citizenship and Naturalization', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Marijuana', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Citizenship and Immigration Services (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-11-12T01:49:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nancy Coleman', 'person': [{'firstname': 'Nancy', 'middlename': None, 'lastname': 'Coleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3e6dde1d-ae68-5961-bd6e-5f48be110b1a', 'word_count': 640, 'uri': 'nyt://article/3e6dde1d-ae68-5961-bd6e-5f48be110b1a'}, {'abstract': 'The country’s growing economy and shrinking inequality propped him up for years. But its democracy and its institutions suffered, and that’s what brought him down.', 'web_url': 'https://www.nytimes.com/2019/11/11/opinion/evo-morales-bolivia.html', 'snippet': 'The country’s growing economy and shrinking inequality propped him up for years. But its democracy and its institutions suffered, and that’s what brought him down.', 'lead_paragraph': 'The forced ouster of an elected leader is by definition a setback to democracy, and so a moment of risk. But when a leader resorts to brazenly abusing the power and institutions put in his care by the electorate, as President Evo Morales did in Bolivia, it is he who sheds his legitimacy, and forcing him out often becomes the only remaining option. That is what the Bolivians have done, and what remains is to hope that Mr. Morales goes peacefully into exile in Mexico and to help Bolivia restore its wounded democracy.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/11/opinion/11boliviaWeb/merlin_164200518_7f9d2fbc-dab4-4927-b141-6605e7152c38-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/11/opinion/11boliviaWeb/merlin_164200518_7f9d2fbc-dab4-4927-b141-6605e7152c38-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/11/opinion/11boliviaWeb/merlin_164200518_7f9d2fbc-dab4-4927-b141-6605e7152c38-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/11/opinion/11boliviaWeb/merlin_164200518_7f9d2fbc-dab4-4927-b141-6605e7152c38-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/11/opinion/11boliviaWeb/11boliviaWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/11/opinion/11boliviaWeb/11boliviaWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/11/opinion/11boliviaWeb/11boliviaWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headl