'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-ANDERSON/10-BKS-ANDERSON-articleLarge-v2.jpg', 'height': 908, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/10/books/review/10-BKS-ANDERSON/10-BKS-ANDERSON-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 908}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-ANDERSON/10-BKS-ANDERSON-jumbo-v2.jpg', 'height': 1024, 'width': 677, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-ANDERSON/10-BKS-ANDERSON-superJumbo-v2.jpg', 'height': 2048, 'width': 1353, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-ANDERSON/10-BKS-ANDERSON-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/10/books/review/10-BKS-ANDERSON/10-BKS-ANDERSON-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-ANDERSON/10-BKS-ANDERSON-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Secrets and Lies', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Secrets and Lies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': '