l', 'byline': {'original': 'By Sopan Deb', 'person': [{'firstname': 'Sopan', 'middlename': None, 'lastname': 'Deb', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1f8f3621-cca5-5847-b0f5-b77aced649df', 'word_count': 1196, 'uri': 'nyt://article/1f8f3621-cca5-5847-b0f5-b77aced649df'}, {'abstract': 'A veteran diplomat responded in real time to Twitter attacks by President Trump.', 'web_url': 'https://www.nytimes.com/2019/11/15/us/politics/impeachment-briefing-what-happened-today.html', 'snippet': 'A veteran diplomat responded in real time to Twitter attacks by President Trump.', 'lead_paragraph': 'Marie Yovanovitch was the American ambassador to Ukraine until May, when she was removed by President Trump after a smear campaign orchestrated by Rudy Giuliani, the president’s personal lawyer. In a July 25 phone call with Volodymyr Zelensky, the Ukrainian president, Mr. Trump described Ms. Yovanovitch as “bad news,” adding, “She’s going to go through some things.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/15/us/politics/15impeachmentbriefing/merlin_164462067_db3ab862-807f-4710-a226-b9feed71deeb-articleLarge.jpg', 'height': 412, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/15/us/politics/15impeachmentbriefing/merlin_164462067_db3ab862-807f-4710-a226-b9feed71deeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 412}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/15/us/politics/15impeachmentbriefing/merlin_164462067_db3ab862-807f-4710-a226-b9feed71deeb-jumbo.jpg', 'height': 703, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 