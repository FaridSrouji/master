12:12+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/8d01537e-9b8c-5d12-ae52-a962d1c0122f', 'word_count': 42, 'uri': 'nyt://article/8d01537e-9b8c-5d12-ae52-a962d1c0122f'}, {'abstract': 'No corrections appeared in print on Monday, November 4, 2019.', 'web_url': 'https://www.nytimes.com/2019/11/03/pageoneplus/no-corrections-november-4-2019.html', 'snippet': 'No corrections appeared in print on Monday, November 4, 2019.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Corrections: November 4, 2019', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-11-04T02:12:38+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/e28673aa-fb58-5e59-b2e5-852ba135f905', 'word_count': 0, 'uri': 'nyt://article/e28673aa-fb58-5e59-b2e5-852ba135f905'}, {'abstract': 'Agent Laurie Blake knows a few things first-hand about the masked vigilantes she is after.', 'web_url': 'https://www.nytimes.com/2019/11/03/arts/television/watchmen-recap-episode-3.html', 'snippet': 'Agent Laurie Blake knows a few things first-hand about the masked vigilantes she is after.', 'lead_paragraph': 'When searching for precedent on the TV “remix” of “Watchmen,” which tells an original story that nonetheless heavily references the source material, a good point of comparison is the FX series “Fargo,” Noah Hawley’s twist on the 1995 Coen brothers thriller. Both shows take place in the same fictional universe as the story that inspired them, cherry-picking bits of mythology while lifting certain visual and thematic ideas wholesale and planting Easter eggs for hard-core fans. The danger to this approach, which has affected “Fargo” at times, is that the show can devolve into shallow pastiche, reverberating like a tinny cover version of a superior work of art.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/04/arts/03watchmen-recap/merlin_163531089_004387c2-93ce-4020-adad-24524f047c84-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/04/arts/03watchmen-recap/merlin_163531089_004387c2-93ce-4020-adad-24524f047c84-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/04/arts/03watchmen-recap/merlin_163531089_004387c2-93ce-4020-adad-24524f047c84-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/04/arts/03watchmen-recap/merlin_163531089_004387c2-93ce-4020-adad-24524f047c84-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/04/arts/03watchmen-recap/03watchmen-recap-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/04/arts/03watchmen-recap/03watchmen-recap-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/04/arts/03watchmen-recap/03watchmen-recap-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Watchmen’ Season 1, Episode 3 Recap: Good Guys for Breakfast', 'kicker': 'Watchmen', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Watchmen (TV Program)', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-11-04T03:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Scott Tobias', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Tobias', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c34ec612-955b-5ef2-a18a-c68d404066c5', 'word_count': 1299, 'uri': 'nyt://article/c34ec612-955b-5ef2-a18a-c68d404066c5'}, {'abstract': 'The perspective-shifting series ended its five-season run with a few last surprises and a few last chances for redemption.', 'web_url': 'https://www.nytimes.com/2019/11/03/arts/television/the-affair-finale.html', 'snippet': 'The perspective-shifting series ended its five-season run with a few last surprises and a few last chances for redemption.', 'lead_paragraph': 'The final episode of “The Affair” begins and ends with different versions of the same song. In its opening minutes, “The Whole of the Moon” by the Irish folk-rock band the Waterboys blares forth while Noah Solloway drills friends and family in a dance routine for his daughter Whitney’s wedding. As sung by the vocalist Mike Scott, the lyrics regard a loved one with awe that borders on pagan devotion: “I saw the crescent,” he joyfully yelps. “You saw the whole of the moon.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/03/arts/03affair-recap/merlin_1