: 0, 'uri': 'nyt://video/4560bb46-4501-5163-99cb-07550a8a9661'}, {'abstract': 'The United Nations is investigating attacks on seven humanitarian sites in Syria. Diplomats say Russia is trying to keep the U.N. findings secret.', 'web_url': 'https://www.nytimes.com/2019/11/14/world/middleeast/russia-syria-hospital-bombing.html', 'snippet': 'The United Nations is investigating attacks on seven humanitarian sites in Syria. Diplomats say Russia is trying to keep the U.N. findings secret.', 'lead_paragraph': 'The aerial bombings of hospitals in rebel areas of Syria have long stood out as possible war crimes, so brazen that the leader of the United Nations ordered a special inquiry three months ago, raising hope of some accountability.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.N. Query on Syria Hospital Bombings May Be Undermined by Russia Pressure, Limited Scope', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.N. Inquiry on Syria Hospital Bombings Might Be Undermined by Russia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Idlib (Syria)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Assad, Bashar al-', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Human Rights Watch', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Physicians for Human Rights', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Civilian Casualties', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-11-14T20:15:12+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Whitney Hurst and Rick Gladstone', 'person': [{'firstname': 'Whitney', '