 of all the tellings that came before it.', 'print_section': 'BR', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-BAPTISTE/10-BKS-BAPTISTE-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/10/books/review/10-BKS-BAPTISTE/10-BKS-BAPTISTE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-BAPTISTE/10-BKS-BAPTISTE-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-BAPTISTE/10-BKS-BAPTISTE-superJumbo.jpg', 'height': 761, 'width': 1142, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-BAPTISTE/10-BKS-BAPTISTE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/10/books/review/10-BKS-BAPTISTE/10-BKS-BAPTISTE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/books/review/10-BKS-BAPTISTE/10-BKS-BAPTISTE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'She’s Seeking Power, But She’s Not Power-Seeking', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'She’s Seeking Power, But She’s Not Power-Seeking', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name'