t': None, 'type': 'image', 'url': 'images/2019/11/06/t-magazine/06tmag-oc-mts/06tmag-oc-mts-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/06/t-magazine/06tmag-oc-mts/06tmag-oc-mts-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/06/t-magazine/06tmag-oc-mts/06tmag-oc-mts-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Make T Something | Carol Lim & Humberto Leon', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Handicrafts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Leon, Humberto', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lim, Carol', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-11-08T17:19:27+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By United Labor', 'person': [{'firstname': 'United', 'middlename': None, 'lastname': 'Labor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/979cf408-9f90-573f-aa17-bc449239d956', 'word_count': 0, 'uri': 'nyt://video/979cf408-9f90-573f-aa17-bc449239d956'}, {'abstract': 'Carol Lim and Humberto Leon are the latest subjects to take the “Make T Something “ challenge.', 'web_url': 'https://www.nytimes.com/2019/11/08/t-magazine/opening-ceremony-hats.html', 'snippet': 'Carol Lim and Humberto Leon are the latest subjects to take the “Make T Something “ challenge.', 'lead_paragraph': 'Carol Lim and Humberto Leon founded Opening Ceremony, their concept boutique in New York’s SoHo, in 2002, with a simple but novel idea: They would source under-the-radar design from their travels around the world and bring it together under one roof. Over the years, Opening Ceremony has featured unsung talents from countries such as Russia, Argentina, Korea and China, and earned a reputation for its colorful, off-kilter aesthetic and D.I.Y. approach to style (Leon’s mother once sewed sweatshirts for the store’s own clothing line). In recent seasons, Lim and Leon have also ramped up their political messaging and activism, presenting in-house collections that have tackled pressing issues, albeit through playful high-spectacle presentations. The brand’s spring 2019 collection, for example, was a celebration of the gay and trans communities and proceeds from a raffle at the show went to the Transgender Law Center. “Representation is a pillar of how we work,” says Leon.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/06/t-magazine/06tmag-oc-mts-02/06tmag-oc-mts-02-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/06/t-magazine/06tmag-oc-mts-02/06tmag-oc-mts-02-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/06/t-magazine/06tmag-oc-mts-02/06tmag-oc-mts-02-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/06/t-magazine/06tmag-oc-mts-02/06tmag-oc-mts-02-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/06/t-magazine/06tmag-oc-mts-02