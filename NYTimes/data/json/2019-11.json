b74-5c687017d1ec', 'word_count': 2166, 'uri': 'nyt://article/9072499c-59b3-5d39-bb74-5c687017d1ec'}, {'abstract': 'The desire for politics to entertain was one of the things that gave us President Trump.', 'web_url': 'https://www.nytimes.com/2019/11/15/opinion/impeachment-boring.html', 'snippet': 'The desire for politics to entertain was one of the things that gave us President Trump.', 'lead_paragraph': 'By now, we have a good sense of the playbook Republicans follow when hit with revelations of new Trump administration misdeeds. First comes the heated denial: That never happened. Then, the qualifications: O.K., maybe something happened, but not the way the media says! Finally, the shifted goal post: O.K., it happened exactly the way the media says, but really, is that so bad?', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/15/opinion/15weiner/merlin_164345523_d96b3da4-6e49-4264-8fdc-152fec2698f5-articleLarge.jpg', 'height': 357, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/15/opinion/15weiner/merlin_164345523_d96b3da4-6e49-4264-8fdc-152fec2698f5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 357}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/15/opinion/15weiner/merlin_164345523_d96b3da4-6e49-4264-8fdc-152fec2698f5-jumbo.jpg', 'height': 610, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/15/opinion/15weiner/merlin_164345523_d96b3da4-6e49-4264-8fdc-152fec2698f5-superJumbo.jpg', 'height': 1220, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url':