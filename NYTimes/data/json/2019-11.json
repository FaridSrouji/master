7/travel/17luxury-for-less/17luxury-for-less-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/17/travel/17luxury-for-less/17luxury-for-less-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/travel/17luxury-for-less/17luxury-for-less-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/travel/17luxury-for-less/17luxury-for-less-superJumbo.jpg', 'height': 1290, 'width': 1950, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/travel/17luxury-for-less/17luxury-for-less-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/17/travel/17luxury-for-less/17luxury-for-less-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/17/travel/17luxury-for-less/17luxury-for-less-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Luxury for Less: The Travel Advisor Gambit', 'kicker': None, 'content_kicker': None, 'print_headline': 'How About a Room Upgrade, and a Cocktail?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Luxury Goods and Services', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Travel Agencies and Agents', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hotels and