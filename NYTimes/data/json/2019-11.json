': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-crown-image-02/10mag-crown-image-02-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/10/magazine/10mag-crown-image-02/10mag-crown-image-02-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-crown-image-02/10mag-crown-image-02-jumbo.jpg', 'height': 1024, 'width': 820, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-crown-image-02/10mag-crown-image-02-superJumbo.jpg', 'height': 2048, 'width': 1639, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-crown-image-02/10mag-crown-image-02-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/10/magazine/10mag-crown-image-02/10mag-crown-image-02-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-crown-image-02/10mag-crown-image-02-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How the Man Behind ‘The Crown’ Made the Monarchy Relevant Again', 'kicker': 'Feature', 'content_kicker': None, 'print_headline': 'The Royal We', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Royal Families', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Labour Party (Great Britain)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Anne, Queen of Great Britain (1665-1714)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Blair, Tony', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Elizabeth II, Queen of Great Britain', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Morgan, Peter (1963- )', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-11-06T10:00:02+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Giles Harvey', 'person': [{'firstname': 'Giles', 'middlename': None, 'lastname': 'Harvey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1e570df-939b-50bd-bfe7-7e43de86680c', 'word_count': 5411, 'uri': 'nyt://article/f1e570df-939b-50bd-bfe7-7e43de86680c'}, {'abstract': 'Toni Tipton-Martin’s recipes celebrate African-American cooking. This one is astonishingly good.', 'web_url': 'https://www.nytimes.com/2019/11/06/magazine/toni-tipton-martin-jubilee-cookbook.html', 'snippet': 'Toni Tipton-Martin’s recipes celebrate African-American cooking. This one is astonishingly good.', 'lead_paragraph': 'There are precious few feelings as nice as the one that comes from falling in love with a cookbook — with its aesthetics and point of view, with its larder and stories, above all with the flavors the recipes produce. There you were, making the sort of food you’ve been making forever, cooking the beans the way you do, the muffins, the fish, the lamb. Everything is fine, maybe even delicious. Life is good. But then, suddenly, it’s better: new techniques, new flavors, new narratives — everything so thrilling you want to make the recipes over and over again, until they are a little bit yours, until the food they produce is something you share with the author like a secret, like a fact.', 'print_section': 'MM', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-eat/10mag-eat-articleLarge.jpg', 'height': 445, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/10/magazine/10mag-eat/10mag-eat-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 445}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-eat/10mag-eat-jumbo.jpg', 'height': 760, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-eat/10mag-eat-superJumbo.jpg', 'height': 1520, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-eat/10mag-eat-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/10/magazine/10mag-eat/10mag-eat-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/10/magazine/10mag-eat/10mag-eat-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Pork Chops You’ll Make Again and Again', 'kicker': 'Eat ', 'content_kicker': None, 'print_headline': 'The Pork Chops You’ll Make Again and Again', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value