 'middlename': None, 'lastname': 'Muhlke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f330fcad-5675-566a-a635-4ee8abdee236', 'word_count': 1903, 'uri': 'nyt://article/f330fcad-5675-566a-a635-4ee8abdee236'}, {'abstract': 'An advocacy group says it has documented systematic sexual abuse  by teachers, principals and other authorities of dozens of boys in one rural area.', 'web_url': 'https://www.nytimes.com/2019/11/25/world/asia/afghan-schools-rape.html', 'snippet': 'An advocacy group says it has documented systematic sexual abuse  by teachers, principals and other authorities of dozens of boys in one rural area.', 'lead_paragraph': 'KABUL, Afghanistan — The 14-year-old Afghan boy said his teacher had asked him for “a little favor” in return for not failing him on his final exams. Then the man took him to the school library, locked the door and raped him, the boy said. ', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/25/world/00afghan-rapes1/merlin_148296984_1d2a3f10-a455-43fa-8dd9-032e51d05427-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/25/world/00afghan-rapes1/merlin_148296984_1d2a3f10-a455-43fa-8dd9-032e51d05427-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/25/world/00afghan-rapes1/merlin_148296984_1d2a3f10-a455-43fa-8dd9-032e51d05427-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/25/world/00afghan-rapes1/merlin_148296984_1d2a3f10-a455-43f