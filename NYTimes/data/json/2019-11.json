/article/29ac372f-aed3-578a-bf52-e09291c485ea'}, {'abstract': 'Tune in to "The Weekly" on these international channels.\xa0', 'web_url': 'https://www.nytimes.com/2019/11/17/the-weekly/the-weekly-outside-the-us.html', 'snippet': 'Tune in to "The Weekly" on these international channels.\xa0', 'lead_paragraph': 'Since the TV premiere of “The Weekly,” we’ve introduced you to college-bound Louisiana students betrayed by their high school principal, a U.S. Marine fighting to take back his online identity from internet scammers and the youngest known child to be separated from his family at the U.S.-Mexico border by the Trump administration.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Here’s How You Can Watch The Times’s New TV Show Outside the U.S.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'The Weekly (TV Program)', 'rank': 1, 'major': 'N'}], 'pub_date': '2019-11-17T20:00:25+0000', 'document_type': 'article', 'news_desk': 'Universal', 'section_name': 'The Weekly', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/798a7638-8e49-5dd2-9f92-abc523d8fb4c', 'word_count': 163, 'uri': 'nyt://article/798a7638-8e49-5dd2-9f92-abc523d8fb4c'}, {'abstract': 'Called “the woman who began the rebellion of Ethiopian women,” she helped thwart a barbaric practice that she had suffered and that had cost her sister’s life.', 'web_url': 'https://www.nytimes.com/2019/11/17/obituaries/bogaletch-gebre-dies.html', 'snippet': 'Called “the woman who began the rebellion of Ethiopian women,” she helped thwart a barbaric practice that she had suffered and that had cost her sister’s life.', 'lead_paragraph': 'Bogaletch Gebre, an Ethiopian women’s rights activist and scientist who helped lead a successful campaign in her homeland against female genital mutilation, a barbaric practice she herself had endured growing up there, died on Nov. 2 in Los Angeles. Her birth date is not known, but she was said to be 66.', 'print_section': 'D', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/18/obituaries/15Gebre1/15Gebre1-articleLarge.jpg', 'height': 902, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/11/18/obituaries/15Gebre1/15Gebre1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 902}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/18/obituaries/15Gebre1/15Gebre1-jumbo.jpg', 'height': 1024, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/18/obituaries/15Gebre1/15Gebre1-superJumbo.jpg', 'height': 2048, 'width': 1363, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/18/obituaries/15Gebre1/15Gebre1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/11/18/obituaries/15Gebre1/15Gebre1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/18/obituaries/15Gebre1/15Gebre1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bogaletch Gebre, Foe of Female Genital Mutilation, Dies at 66', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bogaletch Gebre, 66,  Who Fought Mutilation Of Female Genitals, Dies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Geb