y (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immunity from Prosecution', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Constitution (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Impeachment', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Office of Legal Counsel (US)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Bill', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Kavanaugh, Brett M', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Nixon, Richard Milhous', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 12, 'major': 'N'}], 'pub_date': '2019-11-15T18:00:41+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Corey Brettschneider', 'person': [{'firstname': 'Corey', 'middlename': None, 'lastname': 'Brettschneider', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/dc2f0c76-27c4-539e-829a-c60388c70a01', 'word_count': 1030, 'uri': 'nyt://article/dc2f0c76-27c4-539e-829a-c60388c70a01'}, {'abstract': 'Tom Hanks. An Alison Roman Thanksgiving. A review of the third season of “The Crown.” Trump, Ukraine and impeachment. The SoftBank effect. And more.', 'web_url': 'https://www.nytimes.com/2019/11/15/briefing/11-of-our-best-weekend-reads.html', 'snippet': 'Tom Hanks. An Alison Roman Thanksgiving. A review of the third season of “The Crown.” Trump, Ukraine and impeachment. The SoftBank effect. And more.', 'lead_paragraph': 'Welcome to the weekend. After a week of history-making impeachment inquiry news, you might want to take a break. Maybe you