nk': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4045dc2a-d6f3-561d-9bca-3f56749f29e9', 'word_count': 799, 'uri': 'nyt://article/4045dc2a-d6f3-561d-9bca-3f56749f29e9'}, {'abstract': 'After the Yankees were outscored by Toronto, 23-8, in two games, Manager Joe Girardi all but accused the Blue Jays of using off-the-field means to steal signs.', 'web_url': 'https://bats.blogs.nytimes.com/2011/07/16/girardi-shows-signs-of-frustration/', 'snippet': 'After the Yankees were outscored by Toronto, 23-8, in two games, Manager Joe Girardi all but accused the Blue Jays of using off-the-field means to steal signs.', 'lead_paragraph': 'TORONTO — Manager Joe Girardi’s frustration with his team’s poor play in the first two games here seemed to boil over Saturday morning when he all but accused the Blue Jays of using off-the-field means to steal the Yankees’ signs. The day after applauding their resourcefulness in divining Russell Martin’s signals from second base, Girardi turned testy when asked why he told Martin on Friday night to use complicated signs even with no one on base.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Girardi Shows Signs of Frustration', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Girardi, Joe', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Toronto Blue Jays', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Toronto (Ontario)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-16T18:07:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organizati