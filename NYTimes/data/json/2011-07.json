s', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-26T14:34:17+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jennifer Medina', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Medina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c8f00b42-3580-5e8b-a68c-ea5d3e3cd4c6', 'word_count': 942, 'uri': 'nyt://article/c8f00b42-3580-5e8b-a68c-ea5d3e3cd4c6'}, {'abstract': 'The public appears to be responding to President Obama’s request that they call Congress about the debt ceiling impasse.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/07/26/phones-on-the-hill-ringing-off-the-hook/', 'snippet': 'The public appears to be responding to President Obama’s request that they call Congress about the debt ceiling impasse.', 'lead_paragraph': 'It’s not clear what they’re saying once they get on the line, but it seems clear many Americans are taking President Obama’s advice and calling their House representative to weigh in on the debt ceiling impasses.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Phones on the Hill Ringing Off the Hook', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'National Debt (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-26T14:38:38+0000', 'documen