ritish-open-rain-wind-snarls-third-round.html', 'snippet': 'Darren Clarke took a one-shot lead over Dustin Johnson into Sunday’s final round at the British Open.', 'lead_paragraph': 'SANDWICH, England — A Saturday that began with heavy rain, high winds and high scores at the British Open ended with clear skies, low scores and very high hopes for a clear-cut leader and a group of fast followers who all have something to prove.', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/sports/YJPOPEN/YJPOPEN-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/17/sports/YJPOPEN/YJPOPEN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/sports/YJPOPEN/YJPOPEN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/sports/YJPOPEN/YJPOPEN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/17/sports/YJPOPEN/YJPOPEN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Clarke Leads a Blustery Third Round', 'kicker': 'British Open | Royal St. Georges', 'content_kicker': None, 'print_headline': 'In Challenging Conditions, Bright Day for Clarke', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'British Open (Golf)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clarke, Darren', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bjorn, Thomas', 'rank': 4,