dia and Entertainment)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Youth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computer and Video Games', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-02T21:31:42+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Joel Bakan', 'person': [{'firstname': 'Joel', 'middlename': None, 'lastname': 'Bakan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/dcbe6e00-91ac-51da-bb3a-0d526934866e', 'word_count': 356, 'uri': 'nyt://article/dcbe6e00-91ac-51da-bb3a-0d526934866e'}, {'abstract': 'Test your knowledge of recent events.', 'web_url': 'https://www.nytimes.com/2011/07/03/opinion/sunday/03wait.html', 'snippet': 'Test your knowledge of recent events.', 'lead_paragraph': 'NPR’s “Wait Wait ... Don’t Tell Me!” is heard weekends on public radio stations across the country. (npr.org/programs/wait-wait-dont-tell-me/)', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/sunday-review/26QUIZ/26QUIZ-articleLarge.jpg', 'height': 348, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/26/sunday-review/26QUIZ/26QUIZ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 348}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/sunday-review/26QUIZ/26QUIZ-jumbo.jpg', 'height': 594, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'cr