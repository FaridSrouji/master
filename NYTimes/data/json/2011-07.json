mages/2011/07/10/sports/mets-1310268841303/mets-1310268841303-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/10/sports/mets-1310268841303/mets-1310268841303-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'No Replay for Hairston as the Mets Fall to the Giants', 'kicker': 'Giants 3, Mets 1', 'content_kicker': None, 'print_headline': 'No Replay for Hairston as the Mets Fall to the Giants', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'San Francisco Giants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hairston, Scott', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lincecum, Tim', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-10T04:38:39+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/91d78c49-47fd-584f-b8d0-4d4c9c3aba00', 'word_count': 741, 'uri': 'nyt://article/91d78c49-47fd-584f-b8d0-4d4c9c3aba00'}, {'abstract': 'Argentina and Brazil, the favorites to win the Copa América, have yet to win a game in the tournament.', 'web_url': 'https://goal.blogs.nytimes.com/2011/07/10/is-it-panic-time-for-the-copa-america-favorites/', 'snippet': 'Argentina and Brazil, the favorites to win the Copa América, have yet to win a game in the tournament.', 'lead_paragraph': 'The 12 teams in the Copa América have all played two of their three first-round games. Costa Rica, Venezuela and Peru all have wins under their belts. Argentina, Brazil and Uruguay do not.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is It Panic Time for the Copa América Favorites?', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-10T07:40:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Andrew Das', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Das', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/94607278-d9a4-5a13-90d0-01bc022f4c72', 'word_count': 634, 'uri': 'nyt://article/94607278-d9a4-5a13-90d0-01bc022f4c72'}, {'abstract': 'The United States’ top military officer met with Chinese officials in Beijing, the first such trip in more than four years.', 'web_url': 'https://www.nytimes.com/2011/07/11/world/asia/11china.html', 'snippet': 'The United States’ top military officer met with Chinese officials in Beijing, the first such trip in more than four years.', 'lead_paragraph': 'BEIJING — The United States’ top military officer met with Chinese officials in Beijing on Sunday, in the first such trip in more than four years and a sign of revival in what has for years been a stagnant military relationship between the two powers. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/11/world/CHINA/CHINA-jumbo.jpg', 'height': 956, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/11/world/CHINA/CHINA-thumbStandard.jpg', 'height': 7