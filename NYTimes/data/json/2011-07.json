umbnailheight': 75}}], 'headline': {'main': 'Is It Summer? Time to Party at the Museum', 'kicker': 'Neighborhood Joint', 'content_kicker': None, 'print_headline': 'Is It Summer? Time to Party At the Museum', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Long Island City (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'PS 1 Contemporary Art Center', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-07T20:40:10+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Hugh Ryan', 'person': [{'firstname': 'Hugh', 'middlename': None, 'lastname': 'Ryan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f4cfa15-b1d8-5c99-aa37-293fd31a4074', 'word_count': 557, 'uri': 'nyt://article/7f4cfa15-b1d8-5c99-aa37-293fd31a4074'}, {'abstract': 'Video posted online by activists appears to offer glimpses of the ongoing security crackdown in the Syrian cities of Hama and Homs.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/07/07/on-youtube-glimpses-of-syrian-crackdown/', 'snippet': 'Video posted online by activists appears to offer glimpses of the ongoing security crackdown in the Syrian cities of Hama and Homs.', 'lead_paragraph': 'Citing the account of an unnamed activist in the Syrian city of Hama, The Associated Press reports that protesters “hurled stones and set roadblocks of burning tires” to block government forces as they tried to regain control of the opposition stronghold on Thursday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On YouTube, Glimpses of Syrian Crackdown', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Middle East and North Africa Unrest (2