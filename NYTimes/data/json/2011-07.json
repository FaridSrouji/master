n', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Copyrights and Copyright Violations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gordon, Janine', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McGinley, Ryan', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Artnet', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-07-13T17:34:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1adc854-19e5-5e5d-84bf-fad412812fa1', 'word_count': 292, 'uri': 'nyt://article/c1adc854-19e5-5e5d-84bf-fad412812fa1'}, {'abstract': 'A three-bedroom modern house set on nearly 1,000 acres between snow-capped peaks and the misty waters of a nearby fjord.', 'web_url': 'https://www.nytimes.com/interactive/2011/07/14/greathomesanddestinations/20110714-iceland-slideshow.html', 'snippet': 'A three-bedroom modern house set on nearly 1,000 acres between snow-capped peaks and the misty waters of a nearby fjord.', 'lead_paragraph': 'A three-bedroom modern house set on nearly 1,000 acres between snow-capped peaks and the misty waters of a nearby fjord.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Location | An Icelandic Home Near the Arctic Circle', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Housing and Real Es