 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Centrist Cop-Out', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'The Centrist Cop-Out', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Republican Party', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'National Debt (US)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-07-29T01:24:25+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/753959a0-86c4-5413-ac62-8cdf442c686d', 'word_count': 804, 'uri': 'nyt://article/753959a0-86c4-5413-ac62-8cdf442c686d'}, {'abstract': '“Where the Road Meets the Sun” follows four men whose lives intersect at a residential hotel.', 'web_url': 'https://www.nytimes.com/2011/07/29/movies/where-the-road-meets-the-sun-review.html', 'snippet': '“Where the Road Meets the Sun” follows four men whose lives intersect at a residential hotel.', 'lead_paragraph': 'The multistory movie — weaving together episodes of several unrelated characters as their paths cross — has held a place of honor in Hollywood since “Grand Hotel.” In recent years a Los-Angeles-specific subgenre has grown like Topsy, from the entrancing “Short Cuts” to the less fabulous “Crash” to any number of weaker efforts: These days every film student in Southern California must be assembling a thesis project with a lineup of locals intended to reveal the Connectedness of Us All.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paths That Cross in Los Angeles', 'kicker': None, 'content_kicker': None, 'print_headline': "Movie Review | 'Where the Road Meets the Sun'", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-29T01:27:37+0000', 'document_type': 'article', 'news_desk': 'W