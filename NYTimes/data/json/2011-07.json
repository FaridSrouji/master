imes.com/2011/07/05/business/economy/05warren.html', 'snippet': 'Opposition to naming Elizabeth Warren as chief of the new Consumer Financial Protection Bureau has been blunted by concerns that President Obama has yet to name anyone for the post.', 'lead_paragraph': 'WASHINGTON — It is conventional wisdom in this town that the first director of the new Consumer Financial Protection Bureau will be anyone but Elizabeth Warren.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/business/WARREN/WARREN-jumbo.jpg', 'height': 664, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/business/WARREN/WARREN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/05/business/WARREN/WARREN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'An Agency Builder, but Not Yet Its Leader', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Agency Builder, But Not Yet Its Leader', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Consumer Financial Protection Bureau', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-05T00:53:41+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Edward Wyatt', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wyatt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3b9cfec0-e91c-5ba3-b354-2d363f40837f', 'word_count': 1212, 'uri': 'nyt://article/3b9cfec0-e91c-5ba3-b354-2d363f40837f'}, {'abstract': 'A search of vaults at the Sri Padmanabhaswamy temple found a vast collection of gold coins, jewels and precious stones worth an estimated $22 billion.', 'web_url': 'https://www.nytimes.com/2011/07/05/world/asia/05india.html', 'snippet': 'A search of vaults at the Sri Padmanabhaswamy temple found a vast collection of gold coins, jewels and precious stones worth an estimated $22 billion.', 'lead_paragraph': 'MUMBAI, India — A court-ordered search of vaults beneath a south Indian temple has unearthed gold, jewels and statues worth an estimated $22 billion, government officials said Monday.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/world/INDIA/INDIA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/world/INDIA/INDIA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/05/world/INDIA/INDIA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Beneath a Temple in Southern India, a Treasure Trove of Staggering Riches', 'kicker': None, 'content_kicker': None, 'print_headline': 'Beneath a Temple in Southern India, a Treasure Trove of Staggering Riches', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jewels and Jewelry', 'rank': 2, 'major': 'N'}, {'name': 'glocations'