 Internet anytime soon.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/29/arts/29WEIWEI/29WEIWEI-articleLarge.jpg', 'height': 189, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/29/arts/29WEIWEI/29WEIWEI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 189}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/29/arts/29WEIWEI/29WEIWEI-jumbo-v2.jpg', 'height': 375, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/29/arts/29WEIWEI/29WEIWEI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/29/arts/29WEIWEI/29WEIWEI-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Beijing Bohemian in the East Village', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'A Beijing Bohemian in the East Village', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ai Weiwei', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'East Village (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-28T23:14:46+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': '