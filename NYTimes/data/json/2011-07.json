ent_kicker': None, 'print_headline': 'Is That All There Is? Milking Life for More', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'July, Miranda', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Linklater, Hamish', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-28T22:44:48+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/063f4614-2483-5c41-8523-ee339eb1a2e8', 'word_count': 1049, 'uri': 'nyt://article/063f4614-2483-5c41-8523-ee339eb1a2e8'}, {'abstract': '“The Yellow Brick Road,” a Latino-flavored riff on the L. Frank Baum classic, is carried by salsa and merengue.', 'web_url': 'https://www.nytimes.com/2011/07/29/theater/reviews/the-yellow-brick-road-at-lucille-lortel-review.html', 'snippet': '“The Yellow Brick Road,” a Latino-flavored riff on the L. Frank Baum classic, is carried by salsa and merengue.', 'lead_paragraph': 'This isn’t your grandparents’ “Wizard of Oz.” Or your parents’ “Wiz.” Or your older sister’s “Wicked.”', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/29/arts/29YELLOW_SPAN/29YELLOW_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/29/arts/29YELLOW_SPAN/29YELLOW_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/29/arts/29YELLOW_SPAN/Yellow-jumbo.jpg', 'height': 819, 'width': 1024, 