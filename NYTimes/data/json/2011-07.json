en', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6151a970-b28b-5855-82b3-d7568d07cdb5', 'word_count': 129, 'uri': 'nyt://article/6151a970-b28b-5855-82b3-d7568d07cdb5'}, {'abstract': 'The credit agency said it expected private bond holders would have to take losses on Greek debt as part of the bailout package agreed to last week.', 'web_url': 'https://www.nytimes.com/2011/07/26/business/global/european-sovereign-debt-crisis.html', 'snippet': 'The credit agency said it expected private bond holders would have to take losses on Greek debt as part of the bailout package agreed to last week.', 'lead_paragraph': 'Moody’s Investors Service cut Greece’s credit rating Monday after concluding that the euro zone bailout plan announced last week would require private sector holders of Greek debt to take credit losses. ', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/26/business/global/26euro-span/26euro-span-jumbo.jpg', 'height': 673, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/26/business/global/26euro-span/26euro-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/26/business/global/26euro-span/26euro-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Moody’s Again Reduces Greece’s Credit Rating', 'kicker': None, 'content_kicker': None, 'print_headline': 'Moody’s Again Reduces Greece’s Credit Rating', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 1, 'major': 'N'