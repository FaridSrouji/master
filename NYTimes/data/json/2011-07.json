ectations', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'General Electric Company', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Company Reports', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-22T12:26:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Steve Lohr', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Lohr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76c689e4-e41e-56d2-aae7-36f3e3977291', 'word_count': 917, 'uri': 'nyt://article/76c689e4-e41e-56d2-aae7-36f3e3977291'}, {'abstract': 'Customers should not see any major effect from the voltage reduction, though, utility officials said.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/22/con-ed-trims-power-to-parts-of-queens-and-westchester/', 'snippet': 'Customers should not see any major effect from the voltage reduction, though, utility officials said.', 'lead_paragraph': 'Consolidated Edison has reduced power to parts of Queens and Westchester County because of electrical problems, but customers should not see any major effect, though they are being urged not to use their air-conditioners as the region girds for the possibility of record-breaking triple-digit temperatures and power demand.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Con Ed Trims Power in Queens and Westchester', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blackouts and Brownouts (Electrical)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electric Light and Power', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Weather', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Consolidated Edison Inc', 'rank': 4