9/sports/YSANDOMIR/YSANDOMIR-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/19/sports/YSANDOMIR/YSANDOMIR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/19/sports/YSANDOMIR/YSANDOMIR-jumbo.jpg', 'height': 642, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/19/sports/YSANDOMIR/YSANDOMIR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/19/sports/YSANDOMIR/YSANDOMIR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Fairer Broadcast for Title Game', 'kicker': 'Tv Sports', 'content_kicker': None, 'print_headline': 'Fairer Broadcast For Women’s Title Game', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'ESPN', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': "Women's World Cup (Soccer)", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Foudy, Julie', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-19T00:34:41+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4503b501-1540-595a-926c-1cece0b2775e', 'word_count': 722, 'uri': 'nyt://article/4503b501-1540-595a-926c-1cece0b2775e'}, {'