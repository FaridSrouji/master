, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-30T01:17:41+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/ed0582c3-f4d5-59d4-afc6-167424fbc33c', 'word_count': 381, 'uri': 'nyt://article/ed0582c3-f4d5-59d4-afc6-167424fbc33c'}, {'abstract': 'Paying state judges at the level of federal judges would be a sound investment in the justice system.', 'web_url': 'https://www.nytimes.com/2011/07/30/opinion/new-york-judges-deserve-a-raise.html', 'snippet': 'Paying state judges at the level of federal judges would be a sound investment in the justice system.', 'lead_paragraph': 'New York State’s 1,300 judges have not had a raise or even a cost-of-living adjustment for a dozen years. Their salaries now lag behind the pay of federal judges, senior assistant district attorneys and Legal Aid lawyers in New York City. In many instances, judges even earn less than their own law clerks whose salaries are set by union collective bargaining. Judges on the State Supreme Court, New York’s main trial court, earn $136,700 — $37,300 less than comparable federal judges.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York Judges Deserve a Raise', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'New York Judges Deserve a Raise', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Judges', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-30T01:22:32+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_