rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/de2bb07e-9e6b-501e-a211-5b3133f869b4', 'word_count': 0, 'uri': 'nyt://video/de2bb07e-9e6b-501e-a211-5b3133f869b4'}, {'abstract': 'A sign of the times from Michael Black.', 'web_url': 'https://wordplay.blogs.nytimes.com/2011/07/25/cant-miss/', 'snippet': 'A sign of the times from Michael Black.', 'lead_paragraph': 'Administrivial Lollapuzzoola-Flogging Alert! This just in from the “Be More Smarter” team: If you cannot make it in person to the insanely fun day that is Lollapuzzoola 4 on August 6 — and I highly recommend it, it’s a blast — hosts Brian Cimmet and Patrick Blindauer are offering the “staycation” play-at-home version for a mere $10. It’s not quite like watching Brian try to find the source of the irritating chirping noise in the room in person, but it’s the next best thing. The puzzle suite will be available to non-attendees during the week of August 7-14 ONLY. After August 14, the puzzles go back into the Lollapuzzoola vault (i.e., the constructors’ personal files), and they will not sell another copy, so hurry and place your order now!', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tuesday: Can’t-Miss Event', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-26T02:00:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/026198a9-cab4-5580-96bc-3e74701b5919', 'word_count': 362, 'uri': 'nyt://article/026198a9-cab4-5580-96bc-3e74701b5919'}, {'abstract': 'An Istanbul court sentenced a man to almost 23 years in jail on Monday for the killing of an ethnic Armenian journalist who criticized nationalist tendencies in Turkey.', 'web_url': 'https://www.nytimes.com/2011/07/26/world/europe/26briefs-Turkey.html', 'snippet': 'An Istanbul court sentenced a man to almost 23 years in jail on Monday for the killing of an ethnic Armenian journalist who criticized nationalist tendencies in Turkey.', 'lead_paragraph': ' An Istanbul court sentenced a man to almost 23 years in jail on Monday for the killing of an ethnic Armenian journalist who criticized nationalist tendencies in Turkey. The man, Ogun Samast, an ultranationalist, shot the journalist, Hrant Dink, in January 2007. The death of Mr. Dink, the editor of the only Turkish-Armenian bilingual newspaper in Turkey, led to public discussions about the way Armenians are treated. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Turkey: Sentence in Editor’s Death', 'kicker': 'World Briefing | EUROPE', 'content_kicker': None, 'print_headline': 'Turkey: Sentence in Editor’s Death', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Samast, Ogun', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dink, Hrant', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'ARMENIA', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Armenians', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-07-26T02:06:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Sebnem Arsu', 'person': [{'firstname': 'Sebnem', 'middlename': None, 'lastname': 'Arsu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_materi