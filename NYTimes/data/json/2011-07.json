t Rooftop Farm. ', 'print_section': 'E', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/07/fashion/Z-BOITE-span/Z-BOITE-1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/07/fashion/Z-BOITE-span/Z-BOITE-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/07/fashion/Z-BOITE-span/Z-BOITE-1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/07/fashion/Z-BOITE-span/Z-BOITE-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/07/fashion/Z-BOITE-span/Z-BOITE-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Spritzenhaus', 'kicker': 'Boîte', 'content_kicker': None, 'print_headline': 'Spritzenhaus: Greenpoint, Brooklyn', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Greenpoint (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Beer', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-06T19:08:55+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Jed Lipinski', 'person': [{'firstname': 'Jed', 'middlename': None, 'lastname': 'Lipinski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e0c51e65-b6d4-514a-a4d1-5b9b06b0d64d', 'word_count': 368, 'uri': 'nyt://article/e0c51e65-b