alue': 'News of the World', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Scotland Yard (Metropolitan Police Service)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 10, 'major': 'N'}], 'pub_date': '2011-07-17T20:17:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0fe0a18e-ffd1-5e20-92d8-a62c7457a282', 'word_count': 1497, 'uri': 'nyt://article/0fe0a18e-ffd1-5e20-92d8-a62c7457a282'}, {'abstract': 'Stanley Patz suggests that all children should be given simple emergency cellphones.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/17/after-brooklyn-boys-murder-father-of-etan-patz-has-a-suggestion/', 'snippet': 'Stanley Patz suggests that all children should be given simple emergency cellphones.', 'lead_paragraph': 'Stanley Patz has been conditioned to expect his telephone to ring whenever a child goes missing, so he was bracing when he heard about the disappearance of an 8-year-old boy, Leiby Kletzky, last week in Brooklyn.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Brooklyn Boy’s Murder, Father of Etan Patz Has a Suggestion', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-17T20:22:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Patrick McGeehan', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'McGeehan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee4347fa-a853-5639-bf6b-9fdfcd07bb9b', 'word_count': 371, 'uri': 'nyt://article/ee4347fa-a853-5639-bf6b-9fdfcd07bb9b'}, {'abstract': 'Phil Hughes was sharp in his second start since coming off the disabled list, which likely filled the Yankees with confidence and relief.', 'web_url': 'https://www.nytimes.com/2011/07/18/sports/baseball/phil-hughes-pitches-like-old-self-in-yankees-win-over-jays.html', 'snippet': 'Phil Hughes was sharp in his second start since coming off the disabled list, which likely filled the Yankees with confidence and relief.', 'lead_paragraph': 'TORONTO — A man wearing a gray uniform with “New York” on the front and No. 65 on the back stood atop the Rogers Centre mound Sunday. He looked like Phil Hughes, but it had been so long since the Yankees saw him fire fastballs and curveballs with precision against major league hitters that it seemed possible an impostor had replaced him.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/sports/baseball/18yankees-pic/18yankees-pic-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/18/sports/baseball/18yankees-pic/18yankees-pic-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/sports/baseball/18yankees-pic/18yankees-pic-jumbo.jpg', 'height': 699, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/sports/baseball/18yankees-pic/18yankees-pic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/18/sports/baseball/18yankees-pic/18yankees-pic-thumbStandard.jpg', 'thumbnail