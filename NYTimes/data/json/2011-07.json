None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31c2d17c-cd27-5558-9aaa-bd66cfa35439', 'word_count': 603, 'uri': 'nyt://article/31c2d17c-cd27-5558-9aaa-bd66cfa35439'}, {'abstract': 'Political news from today’s Times and around the Web, plus a look at what’s happening in Washington.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/07/13/the-early-word-pessimism/', 'snippet': 'Political news from today’s Times and around the Web, plus a look at what’s happening in Washington.', 'lead_paragraph': 'Today’s Times', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Early Word: Pessimism', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-13T10:30:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jada F. Smith', 'person': [{'firstname': 'Jada', 'middlename': 'F.', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/590d42ad-f145-5701-8370-5f103b1216c5', 'word_count': 440, 'uri': 'nyt://article/590d42ad-f145-5701-8370-5f103b1216c5'}, {'abstract': "Royal St. George's, the first English golf course to award the British Open's Claret Jug, was designed by Scots with Scotland in mind.", 'web_url': 'https://www.nytimes.com/2011/07/14/sports/golf/14iht-SRBOCOURSE14.html', 'snippet': "Royal St. George's, the first English golf course to award the British Open's Claret Jug, was designed by Scots with Scotland in mind.", 'lead_paragraph': 'SANDWICH, ENGLAND — The first challenge is to procure the keys. The next is to fit through a doorway designed for the shorter men of the 12th century. All that remains is to climb a tight, winding stone staircase and then a wooden ladder that leads to a final door and, at last, like Dr. William Laidlaw Purves more than a century ago, you are atop the Norman bell tower at St. Clement’s Church, squinting in the direction of the beach in search of prime golfing land.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/14/sports/Y-BRITISH/Y-BRITISH-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/14/sports/Y-BRITISH/Y-BRITISH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/14/sports/Y-BRITISH/Y-BRITISH-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/14/sports/Y-BRITISH/Y-BRITISH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/14/sports/Y-BRITISH/Y-BRITISH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Bit of Scotland by the Sea in England', 'kicker': 'Special Report on the British Open', 'content_kicker': None, 'print_headline': 'A Touch of Scotland Along the Sea in England', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'British Open (Golf)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-13T10:54:10+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Christopher Clarey', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Clarey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Special Report', '_id': 'nyt://article/91faeb9f-6ff4-50a9-b5de-c42c2390f77d', 'word_count': 1305, 'uri': 'nyt://article/91faeb9f-6ff4-50a9-b5de-c42c2390f77d'}, {'abstract': 'On Wednesday, The Lede is following developments in the phone hacking scandal in Britain.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/07/13/latest-updates-on-british-phone-hacking-scandal-2/', 'snippet': 'On Wednesday, The Lede is following developments in the phone hacking scandal in Britain.', 'lead_paragraph': 'On Wednesday, The Lede is following developments in the phone-hacking scandal in Britain. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Updates on British Phone-Hacking Scandal', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Great Britain', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-13T10:59:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a27a9134-310b-5f71-a034-4dfb577427e8', 'word_count': 7148, 'uri': 'nyt://article/a27a9134-310b-5f71-a034-4dfb577427e8'}, {'abstract': 'Will the new health care law prompt employers to drop health coverage?', 'web_url': 'https://boss.blogs.nytimes.com/2011/07/13/doing-the-math-on-employer-health-insurance/', 'snippet': 'Will the new health care law prompt employers to drop health coverage?', 'lead_paragraph': 'Our post last month on the McKinsey & Company study that suggested — but absolutely did not predict — that up to 30 percent of employers would shed the health insurance plans they now provide workers in 2014, when the Patient Protection and Affordable Care Act largely takes effect, drew some readers into an interesting discussion. After one reader wondered what prevents those companies from dropping health insurance now, another, adam of Washington, wrote a thoughtful response that is worth reprinting at length. The premium calculator he describes was developed by the Kaiser Family Foundation and allows users to enter demographic data and generate an estimate for how much insurance will cost when purchased on the exchanges created by the health care overhaul. Here’s what adam wrote:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Doing the Math on Employer Health Insurance', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-13T11:00:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Robb Mandelbaum', 'person': [{'firstname': 'Robb', 'middlename': None, 'lastname': 'Mandelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/adce98e8-6ec4-5aab-8046-7052d27315c6', 'word_count': 1117, 'uri': 'nyt://article/adce98e8-6ec4-5aab-8046-7052d27315c6'}, {'abstract': 'The Climate Reality Project, a renamed and redefined group overseen by Mr. Gore, will seek to educate the public about the impacts of global warming and counter what he considers the well-financed disinformation and denial campaign run by the fossil fuel industries.', 'web_url': 'https://green.blogs.nytimes.com/2011/07/13/an-al-gore-reality-show/', 'snippet': 'The Climate Reality Project, a renamed and redefined group overseen by Mr. Gore, will seek to educate the public about the impacts of global warming and counter what he considers the well-financed disinformation and denial campaign run by the foss...', 'lead_paragraph': 'Al Gore, the former vice president, Nobel Prize winner and climate campaigner-in-chief, is opening a new global climate change activism program called the Climate Reality Project.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Al Gore’s Reality Show', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Global Warming', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gore, Al', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-13T11:22:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By John M. Broder', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/310f1d15-8c88-5b7b-a048-732159ef8b99', 'word_count': 301, 'uri': 'nyt://article/310f1d15-8c88-5b7b-a048-732159ef8b99'}, {'abstract': 'A private equity consortium led by Apax Partners will acquire the medical therapy company Kinetic Concepts in the largest buyout since the financial crisis.', 'web_url': 'https://dealbook.nytimes.com/2011/07/13/private-equity-group-to-buy-kinetic-concepts/', 'snippet': 'A private equity consortium led by Apax Partners will acquire the medical therapy company Kinetic Concepts in the largest buyout since the financial crisis.', 'lead_paragraph': '8:28 p.m. | Updated ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Apax Leads $6.3 Bill