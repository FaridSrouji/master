rgia.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Q&A With Jerry Glanville', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Glanville, Jerry', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'United Football League', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-30T16:45:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Lang Whitaker', 'person': [{'firstname': 'Lang', 'middlename': None, 'lastname': 'Whitaker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e24f051b-0569-5a63-bf05-f93a40700bff', 'word_count': 1200, 'uri': 'nyt://article/e24f051b-0569-5a63-bf05-f93a40700bff'}, {'abstract': '“The difference between a good team and a great team is usually mind-set,” says Peter Löscher, C.E.O. of Siemens.', 'web_url': 'https://www.nytimes.com/2011/07/31/business/siemens-ceo-on-building-trust-and-teamwork.html', 'snippet': '“The difference between a good team and a great team is usually mind-set,” says Peter Löscher, C.E.O. of Siemens.', 'lead_paragraph': 'This interview with  Peter Löscher, president and C.E.O. of Siemens A.G., was conducted and condensed by  Adam Bryant.', 'print_section': 'BU', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/31/business/31CORNER/31CORNER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/31/business/31CORNER/31CORNER-thumbStandard.jpg', 'thumbnai