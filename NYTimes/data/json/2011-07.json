rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/08/us/08TTBLACKSTONE/08TTBLACKSTONE-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/08/us/08TTBLACKSTONE/08TTBLACKSTONE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/08/us/08TTBLACKSTONE/08TTBLACKSTONE-jumbo.jpg', 'height': 696, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/08/us/08TTBLACKSTONE/08TTBLACKSTONE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/08/us/08TTBLACKSTONE/08TTBLACKSTONE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Jobless Youth Get Summer Lift at Bicycle Works', 'kicker': 'Chicago News Cooperative', 'content_kicker': None, 'print_headline': 'Jobless Youth Get Summer Lift at Bicycle Works', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bicycles and Bicycling', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-08T02:41:56+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Karen Ann Cullotta', 'person': [{'firstname': 'Karen', 'middlename': 'Ann', 'lastname': 'Cullotta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/430a418d-feed-55d2-9272-9135768a2b65', 'word_count': 530, 'uri': 'nyt://article/430a418d-feed-55d2-9272-9135768a2b65'}, {'abstract': '“Romeo & Juliet in Yiddish” relocates Shakespeare’s lovers to modern-day Brooklyn.', 'web_url': 'https://www.nytimes.com/2011/07/08/movies/romeo-juliet-in-yiddish-review.html', 'snippet': '“Romeo & Juliet in Yiddish” relocates Shakespeare’s lovers to modern-day Brooklyn.', 'lead_paragraph': '“Romeo & Juliet in Yiddish” tucks Shakespeare’s tale of greatest woe into a story of intra-Judaic culture clash in present-day Brooklyn. The film, written and directed by Eve Annenberg (who also stars) is sprawling and sometimes confusing, but its premise is charming and not at all far-fetched. Anyone who loves “West Side Story” knows that New York is full of warring tribes and clans to serve as Montagues and Capulets. And Shakespeare was a staple of Second Avenue back in the glory days of the Yiddish theater. So Ms. Annenberg, by all appearances an eager omnivore, has plenty to work with.', 'print_section': 'C', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/08/arts/08romeo-span/08romeo-span-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/08/arts/08romeo-span/08romeo-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/08/arts/08romeo-span/08romeo-span-jumbo.jpg', 'height': 667, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/08/arts/08romeo-span/08romeo-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/08/arts/08romeo-span/08romeo-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailhei