1/07/05/arts/eno/eno-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/05/arts/eno/eno-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Pushing Back the Limits of Speech and Music', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pushing Back the Limits Of Speech and Music', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'U2', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Coldplay', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Eno, Brian', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-04T20:27:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41af2ed0-6f92-55c1-8e4c-25e1f81f430d', 'word_count': 1097, 'uri': 'nyt://article/41af2ed0-6f92-55c1-8e4c-25e1f81f430d'}, {'abstract': 'The Cassatt Quartet and the pianist Ursula Oppens gave a passionate performance of Brahms’s Piano Quintet in F minor at Bargemusic on Sunday.', 'web_url': 'https://www.nytimes.com/2011/07/05/arts/music/cassatt-quartet-and-ursula-oppens-at-bargemusic-review.html', 'snippet': 'The Cassatt Quartet and the pianist Ursula Oppens gave a passionate performance of Brahms’s Piano Quintet in F minor at Bargemusic on Sunday.', 'lead_paragraph': 'The pianist Ursula Oppens built her reputation as a new-music specialist, both as a member of the adventurous ensemble Speculum Musicae in its early days and as a soloist who has championed composers as different as Tobias Picker, Frederic Rzewski and Elliott Carter. But Ms. Oppens has never abandoned the standard repertory: anyone who has followed her work over the years may remember her thoughtful account of Rachmaninoff’s Rhapsody on a Theme of Paganini with the New York Philharmonic in 1977 and will have heard her clean-textured, emotionally intense readings of the Beethoven sonatas more recently. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/arts/barge/barge-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/05/arts/barge/barge-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/arts/barge/barge-jumbo.jpg', 'height': 553, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/arts/barge/barge-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/05/arts/barge/barge-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sharp Interplay and Melting Lyricism', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Sharp Interplay and Melting Lyricism', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Bargemusic', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Cassatt String Quartet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-04T20:28:37+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/cd7ab271-8706-5c3a-80c7-71f3cd2c993c', 'word_count': 428, 'uri': 'nyt://article/cd7ab271-8706-5c3a-80c7-71f3cd2c993c'}, {'abstract': 'The Norwegian group Jaga Jazzist has evolved slowly for more than a decade, through lesser and greater engagements with electronics.', 'web_url': 'https://www.nytimes.com/2011/07/05/arts/music/jaga-jazzist-at-le-poisson-rouge.html', 'snippet': 'The Norwegian group Jaga Jazzist has evolved slowly for more than a decade, through lesser and greater engagements with electronics.', 'lead_paragraph': 'Jaga Jazzist, the Norwegian instrumental jazz-rock band currently touring as a nine-piece, is an off-brand, something to be settled for. Frank Zappa’s dead; Soft Machine is long gone; Tortoise, the Chicago band from which this one derives the deepest inspiration, tours infrequently. It’s got something that isn’t particularly common; it’ll do in a pinch.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/arts/jaga/jaga-jumbo.jpg', 'height': 552, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/arts/jaga/jaga-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/05/arts/jaga/jaga-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Little Bit Like a School Orchestra', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Little Bit Like a School Orchestra', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Le Poisson Rouge', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-04T20:29:33+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1b2f79df-1bfc-51dd-a5be-b08274509a36', 'word_count': 573, 'uri': 'nyt://article/1b2f79df-1bfc-51dd-a5be-b08274509a36'}, {'abstract': 'A set of light number problems highlighting some numerical coincidences related to America’s birthday.', 'web_url': 'https://wordplay.blogs.nytimes.com/2011/07/04/numberplay-happy-birthday-america/', 'snippet': 'A set of light number problems highlighting some numerical coincidences related to America’s birthday.', 'lead_paragraph': ' Our blog today falls on the Fourth of July, a day for celebration and fireworks. To match the summer mood, we have some light number fare, cooked up by my friend Aziz Inan, who is an absolute whiz when it comes to finding numerical coincidences related to dates. Dr. Inan, an electrical engineering professor at the University of Portland, has appeared in this column before with coincidences related to Palindrome Day, Chopin’s birthday, Dr. Martin Luther King Day and Bill Gates’s birthday. As usual he has a set of wonderful connections with today’s date.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Numberplay: Happy Birthday, America!', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Declaration of Independence (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Independence Day (US) (July 4)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-04T20:40:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Pradeep Mutalik with Aziz Inan', 'person': [{'firstname': 'Pradeep', 'middlename': None, 'lastname': 'Mutalik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Aziz', 'middlename': None, 'lastname': 'Inan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62370ffe-86f9-5830-81f1-bf3c06ad5858', 'word_count': 361, 'uri': 'nyt://article/62370ffe-86f9-5830-81f1-bf3c06ad5858'}, {'abstract': 'Two takes on Wagner’s “Ring,” one by Francesca Zambello in San Francisco and another by Robert Lepage at the Met, show the opportunities and pitfalls of operatic interpretation.', 'web_url': 'https://www.nytimes.com/2011/07/05/arts/music/wagners-ring-via-francesca-zambello-and-robert-lepage.html', 'snippet': 'Two takes on Wagner’s “Ring,” one by Francesca Zambello in San Francisco and another by Robert Lepage at the Met, show the opportunities and pitfalls of operatic interpretation.', 'lead_paragraph': 'Every production of an opera is a commentary on the work. But how and to what extent a director should make such commentary is the question.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/arts/ring/ring-articleLarge.jpg', 'height': 279, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/05/arts/ring/ring-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 279}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/05/arts/ring/ring-jumbo.jpg', 'height': 476, 'width': 1024, 'su