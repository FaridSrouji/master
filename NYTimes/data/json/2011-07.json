k': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson, Lisa P', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-07-27T00:04:32+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/f2c6acff-e801-5050-9013-c8927cb53caf', 'word_count': 445, 'uri': 'nyt://article/f2c6acff-e801-5050-9013-c8927cb53caf'}, {'abstract': 'Ron Paul’s libertarian views are being received differently in his second run for the Republican nomination.', 'web_url': 'https://www.nytimes.com/2011/07/27/us/politics/27paul.html', 'snippet': 'Ron Paul’s libertarian views are being received differently in his second run for the Republican nomination.', 'lead_paragraph': 'CEDAR RAPIDS, Iowa — Representative Ron Paul has a message for the ardent followers who read his books with a highlighter and donate to his fund-raising “money bombs” on the Internet: Winning the Iowa Straw Poll next month would “rock the establishment.”', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/27/us/PAUL/PAUL-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/27/us/PAUL/PAUL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/27/us/PAUL/PAUL-jumbo.jpg', 'height': 629, 'width': 102