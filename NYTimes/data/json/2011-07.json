nyregion/indians1/indians1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/04/nyregion/indians1/indians1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/04/nyregion/indians1/indians1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Hispanics Identifying Themselves as Indians', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hispanics Identifying Themselves As Indians', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Native Americans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hispanic-Americans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Census', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Carnival (Pre-Lenten)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Tlaxcala (Mexico)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-04T02:00:38+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Geoffrey Decker', 'person': [{'firstname': 'Geoffrey', 'middlename': None, 'lastname': 'Decker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0174795a-a045-5604-a88b-f047f2635845', 'word_count': 854, 'uri': 'nyt://article/0174795a-a045-5604-a88b-f047f2635845'}, {'abstract': 'Three music therapists from MJHS Hospice and Palliative Care crisscross the city and suburbs to sing songs to the dying.', 'web_url': 'https://www.nytimes.com/2011/07/04/nyregion/music-therapy-helps-the-dying.html', 'snippet': 'Three music therapists from MJHS Hospice and Palliative Care crisscross the city and suburbs to sing songs to the dying.', 'lead_paragraph': 'Every week, three music therapists from MJHS Hospice and Palliative Care crisscross the city and suburbs to sing songs to the dying. With guitars strapped to their backs, a flute or tambourine and a songbook jammed in their backpacks, they play music for more than 100 patients, in housing projects, in nursing homes and even in a lavish waterfront home. The time for chemotherapy and radiation is over. ', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Relaxing, Touching the Memory, Music Helps With the Final Transition', 'kicker': None, 'content_kicker': None, 'print_headline': 'Relaxing, Touching the Memory, Music Helps With the Final Transition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Death and Dying', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hospice Care', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-04T02:11:03+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Suzanne DeChillo', 'person': [{'firstname': 'Suzanne', 'middlename': None, 'lastname': 'DeChillo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/55ecaa97-8bf0-559d-9739-441a02e533f0', 'word_count': 562, 'uri': 'nyt://article/55ecaa97-8bf0-559d-9739-441a02e533f0'}, {'abstract': 'New anti-immigration laws in Georgia, Alabama and South Carolina are cruel, racist and counterproductive.', 'web_url': 'https://www.nytimes.com/2011/07/04/opinion/04mon1.html', 'snippet': 'New anti-immigration laws in Georgia, Alabama and South Carolina are cruel, racist and counterproductive.', 'lead_paragraph': 'If you thought the do-it-yourself anti-immigrant schemes couldn’t get any more repellent, you were wrong. New laws in Georgia, Alabama and South Carolina are following — and in some ways outdoing — Arizona’s attempt to engineer the mass expulsion of the undocumented, no matter the damage to the Constitution, public safety, local economies and immigrant families.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'It Gets Even Worse', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'It Gets Even Worse: New anti-immigrant laws are cruel, racist and counterproductive', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'South Carolina', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Racial Profiling', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ALABAMA', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Migrant and Foreign Workers', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-07-04T02:12:19+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/49a21e34-171b-55e0-a07c-afb261e7d658', 'word_count': 504, 'uri': 'nyt://article/49a21e34-171b-55e0-a07c-afb261e7d658'}, {'abstract': 'Filibusters routinely bypass democracy and surrender control to a small group of lawmakers.', 'web_url': 'https://www.nytimes.com/2011/07/04/opinion/04mon2.html', 'snippet': 'Filibusters routinely bypass democracy and surrender control to a small group of lawmakers.', 'lead_paragraph': 'When the New York State Senate legalized same-sex marriage with a simple majority last month, it was a reminder of how unthinkable that would have been in Washington. In the United States Senate, the most routine measures are filibustered and require 60 votes to pass. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Power of a Simple Majority', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Power of a Simple Majority: Filibusters surrender control to a small group of lawmakers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New York State', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Reform and Reorganization', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Filibusters and Debate Curbs', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-04T02:24:45+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/775bb1e6-1717-55f9-bc0c-76aeacc31e6f', 'word_count': 402, 'uri': 'nyt://article/775bb1e6-1717-55f9-bc0c-76aeacc31e6f'}, {'abstract': 'Responding to the growing threat of a humanitarian crisis, the European Union said it would provide about $14.5 million in emergency aid.', 'web_url': 'https://www.nytimes.com/2011/07/04/world/asia/04union.html', 'snippet': 'Responding to the growing threat of a humanitarian crisis, the European Union said it would provide about $14.5 million in emergency aid.', 'lead_paragraph': 'BRUSSELS — Responding to the growing threat of a humanitarian crisis in North Korea, the European Union announced on Monday that it will provide about $14.5 million in emergency aid to feed more than some 650,000 North Koreans.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'European Union to Send Food Aid to North Korea', 'kicker': None, 'content_kicker': None, 'prin