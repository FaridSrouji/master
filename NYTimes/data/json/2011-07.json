le': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/43c36f1a-6e9d-5fe9-abd6-5dc8cf61ae36', 'word_count': 489, 'uri': 'nyt://article/43c36f1a-6e9d-5fe9-abd6-5dc8cf61ae36'}, {'abstract': 'According to a new study, more than one-fourth of all federal securities class-action lawsuits this year came from investors in China-based companies that listed on American exchanges through a backdoor method.', 'web_url': 'https://dealbook.nytimes.com/2011/07/26/chinese-reverse-merger-companies-draw-lawsuits/', 'snippet': 'According to a new study, more than one-fourth of all federal securities class-action lawsuits this year came from investors in China-based companies that listed on American exchanges through a backdoor method.', 'lead_paragraph': 'A few years back, Chinese reverse-merger companies were all the rage on Wall Street.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chinese Reverse-Merger Companies Draw Lawsuits', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-26T18:35:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Azam Ahmed', 'person': [{'firstname': 'Azam', 'middlename': None, 'lastname': 'Ahmed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21ebadaf-0b95-5c22-af47-a74c134d8b0e', 'word_count': 499, 'uri': 'nyt://article/21ebadaf-0b95-5c22-af47-a74c134d8b0e'}, {'abstract': 'A spot-on parody of “Entourage” that nails the circular, Sisyphean nature of the show.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/07/26/the-maddening-circularity-of-entourage/', 'snippet': 'A spot-on parody of “Entourage” that nails the circular, Sisyphean nature of the show.', 'lead_paragraph': 'In this week’s Riff, Heather Havrilesky looks at the eighth and final season of HBO’s “Entourage,” the show about a quartet of young men who move to Hollywood and, in an incredibly repetitive and increasingly familiar way, enjoy the spoils of celebrity. As Heather puts it in one of many memorable sentences in her essay, the bro-on-bro joshing that is the show’s trademark long ago devolved into “a muddled white noise of macho white-people ribbing.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Maddening Circularity of ‘Entourage’', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-26T18:38:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Adam Sternbergh', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Sternbergh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e29ab5d0-982e-581a-86e0-ba0003b700af', 'word_count': 244, 'uri': 'nyt://article/e29ab5d0-982e-581a-86e0-ba0003b700af'}, {'abstract': 'Victor Gordon was arraigned on smuggling charges in federal court in Brooklyn after, the authorities said, they seized about a ton of carved ivory that he had had a confederate bring into the country in his luggage.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/26/art-dealer-charged-with-smuggling-ivory-into-u-s/', 'snippet': 'Victor Gordon was arraigned on smuggling charges in federal court in Brooklyn after, the authorities said, they seized about a ton of carved ivory that he had had a confederate bring into the country in his luggage.', 'lead_paragraph': 'Of the millions of tons of stuff tha