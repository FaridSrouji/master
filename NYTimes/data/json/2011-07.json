stname': 'Kevin', 'middlename': None, 'lastname': 'Roose', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae084aa6-2f34-545c-82b2-76099a673c38', 'word_count': 461, 'uri': 'nyt://article/ae084aa6-2f34-545c-82b2-76099a673c38'}, {'abstract': 'A film festival at two Kenyan refugee camps this week will give thousands of displaced people an unlikely source of diversion.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/07/18/out-of-africa/', 'snippet': 'A film festival at two Kenyan refugee camps this week will give thousands of displaced people an unlikely source of diversion.', 'lead_paragraph': 'Movies may not be high on lists of supplies needed by refugees, but for many people suffering the effects of war and long-term displacement, film screenings can be an all-too-rare source of diversion and psychological release, advocates say. This week, Film Forward, a Sundance Institute initiative, and FilmAid International, a humanitarian aid organization, are bringing a festival to Kenya’s sprawling Kakuma and Dadaab camps, home to hundreds of thousands of refugees.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Out of Africa', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-18T17:45:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Abby Aguirre', 'person': [{'firstname': 'Abby', 'middlename': None, 'lastname': 'Aguirre', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3e8872f0-9bac-50fc-b4ba-4ce32a4f7e30', 'word_count': 335, 'uri': 'nyt://article/3e8872f0-9bac-50fc-b4ba-4ce32a4f7e30'}, {'abstract': 'The Lincoln Trust Company is providing itemized statements of retirement plan costs for employers and employee participants.', 'web_url': 'https://bucks.blogs.nytimes.com/2011/07/18/lincoln-trusts-enhanced-view-of-retirement-plan-costs/', 'snippet': 'The Lincoln Trust Company is providing itemized statements of retirement plan costs for employers and employee participants.', 'lead_paragraph': 'In recent weeks, the Your Money columnist Ron Lieber has written often about the impact of mutual fund expenses and other fees on the performance of 401(k) plans and the difficulty of determining just how much one is paying in expenses.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lincoln Trust’s Enhanced View of Retirement Plan Costs', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': '401(k), 403(b) and 457 Plans', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lieber, Ron', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Labor Department (US)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Denver (Colo)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-18T17:47:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29cba5c2-637b-5294-9975-61715750d8a6', 'word_count': 590, 'uri': 'nyt://article/29cba5c2-637b-5294-9975-61715750d8a6'}, {'abstract': 'Rod Arnold joined the Media Ventures Group, New York, in a new post, senior vice president for business development and strategy. He had been chief operating officer at Charity: Water.', 'web_url': 'https://www.nytimes.com/2011/07/18/business/media/accounts-and-people-of-note-in-the-ad-industry.html', 'snippet': 'Rod Arnold joined the Media Ventures Group, New York, in a new post, senior vice president for business development and strategy. He had been chief operating officer at Charity: Water.', 'lead_paragraph': 'Rod Arnold joined the Media Ventures Group, New York, in a new post, senior vice president for business development and strategy. He had been chief operating officer and head of special projects at Charity: Water.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Accounts and People of Note in the Ad Industry', 'kicker': 'Webdenda', 'content_kicker': None, 'print_headline': 'Webdenda', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Public Relations and Publicity', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-18T17:50:29+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/788565e7-60fc-5252-bf8f-b5e136bffce2', 'word_count': 1412, 'uri': 'nyt://article/788565e7-60fc-5252-bf8f-b5e136bffce2'}, {'abstract': 'It’s a question of whether sound-alike performers are used in radio spots.', 'web_url': 'https://www.nytimes.com/2011/07/18/business/media/q-and-a-with-stuart-elliott.html', 'snippet': 'It’s a question of whether sound-alike performers are used in radio spots.', 'lead_paragraph': 'Q: (Reader)', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2010/05/27/business/media/stuart-elliott-headshot/stuart-elliott-headshot-jumbo.jpg', 'height': 234, 'width': 190, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumb