: 'nyt://article/9aa9907f-0a40-5a31-a697-e96b5f118880', 'word_count': 212, 'uri': 'nyt://article/9aa9907f-0a40-5a31-a697-e96b5f118880'}, {'abstract': 'The bride is a trial lawyer; the bridegroom works for a congressman.', 'web_url': 'https://www.nytimes.com/2011/07/31/fashion/weddings/jessica-reimelt-david-greengrass-weddings.html', 'snippet': 'The bride is a trial lawyer; the bridegroom works for a congressman.', 'lead_paragraph': 'Jessica Scott Reimelt and David Neil Greengrass were married Saturday evening at the Hay-Adams hotel in Washington. Mary Ellen Barbera, a judge on the Maryland Court of Appeals, officiated. ', 'print_section': 'ST', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/31/fashion/weddings/31REIMELTjpg/31REIMELTjpg-jumbo.jpg', 'height': 1024, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/31/fashion/weddings/31REIMELTjpg/31REIMELTjpg-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/31/fashion/weddings/31REIMELTjpg/31REIMELTjpg-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Jessica Reimelt, David Greengrass', 'kicker': None, 'content_kicker': None, 'print_headline': 'Jessica Reimelt, David Greengrass', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-29T21:18:53+0000', 'document_type': 'article', 'news_desk': 'Society', 'section_name': 'Fashion & Style', 'subsection_name': 'Weddings', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7333e156-1ffa-5cae-a4a7-c04cee86267d', 'word_count': 194,