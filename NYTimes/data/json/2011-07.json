, 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/19/arts/BRUCKNER/BRUCKNER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/19/arts/BRUCKNER/BRUCKNER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Chance to Hear Bruckner Anew, by Himself and With an Unexpected Partner', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Chance to Hear Bruckner Anew, by Himself and With an Unexpected Partner', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Lincoln Center for the Performing Arts', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cleveland Orchestra', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bruckner, Anton', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-18T21:49:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Steve Smith', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c15c7161-463c-5b33-b08d-2dd60602894c', 'word_count': 613, 'uri': 'nyt://article/c15c7161-463c-5b33-b08d-2dd60602894c'}, {'abstract': 'Photographs from Afghanistan, India, Israel and England.', 'web_url': 'https://lens.blogs.nytimes.com/2011/07/18/pictures-of-the-day-afghanistan-and-elsewhere-15/', 'snippet': 'Photographs from Afghanistan, India, Israel and England.', 'lead_paragraph': 'Photographs from Afghanistan, India, Israel and England.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pictures of the Day: Afghanistan and Elsewhere', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'England', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-18T21:49:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/14241665-251e-5379-a278-5db5778afdf2', 'word_count': 7, 'uri': 'nyt://article/14241665-251e-5379-a278-5db5778afdf2'}, {'abstract': 'For the International Keyboard Institute and Festival’s opening recital, its director, Jerome Rose, forwent an all-Liszt program in favor of Brahms.', 'web_url': 'https://www.nytimes.com/2011/07/19/arts/music/jerome-rose-at-international-keyboard-festival-review.html', 'snippet': 'For the International Keyboard Institute and Festival’s opening recital, its director, Jerome Rose, forwent an all-Liszt program in favor of Brahms.', 'lead_paragraph': 'You might have expected that this year’s International Keyboard Institute and Festival at Mannes College the New School for Music would be virtually a symposium on the work of Franz Liszt. The 200th anniversary of Liszt’s birth is being commemorated this year, after all, and he is the patron saint of the grand Romantic approach to keyboard virtuosity that this festival, now in its 13th season, has always celebrated. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/19/arts/ROSE/ROSE-jumbo.jpg', 'height': 652, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'r