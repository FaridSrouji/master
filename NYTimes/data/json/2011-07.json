astname': 'Warren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8535e73d-e94f-5602-b53d-09a2f95a9c1b', 'word_count': 745, 'uri': 'nyt://article/8535e73d-e94f-5602-b53d-09a2f95a9c1b'}, {'abstract': 'With a deadline looming on Tuesday to raise the debt ceiling, the specter of default dominates the Sunday talk shows.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/07/30/sunday-breakfast-menu-july-31/', 'snippet': 'With a deadline looming on Tuesday to raise the debt ceiling, the specter of default dominates the Sunday talk shows.', 'lead_paragraph': 'With an ominous deadline to raise the debt ceiling looming on Tuesday, the White House and Congressional lawmakers are still far from reaching a deal. The impasse raises the central question of this Sunday’s talk shows: Will America default?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sunday Breakfast Menu, July 31', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'National Debt (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-30T20:28:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Southall', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Southall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f9d24df-d6da-594c-9425-237a2499a8ba', 'word_count': 375, 'uri': 'nyt://article/4f9d24df-d6da-594c-9425-237a2499a8ba'}, {'abstract': 'A study done on the disciplinary actions of students in Texas should prompt all states to re-examine their policies.', 'web_url': 'https://www.nytimes.com/2011/07/31/opinion/sunday/one-way-to-guarantee-more-trouble-for-schools.html', 'snippet': 'A study done on the disciplinary actions of students in Texas should prompt all states to re-examine their policies.', 'lead_paragraph': 'Nearly six in 10 public school students in Texas were suspended or expelled at least once between seventh and 12th grade. That was the astounding finding of an analysis tracking nearly one million students in 3,900 Texas schools.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'One Way to Guarantee More Trouble', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'One Way to Guarantee More Trouble', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'School Discipline (Students)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Office for Civil Rights', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Council of State Governments', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-07-30T20:36:20+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/46e85c52-b7b5-5e00-9b08-5489cf584f86', 'word_count': 506, 'uri': 'nyt://article/46e85c52-b7b5-5e00-9b08-5489cf584f86'}, {'abstract': 'Robert B. Semple Jr. explains the legislative riders lurking inside a 2012 appropriations bill, and the damage they would do.', 'web_url': 'https://www.nytimes.com/2011/07/31/opinion/sunday/concealed-weapons-against-the-environment.html', 'snippet': 'Robert B. Semple Jr. explains the legislative riders lurking inside a 2012 appropriations bill, and the damage they would do.', 'lead_paragraph': 'While almost no one was looking, House Republicans embarked last week on a broad assault on the nation’s environmental laws, using as their weapon the 2012 spending bill for the Interior Department and the Environmental Protection Agency. When debate began Monday, the bill included an astonishing 39 anti-environmental riders — so called because they ride along on appropriations bills even though they have nothing to do with spending and are designed to change policy, in this case disastrously.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Concealed Weapons Against the Environment', 'kicker': 'Editorial | Annotation', 'content_kicker': None, 'print_headline': 'Concealed Weapons Against the Environment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Environment', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Energy and Power', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-07-30T20:36:27+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Robert B. Semple Jr', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/45b011af-bc9a-5bf1-91e3-b6f77ba28201', 'word_count': 1109, 'uri': 'nyt://article/45b011af-bc9a-5bf1-91e3-b6f77ba28201'}, {'abstract': 'Yankees Manager Joe Girardi voiced his dislike of doubleheaders before his team beat the Orioles by a combined score of 25-6, in their doubleheader on Saturday.', 'web_url': 'https://www.nytimes.com/2011/07/31/sports/baseball/yankees-win-first-game-of-doubleheader-against-orioles.html', 'snippet': 'Yankees Manager Joe Girardi voiced his dislike of doubleheaders before his team beat the Orioles by a combined score of 25-6, in their doubleheader on Saturday.', 'lead_paragraph': 'At the start of a long day of baseball, Yankees Manager Joe Girardi was asked how he felt about doubleheaders — either the traditional back-to-back variety or the split doubleheader, with games at 1 p.m. and 7 p.m., like the Yankees and the Baltimore Orioles played Saturday. Girardi frowned.', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/31/sports/ny-yankees2/ny-yankees2-jumbo.jpg', 'height': 824, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/31/sports/ny-yankees2/ny-yankees2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/31/sports/ny-yankees2/ny-yankees2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Long Day for Yankees; Longer One for Orioles', 'kicker': 'Yankees 8, Orioles 3 (1st Game); Yankees 17, Orioles 3 (2nd Game)', 'content_kicker': None, 'print_headline': 'Long Day for Yankees; Longer One for Orioles', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Baltimore Orioles', 'rank': 1, 'major': 'N'}, {'n