ame': 'Casey', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c00f0bf2-f70f-55c3-a958-9c26eb107944', 'word_count': 401, 'uri': 'nyt://article/c00f0bf2-f70f-55c3-a958-9c26eb107944'}, {'abstract': 'Serbian police have arrested Goran Hadzic, the former rebel leader sought in the killings of hundreds of Croats and the last Serb wanted by the United Nations war crimes tribunal.', 'web_url': 'https://www.nytimes.com/2011/07/21/world/europe/21goran-hadzic.html', 'snippet': 'Serbian police have arrested Goran Hadzic, the former rebel leader sought in the killings of hundreds of Croats and the last Serb wanted by the United Nations war crimes tribunal.', 'lead_paragraph': 'PARIS — The last Serbian fugitive wanted by a United Nations war crimes tribunal was arrested in a Serbian forest early Wednesday, a quiet event that appeared to remove the final major obstacle blocking the nation’s access to Western money and European Union membership. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/21/world/21goran-hadzic/21goran-hadzic-jumbo.jpg', 'height': 1024, 'width': 723, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/21/world/21goran-hadzic/21goran-hadzic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/21/world/21goran-hadzic/21goran-hadzic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Serbia Arrests Its Last Fugitive Accused of War Crimes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Serbia Arrests Its Last Fugitive Accused of War Crimes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Serbia', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Croatia', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'International Criminal Tribunal for the former Yugoslavia', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tadic, Boris', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-20T10:13:27+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Marlise Simons', 'person': [{'firstname': 'Marlise', 'middlename': None, 'lastname': 'Simons', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/af5676bf-7343-5f0c-aa83-f11c145961ad', 'word_count': 725, 'uri': 'nyt://article/af5676bf-7343-5f0c-aa83-f11c145961ad'}, {'abstract': 'Google allows us to “save hard drive space for what matters, while at the same time improving the accuracy of recall.”', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/07/20/does-google-make-us-smarter-dumber-or-both/', 'snippet': 'Google allows us to “save hard drive space for what matters, while at the same time improving the accuracy of recall.”', 'lead_paragraph': 'Why is your brain on Google better than your brain sans Google? Because it gives you somewhere to store all that trivia you would otherwise have to waste precious brain cells remembering. Or so says Jonah Lehrer, via Andrew Sullivan on the Daily Dish, who points out that Google not only helps us remember but also helps us correct our often faulty memories. “While the Web enables all sorts of other biases – it lets us filter news, for instance, to confirm what we already believe – the use of the Web as a vessel of transactive memory is mostly virtuous. We save hard drive space for what matters, while at the same time improving the accuracy of recall.” So forget all those warnings about how the Web just makes us dumber. It’s perfectly okay if you have to Google something you just read two seconds ago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Does Google Make Us Smarter, Dumber or Both?', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-20T10:13:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Sheila Glaser', 'person': [{'firstname': 'Sheila', 'middlename': None, 'lastname': 'Glaser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4311575c-a064-55c4-8ae2-bb421a49379e', 'word_count': 172, 'uri': 'nyt://article/4311575c-a064-55c4-8ae2-bb421a49379e'}, {'abstract': 'The Lede continues to follow developments in the phone hacking scandal in Britain on Wednesday.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/07/20/latest-updates-on-phone-hacking-scandal-2/', 'snippet': 'The Lede continues to follow developments in the phone hacking scandal in Britain on Wednesday.', 'lead_paragraph': 'The Lede continued to follow developments in the phone hacking scandal in Britain on Wednesday. Video of Prime Minister David Cameron’s complete statement to the House of Commons on the scandal, and his answers to questions from members of Parliament, is embedded above.  ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Latest Updates on Phone Hacking Scandal', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Newspapers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wiretapping and Other E