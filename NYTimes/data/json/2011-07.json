ype': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/12/business/12flier-inline/12flier-inline-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Seatmate Falls Asleep, and His Small Dog Gets Comfortable', 'kicker': 'Frequent Flier', 'content_kicker': None, 'print_headline': 'A Seatmate Falls Asleep, and His Small Dog Gets Comfortable', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-11T20:14:22+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Jonah Disend', 'person': [{'firstname': 'Jonah', 'middlename': None, 'lastname': 'Disend', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/23743be5-a8f8-5782-ade5-22ad36501e49', 'word_count': 624, 'uri': 'nyt://article/23743be5-a8f8-5782-ade5-22ad36501e49'}, {'abstract': 'Readers write to argue that news organizations are responsible for politicians’ inattention to the unemployment issue.', 'web_url': 'https://economix.blogs.nytimes.com/2011/07/11/media-culpa-coverage-of-jobs-vs-deficit/', 'snippet': 'Readers write to argue that news organizations are responsible for politicians’ inattention to the unemployment issue.', 'lead_paragraph': 'I’ve suggested several different explanations for why the jobs crisis has gotten so little attention in Washington, especially compared to the deficit. In response, a lot of frustrated readers e-mailed me to argue that I’d left out one other explanation: the media. Major news organizations have devoted much more air time, ink and pixels to America’s debt concerns than to the 14-million-person army of jobless workers, they argued.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Media Culpa? Coverage of Jobs vs. Deficit', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-11T20:20:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5fd93ded-9221-5462-a519-8939c98f1cb9', 'word_count': 346, 'uri': 'nyt://article/5fd93ded-9221-5462-a519-8939c98f1cb9'}, {'abstract': 'The latest and greatest to weigh in with his list of five favorite novels is Sam Tanenhaus, editor of the Book Review.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/07/11/sam-tanenhauss-five-favorite-novels/', 'snippet': 'The latest and greatest to weigh in with his list of five favorite novels is Sam Tanenhaus, editor of the Book Review.', 'lead_paragraph': 'The latest Times staff member to weigh in with a list of five favorite novels is Sam Tanenhaus, the editor of the Book Review. His picks are below.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sam Tanenhaus’s Five Favorite Novels', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tanenhaus, Sam', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-11T20:21:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Rachel Nolan', 'per