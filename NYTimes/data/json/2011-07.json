}], 'pub_date': '2011-07-21T16:23:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Charles Isherwood', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'Isherwood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fec85687-8395-568b-b701-b5a61cc4f472', 'word_count': 1151, 'uri': 'nyt://article/fec85687-8395-568b-b701-b5a61cc4f472'}, {'abstract': 'A new education school in New York promises to revolutionize teacher prep.', 'web_url': 'https://www.nytimes.com/slideshow/2011/07/24/education/20110724TEACH.html', 'snippet': 'A new education school in New York promises to revolutionize teacher prep.', 'lead_paragraph': 'A new education school in New York promises to revolutionize teacher prep.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/20110724TEACH-slide-TE46/20110724TEACH-slide-TE46-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/20110724TEACH-slide-TE46/20110724TEACH-slide-TE46-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/24/education/20110724TEACH-slide-TE46/20110724TEACH-slide-TE46-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'To Train a Teacher', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-21T16:33:03+0000', 'document_type': 'multimedia', 'news_desk': 'Education', 'section_name': 'Education', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/fe3d4050-3056-5158-9109-15dbe892e6b0', 'word_count': 0, 'uri': 'nyt://slideshow/fe3d4050-3056-5158-9109-15dbe892e6b0'}, {'abstract': 'New models for teacher preparation are thinking outside the box. Are they too far out?', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24teacher-t.html', 'snippet': 'New models for teacher preparation are thinking outside the box. Are they too far out?', 'lead_paragraph': 'There will be no courses at the Relay Graduate School of Education, the first standalone college of teacher preparation to open in New York State for nearly 100 years. Instead, there will be some 60 modules, each focused on a different teaching technique. There will be no campus, because it is old-think to believe a building makes a school. Instead, the graduate students will be mentored primarily at the schools where they teach. And there will be no lectures. Direct instruction, as such experiences will be called, should not take place for more than 15 or 20 minutes at a time. After that, students should discuss ideas with one another or reflect on their own.', 'print_section': 'ED', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/edl-24teacher-t_CA0/edl-24teacher-t_CA0-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/24/education/edl-24teacher-t_CA0/edl-24teacher-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/edl-24teacher-t_CA0/edl-24teacher-t_CA0-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'ra