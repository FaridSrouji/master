rint_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-07T21:46:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nate Silver', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Silver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/156523a9-87ad-5fc2-9292-6a4d595c4613', 'word_count': 934, 'uri': 'nyt://article/156523a9-87ad-5fc2-9292-6a4d595c4613'}, {'abstract': 'The agency says it wants to study the issue first.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/07/07/i-r-s-halts-gift-tax-enforcement-for-contributions-to-political-nonprofits/', 'snippet': 'The agency says it wants to study the issue first.', 'lead_paragraph': 'The Internal Revenue Service will not enforce a tax on large contributions to nonprofit advocacy groups while it studies the issue, according to a memorandum issued by the agency on Thursday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'I.R.S. Halts Gift Tax Enforcement for Contributions to Political Nonprofits', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nonprofit Organizations', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Crossroads GPS', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Internal Revenue Service', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Priorities USA Action', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-07T21:47:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Derek Willis', 'person': [{'firstname': 'Derek', '