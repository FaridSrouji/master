S-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/us/GAYS/GAYS-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/us/GAYS/GAYS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/03/us/GAYS/GAYS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'New York’s Approval of Same-Sex Marriage Spurs Opponents for New Fights', 'kicker': None, 'content_kicker': None, 'print_headline': 'New York’s Approval of Same-Sex Marriage Spurs Opponents for New Fights', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Organization for Marriage', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-02T21:39:06+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Erik Eckholm and Katharine Q. Seelye', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Eckholm', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/669220b1-5383-5efc-8f76-9f7007f7b0ce', 'word_count': 916, 'uri': 'nyt://article/669220b1-5383-5efc-8f76-9f7007f7b0ce'}, {'abstract': 'Prince William and Kate Middleton are to travel to Los Angeles, a nation unto itself. Here are some suggestions for how to handle the culture shock.', 'web_url': 'https://www.nytimes.com/2011/07/03/sunday-review/03royals.html', 'snippet': 'Prince William and Kate Middleton are to travel to Los Angeles, a nation unto itself. Here are some suggestions for how to handle the culture shock.', 'lead_paragraph': 'LONDON ', 'print_section': 'SR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/sunday-review/LYALL-B-1309550762711/LYALL-B-1309550762711-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/03/sunday-review/LYALL-B-1309550762711/LYALL-B-1309550762711-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/sunday-review/LYALL-B-1309550762711/LYALL-B-1309550762711-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/sunday-review/LYALL-B-1309550762711/LYALL-B-1309550762711-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/03/sunday-review/LYALL-B-1309550762711/LYALL-B-1309550762711-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'William and Kate, Meet L.A.', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'William And Kate, Meet L.A.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'William, Duke of Cambridge', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Catherine, Duchess of Cambridge', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-02T21:42:31+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Sunday Review', 'byline': {'original': 'By Sarah Lyall', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Lyall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/63070f27-b0d9-5e0e-abc1-5db02a71d1ae', 'word_count': 744, 'uri': 'nyt://article/63070f27-b0d9-5e0e-abc1-5db02a71d1ae'}, {'abstract': 'We witness a polar bear’s grief and taste our own memories of love, loss and loneliness. Our wild heart goes out to him.', 'web_url': 'https://www.nytimes.com/2011/07/03/opinion/sunday/03gus.html', 'snippet': 'We witness a polar bear’s grief and taste our own memories of love, loss and loneliness. Our wild heart goes out to him.', 'lead_paragraph': 'MY heart goes out to Gus, the famously neurotic polar bear in the Central Park Zoo, who used to swim endless laps around his pool. He’d dive to the bottom in a froth of bubbles, surge across and then surface like a bear obsessed. He’d backstroke to the other side, and with great paws splashing, dive down to the bottom and circle around again. Some wags called him the “bipolar bear,” but most zoo-goers sensed that he felt bored, pent-up, out of his element and depressed. ', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/04/opinion/ackerman-contributor/contibutors-images-slide-VPGN-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/10/04/opinion/ackerman-contributor/contibutors-images-slide-VPGN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption':