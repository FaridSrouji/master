_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alix Browne', 'person': [{'firstname': 'Alix', 'middlename': None, 'lastname': 'Browne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d5c4058-5b84-58ee-8bf9-b9038511a68d', 'word_count': 201, 'uri': 'nyt://article/5d5c4058-5b84-58ee-8bf9-b9038511a68d'}, {'abstract': 'The smartphone app Dances for an iPhone features accomplished dancers performing Richard Daniels’s pieces, which are intimate works of art in themselves.', 'web_url': 'https://www.nytimes.com/2011/07/17/arts/music/dances-for-an-iphone-richard-danielss-intimate-app.html', 'snippet': 'The smartphone app Dances for an iPhone features accomplished dancers performing Richard Daniels’s pieces, which are intimate works of art in themselves.', 'lead_paragraph': 'DANCES for an iPhone began the way most dances don’t: with an injury. But Richard Daniels, who at various times has worked as an arts administrator, a producer and a choreographer, was incapacitated and recovering from shoulder surgery in 2008 when the idea was born. ', 'print_section': 'AR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/arts/POD-3/POD-3-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/17/arts/POD-3/POD-3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/arts/POD-3/POD-3-jumbo.jpg', 'height': 695, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Modern Dance, in Your Hand', 'kicker': None, 'content_kicker': None, 'print_headline': 'Modern Dance, in Your Hand', 'name': None, 'seo': N