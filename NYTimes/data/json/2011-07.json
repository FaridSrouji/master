rank': 3, 'major': 'N'}], 'pub_date': '2011-07-22T19:00:41+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'byline': {'original': 'By John Tierney', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Tierney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f2cf92b-8980-5c0e-8caf-51667de321f3', 'word_count': 1184, 'uri': 'nyt://article/3f2cf92b-8980-5c0e-8caf-51667de321f3'}, {'abstract': 'A researcher’s rap, for fun.', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24rap-t.html', 'snippet': 'A researcher’s rap, for fun.', 'lead_paragraph': 'Adam J. Ruben spent seven years working on a Ph.D. in molecular biology at Johns Hopkins. On the side, he performed at open mikes and wrote a book that didn’t count toward his publish-or-perish count. “Surviving Your Stupid, Stupid Decision to Go to Grad School” was published by Broadway Books last year. Now Dr. Ruben teaches an undergraduate class on the stand-up comic in society at Johns Hopkins, when he’s not at his day job at Sanaria, working on a vaccine for malaria. Another hobby: rapping.', 'print_section': 'ED', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/education/edlife/dl-24rap-CA0/dl-24rap-CA0-jumbo.jpg', 'height': 482, 'width': 654, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/education/edlife/dl-24rap-CA0/dl-24rap-CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/18/education/edlife/dl-24rap-CA0/dl-24rap-CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Dissing the Doctorate', 'kicker': 'BlackBoard', 'content_kicker': None, 'print_headline': 'Dissing the Doctorate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-22T19:00:45+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/950ab872-8dc5-5cb0-aab8-76f34add9c08', 'word_count': 593, 'uri': 'nyt://article/950ab872-8dc5-5cb0-aab8-76f34add9c08'}, {'abstract': 'With messages like “go further faster,” institutions are offering alternatives to the traditional four-year/two-year timetable, allowing students to complete two degrees in five years or less.', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24speed-t.html', 'snippet': 'With messages like “go further faster,” institutions are offering alternatives to the traditional four-year/two-year timetable, allowing students to complete two degrees in five years or less.', 'lead_paragraph': 'Do you want a master’s with that bachelor’s? Think of it as adding fries and a Coke for an Extra Value Meal.', 'print_section': 'ED', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Two-for-One Deal: Bachelor’s Plus Master’s', 'kicker': None, 'content_kicker': None, 'print_headline': 'B.A./M.A.: A Two-for-One Deal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-22T19:00:57+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Laura Pappano', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Pappano', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a3e5023-aab3-5120-92b2-65518689b20c', 'word_count': 341, 'uri': 'nyt://article/2a3e5023-aab3-5120-92b2-65518689b20c'}, {'abstract': 'Experts weigh in on clichés.', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24seuss-t.html', 'snippet': 'Experts weigh in on clichés.', 'lead_paragraph': 'In thesis writing or application essays, impressive citations are important. Here are a few to leave out:', 'print_section': 'ED', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/education/edlife/edl24-seuss-1/edl24-seuss-1-jumbo-v2.jpg', 'height': 554, 'width': 400, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/education/edlife/edl24-seuss-1/edl24-seuss-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/18/education/edlife/edl24-seuss-1/edl24-seuss-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Citations to Avoid', 'kicker': 'Blackboard | Writings', 'content_kicker': None, 'print_headline': 'Citations To Avoid', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-22T19:00:57+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5689243a-d9aa-55e0-ab7a-ecddd8c96d52', 'word_count': 157, 'uri': 'nyt://article/5689243a-d9aa-55e0-ab7a-ecddd8c96d52'}, {'abstract': 'Dinosaur eggs, iguanas and ooh, look, a grad student. Inside the new school at the Natural History Museum', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24naturalhistory-t.html', 'snippet': 'Dinosaur eggs, iguanas and ooh, look, a grad student. Inside the new school at the Natural History Museum', 'lead_paragraph': 'Beyond the noisy throngs marveling at the dinosaurs, the dioramas and the immense blue whale, up on the fifth floor where visitors are not allowed, the American Museum of Natural History takes on an entirely different character.', 'print_section': 'ED', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/24NATHISTORY_SPAN/24NATHISTORY_SPAN-articleLarge.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/24/education/24NATHISTORY_SPAN/24NATHISTORY_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/24NATHISTORY_SPAN/24NATHISTORY_SPAN-jumbo.jpg', 'height': 300, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/24NATHISTORY_SPAN/24NATHISTORY_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/24/education/24NATHISTORY_SPAN/24NATHISTORY_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Critter People', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Critter People', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Museum of Natural History', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Biology and Biochemistry', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-22T19:00:57+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Tamar Lewin', 'person': [{'firstname': 'Tamar', 'middlename': None, 'lastname': 'Lewin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8f3af53-b6b5-591f-8e83-345fbbef5f55', 'word_count': 1340, 'uri': 'nyt://article/e8f3af53-b6b5-591f-8e83-345fbbef5f55'}, {'abstract': 'Is graduate school worth the investment?', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24roi-t.html', 'snippet': 'Is graduate school worth the investment?', 'lead_paragraph': 'Graduate school has long been a recession hideout, a place to add new skills and credentials that, presumably, increase job opportunities and salary in a market recovered by graduation. A year after 2008’s economic meltdown, applications to graduate school rose more than 8 percent. Last year, as the country hobbled toward recovery (or not), 27 percent of college seniors said they planned to attend immediately after graduation, up from 21 percent in 2007, according to the National Association of Colleges and Employers.', 'print_section': 'ED', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'R.O.I.', 'kicker': None, 'content_kicker': None, 'print_headline': 'R.O.I.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Careers and Professions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tuition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lemann, Nicholas', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-22T19:00:59+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Cecilia Capuzzi Simon', 'person': [{'firstname': 'Cecilia', 'middlename': 'Capuzzi', 'lastname': 'Simon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9a8e9c49-91d3-5e86-b9f8-ce0a4113bee5', 'word_count': 1576, 'uri': 'nyt://article/9a8e9c49-91d3-5e86-b9f8-ce0a4113bee5'}, {'abstract': 'Teaching assistantships are grueling, rewarding and crucial to university and to student. If only there were enough to go around.', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24TA-t.html', 'snippet': 'Teaching assistantships are grueling, rewarding and crucial to university and to student. If only there were enough to go around.', 'lead_paragraph': 'Jason G. Ball was thrilled when he was accepted two years ago at the University of California, Los Angeles, and could pursue a Ph.D. in political science. He was so thrilled, he enrolled without any assurance of a teaching assistantship or other financial support.', 'print_section': 'ED', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/education/edl-24TA-t_CA0/edl-24TA-t_CA0-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'The Essential T.A.', 'kicker': 'Resources | Financial Aid', 'content_kicker': None, 'print_headline': 'The Essential T.A.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Scholarships and Fellowships', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-22T19:01:01+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/114d97ea-6f1f-5008-94ed-a92a85fce53e', 'word_count': 1341, 'uri': 'nyt://article/114d97ea-6f1f-5008-94ed-a92a85fce53e'}, {'abstract': 'Sample questions from the new integrated reasoning section.', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24quiz-t.html', 'snippet': 'Sample questions from the new integrated reasoning section.', 'lead_paragraph': 'Anyone contemplating business school wants to know whether to take the GMAT now or wait until next June, when the integrated reasoning section is introduced. First, ask yourself this: Does an Excel file give you pause? The new section is what came of a 2009 survey of 740 faculty members, who were asked what the GMAT should measure that it didn’t. The section will replace one of two essays, and is heavy on data interpretation. “As the business environment changes, the business curriculum changes,” explains Ashok Sarathy, vice president for the Graduate Management Admission Council, which administers the test. What doesn’t change: total test time (at three and a half hours) and the verbal and quantitative sections. Try your hand at this preview, which GMAC created for Education Life. There are four new question types: multi-source reasoning, graphics interpretation, two-part analysis and sorting tables.', 'print_section': 'ED', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/19/education/edlife/edl-24quiz-illo/edl-24quiz-illo-jumbo.jpg', 'height': 810, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/19/education/edlife/edl-24quiz-illo/edl-24quiz-illo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/19/education/edlife/edl-24quiz-illo/edl-24quiz-illo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'GMAT Makeover', 'kicker': 'Pop Quiz | Business', 'content_kicker': None, 'print_headline': 'GMAT Makeover', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Management Admission Test (GMAT)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Business Schools', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tests and Examinations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-22T19:01:01+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/94c13d66-6c96-53f6-aa85-f8d92087d974', 'word_count': 745, 'uri': 'nyt://article/94c13d66-6c96-53f6-aa85-f8d92087d974'}, {'abstract': 'Teaching graduate students to communicate.', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24jargon-t.html', 'snippet': 'Teaching graduate students to communicate.', 'lead_paragraph': 'Recognizing that scientists can be really, really hard to understand, Emory last semester introduced “Communicating Science” to teach grad students to write for and talk to laypeople. Students create presentations, blog and compose “elevator speeches” addressing various scenarios (see below).', 'print_section': 'ED', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/19/education/edlife/edl-24jargon-CAO/edl-24jargon-CAO-jumbo.jpg', 'height': 801, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'How to Talk to Real People', 'kicker': 'Blackboard | Jargon', 'content_kicker': None, 'print_headline': 'How to Talk To Real People', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-22T19:01:01+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b6364d27-4310-5d9e-8f75-ac656674ce69', 'word_count': 295, 'uri': 'nyt://article/b6364d27-4310-5d9e-8f75-ac656674ce69'}, {'abstract': 'Call it credentials inflation. A four-year degree may not cut it anymore.', 'web_url': 'https://www.nytimes.com/2011/07/24/education/edlife/edl-24masters-t.html', 'snippet': 'Call it credentials inflation. A four-year degree may not cut it anymore.', 'lead_paragraph': 'William Klein’s story may sound familiar to his fellow graduates. After earning his bachelor’s in history from the College at Brockport, he found himself living in his parents’ Buffalo home, working the same $7.25-an-hour waiter job he had in high school.', 'print_section': 'ED', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/education/edlife/edl-24masters-CA0/edl-24masters-CA0-jumbo.jpg', 'height': 1024, 'width': 1004, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/18/education/edlife/edl-24masters-CA0/edl-24masters-CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/18/education/edlife/edl-24masters-CA0/edl-24masters-CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Master’s as the New Bachelor’s', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Master’s as the New Bachelor’s', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Education', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Careers and Professions', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-22T19:01:03+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Laura Pappano', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Pappano', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a49b286-be01-5113-aded-3e4098bfa66c', 'word_count': 1949, 'uri': 'nyt://article/2a49b286-be01-5113-aded-3e4098bfa66c'}, {'abstract': 'Getting an executive M.B.A. can be onerous, both logistically and financially.', 'web_url': 'https://www.nytimes.com/2011/07/20/education/edlife/edl-24exmba-box.html', 'snippet': 'Getting an executive M.B.A. can be onerous, both logistically and financially.', 'lead_paragraph': 'Getting an executive M.B.A. can be onerous, both logistically and financially. While there are some scholarships, many students rely on loans.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paying for an M.B.A.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Business Schools', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tuition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Student Loans', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-22T19:01:06+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Geraldine Fabrikant', 'person': [{'firstname': 'Geraldine', 'middlename': None, 'lastname': 'Fabrikant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36476e7e-aa20-5f3f-9b77-4a579edad30d', 'word_count': 365, 'uri': 'nyt://article/36476e7e-aa20-5f3f-9b77-4a579edad30d'}, {'abstract': 'M.F.A. programs around the country have taken to challenging the conventional mold by offering more courses in nontraditional art.', 'web_url': 'https://www.nytimes.com/2011/07/21/education/edlife/edl-24mfa-t.html', 'snippet': 'M.F.A. programs around the country have taken to challenging the conventional mold by offering more courses in nontraditional art.', 'lead_paragraph': "Traditionally, a Master of Fine Arts program is studio-centric: students work in a single medium, putting together a unified body of work and attempting to become better artists. But today's M.F.A. programs have taken to challenging the conventional mold. One of the more popular alternatives is community art, in which students are encouraged to create work with larger public outreach.", 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Art of Community Engagement', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Graduate Schools and Students', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-22T19:01:08+0000', 'document_type': 'article', 'news_desk': 'Education', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Daniel Grant', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Grant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2b6faf23-4f1e-5ea7-9b1b-3d475f9fd2fc', 'word_count': 427, 'uri': 'nyt://article/2b6faf23-4f1e-5ea7-9b1b-3d475f9fd2fc'}, {'abstract': 'The latest statistics from top law schools and full-time M.B.A. programs.', 'web_url': 'https://www.nytimes.com/2011/07/20/education/edlife/edl-24data.html', 'snippet': 'The latest statistics from top law schools and full-time M.B.A. programs.', 'lead_paragraph': 'The latest statistics from top law schools and full-time M.B.A. programs.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Admissions Tally', 'kicker': 'Data', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-22T19:01:09+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/17511fc4-32b8-53ce-a3d4-34ba229d4cc2', 'word_count': 11, 'uri': 'nyt://art