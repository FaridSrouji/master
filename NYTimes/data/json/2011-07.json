'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/83ee58fa-4c7b-5ad9-b5b3-2987d9e2edaa', 'word_count': 110, 'uri': 'nyt://article/83ee58fa-4c7b-5ad9-b5b3-2987d9e2edaa'}, {'abstract': 'Community leaders in Oakland, Calif., have started to reduce lead contamination in backyards by roto-tilling the soil with a paste of fishbone meal.', 'web_url': 'https://green.blogs.nytimes.com/2011/07/22/fish-bones-to-the-rescue/', 'snippet': 'Community leaders in Oakland, Calif., have started to reduce lead contamination in backyards by roto-tilling the soil with a paste of fishbone meal.', 'lead_paragraph': 'The over-the-transom response to my article in Thursday’s paper on the use of fish bones to neutralize toxic lead in residential yards was swift, and worthy of response here.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fish Bones to the Rescue', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bones', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hazardous and Toxic Substances', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Lead', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Oakland (Calif)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-22T12:17:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Felicity Barringer', 'person': [{'firstname': 'Felicity', 'middlename': None, 'lastname': 'Barringer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7e595537-78c4-5585-97d5-b42cdf4782ba', 'word_count': 532, 'uri': 'nyt://article/7e595537-78c4-5585-97d5-b42cdf4782ba'}, {'abstract': 'The ceremonies will take place Monday night at the St. James Theater.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/07/22/hair-encore-three-same-sex-marriages/', 'snippet': 'The ceremonies will take place Monday night at the St. James Theater.', 'lead_paragraph': 'Three gay couples who have ties to theater will wed on the Broadway stage of the St. James Theater on Monday night after the performance of the musical “Hair,” a day after New York State’s new marriage law takes effect. Among them is the Broadway actress Terri White, who received strong reviews in the 2009 Broadway revival of “Finian’s Rainbow” and will appear in the revival of “Follies” that begins next month.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Hair’ Encore: Three Same-Sex Marriages', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Creel, Gavin', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Domingo, Colman', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Eustis, Oskar', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Roth, Jordan', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'White, Terri', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Broadway Impact', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Jujamcyn Theaters', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Theater', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'St James Theater', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Theater Communications Group', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'v