ges/2011/07/17/magazine/17cover/17cover-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Miranda July Is Totally Not Kidding', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Make-Believer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mills, Mike (1966- )', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'July, Miranda', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-14T12:01:21+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Katrina Onstad', 'person': [{'firstname': 'Katrina', 'middlename': None, 'lastname': 'Onstad', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c47e39b-7aa7-5237-881a-b4aeac2dda5b', 'word_count': 4623, 'uri': 'nyt://article/9c47e39b-7aa7-5237-881a-b4aeac2dda5b'}, {'abstract': 'Surprise! Phony numbers.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/07/14/fannie-freddie-phooey/', 'snippet': 'Surprise! Phony numbers.', 'lead_paragraph': 'Over at The Big Picture, David Min has a terrific takedown of the claim that Fannie and Freddie caused the housing bubble. Every time you hear or read someone claiming that Fannie and Freddie were responsible for large amounts of subprime/risky lending, you should remember that this is based on essentially phony numbers: people at AEI invented their own definition of subprime, which isn’t the standard definition, and, more important, doesn’t work: the supposedly high-risk loans that F&F were making or buying were, demonstrably, not actually high-risk:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fannie Freddie Phooey', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keyword