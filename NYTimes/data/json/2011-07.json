ars old.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/27/dining/27REST_SPAN/27REST_SPAN-articleLarge.jpg', 'height': 385, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/27/dining/27REST_SPAN/27REST_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 385}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/27/dining/27REST_SPAN/27REST-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/27/dining/27REST_SPAN/27REST_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/27/dining/27REST_SPAN/27REST_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Palm and Palm Too', 'kicker': 'Restaurant Review', 'content_kicker': None, 'print_headline': 'At the Heart of the Steakhouse Beast', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Midtown Area (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-26T17:40:44+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'subsection_name': 'Dining & Wine', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7ef24194-46f7-5ae3-b143-8dfb1fd183f5', 'word_count': 1294, 'uri': 'nyt://article/7ef24194-46f7-5ae3-b143-8dfb1fd183f5'}, {'a