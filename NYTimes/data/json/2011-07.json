Kahn to make money.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/nyregion/sub-DSK-refer/sub-DSK-refer-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/nyregion/sub-DSK-refer/sub-DSK-refer-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/nyregion/sub-DSK-refer/sub-DSK-refer-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Housekeeper’s Lawyer Says She Was Misquoted', 'kicker': None, 'content_kicker': None, 'print_headline': 'Housekeeper’s Lawyer Says She Was Misquoted', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sex Crimes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wiretapping and Other Eavesdropping Devices and Methods', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Diallo, Nafissatou', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Strauss-Kahn, Dominique', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-28T02:34:50+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': "By Jim Dwyer, John Eligon and Anahad O'Connor", 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Dwyer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'John', 'middlename': None, 'lastname': 'Eligon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Anahad', 'middlename': None, 'lastname': "O'Connor", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 