2c7-95ce-d060ec9d3361'}, {'abstract': 'Many Americans watched the Casey Anthony trial, then talked about it on Twitter and Facebook.', 'web_url': 'https://www.nytimes.com/2011/07/06/business/media/06coverage.html', 'snippet': 'Many Americans watched the Casey Anthony trial, then talked about it on Twitter and Facebook.', 'lead_paragraph': 'As the lawyers for Casey Anthony gathered at a restaurant in Orlando, Fla., on Tuesday afternoon, two hours after a jury found their client not guilty of killing her daughter, Caylee, the television host Nancy Grace was sequestered in a studio one block away, delivering her own verdict of sorts.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Watching a Trial on TV, Discussing It on Twitter', 'kicker': None, 'content_kicker': None, 'print_headline': 'Watching a Trial on TV, Discussing It on Twitter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Facebook.com', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Anthony, Caylee Marie', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Anthony, Casey', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-07-06T01:52:39+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter and Jenna Wortham', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jenna', 'm