ame': None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/00a8097c-1e10-5040-97a2-86ce9503a2fe', 'word_count': 293, 'uri': 'nyt://article/00a8097c-1e10-5040-97a2-86ce9503a2fe'}, {'abstract': 'Time is finite, says the author Tony Schwartz, so “we need to learn to manage our energy rather than our time.”', 'web_url': 'https://www.nytimes.com/2011/07/24/jobs/24pre.html', 'snippet': 'Time is finite, says the author Tony Schwartz, so “we need to learn to manage our energy rather than our time.”', 'lead_paragraph': 'I CAN pinpoint the moment I realized that we’d reached a tipping point. It was almost exactly a year ago. I was standing in the parking lot of a large technology company in Silicon Valley, with a senior executive I’d come to know well. The company that employed him was widely viewed as a great place to work, and this executive is one of the most upbeat people I know.', 'print_section': 'BU', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/business/Pre/Pre-jumbo.jpg', 'height': 807, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/business/Pre/Pre-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/24/business/Pre/Pre-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Personal Energy Crisis', 'kicker': 'Preoccupations', 'content_kicker': None, 'print_headline': 'The Personal Energy Crisis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Working Hours', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fatigue', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sleep', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Environment', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-23T17:54:09+0000', 'document_type': 'article', 'news_desk': 'NAT', 'section_name': 'Job Market', 'byline': {'original': 'By Tony Schwartz', 'person': [{'firstname': 'Tony', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8328e84-cee2-517f-915a-0b427e0bfcc7', 'word_count': 767, 'uri': 'nyt://article/f8328e84-cee2-517f-915a-0b427e0bfcc7'}, {'abstract': 'Afghan officials expressed concern about more undetected militant camps within the country’s borders.', 'web_url': 'https://www.nytimes.com/2011/07/24/world/asia/24afghan.html', 'snippet': 'Afghan officials expressed concern about more undetected militant camps within the country’s borders.', 'lead_paragraph': 'KABUL, Afghanistan — The number of insurgents reported killed in a NATO attack on a large encampment in a remote area of Paktika Province rose to 80 on Saturday, said Afghan officials, adding that they were concerned that there could be more undetected militant camps within the country’s borders. ', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/24/world/asia/24afghan-map/24afghan-map-jumbo.jpg', 'height': 630, 'width': 454, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Toll Climbs to 80 in NATO Raid on Insurgent Camp in Southeastern Afghanistan', 'kicker': None, 'content_kicker': None, 'print_headline': 'Toll Climbs to 80 in NATO Raid on Insurgent Camp in Southeastern Afghanistan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War