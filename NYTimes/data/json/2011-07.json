f6'}, {'abstract': 'French tourists are flocking to the Franklin Street town house where Dominique Strauss-Kahn has been holed up for nearly six weeks.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/05/for-french-tourists-strauss-kahn-town-house-is-must-see/', 'snippet': 'French tourists are flocking to the Franklin Street town house where Dominique Strauss-Kahn has been holed up for nearly six weeks.', 'lead_paragraph': 'Louis Lelias, 30, skipped up to the door of 153 Franklin Street on Monday afternoon. He smiled broadly and stuck out his fist, extending his pinky and thumb to make a jovial “hang loose” hand gesture, as his wife snapped a picture. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For French Tourists, Strauss-Kahn Town House Is Must-See', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sex Crimes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Strauss-Kahn, Dominique', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'TriBeCa (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-05T20:49:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Adriane Quinlan', 'person': [{'firstname': 'Adriane', 'middlename': None, 'lastname': 'Quinlan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3eb9861-3179-546e-acef-8d78e673be62', 'word_count': 483, 'uri': 'nyt://article/e3eb9861-3179-546e-acef-8d78e673be62'}, {'abstract': 'Photographs from Kenya, India, South Sudan and Afghanistan.', 'web_url': 'https://lens.blogs.nytimes.com/2011/07/05/pictures-of-the-day-kenya-and-elsewhere-2/', 'snippet': 'Photographs from Kenya, India, South Sudan and Afghanistan.', 'lead_paragraph': 'Photographs from Kenya, India, South Sudan and Afghanistan.', '