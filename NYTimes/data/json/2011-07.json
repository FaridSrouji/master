icker': None, 'content_kicker': None, 'print_headline': 'Elliot Handler, Co-Founder Of Mattel Toys, Dies at 95', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Mattel Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Toys', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Barbie (Doll)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-23T02:24:23+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Charles Duhigg', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'Duhigg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/94fd3260-58e7-5217-9803-f27152d07075', 'word_count': 488, 'uri': 'nyt://article/94fd3260-58e7-5217-9803-f27152d07075'}, {'abstract': 'Tyler Hadley, 17, is accused of bludgeoning his parents to death with a hammer last Saturday. He gave a party for 60 people the evening after the killings.', 'web_url': 'https://www.nytimes.com/2011/07/23/us/23murder.html', 'snippet': 'Tyler Hadley, 17, is accused of bludgeoning his parents to death with a hammer last Saturday. He gave a party for 60 people the evening after the killings.', 'lead_paragraph': 'PORT ST. LUCIE, FLA. — Tyler Hadley was giving a party for 60 people at his home here last Saturday night when, according to police, he confessed to a friend that he had killed his parents. The friend refused to believe him, until the 17-year-old Mr. Hadley showed him a bloody shoe print in the garage. The friend entered the house and said he saw blood near the door of the master bedroom. When he opened it he saw a partly covered body sticking out from a heap of items on the floor.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'