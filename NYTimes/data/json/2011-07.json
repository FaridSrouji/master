', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf8a0c9e-7d5b-5d9a-9b50-7e0a07277c39', 'word_count': 1885, 'uri': 'nyt://article/cf8a0c9e-7d5b-5d9a-9b50-7e0a07277c39'}, {'abstract': 'A scene featuring Zoe Kravitz in "Yelling to the Sky," a film by Victoria Mahoney about a troubled multicultural family.', 'web_url': 'https://www.nytimes.com/video/multimedia/100000000891808/tk-stop-slamming-hed-for-mixed.html', 'snippet': 'A scene featuring Zoe Kravitz in "Yelling to the Sky," a film by Victoria Mahoney about a troubled multicultural family.', 'lead_paragraph': 'A scene featuring Zoe Kravitz in "Yelling to the Sky," a film by Victoria Mahoney about a troubled multicultural family.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/multimedia/video-slamming/video-slamming-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/01/multimedia/video-slamming/video-slamming-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/multimedia/video-slamming/video-slamming-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/01/multimedia/video-slamming/video-slamming-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': "'Yelling to the Sky'", 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-05T15:03:35+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/2e70b595-dafe-5741-9f15-7e0b7d415845', 'word_count': 0, 'uri': 'nyt://video/2e70b595-dafe-5741-9f15-7e0b7d415845'}, {'abstract': 'Of the two high-profile weddings that dominated the news circuit this week, who wore it best?', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/07/05/princess-brides-charlene-and-kate/', 'snippet': 'Of the two high-profile weddings that dominated the news circuit this week, who wore it best?', 'lead_paragraph': 'Two high-profile weddings dominated the news over the weekend: Charlene Wittstock, now Princess Charlene of Monaco, whose royal festivities blended fashion and the monarchy in Monte Carlo; and Kate Moss, the reigning princess of style whose guest list read like a mashup of NME and Tatler in the Cotswalds. T wants to know whose dress you prefer – Princess Charlene’s Armani Privé duchesse silk gown or Mrs. Hince’s Galliano floor-length dress with sequins and sheer detailing. Vote for your favorite look on T’s Facebook page: www.facebook.com/tmagazine.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Princess Brides |  Charlene and Kate', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-05T15:12:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b06c91de-a4c4-53b3-a3a7-a38d74c4d198', 'word_count': 86, 'uri': 'nyt://article/b06c91de-a4c4-53b3-a3a7-a38d74c4d198'}, {'abstract': 'On the first day that same-sex couples can apply for marriage licenses in New York City, a problem crops up.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/05/still-ironing-out-the-gay-marital-terminology/', 'snippet': 'On the first day that same-sex couples can apply for marriage licenses in New York City, a problem crops up.', 'lead_paragraph': 'Oh, brave new world of same-sex marriage bureaucracy! ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Still Ironing Out the Gay Marital Terminology', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-05T15:12:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/fd2e1ec7-cedb-50d4-967c-456605286e50', 'word_count': 118, 'uri': 'nyt://article/fd2e1ec7-cedb-50d4-967c-456605286e50'}, {'abstract': 'Competitors hurtle across an unstable surface at more than 60 m.p.h. while jockeying for position against hundreds of rivals — and without helmets, despite violent wipeouts.', 'web_url': 'https://www.nytimes.com/slideshow/2011/07/10/magazine/look-windsurfing.html', 'snippet': 'Competitors hurtle across an unstable surface at more than 60 m.p.h. while jockeying for position against hundreds of rivals — and without helmets, despite violent wipeouts.', 'lead_paragraph': 'Competitors hurtle across an unstable surface at more than 60 m.p.h. while jockeying for position against hundreds of rivals — and without helmets, despite violent wipeouts.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/10/magazine/look-windsurfing-slide-GCW1/look-windsurfing-slide-GCW1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtyp