ng to get cracking.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/movies/cowboys/cowboys-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/movies/cowboys/cowboys-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/movies/cowboys/cowboys-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/movies/cowboys/cowboys-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/movies/cowboys/cowboys-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Extraterrestrials Land at the O.K. Corral', 'kicker': "Movie Review | 'Cowboys & Aliens'", 'content_kicker': None, 'print_headline': 'Extraterrestrials Land At the O.K. Corral', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Favreau, Jon', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Craig, Daniel', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ford, Harrison', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wilde, Olivia', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-28T18:44:41+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 