estors.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/25/business/25VIEWS-BW/25VIEWS-BW-jumbo.jpg', 'height': 646, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Bing Becomes a Distraction for Microsoft', 'kicker': 'Reuters Breakingviews', 'content_kicker': None, 'print_headline': 'At Microsoft, Bing Too Costly to Keep', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Search Engines', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ratings and Rating Systems', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Government Bonds', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-25T03:20:43+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Robert Cyran and Martin Hutchinson', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Cyran', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Martin', 'middlename': None, 'lastname': 'Hutchinson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/78ac66db-01b4-5ee6-934e-51b6cf0738fc', 'word_count': 764, 'uri': 'nyt://article/78ac66db-01b4-5ee6-934e-51b6cf0738fc'}, {'abstract': 'As the N.F.L. prepares the get back to work, the only real winners so far are the lawyers, says William C. Rhoden.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/07/24/video-the-real-winners-of-the-n-f-l-lockout/', 'snippet': 'As the N.F.L. prepares the get back to work, the only real winners so far are the 