[{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/opinion/video-bhgoogle/video-bhgoogle-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/22/opinion/video-bhgoogle/video-bhgoogle-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/opinion/video-bhgoogle/video-bhgoogle-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/22/opinion/video-bhgoogle/video-bhgoogle-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Google+ vs. Facebook', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Google Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook.com', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-22T21:52:39+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'byline': {'original': 'None None', 'person': [{'firstname': 'None', 'middlename': None, 'lastname': 'None', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/189714b9-7e54-5b68-8565-dbb3646276f6', 'word_count': 0, 'uri': 'nyt://video/189714b9-7e54-5b68-8565-dbb3646276f6'}, {'abstract': 'Two sides of extreme weather at Union Square.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/22/its-soooo-coldhot-i-cant-wait-for-summerwinter/', 'snippet': 'Two sides of extreme weather at Union Square.', 'lead_paragraph': 'Just remember: 182 days ago, you were cursing the cold and praying for summer. O.K., maybe you were having fun building a snowman and wishing every day could be a winter wonderland. In any case, this too shall pass. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'It’s Soooo Cold/Hot. I Can’t Wait for Summer/Winter!', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-22T21:54:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/259cc67c-ee94-5703-a04b-7c80940b9e82', 'word_count': 40, 'uri': 'nyt://article/259cc67c-ee94-5703-a04b-7c80940b9e82'}, {'abstract': 'To accommodate as many people as possible, the studio built two touch video walls stretching 8 feet by 11 feet, allowing more than a dozen people at once to finger swipe through video marketing materials for upcoming movies.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/07/22/getting-interactive-at-comic-con-with-conan-the-barbarian/', 'snippet': 'To accommodate as many people as possible, the studio built two touch video walls stretching 8 feet by 11 feet, allowing more than a dozen people at once to finger swipe through video marketing materials for upcoming movies.', 'lead_paragraph': 'SAN DIEGO— Patience is often in short supply on Comic-Con’s trade show floor, where lines of fans waiting to get an autograph or check out a particular booth snake through the already gridlocked aisles. Lionsgate, the studio that “Saw” built, is normally one of the biggest line generators, because it loads its exhibit area with technology. Last year, for instance, the studio invited attendees to make videos of themselves trapped inside a coffin; Lionsgate then emailed them the result to share with their friends online. The stunt promoted “Buried,” a thriller starring Ryan Reynolds, and it was a huge Comic-Con hit (although it didn’t pay off in box office success).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Getting Interactive at Comic-Con With ‘Conan the Barbarian’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Comic-Con (Convention)', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-22T21:55:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/54b06db0-2343-5953-b487-2a36b23f9b13', 'word_count': 207, 'uri': 'nyt://article/54b06db0-2343-5953-b487-2a36b23f9b13'}, {'abstract': 'An all-Mendelssohn concert by the New Jersey Symphony at Princeton was interrupted, but that did not stop the entertainment.', 'web_url': 'https://www.nytimes.com/2011/07/23/arts/music/new-jersey-symphony-plays-mendelssohn-at-princeton-review.html', 'snippet': 'An all-Mendelssohn concert by the New Jersey Symphony at Princeton was interrupted, but that did not stop the entertainment.', 'lead_paragraph': 'PRINCETON, N.J. — The concert was supposed to be all Mendelssohn, but the sound of Gershwin’s “Summertime” was unmistakable, floating lazily through the early evening humidity.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/arts/guten/guten-articleLarge.jpg', 'height': 344, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/22/arts/guten/guten-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 344}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/arts/guten/guten-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Alfresco Surprises to Go With Mendelssohn', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Alfresco Surprises to Go With Mendelssohn', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New Jersey Symphony Orchestra', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-22T21:58:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fc5ff94f-a9a9-5f81-9eb4-fd3ddaec947d', 'word_count': 489, 'uri': 'nyt://article/fc5ff94f-a9a9-5f81-9eb4-fd3ddaec947d'}, {'abstract': 'As temperatures rose well above 100 degrees in New York on Friday, people across the city resorted to a variety of ways to cope.', 'web_url': 'https://www.nytimes.com/slideshow/2011/07/23/nyregion/20110723_HEAT.html', 'snippet': 'As temperatures rose well above 100 degrees in New York on Friday, people across the city resorted to a variety of ways to cope.', 'lead_paragraph': 'As temperatures rose well above 100 degrees in New York on Friday, people across the city resorted to a variety of ways to cope.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/nyregion/20110723_HEAT-slide-WNVD/20110723_HEAT-slide-WNVD-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/nyregion/20110723_HEAT-slide-WNVD/20110723_HEAT-slide-WNVD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/23/nyregion/20110723_HEAT-slide-WNVD/20110723_HEAT-slide-WNVD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Day of Relentless Heat', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weather', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Heating', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-22T22:01:11+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/118f6690-883b-5c14-9d08-681e7d205c69', 'word_count': 0, 'uri': 'nyt://slideshow/118f6690-883b-5c14-9d08-681e7d205c69'}, {'abstract': 'In “The Uncommitted,” Paul Taylor’s 134th dance, the pairings are fleeting.', 'web_url': 'https://www.nytimes.com/2011/07/23/arts/dance/the-uncommitted-by-paul-taylor-review.html', 'snippet': 'In “The Uncommitted,” Paul Taylor’s 134th dance, the pairings are fleeting.', 'lead_paragraph': 'DURHAM, N.C.—When it comes to peeling away the surface of a relationship to expose its defects — or that especially aggressive point where tension turns to hostility\xa0— the American choreographer Paul Taylor has a way of ripping off the bandage. Through his dances he reveals the meat of the human condition, and he likes it raw. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/arts/taylor/taylor-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/23/arts/taylor/taylor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/arts/taylor/taylor-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/arts/taylor/taylor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/23/arts/taylor/taylor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Ending Up All Alone, and Making It Beautiful', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Ending Up All Alone, And Making It Beautiful', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Paul', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'AMERICAN DANCE FESTIVAL', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-22T22:01:40+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Gia Kourlas', 'person': [{'firstname': 'Gia', 'middlename': None, 'lastname': 'Kourlas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/afcf1d1b-2ff4-5109-8454-3d9f04f3a94f', 'word_count': 804, 'uri': 'nyt://article/afcf1d1b-2ff4-5109-8454-3d9f04f3a94f'}, {'abstract': 'A slide show of photographs from the past week in New York City and the region. Subjects include a book party, same-sex marriage and a hot day in Newark.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/22/the-week-in-pictures-for-july-22/', 'snippet': 'A slide show of photographs from the past week in New York City and the region. Subjects include a book party, same-sex marriage and a hot day in Newark.', 'lead_paragraph': 'Here is a slide show of photographs from the past week in New York City and the region. Subjects include a book party, same-sex marriage, and a hot day in Newark.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Week in Pictures for July 22', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New York City', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-22T22:05:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/5ac3500d-962e-5abc-a438-9f6a0318f073', 'word_count': 145, 'uri': 'nyt://article/5ac3500d-962e-5abc-a438-9f6a0318f073'}, {'abstract': 'An early graffiti artist, TAKI 183, came to prominence through an article in The New York Times in 1971. That artist is still around.', 'web_url': 'https://www.nytimes.com/2011/07/23/arts/design/early-graffiti-artist-taki-183-still-lives.html', 'snippet': 'An early graffiti artist, TAKI 183, came to prominence through an article in The New York Times in 1971. That artist is still around.', 'lead_paragraph': 'A short Greek-American kid named Demetrius who lived on West 183rd Street in the late 1960s was by no means the first teenager to think of writing something in indelible ink on someone else’s property. He never considered himself an artist, and his illicit career of leaving his name and street number on hundreds, maybe thousands, of surfaces throughout the five boroughs of New York City ended after only a couple of years, when he put aside his Magic Marker and went off dutifully to college.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/arts/taki-1/taki-1-articleLarge.jpg', 'height': 349, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/23/arts/taki-1/taki-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 349}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/arts/taki-1/taki-1-jumbo.jpg', 'height': 796, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/arts/taki-1/taki-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/23/arts/taki-1/taki-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Celebrating Forefather of Graffiti', 'kicker': None, 'content_kicker': None, 'print_headline': 'Celebrating Forefather Of Graffiti', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graffiti', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-22T22:07:18+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/837631a8-2c43-5738-ba3c-963dff66a735', 'word_count': 809, 'uri': 'nyt://article/837631a8-2c43-5738-ba3c-963dff66a735'}, {'abstract': 'There are few things in life that I avoid as strenuously as video games. Sure, I played a bit of Pong and Pac Man in my day. But when games started becoming these immersive, life-devouring experiences, I stayed away. Not because I consider them stupid or beneath me. I don’t know whether such games make us smarter or if they represent important achievements of pop culture. All I know is that if I brought an Xbox into my apartment, I’m scared I might never do anything else.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/07/22/this-sunday-the-story-my-mom-will-try-to-skip/', 'snippet': 'There are few things in life that I avoid as strenuously as video games. Sure, I played a bit of Pong and Pac Man in my day. But when games started becoming these immersive, life-devouring experiences, I stayed away. Not because I consider them st...', 'lead_paragraph': 'There are few things in life that I avoid as strenuously as video games. Sure, I played a bit of Pong and Pac Man in my day. But when games started becoming these immersive, life-devouring experiences, I stayed away. Not because I consider them stupid or beneath me. I don’t know whether such games make us smarter or if they represent important achievements of pop culture. All I know is that if I brought an Xbox into my apartment, I’m scared I might never do anything else.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Sunday: The Story My Mom Will Try to Skip', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-22T22:07:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Hugo Lindgren', 'person': [{'firstname': 'Hugo', 'middlename': None, 'lastname': 'Lindgren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eec1946f-b68e-58d5-96ca-0261bafac244', 'word_count': 578, 'uri': 'nyt://article/eec1946f-b68e-58d5-96ca-0261bafac244'}, {'abstract': 'Let’s kick some can.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/07/22/war-of-the-rose/', 'snippet': 'Let’s kick some can.', 'lead_paragraph': 'David Brooks and me, on Charlie Rose tonight. No columnists were harmed in the making of this program — possibly because one was in northern Virginia and the other in central New Jersey.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'War of the Rose', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-22T22:09:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d38457a0-2d45-50a0-9a42-d1d6ad1ae3ef', 'word_count': 33, 'uri': 'nyt://article/d38457a0-2d45-50a0-9a42-d1d6ad1ae3ef'}, {'abstract': 'All the fashion news of the week that’s fit to reprint.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/07/22/chic-in-review-karl-lagerfeld-takes-herald-square/', 'snippet': 'All the fashion news of the week that’s fit to reprint.', 'lead_paragraph': 'All the fashion news of the week that’s fit to reprint.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chic in Review | Karl Lagerfeld Takes Herald Square', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-22T22:12:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Kathryn Branch', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Branch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5fcc4d2a-f5cf-53d8-8625-123e3008ca68', 'word_count': 390, 'uri': 'nyt://article/5fcc4d2a-f5cf-53d8-8625-123e3008ca68'}, {'abstract': 'Readers respond to recent articles.', 'web_url': 'https://www.nytimes.com/2011/07/24/fashion/letters.html', 'snippet': 'Readers respond to recent articles.', 'lead_paragraph': 'Reply All', 'print_section': 'ST', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Letters', 'kicker': None, 'content_kicker': None, 'print_headline': 'Letters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Letters', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-22T22:12:53+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/d5272f86-e473-5cae-abc5-7f1f523cfeb2', 'word_count': 269, 'uri': 'nyt://article/d5272f86-e473-5cae-abc5-7f1f523cfeb2'}, {'abstract': 'New hotter norms for American summers mesh well with old climate forecasts.', 'web_url': 'https://dotearth.blogs.nytimes.com/2011/07/22/living-with-the-greenhouse-effect/', 'snippet': 'New hotter norms for American summers mesh well with old climate forecasts.', 'lead_paragraph': '“Living with the greenhouse effect” was the subtitle of my October, 1988, cover story for Discover Magazine — my first lengthy exploration of the science pointing to a growing human influence on climate. The cover line on the piece, which followed a scorching summer across much of the country, was, “This summer was merely a warmup.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Living With the Greenhouse Effect', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Global Warming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tornadoes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Weather', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Cullen, Heidi', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gleick, Peter', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Hansen, James E', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Huffington Post', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'National Aeronautics and Space Administration', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'National Oceanic and Atmospheric Administration', 'rank': 10, 'major': 'N'}], 'pub_date': '2011-07-22T22:15:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew C. Revkin', 'person': [{'firstname': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2d76b66c-d561-57aa-9655-7b39ccb24586', 'word_count': 613, 'uri': 'nyt://article/2d76b66c-d561-57aa-9655-7b39ccb24586'}, {'abstract': 'Judith Light (ABC’s “Ugly Betty,” “Lombardi” on Broadway) will replace Linda Lavin as the sharp-tongued Silda in the Jon Robin Baitz play “Other Desert Cities.”', 'web_url': 'https://www.nytimes.com/2011/07/23/theater/light-to-broadway.html', 'snippet': 'Judith Light (ABC’s “Ugly Betty,” “Lombardi” on Broadway) will replace Linda Lavin as the sharp-tongued Silda in the Jon Robin Baitz play “Other Desert Cities.”', 'lead_paragraph': 'Judith Light (ABC’s “Ugly Betty,” “Lombardi” on Broadway) will replace Linda Lavin as the sharp-tongued Silda in the Jon Robin Baitz play “Other Desert Cities,” which transfers to the Booth Theater on Broadway in October after a run earlier this year at the Mitzi E. Newhouse Theater, presented by Lincoln Center Theater. Ms. Lavin is starring this fall in the Off Broadway play “The Lyons.”', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Light to Broadway', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Light to Broadway', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Light, Judith', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-22T22:16:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'Compiled by Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/f7efd75c-5da5-5c90-a5c3-85188706c783', 'word_count': 66, 'uri': 'nyt://article/f7efd75c-5da5-5c90-a5c3-85188706c783'}, {'abstract': 'For an easy, casual and satisfying meal with a minimal investment of time or money, make these sizzling pork-filled beauties at home.', 'web_url': 'https://www.nytimes.com/2011/07/27/dining/the-simple-pleasure-of-tacos-city-kitchen.html', 'snippet': 'For an easy, casual and satisfying meal with a minimal investment of time or money, make these sizzling pork-filled beauties at home.', 'lead_paragraph': 'THE appeal of tacos lies in their simplicity, in their hot-off-the-griddle-ness, their savory, spicy two bites of pleasure. I’ll admit I’ve eaten my share of tacos on the run, and happily, at market stalls south of the border, some unlikely joints in Texas and in downtown Manhattan. Part of the joy is the immediacy and the pace. Hunger sated, now. Another part is seeing a real taco master at work. I’ve patronized a popular place in San Francisco’s Mission district for more than 20 years. The tacos are excellent, but a big part of the draw is watching the sole longtime chef flipping tortillas, chopping meat and building beautiful tacos at incredible speed, never losing his cool. ', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/27/dining/27KITCH/27KITCH-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/27/dining/27KITCH/27KITCH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/27/dining/27KITCH/27KITCH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Simple Pleasure of Tacos', 'kicker': 'City Kitchen', 'content_kicker': None, 'print_headline': 'A Simple Pleasure To Fold And Eat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tacos', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Salsa (Condiment)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tortillas', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-22T22:24:57+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/87f22945-7099-5dc1-90d4-5191f0b0e551', 'word_count': 409, 'uri': 'nyt://article/87f22945-7099-5dc1-90d4-5191f0b0e551'}, {'abstract': "Judge Efrain Alvarado prepares to officiate at New York's first gay marriage ceremonies.", 'web_url': 'https://www.nytimes.com/video/nyregion/100000000961405/making-it-official.html', 'snippet': "Judge Efrain Alvarado prepares to officiate at New York's 