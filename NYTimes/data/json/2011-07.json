9fa7-54b6-8d9e-5502aa23f308', 'word_count': 561, 'uri': 'nyt://article/2532518d-9fa7-54b6-8d9e-5502aa23f308'}, {'abstract': 'Otherworldly singing is the premise of “Voca People,” at the Westside Theater.', 'web_url': 'https://www.nytimes.com/2011/07/15/theater/reviews/voca-people-at-westside-theater-review.html', 'snippet': 'Otherworldly singing is the premise of “Voca People,” at the Westside Theater.', 'lead_paragraph': 'There was a time when a cappella was one of music’s best-kept secrets. Relatively few people were aware of just how sophisticated the genre had become or how many sounds the best a cappella singers could draw on: not just standard notes, but vocal percussion, orchestral imitation and more. ', 'print_section': 'C', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/15/arts/VOCA/VOCA-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/15/arts/VOCA/VOCA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/15/arts/VOCA/VOCA-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/15/arts/VOCA/VOCA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/15/arts/VOCA/VOCA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Harmonies From Outer Space', 'kicker': "Theater Review | 'Voca People'", 'content_kicker': None, 'print_headline': 'Harmonies From Outer Space', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-14T21:57:31+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/94543249-7507-5567-8f2c-099ddcbd8168', 'word_count': 349, 'uri': 'nyt://article/94543249-7507-5567-8f2c-099ddcbd8168'}, {'abstract': 'With the trading deadline just a little over two weeks away, the Red Sox, the Yankees and the Rays are jockeying for position.', 'web_url': 'https://bats.blogs.nytimes.com/2011/07/14/keeping-score-sizing-up-trade-needs-in-the-a-l-east/', 'snippet': 'With the trading deadline just a little over two weeks away, the Red Sox, the Yankees and the Rays are jockeying for position.', 'lead_paragraph': 'For the last three seasons, the Red Sox, the Yankees and the Rays have jockeyed among themselves for the American League East title and the A.L.’s wild-card berth, with each team missing the playoffs once. In 2011, these three teams are again atop the East, with the Red Sox leading at the All-Star Game break and the Rays having the most ground to make up.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Keeping Score: Sizing Up Trade Needs in the A.L. East', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Red Sox', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Tampa Bay Rays', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-14T21:59:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Sean Forman', 'person': [{'firstname': 'Sean', 'middlename': None, 'lastname': 'Forman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e57da490-9efe-5fd9-8d81-75025c76090a', 'word_count': 762, 'uri': 'nyt://article/e57da490-9efe-5fd9-8d81-75025c76090a'}, {'abstract': 'Even when dancers take a break, Alastair Macaulay writes, the ballerinas of Degas and Lancret twirl on.', 'web_url': 'https://www.nytimes.com/2011/07/15/arts/dance/dance-in-museums-degas-and-lancret.html', 'snippet': 'Even when dancers take a break, Alastair Macaulay writes, the ballerinas of Degas and Lancret twirl on.', 'lead_paragraph': 'In those rare lulls when there’s no live dance to see in New York — summer brings a few — there’s still dance in its galleries. At the Metropolitan Museum, I start on the ground floor with the Hellenistic bronze of a veiled and masked dancer, less than nine inches tall. A masterpiece of implication, it firmly shows, by means of surface alone, the lines and twists of the dancing figure beneath layers of fabric. At the Museum of Modern Art, in Matisse’s painting “La Danse,” five nude women create an image of primeval dance as they circle before an empty blue sky and a green grass sward.', 'print_section': 'C', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/15/arts/MACAULAY/MACAULAY-articleLarge.jpg', 'height': 209, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/15/arts/MACAULAY/MACAULAY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 209}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/15/arts/MACAULAY/MACAULAY-jumbo.jpg', 'height': 357, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/15/arts/MACAULAY/MACAULAY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/15/arts/MACAULAY/MACAULAY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Always Moving, Always Frozen', 'kicker': 'The Hot List | Dance', 'content_kicker': None, 'print_headline': 'Always Moving, Always Frozen', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-14T22:02:07+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7650c97a-818d-5405-93da-a0a637853796', 'word_count': 317, 'uri': 'nyt://article/7650c97a-818d-5405-93da-a0a637853796'}, {'abstract': 'The soprano Deborah Voigt, known for portraying Strauss and Wagner heroines, will be packing heat in the title role of “Annie Get Your Gun” at the Glimmerglass Opera Festival.', 'web_url': 'https://www.nytimes.com/2011/07/15/arts/music/deborah-voigt-stars-in-annie-get-your-gun.html', 'snippet': 'The soprano Deborah Voigt, known for portraying Strauss and Wagner heroines, will be packing heat in the title role of “Annie Get Your Gun” at the Glimmerglass Opera Festival.', 'lead_paragraph': 'COOPERSTOWN, N.Y.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'c