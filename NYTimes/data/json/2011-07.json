1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/12/business/12flier-1/12flier-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'European Airfares Look Inviting Next to U.S. Prices', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Edge in Airfares', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'United States', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-11T19:59:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Susan Stellin', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Stellin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/51eb49a7-ef1c-5085-8e7d-4e8574ae1535', 'word_count': 969, 'uri': 'nyt://article/51eb49a7-ef1c-5085-8e7d-4e8574ae1535'}, {'abstract': 'The first passes for the first days that the museum will be open were reserved within a few hours.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/11/demand-strong-to-visit-911-memorial/', 'snippet': 'The first passes for the first days that the museum will be open were reserved within a few hours.', 'lead_paragraph': 'Despite a technical hiccup that temporarily prevented some people from reserving tickets to the 9/11 Memorial when it opens to the public, 5,000 passes were distributed within the first hour after the ticket system opened at 9 this morning. Within several hours, 11,000 passes had been reserved.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Demand Strong to Visit 9/11 Memorial', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Monuments and Memorials', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'September 11 (2001)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'World Trade Center (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-11T20:00:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Sydney Ember', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Ember', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f94baa4-84ba-525b-a6bf-581d072990bc', 'word_count': 279, 'uri': 'nyt://article/5f94baa4-84ba-525b-a6bf-581d072990bc'}, {'abstract': 'The Brooklyn-based artist Kenneth E. Parris III is on tour with members of the Merce Cunningham Dance Company, documenting their two-year Legacy Tour.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/07/11/drawing-dance-a-visit-to-purchase-college/', 'snippet': 'The Brooklyn-based artist Kenneth E. Parris III is on tour with members of the Merce Cunningham Dance Company, documenting their two-year Legacy Tour.', 'lead_paragraph': 'The Brooklyn-based artist Kenneth E. Parris III is on tour with members of the Merce Cunningham Dance Company, documenting their two-year Legacy Tour through a series of drawings and paintings. After 58 years, the company is scheduled to disband on New Year’s Day 2012. This is the fourth in a series of graphite drawings he plans to create from the road, providing a front-row seat to the final weeks of the company’s journey. This week’s entry is from Purchase College.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Drawing Dance: A Visit to Purchase College', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New Year', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Cunningham, Merce, Dance Co', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'State University of New York at Purchase', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-11T20:00:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/36dd0ec0-aa55-5a60-9fc4-f7ae92047c73', 'word_count': 161, 'uri': 'nyt://article/36dd0ec0-aa55-5a60-9fc4-f7ae92047c73'}, {'abstract': 'The city has encouraged green efforts like solar panels, but thus far the number of residences to install the panels has been very small. The approval process can be daunting.', 'web_url': 'https://www.nytimes.com/2011/07/12/nyregion/solar-energy-slowly-grows-in-new-york-homes.html', 'snippet': 'The city has encouraged green efforts like solar panels, but thus far the number of residences to install the panels has been very small. The approval process can be daunting.', 'lead_paragraph': 'When Ed and Paula Antonio moved from a small home in Marine Park, Brooklyn, to a roughly 3,000-square-foot house in Belle Harbor, Queens, they realized that with all that space and a central air-conditioning system, their electricity costs would run much higher. So after intensive research and analysis and the bids of five contractors, they paid $72,000 to install 42 solar panels on their new roof. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/12/nyregion/appraisal1/appraisal1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/12/nyregion/appraisal1/appraisal1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/12/nyregion/appraisal1/appraisal1-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Solar Panels Still Rare, Despite Glow of $7 Power Bills', 'kicker': 'The Appraisal', 'content_kicker': None, 'print_headline': 'Solar Panels Still Rare, Despite Glow of $7 Power Bills', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Solar Energy', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Buildings Department (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Credits, Deductions and Exemptions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Housing and Real Estate', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-11T20:05:18+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Diane Cardwell', 'person': [{'firstname': 'Diane', 'middlename': None, 'lastname': 'Cardwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3c393a1-7e75-5048-9ba1-16976daeae7f', 'word_count': 1015, 'uri': 'nyt://article/e3c393a1-7e75-5048-9ba1-16976daeae7f'}, {'abstract': 'As it pursues its case against Washington Mutual’s former executives, the F.D.I.C. has adopted a new clawback rule for failed banks to reclaim executive compensation.', 'web_url': 'https://dealbook.nytimes.com/2011/07/11/using-clawbacks-to-punish-bank-executives/', 'snippet': 'As it pursues its case against Washington Mutual’s former executives, the F.D.I.C. has adopted a new clawback rule for failed banks to reclaim executive compensation.', 'lead_paragraph': 'A common complaint has been the absence of pros