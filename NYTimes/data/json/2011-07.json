8ad73', 'word_count': 238, 'uri': 'nyt://article/ff51f719-41ae-51ff-ade0-cae35568ad73'}, {'abstract': 'A letter to the editor.', 'web_url': 'https://www.nytimes.com/2011/07/19/health/19letters-TOVACCINATEO_LETTERS.html', 'snippet': 'A letter to the editor.', 'lead_paragraph': 'To the Editor:', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'To Vaccinate or Not (1 Letter)', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'To Vaccinate or Not', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-18T20:59:21+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/c0a716de-c5fa-5c97-94b8-5a2215a3d418', 'word_count': 125, 'uri': 'nyt://article/c0a716de-c5fa-5c97-94b8-5a2215a3d418'}, {'abstract': 'Tourneau tapped the Apple store designers to make its new Madison Avenue concept store more user-friendly.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/07/18/its-about-time-a-nouveau-tourneau/', 'snippet': 'Tourneau tapped the Apple store designers to make its new Madison Avenue concept store more user-friendly.', 'lead_paragraph': 'Blocks away from its clock swamped, tourist-enticing flagship “Time Machine” store on 57th Street, Tourneau has just opened a new concept store. Same time zone, different world. Created by Eight Inc., the designers behind the state-of-the-art Apple stores, this soaring modernist space eschews the traditional “behind-the-counter” retail approach in favor of a more user-friendly shopping experience. Eight large watch tables allow for accessible, easy viewing from all sides, while\xa0digital screens embedded in walls feature informative, up-to-the-minute videos. The store also features its own Rolex boutique — New York City’s first — which occupies almost a third of the space. To celebrate the new Madison Avenue location, Tourneau has launched a new line of timepieces, the TNY series, with the clean lines and strong look of the city that inspired it. The Rush Hour watch, made from the high performance alloy DLC, features numerals and hands in vivid yellow. Hey taxi!', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'It’s About Time | A Nouveau Tourneau', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-18T21:00:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Bruce Pask', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Pask', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24c4c003-526c-50ba-b5ce-955471304d4e', 'word_count': 158, 'uri': 'nyt://article/24c4c003-526c-50ba-b5ce-955471304d4e'}, {'abstract': 'Robert Reich, the former labor secretary, says the economic problem isn’t that consumers have been profligate, but that incomes have not kept up with the economy.', 'web_url': 'https://economix.blogs.nytimes.com/2011/07/18/a-consumer-bust-or-a-wage-bust/', 'snippet': 'Robert Reich, the former labor secretary, says the economic problem isn’t that consumers have been profligate, but that incomes have not kept up with the economy.', 'lead_paragraph': 'Robert Reich, the professor, blogger and former labor secretary, sent the following e-mail in response to my Sunday column on the great consumer bust:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Consumer Bust? Or a Wage Bust?', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Consumer Behavior', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Income', 'rank': 2, '