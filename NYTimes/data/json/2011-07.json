s', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-08T01:25:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Doug Glanville', 'person': [{'firstname': 'Doug', 'middlename': None, 'lastname': 'Glanville', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/243e2e73-81c2-5ec3-800f-9243ae57069b', 'word_count': 937, 'uri': 'nyt://article/243e2e73-81c2-5ec3-800f-9243ae57069b'}, {'abstract': 'A federal appeals court upended the rule that one company may own a broadcast outlet and a newspaper in the same municipality, but little immediate impact is expected.', 'web_url': 'https://www.nytimes.com/2011/07/08/business/fcc-cross-ownership-rule-is-overturned.html', 'snippet': 'A federal appeals court upended the rule that one company may own a broadcast outlet and a newspaper in the same municipality, but little immediate impact is expected.', 'lead_paragraph': 'In a narrow ruling unlikely to have an immediate effect on current broadcasters, a federal appeals court on Thursday overturned a 2008 decision by the Federal Communications Commission to relax restrictions on cross-ownership of newspapers and broadcast outlets in the same city.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Court Overturns F.C.C. Cross-Ownership Rule', 'kicker': None, 'content_kicker': None, 'print_headline': 'Court Overturns F.C.C. Cross-Ownership Rule', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Newspapers', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Communications Commission', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 4, 'major': 'N'}], 'pub_da