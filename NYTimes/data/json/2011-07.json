int_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-25T21:35:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Tara Parker-Pope', 'person': [{'firstname': 'Tara', 'middlename': None, 'lastname': 'Parker-Pope', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1a8dd324-28b1-5c16-a996-7c9ca0a5e3fc', 'word_count': 224, 'uri': 'nyt://article/1a8dd324-28b1-5c16-a996-7c9ca0a5e3fc'}, {'abstract': 'More than 10 percent of adults and children suffer from migraine, which is three times as common in women and girls as in men and boys.', 'web_url': 'https://well.blogs.nytimes.com/2011/07/25/migraine-miseries-push-patients-to-ways-of-coping/', 'snippet': 'More than 10 percent of adults and children suffer from migraine, which is three times as common in women and girls as in men and boys.', 'lead_paragraph': 'The news that the presidential candidate Michele Bachmann suffers from severe migraines has touched off a national discussion about a surprisingly common disorder that is little understood and often undertreated.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Migraine Miseries Push Patients to Ways of Coping', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Migraine Headaches', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-25T21:40:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Tara Parker-Pope', 'person': [{'firstname': 'Tara', 'middlename': None, 'lastname': 'Parker-Pope', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e132693c-5d98-5b0f-9abe-891afb2fb18d', 'word_count': 893, 'uri': 'nyt://article/e132693c-5d98-5b0f-9abe-891afb2fb18d'}, {'abstract': 'On Sunday at the Museum of Modern Art, the New Juilliard Ensemble offered a concise overview of contemporary quartet composition.', 'web_url': 'https://www.nytimes.com/2011/07/26/arts/music/new-juilliard-ensemble-at-moma-review.html', 'snippet': 'On Sunday at the Museum of Modern Art, the New Juilliard Ensemble offered a concise overview of contemporary quartet composition.', 'lead_paragraph': 'From Haydn’s time on, quartets have been laboratories in which composers can experiment freely, using the ensemble’s balanced texture as ballast for their boldest ideas and often finding ways to charm and startle at the same time. For its second and final contribution to this year’s Summergarden series at the Abby Aldrich Rockefeller Sculpture Garden of the Museum of Modern Art, on Sunday evening, the New Juilliard Ensemble offered a concise overview of contemporary quartet composition that touched on several contrasting approaches: among them the painterly, the emotional, the dramatic and the abstract. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/26/arts/ensemble/ensemble-jumbo.jpg', 'height': 1024, 'width': 639, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/26/arts/ensemble/ensemble-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/26/arts/