 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/dc60a208-51d2-5ca5-9c86-31ac9d8f34ec', 'word_count': 1118, 'uri': 'nyt://article/dc60a208-51d2-5ca5-9c86-31ac9d8f34ec'}, {'abstract': 'Yasushi Furukawa of Saga Prefecture must decide whether to support a request by Prime Minister Naoto Kan to restart two reactors at a local nuclear plant.', 'web_url': 'https://www.nytimes.com/2011/07/03/world/asia/03japan.html', 'snippet': 'Yasushi Furukawa of Saga Prefecture must decide whether to support a request by Prime Minister Naoto Kan to restart two reactors at a local nuclear plant.', 'lead_paragraph': 'SAGA, Japan — In a nation plagued by weak political leadership, it has fallen to the local governor of an obscure southern prefecture to make a crucial decision that could help determine the future of nuclear power in Japan after the Fukushima Daiichi accident.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/world/03japan2/03japan2-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/03/world/03japan2/03japan2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/world/03japan2/JAPAN-2-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/03/world/03japan2/03japan2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/03/world/03japan2/03japan2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Governor’s Power to Shap