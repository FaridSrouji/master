9/arts/29GUARD_SPAN/29GUARD-articleLarge.jpg', 'height': 340, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/29/arts/29GUARD_SPAN/29GUARD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 340}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/29/arts/29GUARD_SPAN/29GUARD-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/29/arts/29GUARD_SPAN/29GUARD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/29/arts/29GUARD_SPAN/29GUARD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Mismatched Partners in a Crime Comedy', 'kicker': "Movie Review | 'The Guard'", 'content_kicker': None, 'print_headline': 'Mismatched Partners In a Crime Comedy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gleeson, Brendan', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cheadle, Don', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McDonagh, John Michael', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-29T00:22:07+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/06bc80ce-e572-5da4-8127-d436db7f4750', 'word_count': 840, 'uri': 'nyt://article/06bc80ce-e572-5da4-8127-d436db7f4750'}, {'abstract': 'The second-quarter results of both banks highlighted the improved mar