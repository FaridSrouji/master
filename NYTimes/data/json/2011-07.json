eo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Yankees', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Colon, Bartolo', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Girardi, Joe', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-16T01:49:11+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7e66831-7308-5fd5-8be0-7f7475279735', 'word_count': 772, 'uri': 'nyt://article/c7e66831-7308-5fd5-8be0-7f7475279735'}, {'abstract': 'Barretto Point Park in Hunts Point, once a neglected stretch of waterfront, is now a summer getaway that fans strive to keep secret.', 'web_url': 'https://www.nytimes.com/2011/07/17/nyregion/barretto-point-park-a-secret-oasis-in-the-bronx.html', 'snippet': 'Barretto Point Park in Hunts Point, once a neglected stretch of waterfront, is now a summer getaway that fans strive to keep secret.', 'lead_paragraph': 'ELIZABETH GOMEZ feels a little protective about her beach. It’s a tiny crescent of sand, tucked between a thicket of reeds and some gently lapping waves, where she and five friends stretched out on blankets one recent sweltering Saturday, savoring their seclusion.', 'print_section': 'MB', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/nyregion/17PARK1_SPAN/17PARK1_SPAN-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/17/nyregion/17PARK1_SPAN/17PARK1_SPAN-articleLarge.jpg', 'xlarge