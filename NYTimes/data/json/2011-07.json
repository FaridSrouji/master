name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bowie, David', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-22T14:30:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dwight Garner', 'person': [{'firstname': 'Dwight', 'middlename': None, 'lastname': 'Garner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/606b7ebe-1dee-5c81-9392-363c175e028e', 'word_count': 164, 'uri': 'nyt://article/606b7ebe-1dee-5c81-9392-363c175e028e'}, {'abstract': 'A gunman stalked youths at an island summer camp for young members of the governing party after explosions in Oslo hit government buildings. The police seized a man officials described as a right-wing extremist in connection with both attacks.', 'web_url': 'https://www.nytimes.com/2011/07/23/world/europe/23oslo.html', 'snippet': 'A gunman stalked youths at an island summer camp for young members of the governing party after explosions in Oslo hit government buildings. The police seized a man officials described as a right-wing extremist in connection with both attacks.', 'lead_paragraph': 'OSLO — A lone political extremist bombed the government center here on Friday, killing 7 people, the police said, before heading to an island summer camp for young members of the governing Labor Party and killing at least 80 people.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/23/world/23oslo_span10/23oslo_span10-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/23/world/23oslo_span10/23oslo_span10-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo',