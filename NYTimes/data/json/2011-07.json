me': 'Liz', 'middlename': None, 'lastname': 'Alderman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd9e3999-29ce-5b0c-8413-27a00777f4e6', 'word_count': 1158, 'uri': 'nyt://article/dd9e3999-29ce-5b0c-8413-27a00777f4e6'}, {'abstract': 'The 18 teams in Major League Soccer have already broken the league record for scoreless ties less than halfway through the 2011 season.', 'web_url': 'https://goal.blogs.nytimes.com/2011/07/05/in-m-l-s-when-a-good-result-is-bad/', 'snippet': 'The 18 teams in Major League Soccer have already broken the league record for scoreless ties less than halfway through the 2011 season.', 'lead_paragraph': 'One of the more distressing euphemisms of soccer is “the good result,” a win, but more often a tie on the road. A point is a point, whether it be a 3-3 or 0-0 game. In Major League Soccer, where two coaches have already lost their jobs this season and making the playoffs is crucial, caution is accepted as the best strategy, especially on the road.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In M.L.S., When a ‘Good Result’ Is Bad', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Soccer', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-05T15:53:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c1208ae-d4db-5345-ac8b-312a10d2a514', 'word_count': 679, 'uri': 'nyt://article/6c1208ae-d4db-5345-ac8b-312a10d2a514'}, {'abstract': 'Most of the features in Google’s new social networking venture, Google+, can be found elsewhere on the Web. But Hangouts, a virtual chatting service, may keep users coming back for more.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2011/07/05/is-googles-hangouts-its-killer-app/', 'snippet': 'Most of the features in Google’s new social networking venture, Google+, can be found elsewhere on the Web. But Hangouts, a virtual chatting service, may keep users coming back for more.', 'lead_paragraph': 'Last night a chatroom changed my life. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Digital Diary: Is Google’s Hangouts Its Killer App?', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Incorporated', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook.com', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Skype Technologies', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-07-05T15:54:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eb4511cf-eb61-532c-a310-890ce63bdcc0', 'word_count': 555, 'uri': 'nyt://article/eb4511cf-eb61-532c-a310-890ce63bdcc0'}, {'abstract': 'A judge said she would not accept a plea agreement for Mr. Nelson that stemmed from a 2010 drug arrest and said a local prosecutor was giving the singer preferential treatment because he is famous.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/07/05/case-of-willie-nelson-pot-bust-isnt-extinguished-yet/', 'snippet': 'A judge said she would not accept a plea agreement for Mr. Nelson that stemmed from a 2010 drug arrest and said a local prosecutor was giving the singer preferential treatment because he is famous.', 'lead_paragraph': 'The seemingly routine occurrence of Willie Nelson’s being found in possession of marijuana has stoked a small conflagration in a Texas county where a judge says she will not permit what she sees as the lenient punishment of this singer by an overly deferential prosecutor. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Case of Willie Nelson Pot Bust Isn’t Extinguished Yet', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Country Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Marijuana', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nelson, Willie', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Border Patrol (US)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-07-05T16:00:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9dd17a5-c309-5f67-ad3a-ee4d92612839', 'word_count': 471, 'uri': 'nyt://article/f9dd17a5-c309-5f67-ad3a-ee4d92612839'}, {'abstract': 'Is fan pressure keeping gay soccer players from coming out?', 'web_url': 'https://goal.blogs.nytimes.com/2011/07/05/would-top-clubs-and-their-fans-support-a-gay-player/', 'snippet': 'Is fan pressure keeping gay soccer players from coming out?', 'lead_paragraph': 'For a number of English Premier League clubs, this week marks the beginning of preseason training. It comes only days after the British government followed up its recently launched charter to tackle homophobia and transphobia in sports by holding a reception for the lesbian, gay, bisexual and transgender community, hosted by Prime Minister David Cameron.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Would Top Clubs and Their Fans Support a Gay Player?', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-05T16:00:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Simon Clancy', 'person': [{'firstname': 'Simon', 'middlename': None, 'lastname': 'Clancy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2527dbce-676c-5c20-89a0-cd9a9d908377', 'word_count': 933, 'uri': 'nyt://article/2527dbce-676c-5c20-89a0-cd9a9d908377'}, {'abstract': 'Long before Ellen DeGeneres and Portia de Rossi, there was Gertrude Stein and Alice B. Toklas.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/07/05/a-paper-doll-is-a-paper-doll-is-a-paper-doll/', 'snippet': 'Long before Ellen DeGeneres and Portia de Rossi, there was Gertrude Stein and Alice B. Toklas.', 'lead_paragraph': 'Long before Ellen DeGeneres and Portia de Rossi, there was Gertrude Stein and Alice B. Toklas. The brilliantly eccentric couple made myriad contributions to the arts in the early-to-mid-20th century, notably as the hostesses of their legendary artist salons. They befriended and championed Picasso, Matisse and Hemingway and also extended their network to other modernist creatives (many of them gay).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Paper Doll Is a Paper Doll Is a Paper Doll', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dolls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stein, Gertrude', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Toklas, Alice B', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Contemporary Jewish Museum (San Francisco, Calif)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-07-05T16:09:36+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Yuri Chong', 'person': [{'firstname': 'Yuri', 'middlename': None, 'lastname': 'Chong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b7ccedd2-b32d-5e0d-9470-5fe068e536a9', 'word_count': 172, 'uri': 'nyt://article/b7ccedd2-b32d-5e0d-9470-5fe068e536a9'}, {'abstract': 'Questions and answers about “Some With Histories of Mental Illness Petition to Get Their Gun Rights Back,” by Michael Luo of The New York Times.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/07/05/gun-rights-and-mental-illness-answering-readers-questions/', 'snippet': 'Questions and answers about “Some With Histories of Mental Illness Petition to Get Their Gun Rights Back,” by Michael Luo of The New York Times.', 'lead_paragraph': '5:52 p.m. | Updated In an article in The New York Times on Sunday, Michael Luo examined how states across the country were increasingly allowing people who lost their firearm rights because of mental illness to petition to have those rights restored.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gun Rights and Mental Illness: Answering Readers’ Questions', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Luo, Michael', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-05T16:11:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Michael Luo', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Luo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4582f9cd-4867-5fff-b3d0-0e1f199c2829', 'word_count': 2093, 'uri': 'nyt://article/4582f9cd-4867-5fff-b3d0-0e1f199c2829'}, {'abstract': 'Members of Albert Fritsch’s family descended on Grand Central Terminal to visit a family heirloom (and 45-pound tchotchke) that is now the three-dimensional centerpiece of the exhibition “The Once and Future Pennsylvania Station.”', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/05/after-a-half-century-a-penn-station-eagle-returns/', 'snippet': 'Members of Albert Fritsch’s family descended on Grand Central Terminal to visit a family heirloom (and 45-pound tchotchke) that is now the three-dimensional centerpiece of the exhibition “The Once and Future Pennsylvania Station.”', 'lead_paragraph': 'Members of Albert Fritsch’s family descended on Grand Central Terminal on Friday to visit a family heirloom (and 45-pound tchotchke) that is now the three-dimensional centerpiece of the exhibition “The Once and Future Pennsylvania Station.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Half a Century, a Penn Station Eagle Returns', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-05T16:16:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By DAVID W. DUNLAP', 'person': [{'firstname': 'David', 'middlename': 'W.', 'lastname': 'DUNLAP', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/17c2f114-95d2-5451-8c24-5ab8ed6f42ab', 'word_count': 641, 'uri': 'nyt://article/17c2f114-95d2-5451-8c24-5ab8ed6f42ab'}, {'abstract': 'There is nothing like a little outbreak of meaningless Yankee panic in early July.', 'web_url': 'https://www.nytimes.com/2011/07/06/sports/rivera-sits-and-panic-ensues.html', 'snippet': 'There is nothing like a little outbreak of meaningless Yankee panic in early July.', 'lead_paragraph': 'Even if you are not a Yankees fan — and thankfully not everyone gravitates to the best team money can attempt to buy. How boring would that be? — you might have to admit they do have the ability to be entertaining no matter where you fall on the love-hate scale. Because there is nothing like a little outbreak of meaningless Yankee panic in early July to make you pour yourself a glass of lemonade, sit back and enjoy. It’s kind of like fireworks, only louder.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rivera Sits and Panic Ensues', 'kicker': 'Leading Off', 'content_kicker': None, 'print_headline': 'Rivera Sits and Panic Ensues', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rivera, Mariano', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jeter, Derek', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-05T16:18:07+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63c894b4-edf6-593f-9ff7-50397c1def3c', 'word_count': 819, 'uri': 'nyt://article/63c894b4-edf6-593f-9ff7-50397c1def3c'}, {'abstract': 'Still battling injuries to his left knee and Achilles’ tendon, Tiger Woods announced on his Web site that he would not play in the British Open at Royal St. George’s next week.', 'web_url': 'https://www.nytimes.com/2011/07/06/sports/golf/2011-british-open-leg-injuries-keep-tiger-woods-out.html', 'snippet': 'Still battling injuries to his left knee and Achilles’ tendon, Tiger Woods announced on his Web site that he would not play in the British Open at Royal St. George’s next week.', 'lead_paragraph': 'Tiger Woods announced Tuesday on his Web site that he would not play in the British Open next week at Royal St. George’s in Sandwich, England.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Woods to Skip British Open', 'kicker': None, 'content_kicker': None, 'print_headline': 'Woods to Skip British Open', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'British Open (Golf)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Woods, Tiger', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-05T16:20:19+0000', 'document_