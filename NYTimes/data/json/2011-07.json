': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-21T20:48:01+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Theater', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/f90fd1db-4176-52ef-8db8-bb54fc1ae8b5', 'word_count': 3856, 'uri': 'nyt://article/f90fd1db-4176-52ef-8db8-bb54fc1ae8b5'}, {'abstract': 'The staff at Eastern State Penitentiary in Philadelphia, now a museum, has been researching and protecting paintings a prisoner made while incarcerated there.', 'web_url': 'https://www.nytimes.com/2011/07/22/arts/design/prisoner-art-at-eastern-state-penitentiary-philadelphia.html', 'snippet': 'The staff at Eastern State Penitentiary in Philadelphia, now a museum, has been researching and protecting paintings a prisoner made while incarcerated there.', 'lead_paragraph': 'In 1955 a remorseful prisoner at Eastern State Penitentiary in Philadelphia started expressing his newfound Roman Catholic faith on the jailhouse walls. The inmate, Lester Smith, had been convicted of a string of armed robberies. At first, while in his prison cell, he painted portraits of saints. Then the Eastern State staff noticed his talent and invited him to line the Catholic chaplain’s office suite with biblical murals.', 'print_section': 'C', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/arts/22antiques/22antiques-jumbo.jpg', 'height': 951, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/arts/22antiques/22antiques-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/22/arts/22antiques/22antiques-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Penitentiary Restores Prisoner’s Biblical Murals', 'kicker': 'Antiques', 'content_kicker': None, 'print_headline': 'Penitentiary Restores Prisoner’s Biblical Murals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ANTIQUES', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-07-21T20:48:57+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Eve M. Kahn', 'person': [{'firstname': 'Eve', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92c9a5df-594a-57fc-b831-44e95387e0b3', 'word_count': 1062, 'uri': 'nyt://article/92c9a5df-594a-57fc-b831-44e95387e0b3'}, {'abstract': 'A listing of events around town.', 'web_url': 'https://www.nytimes.com/2011/07/22/arts/spare-times-july-22-28.html', 'snippet': 'A listing of events around town.', 'lead_paragraph': 'Staten Island Outloud: Bessie Coleman (Saturday) She left a legacy of firsts, but Bessie Coleman, an early-20th-century pilot, is not a household name to many outside the aviation industry. She was the first black American woman to become a pilot, and the first black American, man or woman, to hold an international pilot’s license. (Above, she’s with her Curtiss JN-4 biplane in the 1920s.) Her story will be brought to life in a reading from her biographies on Saturday at 3 p.m., commemorating the 90th anniversary of her first flight. Sponsored by Staten Island OutLoud, the reading came about because a board member who had faced sexism when she sought to learn how to fly had developed an interest in female aviators, said Beth Gorrie, OutLoud’s executive director. Coleman faced both sexism and racism, causing her to study in France. In the United States she became a popular figure, performing stunts at air shows and surviving numerous crashes. But on a flight in 1926 to scout locations for a parachute jump, Coleman, then 34, was in a plane that took an unexpected plunge; not at the controls and not buckled into her seat, she was ejected and fell to her death. Her mechanic, who was flying the plane, also died. Members of the Bessie Coleman Aerospace Legacy, formerly the Bessie Coleman Foundation, are expected to attend the reading; model planes, including a model of Coleman’s biplane, will be flown. Miller Field, 801 New Dorp Lane, at Cedar Grove Avenue, Gateway National Recreation Area, New Dorp, Staten Island, (718) 907-0709; statenislandoutloud.org; free, but spectators should provide their own seating. Aptly, the reading will take place next to some old airplane hangars. (Anne Mancuso)', 'print_section': 'C', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spare Times July 2-28', 'kicker': None, 'content_kicker': None, 'print_headline': 'Spare Times', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-21T20:49:17+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Anne Mancuso and Sunita Reddy', 'person': [{'firstname': 'Anne', 'middlename': None, 'lastname': 'Mancuso', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sunita', 'middlename': None, 'lastname': 'Reddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/2ca13262-b192-5507-bcd0-40491241f186', 'word_count': 2609, 'uri': 'nyt://article/2ca13262-