rds': [{'name': 'subject', 'value': 'Friendship', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook.com', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-27T09:44:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Paul Boutin', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Boutin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/12a7ec1c-23d3-5e49-a083-9c69aa11fd54', 'word_count': 396, 'uri': 'nyt://article/12a7ec1c-23d3-5e49-a083-9c69aa11fd54'}, {'abstract': 'Participants in a discussion convened by the N.H.T.S.A. differed on whether a solution to the deaths was best addressed with government-mandated standards or purely with educational outreach.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/07/27/at-safety-roundtable-diverging-strategies-for-preventing-child-hyperthermia-in-cars/', 'snippet': 'Participants in a discussion convened by the N.H.T.S.A. differed on whether a solution to the deaths was best addressed with government-mandated standards or purely with educational outreach.', 'lead_paragraph': 'Because deaths of children left in hot cars are occurring at an alarming rate this summer, the National Highway Traffic Safety Administration convened a roundtable discussion on Tuesday in Washington. In attendance were David Strickland, the N.H.T.S.A. administrator; auto industry representatives; child safety proponents; technical experts; and a mother whose child died from hyperthermia this year.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'At Safety Roundtable, Diverging Strategies for Preventing Child Hyperthermia in Cars', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 's