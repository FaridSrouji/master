ages/2011/07/17/nyregion/17UPDATE_SPAN/17UPDATE_SPAN-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/17/nyregion/17UPDATE_SPAN/17UPDATE_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/nyregion/17UPDATE_SPAN/17UPDATE-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/17/nyregion/17UPDATE_SPAN/17UPDATE_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/17/nyregion/17UPDATE_SPAN/17UPDATE_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Marathon Swimmers Complete Their Trek', 'kicker': 'Update', 'content_kicker': None, 'print_headline': 'Marathon Swimmers Complete Their Trek', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Swimming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Verrazano-Narrows Bridge (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-16T01:53:52+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Suzanne Sataline', 'person': [{'firstname': 'Suzanne', 'middlename': None, 'lastname': 'Sataline', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dec2c033-4d6f-52e7-9525-3a91823aa32e', 'word_count': 345, 'uri': 'nyt://article/dec2c033-4d6f-52e7-9525-3a91823aa32e'}, {'abstract': 'Track officials are dealing with the aftermath of a massive traffic jam that caused 15,000 fans to miss a Sprint Cup Nascar race.', 'web_url': 'https://www.nytimes.com/2011/07/16/sports/autoracing/at-kentucky-speedway-a-pileup-off-the-track.html', 'snippet': 'Track officials are dealing with the aftermath of a massive traffic jam that caused 15,000 fans to miss a Sprint Cup Nascar race.', 'lead_paragraph': 'Nascar’s president, Mike Helton, answered 14 questions Friday at a news conference at a racetrack in Loudon, N.H. Nine questions, and his opening comments, dealt with a colossal traffic jam, not caused by stock cars, before a race last Saturday about 900 miles away in Kentucky.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/16/sports/nascar/nascar-articleLarge.jpg', 'height': 288, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/16/sports/nascar/nascar-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 288}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/16/sports/nascar/nascar-jumbo.jpg', 'height': 491, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'At Kentucky Speedway, a Pileup Off the Track', 'kicker': None, 'content_kicker': None, 'print_headline': 'At Kentucky Speedway, A Pileup Off the Track', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Assn of Stock Car Auto Racing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Roads and Traffic', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nascar Sprint Cup Series', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Delays (Transportation)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Kentucky', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-16T01:54:33+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Auto Racing', 'byline': {'original': 'By Dave Caldwell', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Caldwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a8018548-f049-5a4e-b401-af7c935063e8', 'word_count': 701, 'uri': 'nyt://article/a8018548-f049-5a4e-b401-af7c935063e8'}, {'abstract': 'In which I learn a poker term.', 'web_url': 'https://wordplay.blogs.nytimes.com/2011/07/15/word-law/', 'snippet': 'In which I learn a poker term.', 'lead_paragraph': 'SATURDAY’S PUZZLE — I’ve said it before and I’ll say it again: if you can get through a Saturday puzzle with your life and your dignity intact, you are bound to come out a smarter person. Today was such a day for me, and I hope it was for you, too. But I came awfully close to this being a D.N.F. (Did Not Finish, for those of you who are new here) for me. That would have been a shame, primarily because I happen to love Patrick Berry’s puzzles, and secondly, because I can’t really write intelligently about the puzzle if I don’t finish, and that ticks off my editors like you can’t imagine.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Saturday: Their Word Is Law', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-07-16T02:00:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/299b6707-0349-5ad8-9708-530ebe946fdc', 'word_count': 336, 'uri': 'nyt://article/299b6707-0349-5ad8-9708-530ebe946fdc'}, {'abstract'