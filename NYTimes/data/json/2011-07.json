': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Dolnick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b9b4f48-7d7e-5b17-8fef-86ca01296709', 'word_count': 335, 'uri': 'nyt://article/0b9b4f48-7d7e-5b17-8fef-86ca01296709'}, {'abstract': 'A gay couple whose romance blossomed on the Staten Island ferry returned to the borough to get married.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/07/24/gay-marriage-traveling-from-missouri-to-staten-island-for-big-day/', 'snippet': 'A gay couple whose romance blossomed on the Staten Island ferry returned to the borough to get married.', 'lead_paragraph': 'For their first date, Steve Mulrooney and Jerome Van Wert rode the Staten Island ferry under the moonlight. They were so enamored with each other that night, under the stars and wrapped in a blanket, they didn’t realize they had docked until the boat’s captain told them they had to leave. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gay Marriage | Traveling From Missouri to Staten Island for Big Day', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Marriages', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Kansas City (Mo)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Staten Island (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-07-24T15:51:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Sydney Ember', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Ember', 'qualifier': None, 'title': None, 'role': 'reported'