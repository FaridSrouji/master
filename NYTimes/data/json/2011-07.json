': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/arts/22book2/22book2-jumbo.jpg', 'height': 960, 'width': 638, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/arts/22book2/22book2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/22/arts/22book2/22book2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'David Bowie, the Cool Chameleon From Mars', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'David Bowie, The Cool Chameleon From Mars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bowie, David', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-07-21T22:09:36+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Books', 'byline': {'original': 'By Dwight Garner', 'person': [{'firstname': 'Dwight', 'middlename': None, 'lastname': 'Garner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f9572ced-02f6-5e28-8fe5-84702df61eb9', 'word_count': 1242, 'uri': 'nyt://article/f9572ced-02f6-5e28-8fe5-84702df61eb9'}, {'abstract': 'The country singer Sarah Darling, at Matty T’s Roadhouse, played for an arena in her mind’s eye.', 'web_url': 'https://www.nytimes.com/2011/07/22/arts/music/sarah-darling-at-matty-ts-review.html', 'snippet': 'The country singer Sarah Darling, at Matty T’s Roadhouse, played for an arena in her mind’s eye.', 'lead_paragraph': 'DEER PARK, N.Y. — Matty T’s Roadhouse is a tiny Northern outpost of Southern attitude, with signed memorabilia on the wall, a D.J. with a black cowboy hat and a Long Island accent, and a handful of fans testing out their line-dancing moves to Toby Keith songs between acts.', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/22/arts/DARLING/DARLING-jumbo.jpg', 'height': 1024, 'width': 695, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'A Big Voice and an Awful Lot of Refinement for a Long Island Honky-Tonk', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Big Voice and an Awful Lot of Refinement for a Long Island Honky-Tonk', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gospel Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-07-21T22:09:55+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0ed5871a-168b-54cc-b064-953479c018ed', 'word_count': 533, 'uri': 'nyt://article/0ed5871a-168b-54cc-b064-953479c018ed'}, {'abstract': 'Images from “Another Earth,” a film that blends drama with science fiction.', 'web_url': 'https://www.nytimes.com/slideshow/2011/07/22/movies/another-earth-images.html', 'snippet': 'Images from “Another Earth,” a film that blends drama with science fiction.', 'lead_paragraph': 'Images from “Another Earth,” a film that blends drama with science fiction.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'capti