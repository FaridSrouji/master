 [], 'headline': {'main': 'July 5, 1975 | Arthur Ashe Becomes First Black Man to Win Wimbledon', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-05T19:21:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By The Learning Network', 'person': [], 'organization': 'The Learning Network'}, 'type_of_material': 'News', '_id': 'nyt://article/412bbff4-24a1-5e31-86fb-fa86d0233857', 'word_count': 685, 'uri': 'nyt://article/412bbff4-24a1-5e31-86fb-fa86d0233857'}, {'abstract': 'The advice columnist Dan Savage and his partner, Terry Miller, recently sat down with The New York Times to discuss how the It Gets Better Project started.', 'web_url': 'https://well.blogs.nytimes.com/2011/07/05/talking-about-the-it-gets-better-project/', 'snippet': 'The advice columnist Dan Savage and his partner, Terry Miller, recently sat down with The New York Times to discuss how the It Gets Better Project started.', 'lead_paragraph': 'Last fall, the advice columnist Dan Savage and his partner, Terry Miller, decided to post a video to give hope to bullied gay teenagers. Their message was that they also had been bullied as kids, but their adult lives were so much better, and included love, friendship, career achievement, marriage and parenthood.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Talking About the It Gets Better Project', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-07-05T19:21:24+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Tara Parker-Pope', 'person': [{'firstname': 'Tara', 'middlename': None, 'lastname': 'Parker-Pope', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_ma