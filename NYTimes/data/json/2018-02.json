7c1-ba6c935ef8d0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/nyregion/25big/merlin_62478830_db898b40-672a-4063-b7c1-ba6c935ef8d0-jumbo.jpg', 'height': 667, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/nyregion/25big/merlin_62478830_db898b40-672a-4063-b7c1-ba6c935ef8d0-superJumbo.jpg', 'height': 1303, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/nyregion/25big/25big-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/25/nyregion/25big/25big-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/nyregion/25big/25big-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nanny Case Is a Parent’s Nightmare, Too Horrifying to See Up Close', 'kicker': 'Big City', 'content_kicker': None, 'print_headline': 'A Parent’s Nightmare, Too Horrifying to See Up Close', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Child Care', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Krim, Marina', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ortega, Yoselyn', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Slimani, Leila', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Perfect Nanny (Book)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-02-23T12:00:17+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6089b385-a8ab-57bd-b59a-c8609aafd842', 'word_count': 984, 'uri': 'nyt://article/6089b385-a8ab-57bd-b59a-c8609aafd842'}, {'abstract': 'Mr. Leguizamo hits the stage much earlier than he thinks is natural, so he gives himself plenty of time before and after his show to warm up and unwind.', 'web_url': 'https://www.nytimes.com/2018/02/23/nyregion/john-leguizamo-sunday-routine.html', 'snippet': 'Mr. Leguizamo hits the stage much earlier than he thinks is natural, so he gives himself plenty of time before and after his show to warm up and unwind.', 'lead_paragraph': '“Acting really shouldn’t happen before 6 p.m.,” John Leguizamo said recently. Because of his success with one-man shows, however, the writer/performer has done his fair share of matinees, from the breakout, Obie award-winning “Mambo Mouth” in 1991, to his “Latin History for Morons,” currently on Broadway and scheduled to close this weekend. Of all his solo shows, Mr. Leguizamo, 53, said the current one, addressing a gap in his eighth-grade son’s education, is the closest to his contemporaneous life — which now includes his wife, Justine Maurer, a Greenwich Village townhouse, a beach house, a son at boarding school, a daughter at home and two dogs. And also a role in the Paramount mini-series “Waco.”', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/22/nyregion/00LEGUIZAMO9/merlin_132721694_3df00170-1d16-45a2-8713-d5858c7b46c1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/22/nyregion/00LEGUIZAMO9/merlin_132721694_3df00170-1d16-45a2-8713-d5858c7b46c1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/22/nyregion/00LEGUIZAMO9/merlin_132721694_3df00170-1d16-45a2-8713-d5858c7b46c1-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/22/nyregion/00LEGUIZAMO9/merlin_132721694_3df00170-1d16-45a2-8713-d5858c7b46c1-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/22/nyregion/00LEGUIZAMO9/00LEGUIZAMO9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/22/nyregion/00LEGUIZAMO9/00LEGUIZAMO9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/22/nyregion/00LEGUIZAMO9/00LEGUIZAMO9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How John Leguizamo, Actor, Spends His Sundays', 'kicker': 'Sunday Routine', 'content_kicker': None, 'print_headline': 'A Body of Work, at Rest or in Motion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': '