024, 'width': 745, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/t-magazine/29tmag-baskets-slide-GDLC/29tmag-baskets-slide-GDLC-superJumbo.jpg', 'height': 2048, 'width': 1490, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/t-magazine/29tmag-baskets-slide-GDLC/29tmag-baskets-slide-GDLC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/29/t-magazine/29tmag-baskets-slide-GDLC/29tmag-baskets-slide-GDLC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/t-magazine/29tmag-baskets-slide-GDLC/29tmag-baskets-slide-GDLC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Enduring Appeal of: Baskets', 'kicker': 'Material Culture', 'content_kicker': None, 'print_headline': 'Baskets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'England', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-02-15T17:09:49+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Design & Interiors', 'byline': {'original': 'By Deborah Needleman', 'person': [{'firstname': 'Deborah', 'middlename': None, 'lastname': 'Needleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3b2ca7e6-fbe0-58f4-b302-04e9b55de825', 'word_count': 1489, 'uri': 'nyt://article/3b2ca7e6-fbe0-58f4-b302-04e9b55de825'}, {'abstract': 'A handful of makers around the world offer classes in the centuries-old practice.', 'web_url': 'https://www.nytimes.com/2018/02/15/t-magazine/design/basket-making-crafting-class.html', 'snippet': 'A handful of makers around the world offer classes in the centuries-old practice.', 'lead_paragraph': 'This story on willow baskets is the first installment of a series for T on craft around the world. For each practice I researched, I knew I would discover more incredible resources and makers than could fit on just a few pages. While the focus of each column is the current state of a particular craft (what we are calling “universal crafts,” as nearly all cultures have created versions of them), it is worth noting that the craftspeople engaged in these centuries-old traditions are involved in a living practice. These are objects meant to be used, not simply regarded as historic artifacts or hung on a wall. These makers are not starting from scratch or reinventing the wheel, yet their work is the product of innovative new ideas, practices and modifications. And it is also a tangible link to our past. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/15/t-magazine/15tmag-baskets-slide-BGB1/15tmag-baskets-slide-BGB1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/15/t-magazine/15tmag-baskets-slide-BGB1/15tmag-baskets-slide-BGB1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/15/t-magazine/15tmag-baskets-slide-BGB1/15tmag-baskets-slide-BGB1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/0