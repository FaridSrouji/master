rial': 'News', '_id': 'nyt://article/10df4fd9-7619-5858-b835-ffd956fe0ef2', 'word_count': 713, 'uri': 'nyt://article/10df4fd9-7619-5858-b835-ffd956fe0ef2'}, {'abstract': 'A graduate of Stoneman Douglas High School has been close to four mass shootings in Florida. She wants last week’s to be the last.', 'web_url': 'https://www.nytimes.com/video/opinion/100000005752277/i-interned-for-senator-rubio-now-im-begging-him-to-act-on-guns.html', 'snippet': 'A graduate of Stoneman Douglas High School has been close to four mass shootings in Florida. She wants last week’s to be the last.', 'lead_paragraph': 'A graduate of Stoneman Douglas High School has been close to four mass shootings in Florida. She wants last week’s to be the last.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/20/autossell/ShanaThumb1/ShanaThumb1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/20/autossell/ShanaThumb1/ShanaThumb1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/20/autossell/ShanaThumb1/ShanaThumb1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/20/autossell/ShanaThumb1/ShanaThumb1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/20/autossell/ShanaThumb1/ShanaThumb1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/20/autossell/ShanaThumb1/ShanaThumb1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/20/autossell/ShanaThumb1/ShanaThumb1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Interned for Senator Rubio. Now I’m Begging Him to Act on Guns.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parkland, Fla, Shooting (2018)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Marjory Stoneman Douglas High School (Parkland, Fla)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'School Shootings and Armed Attacks', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-02-21T01:15:09+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Shana Rosenthal, Leah Varjacques and Andrea Havis', 'person': [{'firstname': 'Shana', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Leah', 'middlename': None, 'lastname': 'Varjacques', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Andrea', 'middlename': None, 'lastname': 'Havis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/f34bcabf-da62-5581-b19c-2cacba9d2c54', 'word_count': 0, 'uri': 'nyt://video/f34bcabf-da62-5581-b19c-2cacba9d2c54'}, {'abstract': 'A graduate of Stoneman Douglas High School has been close to four mass shootings in Florida. She wants last week’s to be the last.', 'web_url': 'https://www.nytimes.com/2018/02/20/opinion/i-interned-for-senator-rubio-now-im-begging-him-to-act-on-guns.html', 'snippet': 'A graduate of Stoneman Douglas High School has been close to four mass shootings in Florida. She wants last week’s to be the last.', 'lead_paragraph': 'The video above is based on the following letter, which I wrote to my senator, Marco Rubio, in the wake of the shooting at Marjory Stoneman Douglas High School. I urge you to hold your elected officials accountable by sending them a letter and tagging them on Facebook, Twitter, Instagram and whatever other social media platforms you use.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'I Interned for Senator Rubio. Now I’m Begging Him to Act on Guns.', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Senate', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rubio, Marco', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parkland, Fla, Shooting (2018)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Marjory Stoneman Douglas High School (Parkland, Fla)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'School Shootings and Armed Attacks', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-02-21T01:16:00+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Shana Rosenthal', 'person': [{'firstname': 'Shana', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/bba44fab-dd94-5d6a-b97b-6ea1fa1f45a3', 'word_count': 875, 'uri': 'nyt://article/bba44fab-dd94-5d6a-b97b-6ea1fa1f45a3'}, {'abstract': 'Students fed up with gun violence hopped a bus to Tallahassee, Fla., and planned protests from coast to coast. Whether their activism would amount to anything was far from clear.', 'web_url': 'https://www.nytimes.com/2018/02/20/us/parkland-students-shooting-florida.html', 'snippet': 'Students fed up with gun violence hopped a bus to Tallahassee, Fla., and planned protests from coast to coast. Whether their activism would amount to anything was far from clear.', 'lead_paragraph': 'TALLAHASSEE, Fla. — Instead of 10th-grade English and 12th-grade calculus, the teenagers from Marjory Stoneman Douglas High School in Parkland, Fla., had another funeral to attend. When the grim ceremony was over on Tuesday morning, they hugged their parents goodbye, stashed their backpacks in the bellies of three buses and set off in grief and hope to demand gun control measures from state lawmakers more than 400 miles away.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/21/us/21protests4/21protest4-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/21/us/21protests4/21protest4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/21/us/21protests4/21protest4-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/21/us/21protests4/21protest4-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/21/us/21protests4/21protest4-thumbStandard.jpg', 'heigh