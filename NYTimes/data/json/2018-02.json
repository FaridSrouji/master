ject', 'value': 'Education (K-12)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Graduation Rates', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Principals (School)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Nonprofit Organizations', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Harvard University', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 13, 'major': 'N'}], 'pub_date': '2018-02-13T18:29:49+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Elizabeth A. Harris', 'person': [{'firstname': 'Elizabeth', 'middlename': 'A.', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/58b04a91-bd6d-5d0e-8188-aa34c10c14eb', 'word_count': 1228, 'uri': 'nyt://article/58b04a91-bd6d-5d0e-8188-aa34c10c14eb'}, {'abstract': 'Along with a building renovation came a rebranding — and some upset. To what extent does a name matter?', 'web_url': 'https://www.nytimes.com/2018/02/13/arts/dance/ps122-performance-space-new-york-jenny-schlenzka.html', 'snippet': 'Along with a building renovation came a rebranding — and some upset. To what extent does a name matter?', 'lead_paragraph': 'If you search Instagram these days for the handle @PS122, you won’t find the institution formerly known as Performance Space 122 (PS122 for short). Instead you’ll discover a new, anonymous account that calls itself You Cant Kill a Ghost, with 29 followers, a single photo of the color red and a one-word bio: “History.”', 'print_section': 'C', 'print_pa