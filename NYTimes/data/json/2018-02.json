, Glenn', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-02-14T21:36:17+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Entertainment', 'byline': {'original': 'By John Wogan and Illustrations by Aurore de La Morinerie', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Wogan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Illustrations', 'middlename': 'Aurore', 'lastname': 'de La Morinerie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9b141072-29b8-5b31-ad09-6f165e89cce0', 'word_count': 305, 'uri': 'nyt://article/9b141072-29b8-5b31-ad09-6f165e89cce0'}, {'abstract': 'Low-key bags in organic materials and natural hues.', 'web_url': 'https://www.nytimes.com/2018/02/14/t-magazine/fashion/70s-style-totes-that-go-with-anything.html', 'snippet': 'Low-key bags in organic materials and natural hues.', 'lead_paragraph': 'Low-key bags in organic materials and natural hues.', 'print_section': 'M2', 'print_page': '176', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/t-magazine/29tmag-natural-slide-Q7F1/29tmag-natural-slide-Q7F1-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/29/t-magazine/29tmag-natural-slide-Q7F1/29tmag-natural-slide-Q7F1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/t-magazine/29tmag-natural-slide-Q7F1/29tmag-natural-slide-Q7F1-jumbo.jpg', 'height': 831, 'width': 665, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'imag