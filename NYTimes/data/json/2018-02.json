_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25getaway/merlin_96612478_c65d32c2-9cdc-4455-81c2-f8ad712e8497-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/25/travel/25getaway/merlin_96612478_c65d32c2-9cdc-4455-81c2-f8ad712e8497-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25getaway/merlin_96612478_c65d32c2-9cdc-4455-81c2-f8ad712e8497-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25getaway/merlin_96612478_c65d32c2-9cdc-4455-81c2-f8ad712e8497-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25getaway/merlin_96612478_c65d32c2-9cdc-4455-81c2-f8ad712e8497-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/25/travel/25getaway/merlin_96612478_c65d32c2-9cdc-4455-81c2-f8ad712e8497-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25getaway/merlin_96612478_c65d32c2-9cdc-4455-81c2-f8ad712e8497-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Great American Road Trip: Shorter and More Popular Than Ever', 'kicker': 'the getaway', 'content_kicker': None, 'print_headline': 