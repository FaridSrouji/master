'}, {'name': 'organizations', 'value': 'American Enterprise Institute for Public Policy Research', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'American Journal of Sociology', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Brookings Institution', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-02-10T19:30:02+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By David Brady, Ryan M. Finnigan and Sabine Hübgen', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Brady', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ryan', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6000098b-d787-573a-9b7e-0b0d13fc696d', 'word_count': 982, 'uri': 'nyt://article/6000098b-d787-573a-9b7e-0b0d13fc696d'}, {'abstract': 'If Washington shuts down, companies will step up. Do we really want that?', 'web_url': 'https://www.nytimes.com/2018/02/10/opinion/sunday/corporations-will-inherit-the-earth.html', 'snippet': 'If Washington shuts down, companies will step up. Do we really want that?', 'lead_paragraph': 'What a herky-jerky mess our federal government is. What a bumbling klutz. It can’t manage health care. It can’t master infrastructure. It can’t fund itself for more than tiny increments of time. It can barely stay open. It shut down briefly on Friday for the second time in three weeks. Maybe it should just stay closed for good.', 'print_section': 'SR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/11/opinion/sunday/11bruni/11bruni-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', '