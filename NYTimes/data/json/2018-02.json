b. 18. ', 'print_section': 'TR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/travel/18CARRYONA/18CARRYONA-articleLarge.jpg', 'height': 663, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/18/travel/18CARRYONA/18CARRYONA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 663}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/travel/18CARRYONA/18CARRYONA-jumbo.jpg', 'height': 900, 'width': 814, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/travel/18CARRYONA/18CARRYONA-superJumbo.jpg', 'height': 900, 'width': 814, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/travel/18CARRYONA/18CARRYONA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/18/travel/18CARRYONA/18CARRYONA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/travel/18CARRYONA/18CARRYONA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Joel Embiid Can’t Travel Without', 'kicker': 'Carry-On', 'content_kicker': None, 'print_headline': 'Joel Embiid Keeps His Lip Balm and Cologne Close.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value