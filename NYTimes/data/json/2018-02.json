e': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By William Neuman and J. David Goodman', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Neuman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'J.', 'middlename': 'David', 'lastname': 'Goodman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04c0406c-76ec-57b2-ba71-8cf909c17118', 'word_count': 1210, 'uri': 'nyt://article/04c0406c-76ec-57b2-ba71-8cf909c17118'}, {'abstract': '“Asymmetry” features a clandestine romance between a young editorial assistant and a famous, much older novelist.', 'web_url': 'https://www.nytimes.com/2018/02/02/books/in-lisa-hallidays-debut-novel-philip-roth.html', 'snippet': '“Asymmetry” features a clandestine romance between a young editorial assistant and a famous, much older novelist.', 'lead_paragraph': 'In the opening scene of Lisa Halliday’s debut novel, “Asymmetry,” Alice, a young editorial assistant at a publishing house, is reading on a bench on the Upper West Side when a famous novelist plops down beside her with a Mister Softee ice cream cone. When they meet again on the same bench two weeks later, the novelist, Ezra Blazer, brings two cones and offers her one. After she accepts it, quickly rationalizing that “multiple-Pulitzer Prize winners don’t go around poisoning people,” Ezra asks her, “Are you game?”', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/03/books/review/03halliday/03halliday-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/03/books/review/03halliday/03halliday-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/03/books/review/03halliday/03halliday-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/03/books/review/03halliday/03halliday-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/03/books/review/03halliday/03halliday-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/03/books/review/03halliday/03halliday-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/03/books/review/03halliday/03halliday-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lisa Halliday’s Debut Novel Is Drawing Comparisons to Philip Roth. Though Not for the Reasons You Might Think.', 'kicker': 'Profile', 'content_kicker': None, 'print_headline': 'It’s Rothian, But Not How You Think', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Asymmetry (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Halliday, Lisa', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Roth, Philip', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-02-02T19:05:20+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'origina