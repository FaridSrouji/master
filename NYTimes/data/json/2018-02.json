e': 'persons', 'value': 'Gitner, Daniel M', 'rank': 8, 'major': 'N'}], 'pub_date': '2018-02-09T18:10:34+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Benjamin Weiser and Vivian Wang', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Weiser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Vivian', 'middlename': None, 'lastname': 'Wang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6f90170-a94b-5429-9323-7f646ed056d1', 'word_count': 978, 'uri': 'nyt://article/e6f90170-a94b-5429-9323-7f646ed056d1'}, {'abstract': 'G.O.P. fiscal policy is reprehensible, but it won’t cause a recession.', 'web_url': 'https://www.nytimes.com/2018/02/09/opinion/no-fairy-no-cry.html', 'snippet': 'G.O.P. fiscal policy is reprehensible, but it won’t cause a recession.', 'lead_paragraph': 'Republicans preached fiscal austerity when the economy needed stimulus, and have turned to fiscal profligacy now that it doesn’t. If this surprises you, either you’ve been completely oblivious to the reality of the modern GOP for the past decade, or you’re a reflexive centrist – which is pretty much the same thing.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/09/opinion/09krugmanWeb/merlin_133321256_71ad898c-e78e-41c2-9bd9-a5cb462461e5-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/09/opinion/09krugmanWeb/merlin_133321256_71ad898c-e78e-41c2-9bd9-a5cb462461e5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/09/opinion/09krugmanWeb/merlin_133321256_7