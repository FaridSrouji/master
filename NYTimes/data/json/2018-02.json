pe': 'image', 'url': 'images/2018/02/12/t-magazine/12tmag-risso-slide-Z0YA/12tmag-risso-slide-Z0YA-jumbo.jpg', 'height': 1024, 'width': 868, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/12/t-magazine/12tmag-risso-slide-Z0YA/12tmag-risso-slide-Z0YA-superJumbo.jpg', 'height': 1508, 'width': 1278, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/12/t-magazine/12tmag-risso-slide-Z0YA/12tmag-risso-slide-Z0YA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/12/t-magazine/12tmag-risso-slide-Z0YA/12tmag-risso-slide-Z0YA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/12/t-magazine/12tmag-risso-slide-Z0YA/12tmag-risso-slide-Z0YA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Profile in Style: Francesco Risso', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-02-23T17:23:36+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4aa62cd9-4a01-55ac-9352-f699ec675df4', 'word_count': 0, 'uri': 'nyt://slideshow/4aa62cd9-4a01-55ac-9352-f699ec675df4'}, {'abstract': 'Francesco Risso — who took the helm at Marni in 2016 — draws from Disney cartoons and 18th-century tartan hunting jackets alike.', 'web_url': 'https://www.nytimes.com/2018/02/23/t-magazine/fashion/francesco-risso-marni.html', 'snippet': 'Francesco Risso — who took the helm at Marni in 2016 — draws from Disney cartoons and 18th-century tartan hunting jackets alike.', 'lead_paragraph': 'Francesco Risso’s childhood was straight out of a Fellini film. The fashion designer, who has been the creative director of Marni since 2016, was born near Sardinia and spent his first four years living on a wooden schooner with his parents, sailing around the Mediterranean. Next, they settled into a grand 16th-century villa in Genoa with three of Risso’s grandparents and an ever-rotating cast of glamorous houseguests from abroad. “My family was extremely eclectic,” says the 35-year-old, who, craving stability, “escaped” at 16 to study fashion at the Polimoda school in Florence before attending the Fashion Institute of Technology in New York and Central Saint Martins in London. “It was a vertigo way of life — I was always outside my comfort zone,” he says. “That forced me to be adventurous and open-minded.”', 'print_section': 'M2', 'print_page': '70', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/12/t-magazine/12tmag-risso-slide-UENP/12tmag-risso-slide-UENP-articleLarge.jpg', 'height': 799, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/12/t-magazine/12tmag-risso-slide-UENP/12tmag-risso-slide-UENP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 799}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/12/t-magazine/12tmag-risso-slide-UENP/12tmag-risso-slide-UENP-jumbo.jpg', 'height': 1024, 'width': 769, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/12/t-magazine/12tmag-risso-slide-UENP/12tmag-risso-slide-UENP-superJumbo.jpg', 'height': 1323, 'width': 993, 'subType': 'super