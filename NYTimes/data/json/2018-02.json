5274-8d3a-889284fa0288', 'word_count': 838, 'uri': 'nyt://article/b55f91b7-59dc-5274-8d3a-889284fa0288'}, {'abstract': 'We were so close to moving beyond the stereotypes. Alas.', 'web_url': 'https://www.nytimes.com/2018/02/17/opinion/sunday/trump-bad-for-golf.html', 'snippet': 'We were so close to moving beyond the stereotypes. Alas.', 'lead_paragraph': 'Golf was so close! It was so close to moving beyond that stereotype — the image of a rich, old, unathletic white man making sexist jokes and trading real estate tips. The image of someone like Donald Trump.', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/opinion/sunday/18zimmerman-print/18zimmerman-print-articleLarge.jpg', 'height': 901, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/18/opinion/sunday/18zimmerman-print/18zimmerman-print-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 901}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/opinion/sunday/18zimmerman-print/18zimmerman-print-jumbo.jpg', 'height': 1024, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/opinion/sunday/18zimmerman-print/18zimmerman-print-superJumbo.jpg', 'height': 2048, 'width': 1364, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/opinion/sunday/18zimmerman-print/18zimmerman-print-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/18/opinion/sunday/18zimmerman-print/18zimmerman-print-thumbStandard-v2.jpg', 'thumbnailwid