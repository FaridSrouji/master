subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 11, 'major': 'N'}], 'pub_date': '2018-02-26T01:01:55+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Leonhardt', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7c7024af-1f4d-5413-8723-f1b4efb92c18', 'word_count': 825, 'uri': 'nyt://article/7c7024af-1f4d-5413-8723-f1b4efb92c18'}, {'abstract': 'It’s hard to know what to do when age brings a faithful companion so much fear and suffering.', 'web_url': 'https://www.nytimes.com/2018/02/25/opinion/loving-old-dogs.html', 'snippet': 'It’s hard to know what to do when age brings a faithful companion so much fear and suffering.', 'lead_paragraph': 'NASHVILLE — It’s 2 in the morning, and it has just started to rain. It’s a gentle rain, with no threat of high winds or lightning. I know this without having to get up to peer into the dark night or put on my glasses to check the weather app on my phone. I know the facts of this meteorological reality without even opening my eyes because there is a large dog with halitosis now standing beside my bed, panting.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/opinion/26renklWeb/26renklWeb-articleLarge-v2.jpg', 'height': 363, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/28/opi