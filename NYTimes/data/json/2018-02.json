/14LOGO-PERUSHEK1/14LOGO-PERUSHEK1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 410}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/sports/14LOGO-PERUSHEK1/14LOGO-PERUSHEK1-jumbo-v2.jpg', 'height': 701, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/sports/14LOGO-PERUSHEK1/14LOGO-PERUSHEK1-superJumbo-v2.jpg', 'height': 1401, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/sports/14LOGO-PERUSHEK1/14LOGO-PERUSHEK1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/18/sports/14LOGO-PERUSHEK1/14LOGO-PERUSHEK1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/18/sports/14LOGO-PERUSHEK1/14LOGO-PERUSHEK1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Your Designs: Olympic Logos for Russia and the Two Koreas', 'kicker': None, 'content_kicker': None, 'print_headline': 'Building a Better Logo and Flag', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2018)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-02-15T14:07:13+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Sona Patel and Jessica White', 'person': [{'firstname': 'Sona', 'middlename': None, 'lastname': 'Patel', 'qualifier': None, 'title': None, 