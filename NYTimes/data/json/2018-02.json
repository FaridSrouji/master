}], 'pub_date': '2018-02-17T18:16:52+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Sheera Frenkel and Katie Benner', 'person': [{'firstname': 'Sheera', 'middlename': None, 'lastname': 'Frenkel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Katie', 'middlename': None, 'lastname': 'Benner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/158f52a8-9841-56a7-a08d-16304c7d5e3d', 'word_count': 1447, 'uri': 'nyt://article/158f52a8-9841-56a7-a08d-16304c7d5e3d'}, {'abstract': 'It was unclear how much damage the blaze did to the ancient Buddhist temple. But to many Tibetans, any harm to the site would be a harsh blow.', 'web_url': 'https://www.nytimes.com/2018/02/17/world/asia/tibet-temple-fire.html', 'snippet': 'It was unclear how much damage the blaze did to the ancient Buddhist temple. But to many Tibetans, any harm to the site would be a harsh blow.', 'lead_paragraph': 'BEIJING — A fire broke out on Saturday at one of the most hallowed sites in Tibet, the Jokhang temple in Lhasa, a day after the start of the traditional Tibetan New Year celebrations, official Chinese news media reported.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fire Strikes Hallowed Site in Tibet, the Jokhang Temple in Lhasa', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fire Strikes Shrine Tibet Holds Sacred', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fires and Firefighters', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Buddhism', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Lhasa (Tibet)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'vis-multimedia', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-02-17T18:4