e, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Agee, Mary Cunningham', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Agee, William (1938-2017)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bendix Corp', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wills and Estates', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': '#MeToo Movement', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'vis-multimedia', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-02-10T10:00:40+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Amy Chozick', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Chozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2c0f06d7-08df-5485-9803-73798458077d', 'word_count': 3188, 'uri': 'nyt://article/2c0f06d7-08df-5485-9803-73798458077d'}, {'abstract': 'What makes a mother? The Sugars advise.', 'web_url': 'https://www.nytimes.com/audio/2018/02/10/podcasts/10SUGARS-audio.html', 'snippet': 'What makes a mother? The Sugars advise.', 'lead_paragraph': 'What makes a mother? The Sugars advise.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Listen to ‘Dear Sugars’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-02-10T11:00:01+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Podcasts', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/32ff00e0-3454-54f7-a2da-f3e04a891be6', 'word_count': 0, 'uri': 'nyt://audio/32ff00e0-3454-54f7-a2da-f3e04a891be6'}, {'abstract': 'Cuteness counts, but so does the breed. Poodles and work dogs are out; Chihuahuas and mutts are in.', 'web_url': 'https://www.nytimes.com/2018/0