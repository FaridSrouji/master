age', 'url': 'images/2018/03/13/science/13THIRST/13THIRST-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/03/13/science/13THIRST/13THIRST-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/03/13/science/13THIRST/13THIRST-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/03/13/science/13THIRST/13THIRST-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'You Get Thirsty and Drink. How Does Your Brain Signal You’ve Had Enough?', 'kicker': 'Trilobites', 'content_kicker': None, 'print_headline': 'To Quench Thirst, It’s All in the Gulp', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Brain', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Senses and Sensation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Water', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mice', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Nature (Journal)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Augustine, Vineet', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Oka, Yuki', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-02-28T18:00:14+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Veronique Greenwood', 'person': [{'firstname': 'Veronique', 'middlename': None, 'lastname': 'Greenwood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1866e280-fa60-5197-acf7-63b6a864240a', 'word_count': 742, 'uri': 'nyt://article/1866e280-fa60-5197-acf7-63b6a864240a'}, {'abstract': 'Using a telescope in Australia, astronomers say they have glimpsed farther back in time than the Hubble Telescope to see what was happening when the first stars were forming.', 'web_url': 'https://www.nytimes.com/2018/02/28/science/stars-dark-energy.html', 'snippet': 'Using a telescope in Australia, astronomers say they have glimpsed farther back in time than the Hubble Telescope to see what was happening when the first stars were forming.', 'lead_paragraph': 'It was morning in the universe and much colder than anyone had expected when light from the first stars began to tickle and excite their dark surroundings nearly 14 billion years ago.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/27/science/29STARLIGHT2/29STARLIGHT2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/27/science/29STARLIGHT2/29STARLIGHT2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/27/science/29STARLIGHT2/29STARLIGHT2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/27/science/29STARLIGHT2/29STARLIGHT2-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/27/science/29STARLIGHT2/29STARLIGHT2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'image