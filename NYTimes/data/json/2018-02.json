name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Cassisi, John (1963- )', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Vance, Cyrus R Jr', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Wilfred (Construction Executive)', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Jonathan Metal & Glass Ltd', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Structure Tone Inc', 'rank': 13, 'major': 'N'}], 'pub_date': '2018-02-26T21:22:08+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Charles V. Bagli', 'person': [{'firstname': 'Charles', 'middlename': 'V.', 'lastname': 'Bagli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0c35429c-2d71-5158-90b6-27195f5e1360', 'word_count': 1545, 'uri': 'nyt://article/0c35429c-2d71-5158-90b6-27195f5e1360'}, {'abstract': 'Daa! Dumplings sells pelmeni, khinkali and more Siberian favorites to eat in or take out at the Turnstyle Underground Market.', 'web_url': 'https://www.nytimes.com/2018/02/26/dining/daa-dumplings-turnstyle-underground-market-pelmeni.html', 'snippet': 'Daa! Dumplings sells pelmeni, khinkali and more Siberian favorites to eat in or take out at the Turnstyle Underground Market.', 'lead_paragraph': 'Ksenia Kolesova, a native of Bratsk, in Siberia, thought it was about time New York had a taste of real Russian dumplings. She’s opened a shop in the underground market at Columbus Circle with Raphael Nieto, a graphic designer. Savory little pelmeni showered with herbs like dill come steamed or in chicken broth, to eat in or take out with sour cream or hot sauce. Frozen ones are also available. (In Siberia, housewives would leave bags of homemade pelmeni outside to freeze in winter.) Khinkali, a type of pleated Georgian soup dumpling, is another option, as are sweet dumplings stuffed with cherries or cheese: Pelmeni, 10 for $8.75, 14 for $12.75; khinkali, 3 for $9.75, Daa! Dumplings, Turnstyle Underground Market, 59th Street Columbus Circle subway station, 212-757-6207, daadumplings.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/28burnerdumpling/merlin_134380361_a102fd14-e5cd-4e89-a04e-bb18e2d760b2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/28/dining/28burnerdumpling/merlin_134380361_a102fd14-e5cd-4e89-a04e-bb18e2d760b2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/28burnerdumpling/merlin_134380361_a102fd14-e5cd-4e89-a04e-bb18e2d760b2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/28burnerdumpling/merlin_134380361_a102fd14-e5cd-4e89-a04e-bb18e2d760b2-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/28burnerdumpling/28burnerdumpling-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/28/dining/28burnerdumpling/28burnerdumpling-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/28burnerdumpling/28burnerdumpling-thumbLarge.jpg', 'height': 150, 'width': 150, 'sub