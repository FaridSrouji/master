: 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/14/dining/07COOKING-POLENTA-MUSHROOMS1/07COOKING-POLENTA-MUSHROOMS1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/14/dining/07COOKING-POLENTA-MUSHROOMS1/07COOKING-POLENTA-MUSHROOMS1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/14/dining/07COOKING-POLENTA-MUSHROOMS1/07COOKING-POLENTA-MUSHROOMS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/14/dining/07COOKING-POLENTA-MUSHROOMS1/07COOKING-POLENTA-MUSHROOMS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/14/dining/07COOKING-POLENTA-MUSHROOMS1/07COOKING-POLENTA-MUSHROOMS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gold Medal Recipes', 'kicker': 'What to Cook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-02-12T15:31:07+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://