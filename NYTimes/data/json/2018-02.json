: 'images/2018/01/29/nyregion/29yale-1/27yale1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/nyregion/29yale-1/27yale1-jumbo-v2.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/nyregion/29yale-1/27yale1-superJumbo-v2.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/nyregion/29yale-1/27yale1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/29/nyregion/29yale-1/27yale1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/29/nyregion/29yale-1/27yale1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Should Schools Teach You How to Be Happy?', 'kicker': 'Student Opinion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-02-01T10:00:02+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Natalie Proulx', 'person': [{'firstname': 'Natalie', 'middlename': None, 'lastname': 'Proulx', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d22ec424-5b05-53f2-9597-f0b181f234b8', 'word_count': 485, 'uri': 'nyt://article/d22ec424-5b05-53f2-9597-f0b181f234b8'}, {'abstract': 'What happens when the therapeutic alliance turns into a disturbing dance of deception?', 'web_url': 'https://www.nytimes.com/2018/02/01/magazine/a-doctors-painful-struggle-with-an-opioid-addicted-patient.html', 'snippet': 'What happens when the therapeutic alliance turns into a disturbing dance of deception?', 'lead_paragraph': 'I once found myself entrapped by a patient as much as she felt trapped by me. It was the summer of 2001, and I was running a small internal-medicine clinic, supervised by a preceptor, on the fourth floor of a perpetually chilly Boston building. Most of the work involved routine primary care — the management of diabetes, blood pressure and heart disease. It was soft, gratifying labor; the night before a new patient’s visit, I would usually sift through any notes that were sent ahead and jot my remarks in the margins. The patient’s name was S., I learned. She had made four visits to the emergency room complaining of headaches. Three of those times she left with small stashes of opioids — Vicodin, Percocet, oxycodone. Finally, the E.R. doctors refused to give her pain medicines unless she had a primary-care physician. There was an open slot in my clinic the next morning, and the computer had randomly assigned her to see me.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/04/magazine/04mag-onmedicine1-copy/04mag-04onmedicine-t_CA0-articleLarge.jpg', 'height': 700, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/04/magazine/04mag-onmedicine1-copy/04mag-04onmedicine-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 700}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/04/magazine/04mag-onmedicine1-copy/04mag-04onmedicine-t_CA0-jumbo.jpg', 'height': 1024, 'width': 879, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/04/magazine/04mag-onmedicine1-copy/04mag-04onmedicine-t_CA0-superJumbo.jpg', 'height': 2048, 'width': 1757, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/04/magazine/04mag-onmedicine1-copy/04mag-04onmedicine-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/04/magazine/04mag-onmedicine1-copy/04mag-04onmedicine-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/04/magazine/04mag-onmedicine1-copy/04mag-04onmedicine-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Doctor’s Painful Struggle With an Opioid-Addicted Patient', 'kicker': 'On Medicine', 'content_kicker': None, 'print_headline': 'A Disturbing Dance of Deception With an Opioid-Addicted Patient.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opioids and Opiates', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Addiction (Psychology)', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-02-01T10:00:02+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Siddhartha Mukherjee', 'person': [{'firstname': 'Siddhartha', 'middlename': None, 'lastname': 'Mukherjee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ec269f58-9f20-5611-9014-14a32802f9ec', 'word_count': 1557, 'uri': 'nyt://article/ec269f58-9f20-5611-9014-14a3280