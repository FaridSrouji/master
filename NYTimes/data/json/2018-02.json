/22byman/22byman-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/22/opinion/22byman/22byman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/22/opinion/22byman/22byman-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/22/opinion/22byman/22byman-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/22/opinion/22byman/22byman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/22/opinion/22byman/22byman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/22/opinion/22byman/22byman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Is It Possible to Serve Honorably in the Trump Administration?', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Government Workers Should Carry On', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Trump, Donald J', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Government Employees', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Brand, Rachel L', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shaub, Walter M Jr', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rosenberg, Chuck (1960- )', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-02-21T23:55:14+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Daniel Byman', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Byman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e50f0607-f682-55f8-a2d8-92fc36f29d01', 'word_count': 1032, 'uri': 'nyt://article/e50f0607-f682-55f8-a2d8-92fc36f29d01'}, {'abstract': 'Too often he resisted revising Protestantism to reflect the diversity and knowledge of the modern world.', 'web_url': 'https://www.nytimes.com/2018/02/21/opinion/billy-graham-death-missed-opportunties.html', 'snippet': 'Too often he resisted revising Protestantism to reflect the diversity and knowledge of the modern world.', 'lead_paragraph': 'As one of world Christianity’s most admired leaders, the Rev. Billy Graham, who died on Wednesday at 99, had extraordinary opportunities to affect the character of the Christian religion and to pronounce on its implications for personal conduct. He scored at the top of lists of “most respected” Americans decade after decade. He was loved by millions in the United States and abroad.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/22/opinion/22hollinger1/22Merritt1-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/22/opinion/22hollinger1/22Merritt1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/22/opinion/22hollinger1/22Merritt1-jumbo.jpg',