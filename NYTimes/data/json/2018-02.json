lifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/88b88bbe-e279-582f-a666-5e8b382d907c', 'word_count': 281, 'uri': 'nyt://article/88b88bbe-e279-582f-a666-5e8b382d907c'}, {'abstract': 'At 40, Brady is about to become the oldest quarterback to play in a Super Bowl, yet he seems to have adopted a style of play generally associated with younger players.', 'web_url': 'https://www.nytimes.com/2018/02/01/sports/football/tom-brady-super-bowl-lii.html', 'snippet': 'At 40, Brady is about to become the oldest quarterback to play in a Super Bowl, yet he seems to have adopted a style of play generally associated with younger players.', 'lead_paragraph': 'ST. PAUL — On Saturday night, five years after the final game of his 14-season career, Randy Moss will almost certainly be announced as a new member of the Pro Football Hall of Fame. On Sunday, Tom Brady, the quarterback who helped revitalize Moss’s career in 2007, will be on the field at U.S. Bank Stadium in search of his sixth Super Bowl ring with the New England Patriots.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/sports/02brady/02brady-articleLarge.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/02/sports/02brady/02brady-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 377}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/sports/02brady/02brady-jumbo.jpg', 'height': 643, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/sports/02brady/02brady-superJumbo.jpg', 'height': 1285, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/sports/02brady/02brady-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/02/sports/02brady/02brady-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/sports/02brady/02brady-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tom Brady’s Peers Are Getting Older. He Can’t Relate.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Brady’s Peers Are Aging. He Can’t Relate.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Longevity', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brady, Tom', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New England Patriots', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-02-01T12:00:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Benjamin Hoffman', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Hoffman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a418ae2b-f97b-5744-b569-f5cc663aa6ea', 'word_count': 862, 'uri': 'nyt://article/a418ae2b-f97b-5744-b569-f5cc663aa6ea'}, {'abstract': 'Newly restored, King Hu’s 1979 period film follows a scholar deep into the misty countryside.', 'web_url': 'https://www.nytimes.com/2018/02/01/movies/legend-of-the-mountain-review.html', 'snippet': 'Newly restored, King Hu’s 1979 period film follows a scholar deep into the misty countryside.', 'lead_paragraph': 'A magical mystery marathon, King Hu’s “Legend of the Mountain” takes place (maybe, as the narrator waggishly says) in the 11th century during the Song dynasty. It tells of a cheerful, underemployed scholar, Ho Yunqing (Shih Chun), who makes a meager living as a copyist. Soon after the movie opens, he is entrusted to copy a Buddhist sutra (a dialogue or sermon) that can liberate souls stuck in limbo. Ho isn’t a believer, but he needs the money and so enthusiastically heads out on a seemingly simple mission, one that eventually leads to an isolated outpost where curious and curiouser things occur.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02legendmountain/02legendmountain-articleLarge.jpg', 'height': 255, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/02/arts/02legendmountain/02legendmountain-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 255}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02legendmountain/02legendmountain-jumbo.jpg', 'height': 436, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02legendmountain/02legendmountain-superJumbo.jpg', 'height': 786, 'width': 1847, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02legendmountain/02legendmountain-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/02/arts/02legendmountain/02legendmountain-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02legendmountain/02legendmountain-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Legend of the Mountain,’ a Magical Mystery Marathon in Ancient China', 'kicker': None, 'content_kicker': None, 'print_headline': 'Down a Rabbit Hole In 11th-Century China', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hu, King', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Legend of the Mountain (Movie)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-02-01T12:00:22+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a5fce1cf-e93d-58b0-89cc-b91747ecf543', 'word_count': 450, 'uri': 'nyt://article/a5fce1cf-e93d-58b0-89cc-b91747ecf543'}, {'abstract': 'The latest from the Japanese horror master Kiyoshi Kurosawa is a philosophical inquiry as a prelude to extraterrestrial invasion.', 'web_url': 'https://www.nytimes.com/2018/02/01/movies/before-we-vanish-review.html', 'snippet': 'The latest from the Japanese horror master Kiyoshi Kurosawa is a philosophical inquiry as a prelude to extraterrestrial invasion.', 'lead_paragraph': 'When will they ever learn? The aliens, I mean, who can’t seem to resist the impulse to invade Earth and wipe out humanity. “Before We Vanish,” Kiyoshi Kurosawa’s witty science-fiction chin-scratcher — less a horror movie than a series of musings on potentially horrifying ideas — addresses the question literally. It concerns a reconnaissance squad of space travelers sent to do fieldwork in our ways and habits, with particular emphasis on our mental concepts.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02beforewevanish/merlin_132731168_fedf873d-789d-49f3-87ee-c05159dc3e04-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/02/arts/02beforewevanish/merlin_132731168_fedf873d-789d-49f3-87ee-c05159dc3e04-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02beforewevanish/merlin_132731168_fedf873d-789d-49f3-87ee-c05159dc3e04-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02beforewevanish/merlin_132731168_fedf873d-789d-49f3-87ee-c05159dc3e04-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02beforewevanish/02beforewevanish-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/02/arts/02beforewevanish/02beforewevanish-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/02/arts/02beforewevanish/02beforewevanish-thumbLarge.jpg', 'height