argeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/21burnerfresh/merlin_133655547_a680de1a-ca6d-488b-9c82-b0732740cb18-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/21burnerfresh/merlin_133655547_a680de1a-ca6d-488b-9c82-b0732740cb18-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/21burnerfresh/21burnerfresh-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/28/dining/21burnerfresh/21burnerfresh-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/21burnerfresh/21burnerfresh-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Popular Taiwanese Chain Opens an Outpost in the East Village', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Spoon: A Taiwanese Dessert Cafe Sets Up Shop in New York', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Meet Fresh', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ice Cream and Frozen Desserts', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Desserts', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'East Village (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-02-26T20:29:20+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6a510517-f49a-53f5-b933-4105b1bba267', 'word_count': 110, 'uri': 'nyt://article/6a510517-f49a-53f5-b933-4105b1bba267'}, {'abstract': 'Made In’s three-quart saucier has a rounded profile to aid the whisking of custards and other sauces.', 'web_url': 'https://www.nytimes.com/2018/02/26/dining/made-in-saucier.html', 'snippet': 'Made In’s three-quart saucier has a rounded profile to aid the whisking of custards and other sauces.', 'lead_paragraph': 'Made In, a cookware brand that’s been on the market since September, has developed a new saucier in response to consumer demand. The wide, generous saucepan has a rounded profile to make stirring and whisking a custard, hollandaise or a risotto a breeze. Like the rest of the line, it is produced in the United States and made of five-ply metal: aluminum for conductivity and stainless steel for practicality. The saucier is compatible with induction cooktops, and its long handle stays cool. Made In sells only directly to consumers, so the price-quality ratio is very positive, often half the price of some name brands in stores: Made In, three-quart saucier, $85 without lid, $99 with lid, madeincookware.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/28/dining/28burnerpan/merlin_134243111_7d6a966d-91cf-4fa5-8888-22fb34d012e6-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/28/dining/28burnerpan/merlin_134243111_7d6a966d-91cf-4fa5-8888-22fb34d012e6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'c