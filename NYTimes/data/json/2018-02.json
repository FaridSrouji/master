': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/books/review/0225-BKS-LIST/0225-BKS-LIST-superJumbo.jpg', 'height': 449, 'width': 438, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/books/review/0225-BKS-LIST/0225-BKS-LIST-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/25/books/review/0225-BKS-LIST/0225-BKS-LIST-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/books/review/0225-BKS-LIST/0225-BKS-LIST-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Setting Her Hair on Fire, Lisa Gardner Decided to Become a Writer', 'kicker': 'Inside the List', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Look for Me (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gardner, Lisa (Author)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': "Everything Happens for a Reason: And Other Lies I've Loved (Book)", 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bowler, Kate (Author)', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-02-16T10:00:37+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Tina Jordan', 'person': [{'firstname': 'Tina', 'middlename': None, 'lastname': 'Jordan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/82216ac9-d6f6-5e07-b3a6-7f7e4b4863aa', 'word_count': 461, 'uri': 'nyt://article/82216ac9-d6f6-5e07-b3a6-7f7e4b4863aa'}, {'abstract': 'Exploring one of China’s most exciting, progressive cities on a budget.', 'web_url': 'https://www.nytimes.com/2018/02/16/travel/chengdu-china-budget-affordable-food.html', 'snippet': 'Exploring one of China’s most exciting, progressive cities on a budget.', 'lead_paragraph': '“Now, that bear is definitely not white,” said the Dutch tourist next to me. The giant panda turned in our direction at that moment and let out some kind of loud sneeze or snort as if to say, “Give me a break, pal.” It was raining and muddy, after all, and even slightly smudged, the panda bears at the Chengdu Research Base of Giant Panda Breeding were still absurdly adorable. The bear ambled off to climb a nearby jungle gym-like structure, fell off it once or twice, eventually gave up, and finally settled on a choice piece of bamboo to munch on. ', 'print_section': 'TR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25frugal-chengdu6/18frugal-chengdu6-articleLarge.jpg', 'height': 364, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/25/travel/25frugal-chengdu6/18frugal-chengdu6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 364}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25frugal-chengdu6/18frugal-chengdu6-jumbo.jpg', 'height': 621, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/25/travel/25frugal-chengdu6/18frugal-chengdu6-superJumbo.jpg', 'height': 1243, 'width': 2048, 'subType': 'superJumbo', 'crop_name':