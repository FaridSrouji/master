'major': 'N'}], 'pub_date': '2018-02-05T00:35:21+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Jina Moore', 'person': [{'firstname': 'Jina', 'middlename': None, 'lastname': 'Moore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/baa62531-8d1f-5a64-98c5-b9624a0ac9ff', 'word_count': 1102, 'uri': 'nyt://article/baa62531-8d1f-5a64-98c5-b9624a0ac9ff'}, {'abstract': 'Imagine the day when operatives can create fake video of their enemies. That day is here.', 'web_url': 'https://www.nytimes.com/2018/02/04/opinion/hacking-politics-future.html', 'snippet': 'Imagine the day when operatives can create fake video of their enemies. That day is here.', 'lead_paragraph': 'Imagine it is the spring of 2019. A bottom-feeding website, perhaps tied to Russia, “surfaces” video of a sex scene starring an 18-year-old Kirsten Gillibrand. It is soon debunked as a fake, the product of a user-friendly video application that employs generative adversarial network technology to convincingly swap out one face for another.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/05/opinion/05FarrellPerlstein/merlin_133232672_88a593c8-4535-4bde-9af2-d9a9ad120a90-articleLarge.jpg', 'height': 421, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/05/opinion/05FarrellPerlstein/merlin_133232672_88a593c8-4535-4bde-9af2-d9a9ad120a90-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 421}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/05/opinion/05FarrellPerlstein/merlin_133232672_88a593c8-4535-4bde-9af2-d9a9ad120a90-jumbo.jpg', 'height': 719, 'width':