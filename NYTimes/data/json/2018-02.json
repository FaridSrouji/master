, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/24/opinion/24sat2sub/merlin_133798416_4f2b0509-2d74-427f-bac4-0df5e9918b7e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/24/opinion/24sat2sub/merlin_133798416_4f2b0509-2d74-427f-bac4-0df5e9918b7e-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/24/opinion/24sat2sub/24sat2sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/02/24/opinion/24sat2sub/24sat2sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/24/opinion/24sat2sub/24sat2sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Charity Workers Turn Predatory', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'When Charity Workers Turn Predatory', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Oxfam', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Humanitarian Aid', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Haiti', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-02-24T02:14:36+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/50063f3f-a287-5382-8f9b-792d82534567', 'word_count': 493, 'uri': 'nyt://article/50063f3f-a287-5382-8f9b-792d82534567'}, {'abstract': 'Inspired by the Olympics? People of all skill levels can get into winter sports like figure skating, bobsledding and, yes, even curling. Here’s how.', 'web_url': 'https://www.nytimes.com/2018/02/23/smarter-living/how-to-get-started-with-olympic-winter-sports.html', 'snippet': 'Inspired by the Olympics? People of all skill levels can get into winter sports like figure skating, bobsledding and, yes, even curling. Here’s how.', 'lead_paragraph': 'There’s a familiar refrain heard in living rooms around the world during the Olympic Games: “I could do that.” Eye rolls usually follow. But if you are watching the Games and wondering if you can follow in the footsteps of those athletes, here’s a way to get started.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/07/sports/text-skeleton/text-skeleton-articleLarge-v5.jpg', 'height': 467, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/07/sports/text-skeleton/text-skeleton-articleLarge-v5.jpg', 'xlargewidth': 600, 'xlargeheight': 467}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/07/sports/text-skeleton/text-skeleton-jumbo-v5.jpg', 'height': 798, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/07/sports/text-skeleton/text-skeleton-superJumbo-v5.jpg', 'height': 1595, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/07/sports/text-skeleton/text-sk