', 'url': 'images/2015/07/14/sports/14SANDOMIRweb1/14SANDOMIRweb1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/14/sports/14SANDOMIRweb1/14SANDOMIRweb1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/14/sports/14SANDOMIRweb1/14SANDOMIRweb1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'FanDuel and DraftKings, Leaders in Daily Fantasy Sports, Are Quickly Gaining Clout', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stakes Are Rising Rapidly in the Daily Fantasy Industry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fantasy Sports', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sandomir, Richard (Per)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'DraftKings Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'FanDuel.com', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'ESPN', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox Sports', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Venture Capital', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Yahoo! Inc', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'King, Matt', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Robins, Jason (1980- )', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-07-13T15:02:36+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a2c0057e-0189-5e4e-9e9b-cb0ed4643802', 'word_count': 902, 'uri': 'nyt://article/a2c0057e-0189-5e4e-9e9b-cb0ed4643802'}, {'abstract': 'A journalist looks at how Indra Devi spread yoga throughout the world.', 'web_url': 'https://www.nytimes.com/2015/07/19/books/review/the-goddess-pose-by-michelle-goldberg.html', 'snippet': 'A journalist looks at how Indra Devi spread yoga throughout the world.', 'lead_paragraph': 'Growing up in 1980s India, I was, for a time, placed in an all-girls school where nuns in habits gave yoga lessons to which we wore stiff-collared white shirts tucked into navy blue bloomer-like shorts. I claimed the back row in the lotus position, arms outstretched and fingers curled into a gyan mudra. I never awakened a chakra, but sometimes I fell asleep. ', 'print_section': 'BR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/books/review/19FALEIRO/19FALEIRO-articleLarge.jpg', 'height': 613, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/19/books/review/19FALEIRO/19FALEIRO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 613}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/books/review/19FALEIRO/19FALEIRO-jumbo.jpg', 'height': 1024, 'width': 1003, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/books/review/19FALEIRO/19FALEIRO-superJumbo.jpg', 'height': 2048, 'width': 2005, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/books/review/19FALEIRO/19FALEIRO-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'th