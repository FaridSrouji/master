one, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/t-magazine/19entertain-edletter/19entertain-edletter-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/19/t-magazine/19entertain-edletter/19entertain-edletter-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/t-magazine/19entertain-edletter/19entertain-edletter-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/t-magazine/19entertain-edletter/19entertain-edletter-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/t-magazine/19entertain-edletter/19entertain-edletter-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/19/t-magazine/19entertain-edletter/19entertain-edletter-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/t-magazine/19entertain-edletter/19entertain-edletter-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Play on Words', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'A Play on Words', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-07-17T21:00:42+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Deborah Needleman', 'person': [{'firstname': 'Deborah', 'middlename': None, 'lastname': 'Needleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3270f80e-ceef-5373-a754-aa63e0bb02e2', 'word_count': 489, 'uri': 'nyt://article/3270f80e-ceef-5373-a754-aa63e0bb02e2'}, {'abstract': 'Deleting the name of a dead friend from your phone can feel like removing that person from the world.', 'web_url': 'https://www.nytimes.com/2015/07/19/opinion/sunday/my-digital-cemetery.html', 'snippet': 'Deleting the name of a dead friend from your phone can feel like removing that person from the world.', 'lead_paragraph': 'SAVANNAH, GA. — MY digital address book lists 2,743 contacts. This is not because I’m popular or extroverted; I’m neither. It’s because this collection of names stretches back two decades, the oldest contacts tracing to a 1996 Palm Pilot and preserved through transfers involving more devices than I care to remember. It covers life in four cities and work on countless reporting projects. The idea of organizing and pruning this slow-motion data dump is by now unthinkable.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/opinion/sunday/19COVER/19COVER-articleLarge-v2.jpg', 'height': 766, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/19/opinion/sunday/19COVER/19COVER-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 766}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/opinion/sunday/19COVER/19COVER-jumbo-v2.jpg', 'height': 1024, 'width': 802, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/opinion/sunday/19COVER/19COVER