y': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-superJumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/egan-circular/egan-circular-thumbLarge-v4.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Heritage and Healing', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Heritage and Healing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'United States', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Egan, Timothy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rural Areas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Nez Perce Indians', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Joseph (Ore)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Native Americans', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Oregon', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-07-17T07:21:04+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/48a4a73d-683c-5a50-8f38-de6fa8d310e7', 'word_count': 849, 'uri': 'nyt://article/48a4a73d-683c-5a50-8f38-de6fa8d310e7'}, {'abstract': 'The Lone Star State’s history explains the alarmed reaction to a military training exercise.', 'web_url': 'https://www.nytimes.com/2015/07/17/opinion/why-texans-fear-invasion.html', 'snippet': 'The Lone Star State’s history explains the alarmed reaction to a military training exercise.', 'lead_paragraph': 'HOUSTON — A PSYCHIATRIST I knew many years ago suggested to me that a person’s irrational behavior in the present was probably not so irrational (to the person) in the past. As time has gone on, this insight has proved pretty useful, helping me develop empathy not just for bad boyfriends and crazy bosses, but for understanding my home state of Texas, which, let’s face it, has been known to excel at throw-up-your-hands behavior.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17Swartz/17Swartz-articleLarge.jpg', 'height': 359, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/17/opinion/17Swartz/17Swartz-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 359}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17Swartz/17Swartz-jumbo.jpg', 'height': 613, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17Swartz/17Swartz-superJumbo.jpg', 'height': 1226, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17Swartz/17Swartz-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/17/opinion/17Swartz/17Swartz-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17Swartz/17Swartz-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Texans Fear Invasion', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Why Texans Fear Invasion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Swartz, Mimi', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fringe Groups and Movements', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bradburn, Juan Davis (1787-1842)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-17T07:21:04+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Mimi Swartz', 'person': [{'firstname': 'Mimi', 'middlename': None, 'lastname': 'Swartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/66ccaaf2-0a44-5c54-b61e-169e93221359', 'word_count': 917, 'uri': 'nyt://article/66ccaaf2-0a44-5c54-b61e-169e93221359'}, {'abstract': 'A proposed law would weaken the agency’s already ineffective oversight.', 'web_url': 'https://www.nytimes.com/2015/07/17/opinion/the-fdas-medical-device-problem.html', 'snippet': 'A proposed law would weaken the agency’s already ineffective oversight.', 'lead_paragraph': 'THE Food and Drug Administration has been regulating the approval of medical devices since 1976, but its regulatory oversight has not kept pace with the increasing complexity of this technology. Many high-risk medical devices today are approved on the basis of just one clinical trial (as opposed to new medications, which usually require two trials). And only a small minority of clinical studies of medical devices are randomized, controlled and blinded — the gold standard for reliable evidence (and the benchmark to which studies of drugs are held).', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The F.D.A.’s Medical Device Problem', 'kicker': 'Op-Ed Contributors', 'content_kicker': None, 'print_headline': 'The F.D.A.’s Medical Device Problem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medical Devices', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Redberg, Rita F', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-17T07:21:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Rita F. Redberg and Sanket S. Dhruva', 'person': [{'firstname': 'Rita', 'middlename': 'F.', 'lastname': 'Redberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sanket', 'middlename': 'S.', 'lastname': 'Dhruva', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/731b35a3-75ec-5468-b374-7cb0d02f3cd3', 'word_count': 790, 'uri': 'nyt://article/731b35a3-75ec-5468-b374-7cb0d02f3cd3'}, {'abstract': 'The Fair Employment Project writes that “do no harm” means that doctors need to become aware of the legal ramifications of their notes for patients.', 'web_url': 'https://www.nytimes.com/2015/07/17/opinion/doctor-notes-in-pregnancy.html', 'snippet': 'The Fair Employment Project writes that “do no harm” means that doctors need to become aware of the legal ramifications of their notes for patients.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Doctor Notes in Pregnancy', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Doctor Notes in Pregnancy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-07-17T07:21:04+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/817dba69-6874-5db9-b1a7-3934c91a1baa', 'word_count': 192, 'uri': 'nyt://article/817dba69-6874-5db9-b1a7-3934c91a1baa'}, {'abstract': 'If Iranian leaders want the nuclear deal to help the nation shed its pariah status, they can start by freeing the Washington Post journalist.', 'web_url': 'https://www.nytimes.com/2015/07/17/opinion/iran-must-free-jason-rezaian.html', 'snippet': 'If Iranian leaders want the nuclear deal to help the nation shed its pariah status, they can start by freeing the Washington Post journalist.', 'lead_paragraph': 'In the year leading up to this week’s nuclear deal with Iran, the cruel and unjustified imprisonment of the Washington Post journalist Jason Rezaian complicated negotiations between world powers and Tehran. It is imperative that Iran set him free immediately and unconditionally. If Iranian leaders want the deal to help the nation shed its international pariah status, they must start taking steps that generate good will. Freeing Mr. Rezaian is an important one.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17fri3web/17fri3web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/17/opinion/17fri3web/17fri3web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17fri3web/17fri3web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17fri3web/17fri3web-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17fri3web/17fri3web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/17/opinion/17fri3web/17fri3web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/opinion/17fri3web/17fri3web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Iran Must Free Jason Rezaian', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Ir