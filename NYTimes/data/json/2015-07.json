 None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bab4591-fba2-5f96-8ede-acdbb9bd96f9', 'word_count': 1181, 'uri': 'nyt://article/6bab4591-fba2-5f96-8ede-acdbb9bd96f9'}, {'abstract': 'Quotation of the Day for Tuesday, July 14, 2015.', 'web_url': 'https://www.nytimes.com/2015/07/14/pageoneplus/quotation-of-the-day.html', 'snippet': 'Quotation of the Day for Tuesday, July 14, 2015.', 'lead_paragraph': '“I believe that at its heart, America is a nation of second chances. And I believe these folks deserve their second chance.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-07-14T04:44:09+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/d1b489eb-0487-5653-8b5a-17f9447e34c9', 'word_count': 41, 'uri': 'nyt://article/d1b489eb-0487-5653-8b5a-17f9447e34c9'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/07/14/arts/television/whats-on-tv-tuesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (Pop) A PERFECT MURDER (1998) Steven (Michael Douglas), a reptilian Wall Street bond salesman about to lose his shirt, plots to kill his wife, Emily (Gwyneth Paltrow, above, with Mr. Douglas), a United Nations interpreter, and inherit her fortune in Andrew Davis’s update of “Dial M for Murder,” the play by Frederick Knott (and the film by Alfred Hitchcock). Viggo Mortensen portrays Emily’s lover, whom Steven offers $500,000 to do the deed or be exposed for the con man and gigolo he really is. “The creepiest aspect of ‘A Perfect Murder’ is that there really is no contest between love and money,” Stephen Holden wrote in The New York Times. “The movie is right in tune with the icy Darwinian mood fostered by the booming late-’90s economy.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Tuesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What&#8217;s On TV Tuesday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-07-14T05:00:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/a465645d-55c0-5902-bc67-2d5036edb875', 'word_count': 734, 'uri': 'nyt://article/a465645d-55c0-5902-bc67-2d5036edb875'}, {'abstract': 'Corrections appearing in print on Tuesday, July 14, 2015.', 'web_url': 'https://www.nytimes.com/2015/07/14/pageoneplus/corrections-july-14-2015.html', 'snippet': 'Corrections appearing in print on Tuesday, July 14, 2015.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: July 14, 2015', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-07-14T05:28:46+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/116c5761-5b55-5cbc-b8e6-f03ae5e23d2d', 'word_count': 618, 'uri': 'nyt://article/116c5761-5b55-5cbc-b8e6-f03ae5e23d2d'}, {'abstract': 'A look at the United States team’s performances in a Concacaf Gold Cup draw with Panama on Monday night.', 'web_url': 'https://www.nytimes.com/2015/07/14/sports/soccer/player-ratings-us-1-vs-panama-1.html', 'snippet': 'A look at the United States team’s performances in a Concacaf Gold Cup draw with Panama on Monday night.', 'lead_paragraph': 'In its final group-stage game at the Concacaf Gold Cup, the United States national team came out flat and was forced to rally for a draw against a motivated Panama squad. In all three games at the tournament, Coach Jurgen Klinsmann’s squad has been outplayed early, and with the knockout stage set to begin this weekend, there is little margin for error.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/15/sports/14RATINGS2/14RATINGS2-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/15/sports/14RATINGS2/14RATINGS2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/15/sports/14RATINGS2/14RATINGS2-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/15/sports/14RATINGS2/14RATINGS2-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/15/sports/14RATINGS2/14RATINGS2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/15/sports/14RATINGS2/14RATINGS2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/15/sports/14RATINGS2/14RATINGS2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Player Ratings: U.S. (1) vs. Panama (1)', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "United States Men's National Soccer Team", 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dempsey, Clint', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bradley, Michael', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Klinsmann, Jurgen', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-14T05:38:34+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Brian Sciaretta', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Sciaretta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eade052a-f721-56c4-90f6-b9fe4d99c514', 'word_count': 1070, 'uri': 'nyt://article/eade052a-f721-56c4-90f6-b9fe4d99c514'}, {'abstract': 'A young South African photographer born after apartheid explores his country, from black and white to rich and poor.', 'web_url': 'https://lens.blogs.nytimes.com/2015/07/14/born-free-in-south-africa/', 'snippet': 'A young South African photographer born after apartheid explores his country, from black and white to rich and poor.', 'lead_paragraph': 'With bold confidence, Sipho Mpongo, born in 1993, a year before apartheid ended, declares himself part of “the new age of South Africa.” His parents, like many of their generation, fought for freedom.