/arts/22PARTCH/22PARTCH-jumbo.jpg', 'height': 652, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/arts/22PARTCH/22PARTCH-superJumbo.jpg', 'height': 1303, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/arts/22PARTCH/22PARTCH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/22/arts/22PARTCH/22PARTCH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/arts/22PARTCH/22PARTCH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Reviving a Harry Partch Work With Hubcaps and Wine Bottles', 'kicker': None, 'content_kicker': None, 'print_headline': 'Reviving a Work With Hubcaps and Wine Bottles ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Partch, Harry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Musical Instruments', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Center Theater', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Ensemble Musikfabrik', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-21T21:36:52+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Michael Cooper', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cooper', 'qualifier': None, 'title': N