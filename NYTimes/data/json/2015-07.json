or': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-16T20:55:19+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Jodi Rudoren', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Rudoren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/75ac6fc5-d530-5b29-8bc8-4212ddb143a1', 'word_count': 1146, 'uri': 'nyt://article/75ac6fc5-d530-5b29-8bc8-4212ddb143a1'}, {'abstract': 'This lesser-known 16th-century Dutch artist could think like a devil and paint like an angel.', 'web_url': 'https://www.nytimes.com/2015/07/17/arts/design/review-joachim-wtewaels-provocative-and-puzzling-paintings-at-the-national-gallery.html', 'snippet': 'This lesser-known 16th-century Dutch artist could think like a devil and paint like an angel.', 'lead_paragraph': 'WASHINGTON — How can you maintain fame if people can’t say your name? This is one question that might have occurred to the 16th-century Dutch artist Joachim Wtewael if he had cared about lasting fame, which, apparently, he only sometimes did. Over the span of his well-cushioned life in Utrecht, Wtewael — pronounced, approximately, oo-tuh-vawl (even the Dutch have a hard time with it) — seems to have paid more attention to selling flax and buying stocks than he did to making art, even though art was his first calling and did bring him local renown.', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17DUTCH/17DUTCH-articleLarge.jpg', 'height': 792, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'l