id': 'nyt://article/c99511e2-cd81-5cb9-b252-a129dda403ae', 'word_count': 901, 'uri': 'nyt://article/c99511e2-cd81-5cb9-b252-a129dda403ae'}, {'abstract': 'The songs of Mr. Sondheim change KT Sullivan and Jeff Harnar, the stars of this revue, into more complex entertainers than previously suspected.', 'web_url': 'https://www.nytimes.com/2015/07/20/arts/music/review-another-hundred-people-digs-into-stephen-sondheims-catalog.html', 'snippet': 'The songs of Mr. Sondheim change KT Sullivan and Jeff Harnar, the stars of this revue, into more complex entertainers than previously suspected.', 'lead_paragraph': '“Another Hundred People,” a thrilling new revue at the Laurie Beechman Theater, is the most dramatic example I can remember of how a crash course in the songs of Stephen Sondheim can transform entertainers you thought you knew into beings far more complex and sophisticated than you ever suspected. As its stars, KT Sullivan and Jeff Harnar, dug into Mr. Sondheim’s catalog, it was as though they had suddenly grown up.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20SULLIVAN/20SULLIVAN-articleLarge.jpg', 'height': 906, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/20/arts/20SULLIVAN/20SULLIVAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 906}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20SULLIVAN/20SULLIVAN-jumbo.jpg', 'height': 1024, 'width': 679, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20SULLIVAN/20SULLIVAN-superJumbo.jpg', 'height': 1852, 'width': 1227, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20SULLIVAN/20SULLIVAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/20/arts/20SULLIVAN/20SULLIVAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20SULLIVAN/20SULLIVAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Another Hundred People’ Digs Into Stephen Sondheim’s Catalog', 'kicker': None, 'content_kicker': None, 'print_headline': 'Two Singers Transformed by Sondheim ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sondheim, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Weber, Jon', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Sullivan, KT', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Harnar, Jeff', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-07-19T21:21:57+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0c089fbb-6386-5b7e-b011-057e6059703e', 'word_count': 410, 'uri': 'nyt://article/0c089fbb-6386-5b7e-b011-057e6059703e'}, {'abstract': 'A new book from Dr. Seuss inspires a Seuss-ian review from Michiko Kakutani.', 'web_url': 'https://www.nytimes.com/2015/07/20/books/review-what-pet-should-i-get-a-new-book-from-dr-seuss.html', 'snippet': 'A new book from Dr. Seuss inspires a Seuss-ian review from Michiko Kakutani.', 'lead_paragraph': 'In Seussland, we are likely to meetThe fuzzy and feathered and furry,They like to wear hats, mittens and socks,And run, fly and jump in a hurry.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20BOOKSEUSS/20BOOKSEUSS-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/20/arts/20BOOKSEUSS/20BOOKSEUSS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20BOOKSEUSS/20BOOKSEUSS-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20BOOKSEUSS/20BOOKSEUSS-superJumbo.jpg', 'height': 1684, 'width': 1263, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20BOOKSEUSS/20BOOKSEUSS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/20/arts/20BOOKSEUSS/20BOOKSEUSS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/20/arts/20BOOKSEUSS/20BOOKSEUSS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘What Pet Should I Get?,’ a New Book From Dr. Seuss', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Tale of Critters From Dr. Seuss (The Late Great)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Geisel, Theodor Seuss', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'What Pet Should I Get? (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-19T21:30:58+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Michiko Kakutani', 'person': [{'firstname': 'Michiko', 'middlename': None, 'lastname': 'Kakutani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b1640ed6-f1dd-511d-82e0-be2d3ce6f152', 'word_count': 425, 'uri': 'nyt://article/b1640ed6-f1dd-511d-82e0-be2d3ce6f152'}, {'abstract': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'web_url': 'https://www.nytimes.com/2015/07/20/business/treasury-auctions-set-for-the-week-of-july-20.html', 'snippet': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'lead_paragraph': 'The Treasury’s schedule of financing this week includes Monday’s auction of new three- and six-month bills and an auction of four-week bills on Tuesday. At the close of the New York cash market Friday, the rate on the outstanding three-month bill was 0.02 percent. The six-month rate was 0.11 percent, and the four-week rate was 0.02 percent. The following tax-exempt fixed-income issues are scheduled for pricing this week: ', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Treasury Auctions Set for the Week of July 20', 'kicker': None, 'content_kicker': None, 'print_headline': 'Treasury Auctions Set for This Week', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Municipal Bonds', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Treasury Department', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Credits, Deductions and Exemptions', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-07-19T21:33:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/508a96a9-20f4-59d1-9280-3da6c0adf8bb', 'word_count': 528, 'uri': 'nyt://article/508a96a9-20f4-59d1-9280-3da6c0adf8bb'}, {'abstract': 'Cast members of HBO’s “The Wire” gathered in Baltimore to reflect upon the recent unrest in the city and pay homage to its residents.', 'web_url': 'https://www.nytimes.com/2015/07/20/arts/television/the-wire-cast-gathers.html', 'snippet': 'Cast members of HBO’s “The Wire” gathered in Baltimore to reflect upon the recent unrest in the city and pay homage to its residents.', 'lead_paragraph': 'Cast members of HBO’s “The Wire” gathered at the Modell Performing Arts Center at the Lyric in Baltimore on Saturday to reflect upon the recent unrest in the city and pay homage to its residents. The event, “Wired Up!,” was part of the annual Baltimore arts festival Artscape and featured the cast members Michael K. Williams, Sonja Sohn, Andre Royo and Larry Gilliard Jr. The sold-out event came about thanks to Ms. Sohn and her fellow cast member Maria Broom, who interviewed residents in West Baltimore about their experiences during the protests after the death of the young black man Freddie Gray. They turned the interviews into monologues that were read in tandem by the residents, including single mothers and self-professed gang members, and actors from the show. Dominic West and Wendell Pierce, two of the show’s stars, and the director David Simon were not present, but sent video messages.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The ‘Wire’ Cast Gathers', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'The &#8216;Wire&#8217; Cast Gathers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Baltimore (Md)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gray, Freddie (1989-2015)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Wire (TV Program)', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-07-19T21:54:12+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'Compiled by Andrew R. Chow', 'person': [{'firstname': 'Andrew', 'middlename': 'R.', 'lastname': 'Chow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/5e9f655d-5136-57ef-b1d1-729d6f63cc49', 'word_count': 150, 'uri': 'nyt://article/5e9f655d-5136-57ef-b1d1-729d6f63cc49'}, {'abstract': 'Joel Paley and Marvin Laird’s musical, about a little girl determined to secure a part in a school play, is revived at St. Luke’s Theater.', 'web_url': 'https://www.nytimes.com/2015/07/21/theater/review-ruthless-at-st-lukes-takes-stage-ambition-to-the-playground.html', 'snippet': 'Joel Paley and Marvin Laird’s musical, about a little girl determined to secure a part in a school play, is revived at St. Luke’s Theater.', 'lead_paragraph': 'A spiked Shirley Temple of a show, “Ruthless!” opened 23 years ago with the likes of Natalie 