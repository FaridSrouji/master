nk': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ARMS CONTROL AND LIMITATION AND DISARMAMENT', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Cold War Era', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-15T08:10:43+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By James P. Rubin', 'person': [{'firstname': 'James', 'middlename': 'P.', 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/ea229dab-b455-565d-89f3-d55df2d8c8a2', 'word_count': 915, 'uri': 'nyt://article/ea229dab-b455-565d-89f3-d55df2d8c8a2'}, {'abstract': 'Buyer demand for housing remains high in the hilly 5.7-square-mile village of around 11,000 residents located about 25 miles from Midtown Manhattan.', 'web_url': 'https://www.nytimes.com/2015/07/19/realestate/tarrytown-ny-steeped-in-history.html', 'snippet': 'Buyer demand for housing remains high in the hilly 5.7-square-mile village of around 11,000 residents located about 25 miles from Midtown Manhattan.', 'lead_paragraph': 'While Tarrytown and the construction of the new Tappan Zee Bridge are intertwined in the news these days, this village rich in Revolutionary War history and culture\xa0has always been a\xa0popular spot\xa0in the Hudson Valley for its river views, its historic houses and its many activities.', 'print_section': 'RE', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/realestate/20150719LIVING-slide-QC93-copy/20150719LIVING-slide-QC93-copy-articleLarge.jpg', 'height'