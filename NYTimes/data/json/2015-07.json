': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/18/sports/18ARNSPARGER-obit-1/18ARNSPARGER-obit-1-superJumbo-v3.jpg', 'height': 1701, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/18/sports/18ARNSPARGER-obit-1/18ARNSPARGER-obit-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/18/sports/18ARNSPARGER-obit-1/18ARNSPARGER-obit-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/18/sports/18ARNSPARGER-obit-1/18ARNSPARGER-obit-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bill Arnsparger, Architect of Feared Dolphins Defenses, Dies at 88', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bill Arnsparger Dies at 88; Defensive Coach Created ‘No Name’ and ‘Killer Bees’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Goldstein, Richard', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Dolphins', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Arnsparger, Bill (1926-2015)', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-18T00:45:13+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Richard Goldstein', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Goldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/81577d0c-eccd-5cbe-b591-975855a404c9', 'word_count': 916, 'uri': 'nyt://article/81577d0c-eccd-5cbe-b591-975855a404c9'}, {'abstract': 'At least 50 people were killed in a suicide car bombing in a central marketplace in eastern Iraq on Friday.', 'web_url': 'https://www.nytimes.com/2015/07/18/world/middleeast/iraq-dozens-killed-in-car-bombing-at-end-of-ramadan.html', 'snippet': 'At least 50 people were killed in a suicide car bombing in a central marketplace in eastern Iraq on Friday.', 'lead_paragraph': ' At least 50 people were killed in a suicide car bombing in a central marketplace in eastern Iraq on Friday, as people shopped for Eid al-Fitr, the Muslim holiday that marks the end of the holy month of Ramadan, the authorities said. The attack took place in the heart of Khan Bani Saad township, a mostly Shiite area about a dozen miles from Baquba, the capital of Diyala Province. At least 90 people were wounded, and some reports said that as many as 80 may have died. There was no immediate claim of responsibility for the bombing, although the Islamic State has carried out a number of bombings in predominantly Shiite areas of Iraq. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Iraq: Dozens Killed in Car Bombing at End of Ramadan', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Middle East; Iraq: Dozens Killed in Car Bombing at End of Ramadan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iraq', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jawoshy, Omar Al-', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ramadan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-18T00:49:14+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Omar Al-Jawoshy', 'person': [{'firstname': 'Omar', 'middlename': None, 'lastname': 'Al-Jawoshy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/bb9a19e5-f801-570d-883b-90b4ca86cbf7', 'word_count': 114, 'uri': 'nyt://article/bb9a19e5-f801-570d-883b-90b4ca86cbf7'}, {'abstract': 'In a lawsuit filed Thursday, a group of Seattle residents said the city’s garbage inspection rules violated their privacy rights.', 'web_url': 'https://www.nytimes.com/2015/07/18/us/residents-sue-seattle-saying-new-trash-rules-violate-privacy.html', 'snippet': 'In a lawsuit filed Thursday, a group of Seattle residents said the city’s garbage inspection rules violated their privacy rights.', 'lead_paragraph': 'SEATTLE — Environmental goals about garbage in this and other like-minded cities increasingly come down to three words: Throw less away. So Seattle residents are given different bins to put out on the curb — one for yard and food waste, another for recycling — and are encouraged to use ever-tinier cans for the stuff that really is trash.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/18/us/18TRASH1/18TRASH1-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/18/us/18TRASH1/18TRASH1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/18/us/18TRASH1/18TRASH1-jum