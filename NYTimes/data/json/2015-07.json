, {'abstract': 'Less than 1 percent of Japan’s industrial output is military-related, but some of the nation’s large industrial conglomerates have long had sidelines in military production.', 'web_url': 'https://www.nytimes.com/2015/07/13/business/international/with-ban-on-exports-lifted-japan-arms-makers-cautiously-market-wares-abroad.html', 'snippet': 'Less than 1 percent of Japan’s industrial output is military-related, but some of the nation’s large industrial conglomerates have long had sidelines in military production.', 'lead_paragraph': 'YOKOHAMA, Japan — Some of Japan’s biggest companies, best known for motorcycles, washing machines and laptop computers, are pitching a new line of global products: military hardware.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/23/business/24japanarms-web2/24japanarms-web2-articleLarge.jpg', 'height': 416, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/23/business/24japanarms-web2/24japanarms-web2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 416}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/23/business/24japanarms-web2/24japanarms-web2-jumbo.jpg', 'height': 711, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/23/business/24japanarms-web2/24japanarms-web2-superJumbo.jpg', 'height': 1421, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/23/business/24japanarms-web2/24japanarms-web2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 