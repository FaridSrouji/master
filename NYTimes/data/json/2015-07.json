/07/26/magazine/26bagel-promo/26bagel-opener-thumbStandard-v6.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/26/magazine/26bagel-promo/26bagel-opener-thumbStandard-v6.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/26/magazine/26bagel-promo/26bagel-opener-thumbLarge-v6.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Is It So Hard to Get a Great Bagel in California?', 'kicker': 'Feature', 'content_kicker': None, 'print_headline': 'A Hole in the Heart', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bagels', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weil, Elizabeth', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco Bay Area (Calif)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Wise Sons (San Francisco, Calif, Restaurant)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Beckerman, Leo (1983- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Bloom, Evan L', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-23T11:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Elizabeth Weil', 'person': [{'firstname': 'Elizabeth', 'middlename': None, 'lastname': 'Weil', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aab6c126-dd58-5254-b40b-f949094d7f82', 'word_count': 2652, 'uri': 'nyt://article/aab6c126-dd58-5254-b40b-f949094d7f82'}, {'abstract': 'The Frugal Traveler’s first stop on a four-island Indonesia trip was Padang, known for its rich and spicy cuisine, during the Muslim fasting season.', 'web_url': 'https://www.nytimes.com/2015/07/23/travel/a-visit-to-padang-indonesias-food-paradise-during-ramadan.html', 'snippet': 'The Frugal Traveler’s first stop on a four-island Indonesia trip was Padang, known for its rich and spicy cuisine, during the Muslim fasting season.', 'lead_paragraph': 'The afternoon market on the grounds of Imam Bonjol Stadium in Padang, Indonesia, lasts just one month a year and looks like a nibbler’s paradise. Padang is known across Indonesia for its cuisine and it showed: mountains of fried noodles studded with shrimp chips and whole fried eggs; heaps of snails spiced with turmeric; mounds of tiny silvery anchovies with green chiles; beef long-simmered in coconut milk to become tender rendang; es campur, an icy dessert full of unfamiliar fruits and fluorescent cubes of gelatin.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/23/travel/23frugal1/23frugal1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/23/travel/23frugal1/23frugal1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/23/travel/23frugal1/23frugal1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/23/travel/23frugal1/23frugal1-superJumbo.jpg', 'height': 853, 'width': 1280, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/23/travel/23frugal1/23frugal1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStanda