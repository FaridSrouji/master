ltimedia': [], 'headline': {'main': 'Understanding the Options at the End of Life', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'Understanding the Options at the End of Life', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Death and Dying', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hospice Care', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-07-18T00:42:29+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/b09c9323-074e-5b29-babf-b44bc17f236a', 'word_count': 340, 'uri': 'nyt://article/b09c9323-074e-5b29-babf-b44bc17f236a'}, {'abstract': 'Prime Minister Benjamin Netanyahu of Israel called his Palestinian counterpart on Friday on Eid-al-Fitr, the first time the two leaders have spoken in more than a year.', 'web_url': 'https://www.nytimes.com/2015/07/18/world/middleeast/israel-netanyahu-and-abbas-talk-by-phone-after-year.html', 'snippet': 'Prime Minister Benjamin Netanyahu of Israel called his Palestinian counterpart on Friday on Eid-al-Fitr, the first time the two leaders have spoken in more than a year.', 'lead_paragraph': ' Prime Minister Benjamin Netanyahu of Israel called his Palestinian counterpart on Friday on Eid al-Fitr, the first time the two leaders have spoken in more than a year. Mr. Netanyahu’s office released a statement saying that the prime minister had told President Mahmoud Abbas of the Palestinian Authority that “the citizens of Israel want peace” and that “Israel would continue to act toward regional stability.” Palestinian news agencies reported that Mr. Abbas responded that it was important to reach a peace accord in the coming year. In the 13 months since the two men last spoke, in June 2014, Israel fought a devastating war with Palestinian militants in the Gaza Strip, and Mr. Abbas led the Palestinian Authority to join the International Criminal Court and pressed for Palestinian statehood through other international forums. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Israel: Netanyahu and Abbas Talk by Phone After Year', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Middle East; Israel: Netanyahu and Abbas Talk by Phone After Year', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rudoren, Jodi', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Netanyahu, Benjamin', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ABBAS, MAHMOUD', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Palestinian Authority', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Ramadan', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-18T00:43:33+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Jodi Rudoren', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Rudoren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/bf52f4d5-a900-50e8-843f-81758f487de4', 'word_count': 133, 'uri': 'nyt://article/bf52f4d5-a900-50e8-843f-81758f487de4'}, {'abstract': 'A reader writes about the ubiquity of too much air-conditioning.', 'web_url': 'https://www.nytimes.com/2015/07/18/opinion/baby-its-cold-inside.html', 'snippet': 'A reader writes about the ubiquity of too much air-conditioning.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Baby, It’s Cold Inside!', 'kicker': 'Letter', 'content_kicker': None