o', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/us/03FORD-OBIT-SUB/03FORD-OBIT-SUB-superJumbo.jpg', 'height': 1502, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/us/03FORD-OBIT-SUB/03FORD-OBIT-SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/03/us/03FORD-OBIT-SUB/03FORD-OBIT-SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/us/03FORD-OBIT-SUB/03FORD-OBIT-SUB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Glenn Ford, Death Row Prisoner Freed After 29 Years, Dies at 65', 'kicker': None, 'content_kicker': None, 'print_headline': 'Glenn Ford, Spared Death Row, Dies at 65', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weber, Bruce', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'False Arrests, Convictions and Imprisonments', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Louisiana State Penitentiary', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ford, Glenn (1949-2015)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-03T02:00:09+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Bruce Weber', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Weber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/3f3f4ea3-c084-5601-876e-f5aeefd680e7', 'word_count': 1153, 'uri': 'nyt://article/3f3f4ea3-c084-5601-876e-f5aeefd680e7'}, {'abstract': 'Brandon Hensley will not share his 15 Across.', 'web_url': 'https://wordplay.blogs.nytimes.com/2015/07/02/letter-accompanying-sin/', 'snippet': 'Brandon Hensley will not share his 15 Across.', 'lead_paragraph': 'FRIDAY PUZZLE — A very fresh and snappy puzzle by Brandon “I Make My Own Ice Cream From Scratch” Hensley. Mr. Hensley, who has yet to offer me any of his delicious RUM RAISIN ice cream, or even his lavender honeycomb flavor (which sounds fabulous), wondered if I was going to begin my post about his puzzle with the word “Ew,” like I did with his debut puzzle. I was actually responding to the grotesque rural legend that his theme described, and not his construction, because it’s impossible for me to think about what that legend described and not respond with an “Ew.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Letter Accompanying Sin', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-07-03T02:00:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a0086eb1-528f-5d1f-ba71-49e1395e8e9f', 'word_count': 531, 'uri': 'nyt://article/a0086eb1-528f-5d1f-ba71-49e1395e8e9f'}, {'abstract': 'Two commanders leading the opposing sides in the civil war convulsing South Sudan were sanctioned by the Treasury Department on Thursday for fomenting the conflict.', 'web_url': 'https://www.nytimes.com/2015/07/03/world/africa/south-sudan-2-sanctioned-by-us.html', 'snippet': 'Two commanders leading the opposing sides in the civil war convulsing South Sudan were sanctioned by the Treasury Department on Thursday for fomenting the conflict.', 'lead_paragraph': ' Two commanders leading the opposing sides in the civil war convulsing South Sudan were sanctioned by the Treasury Department on Thursday for fomenting the conflict. The action against the two, Gabriel Jok Riak and Simon Gatwech Dual, freezes any assets they have under American jurisdiction and bars them from transactions with Americans. The Treasury said the two were responsible for “perpetrating violence and breaching cease-fire agreements.” The United Nations Security Council has imposed sanctions on them and four others. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'South Sudan: 2 Sanctioned by U.S.', 'kicker': 'World Briefing | Africa', 'content_kicker': None, 'print_headline': 'South Sudan: 2 Sanctioned by U.S.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'South Sudan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-03T02:13:00+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Rick Gladstone', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Gladstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/fe737fb5-e4c8-5ca9-9e4e-ebe1e2d5caeb', 'word_count': 79, 'uri': 'nyt://article/fe737fb5-e4c8-5ca9-9e4e-ebe1e2d5caeb'}, {'abstract': 'An Iranian official signaled a willingness to accept Western demands for inspections of any nuclear-related facility, despite a previous rejection of such actions by the supreme leader.', 'web_url': 'https://www.nytimes.com/2015/07/03/world/middleeast/signs-of-a-compromise-over-inspections-in-iran-nuclear-talks.html', 'snippet': 'An Iranian official signaled a willingness to accept Western demands for inspections of any nuclear-related facility, despite a previous rejection of such actions by the supreme leader.', 'lead_paragraph': 'VIENNA — An Iranian official signaled Thursday that Tehran was trying to bridge the gap between Western demands for inspections of any suspected nuclear-related facility and a declaration by Iran’s supreme leader that foreigners could not enter military sites or interview Iranian scientists. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/world/IRAN/IRAN-articleLarge.jpg', 'height': 829, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/03/world/IRAN/IRAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 829}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/world/IRAN/IRAN-jumbo.jpg', 'height': 1024, 'width': 742, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/world/IRAN/IRAN-superJumbo.jpg', 'height': 1134, 'width': 821, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/world/IRAN/IRAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/03/world/IRAN/IRAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/world/IRAN/IRAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Signs of a Compromise Over Inspections in Iran Nuclear Talks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Signs of a Compromise on Inspections Emerge in Iran Talks ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iran', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gordon, Michael R', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Khamenei, Ali', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-03T02:31:46+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By David E. Sanger and Michael R. Gordon', 'person': [{'firstname': 'David', 'middlename': 'E.', 'lastname': 'Sanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Michael', 'middlename': 'R.', 'lastname': 'Gordon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cce70bca-a255-5e85-b76d-f7da413047d7', 'word_count': 812, 'uri': 'nyt://article/cce70bca-a255-5e85-b76d-f7da413047d7'}, {'abstract': 'Mr. Harbutt infused his work with evocative imagery and as an art photographer he transformed conventional scenes into surreal metaphors.', 'web_url': 'https://www.nytimes.com/2015/07/03/arts/charles-harbutt-photojournalist-with-an-eye-for-art-as-well-as-news-dies-at-79.html', 'snippet': 'Mr. Harbutt infused his work with evocative imagery and as an art photographer he transformed conventional scenes into surreal metaphors.', 'lead_paragraph': 'Charles Harbutt, a photojournalist who infused his work with evocative imagery and an art photographer who transformed conventional scenes into surreal metaphors, died late Monday or early Tuesday in Monteagle, Tenn., near Chattanooga, where he was teaching. He was 79.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/nyregion/obit-harbutt/obit-harbutt-articleLarge.jpg', 'height': 415, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/03/nyregion/obit-harbutt/obit-harbutt-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 415}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/nyregion/obit-harbutt/obit-harbutt-jumbo.jpg', 'height': 708, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/nyregion/obit-harbutt/obit-harbutt-superJumbo.jpg', 'height': 1415, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/nyregion/obit-harbutt/obit-harbutt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/03/nyregion/obit-harbutt/obit-harbutt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/nyregion/obit-harbutt/obit-harbutt-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Charles Harbutt, Photojournalist With an Eye for Art, Dies at 79', 'kicker': None, 'content_kicker': None, 'print_headline': 'Charles Harbutt, Photojournalist With an Eye for Art as Well as News, Dies at 79 ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Harbutt, Charles (1935-2015)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-03T02:36:46+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Sam Roberts', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Roberts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/3dfa4b98-e4f3-58d7-a49b-e88c51fb1227', 'word_count': 1030, 'uri': 'nyt://article/3dfa4b98-e4f3-58d7-a49b-e88c51fb1227'}, {'abstract': 'Opponents of Prime Minister Alexis Tsipras are backing a “yes” vote in a referendum on a deal with Greece’s creditors, hoping that outcome will force his ouster.', 'web_url': 'https://www.nytimes.com/2015/07/03/world/alexis-tsiprass-enemies-try-to-use-greek-vote-against-him.html', 'snippet': 'Opponents of Prime Minister Alexis Tsipras are backing a “yes” vote in a referendum on a deal with Greece’s creditors, hoping that outcome will force his ouster.', 'lead_paragraph': 'ATHENS — Prime Minister Alexis Tsipras says the referendum in Greece on Sunday is simply about whether to agree to what he sees as a bad deal from the country’s creditors. Many of his opponents say it is actually about whether Greece wants to stay with the euro.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit':