abstract': 'Solanezumab, from Eli Lilly, is getting another look for mild cases, and Biogen said data from a small group taking aducanumab showed mixed results.', 'web_url': 'https://www.nytimes.com/2015/07/23/business/new-data-on-2-alzheimers-drugs-alters-hope-and-expectation.html', 'snippet': 'Solanezumab, from Eli Lilly, is getting another look for mild cases, and Biogen said data from a small group taking aducanumab showed mixed results.', 'lead_paragraph': 'New data released on Wednesday raised hopes somewhat that an experimental Alzheimer’s drug from Eli Lilly & Company might be effective. At the same time, other results were released on Wednesday that could reduce expectations a bit for a similar drug being developed by Biogen.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Data on 2 Alzheimer’s Drugs Alters Hope and Expectation', 'kicker': None, 'content_kicker': None, 'print_headline': 'New Data on 2 Alzheimer&#8217;s Drugs Alter Hope and Expectation for Treatments', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pollack, Andrew', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Alzheimer's Disease", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Eli Lilly and Company', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Biogen Idec Inc', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Clinical Trials', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': "ALZHEIMER'S ASSN", 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-22T11:00:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Andrew Pollack', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Pollack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank'