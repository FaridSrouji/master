ty, its type and the result.', 'print_section': 'SP', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/sports/METS/METS-articleLarge.jpg', 'height': 526, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/05/sports/METS/METS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 526}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/sports/METS/METS-jumbo.jpg', 'height': 898, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/sports/METS/METS-superJumbo.jpg', 'height': 1797, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/sports/METS/METS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/05/sports/METS/METS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/sports/METS/METS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'From a Front Row Seat, Scott Boras Notes Matt Harvey’s Struggles', 'kicker': 'Dodgers 4, Mets 3', 'content_kicker': None, 'print_headline': 'Agent Notes Harvey&#8217;s Struggles in Mets&#8217; Loss', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Greinke, Zack', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Harvey, Matt', 'rank':