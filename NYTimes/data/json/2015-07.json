': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/arts/24PAPERTOWNS/24PAPERTOWNS-articleLarge.jpg', 'height': 445, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/24/arts/24PAPERTOWNS/24PAPERTOWNS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 445}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/arts/24PAPERTOWNS/24PAPERTOWNS-jumbo.jpg', 'height': 759, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/arts/24PAPERTOWNS/24PAPERTOWNS-superJumbo.jpg', 'height': 1518, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/arts/24PAPERTOWNS/24PAPERTOWNS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/24/arts/24PAPERTOWNS/24PAPERTOWNS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/arts/24PAPERTOWNS/24PAPERTOWNS-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Paper Towns’ Tries to Fold Significance Into the Everyday', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Besotted Boy, Chasing His Muse ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schreier, Jake', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Delevingne, Cara', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wolff, Nat', 'rank': 4, 'major': 'N'},