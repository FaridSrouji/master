nail': 'images/2015/07/05/business/05Gret-web/05Gret-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/05Gret-web/05Gret-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Samsung Merger Plan Called Unfair to Some Investors', 'kicker': None, 'content_kicker': None, 'print_headline': 'At Samsung, It’s Insiders vs. Outsiders', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Morgenson, Gretchen', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Samsung Electronics Co', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cheil Industries', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Shareholder Rights and Activism', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-04T15:36:09+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Gretchen Morgenson', 'person': [{'firstname': 'Gretchen', 'middlename': None, 'lastname': 'Morgenson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ce702c31-9cba-5156-800c-bd1a8f4c2291', 'word_count': 1091, 'uri': 'nyt://article/ce702c31-9cba-5156-800c-bd1a8f4c2291'}, {'abstract': 'Another look at the refurbished replacement cellphone that came complete with the previous owner’s apps, Facebook account and contacts list.', 'web_url': 'https://www.nytimes.com/2015/07/05/your-money/the-story-of-the-cellphone-with-a-past-life-continued.html', 'snippet': 'Another look at the refurbished replacement cellphone that came complete with the previous owner’s apps, Facebook account and contacts list.', 'lead_paragraph': 'As a connoisseur of corporate bungling, the Haggler cannot resist taking a second look at the strange story, told in our last episode, of Tom Paterson’s smartphone. You may recall that after Mr. Paterson’s Nexus 5 broke down, he mailed it to a T-Mobile repair/exchange center and, nine days later, received a refurbished version of the same device. ', 'print_section': 'BU', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-HAGGLER/5-HAGGLER-articleLarge.jpg', 'height': 629, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/05/business/5-HAGGLER/5-HAGGLER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 629}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-HAGGLER/5-HAGGLER-jumbo.jpg', 'height': 1024, 'width': 977, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-HAGGLER/5-HAGGLER-superJumbo.jpg', 'height': 1687, 'width': 1608, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-HAGGLER/5-HAGGLER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/05/business/5-HAGGLER/5-HAGGLER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-HAGGLER/5-HAGGLER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thum