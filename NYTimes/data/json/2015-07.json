politics/selfie-hp-slide-ZKJB/selfie-hp-slide-ZKJB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Selfie Election', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-07-05T09:14:48+0000', 'document_type': 'multimedia', 'news_desk': 'U.S.', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/3f30b8a6-2dc4-5a04-81b0-48ea357aa6f7', 'word_count': 0, 'uri': 'nyt://slideshow/3f30b8a6-2dc4-5a04-81b0-48ea357aa6f7'}, {'abstract': 'Discover Macedonia is offering nine-day guided tours with moderate cycling and hiking.', 'web_url': 'https://www.nytimes.com/2015/07/05/travel/new-bike-tours-of-macedonia.html', 'snippet': 'Discover Macedonia is offering nine-day guided tours with moderate cycling and hiking.', 'lead_paragraph': 'Jim Johnson, of Bike Tours Direct, was so impressed with Macedonian culture and sights that he worked with Ride Macedonia, a local outfitter, to develop Discover Macedonia,  nine-day guided tours with moderate cycling and hiking. The first one, now sold out, departs Aug. 25; the second, Sept. 23. The cost is 1,010 euros a person, about $1,093, at $1.09 to the euro. (Bike Tours Direct doesn’t operate tours but represents operators in more than 70 countries.)', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/travel/05BRIEFS1/05BRIEFS1-articleLarge.jpg', 'height': 372, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/05/travel/05BRIEFS1/05BRIEFS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 372}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/travel/05BRIEFS1/05BRIEFS1-jumbo.jpg', 'height': 634, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/travel/05BRIEFS1/05BRIEFS1-superJumbo.jpg', 'height': 1268, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/travel/05BRIEFS1/05BRIEFS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/05/travel/05BRIEFS1/05BRIEFS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/travel/05BRIEFS1/05BRIEFS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Bike Tours of Macedonia', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': 'Biking: Riding Through Macedonia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Daniel, Diane', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bicycles and Bicycling', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Macedonia', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-05T11:00:05+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Diane Daniel', 'person': [{'firstname': 'Diane', 'middlename': None, 'lastname': 'Daniel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d15ddc29-fab4-5a38-a1de-fa7ad6f5b31e', 'word_count': 184, 'uri': 'nyt://article/d15ddc29-fab4-5a38-a1de-fa7ad6f5b31e'}, {'abstract': 'Among the plaintiffs in the landmark same-sex marriage ruling was a funeral director who fought to list a widowed partner as the surviving spouse on death certificates.', 'web_url': 'https://lens.blogs.nytimes.com/2015/07/05/a-gay-couples-love-in-life-and-death-goes-to-the-supreme-court/', 'snippet': 'Among the plaintiffs in the landmark same-sex marriage ruling was a funeral director who fought to list a widowed partner as the surviving spouse on death certificates.', 'lead_paragraph': 'It’s easy to forget there are real people behind Supreme Court rulings. Back when the court announced it would hear six cases about same-sex marriage, I scrolled through the documents, waiting for anything human to jump out at me. When I read that a funeral director was a plaintiff in one, I thought, “That’s weird.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Gay Couple’s Love, in Life and Death, Goes to the Supreme Court', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-07-05T11:00:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Samantha Stark', 'person': [{'firstname': 'Samantha', 'middlename': None, 'lastname': 'Stark', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9fccc085-7f38-5005-9c9e-319e22bad0b0', 'word_count': 680, 'uri': 'nyt://article/9fccc085-7f38-5005-9c9e-319e22bad0b0'}, {'abstract': 'From the International Herald Tribune archives: Great Britain introduces new security laws in 1940.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/07/05/1940-britain-puts-ban-on-kite-flying-as-safety-move/', 'snippet': 'From the International Herald Tribune archives: Great Britain introduces new security laws in 1940.', 'lead_paragraph': 'LONDON — In a series of new orders designed to brace the home front against invasion of “fifth columnists” the British government banned today [July 5] kite or balloon flying by the public, decreed that British subjects or aliens must not possess large-scale maps of these islands and gave regional commissioners power to clear roads of non-essential vehicular traffic. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/06/blogs/06iht-old-1940/06iht-old-1940-articleLarge.jpg', 'height': 445, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/06/blogs/06iht-old-1940/06iht-old-1940-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 445}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/06/blogs/06iht-old-1940/06iht-old-1940-jumbo.jpg', 'height': 760, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/06/blogs/06iht-old-1940/06iht-old-1940-superJumbo.jpg', 'height': 1520, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/06/blogs/06iht-old-1940/06iht-old-1940-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/06/blogs/06iht-old-1940/06iht-old-1940-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/06/blogs/06iht-old-1940/06iht-old-1940-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1940: Britain Puts Ban on Kite Flying as Safety Move', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Balloons', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Kites', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-05T11:02:40+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29245b99-2870-5c18-9fd3-948f8e1884c6', 'word_count': 212, 'uri': 'nyt://article/29245b99-2870-5c18-9fd3-948f8e1884c6'}, {'abstract': 'A beloved band doesn’t schedule its last three concerts on a Fourth of July weekend by happenstance.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/07/05/on-july-4-the-grateful-dead-show-pride-in-being-an-american-band/', 'snippet': 'A beloved band doesn’t schedule its last three concerts on a Fourth of July weekend by happenstance.', 'lead_paragraph': 'CHICAGO — On this Fourth of July, Grateful Dead fans came prepared. They arrived at Soldier Field for the second “Fare Thee Well” concert wearing Uncle Sam hats, stars-and-stripes-patterned clothes and the band’s red, white and blue skull-and-lightning-bolt logo. And when the Dead played the night’s inevitable encore, “U.S. Blues,” fans had little American flags ready for the chorus: “Wave that flag/Wave it wide and high.” Images of the Empire State Building, lighted in a tribute to the Dead, showed on the video screen. ', 'source': 'The N