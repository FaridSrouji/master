acy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/23/opinion/23Weiner/23Weiner-superJumbo.jpg', 'height': 2048, 'width': 1318, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/23/opinion/23Weiner/23Weiner-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/23/opinion/23Weiner/23Weiner-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/23/opinion/23Weiner/23Weiner-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Hello Mother, Hello Daughter’: Texts of Misery from Camp', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': '‘Hello Mother,  Hello Daughter’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Weiner, Jennifer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Camps and Camping', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Text Messaging', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-23T13:14:39+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Weiner', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Weiner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/38a2e617-2b60-597b-9aee-2a21197149b0', 'word_count': 1022, 'uri': 'nyt://article/38a2e617-2b60-597b-9aee-2a21197149b0'}, {'abstract': 'Mr. Trump hasn’t had to rely on super PAC money for his recent surge in the polls.', 'web_url': 'https://takingnote.blogs.nytimes.com/2015/07/23/super-pacs-versus-donald-trumps-super-mouth/', 'snippet': 'Mr. Trump hasn’t had to rely on super PAC money for his recent surge in the polls.', 'lead_paragraph': 'Donald Trump’s blasts of runaway bombast have created many fretful moments for fellow Republicans, but nothing may be as galling as his surge in opinion polls through what political pros cherish as “free media”: Mr. Trump hasn’t had to pay a penny to strut and caper ahead of the pack. His caustic utterances have been too inviting for the news media not to flash them instantly across the nation in these early days of uncertainty and fickle audience involvement in next year’s presidential election.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22clinesWEB/22clinesWEB-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/22/opinion/22clinesWEB/22clinesWEB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22clinesWEB/22clinesWEB-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22clinesWEB/22clinesWEB-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22clinesWEB/22clinesWEB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/22/opinion/22clinesWEB/22clinesWEB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22clinesWEB/22clinesWEB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Super PACs Versus Donald Trump’s Super Mouth', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Political Action Committees', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Elections (US)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Bush, Jeb', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Leahy, Patrick J', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Election Commission', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 15, 'major': 'N'}, {'name': 'glocations', 'value': 'Vermont', 'rank': 16, 'major': 'N'}], 'pub_date': '2015-07-23T13:29:15+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Francis X. Clin