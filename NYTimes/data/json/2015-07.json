fc-cfaa3fbd9817'}, {'abstract': 'At a rare public meeting of the Actuarial Standards Board, participants had difficulty in reaching consensus on changes to preserve public pensions.', 'web_url': 'https://www.nytimes.com/2015/07/11/business/dealbook/standards-board-struggles-with-pension-quagmire.html', 'snippet': 'At a rare public meeting of the Actuarial Standards Board, participants had difficulty in reaching consensus on changes to preserve public pensions.', 'lead_paragraph': 'A standards board for actuaries that is seeking ways to defuse a public pension crisis heard on Thursday about two changes that seemingly everyone could agree on, but many more where there was no consensus at all.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Standards Board Struggles With Pension Quagmire', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pensions and Retirement Plans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Retirement', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Government Bonds', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Interest Rates', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Actuarial Standards Board', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN ACADEMY OF ACTUARIES', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-10T22:21:18+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Mary Williams Walsh', 'person': [{'firstname': 'Mary', 'middlename': 'Williams', 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30100d86-9c12-5768-b528-1f7b7410c0d2', 'word_count': 1134, 'uri': 'nyt://article/30100d86-9c12-5768-b528-1f7b7410c0d2'}, {'ab