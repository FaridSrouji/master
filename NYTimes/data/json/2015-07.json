: None, 'type': 'image', 'url': 'images/2015/07/21/arts/music/20150721PITCHFORK-slide-DDQ5/20150721PITCHFORK-slide-DDQ5-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/arts/music/20150721PITCHFORK-slide-DDQ5/20150721PITCHFORK-slide-DDQ5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/21/arts/music/20150721PITCHFORK-slide-DDQ5/20150721PITCHFORK-slide-DDQ5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/arts/music/20150721PITCHFORK-slide-DDQ5/20150721PITCHFORK-slide-DDQ5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Polyglot of Styles at the Pitchfork Music Festival', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pitchfork Music Festival', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-07-20T21:54:59+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/28b5df42-05eb-5095-a023-62a320f4e78c', 'word_count': 0, 'uri': 'nyt://slideshow/28b5df42-05eb-5095-a023-62a320f4e78c'}, {'abstract': 'The festival, in its 10th year, was dominated by guitar-driven rock on Friday, a mixed bag of styles on Saturday and hip-hop and electronic music on Sunday.', 'web_url': 'https://www.nytimes.com/2015/07/21/arts/music/pitchfork-music-festival-in-chicago-welcomes-a-polyglot-of-styles.html', 'snippet': 'The festival, in its 10th year, was dominated by guitar-driven rock on Friday, a mixed bag of styles on Saturday and hip-hop and electronic music on Sunday.', 'lead_paragraph': 'CHICAGO — The closing-night headliner of the Pitchfork Music Festival, which took over Union Park here from Friday afternoon through Sunday night, was Chance the Rapper, as modern an independent music star as there is. He’s 22 and has a million Twitter followers, but has never had a radio hit (or really, any hit) and has sold exactly zero albums. All of his material has been released free (though a bootleg of his once charted). Even so, several thousand fans crowded the park during his set, exuberantly rapping along to every word.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pitchfork Music Festival in Chicago Welcomes a Polyglot of Styles', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'A Polyglot of Styles at Pitchfork', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pitchfork Music Festival', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-20T21:55:16+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0dcf17a9-8d22-5139-b7fb-5a50b8ade5ae', 'word_count': 1219, 'uri': 'nyt://article/0dcf17a9-8d22-5139-b7fb-5a50b8ade5ae'}, {'abstract': 'Barney Frank and Christopher J. Dodd received a hero’s welcome during a visit to the Consumer Financial Protection Bureau, the watchdog agency created as part of the 2010 financial regulation law that bears their names.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2015/07/20/christopher-dodd-and-barney-frank-are-welcomed-at-watchdog-agency-they-helped-create/', 'snippet': 'Barney Frank and Christopher J. Dodd received a hero’s welcome during a visit to the Consumer Financial Protection Bureau, the watchdog agency created as part of the 2010 financial regulation law that bears their names.', 'lead_paragraph': 'The Dodd-Frank Act on financial regulation turns five on Tuesday, and it remains contentious. But if there is one place the Democratic authors of the legislation will always feel welcome, it is the offices of the Consumer Financial Protection Bureau, the federal watchdog agency created by the law.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Christopher Dodd and Barney Frank Are Welcomed at Watchdog Agency They Helped Create', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dodd, Christopher J', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Frank, Barney', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Consumer Financial Protection Bureau', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-20T21:59:12+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Carl Hulse', 'person': [{'firstname': 'Carl', 'middlename': None, 'lastname': 'Hulse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f739de2a-d193-519e-98e8-29cedafdd08a', 'word_count': 306, 'uri': 'nyt://article/f739de2a-d193-519e-98e8-29cedafdd08a'}, {'abstract': 'An interplanetary romance is fodder for the South Korean television drama “My Love From Another Star,” which is a hit in China, the world’s largest streaming market.', 'web_url': 'https://www.nytimes.com/2015/07/21/arts/television/chinas-love-affair-with-irresistible-korean-tv.html', 'snippet': 'An interplanetary romance is fodder for the South Korean television drama “My Love From Another Star,” which is a hit in China, the world’s largest streaming market.', 'lead_paragraph': 'BEIJING — China’s obsession with a South Korean television show about a 400-year-old Harvard-educated alien who falls in love with an arrogant actress reached such a frenzy last year that online streaming companies here began racing to snap up licensing rights for other South Korean television programs, inflating their prices almost tenfold.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/arts/21KOREATV/21KOREATV-articleLarge.jpg', 'height': 1189, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/21/arts/21KOREATV/21KOREATV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1189}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/arts/21KOREATV/21KOREATV-jumbo.jpg', 'height': 1024, 'width': 517, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/arts/21KOREATV/21KOREATV-superJumbo.jpg', 'height': 2048, 'width': 1034, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/arts/21KOREATV/21KOREATV-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'c