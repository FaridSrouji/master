': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/nyregion/MINIMUM/MINIMUM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/24/nyregion/MINIMUM/MINIMUM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/nyregion/MINIMUM/MINIMUM-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Guide to New York’s $15 Minimum Wage Proposal', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Minimum Wage', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fast Food Industry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-23T18:45:28+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Amy Zerba and Patrick McGeehan', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Zerba', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Patrick', 'middlename': None, 'lastname': 'McGeehan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2241fbde-0109-5ed7-9597-63d01905665c', 'word_count': 419, 'uri': 'nyt://article/2241fbde-0109-5ed7-9597-63d01905665c'}, {'abstract': 'To celebrate turning 29, the designer made a Bahamian getaway with his boyfriend, Paul Arnhold, and their cockapoo, Bird.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/07/23/wes-gordon-harbour-island-birthday/', 'snippet': 'To celebrate turning 29, the designer made a Bahamian getaway with his boyfriend, Paul Arnhold, and their cockapoo, Bird.', 'lead_paragraph': '“The ocean freaks me out, with all those sharks in there,” exclaims the fashion designer Wes Gordon. It was lucky, then, that Gordon chose Harbour Island in the Bahamas for a four-day beach getaway this month to celebrate his 29th birthday with his longtime boyfriend Paul Arnhold. “It was literally like bathtub water, it’s crystal clear, and there aren’t plants or rocks. I think even the sharks there would be too relaxed to do anything.” Good for Gordon, whose sophisticated silhouettes reflect his own sensibilities and who isn’t exactly a beach bum: “We don’t go that often — I get really red so easily,” he says. “There are certain places that have a very loyal cult following, and Harbour Island is definitely one of them, so we thought it was time to check out what that was about.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wes Gordon’s Harbour Island Birthday', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Harbour Island (Bahamas)', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-07-23T18:45:40+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Julie Baumgardner', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Baumgardner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c4f38672-5cd6-5845-942d-08822245d518', 'word_count': 290, 'uri': 'nyt://article/c4f38672-5cd6-5845-942d-08822245d518'}, {'abstract': 'Paulson & Company will pay $20 million for the San Juan Beach Hotel, one of several hotels in Puerto Rico that Mr. Paulson has acquired.', 'web_url': 'https://www.nytimes.com/2015/07/24/business/dealbook/john-paulsons-hedge-fund-to-buy-another-puerto-rico-hotel.html', 'snippet': 'Paulson & Company will pay $20 million for the San Juan Beach Hotel, one of several hotels in Puerto Rico that Mr. Paulson has acquired.', 'lead_paragraph': 'Puerto Rico’s tourism industry has fallen victim to the island’s struggling economy, hit by one misfortune after another. In March, the San Juan Beach Hotel filed for bankruptcy. This week, the Condado Plaza Hilton was forced to close its casino.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/business/24db-rico-web/24db-rico-web-articleLarge.jpg', 'height': 465, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/24/business/24db-rico-web/24db-rico-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 465}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/business/24db-rico-web/24db-rico-web-jumbo.jpg', 'height': 794, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/business/24db-rico-web/24db-rico-web-superJumbo.jpg', 'height': 1588, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/24/business/24db-rico-web/24db-rico-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/24/busin