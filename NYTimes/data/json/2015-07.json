fashion/26MODERN/26MODERN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/26/fashion/26MODERN/26MODERN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Modern Love Redux: Readers’ Thoughts on Gifts, Love and Lying', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gifts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Love (Emotion)', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-07-27T07:02:56+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Valeriya Safronova', 'person': [{'firstname': 'Valeriya', 'middlename': None, 'lastname': 'Safronova', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/37ba70da-5d94-5873-bfc0-14ade1913606', 'word_count': 1103, 'uri': 'nyt://article/37ba70da-5d94-5873-bfc0-14ade1913606'}, {'abstract': 'After Charleston, every state must make attacks\xad based on bigotry a crime.', 'web_url': 'https://www.nytimes.com/2015/07/27/opinion/there-ought-to-be-a-law-against-hate.html', 'snippet': 'After Charleston, every state must make attacks\xad based on bigotry a crime.', 'lead_paragraph': 'OAK CREEK, Wis. — LAST week, the Department of Justice indicted Dylann Roof, the suspect in the shooting deaths of nine people in Charleston, S.C., for hate crimes. Officials said they were bringing this indictment because they were worried that the racial motivation in the case would not be addressed adequately by a trial in a state court.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'There Ought to