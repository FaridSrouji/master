8/nyregion/18grimm-web/18grimm-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/18/nyregion/18grimm-web/18grimm-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/18/nyregion/18grimm-web/18grimm-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Michael Grimm, Former Congressman, Is Sentenced to 8 Months', 'kicker': None, 'content_kicker': None, 'print_headline': 'Former New York Congressman Is Sentenced to 8 Months', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Grimm, Michael G', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clifford, Stephanie', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Evasion', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Chen, Pamela K', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-17T15:59:23+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Stephanie Clifford', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'Clifford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7affbb4f-918d-53d3-8f3d-dae71390fd7c', 'word_count': 899, 'uri': 'nyt://article/7affbb4f-918d-53d3-8f3d-dae71390fd7c'}, {'abstract': 'This Anthology Film Archives series includes James William Guercio’s “Electra Glide in Blue,” Leonard Kastle’s “The Honeymoon Killers” and Wynn Chamberlain’s “Brand X.”', 'web_url': 'https://www.nytimes.com/2015/07/19/movies/one-film-wonders-hits-without-follow-ups.html', 'snippet': 'This Anthology Film Archives series includes James William Guercio’s “Electra Glide in Blue,” Leonard Kastle’s “The Honeymoon Killers” and Wynn Chamberlain’s “Brand X.”', 'lead_paragraph': 'James William Guercio never knew from one-hit wonders when he was producing Grammy winners by Chicago. But he did have a single cinematic dalliance, now included in the One-Film Wonders series at Anthology Film Archives: “Electra Glide in Blue,” a 1973 police story for the “Easy Rider” set, starred Robert Blake as an Arizona motorcycle cop trying to solve a murder. More than an artifact, the movie is also beautiful, thanks to the immense vistas shot by Conrad L. Hall (“In Cold Blood,” “Butch Cassidy and the Sundance Kid”).', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK5/19WEEK5-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/19/arts/19WEEK5/19WEEK5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK5/19WEEK5-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK5/19WEEK5-superJumbo.jpg', 'height': 1056, 'width': 1585, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK5/19WEEK5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/19/arts/19WEEK5/19WEEK5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK5/19WEEK5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'One-Film Wonders: Hits Without Follow-Ups', 'kicker': 'Film', 'content_kicker': None, 'print_headline': 'For Some Auteurs, Once Was Enough', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Guercio, James William (1945- )', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-07-17T16:00:04+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Daniel M. Gold', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/054ff6be-5fef-5675-93b5-609e585b4563', 'word_count': 160, 'uri': 'nyt://article/054ff6be-5fef-5675-93b5-609e585b4563'}, {'abstract': 'The three singer-songwriters — Speedy Ortiz is led by Sadie Dupuis — deliver some of the best of today’s pop culture.', 'web_url': 'https://www.nytimes.com/2015/07/19/arts/music/at-terminal-5-a-triple-bill-of-courtney-barnett-speedy-ortiz-and-torres.html', 'snippet': 'The three singer-songwriters — Speedy Ortiz is led by Sadie Dupuis — deliver some of the best of today’s pop culture.', 'lead_paragraph': 'A little while ago — 10 years? — it felt almost right to say, for those who like to cross things off lists, that singer-songwriter guitar rock had sunk to the bottom of the ocean. As is always the case regarding absolute statements about art, this was wrong, and women were especially good at demonstrating why. And so, an exceptional triple bill at Terminal 5 on July 22: Courtney Barnett, Speedy Ortiz, Torres — three singer-songwriters (Speedy Ortiz is led by Sadie Dupuis) deep in the zone. Ms. Barnett, from Australia, generates endless graffiti about insecurities and irritations to a steady but flexible meter; Ms. Dupuis’s words are rich and sanded-down and wry, as if designed to be read on a page; Mackenzie Scott, a.k.a. Torres, wants you to feel a philosophical chill, putting contemplative space around her best thoughts or repeating them.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'At Terminal 5, a Triple Bill of Courtney Barnett, Speedy Ortiz and Torres', 'kicker': 'Pop', 'content_kicker': None, 'print_headline': 'Voice and Guitar in a Revival', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barnett, Courtney (1988- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Scott, Mackenzie (Torres)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-07-17T16:00:04+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/59aa9800-3c15-55e7-9497-7f5a6257aa7b', 'word_count': 169, 'uri': 'nyt://article/59aa9800-3c15-55e7-9497-7f5a6257aa7b'}, {'abstract': '“Arlene Shechet: All at Once” traces the artist’s career from her seated Buddhas to the traditional and the abstract.', 'web_url': 'https://www.nytimes.com/2015/07/19/arts/design/arlene-shechet-has-a-first-museum-retrospective-in-boston.html', 'snippet': '“Arlene Shechet: All at Once” traces the artist’s career from her seated Buddhas to the traditional and the abstract.', 'lead_paragraph': 'In the early 1990s, when a lot of New York artists were making art about gender, racial identity and the devastation of AIDS, Arlene Shechet was producing worked that looked like no other: hand-molded plaster sculptures of seated Buddhas. Rough-textured, splashed with color, her art was very much a meditation on change and loss, but added an extra element: a sense of emotional resolution.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK4/19WEEK4-articleLarge.jpg', 'height': 418, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/19/arts/19WEEK4/19WEEK4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 418}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK4/19WEEK4-jumbo.jpg', 'height': 713, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK4/19WEEK4-superJumbo.jpg', 'height': 1427, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK4/19WEEK4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/19/arts/19WEEK4/19WEEK4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK4/19WEEK4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Arlene Shechet Has a First Museum Retrospective in Boston', 'kicker': 'Art', 'content_kicker': None, 'print_headline': 'Flights of Fancy in Sculpture', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Shechet, Arlene', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Boston (Mass)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-07-17T16:00:04+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b89398b3-1c48-5cac-aa8f-db4b616c1446', 'word_count': 158, 'uri': 'nyt://article/b89398b3-1c48-5cac-aa8f-db4b616c1446'}, {'abstract': 'Harry Partch dreamed up his own instruments, and Ensemble Musikfabrik is bringing them to the Lincoln Center Festival.', 'web_url': 'https://www.nytimes.com/2015/07/19/arts/music/delusion-of-the-fury-a-dream-carried-out-by-ensemble-musikfabrik.html', 'snippet': 'Harry Partch dreamed up his own instruments, and Ensemble Musikfabrik is bringing them to the Lincoln Center Festival.', 'lead_paragraph': 'A menagerie of alien-looking instruments will fill the stage at City Center on Thursday and Friday at 8 p.m. as the German new-music mavens Ensemble Musikfabrik together with the director Heiner Goebbels bring to life “Delusion of the Fury” by the maverick West Coast composer Harry Partch. ', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/19/arts/19WEEK2/19WEEK2-articleLarge.jpg', 'height': 400, 'width': 600,