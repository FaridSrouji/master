ier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f816c203-9b77-5bd7-9d5f-5a444988aa9d', 'word_count': 221, 'uri': 'nyt://article/f816c203-9b77-5bd7-9d5f-5a444988aa9d'}, {'abstract': 'The entire French region revered for producing bubbly bottles has been added to UNESCO’s World Heritage Sites —\xa0including Ruinart and its chalk cellars.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/07/30/ruinart-champagne-house-united-nations-connection/', 'snippet': 'The entire French region revered for producing bubbly bottles has been added to UNESCO’s World Heritage Sites —\xa0including Ruinart and its chalk cellars.', 'lead_paragraph': 'With the recent addition of the Champagne region of France to UNESCO’s World Heritage Sites, the area’s hillsides, houses and cellars join the ranks of the Taj Mahal and Machu Picchu. It will be the first region of its kind on the list of “areas of authenticity” — which typically includes institutions, cities or structures. And in adopting the region, UNESCO (United Nations Educational, Scientific and Cultural Organizations) also acknowledges and protects all the individual historic institutions within the region, like Ruinart, the oldest Champagne house there.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/29/t-magazine/29beddie-unesco/29beddie-unesco-articleLarge.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/29/t-magazine/29beddie-unesco/29beddie-unesco-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/29/t-magazine/29beddie-unesco/29beddie-unesco-jumbo.jpg', 'height': 706, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/29/t-magazine/29beddie-unesco/29beddie-unesco-superJumbo.jpg', 'height': 1412, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/29/t-magazine/29beddie-unesco/29beddie-unesco-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/29/t-magazine/29beddie-unesco/29beddie-unesco-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/29/t-magazine/29beddie-unesco/29beddie-unesco-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Champagne House’s United Nations Connection', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Caves and Caverns', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations Educational, Scientific and Cultural Organization', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-30T14:26:05+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By David Graver', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Graver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ca50f7af-680b-575f-8b54-2d74da1ca3bb', 'word_count': 508, 'uri': 'nyt://article/ca50f7af-680b-575f-8b54-2d74da1ca3bb'}, {'abstract': 'The stocks of social-media companies like Yelp, Twitter and Facebook all got punished on Wednesday, either in regular or after-hours trading. Few should be surprised by the investor reaction.', 'web_url': 'https://bits.blogs.nytimes.com/2015/07/30/daily-report-social-media-stocks-and-their-unforgiving-investors/', 'snippet': 'The stocks of social-media companies like Yelp, Twitter and Facebook all got punished on Wednesday, either in regular or after-hours trading. Few should be surprised by the investor reaction.', 'lead_paragraph': 'Several social media stocks took a pummeling on Wednesday, with Yelp plunging 25 percent and Twitter dropping 15 percent after both companies issued quarterly earnings that disappointed investors in one way or another. On top of that, Facebook’s shares fell slightly in after-hours trading after it posted financial results that included a surge in spending and a forecast of slowing revenue growth. Let’s see if LinkedIn, which reports earnings on Thursday, also joins this not-so-fun party. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-articleLarge-v4.png', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-articleLarge-v4.png', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-jumbo-v6.jpg', 'height': 400, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-superJumbo-v3.png', 'height': 400, 'width': 6