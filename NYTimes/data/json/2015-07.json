: 'https://www.nytimes.com/2015/07/26/sports/soccer/concacaf-official-blames-human-error-for-referees-decisions-in-panamas-loss.html', 'snippet': 'Forced into the third-place game after its surprising loss to Jamaica, the U.S. national team was in no mood for consolation and showed it in a shootout loss to Panama.', 'lead_paragraph': 'CHESTER, Pa. — The United States national soccer team did not want to be here Saturday afternoon, playing a Gold Cup consolation match in a small soccer arena instead of the championship game at a large football stadium.', 'print_section': 'SP', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'United States’ Gold Cup Performance Culminates With a Whimper', 'kicker': 'Panama 1 (3), United States 1 (2)', 'content_kicker': None, 'print_headline': 'United States&#8217; Gold Cup Performance Culminates With a Whimper', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Panama', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Officiating (Sports)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Confederation of North, Central American and Caribbean Association Football (CONCACAF)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Geiger, Mark', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Gold Cup (Soccer)', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-07-25T15:47:32+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jeré Longman', 'person': [{'firstname': 'Jeré', 'middlename': None, 'lastname': 'Longman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a65a86d1-c004-53d9-b060-906a06a4d903', 'word_