rk Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/16/fashion/16CWST2SUB/16CWST2SUB-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/16/fashion/16CWST2SUB/16CWST2SUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/16/fashion/16CWST2SUB/16CWST2SUB-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/16/fashion/16CWST2SUB/16CWST2SUB-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/16/fashion/16CWST2SUB/16CWST2SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/16/fashion/16CWST2SUB/16CWST2SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/16/fashion/16CWST2SUB/16CWST2SUB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Men’s Fashion Underdogs of Los Angeles Try to Conquer New York With Rocks and Rope', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Los Angeles Label’s Plan to Conquer Men’s Wear, With Rocks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New York Fashion Week', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Buse, Derek J', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sadle