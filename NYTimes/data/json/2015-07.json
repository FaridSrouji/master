rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/53b35ffc-e2ca-537d-9dec-1aeeb59486aa', 'word_count': 68, 'uri': 'nyt://article/53b35ffc-e2ca-537d-9dec-1aeeb59486aa'}, {'abstract': 'A Brooklyn fashion-shop keeper shares some advice on how to dress in the summer without looking like you’re still in college.', 'web_url': 'https://www.nytimes.com/2015/07/10/fashion/mens-style/style-tips-for-cool-dads-from-the-owner-of-goose-barnacle.html', 'snippet': 'A Brooklyn fashion-shop keeper shares some advice on how to dress in the summer without looking like you’re still in college.', 'lead_paragraph': 'Goose Barnacle, a men’s shop near the western tip of Atlantic Avenue in Brooklyn, is a place for new dads and former hipsters who still want to dress like sexy beasts. Since 2010, its proprietor, David Alperin, 36, who grew up around the corner, has been matching his friends and neighbors with clothes from a limited stock of hard-to-find labels.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/10/fashion/10PULSE7/10PULSE7-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/10/fashion/10PULSE7/10PULSE7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/10/fashion/10PULSE7/10PULSE7-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/10/fashion/10PULSE7/10PULSE7-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': '