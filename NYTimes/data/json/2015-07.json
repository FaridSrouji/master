', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22anvari/22anvari-articleLarge.jpg', 'height': 382, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/22/opinion/22anvari/22anvari-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 382}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22anvari/22anvari-jumbo.jpg', 'height': 652, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22anvari/22anvari-superJumbo.jpg', 'height': 1303, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22anvari/22anvari-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/22/opinion/22anvari/22anvari-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/opinion/22anvari/22anvari-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Iran’s Next Need: Internal Healing', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Iran’s Next Need: Internal Healing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iran', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-07-21T10:30:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Haleh Anvari', 'person': [{'firstname': 'Haleh', 'middlename': None, 'lastname': 'Anvari', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/649ed878-85dc-5311-b754-fd7df6b85102', 'word_count': 1114, 'uri': 'nyt://article/649ed878-85dc-5311-b754-fd7df6b85102'}, {'abstract': 'The legislators decided to have a panel study the nuclear deal with world powers, effectively withholding their judgment until after the American Congress votes.', 'web_url': 'https://www.nytimes.com/2015/07/22/world/middleeast/iran-nuclear-deal-vote.html', 'snippet': 'The legislators decided to have a panel study the nuclear deal with world powers, effectively withholding their judgment until after the American Congress votes.', 'lead_paragraph': 'TEHRAN — The Iranian Parliament will wait at least 80 days before voting on a nuclear agreement reached last week with world powers, as legislators decided on Tuesday to form a committee to study the accord, state radio reported.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/world/22Iran-web/22Iran-web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/22/world/22Iran-web/22Iran-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/world/22Iran-web/22Iran-web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/world/22Iran-web/22Iran-web-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'cr