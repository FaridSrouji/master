adline': {'main': 'Questions After Unarmed Ohio Man Is Killed in Traffic Stop', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-07-22T16:29:44+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Katie Rogers', 'person': [{'firstname': 'Katie', 'middlename': None, 'lastname': 'Rogers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39c30a83-c70d-5946-b962-1f06ae716ad0', 'word_count': 356, 'uri': 'nyt://article/39c30a83-c70d-5946-b962-1f06ae716ad0'}, {'abstract': 'The cult fashion designer shares her favorite places to buy furniture and long johns, eat rigatoni and pick berries in the Catskills.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/07/22/upstate-new-york-travel-guide-ryan-roche/', 'snippet': 'The cult fashion designer shares her favorite places to buy furniture and long johns, eat rigatoni and pick berries in the Catskills.', 'lead_paragraph': '“When I first moved to New York City, I never would have believed that I’d eventually long for the countryside again,” says the designer Ryan Roche, laughing. “But with little ones and living in Brooklyn, my day-to-day just wasn’t very peaceful. I grew up in Idaho in a really small town, with horses and wide open space and lots of fresh air, and I wanted to get back to my country-girl roots.” So in 2008, she and her family packed up the contents of their fourth-floor walk-up in Bushwick, and moved into a 17th-century stone farmhouse in the historic town of Hurley, N.Y.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/t-magazine/17roche-vu-1/17roche-vu-1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/17/t-magazine/17roche-vu-1/17roche-vu-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/t-magazine/17roche-vu-1/17roche-vu-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/t-magazine/17roche-vu-1/17roche-vu-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/t-magazine/17roche-vu-1/17roche-vu-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/17/t-magazine/17roche-vu-1/17roche-vu-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/t-magazine/17roche-vu-1/17roche-vu-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ryan Roche’s Guide to the Best of Upstate New York', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Roche, Ryan', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Levon Helm Studios (Woodstock, NY)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Spruceton Inn (West Kill, NY, Hotel)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Rhinebeck (NY)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Woodstock (NY)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-22T16:30:22+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Mimi Vu', 'person': [{'firstname': 'Mimi', 'middlename': None, 'lastname': 'Vu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/60591f64-ae22-559b-8b62-3bd62c32108a', 'word_count': 1396, 'uri': 'nyt://article/60591f64-ae22-559b-8b62-3bd62c32108a'}, {'abstract': '“You cannot have a conversation about race in this country and not include white people in it,” Mr. Vargas said.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/07/22/jose-antonio-vargas-white-people-interview/', 'snippet': '“You cannot have a conversation about race in this country and not include white people in it,” Mr. Vargas said.', 'lead_paragraph': 'Jose Antonio Vargas is a Pulitzer Prize-winning journalist and immigration activist. His new documentary “White People,” which airs tonight on MTV, follows Mr. Vargas as he travels the country speaking to young people about issues of race, particularly what it means to be white and experience white privilege. Because, Mr. Vargas said, “You cannot have a conversation about race in this country and not include white people in it.” ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/26/arts/22VARGAS/22VARGAS-articleLarge.jpg', 'height': 336, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/26/arts/22VARGAS/22VARGAS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 336}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url'