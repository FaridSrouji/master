program for their country.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/09/opinion/Bittner-contributor/Bittner-contributor-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/10/09/opinion/Bittner-contributor/Bittner-contributor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/09/opinion/Bittner-contributor/Bittner-contributor-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/09/opinion/Bittner-contributor/Bittner-contributor-superJumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/09/opinion/Bittner-contributor/Bittner-contributor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/10/09/opinion/Bittner-contributor/Bittner-contributor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/09/opinion/Bittner-contributor/Bittner-contributor-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'It’s Time for Greece to Leave the Euro', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Why Greece Needs to Go', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value'