ajor': 'N'}], 'pub_date': '2015-07-31T01:39:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b5555210-ccad-52a1-98c5-356e20ed5dcb', 'word_count': 1296, 'uri': 'nyt://article/b5555210-ccad-52a1-98c5-356e20ed5dcb'}, {'abstract': 'For this documentary, the director and actor Damon Gameau subjects himself to a high sugar diet, by way of juice, yogurt and cereal.', 'web_url': 'https://www.nytimes.com/2015/07/31/movies/review-in-that-sugar-film-a-bitter-truth.html', 'snippet': 'For this documentary, the director and actor Damon Gameau subjects himself to a high sugar diet, by way of juice, yogurt and cereal.', 'lead_paragraph': 'In “That Sugar Film,” Damon Gameau, an engaging Australian actor-director who has been off refined sugars for years, shifts his consumption for two months to include 40 teaspoons of sugar a day, the average Aussie’s intake. And he isn’t scarfing candy and soda: Instead, to highlight the hidden sugars in so-called healthy alternatives, he consumes products like low-fat yogurt, juice and cereal.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/31/arts/31THATSUGAR/31THATSUGAR-articleLarge.jpg', 'height': 304, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/31/arts/31THATSUGAR/31THATSUGAR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 304}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/31/arts/31THATSUGAR/31THATSUGAR-jumbo.jpg', 'heig