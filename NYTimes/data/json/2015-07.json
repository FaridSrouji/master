reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/1552a3b1-a931-5d63-9ca6-0bf8bc6353d5', 'word_count': 0, 'uri': 'nyt://interactive/1552a3b1-a931-5d63-9ca6-0bf8bc6353d5'}, {'abstract': 'The Chinese capital beat the Kazakh city in an International Olympic Committee vote and will be the first city to host both the Summer and Winter Games.', 'web_url': 'https://www.nytimes.com/2015/08/01/sports/olympics/beijing-selected-as-host-of-2022-winter-olympics.html', 'snippet': 'The Chinese capital beat the Kazakh city in an International Olympic Committee vote and will be the first city to host both the Summer and Winter Games.', 'lead_paragraph': 'One of the strangest Olympic bidding races in recent memory came to a surprising end Friday when Beijing, which staged the Summer Games seven years ago, was awarded the rights to the 2022 Winter Games, setting up the Chinese capital to become the first city to host both versions of the Games in more than a century of Olympic history.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Beijing Defeats Almaty in Bid to Host 2022 Winter Olympics', 'kicker': None, 'content_kicker': None, 'print_headline': 'Goliath Edges David, as Beijing Lands 2022 Winter Games ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Borden, Sam (Per)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games (2022)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Beijing (China)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ALMATY (KAZAKHSTAN)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'High-Speed Rail Projects', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'International Olympic Committee', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'valu