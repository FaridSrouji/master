subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lupulo', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Lupulo (Manhattan, NY, Restaurant)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Chelsea (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mendes, George', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-21T16:35:41+0000', 'document_type': 'multimedia', 'news_desk': 'Food', 'section_name': 'Food', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/34ea1ba3-758b-54c5-b408-5e2003e9d699', 'word_count': 0, 'uri': 'nyt://slideshow/34ea1ba3-758b-54c5-b408-5e2003e9d699'}, {'abstract': 'The flavor and feel of a Portuguese beer hall come through loud and clear.', 'web_url': 'https://www.nytimes.com/2015/07/22/dining/restaurant-review-lupulo-in-chelsea.html', 'snippet': 'The flavor and feel of a Portuguese beer hall come through loud and clear.', 'lead_paragraph': 'If George Mendes did not have such a strong grip on the flavors and aromas of Portugal, Lupulo might have slipped away from him. It can be a confusing restaurant at first, its messages mixed, its fairly simple concept fuzzed over with complications. But give the place a chance, and you can find clarity in the smells of garlic and wood smoke that fill the dining room; in the way sweet paprika and cilantro sidle up to each other in olive oil; and in the fresh, firm seafood, the grilled sardines and carabineros, red as a lobster, their heads dripping with juices that are as rich and intense as any sauce. The restaurant may be unfocused, but the cooking isn’t.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Restaurant Review: Lupulo in Chelsea', 'kicker': 'Restaurants', 'content_kicker': None, 'print_headline': 'Portuguese Cooking Rises Above the Din', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Chelsea (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mendes, George', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Lupulo (Manhattan, NY, Restaurant)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-21T16:35:51+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Pete Wells', 'person': [{'firstname': 'Pete', 'middlename': None, 'lastname': 'Wells', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/daf65056-ecd3-5690-9fc9-13c077b884d4', 'word_count': 1055, 'uri': 'nyt://article/daf65056-ecd3-5690-9fc9-13c077b884d4'}, {'abstract': 'A face-to-face session between Defense Secretary Ashton B. Carter and Prime Minister Benjamin Netanyahu of Israel on Tuesday was fraught with tension.', 'web_url': 'https://www.nytimes.com/2015/07/22/world/middleeast/iran-deal-looms-as-us-defense-secretary-meets-with-netanyahu.html', 'snippet': 'A face-to-face session between Defense Secretary Ashton B. Carter and Prime Minister Benjamin Netanyahu of Israel on Tuesday was fraught with tension.', 'lead_paragraph': 'JERUSALEM — It was never going to be an easy meeting, but a face-to-face session on Tuesday between Prime Minister Benjamin Netanyahu of Israel and Defense Secretary Ashton B. Carter, the first high-level Obama emissary here since the Iran nuclear deal was struck last week, was so fraught with tension that the two balked at even making the obligatory statements at the beginning.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlar