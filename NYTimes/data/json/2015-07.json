nion/douthat-circular/douthat-circular-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 594}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/douthat-circular/douthat-circular-jumbo-v3.jpg', 'height': 1014, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/douthat-circular/douthat-circular-superJumbo-v3.jpg', 'height': 1852, 'width': 1871, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Looking Away From Abortion', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Looking Away From Abortion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Douthat, Ross G (Per)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Planned Parenthood Federation of America', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Daleiden, David', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Selzer, Richard', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-25T18:30:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/5eaa8264-390f-5afb-9849-68b46c99ce00', 'word_count': 795, 'uri': 'nyt://article/5eaa8264-390f-5afb-9849-68b46c99ce00'}, {'abstract': 'The conditions imposed on the country make it a kind of debtors’ prison.', 'web_url': 'https://www.nytimes.com/2015/07/26/opinion/greece-the-sacrificial-lamb.html', 'snippet': 'The conditions imposed on the country make it a kind of debtors’ prison.', 'lead_paragraph': 'ATHENS — AS the Greek crisis proceeds to its next stage, Germany, Greece and the triumvirate of the International Monetary Fund, the European Central Bank and the European Commission (now better known as the troika) have all faced serious criticism. While there is plenty of blame to share, we shouldn’t lose sight of what is really going on. I’ve been watching this Greek tragedy closely for five years, engaged with those on all sides. Having spent the last week in Athens talking to ordinary citizens, young and old, as well as current and past officials, I’ve come to the view that this is about far more than just Greece and the euro.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/26/opinion/sunday/26stiglitz/26stiglitz-articleLarge.jpg', 'height': 492, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/26/opinion/sunday/26stiglitz/26stiglitz-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 492}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/26/opinion/sunday/26stiglitz/26stiglitz-jumbo.jpg', 'height': 839, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/26/opinion/sunday/26stiglitz/26stiglitz-superJumbo.jpg', 'height': 1281, 'width': 1563, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/26/opinion/sunday/26stiglitz/26stiglitz-thumbStandard.jpg', 'height': 75, 'width': 75, 'subTyp