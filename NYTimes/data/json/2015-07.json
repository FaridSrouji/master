-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/arts/international/22iht-arles22e/22iht-arles22e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/arts/international/22iht-arles22e/22iht-arles22e-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/arts/international/22iht-arles22e/22iht-arles22e-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/22/arts/international/22iht-arles22e/22iht-arles22e-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/22/arts/international/22iht-arles22e/22iht-arles22e-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Cutting Edge in Provence', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Cutting Edge in Provence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ARLES (FRANCE)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'van Gogh, Vincent', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-21T10:03:54+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'International Arts', 'byline': {'original': 'By Sarah Moroz', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Moroz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44fa725e-dea0-5cb9-bb42-2fee40f5695d', 'word_count': 1189, 'uri': 'nyt://article/44fa725e-dea0-5cb9-bb42-2fee40f5695d'}, {'abstract': 'Tuesday: One more day of heat, fog makes the mayor late for a speech in Rome, and Hostess corn dogs.', 'web_url': 'https://cityroom.blogs.nytimes.com/2015/07/21/new-york-today-just-add-twinkies/', 'snippet': 'Tuesday: One more day of heat, fog makes the mayor late for a speech in Rome, and Hostess corn dogs.', 'lead_paragraph': 'Good morning on this brain-melting Tuesday — Day 3 of the heat wave. They say it’s the last. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/nyregion/21NYTODAY/21NYTODAY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/21/nyregion/21NYTODAY/21NYTODAY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/nyregion/21NYTODAY/21NYTODAY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/nyregion/21NYTODAY/21NYTODAY-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/21/nyregion/21NYTODAY/21NYTODAY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/21/nyregion/21NYTODAY/21NYTODAY-thumbStan