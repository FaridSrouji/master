e', 'url': 'images/2015/08/02/magazine/02talk/02talk-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/02/magazine/02talk/02talk-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02talk/02talk-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02talk/02mag-02talk-t_CA0-articleLarge.jpg', 'height': 1345, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/02/magazine/02talk/02mag-02talk-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1345}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02talk/02mag-02talk-t_CA0-jumbo.jpg', 'height': 1024, 'width': 457, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02talk/02mag-02talk-t_CA0-superJumbo.jpg', 'height': 1500, 'width': 669, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Jermaine Affonso Can’t Escape the Garbage, Either', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'Jermaine Affonso Can’t Escape the Garbage, Either', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Affonso, Jermaine (1988- )', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cox, Ana Marie', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Clickhole.com', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-30T10:58:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Ana Marie Cox', 'person': [{'firstname': 'Interview', 'middlename': 'Ana', 'lastname': 'Marie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/994e23f5-11c4-59ca-a391-d8591fdbc728', 'word_count': 699, 'uri': 'nyt://article/994e23f5-11c4-59ca-a391-d8591fdbc728'}, {'abstract': 'Playing this small, hand-held, under-appreciated percussion instrument isn’t about glory; it’s about connection.', 'web_url': 'https://www.nytimes.com/2015/08/02/magazine/letter-of-recommendation-egg-shakers.html', 'snippet': 'Playing this small, hand-held, under-appreciated percussion instrument isn’t about glory; it’s about connection.', 'lead_paragraph': 'We give babies rattles because babies understand abandon, because they’re not too proud or complicated yet to shake those rattles hard and feel free. I’m no baby; I’m a man, with two small children of my own. But last fall, I got an egg shaker, and I’ve enjoyed putting on records and playing egg shaker along with them ever since. It’s an outlet, a release — like air guitar, but with one key difference. I am making noise.', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02lor/02mag-02lor-t_CA1-articleLarge.jpg', 'height': 521, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/02/magazine/02lor/02mag-02lor-t_CA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 521}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02lor/02mag-02lor-t_CA1-jumbo.jpg', 'height': 889, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02lor/02mag-02lor-t_CA1-superJumbo.jpg', 'height': 1779, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02lor/02mag-02lor-t_CA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/02/magazine/02lor/02mag-02lor-t_CA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02lor/02mag-02lor-t_CA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Letter of Recommendation: Egg Shakers', 'kicker': 'Letter of Recommendation', 'content_kicker': None, 'print_headline': 'Egg Shakers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Musical Instruments', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Band, The (Music Group)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-07-30T10:59:02+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Jon Mooallem', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Mooallem', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5200229-e194-5926-8b0e-d86c1f1e69fb', 'word_count': 969, 'uri': 'nyt://article/c5200229-e194-5926-8b0e-d86c1f1e69fb'}, {'abstract': 'How a rich entrepreneur persuaded the city to let him create his own high-tech police force.', 'web_url': 'https://www.nytimes.com/2015/08/02/magazine/who-runs-the-streets-of-new-orleans.html', 'snippet': 'How a rich entrepreneur persuaded the city to let him create his own high-tech police force.', 'lead_paragraph': 'On the morning of Sunday, March 29, Sidney Torres was sipping an espresso in the kitchen of his mansion on the edge of the French Quarter when a jarring notification lit up his iPad and two iPhones. Pimps fighting with drug dealers and johns. Man has gun. Hurry. The message came from a neighbor 10 blocks away, on St. Louis Street, and was sent through a venture Torres started four days earlier: a private police patrol that could be summoned via mobile app. Torres, who made a vast fortune as the founder of SDT Waste & Debris Services, a sanitation company that cleaned up much of New Orleans in the years following Hurricane Katrina, spent $380,000 to fund the enterprise after a crime wave put Quarter residents on edge for the better part of a year. Between November and January, there were more than 60 robberies in the neighborhood, and the crimes became increasingly brazen, including a vicious stabbing and a spate of random beatings. It became a personal issue for Torres on Dec. 17, when his 8,000-square-foot home was burglarized; three weeks later, the bar next door was held up by two masked gunmen. Torres’s crowdsourcing approach to crime, conceived throughout February and March, was the impulsive byproduct of his belief that the New Orleans Police Department, which has shrunk by around 500 officers since Hurricane Katrina, was no longer able to protect even the neighborhood less than a square mile in size that contained the city’s most valuable real estate.', 'print_section': 'MM', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02frenchquarter1/02mag-02frenchquarter-t_CA1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/08/02/magazine/02frenchquarter1/02mag-02frenchquarter-t_CA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02frenchquarter1/02mag-02frenchquarter-t_CA1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02frenchquarter1/02mag-02frenchquarter-t_CA1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02frenchquarter1/02mag-02frenchquarter-t_CA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/08/02/magazine/02frenchquarter1/02mag-02frenchquarter-t_CA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/08/02/magazine/02frenchquarter1/02mag-02frenchquarter-t_CA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Who Runs the Streets of New Orleans?', 'kicker': 'Feature', 'content_kicker': None, 'print_headline': 'Street Sweeper', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New Orleans (La)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Amsden, David', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'va