es/2015/07/03/arts/0703GALLERY2/0703GALLERY2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 526}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/arts/0703GALLERY2/0703GALLERY2-jumbo.jpg', 'height': 899, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/arts/0703GALLERY2/0703GALLERY2-superJumbo.jpg', 'height': 1747, 'width': 1991, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/arts/0703GALLERY2/0703GALLERY2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/03/arts/0703GALLERY2/0703GALLERY2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/03/arts/0703GALLERY2/0703GALLERY2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Elmer Bischoff, ‘Figurative Paintings’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Elmer Bischoff', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-07-02T21:34:58+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/54e43a1c-e035-5d5c-bfe8-be078c179a65', 'word_count': 245, 'uri': 'nyt://article/54e43a1c-e035-5d5c-bfe8-be078c179a65'}, {'abstract': 'The fast-casual chain said it would eliminate high-fructose corn syrup from soda that it serves as part of an initiative to phase out artificial ingredients.', 'web_url': 'https://www.nytimes.com/2015/07/05/business/paneras-mission-to-be-anything-but-artificial.html', 'snippet': 'The fast-casual chain said it would eliminate high-fructose corn syrup from soda that it serves as part of an initiative to phase out artificial ingredients.', 'lead_paragraph': 'Dan Kish grew up visiting his grandparents’ farm in northwest Pennsylvania. During long summer days, he would can vegetables and shuck thousands of ears of corn. His grandfather would squirt cow’s milk straight from the udder into his mouth. His grandmother taught him how to cook on a white enamel Westinghouse gas stove. ', 'print_section': 'BU', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-REVALUED-1SUB/5-REVALUED-1SUB-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/05/business/5-REVALUED-1SUB/5-REVALUED-1SUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-REVALUED-1SUB/5-REVALUED-1SUB-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-REVALUED-1SUB/5-REVALUED-1SUB-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/05/business/5-REVALUED-1SUB/5-REVA