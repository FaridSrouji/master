 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/07/sports/07SANDOMIRweb/07SANDOMIRweb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/07/sports/07SANDOMIRweb/07SANDOMIRweb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Women’s World Cup Final Was Most-Watched Soccer Game in United States History', 'kicker': None, 'content_kicker': None, 'print_headline': 'World Cup Final&#8217;s American Audience Sets Record for Soccer ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox Broadcasting Co', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': "Women's World Cup (Soccer)", 'rank': 7, 'major': 'N'}], 'pub_date': '2015-07-06T20:34:14+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aa70ecd6-dd6a-568a-bb89-fbad2b901e6a', 'word_count': 870, 'uri': 'nyt://article/aa70ecd6-dd6a-568a-bb89-fbad2b901e6a'}, {'abstract': 'New varieties of sriracha, ketchup and other condiments make their debut; a children’s book recounts a dessert’s history; new olive oils; and more.', 'web_url': 'https://www.nytimes.com/2015/07/08/dining/condiments-galore-at-new-yorks-fancy-food-show.html', 'snippet': 'New varieties of sriracha, ketchup and other condiments make their debut; a children’s book recounts a dessert’s history; new olive oils; and more.', 'lead_paragraph': 'Condiments, notably those that are Asian and fueled with searing heat, continue to ride high in the specialty food business, as showcased at last week’s Fancy Food Show at the Jacob K. Javits Convention Center in New York. Some newcomers in the category included charred sriracha from Nathan Meshberg and Jessica Fox of Ft. Greene Farms; a hot chile and a milder lime leaf sambal from Auria Abraham of Auria’s Malaysian Kitchen; and sriracha tweaked to make a hot sauce called Veracha, from Kevin Powell of True Made Foods. There were new imports of gochujang, the thick, spicy Korean sauce. And ketchup was not left in the dust; several came with gochujang and sriracha profiles. Popcorn, especially with smaller kernels like Pipcorn, and variations on corn nuts were also a big presence: Specialty Food Association, specialtyfood.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/08/dining/08BURNER1/08BURNER1-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/08/dining/08BURNER1/08BURNER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/08/dining/08BURNER1/08BURNER1-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/08/dining/08BURNER1/08BURNER1-superJumbo.jpg', 'height': 1356, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank':