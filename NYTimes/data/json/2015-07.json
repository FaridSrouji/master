eo/e45d32c0-c079-54e3-ae16-659e254658fb'}, {'abstract': 'Arseniy P. Yatsenyuk said his coalition was committed to tackling corruption, increasing wages and voting for changes to offer more power to the separatist East.', 'web_url': 'https://www.nytimes.com/2015/07/14/world/europe/ukraine-premier-in-white-house-visit-hails-economic-progress.html', 'snippet': 'Arseniy P. Yatsenyuk said his coalition was committed to tackling corruption, increasing wages and voting for changes to offer more power to the separatist East.', 'lead_paragraph': 'WASHINGTON — The prime minister of Ukraine reassured President Obama on Monday that his embattled government was making important progress in overhauling the country’s troubled economy and meeting the terms of a shaky cease-fire with Russia.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ukraine Premier, in White House Visit, Hails Economic Progress', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Yatsenyuk, Arseniy P', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Chamber of Commerce', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-14T03:18:27+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Peter Baker and Sabrina Tavernise', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Baker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sabrina', 'middlename': None, 'lastname': 'Tavernise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4598ba87-8192-5f43-83b7-be96dabd2534', 'word_count': 628, 'uri': 'nyt://article/4598ba87-8192-5f43-83b7-be96dabd2534'}, {'abstract': 'The strict terms of the debt deal imposed on Greece prompted a wave of criticism on social networks.', 'web_url': 'https://www.nytimes.com/2015/07/14/world/europe/sympathy-for-greeks-inspires-outraged-commentary-tagged-thisisacoup.html', 'snippet': 'The strict terms of the debt deal imposed on Greece prompted a wave of criticism on social networks.', 'lead_paragraph': 'The strict terms of the deal imposed on Greece by fellow members of the eurozone on Sunday inspired hundreds of thousands of comments on social networks deriding the agreement as the equivalent of a coup against the left-wing government of Prime Minister Alexis Tsipras.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sympathy for Greeks Inspires Outraged Commentary Tagged #ThisIsACoup', 'kicker': 'Open Source', 'content_kicker': None, 'print_headline': 'Sympathy for Greeks Inspires Outraged Commentary Tagged #ThisIsACoup', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Greece', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Coalition of the Radical Left (Greece)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tsipras, Alexis', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Varoufakis, Yanis', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Iglesias Turrion, Pablo (1978- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Colau, Ada', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Krugman, Paul', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Eurozone', 'rank': 9, 'major': 'N'}, {'name':