umbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/08/world/OCEANS-SLAVES-01/OCEANS-SLAVES-01-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/08/world/OCEANS-SLAVES-01/OCEANS-SLAVES-01-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/08/world/OCEANS-SLAVES-01/OCEANS-SLAVES-01-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/08/world/OCEANS-SLAVES-01/OCEANS-SLAVES-01-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Sea Slaves’: The Human Misery That Feeds Pets and Livestock', 'kicker': 'The Outlaw Ocean', 'content_kicker': None, 'print_headline': 'Forced Labor for Cheap Fish', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Maritime Crime', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Urbina, Ian', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Forced Labor', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fishing, Commercial', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Human Trafficking', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'South China Sea', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Series', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'National Human Rights Commission (Thailand)', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-07-27T07:31:36+0000', 'document_type': 'article', 