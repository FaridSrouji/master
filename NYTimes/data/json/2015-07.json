abeb-6622-5500-b532-662834e8567d', 'word_count': 395, 'uri': 'nyt://article/736cabeb-6622-5500-b532-662834e8567d'}, {'abstract': 'Charlotte di Carcaci on the years Picasso spent in the Mediterranean.', 'web_url': 'https://www.nytimes.com/audio/2013/06/02/t-magazine/tmag-in-the-air-picasso.html', 'snippet': 'Charlotte di Carcaci on the years Picasso spent in the Mediterranean.', 'lead_paragraph': 'Charlotte di Carcaci on the years Picasso spent in the Mediterranean.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Artist’s Life in Cannes', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-07-16T14:48:25+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/d5de4c9d-207f-5ed1-a05d-f4e004fe80d8', 'word_count': 0, 'uri': 'nyt://audio/d5de4c9d-207f-5ed1-a05d-f4e004fe80d8'}, {'abstract': 'The movie, directed by Judd Apatow from Ms. Schumer’s script, is a romantic comedy packed with pop-cultural references and edged with social critique.', 'web_url': 'https://www.nytimes.com/2015/07/17/movies/review-trainwreck-delivers-the-full-amy-schumer-experience.html', 'snippet': 'The movie, directed by Judd Apatow from Ms. Schumer’s script, is a romantic comedy packed with pop-cultural references and edged with social critique.', 'lead_paragraph': 'Amy Schumer is my kind of superhero — she stops haters dead. As fans of her Comedy Central show, “Inside Amy Schumer,” know, there’s almost nothing that anyone can say about women, her included, that she hasn’t already said herself. Her powers of deflection are the perfect approach in a neofeminist moment in which women are calling out sexists, sometimes against vicious pushback. Think that she’s not thin enough or pretty enough? She intercepts hateful slurs like those and turns them into ferocious comedy gold that exposes chauvinism as the absurdity it is. She can’t be stereotyped away as a sourpuss who just needs to chill out, lie back and smile. She’s already smiling, and she’s killing it, joke after joke.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17TRAINWRECK/17TRAINWRECK-articleLarge.jpg', 'height': 294, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/17/arts/17TRAINWRECK/17TRAINWRECK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 294}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17TRAINWRECK/17TRAINWRECK-jumbo.jpg', 'height': 501, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17TRAINWRECK/17TRAINWRECK-superJumbo.jpg', 'height': 1002, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17TRAINWRECK/17TRAINWRECK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/17/arts/17TRAINWRECK/17TRAINWRECK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17TRAINWRECK/17TRAINWRECK-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Trainwreck’ Delivers the Full Amy Schumer Experience', 'kicker': None, 'content_kicker': None, 'print_headline': 'Forget Commitment, or Cuddling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'APATOW, JUDD', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Schumer, Amy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dating and Relationships', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Trainwreck (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-07-16T14:49:57+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/28b20451-f630-52ba-beee-20afd77af7ad', 'word_count': 1422, 'uri': 'nyt://article/28b20451-f630-52ba-beee-20afd77af7ad'}, {'abstract': 'TLC had pulled all broadcasts of the show earlier this summer.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/07/16/19-kids-and-counting-tlc-canceled/', 'snippet': 'TLC had pulled all broadcasts of the show earlier this summer.', 'lead_paragraph': ' TLC said on Thursday that it was canceling its reality series “19 Kids and Counting.” The decision arrives several weeks after a magazine report revealed that one of the stars of the show had been investigated on suspicion of molesting underage girls. The show’s cancellation was first reported by The Associated Press, and the announcement was made less than two hours before the unveiling of the nominations for Emmy Awards, an event that will dominate the attention of the television industry for the rest of the day.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'ima