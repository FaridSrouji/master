show/dfc095ef-9339-50b0-ae65-5b586c0be2a9'}, {'abstract': 'Alpine Cinema in Bay Ridge, Brooklyn, charges $6 per seat on Wednesday nights, providing a low-budget movie option for families and frugal couples.', 'web_url': 'https://www.nytimes.com/2015/07/12/nyregion/neighborhood-joint-alpine-cinema-in-bay-ridge-brooklyn.html', 'snippet': 'Alpine Cinema in Bay Ridge, Brooklyn, charges $6 per seat on Wednesday nights, providing a low-budget movie option for families and frugal couples.', 'lead_paragraph': 'As dusk fell on a recent balmy Wednesday, it was still bright underneath the arched marquee of the Alpine Cinema. Young families, groups of students finally free for the summer and older couples milled around in the amber light, sidestepping piles of shoes spilling out of the neighboring Islamic Society of Bay Ridge, which was packed for Ramadan services. The line snaked past a shuttered comic-book store and was joined by people exiting Middle Eastern sweets shops, queuing up to watch dinosaurs maul one another in “Jurassic World.”', 'print_section': 'MB', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wednesday Night Fever in Bay Ridge', 'kicker': 'Neighborhood Joint', 'content_kicker': None, 'print_headline': 'Wednesday Night Fever ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Alpine Cinema (Brooklyn, NY)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Bay Ridge (Brooklyn, NY)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theaters (Buildings)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-10T22:11:45+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Jessica Leigh Hester', 'person': [{'firstname': 'Jessica', 'middlename': 'Leigh', 'lastname': 'Hester', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 