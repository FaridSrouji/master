nsive methods if they want to achieve student diversity.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/us/01AFFIRMATIVE-JPN/01AFFIRMATIVE-JPN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/01/us/01AFFIRMATIVE-JPN/01AFFIRMATIVE-JPN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/us/01AFFIRMATIVE-JPN/01AFFIRMATIVE-JPN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/us/01AFFIRMATIVE-JPN/01AFFIRMATIVE-JPN-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/us/01AFFIRMATIVE-JPN/01AFFIRMATIVE-JPN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/01/us/01AFFIRMATIVE-JPN/01AFFIRMATIVE-JPN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/us/01AFFIRMATIVE-JPN/01AFFIRMATIVE-JPN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Colleges Brace for Supreme Court Review of Race-Based Admissions', 'kicker': None, 'content_kicker': None, 'print_headline': 'Colleges Brace for Uncertainty as Court Reviews Race in Admissions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'orga