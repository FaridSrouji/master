e, 'type': 'image', 'url': 'images/2015/07/17/arts/17BOOK/17BOOK-articleLarge.jpg', 'height': 910, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/17/arts/17BOOK/17BOOK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 910}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17BOOK/17BOOK-jumbo.jpg', 'height': 1024, 'width': 676, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17BOOK/17BOOK-superJumbo.jpg', 'height': 2048, 'width': 1351, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17BOOK/17BOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/17/arts/17BOOK/17BOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/17/arts/17BOOK/17BOOK-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Pretty Is,’ Grown Friends Recall Being Kidnapped', 'kicker': None, 'content_kicker': None, 'print_headline': 'That Summer of Our Abduction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lyall, Sarah', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mitchell, Maggie (1970- )', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Pretty Is (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-07-16T21:13:50+0000', 'document_type': 'article', 'news_desk': 'Weekend'