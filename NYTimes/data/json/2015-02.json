own throughout soccer as the Yellow Wall.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/sports/23DORTMUND2/23DORTMUND2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/23/sports/23DORTMUND2/23DORTMUND2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/sports/23DORTMUND2/23DORTMUND2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/sports/23DORTMUND2/23DORTMUND2-superJumbo.jpg', 'height': 1254, 'width': 1879, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/sports/23DORTMUND2/23DORTMUND2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/23/sports/23DORTMUND2/23DORTMUND2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/sports/23DORTMUND2/23DORTMUND2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Dortmund, a Dramatic Fall, but Not From Grace', 'kicker': None, 'content_kicker': None, 'print_headline': 'For German Club, a Dramatic Fall, but Not From Grace', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Borden, Sam', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank'