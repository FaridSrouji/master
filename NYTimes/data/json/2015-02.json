_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Tangled Roots of English', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Tangled Roots of English', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wade, Nicholas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Language and Languages', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-23T22:25:21+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Nicholas Wade', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Wade', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/de7d6665-645f-5c8d-8866-c66d501c6902', 'word_count': 1467, 'uri': 'nyt://article/de7d6665-645f-5c8d-8866-c66d501c6902'}, {'abstract': 'It took eight contentious years of debate before fluoridated water finally started flowing in the city in 1965. The issue still divides communities.', 'web_url': 'https://www.nytimes.com/2015/02/24/health/new-yorks-fluoridation-fuss-50-years-later.html', 'snippet': 'It took eight contentious years of debate before fluoridated water finally started flowing in the city in 1965. The issue still divides communities.', 'lead_paragraph': 'In March 1957, as Elvis was buying Graceland and the Soviets were preparing to shock the world with Sputnik, Robert F. Wagner, the famously cautious mayor of New York, was having trouble taking a stand.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/24/science/24SUBFLOURIDE1/24SUBFLOURIDE1-articleLarge.jpg', 'height': 433, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', '