ords': [{'name': 'organizations', 'value': 'Teach for America', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-06T01:50:11+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Education', 'byline': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c46ff1f3-7a90-5480-8a80-6e93f39fa420', 'word_count': 1430, 'uri': 'nyt://article/c46ff1f3-7a90-5480-8a80-6e93f39fa420'}, {'abstract': 'U.S. trade groups gave the Chinese government an earful last week about new policies that could hamper the ability of major technology multinationals to do business in China.', 'web_url': 'https://www.nytimes.com/2015/02/06/business/international/us-business-group-urges-resistance-to-chinese-policy.html', 'snippet': 'U.S. trade groups gave the Chinese government an earful last week about new policies that could hamper the ability of major technology multinationals to do business in China.', 'lead_paragraph': 'United States trade groups gave the Chinese government an earful last week about new policies that could hamper the ability of major technology multinationals to do business in China. Now, in a letter addressed to key United States officials, including Secretary of State John Kerry, 17 trade groups headlined by the United States Chamber of Commerce urged the government to resist the Chinese policies, according to a copy of the letter viewed Thursday by The New York Times. The letter called for the United States government to take “immediate action to work with Chinese officials to reverse an alarming number of troubling, new Chinese government policies impacting the information and communications technology sector.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Business Group Urges Resistance to Chinese Policy', 'kicker': 'Business Briefing', 'content_kicker': None, 'print_headline': 'U.S. Business Group Urges Resistance To Chinese Policy ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States International Relations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Chamber of Commerce', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-06T01:51:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By PAUL MOZUR', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'MOZUR', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/70fd977d-3035-505b-aee1-c23976da6a28', 'word_count': 113, 'uri': 'nyt://article/70fd977d-3035-505b-aee1-c23976da6a28'}, {'abstract': 'The departure of Peter Ragone, the powerful steward of Mayor Bill de Blasio’s public image, is the most significant shake-up yet at a close-knit City Hall.', 'web_url': 'https://www.nytimes.com/2015/02/06/nyregion/a-top-aide-who-helped-mold-de-blasios-public-image-is-leaving.html', 'snippet': 'The departure of Peter Ragone, the powerful steward of Mayor Bill de Blasio’s public image, is the most significant shake-up yet at a close-knit City Hall.', 'lead_paragraph': 'The powerful steward of Mayor Bill de Blasio’s public image is leaving the administration, the most significant shake-up yet at a close-knit City Hall. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images