tle': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21dc5cbb-6b73-5e93-85be-aadbbdfda196', 'word_count': 981, 'uri': 'nyt://article/21dc5cbb-6b73-5e93-85be-aadbbdfda196'}, {'abstract': 'Heddy Honigmann’s film looks at the Royal Concertgebouw Orchestra on its 125th anniversary tour in 2013.', 'web_url': 'https://www.nytimes.com/2015/02/28/movies/review-around-the-world-in-50-concerts-a-documentary-follows-an-orchestra.html', 'snippet': 'Heddy Honigmann’s film looks at the Royal Concertgebouw Orchestra on its 125th anniversary tour in 2013.', 'lead_paragraph': 'You won’t find talk about dwindling audiences or the need to expand repertories in Heddy Honigmann’s documentary “Around the World in 50 Concerts.” Ms. Honigmann’s movie, which follows the Royal Concertgebouw Orchestra of Amsterdam on its 125th anniversary tour in 2013, is more concerned with the power of music, both for the people who make it and the people listening, than it is with the business of running an orchestra in the 21st century.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/28/arts/28AROUND/28AROUND-articleLarge-v2.jpg', 'height': 336, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/28/arts/28AROUND/28AROUND-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 336}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/28/arts/28AROUND/28AROUND-jumbo-v2.jpg', 'height': 573, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/28/arts/28AROUND/28AROUND-superJumbo-v2.jpg', 'height': 1106, 'width': 1976, 'subType': 'superJumbo', 'crop_