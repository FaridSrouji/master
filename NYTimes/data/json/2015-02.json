ms', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-06T08:27:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ariel Dorfman', 'person': [{'firstname': 'Ariel', 'middlename': None, 'lastname': 'Dorfman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/bfc8e26f-368c-5808-b9ad-e0c3b5a6ccfe', 'word_count': 909, 'uri': 'nyt://article/bfc8e26f-368c-5808-b9ad-e0c3b5a6ccfe'}, {'abstract': 'Regulators should be applauded for trying to stop companies from blocking or slowing down information on the Internet.', 'web_url': 'https://www.nytimes.com/2015/02/06/opinion/net-neutralitys-wise-new-rules.html', 'snippet': 'Regulators should be applauded for trying to stop companies from blocking or slowing down information on the Internet.', 'lead_paragraph': 'The Federal Communications Commission will soon put in place regulations designed to prevent cable and phone companies from blocking or slowing down information on the Internet. The companies and their congressional allies are using scare tactics to stop this from happening. ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/06/opinion/06fri1WEB/06fri1WEB-articleLarge.jpg', 'height': 382, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/06/opinion/06fri1WEB/06fri1WEB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 382}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/06/opinion/06fri1WEB/06fri1WEB-jumbo.jpg', 'height': 651, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2