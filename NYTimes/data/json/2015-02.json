dard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/13/us/13carolina-web02/13carolina-web02-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/13/us/13carolina-web02/13carolina-web02-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Funeral for Muslims Killed in Chapel Hill Draws Thousands', 'kicker': None, 'content_kicker': None, 'print_headline': 'Funeral for Muslims Killed in Chapel Hill Draws Thousands', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Abu-Salha, Razan Mohammad', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Abu-Salha, Yusor Mohammad', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Chapel Hill (NC)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Barakat, Deah Shaddy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Funerals and Memorials', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'University of North Carolina', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'North Carolina State University', 'rank': 11, 'major': 'N'}], 'pub_date': '2015-02-12T15:05:20+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jonathan M. Katz', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b137b040-4315-5b14-a0bc-79866ef24398', 'word_count': 850, 'uri': 'nyt://article/b137b040-4315-5b14-a0bc-79866ef24398'}, {'abstract': 'Parents often worry that a teacher calls on some students more than others, or that quieter children are overlooked in the classroom.', 'web_url': 'https://parenting.blogs.nytimes.com/2015/02/12/teaching-students-how-to-talk-less-and-think-more/', 'snippet': 'Parents often worry that a teacher calls on some students more than others, or that quieter children are overlooked in the classroom.', 'lead_paragraph': 'This week’s question comes from a discussion on my Facebook feed, in which Mark North, an instructor at Highline Community College in Des Moines, Wash., asked for suggestions about how to manage students who monopolize class time with their comments. I often get the flip side of this question from parents who say their child’s teacher calls on some students and not others, or from parents who are concerned that their quiet child gets overlooked in class.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/03/13/blogs/motherlode-teachers-turn/motherlode-teachers-turn-articleLarge.jpg', 'height': 448, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/03/13/blogs/motherlode-teachers-turn/motherlode-teachers-turn-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 448}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/03/13/blogs/motherlode-teachers-turn/motherlode-teachers-turn-jumbo.jpg', 'height': 765, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/03/13/blogs/motherlode-teachers-turn/motherlode-teachers-turn-superJumbo.jpg', 'height': 1530, 'width': 2048, 'subType': 'superJumbo', 'crop_name': '