cfd3b-6ef4-58b1-af9d-de513007d1cb', 'word_count': 0, 'uri': 'nyt://slideshow/569cfd3b-6ef4-58b1-af9d-de513007d1cb'}, {'abstract': 'The call from my patient’s daughter wasn’t the first time a patient or family member had revealed to me a plan for an exit strategy.', 'web_url': 'https://well.blogs.nytimes.com/2015/02/26/deciding-on-a-parents-death/', 'snippet': 'The call from my patient’s daughter wasn’t the first time a patient or family member had revealed to me a plan for an exit strategy.', 'lead_paragraph': 'The phone call came when these types of calls tend to come — late on a Friday afternoon at the tail end of a brutal Cleveland winter. I picked up the handset as I glanced outside my office windows at the accelerating snowfall, wondering whether I should leave work early.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/health/27well_doctor/27well_doctor-articleLarge.jpg', 'height': 391, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/27/health/27well_doctor/27well_doctor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/health/27well_doctor/27well_doctor-jumbo-v2.jpg', 'height': 668, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/health/27well_doctor/27well_doctor-superJumbo-v2.jpg', 'height': 1336, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/health/27well_doctor/27well_doctor-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/27/health/27well_doctor/27well_doctor-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/health/27well_doctor/27well_doctor-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Deciding On a Parent’s Death', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Death and Dying', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-26T22:13:53+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Mikkael A. Sekeres, M.d', 'person': [{'firstname': 'Mikkael', 'middlename': 'A.', 'lastname': 'Sekeres', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6b64b73-2800-5ad0-9fcf-5bcf6957d479', 'word_count': 835, 'uri': 'nyt://article/f6b64b73-2800-5ad0-9fcf-5bcf6957d479'}, {'abstract': '“Surround Audience,” organized by Ryan Trecartin and Lauren Cornell, features artists crossing borders and worried about what’s to come.', 'web_url': 'https://www.nytimes.com/2015/02/27/arts/design/review-new-museum-triennial-casts-a-wary-eye-on-the-future.html', 'snippet': '“Surround Audience,” organized by Ryan Trecartin and Lauren Cornell, features artists crossing borders and worried about what’s to come.', 'lead_paragraph': 'If you’re fed up with big joke-shop sculpture, diva spectacles and brain-dead abstraction, the New Museum’s 2015 Triennial, titled “Surround Audience,” will come as a break in the clouds. Not a full flood of new light, but a pull in a different direction, a microgravity shift in a gross-objects industry. It’s a glimpse, and just that, of terrain composed almost entirely of border crossings: between genders, media, disciplines, ethnicities and species. Welcome to Planet Trans.', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Review: New Museum Triennial Casts a Wary Eye on the Future', 'kicker': None, 'content_kicker': None, 'print_headline': 'Casting a Wary Eye on the Future', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cotter, Holland', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New Museum of Contemporary Art', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trecartin, Ryan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Cornell, Lauren (1978- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kline, Josh', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-02-26T22:14:58+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7d1833a6-0018-5a3f-8763-d9202ada1a57', 'word_count': 1497, 'uri': 'nyt://article/7d1833a6-0018-5a3f-8763-d9202ada1a57'}, {'abstract': 'This art director and illustrator, called the Picasso of graphic design, is the subject of a show at the Museum of the City of New York.', 'web_url': 'https://www.nytimes.com/2015/02/27/arts/design/review-everything-is-design-showcases-paul-rand-master-of-brand-identity.html', 'snippet': 'This art director and illustrator, called the Picasso of graphic design, is the subject of a show at the Museum of the City of New York.', 'lead_paragraph': 'You may not know the name Paul Rand (1914-1996), the immensely influential 20th-century advertising art director, illustrator and graphic designer, but it’s a safe bet you’re familiar with some of his works. After shaking up American advertising and book cover design in the 1940s and ’50s, he created the logos for UPS, IBM, Westinghouse and other American corporations, symbols that remain ubiquitously familiar today. His admirers called him “the Picasso of graphic design”; the Museum of Modern Art named him one of the 10 best art directors of all time. ', 'print_section': 'C', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PAULRAND2/27PAULRAND2-articleLarge.jpg', 'height': 425, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/27/arts/27PAULRAND2/27PAULRAND2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 425}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PAULRAND2/27PAULRAND2-jumbo.jpg', 'height': 725, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PAULRAND2/27PAULRAND2-superJumbo.jpg', 'height': 896, 'width': 1265, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PAULRAND2/27PAULRAND2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/27/arts/27PAULRAND2/27PAULRAND2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PAULRAND2/27PAULRAND2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Everything Is Design’ Showcases Paul Rand, Master of Brand Identity', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Master Designer’s Legacy Etched in a Few Letters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rand, Paul', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum of the City of New York', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-02-26T22:21:03+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8e5b1d5b-a81d-5182-aecd-47be672d40de', 'word_count': 908, 'uri': 'nyt://article/8e5b1d5b-a81d-5182-aecd-47be672d40de'}, {'abstract': 'T plucks the best shoes right off the runway. Today’s pick: a block-heeled, double-strap spin on the classic silhouette.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/02/26/prada-fall-2015-runway-shoes-milan-fashion-week/', 'snippet': 'T plucks the best shoes right off the runway. Today’s pick: a block-heeled, double-strap spin on the classic silhouette.', 'lead_paragraph': 'T plucks the best shoes right off the runway.', 'source': 'The New York Times', 'multi