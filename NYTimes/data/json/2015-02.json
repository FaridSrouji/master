s', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Jaguar Land Rover', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-02-10T12:45:57+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Automobiles', 'subsection_name': 'New Cars', 'byline': {'original': 'By Tom Voelk', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Voelk', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/509ecd68-fafa-5484-bba0-a052388d728f', 'word_count': 478, 'uri': 'nyt://article/509ecd68-fafa-5484-bba0-a052388d728f'}, {'abstract': 'The Jaguar F-Type Coupe is as much Rodin as road machine, with performance to match the undulating aluminum panels draped over a bonded and riveted aluminum platform.', 'web_url': 'https://www.nytimes.com/video/automobiles/autoreviews/100000003499999/driven-2015-jaguar-f-type-r-coupe.html', 'snippet': 'The Jaguar F-Type Coupe is as much Rodin as road machine, with performance to match the undulating aluminum panels draped over a bonded and riveted aluminum platform.', 'lead_paragraph': 'The Jaguar F-Type Coupe is as much Rodin as road machine, with performance to match the undulating aluminum panels draped over a bonded and riveted aluminum platform.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/09/multimedia/driven-jaguar-ftype/driven-jaguar-ftype-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/09/multimedia/driven-jaguar-ftype/driven-jaguar-ftype-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/09/multimedia/driven-jaguar-ftype/driven-jaguar-ftype-jumbo.jpg', 'height': 576, 'width': 1024, 'sub