Large', 'legacy': {}}], 'headline': {'main': 'Movie Review: ‘Jupiter Ascending’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Jupiter Ascending (Movie)', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-06T01:19:28+0000', 'document_type': 'multimedia', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'Robin Lindsay', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Lindsay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/2af16c67-ee25-5d1f-8f93-712324e74c26', 'word_count': 0, 'uri': 'nyt://video/2af16c67-ee25-5d1f-8f93-712324e74c26'}, {'abstract': 'In his second, and final, national security strategy on Friday, President Obama will be making a stronger case than he did five years ago for robust American leadership.', 'web_url': 'https://www.nytimes.com/2015/02/06/us/politics/security-strategy-recognizes-us-limits.html', 'snippet': 'In his second, and final, national security strategy on Friday, President Obama will be making a stronger case than he did five years ago for robust American leadership.', 'lead_paragraph': 'WASHINGTON — President Obama plans to release his second, and final, national security strategy\xa0on Friday, laying out a blueprint for robust American leadership for his remaining time in office while recognizing limits on how much the United States can shape world events.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Security Strategy Recognizes U.S. Limits', 'kicker': None, 'content_kicker': None, 'print_headline': 'Security Strategy Recognizes U.S. Limits', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Baker, Peter', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Middle East', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Ukraine', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-02-06T01:20:18+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Peter Baker and David E. Sanger', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Baker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'David', 'middlename': 'E.', 'lastname': 'Sanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8b02ecec-ae7e-5f1e-9b90-ffb24c28f4d0', 'word_count': 1064, 'uri': 'nyt://article/8b02ecec-ae7e-5f1e-9b90-ffb24c28f4d0'}, {'abstract': 'In “Jupiter Ascending,” Mila Kunis plays an earthling who turns out to be the reconstituted queen of the universe.', 'web_url': 'https://www.nytimes.com/2015/02/06/movies/mila-kuniss-dizzying-orbit-in-jupiter-ascending.html', 'snippet': 'In “Jupiter Ascending,” Mila Kunis plays an earthling who turns out to be the reconstituted queen of the universe.', 'lead_paragraph': '“Jupiter Ascending,” the latest from Lana and Andy Wachowski, is a big, woozy, spacey fairy tale with a science-fiction exoskeleton and a core of pure mush. With its nods to the original “Star Trek” and David Lynch’s proto-steampunk hallucination “Dune,” it seduces the eye with filigreed flourishes even as the mind reels from some of the mildewy storytelling. Mila Kunis plays Jupiter Jones, an earthling who turns out to be the reconstituted queen of the universe or some such, which apparently means that she needs to be repeatedly rescued. An uncomfortable-looking Channing Tatum plays her hybrid honey, Caine Wise, a man-wolf with pointy ears and, my, what big, bulging muscles. ', 'print_section': 'C', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cleaning Lady Has No Idea of Her Crucial Role in the Cosmos', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Cleaning Lady Has No Idea of Her Crucial Role in the Cosmos', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wachowski, Andy', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wachowski, Lana', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kunis, Mila', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Tatum, Channing', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Jupiter Ascending (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-02-06T01:26:36+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9a9163ab-4fa7-542e-abf1-f8a8dce87812', 'word_count': 953, 'uri': 'nyt://article/9a9163ab-4fa7-542e-abf1-f8a8dce87812'}, {'abstract': 'Jordan released Abu Muhammad al-Maqdisi, a leading jihadist cleric, from prison on Thursday, according to the official Petra news agency.', 'web_url': 'https://www.nytimes.com/2015/02/06/world/middleeast/jordan-jihadist-cleric-freed-from-jail.html', 'snippet': 'Jordan released Abu Muhammad al-Maqdisi, a leading jihadist cleric, from prison on Thursday, according to the official Petra news agency.', 'lead_paragraph': ' Jordan released Abu Muhammad al-Maqdisi, a leading jihadist cleric, from prison on Thursday, according to the official Petra news agency. Mr. Maqdisi, who was arrested in October, was accused of “using the Internet to promote and incite views of jihadist terrorist organizations.” It is unclear why he was released. Considered a spiritual mentor to Abu Musab al-Zarqawi, the leader of Al Qaeda in Iraq until his death in 2006, Mr. Maqdisi later renounced the killing of civilians and has spoken out against the Islamic State group, calling it “deviant.” ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jordan: Jihadist Cleric Freed From Jail', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Jordan: Jihadist Cleric Freed From Jail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Jordan', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sweis, Rana F', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Maqdisi, Abu Muhammad al-', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Zarqawi, Abu Musab al-', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'AL QAEDA IN MESOPOTAMIA', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Middle East', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-02-06T01:27:02+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Rana F. Sweis', 'person': [{'firstname': 'Rana', 'middlename': 'F.', 'lastname': 'Sweis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/7c719c37-56af-5a26-80ee-434506bcfd1f', 'word_count': 89, 'uri': 'nyt://article/7c719c37-56af-5a26-80ee-434506bcfd1f'}, {'abstract': 'Secretary General Ban Ki-moon said Thursday that he had appointed Nickolay E. Mladenov, a Bulgarian diplomat and statesman who has been his special representative in Iraq, as his new special Middle East peace envoy.', 'web_url': 'https://www.nytimes.com/2015/02/06/world/middleeast/new-middle-east-envoy-is-appointed.html', 'snippet': 'Secretary General Ban Ki-moon said Thursday that he had appointed Nickolay E. Mladenov, a Bulgarian diplomat and statesman who has been his special representative in Iraq, as his new special Middle East peace envoy.', 'lead_paragraph': ' Secretary General Ban Ki-moon said on Thursday that he had appointed Nickolay E. Mladenov, a former foreign minister of Bulgaria who has been his special representative in Iraq, as his new Middle East peace envoy. Mr. Mladenov succeeds Robert H. Serry, a Dutch diplomat who has been in that post for more than seven years. A statement on the appointment, posted on the United Nations website, said Mr. Ban thanked Mr. Serry for “his dedicated service and excellent leadership” but gave no indication about Mr. Serry’s future, precisely when the change would take effect or who would replace Mr. Mladenov in Iraq.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Middle East Envoy Is Appointed', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'New Middle East Envoy Is Appointed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ban Ki-moon', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mladenov, Nickolay E', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Security Council (UN)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Diplomatic Service, Embassies and Consulates', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-02-06T01:36:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Rick Gladstone', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Gladstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/e9f12daa-7875-5cda-ba9c-d120bc885c00', 'word_count': 269, 'uri': 'nyt://article/e9f12daa-7875-5cda-ba9c-d120bc885c00'}, {'abstract': 'In “Outcast,” set in medieval China, a prince needs to foil his murderous older brother.', 'web_url': 'https://www.nytimes.com/2015/02/06/movies/outcast-with-nicolas-cage-and-hayden-christensen.html', 'snippet': 'In “Outcast,” set in medieval China, a prince needs to foil his murderous older brother.', 'lead_paragraph': 'The main thing to be learned from “Outcast,”  Nicholas Powell’s loony directing debut about two former Crusaders hanging out in medieval China, is that Hayden Christensen’s portrayal of opium addiction is not appreciably different from his take on clean and sober.', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/06/arts/06OUTCAST2/06OUTCAST2-articleLarge-v2.jpg', 'height': 723, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/06/arts/06OUTCAST2/06OUTCAST2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 723}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/06/arts/06OUTCAST2/06OUTCAST2-ju