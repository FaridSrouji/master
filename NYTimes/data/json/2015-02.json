: 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/17/upshot/17UP-Measuring/17UP-Measuring-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Measuring Inequality Trends During the Great Recession', 'kicker': 'By the Numbers', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Inequality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recession and Depression', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment Insurance', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Income Tax', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Saez, Emmanuel', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-02-17T05:25:27+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Stephen J. Rose', 'person': [{'firstname': 'Stephen', 'middlename': 'J.', 'lastname': 'Rose', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6c059c0-abdc-54c9-b4ab-0006262b68ef', 'word_count': 953, 'uri': 'nyt://article/f6c059c0-abdc-54c9-b4ab-0006262b68ef'}, {'abstract': 'The income declines for the rich were steeper than for any other group, while the government has done more to help the middle class and poor.', 'web_url': 'https://www.nytimes.com/2015/02/17/upshot/inequality-has-actually-not-risen-since-the-financial-crisis.html', 'snippet': 'The income declines for the rich were steeper than for any other group, while the government has done more to help the middle class and poor.', 'lead_paragraph': 'The notion that income inequality has continued to rise over the past decade is part of the conventional wisdom. Yo