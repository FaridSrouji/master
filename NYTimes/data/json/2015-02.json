 'thumbLarge', 'legacy': {}}], 'headline': {'main': '“Mondo Cane”', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dogs', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-28T21:33:25+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/58ae0e2e-3fc2-5e37-b033-991c58d0f78a', 'word_count': 0, 'uri': 'nyt://slideshow/58ae0e2e-3fc2-5e37-b033-991c58d0f78a'}, {'abstract': 'Silhouettes seem to capture the spirit of the dogs — an outward projection of how they see themselves, off the leash at the park.', 'web_url': 'https://www.nytimes.com/2015/03/01/opinion/sunday/a-dogs-world-in-shadow.html', 'snippet': 'Silhouettes seem to capture the spirit of the dogs — an outward projection of how they see themselves, off the leash at the park.', 'lead_paragraph': 'Years ago, my parents and I started taking our family dog, a standard poodle named Tino, to the Dyker Dog Park in Bay Ridge, Brooklyn. It was essentially a large, enclosed dirt space with some grass toward the back — by no means Prospect Park, but also without leash laws, so dogs could run free. ', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Dog’s World, in Shadow', 'kicker': 'Menagerie', 'content_kicker': None, 'print_headline': 'A Dog’s World, in Shadow', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dogs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-02-28T21:36:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Giancarlo T. Roma', 'person': [{'firstname': 'Gianc