line': {'original': 'By Daniel Jones', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Jones', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/23e3a34a-25a5-5d99-9236-6c32e9b0e437', 'word_count': 443, 'uri': 'nyt://article/23e3a34a-25a5-5d99-9236-6c32e9b0e437'}, {'abstract': '“The Song of the Sea” filmmakers were told not to be so self-deprecating on the Oscar campaign trail — because Americans might take them at their word.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2015/02/13/irish-animators-in-a-strange-land-los-angeles/', 'snippet': '“The Song of the Sea” filmmakers were told not to be so self-deprecating on the Oscar campaign trail — because Americans might take them at their word.', 'lead_paragraph': 'Five years ago, Hollywood was mildly gobsmacked when “The Secret of Kells,” an obscure animated Celtic film from a teeny studio in southeast Ireland, came from nowhere to land a nomination for the best animated feature Oscar. The young filmmakers were, too. This year, the same filmmakers put a little more muscle into getting a nomination for their second effort, “Song of the Sea,” by spending time with Academy members and so on. That, too, worked: they earned their second nod. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/arts/songsea/songsea-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/12/arts/songsea/songsea-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/arts/songsea/songsea-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJ