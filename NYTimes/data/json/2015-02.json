], 'headline': {'main': 'From Agadir to Merzouga', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deserts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Morocco', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Sahara Desert', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-07T04:54:30+0000', 'document_type': 'multimedia', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/efe27543-efd7-5ca1-a650-d1e606a7a66d', 'word_count': 0, 'uri': 'nyt://slideshow/efe27543-efd7-5ca1-a650-d1e606a7a66d'}, {'abstract': 'Corrections appearing in print on Saturday, February 7, 2015.', 'web_url': 'https://www.nytimes.com/2015/02/07/pageoneplus/corrections-february-7-2015.html', 'snippet': 'Corrections appearing in print on Saturday, February 7, 2015.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: February 7, 2015', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-02-07T07:19:09+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9588dcf-e7d6-53fb-9f12-c05f2e6e6919', 'word_count': 610, 'uri': 'nyt://article/f9588dcf-e7d6-53fb-9f12-c05f2e6e6919'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/02/07/arts/television/whats-on-tv-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '1:15 P.M. (Starz Cinema) BEFORE MIDNIGHT (2013) Nine years after rekindling a romance in Paris (“Before Sunset”) that began nine years before that in Vienna (“Before Sunrise”), Celine (Julie Delpy) and Jesse (Ethan Hawke) are in Greece, at the end of a vacation with their twin daughters (Jennifer and Charlotte Prior) and Hank (Seamus Davey-Fitzpatrick), the son Jesse left behind in Chicago. Jesse wonders if they could move from Paris to the United States to spend more time with Hank. Celine sees his question as a demand. And so they will fight about this — and the meaning of love, the nature of time and the difference between men and women — throughout the course of a day. “\xa0‘Before Sunrise,’ ‘Before Sunset’ and ‘Before Midnight’ are modest, charming movies that together add up to the great romantic epic of a generation defined, in the popular mind and our therapists’ offices, by hedged bets, easy ironies and perpetual confusion,” A. O. Scott wrote in The New York Times of this trilogy from the director Richard Linklater. This final installment, he added, “is a wonderful paradox: a movie passionately committed to the ideal of imperfection that is itself very close to perfect.” “Before Sunset” will be shown at 8:40 a.m. on HBO2.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Saturday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-07T08:02:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/be4023b4-dbfb-5d62-b2b7-867b4495d6f9', 'word_count': 687, 'uri': 'nyt://article/be4023b4-dbfb-5d62-b2b7-867b4495d6f9'}, {'abstract': 'A state media report Saturday quoted Kim Jong-un, the North’s leader, as calling for “more tactical guided weapons of high precision and intelligence.”', 'web_url': 'https://www.nytimes.com/2015/02/08/world/asia/north-korea-says-it-has-tested-new-antiship-missile.html', 'snippet': 'A state media report Saturday quoted Kim Jong-un, the North’s leader, as calling for “more tactical guided weapons of high precision and intelligence.”', 'lead_paragraph': 'SEOUL, South Korea — North Korea said Saturday that its leader, Kim Jong-un, had overseen the test-firing of a new antiship missile, weeks before planned joint military exercises by South Korea and the United States that the North has protested.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'North Korea Says It Tested New Missile With Success ', 'kicker': None, 'content_kicker': None, 'print_headline': 'North Korea Says It Tested New Missile With Success', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'North Korea', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Missiles and Missile Defense Systems', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Korean Central News Agency', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kim Jong-un', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Tests', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-02-07T09:37:55+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Choe Sang-Hun', 'person': [{'firstname': 'Choe', 'middlename': None, 'lastname': 'Sang-Hun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material