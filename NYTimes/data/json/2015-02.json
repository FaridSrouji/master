rk Times', 'multimedia': [], 'headline': {'main': 'Plantains, Top to Bottom', 'kicker': 'Hungry City', 'content_kicker': None, 'print_headline': 'Plantains, Top to Bottom', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mishan, Ligaya', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Lower East Side (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Patacon Pisao (Manhattan, NY, Restaurant)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-12T18:08:19+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Ligaya Mishan', 'person': [{'firstname': 'Ligaya', 'middlename': None, 'lastname': 'Mishan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0b84cf18-1b1d-5346-aea9-d6a4db9a1682', 'word_count': 702, 'uri': 'nyt://article/0b84cf18-1b1d-5346-aea9-d6a4db9a1682'}, {'abstract': 'Two of the old giants of the technology world showed this week two very different ways of making a transition to a world where computer intelligence is everywhere.', 'web_url': 'https://bits.blogs.nytimes.com/2015/02/12/cisco-and-texas-instruments-adapt-to-a-new-tech-world/', 'snippet': 'Two of the old giants of the technology world showed this week two very different ways of making a transition to a world where computer intelligence is everywhere.', 'lead_paragraph': 'For at least a couple of old tech companies, the week offered some good news. And perhaps some lessons about what survival, even prosperity, will look like.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/technology/12bits-chambers/12bits-chambers-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge'