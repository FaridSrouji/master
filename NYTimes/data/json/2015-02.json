d8b-324ffbdc7aa9', 'word_count': 407, 'uri': 'nyt://article/9500fbae-4d84-514f-ad8b-324ffbdc7aa9'}, {'abstract': 'President Obama is right to push a personalized approach to health care forward, though high costs remain a concern.', 'web_url': 'https://www.nytimes.com/2015/02/08/opinion/sunday/medicine-just-for-you.html', 'snippet': 'President Obama is right to push a personalized approach to health care forward, though high costs remain a concern.', 'lead_paragraph': 'President Obama’s new budget contains a farsighted proposal that could ultimately transform the practice of American medicine. The proposal seeks to design treatments for the individual, which are sometimes called “personalized medicine” or “precision medicine” to distinguish them from the one-size-tries-to-fit-all approach.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Medicine Just for You', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Medicine Just for You', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicine and Health', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Genetics and Heredity', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Cancer', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-02-07T19:30:12+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/9ba7ced1-903f-5b38-8e02-6e37c0a83b85', 'word_count': 556, 'uri': 'nyt://article/9ba7ced1-903f-5b38-8e02-6e37c0a83b85'}, {'abstract': 'I want to hold his hand. And that’s still a loaded gesture.', 'web_url': 'https://www.nytimes.com/2015/02/08/opinion/sunday/frank-bruni-same-sex-marriage-republican-scorn-and-unfinished-work.html', 'snippet': 'I want to hold his hand. And that’s still a loaded gesture.', 'lead_paragraph': 'WHAT an altered world we live in. What an advanced one. The man I love and I can be married in New York or 35 other states if we ever get organized enough, if we decide that we want public vows and a gaudy cake — I’m thinking devil’s food, for a host of reasons — to seal our commitment.', 'print_section': 'SR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bruni-circular/bruni-circular-articleLarge-v2.jpg', 'height': 601, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/01/opinion/bruni-circular/bruni-circular-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 601}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bruni-circular/bruni-circular-jumbo-v5.jpg', 'height': 1024, 'width': 1023, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bruni-circular/bruni-circular-superJumbo-v5.jpg', 'height': 1852, 'width': 1850, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/bruni-circular/bruni-circular-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/bruni-circular/bruni-circular-thumbStandard-v5.jpg', 'thumbnailwidth': 