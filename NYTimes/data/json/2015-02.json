': 415}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/05/business/05NET/05NET-jumbo.jpg', 'height': 708, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/05/business/05NET/05NET-superJumbo.jpg', 'height': 1416, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/05/business/05NET/05NET-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/05/business/05NET/05NET-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/05/business/05NET/05NET-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'F.C.C. Plans Strong Hand to Regulate the Internet', 'kicker': None, 'content_kicker': None, 'print_headline': 'F.C.C. Plans Strong Hand To Regulate The Internet ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lohr, Steve', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Net Neutrality', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wheeler, Thomas E', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Communications Commission', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-04T16:42:56+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Steve Lohr', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Lohr', 'qualif