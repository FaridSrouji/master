': [], 'headline': {'main': 'Searching for a Safe Deposit', 'kicker': 'Comments', 'content_kicker': None, 'print_headline': 'Searching for a Safe Deposit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-02-14T18:50:49+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ada61abe-2533-5e0b-b62e-22e01f6b03c1', 'word_count': 296, 'uri': 'nyt://article/ada61abe-2533-5e0b-b62e-22e01f6b03c1'}, {'abstract': 'Readers sound off on the latest headlines in Sports.', 'web_url': 'https://www.nytimes.com/2015/02/15/sports/letters-to-the-editor.html', 'snippet': 'Readers sound off on the latest headlines in Sports.', 'lead_paragraph': 'Smith Shone On Court and Off', 'print_section': 'SP', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Letters to the Editor', 'kicker': 'Inbox', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Connecticut', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jenner, Bruce', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Gender', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Dean (1931-2015)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-14T19:00:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/f9e35475-cc06-5364-a343-d4a3c503dba0', 'word_count': 604, 'uri': 'nyt://article/f9e35475-cc06-5364-a343-d4a3c503dba0'}, {'abstract': 'The anonymous communication social media creates both provokes and mitigates our inherent capacity for monstrosity.', 'web_url': 'https://www.nytimes.com/2015/02/15/opinion/sunday/the-epidemic-of-facelessness.html', 'snippet': 'The anonymous communication social media creates both provokes and mitigates our inherent capacity for monstrosity.', 'lead_paragraph': 'A PART-TIME delivery driver named Peter Nunn was recently sentenced to 18 weeks in a British prison for tweeting and retweeting violent messages to Stella Creasy, a member of Parliament. He never saw his victim but the consequences of his virtual crime were real enough. In a statement, Ms. Creasy described fears for her physical safety, going so far as to install a panic button in her home. Mr. Nunn has been physically separated from the rest of society for posting abusive words on a social media site. ', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/sunday-review/15FACELESSNESS/15FACELESSNESS-articleLarge.jpg', 'height': 919, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/15/sunday-review/15FACELESSNESS/15FACELESSNESS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 919}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/sunday-review/15FACELESSNESS/15FACELESSNESS-jumbo.jpg', 'height': 1024, 'width': 669, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/sunday-review/15FACELESSNESS/15FACELESSNESS-superJumbo.jpg', 'height': 2048, 'width': 1338, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/sunday-review/15FACELESSNESS/15FACELESSNESS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': 