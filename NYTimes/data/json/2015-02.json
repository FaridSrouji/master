il', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/04/business/04socolow-obit/04socolow-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/04/business/04socolow-obit/04socolow-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sandy Socolow, CBS Newsman During Heady Days, Dies at 86', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sandy Socolow, 86, CBS Newsman During Heady Days', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weber, Bruce', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Socolow, Sanford (1928-2015)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'CBS News', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-04T04:47:28+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Bruce Weber', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Weber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/cdd1b536-fd54-5a84-914f-cbf8e9aa6a65', 'word_count': 1107, 'uri': 'nyt://article/cdd1b536-fd54-5a84-914f-cbf8e9aa6a65'}, {'abstract': 'Mr. Oum was the director of animation for Rooster Teeth Productions, a company best known for repurposing avatars from the Halo video games into angst-ridden slackers in the popular web series “Red vs. Blue.”', 'web_url': 'https://www.nytimes.com/2015/02/04/arts/video-games/monty-oum-web-series-animator-dies-at-33.html', 'snippet': 'Mr. Oum was the director of animation for Rooster Teeth Productions, a company best known for repurposing avatars from the Halo video games into angst-ridden slackers in the popular web series “Red vs. Blue.”', 'lead_paragraph': 'Monty Oum, the creator of the animated web series “RWBY” and director of animation for Rooster Teeth Productions, a company best known for repurposing the bloodthirsty avatars in the Halo video games into angst-ridden slackers in the popular web series “Red vs. Blue,” died on Sunday near his home in Austin, Tex. He was 33.', 'print_section': 'B', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/04/arts/04oum-obit/04oum-obit-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/04/arts/04oum-obit/04oum-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/04/arts/04oum-obit/04oum-obit-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/04/arts/04oum-obit/04oum-obit-superJumbo.jpg', 'height': 1999, 'width': 1332, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/04/arts/04oum-obit/04oum-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/04/arts/04oum-obit/04oum-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/04/arts/04oum-obit/04o