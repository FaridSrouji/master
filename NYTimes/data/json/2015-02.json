ws', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-02-20T12:35:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Sydney Ember', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Ember', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/61d5da43-269c-5e45-a16a-e2867f6e915e', 'word_count': 1810, 'uri': 'nyt://article/61d5da43-269c-5e45-a16a-e2867f6e915e'}, {'abstract': 'Ruth Bader Ginsburg’s woman-hear-me-roar history, her frail appearance and her role as leader of the Supreme Court’s liberals have rallied her new fan base.', 'web_url': 'https://www.nytimes.com/2015/02/22/opinion/sunday/gail-collins-ruth-bader-ginsburg-has-no-interest-in-retiring.html', 'snippet': 'Ruth Bader Ginsburg’s woman-hear-me-roar history, her frail appearance and her role as leader of the Supreme Court’s liberals have rallied her new fan base.', 'lead_paragraph': 'RUTH BADER GINSBURG isn’t planning on going anywhere any time soon.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/22/sunday-review/22COLLINSweb/22COLLINSweb-articleLarge.jpg', 'height': 825, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/22/sunday-review/22COLLINSweb/22COLLINSweb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 825}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/22/sunday-review/22COLLINSweb/22COLLINSweb-jumbo.jpg', 'height': 1024, 'width': 745, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': '