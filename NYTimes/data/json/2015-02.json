es/2014/02/14/business/dbpix-dealprof3/dbpix-dealprof3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Delaware Courts Pause on the Deal Price Do-Over', 'kicker': 'Deal Professor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hedge Funds', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-19T19:29:19+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Steven Davidoff Solomon', 'person': [{'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6fa76cd8-1625-5ea3-a555-79eb1ddb66ac', 'word_count': 1287, 'uri': 'nyt://article/6fa76cd8-1625-5ea3-a555-79eb1ddb66ac'}, {'abstract': 'Youth abounds and street style reigns in fall 2015 presentations from London to Paris to New York.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/02/19/male-models-new-york-fashion-week-fall-2015/', 'snippet': 'Youth abounds and street style reigns in fall 2015 presentations from London to Paris to New York.', 'lead_paragraph': 'Having emerged from the shadow of women’s wear, men’s wear is offering some of today’s most compelling design, thanks to a new generation of young mavericks. With eyes on the street, the designers presented clothes for fall/winter 2015 — in London (Craig Green, Alex Mullins and Martine Rose), Paris (Julien David and Gosha Rubchinskiy) and New York (Proper Gang) — that not only reflect what men like to wear, but what they will aspire to. T cast a similarly youthful set of breakthrough models from New York Fashion Week, which ends today, to model these six designers’ fall collections.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Men’s Wear’s Most Compelling New Collections, on Its Six Hottest New Models', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Fashion Memo: The Next Generation of Menu2019s Wear', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': "Men's Fashion Week", 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Models (Professional)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'New York Fashion Week', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Craig', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rose, Martine', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-02-19T19:35:29+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Jason Rider', 'person': [{'firstname': 'Jason', 'middlename': None, 'lastname': 'Rider', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a21ed23b-a7e3-51e3-abfe-52e627928d68', 'word_count': 128, 'uri': 'nyt://article/a21ed23b-a7e3-51e3-abfe-52e627928d68'}, {'abstract': 'Federal authorities are investigating whether hackers broke into the laptop of the former broker and took customer data he had on his computer.', 'web_url': 'https://www.nytimes.com/2015/02/20/business/dealbook/morgan-stanley-broker-who-took-customer-data-may-have-been-hacking-victim.html', 'snippet': 'Federal authorities are investigating whether hackers broke into the laptop of the former broker and took customer data he had on his computer.', 'lead_paragraph': 'There’s been little dispute that a former Morgan Stanley broker, Galen Marsh, violated the firm’s rules when he downloaded information about 350,000 customers onto his personal computer. But Mr. Marsh may not be responsible for posting that information online late last year and trying to sell it, people familiar with the investigation said on Thursday.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/06/business/Morgan/Morgan-jumbo.jpg', 'height': 837, 'width': 561, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/06/business/Morgan/Morgan-superJumbo.jpg', 'height': 837, 'width': 561, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/06/business/Morgan/Morgan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/06/business/Morgan/Morgan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/06/business/Morgan/Morgan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hackers May Have Taken Customer Data From Morgan Stanley Broker', 'kicker': None, 'content_kicker': None, 'print_headline': 'Twist in Morgan Inquiry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Goldstein, Matthew', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cyberattacks and Hackers', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'M