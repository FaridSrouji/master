dern-love-college-essay-contest-1423085382417/modern-love-college-essay-contest-1423085382417-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Modern Love College Essay Contest', 'kicker': 'Modern Love', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-02-05T19:41:41+0000', 'document_type': 'multimedia', 'news_desk': 'Style', 'section_name': 'Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/cc7945ea-d369-572e-abc7-521046fd5fdb', 'word_count': 0, 'uri': 'nyt://interactive/cc7945ea-d369-572e-abc7-521046fd5fdb'}, {'abstract': 'On the power of moral clarity in a spiritual vacuum.', 'web_url': 'https://douthat.blogs.nytimes.com/2015/02/05/the-moral-appeal-of-p-c/', 'snippet': 'On the power of moral clarity in a spiritual vacuum.', 'lead_paragraph': 'By way of a parting thought\xa0on the political correctness debate, I’m going to quote from a 2011 argument\xa0from Brendan O’Neill, the editor of the British magazine Spiked, in which he talks both about the essential appeal of the strident moralism inherent in a lot of what gets labeled as P.C., and about why it can exert so much effective pressure on institutions that seem like they should be better equipped to resist. Here’s O’Neill:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Moral Appeal of P.C.', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Yoffe, Emily', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Occidental College', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Michigan', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-05T19:43:15+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/61526116-f442-5095-8ccd-785a8bfbb22e', 'word_count': 1201, 'uri': 'nyt://article/61526116-f442-5095-8ccd-785a8bfbb22e'}, {'abstract': 'MoMA PS1’s outdoor courtyard in Long Island City will be temporarily transformed this summer by Andrés Jaque/Office for Political Innovation.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/02/05/ps1-names-winner-of-summer-architecture-competition/', 'snippet': 'MoMA PS1’s outdoor courtyard in Long Island City will be temporarily transformed this summer by Andrés Jaque/Office for Political Innovation.', 'lead_paragraph': 'The transformation of MoMA PS1’s outdoor courtyard in Long Island City by an emerging architect has become one of the art world’s rites of summer. The popularity of these temporary installations has made its architectural competition increasingly stiff. In this, the 16th year of the Young Architects Program, the lucky winner is Andrés Jaque/Office for Political Innovation.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/05/arts/05artsbeat-ps1/05artsbeat-ps1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/05/arts/05artsbeat-ps1/05artsbeat-ps1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/05/arts/05artsbeat-