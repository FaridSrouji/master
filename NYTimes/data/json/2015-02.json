o', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/sundance-me/sundance-me-superJumbo.jpg', 'height': 1376, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/sundance-me/sundance-me-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/02/arts/sundance-me/sundance-me-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/sundance-me/sundance-me-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Top Sundance Prizes Go to ‘Me and Earl and the Dying Girl’', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '‘Me and Earl’ Wins Big At Sundance Film Festival', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Awards, Decorations and Honors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Festivals', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sundance Film Festival (Park City, Utah)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-01T05:21:29+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Cara Buckley', 'person': [{'firstname': 'Cara', 'middlename': None, 'lastname': 'Buckley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8759731c-3871-5592-b86a-cfbafbd0a117', 'word_count': 358, 'uri': 'nyt://article/8759731c-3871-5592-b86a-cfbafbd0a117'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/02/01/arts/television/whats-on-tv-sunday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '6 P.M. (NBC) SUPER BOWL XLIX The New England Patriots face off against the Seattle Seahawks at the University of Phoenix Stadium in Glendale, Ariz. Al Michaels provides play-by-play commentary; Cris Collinsworth is the analyst; and Michele Tafoya reports from the sidelines. Kickoff is at 6:30. Katy Perry, above, will take the stage at halftime, with Lenny Kravitz and Missy Elliott as special guests; Idina Menzel will perform the national anthem; and John Legend will sing “America the Beautiful.” Bob Costas will host the pregame show, starting at noon, featuring commentary and analysis; visits to the teams’ hotels; an interview with Ms. Perry by Josh Elliott; celebrity reports by the figure skaters Johnny Wier and Tara Lipinski; a stop at the official tailgate party; and an interview with President Obama by Savannah Guthrie.', 'print_section': 'SP', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Sunday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Sunday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-01T06:00:10+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/86e93ab7-6b6f-5188-8ad3-81db8ac74621', 'word_count': 643, 'uri': 'nyt://article/86e93ab7-6b6f-5188-8ad3-81db8ac74621'}, {'abstract': 'Corrections appearing in