le', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Tom Pedulla', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Pedulla', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21abed67-2034-58e5-a0dc-1cf3cdad725d', 'word_count': 913, 'uri': 'nyt://article/21abed67-2034-58e5-a0dc-1cf3cdad725d'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2015/02/22/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'THE PROBLEM OF SLAVERY IN THE AGE OF EMANCIPATION,  by David Brion Davis. (Vintage, $16.95.) This final volume in an exceptional trilogy on slavery in the Western Hemisphere focuses on 19th-century trans-Atlantic abolitionism and, in particular, the intellectual and theological origins of the antislavery movement in America. Davis explores how the Haitian Revolution respectively terrified and inspired white and black Americans, and examines the significance of the colonization project to move freed slaves back to Africa.', 'print_section': 'BR', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paperback Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-20T18:16:32+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/75a6faa9-01c9-55ae-9d69-a41bf8099ceb', 