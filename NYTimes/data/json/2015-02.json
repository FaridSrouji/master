ine': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/be11cdac-9918-50f6-9aed-73f0adeb114c', 'word_count': 0, 'uri': 'nyt://slideshow/be11cdac-9918-50f6-9aed-73f0adeb114c'}, {'abstract': 'Cafe Mingala is New York City’s only dedicated Burmese restaurant.', 'web_url': 'https://www.nytimes.com/2015/03/01/nyregion/cafe-mingala-offers-a-rare-and-constant-taste-of-myanmar.html', 'snippet': 'Cafe Mingala is New York City’s only dedicated Burmese restaurant.', 'lead_paragraph': 'Tucked between flashier Chinese and Indian restaurants on Second Avenue on the Upper East Side of Manhattan is an unassuming storefront whose only markings are a simple awning and two blue neon words in the window: “Burmese Cooking.” The restaurant, Cafe Mingala, is so narrow and dwarfed by its neighbors that you’d probably never notice it. If you did pass it by, you’d miss out on New York City’s only dedicated Burmese restaurant. ', 'print_section': 'MB', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'You Say Myanmar, They Say Burma ', 'kicker': 'Neighborhood Joint', 'content_kicker': None, 'print_headline': 'You Say Myanmar, They Say Burma', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Upper East Side (Manhattan, NY)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cafe Mingala (Manhattan, NY, Restaurant)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-28T17:17:49+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Laura Smith', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d19a413a-f23d-562a-82fd-15c79ad850bb', 'word_co