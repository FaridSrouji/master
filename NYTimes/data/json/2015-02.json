e/f53e7a3e-0d75-5d63-92ec-bf536cff2d90'}, {'abstract': 'Carl Hancock Rux’s new production, “Stranger on Earth,” looks at the lives of the civil rights icon James Baldwin and the singer Dinah Washington.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/02/19/james-baldwin-dinah-washington-civil-rights-play-harlem-stage/', 'snippet': 'Carl Hancock Rux’s new production, “Stranger on Earth,” looks at the lives of the civil rights icon James Baldwin and the singer Dinah Washington.', 'lead_paragraph': 'In 1963, during one of the most turbulent years of the civil rights movement, the writer James Baldwin found himself on the cover of Time magazine, having become a national voice for civil rights with his book, “The Fire Next Time.” Meanwhile, the cornet-voiced jazz singer Dinah Washington, who’d had a hit a few years back with “What a Diff’rence a Day Makes,” was newly married, settling down in Detroit and looking forward to the release of a new album, “Stranger on Earth.” The two figures — each of them on a similar path of political awakening — probably never met (Washington would die of an overdose, at age 39, before Christmas), but that hasn’t stopped the Obie Award-winning playwright and performer Carl Hancock Rux from imagining what would happen if they had with his new play “Stranger on Earth.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/19/t-magazine/19stranger-murphy-1/19stranger-murphy-1-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/19/t-magazine/19stranger-murphy-1/19stranger-murphy-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/19/t-magazine/19stranger-murphy-1/19stranger-murphy-1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/19/t-magazine/19stranger-murphy-1/19stranger-murphy-1-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/19/t-magazine/19stranger-murphy-1/19stranger-murphy-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/19/t-magazine/19stranger-murphy-1/19stranger-murphy-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/19/t-magazine/19stranger-murphy-1/19stranger-murphy-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A New Play Explores a Harlem Friendship That Never Was', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rux, Carl Hancock', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Harlem Stage', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Harlem (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-19T20:30:43+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Tim Murphy', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2319c563-0ec3-5b3d-804c-fbedb579c42d', 'word_count': 352, 'uri': 'nyt://arti