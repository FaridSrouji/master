ection_name': 'Asia Pacific', 'byline': {'original': 'By Jess Macy Yu', 'person': [{'firstname': 'Jess', 'middlename': 'Macy', 'lastname': 'Yu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39e756d1-8722-5447-94f9-be554cc52aab', 'word_count': 566, 'uri': 'nyt://article/39e756d1-8722-5447-94f9-be554cc52aab'}, {'abstract': '“Wolf Totem,” a film by the French director Jean-Jacques Annaud, opens in China with Beijing’s approval.', 'web_url': 'https://www.nytimes.com/2015/02/24/arts/international/china-looks-west-to-bring-wolf-totem-to-screen.html', 'snippet': '“Wolf Totem,” a film by the French director Jean-Jacques Annaud, opens in China with Beijing’s approval.', 'lead_paragraph': 'BEIJING — Ten years ago, when producers at the state-run Beijing Forbidden City Film Corporation began searching for a director for the movie adaptation of the Chinese novel “Wolf Totem” by Jiang Rong, they had no plans to look beyond China’s homegrown stable. It was a Chinese story, after all, written by a Chinese author, and had sold more than a million copies in this country in the year since its publication in 2004. (It has sold four million more there since.)', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/02/arts/02WOLFTOTEMJP2/02WOLFTOTEMJP2-articleLarge-v2.jpg', 'height': 341, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/02/arts/02WOLFTOTEMJP2/02WOLFTOTEMJP2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 341}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/02/arts/02WOLFTOTEMJP2/02WOLFTOTEMJP2-jumbo-v2.jpg', 'height': 581, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank'