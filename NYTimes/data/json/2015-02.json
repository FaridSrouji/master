65, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/nyregion/20150202FIREss-slide-S938/20150202FIREss-slide-S938-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/02/nyregion/20150202FIREss-slide-S938/20150202FIREss-slide-S938-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/nyregion/20150202FIREss-slide-S938/20150202FIREss-slide-S938-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cleaning Up Damage From a Blaze', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fires and Firefighters', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Williamsburg (Brooklyn, NY)', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-02-01T22:39:21+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/63c076d9-1fe2-5bd9-b2e5-95e430bc2be9', 'word_count': 0, 'uri': 'nyt://slideshow/63c076d9-1fe2-5bd9-b2e5-95e430bc2be9'}, {'abstract': 'Joachim Roncin, the art director of a free Paris weekly magazine, is trying to prevent people from capitalizing on his “Je Suis Charlie” sign.', 'web_url': 'https://www.nytimes.com/2015/02/02/arts/design/theres-no-branding-a-symbol-of-free-speech.html', 'snippet': 'Joachim Roncin, the art director of a free Paris weekly magazine, is trying to prevent people from capitalizing on his “Je Suis Charlie” sign.', 'lead_paragraph': 'Almost immediately after jihadists killed 12 in an attack on the French satirical weekly Charlie Hebdo on Jan. 7, the image went viral: “Je Suis Charlie” or “I Am Charlie,” white and light gray letters against a black background. The words are now a shorthand for support of freedom of expression. The sign is the creation of Joachim Roncin, 39, the art director of Stylist, a free Paris weekly magazine. Now, with the aid of pro bono lawyers and the good will of France’s patent office, he’s trying to prevent people from capitalizing on it. “I can’t trademark it. It’s not something that belongs to anyone,” Mr. Roncin said in a telephone interview. “If it’s a slogan, it cannot be a brand.” Mr. Roncin said that even arms manufacturers had filed requests with the French patent office, hoping to sell weapons with the phrase. He said that the patent office has said it will not trademark the slogan. Mr. Roncin has only granted Reporters Without Borders permission to use the image to help raise money for Charlie Hebdo. (In its first issue published after the attacks, the magazine ran a cartoon depicting people in Bangladesh hunched over sewing machines sewing “Je Suis Charlie” T-shirts.) Mr. Roncin posted his image on Twitter not long after the killings. With only around 400 Twitter followers, he expected only a few friends to share the image, but it swept across social media, and tens of thousands marched in Paris on Jan. 11 holding “Je Suis Charlie” signs. “It’s incredible,” Mr. Roncin said. “Now it’s crazy.”', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/02ARTS3/02ARTS3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/02/arts/02ARTS3/02ARTS3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/02ARTS3/02ARTS3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/02ARTS3/02ARTS3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/02ARTS3/02ARTS3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/02/arts/02ARTS3/02ARTS3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/02/arts/02ARTS3/02ARTS3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'There’s No Branding a Symbol of Free Speech', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'There’s No Branding a Symbol of Free Speech', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Donadio, Rachel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Roncin, Joachim', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Charlie Hebdo', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Slogans and Mottoes', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Trademarks and Trade Names', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-02-01T22:49:15