nt_kicker': None, 'print_headline': 'Coming Home to Damaging Stereotypes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Philipps, Dave', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Marvin, Christopher Michael (1979- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Got Your 6 (Be The Change Inc)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Post-Traumatic Stress Disorder', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-02-05T13:46:17+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Dave Philipps', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Philipps', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8bc55bb-d07a-5cc4-ac3b-324c0a4e73a1', 'word_count': 1281, 'uri': 'nyt://article/e8bc55bb-d07a-5cc4-ac3b-324c0a4e73a1'}, {'abstract': 'Television and movie portrayals of veterans vary widely, to the frustration of many vets. Here, they say, are some of the best and worst recent examples.', 'web_url': 'https://www.nytimes.com/2015/02/06/us/veterans-pan-and-cheer-their-counterparts-on-the-screen.html', 'snippet': 'Television and movie portrayals of veterans vary widely, to the frustration of many vets. Here, they say, are some of the best and worst recent examples.', 'lead_paragraph': 'Chris Marvin, 35, a retired Army helicopter pilot who broke his legs, an arm and bones in his face in a crash in Afghanistan in 2004, says he often does not recognize the veterans he sees portrayed in movies and television shows.