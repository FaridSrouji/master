tandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/upshot/12UP-valentine-3/12UP-valentine-3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Big Valentine Food That Isn’t Chocolate', 'kicker': 'Be Mine', 'content_kicker': None, 'print_headline': 'The Big Valentine Food That Isn’t Chocolate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Valentine's Day", 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barro, Josh', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Candy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Chocolate', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-12T05:32:29+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'The Upshot', 'byline': {'original': 'By Josh Barro', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Barro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5fe4c6fc-7f6f-50ad-a184-2d563c227bee', 'word_count': 858, 'uri': 'nyt://article/5fe4c6fc-7f6f-50ad-a184-2d563c227bee'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/02/12/arts/television/whats-on-tv-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (NBC) THE SLAP Hector (Peter Sarsgaard) is a public servant, a father and a potentially philandering husband who has just lost out on a big job promotion. He finds his life in additional turmoil on the day of his 40th birthday party when his hotheaded cousin (Zachary Quinto) slaps the bullying 5-year-old son of another couple, inciting legal action — and resurrecting some long-buried family secrets. Melissa George plays the boy’s mother; Thandie Newton is Hector’s beautiful wife; and Uma Thurman, Thomas Sadoski, Brian Cox and Makenzie Leigh round out the cast of this eight-part mini-series adapted by Jon Robin Baitz from an Australian series based on a novel by Christos Tsiolkas. Writing in The New York Times, Alessandra Stanley called the show “a remarkable feat — a sophisticated, suspenseful comedy of ill manners that seems much more like a Showtime or Netflix drama than a broadcast network offering.” “The Slap,” she added, “connects, but it’s not a harsh blow. It’s more of a bracing surprise.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Thursday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-12T06:00:11+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/496e696c-28a8-57f1-b477-ab53a98ccf9c', 'word_count': 745, 'uri': 'nyt://article/496e696c-28a8-57f1-b477-ab53a98ccf9c'}, {'abstract': 'Quotation of the Day for Thursday, February 12, 2015.', 'web_url': 'https://www.nytimes.com/2015/02/12/pageoneplus/quotation-of-the-day.html', 'snippet': 'Quotation of the Day for Thursday, February 12, 2015.', 'lead_paragraph': '“There is a tendency to say ‘This is a nice place, these eruptions of violence don’t belong here.’ And yet here we are. This is, in all of the heartbreak and violence and sadness, where we are.”', 'print_section': 'A', 'print_pa