ption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/us/23preempt-web01/23preempt-web01-superJumbo.jpg', 'height': 1409, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/us/23preempt-web01/23preempt-web01-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/23/us/23preempt-web01/23preempt-web01-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/us/23preempt-web01/23preempt-web01-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'States Are Blocking Local Regulations, Often at Industry’s Behest ', 'kicker': None, 'content_kicker': None, 'print_headline': 'States Are Blocking Local Regulations, Often at Industry’s Behest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'States (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dewan, Shaila K', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Local Government', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Abbott, Gregory W (1957- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-02-23T17:38:34+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Shaila Dewan', 'person': [{'firstname': 'Shaila', 'middlename': None, 'lastname': 'Dewan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/164d0989-c458-515b-bad0-11215dafe572', 'word_count': 1227, 'uri': 'nyt://article/164d0989-c458-515b-bad0-11215dafe572'}, {'abstract': 'To match the eclectic, bohemian collection, the makeup artist Wendy Rowe created a beauty look that’s as effortless as it looks.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/02/23/burberry-fall-2015-beauty/', 'snippet': 'To match the eclectic, bohemian collection, the makeup artist Wendy Rowe created a beauty look that’s as effortless as it looks.', 'lead_paragraph': 'The makeup artist Wendy Rowe built a layered beauty look for Burberry’s fall 2015 show. “It’s a folky collection that’s full of eclectic patterns and prints,” she explained backstage earlier today. “To complement that, I’ve created a patchwork of textures: a matte mouth, cashmere skin and iridescent eyes.” Keeping the skin very clean and the lips tinted nude, she focused on creating “romantic” but, crucially, not “smoky” eyes. After drawing a line along the upper and lower lids with cream eye shadow, Rowe then loosely blended beneath the eye for a worn-in finish. Her advice for artlessly recreating this disheveled feel: “It should look as though its been done in a rush.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/t-magazine/23beauty-burberry/23beauty-burberry-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/23/t-magazine/23beauty-burberry/23beauty-burberry-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/23/t-magazine/23beauty-burberry/23beauty-burberry-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': '