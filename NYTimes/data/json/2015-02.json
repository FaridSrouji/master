JAMESGALLERY2/27MERLINJAMESGALLERY2-articleLarge.jpg', 'height': 611, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/27/arts/27MERLINJAMESGALLERY2/27MERLINJAMESGALLERY2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 611}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27MERLINJAMESGALLERY2/27MERLINJAMESGALLERY2-jumbo.jpg', 'height': 1024, 'width': 1006, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27MERLINJAMESGALLERY2/27MERLINJAMESGALLERY2-superJumbo.jpg', 'height': 2048, 'width': 2011, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27MERLINJAMESGALLERY2/27MERLINJAMESGALLERY2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/27/arts/27MERLINJAMESGALLERY2/27MERLINJAMESGALLERY2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27MERLINJAMESGALLERY2/27MERLINJAMESGALLERY2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Merlin James: ‘Genre Paintings’', 'kicker': 'Art in Review', 'content_kicker': None, 'print_headline': 'Merlin James', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'James, Merlin (1950- )', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-02-26T21:55:45+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Martha Schwendener', 'person': [{'firstname': 'Martha', 'middlename': None, 'lastname': 'Schwendener', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fd882887-a256-59a8-ac5a-5c3665f29984', 'word_count': 293, 'uri': 'nyt://article/fd882887-a256-59a8-ac5a-5c3665f29984'}, {'abstract': 'This show offers a subtle contemporary spin on the artistic impulse to remake or deconstruct mediums.', 'web_url': 'https://www.nytimes.com/2015/02/27/arts/design/jim-lee-and-the-cream-tones.html', 'snippet': 'This show offers a subtle contemporary spin on the artistic impulse to remake or deconstruct mediums.', 'lead_paragraph': 'There have been many attempts over the years to merge painting and sculpture. Robert Rauschenberg’s combines — a neologism inspired by Alexander Calder’s mobiles — combined the two practices, while Donald Judd’s 1965 essay “Specific Objects” identified a similar hybrid strain in 1960s art. Jim Lee takes on the project with a certain humor and humility, acknowledging his predecessors but offering a subtle contemporary spin on the artistic impulse to remake or deconstruct mediums.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Jim Lee and the Cream Tones’', 'kicker': 'Art in Review', 'content_kicker': None, 'print_headline': 'Jim Lee', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lee, Jim (1970- )', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-02-26T21:57:26+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Martha Schwendener', 'person': [{'firstname': 'Martha', 'middlename': None, 'lastname': 'Schwendener', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a9244074-30c9-5dbe-9742-3869ad1ec4f2', 'word_count': 265, 'uri': 'nyt://article/a9244074-30c9-5dbe-9742-3869ad1ec4f2'}, {'abstract': 'Lurid and amusing paintings made by Mexican artists as covers for pulp fiction books are being shown at Ricco/Maresca gallery.', 'web_url': 'https://www.nytimes.com/2015/02/27/arts/design/pulp-drunk-mexican-pulp-art.html', 'snippet': 'Lurid and amusing paintings made by Mexican artists as covers for pulp fiction books are being shown at Ricco/Maresca gallery.', 'lead_paragraph': '“Pulp Drunk: Mexican Pulp Art,” an exhibition of original paintings made for the covers of paperback novels of the 1960s and ’70s, is a hoot. It’s also psychologically and sociologically resonant. Most were done in tempera paints on cardboard by unidentified Mexican artists, who vividly pictured primal fantasies and anxieties dressed up in midcentury garb.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PULPDRUNKGALLERY3/27PULPDRUNKGALLERY3-articleLarge.jpg', 'height': 925, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/27/arts/27PULPDRUNKGALLERY3/27PULPDRUNKGALLERY3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 925}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PULPDRUNKGALLERY3/27PULPDRUNKGALLERY3-jumbo.jpg', 'height': 1024, 'width': 664, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PULPDRUNKGALLERY3/27PULPDRUNKGALLERY3-superJumbo.jpg', 'height': 1089, 'width': 706, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PULPDRUNKGALLERY3/27PULPDRUNKGALLERY3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/27/arts/27PULPDRUNKGALLERY3/27PULPDRUNKGALLERY3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/arts/27PULPDRUNKGALLERY3/27PULPDRUNKGALLERY3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Pulp Drunk’: ‘Mexican Pulp Art’', 'kicker': 'Art in Review', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-26T21:57:52+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7c3d8ce2-517e-5b35-80d0-7e1b0c797385', 'word_count': 254, 'uri': 'nyt://article/7c3d8ce2-517e-5b35-80d0-7e1b0c797385'}, {'abstract': 'The Argentine artist, whose work has drawn support from John Baldessari and Paul McCarthy, has two concurrent upcoming exhibitions in London and New York.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/02/26/analia-saban-artist-argentina/', 'snippet': 'The Argentine artist, whose work has drawn support from John Baldessari and Paul McCarthy, has two concurrent upcoming exhibitions in London and New York.', 'lead_paragraph': 'Her works may be beige, but Analia Saban’s practice is anything but boring. The Argentinean-born artist, who at 34 has studios in both Santa Monica, Calif., and Hell’s Kitchen, New York City, is destined for art historical legacy — if her mentors have anything to do with it. “John Baldessari is my main adviser,” she shares, in a chat on the eve of her first London exhibition, “Interiors,” with her long-time gallery Sprüth Magers, which opens Feb. 27. She also concurrently has a solo showing — her second — at Tanya Bonakdar in Chelsea, New York. Both shows feature her signature playful approach to art-making, which slips between genres and subverts traditional usage of materials. “When people start calling me a painter, this is the moment I need to shift. I like to think about where I am showing, I make the work for the space,” she says. “It’s really about experiencing the world and analyzing my own interpretation of what I am experiencing.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Analia Saban’s Unassuming Artwork, More Than Meets the Eye', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baldessari, John', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McCarthy, Paul (1945- )', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Buenos Aires (Argentina)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Chelsea (Manhattan, NY)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Santa Monica (Calif)', 'rank': 11, 'major': 'N'}], 'pub_date': '2015-02-26T22:00:50+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Julie Baumgardner', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Baumgardner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fc9c6e45-4f11-5fb6-9217-a6c0fea0a29d', 'word_count': 756, 'uri': 'nyt://article/fc9c6e45-4f11-5fb6-9217-a6c0fea0a29d'}, {'abstract': 'Plus: Foreign-language eavesdropping, a mother and daughter’s relationship and an evaluation of a former colleague.', 'web_url': 'https://www.nytimes.com/2015/03/01/style/a-question-about-contacting-a-former-girlfriend.html', 'snippet': 'Plus: Foreign-language eavesdropping, a mother and daughter’s relationship and an evaluation of a former colleague.', 'lead_paragraph': 'I went out with a girl for two years after college. I broke up with her when I thought I had met the love of my life. (I was wrong.) My original girlfriend took the breakup very badly. She refused contact with me and wouldn’t return my calls or texts. But now, several years later, I would like to ask her out again. I think she may be “the one.” Is there a polite and respectful way to do this?', 'print_section': 'ST', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_in