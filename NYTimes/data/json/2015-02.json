E/25KYLE-articleLarge.jpg', 'height': 833, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/26/us/25KYLE/25KYLE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 833}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/25KYLE/25KYLE-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/25KYLE/25KYLE-superJumbo.jpg', 'height': 1604, 'width': 1155, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/25KYLE/25KYLE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/26/us/25KYLE/25KYLE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/25KYLE/25KYLE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Insanity Defense Fails in Killing of the Former Navy Sniper Chris Kyle', 'kicker': None, 'content_kicker': None, 'print_headline': 'Insanity Defense Fails in Killing of Sniper', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Routh, Eddie Ray', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fernandez, Manny', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kyle, Chris (1974-2013)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Littlefield, Chad', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Navy Seals', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Post-Traumatic Stress Disorder', 'rank': 11, 'major': 'N'}], 'pub_date': '2015-02-26T01:43:28+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Manny Fernandez and Richard Pérez-Peña', 'person': [{'firstname': 'Manny', 'middlename': None, 'lastname': 'Fernandez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Richard', 'middlename': None, 'lastname': 'Pérez-Peña', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/db10917e-5741-53be-be35-aad59cc971ee', 'word_count': 962, 'uri': 'nyt://article/db10917e-5741-53be-be35-aad59cc971ee'}, {'abstract': 'With four Silver Stars, four Bronze Stars and four Purple Hearts, the Army poster boy was relieved of his command in April 1969 after reporting he witnessed war crimes in South Vietnam.', 'web_url': 'https://www.nytimes.com/2015/02/26/us/anthony-b-herbert-decorated-war-hero-turned-army-whistleblower-dies-at-84.html', 'snippet': 'With four Silver Stars, four Bronze Stars and four Purple Hearts, the Army poster boy was relieved of his command in April 1969 after reporting he witnessed war crimes in South Vietnam.', 'lead_paragraph': 'During World War II, he ran away to join the Marines, but was sent home the next day because he was just 14. He enlisted in the Army three years later and, bemedaled with four Silver Stars, four Bronze Stars and four Purple Hearts, became the most decorated enlisted man during the Korean War. He volunteered for service in Vietnam, where, as a lieutenant colonel, he earned a Silver Star, two Bronze Stars, an Air Medal and an Army Commendation Medal in only 58 days of combat. ', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/26herbert-obit/26herbert-obit-articleLarge.jpg', 'height': 480, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/26/us/26herbert-obit/26herbert-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 480}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/26herbert-obit/26herbert-obit-jumbo.jpg', 'height': 819, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/26herbert-obit/26herbert-obit-superJumbo.jpg', 'height': 1639, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/26herbert-obit/26herbert-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/26/us/26herbert-obit/26herbert-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/26/us/26herbert-obit/26herbert-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Anthony B. Herbert, Decorated War Hero Turned Army Whistleblower, Dies at 84', 'kicker': None, 'content_kicker': None, 'print_headline': 'Anthony B. Herbert, Decorated War Hero Turned Army Whistleblower, Dies at 84', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Herbert, Anthony B (1930-2014)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Vietnam War', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Korean War', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Whistle-Blowers', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-02-26T02:01:26+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sam Roberts', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Roberts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/a762f8d8-14cf-5bbb-b23d-ae2bcd55bcd2', 'word_count': 999, 'uri': 'nyt://article/a762f8d8-14cf-5bbb-b23d-ae2bcd55bcd2'}, {'abstract': 'As a marijuana farm was being discovered under Dell’s Maraschino Cherries, the company’s owner, Arthur Mondella, 57, fatally shot himself in his office bathroom.', 'web_url': 'https://www.nytimes.com/2015/02/26/nyregion/marijuana-farm-found-at-a-cherry-business-in-brooklyn.html', 'snippet': 'As a marijuana farm was being discovered under Dell’s Maraschino Cherries, the company’s owner, Arthur Mondella, 57, fatally shot himself in his office bathroom.', 'lead_paragraph': 'There was no sign on the former brick factory on the treeless block in Red Hook, Brooklyn, where Arthur Mondella worked. No name on the door. Nothing — other than the bright-red liquid trickling onto the sidewalk and into the gutter, and the thick scent of syrup on a summer’s day — to announce the presence of one of the country’s largest suppliers of maraschino cherries.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type':