aterial': 'News', '_id': 'nyt://article/44ef86a9-5db3-55ca-b9e1-e4b6b1175657', 'word_count': 1390, 'uri': 'nyt://article/44ef86a9-5db3-55ca-b9e1-e4b6b1175657'}, {'abstract': 'Ms. Mason sings a number from the new musical, from the troupe the Civilians, about people working in the pornography industry.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/02/17/in-performance-luba-mason-of-pretty-filthy/', 'snippet': 'Ms. Mason sings a number from the new musical, from the troupe the Civilians, about people working in the pornography industry.', 'lead_paragraph': 'This week’s video features the actress Luba Mason singing the number “Beautiful” from “Pretty Filthy,” a new musical derived from interviews with actors, directors and other people working in the pornography industry. The latest work from the troupe the Civilians, the show features a book by Bess Wohl and words and music by Michael Friedman, who accompanies Ms. Mason on piano. It runs through March 1 at the Abrons Arts Center.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Performance: Luba Mason of ‘Pretty Filthy’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Friedman, Michael', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mason, Luba', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wohl, Bess', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Civilians, The (Theater Co)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-02-17T13:00:51+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'ra