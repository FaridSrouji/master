nk': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Ebola Virus', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Berehulak, Daniel (1975- )', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'World Press Photo Foundation', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Barcelona (Spain)', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Liberia', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-02-27T05:30:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf346f93-18e0-5a0f-80c8-6e01b11ed0f9', 'word_count': 791, 'uri': 'nyt://article/cf346f93-18e0-5a0f-80c8-6e01b11ed0f9'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/02/27/arts/television/whats-on-tv-friday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '11:55 A.M. (MoreMax) MOONRISE KINGDOM (2012) In this Wes Anderson tale, 12-year-old Suzy (Kara Hayward) and her soul mate, Sam (Jared Gilman), fall in love and run away, while on an island, sending the adults in charge — Suzy’s parents (the Bishops, played by Bill Murray and Frances McDormand), Scout Master Ward (Edward Norton) and Captain Sharp (Bruce Willis) — into a panic as a storm approaches. “Written by Mr. Anderson and Roman Coppola (they worked together several times before), ‘Moonrise Kingdom’ breezes along with a beautifully coordinated admixture of droll humor, deadpan and slapstick,” Manohla Dargis wrote in The New York Times. But, she added, as in all of Mr. Anderson’s films, “there’s a deep, pervasive melancholia here, too, a sense of regret evident in Mr. Bishop’s slouch (with his plaid pants, he is a walking John Cheever tragedy) and in the way Captain Sharp and Mrs. Bishop look, and don’t look, at each other. Adulthood can seem so desperately painful, so maybe Sam and Suzy shouldn’t be quite as eager to grow up.”', 'print_section': 'C', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Friday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Friday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-27T06:00:11+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/b7734987-c1f7-55c1-b85b-9f04c4205045', 'word_count': 685, 'uri': 'nyt://article/b7734987-c1f7-55c1-b85b-9f04c4205045'}, {'abstract': 'Quotation of the Day for Friday, February 27, 2015.', 'web_url': 'https://www.nytimes.com/2015/02/27/pageoneplus/quotation-of-the-day.html', 'snippet': 'Quotation of the Day for Friday, February 27, 2015.', 'lead_paragraph': '“There are no rules as to how long cases should cook, no recipe. Lots of factors must be weighed.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-02-27T06:41:23+0000', 'document_type': 'article', 'news_desk': 'Summary', 'se