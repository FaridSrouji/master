deshow/661483a8-649a-5303-823b-d42122282c1f'}, {'abstract': 'America’s energy hub prays for the cost of gasoline to rise.', 'web_url': 'https://www.nytimes.com/2015/03/01/opinion/sunday/as-oil-prices-fall-houston-shudders.html', 'snippet': 'America’s energy hub prays for the cost of gasoline to rise.', 'lead_paragraph': 'HOUSTON — LATELY — very lately — I’ve started to enjoy driving by my neighborhood Kroger again. The boldly colored curbside sign has been showing an uptick in the price of gas in the last few weeks, from $1.75 a gallon to $1.91 to $2.11. In fancier parts of town, I’ve even seen it hit $2.50.', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Swartz-Mimi-circular/Swartz-Mimi-circular-jumbo-v3.png', 'height': 400, 'width': 417, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Swartz-Mimi-circular/Swartz-Mimi-circular-superJumbo-v3.png', 'height': 400, 'width': 417, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Swartz-Mimi-circular/Swartz-Mimi-circular-thumbStandard-v3.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/16/opinion/Swartz-Mimi-circular/Swartz-Mimi-circular-thumbStandard-v3.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Swartz-Mimi-circular/Swartz-Mimi-circular-thumbLarge-v3.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As Oil Prices Fall, Houston Shudders ', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'As Oil Prices Fall, Houston Shudders', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Houston (Tex)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Swartz, Mimi', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-02-28T21:25:29+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Mimi Swartz', 'person': [{'firstname': 'Mimi', 'middlename': None, 'lastname': 'Swartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/557cb117-b11a-596a-96e7-c6d5483938ad', 'word_count': 1296, 'uri': 'nyt://article/557cb117-b11a-596a-96e7-c6d5483938ad'}, {'abstract': 'Children will learn better. Look at rural Colombia.', 'web_url': 'https://www.nytimes.com/2015/03/01/opinion/sunday/make-school-a-democracy.html', 'snippet': 'Children will learn better. Look at rural Colombia.', 'lead_paragraph': 'ARMENIA, Colombia — IN a one-room rural schoolhouse an hour’s drive from this city in a coffee-growing region of Colombia, 30 youngsters ages 5 to 13 are engrossed in study. In most schools, students sit in rows facing the teacher, who does most of the talking. But these students are grouped at tables, each corresponding to a grade level. The hum of conversation fills the room. After tackling an assignment on their own, the students review one another’s work. If a child is struggling, the others pitch in to help. ', 'print_section': 'SR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Kirp-David-circular/Kirp-David-circular-articleLarge.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/16/opinion/Kirp-David-circular/Kirp-David-circular-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Kirp-David-circular/Kirp-David-circular-jumbo.jpg', 'height': 400, 'width': 800, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Kirp-David-circular/Kirp-David-circular-superJumbo.jpg', 'height': 400, 'width': 800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Kirp-David-circular/Kirp-David-circular-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/16/opinion/Kirp-David-circular/Kirp-David-circular-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Kirp-David-circular/Kirp-David-circular-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Make School a Democracy', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Make School a Democracy', 'name': None, 'seo': None, 'sub': None}, 'ke