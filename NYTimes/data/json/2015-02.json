ort Across the Board', 'kicker': 'Encouraging Signs', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Labor Department (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-06T14:19:21+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Neil Irwin', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Irwin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7c02222d-8b22-50e5-bd50-7ccb41dae00f', 'word_count': 651, 'uri': 'nyt://article/7c02222d-8b22-50e5-bd50-7ccb41dae00f'}, {'abstract': 'United States air carriers see growing rivals in the Persian Gulf and Europe as a threat.', 'web_url': 'https://www.nytimes.com/2015/02/07/business/us-airlines-challenge-open-skies-agreements.html', 'snippet': 'United States air carriers see growing rivals in the Persian Gulf and Europe as a threat.', 'lead_paragraph': 'For more than two decades, domestic airlines and successive administrations have pushed for, and achieved, broad international agreements that have fostered greater competition, lower airfares and more flights to hundreds of destinations like Tokyo, Beijing and Rio de Janeiro.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/07/business/07openskies1-web/07openskies1-web-articleLarge.jpg', 'height': 319, 'width': 600, 'subType': 'xlarge', 'crop_name': 'arti