on': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Barbaro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b07b6c29-6b8b-5ce0-80f5-212a4e0f105a', 'word_count': 223, 'uri': 'nyt://article/b07b6c29-6b8b-5ce0-80f5-212a4e0f105a'}, {'abstract': 'Create incentives for kidnappers to break ranks with one another.', 'web_url': 'https://www.nytimes.com/2015/02/04/opinion/the-right-way-to-pay-ransoms-to-terrorists.html', 'snippet': 'Create incentives for kidnappers to break ranks with one another.', 'lead_paragraph': 'DURHAM, N.C. — IT all began in 2003, when a German official flew into the wilds of northern Mali with three suitcases full of cash to secure the release of 14 European hostages. That first big ransom breathed life into the militant group known as Al Qaeda in the Islamic Maghreb, and laid the groundwork for a kidnap economy that now finances Islamist extremist groups around the globe.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Right Way to Pay Ransoms to Terrorists', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The Right Way to Pay Ransoms to Terrorists', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kidnapping and Hostages', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AL QAEDA', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-03T17:41:41+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David McAdams', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'McAdams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of