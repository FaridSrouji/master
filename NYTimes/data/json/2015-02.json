mages/2015/02/27/business/dbpix-violin/dbpix-violin-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/business/dbpix-violin/dbpix-violin-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/27/business/dbpix-violin/dbpix-violin-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/business/dbpix-violin/dbpix-violin-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Rhythm of Great Performance', 'kicker': 'Life@Work', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sleep', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Productivity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fatigue', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kahneman, Daniel', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-27T17:34:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Tony Schwartz', 'person': [{'firstname': 'Tony', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/06f98480-57fe-559c-8157-6774b75fede3', 'word_count': 863, 'uri': 'nyt://article/06f98480-57fe-559c-8157-6774b75fede3'}, {'abstract': 'My mom tells me that my dad has always been great with children. But that’s not what I remember.', 'web_url': 'https://parenting.blogs.nytimes.com/2015/02/27/my-dad-strict-my-daughters-papa-not-so-much/', 'snippet': 'My mom tells me that my dad has always been great with children. But that’s not what I remember.', 'lead_paragraph': 'I have always had a complicated relationship with my father. As the oldest of four children and the only girl, I resented my dad’s rigidity, his chauvinism, the perceived preference shown to my younger brothers. When it came to housework, I was relegated to the “girl” chores, which meant I regularly spent an hour washing the family’s dishes, compared with my brother’s 15 minutes of taking out the garbage and sweeping the floors. When I was a little older I was stuck at home watching my eight-years-younger twin brothers, while my brother was absolved from caregiving duties because he was “too irresponsible.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/us/motherlode-papa2/motherlode-papa2-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/27/us/motherlode-papa2/motherlode-papa2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/us/motherlode-papa2/motherlode-papa2-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/us/motherlode-papa2/motherlode-papa2-superJumbo.jpg', 'height': 1356, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/us/motherlode-papa2/motherlode-papa2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/27/us/motherlode-papa2/motherlode-papa2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/us/motherlode-papa2/motherlode-papa2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Dad: Strict. My Daughter’s ‘Papa’? Not So Much.', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grandparents', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-02-27T17:34:52+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'U.S.', 'byline': {'original': 'By Kristina Lynch', 'person': [{'firstname': 'Kristina', 'middlename': None, 'lastname': 'Lynch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/66f21a4a-b1f3-5b06-95af-0af1e8ca1c66', 'word_count': 544, 'uri': 'nyt://article/66f21a4a-b1f3-5b06-95af-0af1e8ca1c66'}, {'abstract': 'For fall 2015, a neutral face —\xa0amped up slightly with layers of mascara and a touch of black glitter —\xa0complements the brand’s range of looks.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/02/27/milan-fashion-week-fall-2015-blumarine-makeup/', 'snippet': 'For fall 2015, a neutral face —\xa0amped up slightly with layers of mascara and a touch of black glitter —\xa0complements the brand’s range of looks.', 'lead_paragraph': '“Our inspiration is about a young girl, cool, who wants to have fun,” explained the makeup artist Tom Pecheux backstage at Blumarine’s fall/winter 2015 show today. To complement the range of textures (leather, lace, lamé), designs (mini dresses, structured coats, flowing gowns) and colors (light gray, burnt orange, electric blue) in the collection, Pecheux stuck to a neutral palette. “If you are a little disco, if you are a little bit rock and roll, if you are a little bit classy, a little bit punk,” he says, the look will work for you. He amped things up, ever so slightly, on the eyes: loads of mascara on the top lashes, a little bit of gloss on the lid and a touch of black glitter. It was a very small beauty moment that added just enough oomph to the rock-and-roll feel of the looks.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/t-magazine/27beauty-blumarine/27beauty-blumarine-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/27/t-magazine/27beauty-blumarine/27beauty-blumarine-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/t-magazine/27beauty-blumarine/27beauty-blumarine-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/t-magazine/27beauty-blumarine/27beauty-blumarine-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/27/t-magazine/27beauty-blumarine/27beauty-blumarine-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/27/t-magazine/27beauty-blumarine/27beauty-blumarine-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 't