ype': 'image', 'url': 'images/2015/02/22/upshot/internet-language-quiz-1424551408050/internet-language-quiz-1424551408050-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Language Quiz: Are You on Fleek?', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-02-22T14:50:32+0000', 'document_type': 'multimedia', 'news_desk': 'The Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By WILSON ANDREWS and JOSH KATZ', 'person': [{'firstname': 'Wilson', 'middlename': None, 'lastname': 'ANDREWS', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Josh', 'middlename': None, 'lastname': 'KATZ', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/e637bf58-8b69-5b05-b6d0-d8efb0141d9c', 'word_count': 0, 'uri': 'nyt://interactive/e637bf58-8b69-5b05-b6d0-d8efb0141d9c'}, {'abstract': 'Highlights from the International Herald Tribune archives: Germans bombard Rheims in 1915.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/02/22/1915-germans-own-to-big-reverse-bombard-rheims/', 'snippet': 'Highlights from the International Herald Tribune archives: Germans bombard Rheims in 1915.', 'lead_paragraph': 'LONDON — The Germans admit serious setbacks and heavy losses within the last few days. They admit it according to their now well-established code\xa0— by useless bombardment of civilians, or the destruction of a monument of architecture. Sometimes it has been a church destroyed, sometimes it has been women and children slaughtered. Sometimes is has been Arras, sometimes is has been Ypres. When everything else fails there is always Pont-à-Mousson. In admitting their recent reverse, the Germans have turned again to Rheims, where there is both a magnificent church to be shelled and plenty of civilians to be killed. This indicates that they regard their latest defeats as unusually serious, and wish to make their admission of them equally so.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/22/blogs/22iht-reims/22iht-reims-articleLarge.jpg', 'height': 435, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/22/blogs/22iht-reims/22iht-reims-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 435}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/22/blogs/22iht-reims/22iht-reims-jumbo.jpg', 'height': 511, 'width': 705, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/22/blogs/22iht-reims/22iht-reims-superJumbo.jpg', 'height': 511, 'width': 705, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/22/blogs/22iht-reims/22iht-reims-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/22/blogs/22iht-reims/22iht-reims-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/22/blogs/22iht-reims/22iht-reims-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1915: Germans Own to Big Reverse, Bombard Rheims', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'v