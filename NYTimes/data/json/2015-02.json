es', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/us/12OREGONweb/12OREGONweb-articleLarge.jpg', 'height': 418, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/12/us/12OREGONweb/12OREGONweb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 418}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/us/12OREGONweb/12OREGONweb-jumbo.jpg', 'height': 713, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/us/12OREGONweb/12OREGONweb-superJumbo.jpg', 'height': 1426, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/us/12OREGONweb/12OREGONweb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/12/us/12OREGONweb/12OREGONweb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/12/us/12OREGONweb/12OREGONweb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Love and Politics Collide as Scandals Plague Oregon’s Fourth-Term Governor', 'kicker': None, 'content_kicker': None, 'print_headline': 'Love and Politics Collide as Scandals Plague Oregon’s Fourth-Term Governor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Johnson, Kirk', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kitzhaber, John', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hayes, Cylvia', 'rank': 3, 'majo