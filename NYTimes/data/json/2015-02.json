dth': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/01/books/review/01SHORT/0301-bks-SHORT-1424192326228-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01SHORT/0301-bks-SHORT-1424192326228-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Poetry', 'kicker': 'The Shortlist', 'content_kicker': None, 'print_headline': 'Poetry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ford, Katie (1975- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, Jynne Dilling', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fulton, Alice', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Belieu, Erin (1967- )', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Slant Six (Book)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-02-27T15:43:19+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Daisy Fried', 'person': [{'firstname': 'Daisy', 'middlename': None, 'lastname': 'Fried', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5cb7288a-0db2-5072-9e77-338483f49136', 'word_count': 1068, 'uri': 'nyt://article/5cb7288a-0db2-5072-9e77-338483f49136'}, {'abstract': 'An outlaw clan terrorizes a town in the Upper Peninsula, and Jim Harrison’s hapless detective is caught in the crossfire.', 'web_url': 'https://www.nytimes.com/2015/03/01/books/review/the-big-seven-by-jim-harrison.html', 'snippet': 'An outlaw clan terrorizes a town in the Upper Peninsula, and Jim Harrison’s hapless detective is caught in the crossfire.', 'lead_paragraph': 'A startling moment occurs in Jim Harrison’s 2011 novel, “The Great Leader,” when the protagonist, Detective Sunderson, abruptly reflects on an incident that has landed him in the hospital. His soon-to-be ex-wife, Diane, has left with all of her things, and Sunderson drinks a bottle of Canadian whisky. “This had gone on a couple of days and . . . a colleague had checked up and found him facedown and comatose on the floor of the unheated enclosed back porch after a 10-degree night.” Up until this point, Sunderson’s steady drinking has been recklessly celebratory in this whisky-soaked novel, the kind of soaking one expects from a divorced detective at the outset of his retirement. But when he blithely reveals that he spent a few days unconscious, all the previous pages are cast into a foggy doubt. Just how screwed up is this guy, and exactly how stewed has he been for the past several chapters?', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01HENDERSON/01HENDERSON-articleLarge.jpg', 'height': 378, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/01/books/review/01HENDERSON/01HENDERSON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 378}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01HENDERSON/01HENDERSON-jumbo.jpg', 'height': 645, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01HENDERSON/01HENDERSON-superJumbo.jpg', 'height': 1290, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01HENDERSON/01HENDERSON-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/01/books/review/01HENDERSON/01HENDERSON-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01HENDERSON/01HENDERSON-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘The Big Seven,’ by Jim Harrison', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stay Off His Lawn', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Henderson, Smith', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Harrison, Jim', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-27T15:45:00+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Smith Henderson', 'person': [{'firstname': 'Smith', 'middlename': None, 'lastname': 'Henderson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c2e074e1-4e6f-5858-831a-d20772ab47fb', 'word_count': 1187, 'uri': 'nyt://article/c2e074e1-4e6f-5858-831a-d20772ab47fb'}, {'abstract': 'The Economist’s Italy correspondent explains the confounding inner workings of the Bel Paese.', 'web_url': 'https://www.nytimes.com/2015/03/01/books/review/the-italians-by-john-hooper.html', 'snippet': 'The Economist’s Italy correspondent explains the confounding inner workings of the Bel Paese.', 'lead_paragraph': 'One of the epigraphs John Hooper uses to introduce the various chapters in his new book, “The Italians,” is a bit of dialogue from the 1949 film “The Third Man.” In it, Harry Lime compares the tumultuous 30 years of Borgia rule in Italy, which produced the Renaissance and some of its greatest artists, to the 500 years of democracy and peace in Switzerland, which, he claims, produced only the cuckoo clock.', 'print_section': 'BR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘The Italians,’ by John Hooper', 'kicker': None, 'content_kicker': None, 'print_headline': 'Under the Italian Sun', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hooper, John Edward Francis', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Italians (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-27T15:45:54+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Elisabetta Povoledo', 'person': [{'firstname': 'Elisabetta', 'middlename': None, 'lastname': 'Povoledo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b942175f-27de-52d7-8f14-204e03f7660e', 'word_count': 681, 'uri': 'nyt://article/b942175f-27de-52d7-8f14-204e03f7660e'}, {'abstract': 'Jorie Graham’s career-spanning selected poems show how she moved the art form forward.', 'web_url': 'https://www.nytimes.com/2015/03/01/books/review/jorie-grahams-from-the-new-world.html', 'snippet': 'Jorie Graham’s career-spanning selected poems show how she moved the art form forward.', 'lead_paragraph': 'Writing about Jorie Graham at this point, seven books after she won the Pulitzer Prize for “The Dream of the Unified Field: Selected Poems 1974-1994,” means joining a cacophony of voices. Google her name and you will find her elders, her peers and those she has influenced (and she has influenced most poets younger than she is, and not just in English, whether they know it or not) making cases for and against the importance of her work. People have all sorts of reasons to love or hate her, and even love to hate her for reasons they sometimes can’t articulate. The most evident case for Graham’s importance is the volume of chatter eddying around her name. Tune all of that out and the deeper reasons for her lasting reputation grow louder. Graham’s great body of work, summarized in “From the New World,” her new career-spanning selected poems (one can understand why active poets resist the tombstone of a “collected” volume), has so much in it, more of life and of the world than that of almost any other poet now writing. Or so it seems to me — as anxious, I realize, as everyone else to make my case.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01teicher/01teicher-articleLarge.jpg', 'height': 689, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/01/books/review/01teicher/01teicher-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 689}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01teicher/01teicher-jumbo.jpg', 'height': 1024, 'width': 892, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01teicher/01teicher-superJumbo.jpg', 'height': 2048, 'width': 1784, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01teicher/01teicher-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/01/books/review/01teicher/01teicher-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/01teicher/01teicher-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jorie Graham’s ‘From the New World’', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Way Things Work', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Teicher, Craig Morgan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Graham, Jorie', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'From the New World: Poems 1976-2014 (Book)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-02-27T15:46:22+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Craig Morgan Teicher', 'person': [{'firstname': 'Craig', 'middlename': 'Morgan', 'lastname': 'Teicher', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/15157af4-c260-52ad-a424-d0411d8005f9', 'word_count': 1062, 'uri': 'nyt://article/15157af4-c260-52ad-a424-d0411d8005f9'}, {'abstract': 'A father and daughter pursue riches in the music world and on the open water in Daniel Handler’s comic novel.', 'web_url': 'https://www.nytimes.com/2015/03/01/books/review/daniel-handlers-we-are-pirates.html', 'snippet': 'A father and daughter pursue riches in the music world and on the open water in Daniel Handler’s comic novel.', 'lead_paragraph': '“Don’t start with Gwen,” begins the second chapter of Daniel Handler’s new novel, “We Are Pirates.” “Don’t start” means “Don’t begin” but also “Don’t mess with,” because the Gwen in question is a furious 14-year-old girl who has just been caught shoplifting. Her mother has “ransacked” her room and “thrown all her stuff out, thinking it was stolen. Well, it was stolen now.” Gwen, you see, is \xadupset, so don’t start with Gwen — the joke being, of course, that Chapter 2 is starting with her. The novel itself starts with the report of how the novel’s narrator meets Gwen’s father: ', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/0301-BKS-LEVINE/0301-BKS-LEVINE-articleLarge.jpg', 'height': 646, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/01/books/review/0301-BKS-LEVINE/0301-BKS-LEVINE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 646}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/0301-BKS-LEVINE/0301-BKS-LEVINE-jumbo.jpg', 'height': 1024, 'width': 951, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/0301-BKS-LEVINE/0301-BKS-LEVINE-superJumbo.jpg', 'height': 2000, 'width': 1857, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/0301-BKS-LEVINE/0301-BKS-LEVINE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/01/books/review/0301-BKS-LEVINE/0301-BKS-LEVINE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/01/books/review/0301-BKS-LEVINE/0301-BKS-LEVINE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Daniel Handler’s ‘We Are Pirates’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pillage, Plunder and Loot', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Handler, Daniel', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-27T15:46:33+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Sara Levine', 'person': [{'firstname': 'Sara', 'middlename': None, 'lastname': 'Levine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d72cb2f5-3d2e-59cb-8420-1e891058f149', 'word_count': 1213, 'uri': 'nyt://article/d72cb2f5-3d2e-59cb-8420-1e891058f149'}, {'abstract': 'A memoir mixes biography and intellectual history.', 'web_url': 'https://www.nytimes.com/2015/03/01/books/review/why-not-say-what-happened-by-morris-dickstein.html', 'snippet': 'A memoir mixes biography and intellectual history.', 'lead_paragraph': 'In his 1992 book “Double Agent: The Critic and Society,” Morris Dickstein urged his fellow critics to engage in a cultural conversation among citizens rather than insulate themselves in a ghetto of postmodern jargon. And he insisted that “like all good writing, criticism is personal or it is nothing.” ', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Why Not Say What Happened,’ by Morris Dickstein', 'kicker': None, 'content_kicker': None, 'print_headline': 'Critic’s Choice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dickstein, Morris', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-02-27T15:47:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Susie Linfield', 'person': [{'firstname': 'Susie', 'middlename': None, 'lastname': 'Linfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0be974d1-89fd-500d-a63e-ef1a537145a5', 'word_count': 709, 'uri': 'nyt://article/0be974d1-89fd-500d-a63e-ef1a537145a5'}, {'abstract': 'Changing how society deals with caregiving.', 'web_url': 'https://www.nytimes.com/2015/03/01/books/review/the-age-of-dignity-by-ai-jen-poo-with-ariane-conrad.html', 'snippet': 'Changing how society deals with caregiving.', 'lead_paragraph': 'For years, nonfiction books about aging have tended to fall into certain categories: pragmatic texts about coping with specific challenges and encouraging healthy aging; memoirs of the author’s experience of old age or of caring for elderly parents; research-filled narratives by experts or journalists. ', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘The Age of Dignity,’ by Ai-jen Poo With Ariane Conrad', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Old Problem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Poo, Ai-jen', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Conrad, Ariane', 'rank': 4, 'major': 'N'}, {'n