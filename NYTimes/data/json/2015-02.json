-Stuff/14UP-Stuff-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/14/upshot/14UP-Stuff/14UP-Stuff-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stuff We Liked: Surprising Facts About Vaccination and Beer', 'kicker': 'Best of the Web', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lotteries', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Valentine's Day", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Vaccination and Immunization', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-13T17:22:50+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'Compiled by Damon Darlin and Kathleen Flynn', 'person': [{'firstname': 'Damon', 'middlename': None, 'lastname': 'Darlin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Kathleen', 'middlename': None, 'lastname': 'Flynn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04fba8b7-f165-5f74-9454-875a0a690c47', 'word_count': 620, 'uri': 'nyt://article/04fba8b7-f165-5f74-9454-875a0a690c47'}, {'abstract': 'Nick Hornby, whose novel “Funny Girl” enters the hardcover fiction list at No. 9, has lately embraced Hollywood in a big way.', 'web_url': 'https://www.nytimes.com/2015/02/22/books/review/inside-the-list.html', 'snippet': 'Nick Hornby, whose novel “Funny Girl” enters the hardcover fiction list at No. 9, has lately embraced Hollywood in a big way.', 'lead_paragraph': 'Adaptation, Part I: Readers who have kept tabs on Nick Hornby’s career might not be surprised that his new novel, “Funny Girl” — new at No. 9 on the hardcover fiction list — devotes considerable attention to a couple of scriptwriters. That’s because Hornby, who made his name with the 1995 novel “High Fidelity,” has lately embraced Hollywood in a big way. He received an Oscar nomination for his screenplay for the 2009 movie “An Education” (adapted from Lynn Barber’s memoir), then went on to adapt Cheryl Strayed’s “Wild,” currently in theaters, and Colm Toibin’s novel “Brooklyn,” which had its premiere last month at Sundance. (Interestingly, Hornby did not write the screenplay for “High Fidelity,” which jumped to film in 2000, or any of his other books to become movies — confirming the wisdom that it’s better to operate on other people’s children than your own.) In a recent online interview with The Atlantic, Hornby, who is British, explained why he had actively pursued the “Wild” gig: “There’s a side of me that responds very deeply to American things,” he said. “The book to me felt like a Springsteen album. I always loved Springsteen, but he’s very American. That kind of directness is really interesting to me because it doesn’t have to be unsubtle. It’s just a different way of being, a different way of thinking. The great thing about adaptation is it gives you a chance to be someone else.”', 'print_section': 'BR', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/books/review/15list-hornby/15list-hornby-jumbo.jpg', 'height': 450, 'width': 451, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/books/review/15list-hornby/15list-hornby-superJumbo.jpg', 'height': 450, 'width': 451, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/books/review/15list-hornby/15list-hornby-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/15/books/review/15list-hornby/15list-hornby-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/15/books/review/15list-hornby/15list-hornby-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-02-13T17:23:42+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad4ca37a-f4b7-5e5e-82be-6ae8a0703dd5', 'word_count': 490, 'uri': 'nyt://article/ad4ca37a-f4b7-5e5e-82be-6ae8a0703dd5'}, {'abstract': 'A Delhi woman embraces desire, social and erotic.', 'web_url': 'https://www.nytimes.com/2015/02/15/books/review/a-bad-character-by-deepti-kapoor.html', 'snippet': 'A Delhi woman embraces desire, social and erotic.', 'lead_paragraph': 'The title character of Deepti Kapoor’s searing debut is dead by Line 1, but I still read “A Bad Character” in one frantic sitting. I wasn’t desperate for details about his mysterious death or his relationship with the narrator; it was Idha, a woman ready to defy societal conventions, who kept me on the line.', 'print_section': 'BR', 'print_page': '20', 'source': 'The New York Times'