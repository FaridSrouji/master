l': 'images/2015/02/11/business/dbpix-puerto3/dbpix-puerto3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/11/business/dbpix-puerto3/dbpix-puerto3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Judge Strikes Down Puerto Rico’s Debt Restructuring Law', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Credit and Debt', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Municipal Bonds', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Puerto Rico Electric Power Authority', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Puerto Rico', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-02-08T18:52:33+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Michael Corkery', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Corkery', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dbb45a0c-ba32-5b60-b9d2-27c028bb02ef', 'word_count': 508, 'uri': 'nyt://article/dbb45a0c-ba32-5b60-b9d2-27c028bb02ef'}, {'abstract': 'Highlights from the International Herald Tribune archives: French officials raid a Soviet office in Paris in 1940.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/02/08/1940-french-raid-soviet-paris-trade-office/', 'snippet': 'Highlights from the International Herald Tribune archives: French officials raid a Soviet office in Paris in 1940.', 'lead_paragraph': 'News that the Soviet trade offices in Paris, as well as the Intourist Bureau and the former Soviet School, were raided by the French police Monday was revealed yesterday [Feb. 8] when the press reproduced a German D.N.B. dispatch from Moscow quoting a Tass Agency announcement of the raids. At the same time, it was disclosed that the French authorities rejected the protest of Jacob Souritz, Soviet Ambassador to France, against the raids. The French government took the stand that the three Russian organizations did not enjoy the privilege of extra-territoriality. The raids were justified on the ground that it was necessary to suppress the Soviet propaganda emanating from these premises, which it was stated, was assuming the dimensions of a ‘‘veritable fifth column.’’ It was denied officially that the police action had the ‘‘character of hostility toward a country with which France maintains normal diplomatic relations.’’ ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1940: French Raid Soviet Paris Trade Office', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Communism (Theory and Philosophy)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Propaganda', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-02-08T19:03:20+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eba82bb8-ea25-5df5-add0-8f7fadbd646e', 'word_count': 221, 'uri': 'nyt://article/eba82bb8-ea25-5df5-add0-8f7fadbd646e'}, {'abstract': 'For seven months, the Ukrainian town of Debaltseve, northeast of the rebel stronghold of Donetsk, has been battered by shelling from rebel forces on all sides.', 'web_url': 'https://