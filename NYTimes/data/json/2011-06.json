600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/23/us/GORE/GORE-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/23/us/GORE/GORE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/23/us/GORE/GORE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Gore Criticizes Obama for Record on Climate', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gore Criticizes Obama For Record on Climate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Rolling Stone', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gore, Al', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T15:13:53+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By John M. Broder', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6a47f496-0337-5ff0-90b9-5737683bbcca', 'word_count': 926, 'uri': 'nyt://article/6a47f496-0337-5ff0-90b9-5737683bbcca'}, {'abstract': 'Tobey Maguire, who hit the jackpot with his starring role in the “Spider-Man” films, may have overplayed his hand at the poker table, according to a suit filed in the United States Bankruptcy Court for the Central District of California in Los Angeles.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/22/suit-seeks-to-win-back-poker-kitty-from-tobey-maguire/', 'snippet': 'Tobey Maguire, who hit the jackpot with his starring role in the “Spider-Man” films, may have overplayed his hand at the poker table, according to a suit filed in the United States Bankruptcy Court for the Central District of California in Los Ang...', 'lead_paragraph': 'LOS ANGELES — Tobey Maguire, who hit the jackpot with his starring role in the “Spider-Man” films, may have overplayed his hand at the poker table, according to a suit filed in the United States Bankruptcy Court for the Central District of California here. The trustee for Ruderman Capital Partners is demanding that Mr. Maguire repay at least $311,200 in winnings from what it describes as unlicensed, high-stakes poker games between 2006 and 2009. Radaronline on Wednesday carried a report of the suit, which was filed here in March. According to the filing, Bradley Ruderman, who managed the fund and in January of last year was sentenced to 10 years in federal prison on various fraud charges, used investor money to pay off losses in the games, in which Mr. Maguire was among the winners.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Suit Seeks to Win Back Poker Kitty From Tobey Maguire', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poker (Card Game)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Maguire, Tobey', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Four Seasons Hotel', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T15:15:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29c7cdb5-a54a-532b-953e-cbfd0f43dd85', 'word_count': 213, 'uri': 'nyt://article/29c7cdb5-a54a-532b-953e-cbfd0f43dd85'}, {'abstract': 'The Netherlands has become the first country in Europe to ban its mobile operators from blocking or charging consumers extra for using Internet-based services like Skype.', 'web_url': 'https://www.nytimes.com/2011/06/23/technology/23neutral.html', 'snippet': 'The Netherlands has become the first country in Europe to ban its mobile operators from blocking or charging consumers extra for using Internet-based services like Skype.', 'lead_paragraph': 'BERLIN — The Netherlands on Wednesday became the first country in Europe, and only the second in the world, to enshrine the concept of network neutrality into national law by banning its mobile telephone operators from blocking or charging consumers extra for using Internet-based communications services like Skype or WhatsApp, a free text service.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/23/business/Neutral/Neutral-articleLarge.jpg', 'height': 335, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/23/business/Neutral/Neutral-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 335}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/23/business/Neutral/Neutral-jumbo.jpg', 'height': 636, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Dutch Lawmakers Adopt Net Neutrality Law', 'kicker': None, 'content_kicker': None, 'print_headline': 'Netherlands Bans Extra Carrier Fees for Mobile Web Services', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Net Neutrality', 'rank': 1, 'maj