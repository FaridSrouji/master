ct', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'James, LeBron', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nowitzki, Dirk', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Mavericks', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Heat', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-12T20:18:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Rob Mahoney', 'person': [{'firstname': 'Rob', 'middlename': None, 'lastname': 'Mahoney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/530e4803-f633-559c-8d00-9e76a9371879', 'word_count': 676, 'uri': 'nyt://article/530e4803-f633-559c-8d00-9e76a9371879'}, {'abstract': 'New revealing photographs of Representative Anthony D. Weiner — reportedly taken in the locker room of the Congressional gym — were posted on the Internet Sunday.', 'web_url': 'https://www.nytimes.com/2011/06/13/nyregion/more-photos-and-more-calls-for-weiner-to-resign.html', 'snippet': 'New revealing photographs of Representative Anthony D. Weiner — reportedly taken in the locker room of the Congressional gym — were posted on the Internet Sunday.', 'lead_paragraph': 'New revealing photographs of Representative Anthony D. Weiner — these reportedly taken in the locker room of the Congressional gym — were posted on the Internet on Sunday even as Democratic leaders in the House again called for Mr. Weiner to step down.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'More Photos and More Calls for Weiner to Resign', 'kicker': None, 'content_kicker': None, 'print_headline': 'More Calls to Resign as More Weiner Photos Appear', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Weiner, Anthony D', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Uni