value': 'Guirgis, Stephen Adly', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jewels and Jewelry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-10T17:30:18+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By David Colman', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Colman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d923432-2804-5146-8042-473846da21c8', 'word_count': 679, 'uri': 'nyt://article/5d923432-2804-5146-8042-473846da21c8'}, {'abstract': "June 10, 2011 - Michael D. Shear on what's left of the Newt Gingrich campaign. Also, Jim Rutenberg previews the release of thousands of pages of Sarah Palin's old emails.", 'web_url': 'https://www.nytimes.com/video/us/politics/100000000858810/caucus--the-gingrich-campaign-implodes.html', 'snippet': "June 10, 2011 - Michael D. Shear on what's left of the Newt Gingrich campaign. Also, Jim Rutenberg previews the release of thousands of pages of Sarah Palin's old emails.", 'lead_paragraph': "June 10, 2011 - Michael D. Shear on what's left of the Newt Gingrich campaign. Also, Jim Rutenberg previews the release of thousands of pages of Sarah Palin's old emails.", 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/10/us/politics/video-caucus-061011/video-caucus-061011-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/10/us/politics/video-caucus-061011/video-caucus-061011-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': Non