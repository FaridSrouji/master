 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/sports/mets/mets-articleLarge.jpg', 'height': 379, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/11/sports/mets/mets-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 379}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/sports/mets/mets-jumbo.jpg', 'height': 731, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/sports/mets/mets-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/11/sports/mets/mets-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Mets’ Buffalo Pipeline Again Provides a Boost as Gee Remains Undefeated', 'kicker': 'Mets 8, Pirates 1 ', 'content_kicker': None, 'print_headline': 'Mets’ Buffalo Pipeline Again Provides a Boost as Gee Remains Undefeated', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Mets', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gee, Dillon', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Duda, Lucas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Pirates', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-10T23:33:32+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/71e9f33e-01b5-5486-8bdd-57a63d7e8712', 'word_count': 843, 'uri': 'nyt://article/71e9f33e-01b5-5486-8bdd-57a63d7e8712'}, {'abstract': '“Fish Eye,” the Colt Coeur production at Here Arts Center, deals with a web of relationships, past and present.', 'web_url': 'https://www.nytimes.com/2011/06/11/theater/reviews/fish-eye-by-colt-coeur-at-here-arts-center-review.html', 'snippet': '“Fish Eye,” the Colt Coeur production at Here Arts Center, deals with a web of relationships, past and present.', 'lead_paragraph': 'There’s a certain nervous energy people often have when they’re with those they desire, especially when the relationship is not entirely secure. It’s a sort of performance energy, a directed one, and it isn’t all that different from the charge emanating from many a stage actor.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/arts/fish/fish-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/11/arts/fish/fish-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/arts/fish/fish-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/arts/fish/fish-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/11/arts/fish/fish-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Friends With Entanglements, Hoping for Benefits', 'kicker': "Theater Review | 'Fish Eye'", 'content_kicker': None, 'print_headline': 'Friends With Entanglements, Hoping for Benefits', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'HERE Arts Center', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-10T23:38:40+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Claudia La Rocco', 'person': [{'firstname': 'Claudia', 'middlename': None, 'lastname': 'La Rocco', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/96a7611b-c72f-5299-9dfe-03703631cfcd', 'word_count': 398, 'uri': 'nyt://article/96a7611b-c72f-5299-9dfe-03703631cfcd'}, {'abstract': 'Several people who were injured in the May 22 Joplin tornado have become sickened by an uncommon, deadly fungal infection, officials said.', 'web_url': 'https://www.nytimes.com/2011/06/11/us/11fungus.html', 'snippet': 'Several people who were injured in the May 22 Joplin tornado have become sickened by an uncommon, deadly fungal infection, officials said.', 'lead_paragraph': 'Several people who were injured when a tornado devastated Joplin, Mo., last month have become sickened by an uncommon, deadly fungal infection and at least three have died, although public health officials said Friday that a link between the infection and the deaths was not certain. ', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rare Infection Strikes Victims of a Tornado in Missouri', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rare Fungal Infection Sickens Several Victims of a Missouri Tornado', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fungi', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Joplin (Mo)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tornadoes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-10T23:41:17+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Timothy Williams', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b0b7b479-49c9-5c2f-8cbb-1df52fe2a91a', 'word_count': 554, 'uri': 'nyt://article/b0b7b479-49c9-5c2f-8cbb-1df52fe2a91a'}, {'abstract': 'Corn hit a record near $8 a bushel on Friday, on signs that global inventories would drop as bad weather slashes acreage in the United States.', 'web_url': 'https://www.nytimes.com/2011/06/11/business/11bizbriefs-CONCERNABOUT_BRF.html', 'snippet': 'Corn hit a record near $8 a bushel on Friday, on signs that global inventories would drop as bad weather slashes acreage in the United States.', 'lead_paragraph': 'Corn hit a record near $8 a bushel on Friday, on signs that global inventories would drop as bad weather slashes acreage in the United States, the world’s top producer, and demand rises for livestock feed and ethanol. Worldwide stockpiles will be 111.89 million metric tons before the 2012 harvest in the Northern Hemisphere, the Agriculture Department said Friday. That was down from 129.14 million forecast in May. Prices have more than doubled in the last year. ', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Concern About Stockpiles Pushes Corn to Record', 'kicker': 'Business Briefing | Agriculture', 'content_kicker': None, 'print_headline': 'Concern About Stockpiles Pushes Corn to Record', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Corn', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-10T23:41:25+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Bloomberg News', 'person': [{'firstname': 'Bloomberg', 'middlename': None, 'lastname': 'News', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/4504d587-3bde-5909-99ce-291166a379f5', 'word_count': 78, 'uri': 'nyt://article/4504d587-3bde-5909-99ce-291166a379f5'}, {'abstract': 'Fabrice Tourre, the Goldman Sachs trader accused of misleading investors, failed in his bid for a dismissal of a lawsuit by the Securities and Exchange Commission.', 'web_url': 'https://www.nytimes.com/2011/06/11/business/11bizbriefs-JUDGESAYSCAS_BRF.html', 'snippet': 'Fabrice Tourre, the Goldman Sachs trader accused of misleading investors, failed in his bid for a dismissal of a lawsuit by the Securities and Exchange Commission.', 'lead_paragraph': 'Fabrice Tourre, the Goldman Sachs trader accused of misleading investors, failed in his bid for a dismissal of a lawsuit by the Securities and Exchange Commission. While Judge Barbara Jones of United States District Court in Manhattan did narrow some of the claims in her decision on Friday, she said the S.E.C. had met its burden that Mr. Tourre had violated a law meant to prevent fraudulent sales of securities. The S.E.C. initially sued Mr. Tourre in April 2010, saying he had defrauded investors by not disclosing that the Paulson & Company hedge fund had helped pick the underlying securities for a collateralized debt obligation and planned to bet against them. Goldman and the S.E.C. agreed to a related $550 million settlement. ', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Judge Says Case Against Goldman Trader Will Proceed', 'kicker': 'Business Briefing | Legal News', 'content_kicker': None, 'print_headline': 'Judge Says Case Against Goldman Trader Will Proceed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tourre, Fabrice P', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Goldman Sachs Group Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Securities and Commodities Violations', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-10T23:42:24+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Bloomberg News', 'person': [{'firstname': 'Bloomberg', 'middlename': None, 'lastname': 'News', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/e85556e9-1450-5a85-b397-ba2d7c628b08', 'word_count': 124, 'uri': 'nyt://article/e85556e9-1450-5a85-b397-ba2d7c628b08'}, {'abstract': 'Conservative groups, gay rights groups and state lawmakers just cannot seem to stop talking about the rainbow flag at the Federal Reserve Bank in Richmond, Va.', 'web_url': 'https://www.nytimes.com/2011/06/11/us/11flag.html', 'snippet': 'Conservative groups, gay rights groups and state lawmakers just cannot seem to stop talking about the rainbow flag at the Federal Reserve Bank in Richmond, Va.', 'lead_paragraph': 'RICHMOND, Va. — The Federal Reserve Bank of Richmond ran a rainbow flag up its flagpole last week and has been hearing about it ever since. ', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/us/flag/flag-jumbo.jpg', 'height': 956, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type'