ywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Citigroup Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Embezzlement', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-28T00:30:28+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Eric Dash', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Dash', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f39dbc7-e3c3-5971-bf11-fee0b46e1b74', 'word_count': 816, 'uri': 'nyt://article/5f39dbc7-e3c3-5971-bf11-fee0b46e1b74'}, {'abstract': 'Jon Huntsman might have an easier time winning a general election than the nomination of his own party.', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/06/27/handicapping-huntsman/', 'snippet': 'Jon Huntsman might have an easier time winning a general election than the nomination of his own party.', 'lead_paragraph': 'When I ran for the office of secretary of my freshman class at the University of Pennsylvania in 1955, my campaign manager was Jon Huntsman, father of Jon Huntsman, Jr., the former governor of Utah, former Ambassador to China and current candidate for the Republican nomination for the presidency. (I won and found, happily, that the office carried with it almost no responsibilities.) ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Handicapping Huntsman', 'kicker': 'Stanley Fish', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hun