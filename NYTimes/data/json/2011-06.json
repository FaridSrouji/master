leLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/us/SHIPWRECK/SHIPWRECK-jumbo.jpg', 'height': 695, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/us/SHIPWRECK/SHIPWRECK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/03/us/SHIPWRECK/SHIPWRECK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Malibu Mystery, Washed in by the Tide', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Malibu Mystery, Washed in by the Tide', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Malibu (Calif)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Abandonment (Property)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sailboats and Sailing', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-03T00:06:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jennifer Medina', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Medina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e06206b7-17e9-5d67-b3d3-a79e880eeab4', 'word_count': 409, 'uri': 'nyt://article/e06206b7-17e9-5d67-b3d3-a79e880eeab4'}, {'abstract': 'Dermot Mulroney’s directorial debut, “Love, Wedding, Marriage,” stars Mandy Moore as a psychologist trying to save her parents’ marriage.', 'web_url': 'https://www.nytimes.com/2011/06/03/movies/love-wedding-marriage-review.html', 'snippet': 'Dermot Mulroney’s directorial debut, “Love, Wedding, Marriage,” stars Mandy Moore as a psychologist trying to save her parents’ marriage.', 'lead_paragraph': 'If there is a special hell for film critics, it probably has movies like “Love, Wedding, Marriage” on continuous rotation. A supposed romantic comedy with less romance — and significantly less comedy — than the instructions on a condom wrapper, this charmless clunker is the directing debut of the actor Dermot Mulroney. We can only hope that he isn’t planning to quit his day job.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/03love-span/03love-span-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/03/arts/03love-span/03love-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/03love-span/03love-span-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/03love-span/03love-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/03/arts/03love-span/03love-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Dos and Don’ts of ‘I Do’', 'kicker': None, 'content_kicker': None, 'print_headline': "Movie Review | 'Love, Wedding, Marriage'", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mulroney, Dermot', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Moore, Mandy', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-03T00:08:23+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7bb375cc-5b2d-571c-b959-ba5d45a26529', 'word_count': 336, 'uri': 'nyt://article/7bb375cc-5b2d-571c-b959-ba5d45a26529'}, {'abstract': 'What an Indiana soldier saw at the first battle of the Civil War.', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/06/02/captain-hannum-attends-the-philippi-races/', 'snippet': 'What an Indiana soldier saw at the first battle of the Civil War.', 'lead_paragraph': 'The sleepy hamlet of Philippi, nestled in the bucolic hills of western Virginia, awoke to bedlam on June 3, 1861. Early that morning, a federal force of about 3,000 in two columns converged on a camp of some 1,000 Confederates in what would be the first conventional engagement of the Civil War. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Captain Hannum Attends the Philippi Races', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Indiana', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'West Virginia', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-03T00:15:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ronald S. Coddington', 'person': [{'firstname': 'Ronald', 'middlename': 'S.', 'lastname': 'Coddington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f99e295c-b64f-535c-bdaf-d287c2e5293b', 'word_count': 1307, 'uri': 'nyt://article/f99e295c-b64f-535c-bdaf-d287c2e5293b'}, {'abstract': 'After tornadoes in Missouri and Alabama, Procter & Gamble provided Tide- and Duracell-branded trailers and crews for cleaning clothes and supplying batteries, flashlights and more to stricken areas.', 'web_url': 'https://www.nytimes.com/2011/06/03/business/media/03adco.html', 'snippet': 'After tornadoes in Missouri and Alabama, Procter & Gamble provided Tide- and Duracell-branded trailers and crews for cleaning clothes and supplying batteries, flashlights and more to stricken areas.', 'lead_paragraph': 'MANY companies have donated money and goods in the wake of the tornado that devastated Joplin, Mo., and left at least 138 people dead. But in addition to donating to disaster relief groups, Procter & Gamble, the consumer goods giant, is taking the unusual approach of providing disaster relief directly.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/business/Adco/Adco-articleLarge.jpg', 'height': 233, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/03/business/Adco/Adco-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 233}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/business/Adco/Adco-jumbo.jpg', 'height': 397, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/business/Adco/Adco-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/03/business/Adco/Adco-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Direct Approach to Disaster Relief From Procter & Gamble', 'kicker': 'Advertising', 'content_kicker': None, 'print_headline': 'A Direct Approach to Disaster Relief From Procter & Gamble', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Procter & Gamble Company', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Joplin (Mo)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Disasters and Emergencies', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Tornadoes', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-03T00:15:28+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Andrew Adam Newman', 'person': [{'firstname': 'Andrew', 'middlename': 'Adam', 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f9c21f1-dbcb-59a5-9399-9dc6ff21c7b1', 'word_count': 949, 'uri': 'nyt://article/3f9c21f1-dbcb-59a5-9399-9dc6ff21c7b1'}, {'abstract': 'The musicians Carrie Brownstein and James Mercer star in “Some Days Are Better Than Others,” as young people fighting losing battles against isolation.', 'web_url': 'https://www.nytimes.com/2011/06/03/movies/some-days-are-better-than-others-review.html', 'snippet': 'The musicians Carrie Brownstein and James Mercer star in “Some Days Are Better Than Others,” as young people fighting losing battles against isolation.', 'lead_paragraph': 'Fans of the guitarist-writer-actress Carrie Brownstein and her goofy television show, “Portlandia,” will need to adjust their expectations for “Some Days Are Better Than Others.” Starring Ms. Brownstein and another indie-music hero, James Mercer of the Shins, the film uses Portland and other Oregon locations (shot very prettily by Greg Schmitt) as a backdrop for neo-Depression anomie and darkly shaded melancholia.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/some-span/ROUNDUP-2-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/03/arts/some-span/ROUNDUP-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/some-span/ROUNDUP-2-jumbo.jpg', 'height': 666, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/some-span/ROUNDUP-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/03/arts/some-span/ROUNDUP-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Fighting Losing Battles Against Isolation', 'kicker': None, 'content_kicker': None, 'print_headline': "Movie Review | 'Some Days Are Better Than Others'", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brownstein, Carrie', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-03T00:18:00+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f9e7e27d-d348-5956-9462-4dab040212f2', 'word_count': 367, 'uri': 'nyt://article/f9e7e27d-d348-5956-9462-4dab040212f2'}, {'abstract': 'For his latest reinvention, Bernard Hopkins — street thug, convict, boxer, champion, retiree, champion again — wants to inspire aging athletes and spread the gospel of healthy living.', 'web_url': 'https://www.nytimes.com/2011/06/03/sports/surviving-the-bernard-hopkins-way.html', 'snippet': 'For his latest reinvention, Bernard Hopkins — street thug, convict, boxer, champion, retiree, champion again — wants to inspire aging athletes and spread the gospel of healthy living.', 'lead_paragraph': 'PHILADELPHIA — For his latest reinvention, Bernard Hopkins — street thug, convict, boxer, champion, retiree, champion again — wants to inspire aging athletes and spread the gospel of healthy living. Yes, that Bernard Hopkins. Once prisoner No. 44145.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/sports/HOPKINS/HOPKINS-articleLarge.jpg', 'height': 348, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/03/sports/HOPKINS/HOPKINS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 348}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/sports/HOPKINS/HOPKINS-jumbo.jpg', 'height': 621, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/sports/HOPKINS/HOPKINS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/03/sports/HOPKINS/HOPKINS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'At 46, Bernard Hopkins Keeps Surviving, His Way', 'kicker': None, 'content_kicker': None, 'print_headline': 'At 46, Bernard Hopkins Keeps Surviving, His Way', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Boxing', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hopkins, Bernard', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-03T00:23:37+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Greg Bishop', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f7db48e9-484f-5410-8321-b500489c0f9e', 'word_count': 1198, 'uri': 'nyt://article/f7db48e9-484f-5410-8321-b500489c0f9e'}, {'abstract': '“Empire of Silver,” Christina Yao’s melodrama, follows a powerful Chinese merchant family in the late 19th century.', 'web_url': 'https://www.nytimes.com/2011/06/03/movies/empire-of-silver-review.html', 'snippet': '“Empire of Silver,” Christina Yao’s melodrama, follows a powerful Chinese merchant family in the late 19th century.', 'lead_paragraph': 'As expensive looking as any film about money ought to be, the Taiwanese historical melodrama “Empire of Silver” is rather an odd duck. (And not just because yes, that is indeed Jennifer Tilly in a supporting role.) Hovering somewhere between dryly factual base-touching and sails-to-the-wind dynastic extravagance, this weirdly engaging tale of banking and bad behavior makes 19th-century China look uncomfortably like 21st-century America.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/empire-span/ROUNDUP-3-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/03/arts/empire-span/ROUNDUP-3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/empire-span/ROUNDUP-3-jumbo.jpg', 'height': 1024, 'width': 749, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/arts/empire-span/ROUNDUP-3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/03/arts/empire-span/ROUNDUP-3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Banking and Bad Behavior', 'kicker': None, 'content_kicker': None, 'print_headline': 'Movie Review | ‘Empire of Silver’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-03T00:26:17+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5a30f452-0256-5093-8e8e-9b97f54affad', 'word_count': 384, 'uri': 'nyt://article/5a30f452-0256-5093-8e8e-9b97f54affad'}, {'abstract': 'An analysis of Bay Area bicycle accident data from the California Highway Patrol found that young cyclists are at the highest risk.', 'web_url': 'https://www.nytimes.com/2011/06/03/us/03bcbike.html', 'snippet': 'An analysis of Bay Area bicycle accident data from the California Highway Patrol found that young cyclists are at the highest risk.', 'lead_paragraph': 'For the Sorensen family of Alameda, the sound of knuckles rapping on the garage door was a familiar annoyance. It was their 13-year-old son, Brandon, who knocked on the door so frequently to put away his bicycle that his parents finally got him an access code to open the garage on his own. ', 'print_section': 'A', 'print_page': '17A', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/us/03BCBIKES1/03BCBIKES1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/03/us/03BCBIKES1/03BCBIKES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/us/03BCBIKES1/03BCBIKES1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/03/us/03BCBIKES1/03BCBIKES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/03/us/03BCBIKES1/03BCBIKES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Bay Area, Youngsters Are More Prone to Bicycle Accidents', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Bay Area, Youngsters Are More Prone to Bicycle Accidents', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bicycles and Bicycling', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco Bay Area (Calif)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Traffic Accidents and Safety', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-03T00:27:30+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sydney Lupkin', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Lupkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/18139060-3c5b-5f7c-9c4f-f8324dab277f', 'word_count': 1256, 'uri': 'nyt://article/18139060-3c5b-5f7c-9c4f-f8324dab277f'}, {'abstract': 'James R. Doty, chairman of the Public Company Accounting Oversight Board, said the measure might be necessary for auditors to retain independence from their clients.', 'web_url': 'https://www.nytimes.com/2011/06/03/business/03audit.html', 'snippet': 'James R. Doty, chairman of the Public Company Accounting Oversight Board, said the measure might be necessary for auditors to retain independence from their clients.', 'lead_paragraph': 'Publicly traded companies may be forced to change their audit firms after several years, the chief regulator of the industry said Thursday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Companies May Face Rule to Shift Audit Firms', 'kicker': None, 'content_kicker': None, 'print_headline': 'Companies May Face Rule to Shift Audit Firms', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Public Company Accounting Oversight Board', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ACCOUNTING AND ACCOUNTANTS', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-03T00:27:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Floyd Norris', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1da34088-c385-5309-a5bc-4d11a9a7e86c', 'word_count': 640, 'uri': 'nyt://article/1da34088-c385-5309-a5bc-4d11a9a7e86c'}, {'abstract': 'A look at some recent dismal economic data shows the results of a pivot away from jobs to other concerns.', 'web_url': 'https://www.nytimes.com/2011/06/03/opinion/03krugman.html', 'snippet': 'A look at some recent dismal economic data shows the results of a pivot away from jobs to other concerns.', 'lead_paragraph': 'Earlier this week, the Federal Reserve Bank of New York published a blog post about the “mistake of 1937,” the premature fiscal and monetary pullback that aborted an ongoing economic recovery and prolonged the Great Depression. As Gauti Eggertsson, the post’s author (with whom I have done research) points out, economic conditions today — with output growing, some prices rising, but unemployment still very high — bear a strong resemblance to those in 1936-37. So are modern policy makers going to make the same mistake?', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'t