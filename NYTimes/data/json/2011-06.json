': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d07b1c6e-f926-575e-8fc0-811901eabe5a', 'word_count': 790, 'uri': 'nyt://article/d07b1c6e-f926-575e-8fc0-811901eabe5a'}, {'abstract': 'Debt collectors are well aware that they are not a sympathetic lot, but the industry trade association has begun a charm offensive.', 'web_url': 'https://www.nytimes.com/2011/06/13/business/13collect.html', 'snippet': 'Debt collectors are well aware that they are not a sympathetic lot, but the industry trade association has begun a charm offensive.', 'lead_paragraph': 'EDINA, Minn. — As a longtime debt collector, Lesllie Rogers has been routinely insulted, pummeled with obscenities, crudely propositioned and threatened with violence by the people she calls.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/13/business/JP-COLLECT/JP-COLLECT-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/13/business/JP-COLLECT/JP-COLLECT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/13/business/JP-COLLECT/JP-COLLECT-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/13/business/JP-COLLECT/JP-COLLECT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/13/business/JP-COLLECT/JP-COLLECT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Debt Collectors Ask to Be Paid a Little Resp