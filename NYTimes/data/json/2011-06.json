n/l01elite.html', 'snippet': 'Readers respond to an article about admissions policies of elite colleges.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/01/opinion/01lettersimg/01lettersimg-jumbo.jpg', 'height': 482, 'width': 379, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/01/opinion/01lettersimg/01lettersimg-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/01/opinion/01lettersimg/01lettersimg-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Elite Colleges and Economic Diversity', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'Elite Colleges and Economic Diversity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Private and Sectarian Schools', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADMISSIONS STANDARDS', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-01T00:04:24+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/add19041-e83d-5632-943d-157d6ab52dca', 'word_count': 833, 'uri': 'nyt://article/add19041-e83d-5632-943d-157d6ab52dca'}, {'abstract': 'Patrizia Arcuni-English talks about her son’s career, his critics and the need to focus. Have you been to a Todd English restaurant? Share your thoughts.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/05/31/and-now-a-moment-with-todd-englishs-mother/', 'snippet': 'Patrizia Arcuni-English talks about her son’s career, his critics and the need to focus. Have you been to a Todd English restaurant? Share your thoughts.', 'lead_paragraph': 'On a recent Sunday afternoon in SoHo, I found myself talking with Todd English’s mother. We were standing in a theater, waiting for a concert to begin. Mr. English, the chef, and his teenage son, Simon, were about to perform with a children’s music trio called Laughing Pizza. The matriarch of their family, Patrizia Arcuni-English, had come to watch. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'And Now, a Moment With Todd English’s Mother', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chefs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'English, Todd', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-01T00:07:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Jeff Gordinier', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Gordinier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/873175d7-d531-5777-a444-3d3ba1fdcc5d', 'word_count': 554, 'uri': 'nyt://article/873175d7-d531-5777-a444-3d3ba1fdcc5d'}, {'abstract': 'Fine places for beer in Manhattan and Brooklyn', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/05/31/a-look-at-taproom-no-307-and-thoughts-about-a-gravesend-saloon/', 'snippet': 'Fine places for beer in Manhattan and Brooklyn', 'lead_paragraph': '\xa0', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Look at Taproom No. 307, and Thoughts About a Gravesend Saloon', 'kicker': 'Diner&#