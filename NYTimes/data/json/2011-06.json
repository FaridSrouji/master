nk': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Poisoning and Poisons', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Butterflies and Moths', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-08T22:41:11+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Bob Tedeschi', 'person': [{'firstname': 'Bob', 'middlename': None, 'lastname': 'Tedeschi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd4a3eef-b01d-5a8b-88cf-97dbd51b2af9', 'word_count': 1448, 'uri': 'nyt://article/bd4a3eef-b01d-5a8b-88cf-97dbd51b2af9'}, {'abstract': 'The designer’s first New York store opens in the Flatiron district today, in a 4,000-square-foot space on 20th Street.', 'web_url': 'https://www.nytimes.com/2011/06/09/garden/ann-gish-now-making-her-bed-in-new-york.html', 'snippet': 'The designer’s first New York store opens in the Flatiron district today, in a 4,000-square-foot space on 20th Street.', 'lead_paragraph': 'Ann Gish’s first New York store opens in the Flatiron district today, in a 4,000-square-foot space on 20th Street.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09open/Currents-5-jumbo.jpg', 'height': 1024, 'width': 812, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09open/09open-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/garden/09open/09open-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Ann Gish, Now Making Her Bed in New York', 'kicker': 'Currents | Open', 'content_k