jor': 'N'}], 'pub_date': '2011-06-11T12:08:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/07e24f89-d1cd-565f-8b58-8146f45886e3', 'word_count': 12, 'uri': 'nyt://article/07e24f89-d1cd-565f-8b58-8146f45886e3'}, {'abstract': 'Josef Ackermann, chief executive of Europe’s largest bank, emerged from the 2008 financial crisis with deep influence on the Continent’s financial future.', 'web_url': 'https://www.nytimes.com/2011/06/12/business/12bank.html', 'snippet': 'Josef Ackermann, chief executive of Europe’s largest bank, emerged from the 2008 financial crisis with deep influence on the Continent’s financial future.', 'lead_paragraph': 'FRANKFURT', 'print_section': 'BU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/12/business/BANK-jp/BANK-jp-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/12/business/BANK-jp/BANK-jp-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/12/business/BANK-jp/BANK-jp-jumbo.jpg', 'height': 688, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/12/business/BANK-jp/BANK-jp-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/12/business/BANK-jp/BANK-jp-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Deutsche Bank’s Chief Casts Long Shadow in Europe', 'kicker': None, 'content_kicker': None, 'print_headline': 'Banker With A Long Shadow', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ACKERMANN, JOSEF', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Deutsche Bank AG', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'European Central Bank', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 9, 'major': 'N'}], 'pub_date': '2011-06-11T12:32:35+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Jack Ewing and Liz Alderman', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Ewing', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Liz', 'middlename': None, 'lastname': 'Alderman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0638c44f-4738-5fc6-a747-c7859faffd77', 'word_count': 2741, 'uri': 'nyt://article/0638c44f-4738-5fc6-a747-c7859faffd77'}, {'abstract': 'Horse racing is inherently rhythmic: it is hearts pulsing and hooves pounding, heads turning and hands moving, sweat dripping and legs tangling.', 'web_url': 'https://therail.blogs.nytimes.com/2011/06/11/dancing-with-the-stars-belmont-style/', 'snippet': 'Horse racing is inherently rhythmic: it is hearts pulsing and hooves pounding, heads turning and hands moving, sweat dripping and legs tangling.', 'lead_paragraph': 'Molly Jo Rosen has been involved with thoroughbred racing from coast to coast: from Churchill Downs to TVG to Smarty Jones’s personal assistant to managing a major New York racing operation. She now runs Community Communications at GradeOneRacing, finds future superstars at 2yoSales.com, and serves her blend of pony punditry on her blog, Focused Filly.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dancing With the Stars, Belmont Style', 'kicker': 'The Rail', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-11T13:01:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Molly Jo Rosen', 'person': [{'firstname': 'Molly', 'middlename': 'Jo', 'lastname': 'Rosen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/11f6efdb-b1b9-5e2b-9752-dafb9be18600', 'word_count': 525, 'uri': 'nyt://article/11f6efdb-b1b9-5e2b-9752-dafb9be18600'}, {'abstract': 'It works, but not on taxes.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/06/11/thoughts-on-voodoo/', 'snippet': 'It works, but not on taxes.', 'lead_paragraph': 'With Tim Pawlenty — who was supposed to be a sensible Republican — going all-in for high voodoo, I thought it’s worth pointing out that at the moment there’s a pretty good case that there is a kind of Laffer curve in which more is less and less is more. Namely, there’s a good case that fiscal stimulus right now would actually improve the long-run fiscal situation, while fiscal austerity makes it worse.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Thoughts on Voodoo', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-11T13:17:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80b9193f-e1ba-5ffb-988f-a192c2b0cd75', 'word_count': 568, 'uri': 'nyt://article/80b9193f-e1ba-5ffb-988f-a192c2b0cd75'}, {'abstract': 'The announcement that May was the deadliest month for civilians since 2007 came as a bombing left 15 civilians dead.', 'web_url': 'https://www.nytimes.com/2011/06/12/world/asia/12afghanistan.html', 'snippet': 'The announcement that May was the deadliest month for civilians since 2007 came as a bombing left 15 civilians dead.', 'lead_paragraph': 'KABUL, Afghanistan — The United Nations announced Saturday that May was the deadliest month for Afghan civilians since it began keeping count in 2007 — most likely a reflection of intense fighting, as militants seek to show they can stand up to the surge in American forces and try to undermine the government of President Hamid Karzai as it prepares to start taking over security. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/12/world/12afghanistan/12afghanistan-jumbo.jpg', 'height': 650, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/12/world/12afghanistan/12afghanistan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/12/world/12afghanistan/12afghanistan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Afghan Civilian Deaths Set a Monthly Record, U.N. Says', 'kicker': None, 'content_kicker': None, 'print_he