': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dba1f2c0-7ee7-5033-8f14-2b5aadd55cd2', 'word_count': 473, 'uri': 'nyt://article/dba1f2c0-7ee7-5033-8f14-2b5aadd55cd2'}, {'abstract': 'Careful about those Taylor rules.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/06/15/one-size-fits-one-redux-wonkish/', 'snippet': 'Careful about those Taylor rules.', 'lead_paragraph': 'The San Franciso Fed has a new letter (pdf) analyzing the dilemmas of eurozone monetary policy in terms of a Taylor rule. But it has a methodological problem that I think skews the results; doing it right would, I’d argue, look much less favorable for the ECB.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'One Size Fits One, Redux (Wonkish)', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-15T17:39:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c56110a-9842-56bc-91de-84c1033cb3f2', 'word_count': 257, 'uri': 'nyt://article/3c56110a-9842-56bc-91de-84c1033cb3f2'}, {'abstract': 'Marcella Caprario a 37-year-old opera singer faced an assault charge over a dispute that turned physical with another shopper at Trader Joe’s.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/06/15/accused-pad-thai-slapper-found-not-guilty/', 'snippet': 'Marcella Caprario a 37-year-old opera singer faced an assault charge over a dispute that turned physical with another shopper at Trader Joe’s.', 'lead_paragraph': 'The legal protection of self-defense, it seems, has been extended to noodle-related strife.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Accused Pad Thai Slapper Found Not Guilty', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Assaults', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Simpson, ShawnDya L', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Trader Joe's", 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-15T17:41:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff8715d3-853a-59ba-907e-8bcb0101a3d6', 'word_count': 361, 'uri': 'nyt://article/ff8715d3-853a-59ba-907e-8bcb0101a3d6'}, {'abstract': 'During a television interview with the Dalai Lama last week, Karl Stefanovic, the host of a morning news show in Australia, told the revered leader of Tibetan Buddhism, “I have a joke for you.” Next came the sound of one man laughing.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/06/15/how-not-to-tell-the-dalai-lama-a-joke/', 'snippet': 'During a television interview with the Dalai Lama last week, Karl Stefanovic, the host of a morning news show in Australia, told the revered leader of Tibetan Buddhism, “I have a joke for you.” Next came the sound of one man laughing.', 'lead_paragraph': 'During a television interview with the Dalai Lama last week, Karl Stefanovic, the host of a morning news show in Australia, told the revered leader of Tibetan Buddhists, “I have a joke for you, that my son told me, that he said you would laugh at, even though it’s about you.” What happened next, as the joke was haltingly translated, proved Mr. Stefanovic’s son quite wrong.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Not to Tell the Dalai Lama a Joke', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Dalai Lama', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-15T17:43:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aa5ba50f-7ddf-595c-acd8-50c3ec450ca9', 'word_count': 107, 'uri': 'nyt://article/aa5ba50f-7ddf-595c-acd8-50c3ec450ca9'}, {'abstract': 'Discussing the possible presidential campaign of Gov. Rick Perry of Texas, including insights from a reporter who has covered Mr. Perry for years.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/06/15/video-will-rick-perry-run/', 'snippet': 'Discussing the possible presidential campaign of Gov. Rick Perry of Texas, including insights from a reporter who has covered Mr. Perry for years.', 'lead_paragraph': 'Megan Liberman and Jeff Zeleny discuss the possible presidential campaign of Gov. Rick Perry of Texas. Also, a conversation with a reporter who has covered Mr. Perry for years.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video: Will Rick Perry Run?', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Governors (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-15T17:54:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ben Werschkul', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Werschkul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2fcc67d4-ef76-5034-88b9-51faf19c8825', 'word_count': 42, 'uri': 'nyt://article/2fcc67d4-ef76-5034-88b9-51faf19c8825'}, {'abstract': '“My vulnerability and fear brought a kind of red-faced rage forth from him, or maybe I was just the unwitting recipient and had no part in causing it, it was hard to tell.”', 'web_url': 'https://parenting.blogs.nytimes.com/2011/06/15/memories-of-a-fathers-rage/', 'snippet': '“My vulnerability and fear brought a kind of red-faced rage forth from him, or maybe I was just the unwitting recipient and had no part in causing it, it was hard to tell.”', 'lead_paragraph': 'Corbyn Hightower also remembers her father, and her memories are also mixed. We talk often about anger from a parent’s point of view here on Motherlode. In a guest post today, Ms. Hightower crawls back into how it felt to be the child who feared her father’s loss of control.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Memories of a Father’s Rage', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-15T17:58:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Lisa Belkin', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': 'Belkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/887e7ef8-d239-51c2-8eaa-b7aa067c91e7', 'word_count': 1300, 'uri': 'nyt://article/887e7ef8-d239-51c2-8eaa-b7aa067c91e7'}, {'abstract': 'The photographer Antony Crook sets a film about “hostility and isolation” in Ouarzazate, Morocco.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/06/15/fragmented-memories-morocco/', 'snippet': 'The photographer Antony Crook sets a film about “hostility and isolation” in Ouarzazate, Morocco.', 'lead_paragraph': 'For the fourth issue of the The Rig Out (out in two weeks), the photographer Antony Crook — a co-founder of the magazine — says he chose Ouarzazate, Morocco, as the backdrop for an editorial that explores abstract fragmented memories. “We were looking for the feeling of hostility and isolation,” he explains. This companion video offers a sneak peak into the story, styled by another co-founder, Glenn Kitson, and featuring utilitarian clothing by Woolrich Woolen Mills, Clarks Originals and Stone Island.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fragmented Memories | Morocco', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-15T18:00:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alex Tudela', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Tudela', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c4559290-710c-5b3c-b524-e0d9cb381194', 'word_count': 101, 'uri': 'nyt://article/c4559290-710c-5b3c-b524-e0d9cb381194'}, {'abstract': 'June 15, 2011 - Megan Liberman and Jeff Zeleny on the possible presidential campaign of Gov. Rick Perry of Texas. Also, a conversation with a reporter who has covered Mr. Perry for years.', 'web_url': 'https://www.nytimes.com/video/us/politics/1000000008