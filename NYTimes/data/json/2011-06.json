://article/207760cc-d326-5ca7-997e-ef5f587fddd9'}, {'abstract': '“The Thin Blue Line” told the story of how Mr. Adams was wrongly convicted of murder and put on death row.', 'web_url': 'https://www.nytimes.com/2011/06/26/us/26adams.html', 'snippet': '“The Thin Blue Line” told the story of how Mr. Adams was wrongly convicted of murder and put on death row.', 'lead_paragraph': 'Randall Dale Adams, who spent 12 years in prison before his conviction in the murder of a Dallas police officer was thrown out largely on the basis of evidence uncovered by a filmmaker, died in obscurity in October in Washington Court House, Ohio. He was 61.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/arts/dogADAMS-obit/dogADAMS-obit-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/arts/dogADAMS-obit/dogADAMS-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/26/arts/dogADAMS-obit/dogADAMS-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Randall Adams, 61, Dies; Freed With Help of Film', 'kicker': None, 'content_kicker': None, 'print_headline': 'Randall Adams, 61, Dies; Freed With Help of Film', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'False Arrests, Convictions and Imprisonments', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Morris, Errol', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 5,