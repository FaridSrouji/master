i': 'nyt://article/102ae106-710f-515c-8f33-ea165bead9bb'}, {'abstract': 'Top Democrats in the House intensified pressure on Representative Anthony D. Weiner to resign his Congressional seat on Sunday.', 'web_url': 'https://www.nytimes.com/2011/06/13/nyregion/despite-rehab-plan-more-calls-for-weiner-to-quit.html', 'snippet': 'Top Democrats in the House intensified pressure on Representative Anthony D. Weiner to resign his Congressional seat on Sunday.', 'lead_paragraph': 'WASHINGTON — A day after a spokeswoman for Representative Anthony D. Weiner said he was checking into a rehabilitation center, his aides on Sunday could not say what kind of treatment he was receiving or when he would be released.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/13/nyregion/WEINER/WEINER-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/13/nyregion/WEINER/WEINER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/13/nyregion/WEINER/WEINER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Despite Plan to Enter Rehab, Weiner Still Faces Calls to Resign', 'kicker': None, 'content_kicker': None, 'print_headline': 'Despite Plan to Enter Rehab, Weiner Still Faces Calls to Resign', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ethics (Institutional)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weiner, Anthony D', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 4, 'major': 'N'}], 'pu