ae-0ba6-5561-9f64-0340108c7015', 'word_count': 1109, 'uri': 'nyt://article/7037ebae-0ba6-5561-9f64-0340108c7015'}, {'abstract': 'June 20, 2011 - The Supreme Court throws out a class-action discrimination lawsuit against Wal-Mart, saying 1.5 million women could not unite their collective cases.', 'web_url': 'https://www.nytimes.com/video/multimedia/100000000873188/timescast--ruling-for-wal-mart.html', 'snippet': 'June 20, 2011 - The Supreme Court throws out a class-action discrimination lawsuit against Wal-Mart, saying 1.5 million women could not unite their collective cases.', 'lead_paragraph': 'June 20, 2011 - The Supreme Court throws out a class-action discrimination lawsuit against Wal-Mart, saying 1.5 million women could not unite their collective cases.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/20/multimedia/video-tc-110620-walmart/video-tc-110620-walmart-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/20/multimedia/video-tc-110620-walmart/video-tc-110620-walmart-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'TimesCast | Ruling for Wal-Mart', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Wal-Mart Stores Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-21T03:01:57+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'Zena Barakat|Ben Solomon|Vijai Singh|Ted Trautman', 'person': [{'firstname': 'Zena', 'middlename': 'Barakat', 'lastname': 'Ben', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/8e7852a1-6580-54c3-a9dc-9c78046633b6', 'word_count': 0, 'uri': 'nyt://video/8e7852a1-6580-54c3-a9dc-9c78046633b6'}, {'abstract': 'Under a new agreement, Ethiopian troops will take up positions in Abyei, straddling the internal north-south border.', 'web_url': 'https://www.nytimes.com/2011/06/21/world/africa/21abyei.html', 'snippet': 'Under a new agreement, Ethiopian troops will take up positions in Abyei, straddling the internal north-south border.', 'lead_paragraph': 'NAIROBI, Kenya — The Sudanese government has agreed to pull its troops out of the flashpoint Abyei area and allow Ethiopian peacekeepers to come in, the result of a deal signed Monday that could ease tensions along Sudan’s disputed north-south border.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sudan to Pull Troops From Abyei and Allow Peacekeepers', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sudan to Let Peacekeepers Patrol Area In Dispute', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'South Sudan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Abyei (Sudan)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-21T03:03:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Jeffrey Gettleman', 'person': [{'firstname': 'Jeffrey', 'middlename': None, 'lastname': 'Gettleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/622991e4-2126-575b-a20b-e04cc737a7ed', 'word_count': 454, 'uri': 'nyt://article/622991e4-2126-575b-a20b-e04cc737a7ed'}, {'abstract': 'Ethnic Nubans appear to be among the targets of northern forces in a restive region.', 'web_url': 'https://www.nytimes.com/2011/06/21/world/africa/21refugees.html', 'snippet': 'Ethnic Nubans appear to be among the targets of northern forces in a restive region.', 'lead_paragraph': 'PARIENG, Sudan — Underneath the wisp of shade he now calls home, Hamed El Bardi is a leader of a lost community. With more than 100 of his fellow Nubans huddled in the backyard of a county office in this southern Sudanese village, Mr. El Bardi tabulates newcomers and tries to figure out what to do next.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ethnic Killings by Army Reported in Sudanese Mountains', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ethnic Killings by Army Reported in Sudanese Mountains', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War and Guerrilla Warfare', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'South Sudan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Sudan', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-21T03:04:05+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Josh Kron', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Kron', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c4fff818-330a-59e8-9d9e-674ff10eca32', 'word_count': 633, 'uri': 'nyt://article/c4fff818-330a-59e8-9d9e-674ff10eca32'}, {'abstract': 'The suspect in the beating of a Giants fan at Dodger Stadium on opening day was sent back to prison on Monday because of a parole violation.', 'web_url': 'https://www.nytimes.com/2011/06/21/us/21brfs-California.html', 'snippet': 'The suspect in the beating of a Giants fan at Dodger Stadium on opening day was sent back to prison on Monday because of a parole violation.', 'lead_paragraph': 'The suspect in the beating of a Giants fan at Dodger Stadium on opening day was sent back to prison on Monday because of a parole violation. The parole board ordered Giovanni Ramirez, 31, suspected of being a gang member, to spend 10 months behind bars after the Los Angeles police found weapons in the home where he was living when he was arrested in the beating case on May 22. The parole revocation comes as the police have struggled to put together a case against Mr. Ramirez, who has been in custody since his arrest and remains the primary suspect but has not been charged. The parole board declined earlier this month to hold Mr. Ramirez on charges related to the beating for lack of evidence. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'California: Beating Suspect Jailed for Parole Violation', 'kicker': 'National Briefing | WEST', 'content_kicker': None, 'print_headline': 'California: Beating Suspect Jailed for Parole Violation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ramirez, Giovanni', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-21T03:05:19+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Ian Lovett', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Lovett', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/59556996-8d0a-5f42-a82e-326d9278e3e0', 'word_coun