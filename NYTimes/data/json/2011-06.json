-FLOOD-1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/25/us/JP-FLOOD-1/JP-FLOOD-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/us/JP-FLOOD-1/JP-FLOOD-1-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/us/JP-FLOOD-1/JP-FLOOD-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/25/us/JP-FLOOD-1/JP-FLOOD-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '2 by 2, or Not, Zoo Animals Escape Flood', 'kicker': None, 'content_kicker': None, 'print_headline': 'Zoo Animals Escape a Flood, But Not Precisely Two by Two', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Floods', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Minot (North Dakota)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Souris River', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Zoos', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ANIMALS', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-25T02:13:28+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By A. G. Sulzberger', 'person': [{'firstname': 'A.', 'middlename': 'G.', 'lastname': 'Sulzberger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90c3181f-5e93-5d15-a343-1388fa68cf14', 'word_count': 919, 'uri': 'nyt://article/90c3181f-5e93-5d15-a343-1388fa68cf14'}, {'abstract': 'At 81, James (Whitey) Bulger, under indictment for racketeering in connection with accusations of extortion, money laundering and 19 killings, faces prosecution in three states.', 'web_url': 'https://www.nytimes.com/2011/06/25/us/25legal.html', 'snippet': 'At 81, James (Whitey) Bulger, under indictment for racketeering in connection with accusations of extortion, money laundering and 19 killings, faces prosecution in three states.', 'lead_paragraph': 'James (Whitey) Bulger’s long flight back from Los Angeles to Boston on Friday was only the beginning of a much longer journey, a legal odyssey that is likely to keep him in court for years. Unless Mr. Bulger, who is 81, bypasses the long court process with plea deals, the trials themselves could be a death sentence. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/us/BULGER-2/BULGER-2-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/25/us/BULGER-2/BULGER-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/us/BULGER-2/BULGER-2-jumbo.jpg', 'height': 735, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/us/BULGER-2/BULGER-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/25/us/BULGER-2/BULGER-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Long Series of Trials Could Prove to Be Mobster’s Death Sentence', 'kicker': None, 'content_kicker': None, 'print_headline': 'Long Series of Trials Could Prove to Be Mobster’s Death Sentence', 'name'