nk': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/52a2a3e2-4978-5dfd-8d95-2df5fb061de0', 'word_count': 220, 'uri': 'nyt://article/52a2a3e2-4978-5dfd-8d95-2df5fb061de0'}, {'abstract': 'The journalist David Browne recounts the stories behind four famous rock albums made in 1970.', 'web_url': 'https://www.nytimes.com/2011/06/24/books/fire-and-rain-by-david-browne-book-review.html', 'snippet': 'The journalist David Browne recounts the stories behind four famous rock albums made in 1970.', 'lead_paragraph': 'The Beatles broke up, the Weathermen accidentally torched a Greenwich Village brownstone, and pop music went really soft. (Except when it didn’t.) That’s the tale, in a nutshell, told by “Fire and Rain: The Beatles, Simon & Garfunkel, James Taylor, CSNY, and the Lost Story of 1970,” which proposes to wrap together a year in the life of several loosely connected artists.', 'print_section': 'C', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/24/arts/BOOK-AUTHOR/BOOK-AUTHOR-jumbo.jpg', 'height': 973, 'width': 673, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/24/arts/BOOK-AUTHOR/BOOK-AUTHOR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/24/arts/BOOK-AUTHOR/BOOK-AUTHOR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Why 1970 Deserves Its 15 Minutes of Fame', 'kicker': "Books of The Times | 'Fire and Rain'", 'content_kicker': None, 'print_headline': 'Why 1970 Deserves Its 15 Minutes of Fame', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Browne, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Sev