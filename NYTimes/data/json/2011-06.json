e0e0d4-93c4-5ff5-9fec-f33216eaeacb'}, {'abstract': 'Sean Devlin, a stay-at-home dad, trash aficionado and writer, on celebrating the solitary life of picking up other people’s discards.', 'web_url': 'https://www.nytimes.com/2011/06/09/garden/the-king-of-the-trash-finders-ball-qa.html', 'snippet': 'Sean Devlin, a stay-at-home dad, trash aficionado and writer, on celebrating the solitary life of picking up other people’s discards.', 'lead_paragraph': 'A trash picker’s life can be an ignoble, even solitary one. It is rare that one woman says to another, “Lunch, and then a bit of Dumpster diving?” And many people remain shy about acknowledging that the source of that beautiful antique dining table was the town dump.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09qa/QA-2-jumbo.jpg', 'height': 1024, 'width': 706, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09qa/09qa-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/garden/09qa/09qa-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The King of the Trash Finder’s Ball', 'kicker': 'Currents | Q&A', 'content_kicker': None, 'print_headline': 'Giving Dumpster Divers Their Due', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Waste Materials and Disposal', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-08T22:41:10+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Joyce Wadler', 'person': [{'firstname': 'Joyce', 'middlename': None, 'lastname': 'Wadler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/5b96df42-1c04-503d-93b1-993bc55fa4a8', 'word_count': 915, 'uri': 'nyt://article/5b96df42-1c04-503d-93b1-993bc55fa4a8'}, {'abstract': 'Fab.com will offer daily online flash sales, with a focus on modern design.', 'web_url': 'https://www.nytimes.com/2011/06/09/garden/flash-sales-reach-the-design-world.html', 'snippet': 'Fab.com will offer daily online flash sales, with a focus on modern design.', 'lead_paragraph': 'There’s a new player in the world of online flash sales: Fab.com, a site with a focus on modern design that goes live today. The first week’s offerings include the Plumen light bulb, posters by Milton Glaser and items from Kid Robot, FontanaArte, Iittala and Eva Zeisel. (The Syrup collection by Objeti, pictured, will go on sale later in the month.)', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09online/Currents-6-jumbo.jpg', 'height': 1024, 'width': 864, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09online/09lighting-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/garden/09online/09lighting-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Flash Sales Reach the Design World', 'kicker': 'Currents | Online', 'content_kicker': None, 'print_headline': 'Flash Sales Reach the Design World', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'E-Commerce', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sales', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-08T22:41:10+0000', 'document_type': 'article'