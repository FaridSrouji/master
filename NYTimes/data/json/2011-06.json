 None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/028f0c93-a0d8-5d81-8043-fa436919f142', 'word_count': 447, 'uri': 'nyt://article/028f0c93-a0d8-5d81-8043-fa436919f142'}, {'abstract': 'The Supreme Court makes it harder and more expensive to seek class-action remedies.', 'web_url': 'https://www.nytimes.com/2011/06/21/opinion/21tue1.html', 'snippet': 'The Supreme Court makes it harder and more expensive to seek class-action remedies.', 'lead_paragraph': 'Wal-Mart Stores asked the Supreme Court to make a million or more of the company’s current and former female employees fend for themselves in individual lawsuits instead of seeking billions of dollars for discrimination in a class-action lawsuit. Wal-Mart got what it wanted from the court — unanimous dismissal of the suit as the plaintiffs presented it — and more from the five conservative justices, who went further in restricting class actions in general. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wal-Mart Wins. Workers Lose.', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Wal-Mart Wins. Workers Lose.: The Supreme Court makes it harder and more expensive to seek class-action remedies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Supreme Court', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Wal-Mart Stores Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-21T02:02:31+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/5a9afcc7-53ba-5bd9-8091-7a0ea38c5d1f', 'word_count': 462, 'uri': 'nyt://article/5a9afcc7-53ba-5bd9-8091-7a0ea38c5d1f'}, {'abstract': 'The gunman, later identified as Carl Lastorino, walked into Peter’s Tire and Rim Shop in East New York and began shooting.', 'web_url': 'https://www.nytimes.com/2011/06/21/nyregion/man-shot-in-brooklyn-auto-shop-police-kill-gunman.html', 'snippet': 'The gunman, later identified as Carl Lastorino, walked into Peter’s Tire and Rim Shop in East New York and began shooting.', 'lead_paragraph': 'A pair of police officers shot and killed a gunman on Monday minutes after he walked into a Brooklyn auto shop and opened fire on a man in an apparent feud, the police said. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Man Shot in Brooklyn Shop; Police Kill Gunman', 'kicker': None, 'content_kicker': None, 'print_headline': 'Man Shot in Brooklyn Shop; Police Kill Gunman', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'EAST NEW YORK (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-21T02:07:11+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joseph Goldstein', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'Goldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a6373830-2f27-5a09-916c-864a85f6a134', 'word_count': 301, 'uri': 'nyt://article/a6373830-2f27-5a09-916c-864a85f6a134'}, {'abstract': 'An appeals court in Santiago suspended the government’s approval process for the $3.2 billion plan to build five dams and hydroelectric plants in a pristine region of Patagonia.', 'web_url': 'https://www.nytimes.com/2011/06/21/world/americas/21chile.html', 'snippet': 'An appeals court in Santiago suspended the government’s approval process for the $3.2 billion plan to build five dams and hydroelectric plants in a pristine region of Patagonia.', 'lead_paragraph': 'A Chilean appeals court on Monday suspended a plan to build five dams and hydroelectric plants in the country’s Patagonia region.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chilean Court Blocks Plan for Patagonia Dam Project', 'kicker': None, 'content_kicker': None, 'print_headline': 'Chilean Court Blocks Plan For Patagonia Dam Project', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Chile', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hydroelectric Power', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Levees and Dams', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-21T02:08:22+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Alexei Barrionuevo', 'person': [{'firstname': 'Alexei', 'middlename': None, 'lastname': 'Barrionuevo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9385a936-6099-5977-804a-dbdf6e37e3ef', 'word_count': 388, 'uri': 'nyt://article/9385a936-6099-5977-804a-dbdf6e37e3ef'}, {'abstract': 'Too much time indoors can damage the eye’s development.', 'web_url': 'https://www.nytimes.com/2011/06/21/opinion/21wang.html', 'snippet': 'Too much time indoors can damage the eye’s development.', 'lead_paragraph': 'WHY is nearsightedness so common in the modern world? In the ea