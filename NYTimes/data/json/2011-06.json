/2011/06/09/garden/09shows/09walls-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/garden/09shows/09walls-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Colonial Revival Décor on Display', 'kicker': 'Currents | Shows', 'content_kicker': None, 'print_headline': 'Celebrating Colonial Revival Décor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Museum of the City of New York', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-08T22:41:11+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Bella Neyman', 'person': [{'firstname': 'Bella', 'middlename': None, 'lastname': 'Neyman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d49255e9-2595-532a-8e7f-df57e4a7f7b8', 'word_count': 125, 'uri': 'nyt://article/d49255e9-2595-532a-8e7f-df57e4a7f7b8'}, {'abstract': 'The Vault at Pfaff’s, a new subterranean lounge in NoHo, is named for the proprietor of a bohemian gathering place in the area 150 years ago.', 'web_url': 'https://www.nytimes.com/2011/06/09/garden/a-new-bar-with-a-nod-to-whitman.html', 'snippet': 'The Vault at Pfaff’s, a new subterranean lounge in NoHo, is named for the proprietor of a bohemian gathering place in the area 150 years ago.', 'lead_paragraph': 'The Vault at Pfaff’s, a new subterranean lounge in NoHo, is named after Charles Pfaff, the proprietor of a popular bohemian gathering place in the area 150 years ago. “Walt Whitman was said to be drinking and hanging out there,” said the interior designer Mark Zeff, who mined inspiration from the past for his design of the space. “He alluded to the place in one of his pieces.”', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09room-span/09room-span-articleLarge.jpg', 'height': 372, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/09/garden/09room-span/09room-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 372}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09room-span/Currents-2-jumbo.jpg', 'height': 763, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09room-span/09room-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/garden/09room-span/09room-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A New Bar, With a Nod to Whitman', 'kicker': 'Currents | Rooms', 'content_kicker': None, 'print_headline': 'A New Bar, With a Nod to Whitman', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bars', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-08T22:41:12+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/562349f5-8e4a-5217-b601-ddef376b8912', 'word_count': 153, 'uri': 'nyt://article/562349f5-8e4a-5217-b601-ddef376b8912'}, {'abstract': 'Ice needs to do more than chill a drink; it has to entertain, too. Eben Freeman, director of bar operations and innovation for Altamarea Group, went shopping for trays.', 'web_url': 'https://www.nytimes.com/2011/06/09/garden/ice-cube-trays-shopping-with-eben-freeman.html', 'snippet': 'Ice needs to do more than chill a drink; it has to entertain, too. Eben Freeman, director of bar operations and innovation for Altamarea Group, went shopping for trays.', 'lead_paragraph': 'VISIT any of the “proper” cocktail bars in New York and it is clear that the ice in one’s drink has become almost as important as the drink itself. The once humble cube of frozen water is now mentioned in terms usually associated with the other “ice” (cut, clarity and size) and is made into balls, cylindrical columns and squares of all sizes, sometimes even hand-carved.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09shopping/SHOP-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/garden/09shopping/09shopping-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/garden/09shopping/09shopping-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Ice Cube Trays', 'kicker': 'Shopping With Eben Freeman', 'content_kicker': None, 'print_headline': 'On the Rocks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ice', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-08T22:41:13+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 