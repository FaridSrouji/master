.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/19/nyregion/19DINENJ2/19DINENJ2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/nyregion/19DINENJ2/19DINENJ2-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/nyregion/19DINENJ2/19DINENJ2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/19/nyregion/19DINENJ2/19DINENJ2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Organic Blueberries Don’t Come Easily', 'kicker': 'New Jersey Dining | From the Farm', 'content_kicker': None, 'print_headline': 'Organic Blueberries Don’t Come Easily', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Farmers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Organic Food', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-18T02:12:06+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Tammy La Gorce', 'person': [{'firstname': 'Tammy', 'middlename': None, 'lastname': 'La Gorce', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8aa0614f-12ba-5088-bb51-f1aa4cb3c45b', 'word_count': 913, 'uri': 'nyt://article/8aa0614f-12ba-5088-bb51-f1aa4cb3c45b'}, {'abstract': 'With sand, seawater, suntan lotion, melting ice cream and who knows what else blowing by, can you actually read while relaxing seaside?', 'web_url': 'https://www.nytimes.com/2011/06/18/opinion/18sat4.html', 'snippet': 'With sand, seawater, suntan lotion, melting ice cream and who knows what else blowing by, can you actually read while relaxing seaside?', 'lead_paragraph': 'Beach season is upon us, which means that lists of summer beach reading have begun to appear. They include books that are fat and credential-building, books that are fat and breezy, and books that Bertie Wooster would be reading if he were going to the South of France. The lists lead to an important question. Can you actually read at the beach? Or do you merely hold a book before your face as a blind for better beach-watching? ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Book at the Beach', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Book at the Beach', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beaches', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-18T02:13:38+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/3a83d30a-44fb-528a-8069-48902402a7de', 'word_count': 292, 'uri': 'nyt://article/3a83d30a-44fb-528a-8069-48902402a7de'}, {'abstract': 'Damage control may be the best outcome to hope for in the negotiations between the White House and Republicans.', 'web_url': 'https://www.nytimes.com/2011/06/18/opinion/18sat1.html', 'snippet': 'Damage control may be the best outcome to hope for in the negotiations between the White House and Republicans.', 'lead_paragraph': 'The White House has said not to expect any back-nine breakthroughs on the debt limit when President Obama and the House speaker, John Boehner, get together for a game of golf on Saturday. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Debt Limit Endgame', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Debt Limit Endgame: We fear that damage control may be the best outcome to hope for', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'National Debt (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-06-18T02:14:15+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/eb20693b-5520-5d90-bc88-2fc79103663f', 'word_count': 553, 'uri': 'nyt://article/eb20693b-5520-5d90-bc88-2fc79103663f'}, {'abstract': 'Corrections appearing in print, June 18, 2011.', 'web_url': 'https://www.nytimes.com/2011/06/18/pageoneplus/corrections.html', 'snippet': 'Corrections appearing in print, June 18, 2011.', 'lead_paragraph': 'NEW YORK', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-18T02:16:16+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/bcea9c31-01c1-5e0e-b3c2-b07b96569a1c', 'word_count': 711, 'uri': 'nyt://article/bcea9c31-01c1-5e0e-b3c2-b07b96569a1c'}, {'abstract': 'Regardless of how damaged the relationship, it’s always possible for a father to leave a stamp of love — no matter how small or seemingly inconsequential — on his child.', 'web_url': 'https://www.nytimes.com/2011/06/18/opinion/18blow.html', 'snippet': 'Regardless of how damaged the relationship, it’s always possible for a father to leave a stamp of love — no matter how small or seemingly inconsequential — on his child.', 'lead_paragraph': 'Occasionally, without warning, the drunken wreckage of my father would wash up on our doorstep, late at night, stammering, laughing, reeking of booze.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Remembrances of My Father', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Remembrances of My Father', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Love (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': "Father's Day", 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-18T02:20:55+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Charles M. Blow', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9317498c-e036-5ce9-86e1-0b2634f83076', 'word_count': 1264, 'uri': 'nyt://article/9317498c-e036-5ce9-86e1-0b2634f83076'}, {'abstract': 'Because of ideological opposition and other priorities, Arizona has not made the one-word change necessary to keep the federally financed benefits going.', 'web_url': 'https://www.nytimes.com/2011/06/18/business/18benefits.html', 'snippet': 'Because of ideological opposition and other priorities, Arizona has not made the one-word change necessary to keep the federally financed benefits going.', 'lead_paragraph': 'One word, just one little word.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/business/Benefits/Benefits-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/18/business/Benefits/Benefits-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/business/Benefits/Benefits-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/business/Benefits/Benefits-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/18/business/Benefits/Benefits-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For Want of a Word, Arizona’s Jobless Lose Checks', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Want of One-Word Tweak, Arizona Jobless Lose Benefits', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Unemployment Insurance', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ALASKA', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Aid (US)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ARIZONA', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-06-18T02:24:54+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Catherine Rampell', 'person': [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Rampell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/abac28f6-5b77-5ae8-9a73-ff8f469655c6', 'word_count': 1121, 'uri': 'nyt://article/abac28f6-5b77-5ae8-9a73-ff8f469655c6'}, {'abstract': 'Reporting by David Protess and his students has had a part in freeing more than 10 wrongly convicted men from prison — five of them from death row.', 'web_url': 'https://www.nytimes.com/2011/06/18/business/media/18innocence.html', 'snippet': 'Reporting by David Protess and his students has had a part in freeing more than 10 wrongly convicted men from prison — five of them from death row.', 'lead_paragraph': 'Reporting by David Protess and his students, both before and after his time at the Medill Innocence Project, has had a part in freeing more than 10 wrongly convicted men from prison — five of them from death row.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Freed by a Journalism Professor and His Students', 'kicker': None, 'content_kicker': None, 'print_headline': 'Freed by a Journalism Professor and His Students', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'False Arrests, Convictions and Imprisonments', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Protess, David', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-18T02:25:42+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By John Schwartz', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/97c5ab8e-6694-5978-96b3-c2c23e0543f5', 'word_count': 323, 'uri': 'nyt://article/97c5ab8e-6694-5978-96b3-c2c23e0543f5'}, {'abstract': 'David Protess made a name for himself as the Innocence Project he led exonerated a dozen wrongly convicted defendants. Then he locked horns with a prosecutor.', 'web_url': 'https://www.nytimes.com/2011/06/18/business/media/18protess.html', 'snippet': 'David Protess made a name for himself as the Innocence Project he led exonerated a dozen wrongly convicted defendants. Then he locked horns with a prosecutor.', 'lead_paragraph': 'For the last two years, David Protess, a renowned journalist and professor who spent three decades fighting to prove the innocence of others, has been locked in a battle to do the same for himself. It hasn’t gone as well.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/us/JP-PROTESS/JP-PROTESS-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/18/us/JP-PROTESS/JP-PROTESS-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/us/JP-PROTESS/JP-PROTESS-jumbo-v2.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/us/JP-PROTESS/JP-PROTESS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/18/us/JP-PROTESS/JP-PROTESS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Watchdog Professor, Now Defending Himself', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Watchdog Professor, Now Defending Himself', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McKinney, Anthony', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Innocence Project', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Northwestern University', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'False Arrests, Convictions and Imprisonments', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Capital Punishment', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Journalism Schools', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Protess, David', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Cook County (Ill)', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-06-18T02:25:47+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By David Carr and John Schwartz', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Carr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'John', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4eb062f-13e1-57e0-a31b-7d1e0ceded81', 'word_count': 1842, 'uri': 'nyt://article/d4eb062f-13e1-57e0-a31b-7d1e0ceded81'}, {'abstract': 'Several dozen women drove in major cities of Saudi Arabia on Friday as part of a protest against a longstanding ban.', 'web_url': 'https://www.nytimes.com/2011/06/18/world/middleeast/18saudi.html', 'snippet': 'Several dozen women drove in major cities of Saudi Arabia on Friday as part of a protest against a longstanding ban.', 'lead_paragraph': 'CAIRO — Several dozen women drove in defiance of the law in major cities of Saudi Arabia on Friday, according to reports on social media and by an informal network of activists in the country. There appeared to be few confrontations reported with either the traffic