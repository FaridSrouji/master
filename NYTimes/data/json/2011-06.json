tions', 'value': 'Goldman Sachs Group Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Morgan Stanley', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-17T13:42:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Mac William Bishop, Susanne Craig and Adrienne Carter', 'person': [{'firstname': 'Mac', 'middlename': 'William', 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Susanne', 'middlename': None, 'lastname': 'Craig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Adrienne', 'middlename': None, 'lastname': 'Carter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/57025b00-9492-5460-be0e-fcff52521a46', 'word_count': 70, 'uri': 'nyt://article/57025b00-9492-5460-be0e-fcff52521a46'}, {'abstract': 'Sony Pictures Classics said Thursday that it planned to increase the number of theaters showing Woody Allen’s new time-traveling comedy “Midnight in Paris,” to 1,038 screens, the widest release of any of Mr. Allen’s films.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/17/woody-gets-his-biggest-roll-out/', 'snippet': 'Sony Pictures Classics said Thursday that it planned to increase the number of theaters showing Woody Allen’s new time-traveling comedy “Midnight in Paris,” to 1,038 screens, the widest release of any of Mr. Allen’s films.', 'lead_paragraph': 'Woody is going wide. Sony Pictures Classics said Thursday that it planned to increase the number of theaters showing Woody Allen’s new time-traveling comedy “Midnight in Paris,” to 1,038 screens, the widest release of any of Mr. Allen’s films. “Midnight in Paris,” which has been well-received by critics, has earned more than $16 million in the United States and more than $18.3 million overseas, where in recent years Mr. Allen has found a much bigger audience than he enjoys at home. (His last critically successful film, “Vicky Christina Barcelona,” earned $23.2 million in the United States and $73.2 million internationally, according to boxofficemojo.com.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Woody Allen Gets His Biggest Roll-Out', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'ALLEN, WOODY', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-17T13:55:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Randy Kennedy', 'person': [{'firstname': 'Randy', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/644957d3-2416-5d9b-909b-ac10103709f0', 'word_count': 198, 'uri': 'nyt://article/644957d3-2416-5d9b-909b-ac10103709f0'}, {'abstract': 'Highlights from the DealBook newsletter.', 'web_url': 'https://dealbook.nytimes.com/2011/06/17/morning-take-out-267/', 'snippet': 'Highlights from the DealBook newsletter.', 'lead_paragraph': 'Wall Street Braces for New Layoffs as Profits Wane \xa0|\xa0 Wall Street plans to get smaller this summer. Faced with weak markets and uncertainty over regulations, many of the biggest firms are preparing for deep cuts in jobs and other costs.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Take-Out', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-17T13:58:50+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9829221e-5449-503f-9941-34b13823f756', 'word_count': 2064, 'uri': 'nyt://article/9829221e-5449-503f-9941-34b13823f756'}, {'abstract': 'Though their boss has stepped down, Mr. Weiner’s Congressional staff will keep working, at least until someone else is elected to fill his seat.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/06/17/weiner-is-gone-but-his-staff-will-hold-the-fort/', 'snippet': 'Though their boss has stepped down, Mr. Weiner’s Congressional staff will keep working, at least until someone else is elected to fill his seat.', 'lead_paragraph': 'When Representative Anthony D. Weiner announced his resignation from Congress on Thursday at a center for the elderly in Sheepshead Bay, Brooklyn, where he had started his first campaign for City Council 20 years earlier, his Washington office sat locked and shuttered. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Weiner Is Gone, but His Staff Will Hold the Fort', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ethics (Institutional)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suspensions, Dismissals and Resignations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Weiner, Anthony D', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-17T14:00:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Ashley Parker', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92a5afb1-b2bb-5247-b868-9ff1be0f66cb', 'word_count': 585, 'uri': 'nyt://article/92a5afb1-b2bb-5247-b868-9ff1be0f66cb'}, {'abstract': 'The swimwear collections make us lustful for these no-fuss, color-blocked geometric maillots right now — we don’t want to wait for winter holiday.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/06/17/wear-resort-now-scuba-suits/', 'snippet': 'The swimwear collections make us lustful for these no-fuss, color-blocked geometric maillots right now — we don’t want to wait for winter holiday.', 'lead_paragraph': 'Resort’s must-have swimwear makes us lustful for no-fuss, color-blocked geometric maillots right now — even though we know we’re supposed to wait for winter holiday. In fact, resort was swimming in surf wear. Michael Kors, Chanel and Jason Wu, to name a few, showed scuba-styled, wet-suit-inspired pieces, while Burberry Prorsum, Zero Maria Cornejo, Preen and Juan Carlos Obando took advantage of neoprene accents and neon colors. And how we adored Lisa Marie Fernandez’s front-zipper dive-suit bikini, which left us panting for flippers. But wait! We can dip our toes in right now (see below).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wear Resort Now | Scuba Suits', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-17T14:00:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Chelsea Zalopany', 'person': [{'firstname': 'Chelsea', 'middlename': None, 'lastname': 'Zalopany', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cbb45140-6681-51ac-9d1e-40dd6a41d0b8', 'word_count': 100, 'uri': 'nyt://article/cbb45140-6681-51ac-9d1e-40dd6a41d0b8'}, {'abstract': 'In the second round on Friday, Rory McIlroy reached an astonishing 13 under par, finishing at 11 under.', 'web_url': 'https://www.nytimes.com/2011/06/18/sports/golf/2011-us-open-mcilroy-charges-to-a-commanding-lead-on-day-2.html', 'snippet': 'In the second round on Friday, Rory McIlroy reached an astonishing 13 under par, finishing at 11 under.', 'lead_paragraph': 'BETHESDA, Md. — Through 35 holes of the 111th United States Open, Rory McIlroy was in a zone of his own, scorching Congressional Country Club with birdies — almost at will — and strutting as close to perfection as any golfer has during this annual survival test.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/sports/GOLF2/GOLF2-jumbo.jpg', 'height': 691, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/18/sports/GOLF2/GOLF2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/18/sports/GOLF2/GOLF2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'McIlroy Runs Away With the Lead', 'kicker': 'U.S. Open', 'content_kicker': None, 'print_headline': 'Making the Open Look Easy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McIlroy, Rory', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Golf)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Congressional Country Club', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-17T14:17:51+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Larry Dorman', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Dorman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c75a0352-67fc-501b-973a-be978d390dd9', 'word_count': 1125, 'uri': 'nyt://article/c75a0352-67fc-501b-973a-be978d390dd9'}, {'abstract': 'Quicksilver, a period-instrument sextet, took the stage at Emmanuel Church in Boston to play a program of vigorous, texturally rich sonatas from the dawn of the Baroque era.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/17/early-music-festival-quicksilver-at-night/', 'snippet': 'Quicksilver, a period-instrument sextet, took the stage at Emmanuel Church in Boston to play a program of vigorous, texturally rich sonatas from the dawn of the Baroque era.', 'lead_paragraph': 'BOSTON — Talk about musicians who work hard for the love of it: at 11:30 on Wednesday night, Quicksilver, a period-instrument sextet, took the stage at Emmanuel Church to play a program of vigorous, texturally rich sonatas from the dawn of the Baroque era. The lateness of the hour was not so unusual: the Boston Early Music Festival, which presented the concert, has always offered late- night performances, and the concept has taken root elsewhere too (at Lincoln Center, for example, which has offered refreshing late performances, particularly after Mostly Mozart concerts, in recent years). ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Early Music Festival: Quicksilver at Night', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Morris, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stein, Avi', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Camerata', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Boston (Mass)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-17T14:20:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96d6df41-fe7a-57a8-ae55-397afc9303fd', 'word_count': 554, 'uri': 'nyt://article/96d6df41-fe7a-57a8-ae55-397afc9303fd'}, {'abstract': 'A collection of links by the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/06/17/what-were-reading-206/', 'snippet': 'A collection of links by the reporters and editors of the Dining section.', 'lead_paragraph': 'A collection of links by the reporters and editors of the Dining section.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-17T14:22:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/eeecb37b-0146-56cc-975b-ee4d6c3faad1', 'word_count': 407, 'uri': 'nyt://article/eeecb37b-0146-56cc-975b-ee4d6c3faad1'}, {'abstract': 'China is increasing is maritime surveillance force to 15,000 people by 2020, up from 9,000 now, a report says.', 'web_url': 'https://www.nytimes.com/2011/06/18/world/asia/chinabrief.html', 'snippet': 'China is increasing is maritime surveillance force to 15,000 people by 2020, up from 9,000 now, a report says.', 'lead_paragraph': 'China is increasing its maritime surveillance force to 15,000 people by 2020, up from 9,000 now, according to a report on Friday in China Daily, an English-language newspaper. By 2015, the aviation branch of the force, which is officially civilian in nature and operates under the State Ocean Administration, will have 16 aircraft; the sea patrol fleet will have 350 vessels by then, and 520 by 2020, the report said.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'China: Maritime Patrols on the Rise', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ships and Shipping', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-17T14:33:17+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Edward Wong', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/6095ac8b-6019-5107-b0d3-9c43519e7416', 'word_count': 158, 'uri': 'nyt://article/6095ac8b-6019-5107-b0d3-9c43519e7416'}, {'abstract': 'The sports-car manufacturer said the condition affected its fastest 911 models, including the GT2 RS, Turbo S and GT3 RS.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/06/17/high-horsepower-porsche-911s-recalled-for-premature-wear-of-wheel-hubs/', 'snippet': 'The sports-car manufacturer said the condition affected its fastest 911 models, including the GT2 RS, Turbo S and GT3 RS.', 'lead_paragraph': 'Porsche is recalling about 1,700 of its most powerful 911s from 2010-11 because wheel hubs may wear prematurely, resulting in a compromised wheel-retention system that could lead to a crash, the automaker told the National Highway Traffic Safety Administration.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'High-Horsepower Porsche 911s Recalled for Premature Wear of Wheel Hubs', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Chrysler LLC', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Honda Motor Co Ltd', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Highway Traffic Safety Administration', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Porsche AG', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Volvo Car Corp', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-17T14:36:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Christopher Jensen', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/edbe8647-0249-5aa7-82cb-6d6246942c2b', 'word_count': 547, 'uri': 'nyt://article/edbe8647-0249-5aa7-82cb-6d6246942c2b'}, {'abstract': 'Mr. Ball, the “True Blood” creator and producer, talks about the coming season of the show, its themes of sexuality and why he filmed a scene for the series in 3-D.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/17/hes-created-a-monster-alan-ball-talks-true-blood/', 'snippet': 'Mr. Ball, the “True Blood” creator and producer, talks about the coming season of the show, its themes of sexuality and why he filmed a scene for the series in 3-D.', 'lead_paragraph': 'As anticipation grows for the June 26 season premiere of “True Blood” on HBO, an article in this weekend’s