ultimedia': [], 'headline': {'main': 'June 22, 1940 | Hitler Gains Victory Over France', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-22T14:30:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By The Learning Network', 'person': [], 'organization': 'The Learning Network'}, 'type_of_material': 'News', '_id': 'nyt://article/92372988-d7b9-548f-940c-f37c85191899', 'word_count': 539, 'uri': 'nyt://article/92372988-d7b9-548f-940c-f37c85191899'}, {'abstract': 'The Philadelphia Orchestra announced that it had drummed up $27.5 million in pledges and donations as part of its search for financial stability.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/22/financially-troubled-philadelphia-orchestra-finds-new-support/', 'snippet': 'The Philadelphia Orchestra announced that it had drummed up $27.5 million in pledges and donations as part of its search for financial stability.', 'lead_paragraph': 'The Philadelphia Orchestra, which in April filed for protection under Chapter 11 of the bankruptcy laws, said on Wednesday it has drummed up $27.5 million in pledges and donations as part of its search for financial stability. Most of the money — $16.3 million – came in the form of challenge grants that must be met by the end of the year. Gifts and promised gifts came from several local foundations and members of the orchestra’s board. The donors include the William Penn Foundation, Wyncote Foundation and Neubauer Family Foundation, the orchestra said.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Financially Troubled Philadelphia Orchestra Finds New Support', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-22T14:33:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name'