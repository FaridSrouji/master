 None, 'type': 'image', 'url': 'images/2011/07/03/realestate/Hunt4/Hunt4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/03/realestate/Hunt4/Hunt4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Greenwood Heights, a Place to Stay Put', 'kicker': 'The Hunt', 'content_kicker': None, 'print_headline': 'A Place for the Foreseeable Future', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Housing and Real Estate', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-30T21:45:23+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Joyce Cohen', 'person': [{'firstname': 'Joyce', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44e51f21-92ae-5f18-bfd6-922f097a52f1', 'word_count': 1108, 'uri': 'nyt://article/44e51f21-92ae-5f18-bfd6-922f097a52f1'}, {'abstract': 'Photographs of the atomic devastation at Hiroshima and Nagasaki, on exhibit at the International Center of Photography, were originally classified government documents.', 'web_url': 'https://www.nytimes.com/2011/07/01/arts/design/atomic-bombs-captured-in-photo-exhibitions-review.html', 'snippet': 'Photographs of the atomic devastation at Hiroshima and Nagasaki, on exhibit at the International Center of Photography, were originally classified government documents.', 'lead_paragraph': 'The mushroom cloud is one of those images that’s hard to process without resorting to abstractions. In our minds this symbol of nuclear Armageddon has somehow become detached from the weapon’s deadly efficacy.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/ATOMIC/ATOMIC-jumbo.jpg', 'height': 855, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/ATOMIC/ATOMIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/01/arts/ATOMIC/ATOMIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Hiroshima and Nagasaki in Black and White', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Hiroshima and Nagasaki in Black and White', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Hiroshima (Japan)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Nagasaki (Japan)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'International Center of Photography', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-30T21:47:59+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Karen Rosenberg', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1424347b-8fec-5c4d-916e-12ff95dc9f71', 'word_count': 726, 'uri': 'nyt://article/1424347b-8fec-5c4d-916e-12ff95dc9f71'}, {'abstract': 'In “The Perfect Host,” David Hyde Pierce plays a gentleman whose elegant dinner party is hijacked by a bank robber.', 'web_url': 'https://www.nytimes.com/2011/07/01/movies/david-hyde-pierce-in-thriller-the-perfect-host-review.html', 'snippet': 'In “The Perfect Host,” David Hyde Pierce plays a gentleman whose elegant dinner party is hijacked by a bank robber.', 'lead_paragraph': 'Warwick Wilson, the prim, dapper title character of “The Perfect Host,” played by David Hyde Pierce, seems at first to be a clone of Waldo Lydecker, the snobbish newspaper columnist of Otto Preminger’s film-noir classic “Laura.” As Warwick jousts with John Taylor (Clayne Crawford), a scruffy bank robber on the lam who talks his way into Warwick’s immaculate Los Angeles lair, you expect an insidious tug of war between an aesthete and a roughneck, similar to the power struggle of Clifton Webb’s imperious dandy and Dana Andrews’s earthy detective in “Laura.”', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/PERFECT-span/PERFECT-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/01/arts/PERFECT-span/PERFECT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/PERFECT-span/PERFECT-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/PERFECT-span/PERFECT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/01/arts/PERFECT-span/PERFECT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Welcome to His World Is Accepted at Your Peril', 'kicker': "Movie Review | 'The Perfect Host'", 'content_kicker': None, 'print_headline': 'A Welcome to His World Is Accepted at Your Peril', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name':