/sports/yGOLF/yGOLF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/30/sports/yGOLF/yGOLF-jumbo.jpg', 'height': 1024, 'width': 960, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/30/sports/yGOLF/yGOLF-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/30/sports/yGOLF/yGOLF-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Ups and Downs of Life After Transplants', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Ups and Downs Of Life After Transplants', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Professional Golfers Assn', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Heart', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Transplants', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Compton, Erik', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-30T00:51:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Larry Dorman', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Dorman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2a8748d-cc52-5203-988d-914b48ad0088', 'word_count': 848, 'uri': 'nyt://article/c2a8748d-cc52-5203-988d-914b48ad0088'}, {'abstract': 'Saturday evening in the Hamptons began at a benefit for the Group for the East End; it ended at a restaurant where Alec Baldwin served Nocturnalist sea bass.', 'web_url': 'https://www.nyt