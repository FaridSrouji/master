ew York Times', 'multimedia': [], 'headline': {'main': 'Urban Forager: An Irresistible Berry (Within Limits)', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fruit', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parks and Other Recreation Areas', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Trees and Shrubs', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-25T13:15:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Ava Chin', 'person': [{'firstname': 'Ava', 'middlename': None, 'lastname': 'Chin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b474e701-c1c3-5668-9c13-93914c8cdeda', 'word_count': 521, 'uri': 'nyt://article/b474e701-c1c3-5668-9c13-93914c8cdeda'}, {'abstract': 'Scenes from the Paris Fashion Week photo diary of Sonny Vandevelde.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/06/25/photos-of-the-moment-givenchy-3/', 'snippet': 'Scenes from the Paris Fashion Week photo diary of Sonny Vandevelde.', 'lead_paragraph': ' NYTD.fullScreenSlideShowFactory.createSlideshow("#797", 592, 490, true, chameleonData);', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photos of the Moment | Givenchy', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-25T13:30:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Sonny Vandevelde', 'person': [{'firstname': 'Sonny', 'middlename': None, 'lastname': 'Vandevelde', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/854c720e-ced9-58f2-8c26-d5fd