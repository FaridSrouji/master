een’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Great Britain', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Energy Efficiency', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Alternative and Renewable Energy', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Energy Department', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-08T19:50:55+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Elisabeth Rosenthal', 'person': [{'firstname': 'Elisabeth', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4d24072e-d405-512d-940e-a8a753ef5424', 'word_count': 1359, 'uri': 'nyt://article/4d24072e-d405-512d-940e-a8a753ef5424'}, {'abstract': 'A plan to raise money through crowdsourcing online to buy the maker of Pabst Blue Ribbon fizzed out after the S.E.C. declared that it violated securities laws.', 'web_url': 'https://dealbook.nytimes.com/2011/06/08/s-e-c-thwarts-would-be-buyers-of-pabst-beer/', 'snippet': 'A plan to raise money through crowdsourcing online to buy the maker of Pabst Blue Ribbon fizzed out after the S.E.C. declared that it violated securities laws.', 'lead_paragraph': 'An effort to buy the maker of the oft-ironically enjoyed Pabst Blue Ribbon beer has fizzed out, after the Securities and Exchange Commission became involved.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'S.E.C. Stops Would-Be Buyers of Pabst Beer', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Crowdsourcing (Internet)', 'rank': 2, 'ma