izations', 'value': 'United Nations', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-07T23:43:55+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Dan Bilefsky', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Bilefsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/36cd5866-5f71-5e38-a1bc-26e45b23eb43', 'word_count': 78, 'uri': 'nyt://article/36cd5866-5f71-5e38-a1bc-26e45b23eb43'}, {'abstract': 'Two days after fouling a ball off his right leg and leaving the game in the second inning, Carlos Beltran started against the Milwaukee Brewers.', 'web_url': 'https://bats.blogs.nytimes.com/2011/06/07/beltrans-back-in-the-lineup/', 'snippet': 'Two days after fouling a ball off his right leg and leaving the game in the second inning, Carlos Beltran started against the Milwaukee Brewers.', 'lead_paragraph': 'Two days after fouling a ball off his right leg and leaving the game in the second inning, Carlos Beltran was back in the lineup Tuesday night as the Mets opened a three-game series in Milwaukee against the Brewers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Beltran’s Back in the Lineup', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Beltran, Carlos', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-07T23:44:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/9b4ada38-f861-5cfa-bbee-e8c3749d2f30', 'word_count': 189, 'uri': 'nyt://article/9b4ada38-f861-5cfa-bbee-e8c3749d2f30'}, {'abstract': 'Jena Troutman, the main supporter of a ballot measure to ban circumcision in Santa Monica, says the legislation has been misrepresented as an attempt to impinge on religious freedom.', 'web_url': 'https://www.nytimes.com/2011/06/08/us/08circumcise.html', 'snippet': 'Jena Troutman, the main supporter of a ballot measure to ban circumcision in Santa Monica, says the legislation has been misrepresented as an attempt to impinge on religious freedom.', 'lead_paragraph': 'LOS ANGELES — The primary backer of an effort to get a ban on circumcision on the ballot in Santa Monica is abandoning her push, saying the proposed legislation had been misrepresented as an effort to impinge on religious freedom. A similar measure in San Francisco is scheduled for a fall vote. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/us/CIRCUMCISE/CIRCUMCISE-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/us/CIRCUMCISE/CIRCUMCISE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/us/CIRCUMCISE/CIRCUMCISE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Santa Monica, Circumcision Opponent Abandons Efforts', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Santa Monica, Circumcision Opponent Abandons Efforts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Circumcision', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Santa Monica (Calif)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Youth', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-07T23:45:16+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jennifer Medina', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Medina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7adda582-0a82-5efa-ac3f-be66255a9ec7', 'word_count': 390, 'uri': 'nyt://article/7adda582-0a82-5efa-ac3f-be66255a9ec7'}, {'abstract': 'Fighting continued between northern troops and soldiers aligned with the southern Sudanese in the capital of Southern Kordofan State, forcing about 400 foreigners to be evacuated', 'web_url': 'https://www.nytimes.com/2011/06/08/world/africa/08briefs-Sudan.html', 'snippet': 'Fighting continued between northern troops and soldiers aligned with the southern Sudanese in the capital of Southern Kordofan State, forcing about 400 foreigners to be evacuated', 'lead_paragraph': ' Fighting continued on Tuesday between northern troops and soldiers aligned with the southern Sudanese in Kadugli, the capital of Southern Kordofan State, forcing about 400 foreigners to be evacuated, the United Nations said. At least six people were killed in the last two days, the United Nations said, adding that about 3,000 people had taken shelter at a nearby hospital on Monday night. Southern Kordofan is on the border between northern and southern Sudan, which is to declare its independence next month. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sudan: Foreigners Evacuated in Border City', 'kicker': 'World Briefing | AFRICA', 'content_kicker': None, 'print_headline': 'Sudan: Foreigners Evacuated in