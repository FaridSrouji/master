me. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Albany’s Duty to Stop Domestic Violence', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Albany’s Duty to Stop Domestic Violence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Domestic Violence', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-15T01:13:16+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/2cbb54ee-d1a3-553b-bb99-06c3fe09ba76', 'word_count': 296, 'uri': 'nyt://article/2cbb54ee-d1a3-553b-bb99-06c3fe09ba76'}, {'abstract': 'Professor Baldus nearly convinced the Supreme Court that the race of the victim affected death sentences.', 'web_url': 'https://www.nytimes.com/2011/06/15/us/15baldus.html', 'snippet': 'Professor Baldus nearly convinced the Supreme Court that the race of the victim affected death sentences.', 'lead_paragraph': 'David C. Baldus, whose pioneering research on race and the death penalty came within a vote of persuading the Supreme Court to make fundamental changes in the capital justice system, died on Monday at his home in Iowa City. He was 75.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/15/us/BALDUS-obit/BALDUS-obit-jumbo.jpg', 'height': 1024, 'width': 708, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/15/us/BALDUS-obit/B