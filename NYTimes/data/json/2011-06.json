rts/VOGEL-1/VOGEL-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/VOGEL-1/VOGEL-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Showing Two Painters, Three Centuries Apart', 'kicker': 'Inside Art', 'content_kicker': None, 'print_headline': 'Showing Two Painters, Three Centuries Apart', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Twombly, Cy', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Murakami, Takashi', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Museum of Art', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-30T21:31:14+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d13e089f-527a-5781-ab01-2436d7b54270', 'word_count': 1108, 'uri': 'nyt://article/d13e089f-527a-5781-ab01-2436d7b54270'}, {'abstract': 'In “Monte Carlo,” Selena Gomez plays a Texas Francophile who travels to France and Monte Carlo with her eager friend and reluctant older stepsister.', 'web_url': 'https://www.nytimes.com/2011/07/01/movies/selena-gomez-in-monte-carlo-review.html', 'snippet': 'In “Monte Carlo,” Selena Gomez plays a Texas Francophile who travels to France and Monte Carlo with her eager friend and reluctant older stepsister.', 'lead_paragraph': 'The gal-pal comedy “Monte Carlo” comes with a bewildering PG rating for “brief mild language” (so brief I missed the offending words), when it really should have earned a Gee. Cheery, corny and perhaps calculatingly unoriginal, this is packaged entertainment so familiar it feels like a remake and so wholesome you could swear Sandra Dee starred in the 1959 original. Think of it as “No Sex and the City” for tweeners.', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/MONTE-span/MONTE-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/01/arts/MONTE-span/MONTE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/MONTE-span/MONTE-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/MONTE-span/MONTE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/01/arts/MONTE-span/MONTE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Cinderella Goes to Europe, and Cute Meets Culture', 'kicker': "Movie Review | 'Monte Carlo'", 'content_kicker': None, 'print_headline': 'Cinderella Goes to Europe, And Cute Meets Culture', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Friendship', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-30T21:34:52+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/324e983c-7e5e-5848-b5a8-5e9d01b805f5', 'word_count': 795, 'uri': 'nyt://article/324e983c-7e5e-5848-b5a8-5e9d01b805f5'}, {'abstract': 'New York City is chockablock with shelters of solitude, some hidden and some in plain sight, that invite pause, reflection, even wonder; somehow the noise heightens the silence.', 'web_url': 'https://www.nytimes.com/2011/07/01/arts/manhattans-quiet-shelters-of-solitude-amid-the-noise.html', 'snippet': 'New York City is chockablock with shelters of solitude, some hidden and some in plain sight, that invite pause, reflection, even wonder; somehow the noise heightens the silence.', 'lead_paragraph': 'MANHATTAN can be too much with us. It can seem like a 23-square-mile rugby pitch, where on any given day nearly three million people are shoving elbows, blowing cigarette smoke, jabbering on cellphones or to themselves, all ready to rumble over the slightest slight. Not long ago a well-educated woman slapped another well-educated woman in a confrontation over a package of vegan pad Thai in the frozen-food section of Trader Joe’s. To which inhabitants of Manhattan might say: “Yeah? So what?”', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/JP-QUIET/JP-QUIET-jumbo.jpg', 'height': 611, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/JP-QUIET/JP-QUIET-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/01/arts/JP-QUIET/JP-QUIET-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Sounds of Silence', 'kicker': None, 'content_kicker': None, 'print_headline': 'Loving New York, in Cacophony and in Quiet: The Sounds of Silence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Noise', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Frick Collection', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Public Library', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-30T21:35:17+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Dan Barry', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Barry', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ad62291-de04-52fd-990b-dd3e2394bfcf', 'word_count': 881, 'uri': 'nyt://article/9ad62291-de04-52fd-990b-dd3e2394bfcf'}, {'abstract': 'New York noise, from the dawn chorus of the garbage trucks to the basso continuo of the traffic, can be restorative.', 'web_url': 'https://www.nytimes.com/2011/07/01/arts/noises-of-new-york-citys-racket-can-be-restorative.html', 'snippet': 'New York noise, from the dawn chorus of the garbage trucks to the basso continuo of the traffic, can be restorative.', 'lead_paragraph': 'LIKE most commuters, I spend my days in the city but sleep out in the stillness of the suburbs, where at night it’s as quiet as the grave. The only thing you hear is the occasional scrabbling of raccoons trying to knock over the trash cans. But a couple of years ago I happened to spend the night at an Upper East Side hotel, where I was pleasantly startled by two phenomena: the abundant free pornography on cable TV and, around dawn, a whining, grinding, masticating sound that I eventually recognized as a garbage truck partaking of its morning feed. This was followed by some bus rumbling and horn honking and, a few blocks away, an insistent car alarm. The city was already awake and thrumming, going about its business with none of the suburban fussiness that makes it unmannerly, for example, to crank up your lawn mower or your leaf blower before breakfast. ', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/JP-NOISY/JP-NOISY-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/arts/JP-NOISY/JP-NOISY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/01/arts/JP-NOISY/JP-NOISY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Restorative Racket', 'kicker': None, 'content_kicker': None, 'print_headline': 'Loving New York, in Cacophony and in Quiet: A Restorative Racket', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Noise', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-30T21:35:21+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe38b848-3f9d-53fc-ae19-81f2e993a8bf', 'word_count': 807, 'uri': 'nyt://article/fe38b848-3f9d-53fc-ae19-81f2e993a8bf'}, {'abstract': 'A selected guide to events for, by and about children.', 'web_url': 'https://www.nytimes.com/2011/07/01/arts/spare-times-for-children-for-july-1-7.html', 