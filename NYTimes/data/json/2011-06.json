 None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/61ddb909-5def-557e-9dbb-3f2a3b44865b', 'word_count': 255, 'uri': 'nyt://article/61ddb909-5def-557e-9dbb-3f2a3b44865b'}, {'abstract': 'Susan C. Ervin, who has worked at the Commodity Futures Trading Commission and the Securities and Exchange Commission, will join the law firm’s Washington office as a partner.', 'web_url': 'https://dealbook.nytimes.com/2011/06/08/davis-polk-hires-former-derivatives-regulator/', 'snippet': 'Susan C. Ervin, who has worked at the Commodity Futures Trading Commission and the Securities and Exchange Commission, will join the law firm’s Washington office as a partner.', 'lead_paragraph': 'Susan C. Ervin, a longtime federal derivatives regulator, will join Davis Polk & Wardwell as a partner in the law firm’s Washington office. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Davis Polk Hires Former Derivatives Regulator', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Derivatives (Financial Instruments)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Davis Polk & Wardwell', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-08T15:31:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Protess', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/50da3078-8295-5b74-bdb6-bd2de32bb2fa', 'word_count': 295, 'uri': 'nyt://article/50da3078-8295-5b74-bdb6-bd2de32bb2fa'}, {'abstract': 'A graphic novel about a teenage girl and her friend Emily, a 100-something-year-old ghost who died 90 years earlier.', 'web_url': 'https://www.nytimes.com/2011/06/08/books/review/young-adult-books-anyas-ghost-by-vera-brosgol.html', 'snippet': 'A graphic novel about a teenage girl and her friend Emily, a 100-something-year-old ghost who died 90 years earlier.', 'lead_paragraph': 'Female friendship, always a tricky business, is particularly dicey during high school. The person you consider to be your best friend may be exactly that, but she may also be your chief underminer and most enthusiastic behind-your-back critic.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/books/review/08childrens/08childrens-articleLarge.jpg', 'height': 348, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/08/books/review/08childrens/08childrens-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 348}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/books/review/08childrens/08childrens-jumbo.jpg', 'height': 1024, 'width': 704, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/books/review/08childrens/08childrens-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/books/review/08childrens/08childrens-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Girl and Her Ghost', 'kicker': 'Young Adult', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'nam