on': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73b768de-2ac0-57a9-a766-fec0ab516eb1', 'word_count': 338, 'uri': 'nyt://article/73b768de-2ac0-57a9-a766-fec0ab516eb1'}, {'abstract': 'President Hamid Karzai arrived in Islamabad for a two-day visit that is being viewed as an effort to ensure Pakistani help in peace negotiations with the Taliban.', 'web_url': 'https://www.nytimes.com/2011/06/11/world/asia/11pakistan.html', 'snippet': 'President Hamid Karzai arrived in Islamabad for a two-day visit that is being viewed as an effort to ensure Pakistani help in peace negotiations with the Taliban.', 'lead_paragraph': 'ISLAMABAD, Pakistan — President Hamid Karzai of Afghanistan arrived in Islamabad on Friday for a two-day visit, which was being viewed as an effort to ensure Pakistani help in the peace talks he has initiated with the Taliban. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/world/asia/11pakistan/11pakistan-jumbo.jpg', 'height': 1024, 'width': 686, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/world/asia/11pakistan/11pakistan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/11/world/asia/11pakistan/11pakistan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Afghan Leader Seeks Pakistani Help in Talks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Afghan Leader Seeks Pakistani Help in Talks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Intelligence Services', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Karzai, Hamid', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kayani, Ashfaq Parvez', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Zardari, Asif Ali', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-06-10T14:49:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Salman Masood', 'person': [{'firstname': 'Salman', 'middlename': None, 'lastname': 'Masood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fcf0dac5-7dc5-565c-8c37-1bbef9b1c7c2', 'word_count': 531, 'uri': 'nyt://article/fcf0dac5-7dc5-565c-8c37-1bbef9b1c7c2'}, {'abstract': 'Jim Yardley responds to readers’ questions and comments on his recent story on economic development in India.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/06/10/indias-way-jim-yardley-responds-to-readers-on-development-in-gurgaon/', 'snippet': 'Jim Yardley responds to readers’ questions and comments on his recent story on economic development in India.', 'lead_paragraph': 'I want to thank everyone for all the thoughtful comments about the Gurgaon story. India is one of the most fascinating assignments in the world, if occasionally a vexing one, given its complexities and contradictions. In the India’s Way series, we hope to examine how India works — and doesn’t work. We want to look at how it has grown, examine the unique ways Indians are trying to move their country forward and also explore the challenges ahead.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'India’s Way: Jim Yardley Responds to Readers on Development in Gurgaon', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', '