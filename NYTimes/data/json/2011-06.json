ght': 75}}], 'headline': {'main': 'Pfizer Suspends Sales of Chicken Drug With Arsenic', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pfizer Suspends Sales of Chicken Drug With Arsenic', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Pfizer Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ARSENIC', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'AGRICULTURE', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Recalls and Bans of Products', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Poultry', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-06-09T00:26:59+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Gardiner Harris and Denise Grady', 'person': [{'firstname': 'Gardiner', 'middlename': None, 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Denise', 'middlename': None, 'lastname': 'Grady', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/26b040a0-5fd7-5b59-a3d7-2e6ac537f0d5', 'word_count': 720, 'uri': 'nyt://article/26b040a0-5fd7-5b59-a3d7-2e6ac537f0d5'}, {'abstract': 'Smartphone apps from Apple and Android include photos, descriptions and even audio pronunciations to help make ordering sushi easier.', 'web_url': 'https://www.nytimes.com/2011/06/09/technology/personaltech/09smart.html', 'snippet': 'Smartphone apps from Apple and Android include photos, descriptions and even audio pronunciations to help make ordering sushi easier.', 'lead_paragraph': 'Want to take someone down a notch? Take them to a sushi bar and ask them to order. Even sushi fans face a moment of uncertainty when a server who is clearly fluent in Japanese addresses the table. Novices have it even worse.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/business/SMART-1/SMART-1-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/business/SMART-1/SMART-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/business/SMART-1/SMART-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Order Sushi Like a Native, and Know What You’re Eating', 'kicker': 'App Smart', 'content_kicker': None, 'print_headline': 'Order Sushi Like a Native, and Know What You’re Eating', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sushi', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-09T00:28:22+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Bob Tedeschi', 'person': [{'firstname': 'Bob', 'middlename': None, 'lastname': 'Tedeschi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/686ff13f-6d46-56f3-970c-ed8bb020e3e4', 'word_count': 954, 'uri': 'nyt://article/686ff13f-6d46-56f3-970c-ed8bb020e3e4'}, {'abstract': 'Pricey music servers can store and play high-fidelity music files, but an old computer and a digital-to-analog converter can also do the job.', 'web_url': 'https://www.nytimes.com/2011/06/09/technology/personaltech/09basics.html', 'snippet': 'Pricey music servers can store and play high-fidelity music files, but an old computer and a digital-to-analog converter can also do the job.', 'lead_paragraph': 'Back when my music was on vinyl or CD, I had a stereo in the living room where my music-loving friends would gather to listen, chat and argue. But now that I, like most of the world, buy digital downloads, my music resides on my main computer. So when my friends come by, we end up awkwardly crowded around the computer in my office, clicking on songs. This is not gracious entertaining.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/business/BASICS/BASICS-jumbo.jpg', 'height': 1024, 'width': 1013, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/09/business/BASICS/BASICS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/09/business/BASICS/BASICS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Low Cost and Hi-Fi: Building a Player', 'kicker': None, 'content_kicker': None, 'print_headline': 'Low Cost And Hi-Fi: Building A Player', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-09T00:37:42+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Roy Furchgott', 'person': [{'firstname': 'Roy', 'middlename': None, 'lastname': 'Furchgott', 'qualifier': Non