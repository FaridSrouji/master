rank': 1}, {'firstname': 'J.', 'middlename': 'David', 'lastname': 'Goodman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d758f37-1f76-5f96-ab44-391cc0c5b2f3', 'word_count': 310, 'uri': 'nyt://article/6d758f37-1f76-5f96-ab44-391cc0c5b2f3'}, {'abstract': 'The move comes amid much uncertainty at the company.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/02/another-blow-for-city-opera-as-director-of-artistic-planning-departs/', 'snippet': 'The move comes amid much uncertainty at the company.', 'lead_paragraph': 'The New York City Opera has suffered a staff departure at a critical time. Edward C. Yim, the director of artistic planning, is resigning to serve as a consultant at the New York Philharmonic. The financially strapped opera company announced two weeks ago that it was leaving its Lincoln Center home to save money, without saying where it was going or what operas it would perform for the season starting in October. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Another Blow for City Opera as Director of Artistic Planning Departs', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mehta, Zarin', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Steel, George', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Lincoln Center for the Performing Arts', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Opera', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-06-02T16:07:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline':