anizations', 'value': 'Department of Environmental Protection', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Friends of Animals', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Prospect Park (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-23T23:20:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Andy Newman', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cb727e2f-1aed-52f5-aab2-8be5b72e280c', 'word_count': 495, 'uri': 'nyt://article/cb727e2f-1aed-52f5-aab2-8be5b72e280c'}, {'abstract': 'While Weekend Miser is off to Los Angeles, and probably not behaving in a very miserly fashion, we are left to our own devices to find cheap entertainment.', 'web_url': 'https://www.nytimes.com/2011/06/24/arts/weekend-miser.html', 'snippet': 'While Weekend Miser is off to Los Angeles, and probably not behaving in a very miserly fashion, we are left to our own devices to find cheap entertainment.', 'lead_paragraph': 'While Weekend Miser is off to Los Angeles, and probably not behaving in a very miserly fashion, we are left to our own devices to find cheap entertainment. She left behind a sheaf of papers (O.K., a bunch of e-mails) that is a bit overwhelming, but June is Gay Pride Month, so it’s easy to find plenty of inexpensive things to do around the festivities.', 'print_section': 'C', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Weekend Miser', 'kicker': None, 'content_kicker': None, 'print_headline': 'Weekend Miser', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New York City', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-23T23:23:55+000