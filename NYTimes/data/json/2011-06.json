ginal': 'By Jeff Zeleny', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Zeleny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c01d782a-280d-5c86-b896-e90e1bfb51e3', 'word_count': 407, 'uri': 'nyt://article/c01d782a-280d-5c86-b896-e90e1bfb51e3'}, {'abstract': 'A wardrobe inventory by Jill Scott, from outfits for performing to relaxing at the spa.', 'web_url': 'https://www.nytimes.com/2011/06/19/fashion/jill-scott-from-glamour-to-librarian-what-i-wore.html', 'snippet': 'A wardrobe inventory by Jill Scott, from outfits for performing to relaxing at the spa.', 'lead_paragraph': 'JILL SCOTT, 39, a Philadelphia native, has won three Grammys for her R&B, soul and spoken-word recordings. With 5 million records sold worldwide, the singer and occasional actress will release her fourth studio album, “The Light of the Sun,” on Tuesday. Her corresponding Summer Block Party tour begins July 28 at the Jones Beach Theater in Wantagh, N.Y.', 'print_section': 'ST', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/fashion/WORE/WORE-jumbo.jpg', 'height': 1024, 'width': 609, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/fashion/WORE/WORE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/19/fashion/WORE/WORE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'From Retro Glamour to the Librarian Look', 'kicker': 'What I Wore | Jill Scott', 'content_kicker': None, 'print_headline': 'From Retro Glamour to the Librarian Look', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name':