content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Trisha', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-12T21:51:19+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/aa1b4f13-e80c-5e24-b3fb-606c4344b608', 'word_count': 0, 'uri': 'nyt://slideshow/aa1b4f13-e80c-5e24-b3fb-606c4344b608'}, {'abstract': 'The Huskies, led by two first-round draft picks, have been helped by the popularity and success of UConn’s football and basketball teams.', 'web_url': 'https://www.nytimes.com/2011/06/13/sports/baseball/uconn-is-making-a-name-for-itself-in-baseball.html', 'snippet': 'The Huskies, led by two first-round draft picks, have been helped by the popularity and success of UConn’s football and basketball teams.', 'lead_paragraph': 'COLUMBIA, S.C. — The moment George Springer had waited and worked and prepared a lifetime for came and went last Monday without celebration. There were no embraces or back slaps from his family or Connecticut teammates, no party and no Champagne.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/13/sports/UCONN/UCONN-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/13/sports/UCONN/UCONN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/13/sports/UCONN/UCONN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline':