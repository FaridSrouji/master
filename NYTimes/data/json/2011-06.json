lierpix-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Airport Indulgence: Bending Your Diet Rules', 'kicker': 'Frequent Flier', 'content_kicker': None, 'print_headline': 'The Airport Indulgence: Bending Your Diet Rules', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-06T19:25:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Jeanniey Mullen', 'person': [{'firstname': 'Jeanniey', 'middlename': None, 'lastname': 'Mullen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9759f15f-30f5-5927-8c1e-37fc317478b8', 'word_count': 611, 'uri': 'nyt://article/9759f15f-30f5-5927-8c1e-37fc317478b8'}, {'abstract': 'In my enthusiasm for the terrific side dishes (known in Korea as banchan) that accompanied beef bulgogi in Sunday’s Eat column, I didn’t have room to mention what may be the most indispensable element of the meal: lettuce leaves.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/06/06/korean-foods-mild-sidekick-lettuce/', 'snippet': 'In my enthusiasm for the terrific side dishes (known in Korea as banchan) that accompanied beef bulgogi in Sunday’s Eat column, I didn’t have room to mention what may be the most indispensable element of the meal: lettuce leaves.', 'lead_paragraph': 'In my enthusiasm for the terrific side dishes (known in Korea as banchan) that accompanied beef bulgogi in Sunday’s Eat column — stir-fried spinach with crumbled tofu, Korean-style potato salad, grilled-scallion salad, fried hijiki and (the mother of all Korean sides) kimchi — I didn’t have room to mention what may be the most indispensable element of the meal: lettuce leaves.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Korean Food’s Mild Sidekick: Lettuce', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Korean Food (Cuisine)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Lettuce', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-06T19:33:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/abb7fa30-06a6-5505-840b-505a1772e88c', 'word_count': 245, 'uri': 'nyt://article/abb7fa30-06a6-5505-840b-505a1772e88c'}, {'abstract': 'Today’s special fill-in honors lively sports reporting by showing how many vivid ways there are to describe a ball being moved down a field. Can you fill in the 18 missing verbs?', 'web_url': 'https://learning.blogs.nytimes.com/2011/06/06/fill-in-verbs-used-to-describe-a-soccer-game/', 'snippet': 'Today’s special fill-in honors lively sports reporting by showing how many vivid ways there are to describe a ball being moved down a field. Can you fill in the 18 missing verbs?', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fill-In | Verbs Used to Describe a Soccer Game', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-06T19:39:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier'