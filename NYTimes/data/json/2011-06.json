Outbreak', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'E Coli (Bacteria)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'AGRICULTURE', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-06T14:33:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Judy Dempsey and James Kanter', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Dempsey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'James', 'middlename': None, 'lastname': 'Kanter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d990479-2693-580e-bc5c-e7ab246faff9', 'word_count': 928, 'uri': 'nyt://article/0d990479-2693-580e-bc5c-e7ab246faff9'}, {'abstract': 'Glenn F. Tilton has been named chairman of JPMorgan Chase’s Midwest business, succeeding William M. Daley, who left the bank to become White House chief of staff.', 'web_url': 'https://dealbook.nytimes.com/2011/06/06/jpmorgan-hires-former-united-airlines-c-e-o/', 'snippet': 'Glenn F. Tilton has been named chairman of JPMorgan Chase’s Midwest business, succeeding William M. Daley, who left the bank to become White House chief of staff.', 'lead_paragraph': 'Glenn F. Tilton, a former chief executive of United Airlines, has been named chairman of JPMorgan Chase‘s Midwest business, succeeding William M. Daley, who left the bank this year to become White House chief of staff. Mr. Tilton, 63, will also be a member of the bank’s executive committee. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'JPMorgan Hires Former United Airlines Chief', 'kicker': 'DealBook', 'content_kicker'