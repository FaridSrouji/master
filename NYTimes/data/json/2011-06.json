jor': 'N'}, {'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Hearing Aids', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-20T02:07:10+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joseph Goldstein', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'Goldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2cf27025-fa2e-53b4-aa19-a2383b1ab2d5', 'word_count': 1246, 'uri': 'nyt://article/2cf27025-fa2e-53b4-aa19-a2383b1ab2d5'}, {'abstract': 'Among the victims at Haven Drugs, in Medford, was Jennifer Mejia, 17, who was to have graduated this week from Bellport High.', 'web_url': 'https://www.nytimes.com/2011/06/20/nyregion/gunman-kills-4-in-a-long-island-pharmacy.html', 'snippet': 'Among the victims at Haven Drugs, in Medford, was Jennifer Mejia, 17, who was to have graduated this week from Bellport High.', 'lead_paragraph': 'Four people were shot and killed at a pharmacy in Medford, N.Y., on Sunday morning in what appeared to be an attempted robbery, the Suffolk County police said. One of the victims was a senior at a local high school who was to graduate this week. ', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Robber Kills 4 in L.I. Pharmacy; One Victim Is a 17-Year-Old Girl', 'kicker': None, 'content_kicker': None, 'print_headline': 'Robber Kills 4 in L.I. Pharmacy; One Victim Is a 17-Year-Old Girl', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Robberies and Thefts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Medford (NY)', 'rank'