/2011/06/08/arts/SIMONE/SIMONE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/arts/SIMONE/SIMONE-jumbo.jpg', 'height': 809, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/arts/SIMONE/SIMONE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/arts/SIMONE/SIMONE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Mourning, Bach and a 9/11 Theme', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Mourning, Bach and a 9/11 Theme', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Dinnerstein, Simone', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-07T21:26:33+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Steve Smith', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e71960a2-fb16-5c45-9b4d-1d8632a9a31f', 'word_count': 387, 'uri': 'nyt://article/e71960a2-fb16-5c45-9b4d-1d8632a9a31f'}, {'abstract': 'A federal judge denies a request by prosecutors to reconsider his ruling last month striking down a ban on direct contributions from corporations to political candidates.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/06/07/judge-wont-reconsider-decision-on-corporate-donations/', 'snippet': 'A federal judge denies a request by prosecutors to reconsider his ruling last month striking down a ban on direct contributions from corporations to political candidates.', 'lead_paragraph': 'A federal judge on Tuesday denied a request by prosecutors to reconsider his ruling last month striking down a ban on direct contributions from corporations to political candidates, setting into motion what could be a pivotal court battle over one of the biggest legal and political issues of the day.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Judge Won’t Reconsider Decision on Corporate Donations', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Citizens United v Federal Election Commission (Supreme Court Decision)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Citizens United', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-07T21:29:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/05af913a-6222-5c06-97b5-aa2e48428f2a', 'word_count': 386, 'uri': 'nyt://article/05af913a-6222-5c06-97b5-aa2e48428f2a'}, {'abstract': 'The Gotham Dance Festival’s first of two sampler programs featured works by Kyle Abraham, Faye Driscoll and Gregory Dolbashian at the Joyce Theater.', 'web_url': 'https://www.nytimes.com/2011/06/08/arts/dance/kyle-abraham-faye-driscoll-and-gregory-dolbashian-at-the-joyce-dance-review.html', 'snippet': 'The Gotham Dance Festival’s first of two sampler programs featured works by Kyle Abraham, Faye Driscoll and Gregory Dolbashian at the Joyce Theater.', 'lead_paragraph': 'Sampler programs — bits and pieces from different artists — are a gamble for both presenters and audiences. Perhaps everyone will show the same kind of work? Perhaps all the lighting will be dim and the costumes brown? Perhaps the styles will be so widely disparate or obscure as to leave watchers with furrowed brows? ', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/arts/Abraham/Abraham-jumbo.jpg', 'height': 1024, 'width': 631, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/arts/Abraham/Abraham-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/arts/Abraham/Abraham-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Taking on the Risks of a Mixed Lineup', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Taking On The Risks Of a Mixed Lineup', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Driscoll, Faye', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Abraham, Kyle (1977- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Joyce Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-07T21:31:24+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/cc5d754e-aa49-5f44-a275-43dd4d27fe44', 'word_count': 520, 'uri': 'nyt://article/cc5d754e-aa49-5f44-a275-43dd4d27fe44'}, {'abstract': 'A series of events by Susan Rethorst at Danspace Project looks at the daily work of creating dance.', 'web_url': 'https://www.nytimes.com/2011/06/08/arts/dance/susan-rethorst-deconstructs-dance-making-at-danspace-project.html', 'snippet': 'A series of events by Susan Rethorst at Danspace Project looks at the daily work of creating dance.', 'lead_paragraph': 'The movies like to present portraits of artists who create great works all at once, driven to some sort of divine (perhaps substance-enhanced) frenzy in the dark hours of the night. But anybody who has ever really engineered something, be it a table or a painting or a dinner party, on some level understands that this isn’t the way it happens for most of us — even those residing in that dubious category, “genius.” In her fine 2003 essay “Dailiness,” in an anthology, “Choreographic Encounters,” the choreographer Susan Rethorst muses on the day-by-day practice of dance making. ', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/arts/sub-rethorst/sub-rethorst-jumbo.jpg', 'height': 748, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/arts/sub-rethorst/sub-rethorst-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/arts/sub-rethorst/sub-rethorst-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'How Does a Choreographer Create Art? Day by Ho-Hum Day', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline':