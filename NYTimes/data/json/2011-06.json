'kicker': None, 'content_kicker': None, 'print_headline': 'Clinton Praises Protest by Saudis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Saudi Arabia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-21T22:19:41+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Steven Lee Myers', 'person': [{'firstname': 'Steven', 'middlename': 'Lee', 'lastname': 'Myers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/83e3f564-dd56-5351-8eea-292d9491242a', 'word_count': 476, 'uri': 'nyt://article/83e3f564-dd56-5351-8eea-292d9491242a'}, {'abstract': 'Jon M. Huntsman Jr., the former governor of Utah, returning from Exter, N.H. on his campaign plane, with 5-year-old daughter Asha.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/06/21/the-caucus-click-jon-huntsman-in-exeter-n-h/', 'snippet': 'Jon M. Huntsman Jr., the former governor of Utah, returning from Exter, N.H. on his campaign plane, with 5-year-old daughter Asha.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Caucus Click: Jon Huntsman in Exeter, N.H.', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-21T22:26:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/3da43dd5-1402-5097-aa36-80350dbd838e', 'word_count': 1, 'uri': 'nyt://article/3da43dd5-1402-5097-aa36-80350dbd838e'}, {'abstract': '“If a Tree Falls: A Story of the Earth Liberation Front” looks at an environmental group that, in 2001, the F.B.I. declared was the country’s “No. 1 domestic terrorist threat.”', 'web_url': 'https://www.nytimes.com/2011/06/22/movies/if-a-tree-falls-documentary-on-earth-liberation-front.html', 'snippet': '“If a Tree Falls: A Story of the Earth Liberation Front” looks at an environmental group that, in 2001, the F.B.I. declared was the country’s “No. 1 domestic terrorist threat.”', 'lead_paragraph': 'Do crimes against property in which no one is killed or injured constitute acts of terrorism? That is one of two nagging questions that run through Marshall Curry and Sam Cullman’s thoughtful documentary, “If a Tree Falls: A Story of the Earth Liberation Front.” The other has to do with the efficacy of traditional forms of peaceful protest.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/22/arts/TREE/TREE-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/22/arts/TREE/TREE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/22/arts/TREE/TREE-jumbo.jpg', 'height': 706, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/22/arts/TREE/TREE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/22/arts/TREE/TREE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Crimes Against Property, as Protests', 'kicker': "Movie Review | 'If a Tree Falls: A Story of the Earth Liberation Front'", 'content_kicker': None, 'print_headline': 'Crimes Against Property, as Protests', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Environment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Curry, Marshall', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-21T22:33:37+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/649cd8d2-992e-544d-88a3-56e75a11cdf0', 'word_count': 806, 'uri': 'nyt://article/649cd8d2-992e-544d-88a3-56e75a11cdf0'}, {'abstract': 'Mitt Romney, the former governor of Masschusetts, will participate in a half-dozen presidential debates this fall, his campaign announced Tuesday.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/06/21/romney-sets-fall-debate-schedule/', 'snippet': 'Mitt Romney, the former governor of Masschusetts, will participate in a half-dozen presidential debates this fall, his campaign announced Tuesday.', 'lead_paragraph': 'Mitt Romney, the former governor of Massachusetts, will participate in a half-dozen presidential debates this fall, his campaign announced Tuesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney Sets Fall Debate Schedule', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Debates