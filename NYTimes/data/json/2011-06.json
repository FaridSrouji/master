.jpg', 'height': 710, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/02/sports/01pins-1/01pins-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/02/sports/01pins-1/01pins-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Granderson Powers Yankees Past A’s', 'kicker': 'Yankees 10, Athletics 3', 'content_kicker': None, 'print_headline': 'Granderson Powers Yankees Past A’s', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Yankees', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Oakland Athletics', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Granderson, Curtis', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Garcia, Freddy', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-01T05:03:58+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a05cf125-1f95-5fd3-a4bc-36e0593b2dde', 'word_count': 902, 'uri': 'nyt://article/a05cf125-1f95-5fd3-a4bc-36e0593b2dde'}, {'abstract': 'Confronted by the Heat’s suffocating defense, the Mavericks’ bench converted just 4 of 22 field goals and went 0 for 9 in the second half. It was outscored by the Heat’s much-less-vaunted bench, 27-17.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2011/06/01/mavericks-strong-bench-opens-feebly/', 'snippet': 'Confronted by the Heat’s suffocating defense,