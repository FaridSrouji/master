cle/54bdd269-1c4c-5c84-98ea-91edd00ffa94'}, {'abstract': 'The European drug maker AstraZeneca said on Wednesday that it was selling its Astra Tech dental and medical device business to the American company Dentsply for $1.8 billion, in a deal that would create the third-largest dental implant company in the world.', 'web_url': 'https://dealbook.nytimes.com/2011/06/22/astrazeneca-sells-dental-unit-for-1-8-billion/', 'snippet': 'The European drug maker AstraZeneca said on Wednesday that it was selling its Astra Tech dental and medical device business to the American company Dentsply for $1.8 billion, in a deal that would create the third-largest dental implant company in ...', 'lead_paragraph': 'The European drug maker AstraZeneca said on Wednesday that it was selling its Astra Tech dental and medical device business to Dentsply for $1.8 billion, in a deal that would create the third-largest dental implant company in the world. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'AstraZeneca Sells Dental Unit for $1.8 Billion', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medical Devices', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Teeth and Dentistry', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AstraZeneca PLC', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'DENTSPLY INTERNATIONAL INC', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T11:46:58+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Chris V. Nicholson', 'person': [{'firstname': 'Chris', 'middlename': 'V.', 'lastname': 'Nicholson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a5513b5-4b78-52b9-bcbe-abd54347532b', 'word_count': 216, 'uri': 'nyt://article/0a5513b5-4b78-52b9-bcbe-abd54347532b'}, {'abstract': 'Activists were convicted of conspiring to overthrow the government in protests.', 'web_url': 'https://www.nytimes.com/2011/06/23/world/middleeast/23bahrain.html', 'snippet': 'Activists were convicted of conspiring to overthrow the government in protests.', 'lead_paragraph': 'CAIRO — A special military court in Bahrain convicted 21 mostly Shiite activists on Wednesday on charges of conspiring to overthrow the government during street demonstrations this year, sentencing eight to life in prison and the others to terms of up to 15 years. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/23/world/23bahrain/23bahrain-jumbo.jpg', 'height': 790, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/23/world/23bahrain/23bahrain-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/23/world/23bahrain/23bahrain-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '8 Bahrain Activists Get Life Sentences', 'kicker': None, 'content_kicker': None, 'print_headline': 'Activists Convicted of Plot to Topple Bahrain Rulers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shiite Muslims', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Bahrain', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T12:02:09+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Lara El Gibaly and David Jolly', 'person': [{'firstname': 'Lara', 'middlename': 'El', 'lastname': 'Gibaly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'David', 'middlename': None, 'lastname': 'Jolly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/37796287-e884-547c-97c0-fc59cfabb5c7', 'word_count': 904, 'uri': 'nyt://article/37796287-e884-547c-97c0-fc59cfabb5c7'}, {'abstract': 'Like a swallow arriving early in San Juan Capistrano, a campaign ad appears in Iowa.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/06/22/video-pawlenty-up-with-first-2012-ad-in-iowa/', 'snippet': 'Like a swallow arriving early in San Juan Capistrano, a campaign ad appears in Iowa.', 'lead_paragraph': 'There are plenty of ways to mark the beginning of a real presidential campaign. The first campaign commercial in Iowa is one of them. And here it is. Click over to a post by The Times’s Jeff Zeleny, who wrote on Tuesday about the decision by Tim Pawlenty, the former governor of Minnesota, to broadcast it now.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video: Pawlenty Up With First 2012 Ad in Iowa', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-22T12:13:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Shear', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7bd5abef-d4ed-556b-bf57-77098e4542e6', 'word_count': 57, 'uri': 'nyt://article/7bd5abef-d4ed-556b-bf57-77098e4542e6'}, {'abstract': 'New online services promise to bring order to the digital revolution, but dematerializing recorded music has its consequences for listeners, artists and the music industry.', 'web_url': 'https://www.nytimes.com/2011/06/26/arts/music/new-online-services-offer-hope-to-music-fans.html', 'snippet': 'New online services promise to bring order to the digital revolution, but dematerializing recorded music has its consequences for listeners, artists and the music industry.', 'lead_paragraph': 'I’M ready for the cloud. Soon, I hope, it will be ready for me.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/arts/MUSIC/MUSIC-jumbo-v2.jpg', 'height': 1024, 'width': 757, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/arts/MUSIC/MUSIC-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/26/arts/MUSIC/MUSIC-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Cloud That Ate Your Music', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Cloud That Ate Your Music', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cloud Computing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-22T12:14:37+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/98efd57b-fd71-5fa1-873d-93289f20de6b', 'word_count': 1701, 'uri': 'nyt://article/98efd57b-fd71-5fa1-873d-93289f20de6b'}, {'abstract': 'In his worst performance of the year, the rookie Dillon Gee lasted only four innings, walking a career-high six batters.', 'web_url': 'https://bats.blogs.nytimes.com/2011/06/22/unusual-struggles-for-the-rookie-gee/', 'snippet': 'In his worst performance of the year, the rookie Dillon Gee lasted only four innings, walking a career-high six batters.', 'lead_paragraph': 'In his previous outing against the Atlanta Braves, on June 15, the rookie Dillon Gee had perhaps his best stuff of the year. He pitched four scoreless innings that night with only one hit and two walks.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rare Struggles for the Rookie Gee', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gee, Dillon', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-22T12:18:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5caf8dc-fbcd-5fa8-99e2-c18ef4a907ff', 'word_count': 549, 'uri': 'nyt://article/c5caf8dc-fbcd-5fa8-99e2-c18ef4a907ff'}, {'abstract': 'Cholesterol-lowering drugs can increase diabetes risk, three essential steps to Facebook privacy, bookstores charge admission for author readings to raise revenue and other consumer-focused news from The New York Times.', 'web_url': 'https://bucks.blogs.nytimes.com/2011/06/22/wednesday-reading-cholesterol-drugs-can-increase-diabetes-risk/', 'snippet': 'Cholesterol-lowering drugs can increase diabetes risk, three essential steps to Facebook privacy, bookstores charge admission for author readings to raise revenue and other consumer-focused news from The New York Times.', 'lead_paragraph': 'A variety of consumer-focused articles appears daily in The New York Times and online in our blogs. Each weekday morning, we gather them together here so you can quickly scan the news that could hit you in your wallet. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wednesday Reading: Cholesterol Drugs Can Increase Diabetes Risk', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-22T12:23:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b54485c6-080b-5a39-9a82-3510f68571e9', 'word_count': 163, 'uri': 'nyt://article/b54485c6-080b-5a39-9a82-3510f68571e9'}, {'abstract': 'While recent heavy rains will bolster the country’s hydroelectric production, officials say that will not be enough to meet rising demand.', 'web_url': 'https://www.nytimes.com/2011/06/23/business/global/23iht-power23.html', 'snippet': 'While recent heavy rains will bolster the country’s hydroelectric production, officials say that will not be enough to meet rising demand.', 'lead_paragraph': 'BEIJING — Heavy rains in central China last week will help China produce extra hydroelectric power in the coming weeks, but not enough to avoid severe electricity shortages this summer, Chinese officials said Wednesday. ', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Recent Rains Bolster Hydroelectric Plants, but China Braces for Summer Power Shortages', 'kicker': None, 'content_kicker': None, 'print_headline': 'Recent Rains Bolster Hydroelectric Plants, but China Braces for Summer Power Shortages', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electric Light and Power', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Blackouts and Brownouts (Electrical)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hydroelectric Power', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T12:23:19+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Keith Bradsher', 'person': [{'firstname': 'Keith', 'middlename': None, 'lastname': 'Bradsher', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/02846d3e-dc65-5dae-9792-39ba19f38c82', 'word_count': 558, 'uri': 'nyt://article/02846d3e-dc65-5dae-9792-39ba19f38c82'}, {'abstract': 'A Congressional panel heard testimony regarding unequal pensions for some former workers at the General Motors supplier Delphi.', 'web_url': 'https://www.nytimes.com/2011/06/23/business/23pension.html', 'snippet': 'A Congressional panel heard testimony regarding unequal pensions for some former workers at the General Motors supplier Delphi.', 'lead_paragraph': 'A Congressional panel heard complaints Wednesday that the Obama administration had created pension winners and pension losers when it led the bankruptcy overhauls of the auto companies in 2009, despite federal rules meant to weave a uniform safety net for retirees.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Panel Hears Complaints on Pensions at Delphi', 'kicker': None, 'content_kicker': None, 'print_headline': 'Panel Hears Complaints On Pensions At Delphi', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pensions and Retirement Plans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Subprime Mortgage Crisis', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Delphi Corp', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T12:26:34+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Mary Williams Walsh', 'person': [{'firstname': 'Mary', 'middlename': 'Williams', 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7909a09b-1296-5631-afc8-dae337f3a362', 'word_count': 686, 'uri': 'nyt://article/7909a09b-1296-5631-afc8-dae337f3a362'}, {'abstract': 'The Day: A bunch of upstate lawmakers, some of whom wouldn’t know a hood medallion if they tripped on one, have become involved in reshaping the taxi industry in New York City.  Also, what City Room is reading in other papers and blogs.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/06/22/local-taxi-issues-take-a-ride-to-albany/', 'snippet': 'The Day: A bunch of upstate lawmakers, some of whom wouldn’t know a hood medallion if they tripped on one, have become involved in reshaping the taxi industry in New York City.  Also, what City Room is reading in other papers and blogs.', 'lead_paragraph': 'There’s an old joke about an Englishman living in New York who was heading home and thought it would be a hoot to pull up to the family house in London in the back of a New York yellow taxi. He talked a cabby into going along with the idea, all expenses paid. They sailed to Southampton, with the taxi as cargo, then drove to London.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Local Taxi Issues Take a Ride to Albany', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Taxicabs and Taxicab Drivers', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T12:30:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Clyde Haberman', 'person': [{'firstname': 'Clyde', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70661732-daa4-5b78-b15c-6b18ac0e3c35', 'word_count': 1034, 'uri': 'nyt://article/70661732-daa4-5b78-b15c-6b18ac0e3c35'}, {'abstract': 'A reporter talks about his illegal American dream.', 'web_url': 'https://www.nytimes.com/2011/06/26/magazine/my-life-as-an-undocumented-immigrant.html', 'snippet': 'A reporter talks about his illegal American dream.', 'lead_paragraph': 'One August morning nearly two decades ago, my mother woke me and put me in a cab. She handed me a jacket. “Baka malamig doon” were among the few words she said. (“It might be cold there.”) When I arrived at the Philippines’ Ninoy Aquino International Airport with her, my aunt and a family friend, I was introduced to a man I’d never seen. They told me he was my uncle. He held my hand as I boarded an airplane for the first time. It was 1993, and I was 12.', 'print_section': 'MM', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/magazine/26illegal1/26illegal1-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/26/magazine/26illegal1/26illegal1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/magazine/26illegal1/26illegal1-jumbo-v2.jpg', 'height': 1024, 'width': 820, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/magazine/26illegal1/26illegal1-superJumbo.jpg', 'height': 1500, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/magazine/26illegal1/26illegal1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/26/magazine/26illegal1/26illegal1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/26/magazine/26illegal1/26illegal1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Life as an Undocumented Immigrant', 'kicker': None, 'content_kicker': None, 'print_headline': 'Outlaw', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Philippines', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T12:30:23+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Jose Antonio Vargas', 'person': [{'firstname': 'Jose', 'middlename': 'Antonio', 'lastname': 'Vargas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62a996e3-e00f-5325-9d75-3bdc3ceecac6', 'word_count': 4646, 'uri': 'nyt://article/62a996e3-e00f-5325-9d75-3bdc3ceecac6'}, {'abstract': 'Through water restoration certificates, North America’s top professional hockey league has found a way to return some of the water that it consumes during the playoffs.', 'web_url': 'https://green.blogs.nytimes.com/2011/06/22/n-h-l-tries-to-gives-back-the-water/', 'snippet': 'Through water restoration certificates, North America’s top professional hockey league has found a way to return some of the water that it consumes during the playoffs.', 'lead_paragraph': 'Before the Stanley Cup Finals between the Vancouver Canucks and the Boston Bruins, the National Hockey League said that the finals would be the first “water neutral” series in its history.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'N.H.L. Tries to Give Back the Water', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Athletics and Sports', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conservation of Resources', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hockey, Ice', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Stanley Cup', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Water', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Mansur, Bernadette', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Greenpeace', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'National Hockey League', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Natural Resources Defense Council', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Vancouver Canucks', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Oregon', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Pacific Northwestern States (US)', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Vancouver (British Columbia)', 'rank': 14, 'major': 'N'}], 'pub_date': '2011-06-22T12:32:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Jeff DiNunzio', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'DiNunzio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a65061e1-baa1-5b61-8398-7dc35a62830a', 'word_count': 626, 'uri': 'nyt://article/a65061e1-baa1-5b61-8398-7dc35a62830a'}, {'abstract': 'The Chinese vice foreign minister warned the United States on Wednesday to stay out of the increasingly tense territorial disputes.', 'web_url': 'https://www.nytimes.com/2011/06/23/world/asia/23china.html', 'snippet': 'The Chinese vice foreign minister warned the United States on Wednesday to stay out of the increasingly tense territorial disputes.', 'lead_paragraph': 'BEIJING — The Chinese vice foreign minister warned the United States on Wednesday to stay out of the increasingly tense territorial disputes and maritime conflicts in the South China Sea, which has some of the busiest shipping lanes in the world and is believed to be rich in oil and natural gas reserves.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Beijing Warns U.S. About South China Sea Disputes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Beijing Warns U.S. About South China Sea Disputes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ships and Shipping', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South China Sea', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T12:41:09+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Edward Wong', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/955e0778-78a7-534d-afca-c8f54092f5de', 'word_count': 734, 'uri': 'nyt://article/955e0778-78a7-534d-afca-c8f54092f5de'}, {'abstract': 'Shazam, an application that lets people identify songs using their mobile phones, is raising money to expand its business.', 'web_url': 'https://bits.blogs.nytimes.com/2011/06/22/shazam-identifies-the-sound-of-fresh-venture-funds/', 'snippet': 'Shazam, an application that lets people identify songs using their mobile phones, is raising money to expand its business.', 'lead_paragraph': 'Can Shazam, the mobile application that can identify songs, recognize the sound of cha-ching?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Shazam Identifies the Sound of Fresh Venture Funds', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mobile Applications', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Shazam Entertainment', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-22T13:00:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9613ec30-035e-52b8-bb76-d9f33e99ece9', 'word_count': 309, 'uri': 'nyt://article/9613ec30-035e-52b8-bb76-d9f33e99ece9'}, {'abstract': 'If you sweat the small stuff, especially in the scorching June heat, you deserve a brand-new disposable wipe, the kind that comes in soft, handy packages.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/06/22/samurai-shopper-quicker-picker-uppers/', 'snippet': 'If you sweat the small stuff, especially in the scorching June heat, you deserve a brand-new disposable wipe, the kind that comes in soft, handy packages.', 'lead_paragraph': 'As an occasional insomniac, the Samurai Shopper finds that TV shopping networks no longer put me in the zzzzzone; but Antenna, way up north on Channel 166, does. From 5 a.m. till midday, Antenna runs old movies that beg for oblivion but have been unaccountably resurrected. Today’s fare, circa 1950, was “The Last of the Buccaneers,” a down-market swashbuckling adventure of Jean Lafitte, starring Paul Henried. Asleep yet? How about Beau Bridges as “The Fifth Musketeer”?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Samurai Shopper | Quicker Picker Uppers', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-22T13:00:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By S.S. Fair', 'person': [{'firstname': 'S.', 'middlename': 'S.', 'lastname': 'Fair', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b04a6b26-de60-5266-8f7b-3273759476ff', 'word_count': 714, 'uri': 'nyt://article/b04a6b26-de60-5266-8f7b-3273759476ff'}, {'abstract': 'The lawsuit contends that a new measure broadly expanding the powers of emergency managers violates the State Constitution.', 'web_url': 'https://www.nytimes.com/2011/06/23/us/23michigan.html', 'snippet': 'The lawsuit contends that a new measure broadly expanding the powers of emergency managers violates the State Constitution.', 'lead_paragraph': 'More than two dozen residents of Michigan filed a lawsuit on Wednesday against top officials in the state, contending that a new law broadly expanding the powers of emergency managers in the most financially troubled cities violates Michigan’s Constitution.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Michigan Residents Sue Over Law on Emergency Management of Struggling Cities', 'kicker': None, 'content_kicker': None, 'print_headline': 'Michigan Residents Sue Over Law on Emergency Management of Struggling Cities', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Suits and Litigation', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Michigan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Constitutions', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-22T13:13:15+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Monica Davey', 'person': [{'firstname': 'Monica', 'middlename': None, 'lastname': 'Davey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a7dca4a0-d0a5-52f3-a81c-229e9d8ac204', 'word_count': 573, 'uri': 'nyt://article/a7dca4a0-d0a5-52f3-a81c-229e9d8ac204'}, {'abstract': 'China’s foreign minister met with the leader of Libya’s rebel movement, calling him “an important dialogue partner,” as China seeks to improve its ties to the opposition.', 'web_url': 'https://www.nytimes.com/2011/06/23/world/asia/23beijing.html', 'snippet': 'China’s foreign minister met with the leader of Libya’s rebel movement, calling him “an important dialogue partner,” as China seeks to improve its ties to the opposition.', 'lead_paragraph': 'BEIJING — China’s foreign minister met here with the leader of Libya’s rebel opposition on Wednesday and said in a statement afterward that the opposition was “an important dialogue partner,” the latest in a series of Chinese moves to improve ties to the opposition. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/22/world/CHINA_span/CHINA-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/22/world/CHINA_span/CHINA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/22/world/CHINA_span/CHINA-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/22/world/CHINA_span/CHINA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/22/world/CHINA_span/CHINA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'China Moves Closer to Libyan Opposition', 'kicker': None, 'content_kicker': None, 'print_headline': 'China Moves Closer to Libyan Opposition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jibril, Mahmoud', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Libya', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T13:23:20+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Keith Bradsher', 'person': [{'firstname': 'Keith', 'middlename': None, 'lastname': 'Bradsher', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/749b3482-1151-5779-87bd-23ed74574e30', 'word_count': 573, 'uri': 'nyt://article/749b3482-1151-5779-87bd-23ed74574e30'}, {'abstract': 'Mr. Hanks – or, as he is referred to repeatedly in this video, Tomasito – gamely makes a guest appearance on the Spanish-language television network despite his lack of language skills.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/22/cast-away-tom-hanks-spends-a-morning-at-univisions-despierta-america/', 'snippet': 'Mr. Hanks – or, as he is referred to repeatedly in this video, Tomasito – gamely makes a guest appearance on the Spanish-language television network despite his lack of language skills.', 'lead_paragraph': 'This is how it goes in Hollywood: One day you’re the two-time Academy Award-winning star of “Philadelphia” and “Forrest Gump”; the next, you’re a backup dancer to a TV weather reporter. Demonstrating that he is America’s sweetheart in any language, Tom Hanks – or, as he is referred to repeatedly in the above clip, Tomasito – turned up on Tuesday morning at Univision, the Spanish-language television network. He was there, presumably, to promote his new movie, “Larry Crowne,” but the result was more like the real-life equivalent of a “Saturday Night Live” skit as Mr. Hanks gamely interacted with the cast of “Despierta America” despite his lack of language skills. (But he is, as you may recall from “Big,” a surprisingly competent dancer.) We were pointed to this scene by The Daily What; you can also see Mr. Hanks eat a hot chile on a cooking segment here.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cast Away: Tom Hanks Spends a Morning at Univision’s ‘Despierta America’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Spanish Language', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hanks, Tom', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Univision', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-22T13:28:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/945c3b89-e068-599d-b715-3e1d8607d392', 'word_count': 148, 'uri': 'nyt://article/945c3b89-e068-599d-b715-3e1d8607d392'}, {'abstract': 'Ready for a tour of some of the ins-and-outs of conflict reporting in the Internet Age? C.J. Chivers offers quite a ride.', 'web_url': 'https://atwar.blogs.nytimes.com/2011/06/22/following-up-part-ii-down-the-rabbit-hole-arms-exports-and-qaddafis-cluster-bombs/', 'snippet': 'Ready for a tour of some of the ins-and-outs of conflict reporting in the Internet Age? C.J. Chivers offers quite a ride.', 'lead_paragraph': 'Over the next few days, At War will try something different, and allow readers to look over our shoulders on an unusual reporting and verification adventure, and to journey with us on the follow-up on the attacks with cluster munitions in Misurata, Libya. Ready for a tour of some of the ins-and-outs of conflict reporting in the Internet Age? Then come along for a bit of a ride.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Following Up, Part 2.  Down the Rabbit Hole: Arms Exports and Qaddafi’s Cluster Bombs', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cluster Munitions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'AMNESTY INTERNATIONAL', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Human Rights Watch', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'North Atlantic Treaty Organization', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Libya', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-06-22T13:29:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By C. J. Chivers', 'person': [{'firstname': 'C.', 'middlename': 'J.', 'lastname': 'Chivers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/46037bad-6e4e-52c3-b06d-bd7373e7ce81', 'word_count': 2097, 'uri': 'nyt://article/46037bad-6e4e-52c3-b06d-bd7373e7ce81'}, {'abstract': 'Highlights from the DealBook newsletter.', 'web_url': 'https://dealbook.nytimes.com/2011/06/22/morning-take-out-270/', 'snippet': 'Highlights from the DealBook newsletter.', 'lead_paragraph': 'TOP STORIES', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Take-Out', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-22T13:31:34+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'ori