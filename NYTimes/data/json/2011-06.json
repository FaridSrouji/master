 'A Welcome Silence', 'kicker': 'Editorial | the Rural Life', 'content_kicker': None, 'print_headline': 'A Welcome Silence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ears and Hearing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rural Areas', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-20T01:35:08+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Verlyn Klinkenborg', 'person': [{'firstname': 'Verlyn', 'middlename': None, 'lastname': 'Klinkenborg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/d5d583d8-8902-5534-aab5-7ece4e731a60', 'word_count': 323, 'uri': 'nyt://article/d5d583d8-8902-5534-aab5-7ece4e731a60'}, {'abstract': 'College rodeo athletes aren’t prohibited from riding for prize money in their spare time.', 'web_url': 'https://www.nytimes.com/2011/06/20/sports/astride-rodeos-professional-and-amateur-worlds.html', 'snippet': 'College rodeo athletes aren’t prohibited from riding for prize money in their spare time.', 'lead_paragraph': 'CASPER, Wyo. — JR Vezain leads a double life that many young athletes might envy. A top contender to be the Professional Rodeo Cowboy Association’s rookie of the year, he also recently completed his freshman year as a full-time college student on an athletic scholarship.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/20/sports/YRODEO4/YRODEO4-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/20/sports/YRODEO4/YRODEO4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'ur