r', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d435051a-7493-54bd-bdb3-38f69796ae65', 'word_count': 634, 'uri': 'nyt://article/d435051a-7493-54bd-bdb3-38f69796ae65'}, {'abstract': 'Mr. Christie was photographed stepping off a blue and yellow New Jersey State Police helicopter at St. Joseph Regional High School in Montvale, where the school’s baseball team played Delbarton, the team the governor’s son plays for.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/06/01/christie-takes-state-copter-to-sons-ballgame/', 'snippet': 'Mr. Christie was photographed stepping off a blue and yellow New Jersey State Police helicopter at St. Joseph Regional High School in Montvale, where the school’s baseball team played Delbarton, the team the governor’s son plays for.', 'lead_paragraph': 'New Jersey Gov. Chris Christie hopped in a state helicopter on Tuesday afternoon and headed for an event that is not exactly considered important business: His son’s baseball game.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Christie Takes State Copter to Son’s Ballgame', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Budgets and Budgeting', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Helicopters', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Corzine, Jon S', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Patch.com', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-01T04:27:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': "By Anahad O'Connor", 'person': [{'firstname': 'Anahad', 'middlename': None, 'l