://article/7a02f2d1-bdc4-5b09-b447-a2a6d7f9678a'}, {'abstract': 'Mountain View, home to technology kingpins like Google, illustrates the disconnect between the current technology boom and the daily economic realities of many in Silicon Valley.', 'web_url': 'https://www.nytimes.com/2011/06/05/us/05bcmountainview.html', 'snippet': 'Mountain View, home to technology kingpins like Google, illustrates the disconnect between the current technology boom and the daily economic realities of many in Silicon Valley.', 'lead_paragraph': 'At the Google campus on the outskirts of Mountain View, employees sip lattes under brightly colored umbrellas as others pass on company bicycles, laptops secured in the front baskets. This year the company will add substantially to its work force of more than 5,000 in that Silicon Valley city, and it has just leased nine acres to expand its campus.', 'print_section': 'A', 'print_page': '29A', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/05/us/05BCMOUNTAINVIEW2/05BCMOUNTAINVIEW2-jumbo.jpg', 'height': 1024, 'width': 711, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/05/us/05BCMOUNTAINVIEW2/05BCMOUNTAINVIEW2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/05/us/05BCMOUNTAINVIEW2/05BCMOUNTAINVIEW2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Mountain View, 2 Contrasting Economic Worlds Intersect', 'kicker': 'The Bay Citizen', 'content_kicker': None, 'print_headline': 'In Mountain View, 2 Contrasting Economic Worlds Intersect', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Mou