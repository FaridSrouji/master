_count': 1694, 'uri': 'nyt://article/a7fb174d-5733-555f-bcea-7e29738b8ea6'}, {'abstract': 'Soldiers and civilians protested the dismissal of the prime minister, whom many considered the country’s most capable politician.', 'web_url': 'https://www.nytimes.com/2011/06/10/world/africa/10somalia.html', 'snippet': 'Soldiers and civilians protested the dismissal of the prime minister, whom many considered the country’s most capable politician.', 'lead_paragraph': 'JOHANNESBURG — After months of feuding, Somalia’s bickering leaders on Thursday agreed on a compromise that extends the transitional government for one more year but, at the same time, led to the dismissal of the popular prime minister.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/10/world/africa/10somalia/10somalia-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/10/world/africa/10somalia/10somalia-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/10/world/africa/10somalia/10somalia-jumbo.jpg', 'height': 752, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/10/world/africa/10somalia/10somalia-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/10/world/africa/10somalia/10somalia-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Somalia Extends Government; Premier Fired', 'kicker': None, 'content_kicker': None, 'print_headline': 'Somalia Extends Government; Premier Fired', 'name': None, 'seo': None, 'su