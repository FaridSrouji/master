-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/12/business/Boss/Boss-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Out of Cuba, With a Suitcase', 'kicker': 'The Boss', 'content_kicker': None, 'print_headline': 'Out of Cuba, With a Suitcase', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cruises', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Oceania Cruises', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Executives and Management', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-11T16:59:19+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Job Market', 'byline': {'original': 'By Frank Del Rio', 'person': [{'firstname': 'Frank', 'middlename': 'Del', 'lastname': 'Rio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5df433c-52e2-5108-8504-1525ab792222', 'word_count': 645, 'uri': 'nyt://article/e5df433c-52e2-5108-8504-1525ab792222'}, {'abstract': 'Two new Web sites aim to make traveling a more social event.', 'web_url': 'https://intransit.blogs.nytimes.com/2011/06/11/two-new-web-sites-aim-to-connect-travelers/', 'snippet': 'Two new Web sites aim to make traveling a more social event.', 'lead_paragraph': 'Two new Web sites aim to make traveling a more social event. Both sites — triptrotting.com and igottaguide.com — combine travel with elements of social media, connecting members based on common interests. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Two New Web Sites Aim to Connect Travelers', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}