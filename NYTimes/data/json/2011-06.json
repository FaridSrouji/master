5ed26b9ff', 'word_count': 237, 'uri': 'nyt://article/16b19b6c-3a2b-5029-bdb0-fc75ed26b9ff'}, {'abstract': 'It is supply — the huge number of students seeking full-time work — that drives the labor markets in the summer, rather than demand, an economist writes.', 'web_url': 'https://economix.blogs.nytimes.com/2011/06/08/labor-supply-always-matters/', 'snippet': 'It is supply — the huge number of students seeking full-time work — that drives the labor markets in the summer, rather than demand, an economist writes.', 'lead_paragraph': 'Casey B. Mulligan is an economics professor at the University of Chicago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Labor Supply Always Matters', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Keynes, John Maynard', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-08T10:00:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Casey B. Mulligan', 'person': [{'firstname': 'Casey', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5d5fcd4-bc1e-5321-b138-d3a537281cab', 'word_count': 919, 'uri': 'nyt://article/c5d5fcd4-bc1e-5321-b138-d3a537281cab'}, {'abstract': 'Episodes of mass delusion across the centuries.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/06/08/the-monsters-among-us/', 'snippet': 'Episodes of mass delusion across the centuries.', 'lead_paragraph': 'I’ve seen at least two reviews recently for “Monsters of the Gévaudan: The Making of a Beast,” the new book by Jay M. Smith that recounts the panic in the French countryside in 1764 and 1765 over a creature that killed sheep, women and 