 of dollars a year promoting their products to doctors, have found that it is very useful to know what drugs a doctor has prescribed in the past. Many use data collected from prescriptions processed by pharmacies — a doctor’s name, the drugs and the dosage — to refine their marketing practices and increase sales. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Drug Marketing and Free Speech', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Drug Marketing and Free Speech', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Consumer Protection', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'First Amendment (US Constitution)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-24T02:14:29+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/af078752-2eec-545f-8d31-55bdeb37a4c5', 'word_count': 277, 'uri': 'nyt://article/af078752-2eec-545f-8d31-55bdeb37a4c5'}, {'abstract': 'A letter to the editor regarding assistance to military women who are the victims of sexual assault.', 'web_url': 'https://www.nytimes.com/2011/06/24/opinion/l24kristof.html', 'snippet': 'A letter to the editor regarding assistance to military women who are the victims of sexual assault.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Welfare of Military Women', 'kicker': 'Letters', 'content_kicker