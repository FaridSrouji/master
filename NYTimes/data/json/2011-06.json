: 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/608d9f91-e7da-52db-ba43-f1cee8fe088d', 'word_count': 231, 'uri': 'nyt://article/608d9f91-e7da-52db-ba43-f1cee8fe088d'}, {'abstract': 'Kevin O’Hare, the company’s administrative director, will take over next year.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/14/royal-ballet-names-new-artistic-director/', 'snippet': 'Kevin O’Hare, the company’s administrative director, will take over next year.', 'lead_paragraph': 'The speculation has been incessant, but on Tuesday morning the Royal Ballet in London put an end to the chatter about who will take over once its current artistic director, Monica Mason, steps down in July next year. It will be Kevin O’Hare, a former principal dancer with the Birmingham Royal Ballet who has been steadily making his way up the Royal Ballet’s hierarchy since his retirement from the stage in 2000. He joined as company manager in 2004 and became administrative director in 2009. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Royal Ballet Names New Artistic Director', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mason, Monica', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wheeldon, Christopher', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Royal Ballet', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-14T15:13:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reporte