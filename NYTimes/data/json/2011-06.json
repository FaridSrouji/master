': [], 'headline': {'main': 'No BELL Prize', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-05T20:14:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80be4cc8-c94e-5f3f-a5b3-469cdaeeade7', 'word_count': 71, 'uri': 'nyt://article/80be4cc8-c94e-5f3f-a5b3-469cdaeeade7'}, {'abstract': 'Unkillable falsehoods.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/06/05/health-care-zombies/', 'snippet': 'Unkillable falsehoods.', 'lead_paragraph': 'I actually first encountered the term “zombie lies” with regard to Canadian health care, where false beliefs — like the one about hordes of Canadians heading to America for care, which is completely untrue — just keep coming back, no matter how many times they’re killed by evidence.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Health Care Zombies', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-06-05T20:47:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7556bc8d-0207-5c2d-9018-d071ed1ff05e', 'word_count': 197, 'uri': 'nyt://article/7556bc8d-0207-5c2d-9018-d071ed1ff05e'}, {'abstract': 'A career as an entertainer drew Justin Timberlake to golf, a sport that he plays with passion and expertise.', 'web_url': 'https://onpar.blogs.nytimes.com/2011/06/05/in-golf-justin-timberlake-sees-metaphors-for-life/', 'snippet': 'A career as an entertainer drew Justin Timberlake to golf, a sport that he plays with passion and expertise.', 'lead_paragraph': 'Justin Timberlake does not moonwalk, or dance at all, after making a birdie putt on the golf course.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Golf, Justin Timberlake Sees Metaphors for Life', 'kicker': 'On Par', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Timberlake, Justin', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-05T20:59:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Bill Pennington', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Pennington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6c235a2-f2e5-5199-a2b0-5af94814b327', 'word_count': 960, 'uri': 'nyt://article/f6c235a2-f2e5-5199-a2b0-5af94814b327'}, {'abstract': 'On Par columnist Bill Pennington hits a Brooklyn golf course with entertainer Justin Timberlake.', 'web_url': 'https://www.nytimes.com/video/sports/100000000848537/teeing-off-with-justin-timberlake.html', 'snippet': 'On Par columnist Bill Pennington hits a Brooklyn golf course with entertainer Justin Timberlake.', 'lead_paragraph': 'On Par columnist Bill Pennington hits a Brooklyn golf course with entertainer Justin Timberlake.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/06/sports/video-onpartimberlake/video-onpartimberlake-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xl