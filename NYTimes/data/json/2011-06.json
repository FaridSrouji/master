ion': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/sports/08nba-1/08nba-1-jumbo.jpg', 'height': 1024, 'width': 745, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/sports/08nba-1/08nba-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/sports/08nba-1/08nba-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Finally in Finals, Two Former Kings Recall 2002', 'kicker': None, 'content_kicker': None, 'print_headline': 'Finally in Finals, Two Former Kings Recall 2002', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Mavericks', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bibby, Mike', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Heat', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Stojakovic, Peja', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Sacramento Kings', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-06-08T00:04:08+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Howard Beck', 'person': [{'firstname': 'Howard', 'middlename': None, 'lastname': 'Beck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2745f7f4-c45a-549a-ac12-1274c9e58fb9', 'word_count': 973, 'uri': 'nyt://article/2745f7f4-c45a-549a-ac12-1274c9e58fb9'}, {'abstract': 'William Toye, a self-taught artist with a remarkable career, made a reluctant admission in court.', 'web_url': 'https://www.nytimes.com/2011/06/08/us/08forgery.html', 'snippet': 'William Toye, a self-taught artist with a remarkable career, made a reluctant admission in court.', 'lead_paragraph': 'LAFAYETTE, La. — This is expected to be a formality, one of the lawyers said, a simple affirmation of what has already been put on paper. The courtroom was mostly empty but for a few lawyers and federal agents and a handful of journalists and onlookers who had followed the case with cultish fascination. ', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/us/FORGERY-1/FORGERY-1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/08/us/FORGERY-1/FORGERY-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/us/FORGERY-1/FORGERY-1-jumbo.jpg', 'height': 636, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/us/FORGERY-1/FORGERY-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/us/FORGERY-1/FORGERY-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For a Longtime Forger, Adding One Last Touch', 'kicker': None, 'content_kicker': None, 'print_headline': 'For a Longtime Forger, Adding One Last Touch', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New Orleans (La)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-08T00:17:40+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Campbell Robertson', 'person': [{'firstname': 'Campbell', 'middlename': None, 'lastname': 'Robertson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45bb1059-2104-5276-aeee-28894aff4e75', 'word_count': 1173, 'uri': 'nyt://article/45bb1059-2104-5276-aeee-28894aff4e75'}, {'abstract': 'How we might avoid more frightening outbreaks of E. coli.', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/06/07/e-coli-dont-blame-the-sprouts/', 'snippet': 'How we might avoid more frightening outbreaks of E. coli.', 'lead_paragraph': 'One hundred thousand E. coli can dance on the head of a pin; it may only take 50 to make you sick enough to die. Benign E. coli are everywhere, even in your own pink gut right now, and all E. coli can live on (or in) things as different as sprouts, burgers and water. But if you were able to trace back far enough, their reservoir is most likely the gut of mammal: a goat, a sheep, a deer, even a majestic elk or a dog. They’re most often associated with cows.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'E. Coli: Don’t Blame the Sprouts!', 'kicker': 'Mark Bittman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'E Coli (Bacteria)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food Contamination and Poisoning', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sprouts (Seed)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-08T00:30:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/748d6c0c-d5fc-549c-83b5-2f40ad61a3e1', 'word_count': 1135, 'uri': 'nyt://article/748d6c0c-d5fc-549c-83b5-2f40ad61a3e1'}, {'abstract': 'Ethics hardly seems the right discipline for the matter of Representative Anthony D. Weiner. Psychiatry might help.', 'web_url': 'https://www.nytimes.com/2011/06/08/nyregion/punishment-or-therapy-for-a-fool-in-queens.html', 'snippet': 'Ethics hardly seems the right discipline for the matter of Representative Anthony D. Weiner. Psychiatry might help.', 'lead_paragraph': 'The matter of Anthony D. Weiner, unclothed congressman, is being lodged by Democratic Party elders with the House ethics committee, a holding room where it will remain until either it, or he, goes away.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ethics Case for Weiner? Maybe One of Psychiatry', 'kicker': 'About New York', 'content_kicker': None, 'print_headline': 'Punish Weiner? Or Advise Therapy?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ethics (Institutional)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weiner, Anthony D', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-08T00:35:26+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Jim Dwyer', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Dwyer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/09e3be25-65ae-5943-ab09-f098d5c4e3fd', 'word_count': 665, 'uri': 'nyt://article/09e3be25-65ae-5943-ab09-f098d5c4e3fd'}, {'abstract': 'Children of first-generation immigrant entrepreneurs are bringing their own families’ food businesses to a public hungry for the real thing.', 'web_url': 'https://www.nytimes.com/2011/06/08/dining/based-on-an-old-family-recipe.html', 'snippet': 'Children of first-generation immigrant entrepreneurs are bringing their own families’ food businesses to a public hungry for the real thing.', 'lead_paragraph': 'A COUPLE of years ago, Jason Wang graduated from Washington University in St. Louis with a bachelor’s degree in business. At the moment, he is dishing out spicy hand-cut rice noodles in a narrow storefront in the East Village, and seems pretty thrilled about his career path.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/dining/Generations-span/Generations-span-articleLarge-v2.jpg', 'height': 260, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/08/dining/Generations-span/Generations-span-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 260}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/dining/Generations-span/Generations-span-jumbo-v2.jpg', 'height': 260, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/08/dining/Generations-span/Generations-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/08/dining/Generations-span/Generations-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Based on an Old Family Recipe', 'kicker': None, 'content_kicker': None, 'print_headline': 'Based on an Old Family Recipe', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Chinese-Americans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-08T00:39:13+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By STEVEN STERN', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'STERN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0c361ae4-1837-51ab-9045-e68d061caa1c', 'word_count': 1952, 'uri': 'nyt://article/0c361ae4-1837-51ab-9045-e68d061caa1c'}, {'abstract': 'We are in denial about the severity of the climate crisis and just how big of a response is going to be needed.', 'web_url': 'https://www.nytimes.com/2011/06/08/opinion/08friedman.html', 'snippet': 'We are in denial about the severity of the climate crisis and just how big of a response is going to be needed.', 'lead_paragraph': 'You really do have to wonder whether a few years from now we’ll look back at the first decade of the 21st century — when food prices spiked, energy prices soared, world population surged, tornados plowed through cities, floods and droughts set records, populations were displaced and governments were threatened by the confluence of it all — and ask ourselves: What were we thinking? How did we not panic when the evidence was so obvious that we’d crossed some growth/climate/natural resource/population redlines all at once?', 'print_section': 'A', 'print_page': '23', 'sourc