e': 'image', 'url': 'images/2011/06/11/arts/cook/cook-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/11/arts/cook/cook-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/11/arts/cook/cook-jumbo.jpg', 'height': 656, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Looking Back on Love and Loss, With an Eye on More to Come', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Looking Back on Love and Loss, With an Eye on More to Come', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cook, Barbara', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-10T22:44:23+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/818609e7-5d5d-5160-8154-a788c309ac4c', 'word_count': 510, 'uri': 'nyt://article/818609e7-5d5d-5160-8154-a788c309ac4c'}, {'abstract': 'What didn’t get in the magazine this week.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/06/10/this-sunday-whats-not-in-the-magazine/', 'snippet': 'What didn’t get in the magazine this week.', 'lead_paragraph': 'If you’re doing your job as a magazine editor, there’s a lot of wonderful stuff readers never get to see — because there isn’t room. This applies especially to photography. The editing process can break your heart. For a single feature, we’ll sometimes look at hundreds of pictures, leaving many great ones on the cutting-room floor. So for this editor’s note on an issue filled with spectacular pictures, I asked the photography department to pick a few images they loved that did not make the print edition of our “Voyages in America” special issue. If you click on the headline, it’ll take you to the story.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Sunday: What’s Not in the Magazine', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Canals', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ANDERSON, CHRIS', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Salgado, Sebastiao', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Walt Disney Company', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ALASKA', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-10T22:44:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Hugo Lindgren', 'person': [{'firstname': 'Hugo', 'middlename': None, 'lastname': 'Lindgren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d3d90e3f-ff9c-5e42-a752-14b066b8f0e5', 'word_count': 135, 'uri': 'nyt://article/d3d90e3f-ff9c-5e42-a752-14b066b8f0e5'}, {'abstract': 'Kate Weare brings her four-person troupe and one premiere work to the Gotham Dance Festival at the Joyce.', 'web_url': 'https://www.nytimes.com/2011/06/11/arts/dance/kate-weare-and-company-at-joyce-theater-review.html', 'snippet': 'Kate Weare brings her four-person troupe and one premiere work to the Gotham Dance Festival at the Joyce.', 'lead_paragraph': 'Kate Weare creates terrifically satisfying dance phrases. And her fine company of four (Adrian Clark, Douglas Gillespie, Leslie Kraus and herself) brings these steps to full, luscious life.', 'print_section': 'C',