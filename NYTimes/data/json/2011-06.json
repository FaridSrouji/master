inal': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4dd3aaab-db4d-551d-b451-8f1e10c46049', 'word_count': 853, 'uri': 'nyt://article/4dd3aaab-db4d-551d-b451-8f1e10c46049'}, {'abstract': 'The show will now run through June 24.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/06/09/an-extra-week-for-lysistrata-jones/', 'snippet': 'The show will now run through June 24.', 'lead_paragraph': 'The Off Broadway production of “Lysistrata Jones,” the musical marriage of ancient Greece and high school basketball, has extended performances for one week, its producer said on Thursday, after opening to strong reviews from theater critics. The show, with a book by Douglas Carter Beane (“Sister Act”) and music and lyrics by Lewis Flinn, will now end its limited engagement on June 24. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Extra Week for ‘Lysistrata Jones’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Beane, Douglas Carter', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cummings, Jack III', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Judson Memorial Church', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Transport Group', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich Village (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-06-09T20:41:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization