eywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defense of Marriage Act (1996)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-19T02:42:34+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Sheryl Gay Stolberg', 'person': [{'firstname': 'Sheryl', 'middlename': 'Gay', 'lastname': 'Stolberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c85708c2-a8a0-5fa8-8a8f-b60e3d626ee8', 'word_count': 1159, 'uri': 'nyt://article/c85708c2-a8a0-5fa8-8a8f-b60e3d626ee8'}, {'abstract': 'Katy Perry’s kewpie-doll smiles, on display at the Nassau Coliseum on Friday night, are camouflage to keep parents from worrying.', 'web_url': 'https://www.nytimes.com/2011/06/19/arts/music/at-katy-perry-show-cotton-candy-and-giggles-coat-the-raunch.html', 'snippet': 'Katy Perry’s kewpie-doll smiles, on display at the Nassau Coliseum on Friday night, are camouflage to keep parents from worrying.', 'lead_paragraph': 'Katy Perry shrewdly polled her sold-out audience — at least 85 percent female, young and eager to scream — at Nassau Coliseum on Friday night. She asked who had just graduated from college, high school and junior high, and junior high won, decisively. That may be why Ms. Perry made her concert all bright colors, candy-shaped scenery and wide-eyed, kewpie-doll smiles. It was camouflage to keep parents from worrying. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/sports/19perry-1/19perry-1-articleLarge.jpg', 'height': 353, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/19/sports/19perry-1/19perry-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 353}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/sports/19perry-1/19perry-1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/sports/19perry-1/19perry-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/19/sports/19perry-1/19perry-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Cotton Candy and Giggles Coat the Raunch', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Cotton Candy and Giggles Coat the Raunch', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Nassau Coliseum', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Katy', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-19T02:44:21+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fdeb57e9-133c-5617-ab1c-38bb6cc72a95', 'word_count': 479, 'uri': 'nyt://article/fdeb57e9-133c-5617-ab1c-38bb6cc72a95'}, {'abstract': 'The pilot of a single-engine plane made a descent toward the airport runway in Armonk, N.Y., but hit the ground too early, a spokeswoman for the F.A.A. said.', 'web_url': 'https://www.n