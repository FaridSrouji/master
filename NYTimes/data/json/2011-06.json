8f1a960', 'word_count': 0, 'uri': 'nyt://video/4bff0665-2cfa-5280-8f42-87c7d8f1a960'}, {'abstract': 'After selling their 3,000-square-foot house in Denver, Jeff Kwong and Bob Moriarty went looking for a one-bedroom in a dog-friendly building.', 'web_url': 'https://www.nytimes.com/2011/06/19/realestate/a-big-time-dose-of-downsizing-the-hunt.html', 'snippet': 'After selling their 3,000-square-foot house in Denver, Jeff Kwong and Bob Moriarty went looking for a one-bedroom in a dog-friendly building.', 'lead_paragraph': 'DOWNSIZING was both necessary and welcome for Jeff Kwong and Bob Moriarty when they moved to New York from Denver. Their four-story 3,000-square-foot Denver house had three bedrooms, four bathrooms and three fireplaces. It was far too large for two men and a dog. ', 'print_section': 'RE', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/realestate/HUNT-1-SUB/HUNT-1-SUB-jumbo.jpg', 'height': 872, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/19/realestate/HUNT-1-SUB/HUNT-1-SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/19/realestate/HUNT-1-SUB/HUNT-1-SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Big-Time Dose of Downsizing', 'kicker': 'The Hunt', 'content_kicker': None, 'print_headline': 'A Big-Time Dose of Downsizing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Housing and Real Estate', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-06-16T21:51:04+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Joyce Cohen', 'person': [{'firstname': 'Joyce', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2aa18d0a-ce83-5539-aa18-9154136a846a', 'word_count': 1209, 'uri': 'nyt://article/2aa18d0a-ce83-5539-aa18-9154136a846a'}, {'abstract': '“El Museo’s Bienal: The (S) Files 2011,” a survey of new Latino, Caribbean and Latin American art, includes 75 artists and their street art.', 'web_url': 'https://www.nytimes.com/2011/06/17/arts/design/el-museos-bienal-the-s-files-2011-review.html', 'snippet': '“El Museo’s Bienal: The (S) Files 2011,” a survey of new Latino, Caribbean and Latin American art, includes 75 artists and their street art.', 'lead_paragraph': 'Because of a long renovation of El Museo del Barrio’s Fifth Avenue building, four years have passed since the museum’s last “bi-annual” survey of new Latino, Caribbean and Latin American art. As if to make up for lost time, the new edition is the biggest so far. It includes work by 75 artists spread over seven shows in four boroughs, with the main event at El Museo itself.', 'print_section': 'C', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/17/arts/17museo-span/17museo-span-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/17/arts/17museo-span/17museo-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/17/arts/17museo-span/MUSEO-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'i