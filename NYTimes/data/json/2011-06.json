acy': {'thumbnail': 'images/2011/06/02/sports/y-mavericks/y-mavericks-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Dallas Hopes Nowitzki Can Play Through Pain', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dallas Hopes Nowitzki Can Play Through Pain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Nowitzki, Dirk', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Mavericks', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Terry, Jason', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Heat', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-06-02T00:55:36+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Jonathan Abrams', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Abrams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2856f926-8947-5aac-8f9f-8c1379f72566', 'word_count': 726, 'uri': 'nyt://article/2856f926-8947-5aac-8f9f-8c1379f72566'}, {'abstract': 'In Florida, the summer’s first big beach weekend could be summed up by the word “Ouch!” as a mauve stingers claimed 10 miles of beach in time for Memorial Day.', 'web_url': 'https://www.nytimes.com/2011/06/02/science/earth/02jellyfish.html', 'snippet': 'In Florida, the summer’s first big beach weekend could be summed up by the word “Ouch!” as a mauve stingers claimed 10 miles of beach in time for Memorial Day.', 'lead_paragraph': 'COCOA BEACH, Fla. — They swarmed the beach, taking control of prime holiday sand and surf like a group of marauding spring breakers. Then, just like that, they vanished, leaving behind the damage: spoiled vacations, red welts, heaps of annoyance, discarded containers of vinegar and Benadryl and a crew of exhausted lifeguards.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/02/us/JELLYFISH_337-Span/JELLYFISH-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/02/us/JELLYFISH_337-Span/JELLYFISH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/02/us/JELLYFISH_337-Span/JELLYFISH-jumbo.jpg', 'height': 624, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/02/us/JELLYFISH_337-Span/JELLYFISH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/02/us/JELLYFISH_337-Span/JELLYFISH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Small but Innumerable, Jellyfish Storm a Beach', 'kicker': 'Cocoa Beach Journal', 'content_kicker': None, 'print_headline': 'Small but Innumerable, Jellyfish Storm a Beach', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jellyfish', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Beaches', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-02T00:57:00+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'subsection_name': 'Environment', 'bylin