rk Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/02/arts/video-ab-06302011/video-ab-06302011-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/06/02/arts/video-ab-06302011/video-ab-06302011-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/02/arts/video-ab-06302011/video-ab-06302011-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/02/arts/video-ab-06302011/video-ab-06302011-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Artsbeat - June 30, 2011', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Cirque du Soleil', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Asian-Americans', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ANIMATED FILMS', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Film Society of Lincoln Center', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Japan Society', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 9, 'major': 'N'}], 'pub_date': '2011-06-30T19:46:33+0000', 'document_type': 'multimedia', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'Adam B. Ellick', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/f78454ea-694c-5e48-9667-27762e72bd60', 'word_count': 0, 'uri': 'nyt://video/f78454ea-694c-5e48-9667-27762e72bd60'}, {'abstract': 'Anthony Vaccarello has been named this year’s winner of the ANDAM Fashion Award, the French equivalent of the Council of Fashion Designers of America prize.', 'web_url': 'https://runway.blogs.nytimes.com/2011/06/30/honors-from-a-french-jury/', 'snippet': 'Anthony Vaccarello has been named this year’s winner of the ANDAM Fashion Award, the French equivalent of the Council of Fashion Designers of America prize.', 'lead_paragraph': 'Anthony Vaccarello has a new accolade to add to his list of accomplishments. The 31-year-old Belgian designer has been named this year’s winner of the ANDAM Fashion Award, the French equivalent of the Council of Fashion Designers of America prize. He follows in the footsteps of past winners who include Giles Deacon, Gareth Pugh, Viktor Horsting and Rolf Snoeren of Viktor & Rolf, and Martin Margiela. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Honors From a French Jury', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-06-30T19:51:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Jessica Michault', 'person': [{'firstname': 'Jessica', 'middlename': None, 'lastname': 'Michault', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/34b49749-f9eb-5e77-9531-9102e5b603b2', 'word_count': 266, 'uri': 'nyt://article/34b49749-f9eb-5e77-9531-9102e5b603b2'}, {'abstract': 'An assailant grabbed President Nicolas Sarkozy of France by the shoulder on Thursday as he met local residents in the southwestern French town of Brax.', 'web_url': 'https://www.nytimes.com/2011/07/01/world/europe/01iht-sarkozy01.html', 'snippet': 'An assailant grabbed President Nicolas Sarkozy of France by the shoulder on Thursday as he met local residents in the southwestern French town of Brax.', 'lead_paragraph': 'PARIS — President Nicolas Sarkozy of France was rubbing shoulders with voters Thursday when one of them literally grabbed his, violently yanking his suit collar, and would have been pulled to the ground had it not been for a metal barricade that caught his fall.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sarkozy Is Assaulted as He Meets Voters', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'France: President Assaulted by Voter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'France', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sarkozy, Nicolas', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Assaults', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-06-30T19:53:28+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Katrin Bennhold', 'person': [{'firstname': 'Katrin', 'middlename': None, 'lastname': 'Bennhold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/6a78f4e9-cf08-5d56-b26a-423324ddccc5', 'word_count': 656, 'uri': 'nyt://article/6a78f4e9-cf08-5d56-b26a-423324ddccc5'}, {'abstract': 'Maria Sharapova, a former Wimbledon champion, defeated Sabine Lisicki, and Petra Kvitova reached her first Grand Slam final by ousting Victoria Azarenka.', 'web_url': 'https://www.nytimes.com/2011/07/01/sports/tennis/wimbledon-sharapova-to-meet-kvitova-in-womens-final.html', 'snippet': 'Maria Sharapova, a former Wimbledon champion, defeated Sabine Lisicki, and Petra Kvitova reached her first Grand Slam final by ousting Victoria Azarenka.', 'lead_paragraph': 'WIMBLEDON, England — There were some strange twists on Centre Court on Thursday. The women’s semifinalist with by far the most experience at this heady stage of a Grand Slam tournament was the shakiest at the start. The match that deserved to end with a double fault did not, but the other did. ', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/sports/y-women-2/y-women-2-articleLarge.jpg', 'height': 340, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/01/sports/y-women-2/y-women-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 340}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/sports/y-women-2/y-women-2-jumbo.jpg', 'height': 579, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/01/sports/y-women-2/y-women-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/01/sports/y-women-2/y-women-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Former Champion and New Face in the Final', 'kicker': None, 'content_kicker': None, 'print_headline': 'Former Champion and New Face in the Final', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sharapova, Maria', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kvitova, Petra', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wimbledon Tennis Tournament', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lisicki, Sabine', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-06-30T19:53:29+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Christopher Clarey', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Clarey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/19b1db87-86a9-5a93-896b-aa00ea0552f2', 'word_count': 895, 'uri': 'nyt://article/19b1db87-86a9-5a93-896b-aa00ea0552f2'}, {'abstract': 'In a vote of 94-0, the Senate confirmed Gen. David H. Petraeus’s nomination as intelligence chief.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/06/30/senate-confirms-petraeus-to-c-i-a/', 'snippet': 'In a vote of 94-0, the Senate confirmed Gen. David H. Petraeus’s nomination as intelligence chief.', 'lead_paragraph': 'In a vote of 94-to-0, the Senate confirmed Gen. David H. Petraeus’s nomination to serve as director of the Central Intelligence Agency on Thursday. General Petraeus, the architect of counter-insurgency strategies in Iraq and Afghanistan, will succeed Leon E. Panetta, who is in turn taking over for Robert M. Gates at the Pentagon.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Senate Confirms Petraeus to C.I.A.', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Petraeus, David H', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-06-30T19:57:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politic