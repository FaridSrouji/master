s_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By David Barboza and Azam Ahmed', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Barboza', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Azam', 'middlename': None, 'lastname': 'Ahmed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/defac954-1de0-5c1b-900a-16902057aa22', 'word_count': 1094, 'uri': 'nyt://article/defac954-1de0-5c1b-900a-16902057aa22'}, {'abstract': 'Obama administration officials are clinging to the hope that Bahrain’s leaders — or at least the crown prince — may be willing to undertake democratic changes.', 'web_url': 'https://www.nytimes.com/2011/06/10/world/middleeast/10bahrain.html', 'snippet': 'Obama administration officials are clinging to the hope that Bahrain’s leaders — or at least the crown prince — may be willing to undertake democratic changes.', 'lead_paragraph': 'WASHINGTON — As the Arab Spring grinds into summer, President Obama has turned on repressive Arab governments in different ways and at different speeds. He broke quickly with Col. Muammar el-Qaddafi of Libya and more reluctantly with Hosni Mubarak of Egypt. He slapped sanctions on Bashar al-Assad of Syria and has encouraged a Saudi-led effort to ease Ali Abdullah Saleh out of Yemen.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/10/world/middleeast/10bahrain/10bahrain-jumbo.jpg', 'height': 819, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/10/world/middleeast/10bahrain/10bahrain-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail',