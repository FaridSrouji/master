, {'name': 'organizations', 'value': 'National Football League', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-21T00:38:58+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6885a8f0-3e24-5d3c-9bd6-6cfe451b82ab', 'word_count': 1056, 'uri': 'nyt://article/6885a8f0-3e24-5d3c-9bd6-6cfe451b82ab'}, {'abstract': 'Mr. McKenzie’s 1967 ballad “San Francisco (Be Sure to Wear Flowers in Your Hair)” became a defining hit for the counterculture generation.', 'web_url': 'https://www.nytimes.com/2012/08/21/arts/music/scott-mckenzie-singer-known-for-san-francisco-dies-at-73.html', 'snippet': 'Mr. McKenzie’s 1967 ballad “San Francisco (Be Sure to Wear Flowers in Your Hair)” became a defining hit for the counterculture generation.', 'lead_paragraph': 'Scott McKenzie, who performed the 1967 ballad “San Francisco (Be Sure to Wear Flowers in Your Hair),” which became a defining hit for the counterculture generation and helped draw tens of thousands to the Haight-Ashbury district for the Summer of Love, died on Saturday at his home in Los Angeles. He was 73.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/21/arts/MCKENZIE-obit/MCKENZIE-obit-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/21/arts/MCKENZIE-obit/MCKENZIE-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/21/arts/MCKENZIE-obit/MCKE