8/04/02/opinion/maureen-dowd/maureen-dowd-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Cruelty Is Cute', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'When Cruelty Is Cute', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rand, Ayn', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Medicare', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-08-15T02:15:00+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Maureen Dowd', 'person': [{'firstname': 'Maureen', 'middlename': None, 'lastname': 'Dowd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e9897b6e-bbe6-576e-8f76-51a6c883f7a5', 'word_count': 856, 'uri': 'nyt://article/e9897b6e-bbe6-576e-8f76-51a6c883f7a5'}, {'abstract': 'A Japanese cabinet member visited a Tokyo war shrine on Wednesday for the first time in three years, a move that could add to already heated exchanges with neighboring South Korea over history.', 'web_url': 'https://www.nytimes.com/2012/08/15/world/asia/japanese-cabinet-member-visits-tokyo-war-shrine.html', 'snippet': 'A Japanese cabinet member visited a Tokyo war shrine on Wednesday for the first time in three years, a move that could add to already heated exchanges with neighboring South Korea over history.', 'lead_paragraph': ' A Japanese cabinet member visited a Tokyo war shrine on Wednesday for the first time in three years, a move that could add to already heated exchanges with neighboring South Korea over history. The visit by Jin Matsubara, the National Public Safety Commission chairman, was the first by a cabinet member to the Yasukuni Shrine since the Democratic Party came to power in 2009 with vows to build closer ties with Asia. Mr. Matsubara, an outspoken conservative, told Kyodo News that he visited the shrine to Japan’s war dead as a private citizen, ignoring a request from Prime Minister Yoshihiko Noda not to go. The visit comes as Tokyo and Seoul have clashed over compensation for World War II-era sex slaves and over disputed islands. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/world/15briefs-Japan_337/15briefs-Japan_337-jumbo.jpg', 'height': 735, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/world/15briefs-Japan_337/15briefs-Japan_337-superJumbo.jpg', 'height': 1469, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/world/15briefs-Japan_337/15briefs-Japan_337-thumbStandard.jpg', 'height': 75, 'width': 75, 'sub