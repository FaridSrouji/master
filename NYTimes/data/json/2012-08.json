12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/sunday-review/19GLOBES/19GLOBES-articleLarge.jpg', 'height': 431, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/19/sunday-review/19GLOBES/19GLOBES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 431}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/sunday-review/19GLOBES/19GLOBES-jumbo.jpg', 'height': 736, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/sunday-review/19GLOBES/19GLOBES-superJumbo.jpg', 'height': 1471, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/sunday-review/19GLOBES/19GLOBES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/sunday-review/19GLOBES/19GLOBES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/sunday-review/19GLOBES/19GLOBES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The World Is Flat, Again', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'The World Is Flat, Again', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Maps', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Geography', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-18T16:19:14+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name':