 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Closing Time', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-13T01:44:25+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/ae3ecebb-2c59-5b2f-805b-aef8084498a7', 'word_count': 0, 'uri': 'nyt://slideshow/ae3ecebb-2c59-5b2f-805b-aef8084498a7'}, {'abstract': 'A Boston Brahmin is dispatched to bring back the dead from the Battle of Cedar Mountain.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/08/12/robert-gould-shaws-gruesome-task/', 'snippet': 'A Boston Brahmin is dispatched to bring back the dead from the Battle of Cedar Mountain.', 'lead_paragraph': 'On Aug. 11, 1862, Robert Gould Shaw arrived in the Virginia town of Culpeper on a grim errand: the young lieutenant was there to accompany the remains of five fellow officers on the first leg of a final journey home to Boston. Before the bullet-ridden corpses were packed for shipment, Shaw carefully clipped a lock of hair from the lifeless head of one body. He repeated the somber act on the others, and put the locks away for safekeeping. He planned to present the keepsakes to mourning friends as a memento mori.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Robert Gould Shaw’s Gruesome Task', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fox, William F', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Shaw, Robert Gould', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-13T01:47:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ronald S. Coddington', 'person': [{'firstname': 'Ronald', 'middlename': 'S.', 'lastname': 'Coddington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6016f452-2ec3-512f-97dc-ecb16d83ff86', 'word_count': 1743, 'uri': 'nyt://article/6016f452-2ec3-512f-97dc-ecb16d83ff86'}, {'abstract': 'A $6 fee that helped reduce driving in the city center was eliminated with a ruling that upheld the appeal of a parking garage that had lost business because of the measure.', 'web_url': 'https://www.nytimes.com/2012/08/13/world/europe/ruling-halts-an-effort-to-reduce-traffic-in-milan.html', 'snippet': 'A $6 fee that helped reduce driving in the city center was eliminated with a ruling that upheld the appeal of a parking garage that had lost business because of the measure.', 'lead_paragraph': 'MILAN — It would seem to go without saying that a measure aimed at reducing traffic in the center of a city would hurt the business of a parking garage there. It would not even seem to be a matter of dispute, much less a court case.', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Effort to Cut Milan Traffic Halted as Court Favors Garage', 'kicker': None, 'content_kicker': None, 'print_headline': 'Effort to Cut Milan Traffic Halted as Court Favors Garage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Mediolanum Parking', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parking Garages and Lots', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Roads and Tr