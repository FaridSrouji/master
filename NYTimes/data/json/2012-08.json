.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Yankees Rely on Small Ball, Not Long Ball', 'kicker': 'Yankees 2, Blue Jays 1', 'content_kicker': None, 'print_headline': 'Yankees Rely on Small Ball, Not Long Ball', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Teixeira, Mark', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pearce, Steve (1983- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hughes, Phil', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Toronto Blue Jays', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-29T02:29:54+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Zach Schonbrun', 'person': [{'firstname': 'Zach', 'middlename': None, 'lastname': 'Schonbrun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b55db02-9942-512c-821e-8f730f0694ad', 'word_count': 912, 'uri': 'nyt://article/6b55db02-9942-512c-821e-8f730f0694ad'}, {'abstract': 'President Bashar al-Assad’s relentless war is forcing more and more Syrians to flee to camps in Turkey and elsewhere.', 'web_url': 'https://www.nytimes.com/2012/08/29/opinion/a-refugee-disaster-in-the-making.html', 'snippet': 'President Bashar al-Assad’s relentless war is forcing more and more Syrians to flee to camps in Turkey and elsewhere.', 'lead_paragraph': 'The bloodshed in Syria, which is getting worse by the day, has created an enormous refugee problem. An estimated 200,000 Syrian refugees have crossed the borders of Turkey, Jordan, Iraq and Lebanon, including more than 80,000 in Turkey alone. The United Nations refugee agency, to which the United States is the biggest donor, could soon be overmatched without more significant efforts from other nations. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Refugee Disaster in the Making', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Refugee Disaster in the Making', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Syria', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Assad, Bashar al-', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-29T02:32:09+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/6f80bc86-4458-5dca-98e7-143d89bb253d', 'word_count': 410, 'uri': 'nyt://article/6f80bc86-4458-5dca-98e7-143d89bb253d'}, {'abstract': 'Gov. Chris Christie of New Jersey on Tuesday extolled Mitt Romney as an exceptional leader, and as the right man to take the country in a different direction.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/08/28/in-keynote-speech-christie-asks-country-to-face-hard-truths/', 'snippet': 'Gov. Chris Christie of New Jersey on Tuesday extolled Mitt Romney as an exceptional leader, and as the right man to take the country in a different direction.', 'lead_paragraph': 'TAMPA, Fla. — Chris Christie, the sharp-tongued governor of New Jersey, on Tuesday extolled Mitt Romney as an exceptional leader willing to speak hard truths to a nati