, 'keywords': [{'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-27T16:37:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Allison Kopicki', 'person': [{'firstname': 'Allison', 'middlename': None, 'lastname': 'Kopicki', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/569dbc4a-25e6-5d04-8773-d4d2f9d334fe', 'word_count': 310, 'uri': 'nyt://article/569dbc4a-25e6-5d04-8773-d4d2f9d334fe'}, {'abstract': 'His former party is gathering near his hometown, but Charlie Crist is now preparing to speak at the Democratic convention next week after endorsing President Obama.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/08/27/crist-to-speak-at-democratic-convention/', 'snippet': 'His former party is gathering near his hometown, but Charlie Crist is now preparing to speak at the Democratic convention next week after endorsing President Obama.', 'lead_paragraph': 'TAMPA, Fla. — Charlie Crist, the former Republican governor of Florida who ran for the Senate as an independent, will speak at the Democratic National Convention next week, taking yet another step away from his erstwhile party.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Crist to Speak at Democratic Convention', 'kicker': None, 'content_kicker': None, 'print_headline': 'Election 2012 | Shifting Sands: Crist Lends Voice to Democrats', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-27T16:44:57+0000', 'document_type': 'article', 'news_desk