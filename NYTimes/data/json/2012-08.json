'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19PINK_SPAN/19PINK_SPAN-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/19/arts/19PINK_SPAN/19PINK_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19PINK_SPAN/PINK-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19PINK_SPAN/PINK-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19PINK_SPAN/19PINK_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/arts/19PINK_SPAN/19PINK_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'It’s Nearly Impossible to Stay Unknown', 'kicker': 'Music', 'content_kicker': None, 'print_headline': 'It’s Nearly Impossible to Stay Unknown', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pink, Ariel', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-17T19:12:36+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zach Baron', 'person': [{'firstname': 'Zach', 'middlename': None, 'lastname': 'Baron', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a6f528cf-aa49-5c79-82bf-b7558c26e21b', 'word_count': 1566, 'uri': 'nyt://article/a6f528cf-aa49-5c79-82bf-b7558c26e21b'}, {'abstract': 'The University of North Carolina chancellor has announced an independent review to determine whether academic fraud at the school stretched back further than 2007.', 'web_url': 'https://thequad.blogs.nytimes.com/2012/08/17/widening-u-n-c-scandal-prompts-independent-review/', 'snippet': 'The University of North Carolina chancellor has announced an independent review to determine whether academic fraud at the school stretched back further than 2007.', 'lead_paragraph': 'For the past two years, North Carolina officials have liked to talk about getting past the scandal that landed it in N.C.A.A. hot water, embarrassing a university that likes to believe it is one of the few doing things “the right way.” The embers of the era of Butch Davis as the football coach showed that things had gone seriously off the rails, and now they have gotten only worse with the apparent leaking of Julius Peppers’s eye-opening transcript, which indicates the academic fraud stretches back a lot longer than the Davis era.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Widening U.N.C. Scandal Prompts Independent Review', 'kicker': 'The Quad', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'College Athletics', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Peppers, Julius', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-17T19:13:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'n