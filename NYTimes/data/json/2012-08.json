, 'kicker': None, 'content_kicker': None, 'print_headline': 'Two Shadows Hover Over Ryan&#8217;s Speech: Palin of 2008, and Isaac in 2012', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Republican National Convention', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Vice Presidents and Vice Presidency (US)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-28T17:08:10+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62aa2f14-1f11-574e-8736-1f3e9457a69a', 'word_count': 859, 'uri': 'nyt://article/62aa2f14-1f11-574e-8736-1f3e9457a69a'}, {'abstract': 'Christoph Niemann is in Tampa this week at the Republican National Convention. Last night, he “live illustrated” posts on Twitter relating to the Republican National Convention.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/08/28/from-the-magazine-live-illustrating-the-tweets-of-the-r-n-c/', 'snippet': 'Christoph Niemann is in Tampa this week at the Republican National Convention. Last night, he “live illustrated” posts on Twitter relating to the Republican National Convention.', 'lead_paragraph': 'Christoph Niemann is in Tampa this week, where he is “live illustrating” posts on Twitter relating to the Republican National Convention.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From the Magazine: Live Illustrating the Tweets of the R.N.C.', 'kicker': None, 'content