ne, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-29T22:14:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Stuart Elliott', 'person': [{'firstname': 'Stuart', 'middlename': None, 'lastname': 'Elliott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4ca9f36-6d0a-5606-8f3a-4ce4515619dc', 'word_count': 411, 'uri': 'nyt://article/d4ca9f36-6d0a-5606-8f3a-4ce4515619dc'}, {'abstract': '“For a Good Time, Call ...,” about two postcollegiate women who start a phone-sex line, was a DIY film project for two former college roommates.', 'web_url': 'https://www.nytimes.com/2012/08/30/movies/for-a-good-time-call-finds-humor-in-phone-sex.html', 'snippet': '“For a Good Time, Call ...,” about two postcollegiate women who start a phone-sex line, was a DIY film project for two former college roommates.', 'lead_paragraph': 'As the stars of a movie about a phone-sex line, Lauren Anne Miller and Ari Graynor quickly learned that anything could lend itself to double-entendre, even a joint telephone interview. They were, after all, sitting together on a hotel bed, tag-teaming a conversation.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/30/arts/GOODTIME/GOODTIME-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/30/arts/GOODTIME/GOODTIME-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/30/arts/GOODTIME/GOODTIM