'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Brian Knowlton', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Knowlton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd640664-c60d-524d-9fd5-7606d4d0aeba', 'word_count': 612, 'uri': 'nyt://article/dd640664-c60d-524d-9fd5-7606d4d0aeba'}, {'abstract': 'Campaigning to get AMC’s “The Walking Dead” back on Dish Network, the first zombie candidate for president will appear in Tampa on Sunday.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/08/26/zombie-candidate-crashes-republican-convention/', 'snippet': 'Campaigning to get AMC’s “The Walking Dead” back on Dish Network, the first zombie candidate for president will appear in Tampa on Sunday.', 'lead_paragraph': 'And they say President Obama and Mitt Romney can be stiff.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Zombie Candidate Crashes Republican Convention', 'kicker': None, 'content_kicker': None, 'print_headline': 'Election 2012 | Made For TV: Courting the Zombie Vote', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'The Walking Dead (TV Program)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Republican National Convention', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMC (TV Network)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Walking Dead (TV Program)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-26T18:53:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Emmarie Huetteman', 'person': [{'firstname': 'Emmarie', 'middlename': None, 'lastname': 'Huetteman', 'qualifier': None, 'title': None, 'role': 'reported', 'org