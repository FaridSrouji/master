 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7254de32-16cc-55e8-9da7-bae63c07cbe8', 'word_count': 533, 'uri': 'nyt://article/7254de32-16cc-55e8-9da7-bae63c07cbe8'}, {'abstract': 'A loose archipelago of restaurants and bars faces the glistening bay, most from the Rockaway Peninsula in Queens, attracting locals and boaters alike.', 'web_url': 'https://www.nytimes.com/2012/08/29/dining/jamaica-bay-where-pirates-can-dock-and-dine-in-new-york.html', 'snippet': 'A loose archipelago of restaurants and bars faces the glistening bay, most from the Rockaway Peninsula in Queens, attracting locals and boaters alike.', 'lead_paragraph': 'ON a recent Sunday, as a guitar player did his best Tom Petty imitation, a pirate politely enjoyed brunch on the deck of the Wharf Bar and Restaurant, overlooking Jamaica Bay. In a knit cap with rhinestone skull and crossbones, a jacket with golden epaulets and a scruffy and ashen beard, he hoisted his Budweiser in a toast: “To the captain!”', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29BAY1_SPAN/29BAY1_SPAN-articleLarge.jpg', 'height': 369, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/29/dining/29BAY1_SPAN/29BAY1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 369}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29BAY1_SPAN/29BAY1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29BAY1_SPAN/29BAY1-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29BAY1_SPAN/29BAY1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/29/dining/29BAY1_SPAN/29BAY1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29BAY1_SPAN/29BAY1_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Where Pirates Can Dock and Dine in New York', 'kicker': None, 'content_kicker': None, 'print_headline': 'Where Pirates Can Dock and Dine in New York', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Jamaica Bay (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'NIGHTCLUBS AND CABARETS', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Rockaway Beach (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Bars', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-27T23:23:00+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Daniel Maurer', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Maurer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2191f1e8-07f2-5db0-bec4-551a4b2fc910', 'word_count': 1438, 'uri': 'nyt://article/2191f1e8-07f2-5db0-bec4-551a4b2fc910'}, {'abstract': 'Two summers ago, a quartet of students at New York University started an ambitious project called Diaspora that was intended to be an open alternative to Facebook. But since then the project seems to have petered out. The founders said on Monday that they would be turning it over to its users.', 'web_url': 'https://bits.blogs.nytimes.com/2012/08/27/founders-of-diaspora-intended-as-the-anti-facebook-move-on/', 'snippet': 'Two summers ago, a quartet of students at New York University started an ambitious project called Diaspora that was intended to be an open alternative to Facebook. But since then the project seems to have petered out. The founders said on Monday t...', 'lead_paragraph': ' Two summers ago, a quartet of students at New York University started an ambitious project called Diaspora that was intended to be an open alternative to Facebook, one that would give its users greater control over their data and personal information. They created a project on Kickstarter with the modest goal of raising $10,000, enough capital to support themselves for the time it would take to develop the software. The project caught fire around the Web, and the group ended up raising $200,000.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Founders of Diaspora, Intended as the Anti-Facebook, Move On', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crowdfunding (Internet)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Diaspora', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-27T23:23:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/988b9c83-003f-5ca4-b509-d0ef9298762c', 'word_count': 468, 'uri': 'nyt://article/988b9c83-003f-5ca4-b509-d0ef9298762c'}, {'abstract': 'Airlines will probably continue to cut domestic capacity, especially in small markets, and will depend more on foreign partners.', 'web_url': 'https://www.nytimes.com/2012/08/28/business/airlines-focus-on-capacity-discipline-on-the-road.html', 'snippet': 'Airlines will probably continue to cut domestic capacity, especially in small markets, and will depend more on foreign partners.', 'lead_paragraph': 'WHERE are we going? ', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/28/business/Road/Road-jumbo.jpg', 'height': 598, 'width': 508, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/28/business/Road/Road-superJumbo.jpg', 'height': 598, 'width': 508, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Expect Fewer Seats, Even for Overseas Flights', 'kicker': 'On The Road', 'content_kicker': None, 'print_headline': 'Expect Fewer Seats, Even for Overseas Flights', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN AIRLINES', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-27T23:44:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Joe Sharkey', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Sharkey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4b0f9968-b381-5c29-9e59-ad9215441542', 'word_count': 784, 'uri': 'nyt://article/4b0f9968-b381-5c29-9e59-ad9215441542'}, {'abstract': 'Somali and African Union troops seized the port of Marka, Somalia, on Monday from the Shabab as part of a campaign to secure Somalia, which is trying to establish its first effective national government since 1991.', 'web_url': 'https://www.nytimes.com/2012/08/28/world/africa/troops-seize-somali-port-from-the-shabab.html', 'snippet': 'Somali and African Union troops seized the port of Marka, Somalia, on Monday from the Shabab as part of a campaign to secure Somalia, which is trying to establish its first effective national government since 1991.', 'lead_paragraph': ' Somali and African Union troops seized the port of Marka, Somalia, on Monday from the Shabab as part of a campaign to secure Somalia, which is trying to establish its first effective national government since 1991. African Union officials said its fighters met little resistance in the battle for Marka, which is about 68 miles south of Mogadishu. The Shabab earned income from taxes and port fees in Marka, according to a United Nations report. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Somalia: Troops Seize Port From the Shabab', 'kicker': 'World Briefing | Africa', 'content_kicker': None, 'print_headline': 'Somalia: Troops Seize Port From the Shabab', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Somalia', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Shabab', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Civil War and Guerrilla Warfare', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-27T23:49:11+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Bloomberg News', 'person': [{'firstname': 'Bloomberg', 'middlename': None, 'lastname': 'News', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/b36889da-7770-53f8-b5de-60d9413d2261', 'word_count': 77, 'uri': 'nyt://article/b36889da-7770-53f8-b5de-60d9413d2261'}, {'abstract': 'Two Tibetan teenagers set themselves on fire and burned to death on Monday in an anti-Chinese political protest in a Tibetan-populated area of western China’s Sichuan Province.', 'web_url': 'https://www.nytimes.com/2012/08/28/world/asia/2-tibetan-teenagers-set-themselves-on-fire-in-china.html', 'snippet': 'Two Tibetan teenagers set themselves on fire and burned to death on Monday in an anti-Chinese political protest in a Tibetan-populated area of western China’s Sichuan Province.', 'lead_paragraph': 'Two Tibetan teenagers set themselves on fire and burned to death on Monday in an anti-Chinese political protest in a restive Tibetan-populated area of western China’s Sichuan Province, the rights group Free Tibet reported. At least 50 people have set themselves on fire since March 2011. The latest victims were identified as Lobsang Kalsang, an 18-year-old monk, and Damchoek, 17, a former monk. Free Tibet, which has networks of contacts in Tibetan-populated areas of China, said the teenagers staged their protest outside the Kirti monastery in the town of Ngaba, known in Chinese as Aba, a center of anti-Chinese sentiment. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'China: 2 Tibetan Teenagers Set Themselves on Fire', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'China: 2 Tibetan Teenagers Set Themselves on Fire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Tibet', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Sichuan Province (China)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Immolation', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-28T00:00:22+0000', 'document_type': 'artic