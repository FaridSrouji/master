: 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Phoenix (Ariz)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-15T00:08:10+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Fernanda Santos', 'person': [{'firstname': 'Fernanda', 'middlename': None, 'lastname': 'Santos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5e78737-1401-556b-968a-a41ed1750102', 'word_count': 780, 'uri': 'nyt://article/e5e78737-1401-556b-968a-a41ed1750102'}, {'abstract': 'Two young Tibetan men set themselves on fire on Monday in a Tibetan region of western China to protest Chinese rule.', 'web_url': 'https://www.nytimes.com/2012/08/15/world/asia/self-immolations-continue-in-china.html', 'snippet': 'Two young Tibetan men set themselves on fire on Monday in a Tibetan region of western China to protest Chinese rule.', 'lead_paragraph': ' Two young Tibetan men set themselves on fire on Monday in a Tibetan region of western China to protest Chinese rule, according to Free Tibet, an advocacy group in London, and Radio Free Asia, a news organization financed by the United States government. The men, who were identified as Lungtok and Tashi, self-immolated in the town of Ngaba, known in Chinese as Aba. Free Tibet identified both as former monks of Kirti Monastery, while Radio Free Asia said Lungtok was a monk and Tashi was believed to be a layperson. Forty-eight Tibetans have self-immolated since March 2011. The condition of the two men was unclear on Tuesday, though Free Tibet reported that Lungtok is believed to have died. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'China: Self-Immolations Continue', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'China: Self-Immolations Continue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Tibet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immolation', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-15T00:13:11+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Edward Wong', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/c47c94cf-7e54-582b-900c-e8a8a495e83b', 'word_count': 120, 'uri': 'nyt://article/c47c94cf-7e54-582b-900c-e8a8a495e83b'}, {'abstract': 'The leader of a criminal syndicate operating in the volatile region of Chéran, in the state of Michoacán, was found slain on Tuesday, according to the state attorney’s office.', 'web_url': 'https://www.nytimes.com/2012/08/15/world/americas/criminal-syndicate-leader-found-dead-in-mexico.html', 'snippet': 'The leader of a criminal syndicate operating in the volatile region of Chéran, in the state of Michoacán, was found slain on Tuesday, according to the state attorney’s office.', 'lead_paragraph': 'The leader of a criminal syndicate operating in the volatile region of Chéran, in the state of Michoacán, was found slain on Tuesday, according to the state attorney’s office. A military patrol found the leader, Mauricio Cuitláhuac Hernández, near a burning van in the town of Santa María Urapicho. Residents of Cherán have been struggling to drive out armed illegal loggers who they say have destroyed their forests and tormented their families under the protection of cartel henchmen for months. The government deployed 600 police officers to Michoacán this week. No suspects have been named in the killing.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mexico: Criminal Leader Found 