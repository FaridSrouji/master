, 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/28/world/RUSSIA/RUSSIA-jumbo.jpg', 'height': 1024, 'width': 739, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/28/world/RUSSIA/RUSSIA-superJumbo.jpg', 'height': 2048, 'width': 1479, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/28/world/RUSSIA/RUSSIA-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/28/world/RUSSIA/RUSSIA-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/28/world/RUSSIA/RUSSIA-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Putin, Report Says, State Perks Pile High', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Putin, Report Says, State Perks Pile High', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'High Net Worth Individuals', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-28T00:52:04+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Andrew E. Kramer', 'person': [{'firstname': 'Andrew', 'middlename': 'E.', 'lastname': 'Kramer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}],