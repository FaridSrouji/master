 science.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Deeper Look at Undisclosed Conflicts of Interest in ‘Frackademia’', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conflicts of Interest', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hydraulic Fracturing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Natural Gas', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Shale', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN ASSN FOR THE ADVANCEMENT OF SCIENCE', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Texas', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-08-01T19:35:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew C. Revkin', 'person': [{'firstname': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae91906d-9045-51b2-ac21-3c76f18a89c6', 'word_count': 1365, 'uri': 'nyt://article/ae91906d-9045-51b2-ac21-3c76f18a89c6'}, {'abstract': 'Unofficial equipment for Olympic athletes has arrived in a way previously reserved for official sponsors.', 'web_url': 'https://www.nytimes.com/2012/08/02/sports/olympics/headphone-brands-compete-for-viewers-attention-at-olympics.html', 'snippet': 'Unofficial equipment for Olympic athletes has arrived in a way previously reserved for official sponsors.', 'lead_paragraph': 'LONDON — One by one, the swimmers emerge poolside from behind a wall, making their way to the starting blocks at the Olympic aquatics center in a procession that combines the drama of sport, the staging of prime-time TV and the posturing of a fashion-show catwalk. This conspicuous scene, playing out many times a day at the London Games, has also become an international advertising bonanza for a product not usually associated with water sports: headphones.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/02/sports/02headphones/02headphones-jumbo.jpg', 'height': 1024, 'width': 784, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/02/sports/02headphones/02headphones-superJumbo.jpg', 'height': 2048, 'width': 1569, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/02/sports/02headphones/02headphones-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/02/sports/02headphones/02headphones-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/02/sports/02headphones/02headphones-thumbLarge.jpg', 'height': 0, 'width': 0, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tuning Out Olympic Edict', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tuning Out Olympic Edict', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Swimming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 