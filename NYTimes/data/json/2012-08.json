title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ba1f644a-6278-5d45-921d-6744578eb2ac', 'word_count': 1001, 'uri': 'nyt://article/ba1f644a-6278-5d45-921d-6744578eb2ac'}, {'abstract': 'The latest Quinnipiac University/New York Times/CBS News polls included telephone interviews conducted July 31 through Aug. 6 with a total of 5,197 adults in Colorado, Virginia and Wisconsin.', 'web_url': 'https://www.nytimes.com/2012/08/08/us/politics/how-the-polls-were-conducted.html', 'snippet': 'The latest Quinnipiac University/New York Times/CBS News polls included telephone interviews conducted July 31 through Aug. 6 with a total of 5,197 adults in Colorado, Virginia and Wisconsin.', 'lead_paragraph': 'The latest Quinnipiac University/New York Times/CBS News polls included telephone interviews conducted July 31 through Aug. 6 with a total of 5,197 adults in Colorado, Virginia and Wisconsin. Of these, 4,657 said they were registered to vote.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How the Polls Were Conducted', 'kicker': None, 'content_kicker': None, 'print_headline': 'How the Polls Were Conducted', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Voting and Voters', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Quinnipiac University', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-08T06:59:07+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/11cd6fd6-1ace-577d-8f7c-27ae54dff272', 'word_count': 353, 'uri': 'nyt://article/11cd6fd6-1ace-577d-8f7c-27ae54dff272'}, {'abstract': 'Some 4 in 10 voters in Colorado, Virginia and Wisconsin say that they do want gun laws to be toughened, new Quinnipiac University/New York Times/CBS News polls find.', 'web_url': 'https://www.nytimes.com/2012/08/08/us/politics/polls-find-opposition-to-stricter-gun-laws.html', 'snippet': 'Some 4 in 10 voters in Colorado, Virginia and Wisconsin say that they do want gun laws to be toughened, new Quinnipiac University/New York Times/CBS News polls find.', 'lead_paragraph': 'Most voters in Colorado, Virginia and Wisconsin are not clamoring for stricter state laws covering the sale of guns, with majorities in each state saying more restrictions would not prevent violent attacks like last month’s killings in Aurora, Colo.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mixed Views Are Found on Stricter Laws for Guns', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mixed Views Are Found On Stricter Laws for Guns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Colorado', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-08T07:00:09+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Dalia Sussman', 'person': [{'firstname': 'Dalia', 'middlename': None, 'lastname': 'Sussman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e12e5e86-9973-5d2d-8549-cee38e72bf6c', 'word_count': 535, 'uri': 'nyt://article/e12e5e86-9973-5d2d-8549-cee38e72bf6c'}, {'abstract': 'Mitt Romney has held his advantage among the white working-class while President Obama has maintained the support of women, the Quinnipiac University/New York Times/CBS News polls found.', 'web_url': 'https://www.nytimes.com/2012/08/08/us/politics/polls-see-sharp-divide-in-3-swing-states.html', 'snippet': 'Mitt Romney has held his advantage among the white working-class while President Obama has maintained the support of women, the Quinnipiac University/New York Times/CBS News polls found.', 'lead_paragraph': 'For all of the Democratic attacks painting Mitt Romney as an out-of-touch elitist who will help the rich at the expense of the middle class, he is maintaining the traditional — and sizable — Republican advantage among a politically vital constituency, white working-class voters in the states most likely to decide the presidential election.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/08/us/08poll1/08poll1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/08/us/08poll1/08poll1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Polls Underline Stubborn Splits in 3 Key States', 'kicker': None, 'content_kicker': None, 'print_headline': 'Polls Underline Stubborn Splits In 3 Key States', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Virginia', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major'