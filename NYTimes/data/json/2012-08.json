e, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/business/23google_337/23google_337-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/23/business/23google_337/23google_337-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/business/23google_337/23google_337-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Google’s Inner Circle, a Falling Number of Women', 'kicker': None, 'content_kicker': None, 'print_headline': 'Search and Replace', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hiring and Promotion', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wojcicki, Susan', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Page, Larry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-22T17:53:43+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Claire Cain Miller', 'person': [{'firstname': 'Claire', 'middlename': 'Cain', 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4d518078-fb0e-5148-b99a-bc0fbbcd33be', 'word_count': 1422, 'uri': 'nyt://article/4d518078-fb0e-5148-b99a-bc0fbbcd33be'}, {'abstract': '“Y? O! G…A” is an exhibit by Matt Keegan and Eileen Quinlan that employs yoga mats.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/08/22/the-kitchen-announces-its-fall-season/', 'snippet': '“Y? O! G…A” is an exhibit by Matt Keegan and Eileen Quinlan that employs yoga mats.', 'lead_paragraph': 'Yoga mats, Beethoven, stories from life in America and Mary Shelley’s “Frankenstein” all serve as fodder for offerings this season at The Kitchen performance and exhibition space, which released highlights of its program, which runs from Sept. 7 – Dec. 22.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Kitchen Announces Its Fall Season', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'The Kitchen Announces Its Fall Season', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dorvillier, D D', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Maxwell, Richard (1967- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Kitchen, The (Manhattan, NY, Performance Space)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-22T18:00:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bea86a56-334b-5b0b-b39f-370a9462948a', 'word_count': 151, 'uri': 'nyt://article/bea86a56-334b-5b0b-b39f-370a9462948a'}, {'abstract': 'The Impossible Project has resurrected large format instant film — dead since 2009 — and the results of the first experimental batch will be on display at the Impossible Project Space in New York.', 'web_url': 'https://lens.blogs.nytimes.com/2012/08/22/reinventing-instant-film-in-an-age-of-instant-imagery/', 'snippet': 'The Impossible Project has resurrected large format instant film — dead since 2009 — and the results of the first experimental batch will be on display at the Impossible Project Space in New York.', 'lead_paragraph': 'In the world of photography, innovation has a shelf life. By 2008, some 60 years after Edwin Land’s invention of the Polaroid camera, analog photography had been usurped by the power of the digital age. The shuttering of instant film production left a community of Polaroid enthusiasts and professional photographers with uncertain futures: Would instant film ever be produced again? Could Polaroid be resurrected?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reinventing Instant Film in an Age of Instant Imagery', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cameras', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kaps, Florian', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Land, Edwin H', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Polaroid Corp', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-22T18:00:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Adam McCauley', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'McCauley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0153df2c-0ebf-5963-8db2-82513157f3ad', 'word_count': 1483, 'uri': 'nyt://article/0153df2c-0ebf-5963-8db2-82513157f3ad'}, {'abstract': 'An online discussion of “Wallflower at the Orgy” and other works by Nora Ephron.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/08/22/big-city-book-club-discussing-nora-ephron/', 'snippet': 'An online discussion of “Wallflower at the Orgy” and other works by Nora Ephron.', 'lead_paragraph': '9:30 p.m. | Updated  That’s a wrap! The live portion of our conversation is now concluded. But please still weigh in in the comments section below with any and all thoughts on Nora Ephron and her work. I’ll be checking in throughout the week. And stay tuned: we’ll announce our next book club selection soon. ', 'print_section': 'MB', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Big City Book Club: Discussing Nora Ephron', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': 'Big City Book Club: Joyfully Skewering With Ephron', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-22T18:00:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/93a77088-d7ac-5806-9ec8-859d6e8ac13d', 'word_count': 692, 'uri': 'nyt://article/93a77088-d7ac-5806-9ec8-859d6e8ac13d'}, {'abstract': 'Older men are more likely to father a child with autism or schizophrenia.', 'web_url': 'https://parenting.blogs.nytimes.com/2012/08/22/older-fathers-linked-to-risk-of-autism-and-schizophrenia/', 'snippet': 'Older men are more likely to father a child with autism or schizophrenia.', 'lead_paragraph': 'A new study provides some of the first solid scientific evidence for a true increase in autism. In the Science section, Benedict Carey describes the research: “Older men are more likely than young ones to father a child who develops autism or schizophrenia, because of random mutations that become more numerous with advancing paternal age, scientists reported on Wednesday. The age of mothers had no bearing on the risk for these disorders.” Read more.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Older Fathers Linked to Risk of Autism and Schizophrenia', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-22T18:05:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/ac137b69-04b5-5df2-94b9-394269133842', 'word_count': 74, 'uri': 'nyt://article/ac137b69-04b5-5df2-94b9-394269133842'}, {'abstract': 'What foods do your children bring into the house that you just can’t resist?', 'web_url': 'https://parenting.blogs.nytimes.com/2012/08/22/please-dont-eat-the-cheese-curls/', 'snippet': 'What foods do your children bring into the house that you just can’t resist?', 'lead_paragraph': 'In the Dining Section, Matt Richtel writes about the ways having children has changed his diet — and not for the better. For him, it’s the main meals. He snatches the French fries and finishes the last bites of pasta.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/style/motherlode-cheese-curls/motherlode-cheese-curls-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/style/motherlode-cheese-curls/motherlode-cheese-curls-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/style/motherlode-cheese-curls/motherlode-cheese-curls-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 