ark.', 'lead_paragraph': 'WEST CHESTER, Pa. — Representative Paul D. Ryan of Wisconsin customized from his menu of attacks on President Obama to fit a full day of campaigning in Pennsylvania on Tuesday, putting state-specific numbers on his assertion that current Medicare beneficiaries will suffer benefit cuts under the 2010 health care law.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ryan Takes to Pennsylvania to Push Medicare Message', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elderly', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicare', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Reform and Reorganization', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Pew Research Center', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Philadelphia (Pa)', 'rank': 14, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank': 15, 'major': 'N'}], 'pub_date': '2012-08-21T21:50:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'first