': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/465c52c5-1e4c-54ce-925e-9367b423f8b5', 'word_count': 758, 'uri': 'nyt://article/465c52c5-1e4c-54ce-925e-9367b423f8b5'}, {'abstract': 'Focus groups that evaluated the new bank note before it went into circulation raised questions about why a woman on the back of the bill was Asian, according to reports. She was replaced by a “neutral”-looking woman.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/08/21/canadians-ask-why-design-of-100-bill-replaced-asian-woman-with-white-one/', 'snippet': 'Focus groups that evaluated the new bank note before it went into circulation raised questions about why a woman on the back of the bill was Asian, according to reports. She was replaced by a “neutral”-looking woman.', 'lead_paragraph': 'OTTAWA — When the Bank of Canada switched to plastic-based banknotes, it ran the proposed designs past eight focus groups, hoping to avoid controversy or embarrassment.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Canadians Ask Why Design of $100 Bill Replaced Asian Woman With White One', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Discrimination', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Bank of Canada', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-21T21:42:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Ian Austen', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Austen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a4fb3e18-22a8-5af3-af11-0077a73cc299', 'word_count': 524, 'uri': 'nyt://article/a4fb3e18-22a8-5af3-af11-0077a73cc299'}, {'abstract': 'To observe the 150th anniversary of Debussy’s birth, Arts Brookfield is sponsoring Debussy 150, a free concert series through Thursday in the lobby of 1 Liberty Plaza in Lower Manhattan.', 'web_url': 'https://www.nytimes.com/2012/08/22/arts/music/debussy-150-series-at-1-liberty-plaza.html', 'snippet': 'To observe the 150th anniversary of Debussy’s birth, Arts Brookfield is sponsoring Debussy 150, a free concert series through Thursday in the lobby of 1 Liberty Plaza in Lower Manhattan.', 'lead_paragraph': 'What’s wrong with this picture? New York City’s major institutions have done little to commemorate the 150th anniversary of Debussy’s birth, but Arts Brookfield — the performance presentation arm of Brookfield Office Properties, a real estate concern that operates large office buildings in New York and across North America — is filling the gap with Debussy 150, a free four-concert series in the lobby of 1 Liberty Plaza in Lower Manhattan. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/arts/subdebussy/subdebussy-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/22/arts/subdebussy/subdebussy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/arts/subdebussy/subdebussy-jumbo.jpg', 'height': 573, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/arts/subdebussy/subdebussy-superJumbo.jpg', 'height': 1147, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/arts/subdebussy/