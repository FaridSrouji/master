otton-superJumbo.jpg', 'height': 1319, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/01/sports/cotton/cotton-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/01/sports/cotton/cotton-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/01/sports/cotton/cotton-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cotton Bowl Reinvigorated by Chance to Host a Final', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cotton Bowl Reinvigorated by Chance to Host a Final', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jones, Jerry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football (College)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cowboys Stadium (Arlington, Tex)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bowl Championship Series', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cotton Bowl (Football Game)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-31T23:56:03+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Tom Spousta', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Spousta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/beeaf18c-4f7b-541f-883c-75c9c4caeccf', 'word_count': 827, 'uri': 'nyt://article/beeaf18c-4f7b-541f-883c-75c9c4caeccf'}, {'abstract': 'Concluding a long effort to take gray wolves in the Northern Rockies off the endangered species list, the federal Fish and Wildlife Service lifted protections for most Wyoming wolves.', 'web_url': 'https://www.nytimes.com/2012/09/01/science/earth/wyoming-federal-protections-end-for-gray-wolves.html', 'snippet': 'Concluding a long effort to take gray wolves in the Northern Rockies off the endangered species list, the federal Fish and Wildlife Service lifted protections for most Wyoming wolves.', 'lead_paragraph': 'Concluding a long effort to take the gray wolves in the Northern Rockies off the endangered species list, the federal Fish and Wildlife Service lifted protections for most Wyoming wolves on Friday. The move allows the increased hunting of wolves in Wyoming, where there are about 270 outside Yellowstone National Park. Protections have already been lifted in Montana and Idaho. Major environmental groups immediately protested the move and will most likely sue to block it. They have long maintained that without the protections, hunters and ranchers in the area will kill wolves indiscriminately and ruin one of conservation’s biggest success stories. Ranchers argue that even if the overall cost of wolf attacks on cattle may be small, it can mean the difference between profit and loss in marginal operations. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wyoming: Federal Protections End For Gray Wolves ', 'kicker': 'National Briefing | Rockies', 'content_kicker': None, 'print_headline': 'Wyoming: Federal Protections End For Gray Wolves', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wolves', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Fish and Wildlife Service', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Endangered and Extinct Species', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-31T23:58:51+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Felicity Barringer', 'person': [{'firstname': 'Felicity', 'middlename': None, 'lastname': 'Barringer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/318dd778-f54b-5cdb-a881-49094a648610', 'word_count': 132, 'uri': 'nyt://article/318dd778-f54b-5cdb-a881-49094a648610'}], 'meta': {'hits': 8202}}}