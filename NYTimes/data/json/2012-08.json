PSPAN/0810SUPERCAP-superJumbo.jpg', 'height': 878, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/arts/10RDP_SUPERCAPSPAN/10RDP_SUPERCAPSPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/10/arts/10RDP_SUPERCAPSPAN/10RDP_SUPERCAPSPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/arts/10RDP_SUPERCAPSPAN/10RDP_SUPERCAPSPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Deal Making in Hong Kong, Distracted by Debauchery', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': '$upercapitalist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Yin, Simon', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-10T00:23:39+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bda38dce-a202-5616-bf90-8a082dc2ae52', 'word_count': 243, 'uri': 'nyt://article/bda38dce-a202-5616-bf90-8a082dc2ae52'}, {'abstract': 'The hearings to be overseen by Sir Robert Owen could provide the first opportunity for witnesses to testify under oath regarding the death of Alexander V. Litvinenko.', 'web_url': 'https://www.nytimes.com/2012/08/10/world/europe/britain-judge-is-picked-to-lead-inquest-into-death-of-former-kgb-officer.html', 'snippet': 'The hearings to be overseen by Sir Robert Owen could provide the first opportunity for witnesses to testify under oath regarding the death of Alexander V. Litvinenko.', 'lead_paragraph': ' Judicial authorities said Thursday that they had taken the unusual step of appointing a senior judge to hold a long-planned inquest into the death of Alexander V. Litvinenko, a former K.G.B. officer poisoned in London in 2006 with a rare radioactive isotope, polonium 210. The case soured relations between Britain and Russia, and the new development may put at risk recent improvements. At British inquests, judges replace coroners only in the most high-profile cases, like the inquiry into the death of Princess Diana. The hearings to be overseen by the judge, Sir Robert Owen, could provide the first opportunity in the case for witnesses to testify under oath. A procedural hearing is to be held next month. British prosecutors have accused another former K.G.B. officer, Andrei K. Lugovoi, of Mr. Litvinenko’s poisoning — a charge he denies — and are seeking his extradition, which Russia has refused. Mr. Litvinenko, who fled Russia in 2000, had secured British citizenship shortly before he died, and he accused Russia’s leader, Vladimir V. Putin, of responsibility for his poisoning. ', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Britain: Judge Is Picked to Lead Inquest Into Death of Former K.G.B. Officer', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'Britain: Judge Is Picked to Lead Inquest Into Death of Former K.G.B. Officer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lugovoi, Andrei K', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Poisoning and Poisons', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Litvinenko, Alexander V', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Owen, Robert V', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Courts and the Judiciary', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Extradition', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'KGB', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-08-10T00:24:09+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Alan Cowell', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Cowell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/f0bb25a4-35b7-58bd-808e-c5adc354f4ec', 'word_count': 175, 'uri': 'nyt://article/f0bb25a4-35b7-58bd-808e-c5adc354f4ec'}, {'abstract': 'Every day at the London Games has offered riveting moments, but perhaps no single day was more crowded with drama and record achievement than Thursday.', 'web_url': 'https://www.nytimes.com/2012/08/10/sports/olympics/usain-bolt-ashton-eaton-help-create-a-day-of-superlatives-at-olympics.html', 'snippet': 'Every day at the London Games has offered riveting moments, but perhaps no single day was more crowded with drama and record achievement than Thursday.', 'lead_paragraph': 'LONDON — The world’s fastest man and the world’s greatest half-miler ran past the finish line and into the history books. Wembley, the iconic stadium, bulged with 80,203 fans for women’s soccer as the United States found redemption against Japan. Ireland won its first gold medal in 16 years as women’s boxing crowned its inaugural Olympic champions. And a friendly debate ensued about exactly who was the world’s greatest athlete.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10olympics_395-span/10olympics_395-span-articleLarge.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/10/sports/olympics/10olympics_395-span/10olympics_395-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10olympics_395-span/10olympics_395-span-jumbo.jpg', 'height': 300, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10olympics_395-span/10olympics_395-span-superJumbo.jpg', 'height': 300, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10olympics_395-span/10olympics_395-span-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/10/sports/olympics/10olympics_395-span/10olympics_395-span-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10olympics_395-span/10olympics_395-span-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Faster, Higher, Stronger: Day of Golden Drama', 'kicker': None, 'content_kicker': None, 'print_headline': 'Faster, Higher, Stronger: Day of Golden Drama', 'name': No