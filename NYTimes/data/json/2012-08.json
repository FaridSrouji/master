nail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17FEINSTEIN_SPAN/17FEINSTEIN_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/17/arts/17FEINSTEIN_SPAN/17FEINSTEIN_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17FEINSTEIN_SPAN/17FEINSTEIN_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'It’s ‘Amore,’ Her Father’s Way', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'It’s ‘Amore,’ Her Father’s Way', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-16T21:15:05+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d41a393f-c89b-528e-842d-e5a9ec93760f', 'word_count': 269, 'uri': 'nyt://article/d41a393f-c89b-528e-842d-e5a9ec93760f'}, {'abstract': '“Copper,” BBC America’s new series, tells the story of a police officer patrolling the Five Points neighborhood in post-bellum New York.', 'web_url': 'https://www.nytimes.com/2012/08/19/arts/television/copper-resurrects-the-five-points.html', 'snippet': '“Copper,” BBC America’s new series, tells the story of a police officer patrolling the Five Points neighborhood in post-bellum New York.', 'lead_paragraph': 'TO film “Gangs of New York,” Martin Scorsese painstakingly replicated the 19th-century tenements, saloons and almshouses of Lower Manhattan’s infamous Five Points. On the sprawling back lot of a studio outside Rome, he recreated an incandescent vista of the pentagonal intersection that epitomized the world’s worst slum. ', 'print_section': 'AR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19COPPER1_SPAN/19COPPER1_SPAN-articleLarge.jpg', 'height': 361, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/19/arts/19COPPER1_SPAN/19COPPER1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 361}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19COPPER1_SPAN/19COPPER1_SPAN-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19COPPER1_SPAN/19COPPER1_SPAN-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19COPPER1_SPAN/19COPPER1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/arts/19COPPER1_SPAN/19COPPER1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/arts/19COPPER1_SPAN/19COPPER1_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Slums of New York Teem With Life and Death', 'kicker': 'Television', 'content_kicker': None, 'print_headline': 'Slums of New York Teem With Life and Death', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fontana, Tom', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'BBC America', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-16T21:23:28+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Sam Roberts', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Roberts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d199dcb6-3483-5af3-bab4-614b96e4cc54', 'word_count': 1417, 'uri': 'nyt://article/d199dcb6-3483-5af3-bab4-614b96e4cc54'}, {'abstract': 'The new BBC America series “Copper” is a period police procedural set in the Five Points neighborhood in 19th-century Manhattan.', 'web_url': 'https://www.nytimes.com/2012/08/17/arts/television/copper-a-bbc-america-series-set-in-old-new-york.html', 'snippet': 'The new BBC America series “Copper” is a period police procedural set in the Five Points neighborhood in 19th-century Manhattan.', 'lead_paragraph': '“Copper” is BBC America’s declaration of independence: the first original drama from a channel built on British imports. And unlike the science-fiction and reality fare (“Doctor Who,” “Top Gear”) that BBC America has focused on, “Copper” is a prestige product, a dark and serious show that’s being thrown into the deep end of the cable television pool on Sunday night, where its time-slot competitors include AMC’s “Breaking Bad,” HBO’s “Newsroom” and USA’s “Political Animals.”', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17COPPER_SPAN/17COPPER-articleLarge.jpg', 'heigh