ies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ferris Wheels', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'BFC Partners', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Economic Development Corp', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Staten Island (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-23T18:35:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Vivian Yee', 'person': [{'firstname': 'Vivian', 'middlename': None, 'lastname': 'Yee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef37c1fe-de5c-5929-86d5-fcd51911848d', 'word_count': 974, 'uri': 'nyt://article/ef37c1fe-de5c-5929-86d5-fcd51911848d'}, {'abstract': 'In a disturbing trend, more audits are failing quality reviews, and the problem isn’t limited to work done by small firms.', 'web_url': 'https://www.nytimes.com/2012/08/24/business/bad-grades-rising-at-audit-firms.html', 'snippet': 'In a disturbing trend, more audits are failing quality reviews, and the problem isn’t limited to work done by small firms.', 'lead_paragraph': 'Are audits getting worse? Or are the inspectors getting pickier?', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2010/06/03/health/floyd-norris/floyd-norris-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2010/06/03/health/floyd-norris/floyd-norris-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Bad Grades Are Rising for Auditors', 'kicker': 'High & Low Finance', 'content_kicker': None, 'print_head