': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-03T19:43:05+0000', 'document_type': 'multimedia', 'news_desk': 'U.S.', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/d73df588-48ef-5ae5-86e6-4e35dec974fb', 'word_count': 0, 'uri': 'nyt://interactive/d73df588-48ef-5ae5-86e6-4e35dec974fb'}, {'abstract': 'The downside of Twitter is that journalists need a name for it. And no one seems satisfied to simply call it Twitter.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2012/08/03/hey-twitterverse-lets-rename-the-twitterverse/', 'snippet': 'The downside of Twitter is that journalists need a name for it. And no one seems satisfied to simply call it Twitter.', 'lead_paragraph': 'One benefit of Twitter, for journalists at least, is that it serves as an easily accessible catch bin for real-time public reactions; it’s basically the Internet-age replacement for the hoary old “Man on the Street” features newspapers once relied on. (A lazy crowd-sourcing tactic to which we at the 6th Floor would never stoop.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hey Twitterverse, Let’s Rename the Twitterverse', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Twitter', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-03T19:43:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Mag