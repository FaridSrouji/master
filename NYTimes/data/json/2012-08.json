umbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/12/realestate/12LIVING_SPAN/12LIVING_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Satellite With Great Views of Home Base', 'kicker': 'Living In | Long Island City, Queens', 'content_kicker': None, 'print_headline': 'A Satellite With Great Views of Home Base', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Long Island City (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Renting and Leasing (Real Estate)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-10T19:29:55+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Alison Gregor', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Gregor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dcfd821c-a016-5ce4-bcc7-d095e09b4cea', 'word_count': 1564, 'uri': 'nyt://article/dcfd821c-a016-5ce4-bcc7-d095e09b4cea'}, {'abstract': 'The rapper, who died in May, leaves instructions that he does not want his image, name, music “or any artistic property” used in advertising.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/08/10/adam-yauchs-will-protects-his-artistic-integrity/', 'snippet': 'The rapper, who died in May, leaves instructions that he does not want his image, name, music “or any artistic property” used in advertising.', 'lead_paragraph': ' Even in death, Adam Yauch is a musician for whom principles matter.\xa0 The Beastie Boys member known as MCA, who died three months ago after a battle with cancer, made it clear in his will that he does not want his image, name, music “or any artistic property” used in advertising, The Associated Press reported.\xa0That was his stance during his life as well; he once rapped that he would not “sell my songs for no TV ad.”\xa0 The will, filed in Manhattan court this week, will leaves a roughly $6 million estate to his widow and teen-age daughter.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Adam Yauch’s Will Protects His Artistic Integrity', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Yauch, Adam', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Beastie Boys', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-10T19:38:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9dc7a0f6-e37c-5e1a-9f35-4c5575e60642', 'word_count': 168, 'uri': 'nyt://article/9dc7a0f6-e37c-5e1a-9f35-4c5575e60642'}, {'abstract': 'The Americans won their first gold medal in the sprint relay in 16 years. Their time, 40.82 seconds, broke the previous mark, 41.37, which was set by East Germany in 1985.', 'web_url': 'https://www.nytimes.com/2012/08/11/sports/olympics/olympics-track-and-field-relays.html', 'snippet': 'The Americans won their first gold medal in the sprint relay in 16 years. Their time, 40.82 seconds, broke the previous mark, 41.37, which was set by East Germany in 1985.', 'lead_paragraph': 'LONDON — As Carmelita Jeter sprinted across the finish line in the women’s 4x100-meter relay Friday night, she turned to her left and pointed a finger at the electronic clock beside the track as if to say, “Look at what we just did.” A beat later, the board flashed Jeter’s news in bold type: NEW WR.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/11/sports/RELAYS/RELAYS-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/11/sports/RELAYS/RELAYS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/11/sports/RELAYS/RELAYS-jumbo.jpg', 'height': 627, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/11/sports/RELAYS/RELAYS-superJumbo.jpg', 'height': 1253, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/11/sports/RELAYS/RELAYS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/11/sports/RELAYS/RELAYS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/11/sports/RELAYS/RELAYS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Clean Passes and a Sparkling Finish', 'kicker': 'Track and Field | Relays', 'content_kicker': None, 'print_headline': 'Clean Passes and a Sparkling Finish', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Track and Field', 'rank': 1, 'major': 'N'}, {'name': 'subj