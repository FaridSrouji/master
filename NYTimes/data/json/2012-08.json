eo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Pussy Riot', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-26T22:01:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Andrew E. Kramer', 'person': [{'firstname': 'Andrew', 'middlename': 'E.', 'lastname': 'Kramer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b489ebad-2828-567d-b8ef-72995a1096f2', 'word_count': 517, 'uri': 'nyt://article/b489ebad-2828-567d-b8ef-72995a1096f2'}, {'abstract': 'The decision to shift “Jimmy Kimmel Live” into the time slot long held by “Nightline” is a hurtful and possibly fatal blow to the program, former members of the news show say.', 'web_url': 'https://www.nytimes.com/2012/08/27/business/media/jimmy-kimmels-new-time-slot-may-seal-fate-of-nightline.html', 'snippet': 'The decision to shift “Jimmy Kimmel Live” into the time slot long held by “Nightline” is a hurtful and possibly fatal blow to the program, former members of the news show say.', 'lead_paragraph': 'Jimmy Kimmel’s ascent to the main stage of late-night television — the hour directly after the 11 p.m. local news — was greeted last week with widespread congratulations for a performer who had paid his dues and for a network willing to shake up the late-night status quo and bet on a comedic challenger to David Letterman and Jay Leno.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/27/business/media/27kimmel-jessica-biel/27kimmel-jessi