t', 'value': 'Asylum, Right of', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-08-19T15:59:18+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Ravi Somaiya', 'person': [{'firstname': 'Ravi', 'middlename': None, 'lastname': 'Somaiya', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/776570e8-1e00-535d-bf9a-5c6609d89e85', 'word_count': 674, 'uri': 'nyt://article/776570e8-1e00-535d-bf9a-5c6609d89e85'}, {'abstract': 'The P.G.A. Championship offered vivid demonstrations of the power of the sand wedge.', 'web_url': 'https://onpar.blogs.nytimes.com/2012/08/19/let-the-bounce-bail-you-out-of-sand-traps/', 'snippet': 'The P.G.A. Championship offered vivid demonstrations of the power of the sand wedge.', 'lead_paragraph': 'Anyone watching the recent P.G.A. Championship noticed that there was a lot of sand on the Kiawah Island Ocean Course, nearly 200 acres in one form or another. And the best players in the world, including the winner, Rory McIlroy, were in the sand often.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Let the Bounce Bail You Out of Sand Traps', 'kicker': 'On Par', 'content_kicker': None, 'print_headline': 'Let the Bounce Bail You Out Of Sand Traps', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-19T16:36:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Bill Pennington', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Pennington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/50edd587-0dba-5cab-94cb-eb479ef614e1', 'word_count': 349, 'uri': 'nyt://article/50edd587-0dba-5cab-94cb-eb479ef614e1'}, {'abstract': 'Golf Digest Live offers GPS, statistic tracking, a personalized magazine and a sense of humor.', 'web_url': 'https://onpar.blogs.nytimes.com/2012/08/19/a-golf-app-as-useful-as-a-player-needs-it-to-be/', 'snippet': 'Golf Digest Live offers GPS, statistic tracking, a personalized magazine and a sense of humor.', 'lead_paragraph': 'A golf GPS device was one of the first tools available for the iPhone, and now there are apps for all kinds of things in your golf game.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Golf App as Useful as a Player Needs It to Be', 'kicker': 'On Par', 'content_kicker': None, 'print_headline': 'An App as Useful as You Want', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-19T16:37:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Bill Pennington', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Pennington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/019603ed-5991-5323-a916-90d2e5a22a8f', 'word_count': 428, 'uri': 'nyt://article/019603ed-5991-5323-a916-90d2e5a22a8f'}, {'abstract': 'Golf and fly-fishing, pastimes of many on the PGA Tour, share more than their ancestry: both appeal to those with contemplative temperaments, and both can arouse a powerful fascination.', 'web_url': 'https://onpar.blogs.nytimes.com/2012/08/19/for-golfers-a-change-of-scenery-and-of-pace/', 'snippet': 'Golf and fly-fishing, pastimes of many on the PGA Tour, share more than their ancestry: both appeal to those with contemplative temperaments, and both can arouse a powerful fascination.', 'lead_paragraph': 'While shepherds were whacking bits of dried sheep dung around the spongy coastline of eastern Scotland in golf’s formative days, in the late 15th century, sportsmen and women to the south, in England, were tinkering with the use of artificial baits in what would come to be known as fly-fishing.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For Golfers, a Change of Scenery, and of Pace', 'kicker': 'On Par', 'content_kicker': None, 'print_headline': 'For Golfers, A Change Of Scenery, And of Pace', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fishing, Sport', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Golf', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-19T16:37:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Chris Santella', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Santella', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/761de59e-8547-504c-bc0d-96bb34f5eac9', 'word_count': 805, 'uri': 'nyt://article/761de59e-8547-504c-bc0d-96bb34f5eac9'}, {'abstract': 'The Red Bulls take their undefeated home record against the Portland Timbers, the second-worst team in Major League Soccer, Sunday evening at Red Bull Arena.', 'web_url': 'https://goal.blogs.nytimes.com/2012/08/19/preview-red-bulls-vs-portland/', 'snippet': 'The Red Bulls take their undefeated home record against the Portland Timbers, the second-worst team in Major League Soccer, Sunday evening at Red Bull Arena.', 'lead_paragraph': 'The Red Bulls take their undefeated home record against the Portland Timbers, the second-worst team in Major League Soccer, Sunday evening at Red Bull Arena in Harrison, N.J. And from all indications it should be another three points at home, enabling the Red Bulls (12-7-5, 41 points) to keep pace in the Eastern Conference with Kansas City (14-7-4, 46 points), which won its third straight game Saturday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Preview: Red Bulls vs. Portland', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Backe, Hans', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Henry, Thierry', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Soccer', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Red Bulls (Soccer Team)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Portland Timbers (Soccer Team)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Harrison (NY)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-19T16:48:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3919481-37e7-542d-af46-06607c8381c4', 'word_count': 868, 'uri': 'nyt://article/c3919481-37e7-542d-af46-06607c8381c4'}, {'abstract': 'Video of the complete remarks made on Sunday by Julian Assange, the founder of WikiLeaks, who told supporters at the Ecuadorean Embassy in London he was a victim of a global war on free speech, tying his plight to that of dissidents in the United States, Bahrain and Russia.', 'web_url': 'https://thelede.blogs.nytimes.com/2012