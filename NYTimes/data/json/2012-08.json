 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6496cc9-964c-55b4-bed8-4a5421ba791f', 'word_count': 730, 'uri': 'nyt://article/f6496cc9-964c-55b4-bed8-4a5421ba791f'}, {'abstract': 'Noteworthy cultural events in the New York area.', 'web_url': 'https://www.nytimes.com/2012/08/17/arts/spare-times-for-aug-17-23.html', 'snippet': 'Noteworthy cultural events in the New York area.', 'lead_paragraph': 'Around Town', 'print_section': 'C', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spare Times for Aug. 17-23', 'kicker': None, 'content_kicker': None, 'print_headline': 'Spare Times', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Culture (Arts)', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-16T22:27:47+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Liz Gerecitano', 'person': [{'firstname': 'Liz', 'middlename': None, 'lastname': 'Gerecitano', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/9e27a69b-2cd7-56d3-94a4-5a42eca52145', 'word_count': 3069, 'uri': 'nyt://article/9e27a69b-2cd7-56d3-94a4-5a42eca52145'}, {'abstract': 'In Jake Schreier’s “Robot & Frank,” Frank Langella plays an elderly parent living alone whose son gives him a robot minder.', 'web_url': 'https://www.nytimes.com/2012/08/17/movies/frank-langella-in-robot-frank.html', 'snippet': 'In Jake Schreier’s “Robot & Frank,” Frank Langella plays an elderly parent living alone whose son gives him a robot minder.', 'lead_paragraph': 'In American movies, old people tend to be cute or crotchety, though sometimes they’re both. Ruth Gordon is cute in “Harold and Maude” and somewhat cute if also somehow menacing, at least at first, in “Rosemary’s Baby.” (Later, when the old lady comes out as a Satanist, she’s the ne plus ultra of crotchety: evil.) In “Robot & Frank,” an eager-to-please story set in the near future about an elderly gent, his robot and some awkwardly managed truths about old age, Frank Langella plays so many variations on cute and crotchety and with such suppleness — he’s by turns a charming codger, a silver fox and a wise graybeard — that his performance comes close to a saving grace. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17ROBOT_SPAN/17ROBOT_SPAN-articleLarge-v2.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/17/arts/17ROBOT_SPAN/17ROBOT_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17ROBOT_SPAN/17ROBOT_SPAN-jumbo-v2.jpg', 'height': 436, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17ROBOT_SPAN/17ROBOT_SPAN-superJumbo-v2.jpg', 'height': 872, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17ROBOT_SPAN/17ROBOT_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/17/arts/17ROBOT_SPAN/17ROBOT_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17ROBOT_SPAN/17ROBOT_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When a New Best Friend Hits the Ground Whirring', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'When a New Best Friend Hits the Ground Whirring', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Langella, Frank', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sarandon, Susan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sarsgaard, Peter', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Tyler, Liv', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Robot & Frank (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-16T22:29:26+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/24cf664c-623f-5dee-8974-10e5271934d8', 'word_count': 647, 'uri': 'nyt://article/24cf664c-623f-5dee-8974-10e5271934d8'}, {'abstract': 'This documentary by Ali Samadi Ahadi bears witness to the exhilaration that preceded the presidential election of June 2009 and to the violence that followed.', 'web_url': 'https://www.nytimes.com/2012/08/17/movies/movie-review-the-green-wave-documents-irans-green-revolution.html', 'snippet': 'This documentary by Ali Samadi Ahadi bears witness to the exhilaration that preceded the presidential election of June 2009 and to the violence that followed.', 'lead_paragraph': 'By turns frustrating and moving, Ali Samadi Ahadi’s documentary “The Green Wave,” about the Green Revolution in Iran, gets a jolt from footage shot by the people for the people on the people’s cellphones. Shaky, blurry, sometimes hard to make sense of, these images bear witness to the exhilaration that preceded the presidential election of June 2009 and to the violence that followed. The film also has animated sequences and interviews with Iranian exiles, but nothing matches the effectiveness of that raw, you-are-there footage.', 'print_section': 'C', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17GREEN/17GREEN-articleLarge-v2.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/17/arts/17GREEN/17GREEN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17GREEN/17GREEN-jumbo-v2.jpg', 'height': 649, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17GREEN/17GREEN-superJumbo-v2.jpg', 'height': 1152, 'width': 1818, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17GREEN/17GREEN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/17/arts/17GREEN/17GREEN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/17/arts/17GREEN/17GREEN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Upheaval in Iran, Brought to You Live by the Protesters', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Upheaval in Iran, Brought to You Live by the Protesters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Green Wave (Movie)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-16T22:31:42+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Rachel Saltz', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Saltz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/54823ee7-9c3f-50f0-a161-32481cf108bc', 'word_count': 465, 'uri': 'nyt://article/54823ee7-9c3f-50f0-a161-32481cf108bc'}, {'abstract': 'Oregon seems to be just to the ideological left of where most political observers place the border between competitive and safely Democratic states.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2012/08/16/oregon-sitting-at-the-border-of-safe-and-in-play/', 'snippet': 'Oregon seems to be just to the ideological left of where most political observers place the border between competitive and safely Democratic states.', 'lead_paragraph': 'Today we continue our Presidential Geography series, a one-by-one examination of the peculiarities that drive the politics in all 50 states and the District of Columbia. Today’s stop: Oregon, the Beaver State. FiveThirtyEight spoke with William Lunch, a professor in political science at Oregon State University, and Jeff Mapes and Harry Esteve, both of whom report on politics for The Oregonian.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Oregon, Sitting at the Border of Safe and In Play', 'kicker': 'FiveThi