int_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/books/review/02krueger/02krueger-jumbo.jpg', 'height': 254, 'width': 252, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/books/review/02krueger/02krueger-superJumbo.jpg', 'height': 254, 'width': 252, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/books/review/02krueger/02krueger-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/02/books/review/02krueger/02krueger-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/books/review/02krueger/02krueger-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'TBR: Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-31T16:06:16+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb472354-c04a-55a9-876d-3b3614f6916d', 'word_count': 653, 'uri': 'nyt://article/bb472354-c04a-55a9-876d-3b3614f6916d'}, {'abstract': 'We can do this! But we won’t.', 'web_url': 'https://krugman.blogs.nytimes.com/2012/08/31/bernanke-in-the-hole/', 'snippet': 'We can do this! But we won’t.', 'lead_paragraph': 'Jackson Hole, that is.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bernanke in the Hole', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-31T16:07:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ec8002ad-bf2a-599c-ae99-e38bcec19ce9', 'word_count': 94, 'uri': 'nyt://article/ec8002ad-bf2a-599c-ae99-e38bcec19ce9'}, {'abstract': 'Terence Tyler, a worker at a Pathmark Super Center, returned to the store in Old Bridge with an AK-47 assault rife after leaving his shift, the police said.', 'web_url': 'https://www.nytimes.com/2012/09/01/nyregion/shooting-at-a-new-jersey-pathmark-leaves-3-dead.html', 'snippet': 'Terence Tyler, a worker at a Pathmark Super Center, returned to the store in Old Bridge with an AK-47 assault rife after leaving his shift, the police said.', 'lead_paragraph': 'OLD BRIDGE, N.J. — A supermarket worker left his overnight shift here then returned with an AK-47 assault rifle and killed two co-workers before fatally shooting himself, officials said on Friday.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/01/nyregion/Y-JERSEY2/Y-JERSEY2-jumbo.jpg', 'height': 857, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/01/nyregion/Y-JERSEY2/Y-JERSEY2-superJumbo.jpg', 'height': 1714, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/01/nyregion/Y-JERSEY2/Y-JERSEY2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/01/nyregion/Y-JERSEY2/Y-JERSEY2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/01/nyregion/Y-JERSEY2/Y-JERSEY2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Man Kills 2 Co-Workers and Himself in New Jersey', 'kicker': None, 'content_kicker': None, 'print_headline': 'Man Kills 2 Co-Workers And Himself In New Jersey', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Pathmark', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-31T16:07:29+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Patrick McGeehan', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'McGeehan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24d01e54-9b2f-5a53-90f2-398fbbf3b590', 'word_count': 553, 'uri': 'nyt://article/24d01e54-9b2f-5a53-90f2-398fbbf3b590'}, {'abstract': 'On Wednesday, Irina Falconi and Maria Sanchez won in women’s doubles at the United States Open. On Friday, she’ll play mixed doubles with Steve Johnson.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/08/31/the-open-chronicles-sweet-victory/', 'snippet': 'On Wednesday, Irina Falconi and Maria Sanchez won in women’s doubles at the United States Open. On Friday, she’ll play mixed doubles with Steve Johnson.', 'lead_paragraph': 'Irina Falconi, who is playing at the United States Open this year, will write posts throughout the tournament for Straight Sets. She has her own tumblr page, and can be followed on Twitter. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Open Chronicles: Sweet Victory', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-31T16:15:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By IRINA FALCONI', 'person': [{'firstname': 'Irina', 'middlename': None, 'lastname': 'FALCONI', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a620077-8a4a-53fb-9ce1-457f124b0c33', 'word_count': 264, 'uri': 'nyt://article/4a620077-8a4a-53fb-9ce1-457f124b0c33'}, {'abstract': 'What Romney’s speech accomplished, and the opening it left the Democrats.', 'web_url': 'https://douthat.blogs.nytimes.com/2012/08/31/romneys-speech-and-obamas-opportunity/', 'snippet': 'What Romney’s speech accomplished, and the opening it left the Democrats.', 'lead_paragraph': 'Watching Mitt Romney’s convention speech last night, I felt like I was watching the best possible execution of what’s been the Romney campaign’s strategy for most of this general-election season. That strategy sees a public sufficiently primed to vote against Barack Obama that all Romney needs to do is present a plausible, acceptable, non-threatening alternative and he can grab a narrow, 51-49 win. It sees the kind of steps required to potentially expand that 51 percent to, say, 53 percent as simply too risky – in a polarized country and with a restive base – for the Republican candidate to undertake. And if you accept those two premises, last night’s speech was well-conceived and well-delivered: It was a genuinely humanizing and even moving performance that addressed what’s been his biggest liability to date – his career at Bain Capital – head-on while otherwise supplying only the most general, non-threatening account of what a President Romney might actually do in office. If all Romney needs to do to win in November is be an acceptable alternative for a weary and disappointed electorate, then this performance helped him clear that bar.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney’s Speech and Obama’s Opportunity', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-31T16:19:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c96f231-50e5-5f5c-8cf8-3187dc15609a', 'word_count': 515, 'uri': 'nyt://article/3c96f231-50e5-5f5c-8cf8-3187dc15609a'}, {'abstract': 'With his-and-his jets in the background now wrapped with campaign slogans and logos, Mitt Romney and Representative Paul D. Ryan waved goodbye to Florida on Friday morning,', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/08/31/one-more-rally-before-ryan-and-romney-leave-florida/', 'snippet': 'With his-and-his jets in the background now wrapped with campaign slogans and logos, Mitt Romney and Representative Paul D. Ryan waved goodbye to Florida on Friday morning,', 'lead_paragraph': 'LAKELAND, Fla. — With his-and-his jets in the background now wrapped with campaign slogans and logos, Mitt Romney and Representative Paul D. Ryan waved goodbye to Florida on Friday morning, repeating favorite lines from their convention speeches while seeking to mobilize the 2,000 supporters who turned out to help carry this largest, most crucial of battleground states. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'One More Rally Before Ryan and Romney Leave Florida', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Republican National Convention', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-31T16:22:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9b4446af-5f78-55ba-97d7-9e2b407515c7', 'word_count': 578, 'uri': 'nyt://article/9b4446af-5f78-55ba-97d7-9e2b407515c7'}, {'abstract': 'In separate incidents, the decapitated bodies of a 7-year-old girl and a 12-year-old boy were found on Friday, continuing a spate of grisly beheadings in Afghanistan this week.', 'web_url': 'https://www.nytimes.com/2012/09/01/world/asia/young-girl-and-boy-found-beheaded-in-afghanistan.html', 'snippet': 'In separate incidents, the decapitated bodies of a 7-year-old girl and a 12-year-old boy were found on Friday, continuing a spate of grisly beheadings in Afghanistan this week.', 'lead_paragraph': 'KABUL, Afghanistan — The decapitated bodies of a 7-year-old girl and a 12-year-old boy found Friday in the country’s south and east continued a spate of grisly beheadings in Afghanistan this week.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Young Girl and Boy Found Beheaded in Afghanistan', 'kicker': None, 'content_kicker': None, 'print_headline': 'Decapitated Bodies of a Girl, 7, and a Boy, 12, Are Discovered in Afghanistan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Kandahar (Afghanistan)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-31T16:23:34+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Graham Bowley and Taimoor Shah', 'person': [{'firstname': 'Graham', 'middlename': None, 'lastname': 'Bowley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Taimoor', 'middlename': None, 'lastname': 'Shah', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ccf689cc-b95f-54ec-ae4d-4e862c25e94f', 'word_count': 549, 'uri': 'nyt://article/ccf689cc-b95f-54ec-ae4d-4e862c25e94f'}, {'abstract': 'Washington was the Union capital, but some of its most famous families were divided between North and South.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/08/31/the-divided-capital/', 'snippet': 'Washington was the Union capital, but some of its most famous families were divided between North and South.', 'lead_paragraph': 'Though Civil War Washington was the capital of the Union, its population was dangerously split between Northern and Southern sympathizers. Pro-South feelings ran strongest in the Georgetown section. Started as a tobacco port in 1751, Georgetown, long a separate city within the District of Columbia, was dominated by a few leading families, who ran their corner of Washington like royalty. The Peter family was one. Robert Peter had been first mayor of Georgetown; Martha Washington’s granddaughter had married his son. When the Civil War came, two of the Peter sons joined the Confederate Army. To the everlasting sorrow and resentment of the family, they were hanged as spies after being captured in civilian clothes by Union troops in Virginia. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Divided Capital', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-31T16:30:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By James H. Johnston', 'person': [{'firstname': 'James', 'middlename': 'H.', 'lastname': 'Johnston', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3bdaec64-b7dc-5d57-811d-4a29df6db80b', 'word_count': 2259, 'uri': 'nyt://article/3bdaec64-b7dc-5d57-811d-4a29df6db80b'}, {'abstract': 'How to master the latest look from Paris: East Coast trad crossed with Left Bank tradition.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/08/31/prep-porter/', 'snippet': 'How to master the latest look from Paris: East Coast trad crossed with Left Bank tradition.', 'lead_paragraph': 'var data;function js