s': [{'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ARKANSAS', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality and Misconduct', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Carter, Chavis', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-22T02:37:53+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Christine Hauser', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Hauser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c054fe98-bd52-56bd-9526-22b1cd9fa7d5', 'word_count': 831, 'uri': 'nyt://article/c054fe98-bd52-56bd-9526-22b1cd9fa7d5'}, {'abstract': 'Much has been made of Washington Nationals not wanting their young ace, Stephen Strasburg, to pitch too much. The Mets are following that cue with Matt Harvey.', 'web_url': 'https://www.nytimes.com/2012/08/22/sports/baseball/mets-consider-limiting-innings-of-pitcher-matt-harvey.html', 'snippet': 'Much has been made of Washington Nationals not wanting their young ace, Stephen Strasburg, to pitch too much. The Mets are following that cue with Matt Harvey.', 'lead_paragraph': 'With the Mets toddling toward the end of the season, their postseason hopes all but extinguished, how far they should push various pitchers has become a central question. ', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/sports/METS/METS-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/sports/METS/METS-superJumbo.jpg', 'height': 1365, 'width'