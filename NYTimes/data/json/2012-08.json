name': 'Isabel', 'middlename': None, 'lastname': 'Kershner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d04d3a40-7e11-5b81-a919-123682ec4f1f', 'word_count': 681, 'uri': 'nyt://article/d04d3a40-7e11-5b81-a919-123682ec4f1f'}, {'abstract': 'A former insurance company chief executive writes that the Romney-Ryan plan will increase the country’s health care bill.', 'web_url': 'https://www.nytimes.com/2012/08/29/opinion/medicare-voucher-costs.html', 'snippet': 'A former insurance company chief executive writes that the Romney-Ryan plan will increase the country’s health care bill.', 'lead_paragraph': ' ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Medicare Voucher Costs', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Medicare Voucher Costs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicare', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Reform and Reorganization', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-28T20:54:31+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/72fbc7d0-2f88-5c81-8f2b-3d62e34068d2', 'word_count': 224, 'uri': 'nyt://article/72fbc7d0-2f88-5c81-8f2b-3d62e34068d2'}, {'abstract': 'Governments do it better.', 'web_url': 'https://krugman.blogs.nytimes.com/2012/08/28/public-versus-private-cost-control-in-health/', 'snippet': 'Governments do it better.', 'lead_paragraph': 'Austin Frakt at the The Incidental Economist has a much more comprehensive list than mine on the overwhelming evidence that when it comes to health care costs, the public sector is better at keeping them down than the private sector. Also at TIE, Aaron Carrol asks, Why Is This So Hard To Understand?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Public Versus Private Cost Control in Health', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-28T20:57:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8942978f-a742-5350-8c08-00d06db14a6c', 'word_count': 244, 'uri': 'nyt://article/8942978f-a742-5350-8c08-00d06db14a6c'}, {'abstract': 'The message of “Cougar the Musical” is that relationships between older women and younger men are a great idea.', 'web_url': 'https://www.nytimes.com/2012/08/29/theater/reviews/cougar-the-musical-opens-at-st-lukes-theater.html', 'snippet': 'The message of “Cougar the Musical” is that relationships between older women and younger men are a great idea.', 'lead_paragraph': 'The marital split of Ashton Kutcher and Demi Moore threw the creators of “Cougar the Musical.” You can tell because those stars’ names are in the lyrics, but with disclaimers like “before they broke up” inserted. The show’s message remains that relationships between older women and younger men are a great idea. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/arts/cougar/cougar-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/arts/cougar/cougar-superJumbo.jpg', 'heig