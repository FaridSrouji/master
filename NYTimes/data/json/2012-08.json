 shacks behind them.', 'print_section': 'M2', 'print_page': '148', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/t-magazine/19talk-baku-slide-W3M5/19talk-baku-slide-W3M5-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/t-magazine/19talk-baku-slide-W3M5/19talk-baku-slide-W3M5-superJumbo.jpg', 'height': 1064, 'width': 1596, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/t-magazine/19talk-baku-slide-W3M5/19talk-baku-slide-W3M5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/t-magazine/19talk-baku-slide-W3M5/19talk-baku-slide-W3M5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/t-magazine/19talk-baku-slide-W3M5/19talk-baku-slide-W3M5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Big in Baku', 'kicker': None, 'content_kicker': None, 'print_headline': 'Big in Baku', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Baku (Azerbaijan)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Azerbaijan', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-15T14:00:15+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 