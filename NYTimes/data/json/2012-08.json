page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Destroying Precious Land for Gas', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Destroying Precious Land for Gas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Water Pollution', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hydraulic Fracturing', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lennon, John', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Natural Gas', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-28T00:18:28+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Sean Lennon', 'person': [{'firstname': 'Sean', 'middlename': None, 'lastname': 'Lennon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/13dfc1c7-546c-5434-bfa3-e84a553ff983', 'word_count': 952, 'uri': 'nyt://article/13dfc1c7-546c-5434-bfa3-e84a553ff983'}, {'abstract': 'Mitt Romney is arriving at the convention city earlier than expected.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/08/27/romney-to-arrive-in-tampa-tuesday/', 'snippet': 'Mitt Romney is arriving at the convention city earlier than expected.', 'lead_paragraph': 'TAMPA, Fla. — The Republican National Convention will be welcoming its newest — and most high-profile — guest on Tuesday: Mitt Romney himself.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney to Arrive in Tampa on Tuesday', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Republican National Convention', 'rank': 2, 'major': 'N'},