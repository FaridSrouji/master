, 'multimedia': [], 'headline': {'main': 'Election Unit, Part 4: What Do You Think?', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-31T15:00:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/94e4e80c-8468-5989-8204-8773d26b688c', 'word_count': 1083, 'uri': 'nyt://article/94e4e80c-8468-5989-8204-8773d26b688c'}, {'abstract': 'Christoph Niemann illustrates tweets from the fourth day of the Republican National Convention.', 'web_url': 'https://www.nytimes.com/video/magazine/100000001753180/day-3-of-illustrations-from-the-rnc.html', 'snippet': 'Christoph Niemann illustrates tweets from the fourth day of the Republican National Convention.', 'lead_paragraph': 'Christoph Niemann illustrates tweets from the fourth day of the Republican National Convention.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/31/magazine/video-rnc-day4-7pm-niemann/video-rnc-day4-7pm-niemann-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/31/magazine/video-rnc-day4-7pm-niemann/video-rnc-day4-7pm-niemann-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/31/magazine/video-rnc-day4-7pm-niemann/video-rnc-day4-7pm-niemann-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/31/magazine