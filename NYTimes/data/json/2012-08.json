 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-31T22:53:30+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/0c109f13-34db-5b0e-a27d-97a647ecd712', 'word_count': 0, 'uri': 'nyt://slideshow/0c109f13-34db-5b0e-a27d-97a647ecd712'}, {'abstract': 'Those who knew the previous iteration of the Old Lyme Inn, which reopened in April, will find a brighter and airier interior, but with a familiar, cozy atmosphere.', 'web_url': 'https://www.nytimes.com/2012/09/02/nyregion/a-review-of-the-old-lyme-inn-in-old-lyme.html', 'snippet': 'Those who knew the previous iteration of the Old Lyme Inn, which reopened in April, will find a brighter and airier interior, but with a familiar, cozy atmosphere.', 'lead_paragraph': 'THE OLD LYME INN reopened in April after a year’s renovation by the couple who now own it, Ken and Chris Kitchings, and it fairly gleams under a glossy coat of white paint. Those who knew the place in its previous incarnation will find the interior brighter, and airier, too. Walls in the three dining areas — the main dining room, the intimate Peterson Room and the bar — have been repainted in shades of white and cream, white oak flooring has replaced dark blue carpets, and a window cut between bar and reception allows additional light.', 'print_section': 'CT', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/nyregion/02DINECT1/02DINECT1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank'