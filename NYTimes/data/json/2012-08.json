f85b2-7f34-556f-bf77-20b86d94eb3e', 'word_count': 440, 'uri': 'nyt://article/777f85b2-7f34-556f-bf77-20b86d94eb3e'}, {'abstract': 'Mr. Hope, a producer whose credits include “American Splendor” and “The Ice Storm,” will be leaving New York to assume his new post on Sept. 1, the film society announced this week.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/08/08/another-new-york-transplant-ted-hope-to-lead-san-francisco-film-society/', 'snippet': 'Mr. Hope, a producer whose credits include “American Splendor” and “The Ice Storm,” will be leaving New York to assume his new post on Sept. 1, the film society announced this week.', 'lead_paragraph': 'Yet another leading light in the New York independent film world, Ted Hope, has been named to a position that has been held by two prominent New Yorkers: the executive directorship the San Francisco Film Society.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Another New York Transplant, Ted Hope, to Lead San Francisco Film Society', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hope, Ted', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco Film Society', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-09T01:23:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ed68e86-4043-5828-8612-7497922aa22d', 'word_count': 150, 'uri': 'nyt://article/5ed68e86-4043-5828-8612-7497922aa22d'}, {'abstract': 'Kevin Durant made 4 of 9 shots from beyond the arc and finished with 14 points as the United States basketball team pulled away from Australia, 119-86.', 'web_url': 'https://www.nytimes.com/2012/08/09/sports/olympics/on-target-again-kevin-durant-sparks-us-basketball-win.html', 'snippet': 'Kevin Durant made 4 of 9 shots from beyond the arc and finished with 14 points as the United States basketball team pulled away from Australia, 119-86.', 'lead_paragraph': 'LONDON — The point guards bother Kevin Durant the most. They find him in meetings, on buses, in hallways of hotels. Shoot the ball, they tell him. Shoot. The. Ball.', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/09/sports/09hoops_span/09hoops_span-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/09/sports/09hoops_span/09hoops_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/09/sports/09hoops_span/09hoops_span-jumbo.jpg', 'height': 743, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/09/sports/09hoops_span/09hoops_span-superJumbo.jpg', 'height': 1487, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/09/sports/09hoops_span/09hoops_span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/09/sports/09hoops_span/09hoops_span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Urged to Shoot, Durant Obliges as U.S. Ousts Australia', 'kicker': "Basketball | Men's Quarterfinals", 'content_kicker': None, 'print_headline': 'Urged to Shoot, Durant Obliges as U.S. Ousts Australia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Durant, Kevin', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-09T01:26:39+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Greg Bishop', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8f66bf45-bfc0-57ff-bea5-9df4be4ef3e3', 'word_count': 712, 'uri': 'nyt://article/8f66bf45-bfc0-57ff-bea5-9df4be4ef3e3'}, {'abstract': 'The attack appeared to be the work of organized criminals, according to an official from the state prosecutor’s office.', 'web_url': 'https://www.nytimes.com/2012/08/09/world/americas/mexico-attack-kills-four-in-acapulco.html', 'snippet': 'The attack appeared to be the work of organized criminals, according to an official from the state prosecutor’s office.', 'lead_paragraph': ' Gunmen burst into a house in Acapulco late Tuesday night, killing four people — including a pregnant woman and a 3-year-old girl — and wounding one person, Mexican authorities said. The attack appeared to be the work of organized criminals, according to an official from the state prosecutor’s office. “Acapulco has become a place with high rates of drug consumption,” said the official, who spoke on the condition of anonymity. Amid President Felipe Calderón’s crackdown against drug gangs, Acapulco, formerly a popular tourist destination for Americans, saw a drastic increase in homicides in 2010 and 2011. ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mexico: Attack Kills Four in Acapulco', 'kicker': 'World Briefing | The Americas', 'content_kicker': None, 'print_headline': 'Mexico: Attack Kills Four in Acapulco', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ACAPULCO (MEXICO)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Crime', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-09T01:33:21+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Karla Zabludovsky', 'person': [{'firstname': 'Karla', 'middlename': None, 'lastname': 'Zabludovsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/a62620bb-9971-5118-9879-ba1f9fc6b00c', 'word_count': 98, 'uri': 'nyt://article/a62620bb-9971-5118-9879-ba1f9fc6b00c'}, {'abstract': 'Misty May-Treanor and Kerri Walsh Jennings defeated their fellow Americans in the final.', 'web_url': 'https://www.nytimes.com/slideshow/2012/08/08/sports/olympics/20120808-B_Vollyball.html', 'snippet': 'Misty May-Treanor and Kerri Walsh Jennings defeated their fellow Americans in the final.', 'lead_paragraph': 'Misty May-Treanor and Kerri Walsh Jennings defeated their fellow Americans in the final.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/08/sports/20120808-B_Vollyball-slide-MBZF/20120808-B_Vollyball-slide-MBZ