rds': [{'name': 'glocations', 'value': 'Cobble Hill (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'BATTERY PARK CITY (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Flatiron District (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-03T19:27:02+0000', 'document_type': 'multimedia', 'news_desk': 'Real Estate', 'section_name': 'Real Estate', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/ff0ea079-bcf8-56d4-99a9-5c0bd937d593', 'word_count': 0, 'uri': 'nyt://slideshow/ff0ea079-bcf8-56d4-99a9-5c0bd937d593'}, {'abstract': '“Parker: The Score,” an adaptation of a Richard Stark novel by the cartoonist Darwyn Cooke, is new to the graphic books hardcover best-seller list.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/08/03/graphic-books-best-sellers-parker-plans-his-biggest-heist/', 'snippet': '“Parker: The Score,” an adaptation of a Richard Stark novel by the cartoonist Darwyn Cooke, is new to the graphic books hardcover best-seller list.', 'lead_paragraph': '“Parker: The Score,” an adaptation of a Richard Stark novel by the cartoonist Darwyn Cooke, is new to the graphic books hardcover best-seller list this week at No. 7. The story centers on Parker, a coldhearted thief who is planning his biggest heist yet: stealing everything of value from an isolated small town in North Dakota. As in past stories, Parker doesn’t suffer fools, is brutally efficient and doesn’t let any emotional ties get in his way. All of which makes reading “The Score” completely delectable. It’s a perfect companion to “The Hunter” and “The Outfit.” Parker may be tough and icy, but he still somehow has charms, à la George Clooney in “Ocean’s Eleven.” The fourth Parker adaptation is due next year.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Graphic Books Best Sellers: Parker Plans His Biggest Heist', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Graphic Novels', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'COOKE, DARWYN', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Stark, Richard', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-03T19:30:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By George Gene Gustines', 'person': [{'firstname': 'George', 'middlename': 'Gene', 'lastname': 'Gustines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c124285d-8bd1-5f7a-b98e-5e0b25f060ba', 'word_count': 138, 'uri': 'nyt://article/c124285d-8bd1-5f7a-b98e-5e0b25f060ba'}, {'abstract': 'The realistic parent knows teenagers are likely to explore Internet pornography. How do you point them away from the worst of what’s out there?', 'web_url': 'https://parenting.blogs.nytimes.com/2012/08/03/how-do-you-steer-a-teenager-away-from-the-worst-porn/', 'snippet': 'The realistic parent knows teenagers are likely to explore Internet pornography. How do you point them away from the worst of what’s out there?', 'lead_paragraph': 'This week’s quandary came up when L. was talking with a friend about laundry. She’d taught her newly teenage son to wash his own clothes and, more relevantly, his sheets, and pushed him to do it regularly. She wanted\xa0 the laundry, and the nocturnal events that might lead to a teenage boy’s doing it, to feel ordinary.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Do You Steer a Teenager Away From the Worst Porn?', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parenting', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pornography', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-03T19:31:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b6178d26-2959-57ca-8ce8-3feb9c4888ef', 'word_count': 217, 'uri': 'nyt://article/b6178d26-2959-57ca-8ce8-3feb9c4888ef'}, {'abstract': 'President Obama will celebrate his 51st birthday in true political fashion, holding a party at his Chicago home with a bunch of strangers who made campaign donations to be there.', 'web_url': 'https://www.nytimes.com/2012/08/04/us/politics/obamas-birthday-party-as-fund-raising-opportunity.html', 'snippet': 'President Obama will celebrate his 51st birthday in true political fashion, holding a party at his Chicago home with a bunch of strangers who made campaign donations to be there.', 'lead_paragraph': 'President Obama is turning 51 on Saturday, with just three months until Election Day. So he will celebrate in true political fashion: spending “downtime,” as an e-mail invitation put it, at a party at his Chicago home with a bunch of strangers who made campaign donations to be there.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/04/us/sub-04birthday1/sub-04birthday1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/04/us/sub-04birthday1/sub-04birthday1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit