rs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-29T19:55:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jeremy W. Peters', 'person': [{'firstname': 'Jeremy', 'middlename': 'W.', 'lastname': 'Peters', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5c561a82-2d27-524c-9280-e4484ebcd166', 'word_count': 168, 'uri': 'nyt://article/5c561a82-2d27-524c-9280-e4484ebcd166'}, {'abstract': 'The Food Network chef Robert Irvine manages to combine a fast-paced culinary career with a passion for fitness.', 'web_url': 'https://well.blogs.nytimes.com/2012/08/29/whats-your-workout-a-food-stars-fitness-plan/', 'snippet': 'The Food Network chef Robert Irvine manages to combine a fast-paced culinary career with a passion for fitness.', 'lead_paragraph': 'The Food Network chef Robert Irvine hosts the popular show “Restaurant: Impossible,” in which he and his team race to turn around a troubled restaurant on a 48-hour deadline. During a recent episode, Mr. Irvine renovated a community center in Washington that provides tutoring and healthful meals to children – a challenge issued to him by Michelle Obama.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/30/health/30well_Workout/30well_Workout-jumbo.jpg', 'height': 1024, 'width': 473, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/30/health/30well_Workout/30well_Workout-superJumbo.jpg', 'height': 2048, 'width': 946, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/0