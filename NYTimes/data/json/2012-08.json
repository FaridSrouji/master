, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': '2 Days in New York (Movie)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rock, Chris', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-01T12:00:27+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/3058b5d1-d8f6-586d-a6ab-d8c51db86ee2', 'word_count': 1941, 'uri': 'nyt://article/3058b5d1-d8f6-586d-a6ab-d8c51db86ee2'}, {'abstract': 'London Live: Follow the Olympic action on Wednesday in cycling, gymnastics, fencing and more.', 'web_url': 'https://london2012.blogs.nytimes.com/2012/08/01/london-live-follow-wednesdays-action-at-the-olympics/', 'snippet': 'London Live: Follow the Olympic action on Wednesday in cycling, gymnastics, fencing and more.', 'lead_paragraph': 'The swimmer Nathan Adrian of the United States won the gold medal in the men’s 100-meter freestyle on Wednesday and the American women (Missy Franklin, Dana Vollmer, Alison Schmitt and Shannon Vreeland) won the gold medal and set an Olympic record in the women’s 4×200 relay.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'London Live: Follow Wednesday’s Action at the Olympics', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-01T12:05:34+0000', 'd