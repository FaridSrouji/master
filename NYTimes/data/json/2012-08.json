s', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Edmunds.com', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Honda Motor Co Ltd', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-09T22:11:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Jonathan Schultz', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Schultz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7589d30-2295-5983-8d94-985a26e928e2', 'word_count': 278, 'uri': 'nyt://article/d7589d30-2295-5983-8d94-985a26e928e2'}, {'abstract': 'A selected guide to dance performances in New York and summer dance festivals.', 'web_url': 'https://www.nytimes.com/2012/08/10/arts/dance/dance-listings-for-aug-10-16.html', 'snippet': 'A selected guide to dance performances in New York and summer dance festivals.', 'lead_paragraph': 'Dance', 'print_section': 'C', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dance Listings for Aug. 10-16', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Listings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-09T22:12:46+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/8bbd9e48-dad6-51bc-9eb0-139083297fbd', 'word_count': 1489, 'uri': 'nyt://article/8bbd9e48-dad6-51bc-9eb0-139083297fbd'}, {'abstract': 'A report by Bankrate.c