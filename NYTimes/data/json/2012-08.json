'}], 'pub_date': '2012-08-28T19:45:30+0000', 'document_type': 'multimedia', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'Zena Barakat and Ashley Parker', 'person': [{'firstname': 'Zena', 'middlename': None, 'lastname': 'Barakat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/1e4314ce-2ec1-5ff6-9b67-b11768b2dc71', 'word_count': 0, 'uri': 'nyt://video/1e4314ce-2ec1-5ff6-9b67-b11768b2dc71'}, {'abstract': '“The Ambassador,” a stunt documentary directed by Mads Brugger, follows a European adventurer seeking fortune in Africa.', 'web_url': 'https://www.nytimes.com/2012/08/29/movies/the-ambassador-directed-by-mads-brugger.html', 'snippet': '“The Ambassador,” a stunt documentary directed by Mads Brugger, follows a European adventurer seeking fortune in Africa.', 'lead_paragraph': 'In his new stunt documentary, “The Ambassador,” the Danish journalist and filmmaker Mads Brugger impersonates a European adventurer seeking his fortune in Africa. This character, named Mads Cortzen, might have been dreamed up by Joseph Conrad in collaboration with Sacha Baron Cohen. A slender, dapper fellow with a ginger beard and an ironical manner, Cortzen motors around Liberia and the Central African Republic in a flag-festooned Volvo, handing out bribes and secretly recording his meetings with government ministers, diamond mine owners and shady passport brokers.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/arts/29ambassador/29ambassador-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articl