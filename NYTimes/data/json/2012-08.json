alifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c7afc3e-3f24-52dd-bb67-c34918c3045f', 'word_count': 218, 'uri': 'nyt://article/6c7afc3e-3f24-52dd-bb67-c34918c3045f'}, {'abstract': 'A bicycle delivery worker was hit by a car on Monday evening on the Upper West Side.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/08/28/west-62nd-street-737-p-m/', 'snippet': 'A bicycle delivery worker was hit by a car on Monday evening on the Upper West Side.', 'lead_paragraph': 'A driver turning on to 62nd Street said he did not see this delivery worker until it was too late. The victim was taken to Roosevelt Hospital complaining of pain in his knee. The motorist, who told the police he was a German citizen, was ticketed for unlicensed operation of a motor vehicle.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'West 62nd Street, 7:37 P.M.', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-28T19:08:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/f409a432-4982-52aa-8196-fe2fddabdf8a', 'word_count': 53, 'uri': 'nyt://article/f409a432-4982-52aa-8196-fe2fddabdf8a'}, {'abstract': 'A small company in Nipomo, Calif., was contracted to build and provide all the flags for the Unites States Grand Prix Formula One race, scheduled for Nov. 18.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/08/28/color-guard-readies-its-wares-for-the-u-s-grand-prix/', 'snippet': 'A small company in Nipomo, Calif., was contracted to build and provide all the flags for the Unites States Grand Prix Formula One race, scheduled for Nov. 18.', 'lead_paragraph': 'The exigencies of building a racetrack from scratch have made the United States Grand Prix a fluttery matter in motorsports circles. But the race at the Circuit of the Americas in Austin, Tex., is scheduled for Nov. 18, providing a platform for the Texas capital, American fans of Formula One and a tiny flag maker in the town of Nipomo, just inland from the central coast of California.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Color Guard Readies Its Wares for the U.S. Grand Prix', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-28T19:10:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Ronald Ahrens', 'person': [{'firstname': 'Ronald', 'middlename': None, 'lastname': 'Ahrens', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/68eeee85-1e30-5e84-b441-bcb4fb4cfce8', 'word_count': 610, 'uri': 'nyt://article/68eeee85-1e30-5e84-b441-bcb4fb4cfce8'}, {'abstract': 'The Republican platform calls Medicaid a “black hole.”', 'web_url': 'https://takingnote.blogs.nytimes.com/2012/08/28/blame-the-poor/', 'snippet': 'The Republican platform calls Medicaid a “black hole.”', 'lead_paragraph': 'TAMPA, Fla. – Talking about dismantling health care for the poor might seem to clash with balloons and funny hats, but this is a Republican convention, so it fits right in with the celebratory mood.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Blame the Poor', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medicaid', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Republican National Convention', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-28T19:12:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Firestone', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Firestone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3bd46c0-158b-5099-8507-dbb8838955f5', 'word_count': 508, 'uri': 'nyt://article/e3bd46c0-158b-5099-8507-dbb8838955f5'}, {'abstract': 'The release of Michelle Martin, former wife and accomplice of the convicted child killer Marc Dutroux, infuriated families of victims of crimes that shocked the world 20 years ago.', 'web_url': 'https://www.nytimes.com/2012/08/29/world/europe/michelle-martin-former-wife-of-child-killer-marc-dutroux-is-released-in-belgium.html', 'snippet': 'The release of Michelle Martin, former wife and accomplice of the convicted child killer Marc Dutroux, infuriated families of victims of crimes that shocked the world 20 years ago.', 'lead_paragraph': 'BRUSSELS — The former wife and accomplice of the convicted child killer Marc Dutroux was released from prison on Tuesday afternoon after last-ditch appeals to keep her behind bars failed.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Former Wife of Child Killer Is Released in Belgium', 'kicker': None, 'content_kicker': None, 'print_headline': 'Killer’s Ex-Wife Freed in Belgium', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Belgium', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Crime and Criminals', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Courts and the Judiciary', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, Michelle', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Dutroux, Marc', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-28T19:15:08+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By James Kanter', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Kanter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9c97f3a-4def-58e9-b991-b34ade3f40fd', 'word_count': 610, 'uri': 'nyt://article/e9c97f3a-4def-58e9-b991-b34ade3f40fd'}, {'abstract': 'Although its report is not final, the New York City Office of Emergency Management has found that city residents advised in advance on the dangers of hurricanes and other storms are much more likely to evacuate.', 'web_url': 'https://green.blogs.nytimes.com/2012/08/28/education-a-key-to-hurricane-evacuations-city-finds/', 'snippet': 'Although its report is not final, the New York City Office of Emergency Management has found that city residents advised in advance on the dangers of hurricanes and other storms are much more likely to evacuate.', 'lead_paragraph': 'Of the 370,000 New York City residents ordered to evacuate as Hurricane Irene approached last Aug. 28, only about half chose to leave home, according to the city’s Office of Emergency Management.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Education a Key to Hurricane Evacuations, City Finds', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lopez, Margarita', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Office of Emergency Management (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-28T19:17:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Mireya Navarro', 'person': [{'firstname': 'Mireya', 'middlename': None, 'lastname': 'Navarro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e696ea87-86d2-52de-942a-759453048c3f', 'word_count': 444, 'uri': 'nyt://article/e696ea87-86d2-52de-942a-759453048c3f'}, {'abstract': 'Suzan-Lori Parks will direct her Pulitzer Prize-winning play at Two River Theater Company in New Jersey.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/08/28/playwright-will-stage-her-topdog-with-brothers-in-lead-roles/', 'snippet': 'Suzan-Lori Parks will direct her Pulitzer Prize-winning play at Two River Theater Company in New Jersey.', 'lead_paragraph': 'Ten years after Suzan-Lori Parks’s dark comedy “Topdog/Underdog” won the Pulitzer Prize for drama, Ms. Parks will be directing a new production of the play at Two River Theater Company in Red Bank, N.J. this fall. The show begins performances on Sept. 8, and continues through Sept. 30, with opening night set for Sept. 14.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Playwright Will Stage Her ‘Topdog’ With Brothers in Lead Roles', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Dirden Brothers Cast As Brothers in ‘Topdog’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Parks, Suzan-Lori', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Two River Theater Co', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-28T19:19:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5c174bc-c3cb-55a4-afcd-6ff3219edbac', 'word_count': 355, 'uri': 'nyt://article/e5c174bc-c3cb-55a4-afcd-6ff3219edbac'}, {'abstract': '“No Easy Day,” written by a member of the Navy SEALs team that killed Osama Bin Laden, will now go on sale Sept. 4. The publisher, Dutton, says its planned print run was increased to 575,000.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/08/28/release-of-book-on-bin-laden-raid-is-moved-up-a-week/', 'snippet': '“No Easy Day,” written by a member of the Navy SEALs team that killed Osama Bin Laden, will now go on sale Sept. 4. The publisher, Dutton, says its planned print run was increased to 575,000.', 'lead_paragraph': 'In response to a crush of media attention, criticism and consumers clamoring to buy the book, the publisher behind the first-hand account of the Navy SEALs raid that killed Osama bin Laden has decided to move up the release date to next Tuesday.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Release of Book on Bin Laden Raid Is Moved Up a Week', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'Bin Laden Book Release Moved Up', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'bin Laden, Osama', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bissonnette, Matt', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Owen, Mark', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Penguin Group', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-28T19:22:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0024055b-5583-573c-935e-b29e36bc52a2', 'word_count': 379, 'uri': 'nyt://article/0024055b-5583-573c-935e-b29e36bc52a2'}, {'abstract': 'Dealerships are willing to deliver your new car to your home, if you negotiate for it.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/08/28/negotiating-home-delivery-of-your-new-car/', 'snippet': 'Dealerships are willing to deliver your new car to your home, if you negotiate for it.', 'lead_paragraph': 'It might not be quite as easy as having a pizza delivered, but automotive site Edmunds.com advises that you can have your new car brought right to your home, instead of going to pick it up at the dealership.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Negotiating Home Delivery of Your New Car', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Reed, Philip', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Edmunds.com', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-28T19:24:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9a410756-f5f5-57ea-b6a9-593039779df2', 'word_count': 487, 'uri': 'nyt://article/9a410756-f5f5-57ea-b6a9-593039779df2'}, {'abstract': 'The two restaurants will trade staffs, menus and cities — New York and Chicago — for several days in September and October.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/08/28/trading-places-eleven-madison-park-and-alinea/', 'snippet': 'The two restaurants will trade staffs, menus and cities — New York and Chicago — for several days in September and October.', 'lead_paragraph': '“It’s a crazy idea,” said Daniel Humm, the chef at Eleven Madison Park. “But that’s what’s cool.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Trading Places: Eleven Madison Park and Alinea', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Achatz, Grant', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Eleven Madison Park (Manhattan, NY, Restaurant)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-28T19:30:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Jeff Gordinier', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Gordinier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39d1da07-a27a-585c-a6a7-d20a2375d548', 'word_count': 484, 'uri': 'nyt://article/39d1da07-a27a-585c-a6a7-d20a2375d548'}, {'abstract': 'Prime Minister Mario Monti of Italy is hoping to persuade his European partners to let the European Central Bank buy more government debt to help keep borrowing costs lower.', 'web_url': 'https://www.nytimes.com/2012/08/29/business/global/monti-tries-to-nudge-germany-to-back-ecb.html', 'snippet': 'Prime Minister Mario Monti of Italy is hoping to persuade his European partners to let the European Central Bank buy more government debt to help keep borrowing costs lower.', 'lead_paragraph': 'BERLIN — The top leaders of Germany and Italy plan to meet Wednesday as part of an intense round of shuttle diplomacy before several critical decisions that face Europe. The region’s leaders are struggling to appease voters questioning the price of unity in the euro currency union after three years of financial turmoil.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Germany and Italy to Meet on Euro Crisis', 'kicker': None, 'content_kicker': None, 'print_headline': 'Germany and Italy to Meet on Euro Crisis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Monti, Mario', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-28T19:31:50+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Melissa Eddy and Rachel Donadio', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Eddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Rachel', 'middlename': None, 'lastname': 'Donadio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9516a52a-603b-5b36-8d9f-03eea9877cd7', 'word_count': 919, 'uri': 'nyt://article/9516a52a-603b-5b36-8d9f-03eea9877cd7'}, {'abstract': 'The request from the most economically important region of Spain underscores a growing regional debt burden as the country struggles to pull out of its economic tailspin.', 'web_url': 'https://www.nytimes.com/2012/08/29/business/global/catalonia-asks-spanish-government-for-emergency-funds.html', 'snippet': 'The request from the most economically important region of Spain underscores a growing regional debt burden as the country struggles to pull out of its economic tailspin.', 'lead_paragraph': 'MADRID — The most economically important region of Spain, Catalonia, asked the national government on Tuesday for more than 5 billion euros in emergency financing, underscoring a growing regional debt burden as the country struggles to pull out of its economic tailspin.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/business/SPAIN-MONEY/SPAIN-MONEY-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/29/business/SPAIN-MONEY/SPAIN-MONEY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/business/SPAIN-MONEY/SPAIN-MONEY-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/business/SPAIN-MONEY/SPAIN-MONEY-superJumbo.jpg', 'height': 1338, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Shut Out of the Debt Markets, Catalonia Asks Madrid for Emergency Aid', 'kicker': None, 'content_kicker': None, 'print_headline': 'Shut Out of the Debt Markets, Catalonia Asks Madrid for Emergency Aid', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Spain', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Catalonia (Spain)', 'rank': 5, 'major': 'N'}], 'pub_date': '