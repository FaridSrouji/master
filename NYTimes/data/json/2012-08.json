or': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Ron', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-25T02:00:35+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/240ca696-02b4-5e15-93cd-58b5a0b05b10', 'word_count': 845, 'uri': 'nyt://article/240ca696-02b4-5e15-93cd-58b5a0b05b10'}, {'abstract': 'Corrections appearing in print on August 25, 2012.', 'web_url': 'https://www.nytimes.com/2012/08/25/pageoneplus/corrections-august-25-2012.html', 'snippet': 'Corrections appearing in print on August 25, 2012.', 'lead_paragraph': 'NEW YORK', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: August 25, 2012', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-25T02:00:57+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/fd61d0e1-dbed-542c-9ec5-342adfdd837c', 'word_count': 385, 'uri': 'nyt://article/fd61d0e1-dbed-542c-9ec5-342adfdd837c'}, {'abstract': 'President François Hollande of France has stripped John Galliano, the fashion designer convicted last year of making anti-Semitic remarks, of the Légion d’Honneur that he was awarded in 2009.', 'web_url': 'https://www.nytimes.com/2012/08/25/world/europe/anti-semitic-remarks-cost-designer-john-galliano-french-award.html', 'snippet': 'President François Hollande of France has stripped John Galliano, the fashion designer convicted last year of making anti-Semitic remarks, of the Légion d’Honneur that he was awarded in 2009.', 'lead_paragraph': 'President François Hollande of France has stripped John Galliano, the fashion designer convicted last year of making anti-Semitic remarks, of the Légion d’Honneur that he was awarded in 2009. Mr. Galliano, 51, who was made a chevalier of the Légion d’Honneur by former President Nicolas Sarkozy, was involved in two drunken episodes in a small Paris bar and restaurant. His anti-Semitic remarks, some of them caught on an amateur video, led to his conviction last year on charges of “public insults based on origin, religious affiliation, race or ethnicity.” In February 2011, Mr. Galliano harangued a museum curator about being Jewish and uttered racial insults at her friend, who is of South Asian origin. The court also saw a video of Mr. Galliano, the previous November, declaring his love for Adolf Hitler. Mr. Hollande, elected in May, has been outspoken in condemning anti-Semitism and crimes against Jews committed by the French police under Nazi occupation. ', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'France: Remarks Cost Designer Award', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'France: Remarks Cost Designer Award', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Galliano, John', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Awards, Decorations and Honors', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ANTI-SEMITISM', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hollande, Francois', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-08-25T02:04:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Steven Erlanger', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Erlanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/ac7a6831-f02a-5209-b6ea-7f0cbd0ff7d6', 'word_count': 159, 'uri': 'nyt://article/ac7a6831-f02a-5209-b6ea-7f0cbd0ff7d6'}, {'abstract': 'For all the injury and indignity that come with squatting behind the plate, what the catcher does with a bat in hand is how he is measured — in the eyes of fans, and in the checkbooks of owners.', 'web_url': 'https://www.nytimes.com/2012/08/25/sports/baseball/slump-for-russell-martin-cant-get-in-the-way.html', 'snippet': 'For all the injury and indignity that come with squatting behind the plate, what the catcher does with a bat in hand is how he is measured — in the eyes of fans, and in the checkbooks of owners.', 'lead_paragraph': 'The Yankees, on the verge of being swept in Chicago for the first time in 21 years and in desperate need of a stabilizing victory, were trailing in the top of the seventh inning Wednesday night. There was a runner on first base representing the tying run, and Russell Martin was at the plate trying not to think about his agonizing offensive season, the worst of his career.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/25/sports/