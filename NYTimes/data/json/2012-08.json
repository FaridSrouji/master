ndon-02-SUB-superJumbo.jpg', 'height': 1906, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826--London-02-SUB/0826--London-02-SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/26/books/review/0826--London-02-SUB/0826--London-02-SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826--London-02-SUB/0826--London-02-SUB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tell Me', 'kicker': "Children's Books", 'content_kicker': None, 'print_headline': 'Tell Me', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Stead, Erin E', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Stead, Philip Christian', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stringer, Lauren', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Small, David', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Stewart, Sarah', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Fox, Mem', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-23T14:31:09+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Sara London', 'person': [{'firstname': 'Sara', 'middlename': None, 'lastname': 'London', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0f45515b-fadc-59d8-a0dd-af642b0e63a8', 'word_count': 936, 'uri': 'nyt://article/0f45515b-fadc-59d8-a0dd-af642b0e63a8'}, {'abstract': 'Rebecca Stead’s hero contends with a bully and an eccentric new friend.', 'web_url': 'https://www.nytimes.com/2012/08/26/books/review/liar-spy-by-rebecca-stead.html', 'snippet': 'Rebecca Stead’s hero contends with a bully and an eccentric new friend.', 'lead_paragraph': 'Unlike her Newbery Medal-\xadwinning novel, “When You Reach Me,” in which time travel is the subtext to all the interwoven story lines, Rebecca Stead’s new book, “Liar & Spy,” is firmly grounded in the here and now. What the two do share is a mood of shimmery unrest. Part coming\xad-of-age tale, part mystery, “Liar & Spy” takes place in contemporary Brooklyn and revolves around a seventh-grade loner and misfit named Georges. Cast out of his own home after his father loses his job and the family sells their house to make ends meet — and cast off by his best friend in favor of the popular clique — Georges finds himself living in a new apartment building with a cast of eccentric neighbors. These include the similarly aged and oddly named Safer, the building’s resident dog walker as well as a budding spy; Safer’s candy-obsessed younger sister, Candy; and their bird-watching older brother, Pigeon. ', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Rosenfeld/0826-Rosenfeld-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Rosenfeld/0826-Rosenfeld-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Rosenfeld/0826-Rosenfeld-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/26/books/review/0826-Rosenfeld/0826-Rosenfeld-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Rosenfeld/0826-Rosenfeld-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can You Keep a Secret?', 'kicker': "Children's Books", 'content_kicker': None, 'print_headline': 'Can You Keep a Secret?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Stead, Rebecca', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-23T14:32:10+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Lucinda Rosenfeld', 'person': [{'firstname': 'Lucinda', 'middlename': None, 'lastname': 'Rosenfeld', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c966601f-790c-5848-8fa1-0492ee5d3420', 'word_count': 709, 'uri': 'nyt://article/c966601f-790c-5848-8fa1-0492ee5d3420'}, {'abstract': 'A story inspires an app, a short film and now a book.', 'web_url': 'https://www.nytimes.com/2012/08/26/books/review/the-fantastic-flying-books-of-mr-morris-lessmore.html', 'snippet': 'A story inspires an app, a short film and now a book.', 'lead_paragraph': 'It may be telling that “The Fantastic Flying Books of Mr. Morris Lessmore,” a kind of totem to the unmatched joys of reading, appeared in two different screen adaptations before making the transition into print. Winning an Oscar earlier this year for best animated short after appearing, last summer, as a lauded animated app, William Joyce’s story of a natty Southern loner was a feat of digital imagination, a dazzlingly polished animation and a wordless tribute to a fading literary age. Now, realized at last as a children’s book, his tale gains elegance but loses depth. The print-edition “Morris Lessmore” is a stylishly paced, vividly illustrated parable for young readers, yet it somehow lacks the dreamy creativity of its animated precursors. Ultimately, Joyce’s book tells us something we may already suspect: that storytelling these days has a broader canvas than the hallowed space within the \xadlibrary doors.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Heller/0826-Heller-jumbo.jpg', 'height': 877, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Heller/0826-Heller-superJumbo.jpg', 'height': 1059, 'width': 1236, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Heller/0826-Heller-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/26/books/review/0826-Heller/0826-Heller-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/26/books/review/0826-Heller/0826-Heller-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hanging on Every Word', 'kicker': "Children's Books", 'content_kicker': None, 'print_headline': 'Hanging on Every Word', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Joyce, William', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-23T14:33:11+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Nathan Heller', 'person': [{'firstname': 'Nathan', 'middlename': None, 'lastname': 'Heller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/025c6aa2-489c-53c9-bcff-d9a281b7c903', 'word_count': 641, 'uri': 'nyt://article/025c6aa2-489c-53c9-bcff-d9a281b7c903'}, {'abstract': 'In this graphic novel an ambitious theater geek concentrates on friendship and creative fulfillment instead of boy craziness.', 'web_url': 'https://www.nytimes.com/2012/08/26/books/review/drama-by-raina-telgemeier.html', 'snippet': 'In this graphic novel an ambitious theater geek concentrates on friendship and creative fulfillment instead of boy craziness.', 'lead_paragraph': 'The parenting-book world is flooded with jeremiads about how tween culture breeds sociopaths and prostitots, ergo we should unplug the Internet. But this is a narrative belied by the thriving field of age-appropriate books epitomized by the nice-girls-finish-first graphic novels of Raina Telgemeier, poetic illustrator of middle-school life.', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Life Backstage', 'kicker': "Children's Books", 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Graphic Novels', 'rank': 2, 'major': 'N'},