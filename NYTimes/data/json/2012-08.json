6, 'major': 'N'}], 'pub_date': '2012-08-16T01:12:35+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael M. Grynbaum', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/01c1408c-0663-5f8d-81d5-b7d72a4341fe', 'word_count': 594, 'uri': 'nyt://article/01c1408c-0663-5f8d-81d5-b7d72a4341fe'}, {'abstract': 'A 28-year-old gunman shot and wounded a security guard in the lobby of the Family Research Council, a conservative Christian organization, the F.B.I. said.', 'web_url': 'https://www.nytimes.com/2012/08/16/us/shooting-at-family-research-council-in-washington.html', 'snippet': 'A 28-year-old gunman shot and wounded a security guard in the lobby of the Family Research Council, a conservative Christian organization, the F.B.I. said.', 'lead_paragraph': 'WASHINGTON — A gunman trying to enter the downtown offices of a conservative policy organization on Wednesday morning shot and wounded a security guard before he was wrestled to the ground and arrested, a city police officer said.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Shooting at Family Research Council in Washington', 'kicker': None, 'content_kicker': None, 'print_headline': 'Policy Group In Washington Is Shooting Site', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Assaults', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Family Research Council', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-16T01:13:53+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Theo Emery', 'person': [{'firstname': 'Theo', 'middlename': None, 'lastname': 'Emery', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/607574ab-cd56-52f4-9d66-e9292d710349', 'word_count': 335, 'uri': 'nyt://article/607574ab-cd56-52f4-9d66-e9292d710349'}, {'abstract': 'The Republican presidential candidate has too many narratives to hide from.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/08/15/romney-the-unknowable/', 'snippet': 'The Republican presidential candidate has too many narratives to hide from.', 'lead_paragraph': 'Ten days from now, some of the world’s best-paid magicians of image and narrative will unveil a reboot of a most unfathomable man, Willard Mitt Romney, a 2012 model with a shelf life of barely two months.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney the Unknowable', 'kicker': 'Timothy Egan', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Inequality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mormons (Church of Jesus Christ of Latter-Day Saints)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, George', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Bain Capital', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-16T01:20:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cab9e833-1750-54cb-ab2f-8387acbf094f', 'word_count': 772, 'uri': 'nyt://article/cab9e833-1750-54cb-ab2f-8387acbf094f'}, {'abstract': 'We are learning so much about Paul Ryan, people! But what will this all mean to the American health care system?', 'web_url': 'https://www.nytimes.com/2012/08/16/opinion/collins-middle-age-blues.html', 'snippet': 'We are learning so much about Paul Ryan, people! But what will this all mean to the American health care system?', 'lead_paragraph': 'Paul Ryan is everywhere! Nobody can talk about anything but the congressman from Wisconsin. We now know he is the intellectual, spiritual and moral center of the House of Representatives, who keeps his body fat below 8 percent and excels at a sport that involves sticking your hand inside a catfish, grabbing it by the tonsils and pulling it out of the water. Also, I believe he may have been the guy who ran the men’s relay race in the Olympics on a broken fibula.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/gail-collins/gail-collins-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/gail-collins/gail-collins-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/gail-collins/gail-collins-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/gail-collins/gail-collins-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank