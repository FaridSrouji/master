/18/world/RUSSIA/RUSSIA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/18/world/RUSSIA/RUSSIA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Anti-Putin Stunt Earns Punk Band Two Years in Jail', 'kicker': None, 'content_kicker': None, 'print_headline': 'Anti-Putin Stunt Earns Punk Band Two Years in Jail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kirill I', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Russian Orthodox Church', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Pussy Riot', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Tolokonnikova, Nadezhda', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Samutsevich, Yekaterina', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Alyokhina, Maria', 'rank': 12, 'major': 'N'}], 'pub_date': '2012-08-17T10:12:06+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By David M. Herszenhorn', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a70f18ab-b014-5f75-b275-cd836b7217ce', 'word_count': 1395, 'uri': 'nyt://article/a70f18ab-b014-5f75-b275-cd836b7217ce'}, {'abstract': 'Mr. Khan on Pakistan politics, Islam and Salman Rushdie.', 'web_url': 'https://india.blogs.nytimes.com/2012/08/17/imran-khan-builds-a-mass-movement-in-pakistan/', 'snippet': 'Mr. Khan on Pakistan politics, Islam and Salman Rushdie.', 'lead_paragraph': '“My ex-wife, Jemima, designed the house — it is really paradise for me,” Imran Khan, the Pakistani cricketer-turned-politician told Pankaj Mishra, who wrote about Mr. Khan in the Sunday Magazine section of The New York Times.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Imran Khan Builds a ‘Mass Movement’ in Pakistan', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-17T10:35:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/8ad35a5e-847c-5382-8269-4b641c66b33e', 'word_count': 272, 'uri': 'nyt://article/8ad35a5e-847c-5382-8269-4b641c66b33e'}, {'abstract': 'The freakishly gifted 23-year-old was one of the best defensive ends in the league last year. And he’s still learning to play the game.', 'web_url': 'https://www.nytimes.com/2012/08/19/magazine/jason-pierre-paul-the-late-blooming-defensive-wunderkind.html', 'snippet': 'The freakishly gifted 23-year-old was one of the best defensive ends in the league last year. And he’s still learning to play the game.', 'lead_paragraph': 'In 1999, a promising young director named Doug Liman was dispatched to Florida to work on a commercial with Tiger Woods, then still in his wunderkind phase. The shoot was scripted, and Liman, who would eventually direct “The Bourne Identity,” was part of a team that had only eight hours with the star. Liman noticed that during breaks, Woods, visibly bored, would juggle a golf ball with his club head. The ball never hit the ground. While the crew ate lunch, he grabbed a camera and asked the star to do the trick again. Woods juggled the ball more than 40 consecutive times — around his back, between his legs, sitting it on his club face, never dropping it — before thwacking it down the fairway in mid arc. The 30-second spot became the 1999 equivalent of a viral video, in large part because it laid bare Woods’s superhuman talent.', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19pierrepaul1/19pierrepaul1-articleLarge.jpg', 'height': 696, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/19/magazine/19pierrepaul1/19pierrepaul1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 696}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19pierrepaul1/mag-19PIERRE-PAUL-t_CA0-jumbo.jpg', 'height': 1024, 'width': 819, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19pierrepaul1/mag-19PIERRE-PAUL-t_CA0-superJumbo.jpg', 'height': 1500, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19pierrepaul1/19pierrepaul1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/magazine/19pierrepaul1/19pierrepaul1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19pierrepaul1/19pierrepaul1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jason Pierre-Paul, the Late-Blooming Defensive Wunderkind', 'kicker': None, 'content_kicker': None, 'print_headline': 'Better Faster Stronger (Learning)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Football League', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pierre-Paul, Jason', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-17T11:00:24+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Robert Andrew Powell', 'person': [{'firstname': 'Robert', 'middlename': 'Andrew', 'lastname': 'Powell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9fd3ec7d-8ebf-55e0-a992-1b02b255def8', 'word_count': 2268, 'uri': 'nyt://article/9fd3ec7d-8ebf-55e0-a992-1b02b255def8'}, {'abstract': 'The Broncos are a much better team than they were a year ago, but that doesn’t mean they’ll run away with the division.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/08/17/denver-broncos-2012-n-f-l-season-preview/', 'snippet': 'The Broncos are a much better team than they were a year ago, but that doesn’t mean they’ll run away with the division.', 'lead_paragraph': 'What if John Elway, Broncos executive vice president for football operations, could have written an honest, cathartic open letter to Broncos fans this past March? It might have gone something like this:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Denver Broncos, 2012 N.F.L. Season Preview', 'kicker': 'The Fifth 