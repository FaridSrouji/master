word_count': 760, 'uri': 'nyt://article/f6e7ae89-fd90-5b57-b29c-850d92e4b795'}, {'abstract': 'Behind two goals by Carli Lloyd, the United States defeated Japan to avenge last year’s loss in the World Cup final and win its fourth gold medal in women’s soccer.', 'web_url': 'https://www.nytimes.com/2012/08/10/sports/olympics/united-states-beats-japan-for-womens-soccer-gold.html', 'snippet': 'Behind two goals by Carli Lloyd, the United States defeated Japan to avenge last year’s loss in the World Cup final and win its fourth gold medal in women’s soccer.', 'lead_paragraph': 'LONDON — Megan Rapinoe cried. Hope Solo danced. Christie Rampone leapt into the air, jumping into the arms of Abby Wambach as Wembley stadium erupted around them. For all the elaborate celebrations the United States women’s soccer team displayed over the course of the Olympics, the most memorable one was unrehearsed.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10soc-1/10soc-1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/10/sports/olympics/10soc-1/10soc-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10soc-1/10soc-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10soc-1/10soc-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10soc-1/10soc-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/10/sports/olympics/10soc-1/10soc-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/10/sports/olympics/10soc-1/10soc-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'United States Wins Women’s Soccer Gold', 'kicker': "Women's Soccer: Final | United States 2, Japan 1", 'content_kicker': None, 'print_headline': 'Payback In Gold', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Solo, Hope', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lloyd, Carli', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-09T21:04:20+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7977f774-d823-5f14-9572-093b96d358fe', 'word_count': 1046, 'uri': 'nyt://article/7977f774-d823-5f14-9572-093b96d358fe'}, {'abstract': 'The Manhattan district attorney has charged Sergey Aleynikov, the former Goldman Sachs programmer, with state crimes related to his downloading of computer code from his onetime employer.', 'web_url': 'https://dealbook.nytimes.com/2012/08/09/ex-goldman-programmer-is-arre