': 'N'}], 'pub_date': '2012-08-31T14:25:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/449d3861-e955-5a4d-8e10-86cfb2e40d00', 'word_count': 30, 'uri': 'nyt://article/449d3861-e955-5a4d-8e10-86cfb2e40d00'}, {'abstract': 'Robert and Edward Skidelsky respond to a recent review of their book “How Much Is Enough?”', 'web_url': 'https://www.nytimes.com/2012/09/02/books/review/leisure-time.html', 'snippet': 'Robert and Edward Skidelsky respond to a recent review of their book “How Much Is Enough?”', 'lead_paragraph': 'To the Editor:', 'print_section': 'BR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Leisure Time', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Leisure Time', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-31T14:33:06+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/34037ab0-37a4-5a4b-93ff-17536c237def', 'word_count': 298, 'uri': 'nyt://article/34037ab0-37a4-5a4b-93ff-17536c237def'}, {'abstract': 'The marketer behind the Teletubbies has a new plan to get into the heads of preschoolers and the pockets of their parents.', 'web_url': 'https://www.nytimes.com/2012/09/02/magazine/with-oogieloves-a-plan-to-make-the-multiplex-more-toddler-friendly.html', 'snippet': 'The marketer behind the Teletubbies has a new plan to get into the heads of preschoolers and the pockets of their parents.', 'lead_paragraph': '“I’m not really a dog person,” Kenn Viselman says, just before reaching into his backpack and pulling out a Tupperware container of expensive-looking treats for his goldendoodle, Jacamo. When a nearby Chihuahua barks shrilly, Viselman produces a giant bag of rawhide bones and throws one at its feet. By the time Viselman says he’s not exactly a kid person (“I like some kids”), it’s hard not to imagine him leaving the house with a backpack full of sparklers and lollipops. ', 'print_section': 'MM', 'print_page': '36', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/magazine/02oogieloves1/02oogieloves1-articleLarge.jpg', 'height': 736, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/02/magazine/02oogieloves1/02oogieloves1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 736}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/magazine/02oogieloves1/02oogieloves1-jumbo.jpg', 'height': 1024, 'width': 817, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/magazine/02oogieloves1/02oogieloves1-superJumbo.jpg', 'height': 1500, 'width': 1197, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/magazine/02oogieloves1/02oogieloves1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/02/magazine/02oogieloves1/02oogieloves1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/magazine/02oogieloves1/02oogieloves1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'h