: None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Samsara (Movie)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-23T21:52:50+0000', 'document_type': 'multimedia', 'news_desk': 'Movies', 'section_name': 'Movies', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/60b6429d-ea03-5ef6-b4fd-09ddbd5644e6', 'word_count': 0, 'uri': 'nyt://interactive/60b6429d-ea03-5ef6-b4fd-09ddbd5644e6'}, {'abstract': '“The Newsroom” has had some harsh reviews, but now, with its season finale on Sunday, Aaron Sorkin’s sharp repartee is more evident.', 'web_url': 'https://www.nytimes.com/2012/08/24/arts/television/the-newsroom-finale-and-both-sides-of-aaron-sorkin.html', 'snippet': '“The Newsroom” has had some harsh reviews, but now, with its season finale on Sunday, Aaron Sorkin’s sharp repartee is more evident.', 'lead_paragraph': 'The most recent episode of “The Newsroom” opened with a let’s-put-on-a-show moment — literally — as the idealistic producer of the fictional cable-news program at the heart of the series rallied her troops. Hoping to exploit the chaos of a power blackout to regain control of the newscast, she delivered a stem winder, beginning with, “A miracle happens — we become a team again,” and as it built you couldn’t help thinking: Here he goes again.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/24/arts/24NEWSROOM_SPAN/24NEWSROOM_SPAN-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/24/arts/24NEWSROOM_SPAN/24NEWSROOM_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'im