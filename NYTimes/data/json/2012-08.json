': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/business/james-stewart/james-stewart-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/business/james-stewart/james-stewart-superJumbo.jpg', 'height': 1333, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/business/james-stewart/james-stewart-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/06/25/business/james-stewart/james-stewart-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/06/25/business/james-stewart/james-stewart-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When the Network Effect Goes Into Reverse', 'kicker': 'Common Sense', 'content_kicker': None, 'print_headline': 'Social Media, Once Soaring, Are Coming Down to Earth', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Facebook Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Groupon Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-17T14:58:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By James B. Stewart', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f46ced2-b0cd-565b-ac68-11b7a6b0551c', 'word_count': 1437, 'uri': 'nyt://article/0f46ced2-b0cd-565b-ac68-11b7a6b0551c'}, {'abstract': 'To celebrate The Selby’s new book on far-flung food culture, T makes the photographer the subject for a change.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/08/17/eats-shoots-and-leaves/', 'snippet': 'To celebrate The Selby’s new book on far-flung food culture, T makes the photographer the subject for a change.', 'lead_paragraph': 'On a recent summer afternoon, the photographer Todd Selby was standing in the kitchen of his minimalist apartment in Williamsburg, Brooklyn, stirring shell pasta in a stock pot. He was making Olga’s Shell Soup, a bouillon-and-tomato-paste number concocted by his childhood nanny, a Mexican native who was named after a Swedish character in a telenovela. “This is my favorite soup in the world, but I’ve never met anyone who’s really that into it,” Selby said. “So I’m kind of curious what the reaction is going to be.”', 'print_section': 'M2', 'print_page': '208', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Eats, Shoots and Leaves', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Eats, Shoots and Leaves', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Selby, Todd', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-17T15:00:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Abby Aguirre', 'person': [{'firstname': 'Abby', 'middlename': None, 'lastname': 'Aguirre', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/535cc412-329c-57a9-88f4-2abbe0a685da', 'word_count': 311, 'uri': 'nyt://article/535cc412-329c-57a9-88f4-2abbe0a685da'}, {'abstract': 'Chevrolet Express and GMC Savana passenger and cargo vans from the 2003-4 model years were affected.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/08/17/general-motors-recalls-9400-chevrolet-and-gmc-vans-for-fire-hazard/', 'snippet': 'Chevrolet Express and GMC Savana passenger and cargo vans from the 2003-4 model years were affected.', 'lead_paragraph': 'General Motors recently informed the National Highway Traffic Safety Administration that it would recall almost 9,400 of its 2003-4 Chevrolet Express and GMC Savana full-size vans because of a fire hazard.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'General Motors Recalls 9,400 Chevrolet and GMC Vans for Fire Hazard', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Safety Features and Defects', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chevrolet Division of General Motors Corp', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chrysler Group LLC', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'General Motors', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Mercedes-Benz', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Highway Traffic Safety Administration', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Nissan Motor Co', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-08-17T15:01:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Christopher Jensen', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73e3cfb1-5edb-5a14-aeaa-8a5adacd7795', 'word_count': 617, 'uri': 'nyt://article/73e3cfb1-5edb-5a14-aeaa-8a5adacd7795'}, {'abstract': 'Tyrann Mathieu, who was dismissed from the L.S.U. football team last week, is in a Houston recovery center, according to a report by a New Orleans television station.', 'web_url': 'https://thequad.blogs.nytimes.com/2012/08/17/family-says-mathieu-has-entered-rehab/', 'snippet': 'Tyrann Mathieu, who was dismissed from the L.S.U. football team last week, is in a Houston recovery center, according to a report by a New Orleans television station.', 'lead_paragraph': 'The news that Louisiana State had dismissed one of its best players, defensive back Tyrann Mathieu, had the predictable ripple effect in schools lining up for permission to poach him for their teams. An L.S.U. spokesman said 20 schools had called, but that the school was only going to allow contact by schools Mathieu requested.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Family Says Mathieu Has Entered Rehab', 'kicker': 'The Quad', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mathieu, Tyrann', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Louisiana State University', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New Orleans (La)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-17T15:14:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/075f6038-3120-5a68-ab3c-8705e9d36ba7', 'word_count': 221, '