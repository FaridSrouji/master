 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-22T20:57:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Ilena Silverman', 'person': [{'firstname': 'Ilena', 'middlename': None, 'lastname': 'Silverman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/52b65e4d-69a7-5452-9804-65af30044e84', 'word_count': 282, 'uri': 'nyt://article/52b65e4d-69a7-5452-9804-65af30044e84'}, {'abstract': 'Photographs published on the celebrity Web site TMZ showed the 27-year-old Prince of Wales naked and cavorting with a naked woman, or women, in a Las Vegas hotel room.', 'web_url': 'https://www.nytimes.com/2012/08/23/world/europe/for-prince-harry-what-happened-in-vegas-didnt-stay-there.html', 'snippet': 'Photographs published on the celebrity Web site TMZ showed the 27-year-old Prince of Wales naked and cavorting with a naked woman, or women, in a Las Vegas hotel room.', 'lead_paragraph': 'LONDON — A year that has featured a triumphant Olympic Games and Queen Elizabeth II’s diamond jubilee struck an unwelcome bump on Wednesday for the royal family with the publication of photographs showing the queen’s sometimes wayward grandson, Prince Harry, naked and cavorting with a naked woman, or women, during a strip billiards game in a Las Vegas hotel room.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/world/23harry_inline/23harry_inline-jumbo.jpg', 'height': 1024, 'width': 668, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/world/23harry_inline/23harry_inline-superJumbo.jpg', 'height': 2048, 'width': 1336, 'subType': 'superJum