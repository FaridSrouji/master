rl': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-articleLarge-v4.png', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-articleLarge-v4.png', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-jumbo-v6.jpg', 'height': 400, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-superJumbo-v3.png', 'height': 400, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-thumbStandard-v5.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-thumbStandard-v5.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-thumbLarge-v5.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Daily Report: Cisco, a Tech Bellwether, Beats Forecasts', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T12:53:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/e4257aca-6ec9-5ed4-ac92-e7587866a6a4', 'word_count': 292, 'uri': 'nyt://article/e4257aca-6ec9-5ed4-ac92-e7587866a6a4'}, {'abstract': 'Dorm rules in some of the leading Indian colleges are stricter for girls, while boys are allowed more freedom by the authorities.', 'web_url': 'https://india.blogs.nytimes.com/2012/08/16/does-your-college-treat-you-like-a-child/', 'snippet': 'Dorm rules in some of the leading Indian colleges are stricter for girls, while boys are allowed more freedom by the authorities.', 'lead_paragraph': 'After a recent post on Jodhpur’s emergence as an education hub, India Ink received comments describing unreasonable restrictions on college campuses. We scoured the Internet and found many rules in college dormitories, known as hostels in India, that imposed curfews and bans on certain activities even though most of the students are adults. Moreover, the rules for women were often more restrictive. Here’s a selection:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Does Your College Treat You Like a Child?', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dormitories', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-16T12:57:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Sruthi Gottipati', 'person': [{'firstname': 'Sruthi', 'middlename': None, 'lastname': 'Gottipati', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96f5ddab-35eb-5270-ae26-8ea3c138301a', 'word_count': 1044, 'uri': 'nyt://article/96f5ddab-35eb-5270-ae26-8ea3c138301a'}, {'abstract': 'The Danish actor Mads Mikkelsen has a remarkable ability to balance the global and the local.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/08/16/great-dane/', 'snippet': 'The Danish actor Mads Mikkelsen has a remarkable ability to balance the global and the local.', 'lead_paragraph': 'On a muggy May afternoon, the Danish actor Mads Mikkelsen stopped in Midtown Manhattan to meet me for a beer and a cheeseburger — a brief pause in the middle of a hectic bout of international zigzagging. He had just been in Bucharest and was en route to Cannes, where he would receive the best-actor award for his performance in Thomas Vinterberg’s “The Hunt,” in which he plays a kindergarten teacher menaced by small-town paranoia after he is accused of sexual abuse.', 'print_section': 'M2', 'print_page': '206', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Great Dane', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Great Dane', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T13:00:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By A. O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d350049c-c5dd-5c90-8f34-56767fdcfe56', 'word_count': 411, 'uri': 'nyt://article/d350049c-c5dd-5c90-8f34-56767fdcfe56'}, {'abstract': 'Best Buy’s founder, Richard Schulze, sent a letter to the struggling retailer’s board on Thursday, reaffirming his commitment to buy the company for as much as $8.8 billion.', 'web_url': 'https://dealbook.nytimes.com/2012/08/16/best-buy-founder-presses-case-for-takeover-talks/', 'snippet': 'Best Buy’s founder, Richard Schulze, sent a letter to the struggling retailer’s board on Thursday, reaffirming his commitment to buy the company for as much as $8.8 billion.', 'lead_paragraph': 'The founder of Best Buy, Richard M. Schulze, pressed his case on Thursday for a takeover of the electronics retailer, again trying to prod the company into considering his offer.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Best Buy Founder Nudges Company’s Board to Consider Takeover', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Best Buy Founder Nudges Company’s Board to Consider Takeover', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schulze, Richard M', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Best BUY Company Inc', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-16T13:02:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9b90c282-d900-59c6-83f2-9d64c2b2d64d', 'word_count': 503, 'uri': 'nyt://article/9b90c282-d900-59c6-83f2-9d64c2b2d64d'}, {'abstract': 'Player ratings for the United States national team’s 1-0 victory in a friendly at Mexico on Aug. 15.', 'web_url': 'https://goal.blogs.nytimes.com/2012/08/16/player-ratings-u-s-1-mexico-0/', 'snippet': 'Player ratings for the United States national team’s 1-0 victory in a friendly at Mexico on Aug. 15.', 'lead_paragraph': 'Twenty years from now – 50 years from now – nobody will remember that the United States national team’s first victory over Mexico in Mexico was not a particularly well-played match.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Player Ratings: U.S. (1), Mexico (0)', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "United States Men's National Soccer Team", 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-16T13:14:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By John Godfrey', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Godfrey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b02ac75f-84d4-5b3c-963b-bd2137df0407', 'word_count': 1166, 'uri': 'nyt://article/b02ac75f-84d4-5b3c-963b-bd2137df0407'}, {'abstract': 'Andrew Upton and Cate Blanchett, the husband and wife team, have been co-artistic directors of the Sydney Theater Company since 2008. Mr. Upton’s new term as artistic director will begin on Jan. 1.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/08/16/andrew-upton-to-become-sole-artistic-director-of-sydney-theater-company/', 'snippet': 'Andrew Upton and Cate Blanchett, the husband and wife team, have been co-artistic directors of the Sydney Theater Company since 2008. Mr. Upton’s new term as artistic director will begin on Jan. 1.', 'lead_paragraph': 'When Andrew Upton and Cate Blanchett, the husband-and-wife team that has served as the co-artistic directors of the Sydney Theater Company since 2008, complete their current and final term there, a familiar successor will be waiting in the wings: Mr. Upton will become the artistic director of that theater company, its chairman, David Gonski, said in a statement on Wednesday.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Andrew Upton to Become Sole Artistic Director of Sydney Theater Company', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'For Sydney Theater, One Artistic Director', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T13:23:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f8f84fb-b9dc-5da3-b8da-39db4a933260', 'word_count': 487, 'uri': 'nyt://article/7f8f84fb-b9dc-5da3-b8da-39db4a933260'}, {'abstract': 'Also, David Pogue finds that a new tablet from Samsung has too many features, and crowds of up 75,000 attending a vigil at Graceland to mark the 35th anniversary of Elvis Presley’s death were greeted by two unexpected guests.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/08/16/the-breakfast-meeting-asylum-for-assange-and-jay-zs-stamp-on-the-nets/', 'snippet': 'Also, David Pogue finds that a new tablet from Samsung has too many features, and crowds of up 75,000 attending a vigil at Graceland to mark the 35th anniversary of Elvis Presley’s death were greeted by two unexpected guests.', 'lead_paragraph': 'The WikiLeaks founder Julian Assange on Thursday was granted political asylum by Ecuador, whose embassy in London is currently shielding him. Outside the embassy, the scene has become more chaotic with scuffles between the police and supporters of Mr. Assange. Hanging over the Ecuadorean decision is the possibility that the British government could revoke the diplomatic immunity of the embassy and seize Mr. Assange to extradite him to Sweden, William Neuman and Maggy Ayala report, where he is wanted for questioning over allegations that he sexually assaulted two women. Ecuador’s foreign minister, Ricardo Patiño, didn’t take kindly to the suggestion that the British might move in: “We are not a British colony.” In his statement on Thursday, The Guardian reported, he said: “We trust the U.K. will offer the necessary guarantees so that both governments can act adequately and properly respect international rights and the right of asylum.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Breakfast Meeting: Asylum for Assange, and Jay-Z’s Stamp on the Nets', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T13:26:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Noam Cohen', 'person': [{'firstname': 'Noam', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/611fc5a6-4606-5c68-9122-57bde4d161fa', 'word_count': 550, 'uri': 'nyt://article/611fc5a6-4606-5c68-9122-57bde4d161fa'}, {'abstract': 'In an opinion article, a college student who attended New York City schools draws attention to the city\'s many high-needs schools and their records of failure. "If we fail to attack mainstream economic issues now, then any attempts to improve existing school systems will collapse under a much greater problem: poverty. Empty wallets, empty stomachs and empty minds will persist."', 'web_url': 'https://www.nytimes.com/schoolbook/2012/08/16/when-will-we-address-the-needs-in-high-needs-schools/', 'snippet': 'In an opinion article, a college student who attended New York City schools draws attention to the city\'s many high-needs schools and their records of failure. "If we fail to attack mainstream economic issues now, then any attempts to improve exis...', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'When Will We Address the Needs in High-Needs Schools?', 'kicker': 'SchoolBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T13:29:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By SASHA PANARAM', 'person': [{'firstname': 'Sasha', 'middlename': None, 'lastname': 'PANARAM', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2518008b-bae7-537c-a60b-fc4e65eec41f', 'word_count': 0, 'uri': 'nyt://article/2518008b-bae7-537c-a60b-fc4e65eec41f'}, {'abstract': 'Writers react to Melky Cabrera’s 50-game suspension from baseball and to Felix Hernandez’s perfect game.', 'web_url': 'https://www.nytimes.com/2012/08/17/sports/in-baseball-a-flawed-star-and-a-perfect-game-leading-off.html', 'snippet': 'Writers react to Melky Cabrera’s 50-game suspension from baseball and to Felix Hernandez’s perfect game.', 'lead_paragraph': 'Baseball’s news came in such quick succession, and carrying such different messages, that it was as if Commissioner Bud Selig had picked up the red phone and dialed the baseball gods. The San Francisco Giants’ Melky Cabrera had just been suspended for 50 games for performance-enhancing drug use, dredging up all of baseball’s worst steroid era memories, and Selig needed something quick. How about a perfect game by Seattle’s Felix Hernandez, the gods offered back? Would that do?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Flawed Star and a Perfect Game', 'kicker': 'Leading Off', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cabrera, Melky', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nadal, Rafael', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco Giants', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Seattle Mariners', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hernandez, Felix (1986- )', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-16T13:30:00+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a1b7642-0f9f-58fe-b2cc-5d802035e1e8', 'word_count': 583, 'uri': 'nyt://article/4a1b7642-0f9f-58fe-b2cc-5d802035e1e8'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/08/16/what-were-reading-502/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'Fast Company: The Silicon Valley venture capital crowd seems to be getting all excited about lab-grown meat. — Jeff Gordinier ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T13:36:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/6f722a04-6432-55cb-a8b4-34ef4d8f27a8', 'word_count': 391, 'uri': 'nyt://article/6f722a04-6432-55cb-a8b4-34ef4d8f27a8'}, {'abstract': 'The Chinese-American author and star of a new movie that tackles globalization and high finance has talked about the wide varieties of Asian identity, and the general western tendency to lump all Asians into a single category.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/08/16/asian-identity-and-the-global-economy/', 'snippet': 'The Chinese-American author and star of a new movie that tackles globalization and high finance has talked about the wide varieties of Asian identity, and the general western tendency to lump all Asians into a single category.', 'lead_paragraph': 'Last month I finished writing “Plutocrats,” a book on the rise of the global super-elite and the forces that created it, so I am somewhat obsessed with globalization, bankers and the like. That’s why those themes in a new indie movie, “Supercapitalist,” resonated most strongly for me.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Asian Identity and the Global Economy', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chinese-Americans', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Far East, South and Southeast Asia and Pacific Areas', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-16T13:51:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Chrystia Freeland', 'person': [{'firstname': 'Chrystia', 'middlename': None, 'lastname': 'Freeland', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/23e66627-e55f-5ecd-bf1a-93b490a05d59', 'word_count': 305, 'uri': 'nyt://article/23e66627-e55f-5ecd-bf1a-93b490a05d59'}, {'abstract': 'Liya Kebede brings the season’s darkly romantic evening fabrics into the light of day.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/08/16/velvet-revolution-liya-kebede/', 'snippet': 'Liya Kebede brings the season’s darkly romantic evening fabrics into the light of day.', 'lead_paragraph': 'With storm clouds gathering, something witchy this way comes. Liya Kebede brings the season’s darkly romantic evening fabrics into the light o