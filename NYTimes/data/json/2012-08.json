url': 'images/2012/08/19/books/review/19SUBSAMET-1344372888070/19SUBSAMET-1344372888070-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/books/review/19SUBSAMET-1344372888070/19SUBSAMET-1344372888070-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/books/review/19SUBSAMET-1344372888070/19SUBSAMET-1344372888070-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Collateral Damage', 'kicker': None, 'content_kicker': None, 'print_headline': 'Collateral Damage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Castner, Brian', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-17T15:25:17+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Elizabeth D. Samet', 'person': [{'firstname': 'Elizabeth', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ca1737a0-6d69-5e08-8d26-6d313c9016d2', 'word_count': 1222, 'uri': 'nyt://article/ca1737a0-6d69-5e08-8d26-6d313c9016d2'}, {'abstract': 'A biography of Charles de Gaulle, an autocrat stuck in a democracy.', 'web_url': 'https://www.nytimes.com/2012/08/19/books/review/the-general-a-biography-of-de-gaulle-by-jonathan-fenby.html', 'snippet': 'A biography of Charles de Gaulle, an autocrat stuck in a democracy.', 'lead_paragraph': 'Dare I call a 707-page biography a page turner? For once, the fake enthusiasm of blurb prose rings true. I did “finish the book in one sitting,” as another chestnut has it, though the sitting was a very long flight of 16 hours. And why? Because Jonathan Fenby, a former editor of The Observer of London and a prolific author, knows how to turn breadth and depth into enthrallment. \xadAcademic historians tend to shy away from the grand sweep, while journalists like to stick to the chatty and topical. Fenby has blended the best of both crafts — the historian’s gravitas, the journalist’s feel for drama — into a magnificent book that will rank alongside a classic like Jean Lacouture’s multi\xadvolume biography of Charles de Gaulle. ', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/books/review/19JOFFE/19JOFFE-jumbo.jpg', 'height': 803, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/books/review/19JOFFE/19JOFFE-superJumbo.jpg', 'height': 1607, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/books/review/19JOFFE/19JOFFE-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/books/review/19JOFFE/19JOFFE-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/books/review/19JOFFE/19JOFFE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Charles in Charge', 'kicker': None, 'content_kicker': None, 'print_headline': 'Charles in Charge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name':