 Mitt', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-11T17:30:26+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By David Firestone', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Firestone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/f1af012e-5283-555b-9597-f30608186aa8', 'word_count': 1198, 'uri': 'nyt://article/f1af012e-5283-555b-9597-f30608186aa8'}, {'abstract': 'Women have won 27 of the U.S. team’s 41 gold medals and 54 of its 95 total medals at the London Olympics.', 'web_url': 'https://london2012.blogs.nytimes.com/2012/08/11/for-u-s-women-medals-and-a-moment-to-celebrate-title-ix/', 'snippet': 'Women have won 27 of the U.S. team’s 41 gold medals and 54 of its 95 total medals at the London Olympics.', 'lead_paragraph': 'LONDON – At a news conference Saturday, Ashton Eaton, the Olympic decathlon champion, sat next to fellow United States gold medalists Brenda Villa, Kayla Harrison and Missy Franklin. A question was posed to all the athletes, and a chivalrous Eaton said, “Ladies first.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For U.S. Women, Medals and a Moment to Celebrate Title IX', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Title IX (Gender Discrimination Legislation)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': '