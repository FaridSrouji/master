eo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Podcasts', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Glaser, Nikki', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Maron, Marc', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Schaefer, Sara', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Awl, The', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'MTV Networks', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-05T16:00:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Jason Zinoman', 'person': [{'firstname': 'Jason', 'middlename': None, 'lastname': 'Zinoman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ffb7eadf-6512-55b6-b834-56577193893c', 'word_count': 234, 'uri': 'nyt://article/ffb7eadf-6512-55b6-b834-56577193893c'}, {'abstract': 'The movie, featuring Colin Farrell, was a disappointing No. 2 at North American movie theaters over the weekend.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/08/05/total-recall-remake-struggles-at-box-office/', 'snippet': 'The movie, featuring Colin Farrell, was a disappointing No. 2 at North American movie theaters over the weekend.', 'lead_paragraph': 'Add “Total Recall” to the list of remakes that go thud. Sony, betting in part on advancements in visual effects and fond memories of the 1990 original, spent at least $200 million to make and market a new version starring Colin Farrell in the role Arnold Schwarzenegger made famous. But moviegoers weren’t feeling it: “Total Recall” took in about $26 million at North American theaters over the weekend, a distant second behind “The Dark Knight Rises,” which was No. 1 for the third weekend in a row, with about $36.4 million in ticket sales ($354.6 million total over three weeks).', 'print_section': 'C', 'print_page': '3', 'source': 'The