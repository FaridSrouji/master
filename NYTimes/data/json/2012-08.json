nt_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Watt, Melvin L', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'EMI Group PLC', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Universal Music Group', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-22T21:06:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/307b36f7-b543-5620-9b17-911e8b724480', 'word_count': 489, 'uri': 'nyt://article/307b36f7-b543-5620-9b17-911e8b724480'}, {'abstract': 'Two young Indians want to widen the audience for the Manganiyars, a hereditary caste of Muslim musicians in the state of Rajasthan whose music is passed down orally.', 'web_url': 'https://www.nytimes.com/2012/08/23/arts/music/preserving-manganiyars-and-their-indian-folk-music-tradition.html', 'snippet': 'Two young Indians want to widen the audience for the Manganiyars, a hereditary caste of Muslim musicians in the state of Rajasthan whose music is passed down orally.', 'lead_paragraph': 'RANERI, India — In this tiny village almost 400 miles southwest of New Delhi, where women wash dishes in the sand to conserve water, and electricity is scarce, Lakha Khan sat on the floor of a stone hut, legs crossed and white turban in place. There he coaxed a bright, high-pitched, dizzyingly fast melody from his violinlike sarangi.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/arts/SARANGI/SARANGI-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/23/arts/SARANGI/SARANGI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/arts/SARANGI/SARANGI-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/arts/SARANGI/SARANGI-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/arts/SARANGI/SARANGI-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/23/arts/SARANGI/SARANGI-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/arts/SARANGI/SARANGI-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Preserving the Passion of India’s Roots Music', 'kicker': None, 'content_kicker': None, 'print_headline': 'Preserving the Passion of India’s Roots Music', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Folk Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Amarrass Records', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-22T21:08:39+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nida Najar', 'person': [{'firstname': 'Nida', 'middlename': None, 'lastname': 'Najar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1215fd5-3041-5fcb-99c9-e6a03c29c141', 'word_count': 1453, 'uri': 'nyt://article/c1215fd5-3041-5fcb-99c9-e6a03c29c141'}, {'abstract': 'Kevin James and the [kaj] Ensemble took a John Cage approach to a waltz-laden composition at the DiMenna Center.', 'web_url': 'https://www.nytimes.com/2012/08/23/arts/music/kevin-james-and-kaj-take-john-cage-as-inspiration.html', 'snippet': 'Kevin James and the [kaj] Ensemble took a John Cage approach to a waltz-laden composition at the DiMenna Center.', 'lead_paragraph': 'Most performers who have been inclined to commemorate John Cage’s centenary this season have done so by performing Cage’s music. Kevin James, a trombonist and composer, decided instead to write a work using some of the same principles that animate Cage’s music, including randomness, humor and a mingling of music as it is traditionally understood and unalloyed noise. He presented the piece at the DiMenna Center on Tuesday evening, both as a tribute to Cage and as a way to introduce his new group, the [kaj] Ensemble, which clearly hopes to challenge counter)induction both as a new-music band and over its idiosyncratic orthography.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/arts/KAJ/KAJ-jumbo.jpg', 'height': 668, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/arts/KAJ/KAJ-s