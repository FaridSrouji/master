: 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29WINE/29WINE-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29WINE/29WINE-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/dining/29WINE/29WINE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/29/dining/29WINE/29WINE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Forget Coffee, I’ll Have This Brew', 'kicker': 'Beers of The Times', 'content_kicker': None, 'print_headline': 'Forget Coffee, I’ll Have This Brew', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beer', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-08-23T19:14:53+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'subsection_name': 'Dining & Wine', 'byline': {'original': 'By Eric Asimov', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Asimov', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f486d1fe-5626-5cba-9307-3610d0488f31', 'word_count': 1077, 'uri': 'nyt://article/f486d1fe-5626-5cba-9307-3610d0488f31'}, {'abstract': 'A study suggests that the Indo-European family of languages originated in Anatolia, or modern-day Turkey.', 'web_url': 'https://www.nytimes.com/interactive/2012/08/24/science/0824-origins.html', 'snippet': 'A study suggests that the Indo-European family of languages originated in Anatolia, or modern-day Turkey.', 'lead_paragraph': 'A study suggests that the Indo-European family of languages originated in Anatolia, or modern-day Turkey.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tracing the Origins of Indo-European Languages', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Language and Languages', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Evolution', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-23T19:24:16+0000', 'document_type': 'multimedia', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/f6b6195a-7d76-5860-9e15-0080ed51412a', 'word_count': 0, 'uri': 'nyt://interactive/f6b6195a-7d76-5860-9e15-0080ed51412a'}, {'abstract': 'Artists who work with light are showcased in “Pictures From the Moon,” a new exhibition of holography at the New Museum.', 'web_url': 'https://www.nytimes.com/2012/08/24/arts/design/holography-in-pictures-from-the-moon-at-new-museum.html', 'snippet': 'Artists who work with light are showcased in “Pictures From the Moon,” a new exhibition of holography at the New Museum.', 'lead_paragraph': 'Despite C. P. Snow’s 1959 plaint about the gap between science and the humanities, there isn’t any — on one level at least. Artists happily take up whatever new technology falls into their hands. The mystery is why some inventions gain traction and others, like holograms, are met with a flurry of excitement, used for a short time and then abandoned.', 'print_section': 'C', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/24/arts/24HOLOGRAMS1_SPAN/24HOLOGRAMS1_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': '