, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/23/world/israel/israel-superJumbo.jpg', 'height': 1545, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Developments in Iran and Sinai Deepen Israel’s Worries About Egypt', 'kicker': None, 'content_kicker': None, 'print_headline': 'Developments in Iran and Sinai Deepen Israel’s Worries About Egypt', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'International Relations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Sinai Peninsula (Egypt)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Morsi, Mohamed', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-23T00:44:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Jodi Rudoren', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Rudoren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9dcd0a8b-1213-505a-be23-df76ebc2009a', 'word_count': 1099, 'uri': 'nyt://article/9dcd0a8b-1213-505a-be23-df76ebc2009a'}, {'abstract': 'NASA has made clear that the rover crawling across Earth’s neighbor right now isn’t a last hurrah for a while. A mission scheduled for 2016 will do even more.', 'web_url': 'https://www.nytimes.com/2012/08/23/opinion/a-deeper-search-for-secrets-on-mars.html', 'snippet': 'NASA has made clear that the rover crawling across Earth’s neighbor right now isn’t a last hurrah for a while. A mission scheduled for 2016 will do even more.', 'lead_paragraph': 'Astronauts won’t be landing on Mars anytime soon, but, in recent weeks, NASA has made great strides toward exploring the planet more thoroughly than ever before with automated laboratories dropped on the surface. It is a welcome development given increasingly tight budgets for robotic explorations of the solar system. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Deeper Search for Secrets on Mars', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Deeper Search for Secrets on Mars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Space', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mars (Planet)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Curiosity (Mars Rover)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-23T00:47:28+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/95fdbf70-5471-51de-9f74-665412a6b428', 'word_count': 315, 'uri': 'nyt://article/95fdbf70-5471-51de-9f74-665412a6b428'}, {'abstract': 'State Senator Malcolm A. Smith, a Queens Democrat, said he took exception to the rapper’s remark that “I don’t like New York.”', 'web_url': 'https://www.nytimes.com/2012/08/23/nyregion/malcolm-smith-demands-apology-for-lil-waynes-insult-to-new-york.html', 'snippet': 'State Senator Malcolm A. Smith, a Queens Democrat, said he took exception to the rapper’s remark that “I don’t like New York.”', 'lead_paragraph': 'State Senator Malcolm A. Smith of Queens said Wednesday that he was “angry,” “taken aback” and “shocked” by five words uttered by the rapper Lil Wayne — five words that, unlike some other Lil Wayne lyrics, can be printed here in their en