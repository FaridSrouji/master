ame': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Customer Relations', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-06T00:24:11+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/025c2f93-cf21-5497-a3da-61431831c948', 'word_count': 0, 'uri': 'nyt://interactive/025c2f93-cf21-5497-a3da-61431831c948'}, {'abstract': 'Why thousands of women fought in the Civil War.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/08/05/women-at-war-2/', 'snippet': 'Why thousands of women fought in the Civil War.', 'lead_paragraph': 'On Aug. 29, 1862, during the Second Battle of Bull Run, Union soldiers could see a young woman helping the wounded seek shelter under a rock ledge, while taking fire herself. At Petersburg in June 1864, Sgt. Frederick O. Talbot, of the First Maine Heavy Artillery, found himself standing beside this same woman as she beckoned soldiers to the frontline breastwork to be treated. He was told that the men of the Fifth Michigan Infantry would have anyone’s “life in a minute” for saying “any harm of her.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Women at War', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-06T00:30:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By C Kay Larson', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}],