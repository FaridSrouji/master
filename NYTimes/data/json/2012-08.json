 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b9661cad-834c-5aa0-a4e7-0a0e009d040b', 'word_count': 781, 'uri': 'nyt://article/b9661cad-834c-5aa0-a4e7-0a0e009d040b'}, {'abstract': 'Richard Ellis, the naturalist behind countless paintings, books and one immense blue whale, has spent a lifetime championing — and often demythologizing — marine life.', 'web_url': 'https://www.nytimes.com/2012/08/21/science/guardian-of-ocean-life-armed-with-pen-and-brush.html', 'snippet': 'Richard Ellis, the naturalist behind countless paintings, books and one immense blue whale, has spent a lifetime championing — and often demythologizing — marine life.', 'lead_paragraph': 'Richard Ellis was playing tennis in Little Compton, R.I., during the summer of “Jaws” when he got a call from fishermen in nearby Sakonnet. They had a dead shark. Would he like to come down to the pier?', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/21/science/video-ellis/video-ellis-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/21/science/video-ellis/video-ellis-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/21/science/video-ellis/video-ellis-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/21/science/video-ellis/video-ellis-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Guard of Sea Life, Armed With Pen and Brush', 'kicker': None, 'content_kicker': None, 'print_headline': 'Guard of Sea Life, Armed With Pen And Brush', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ellis, Richard', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sharks', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN MUSEUM OF NATURAL HISTORY', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Fish and Other Marine Life', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-20T18:27:25+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By William J. Broad', 'person': [{'firstname': 'William', 'middlename': 'J.', 'lastname': 'Broad', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Biography', '_id': 'nyt://article/523ecaeb-0807-5355-9cb7-bb567b6673b8', 'word_count': 1692, 'uri': 'nyt://article/523ecaeb-0807-5355-9cb7-bb567b6673b8'}, {'abstract': 'There are four components to a simple, pleasurable summer picnic: dips, poached food, raw or pickled food and beverages.', 'web_url': 'https://www.nytimes.com/2012/08/22/dining/a-few-things-every-picnic-basket-needs.html', 'snippet': 'There are four components to a simple, pleasurable summer picnic: dips, poached food, raw or pickled food and beverages.', 'lead_paragraph': 'HAVING grown up in the city, I never really got the hang of picnics until recently, when I started venturing down to the beach in the early evening and staying through sunset. At the beginning, there was no pattern: I’d roast a chicken, make a frittata, toss a salad, grab some leftovers. It was, in essence, a “normal” dinner, transported. There’s nothing wrong with that. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/22/dining/22BITTMAN_SPAN/22BITTMAN-articleLarge.jpg', 'height':