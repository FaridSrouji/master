 None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/88d5d9ff-664e-5886-92d5-34a55521ea9a', 'word_count': 1412, 'uri': 'nyt://article/88d5d9ff-664e-5886-92d5-34a55521ea9a'}, {'abstract': 'The New York Times film critics on “Red Hook Summer,” “The Bourne Legacy” and “2 Days in New York.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/08/10/this-weeks-movies-aug-10/', 'snippet': 'The New York Times film critics on “Red Hook Summer,” “The Bourne Legacy” and “2 Days in New York.”', 'lead_paragraph': 'This week, the critics look at a new installment in the Bourne franchise (“The Bourne Legacy”), the latest work from Spike Lee (“Red Hook Summer”) and another “2 Days” from Julie Delpy (“2 Days in New York”). Full reviews of this week’s movies can be found here.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Week’s Movies: Aug. 10', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-10T17:45:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/a8189e05-e12e-5d6e-8a84-4990d0c036ce', 'word_count': 47, 'uri': 'nyt://article/a8189e05-e12e-5d6e-8a84-4990d0c036ce'}, {'abstract': 'Superior Thai cuisine in a small Maine town? That’s what you’ll find at Long Grain, thanks to a mix of coastal Maine ingredients and the flavors of Bangkok.', 'web_url': 'https://www.nytimes.com/2012/08/12/travel/restaurant-report-long-grain-in-camden-me.html', 'snippet': 'Superior Thai cuisine in a small Maine town? That’s what you’ll find at Long Grain, thanks to a mix of coastal Maine ingredients and the flavors of Bangkok.', 'lead_paragraph': 'The critic Jonathan Gold created a sensation when, in a 2000 edition of Gourmet magazine, he anointed the Las Vegas restaurant Lotus of Siam the “single best Thai restaurant in North America.” That Siam’s chef refused to dumb down flavors for American palates was thrilling to Mr. Gold and his readers. What added to this real frisson of excitement was that this unparalleled kitchen sat in an unassuming joint off the Vegas Strip.', 'print_section': 'TR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/12/travel/12-BITES/12-BITES-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/12/travel/12-BITES/12-BITES-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/12/travel/12-BITES/12-BITES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/12/travel/12-BITES/12-BITES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/12/travel/12-BITES/12-BITES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Restaurant Report: Long Grain in Camden, Me.', 'kicker': 'Bites', 'content_kicker': None, 'print_headline': 'Long Grain: Camden, Me.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Camden (Me)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major