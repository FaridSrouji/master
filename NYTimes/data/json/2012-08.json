, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/15/world/ISRAEL-1/ISRAEL-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/world/ISRAEL-1/ISRAEL-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/world/ISRAEL-1/ISRAEL-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/world/ISRAEL-1/ISRAEL-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/15/world/ISRAEL-1/ISRAEL-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/world/ISRAEL-1/ISRAEL-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Enlisting From Afar for the Love of Israel', 'kicker': None, 'content_kicker': None, 'print_headline': 'Enlisting From Afar For the Love Of Israel', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Citizenship and Naturalization', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Draft and Recruitment (Military)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-15T02:23:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Jodi Rudoren', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Rudoren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/de2fb611-afbd-56ac-abeb-db306186064d', 'word_count': 1073, 'uri': 'nyt://article/de2fb611-afbd-56ac-abeb-db306186064d'}, {'abstract': 'The vice-presidential candidate is single-handedly responsible for saving the Republican Party from some of its own worst impulses.', 'web_url': 'https://campaignstops.blogs.nytimes.com/2012/08/14/why-moderates-should-like-paul-ryan/', 'snippet': 'The vice-presidential candidate is single-handedly responsible for saving the Republican Party from some of its own worst impulses.', 'lead_paragraph': 'Paul Ryan is not a moderate, not a centrist, and certainly not a perfectly neutral non-ideological number-crunching budget wonk. He is a conservative whose fiscal blueprints and budgets are drawn up with conservative goals uppermost in mind. He’s a Reaganite pro-life hawkish supply-sider who wants limited government and the lowest possible tax burden. Out of all the running mates available, Mitt Romney chose one of the most explicitly ideological options.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Why Moderates Should Like Paul Ryan', 'kicker': 'Campaign Stops', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Reform and Reorganization', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Coburn, Tom', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-15T02:26:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/19832616-429d-5dc5-9aa3-acc9c1621b05', 'word_count': 877, 'uri': 'nyt://article/19832616-429d-5dc5-9aa3-acc9c1621b05'}, {'abstract': 'Hiroki Kuroda drew full support from the crowd as he turned in a masterly performance, shutting down the Texas Rangers, 3-0, on two hits.', 'web_url': 'https://www.nytimes.com/2012/08/15/sports/baseball/kuroda-pitches-complete-game-as-yankees-beat-rangers.html', 'snippet': 'Hiroki Kuroda drew full support from the crowd as he turned in a masterly performance, shutting down the Texas Rangers, 3-0, on two hits.', 'lead_paragraph': 'The Yankees’ catchers have about 10 key words they use to communicate with the Japanese pitcher Hiroki Kuroda when he is on the mound. They are basic phrases of pitching — relax, keep the ball down, attack the strike zone.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/sports/YANKEES1/YANKEES1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/15/sports/YANKEES1/YANKEES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/sports/YANKEES1/YANKEES1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/sports/YANKEES1/YANKEES1-superJumbo.jpg', 'height': 1362, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/sports/YANKEES1/YANKEES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/15/sports/YANKEES1/YANKEES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/15/sports/YANKEES1/YANKEES1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kuroda Dominates as Yankees Defeat Rangers Again', 'kicker': 'Yankees 3, Rangers 0', 'content_kicker': None, 'print_headline': 'Kuroda Lets Pitching Do the Talking, and Nothing Is Lost in Translation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Swisher, Nick', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Texas Rangers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kuroda, Hiroki', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-15T02:30:30+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Zach Schonbrun', 'person': [{'firstname': 'Zach', 'middlename': None, 'lastname': 'Schonbrun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0f1e89b-c51d-583c-b7