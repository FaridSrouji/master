ame': 'Edward', 'middlename': None, 'lastname': 'Chun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/cf4a2ae1-7871-541f-a7c7-48785e504248', 'word_count': 0, 'uri': 'nyt://video/cf4a2ae1-7871-541f-a7c7-48785e504248'}, {'abstract': 'The malfunction was a particularly glaring failure of Russia’s space program, coming just hours after NASA landed a research probe on Mars.', 'web_url': 'https://www.nytimes.com/2012/08/08/world/europe/russian-booster-rocket-fails-to-deliver-satellites.html', 'snippet': 'The malfunction was a particularly glaring failure of Russia’s space program, coming just hours after NASA landed a research probe on Mars.', 'lead_paragraph': 'MOSCOW — A Russian booster rocket carrying two telecommunications satellites malfunctioned during a launching early Tuesday, failing to deliver the satellites into their proper orbit and rendering them useless and unsalvageable.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Russian Booster Rocket Fails to Deliver Satellites', 'kicker': None, 'content_kicker': None, 'print_headline': 'Russia: Launching of Satellites Fails', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Space', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Satellites', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Rocket Science and Propulsion', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-07T17:14:12+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Anna Kordunsky', 'person': [{'firstname': 'Anna', 'middlename': None, 'lastname': 'Kordunsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'typ