es', 'multimedia': [], 'headline': {'main': 'Powerful Bank Regulator to Retire', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Curry, Thomas J', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Office of the Comptroller of the Currency', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-13T21:35:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Protess', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/304fdf07-8386-5762-bf91-d9e4c32d382b', 'word_count': 677, 'uri': 'nyt://article/304fdf07-8386-5762-bf91-d9e4c32d382b'}, {'abstract': 'Bart Millard and the Christian rock band MercyMe performed at Citi Field after a Mets game on Friday night.', 'web_url': 'https://www.nytimes.com/2012/08/14/arts/music/bart-millard-and-mercyme-perform-at-citi-field.html', 'snippet': 'Bart Millard and the Christian rock band MercyMe performed at Citi Field after a Mets game on Friday night.', 'lead_paragraph': 'Bart Millard is a tender singer with a big mouth. The frontman of MercyMe, one of the steadiest and most successful bands in the hermetic world of Christian rock, he’s genial but not distant, caressing in the loudest way possible.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia':