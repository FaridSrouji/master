4, 'major': 'N'}, {'name': 'glocations', 'value': 'Salt Lake City (Utah)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-28T17:00:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Ian Mount', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Mount', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fbeebb21-63c6-5eec-9cee-7e62b6fbbe6e', 'word_count': 811, 'uri': 'nyt://article/fbeebb21-63c6-5eec-9cee-7e62b6fbbe6e'}, {'abstract': 'Las Vegas was a top choice for British athletes vacationing after the Olympics.', 'web_url': 'https://intransit.blogs.nytimes.com/2012/08/28/harry-is-only-vegass-most-visible-briton/', 'snippet': 'Las Vegas was a top choice for British athletes vacationing after the Olympics.', 'lead_paragraph': 'Prince Harry’s arrival in Las Vegas after the Olympics spurred interest among Britons even before photos of his game of strip billiards were published by the gossip site TMZ.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Harry Is Only Vegas’s Most Visible Briton', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'British Airways PLC', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Las Vegas (Nev)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-08-28T17:00:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Emily Brennan', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': 'Brennan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/51554f35-639c-5604-86c3-21442edf90fe', 'word_count': 168, 'uri': 'nyt://article/51554f35-639c-5604-86c3-21442edf90fe'}, {'abstract': 'Levels of the disease are high in other parts of the country, but not in New York.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/08/28/eight-west-nile-cases-reported-in-city-similar-to-level-in-2011/', 'snippet': 'Levels of the disease are high in other parts of the country, but not in New York.', 'lead_paragraph': 'During a summer in which West Nile virus has jumped to record levels nationwide, eight city residents have contracted the mosquito-borne illness — a similar level to the number infected by this time last year, according to the city’s health department.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Eight West Nile Cases Reported in City, Similar to Level in 2011', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'West Nile Virus', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Health and Mental Hygiene Department (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-28T17:05:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Chris Palmer', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Palmer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d62598c6-61d0-5623-b037-2ad32eef51cd', 'word_count': 356, 'uri': 'nyt://article/d62598c6-61d0-5623-b037-2ad32eef51cd'}, {'abstract': 'As Paul D. Ryan prepares his vice-presidential acceptance speech, advisers are playing down Palin-like expectations, well aware that he might be sharing screen time with a hurricane.', 'web_url': 'https://www.nytimes.com/2012/08/29/u