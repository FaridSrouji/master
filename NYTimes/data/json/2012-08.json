don 2012.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '10 Animated GIFs From London 2012', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bolt, Usain', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Douglas, Gabby', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sun Yang', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-08-10T11:30:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Samantha Storey', 'person': [{'firstname': 'Samantha', 'middlename': None, 'lastname': 'Storey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/faf66df3-74d1-5b22-a1a9-784059390dc9', 'word_count': 589, 'uri': 'nyt://article/faf66df3-74d1-5b22-a1a9-784059390dc9'}, {'abstract': 'Japan recalled its ambassador from Seoul on Friday after President Lee Myung-bak of South Korea flew to a set of islets claimed by both countries.', 'web_url': 'https://www.nytimes.com/2012/08/11/world/asia/south-koreans-visit-to-disputed-islets-angers-japan.html', 'snippet': 'Japan recalled its ambassador from Seoul on Friday after President Lee Myung-bak of South Korea flew to a set of islets claimed by both countries.', 'lead_paragraph': 'SEOUL, South Korea — President Lee Myung-bak of South Korea flew to a set of islets locked in a territorial dispute with Japan on Friday, dismissing protests from Tokyo and making a trip that was bound to heighten diplomatic tensions between Washington’s two key Asian allies.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, '