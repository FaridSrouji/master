': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York Film Festival Unveils Main Slate Selections', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'New York Film Festival Names Main Selections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New York Film Festival', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baumbach, Noah', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Berliner, Alan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Chase, David', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'de Palma, Brian', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gerwig, Greta', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Haneke, Michael', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lee, Ang', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Mungiu, Cristian', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Potter, Sally', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Zemeckis, Robert', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-08-16T19:56:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10044e9a-5b4d-58dc-8eaf-9b5e3cd41e09', 'word_count': 235, 'uri': 'nyt://article/10044e9a-5b4d-58dc-8eaf-9b5e3cd41e09'}, {'abstract': 'This invigorating show proves that it is pleasing to see artists talking back to the soul-insulting banality of conventional advertising.', 'web_url': 'https://www.nytimes.com/2012/08/17/arts/design/signs-of-the-times-at-jonathan-levine.html', 'snippet': 'This invigorating show proves that it is pleasing to see artists talking back to the soul-insulting banality of 