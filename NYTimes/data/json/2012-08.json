rson': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Keller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/708a5290-176e-55a9-96f1-fab7b99f8aac', 'word_count': 563, 'uri': 'nyt://article/708a5290-176e-55a9-96f1-fab7b99f8aac'}, {'abstract': 'A French court will open a homicide investigation into the 2004 death of the former Palestinian leader Yasir Arafat, French news media reported Tuesday.', 'web_url': 'https://www.nytimes.com/2012/08/29/world/europe/france-opens-homicide-inquiry-in-arafats-death.html', 'snippet': 'A French court will open a homicide investigation into the 2004 death of the former Palestinian leader Yasir Arafat, French news media reported Tuesday.', 'lead_paragraph': ' A French court will open a homicide investigation into the 2004 death of the former Palestinian leader Yasir Arafat, left, French news media reported Tuesday. Mr. Arafat’s widow, Suha, petitioned French authorities to investigate last month after findings by a Swiss laboratory suggested that Mr. Arafat may have been exposed to polonium 210, the same radioactive isotope used to poison a dissident Russian former spy in London in 2006. Mr. Arafat died in a French military hospital on Nov. 11, 2004, after an infection that was never identified, according to medical records. There have long been suggestions, however unspecific, that he may have been the victim of foul play. The Palestinian Authority, which has agreed to exhume the body for analysis, welcomed the French decision, Saeb Erekat, an aide to the Palestinian Authority president Mahmoud Abbas, told Agence France-Presse. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/world/BRIEFS/BRIEFS-jumbo.jpg', 'height': 1024, 'width': 670, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/world/BRIEFS/BRIEFS-superJumbo.jpg', 'height': 1459, 'width': 954, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/world/BRIEFS/BRIEFS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/29/world/BRIEFS/BRIEFS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/29/world/BRIEFS/BRIEFS-thumbLarge.jpg', 'height': 149, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'France Opens Homicide Inquiry in Arafat’s Death', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'France Opens Homicide Inquiry in Arafat’s Death', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Radiation', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Poisoning and Poisons', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'ARAFAT, YASIR', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-29T03:15:54+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Scott Sayare', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Sayare', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://artic