': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e7bd3e8-0bb1-52bd-b7ce-1692969e4da4', 'word_count': 552, 'uri': 'nyt://article/1e7bd3e8-0bb1-52bd-b7ce-1692969e4da4'}, {'abstract': 'Brooks and Collins discuss Paul Ryan, the Ryan plan and whether good parents make good presidents.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/08/22/whose-ryan-is-it-anyway/', 'snippet': 'Brooks and Collins discuss Paul Ryan, the Ryan plan and whether good parents make good presidents.', 'lead_paragraph': 'Gail Collins: David, welcome back! You missed so much while you were on vacation. Tim Pawlenty is the Republican vice-presidential nominee, and Michele Bachmann is going to make the keynote speech at the convention, and Donald Trump will be leading the invocation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Whose Ryan Is It Anyway?', 'kicker': 'Opinionator', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Taxation', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Congressional Budget Office', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-08-22T17:40:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Brooks and Gail Collins', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Gail', 'middlename': None, 'lastname': 'Collins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dc8c943a-aba8-56a1-a1a8-b4c43c951071', 'word_count': 1287, 'uri': 'nyt://article/dc8c943a-aba8-56a1-a1a8-b4c43c951071'}, {'abstract': 'Women filed two-thirds of new long-term care claims last year, an industry report says.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/08/22/most-new-long-term-care-claims-are-filed-by-women/', 'snippet': 'Women filed two-thirds of new long-term care claims last year, an industry report says.', 'lead_paragraph': 'While deciding to purchase long-term care insurance is a complex decision, it is one that women, in particular, may want to spend some time considering. Nearly two-thirds of new claims under long-term care policies in 2011 were made by women, according to the latest data from an industry group.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Most New Long-Term Care Claims Are Filed by Women', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': 'Care Policies And Women', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Alzheimer's Disease", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elderly', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Home Health Care', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Long-Term Care Insurance', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Longevity', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Nursing Homes', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'American Association for Long-Term Care Insurance', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-22T17:40:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastna