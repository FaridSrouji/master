: 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'From Sportsman to Politician', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T09:01:21+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/1deb68e7-5582-559d-8d64-a9cff0851f8f', 'word_count': 0, 'uri': 'nyt://slideshow/1deb68e7-5582-559d-8d64-a9cff0851f8f'}, {'abstract': 'Does the former cricket superstar Imran Khan have what it takes to lead an angry and disillusioned nation?', 'web_url': 'https://www.nytimes.com/2012/08/19/magazine/pakistans-imran-khan-must-be-doing-something-right.html', 'snippet': 'Does the former cricket superstar Imran Khan have what it takes to lead an angry and disillusioned nation?', 'lead_paragraph': 'On a cool evening in March, Imran Khan, followed by his dogs, walked around the extensive lawns of his estate, sniffling with an incipient cold. “My ex-wife, Jemima, designed the house — it is really paradise for me,” Khan said of the villa, which sprawls on a ridge overlooking Himalayan foothills and Pakistan’s capital, Islamabad. “My greatest regret is that she is not here to enjoy it,” he added, unexpectedly poignantly. We walked through the living room and then sat in his dimly lighted bedroom, the voices of servants echoing in the empty house, the mournful azans drifting up from multiple mosques in the city below.', 'print_section': 'MM', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19khan/19khan-articleLarge.jpg', 'height': 720, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/08/19/magazine/19khan/19khan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 720}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19khan/mag-19Khan-t_CA1-jumbo.jpg', 'height': 1024, 'width': 851, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19khan/mag-19Khan-t_CA1-superJumbo.jpg', 'height': 1500, 'width': 1247, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19khan/19khan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/08/19/magazine/19khan/19khan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/08/19/magazine/19khan/19khan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Imran Khan Must Be Doing Something Right', 'kicker': None, 'content_kicker': None, 'print_headline': 'I Must Be Doing Something Right.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'North-West Frontier Province (Pakistan)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Khan, Jemima', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Pakistan Peoples Party', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Khan, Imran', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-08-16T09:01:28+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Pankaj Mishra', 'person': [{'firstname': 'Pankaj', 'middlename': None, 'lastname': 'Mishra', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e0ef4b6-73ef-5980-9b60-9e7bf9c672f7', 'word_count': 5639, 'uri': 'nyt://article/6e0ef4b6-73ef-5980-9b60-9e7bf9c672f7'}, {'abstract': 'With the turmoil in Syria persisting, how have many Syrians attempted to balance the desires of life with the demands of war?', 'web_url': 'https://learning.blogs.nytimes.com/2012/08/16/in-syria-the-demands-of-life-conflict-with-those-of-war/', 'snippet': 'With the turmoil in Syria persisting, how have many Syrians attempted to balance the desires of life with the demands of war?', 'lead_paragraph': 'WHEN did the Syrian conflict begin? ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Syria, the Demands of Life Conflict With Those of War', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-08-16T09:08:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Ben Murray', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Murray', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a246b186-58dd-580e-9001-da1f79a37426', 'word_count': 162, 'uri': 'nyt://article/a246b186-58dd-580e-9001-da1f79a37426'}, {'abstract': 'More than 6,000 people left Bangalore on Wednesday fearing violent attacks.', 'web_url': 'https://india.blogs.nytimes.com/2012/08/16/rumors-lead-northeastern-people-to-flee-bangalore/', 'snippet': 'More than 6,000 people left Bangalore on Wednesday fearing violent attacks.', 'lead_paragraph': 'Wild rumors of pending attacks led several thousand people to flee Bangalore on Wednesday night because of fears that violence in India’s northeastern region would somehow spread south.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rumors Lead People from Northeast to Flee Bangalore', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Bangalore (India)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Karnataka (India)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-16T10:00:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Hari Kumar', 'person': [{'firstname': 'Hari', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8977a562-9792-5c44-9845-e5edaf660185', 'word_count': 356, 'uri': 'nyt://article/8977a562-9792-5c44-9845-e5edaf660185'}, {'abstract': 'Mercedes-Benz USA released pricing information for its 2013 model line. The Maybachs received only one word: “Discontinued.”', 'web_url': 'https://wheels.blogs.nytimes.com/2012/08/16/at-last-the-maybach-is-priceless/', 'snippet': 'Mercedes-Benz USA released pricing information for its 2013 model line. The Maybachs received only one word: “Discontinued.”', 'lead_paragraph': 'The word “Discontinued” appeared next to the five bottommost items on a price sheet issued recently by Mercedes-Benz USA for its 2013 vehicles. It was a jarring coda to the jumble of dollar signs, commas and digits — many of them stretching to six figures — that preceded it.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'At Last, the Maybach Is Priceless', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Daimler AG', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Mercedes-Benz', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-08-16T10:00:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Jonathan Schultz', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Schultz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7ba89cef-4ad9-5b89-9595-b92da321ffb7', 'word_count': 249, 'uri': 'nyt://article/7ba89cef-4ad9-5b89-9595-b92da321ffb7'}, {'abstract': 'There’s probably not a team in the N.F.L. with worse depth than Oakland.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/08/16/oakland-raiders-2012-n-f-l-season-preview/', 'snippet': 'There’s probably not a team in the N.F.L. with worse depth than Oakland.', 'lead_paragraph': 'In professional sports, we’re always hearing about how “it’s a new era (!) in such-and-such-a-city.” Almost always, this is just a euphemistic way of saying that a team has been bad in recent years and is now hoping that a few personnel changes can fix things. But in the case of the 2012 Oakland Raiders, it really is a new era.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Oakland Raiders, 2012 N.F.L. Season Preview', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Oakland Raiders', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-08-16T10:00:30+0000', 'document_type': 'article', 'news_desk': '', '