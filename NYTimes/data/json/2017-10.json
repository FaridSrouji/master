OOK-1-copy/03FACEBOOK-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/03/business/13FACEBOOK-1-copy/03FACEBOOK-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/03/business/13FACEBOOK-1-copy/03FACEBOOK-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Facebook’s Ad System Works', 'kicker': None, 'content_kicker': None, 'print_headline': 'Blurring Lines: How the Ad System on Your Facebook News Feed Works', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Online Advertising', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Russian Interference in 2016 US Elections and Ties to Trump Associates', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-12T22:26:20+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Cade Metz', 'person': [{'firstname': 'Cade', 'middlename': None, 'lastname': 'Metz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eb0db239-f9ff-5b0f-ad0b-eff571cfe352', 'word_count': 1233, 'uri': 'nyt://article/eb0db239-f9ff-5b0f-ad0b-eff571cfe352'}, {'abstract': 'President Trump says the United States may withdraw from the North American Free Trade Agreement. That would bring big changes for the economy and consumers.', 'web_url': 'https://www.nytimes.com/2017/10/12/business/economy/what-would-happen-if-the-us-withdrew-from-nafta.html', 'snippet': 'President Trump says the United Stat