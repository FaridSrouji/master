rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8f47b315-cc14-5d9f-b420-9049d06decbb', 'word_count': 669, 'uri': 'nyt://article/8f47b315-cc14-5d9f-b420-9049d06decbb'}, {'abstract': 'Uber may have lost its license in London but there are plenty of other apps to choose from there and in New York. Here’s our guide.', 'web_url': 'https://www.nytimes.com/2017/10/04/travel/uber-alternatives-new-york-london.html', 'snippet': 'Uber may have lost its license in London but there are plenty of other apps to choose from there and in New York. Here’s our guide.', 'lead_paragraph': 'When it comes to ride-hailing apps worldwide, Uber may be the most popular brand, but it is by no means the only one. So the 3.5 million people in London who have used Uber in the last three months will have plenty of options to choose from in the wake of the decision by London’s transportation agency not to renew its license to operate there. So, too, do the 3.5 million Uber users in New York, who don’t have to contend with losing the service altogether but may want alternatives during peak demand, when surge pricing becomes more common. Fortunately, each destination happens to have a robust network of ride-hailing apps, said Andrew MacDougall, the head of communications for Citymapper, an app that helps its users connect with local transportation in 40 cities. “New York and London have plenty of competitors to Uber,” he said.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/25/world/25BRITAIN/25BRITAIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/06/25/world/25BRITAIN/25BRITAIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/25/world/25BRITAIN/25BRITAIN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/25/world/25BRITAIN/25BRITAIN-articleLarge.jpg', 'height': 412, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/06/25/world/25BRITAIN/25BRITAIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 412}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/25/world/25BRITAIN/25BRITAIN-jumbo.jpg', 'height': 703, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/06/25/world/25BRITAIN/25BRITAIN-superJumbo.jpg', 'height': 1405, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Here Are Some Alternatives to Uber', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Car Services and Livery Cabs', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Lyft Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Citymapper Ltd', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-04T09:05:45+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Shivani Vora', 'person': [{'firstname': 'Shivani', 'middlename': None, 'lastname': 'Vora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a641b99d-286d-5fec-9cbd-6514f3d95a7a', 'word_count': 1075, 'uri': 'nyt://article/a641b99d-286d-5fec-9cbd-6514f3d95a7a'}, {'abstract':