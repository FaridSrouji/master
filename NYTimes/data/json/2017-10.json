: None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Robert', 'middlename': None, 'lastname': 'Pear', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7029e5c1-2544-5728-971f-d842d4149db0', 'word_count': 1245, 'uri': 'nyt://article/7029e5c1-2544-5728-971f-d842d4149db0'}, {'abstract': 'Congress, not the Supreme Court, should decide the fate of data held abroad.', 'web_url': 'https://www.nytimes.com/2017/10/18/opinion/data-abroad-privacy-court.html', 'snippet': 'Congress, not the Supreme Court, should decide the fate of data held abroad.', 'lead_paragraph': 'In 2013, United States agents served a warrant on Microsoft seeking the emails of a suspect in a drug case. Microsoft balked at the request, saying that the data was stored on a server in Ireland and out of the reach of United States law enforcement. To access the data, the United States would need to make a request to the Irish government through diplomatic channels — a slow and burdensome process. The government fought back, arguing that the Washington State-based company could access the emails from the United States, without ever stepping foot in Ireland, and was required to comply.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/18/opinion/18daskalWeb/18daskalWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/18/opinion/18daskalWeb/18daskalWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/18/opinion/18daskalWeb/18daskalWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/18/opinion/18daskalWeb/18daskalWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/18/opinion/18daskalWeb/18daskalWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/18/opinion/18daskalWeb/18daskalWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/18/opinion/18daskalWeb/18daskalWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'There’s No Good Decision in the Next Big Data Privacy Case', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Law and Legislation', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Data Storage', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-10-18T15:26:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Daskal', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Daskal', 'qualifier': None, 'title': None, 'role': 'repor