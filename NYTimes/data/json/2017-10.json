, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20latenight1/20latenight1-superJumbo.png', 'height': 788, 'width': 1440, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20latenight1/20latenight1-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/20/arts/20latenight1/20latenight1-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20latenight1/20latenight1-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trevor Noah Isn’t Surprised That Trump Offended a Fallen Soldier’s Widow', 'kicker': 'Best of Late Night', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Noah, Trevor (1984- )', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Daily Show with Trevor Noah (TV Program)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Thede, Robin', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McCain, John', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kimmel, Jimmy', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Atamanuik, Anthony', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'BET (TV Network)', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-10-20T08:42:44+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Giovanni Russonello', 'person': [{'firstname': 'Giovanni', 'middlename': None, 'lastname': 'Russonello', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/829c00ac-fea5-56a6-b86f-e0a6399314ed', 'word_count': 469, 'uri': 'nyt://article/829c00ac-fea5-56a6-b86f-e0a6399314ed'}, {'abstract': 'This is what happens when men who feel entitled to control women get power.', 'web_url': 'https://www.nytimes.com/2017/10/20/opinion/trump-pregnancy-abortion-.html', 'snippet': 'This is what happens when men who feel entitled to control women get power.', 'lead_paragraph': 'In early September, a 17-year-old girl from Central America was apprehended trying cross the border between the United States and Mexico. After being taken to a shelter for unaccompanied minors in South Texas to await immigration proceedings, she learned she was pregnant. The girl, referred to as Jane Doe in court filings, was adamant that she wanted an abortion. Because of Texas’ parental consent law, she needed to go to court to get a judge’s permission, which she did with help from Jane’s Due Process, a nonprofit legal organization that provides representation to pregnant minors in Texas. Jane’s Due Process collected money for the procedure from local abortion funds. It was scheduled for Sept. 28, near the end of Doe’s first trimester.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/opinion/20goldberg/merlin-to-scoop-106318382-185021-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/20/opinion/20goldberg/merlin-to-scoop-106318382-185021-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/opinion/20goldberg/merlin-to-scoop-106318382-185021-jumbo.jpg'