idth': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trump Voters, Writ Large', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Trump Voters, Writ Large', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Trump, Donald J', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-10-09T17:19:03+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/24043594-9f88-5a2c-bfa7-a8efc059b322', 'word_count': 145, 'uri': 'nyt://article/24043594-9f88-5a2c-bfa7-a8efc059b322'}, {'abstract': 'The devastation left by Hurricane Maria has ignited a dire sense of urgency for politicians who feel compelled to look after their ancestral homeland.', 'web_url': 'https://www.nytimes.com/2017/10/09/nyregion/politicians-with-puerto-rican-roots-challenge-trump-in-push-for-aid.html', 'snippet': 'The devastation left by Hurricane Maria has ignited a dire sense of urgency for politicians who feel compelled to look after their ancestral homeland.', 'lead_paragraph': 'José E. Serrano has been elected again and again to represent a tiny, tightly packed congressional district in the South Bronx. But since the storm that ravaged Puerto Rico, the island where he lived until he was 8, another constituency far from New York City has commanded more of his attention. It is one that has never voted for him, but that he has nonetheless adopted as his own.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/04/nyregion/00puertopols1/00puertopols1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStan