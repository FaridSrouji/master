it': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27alliseeisyou/27alliseeisyou-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27alliseeisyou/27alliseeisyou-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27alliseeisyou/27alliseeisyou-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/27/arts/27alliseeisyou/27alliseeisyou-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27alliseeisyou/27alliseeisyou-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In ‘All I See Is You,’ Sight Is Restored and a Marriage Rocked', 'kicker': None, 'content_kicker': None, 'print_headline': 'All I See Is You', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'All I See Is You (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Forster, Marc', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lively, Blake', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Clarke, Jason', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-10-26T11:00:27+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d4579165-4420-596e-800c-e9cc3951d7a1', 'word_count': 276, 'uri': 'nyt://article/d4579165-4420-596e-800c-e9cc3951d7a1'}, {'abstract': 'The basement club, which for five years served as the louche headquarters for the East Village 1980s art movement, time-travels to the Museum of Modern Art.', 'web_url': 'https://www.nytimes.com/2017/10/26/arts/design/club-57-museum-of-modern-art.html', 'snippet': 'The basement club, which for five years served as the louche headquarters for the East Village 1980s art movement, time-travels to the Museum of Modern Art.', 'lead_paragraph': 'It hardly looked like hallowed cultural ground, let alone the heart of the 1980s East Village art scene. Even Kenny Scharf, who practically lived out of this spot, seemed unsure on a recent afternoon whether 57 Saint Marks Place was truly the former location of Club 57, the basement bar that served as the louche headquarters for a now-legendary art movement and its foremost triad of art stars, the painters (and sometimes friendly rivals) Jean-Michel Basquiat, Keith Haring and Mr. Scharf. Staring at the sign of the building’s current tenant — the St. Marks Place Institute for Mental Health — Mr. Scharf, 59, finally cracked a smile. “This must be the right place, it sounds like the name of a great party we threw here once,” he quipped.', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27club574/27club574-articleLarge.jpg', 'height': 517, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/27/arts/27club574/27club574-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 517}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27club574/27club574-jumbo.jpg', 'height': 882, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27club574/27club574-superJumbo.jpg', 'height': 1763, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27club574/27club574-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/27/arts/27club574/27club574-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/arts/27club574/27club574-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Club 57, Late-Night Home of Basquiat and Haring, Gets a Museum-Worthy Revival', 'kicker': None, 'content_kicker': None, 'print_headline': 'Club 57, Museum Piece', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum of Modern Art', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Basquiat, Jean-Michel', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Haring, Keith', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Scharf, Kenny', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Magnuson, Ann', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Club 57: Film, Performance, and Art in the East Village, 1978-1983 (Exhibit)', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-10-26T11:00:38+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Brett Sokol', 'person': [{'firstname': 'Brett', 'middlename': None, 'lastname': 'Sokol', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f00b8f3c-2a64-50e5-9e1f-f81679f0feba', 'word_count': 1769, 'uri': 'nyt://article/f00b8f3c-2a64-50e5-9e1f-f81679f0feba'}, {'abstract': 'The pomp and pageantry of Thailand’s monarchy were on display for the cremation of King Bhumibol Adulyadej.', 'web_url': 'https://www.nytimes.com/2017/10/26/world/asia/thailand-king-funeral.html', 'snippet': 'The pomp and pageantry of Thailand’s monarchy were on display for the cremation of King Bhumibol Adulyadej.', 'lead_paragraph': 'BANGKOK — With the gilded pageantry of a bygone era, the cremation ceremony of King Bhumibol Adulyadej of Thailand began in earnest on Thursday. Hundreds of thousands of black-clad mourners lined the streets of Bangkok to honor him and catch a glimpse of the royal chariot transporting his funerary urn to a 164-foot-high pyre.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/world/27thai-visual-alpha/27thai-visual-11-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/27/world/27thai-visual-alpha/27thai-visual-11-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/world/27thai-visual-alpha/27thai-visual-11-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/27/world/27thai-visual-alpha/27thai-visual-11-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo'