caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/12/world/12Liberia1/12Liberia1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/12/world/12Liberia1/12Liberia1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/12/world/12Liberia1/12Liberia1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ex-Soccer Star and Vice President Lead in Liberia Presidential Vote', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ex-Soccer Star and Vice President Lead in Liberia Presidential Vote', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Liberia', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Boakai, Joseph', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Weah, George', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-12T20:50:46+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Helene Cooper', 'person': [{'firstname': 'Helene', 'middlename': None, 'lastname': 'Cooper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b11e1607-abaa-57bd-a030-6a10d7f60e53', 'word_count': 452, 'uri': 'nyt://article/b11e1607-abaa-57bd-a030-6a10d7f60e53'}, {'abstract': 'Suggested reading from critics and editors at The New York Times.', 'web_url': 'https://www.nytimes.com/2017/10/12/books/review/10-new-books-we-recommend-this-week.html', 'snippet': 'Suggested reading from critics and editors at The New York Times.', 'lead_paragraph': 'We’re nearing the season for ghost stories — or, in the case of William Alexander’s new middle-grade novel, “A Properly Unhaunted Place,” un-ghost stories, cautionary tales about what happens when we try too hard to put our history behind us. Eleanor Henderson’s “The Twelve-Mile Straight” and Josephine Rowe’s “A Loving, Faithful Animal” wrestle with the enduring trauma of violence over generations, and Alice McDermott’s “The Ninth Hour” draws narrative power from that perennial burden of Catholicism, shame. Two finalists for the National Book Awards appear on this week’s list: Frank Bidart’s collected poems, “Half-Light,” and Carmen Maria Machado’s debut collection of stories, “Her Body and Other Parties.” You have until the awards are announced on Nov. 15 to finish them. Go!', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/15/books/review/15edchoice-covers/15edchoice-covers-articleLarge.jpg', 'height': 293, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/15/books/review/15edchoice-covers/15edchoice-covers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 293}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/15/books/review/15edchoice-covers/15edchoice-covers-jumbo.jpg', 'height': 501, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/15/books/review/15edchoice-covers/15edchoice-covers-superJumbo.jpg', 'height': 509, 'width': 1041, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/15/books/review/15edchoice-covers/15edchoice-covers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/15/books/review/15edchoice-covers/15edchoice-covers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/15/books/review/15edchoice-covers/15edchoice-covers-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '10 New Books We Recommend This Week', 'kicker': 'Editors’ Choice', 'content_kicker': None, 'print_headline': 'Staff Picks From the Book Review', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-10-12T20:53:03+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/e11901ed-60cf-51f7-b609-500943d54cdd', 'word_count': 871, 'uri': 'nyt://article/e11901ed-60cf-51f7-b609-500943d54cdd'}, {'abstract': 'Our guide to cultural events in New York City for families with children and teenagers.', 'web_url': 'https://www.nytimes.com/2017/10/12/arts/events-for-children-in-nyc-this-week.html', 'snippet': 'Our guide to cultural events in New York City for families with children and teenagers.', 'lead_paragraph': '‘ENCOUNTERS WITH THE NATURAL WORLD: SCIENCE FOR NANOS’ AT THE NEW YORK HALL OF SCIENCE (Oct. 14 at 2 p.m.) This cinema program is like a play date between art and science. And like any play date, it appeals to the adventurous young. Part of the Imagine Science Film Festival, which runs through Oct. 20, “Encounters” will present a dozen American and European shorts, whose settings range from a petri dish (Chloe Thomas’s “Dish Life”) to the International Space Station (Joseph Childs and Iro Tsavala’s “A Story From Space”). The selections also explore the ocean depths: “Polymer,” by Astrid Goldsmith, features an animated monster avenging plastic pollution, and “My Haggan Dream,” by the siblings Laura Sams and Rob Sams, follows a young girl’s investigation into sea turtles’ fragile future — and our own. 718-699-0005, imaginesciencefilms.org', 'print_section': 'C', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/13/arts/13LISTINGS-KIDS/13LISTINGS-KIDS-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/13/arts/13LISTINGS-KIDS/13LISTINGS-KIDS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/13/arts/13LISTINGS-KIDS/13LISTINGS-KIDS-jumbo.jpg', 'height': 614, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/13/arts/13LISTINGS-KIDS/13LISTINGS-KIDS-superJumbo.jpg', 'height': 1199, 'width': 2001, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/13/arts/13LISTINGS-KIDS/13LISTINGS-KIDS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/13/arts/13LISTINGS-KIDS/13LISTINGS-KIDS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/13/arts/13LISTINGS-KIDS/13LISTINGS-KIDS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}]