29Broyard/29Broyard-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/29/books/review/29Broyard/29Broyard-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In ‘After the Eclipse,’ a Daughter Mourns Her Murdered Mother', 'kicker': 'Nonfiction', 'content_kicker': None, 'print_headline': 'When Darkness Falls', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': "After the Eclipse: A Mother's Murder, a Daughter's Search (Book)", 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Sarah (1981- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-26T09:00:18+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Bliss Broyard', 'person': [{'firstname': 'Bliss', 'middlename': None, 'lastname': 'Broyard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/43c69902-dd19-56fd-984f-ad64fb7ddc92', 'word_count': 675, 'uri': 'nyt://article/43c69902-dd19-56fd-984f-ad64fb7ddc92'}, {'abstract': 'It was the first I had endeavored on my own. The experience was . . . formative.', 'web_url': 'https://www.nytimes.com/2017/10/26/magazine/my-no-good-very-bad-dinner-party.html', 'snippet': 'It was the first I had endeavored on my own. The experience was . . . formative.', 'lead_paragraph': 'Not long ago, a group of friends and I began reminiscing about memorable dinner parties we’d attended. Almost at once I was flooded with an overwhelming barrage of images. Like Proust, but more embarrassing. There was that time my hosts served an omelet topped with ice cream and old coffee grounds — oh, and we were in a treehouse. Or that memorable occasion on which I was asked to give my boss a birthday dinner, cut my fingertip off with a mandoline and served everyone with a bloody bandage. Or that fancy dinner I gave where a bunch of crashers showed up, smoked weed out of corncob pipes and then left, taking an entire homemade pie with them. I shouldn’t even mention my brief mania for giving “theme” dinners in which the theme was known only to me: the Prematurely Bald Men Party; the Dinner at Which Everyone’s Boyfriend Is Named Dave; the All-Strangers Spaghetti Gala. Perhaps the most memorable of all, though, was a dinner party I had when I was 18, mostly because it was the first I ever executed completely on my own. I feel, in a way, that it was formative and that all dinner parties since then have been influenced in some way by the events of that evening.', 'print_section': 'MM', 'print_page': '56', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/29/magazine/29badhost-illo/29badhost-illo-articleLarge.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/29/magazine/29badhost-illo/29badhost-illo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/29/magazine/29badhost-illo/29badhost-illo-jumbo.jpg', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/29/magazine/29badhost-illo/29badhost-illo-superJumbo.jpg', 'height': 1024, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'r