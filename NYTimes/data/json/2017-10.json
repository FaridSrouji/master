ions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fuel Efficiency', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Ford Motor Co', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'General Motors', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Barra, Mary T', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hackett, Jim', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Pruitt, Scott', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 10, 'major': 'N'}], 'pub_date': '2017-10-19T08:55:12+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By William K. Reilly and Kenneth Kimmell', 'person': [{'firstname': 'William', 'middlename': 'K.', 'lastname': 'Reilly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Kenneth', 'middlename': None, 'lastname': 'Kimmell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/23f55695-92da-562f-8f99-d237f055a2fd', 'word_count': 899, 'uri': 'nyt://article/23f55695-92da-562f-8f99-d237f055a2fd'}, {'abstract': 'The “Daily Show” host said of Mr. Weinstein, “This guy keeps getting worse and worse.”', 'web_url': 'https://www.nytimes.com/2017/10/19/arts/television/trevor-noah-harvey-weinstein-border-wall.html', 'snippet': 'The “Daily Show” host said of Mr. Weinstein, “This guy keeps getting worse and worse.”', 'lead_paragraph': 'Welcome to Best of Late Night, a rundown that lets you sleep — and lets us get paid to watch comedy. What do you think of it? What else are you interested in? Let us know: thearts@nytimes.com.', 'source': 'The New York Times', 'multimedia': [{'rank