octor/well-firing-doctor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/17/well/family/well-firing-doctor/well-firing-doctor-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/17/well/family/well-firing-doctor/well-firing-doctor-superJumbo.jpg', 'height': 1200, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/17/well/family/well-firing-doctor/well-firing-doctor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/17/well/family/well-firing-doctor/well-firing-doctor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/17/well/family/well-firing-doctor/well-firing-doctor-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why I Almost Fired My Doctor', 'kicker': None, 'content_kicker': None, 'print_headline': 'Why I Almost Fired My Doctor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Doctors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electronic Health Records', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Longevity', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-10-12T10:00:01+0000', 'document_type': 'article', 'news_desk': 'Well', 'section_name': 'Well', 'subsection_name': 'Live', 'byline': {'original': 'By Bob Brody', 'person': [{'firstname': 'Bob', 'middlename': None, 'lastname': 'Brody', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45cab557-75ce-56e9-9822-841d4a485117', 'word_count': 1060, 'uri': 'nyt://article/45cab557-75ce-56e9-9822-841d4a485117'}, {'abstract': 'Cracking up may be a better option than breaking down, or so three recent books by young people with cancer suggest.', 'web_url': 'https://www.nytimes.com/2017/10/12/well/live/cancer-humor.html', 'snippet': 'Cracking up may be a better option than breaking down, or so three recent books by young people with cancer suggest.', 'lead_paragraph': 'During periods of hardship, laughter can lighten the load. Cracking up may be a better option than breaking down, or so the recent publications of three young adults with cancer suggest. Somewhat discomfiting, the jests of these authors serve as an antidote and alternative to the despairing negativity or fake positivity that plagues patients like me. Their punch lines zing with pleasure that offsets the pain of their edgy insights.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/12/well/family/well-gubar-humor/well-gubar-humor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/12/well/family/well-gubar-humor/well-gubar-humor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/12/well/family/well-gubar-humor/well-gubar-humor-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/12/well/family/well-gubar-humor/well-gubar-humor-articleLarge.jpg', 'height': 878, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/12/well/family/well-gubar-humor/well-gubar-humor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 878}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/12/well/family/well-gubar-humor/well-gubar-humor-jumbo.jpg', 'height': 1024, 'width': 700, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/12/well/family/well-gubar-humor/well-gubar-humor-superJumbo.jpg', 'height': 2048, 'width': 1400, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Cancer Humor', 'kicker': 'Living With Cancer', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Breast Cancer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': "Ewing's Sarcoma (Disease)", 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Riggs, Nina (1977-2017)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Harrison, Teva (1976- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Ritvo, Max (1990-2016)', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-10-12T10:00:02+0000', 'document_type': 'article', 'news_desk': 'Well', 'section_name': 'Well', 'subsection_name': 'Live', 'byline': {'original': 'By Susan Gubar', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Gubar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03777654-94a8-56e3-ae82-f9ede9d9879e', 'word_count': 899, 'uri': 'nyt://article/03777654-94a8-56e3-ae82-f9ede9d9879e'}, {'abstr