timedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/06/arts/06osirischild/06osirischild-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/06/arts/06osirischild/06osirischild-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/06/arts/06osirischild/06osirischild-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/06/arts/06osirischild/06osirischild-articleLarge.jpg', 'height': 432, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/06/arts/06osirischild/06osirischild-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 432}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/06/arts/06osirischild/06osirischild-jumbo.jpg', 'height': 737, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/06/arts/06osirischild/06osirischild-superJumbo.jpg', 'height': 1473, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Review: ‘The Osiris Child’ Has It All, and Then Some', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Osiris Child: Science Fiction Volume One', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Osiris Child: Science Fiction Volume One (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Abbess, Shane', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'MacPherson, Daniel (1980- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-05T10:00:14+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Andy Webster', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Webster', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/66225c26-1d3d-5d3e-8a40-5518131fc9f2', 'word_count': 248, 'uri': 'nyt://article/66225c26-1d3d-5d3e-8a40-5518131fc9f2'}, {'abstract': 'The former pastry chef of Mr. Holmes Bakehouse in San Francisco has traveled east and brought the cruffins with him.', 'web_url': 'https://www.nytimes.com/2017/10/05/dining/supermoon-bakehouse-ry-stephen.html', 'snippet': 'The former pastry chef of Mr. Holmes Bakehouse in San Francisco has traveled east and brought the cruffins with him.', 'lead_paragraph': 'Doughnuts and especially croissants are what the pastry chef Ry Stephen is baking at Supermoon Bakehouse, his first venture after leaving Mr. Holmes Bakehouse in San Francisco. “It’s what we love doing,” he said in the big open kitchen of his new Lower East Side bakery. The simple storefront has a wall of glass dividing it from the kitchen. Mr. Stephen studied pastry in his native Melbourne, Australia, before burnishing his skills in Paris and San Francisco. Aron Tzimas, also Australian, is his business partner in this venture. The doughnuts, made from brioche dough, ooze creamy fillings and sport jaunty garnishes; the infinitely layered croissants are large, often filled and also festooned with edible decorations. Some come filled with fruit and are baked a second time. Savory croissants — stuffed with smoked salmon and cream cheese with “everything” seasoning on top — are an item that’s beginning to have traction in New York. They also make a version filled with pastrami, mustard and sauerkraut. And the cruffin, made with croissant dough baked in a muffin tin with a custard filling, may become a favorite: Supermoon Bakehouse, 120 Rivington Street (Essex Street), no phone, supermoonbakehouse.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnersuper/11burnersuper-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/11/dining/11burnersuper/11burnersuper-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnersuper/11burnersuper-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnersuper/11burnersuper-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnersuper/11burnersuper-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/11/dining/11burnersuper/11burnersuper-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnersuper/11burnersuper-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At Supermoon Bakehouse, Croissants From the Chef Ry Stephen', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Indulge: Pastry Chef Sets Up  Shop in Manhattan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Stephen, Ry (Chef)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Supermoon Bakehouse (Manhattan, NY, Bakery)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Lower East Side (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Croissants', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Doughnuts', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-10-05T10:00:15+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/34ca8b07-c0ff-5484-9fd8-57cb98baf4c6', 'word_count': 217, 'uri': 'nyt://article/34ca8b07-c0ff-5484-9fd8-57cb98baf4c6'}, {'abstract': 'A visit to the reclusive country reveals the perilous moment we’re in.', 'web_url': 'https://www.nytimes.com/2017/10/05/opinion/sunday/nuclear-north-korea.html', 'snippet': 'A visit to the reclusive country reveals the perilous moment we’re in.', 'lead_paragraph': 'PYONGYANG, North Korea — To fly into North Korea on an old Russian aircraft is to step into an alternate universe, one in which “the Supreme Leader” defeats craven American imperialists, in which triplets are taken from parents to be raised by the state, in which nuclear war is imminent but survivable — and in which there is zero sympathy for American detainees like Otto Warmbier.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/201