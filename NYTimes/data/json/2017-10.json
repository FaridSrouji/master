ks an Identity Crisis', 'kicker': None, 'content_kicker': None, 'print_headline': 'New Tricks Make for a Strange Brew', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beer', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Molson Coors Brewing Company', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-10-05T18:14:23+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'subsection_name': 'Wine, Beer & Cocktails', 'byline': {'original': 'By Brian Kevin', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Kevin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6024599b-0b8f-5f52-87b8-5a7fae30482e', 'word_count': 1173, 'uri': 'nyt://article/6024599b-0b8f-5f52-87b8-5a7fae30482e'}, {'abstract': 'The New York Times received the following statement from Harvey Weinstein responding to allegations about his treatment of women in Hollywood.', 'web_url': 'https://www.nytimes.com/interactive/2017/10/05/us/statement-from-harvey-weinstein.html', 'snippet': 'The New York Times received the following statement from Harvey Weinstein responding to allegations about his treatment of women in Hollywood.', 'lead_paragraph': 'The New York Times received the following statement from Harvey Weinstein responding to allegations about his treatment of women in Hollywood.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/05/nyregion/image-weinstein-statement/image-weinstein-statement-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/05/nyregion/image-weinstein-statement/image-weinstein-statement-thumbStandard.gif', 'thumbnailwidth