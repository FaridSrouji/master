-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/20/world/20afghanistan-1/20afghanistan-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/world/20afghanistan-1/20afghanistan-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Afghan Army Unit Nearly Wiped Out as New Taliban Tactic Takes Toll', 'kicker': None, 'content_kicker': None, 'print_headline': 'New Tactic Decimates An Afghan Army Unit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Afghan National Army', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Afghan National Security Forces', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Kandahar (Afghanistan)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-10-19T08:40:01+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Taimoor Shah and Mujib Mashal', 'person': [{'firstname': 'Taimoor', 'middlename': None, 'lastname': 'Shah', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Mujib', 'middlename': None, 'lastname': 'Mashal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9a83539f-4ee6-5613-93d5-d6bbcb3fc664', 'word_count': 703, 'uri': 'nyt://article/9a83539f-4ee6-5613-93d5-d6bbcb3fc664'}, {'abstract': 'An Oslo building seen as a symbol of social democracy, and damaged in a deadly 2011 car bombing, is to be torn down, with its artworks relocated.', 'web_url': 'https://www.nytimes.com/2017/10/19/arts/oslo-picasso-mural.html', 'snippet': 'An Oslo building seen as a symbol of social democracy, and damaged in a deadly 2011 car bombing, is to be torn down, with its artworks relocated.', 'lead_paragraph': 'OSLO — Walking through Oslo’s government quarter, it’s hard to miss the monumental concrete mural that dominates its central square. The semiabstract depiction of three people on a boat, pulling in a catch under a blazing sun, is on the end of a swooping modernist building known as Y-Block. “The Fishermen” bears the unmistakable lines of the artist who designed it: Pablo Picasso, who created it in 1970, in collaboration with a Norwegian artist, Carl Nesjar. It is one of five murals by the two men in the government complex here.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20OSLO1/20OSLO1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/20/arts/20OSLO1/20OSLO1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20OSLO1/20OSLO1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20OSLO1/20OSLO1-superJumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20OSLO1/20OSLO1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/20/arts/20OSLO1/20OSLO1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/20/arts/20OSLO1/20OSLO1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Picasso Murals Caught Up in Terrorist Attack’s Bitter Legacy', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Breivik, Anders Behring', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Picasso, Pablo', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Nesjar, Carl (1920- 2015)', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-10-19T08:50:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Thomas Rogers', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Rogers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2bf4316a-afdc-5281-98c2-f31202bc3ddb', 'word_count': 1166, 'uri': 'nyt://article/2bf4316a-afdc-5281-98c2-f31202bc3ddb'}, {'abstract': 'A chilling report with echoes of the bureau’s persecution of black activists a half century ago talks of the threat from “black identity extremists.”', 'web_url': 'https://www.nytimes.com/2017/10/19/opinion/columnists/fbi-blacks-civil-rights.html', 'snippet': 'A chilling report with echoes of the bureau’s persecution of black activists a half century ago talks of the t