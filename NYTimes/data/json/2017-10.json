ank': 6, 'major': 'N'}], 'pub_date': '2017-10-08T16:03:22+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Martin and Mark Landler', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Mark', 'middlename': None, 'lastname': 'Landler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1559884c-3d8f-5f33-a2bf-b66c43a04e42', 'word_count': 1587, 'uri': 'nyt://article/1559884c-3d8f-5f33-a2bf-b66c43a04e42'}, {'abstract': 'Bad ideas flourish when they serve the powerful.', 'web_url': 'https://krugman.blogs.nytimes.com/2017/10/08/the-schlock-of-the-new/', 'snippet': 'Bad ideas flourish when they serve the powerful.', 'lead_paragraph': 'I’m still thinking about Kevin Hassett’s appearance at the Tax Policy Center, where he repaid his hosts’ graciousness by gratuitously impugning their integrity. But insults aside, he offered a new analysis of corporate tax incidence – an approach that is novel, innovative, and completely boneheaded. Oh, and it just happens to say what his political masters want to hear.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Schlock Of The New', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Republican Party', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Tax Policy Center', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-10-08T16:41:19+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title'