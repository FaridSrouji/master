': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Weinstein Co', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weinstein, Harvey', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sexual Harassment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-09T20:52:06+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By John Foley', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Foley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c9139644-8fcd-5060-846b-f6b0f857a57b', 'word_count': 384, 'uri': 'nyt://article/c9139644-8fcd-5060-846b-f6b0f857a57b'}, {'abstract': 'Half the profit from Adirondack Creamery’s new date and walnut ice cream will be donated to the International Rescue Committee.', 'web_url': 'https://www.nytimes.com/2017/10/09/dining/syrian-date-walnut-ice-cream.html', 'snippet': 'Half the profit from Adirondack Creamery’s new date and walnut ice cream will be donated to the International Rescue Committee.', 'lead_paragraph': 'The newest flavor of Adirondack Creamery ice cream recalls a pastry popular in Syria called ma’amoul, combining dates and walnuts. Translated into ice cream, it’s a nubbly, lightly sweetened confection with calls for unity plastered on the container. “Peace,” it proclaims in English, Arabic and Hebrew. “We are all immigrants,” it adds, and outlines the plight of Syrian refugees. Fifty percent of the profit from each pint is being donated to the International Rescue Committee’s efforts on their behalf: Adirondack Creamery Syrian Date & Walnut Ice Cream, $5.99 to $7.49 depending on the store; available at Kalustyans, Greene Grape Provisions, Fairway, Gourmet Garage and Fresh Direct.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnericecream/11burnericecream-articleLarge.jpg', 'height': 707, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/11/dining/11burnericecream/11burnericecream-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 707}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnericecream/11burnericecream-jumbo.jpg', 'height': 1024, 'width': 869, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnericecream/11burnericecream-superJumbo.jpg', 'height': 2048, 'width': 1738, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnericecream/11burnericecream-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/11/dining/11burnericecream/11burnericecream-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/dining/11burnericecream/11burnericecream-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ice Cream Inspired by a Syrian Pastry', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Scoop: Ice Cream Inspired By a Syrian Pastry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Adirondack Creamery Inc', 'rank': 1, 'major': 'N'},