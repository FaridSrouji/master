ype': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/13/opinion/13fri3web/13fri3web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/13/opinion/13fri3web/13fri3web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/13/opinion/13fri3web/13fri3web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Congress Shouldn’t Let Mr. Trump Kill Obamacare on His Own', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Mr. Trump’s Obamacare Sabotage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Orders and Memorandums', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-10-12T22:24:07+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Editorials', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/50f1dd6c-0f08-583f-a4c8-5a1351e9c607', 'word_count': 760, 'uri': 'nyt://article/50f1dd6c-0f08-583f-a4c8-5a1351e9c607'}, {'abstract': 'The director discusses a sequence featuring Ben Stiller and Dustin Hoffman.', 'web_url': 'https://www.nytimes.com/2017/10/12/movies/noah-baumbach-interview-meyerowitz-stories.html', 'snippet': 'The director discusses a sequence featuring Ben Stiller and Dustin Hoffman.', 'lead_paragraph': 'A father-son lunch turns into an uncomfortable negotiation in this scene from “The Meyerowitz Stories (New and Selected).” The scene features Ben Stiller as Matthew meeting his dad, Harold (Dustin Hoffman), for lunch, with a secret plan to bring up the business of trying to settle his father’s estate. He brings along an associate, Gabe (Matthew Shear), and Harold doesn’t take the meeting so well. Mr. Baumbach shot the scene at a Brooklyn restaurant, where he and his crew capture much of the scene in a long take. In a recent interview in New York, the director discussed how he chose the location for the scene and what made it a challenge. Below are excerpts from the conversation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Noah Baumbach Narrates a Scene From ‘The Meyerowitz Stories (New and Selected)’', 'kicker': 'Anatomy of a Scene', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baumbach, Noah', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hoffman, Dustin', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Meyerowitz Stories (New and Selected) (Movie)', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-12T22:25:16+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8537695