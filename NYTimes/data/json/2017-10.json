, 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Vegemite, the Beloved Australian Spread, Goes Upmarket', 'kicker': 'The Breakdown', 'content_kicker': None, 'print_headline': 'A Beloved Australian Condiment Goes Upscale, Diverging From Tradition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Condiments', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'vis-multimedia', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-11T07:17:41+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Australia', 'byline': {'original': 'By Adam Baidawi', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Baidawi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/91f163db-4fb7-5444-b2c0-52188f3b18bb', 'word_count': 439, 'uri': 'nyt://article/91f163db-4fb7-5444-b2c0-52188f3b18bb'}, {'abstract': 'Upending centuries of custom matters more than you think.', 'web_url': 'https://www.nytimes.com/2017/10/11/opinion/donald-trump-tradition-disruption.html', 'snippet': 'Upending centuries of custom matters more than you think.', 'lead_paragraph': 'Donald Trump ran for the White House as a change agent hostile to the habits of Washington, the place he nicknamed “the swamp.” It worked. But the customs he continues to upend as president are the scaffolding that supports the otherwise fragile words of our written Constitution. Mr. Trump’s rejection of them is more threatening to both his presidency and our constitutional regime than any technical violation of the law that he has been accused of (at least so far).', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/opinion/11weiner/11weiner-articleLarge.jpg', 'height': 478, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/11/opinion/11weiner/11weiner-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 478}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/opinion/11weiner/11weiner-jumbo.jpg', 'height': 815, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/opinion/11weiner/11weiner-superJumbo.jpg', 'height': 1630, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/opinion/11weiner/11weiner-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/11/opinion/11weiner/11weiner-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/opinion/11weiner/11weiner-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The President’s Self-Destructive Disruption', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The President’s Self-Destructive Disruption', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Trump, Donald J', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Constitution (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-11T07:21:10+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Greg Weiner', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Weiner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9be5735e-a930-5226-8ae8-75d83002b97c', 'word_count': 936, 'uri': 'nyt://article/9be5735e-a930-5226-8ae8-75d83002b97c'}, {'abstract': 'We’re all connected online, but no one’s in charge to prevent abuses.', 'web_url': 'https://www.nytimes.com/2017/10/11/opinion/columnists/russia-fake-news-media.html', 'snippet': 'We’re all connected online, but no one’s in charge to prevent abuses.', 'lead_paragraph': 'There is an abiding dream in the tech world that when all the planet’s people and data are connected it will be a better place. That may prove true. But getting there is turning into a nightmare — a world where billions of people are connected but without sufficient legal structures, security protections or moral muscles among companies and users to handle all these connections without abuse.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/opinion/11friedmanWeb/11friedmanWeb-articleLarge.jpg', 'height': 507, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/11/opinion/11friedmanWeb/11friedmanWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 507}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/11/opinion/11friedmanWeb/11friedmanWeb-jumbo.jpg', 'height': 866, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': N