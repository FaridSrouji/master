articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/19/science/14TB-FISH/13TB-FISH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/19/science/14TB-FISH/13TB-FISH-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/19/science/14TB-FISH/13TB-FISH-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/19/science/14TB-FISH/13TB-FISH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/19/science/14TB-FISH/13TB-FISH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/19/science/14TB-FISH/13TB-FISH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fish Depression Is Not a Joke', 'kicker': 'Trilobites', 'content_kicker': None, 'print_headline': 'Can Fish Get Depressed? Seriously', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Depression (Mental)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fish and Other Marine Life', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ANTIDEPRESSANTS', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-10-16T18:56:56+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Heather Murphy', 'person': [{'firstname': 'Heather', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf302649-d5db-5914-ad8a-c5e82ceefd5f', 'word_count': 880, 'uri': 'nyt://article/bf302649-d5db-5914-ad8a-c5e82ceefd5f'}, {'abstract': 'The comedian on narcissism, fame, his new book on the 12 steps and life after addiction.', 'web_url': 'https://www.nytimes.com/2017/10/16/books/russell-brand-addiction-recovery.html', 'snippet': 'The comedian on narcissism, fame, his new book on the 12 steps and life after addiction.', 'lead_paragraph': 'I am taking a tour of Russell Brand’s body. It’s not the one I might once have imagined, because I am old and he is no longer a sex addict. But we are examining his tattoos. There are many. He does not seem to mind unbuttoning his shirt, covered in galloping stallions, for a stranger. The chakras traveling down his right arm represent “the sexual energy, the energy of the will, the energy of the heart, the energy of communication …” he explained, touching each one lightly. There is the sex-energy kundalini serpent (do you sense a theme here?) on his right index finger. There’s one on his bicep that he and the singer Katy Perry got when they married that says “Go with the flow” in Sanskrit. They couldn’t, but it was a nice thought. My favorite, though, is a quote that Mr. Brand attributed to Oscar Wilde, in loopy script that stretches from Mr. Brand’s shoulder to his wrist: “If you want to tell people the truth, make them laugh. Otherwise they’ll kill you.”', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/23/arts/23BRAND/00brand1-articleLarge.jpg', 'height': 689, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/23/arts/23BRAND/00brand1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 689}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/23/arts/23BRAND/00brand1-jumbo.jpg', 'height': 1024, 'width': 893, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/23/arts/23BRAND/00brand1-superJumbo.jpg', 'height': 2048, 'width': 1785, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/23/arts/23BRAND/00brand1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/23/arts/23BRAND/00brand1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/23/arts/23BRAND/00brand1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Recovery, Russell Brand Style', 'kicker': 'Profile', 'content_kicker': None, 'print_headline': 'Cravings, Conquered', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Brand, Russell', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Addiction (Psychology)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Recovery: Freedom From Our Addictions (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-10-16T19:05:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Judith Newman', 'person': [{'firstname': 'Judith', 'middlename': None, 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8cb9dad5-aa76-5286-ad58-cd015467e21c', 'word_count': 1379, 'uri': 'nyt://article/8cb9dad5-aa76-5286-ad58-cd015467e21c'}, {'abstract': 'The Obamas have chosen Kehinde Wiley and Amy Sherald: one established artist, one on her way.', 'web_url': 'https://www.nytimes.com/2017/10/16/arts/design/obamas-presidential-portraits.html', 'snippet': 'The Obamas have chosen Kehinde Wiley and Amy Sherald: one established artist, one on her way.', 'lead_paragraph': 'Barack and Michelle Obama don’t like to waste an opportunity, in word or action, to make larger points about contemporary life and culture. In that vein, their choices of artists for their official portraits in the collection of the Smithsonian National Portrait Gallery shine a spotlight on the state of American art. One is an established figurative painter, the other is relatively unknown and a possible rising art-world star. Both are African-American.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/17/arts/17PORTRAITSjp1/16PORTRAITS1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/17/arts/17PORTRAITSjp1/16PORTRAITS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/17/arts/17PORTRAITSjp1/16PORTRAITS1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/17/arts/17PORTRAITSjp1/