words': [{'name': 'glocations', 'value': 'Puerto Rico', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Maria (2017)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-10-04T07:07:57+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Mary Williams Walsh and Alan Rappeport', 'person': [{'firstname': 'Mary', 'middlename': 'Williams', 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Alan', 'middlename': None, 'lastname': 'Rappeport', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e2b85810-f68f-5e74-b14f-59a09074c82f', 'word_count': 980, 'uri': 'nyt://article/e2b85810-f68f-5e74-b14f-59a09074c82f'}, {'abstract': 'What good are laws without enforcement? Scott Pruitt wants to stop paying the Justice Department for hazardous waste litigation.', 'web_url': 'https://www.nytimes.com/2017/10/04/opinion/contributors/epa-rule-of-law-pruitt.html', 'snippet': 'What good are laws without enforcement? Scott Pruitt wants to stop paying the Justice Department for hazardous waste litigation.', 'lead_paragraph': 'In the more than seven months since he became administrator of the Environmental Protection Agency, Scott Pruitt has been on a reckless mission to dismantle public health safeguards and environmental protections. Mr. Pruitt’s E.P.A. wants to postpone or roll back dozens of rules that save lives and provide clean air and water, including efforts by the Obama administration to combat climate change and to protect rivers and streams from pollution.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/04/opinion/04uhlmanWeb/04uhlmanWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/04/opinion/04uhlmanWeb/04uhlmanWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/04/opinion/04uhlmanWeb/04uhlmanWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/04/opinion/04uhlmanWeb/04uhlmanWeb-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/04/opinion/04uhlmanWeb/04uhlmanWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/04/opinion/04uhlmanWeb/04uhlmanWeb-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/04/opinion/04uhlmanWeb/04uhlmanWeb-superJumbo.jpg', 'height': 1344, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Undermining the Rule of Law at the E.P.A.', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hazardous and Toxic Substances', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Superfund', 'rank': 2, 'majo