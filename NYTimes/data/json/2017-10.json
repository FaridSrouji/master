ARS-article-art-jumbo-v5.jpg', 'height': 719, 'width': 957, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/08/22/insider/SUGARS-article-art/SUGARS-article-art-superJumbo-v5.jpg', 'height': 719, 'width': 957, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/08/22/insider/SUGARS-article-art/SUGARS-article-art-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/08/22/insider/SUGARS-article-art/SUGARS-article-art-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/08/22/insider/SUGARS-article-art/SUGARS-article-art-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Listen to ‘Dear Sugars’: What Comes After Rock Bottom', 'kicker': 'Dear Sugars', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Strayed, Cheryl', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson, Mitchell S', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-10-21T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Podcasts', 'section_name': 'Podcasts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/ceea7c36-176f-5208-9e40-64a8a373a668', 'word_count': 517, 'uri': 'nyt://article/ceea7c36-176f-5208-9e40-64a8a373a668'}, {'abstract': 'Her mother had bought a diamond ring 15 years ago at a pawnshop. She d