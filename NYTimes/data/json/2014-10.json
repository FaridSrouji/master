-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 381}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/sports/Y-STUART-1/Y-STUART-1-jumbo.jpg', 'height': 651, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/sports/Y-STUART-1/Y-STUART-1-superJumbo.jpg', 'height': 1302, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/sports/Y-STUART-1/Y-STUART-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/15/sports/Y-STUART-1/Y-STUART-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/sports/Y-STUART-1/Y-STUART-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Detroit, the Lions’ Defense Now Does the Heavy Lifting', 'kicker': 'Analysis', 'content_kicker': None, 'print_headline': 'In Detroit, the Lions’ Defense Now Does the Heavy Lifting', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Lions', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ansah, Ezekiel', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Suh, Ndamukong', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Fairley, Nick', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-14T16:10:07+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Cha