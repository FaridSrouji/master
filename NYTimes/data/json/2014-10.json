 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gonzales, Marco (1992- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'St Louis Cardinals', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-16T16:39:03+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By John Branch', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Branch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65b1b889-ffe2-506e-a1cf-e0060ae3c58d', 'word_count': 1307, 'uri': 'nyt://article/65b1b889-ffe2-506e-a1cf-e0060ae3c58d'}, {'abstract': 'Lyndon B. Johnson drew a larger percentage of African-Americans to the polls than anyone else before the Obama era.', 'web_url': 'https://www.nytimes.com/2014/10/17/upshot/black-turnout-in-1964-and-beyond.html', 'snippet': 'Lyndon B. Johnson drew a larger percentage of African-Americans to the polls than anyone else before the Obama era.', 'lead_paragraph': 'The Times has converted all of its 1964 issues into a digitized, searchable format. Each week, The Upshot will unearth an item from 50 years ago and put it in the light of today. “U.S. Negro Voters Put at 5.5 Million” appeared on Oct. 13 and can be seen in its original format on TimesMachine.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/upshot/17UP-Archive-Dive-slide-1/17UP-Archive-Dive-slide-9A9H-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/16/upshot/17UP-Archive-Dive-slide-1/17UP-Archive-Dive-slide-9A9H-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/upshot/17UP-Archive-Dive-slide-1/17UP-Archive-Dive-slide-9A9H-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/upshot/17UP-Archive-Dive-slide-1/17UP-Archive-Dive-slide-9A9H-superJumbo.jpg', 'height': 1370, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/upshot/17UP-Archive-Dive-slide-1/17UP-Archive-Dive-slide-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/16/upshot/17UP-Archive-Dive-slide-1/17UP-Archive-Dive-slide-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/upshot/17UP-Archive-Dive-slide-1/17UP-Archive-Dive-slide-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Black Turnout in 1964, and Beyond', 'kicker': 'Archive Dive', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Voter Registration and Requirements', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Assn for the Advancement of Colored People', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Southern States (US)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-16T16:49:18+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Alan Flippen', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Flippen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd3e0cf7-d322-58d4-9210-42110e380156', 'word_count': 418, 'uri': 'nyt://article/bd3e0cf7-d322-58d4-9210-42110e380156'}, {'abstract': 'Sleep is learning, of a very specific kind. “Sleep Study Skills” can help our teenagers game the system — and get enough sleep.', 'web_url': 'https://parenting.blogs.nytimes.com/2014/10/16/want-to-ace-that-test-get-the-right-kind-of-sleep/', 'snippet': 'Sleep is learning, of a very specific kind. “Sleep Study Skills” can help our teenagers game the system — and get enough sleep.', 'lead_paragraph': 'Sleep. Parents crave it, but children and especially teenagers, need it. When educators and policymakers debate the relationship between sleep schedules and school performance and — given the constraints of buses, sports and everything else that seem so much more important — what they should do about it, they miss an intimate biological fact: Sleep is learning, of a very specific kind. Scientists now argue that a primary purpose of sleep is learning consolidation, separating the signal from the noise and flagging what is most valuable. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/us/motherlode-sleep/motherlode-sleep-articleLarge.png', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/16/us/motherlode-sleep/motherlode-sleep-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/us/motherlode-sleep/motherlode-sleep-jumbo.png', 'height': 467, 'width': 702, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/us/motherlode-sleep/motherlode-sleep-superJumbo.png', 'height': 467, 'width': 702, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/us/motherlode-sleep/motherlode-sleep-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/16/us/motherlode-sleep/motherlode-sleep-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/16/us/motherlode-sleep/motherlode-sleep-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Want to Ace That Test? Get the Right Kind of Sleep', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Brain', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Memory', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sleep', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Tests and Examinations', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-16T16:56:36+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'U.S.', 'byline': {'original': 'By Benedict Carey', 'person': [{'firstname': 'Benedict', 'middlename': None, 'lastname': 'Carey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organizati