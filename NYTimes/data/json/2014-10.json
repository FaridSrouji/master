o': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gardens and Gardening', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Raver, Anne', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Myers, Mary E', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Philadelphia (Pa)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Flowers and Plants', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sustainable Living', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Biodiversity', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-08T22:27:08+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Anne Raver', 'person': [{'firstname': 'Anne', 'middlename': None, 'lastname': 'Raver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fadfe562-2647-55f6-8ce4-d0eca037bfe7', 'word_count': 1672, 'uri': 'nyt://article/fadfe562-2647-55f6-8ce4-d0eca037bfe7'}, {'abstract': 'Stories of casework and efforts to help voters — recounted by the people a politician has helped — can be a candidate’s message of warmth and caring.', 'web_url': 'https://www.nytimes.com/2014/10/09/us/politics/out-of-the-mouths-of-constituents-candidates-find-a-message.html', 'snippet': 'Stories of casework and efforts to help voters — recounted by the people a politician has helped — can be a candidate’s message of warmth and caring.', 'lead_paragraph': 'WASHINGTON — The Iowa Senate candidate Joni Ernst, a Republican, may have produced the most famous anti-spending spot of the cycle when she released a 30-second commercial during her primary race that featured her in a barn among squealing pigs.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spotlighting Constituents to Buoy Congressional Candidates', 'kicker': None, 'cont