eo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gross, Jessica', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Playgrounds', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Monstrum', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nielsen, Ole Barslund', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jensen, Christian', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Parks and Other Recreation Areas', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Copenhagen (Denmark)', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-10-10T14:31:10+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Jessica Gross', 'person': [{'firstname': 'Jessica', 'middlename': None, 'lastname': 'Gross', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be0e5766-44c1-56d9-9a08-4c51d5dc2c7b', 'word_count': 841, 'uri': 'nyt://article/be0e5766-44c1-56d9-9a08-4c51d5dc2c7b'}, {'abstract': 'A child’s room is like a gallery for expressing creativity. (Well, like a gallery with clothes all over the floor.)', 'web_url': 'https://www.nytimes.com/2014/10/12/magazine/photographers-snoop-on-their-kids-bedrooms.html', 'snippet': 'A child’s room is like a gallery for expressing creativity. (Well, like a gallery with clothes all over the floor.)', 'lead_paragraph': 'For this fall’s Key, the mini-magazine about real estate and design, we asked seven photographers to capture their own kids’ rooms, mess and all.', 'print_section': 'MM', 'print_page': '74', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photographers Snoop on Their Kids’ Bedrooms', 'kicker': 'Key', 'content_kicker': None, 'print_headline': 'Focus on the Family', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tedeschi, Bob', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-10T14:31:15+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interviews by Bob Tedeschi', 'person': [{'firstname': 'Interviews', 'middlename': 'Bob', 'lastname': 'Tedeschi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b7c3ff2d-8251-53eb-bde7-817197be095d', 'word_count': 24, 'uri': 'nyt://article/b7c3ff2d-8251-53eb-bde7-817197be095d'}, {'abstract': 'Paying for deletion.', 'web_url': 'https://www.nytimes.com/2014/10/12/magazine/tourist-retractions.html', 'snippet': 'Paying for deletion.', 'lead_paragraph': 'I recently spent several days at a relatively expensive hotel. The place was deplorable and unsanitary, with an unresponsive front desk. I gave it a poor write-up on TripAdvisor.com, the travel website, titling my review “An Overpriced Dung Heap.” The following day, the owner contacted me through the site with an offer to refund almost half the cost of my stay if I would retract my review. I accepted the handsome offer and deleted my post. Who was the most unethical: me (for accepting the bribe), the owner (for offering it) or the site (which enables this chicanery and therefore has untrustworthy reviews)? HOWARD OLARSCH, FLORIDA', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12ethicist/12ethicist-articleLarge-v3.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/12/magazine/12ethicist/12ethicist-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12ethicist/12ethicist-jumbo-v3.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12ethicist/12ethicist-superJumbo-v3.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12ethicist/mag-12Ethicist-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/12/magazine/12ethicist/mag-12Ethicist-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12ethicist/mag-12Ethicist-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tourist Retractions', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tourist Retractions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Klosterman, Chuck', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ethicist, The (Times Column)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'TripAdvisor.com', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hotels and Travel Lodgings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Bribery and Kickbacks', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-10T14:31:20+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Chuck Klosterman', 'person': [{'firstname': 'Chuck', 'middlename': None, 'lastname': 'Klosterman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/8e132475-a6b9-5489-86aa-089864f50521', 'word_count': 494, 'uri': 'nyt://article/8e132475-a6b9-5489-86aa-089864f50521'}, {'abstract': 'Children are seen by all the world’s cultures as a blessing; food is universally recognized as the staff of life. Put them together, however, and you have the stuff of deepest conflict.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2014/10/10/under-cover-the-thinking-behind-our-food-and-kids-issue/', 'snippet': 'Children are seen by all the world’s cultures as a blessing; food is universally recognized as the staff of life. Put them together, however, and you have the stuff of deepest conflict.', 'lead_paragraph': 'Children are seen by all the world’s cultures as a blessing; food is universally recognized as the staff of life. Put them together, however, and you have the stuff of deepest conflict. In this Food Issue, we offer dispatches from the embattled family table, that contested terrain where our children take aim at us, and we at ourselves. Our survey includes photographs of breakfast around the world; an inside account of the Washington fight over the government’s role in school lunch; a look at snacktime, when a bag of candy can make us feel like a child again; and dinner, a.k.a. ground zero, the meal that can bring peace or madness. Consume it all in good health, but please take your dishes to the sink when you’re done.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12cover_type/12cover_type-articleLarge.jpg', 'height': 731, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/12/magazine/12cover_type/12cover_type-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 731}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12cover_type/12cover_type-jumbo.jpg', 'height': 1024, 'width': 841, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12cover_type/12cover_type-superJumbo.jpg', 'height': 2048, 'width': 1682, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12cover_type/12cover_type-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/12/magazine/12cover_type/12cover_type-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/magazine/12cover_type/12cover_type-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Under Cover: The Thinking Behind Our Food and Kids Issue', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-10-10T14:37:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By The Staff', 'person': [], 'organization': 'The Staff'}, 'type_of_material': 'News', '_id': 'nyt://article/251a6b74-542