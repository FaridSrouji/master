', 'url': 'images/2014/10/23/garden/23JPGARDEN9/23JPGARDEN9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/23/garden/23JPGARDEN9/23JPGARDEN9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/23/garden/23JPGARDEN9/23JPGARDEN9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Apple a Day, for 47 Years', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Apple a Day, for 47 Years', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'APPLES', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tortorello, Michael', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Illustrated History of Apples in North America (Book)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bussey, Dan', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Gardens and Gardening', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Biodiversity', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-10-22T22:23:56+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Michael Tortorello', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Tortorello', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/60164976-cddb-5855-a7a6-880249358ab6', 'word_count': 2913, 'uri': 'nyt://article/60164976-cddb-5855-a7a6-880249358ab6'}, {'abstract': 'A vintage adobe in Sonoma is transformed into a haven for wine lovers.', 'web_url': 'https://www.nytimes.com/2014/10/23/garden/ken-fulk-restores-a-historic-house-in-sonoma-for-three-sticks-wines.html', 'snippet': 'A vintage adobe in Sonoma is transformed into a haven for wine lovers.', 'lead_paragraph': 'When Bill and Eva Price of Three Sticks Wines bought the Vallejo-Casteñada Adobe in Sonoma, Calif., two years ago, it was with a delicate mission: to create a company headquarters with multiple functions in a 170-year-old building that is the oldest occupied home in town. They hired Ken Fulk, the San Francisco designer, to do the job, and ended up with three buildings. The original adobe houses the tasting lounge and kitchen, and is where the winery hosts private dinners with guest chefs. A newly built cottage is used as an office, and a new wine storehouse, contains a second tasting area.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/23/garden/23CURR3/23CURR3-articleLarge.jpg', 'height': 451, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/23/garden/23CURR3/23CURR3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 451}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/23/garden/23CURR3/23CURR3-jumbo.jpg', 'height': 769, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/23/garden/23CURR3/23CURR3-superJumbo.jpg', 'height': 1538, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/23/garden/23CURR3/23CURR3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard'