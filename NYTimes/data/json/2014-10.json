e grade-school set and their families.', 'print_section': 'C', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/10/arts/10SIDEKICK2/10SIDEKICK2-articleLarge.jpg', 'height': 451, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/10/arts/10SIDEKICK2/10SIDEKICK2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 451}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/10/arts/10SIDEKICK2/10SIDEKICK2-jumbo.jpg', 'height': 769, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/10/arts/10SIDEKICK2/10SIDEKICK2-superJumbo.jpg', 'height': 1538, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/10/arts/10SIDEKICK2/10SIDEKICK2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/10/arts/10SIDEKICK2/10SIDEKICK2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/10/arts/10SIDEKICK2/10SIDEKICK2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Test in Following Directions', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Test in Following Directions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Trusty Sidekick Theater Co', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name