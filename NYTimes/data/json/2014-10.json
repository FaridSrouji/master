'name': 'glocations', 'value': 'Cape Town (South Africa)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Montauk (NY)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'South Africa', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Switzerland', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-10-31T21:00:27+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/97c813d2-a8c8-5394-8378-0318590e0e42', 'word_count': 196, 'uri': 'nyt://article/97c813d2-a8c8-5394-8378-0318590e0e42'}, {'abstract': 'The regulations will not be in effect because of All Saints Day.', 'web_url': 'https://cityroom.blogs.nytimes.com/2014/10/31/new-york-city-parking-alert-alternate-side-rules-suspended-saturday/', 'snippet': 'The regulations will not be in effect because of All Saints Day.', 'lead_paragraph': 'The regulations will not be in effect because of All Saints Day.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York City Parking Alert: Alternate-Side Rules Suspended Saturday', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': 'New York City Parking Alert: Alternate-Side Rules Suspended Saturday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parking', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-10-31T21:01:17+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/07841f42-107b-577d-8ba3-9e6a32f931cc', 'word_count': 12, 'uri': 'nyt://article/07841f42-107b-577d-8ba3-9e6a32f931cc'}, {'abstract': 'The Martha Graham Dance Company gave a party for the 70th birthday of “Appalachian Spring,” Aaron Copland’s ode to the American dream.', 'web_url': 'https://www.nytimes.com/2014/11/01/arts/martha-graham-studio-celebrates-appalachian-spring.html', 'snippet': 'The Martha Graham Dance Company gave a party for the 70th birthday of “Appalachian Spring,” Aaron Copland’s ode to the American dream.', 'lead_paragraph': 'The Martha Graham Dance Company hosted a birthday on Thursday night, not for a person but for a dance: Graham’s “Appalachian Spring,” which had its premiere on Oct. 30, 1944 at the Library of Congress, was turning 70. The celebration, part of the Graham Deconstructed series at the troupe’s West Village studio, included an illuminating introduction by the artistic director, Janet Eilber; a spirited performance of the work, complete with Isamu Noguchi’s spartan set (or, as Graham called it, his “indication of a set”); and a custom birthday cake by Cute as Cake, a single black-frosted tier topped with a miniature reproduction of the Noguchi design.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/arts/graham/graham-articleLarge.jpg', 'height': 387, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/01/arts/graham/graham-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 387}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/arts/graham/graham-jumbo.jpg', 'height': 661, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/arts/graham/graham-superJumbo.jpg', 'height': 1