sub': None}, 'keywords': [{'name': 'subject', 'value': 'Discrimination', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Nadella, Satya', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Compensation', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-10T14:46:40+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Claire Cain Miller', 'person': [{'firstname': 'Claire', 'middlename': 'Cain', 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f5c55d7-891d-5758-8cc9-a25f2cdfb847', 'word_count': 527, 'uri': 'nyt://article/5f5c55d7-891d-5758-8cc9-a25f2cdfb847'}, {'abstract': 'Highlights from the International Herald Tribune archives: Antwerp is ravaged by German shells in 1914.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/10/10/1914-antwerp-is-left-in-flames/', 'snippet': 'Highlights from the International Herald Tribune archives: Antwerp is ravaged by German shells in 1914.', 'lead_paragraph': 'HANSWEERT (on the Frontier) — I have just arrived from Antwerp. The bombardment continued throughout the whole of yesterday [Oct. 8], increasing tremendously in fury toward five o’clock in the afternoon. Enormous damage was done in the southern quarter of the city, the German shells spreading fire and death over a large area. One of the shells exploded near the cathedral, which, however, has only been slightly damaged so far.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/blogs/11iht-oldoct11-Antwerp/11iht-oldoct11-Antwerp-articleLarge.jpg', 'height': 372, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/11/blogs/11iht-oldoct11-Antwerp/11iht-oldoct11-Antwerp-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 372}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/blogs/11iht-oldoct11-Antwerp/11iht-oldoct11-Antwerp-jumbo.jpg', 'height': 496, 'width': 800, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/blogs/11iht-oldoct11-Antwerp/11iht-oldoct11-Antwerp-superJumbo.jpg', 'height': 496, 'width': 800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/blogs/11iht-oldoct11-Antwerp/11iht-oldoct11-Antwerp-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/11/blogs/11iht-oldoct11-Antwerp/11iht-oldoct11-Antwerp-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/blogs/11iht-oldoct11-Antwerp/11iht-oldoct11-Antwerp-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1914: Antwerp Is Left in Flames', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'ANTWERP (BELGIUM)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Belgium', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-10T14:48:59+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/befc9b60-2e4a-55a0-89ad-60b5ed320e19', 'word_count': 183, 'uri': 'nyt://article/befc9b60-2e4a-55a0-89ad-60b5ed320e19'}, {'abstract': 'Every year, while others are mapping out their jack-o’-lantern carvings or dusting off boxes of Christmas decorations in the attic, we are building a hut for Sukkot.', 'web_url': 'https://parenting.blogs.nytimes.com/2014/10/10/ta-dah-we-built-you-a-hut/', 'snippet': 'Every year, while others are mapping out their jack-o’-lantern carvings or dusting off boxes of Christmas decorations in the attic, we are building a hut for Sukkot.', 'lead_paragraph': 'While others are mapping out their jack-o’-lantern carvings or dusting off boxes of Christmas decorations in the attic, we are building a hut. I dig out my bags of Sukkot decorations, which include the New Year’s card my son made us when he was 7, encased in a Ziploc bag; the sign warning that our prefabricated hut is guarded by a “Dachshund Security System” (now staffed exclusively by an 8-pound, 14-year-old, mostly lame mini doxie); and various laminated paper awards. We were voted “sweetest,” “best decorated,” “most creative” and “most kid-friendly” sukkah on alternating years by a committee of Lilliputian guests racing ahead of their folks as part of our synagogue’s “sukkah hop.” The “hop” consisted of a merry band of congregants who would trek from sukkah to sukkah, crisscrossing the neighborhood and enjoying a different culinary delight in each hut. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/us/motherlode-hut/motherlode-hut-jumbo.jpg', 'height': 640, 'width': 480, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/us/motherlode-hut/motherlode-hut-superJumbo.jpg', 'height': 640, 'width': 480, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/us/motherlode-hut/motherlode-hut-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/09/us/motherlode-hut/motherlode-hut-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/us/motherlode-hut/motherlode-hut-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ta-dah! We Built You a Hut', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jews and Judaism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-10-10T14:50:06+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'U.S.', 'byline': {'original': 'By Risa Doherty', 'person': [{'firstname': 'Risa', 'middlename': None, 'lastname': 'Doherty', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd19f3a8-c742-58dd-8520-c07b6c8665a3', 'word_count': 597, 'uri': 'nyt://article/fd19f3a8-c742-58dd-8520-c07b6c8665a3'}, {'abstract': 'A group of South Korean activists released large balloons on Friday that were filled with pamphlets criticizing the North Korean government.', 'web_url': 'https://www.nytimes.com/2014/10/11/world/asia/koreas-exchange-fire-after-activists-launch-balloons-over-border.html', 'snippet': 'A group of South Korean activists released large balloons on Friday that were filled with pamphlets criticizing the North Korean government.', 'lead_paragraph': 'SEOUL, South Korea — South and North Korea exchanged machine-gun fire across their heavily armed border on Friday, several hours after a group of South Korean activists, including defectors from the Communist North, released dozens of large balloons loaded with leaflets criticizing the Pyongyang government into the North, South Korean officials said.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/world/11koreaborder/11koreaborder-articleLarge.jpg', 'height': 396, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/11/world/11koreaborder/11koreaborder-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 396}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/world/11koreaborder/11koreaborder-jumbo.jpg', 'height': 676, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/world/11koreaborder/11koreaborder-superJumbo.jpg', 'height': 1352, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/11/world/11koreaborder/11koreaborder-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail