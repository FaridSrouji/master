ame': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘The Affair’ Recap: Does Noah Sound Like a  Writer?', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-10-21T03:01:53+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3070d6c5-bb28-5014-97ec-a85aed8f1491', 'word_count': 586, 'uri': 'nyt://article/3070d6c5-bb28-5014-97ec-a85aed8f1491'}, {'abstract': 'As China’s Communist Party meets to discuss the rule of law and the United Nations hears China’s national report on women’s rights, a rights group publishes a report documenting routine physical and sexual abuse of women in unofficial jails.', 'web_url': 'https://sinosphere.blogs.nytimes.com/2014/10/20/rights-group-details-abuse-in-black-jails/', 'snippet': 'As China’s Communist Party meets to discuss the rule of law and the United Nations hears China’s national report on women’s rights, a rights group publishes a report documenting routine physical and sexual abuse of women in unofficial jails.', 'lead_paragraph': 'One night in June last year, Ding Hongfen and about 20 others stormed the Dongjiao Guesthouse in the city of Wuxi in eastern China, breaking down an iron door with crowbars. They freed five people held inside in a “black jail,” an extralegal detention facility operated by the local authorities who regarded the detainees as troublemakers. One of those freed was over age 80, according to the human rights organization that documented the incident.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/blogs/21sino-jail/21sino-jail-articleLarge.jpg', 'height': 597, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/21/blogs/21sino-jail/21sino-jail-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 597}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/blogs/21sino-jail/21sino-jail-jumbo.jpg', 'height': 615, 'width': 618, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/blogs/21sino-jail/21sino-jail-superJumbo.jpg', 'height': 615, 'width': 618, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/blogs/21sino-jail/21sino-jail-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/21/blogs/21sino-jail/21sino-jail-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/blogs/21sino-jail/21sino-jail-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rights Group Details Abuse in ‘Black Jails’', 'kicker': 'Sinosphere', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Abuse of the Disabled', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Guards', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'va