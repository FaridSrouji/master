.jpg', 'height': 688, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/07artsbeat-spider/07artsbeat-spider-superJumbo.jpg', 'height': 1376, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/07artsbeat-spider/07artsbeat-spider-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/08/arts/07artsbeat-spider/07artsbeat-spider-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/07artsbeat-spider/07artsbeat-spider-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hints of a Studio Spat Over Spider-Man', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Spider-Man (Fictional Character)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Marvel Entertainment', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Sony Pictures Entertainment', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-07T19:28:12+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff780d8f-e72b-5e5d-a0ce-8cb85e823e65', 'word_count': 231, 'uri': 'nyt://article/ff780d8f-e72b-5e5d-a0ce-8cb85e823e65'}, {'abstract': 'The world-renowned sushi chef and his longtime architectural collaborator discuss the design elements that they’ve incorporated all over the world.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/10/07/nobu-matsuhisa-david-rockwell-restaurant-architecture/', 'snippet': 'The world-renowned sushi chef and his longtime architectural collaborator discuss the design elements that they’ve incorporated all over the world.', 'lead_paragraph': 'Since opening his first Nobu in TriBeCa in 1994, the chef Nobu Matsuhisa has turned himself into a global empire, with 32 restaurants on five continents and a cluster of hotels in cities such as Las Vegas and Riyadh. Yet across the map, certain design details have become mainstays of the Nobu style: bamboo-terrazzo surfaces, riverbed stone walls, scorched ash wood and other elements inspired by both Matsuhisa’s\xa0far-flung culinary experiences and the Japanese countryside where he grew up. The mastermind behind these touches? The New York architect David Rockwell, who met Matsuhisa in the early ’90s and instantly took an interest in his food and in designing his restaurants. “I think it was the rock shrimp,” Rockwell says with a grin.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/t-magazine/07beddie-nobu/07beddie-nobu-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/07/t-magazine/07beddie-nobu/07beddie-nobu-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/t-magazine/07beddie-nobu/07beddie-nobu-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/t-magazine/07beddie-nobu/07beddie-nobu-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/t-magazine/07beddie-nobu/07beddie-nobu-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/07/t-magazine/07beddie-nobu/07beddie-nobu-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/t-magazine/07beddie-nobu/07beddie-nobu-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nobu Matsuhisa and David Rockwell on the Art of Constructing a Restaurant', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sushi', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Matsuhisa, Nobu', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rockwell, David', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Nobu', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-07T19:30:34+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kari Molvar', 'person': [{'firstname': 'Kari', 'middlename': None, 'lastname': 'Molvar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e79df0b-10f8-56d2-9e10-5f51a4216daf', 'word_count': 1144, 'uri': 'nyt://article/6e79df0b-10f8-56d2-9e10-5f51a4216daf'}, {'abstract': 'Regardless of the size of the role, Marian Seldes, who died Tuesday at 86, made her theatrical performances memorable, with precision and flourish.', 'web_url': 'https://www.nytimes.com/2014/10/08/theater/how-marian-seldes-took-the-stage.html', 'snippet': 'Regardless of the size of the role, Marian Seldes, who died Tuesday at 86, made her theatrical performances memorable, with precision and flourish.', 'lead_paragraph': 'When Marian Seldes served ham, it always tasted like caviar. More than any stage performer of her generation, this enduringly vital actress — who died on Monday at 86, after a life in the theater of more than six decades — made overacting feel like a deeply elegant craft, wrought in carefully carved flourishes and filigree.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/08marian/08marian-articleLarge-v2.jpg', 'height': 413, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/08/arts/08marian/08marian-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 413}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/08marian/08marian-jumbo-v2.jpg', 'height': 705, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/08marian/08marian-superJumbo-v2.jpg', 'height': 936, 'width': 1359, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/08marian/08marian-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/08/arts/08marian/08marian-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/08/arts/08marian/08marian-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Larger-Than-Life Impact on the Stage ', 'kicker': 'An Appraisal', 'content_kicker': None, 'print_headline': 'A Larger-Than-Life Impact on the Stage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Seldes, Marian', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-07T19:46:22+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'An Appraisal', '_id': 'nyt://article/227e09d5-35ee-5e9f-b273-64dc6249124a', 'word_count': 639, 'uri': 'nyt://article/227e09d5-35ee-5e9f-b273-64dc6249124a'}, {'abstract': 'We aren’t the only deficit nation.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/10/07/punished-for-the-dollars-virtue/', 'snippet': 'We aren’t the only deficit nation.', 'lead_paragraph': 'I rarely disagree with Jared Bernstein, and actually agree with most of his latest post. Yes, the persistent US trade deficit is a problem for achieving full employment, and we should have a weak-dollar, not strong-dollar policy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Punished for the Dollar’s Virtue?', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-10-07T19:48:10+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name'