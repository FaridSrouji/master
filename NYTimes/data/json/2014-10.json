: None, 'type': 'image', 'url': 'images/2014/10/15/arts/14SWIFTARTS/14SWIFTARTS-articleLarge.jpg', 'height': 402, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/15/arts/14SWIFTARTS/14SWIFTARTS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 402}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/arts/14SWIFTARTS/14SWIFTARTS-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/arts/14SWIFTARTS/14SWIFTARTS-superJumbo.jpg', 'height': 1371, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/arts/14SWIFTARTS/14SWIFTARTS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/15/arts/14SWIFTARTS/14SWIFTARTS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/arts/14SWIFTARTS/14SWIFTARTS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Taylor Swift’s ‘Out of the Woods’ Lives Up to The Hype, Soaring to No. 1 on iTunes', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'With Much Preparation, Swift’s Single Starts Strongly', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Antonoff, Jack', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Swift, Taylor', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'iTunes', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-14T13:32:18+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe1088a2-3b65-5c07-bfcb-724b6aac0aa4', 'word_count': 345, 'uri': 'nyt://article/fe1088a2-3b65-5c07-bfcb-724b6aac0aa4'}, {'abstract': 'Officials said the strikes had targeted fighters of the Kurdistan Workers’ Party and were in retaliation for an attack against a military base.', 'web_url': 'https://www.nytimes.com/2014/10/15/world/europe/turkey-airstrike-kurds-isis.html', 'snippet': 'Officials said the strikes had targeted fighters of the Kurdistan Workers’ Party and were in retaliation for an attack against a military base.', 'lead_paragraph': 'ISTANBUL — In the face of increasing international pressure, Turkey took decisive military action on Monday — not against the Islamic State militants that Turkey’s Western allies have urged it to fight, but rather against the Kurdish militant group that has been battling the Islamic State.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Turkish Airstrike Hits Kurds, Complicating Fight Against Islamic State', 'kicker': None, 'content_kicker': None, 'print_headline': 'Turkish Airstrike Hits Kurds, Complicating Fight Against Islamic State', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Turkey', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Arango, Tim', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kurds', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Arsu, Sebnem', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': "Kurdistan Workers' Party", 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Union Party (Syria)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Kobani (Syria)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-10-14T13:55:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Tim Arango and Sebnem Arsu', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Arango', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sebnem', 'middlename': None, 'lastname': 'Arsu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d068cf4-ee24-5e7c-ae1e-ce2cd6a01a84', 'word_count': 1044, 'uri': 'nyt://article/9d068cf4-ee24-5e7c-ae1e-ce2cd6a01a84'}, {'abstract': 'An academic whose work helps us understand one of the major puzzles of the contemporary economy: friendly monopolists.', 'web_url': 'https://www.nytimes.com/2014/10/15/upshot/how-jean-tiroles-work-helps-explain-the-internet-economy.html', 'snippet': 'An academic whose work helps us understand one of the major puzzles of the contemporary economy: friendly monopolists.', 'lead_paragraph': 'For anyone who has wondered how it’s possible to get so much stuff from web companies free or at too-good-to-be-true prices — whether Google searching, Facebook socializing, Uber riding or Amazon shopping — Jean Tirole, the new Nobel Prize winner in economics, has an answer.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/upshot/15up-nobel/15up-nobel-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/15/upshot/15up-nobel/15up-nobel-articleLar