/business/02autos-pic1/02autos-pic1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/02/business/02autos-pic1/02autos-pic1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/business/02autos-pic1/02autos-pic1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/business/02autos-pic1/02autos-pic1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/business/02autos-pic1/02autos-pic1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/02/business/02autos-pic1/02autos-pic1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/business/02autos-pic1/02autos-pic1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'G.M. Sales Rebound in September to Increase 19%', 'kicker': None, 'content_kicker': None, 'print_headline': 'G.M. Sales Rebound in September to Increase 19%', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kessler, Aaron M', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'General Motors', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chrysler Group LLC', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Ford Motor Co', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Cadillac Division of General Motors Corp', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Buick Division of General Motors Corp', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Lincoln Motor Co', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Utility Vehicles and Light Trucks', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-10-01T16:41:56+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Aaron M. Kessler', 'person': [{'firstname': 'Aaron', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9dbddd7a-47b2-5513-a125-04835aa9a9bf', 'word_count': 743, 'uri': 'nyt://article/9dbddd7a-47b2-5513-a125-04835aa9a9bf'}, {'abstract': 'During a weekend in the Danish capital, discover art underground, sample dishes from a former Noma chef and unwind in the city’s green spaces.', 'web_url': 'https://www.nytimes.com/2014/10/05/travel/things-to-do-in-36-hours-in-copenhagen.html', 'snippet': 'During a weekend in the Danish capital, discover art underground, sample dishes from a former Noma chef and unwind in the city’s green spaces.', 'lead_paragraph': 'The mystique of Copenhagen is multifaceted, but for many, it begins with food. The Danish capital is the standard-bearer for New Nordic cuisine, a movement sustained by a society that encourages homegrown talent, in this case chefs experimenting with local ingredients. But the well-tuned city, with its network of bike paths and ample green space, supports a wide variety of creative endeavors. All around town, art galleries are surfacing in quirky spaces, such as old butcher shops; independent boutiques are filling up with distinctive Danish wares; and new cocktail bars are mixing drinks with, for example, local craft beer. So even as food trends wax and wane, Copenhagen continues to surprise.', 'print_section': 'TR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '36 Hours in Copenhagen', 'kicker': None, 'content_kicker': None, 'print_headline': '36 Hours in Copenhagen', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Ingrid K', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Copenhagen (Denmark)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Denmark', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-01T16:43:55+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Ingrid K. Williams', 'person': [{'firstname': 'Ingrid', 'middlename': 'K.', 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5a1b8cc9-26ad-5fe8-af5b-e2979cc65888', 'word_count': 1496, 'uri': 'nyt://article/5a1b8cc9-26ad-5fe8-af5b-e2979cc65888'}, {'abstract': 'Her show “Me, My Mouth and I” is to run for seven weeks this fall at the Cherry Lane Theater.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/10/01/joy-behar-solo-show-to-run-off-broadway/', 'snippet': 'Her show “Me, My Mouth and I” is to run for seven weeks this fall at the Cherry Lane Theater.', 'lead_paragraph': 'Joy Behar, a comedian best known as one of the original hosts of ABC’s “The View,” which she departed last year, will perform her new solo show, “Me, My Mouth and I,” for seven weeks this fall at the Cherry Lane Theater, the producers announced on Wednesday. The autobiographical piece covers her childhood in Brooklyn, her work in stand-up and on television sitcoms, and her 16 years on “The View” alongside Barbara Walters, Elisabeth Hasselbeck and others. The production is to begin performances at the West Village theater on Nov. 6 and run through Dec. 21.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-joy/01artsbeat-joy-articleLarge.jpg', 'height': 799, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/02/arts/01artsbeat-joy/01artsbeat-joy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 799}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-joy/01artsbeat-joy-jumbo.jpg', 'height': 1024, 'width': 769, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-joy/01artsbeat-joy-superJumbo.jpg', 'height': 2048, 'width': 1538, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-joy/01artsbeat-joy-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/02/arts/01artsbeat-joy/01artsbeat-joy-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-joy/01artsbeat-joy-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Joy Behar Solo Show to Run Off Broadway', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Joy Behar Solo Show To Run Off Broadway', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater