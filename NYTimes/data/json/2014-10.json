ddlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c8c1b6aa-1e5b-58a0-ae0a-2ce274ce875d', 'word_count': 872, 'uri': 'nyt://article/c8c1b6aa-1e5b-58a0-ae0a-2ce274ce875d'}, {'abstract': 'Ed Gillespie, a Republican running against Senator Mark Warner in Virginia, does not have any television airtime reserved between now and Election Day.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/10/16/virginia-senate-gillespie-ads/', 'snippet': 'Ed Gillespie, a Republican running against Senator Mark Warner in Virginia, does not have any television airtime reserved between now and Election Day.', 'lead_paragraph': 'In a year when most Republican Senate campaigns have been running downhill, Ed Gillespie’s bid to unseat Mark Warner, the Democratic incumbent in Virginia, has been a steep climb.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gillespie to Leave Airtime in Virginia to Others', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Midterm Elections (2014)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gillespie, Ed', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Warner, Mark R', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-16T22:00:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Weisman and Ashley Parker', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Weisman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c61820f-3785-5bed-b663-15219bc88f72', 'word_count': 275, 'uri': 'nyt://article/4c61820f-3785-5bed-b663-15219bc88f72'}, {'abstract': 'Works on view in London this week reimagine the humble smiley face in a variety of ways.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/10/16/frieze-london-smiley-faces/', 'snippet': 'Works on view in London this week reimagine the humble smiley face in a variety of ways.', 'lead_paragraph': 'One of the most emphatically upbeat presentations at the Frieze Art Fair in London this week is the New York gallery Salon 94’s salon-style hanging of several dozen works derived from the most seminal of emoticons: the smiley face. Organized in collaboration with The Smile Face Museum, a pet project of the Maryland collector Mark Sachs founded in 1992 that has been directed by the artist Adrienne Garbini since 2013, these sunny offerings include everything from odes to the quintessential yellow ball by artists like Marilyn Minter, Hanna Liden and Jonathan Horowitz, to Joyce Pensato’s more somber but nonetheless grinning charcoal mouse and John-Mercer Moore’s mottled purple sculpture monumentalizing the ; and ) of the genealogically proximate winky face.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Frieze Turns That Frown Upside Down', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Frieze Art Fair', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Baldessari, John', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Creed, Martin', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Goodman, Marian', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Minter, Marilyn', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Pensato, Joyce', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-10-16T22:00:30+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kevin McGarry', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'McGarry', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ced37fc7-4eae-512c-a29e-62f169b88605', 'word_count': 270, 'uri': 'nyt://article/ced37fc7-4eae-512c-a29e-62f169b88605'}, {'abstract': 'The filmmaker’s latest documentary, “My Voice, My Life,” looks at Hong Kong youth through the eyes of high school students working to stage a musical. She shares her thoughts on identity and the protest movement.', 'web_url': 'https://sinosphere.blogs.nytimes.com/2014/10/16/q-and-a-ruby-yang-on-hong-kong-youth-and-identity/', 'snippet': 'The filmmaker’s latest documentary, “My Voice, My Life,” looks at Hong Kong youth through the eyes of high school students working to stage a musical. She shares her thoughts on identity and the protest movement.', 'lead_paragraph': 'One evening in March 2007, the United States ambassador to China, Clark T. Randt Jr., hosted a dinner at his Beijing residence for Xi Jinping, who was then the Communist Party chief of Zhejiang Province, in which the two discussed, among other things, the merits of various films and filmmakers.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/15/world/15sino-RUBY2/15sino-RUBY2-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/15/world/15sino-RUBY2/15sino-RUBY2-articleLarge.jpg', 'xlargewidth': 600, 'xlar