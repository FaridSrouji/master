nt_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'German Police Seize Heroin Worth $63 Million', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Germany: Police Seize Heroin Worth $63 Million', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Heroin', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Search and Seizure', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-09T15:48:06+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Alison Smale', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Smale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d9f88612-ce82-5981-b480-c647154cba40', 'word_count': 151, 'uri': 'nyt://article/d9f88612-ce82-5981-b480-c647154cba40'}, {'abstract': 'A new Gallup survey suggests that voters may turn out in lower numbers for the Nov. 4 midterm elections than they did for the last two midterms.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/10/09/voters-are-tuning-out-the-midterms-gallup-says/', 'snippet': 'A new Gallup survey suggests that voters may turn out in lower numbers for the Nov. 4 midterm elections than they did for the last two midterms.', 'lead_paragraph': 'A new Gallup survey suggests that voters may turn out in lower numbers for the Nov. 4 midterm elections than they did for the last two midterms. It also shows that Republican voters are significantly more enthusiastic about voting than Democrats are, affirming fears among Democratic strategists that President Obama’s low approval ratings might keep their partisans away from the polls.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Voters Are Tuning Out the Midterms, Gallup Says', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-10-09T15:48:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By David S. Joachim', 'person': [{'firstname': 'David', 'middlename': 'S.', 'lastname': 'Joachim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e305f5d0-07b9-528b-adf5-f1cf4ff85f06', 'word_count': 188, 'uri': 'nyt://article/e305f5d0-07b9-528b-adf5-f1cf4ff85f06'}, {'abstract': 'Critics want a war memorial to remove a sculpture based on Alfred Eisenstaedt’s famous Life Magazine photo of a sailor kissing a nurse at the end of World War II.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/10/09/an-outcry-in-france-over-a-statues-kiss/', 'snippet': 'Critics want a war memorial to remove a sculpture based on Alfred Eisenstaedt’s famous Life Magazine photo of a sailor kissing a nurse at the end of World War II.', 'lead_paragraph': 'A 13-ton statue of a sailor kissing a nurse is provoking a debate about sexual aggression in France where the image is on loan for a year at a memorial site in Normandy. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/10/arts/09artsbeat-kiss/09artsbeat-kiss-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/10/arts/09artsbeat-kiss/09artsbeat-kiss-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/10/arts/09artsbeat-kiss/09artsb