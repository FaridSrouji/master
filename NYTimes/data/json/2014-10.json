/2014/10/30/us/politics/30firstdraft-christie/30firstdraft-christie-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/30/us/politics/30firstdraft-christie/30firstdraft-christie-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/30/us/politics/30firstdraft-christie/30firstdraft-christie-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/30/us/politics/30firstdraft-christie/30firstdraft-christie-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/30/us/politics/30firstdraft-christie/30firstdraft-christie-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/30/us/politics/30firstdraft-christie/30firstdraft-christie-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '19 States in 5 Days, to Stump for Other Governors', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Governors Assn', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-10-30T15:45:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nick Corasaniti', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Corasaniti', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d682f81-0f6d-5e42-b312-d026d016006e', 'word_count': 148, 'uri': 'nyt://article/9d682f81-0f6d-5e42-b312-d026d016006e'}, {'abstract': 'This animated vampire tale is based on an original 18th-century written account from the Balkans.', 'web_url': 'https://www.nytimes.com/2014/10/30/opinion/first-bite.html', 'snippet': 'This animated vampire tale is based on an original 18th-century written account from the Balkans.', 'lead_paragraph': 'For me, Halloween has one prevailing icon: the vampire. We’ve got child vampires, sexy vampires, modern vampires, classic vampires. Long fascinated by Halloween traditions, I found myself wondering about the origins of our classic image of the vampire, with his capes and fangs and ivory skin. After a bit of research, I came to the obvious conclusion that much of what we think of as a vampire comes from Bram Stoker and the Gothic literature that influenced his masterpiece Dracula. But what about the first vampires? Who were they?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘First Bite’', 'kicker': 'Op-Docs', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Halloween', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vampires', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-10-30T15:45:37+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Drew Christie', 'person': [{'firstname': 'Drew', 'middlename': None, 'lastname': 'Christie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/74c7cf7d-330c-57e3-9038-1137afa0fcc4', 'word_count': 321, 'uri': 'nyt://article/74c7cf7d-330c-57e3-9038-1137afa0fcc4'}, {'abstract': '“Bob and Roberta Smith: Art Amnesty,” at MoMA PS1, invites artists to pledge to stop making art and to deposit their work there, raising intriguing questions about how artists and art are valued.', 'web_url': 'https://www.nytimes.com/2014/10/31/arts/design/bob-and-roberta-smith-art-amnesty-at-moma-ps1.html', 'snippet': '“Bob and Roberta Smith: Art Amnesty,” at MoMA PS1, invites artists to pledge to stop making art and to deposit their work there, raising intriguing questions about how artists and art are valued.', 'lead_paragraph': 'In the outdoor courtyard at MoMA PS1 stands a quartet of trash-hauling bins, each emblazoned with a word spelled in big block letters. Together, they direct visitors, “Throw your art away.” As of Thursday, a few people had accepted this invitation. Except for a slim pile of nondescript drawings in one, a small amateurish painting on canvas and some ordinary garbage, the bins were empty. But they could eventually be filled, as they will remain in place for another four months as part of “Art Amnesty,” an offbeat exhibition conceived by Bob and Roberta Smith. ', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Disposable Commodity, Indeed', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'A Disposable Commodity, Indeed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'MoMA PS1', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brill, Patrick (Bob and Roberta Smith)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-30T15:48:26+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported'