 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e301b977-d429-5457-8ce3-e7f5d699c416', 'word_count': 754, 'uri': 'nyt://article/e301b977-d429-5457-8ce3-e7f5d699c416'}, {'abstract': 'General Motors is concerned that the so-called valet mode offered in the new Corvette Stingray may run afoul of eavesdropping laws in some states.', 'web_url': 'https://www.nytimes.com/2014/10/12/automobiles/is-it-legal-for-corvette-to-eavesdrop.html', 'snippet': 'General Motors is concerned that the so-called valet mode offered in the new Corvette Stingray may run afoul of eavesdropping laws in some states.', 'lead_paragraph': 'General Motors may have to take the sting out of its new Stingray. The 2015 Corvette offers a personal video recording option that lets owners surreptitiously record video and audio when the car is in the hands of other drivers — like parking attendants. But now the automaker is concerned that the so-called valet mode may run afoul of eavesdropping laws in some states.', 'print_section': 'AU', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is It Legal for Corvette to Eavesdrop?', 'kicker': 'Technology', 'content_kicker': None, 'print_headline': 'Is It Legal for Corvette to Eavesdrop?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Chevrolet Division of General Motors Corp', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wiretapping and Other Eavesdropping Devices and Methods', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parking Garages and Lots', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'General Motors', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-10T23:08:09+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'byline': {'original': 'By John R. Quain', 'person': [{'firstname': 'John', 'middle