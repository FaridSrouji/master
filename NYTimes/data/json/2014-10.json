ker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Horns (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-10-31T16:47:57+0000', 'document_type': 'multimedia', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'Robin Lindsay', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Lindsay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/793025eb-d888-5ddb-b72f-538fd6282cf3', 'word_count': 0, 'uri': 'nyt://video/793025eb-d888-5ddb-b72f-538fd6282cf3'}, {'abstract': 'From the International Herald Tribune archives: A hospital ship sank in 1914.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/10/31/1914-hospital-ship-lost-off-coast/', 'snippet': 'From the International Herald Tribune archives: A hospital ship sank in 1914.', 'lead_paragraph': 'LONDON — In a terrific gale on the north-east coast this morning, the British hospital-ship Rohilla, bound for Belgium, ran on the rocks at Whitby and became a total wreck. The Rohilla had on board a staff of doctors and nurses who had just set out on their errand of mercy, together with a large crew. The seas were so heavy that the ship’s boats were smashed immediately after being lowered. Some persons aboard were rescued by lifeboats but eighty are still on the wreck, according to the latest news received to-day, enormous seas preventing their rescue. Several bodies have been washed ashore. A telegram received early this morning says: ‘‘The Whitby boat is disabled and the Scarborough lifeboat, in tow of a tug, is unable to approach sufficiently near to effect a rescue. Now late at night the middle of the vessel is the only portion remaining, the stem and stern having both parted. Those crowded in the dismembered portion appear to be doomed, for, so far as can be seen, no human aid can be extended to them.’’ — The New York Herald, European Edition, Nov. 1, 1914', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1914: Hospital-Ship Lost Off Coast', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ships and Shipping', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Weather', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-31T16:49:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/49fdadb2-df6d-5b65-81a4-8c29336855cf', 'word_count': 190, 'uri': 'nyt://article/49fdadb2-df6d-5b65-81a4-8c29336855cf'}, {'abstract': 'Senator Mitch McConnell is laying the groundwork for Republican messaging against Hillary Clinton.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/10/31/mcconnell-campaigns-with-an-eye-on-clinton/', 'snippet': 'Senator Mitch McConnell is laying the groundwork for Republican messaging against Hillary Clinton.', 'lead_paragraph': 'As Senator Mitch McConnell runs for re-election against the specter of Barack Obama, he is also laying the groundwork for Republican messaging against Hillary Rodham Clinton.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'McConnell Campaigns With an Eye on Clinton', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub