persons', 'value': 'Zernike, Kate', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ebola Virus', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hickox, Kaci', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Doctors Without Borders', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'LePage, Paul R', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Maine', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-10-30T14:13:19+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jess Bidgood and Kate Zernike', 'person': [{'firstname': 'Jess', 'middlename': None, 'lastname': 'Bidgood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Kate', 'middlename': None, 'lastname': 'Zernike', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b77926c-17d6-52c6-8e0a-05d6b1b00939', 'word_count': 1298, 'uri': 'nyt://article/5b77926c-17d6-52c6-8e0a-05d6b1b00939'}, {'abstract': 'The disappointing news in the G.D.P. report is that growth was not more robust in the sectors most likely to consistently drive future expansion.', 'web_url': 'https://www.nytimes.com/2014/10/31/upshot/it-was-a-good-summer-for-the-economy-but-the-future-looks-less-bright.html', 'snippet': 'The disappointing news in the G.D.P. report is that growth was not more robust in the sectors most likely to consistently drive future expansion.', 'lead_paragraph': 'It was quite a strong summer for the American economy. The question now is how it will hold up over the months ahead.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'It Was a Good Summer for the Economy, but the Future Looks Less Bright', 'kicker': 'Prospects for Growth', 'content_kicker': None, 'print_headline': '