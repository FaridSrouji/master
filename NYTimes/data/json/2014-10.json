ON/22MONSON-1413916460144-articleLarge.jpg', 'height': 409, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/22/arts/22MONSON/22MONSON-1413916460144-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 409}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/22MONSON/22MONSON-1413916460144-jumbo.jpg', 'height': 698, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/22MONSON/22MONSON-1413916460144-superJumbo.jpg', 'height': 1397, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/22MONSON/22MONSON-1413916460144-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/22/arts/22MONSON/22MONSON-1413916460144-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/22MONSON/22MONSON-1413916460144-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bringing Nature Inside With Space and Light', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Bringing Nature Inside With Space and Light', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Monson, Jennifer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Tenenbaum, Tatyana', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Niall', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-22T02:21:59+0000', 