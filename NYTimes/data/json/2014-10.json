, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Vijai', 'middlename': None, 'lastname': 'Singh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Katie', 'middlename': 'Hayes', 'lastname': 'Luke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/13aff4eb-babb-5dd3-9f2b-9d6c19eb02bd', 'word_count': 0, 'uri': 'nyt://video/13aff4eb-babb-5dd3-9f2b-9d6c19eb02bd'}, {'abstract': 'Rear Adm. Timothy Ziemer, head of the strikingly successful President’s Malaria Initiative, has been quietly fighting the disease, cutting yearly malaria deaths to about 600,000 from one million.', 'web_url': 'https://www.nytimes.com/audio/2014/10/21/science/21scitimes-podcast-ziemer.html', 'snippet': 'Rear Adm. Timothy Ziemer, head of the strikingly successful President’s Malaria Initiative, has been quietly fighting the disease, cutting yearly malaria deaths to about 600,000 from one million.', 'lead_paragraph': 'Rear Adm. Timothy Ziemer, head of the strikingly successful President’s Malaria Initiative, has been quietly fighting the disease, cutting yearly malaria deaths to about 600,000 from one million.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Man Against Malaria', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Malaria', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-10-20T20:27:38+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Science', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/2df3d815-0a20-5b70-8379-a76a6e5798a5', 'word_count': 0, 'uri': 'nyt://audio/2df3d815-0a20-5b70-8379-a76a6e5798a5'}, {'abstract': 'The current issue of Visionaire is devoted to works by John Baldessari with celebrity self-portraits providing the raw material.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/10/20/celebrity-selfies-as-art-via-john-baldessari/', 'snippet': 'The current issue of Visionaire is devoted to works by John Baldessari with celebrity self-portraits providing the raw material.', 'lead_paragraph': 'Less than a year has elapsed since Oxford Dictionaries declared “selfie” its word of the year for 2013, and though many people regarded selfies as an art form long before that the time has clearly come for formal recognition. Visionaire, a publisher that produces pricey limited editions (which it calls issues), is devoting its current issue, Visionaire 64, to works by the conceptual artist John Baldessari, who has used celebrity self-portraits provided for the project as his raw material.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/arts4-1413922918800-web/arts4-1413922918800-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/22/arts/arts4-1413922918800-web/arts4-1413922918800-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/arts4-1413922918800-web/arts4-1413922918800-jumbo.jpg', 'height': 694, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/arts4-1413922918800-web/arts4-1413922918800-superJumbo.jpg', 'height': 1388, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/arts/arts4-1413922918800-web/arts4-1413922918