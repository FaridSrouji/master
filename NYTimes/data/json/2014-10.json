': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-01T15:49:18+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Chris Buckley and Alan Wong', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Buckley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Alan', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31fa3303-9b04-5b0d-8265-bc79e66d50f8', 'word_count': 1329, 'uri': 'nyt://article/31fa3303-9b04-5b0d-8265-bc79e66d50f8'}, {'abstract': 'The new Indonesian Parliament opened on Wednesday, under the control of political forces seeking to limit democracy and thwart the president-elect, Joko Widodo.', 'web_url': 'https://www.nytimes.com/2014/10/02/world/asia/indonesia-joko-widodo-parliament-opposition.html', 'snippet': 'The new Indonesian Parliament opened on Wednesday, under the control of political forces seeking to limit democracy and thwart the president-elect, Joko Widodo.', 'lead_paragraph': 'JAKARTA, Indonesia — The Indonesian Parliament, under the control of emboldened political forces opposed to President-elect Joko Widodo, convened for a new five-year term on Wednesday, setting the stage for a long-term battle over the future of democracy in Southeast Asia’s most populous country.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/world/02indonesia/02indonesia-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'ar