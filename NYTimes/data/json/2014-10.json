rJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/blow-circular/blow-circular-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-thumbLarge-v8.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Ebola Hysteria', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ebola Virus', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Epidemics', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hickox, Kaci', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Humanitarian Aid', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-10-30T00:22:26+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Charles M. Blow', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9d27d543-c6fc-5516-bf2e-b40391aa009e', 'word_count': 964, 'uri': 'nyt://article/9d27d543-c6fc-5516-bf2e-b40391aa009e'}, {'abstract': 'The authorities said they were investigating an allegation that the army kept a database of email addresses for people seeking a peace deal with the country’s main guerrilla group.', 'web_url': 'https://www.nytimes.com/2014/10/30/world/americas/colombia-army-database-raises-concern-about-possible-spying.html', 'snippet': 'The authorities said they were investigating an allegation that the army kept a database of email addresses for people seeking a peace deal with the country’s main guerrilla group.', 'lead_paragraph': ' The authorities said this week that they were investigating an allegation that the army’s Center for Military Intelligence kept a database of email addresses for legislators, journalists, diplomats and government negotiators seeking a peace deal with the country’s main guerrilla group, among others. The existence of the list, first reported by the newsweekly Semana, raised the possibility that the military might have sought to spy on the emails of some of those included. The magazine said the list was created in October 2012, around the time the negotiations with the guerrillas, the Revolutionary Armed Forces of Colombia, were starting. The list included the email address of a New York Times reporter who previously covered Colombia, according to the magazine. The army and the national prosecutor said they were investigating. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Colombia: Army Database Raises Concern About Possible Spying', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Colombia: Army Database Raises Concern About Possible Spying', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Colombia', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Revolutionary Armed Forces of Colombia', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-30T00:26:32+0000', 'document_type': 'article', 'news_