mbLarge', 'legacy': {}}], 'headline': {'main': 'Republicans’ Big Bet on North Carolina Senate Race', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Midterm Elections (2014)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hagan, Kay R', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Tillis, Thomas R', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Republican Senatorial Committee', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-14T16:52:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Parker', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fbd93d9b-9e85-5f39-b975-4085229dbc13', 'word_count': 166, 'uri': 'nyt://article/fbd93d9b-9e85-5f39-b975-4085229dbc13'}, {'abstract': 'Some of it is OK.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/10/14/the-state-of-macro-six-years-later/', 'snippet': 'Some of it is OK.', 'lead_paragraph': 'Olivier Blanchard has gotten a lot of ribbing, from me among others, for his 2008 paper proclaiming that “the state of macro is good.” My critique was that Olivier was in a state of denial about the Dark Age of macroeconomics; when crisis struck and action became necessary, it became all too clear that freshwater macro had unlearned everything Keynes and Hicks had taught – and also that the desperate New Keynesian attempt to appease the rational expectations crowd had not only failed in that purpose, but arguably hobbled efforts to think clearly about anything that didn’t fit easily into a model where everything except price stickiness reflected maximization..', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The State of Macro, Six Years Later', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-10-14T16:55:08+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24973c95-661b-5a78-b5ee-c7a17a99a238', 'word_count': 500, 'uri': 'nyt://article/24973c95-661b-5a78-b5ee-c7a17a99a238'}, {'abstract': 'Dr. Bruce Aylward, the World Health Organization’s assistant director general, said the number of Ebola cases worldwide will rise above 9,000 this week.', 'web_url': 'https://www.nytimes.com/video/world/100000003175185/who-update-on-ebola-epidemic.html', 'snippet': 'Dr. Bruce Aylward, the World Health Organization’s assistant director general, said the number of Ebola cases worldwide will rise above 9,000 this week.', 'lead_paragraph': 'Dr. Bruce Aylward, the World Health Organization’s assistant director general, said the number of Ebola cases worldwide will rise above 9,000 this week.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/14/multimedia/who-ebola-numbers/who-ebola-numbers-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/14/multimedia/who-ebola-numbers/who-ebola-numbers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/14/multimedia/who-ebola-numbers/who-ebola-numbers-jumb