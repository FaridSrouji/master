6, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/18/arts/SUNBLABYRINTH/SUNBLABYRINTH-superJumbo.jpg', 'height': 1752, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/18/arts/SUNBLABYRINTH/SUNBLABYRINTH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/18/arts/SUNBLABYRINTH/SUNBLABYRINTH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/18/arts/SUNBLABYRINTH/SUNBLABYRINTH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Detour While the Rockettes Waited ', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'A Detour While the Rockettes Waited', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Labryinth (Play)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Dendy, Mark', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'ABRONS ARTS CENTER', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-17T21:56:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Alexis Soloski', 'person': [{'firstname': 'Alexis', 'middlename': None, 'lastname': 'Soloski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/833d68b5-7393-55bc-a945-fea99eb7a178', 'word_count': 402, 'uri': 'nyt://article/833d68b5-7393-55bc-a945-fea99eb7a178'}, {'abstract': 'Our 10th anniversary issue gathers fascinating figures from fashion, entertainment, art and design.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/10/17/inside-the-t-at-10-issue/', 'snippet': 'Our 10th anniversary issue gathers fascinating figures from fashion, entertainment, art and design.', 'lead_paragraph': 'For T’s 10th anniversary, we’ve gathered some of the most fascinating figures from fashion, entertainment, art and design, all between the covers of one issue. (And speaking of covers: We’ve got 10 of them!) We start by traveling to two very different locales: Tangier, where we visit Yves Saint Laurent’s stunning final home, Villa Mabrouka; and Shanghai, where we stroll the Bund — and take a few selfies — with the wisecracking designer Michael Kors. Next, we look at a pair of celebrities on different ends of the career spectrum: the newly minted megastar actor Channing Tatum, who makes time in his busy schedule to indulge his secret passion, sculpture; and the rock icon Stevie Nicks, who doles out wisdom (and some moon pendants) to the rising girl band Haim at her home in Los Angeles. And in two of our most ambitious stories of the past decade, we worked with 15 renowned artists and 15 famous authors. We asked the artists (Barbara Kruger, Francesco Vezzoli and others) to get creative in the form of self-promotional advertisements, and the authors (Zadie Smith, James Patterson and others) to pool their talents for a collaborative original story. Elsewhere, Richard Rodriguez pens an essay on what it means to be naked in the digital age; Tim Wu investigates the roots of modern-day mindfulness practices in California wine country; and Gideon Lewis-Kraus travels to the remote Italian island of Stromboli to check out one of art’s oddest — and most volcanic — residencies. See all stories from the issue >>', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/17/t-magazine/17covers/17covers-articleLarge.jpg', 'height': 359, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/17/t-magazine/17covers/17covers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 359}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/17/t-magazine/17covers/17covers-jumbo.jpg', 'height': 612, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/17/t-magazine/17covers/17covers-superJumbo.jpg', 'height': 1225, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/17/t-magazine/17covers/17covers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/17/t-magazine/17covers/17covers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/17/t-magazine/17covers/17covers-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the T@10 Issue', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kors, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kruger, Barbara', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nicks, Stevie', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Richard', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Zadie', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Tatum, Channing', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Vezzoli, Francesco', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Haim (Music Group)', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Yves Saint Laurent', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Shanghai (China)', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Tangier (Morocco)', 'rank': 12, 'major': 'N'}], 'pub_date': '2014-10-17T22:00:03+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e51f9e58-faeb-5cf8-ba07-5d5ddf8c26ae', 'word_count': 257, 'uri': 'nyt://article/e51f9e58-faeb-5cf8-ba07-5d5ddf8c26ae'}, {'abstract': 'A national study says more than 90 percent of female restaurant workers had experienced sexual harassment, an indictment of an economic structure that turns customers into shadow employers, leaving servers vulnerable.', 'web_url': 'https://www.nytimes.com/2014/10/19/nyregion/when-living-on-tips-means-putting-up-with-harassment.html', 'snippet': 'A national study says more than 90 percent of female restaurant workers had experienced sexual harassment, an indictment of an economic structure that turns customers into shadow employers, leaving servers vulnerable.', 'lead_paragraph': 'Two decades ago it wasn’t terribly hard to have a laugh over the kind of body-cult feminism typified by Eve Ensler, the creator of the “Vagina Monologues” franchise, which could seem so narrow and self-absorbed. Yet now, in the era of Sheryl Sandberg-styled corporate-conference feminism and leaning in — an option you don’t get to exercise in a kitchen at a Taco Bell, where you will only lean closer to the grill — it is easy to feel nostalgic for a time when a prominent face of the women’s movement could emerge from the fringe world of downtown Manhattan theater, rather than the neutered boardrooms of Silicon Valley.', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/19/nyregion/19BIG/19BIG-articleLarge.jpg', 'height': 281, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/19/nyregion/19BIG/19BIG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 281}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/19/nyregion/19BIG/19BIG-jumbo.jpg', 'height': 480, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/19/nyregion/19BIG/19BIG-superJumbo.jpg', 'height': 961, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/19/nyregion/19BIG/19BIG-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/19/nyregion/19BIG/19BIG-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/19/nyregion/19BIG/19BIG-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Living on Tips Means Putting Up With Harassment ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Where a Tip Can Beget Harassment', 'name': None, 'seo': None, 'sub': None}, 