N'}, {'name': 'persons', 'value': 'da Fonseca-Wollheim, Corinna', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Chamber Music Conference and Composers' Forum of the East", 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Bennington College', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-03T18:58:47+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/774968cf-1f26-5510-b9ad-2e90c398b96b', 'word_count': 1483, 'uri': 'nyt://article/774968cf-1f26-5510-b9ad-2e90c398b96b'}, {'abstract': '“Two Days, One Night,” the new film from the Dardenne brothers, follows a woman who must ask her co-workers to sacrifice their bonuses for her.', 'web_url': 'https://www.nytimes.com/2014/10/05/movies/the-dardennes-explore-their-theme-in-two-days-one-night.html', 'snippet': '“Two Days, One Night,” the new film from the Dardenne brothers, follows a woman who must ask her co-workers to sacrifice their bonuses for her.', 'lead_paragraph': 'Telluride, Colo. — Wage stagnation, income inequality, the living wage, the decline of the middle class: These issues may be pushed out of the headlines by more dramatic crises, but they continue to preoccupy political discourse, especially in the United States and Europe. At the movies, economic injustice is occasionally grist for allegory — as in Bong Joon-Ho’s “Snowpiercer,” the action-movie sleeper of the summer — and more frequently an axiom of realism. And for the past 15 years or so, cinematic realism has been virtually synonymous with the name Dardenne, as in Jean-Pierre and Luc, Belgian brothers, now 63 and 60, who have twice won the Palme d’Or in Cannes.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/arts/05CROSSCUTS1/05CROSSCUTS1-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/05/arts/05CROSSCUTS1/05CROSSCUTS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/arts/05CROSSCUTS1/05CROSSCUTS1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/arts/05CROSSCUTS1/05CROSSCUTS1-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/arts/05CROSSCUTS1/05CROSSCUTS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/05/arts/05CROSSCUTS1/05CROSSCUTS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/arts/05CROSSCUTS1/05CROSSCUTS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Specializing in Ordinary Ordeals', 'kicker': 'Cross Cuts', 'content_kicker': None, 'print_headline': 'Specializing in Ordinary Ordeals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dardenne, Luc', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Dardenne, Jean-Pierre', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Two Days, One Night (Movie)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-03T18:59:04+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cc78d376-f17f-5b85-a0da-a9182361eb33', 'word_count': 1869, 'uri': 'nyt://article/cc78d376-f17f-5b85-a0da-a9182361eb33'}, {'abstract': 'Aja Naomi King recounts how she landed the role of a law student in ABC’s “How to Get Away With Murder.”', 'web_url': 'https://www.nytimes.com/2014/10/05/arts/television/aja-naomi-king-on-how-to-get-away-with-murder.html', 'snippet': 'Aja Naomi King recounts how she landed the role of a law student in ABC’s “How to Get Away With Murder.”', 'lead_paragraph': '“I wanna be her,” Michaela Pratt, a young law student, utters in admiration when her professor, Annalise Keating, defends a client on an attempted murder rap — and, in a maneuver of brazen audacity, wins. ', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/28/arts/28SNAPSHOT/28SNAPSHOT-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/28/arts/28SNAPSHOT/28SNAPSHOT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/28/arts/28SNAPSHOT/28SNAPSHOT-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', '