': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/27/sports/PLAYOFF1/PLAYOFF1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 488}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/sports/PLAYOFF1/PLAYOFF1-jumbo.jpg', 'height': 832, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/sports/PLAYOFF1/PLAYOFF1-superJumbo.jpg', 'height': 1664, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/sports/PLAYOFF1/PLAYOFF1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/27/sports/PLAYOFF1/PLAYOFF1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/sports/PLAYOFF1/PLAYOFF1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Providing a Peek at What Matters in a New Era of Rankings', 'kicker': None, 'content_kicker': None, 'print_headline': 'Providing a Peek at What Matters in a New Era of Rankings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tracy, Marc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football (College)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bowl Championship Series', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Long, Jeff', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Bowl Games', 'rank': 6, 'major': 'N'}],