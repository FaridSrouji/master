e2c69311', 'word_count': 583, 'uri': 'nyt://article/9512f2a1-a83e-5fe2-ae9d-4925e2c69311'}, {'abstract': 'In this video, the writer and director of “Nightcrawler” discusses a sequence.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/10/30/dan-gilroy-narrates-a-scene-from-nightcrawler/', 'snippet': 'In this video, the writer and director of “Nightcrawler” discusses a sequence.', 'lead_paragraph': 'In “Nightcrawler,” Jake Gyllenhaal plays Lou Bloom, an ambitious man who dives into a lurid job shooting video of crime scenes and selling them to a local television news station. The writer and director Dan Gilroy discusses in this video a scene where Lou talks about his work and his passions with a news director (Rene Russo) amid the backdrop of the station’s set.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dan Gilroy Narrates a Scene From ‘Nightcrawler’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-10-30T20:28:33+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a32c3f4-533a-5b7d-ad3e-880098a8cb36', 'word_count': 64, 'uri': 'nyt://article/2a32c3f4-533a-5b7d-ad3e-880098a8cb36'}, {'abstract': 'The French-born Dadaist Francis Picabia’s first photomontage, “Tableau Rastadada” (1920), is now part of the Museum of Modern Art’s collection.', 'web_url': 'https://www.nytimes.com/2014/10/31/arts/design/dadaist-self-deprecation-now-at-moma.html', 'snippet': 'The French-born Dadaist Francis Picabia’s first photomontage, “Tableau Rastadada” (1920), is now part of the Museum of Modern Art’s collection.', 'lead_paragraph': 'Francis Picabia, the French-born painter, poet and leading figure of the Dada movement in the late teens and early 1920s, often took delight in producing work filled with hidden messages, double meanings, mysterious puzzles and in-jokes. “Tableau Rastadada,” from 1920, is a prime example. “It’s Picabia’s first photo collage,” Christophe Cherix, chief curator of drawings and prints at the Museum of Modern Art, said this week, standing in a conference room where “Tableau Rastadada,” a recent acquisition, was propped on a table. Although MoMA is already rich in holdings by Picabia — 10 prints, nine paintings and eight drawings — there was no doubt when Mr. Cherix saw the collage last June at Art Basel, the annual contemporary art fair in Switzerland, that the museum had to have it.', 'print_section': 'C', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/31/arts/31VOGEL/VOGEL-articleLarge.jpg', 'height': 683, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/31/arts/31VOGEL/VOGEL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 683}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/31/arts/31VOGEL/VOGEL-jumbo.jpg', 'height': 1024, 'width': 900, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/31/arts/31VOGEL/VOGEL-superJumbo.jpg', 'height': 2000, 'width': 1757, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/31/arts/31VOGEL/VOGEL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/31/arts/31VOGEL/VOGEL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/31/arts/31VOGEL/VOGEL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dadaist Self-Deprecation, Now at MoMA', 'kicker': None, 'content_kicker': None, 'print_headline': 'Self-Deprecation from a Dadaist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Vogel, Carol', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Picabia, Francis', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Johns, Jasper', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum of Modern Art', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Brant Foundation Art Study Center', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': "Sotheby's", 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-30T20:30:45+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bec35f68-11e7-58b0-ba1f-f6d8b463b2d8', 'word_count': 960, 'uri': 'nyt://article/bec35f68-11e7-58b0-ba1f-f6d8b463b2d8'}, {'abstract': 'California, New York and others have exceeded C.D.C. guidelines in important ways.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/10/30/c-d-c-ebola-guidelines-arent-good-enough-for-some-states/', 'snippet': 'California, New York and others have exceeded C.D.C. guidelines in important ways.', 'lead_paragraph': 'The Centers for Disea