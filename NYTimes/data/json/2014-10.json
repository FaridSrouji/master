 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Moynihan, Brian T', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bank of America Corporation', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-01T22:04:58+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5228389c-9583-517d-882a-e5762730ccf4', 'word_count': 343, 'uri': 'nyt://article/5228389c-9583-517d-882a-e5762730ccf4'}, {'abstract': 'Protests from San Francisco’s drag queens prompted Facebook to say it will relax its insistence that its users go by their real names on the service. But how much leeway the company will allow has yet to be decided.', 'web_url': 'https://bits.blogs.nytimes.com/2014/10/01/facebook-agrees-to-ease-rules-on-real-names/', 'snippet': 'Protests from San Francisco’s drag queens prompted Facebook to say it will relax its insistence that its users go by their real names on the service. But how much leeway the company will allow has yet to be decided.', 'lead_paragraph': 'After two weeks of pressure from San Francisco’s drag queens and others who have adopted names that aren’t their legal ones, Facebook agreed Wednesday to modify its policies requiring individual users to operate their accounts under their real names. The company said it would reinstate the names preferred by hundreds of performers and lesbian, gay, bisexual and transgender people whose identities had been questioned in recent weeks.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/01/business/01bit