: [{'firstname': 'Jason', 'middlename': None, 'lastname': 'Horowitz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e1296803-ba30-514c-aeec-93633a650e73', 'word_count': 77, 'uri': 'nyt://article/e1296803-ba30-514c-aeec-93633a650e73'}, {'abstract': 'Red Door Spa, Elements Massage and Hand & Stone Massage and Facial Spa are offering a range of services for $50 each.', 'web_url': 'https://www.nytimes.com/2014/10/20/fashion/spa-week-arrives-just-in-time.html', 'snippet': 'Red Door Spa, Elements Massage and Hand & Stone Massage and Facial Spa are offering a range of services for $50 each.', 'lead_paragraph': 'It’s Spa Week and the timing couldn’t be better. Cold temperatures and dry air are skin and hair’s worst enemy. There’s no better complement to a refreshed autumn look than supple skin and a zenlike attitude.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/20/fashion/20GLOSSIERBEAUTY/20GLOSSIERBEAUTY-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/20/fashion/20GLOSSIERBEAUTY/20GLOSSIERBEAUTY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/20/fashion/20GLOSSIERBEAUTY/20GLOSSIERBEAUTY-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/20/fashion/20GLOSSIERBEAUTY/20GLOSSIERBEAUTY-superJumbo.jpg', 'height': 1600, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/201