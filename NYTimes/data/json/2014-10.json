acy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/business/Rates/Rates-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/business/Rates/Rates-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/22/business/Rates/Rates-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/business/Rates/Rates-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'States Ease Interest Rate Laws That Protected Poor Borrowers', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'States Ease Laws That Protected Poor Borrowers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Credit and Debt', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interest Rates', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Citigroup Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'OneMain Financial', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-22T00:55:50+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Michael Corkery', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Corkery', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6474be18-3aa7-5bf5-bd11-b20d8d6e41ea', 'word_count': 1252, 'uri': 'nyt://article/6474be18-3aa7-5bf5-bd11-b20d8d6e41ea'}, {'abstract': 'Almost 70 years after Jackie Robinson integrated baseball, the upstart Royals are using the same formula that made Robinson and his Negro leagues team, the Kansas City Monarchs, so compelling.', 'web_url': 'https://www.nytimes.com/2014/10/22/sports/baseball/world-series-2014-kansas-city-royals-monarchs-negro-leagues.html', 'snippet': 'Almost 70 years after Jackie Robinson integrated baseball, the upstart Royals are using the same formula that made Robinson and his Negro leagues team, the Kansas City Monarchs, so compelling.', 'lead_paragraph': 'KANSAS CITY, Mo. — Jackie Robinson played his first game as a Kansas City Monarch in the spring of 1945. Robinson was a shooting star who would play one season with the Monarchs before signing his minor-league contract with the Brooklyn Dodgers’ top farm team, the Montreal Royals. But in that one dynamic season, characterized by grueling bus rides and two — sometimes three — games in one day, Robinson honed an aggressive base-running style that, for decades, had defined baseball in the Negro leagues. ', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/sports/subRHODEN3/subRHODEN3-articleLarge.jpg', 'height': 411, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/22/sports/subRHODEN3/subRHODEN3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 411}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/sports/subRHODEN3/subRHODEN3-jumbo.jpg', 'height': 702, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/22/sports/subRHODEN3/subRHODEN3-superJumbo.jpg', 'height': 1404, 'width': 2048, '