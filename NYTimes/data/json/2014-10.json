: 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Social Media Reports, a Fed Policy Meeting and Third-Quarter G.D.P.', 'kicker': 'The Week Ahead', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Social Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Eurozone', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Commerce Department', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Company Reports', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-10-26T22:51:18+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/2181f185-41d7-5312-b996-c672fed2daf5', 'word_count': 319, 'uri': 'nyt://article/2181f185-41d7-5312-b996-c672fed2daf5'}, {'abstract': 'The outdoor retailer the North Face has a new campaign encouraging city dwellers, among whom its jackets are already popular, to take part in outdoor activities like biking and mountain-climbing.', 'web_url': 'https://www.nytimes.com/2014/10/27/business/media/telling-urbanites-to-flee-the-cities-.html', 'snippet': 'The outdoor retailer the North Face has a new campaign encouraging city dwellers, among whom its jackets are already popular, to take part in outdoor activities like biking and mountain-climbing.', 'lead_paragraph': 'So popular are puffy down jackets made by the North Face that a winter visitor to Manhattan might suspect the coats were issued with every subway card, but advertising for the 48-year-old brand has always eschewed images of bundled-up urbanites, focusing instead on outdoor adventurers climbing snowy peaks or swooshing down ski slopes. ', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/business/adco/adco-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/27/business/adco/adco-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/business/adco/adco-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/business/adco/adco-superJumbo.jpg', 'height': 1079, 'width': 1919, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/business/adco/adco-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/27/business/adco/adco-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/business/adco/adco-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Telling Urbanites to Flee the Cities ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Telling Urbanites to Flee the Cities ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Newman, Andrew Adam', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'North Face, The', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Coats and Jackets', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-26T22:58:33+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Andrew Adam Newman', 'person': [{'firstname': 'Andrew', 'middlename': 'Adam', 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b0bd9a7-8773-5e0d-974a-d63ef40bb775', 'word_count': 903, 'uri': 'nyt://article/5b0bd9a7-8773-5e0d-974a-d63ef40bb775'}, {'abstract': 'What was the world’s oldest captive gorilla saying when he held my hand, or when his eyes looked into my own?', 'web_url': 'https://opinionator.blogs.nytimes.com/2014/10/26/a-tale-of-two-primates/', 'snippet': 'What was the world’s oldest captive gorilla saying when he held my hand, or when his eyes looked into my own?', 'lead_paragraph': 'In the first real job I had out of college, I worked in an office, but it was not as mundane as it sounds. For one, I had a unique view. As the public relations manager for the Philadelphia Zoo, my window overlooked the Polar Bear Pool and the African Plains. I’d swivel my chair to rest my high heels on the window frame behind my desk and watch the animals. The children would press their small hands and noses against the polar bear exhibit. They’d scream and jump back as Coldlilocks or Klondike dove into the blue water and smacked a great, white paw against the thick, scratched glass. The parents would explain to their children that the big bears were just playing. I’d laugh on the phone to one of my friends, “The polar bears are trying to kill the kids again,” and in the wild, they would have.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/25/opinion/25menagerie/25menagerie-articleLarge.jpg', 'height': 834, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/25/opinion/25menagerie/25menagerie-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 834}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/25/opinion/25menagerie/25menagerie-jumbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/25/opinion/25menagerie/25menagerie-superJumbo.jpg', 'height': 2048, 'width': 1473, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/25/opinion/25menagerie/25menagerie-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/25/opinion/25menagerie/25menagerie-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/25/opinion/25menagerie/25menagerie-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Tale of Two Primates', 'kicker': 'Menagerie', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Memory', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Monkeys and Apes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Zoos', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-26T23:00:42+00