detractors but by one woman. ', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-CROSLEY/1012-bks-CROSLEY-articleLarge.jpg', 'height': 791, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/12/books/review/1012-bks-CROSLEY/1012-bks-CROSLEY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 791}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-CROSLEY/1012-bks-CROSLEY-jumbo.jpg', 'height': 1024, 'width': 777, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-CROSLEY/1012-bks-CROSLEY-superJumbo.jpg', 'height': 1972, 'width': 1496, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-CROSLEY/1012-bks-CROSLEY-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/12/books/review/1012-bks-CROSLEY/1012-bks-CROSLEY-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-CROSLEY/1012-bks-CROSLEY-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Voice of a Generation', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Voice of a Generation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Not That Kind of Girl 