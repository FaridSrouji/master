'multimedia': [], 'headline': {'main': 'From Futurists to Pussy Riot, a Brief History of Russian Performance Art', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Performance Art', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Pussy Riot', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Moscow (Russia)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-14T17:15:40+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Dawn Chan', 'person': [{'firstname': 'Dawn', 'middlename': None, 'lastname': 'Chan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f25c5afc-250c-5abf-a284-a04cc0476a64', 'word_count': 420, 'uri': 'nyt://article/f25c5afc-250c-5abf-a284-a04cc0476a64'}, {'abstract': 'Saudi security forces arrested a suspect who was a former colleague of the victims, military contractors with Vinnell Arabia.', 'web_url': 'https://www.nytimes.com/2014/10/15/world/middleeast/saudi-arabia-gunman-shoots-vinnell-arabia-employees.html', 'snippet': 'Saudi security forces arrested a suspect who was a former colleague of the victims, military contractors with Vinnell Arabia.', 'lead_paragraph': 'BEIRUT, Lebanon — Two American employees of a United States military contractor were shot on Tuesday, one fatally, by a recently dismissed Saudi-American colleague at a gas station in Riyadh, the Saudi capital, the Interior Ministry reported.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'American Is Fatal