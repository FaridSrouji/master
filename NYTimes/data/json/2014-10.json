 6, 'major': 'N'}], 'pub_date': '2014-10-29T14:19:36+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Farhad Manjoo', 'person': [{'firstname': 'Farhad', 'middlename': None, 'lastname': 'Manjoo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/51e0426c-d4c2-5034-9e25-9730ab070b6e', 'word_count': 1270, 'uri': 'nyt://article/51e0426c-d4c2-5034-9e25-9730ab070b6e'}, {'abstract': 'Some workers at Bellevue Hospital Center in New York have reported being discriminated against as a result of working at the hospital handling the city’s first Ebola case.', 'web_url': 'https://www.nytimes.com/2014/10/30/nyregion/bellevue-workers-worn-out-from-treating-ebola-patient-face-stigma-outside-hospital.html', 'snippet': 'Some workers at Bellevue Hospital Center in New York have reported being discriminated against as a result of working at the hospital handling the city’s first Ebola case.', 'lead_paragraph': 'For six years, Mayra Martinez had been going to the same beautician in Queens, and considered her a friend. On Saturday, while getting her hair done, Ms. Martinez, 45, mentioned she had just gotten a new job.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/30/nyregion/30bellevue-2/30bellevue-2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/30/nyregion/30bellevue-2/30bellevue-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/30/nyregion/30bellevue-2/30bellevue-2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo