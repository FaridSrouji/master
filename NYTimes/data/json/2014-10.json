ri': 'nyt://article/3784a0d7-8740-53a7-8cfc-0d56a58fa812'}, {'abstract': 'The relatives of the detainees have spoken out via social media, saying the charges are unjust and “a big insult to the families.”', 'web_url': 'https://sinosphere.blogs.nytimes.com/2014/10/13/relatives-of-people-detained-for-supporting-hong-kong-protests-appeal-for-their-freedom/', 'snippet': 'The relatives of the detainees have spoken out via social media, saying the charges are unjust and “a big insult to the families.”', 'lead_paragraph': 'Family members of about three dozen people detained in China recently for supporting democracy demonstrations in Hong Kong have appealed to the Chinese authorities to release their relatives, saying the charges of “picking quarrels and making trouble” were unjust and “a big insult to the families.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Relatives of People Detained for Supporting Hong Kong Protests Appeal for Their Freedom', 'kicker': 'Sinosphere', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Instant Messaging', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Die Zeit', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Occupy Central', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': "People's Daily", 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'WeChat (Mobile App)', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Weixin (Mobile App)', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Beijing (China)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-10-13T11:22:52+0000', 'doc