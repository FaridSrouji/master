Greenhouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/eae86137-171c-5992-ad10-041ce652a37c', 'word_count': 1574, 'uri': 'nyt://article/eae86137-171c-5992-ad10-041ce652a37c'}, {'abstract': 'The number of Cubans attempting to immigrate to the United States by sea has nearly doubled in the past two years.', 'web_url': 'https://www.nytimes.com/2014/10/30/us/coast-guard-rescues-cubans-off-boca-raton-in-new-sign-of-perilous-efforts-to-flee.html', 'snippet': 'The number of Cubans attempting to immigrate to the United States by sea has nearly doubled in the past two years.', 'lead_paragraph': 'MIAMI — In yet another signal of the increasingly dangerous voyages taken by Cuban migrants trying to make it to the United States, the Coast Guard rescued nearly three dozen men from a sinking rowboat off the shore of Boca Raton on Wednesday as the agency continued to search for two other rafters missing since Monday.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Coast Guard Rescues Cubans Off Boca Raton in New Sign of Perilous Efforts to Flee', 'kicker': None, 'content_kicker': None, 'print_headline': 'Coast Guard Rescues Cubans Off Boca Raton in New Sign of Perilous Efforts to Flee', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Cuba', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Robles, Frances', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Rescues', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Maritime Accidents and Safety', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigration', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Coast Guard', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Cu