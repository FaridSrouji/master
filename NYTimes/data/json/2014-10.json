 ‘He looked at me funny.’ ”', 'print_section': 'MM', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/magazine/05robinson1/05robinson1-articleLarge-v2.jpg', 'height': 481, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/05/magazine/05robinson1/05robinson1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 481}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/magazine/05robinson1/05robinson1-jumbo-v2.jpg', 'height': 821, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/magazine/05robinson1/05robinson1-superJumbo-v2.jpg', 'height': 1641, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/magazine/05robinson1/mag-05Robinson-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/05/magazine/05robinson1/mag-05Robinson-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/05/magazine/05robinson1/mag-05Robinson-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Revelations of Marilynne Robinson', 'kicker': None, 'content_kicker': None, 'print_headline': 'Saying Grace', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mason, Wyatt', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Robinson, Marilynne', 'ra