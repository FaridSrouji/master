g', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/27/world/sub-brazil/sub-brazil-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/27/world/sub-brazil/sub-brazil-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Brazil Stays With Rousseff as President After Turbulent Campaign', 'kicker': None, 'content_kicker': None, 'print_headline': 'Brazil Stays With Rousseff as President After Turbulent Campaign', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Romero, Simon', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brazil', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Neves, Aecio', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rousseff, Dilma', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Corruption (Institutional)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Da Silva, Luiz Inacio Lula', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-26T16:36:43+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Simon Romero', 'person': [{'firstname': 'Simon', 'middlename': None, 'lastname': 'Romero', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7210a47-0fa7-5819-b3b9-459b66ff981e', 'word_count': 980, 'uri': 'nyt://article/c7210a47-0fa7-5819-b3b9-459b66ff981e'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/10/26/arts/television/whats-on-tv-sunday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (13, 49) DEATH COMES TO PEMBERLEY Six years after tying the knot at the end of Jane Austen’s “Pride and Prejudice,” Elizabeth Bennett (Anna Maxwell Martin) and Mr. Darcy (Matthew Rhys, above, with Ms. Maxwell Martin), now parents to a young son, have planned a ball at their estate — and the uninvited Wickham (Matthew Goode) and his wife, Lydia (Jenna Coleman), have set off by coach to crash the festivities with their friend Captain Denny (Tom Canton). But when the coach arrives hours later with a hysterical Lydia inside, and the men missing, a search party ensues. P. D. James wrote the 2011 novel from which this two-part “Masterpiece Mystery!” production is adapted. “The two most famous argumentative lovers of post-Shakespearean literature are played here,” Mike Hale wrote in The New York Times, “with skill, intelligence and a bit too much restraint.” The most vivid performance, he added, is given by Ms. Coleman, “the current companion on ‘Doctor Who’ — she’s so squeally and broad as Lydia, Elizabeth’s youngest sister and Wickham’s wife, that she seems to be in a different, less distinguished and possibly more entertaining show.”', 'print_section': 'SP', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On TV Sunday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Sunday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-10-26T17:02:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/40c45c5f-fa43-58f6-baaa-2f90bdfc2e9a', 'word_count': 654, 'uri': 'nyt://article/40c45c5f-fa43-58f6-baaa-2f90bdfc2e9a'}, {'abstra