ype': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/24/sports/24BOXING-slide-D54J/24BOXING-slide-D54J-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/24/sports/24BOXING-slide-D54J/24BOXING-slide-D54J-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/24/sports/24BOXING-slide-D54J/24BOXING-slide-D54J-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tiny Champ Is Watching Talent Soar as Belt Sags', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tiny Champ Is Watching Talent Soar as Belt Sags', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Boxing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Borden, Sam', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Budler, Hekkie', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Monaco', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-24T15:02:15+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5582e25f-a403-5040-9a7d-9248e6a70fd2', 'word_count': 1117, 'uri': 'nyt://article/5582e25f-a403-5040-9a7d-9248e6a70fd2'}, {'abstract': 'Lucy Worsley examines the creation of British crime fiction and the growing fascination with foul play.', 'web_url': 'https://www.nytimes.com/2014/10/26/books/review/lucy-worsleys-art-of-the-english-murder.html', 'snippet': 'Lucy Worsley examines the creation of British crime fiction and the growing fascination with foul play.', 'lead_paragraph': '“Scratch John Bull . . . and you find the ancient Briton who revels in blood, who loves to dip deep into a murder and devours the details of a hanging,” The Pall Mall Gazette wrote in 1887, a year before Robert Louis Stevenson’s story “The Strange Case of Dr. Jekyll and Mr. Hyde” became a stage play. People packed the theater night after night, some fainting after witnessing Richard Mansfield’s performance, which included an extraordinary onstage transformation from monster to doctor. This appetite for gore as entertainment spawned a major industry in print, theater and artifacts in 19th-century England. ', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26paretsky/26paretsky-articleLarge.jpg', 'height': 802, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/26/books/review/26paretsky/26paretsky-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 802}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26paretsky/26paretsky-jumbo.jpg', 'height': 1024, 'width': 766, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26paretsky/26paretsky-superJumbo.jpg', 'height': 1380, 'width': 1032, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26paretsky/26paretsky-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/26/books/review/26paretsky/26paretsky-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26paretsky/26paretsky-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lucy Worsley’s ‘Art of the English Murder’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Murder, They Wrote', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Worsley, Lucy', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Art of the English Murder (Book)', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-24T15:04:29+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Sara Paretsky', 'person': [{'firstname': 'Sara', 'middlename': None, 'lastname': 'Paretsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bdb59e98-4a7e-5e09-a157-8ff10586af03', 'word_count': 1121, 'uri': 'nyt://article/bdb59e98-4a7e-5e09-a157-8ff10586af03'}, {'abstract': 'Richard Flanagan’s “The Narrow Road to the Deep North,” No. 10 in hardcover fiction, is the ninth consecutive winner of the Man Booker Prize to make our list.', 'web_url': 'https://www.nytimes.com/2014/11/02/books/review/inside-the-list.html', 'snippet': 'Richard Flanagan’s “The Narrow Road to the Deep North,” No. 10 in hardcover fiction, is the ninth consecutive winner of the Man Booker Prize to make our list.', 'lead_paragraph': 'Underdog: The Man Booker Prize is on a hot streak — Richard Flanagan’s novel “The Narrow Road to the Deep North,” new at No. 10 in hardcover fiction, is the ninth consecutive winner to make our list. (Which of those was most successful? At 38 weeks in hardcover and paperback, Hilary Mantel’s “Wolf Hall” edges out Anne Enright’s “The Gathering,” at 37 weeks.) Asked recently how he felt about this year’s decision to include Americans in the Booker running, which was previously limited to writers from Britain, Ireland and the Commonwealth, Flanagan (who is Australian) sounded serene. “In an age where the razor wire is being rolled out everywhere,” he told The Guardian, “it’s being ripped away with this prize, and what was a great English prize is become a great English-language prize.” Then again, maybe he was just dazed. “The strange thing is that I haven’t had time to feel anything,” he told The Wall Street Journal after his victory, which he acknowledged came as a surprise. “I had friends who were true gamblers bet against me,” he said. “My mother bet on me and she did all right, but she’s my mother.”', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26flanagan/26flanagan-jumbo.jpg', 'height': 450, 'width': 456, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26flanagan/26flanagan-superJumbo.jpg', 'height': 450, 'width': 456, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26flanagan/26flanagan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/26/books/review/26flanagan/26flanagan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/26flanagan/26flanagan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-10-24T15:06:36+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/707c25f4-f885-5b9b-9470-c82c7c628c78', 'word_count': 506, 'uri': 'nyt://article/707c25f4-f885-5b9b-9470-c82c7c628c78'}, {'abstract': 'Reviews of new thrillers, including Tawni O’Dell’s “One of Us,” Sergey Kuznetsov’s “Butterfly Skin” and more.', 'web_url': 'https://www.nytimes.com/2014/10/26/books/review/tawni-odells-one-of-us-and-more.html', 'snippet': 'Reviews of new thrillers, including Tawni O’Dell’s “One of Us,” Sergey Kuznetsov’s “Butterfly Skin” and more.', 'lead_paragraph': 'In the prologue to Tawni O’Dell’s ONE OF US (Gallery Books, $25), when 6-year-old Danny Doyle flees one of his father’s drunken late-night rampages, his grandfather tries to distract him by recounting the story of the Nellies, a band of Irish immigrants whose violent attempts to improve working conditions in the coal mines of Lost Creek, Pa., resulted in their mass execution. It makes for a strange bedtime story, and along with several of the chapters that follow, it’s threaded with a confusing tangle of details about the town’s history. But once O’Dell flashes forward to the present day, it’s clear the Nellies’ execution has left a permanent bruise on the soul of Lost Creek, a bruise its residents are still trying to heal through talk.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/1026-bks-Thrillers/1026-bks-Thrillers-articleLarge.jpg', 'height': 872, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/26/books/review/1026-bks-Thrillers/1026-bks-Thrillers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 872}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/1026-bks-Thrillers/1026-bks-Thrillers-jumbo.jpg', 'height': 1024, 'width': 705, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/1026-bks-Thrillers/1026-bks-Thrillers-superJumbo.jpg', 'height': 2048, 'width': 1409, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/1026-bks-Thrillers/1026-bks-Thrillers-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/26/books/review/1026-bks-Thrillers/1026-bks-Thrillers-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/1026-bks-Thrillers/1026-bks-Thrillers-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Killer Company', 'kicker': 'Thrillers', 'content_kicker': None, 'print_headline': 'Killer Company', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'de Villiers, Gerard', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Beukes, Lauren', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'House, Richard', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kuznetsov, Sergey', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-24T15:07:29+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Christopher Rice', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Rice', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a11296c4-dfbe-5960-a756-49b7252789a0', 'word_count': 2066, 'uri': 'nyt://article/a11296c4-dfbe-5960-a756-49b7252789a0'}, {'abstract': 'New books by Robert Jackson Bennett, Peyton Marshall and more.', 'web_url': 'https://www.nytimes.com/2014/10/26/books/review/robert-jackson-bennetts-city-of-stairs-and-more.html', 'snippet': 'New books by Robert Jackson Bennett, Peyton Marshall and more.', 'lead_paragraph': 'There’s a moment early in Robert Jackson Bennett’s CITY OF STAIRS (Broadway, paper, $15) when one of its lead characters loses an otherwise mundane suspect during a chase through the streets of a city. The suspect runs along a chasm — yes, in the middle of a dense neighborhood — then leaps off a rooftop. Although his pursuer searches for the body, it gradually becomes clear the man has vanished not through trickery but through divine intervention.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/books/review/1026-bks-SCIFI/1026-bks-SCIFI-articl