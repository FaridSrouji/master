_name': 'Dance', 'byline': {'original': 'By Brian Seibert', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Seibert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3cfe84de-f4d2-59c1-b9be-d49dc433f2d6', 'word_count': 536, 'uri': 'nyt://article/3cfe84de-f4d2-59c1-b9be-d49dc433f2d6'}, {'abstract': 'Alarm Will Sound and the conductor Alan Pierson performed Scott Johnson’s “Mind Out of Matter” as part of the Peak Performances series at Montclair State University.', 'web_url': 'https://www.nytimes.com/2014/10/07/arts/music/mind-out-of-matter-from-the-composer-scott-johnson.html', 'snippet': 'Alarm Will Sound and the conductor Alan Pierson performed Scott Johnson’s “Mind Out of Matter” as part of the Peak Performances series at Montclair State University.', 'lead_paragraph': 'MONTCLAIR, N.J. — Steve Reich used taped fragments of people speaking in some of his earliest works from the mid-60s. But when he returned to spoken samples 20 years later, it was in the shadow of Scott Johnson’s seminal, gleeful “John Somebody” (1982), which built its melodies and harmonies from the cadences of recorded speech: in this case, brief excerpts from everyday life, repeated and fractured to the point of hilarious absurdity. (“You know who’s in New York? You remember that guy, John somebody? He was a — he was sort of a ——.”)', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/arts/peak/peak-articleLarge.jpg', 'height': 431, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/07/arts/peak/peak-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 431}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/arts/peak/peak-jumbo.jpg', 'height': 735, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/arts/peak/peak-superJumbo.jpg', 'height': 1470, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/arts/peak/peak-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/07/arts/peak/peak-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/07/arts/peak/peak-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Taking Words and Music and Bending Identities', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Taking Words and Music and Bending Identities', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Woolfe, Zachary', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Scott', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Montclair State University', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'ALARM WILL SOUND', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-06T20:43:49+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/