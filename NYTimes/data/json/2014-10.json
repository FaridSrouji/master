e': 'image', 'url': 'images/2014/10/29/opinion/nyto-koons/nyto-koons-superJumbo.jpg', 'height': 2000, 'width': 2020, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/opinion/nyto-koons/nyto-koons-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/29/opinion/nyto-koons/nyto-koons-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/opinion/nyto-koons/nyto-koons-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'If David Byrne Does Not Care About Contemporary Art, Should We?', 'kicker': 'Op-Talk', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-10-29T19:26:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By John Guida', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Guida', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef69a32e-a907-5b6d-b61d-e85ad7a23ddc', 'word_count': 1211, 'uri': 'nyt://article/ef69a32e-a907-5b6d-b61d-e85ad7a23ddc'}, {'abstract': 'Musicians from several countries joined together to record “Africa Stop Ebola.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/10/29/how-to-protect-yourself-from-ebola-in-song/', 'snippet': 'Musicians from several countries joined together to record “Africa Stop Ebola.”', 'lead_paragraph': 'Public service announcements can be useful, particularly if their messages are presented by celebrities. But a catchy song, performed by a starry cast, can be even better. That, at any rate, is the reasoning behind “Africa Stop Ebola,” a new song packed with information about what people can do to help stop the spread of the Ebola virus, for which some of Africa’s top musicians – among them the reggae singer Tiken Jah Fakoly, the duo Amadou & Mariam and the rapper Didier Awadi – have banded together.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How to Protect Yourself From Ebola, in Song', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'How to Protect Yourself From Ebola, in Song', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ebola Virus', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fakoly, Tiken Jah', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-29T19:27:52+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/794cde54-afb1-57a2-9d84-8c2d68be6162', 'word_count': 478, 'uri': 'nyt://article/794cde54-afb1-57a2-9d84-8c2d68be6162'}, {'abstract': 'The Bacara Resort & Spa in California offers guests a “Bike to the Butterflies” program to see migrating monarchs.', 'web_url': 'https://intransit.blogs.nytimes.com/2014/10/29/butterflies-by-bicycle/', 'snippet': 'The Bacara Resort & Spa in California offers guests a “Bike to the Butterflies” program to see migrating monarchs.', 'lead_paragraph': 'Every winter, more than 10,000 monarch butterflies migrate from as far north as Canada to the Goleta Butterfly Grove in California, and the Bacara Resort & Spa nearby helps its guests see them with its “Bike to the Butterflies” program.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/travel/29monarch/29monarch-articleLarge.jpg', 'height': 577, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/29/travel/29monarch/29monarch-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 577}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/travel/29monarch/29monarch-jumbo.jpg', 'height': 615, 'width': 640, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/travel/29monarch/29monarch-superJumbo.jpg', 'height': 615, 'width': 640, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/travel/29monarch/29monarch-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/29/travel/29monarch/29monarch-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/travel/29monarch/29monarch-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Butterflies by Bicycle', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Butterflies and Moths', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Santa Barbara (Calif)', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-29T19:30:13+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Shivani Vora', 'person': [{'firstname': 'Shivani', 'middlename': None, 'lastname': 'Vora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6290807e-4212-5745-8b41-159f823ed503', 'word_count': 197, 'uri': 'nyt://article/6290807e-4212-5745-8b41-159f823ed503'}, {'abstract': 'The founders’ favorite “Loud Women” —\xa0like Kim Gordon, Yayoi Kusama, Marina Abramovic, Sophia Amoruso — helped get this new online high school for imagination Kickstarted. Here, a first look at their own doodles.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/10/29/school-of-doodle-molly-logan-elise-van-middelem/', 'snippet': 'The founders’ favorite “Loud Women” —\xa0like Kim Gordon, Yayoi Kusama, Marina Abramovic, Sophia Amoruso — helped get this new online high school for imagination Kickstarted. Here, a first look at their own doodles.', 'lead_paragraph': 'Its name may give off a silly vibe, and its “dabble, dig, do” education model sound downright dippy, but School of Doodle is quite serious about its mission: to “use creativity to help girls build their imaginations,” says Molly Logan, who founded the program alongside Elise Van Middelem. Logan explains that healthy imaginations help develop “noncognitive skills like empathy, self-confidence, optimism, self-expression, tenacity” — traits, she notes, that research has shown to be better indicators of future success than I.Q. “It’s not to discount the importance of traditional academic intelligence. But for teen girls, who are considered at-risk at that age, it’s been proven that building these other skills keeps them in school longer.”', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'School of Doodle Draws on Knowledge Dropped by Creative Types', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Gallery: Pencils Up!', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Amoruso, Sophia', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Huffington, Arianna', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kusama, Yayoi', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mehretu, Julie', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Robinson, Angela', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Simmons, Laurie', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Yacht (Music Group)', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-10-29T19:30:41+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Charlotte Druckman', 'person': [{'firstname': 'Charlotte', 'middlename': None, 'lastname': 'Druckman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/17289d26-e007-5414-be86-7183a9fb1a08', 'word_count': 350, 'uri': 'nyt://article/17289d26-e007-5414-be86-7183a9fb1a08'}, {'abstract': 'The emergence of Jaber George Jabbour in a battle between Libya’s sovereign wealth fund and Goldman Sachs reveals the complex relationship between banks and public sector entities.', 'web_url': 'https://dealbook.nytimes.com/2014/10/29/ex-banker-highlights-complexity-of-trades-for-public-entities/', 'snippet': 'The emergence of Jaber George Jabbour in a battle between Libya’s sovereign wealth fund and Goldman Sachs reveals the complex relationship between banks and public sector entities.', 'lead_paragraph': 'LONDON — As an analyst at Goldman Sachs, Jaber George Jabbour learned the intricacies of sophisticated financial products by helping to creat