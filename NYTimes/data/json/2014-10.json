2014/10/25/business/Stewartjp2/Stewartjp2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/25/business/Stewartjp2/Stewartjp2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Brazil’s Election, a Stark Vote on the Nation’s Economy', 'kicker': 'Common Sense', 'content_kicker': None, 'print_headline': 'In Election, Stark Vote on Brazil’s Economy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Neves, Aecio', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brazil', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rousseff, Dilma', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fraga, Arminio', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-24T14:33:59+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By James B. Stewart', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ba33e387-789a-559f-a0a1-49495d3fd696', 'word_count': 1239, 'uri': 'nyt://article/ba33e387-789a-559f-a0a1-49495d3fd696'}, {'abstract': 'In an area of northern France, where the land bears century-old wounds of battle, visitors can walk the grounds of history.', 'web_url': 'https://www.nytimes.com/2014/10/26/travel/where-americans-turned-the-tide-in-world-war-i.html', 'snippet': 'In an area of northern France, where the land bears century-old wounds of battle, visitors can walk the grounds of history.', 'lead_paragraph': 'If you want to find the spot where World War I became a truly somber affair for millions of Americans, you’re going to need some help. It lies about 90 miles northeast of Paris, somewhere between Chamery and Coulonges-Cohan, two farming villages. Just where, exactly, and how best to get there is a matter of dispute; but if you ask enough people in Chamery, eventually one will decide it’s easier to just show you.', 'print_section': 'TR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26WWI1/26WWI1-articleLarge-v2.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/26/travel/26WWI1/26WWI1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26WWI1/26WWI1-jumbo-v2.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26WWI1/26WWI1-superJumbo-v2.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26WWI1/26WWI1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/26/travel/26WWI1/26WWI1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26WWI1/26WWI1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Where Americans Turned the Tide in World War I', 'kicker': 'Over There', 'content_kicker': None, 'print_headline': 'Where Americans Turned the Tide', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rubin, Richard', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Series', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Belleau Wood (France)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Chateau-Thierry (France)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Roosevelt, Quentin (1897-1918)', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-10-24T14:35:53+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Richard Rubin', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2360a35e-f4d1-5954-8282-4d8305137800', 'word_count': 2023, 'uri': 'nyt://article/2360a35e-f4d1-5954-8282-4d8305137800'}, {'abstract': 'Though less than 20 miles from Music City, Franklin is a world away, with a history and culture all its own.', 'web_url': 'https://www.nytimes.com/2014/10/26/travel/a-small-town-gem-near-nashville.html', 'snippet': 'Though less than 20 miles from Music City, Franklin is a world away, with a history and culture all its own.', 'lead_paragraph': 'It was Sunday night at the Cork & Cow. Around 6:30, four girlfriends met at the bar to have salads and Champagne and review the weekend. There was a nice hum in the dining room, where six couples had assembled at a long table along the tufted green banquette. At least a few of them had come for the weekly special that February evening: a $20 prime rib dinner and half-price bottles of wine. My sister and I had spent the day in Nashville and just wanted a quick bite, so we popped in to share some brussels sprouts and warm bread that came in a small cast-iron skillet. Service took a while, but no one seemed to mind. This is the pace of the South.', 'print_section': 'TR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26-overnighter-theater/26-overnighter-theater-articleLarge.jpg', 'height': 486, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/26/travel/26-overnighter-theater/26-overnighter-theater-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 486}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26-overnighter-theater/26-overnighter-theater-jumbo.jpg', 'height': 830, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26-overnighter-theater/26-overnighter-theater-superJumbo.jpg', 'height': 1660, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26-overnighter-theater/26-overnighter-theater-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/26/travel/26-overnighter-theater/26-overnighter-theater-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/26/travel/26-overnighter-theater/26-overnighter-theater-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Small-Town Gem Near Nashville', 'kicker': 'Overnighter', 'content_kicker': None, 'print_headline': 'A Small-Town Gem Near Nashville', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wright, Christian L', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Nashville (Tenn)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Franklin (Tenn)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-24T14:36:55+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Christian L. Wright', 'person': [{'firstname': 'Christian', 'middlename': 'L.', 'lastname': 'Wright', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7d672aa9-8df8-53a6-b532-016ccfa90156', 'word_count': 1342, 'uri': 'nyt://article/7d672aa9-8df8-53a6-b532-016ccfa90156'}, {'abstract': 'Miranda Chaiken, Aida Piccato and Sunnam Quispe are seniors at Stuyvesant High School and the creators of NYC Happenings.', 'web_url': 'https://open.blogs.nytimes.com/2014/10/24/girls-who-code/', 'snippet': 'Miranda Chaiken, Aida Piccato and Sunnam Quispe are seniors at Stuyvesant High School and the creators of NYC Happenings.', 'lead_paragraph': 'Miranda Chaiken, Aida Piccato and Sunnam Quispe are seniors at Stuyvesant High School and the creators of NYC Happenings. Their site, which guides users to events, is powered by The New York Times Event Listings API and searchable by genre and borough. They explained that they found themselves doing the same activities every day and decided to build a functional website as a cure for their boredom. While all three have taken computer science classes at Stuyvesant’s prestigious computer science program, they attended the Girls Who Code Club at Twitter’s headquarters to hone their programming skills.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Girls Who Code', 'kicker': 'Open', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-10-24T14:40:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Priya Ollapally', 'person': [{'firstname': 'Priya', 'middlename': None, 'lastname': 'Ollapally', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b1b40c4-e272-5600-ac55-dcb2241c0c42', 'word_count': 189, 'uri': 'nyt://article/0b1b40c4-e272-5600-ac55-dcb2241c0c42'}, {'abstract': 'In late October, here’s one way to spot a nervous incumbent: a heavy flow of last-minute campaign contributions.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/10/24/from-the-upshot-the-money-race/', 'snippet': 'In late October, here’s one way to spot a nervous incumbent: a heavy flow of last-minute campaign contributions.', 'lead_paragraph': 'For Nervous House Incumbents, October Means a Money Chase ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From The Upshot: The Money Race', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Midterm Elections (2014)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-10-24T14:50:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By First Draft', 'person': [{'firstname': 'First', 'middlename': None, 'lastname': 'Draft', 'qualifier': None, 'title': None, 'role': 'reported', 'o