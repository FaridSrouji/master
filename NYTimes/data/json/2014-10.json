, 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24949b36-a94a-580f-aa13-d7a6c299e0d6', 'word_count': 1340, 'uri': 'nyt://article/24949b36-a94a-580f-aa13-d7a6c299e0d6'}, {'abstract': 'The government has authorized a cull of hundreds of the animals in an attempt to combat bovine tuberculosis, which badgers can transmit.', 'web_url': 'https://www.nytimes.com/2014/10/02/business/badger-hunts-divide-britons.html', 'snippet': 'The government has authorized a cull of hundreds of the animals in an attempt to combat bovine tuberculosis, which badgers can transmit.', 'lead_paragraph': 'GLASSHOUSE, England — “You can tell how outraged people are, if they are willing to spend their evenings like this,” David Carter said as we stood at the edge of a freshly plowed field, peering into the darkness for signs of badger shooters.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Badger Hunts Divide Britons', 'kicker': 'Green Column', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Great Britain', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Badgers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tuberculosis', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Agriculture and Farming', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Animal Abuse, Rights and Welfare', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-01T15:59:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Energy & Environment ', 'byline': {'original': 'By Stanley Reed', 'person': [{'firstname': 'Stanley', 'middlename': None, 'lastname': 'Reed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/447009f9-9669-5d4a-9e84-73728490d8e2', 'word_count': 1047, 'uri': 'nyt://article/447009f9-9669-5d4a-9e84-73728490d8e2'}, {'abstract': 'Ms. Wilson and Mr. Gyllenhaal will star in Nick Payne’s “Constellations,” to begin previews in December.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/10/01/ruth-wilson-to-make-broadway-debut-with-jake-gyllenhaal-in-constellations/', 'snippet': 'Ms. Wilson and Mr. Gyllenhaal will star in Nick Payne’s “Constellations,” to begin previews in December.', 'lead_paragraph': 'Ruth Wilson, who has won acclaim for her performances as Alice Morgan in “Luther,” the BBC crime drama, and who also stars in the forthcoming Showtime series “The Affair,” will make her Broadway debut in Nick Payne’s “Constellations,” the Manhattan Theater Club announced on Wednesday. She will play opposite Jake Gyllenhaal, who will also be making his Broadway debut.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-wilson/01artsbeat-wilson-articleLarge.jpg', 'height': 734, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/02/arts/01artsbeat-wilson/01artsbeat-wilson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 734}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-wilson/01artsbeat-wilson-jumbo.jpg', 'height': 1024, 'width': 838, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-wilson/01artsbeat-wilson-superJumbo.jpg', 'height': 2048, 'width': 1675, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/02/arts/01artsbeat-wilson/01artsbeat-wilson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType':