in': '1964: Hungarian Athlete Defects', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Communism (Theory and Philosophy)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defectors (Political)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ANCHORAGE (ALASKA)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Hungary', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-23T16:51:45+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/098e2c7e-2bda-56e0-b5ec-1bd55affd4f0', 'word_count': 106, 'uri': 'nyt://article/098e2c7e-2bda-56e0-b5ec-1bd55affd4f0'}, {'abstract': 'The writer and director Justin Simien narrates a sequence from his film featuring Tessa Thompson.', 'web_url': 'https://www.nytimes.com/video/movies/100000003183593/anatomy-of-a-scene-dear-white-people.html', 'snippet': 'The writer and director Justin Simien narrates a sequence from his film featuring Tessa Thompson.', 'lead_paragraph': 'The writer and director Justin Simien narrates a sequence from his film featuring Tessa Thompson.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/17/multimedia/dear-white-anatomy/dear-white-anatomy-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/17/multimedia/dear-white-anatomy/dear-white-anatomy-articleLarge.jpg', 'xlargewidth': 600, 'xlarg