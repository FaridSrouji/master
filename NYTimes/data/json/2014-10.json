., the Rush Begins', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Medical Marijuana', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Secret, Mosi', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Marijuana', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-10-31T14:53:27+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By John Leland and Mosi Secret', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Leland', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Mosi', 'middlename': None, 'lastname': 'Secret', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eaa4e27e-de0a-504d-a76c-4cc7aee4022e', 'word_count': 2602, 'uri': 'nyt://article/eaa4e27e-de0a-504d-a76c-4cc7aee4022e'}, {'abstract': 'President Obama is talking up the employment recovery in Rhode Island, where jobs are hard to find.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/10/31/obama-talks-jobs-in-a-state-that-struggles-to-find-them/', 'snippet': 'President Obama is talking up the employment recovery in Rhode Island, where jobs are hard to find.', 'lead_paragraph': 'President Obama chose a curious spot to deliver a full-throated defense of his economic policies on Friday, appearing in a state that hasn’t experienced much of his oft-promoted recovery. ', 'source': 'The New York