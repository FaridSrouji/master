major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Denver Broncos', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-10-12T21:13:15+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4dfbf67f-6815-5794-9013-114161340e90', 'word_count': 1201, 'uri': 'nyt://article/4dfbf67f-6815-5794-9013-114161340e90'}, {'abstract': 'Account assignments, miscellaneous news from advertising agencies and more.', 'web_url': 'https://www.nytimes.com/2014/10/13/business/media/news-from-the-advertising-industry-.html', 'snippet': 'Account assignments, miscellaneous news from advertising agencies and more.', 'lead_paragraph': 'Accounts', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'News From the Advertising Industry ', 'kicker': None, 'content_kicker': None, 'print_headline': 'News From the Advertising Industry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-12T21:16:43+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Stuart Elliott', 'person': [{'firstname': 'Stuart', 'middlename': None, 'lastname': 'Elliott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5c3546b7-fbb2-547c-bea1-6acd8dd40fdb', 'word_count': 1084, 'uri': 'nyt://article/5c3546b7-fbb2-547c-bea1-6acd8dd40fdb'}, {'abstract': 'Competition from synthetic fibers has damaged earnings for the country’s wool exporters, and farmers are retooling their operations in response.', 'web_url': 'https://www.nytimes.com/2014/10/13/business/international/as-wool-demand-shrinks-new-zealands-sheep-farmers-scramble-to-adapt.html', 'snippet': 'Competition from synthetic fibers has damaged earnings for the country’s wool exporters, and farmers are retooling their operations in response.', 'lead_paragraph': 'ST. ANDREWS, New Zealand — About three decades ago, when Andrew Fraser began raising sheep, wool was among the star exports of this sparsely populated nation. Its other sheep products — lamb and mutton — were supporting actors.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Declining Wool Demand Forces Scramble to Adapt at New Zealand Farms', 'kicker': None, 'content_kicker': None, 'print_headline': 'Declining Wool Demand Forces Scramble to Adapt at New Zealand Farms', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wool and Woolen Goods', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Agriculture and Farming', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sheep', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New Zealand', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Australia and New Zealand Banking Group Limited', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-12T21:31:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Mike Ives', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Ives', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/646077cb-514d-5f41-b3d7-320044eacb8e', 'word_count': 1136, 'uri': 'nyt://article/646077cb-514d-5f41-b3d7-320044eacb8e'}, {'abstract': 'The BomPlenazo Artists Collective performed Afro-Puerto Rican roots music with plenty of dancing at Hostos Community College.', 'web_url': 'https://www.nytimes.com/2014/10/13/arts/music/bomplenazo-artists-collective-at-hostos-community-college.html', 'snippet': 'The BomPlenazo Artists Collective performed Afro-Puerto Rican roots music with plenty of dancing at Hostos Community College.', 'lead_paragraph': 'It would be impossible to imagine the music of the BomPlenazo Artists Collective, which played a large-cast concert of Afro-Puerto Rican roots music on Saturday night at Hostos Community College in the Bronx, without the movement and dancing that framed, refracted and amplified it. Generally, the drummers occupied the left of the stage and the singers the right, with bass, keyboards and horns at the back. But everybody moved, casually or theatrically, and all roles stayed fluid: There was little division onstage between being a musician and being a dancer, and little division in the audience between hearing with the ears and the eyes.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/BOMPLEAZO/BOMPLEAZO-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/13/arts/BOMPLEAZO/BOMPLEAZO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/BOMPLEAZO/BOMPLEAZO-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/BOMPLEAZO/BOMPLEAZO-superJumbo.jpg', 'height': 1361, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/BOMPLEAZO/BOMPLEAZO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/13/arts/BOMPLEAZO/BOMPLEAZO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/BOMPLEAZO/BOMPLEAZO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Old Traditions Made Immediate ', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Old Traditions Made Immediate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hostos Community College', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'BomPlenazo Artists Collective', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-10-12T21:43:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2ac41038-0408-506a-ae53-416e6bdb956f', 'word_count': 727, 'uri': 'nyt://article/2ac41038-0408-506a-ae53-416e6bdb956f'}, {'abstract': 'The Janoskians, five young men from Australia, used humor and song to entertain their core audience of teenage girls at Irving Plaza.', 'web_url': 'https://www.nytimes.com/2014/10/13/arts/the-janoskians-bring-their-brand-to-irving-plaza.html', 'snippet': 'The Janoskians, five young men from Australia, used humor and song to entertain their core audience of teenage girls at Irving Plaza.', 'lead_paragraph': 'Strictly speaking, the Janoskians show at Irving Plaza on Saturday afternoon began long before the whole crew came out onstage. For about 20 minutes, the speakers blasted a medley of recent, obvious hits — Iggy Azalea’s “Fancy,” 5 Seconds of Summer’s “She Looks So Perfect,” Nicki Minaj’s “Starships,” One Direction’s “Story of My Life” and so on — while one or two of the guys pretended to be D.J.-ing.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/JANOSKIANS/JANOSKIANS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/13/arts/JANOSKIANS/JANOSKIANS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/JANOSKIANS/JANOSKIANS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/JANOSKIANS/JANOSKIANS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/13/arts/JANOSKIANS/JANOSKIANS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/13/arts/JANOSKIANS/JANOSKIANS-thumbStandard.