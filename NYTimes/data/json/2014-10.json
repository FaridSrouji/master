lifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd7a2d01-74e4-5cad-a3ba-07c91122fda6', 'word_count': 797, 'uri': 'nyt://article/bd7a2d01-74e4-5cad-a3ba-07c91122fda6'}, {'abstract': 'The chairman of the F.C.C. wants to allow Internet-based firms the same access to TV programming as cable and satellite companies.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/10/29/let-the-internet-take-on-cable/', 'snippet': 'The chairman of the F.C.C. wants to allow Internet-based firms the same access to TV programming as cable and satellite companies.', 'lead_paragraph': 'The recent announcements by HBO and CBS that they would sell their programming directly to consumers have stirred hopes that Americans will soon have the ability to buy TV channels a la carte, over the Internet, rather than in bundles. But there has always been a big obstacle to achieving that reality: Internet-based firms do not have the same access to TV programming that cable and satellite companies do.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Let the Internet Take On Cable', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wheeler, Thomas E', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-29T16:39:30+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Vikas Bajaj', 'person': [{'firstname': 'Vikas', 'middlename': None, 'lastname': 'Bajaj', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6fbf51e8-0dcb-5c72-ace4-60c13cf77aa8', 'word_count': 417, 'uri': 'nyt://article/6fbf51e8-0dcb-5c72-ace4-60c13cf77aa8'}, {'abstract': 'The costs of litigation and regulation are still weighing on Deutsche Bank, and investors remain to be convinced that it has made the right call on fixed income, currencies and commodities, George Hay writes for Reuters Breakingviews.', 'web_url': 'https://dealbook.nytimes.com/2014/10/29/familiar-clouds-still-shadow-deutsche-bank/', 'snippet': 'The costs of litigation and regulation are still weighing on Deutsche Bank, and investors remain to be convinced that it has made the right call on fixed income, currencies and commodities, George Hay writes for Reuters Breakingviews.', 'lead_paragraph': 'Deutsche Bank’s strategy is still on probation. It decided this year not to follow Barclays, its largest European rival, in cutting back its investment bank. The bet will pay off only if the recent slowdown in bond trading is merely cyclical, not part of a structural decline. The evidence from the third-quarter results is inconclusive.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/business/dealbook/dbpix-deutsche/dbpix-deutsche-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/29/business/dealbook/dbpix-deutsche/dbpix-deutsche-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/business/dealbook/dbpix-deutsche/dbpix-deutsche-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/29/business/dealbook/dbpix-deutsche/dbpix-deutsche-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumb