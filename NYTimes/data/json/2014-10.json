, 'major': 'N'}, {'name': 'organizations', 'value': 'Blaze, The', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'National Public Radio', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'National Review', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Newsweek', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Slate (Magazine)', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Wall Street Journal', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'Yahoo! Inc', 'rank': 15, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 16, 'major': 'N'}], 'pub_date': '2014-10-23T17:39:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9df94a18-fec7-5e03-b5b9-eeda141f7467', 'word_count': 1166, 'uri': 'nyt://article/9df94a18-fec7-5e03-b5b9-eeda141f7467'}, {'abstract': 'An Ebola vaccine effective in monkeys was not tested in humans until now, after the severe outbreak in West Africa forced governments to step in.', 'web_url': 'https://www.nytimes.com/2014/10/24/health/without-lucrative-market-potential-ebola-vaccine-was-shelved-for-years.html', 'snippet': 'An Ebola vaccine effective in monkeys was not tested in humans until now, after the severe outbreak in West Africa forced governments to step in.', 'lead_paragraph': 'GALVESTON, Tex. — Almost a decade ago, scientists from Canada and the United States reported that they had created a vaccine that was 100 percent effective in protecting monkeys against the Ebola virus. The results were published in a respected journal, and health officials ca