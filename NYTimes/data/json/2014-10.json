lastname': 'Krueger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fc948bd0-eab9-59c2-9175-f254f22dcfd9', 'word_count': 1200, 'uri': 'nyt://article/fc948bd0-eab9-59c2-9175-f254f22dcfd9'}, {'abstract': 'David Gockley, one of the most innovative and adventurous leaders in the American opera world, will retire in July 2016.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/10/03/san-francisco-opera-director-to-step-down/', 'snippet': 'David Gockley, one of the most innovative and adventurous leaders in the American opera world, will retire in July 2016.', 'lead_paragraph': 'The San Francisco Opera announced at a news conference on Friday that David Gockley, its general director since 2006, would retire in July 2016, putting the double bar on a tenure that by then will have run 10 years and two months. Mr. Gockley, 71, has long been regarded as one of the most innovative and adventurous leaders in the American opera world.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'San Francisco Opera Director to Step Down', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Director to Step Down at San Francisco Opera', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gockley, David', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco Opera', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-03T19:49:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2b11ff6