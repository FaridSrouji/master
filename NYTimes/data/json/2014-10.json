ource': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Shamed, Flamed, Harassed: What It’s Like To Be Called Fat Online', 'kicker': 'Op-Talk', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Obesity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Weight', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-03T15:24:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Anna North', 'person': [{'firstname': 'Anna', 'middlename': None, 'lastname': 'North', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/02bf19ec-3265-5b1d-a904-d87e2ea44c8c', 'word_count': 813, 'uri': 'nyt://article/02bf19ec-3265-5b1d-a904-d87e2ea44c8c'}, {'abstract': 'The gritty neighborhood emerges from the shadows of its neighbors, with construction underway for several developments and a $500 million cleanup of the nearby canal.', 'web_url': 'https://www.nytimes.com/2014/10/05/realestate/gowanus-is-counting-on-a-cleanup.html', 'snippet': 'The gritty neighborhood emerges from the shadows of its neighbors, with construction underway for several developments and a $500 million cleanup of the nearby canal.', 'lead_paragraph': 'For decades, Gowanus was written off as a no man’s land between two darlings of brownstone Brooklyn — Carroll Gardens and Park Slope. Now the gritty industrial neighborhood is emerging from the shadows cast by its neighbors.', 'print_section': 'RE', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'h