None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hastings, Thomas', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Frick Collection', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-09T19:30:28+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e23ea394-7773-5f94-9448-a2e99901daad', 'word_count': 225, 'uri': 'nyt://article/e23ea394-7773-5f94-9448-a2e99901daad'}, {'abstract': 'A new supportive-housing complex in the Skid Row section of Los Angeles includes a health clinic.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/10/09/the-solution-to-chronic-homelessness-try-homes/', 'snippet': 'A new supportive-housing complex in the Skid Row section of Los Angeles includes a health clinic.', 'lead_paragraph': 'The solution to chronic homelessness is homes, which sounds stupidly obvious but isn’t.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Solution to Chronic Homelessness? Try Homes.', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homeless Persons', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-10-09T19:37:03+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Lawrence Downes', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Downes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e92d776-5819-5112-a54c-ba9020880376', 'word_count': 278, 'uri': 'nyt://article/1e92d776-5819-5112-a54c-ba9020880376'}, {'abstract': 'Jennifer Senior reviews Kirsten Gillibrand’s memoir, which doubles as a campaign document.', 'web_url': 'https://www.nytimes.com/2014/10/12/books/review/kirsten-gillibrands-off-the-sidelines.html', 'snippet': 'Jennifer Senior reviews Kirsten Gillibrand’s memoir, which doubles as a campaign document.', 'lead_paragraph': 'In some ways, the measure of a good political autobiography — which almost invariably is a campaign document masquerading as a reminiscence — boils down to its ratio of originality to bromides. Kirsten Gillibrand’s “Off the Sidelines,” though, is an interesting case, because it ticktocks in perfect 4/4 time between the two, often on the same page, which means one is never quite sure whether to applaud New York’s junior senator for her honesty or toss tomatoes in irritation. There are stretches so platitudinous that it’s almost impossible not to hear blah blah BLAH blah Blaaaaaaaaaaah chiming in one’s head: “I’m a big believer in making your own luck.” Then there are moments of immensely appealing self-disclosure that seldom appear in other books of this genre: “I was a slightly straighter arrow than my mother. O.K., I was a massive kiss-ass and lived for positive reinforcement.” ', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/12senior-SUB/12senior-1412110067907-articleLarge.jpg', 'height': 531, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/12/books/review/12senior-SUB/12senior-1412110067907-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 531}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/12senior-SUB/12senior-1412110067907-jumbo.jpg', 'height': 906, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/12senior-SUB/12senior-1412110067907-superJumbo.jpg', 'height': 1812, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/12senior-SUB/12senior-1412110067907-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/12/books/review/12senior-SUB/12senior-1412110067907-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/12senior-SUB/12senior-1412110067907-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mother of Two, Senator of 20 Million', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mother of Two, Senator of 20 Million', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Weil, Elizabeth', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gillibrand, Kirsten E', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Weil, Elizabeth', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-10-09T19:41:20+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jennifer Senior', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Senior', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6445eaf9-0bae-54fe-a5e7-c393631ecbee', 'word_count': 1398, 'uri': 'nyt://article/6445eaf9-0bae-54fe-a5e7-c393631ecbee'}, {'abstract': 'For the music video for “Some Winters,” which debuts here, the singer-songwriter Natalie Mering created a tale as fantastical as her pretty, distorted sound.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/10/09/weyes-blood-some-winters-video/', 'snippet': 'For the music video for “Some Winters,” which debuts here, the singer-songwriter Natalie Mering created a tale as fantastical as her pretty, distorted sound.', 'lead_paragraph': 'The video for the “Some Winters,” a haunting, warped-out single from Weyes Blood’s forthcoming album “The Innocents” (out Oct. 21 on Mexican Summer), has a lot in common with the song itself: location, for starters. “It was a little bit of a life parallel,” Natalie Mering, the 25-year-old singer-songwriter who records under the Weyes Blood name, says. “It was just kind of creepy and secluded, and it’s similar to the actual setting of the song; I used to live in a place very similar to that, in the middle of nowhere.” Mering has since moved from rural Kentucky, where she learned about herbal medicine, to New York City. “Mostly I just go from one neighborhood to the next,” she says, though she is currently based in Bushwick. “I kind of have an allegiance to the city, but I don’t love Brooklyn.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/t-magazine/09hartman-weyesblood/09hartman-weyesblood-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/09/t-magazine/09hartman-weyesblood/09hartman-weyesblood-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/t-magazine/09hartman-weyesblood/09hartman-weyesblood-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/t-magazine/09hartman-weyesblood/09hartman-weyesblood-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/t-magazine/09hartman-weyesblood/09hartman-weyesblood-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/09/t-magazine/09hartman-weyesblood/09hartman-weyesblood-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/09/t-magazine/09hartman-weyesblood/09hartman-weyesblood-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Dreamlike New Video From the Indie-Folk Chanteuse Weyes Blood', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mering, Natalie (Weyes Blood)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Saugerties (NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-09T19:45:50+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Alexandria Symonds', 'person': [{'firstname': 'Alexandria', 'middlename': None, 'lastname': 'Symonds', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/262446db-88c5-52e5-9c9f-e5c2c4ee38f5', 'word_count': 325, 'uri': 'nyt://article/262446db-88c5-52e5-9c9f-e5c2c4ee38f5'}, {'abstract': 'Katha Pollitt argues that women should stop apologizing and reclaim abortion as a “positive social good.”', 'web_url': 'https://www.nytimes.com/2014/10/12/books/review/katha-pollitt-pro-reclaiming-abortion-rights-review.html', 'snippet': 'Katha Pollitt argues that women should stop apologizing and reclaim abortion as a “positive social good.”', 'lead_paragraph': '“I never had an abortion, but my mother did. She didn’t tell me about it, but from what I pieced together after her death from a line in her F.B.I. file, which my father, the old radical, had requested along with his own, it was in 1960, so like almost all abortions back then, it was illegal.”', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-Jeffery-syb/1012-bks-Jeffery-syb-articleLarge.jpg', 'height': 540, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/12/books/review/1012-bks-Jeffery-syb/1012-bks-Jeffery-syb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 540}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-Jeffery-syb/1012-bks-Jeffery-syb-jumbo.jpg', 'height': 922, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/12/books/review/1012-bks-Jeffery-syb/1012-bks-Jeffery-syb-superJumbo.jpg', 'height': 1289, 'width': 1431, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtyp