'main': 'Canada’s La Belle Province', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Charlevoix (Canada)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Montreal (Quebec)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Quebec Province (Canada)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-10-17T09:00:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Laurence Butet-Roch', 'person': [{'firstname': 'Laurence', 'middlename': None, 'lastname': 'Butet-Roch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f227c129-0383-5466-a0e6-081da769e5da', 'word_count': 795, 'uri': 'nyt://article/f227c129-0383-5466-a0e6-081da769e5da'}, {'abstract': 'Are you an avid video game player? Do you feel the industry and culture of the gaming world is dominated by men and boys? If so, what effects of that have you seen?', 'web_url': 'https://learning.blogs.nytimes.com/2014/10/17/how-sexist-is-the-gaming-world/', 'snippet': 'Are you an avid video game player? Do you feel the industry and culture of the gaming world is dominated by men and boys? If so, what effects of that have you seen?', 'lead_paragraph': 'Are you an avid video game player? Do you feel the industry and culture of the gaming world is dominated by men and boys? If so, what effects of that have you experienced?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Sexist Is the Gaming World?', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None,