9:11+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Bill Cunningham', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Cunningham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/915dfb86-62ea-51f0-afd3-cf38dd5a11ed', 'word_count': 64, 'uri': 'nyt://article/915dfb86-62ea-51f0-afd3-cf38dd5a11ed'}, {'abstract': 'The fourth Arthur L. Loeb Cup tournament was held at, and raised $70,000 for, the Lenox Hill Neighborhood House on the East Side of Manhattan.', 'web_url': 'https://www.nytimes.com/2014/10/04/crosswords/bridge/bridge-play-from-the-arthur-l-loeb-cup.html', 'snippet': 'The fourth Arthur L. Loeb Cup tournament was held at, and raised $70,000 for, the Lenox Hill Neighborhood House on the East Side of Manhattan.', 'lead_paragraph': 'The fourth Arthur L. Loeb Cup tournament was played on Sept. 23. It was held at, and raised $70,000 for, the Lenox Hill Neighborhood House on the East Side of Manhattan.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bridge Play From the Arthur L. Loeb Cup', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bridge (Card Game)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Lenox Hill Neighborhood House', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cards and Card Games', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-10-03T22:21:30+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Crosswords & Games', 'subsection_name': 'Bridge', 'byline': {'original': 'By Phillip Alder', 'person': [{'firstname': 'Phillip', 'middlename': None, 'lastname': 'Alder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank'