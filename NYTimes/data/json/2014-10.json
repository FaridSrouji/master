-91d3-165b93d8aa8f'}, {'abstract': 'The number of homeless people across the country fell this year, but in New York City the homeless population continued to swell, according to an annual federal survey.', 'web_url': 'https://www.nytimes.com/2014/10/31/nyregion/homelessness-rose-in-new-york.html', 'snippet': 'The number of homeless people across the country fell this year, but in New York City the homeless population continued to swell, according to an annual federal survey.', 'lead_paragraph': 'The number of homeless people living on the streets and in shelters across the country fell this year, according to an annual federal survey released on Thursday. But in New York City, the homeless population continued to grow, swelling in almost every category: individuals, families and the chronically homeless.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Homelessness Rose in New York', 'kicker': None, 'content_kicker': None, 'print_headline': 'Homelessness Rose in New York', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homeless Persons', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schlossberg, Tatiana', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Housing and Urban Development Department', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-10-31T01:49:24+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Tatiana Schlossberg', 'person': [{'firstname': 'Tatiana', 'middlename': None, 'lastname': 'Schlossberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a29b5aa-9fb8-582e-a4f4-2384420bd758', 'word_count': 393, 'uri': 'nyt:/