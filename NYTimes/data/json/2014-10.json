ition: Testing the Other Side', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cyberwarfare', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cold War Era', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'North Atlantic Treaty Organization', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Industrial Espionage', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-10-31T02:08:20+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By David E. Sanger and Nicole Perlroth', 'person': [{'firstname': 'David', 'middlename': 'E.', 'lastname': 'Sanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Nicole', 'middlename': None, 'lastname': 'Perlroth', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8b8d816-5a36-54d6-84f2-9f9915649fa3', 'word_count': 1099, 'uri': 'nyt://article/e8b8d816-5a36-54d6-84f2-9f9915649fa3'}, {'abstract': 'Is this Halloween tradition meant to be a local neighborhood event, or a bridge to other communities? Or is it just about free candy?', 'web_url': 'https://www.nytimes.com/roomfordebate/2014/10/30/whats-the-point-of-trick-or-treating', 'snippet': 'Is this Halloween tradition meant to be a local neighborhood event, or a bridge to other communities? Or is it just about free candy?', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url'