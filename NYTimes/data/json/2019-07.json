: None}, 'keywords': [{'name': 'persons', 'value': 'Chamberlain, Emma (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-07-09T09:00:07+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Jonah Engel Bromwich', 'person': [{'firstname': 'Jonah', 'middlename': 'Engel', 'lastname': 'Bromwich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a4337f78-f40c-5b4b-8d60-67ff0e38b8e5', 'word_count': 2124, 'uri': 'nyt://article/a4337f78-f40c-5b4b-8d60-67ff0e38b8e5'}, {'abstract': 'A simple cure for solipsism.', 'web_url': 'https://www.nytimes.com/2019/07/09/magazine/letter-of-recommendation-bird-feeders.html', 'snippet': 'A simple cure for solipsism.', 'lead_paragraph': 'Last year, as often happens, my mood waned with the autumn light. At work, I stared blankly at my computer, inexplicably on the verge of tears. At home, I counted the minutes until I could sleep. I still woke early, intending to read and write, but instead lay on the couch, idly thumbing at my phone. I felt numb to the world. My psychiatrist adjusted my medication and suggested I invest in a light-therapy lamp. “Winter is coming,” he said without a hint of irony.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/14/magazine/14mag-LOR-Bird-Feeders/73aac0fd625b4b9c8d269ad2881813b1-articleLarge.jpg', 'height': 437, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/14/magazine/14mag-LOR-Bird-Feeders/73aac