e': 'persons', 'value': 'Hawley, Josh D (1979- )', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-07-27T18:31:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Sunday Review', 'byline': {'original': 'By Clay Risen', 'person': [{'firstname': 'Clay', 'middlename': None, 'lastname': 'Risen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/148b2caa-0093-5a59-b15e-0393c4138487', 'word_count': 1291, 'uri': 'nyt://article/148b2caa-0093-5a59-b15e-0393c4138487'}, {'abstract': 'Impeaching Trump might be right, but it’s wrong.', 'web_url': 'https://www.nytimes.com/2019/07/27/opinion/sunday/maureen-dowd-trump-impeachment.html', 'snippet': 'Impeaching Trump might be right, but it’s wrong.', 'lead_paragraph': 'WASHINGTON — After I interviewed Nancy Pelosi a few weeks ago, The HuffPost huffed that we were Dreaded Elites because we were eating chocolates and — horror of horrors — the speaker had on some good pumps.', 'print_section': 'SR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/28/opinion/sunday/28Dowd/merlin_158430324_bc4c8774-f462-4d5c-9914-a13279396c9d-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/28/opinion/sunday/28Dowd/merlin_158430324_bc4c8774-f462-4d5c-9914-a13279396c9d-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/28/opinion/sunday/28Dowd/merlin_158430324_bc4c8774-f462-4d5c-9914-a13279396c9d-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019