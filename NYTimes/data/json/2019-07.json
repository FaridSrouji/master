/arts/09-black-auteurs-streaming/09-black-auteurs-streaming-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/09/arts/09-black-auteurs-streaming/09-black-auteurs-streaming-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/09/arts/09-black-auteurs-streaming/09-black-auteurs-streaming-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/09/arts/09-black-auteurs-streaming/09-black-auteurs-streaming-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/09/arts/09-black-auteurs-streaming/09-black-auteurs-streaming-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Where to Stream the ’90s Black Film Boom', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, Darnell', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Witcher, Theodore', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Harris, Leslie (1959- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Dickerson, Ernest', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Rich, Matty', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Dash, Julie', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-07-11T18:58:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'orig