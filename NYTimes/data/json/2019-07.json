ida Tlaib of Michigan, and me, from Minnesota.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/opinion/25Omar/merlin_158029707_2d56671f-7a9f-4f43-9924-638ac10c5138-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/25/opinion/25Omar/merlin_158029707_2d56671f-7a9f-4f43-9924-638ac10c5138-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/opinion/25Omar/merlin_158029707_2d56671f-7a9f-4f43-9924-638ac10c5138-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/opinion/25Omar/merlin_158029707_2d56671f-7a9f-4f43-9924-638ac10c5138-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/opinion/25Omar/25Omar-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/25/opinion/25Omar/25Omar-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/opinion/25Omar/25Omar-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ilhan Omar: It Is Not Enough to Condemn Trump’s Racism', 'kicker': None, 'content_kicker': None, 'print_headline': 'Push Back Against Trump’s Racism', 'name': None, 'seo': None, 'sub': None}, 'keywords': 