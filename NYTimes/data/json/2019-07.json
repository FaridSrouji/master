None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Birds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'AMBER', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Endangered and Extinct Species', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Paleontology', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fossils', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Myanmar', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Current Biology (Journal)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Xing, Lida', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': "O'Connor, Jingmai", 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-science', 'rank': 10, 'major': 'N'}], 'pub_date': '2019-07-11T15:14:14+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Becky Ferreira', 'person': [{'firstname': 'Becky', 'middlename': None, 'lastname': 'Ferreira', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/df7d9cef-721c-5f24-9163-2467ba7088a6', 'word_count': 618, 'uri': 'nyt://article/df7d9cef-721c-5f24-9163-2467ba7088a6'}, {'abstract': 'The political ground shifts dangerously beneath the solid foundations of a seemingly upright lawyer in 1970s Argentina.', 'web_url': 'https://www.nytimes.com/2019/07/11/movies/rojo-review.html', 'snippet': 'The political ground shifts dangerously beneath the solid foundations of a seemingly upright lawyer in 1970s Argentina.', 'lead_paragraph': 'When a country falls under a dictatorship, who is guilty — or, rather, who is not? That’s the question that beats a steady rhythm — tap, tap, tap — throughout the striking moral thriller “Rojo,” a vision of everyday life in mid-1970s Argentina. For a solid citizen like Claudio (Darío Grandinetti) that life looks entirely respectable, nice and quiet. He has a contented family, his own law firm and a handsome house. There, he and his wife sometimes entertain, eating cake and playing board games while pointedly avoiding any talk about state terror and disappearing compatriots.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11rojopix/merlin_157527645_c514e78a-8f7f-4095-bbe2-cf91d43c645b-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/12/arts/11rojopix/merlin_157527645_c514e78a-8f7f-4095-bbe2-cf91d43c645b-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11rojopix/merlin_157527645_c514e78a-8f7f-4095-bbe2-cf91d43c645b-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11rojopix/merlin_157527645_c514e78a-8f7f-4095-bbe2-cf91d43c645b-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11rojopix/11rojopix-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/12/arts/11rojopix/11rojopix-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11rojopix/11rojopix-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Rojo’ Rev