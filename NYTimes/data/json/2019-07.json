ice not to charge.', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/25/world/00hk-celebrities-1-promo/merlin_156675894_d67d1a09-00d0-4f0c-a5e0-b6ab09e5f19e-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/06/25/world/00hk-celebrities-1-promo/merlin_156675894_d67d1a09-00d0-4f0c-a5e0-b6ab09e5f19e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/25/world/00hk-celebrities-1-promo/merlin_156675894_d67d1a09-00d0-4f0c-a5e0-b6ab09e5f19e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/25/world/00hk-celebrities-1-promo/merlin_156675894_d67d1a09-00d0-4f0c-a5e0-b6ab09e5f19e-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/25/world/00hk-celebrities-1-promo/00hk-celebrities-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/06/25/world/00hk-celebrities-1-promo/00hk-celebrities-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/25/world/00hk-celebrities-1-promo/00hk-celebrities-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Denise Ho, Jackie Chan and Others Think About the Hong Kong Protests', 'kicker':