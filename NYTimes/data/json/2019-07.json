eb/21greenhouseWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/21/opinion/21greenhouseWeb/21greenhouseWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/21greenhouseWeb/21greenhouseWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Invisible Hand of Justice Stevens on Abortion', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Invisible Hand on Abortion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Roe v Wade (Supreme Court Decision)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Religion', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Planned Parenthood Federation of America', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kennedy, Anthony M', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': "O'Connor, Sandra Day", 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Stevens, John Paul', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Guantanamo Bay Naval Base (Cuba)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Indiana', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Minnesota', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Missouri', 'rank': 14, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 15, 'major': 'N'}], 'pub_date': '2019-07-20T18:30:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Linda Greenhouse', 'person': [{'firstname': 'Linda', 'middlename': None, 'lastname': 'Greenhouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/afd34bfe-91ce-545b-b1a1-956079fe68dc', 'word_count': 1212, 'uri': 'nyt://article/afd34bfe-91ce-545b-b1a1-956079fe68dc'}, {'abstract': 'Online, that’s what men say they want from women. Do they know nothing about life?', 'web_url': 'https://www.nytimes.com/2019/07/20/opinion/sunday/tinder-bumble-okcupid-drama.html', 'snippet': 'Online, that’s what men say they want from women. Do they know nothing about life?', 'lead_paragraph': 'I was recently on the dating app Bumble when I came across the profile of an attractive middle-aged man, a few years younger than I am. He was born on the East Coast and had a big dog, which I liked. But then I read that he was “100 percent drama-free” and demanded that any dates be the same way. I thought, “Here’s somebody who probably won’t listen if I’m having a bad day” and swiped left to indicate my lack of interest.', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/sunday/21hilgers/21hilgers-articleLarge.jpg', 'height': 691, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/21/opinion/sunday/21hilgers/21hilgers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 691}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/sunday/21hilgers/21hilgers-jumbo.jpg', 'height': 1024, 'width': 890, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype':