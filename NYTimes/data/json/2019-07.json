/18/science/18liquidmagnets-2/merlin_158089833_1b76c992-0819-41de-b275-85646fd6ad51-articleLarge.jpg', 'height': 375, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/18/science/18liquidmagnets-2/merlin_158089833_1b76c992-0819-41de-b275-85646fd6ad51-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 375}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/18/science/18liquidmagnets-2/merlin_158089833_1b76c992-0819-41de-b275-85646fd6ad51-jumbo.jpg', 'height': 640, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/18/science/18liquidmagnets-2/merlin_158089833_1b76c992-0819-41de-b275-85646fd6ad51-superJumbo.jpg', 'height': 800, 'width': 1280, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/18/science/18liquidmagnets-2/18liquidmagnets-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/18/science/18liquidmagnets-2/18liquidmagnets-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/18/science/18liquidmagnets-2/18liquidmagnets-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'This New Liquid Is Magnetic, and Mesmerizing', 'kicker': 'Trilobites', 'content_kicker': None, 'print_headline': 'Reserachers With Pull: This New Liquid  Is Magnetic, And Mesmerizing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Nanotechnology', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Magnets and Magnetism', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Science (Journal)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Russell, Thomas P', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Massachusetts Amherst', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-science', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-07-18T18:00:06+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Knvul Sheikh', 'person': [{'firstname': 'Knvul', 'middlename': None, 'lastname': 'Sheikh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1dc55e85-028e-58c2-b97e-0a0cf0b336d8', 'word_count': 505, 'uri': 'nyt://article/1dc55e85-028e-58c2-b97e-0a0cf0b336d8'}, {'abstract': 'Peter Orner, author of “Maggie Brown & Others,” on a writer who specializes in “American oddness.”', 'web_url': 'https://www.nytimes.com/2019/07/18/books/enthusiast-wright-morris-peter-orner.html', 'snippet': 'Peter Orner, author of “Maggie Brown & Others,” on a writer who specializes in “American oddness.”', 'lead_paragraph': 'The mystery of Wright Morris isn’t why he’s so forgotten, it’s that he was ever much known in the first place. Because it’s true that Morris was, if never a household literary name, at least mentioned among (need I say it?) the male literary heavyweights of his day. A finalist for the National Book Award numerous times, Morris won it twice, in 1957 for “Field of Vision,” and in 1980 for his final novel, “Plains Song.” A celebrated photographer as well, Morris’s work was exhibited at the Museum of Modern Art as early as 1941. All told, between 1942 and 1986, Morris published 33 books, including novels, prose fiction and photographs (what he referred to as photo-texts), essay and story collections, and memoirs. A Nebraska native, Wright Morris spent much of his life in California remembering, and more important, reimagining, the Midwest. He died in 1998 at the age of 88.', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/19/obituaries/19EnthusiastWright/merlin_157721013_e6319bea-8bf3-40e0-b981-dce2cda4c095-articleLarge.jpg', 'height': 764, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/19/obituaries/19EnthusiastWright/merlin_157721013_e6319bea-8bf3-40e0-b981-dce2cda4c095-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 764}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/19/obituaries/19EnthusiastWright/merlin_157721013_e6319bea-8bf3-40e0-b981-dce2cda4c095-jumbo.jpg', 'height': 1024, 'width': 804, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/19/obituaries/19EnthusiastWright/merlin_157721013_e6319bea-8bf3-40e0-b981-dce2cda4c095-superJumbo.jpg', 'height': 1869, 'width': 1467, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/19/obituaries/19EnthusiastWright/12EnthusiastWright-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/19/obituaries/19EnthusiastWright/12EnthusiastWright-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/19/obituaries/19EnthusiastWright/12EnthusiastWright-thumbLarge.jpg', 'height': 150, 'width': 150, '