/2019/07/01/world/00hongkong-promises-1sub/00hongkong-promises-1sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/01/world/00hongkong-promises-1sub/00hongkong-promises-1sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'On Hong Kong Handover Anniversary, Many Fear Loss of Freedoms', 'kicker': 'PROMISES MADE', 'content_kicker': None, 'print_headline': 'A City Clinging Fiercely to a Tenuous Independence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Hong Kong', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lam, Carrie (1957- )', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Extradition', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 10, 'major': 'N'}], 'pub_date': '2019-07-01T09:00:15+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Austin Ramzy', 'person': [{'firstname': 'Austin', 'middlename': None, 'lastname': 'Ramzy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/546a6a06-5b2f-5034-89b9-3efa00cf4255', 'word_count': 1703, 'uri': 'nyt://article/546a6a06-5b2f-5034-89b9-3efa00cf4255'}, {'abstract': 'Surfboard-packed waves, New York City views and fish tacos galore, all just a subway (or ferry) ride from Manhattan.', 'web_url': 'https://www.nytimes.com/2019/07/01/travel/what-to-do-36-hours-in-rockaway-beach-queens.html', 'snippet': 'Surfboard-packed waves, New York City views and fish tacos galore, all just a subway (or ferry) ride from Manhattan.', 'lead_paragraph': 'It’s been seven years since Hurricane Sandy decimated this barrier peninsula on the southern edge of Queens, tearing the boardwalk from its moorings and scattering debris across the peninsula. But as the scars heal, the working-class neighborhood of Rockaway Beach has transformed from one of the city’s best-kept secrets to a destination beach town, where the D.F.D.’s (“down for the day” in local speak) are packed towel to towel along the expansive shoreline. The weekend A train (yes, this beach is subway-accessible) is often packed with sandy chairs and surfboards, while beach-bag-toting Manhattanites line Pier 11 in the Financial District waiting for a ferry. Indeed, the once-grungy surf town is now a cocktail of bohemia and gentrification, where the urban buzz can feel both immediate and worlds away.', 'print_section': 'TR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/07/travel/04Hours-Rockaway-Queens3/merlin_156944274_1fb5102b-9e72-4e98-b3e2-8269c534fd5c-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/07/travel/04Hours-Rockaway-Queens3/merlin_156944274_1fb5102b-9e72-4e98-b3e2-8269c534fd5c-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/07/travel/04Hours-Rockaway-Queens3/merlin_156944274_1fb5102b-9e72-4e98