ages/2019/07/22/world/22nz-guns/22nz-guns-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/world/22nz-guns/22nz-guns-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Zealand Plans New Round of Gun Restrictions, Including Registry', 'kicker': None, 'content_kicker': None, 'print_headline': 'New Zealand Makes Plans  For 2nd Batch of Gun Laws', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Christchurch, New Zealand, Attack (March 2019)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ardern, Jacinda', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mosques', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Christchurch (New Zealand)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Tarrant, Brenton Harrison', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 10, 'major': 'N'}], 'pub_date': '2019-07-22T09:55:48+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Charlotte Graham-McLay', 'person': [{'firstname': 'Charlotte', 'middlename': None, 'lastname': 'Graham-McLay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92e4724c-549a-5652-866f-7af44b75cf6a', 'word_count': 695, 'uri': 'nyt://article/92e4724c-549a-5652-866f-7af44b75cf6a'}, {'abstract': 'A new study suggests that restoring forests could help reverse global warming.', 'web_url': 'https://www.nytimes.com/2019/07/22/opinion/trees-global-warming.html', 'snippet': 'A new study suggests that restoring forests could help reverse global warming.', 'lead_paragraph': 'NASHVILLE — My whole family was watching the HBO series “Chernobyl” when a big sugar maple tree in our front yard split in half, falling a few feet short of the corner of the house. We didn’t hear the actual crash, perhaps because the storm that took out the tree was already so loud, perhaps because the dramatized cataclysm on the television in our family room was louder still, or at least more absorbing. The branch-whipping wind outside the house functioned like a howling soundtrack for the show. We were focused on the imminent irradiation of Europe when we should have been crouched in our safe place in Tennessee, it turns out, wearing our bike helmets for good measure.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22renklWeb/merlin_154110252_9fcb2056-22c0-4bfc-9f60-555e47bed4bb-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/22/opinion/22renklWeb/merlin_154110252_9fcb2056-22c0-4bfc-9f60-555e47bed4bb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22renklWeb/merlin_154110252_9fcb2056-22c0-4bfc-9f60-555e47bed4bb-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22renklWeb/merlin_154110252_9fcb2056-22c0-4bfc-9f60-555e47bed4bb-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22renklWeb/22renklWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/22/opinion/22renklWeb/22renklWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22renklWeb/22renklWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Trees Might Save Us Yet', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Trees Might Save Us Yet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Trees and Shrubs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-07-22T10:00:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Renkl', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Renkl', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6f772367-332a-5f6a-88b4-72064db20b0b', 'word_count': 1268, 'uri': 'nyt://article/6f772367-332a-5f6a-88b4-72064db20b0b'}, {'abstract': 'The president and his followers lack the moral authority to tell anyone to leave this country because they are not indigenous to this land.', 'web_url': 'https://www.nytimes.com/2019/07/22/opinion/trump-immigration-native-americans.html', 'snippet': 'The president and his followers lack the moral authority to tell anyone to leave this country because they are not indigenous to this land.', 'lead_paragraph': 'Last week President Trump told four of my colleagues to “go back” to where they came from — even though all are American citizens, and only one is an immigrant. But Mr. Trump has somewhere to “go back” to as well: He is a second-generation American. For Native Americans like myself, his comments are perplexing, and wrongheaded. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22haalandWeb/merlin_105605488_c7229182-e22d-4f6f-bc2b-92fe4c65c3d5-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/22/opinion/22haalandWeb/merlin_105605488_c7229182-e22d-4f6f-bc2b-92fe4c65c3d5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22haalandWeb/merlin_105605488_c7229182-e22d-4f6f-bc2b-92fe4c65c3d5-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22haalandWeb/merlin_105605488_c7229182-e22d-4f6f-bc2b-92fe4c65c3d5-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/22/opinion/22haalandWeb/22haalandWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/22/opinion/22haalandWeb/22haalandWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type':