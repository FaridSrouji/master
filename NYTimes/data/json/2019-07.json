-jumbo-v2.jpg', 'height': 510, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11swordoftrust/11swordoftrust-superJumbo-v2.jpg', 'height': 955, 'width': 1918, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11swordoftrust/11swordoftrust-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/12/arts/11swordoftrust/11swordoftrust-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/12/arts/11swordoftrust/11swordoftrust-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Sword of Trust’ Review: Marc Maron in a Comedy About Civil War Truthers', 'kicker': 'Critic’s Pick', 'content_kicker': None, 'print_headline': 'Civil War Sword Propels A Quest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Sword of Trust (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Shelton, Lynn', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Maron, Marc', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Watkins, Michaela', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-07-11T11:00:05+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Glenn Kenny', 'person': [{'firstname': 'Glenn', 'middlename': None, 'lastname': 'Kenny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None