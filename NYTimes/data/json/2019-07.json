equality', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Longview (Tex)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Urban Areas', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Economic Innovation Group', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve Bank of Dallas', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Brewers Assn', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Austin (Tex)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Dallas (Tex)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Houston (Tex)', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'San Antonio (Tex)', 'rank': 12, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 13, 'major': 'N'}], 'pub_date': '2019-07-07T18:13:12+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Jim Tankersley', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Tankersley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd044f8d-d711-54c5-8ef1-490e435d3b3d', 'word_count': 1511, 'uri': 'nyt://article/dd044f8d-d711-54c5-8ef1-490e435d3b3d'}, {'abstract': 'The political clout and incentives of the state’s big power companies have discouraged installation of rooftop solar panels.', 'web_url': 'https://www.nytimes.com/2019/07/07/business/energy-environment/florida-solar-power.html', 'snippet': 'The political clout and incentives of the state’s big power companies have discouraged installation of rooftop solar panels.', 'lead_paragraph': 'ST. PETERSBURG, Fla. — Florida calls itself the Sunshine State. But when it comes to the use of solar power, it trails 19 states, including not-so-sunny Mass