kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADOPTIONS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Korean-Americans', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-07-23T19:22:51+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Glenn Morey and Julie Morey', 'person': [{'firstname': 'Glenn', 'middlename': None, 'lastname': 'Morey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Julie', 'middlename': None, 'lastname': 'Morey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/49ddd2ef-3964-53d5-8931-51b23dc1ccc7', 'word_count': 0, 'uri': 'nyt://video/49ddd2ef-3964-53d5-8931-51b23dc1ccc7'}, {'abstract': '“One of the last things that my grandmother said was, ‘When you grow up, come visit me.’”', 'web_url': 'https://www.nytimes.com/2019/07/23/opinion/korean-adoptees.html', 'snippet': '“One of the last things that my grandmother said was, ‘When you grow up, come visit me.’”', 'lead_paragraph': 'Fifty-nine years ago, Glenn was an orphan in Seoul, South Korea, abandoned as a newborn. He doesn’t know by whom, where or why. But he wound up one baby, out of roughly two million infants and children who were orphaned or somehow separated from their families of origin in the aftermath of the Korean War. This stream of homeless Korean children continued over the next 60-plus years, the consequences of hunger and poverty, social stigma and racial bigotry, broken marriages and untimely death.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Given Away: Korean Adoptees Share Their Stories', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADOPTIONS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Orphans and Orphanages', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-07-23T19:23:34+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Glenn Morey and Julie Morey', 'person': [{'firstname': 'Glenn', 'middlename': None, 'lastname': 'Morey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Julie', 'middlename': None, 'lastname': 'Morey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/101aca7d-6518-5ea5-bfd4-2673315422cc', 'word_count': 481, 'uri': 'nyt://article/101aca7d-6518-5ea5-bfd4-2673315422cc'}, {'abstract': 'Computer scientists have developed an algorithm that can pick out almost any American in databases supposedly stripped of personal information.', 'web_url': 'https://www.nytimes.com/2019/07/23/health/data-privacy-protection.html', 'snippet': 'Computer scientists have developed an algorithm that can pick out almost any American in databases supposedly stripped of personal information.', 'lead_paragraph': 'Your medical records might be used for scientific research. But don’t worry, you’re told — personally identifying data were removed.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/23/science/23PRIVACY/23PRIVACY-articleLarge.jpg', 'height'