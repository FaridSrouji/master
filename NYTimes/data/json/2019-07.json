aries/00ponsot-image1/00ponsot-image1-articleLarge.jpg', 'height': 657, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/08/obituaries/00ponsot-image1/00ponsot-image1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 657}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/08/obituaries/00ponsot-image1/00ponsot-image1-jumbo.jpg', 'height': 1024, 'width': 936, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/08/obituaries/00ponsot-image1/00ponsot-image1-superJumbo.jpg', 'height': 1095, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/08/obituaries/00ponsot-image1/00ponsot-image1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/08/obituaries/00ponsot-image1/00ponsot-image1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/08/obituaries/00ponsot-image1/00ponsot-image1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Marie Ponsot, Poet of Love, Divorce and Family, Dies at 98', 'kicker': None, 'content_kicker': None, 'print_headline': 'Marie Ponsot, 98, Poet Of Love and Family, Dies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poetry and Poets', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'De