ank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'NBCUniversal', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Tokyo (Japan)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-07-25T15:00:06+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Kevin Draper', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'Draper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/12cdc969-3420-598f-84e0-48c6445b3fe4', 'word_count': 560, 'uri': 'nyt://article/12cdc969-3420-598f-84e0-48c6445b3fe4'}, {'abstract': 'When my husband died, I was soothed by the hand-designed furniture he left behind. Eventually, some of it had to go.', 'web_url': 'https://www.nytimes.com/2019/07/25/style/letting-go-of-the-sentimental-but-uncomfortable-couch.html', 'snippet': 'When my husband died, I was soothed by the hand-designed furniture he left behind. Eventually, some of it had to go.', 'lead_paragraph': 'In my family, the old saying “The shoemaker’s daughter goes barefoot” had special meaning. My mother and father manufactured high-fashion women’s shoes sold in Bloomingdale’s and Saks, while I opted to wear construction boots or clogs on most days. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/fashion/25RITES/25RITES-articleLarge.jpg', 'height': 212, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/25/fashion/25RITES/25RITES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 212}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/fashion/25RITES/25RITES-jumbo.jpg', 'height': 362, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/fashion/25RITES/25RITES-superJumbo.jpg', 'height': 724, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/fashion/25RITES/25RITES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/25/fashion/25RITES/25RITES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/25/fashion/25RITES/25RITES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Letting Go of the Sentimental but Not Very Comfortable Couch', 'kicker': 'Rites of passage', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Furniture', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-selfcare', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-07-25T15:04:37+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Joan Lebow', 'person': [{'firstname': 'Joan', 'middlename': None, 'lastname': 'Lebow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None