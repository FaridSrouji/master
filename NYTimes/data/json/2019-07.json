: 'N'}], 'pub_date': '2019-07-31T09:00:12+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Alexander Burns', 'person': [{'firstname': 'Alexander', 'middlename': None, 'lastname': 'Burns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6a43e8a8-6f0e-58ab-add7-3a3b2123f107', 'word_count': 5504, 'uri': 'nyt://article/6a43e8a8-6f0e-58ab-add7-3a3b2123f107'}, {'abstract': 'After two and a half decades, the acclaimed band ventures into a different sound on its ninth album, “The Center Won’t Hold” —\xa0and moves onward without its longtime drummer.', 'web_url': 'https://www.nytimes.com/2019/07/31/arts/music/sleater-kinney-st-vincent.html', 'snippet': 'After two and a half decades, the acclaimed band ventures into a different sound on its ninth album, “The Center Won’t Hold” —\xa0and moves onward without its longtime drummer.', 'lead_paragraph': 'WEST HOLLYWOOD, Calif. — When Sleater-Kinney arrived in a Los Angeles studio last fall with the slim demo of a track for its upcoming album, the group’s new producer, Annie Clark (better known as St. Vincent) had an ear for how to amplify it. What if, she said to the group — the singer-guitarists Carrie Brownstein and Corin Tucker, and the drummer Janet Weiss — you took Brownstein’s guitar riff and made it the lead? Oh, and also, changed the key. And the lyrics.', 'print_section': 'AR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/06/arts/04sleater-kinney-cover/merlin_157814253_e1669992-e985-4280-8310-cb34d637f84e-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/06/arts/04sleater-kinney-cover/merlin_157814253_e1669992-e985-4280-8310-cb34d637f84e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/06/arts/04sleater-kinney-cover/merlin_157814253_e1669992-e985-4280-8310-cb34d637f84e-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/06/arts/04sleater-kinney-cover/merlin_157814253_e1669992-e985-4280-8310-cb34d637f84e-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/06/arts/04sleater-kinney-cover/04sleater-kinney-cover-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/10/06/arts/04sleater-kinney-cover/04sleater-kinney-cover-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/06/arts/04sleater-kinney-cover/04sleater-kinney-cover-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sleater-Kinney Asked St. Vincent for a Creative Spark. The Trio Blew Up.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Creative Sparks Fly. A Drummer Leaves.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sleater-Kinney', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brownstein, Carrie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'St Vincent (1982- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Tucker, Corin', 'ra