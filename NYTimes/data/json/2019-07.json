rganizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-07-24T10:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Doug Collins', 'person': [{'firstname': 'Doug', 'middlename': None, 'lastname': 'Collins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/40c487c4-fa44-5ea0-8ea9-46130dc2e599', 'word_count': 882, 'uri': 'nyt://article/40c487c4-fa44-5ea0-8ea9-46130dc2e599'}, {'abstract': 'It’s motivated by deep hostility. That’s the only coherent thing about it.', 'web_url': 'https://www.nytimes.com/2019/07/24/opinion/trump-poverty-policy.html', 'snippet': 'It’s motivated by deep hostility. That’s the only coherent thing about it.', 'lead_paragraph': 'On Tuesday, the Trump administration announced proposed rules that would cut more than three million people off food assistance. This latest plan confirms what many have long suspected: The only thing unifying its policies on poverty is cruelty. Prior right-wing assaults on the poor at least claimed some semblance of a coherent theme. In contrast, this proposal, and earlier ones, are a grab-bag of mutually inconsistent ideas seemingly selected only to maximize harm.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/24/opinion/24super/24super-articleLarge.jpg', 'height': 560, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/24/opinion/24super/24super-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 560}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'i