icker': None, 'print_headline': 'Sanders Takes Center Stage, Along With the Bill He Wrote', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Debates (Political)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sanders, Bernard', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-07-31T03:35:50+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/089caaf0-d077-5b3a-9e6e-7043bde6ccd8', 'word_count': 1130, 'uri': 'nyt://article/089caaf0-d077-5b3a-9e6e-7043bde6ccd8'}, {'abstract': 'The candidates sparred angrily over whether to wipe out private health insurance and institute a government-run health system.', 'web_url': 'https://www.nytimes.com/2019/07/30/health/democratic-debate-health-medicare.html', 'snippet': 'The candidates sparred angrily over whether to wipe out private health insurance and institute a government-run health system.', 'lead_paragraph': 'WASHINGTON — It took only one question — the very first — in Tuesday night’s Democratic presidential primary debate to make it clear that the issue that united the party in last year’s congressional elections in many ways now divides it.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/30/us/politics/30debates-healthcare/30debates-healthcare-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_na