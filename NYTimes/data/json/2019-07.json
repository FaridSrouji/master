edia': [], 'headline': {'main': 'Mets Open Series With Victory Over Twins', 'kicker': 'Mets 3, Twins 2', 'content_kicker': None, 'print_headline': 'Mets Open Series With Victory Over Twins', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Minnesota Twins', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-07-17T04:50:24+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Field Level Media', 'person': [{'firstname': 'Field', 'middlename': 'Level', 'lastname': 'Media', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e2d5247d-25db-5066-adec-e28bcf74091e', 'word_count': 431, 'uri': 'nyt://article/e2d5247d-25db-5066-adec-e28bcf74091e'}, {'abstract': 'The long-running legal drama begins its final season, and a British reggae classic is available to stream.', 'web_url': 'https://www.nytimes.com/2019/07/17/arts/television/whats-on-tv-wednesday-suits-and-babylon.html', 'snippet': 'The long-running legal drama begins its final season, and a British reggae classic is available to stream.', 'lead_paragraph': 'SUITS 9 p.m. on USA Network. This long-running legal drama begins its ninth and final season. Since the departure of Mike Ross (Patrick J. Adams), his wife, Rachel Zane (Meghan Markle), and the law firm’s head honcho, Jessica Pearson (Gina Torres) in Season 7, fans have watched the series mainstays, Harvey Specter (Gabriel Macht), Louis Litt (Rick Hoffman) and Donna Paulsen (Sarah Rafferty) vie for control of the firm. And while the Duchess of Sussex will in all likelihood not be back, fans can expect to see Adams return as a guest star in the show’s final 10 episodes.', 'print_section': 'C', 'pr