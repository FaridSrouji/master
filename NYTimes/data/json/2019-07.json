'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Thiel, Peter A', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-07-16T09:57:09+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/af6902f0-8cb2-5155-a6b8-2f7e46755282', 'word_count': 1105, 'uri': 'nyt://article/af6902f0-8cb2-5155-a6b8-2f7e46755282'}, {'abstract': 'Each chapter of David Szalay’s new novel picks up from the last, presenting a new protagonist traveling by flight.', 'web_url': 'https://www.nytimes.com/2019/07/16/books/review-turbulence-david-szalay.html', 'snippet': 'Each chapter of David Szalay’s new novel picks up from the last, presenting a new protagonist traveling by flight.', 'lead_paragraph': 'It’s possible to say something about someone’s economic and class status — their privilege, to lay down a more woke signifier — by their familiarity with international airport codes. Yes, you know LAX and JFK. But what about GRU (São Paulo) and YYZ (Toronto) and SGN (Ho Chi Minh City) and DOH (Doha, Qatar)?', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/17/books/16bookszalay1/16bookszalay1-articleLarge.jpg', 'height': 989, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/17/books/16bookszalay1/16bookszalay1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 989}}, {'rank': 0, 'subtype': 'jumb