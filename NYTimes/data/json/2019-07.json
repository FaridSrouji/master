an-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/20/autossell/vid20-iran-1/vid20-iran-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/20/autossell/vid20-iran-1/vid20-iran-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Video Appears to Show Iranian Takeover of British Tanker', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Islamic Revolutionary Guards Corps', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-07-20T16:43:20+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Reuters', 'person': [], 'organization': 'Reuters'}, 'type_of_material': 'Video', '_id': 'nyt://video/08bf47f8-3537-593e-9f39-4c410d44c9fa', 'word_count': 0, 'uri': 'nyt://video/08bf47f8-3537-593e-9f39-4c410d44c9fa'}, {'abstract': 'In the mirror is someone we never thought we’d become.', 'web_url': 'https://www.nytimes.com/2019/07/20/opinion/sunday/faceapp-aging-old.html', 'snippet': 'In the mirror is someone we never thought we’d become.', 'lead_paragraph': 'Several years ago I was in a department store, frazzled and running late, looking for things I couldn’t find. As I was hastening along an aisle, a woman came toward me. She was quite a bit older than I was, and in a state of substantial disarray. As I drew closer I saw her shirt was wrongly buttoned. I put up a hand to prevent her bumping into me, and she put up a hand as well. I stopped. She stopped. We stared at each other with a kind of pity. And with a sudden rush of mortification, I understood that I was looking at myself in a mirror. Was I that tired and shambolic? Was I that old? ', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/sunday/21gerrard/21gerrard-articleLarge.jpg', 'height': 533, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/21/opinion/sunday/21gerrard/21gerrard-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 533}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/sunday/21gerrard/21gerrard-jumbo.jpg', 'height': 910, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/sunday/21gerrard/21gerrard-superJumbo.jpg', 'height': 1820, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/sunday/21gerrard/21gerrard-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/21/opinion/sunday/21gerrard/21gerrard-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/21/opinion/sunday/21gerrard/21gerrard-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'FaceApp and the Savage Shock of Aging', 'kicker': None, 'content_kicker': None, 'print_headline': 'FaceApp and the Savage Shock of Aging', 'name': None