s', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/23/well/physed-barefoot/physed-barefoot-articleLarge.jpg', 'height': 254, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/07/23/well/physed-barefoot/physed-barefoot-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 254}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/23/well/physed-barefoot/physed-barefoot-jumbo.jpg', 'height': 434, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/23/well/physed-barefoot/physed-barefoot-superJumbo.jpg', 'height': 867, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/23/well/physed-barefoot/physed-barefoot-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/07/23/well/physed-barefoot/physed-barefoot-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/07/23/well/physed-barefoot/physed-barefoot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Born to Walk Barefoot', 'kicker': 'Phys Ed', 'content_kicker': None, 'print_headline': 'Going Barefoot Isn’t So Bad', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Running', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Walking', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shoes and Boots', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 