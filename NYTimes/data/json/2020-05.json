, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/world/11virus-russia-deaths-1/11virus-russia-deaths-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/11/world/11virus-russia-deaths-1/11virus-russia-deaths-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/world/11virus-russia-deaths-1/11virus-russia-deaths-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Coronavirus Mystery Explained: Moscow Has 1,700 Extra Deaths', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Number Defies Propaganda: 1,700 Extra Deaths in Moscow', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Moscow (Russia)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-05-11T11:18:50+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Ivan Nechepurenko', 'person': [{'firstname': 'Ivan', 'middlename': None, 'lastname': 'Nechepurenko', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ecaee97-168d-58e0-9530-389c12da9d04', 'word_count': 941, 'uri': 'nyt://article/0ecaee97-168d-58e0-9530-389c12da9d04'}, {'abstract': 'In New York City, restrictions on gatherings and nonessential businesses will probably