_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/obituaries/13Gilder1/merlin_10108757_6365a51d-c481-44b6-a7da-f575fb1f3aaa-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/15/obituaries/13Gilder1/merlin_10108757_6365a51d-c481-44b6-a7da-f575fb1f3aaa-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/obituaries/13Gilder1/merlin_10108757_6365a51d-c481-44b6-a7da-f575fb1f3aaa-jumbo.jpg', 'height': 662, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/obituaries/13Gilder1/merlin_10108757_6365a51d-c481-44b6-a7da-f575fb1f3aaa-superJumbo.jpg', 'height': 1042, 'width': 1611, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/obituaries/13Gilder1/13Gilder1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/15/obituaries/13Gilder1/13Gilder1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/obituaries/13Gilder1/13Gilder1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Richard Gilder, Donor to Parks, Museum and History, Dies at 87', 'kicker': None, 'content_kicker': None, 'print_headline': 'Richard Gilder, Whose Millions Helped Transform Central Park, Is Dead at 87', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gilder, Richard', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parks and Other Recreation Areas', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Collectors and Collections', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN MUSEUM OF NATURAL HISTORY', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Park Conservancy', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'New-York Historical Society', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-05-14T18:48:49+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'New York', 'byline': {'original': 'By Sam Roberts', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Roberts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/c6287446-18cc-5840-a6bf-f2c7b1ca4c29', 'word_count': 1110, 'uri': 'nyt://article/c6287446-18cc-5840-a6bf-f2c7b1ca4c29'}, {'abstract': 'Mr. Lovett played cello in the celebrated ensemble, which performed together for 40 years. He died of complications of the novel coronavirus.', 'web_url': 'https://www.nytimes.com/2020/05/14/obituaries/martin-lovett-dead-coronavirus.html', 'snippet': 'Mr. Lovett played cello in the celebrated ensemble, which performed together for 40 years. He died of complications of the novel coronavirus.', 'lead_paragraph': 'The Amadeus, a string quartet of extraordinary longevity, set the gold standard in chamber music for four decades after World War II. Their style was a burnish on the Viennese tradition of smooth, lush string playing; they shone above a foundation provided by the solid, undemonstrative voice of their cellist, Martin Lovett.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/16/obituaries/14lovett01/merlin_172495293_436477ee-d8a6-4972-a412-b38539a38f02-articleLarge.jpg', 'height': 379, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/16/obituaries/14lovett01/merlin_172495293_436477ee-d8a6-4972-a412-b38539a38f02-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 379}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/16/obituaries/14lovett01/merlin_172495293_436477ee-d8a6-4972-a412-b38539a38f02-jumbo.jpg', 'height': 648, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/16/obituaries/14lovett01/merlin_172495293_436477ee-d8a6-4972-a412-b38539a38f02-superJumbo.jpg', 'height': 1295, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/16/obituaries/14lovett01/14lovett01-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/16/obituaries/14lovett01/14lovett01-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/16/obituaries/14lovett01/14lovett01-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Martin Lovett, Last Living Member of the Amadeus Quartet, Dies at 93', 'kicker': 'those we’ve lost', 'content_kicker': None, 'print_