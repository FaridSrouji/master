ource': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Variety: Cryptic Crossword', 'kicker': 'SUNDAY VARIETY COLUMN', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2020-05-02T15:00:01+0000', 'document_type': 'article', 'news_desk': 'Games', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Caitlin Lovinger', 'person': [{'firstname': 'Caitlin', 'middlename': None, 'lastname': 'Lovinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1915370-55a5-555c-8823-5ac3d117846a', 'word_count': 1743, 'uri': 'nyt://article/f1915370-55a5-555c-8823-5ac3d117846a'}, {'abstract': 'The simple handshake, once an offer of peace, now carries a threat of contagion.', 'web_url': 'https://www.nytimes.com/2020/05/02/opinion/coronavirus-handshake.html', 'snippet': 'The simple handshake, once an offer of peace, now carries a threat of contagion.', 'lead_paragraph': 'Handshaking for self-protection became anachronistic long before Dr. Anthony Fauci, the nation’s leading infectious-disease expert, said wistfully in early April that as far as even greeting one another, “we may never shake hands again.” As a personal defense mechanism and for sealing deals, though, it was outdated as soon as people began openly brandishing guns and hiring lawyers to vet contracts.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/02/opinion/02handshake/02handshake-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/02/opinion/02handshake/02handshake-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/02/o