yline': {'original': 'By Gail Caldwell', 'person': [{'firstname': 'Gail', 'middlename': None, 'lastname': 'Caldwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/27ffaf73-1b00-5271-9fa0-61040772ea26', 'word_count': 1194, 'uri': 'nyt://article/27ffaf73-1b00-5271-9fa0-61040772ea26'}, {'abstract': 'Thomas E. Ricks considers books from ancient China down to the war in Afghanistan.', 'web_url': 'https://www.nytimes.com/2020/05/22/books/review/un-american-erik-edstrom.html', 'snippet': 'Thomas E. Ricks considers books from ancient China down to the war in Afghanistan.', 'lead_paragraph': 'In few areas of human activity is there such a discrepancy between perception and reality as there is with war. There tends to be a huge difference between what people think war is and what it really is, a thought that returned to me repeatedly as I read a stack of new books.', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/books/24Ricks01-web/merlin_49816194_7037f3d0-9cee-422f-8eee-c5f3e45e15b9-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/24/books/24Ricks01-web/merlin_49816194_7037f3d0-9cee-422f-8eee-c5f3e45e15b9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/books/24Ricks01-web/merlin_49816194_7037f3d0-9cee-422f-8eee-c5f3e45e15b9-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/books/24Ricks01-web/merlin_49816194_7037f3d0-9cee-422f-8eee-c5f3e45e15b9-supe