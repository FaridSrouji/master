': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/arts/09richard-appraisal/09richard-appraisal-articleLarge.jpg', 'height': 439, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/09/arts/09richard-appraisal/09richard-appraisal-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 439}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/arts/09richard-appraisal/09richard-appraisal-jumbo.jpg', 'height': 749, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/arts/09richard-appraisal/09richard-appraisal-superJumbo.jpg', 'height': 1498, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/arts/09richard-appraisal/09richard-appraisal-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/09/arts/09richard-appraisal/09richard-appraisal-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/arts/09richard-appraisal/09richard-appraisal-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Little Richard: An Ecstasy You Couldn’t Refuse', 'kicker': 'An Appraisal', 'content_kicker': None, 'print_headline': 'Slippin’ And  A Slidin’ With Joy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'RHYTHM AND BLUES (MUSIC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'val