ker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pediatric Inflammatory Multisystem Syndrome (PIMS)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McMorrow, Jack', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-05-21T09:00:19+0000', 'document_type': 'article', 'news_desk': 'Podcasts', 'section_name': 'Podcasts', 'subsection_name': 'The Daily', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36d29a1b-0b7e-5823-8353-de572135695f', 'word_count': 324, 'uri': 'nyt://article/36d29a1b-0b7e-5823-8353-de572135695f'}, {'abstract': 'New York officials tapped the reality television star to find masks for medical workers. She found a global bazaar of ex-cons and exaggerations.', 'web_url': 'https://www.nytimes.com/2020/05/21/technology/bethenny-frankel-medical-masks-coronavirus.html', 'snippet': 'New York officials tapped the reality television star to find masks for medical workers. She found a global bazaar of ex-cons and exaggerations.', 'lead_paragraph': 'It was late March, with the coronavirus starting to peak in New York and hospitals already running short on supplies, when Bethenny Frankel, the entrepreneur and reality television star, received an email from a publicist offering her access to 500 million medical masks, or about enough to fill 25 Madison Square Gardens.', 'print_section': 'ST', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/business/00frankel1/merlin_1718