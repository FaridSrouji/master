ion': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/10/opinion/sunday/10brooks/10brooks-superJumbo.jpg', 'height': 2048, 'width': 1639, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/10/opinion/sunday/10brooks/10brooks-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/10/opinion/sunday/10brooks/10brooks-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/10/opinion/sunday/10brooks/10brooks-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Forget Pancakes. Pay Mothers.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Forget Pancakes.  Pay Women.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Child Care', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-05-08T19:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Kim Brooks', 'person': [{'firstname': 'Kim', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/cca9f666-74d0-5061-86d9-e02dcc42f80e', 'word_count': 1368, 'uri': 'nyt://article/cca9f666-74d0-5061-86d9-e02dcc42f80e'}, {'abstract': 'Here are some principles you can apply to any form of nature study.', 'web_url': 'https://www.nytimes.com/2020/05/08/opinion/sunday/bird-watching-coronavirus-lockdown.html', 'snippet': 'Here are some principles you can apply to any form of nature study.', 'lead_paragraph': 'We find comfort in nature. The psychological benefits are well documented: Spending time with grass and trees and birds, even through a window, makes us feel happier and more relaxed. It’s inspiring and reassuring to remember that birds are migrating north right now, as they have for millenniums. The earth turns, and birds follow the rhythms of daily and yearly cycles.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/10/opinion/sunday/00sibley1/00sibley1-articleLarge.jpg', 'height': 699, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/10/opinion/sunday/00sibley1/00sibley1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 699}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/10/opinion/sunday/00sibley1/00sibley1-jumbo.jpg', 'height': 1024, 'width': 879, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/10/opinion/sunday/00sibley1/00sibley1-superJumbo.jpg', 'height': 2048, 'width': 1758, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/10/opinion/sunday/00sibley1/00sibley1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/10/opinion/