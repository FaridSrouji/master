'major': 'N'}, {'name': 'organizations', 'value': 'Forest Service', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Interagency Fire Center', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Western States (US)', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-05-14T19:00:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Chris Field and Eric A. Appel', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Field', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Eric', 'middlename': 'A.', 'lastname': 'Appel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a2aa9ac6-cd81-5f15-bde2-b24e96718f4b', 'word_count': 771, 'uri': 'nyt://article/a2aa9ac6-cd81-5f15-bde2-b24e96718f4b'}, {'abstract': 'Pastors who ignore coronavirus restrictions grab headlines. But most are being very careful about worship during the pandemic.', 'web_url': 'https://www.nytimes.com/2020/05/14/opinion/coronavirus-churches.html', 'snippet': 'Pastors who ignore coronavirus restrictions grab headlines. But most are being very careful about worship during the pandemic.', 'lead_paragraph': 'I pastor a church in Sonoma County, Calif., under what has been one of the strictest shelter-in-place orders in the country. We haven’t met for in-person worship services since March 8. We’ve spent the past two months with services, prayer times and Bible studies online. Gov. Gavin Newsom has announced that churches will not be meeting in large assemblies for some time. So with God’s help, prayer and encouragement from one another, we’re drawing upon deeper spiritual and relational resources as we seek to grow in patience, learn to wait and find new ways to minister to those in need.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14cross/14cross-articleLarge.jpg', 'height': 720, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/14/opinion/14cross/14cross-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 720}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14cross/14cross-jumbo.jpg', 'height': 1024, 'width': 854, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14cross/14cross-superJumbo.jpg', 'height': 2048, 'width': 1707, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14cross/14cross-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/14/opinion/14cross/14cross-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14cross/14cross-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Churches Really Think About Opening Up', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shutdowns (Institutional)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Churches (Buildings)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ivey, Kay', 'rank': 4, 'major': 'N'}, {'