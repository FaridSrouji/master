ction_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Brett McGurk', 'person': [{'firstname': 'Brett', 'middlename': None, 'lastname': 'McGurk', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/05f4eb69-6d00-5499-9801-d56192208f6f', 'word_count': 1252, 'uri': 'nyt://article/05f4eb69-6d00-5499-9801-d56192208f6f'}, {'abstract': 'Entire communities around the country face this terrifying virus without being even able to wash their hands.', 'web_url': 'https://www.nytimes.com/2020/05/02/opinion/coronavirus-water.html', 'snippet': 'Entire communities around the country face this terrifying virus without being even able to wash their hands.', 'lead_paragraph': 'Several weeks ago, Larry Welch and his mother, Mary Ann, contracted Covid-19 and died. In the midst of a pandemic in which one of the first lines of defense is vigorous hand washing, they were among more than two million Americans who lack running water.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/02/opinion/02McGraw/02McGraw-articleLarge.jpg', 'height': 359, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/02/opinion/02McGraw/02McGraw-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 359}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/02/opinion/02McGraw/02McGraw-jumbo.jpg', 'height': 613, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/02/opinion/02McGraw/02McGraw-superJumbo.jpg', 'height': 1226, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'ca