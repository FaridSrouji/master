 of Alabama.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/science/11SCI-PYTHON-promo/merlin_172215306_f061188e-0103-4c66-b233-74dabe1f70ef-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/11/science/11SCI-PYTHON-promo/merlin_172215306_f061188e-0103-4c66-b233-74dabe1f70ef-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/science/11SCI-PYTHON-promo/merlin_172215306_f061188e-0103-4c66-b233-74dabe1f70ef-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/science/11SCI-PYTHON-promo/merlin_172215306_f061188e-0103-4c66-b233-74dabe1f70ef-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/science/11SCI-PYTHON-promo/11SCI-PYTHON-promo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/11/science/11SCI-PYTHON-promo/11SCI-PYTHON-promo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/science/11SCI-PYTHON-promo/11SCI-PYTHON-promo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Eat Rat, Make New Body: Easy Stuff for Pythons', 'kicker': 'matter', 'content_kicker': None, 'print_headline': 'A Tip o