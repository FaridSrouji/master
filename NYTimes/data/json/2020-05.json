nail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/27/sports/27nosportsWEB1/merlin_170152599_e3dfb7b3-96ad-4116-853c-2571f178cc7f-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/27/sports/27nosportsWEB1/merlin_170152599_e3dfb7b3-96ad-4116-853c-2571f178cc7f-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sweaty Scrums? How Rugby May Adapt to Return to Play', 'kicker': 'The Day in (No) Sports', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rugby', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus Reopenings', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'World TeamTennis', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-05-27T18:07:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Victor Mather', 'person': [{'firstname': 'Victor', 'middlename': None, 'lastname': 'Mather', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/570e218b-ac4b-5bf7-8e99-09b0b7e16367', 'word_count': 750, 'uri': 'nyt://article/570e218b-ac4b-5bf7-8e99-09b0b7e16367'}, {'abstract': 'Christian Cooper is already back birding at Central Park. “I’m not excusing the racism,” he said. “But I don’t know if her life needed to be torn apart.”', 'web_url': 'https://www.nytimes.com/2020/05/27/nyregion/amy-cooper-christian-central-park-video.html', 'snippet': 'Christian Cooper is already back birding at Central Park. “I’m not excusing the racism,” he said. “But I don’t know if her life needed to be torn apar