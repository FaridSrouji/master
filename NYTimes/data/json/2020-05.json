n. And they’re fictional.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/07/arts/07lesbian-bars-batwoman/merlin_171817692_4174200f-0d0b-449b-81e4-96af346786c5-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/07/arts/07lesbian-bars-batwoman/merlin_171817692_4174200f-0d0b-449b-81e4-96af346786c5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/07/arts/07lesbian-bars-batwoman/merlin_171817692_4174200f-0d0b-449b-81e4-96af346786c5-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/07/arts/07lesbian-bars-batwoman/merlin_171817692_4174200f-0d0b-449b-81e4-96af346786c5-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/07/arts/07lesbian-bars-batwoman/merlin_171817692_4174200f-0d0b-449b-81e4-96af346786c5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/07/arts/07lesbian-bars-batwoman/merlin_171817692_4174200f-0d0b-449b-81e4-96af346786c5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/07/arts/07lesbian-bars-batwoman/merlin_171817692_4174200f-0d0b-449b-81e4-96af346786c5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline