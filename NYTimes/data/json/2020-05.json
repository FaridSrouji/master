one, 'sub': None}, 'keywords': [], 'pub_date': '2020-05-03T19:22:19+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Carole Landry and David Scull', 'person': [{'firstname': 'Carole', 'middlename': None, 'lastname': 'Landry', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'David', 'middlename': None, 'lastname': 'Scull', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/3eb005c8-62bb-568c-8a5b-152e524c4191', 'word_count': 1489, 'uri': 'nyt://article/3eb005c8-62bb-568c-8a5b-152e524c4191'}, {'abstract': 'Social distancing isn’t easy on the subway. Transit officials are mapping out ways to prepare the system for the return of riders.', 'web_url': 'https://www.nytimes.com/2020/05/03/nyregion/mta-subway-coronavirus.html', 'snippet': 'Social distancing isn’t easy on the subway. Transit officials are mapping out ways to prepare the system for the return of riders.', 'lead_paragraph': 'Businesses in New York City will be asked to change workers’ schedules to reduce rush-hour density on the subway. A new squad of guards will patrol stations, reporting overcrowding to supervisors and directing riders to emptier train cars. Brightly colored markers will be added to encourage riders to keep a distance from one another on platforms, following the advice of transit agencies in China, Singapore and Britain.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/01/nyregion/00nyvirus-subway1/00nyvirus-subway1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/01/nyregion/00nyvirus-subway1/00nyvirus-subway1-articleLarge-v2.jpg', 'x