name': 'Hawgood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e990e4f-dafc-5ec5-ae42-f792fba11491', 'word_count': 1500, 'uri': 'nyt://article/6e990e4f-dafc-5ec5-ae42-f792fba11491'}, {'abstract': 'At stake in the lawsuit is the single biggest effort by the United States to fight the climate crisis.', 'web_url': 'https://www.nytimes.com/2020/05/27/climate/lawsuit-fuel-economy-climate.html', 'snippet': 'At stake in the lawsuit is the single biggest effort by the United States to fight the climate crisis.', 'lead_paragraph': 'Led by California, nearly two dozen states sued the Trump administration on Wednesday over its reversal of fuel-efficiency standards for cars and trucks, arguing that the move is based on erroneous science, and endangers public health.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/27/climate/27CLI-AUTOEMISSIONS/27CLI-AUTOEMISSIONS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/27/climate/27CLI-AUTOEMISSIONS/27CLI-AUTOEMISSIONS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/27/climate/27CLI-AUTOEMISSIONS/27CLI-AUTOEMISSIONS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/27/climate/27CLI-AUTOEMISSIONS/27CLI-AUTOEMISSIONS-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url':