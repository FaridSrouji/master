 {'name': 'subject', 'value': 'Classified Information and State Secrets', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Espionage and Intelligence Services', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Wiretapping and Other Eavesdropping Devices and Methods', 'rank': 12, 'major': 'N'}, {'name': 'subject', 'value': 'Special Prosecutors (Independent Counsel)', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Bureau of Investigation', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 15, 'major': 'N'}, {'name': 'persons', 'value': 'Mueller, Robert S III', 'rank': 16, 'major': 'N'}], 'pub_date': '2020-05-30T01:14:12+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Julian E. Barnes, Adam Goldman and Nicholas Fandos', 'person': [{'firstname': 'Julian', 'middlename': 'E.', 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Adam', 'middlename': None, 'lastname': 'Goldman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Fandos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a4766f4-0996-56ad-954f-356d57448b00', 'word_count': 1285, 'uri': 'nyt://article/4a4766f4-0996-56ad-954f-356d57448b00'}, {'abstract': 'Scenes from a country in free fall.', 'web_url': 'https://www.nytimes.com/2020/05/29/opinion/george-floyd-protests-minneapolis.html', 'snippet': 'Scenes from a country in free fall.', 'lead_paragraph': 'The last two and a half months in America have felt like the opening montage in a dystopian film about a nation come undone. First the pandemic hit and hospitals in New York City were overwhelmed. The national economy froze and unemployment soared; one in four American workers has applied for unemployment benefits since March. Lines of cars stretched for miles at food banks. Heavily armed lockdown protesters demonstrated across the country; in Michigan, they forced the Capitol to close and legislators to cancel their session. Nationwide, at least 100,000 people died of a disease almost no one had heard of last year.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/30/opinion/sunday/30Goldberg1/30Goldberg1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/30/opinion/sunday/30Goldberg1/30Goldberg1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/30/opinion/sunday/30Goldberg1/30Goldberg1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/30/opinion/sunday/30Goldberg1/30Goldberg1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/30/opinion/sunday/30Goldberg1/30Goldberg1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/30/opinion/sunday/30Goldberg1/30Goldberg1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/30/opinion/sunday/30Goldberg1/30Goldberg1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thum