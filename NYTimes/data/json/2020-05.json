N-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/01/science/01TB-CHICKEN/01TB-CHICKEN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Your Chicken Is No Longer Pink. That Doesn’t Mean It’s Safe to Eat.', 'kicker': 'Trilobites', 'content_kicker': None, 'print_headline': 'Chicken Cooked Past Pink Might Still Be Unsafe to Eat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poultry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Food Contamination and Poisoning', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Salmonella (Bacteria)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Thermometers', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'PLoS One (Journal)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Langsrud, Solveig', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Norwegian Institute of Food, Fisheries and Aquaculture Research', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-science', 'rank': 10, 'major': 'N'}], 'pub_date': '2020-05-01T19:24:38+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By JoAnna Klein', 'person': [{'firstname': 'Joanna', 'middlename': None, 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f0b6bdee-56dc-56bf-ba87-93744eaab3cb', 'word_count': 847, 'uri': 'nyt://article/f0b6bdee-56dc-56bf-ba87-93744eaab3cb'}, {'abstract': 'On our daily walks together, my young daughter and I begin to navigate a new reality.', 'web_url': 'https://www.nytimes.com/2020/05/01/opinion/sunday/coronavirus-parenting-isolation.html', 'snippet': 'On our daily walks together, my young daughter and I begin to navigate a new reality.', 'lead_paragraph': 'My youngest daughter has told me that Annabelle, her baby doll, might have the coronavirus. We talk about it as we take a daily walk up the road. She’s not sure yet whether it is diabetes or the virus. Annabelle’s symptoms vary, but she has not left the small cradle by the side of my daughter’s bed in days. I have been told I can babysit for Annabelle, but only if I promise to hold her gently and not give her candy. My daughter holds my hand as we walk. She wants to talk about her doll’s sickness every day. Not surprisingly, she’s not sure when or if Annabelle will get a test.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/03/opinion/sunday/03craig/03craig-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/03/opinion/sunday/03craig/03craig-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/03/opinion/sunday/03craig/03craig-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/03/opinion/sunday/03craig/03craig-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/03/opinion/sunday/03craig/03craig-thumbStandard.jpg', 'height': 75, 'width': 75, 'subTyp