me': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Xi Jinping', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Epidemics', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-05-15T15:53:49+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Chris Buckley and Steven Lee Myers', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Buckley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Steven', 'middlename': 'Lee', 'lastname': 'Myers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d04c7ba4-00cf-5685-8177-ca7c3634f74f', 'word_count': 1532, 'uri': 'nyt://article/d04c7ba4-00cf-5685-8177-ca7c3634f74f'}, {'abstract': 'Parents are getting creative to make physical activity fun, yet easy, during lockdown.', 'web_url': 'https://www.nytimes.com/2020/05/15/parenting/coronavirus-keeping-kids-active.html', 'snippet': 'Parents are getting creative to make physical activity fun, yet easy, during lockdown.', 'lead_paragraph': 'It feels like a lifetime ago, but it was only March 17 when my daughter learned how to ride her bike without training wheels. It was also my birthday, so it felt like a gift — one with terrific timing, as our home state, Texas, had declared a state of emergency just four days earlier in response to the coronavirus pandemic. Those early days of the new normal were defined by frequent family bike rides, exploring our neighborhood in the welcoming air of an Austin spring.', 'source'