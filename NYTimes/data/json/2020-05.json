firstname': 'Iqbal', 'middlename': None, 'lastname': 'Kirmani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1825b121-e2c9-5f57-94ab-ffa8962ae2f7', 'word_count': 916, 'uri': 'nyt://article/1825b121-e2c9-5f57-94ab-ffa8962ae2f7'}, {'abstract': 'Government figures due Friday will undoubtedly show that job losses in April were the worst ever. But they could provide key hints about the recovery.', 'web_url': 'https://www.nytimes.com/2020/05/06/business/economy/coronavirus-unemployment-jobs-report.html', 'snippet': 'Government figures due Friday will undoubtedly show that job losses in April were the worst ever. But they could provide key hints about the recovery.', 'lead_paragraph': 'The coronavirus pandemic has brought wave after wave of catastrophic economic data: The worst decline in gross domestic product in a decade. The worst retail sales report on record. The worst week ever for unemployment claims, and then two more twice as bad as that.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/06/business/06virus-job-explain1/merlin_172186200_e5c6672a-6492-49f0-9332-396c8ca05ce7-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/06/business/06virus-job-explain1/merlin_172186200_e5c6672a-6492-49f0-9332-396c8ca05ce7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/06/business/06virus-job-explain1/merlin_172186200_e5c6672a-6492-49f0-9332-396c8ca05ce7-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 't