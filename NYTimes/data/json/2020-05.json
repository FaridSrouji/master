ichigan-1/24michigan-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/sports/24michigan-1/24michigan-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'He Thought He Was Getting Football Physicals. He Was Being Abused.', 'kicker': None, 'content_kicker': None, 'print_headline': '‘He Had Victimized So Many of Us’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tests (Medical)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prostate Cancer', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Michigan', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Anderson, Robert E (1928-2008)', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-05-25T04:30:09+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Alan Blinder', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Blinder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6eb23c8e-4b61-5013-9668-2da9efc6bb6a', 'word_count': 1716, 'uri': 'nyt://article/6eb23c8e-4b61-5013-9668-2da9efc6bb6a'}, {'abstract': 'The gambling thriller starring Adam Sandler arrives on Netflix. And a mini-series about Ulysses S. Grant debuts on History.', 'web_url': 'https://www.nytimes.com/2020/05/25/arts/television/whats-on-tv-monday-uncut-gems-and-grant.html', 'snippet': 'The gambling thriller starring Adam Sandler arrives on Netflix. And a mini-series about Ulysses S. Grant debuts on History.', 'lead_paragraph': 'UNCUT GEMS (2019) Stream on Netflix; rent on Amazon, Vudu and YouTube. The combination of Adam Sandler’s performance in an atypical role and the Safdie brothers’ energetic and adventurous style made waves when this crime thriller arrived in theaters last year. Sandler plays Howard Ratner, a jeweler and gambler who hopes that a black opal he has acquired from Ethiopia will be the key to his salvation. His plan, however, is quickly thrown into disarray by the basketball player Kevin Garnett, playing himself, who wants to borrow the gemstone for good luck. As he tries to extricate himself from one jam after another, Ratner must also contend with his estranged wife, Dinah (Idina Menzel), his mercurial mistress, Julia (Julia Fox), and his loan shark brother-in-law Arno (Eric Bogosian).', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/25/arts/25tvcol-1/13uncut-1-articleLarge.jpg', 'height': 326, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/25/arts/25tvcol-1/13uncut-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 326}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/25/arts/25tvcol-1/13uncut-1-jumbo.jpg', 'height': 556, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/25/arts/25tvcol-1/13uncut-1-superJumbo.jpg', 'height': 1112, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/25/arts/25tvcol-1/25tvcol-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/25/arts/25tvcol-1/25tvcol-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/25/arts/25tvcol-1/25tvcol-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What’s on TV Monday: ‘Uncut Gems’ and ‘Grant’', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Monday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}], 'pub_date': '2020-05-25T05:00:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Peter Libbey', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Libbey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dbbde60a-b6f7-5f6d-8a39-cf756f1ebdb8', 'word_count': 481, 'uri': 'nyt://article/dbbde60a-b6f7-5f6d-8a39-cf756f1ebdb8'}, {'abstract': 'Corrections that appeared in print on Monday, May 25, 2020.', 'web_url': 'https://www.nytimes.com/2020/05/25/pageoneplus/corrections-may-25-2020.html', 'snippet': 'Corrections that appeared in print on Monday, May 25, 2020.', 'lead_paragraph': 'The full-page presentation on Sunday that listed the names of people whose lives were lost to the coronavirus pandemic included several errors. The list erroneously included Jordan Driver Haynes. Mr. Haynes did not die of virus-related causes; his memorial service was delayed because of the outbreak. The following names were also erroneously included because of a misreading of local obituaries: John A. Rocco, Fannie Mae Person, Richard Wayne Cannon, Dorothea Elaine Young-Lane, Stephen Wald Levine, Robert L. Scarpino Jr., Elmer J. David and Jagdish C. Agarwal. The listing also omitted the surname of a professor at Gloucester County College. He was Henry Burk Sullivan, not Burk. It also omitted the surname of a master jeweler from Alpine, N.J. He was Fritz Wilhelm Reisgies, not Wilhelm. It misspelled the surname of a woman from Brookville, N.Y., who died on April 13. She was Joan M. Heaney, not Heany. The list also misstated Randall Clayton French’s age. He was 39, not 29.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: May 25, 2020', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2020-05-25T05:11:52+0000', 'document_type': 'article', 'news_desk': 'Corrections', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/076394a9-ed49-57d5-8ad5-de4cfb34d9fa', 'word_count': 212, 'uri': 'nyt://article/076394a9-ed49-57d5-8ad5-de4cfb34d9fa'}, {'abstract': 'The 1919 Stanley Cup finals were more than a century ago, but they are bound to current reality by the struggle against a deadly virus and the push for sports to return.', 'web_url': 'https://www.nytimes.com/2020/05/25/sports/hockey/spanish-flu-1919-stanley-cup-finals.html', 'snippet': 'The 1919 Stanley Cup finals were more than a century ago, but they are bound to current reality by the struggle against a deadly virus and the push for sports to return.', 'lead_paragraph': 'Nobody made much of it when Joe Hall skated off the ice.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/25/sports/20SEATTLE-HOCKEY-1/merlin_17246