 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae11db8e-6af2-5dae-b76c-8a37eabc46ff', 'word_count': 642, 'uri': 'nyt://article/ae11db8e-6af2-5dae-b76c-8a37eabc46ff'}, {'abstract': 'In an interview with a Dublin radio station, the actor praised the people of Dalkey, the coastal town whose residents have adopted him as one of their own during the coronavirus epidemic.', 'web_url': 'https://www.nytimes.com/2020/05/13/world/europe/matt-damon-ireland-coronavirus.html', 'snippet': 'In an interview with a Dublin radio station, the actor praised the people of Dalkey, the coastal town whose residents have adopted him as one of their own during the coronavirus epidemic.', 'lead_paragraph': 'Matt Damon has broken his silence about riding out the coronavirus lockdown in a seaside town in Ireland, dishing to a Dublin radio station about his newest FaceTime buddy (Bono) and what he was carrying in a SuperValu bag (beach towels) when he was spotted by locals.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/style/13xp-mattdamon/merlin_163866177_756ca2e1-7320-41a8-8755-57faa348f934-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/13/style/13xp-mattdamon/merlin_163866177_756ca2e1-7320-41a8-8755-57faa348f934-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/style/13xp-mattdamon/merlin_163866177_756ca2e1-7320-41a8-8755-57faa348f934-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/style/13xp-mattdamon/merlin_163866177_756ca2e1-7320-41a8-8755-57