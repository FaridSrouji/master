ach', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Canning and Preserving', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-05-14T18:12:36+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Alexa Weibel', 'person': [{'firstname': 'Alexa', 'middlename': None, 'lastname': 'Weibel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7372ef50-ce4b-5a76-89cb-d9d2f49a6967', 'word_count': 664, 'uri': 'nyt://article/7372ef50-ce4b-5a76-89cb-d9d2f49a6967'}, {'abstract': 'With nearly 1,000 images, Aby Warburg’s radical form of visual study is also an artwork itself. Now you can see it online.', 'web_url': 'https://www.nytimes.com/2020/05/14/arts/design/aby-warburg-memory-atlas.html', 'snippet': 'With nearly 1,000 images, Aby Warburg’s radical form of visual study is also an artwork itself. Now you can see it online.', 'lead_paragraph': 'For most of us, it’s natural to look at many pictures at the same time. We do it every day via internet searches and digital pinup boards — even refrigerator doors have become ad hoc photo albums.', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/17/arts/14warburg-review7/merlin_172458987_634c3261-16bd-4dda-9797-0cb064425ef8-articleLarge.jpg', 'height': 478, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/17/arts/14warburg-review7/merlin_172458987_634c3261-16bd-4dda-9797-0cb064425ef8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 478}}, {'