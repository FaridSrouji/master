oving harder still.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/world/11-virus-britain-1/merlin_172365441_1d3eab80-041a-4a96-8517-bc8c0a870f83-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/11/world/11-virus-britain-1/merlin_172365441_1d3eab80-041a-4a96-8517-bc8c0a870f83-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/world/11-virus-britain-1/merlin_172365441_1d3eab80-041a-4a96-8517-bc8c0a870f83-jumbo.jpg', 'height': 695, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/world/11-virus-britain-1/merlin_172365441_1d3eab80-041a-4a96-8517-bc8c0a870f83-superJumbo.jpg', 'height': 1390, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/world/11-virus-britain-1/merlin_172365441_1d3eab80-041a-4a96-8517-bc8c0a870f83-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/11/world/11-virus-britain-1/merlin_172365441_1d3eab80-041a-4a96-8517-bc8c0a870f83-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/11/world/11-virus-britain-1/merlin_172365441_1d3eab80-041a-4a96-8517-bc8c0a870f83-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bafflement Greets Bor