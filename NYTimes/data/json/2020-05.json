': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/22/multimedia/22parenting-drowning-risk/22parenting-drowning-risk-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/22/multimedia/22parenting-drowning-risk/22parenting-drowning-risk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/22/multimedia/22parenting-drowning-risk/22parenting-drowning-risk-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/22/multimedia/22parenting-drowning-risk/22parenting-drowning-risk-superJumbo.jpg', 'height': 1750, 'width': 1750, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/22/multimedia/22parenting-drowning-risk/22parenting-drowning-risk-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/22/multimedia/22parenting-drowning-risk/22parenting-drowning-risk-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/22/multimedia/22parenting-drowning-risk/22parenting-drowning-risk-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Children May Be At Higher Risk of Drowning This Summer', 'kicker': None, 'content_kicker': None, 'print_headline': 'Here to Help; How to Protect Children From Drowning', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drownings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-05-22T09:00:10+0000', 'document_type': 'article', 'news_desk': 'Parenting', 'section_name': 'Parenting', 'byline': {'original': 'By Lisa L. Lewis', 'person': [{'firstname': 'Lisa', 'middlename': 'L.', 'lastname': 'Lewis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a0593182-2b28-5f71-96d4-4b27ab0ea474', 'word_count': 1242, 'uri': 'nyt://article/a0593182-2b28-5f71-96d4-4b27ab0ea474'}, {'abstract': 'I am trying to survive this season of fear as I did another one, the summer of 1951, when I contracted polio. But how long can you live on the knife edge of unknowing?', 'web_url': 'https://www.nytimes.com/2020/05/22/well/family/coronavirus-polio-neighbors-community.html', 'snippet': 'I am trying to survive this season of fear as I did another one, the summer of 1951, when I contracted polio. But how long can you live on the knife edge of unknowing?', 'lead_paragraph': 'One afternoon in early February, a gazillion memories ago, I put a few things on the curb the day before trash pickup, in accord with my neighborhood’s ongoing swap meet. By the next morning the mail carrier had carted off the fireplace irons; someone else took the French coffee press. But my old kitchen wall clock went unclaimed. I propped it against a tree, a forlorn Dali melting into the rough winter earth. Its hands had been stuck at 7:00 for years.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/20/science/00TIES-NEIGHBORS/00TIES-NEIGHBORS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlar