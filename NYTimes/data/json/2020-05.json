/09/opinion/09Gerstel1/09Gerstel1-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09Gerstel1/09Gerstel1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/09/opinion/09Gerstel1/09Gerstel1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09Gerstel1/09Gerstel1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Survived Vietnam. Will I Survive This Pandemic?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Echoes of War Amid  A Pandemic', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vietnam War', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-05-09T15:00:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Gerstel', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gerstel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9206bae5-2d19-5e2c-b2a8-9c836d35790f', 'word_count': 1017, 'uri': 'nyt://article/9206bae5-2d19-5e2c-b2a8-9c836d35790f'}, {'abstract': 'In an age of trolls, economic insecurity and social isolation, mixed martial arts gives fans a rush of harsh reality.', 'web_url': 'https://www.nytimes.com/2020/05/09/opinion/sunday/coronavirus-ufc-fight-return.html', 'snippet': 'In an age of trolls, economic insecurity and social isolation, mixed martial arts gives fans a rush of harsh reality.', 'lead_paragraph': 'It comes as no surprise to its ardent followers that the Ultimate Fighting Championship, known as U.F.C., will be the first organization to stage a major professional sports event in the United States since the spread of Covid-19 induced a monthslong live sports hiatus. Its brash president, Dana White, never wanted to cease operations in the first place.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09Depaola-F-copy/09Depaola-F-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/09/opinion/09Depaola-F-copy/09Depaola-F-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09Depaola-F-copy/09Depaola-F-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09Depaola-F-copy/09Depaola-F-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09Depaola-F-copy/09Depaola-F-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/09/opinion/09Depaola-F-copy/09Depaola-F-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09Depaola-F-copy/09Depaola-F-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why America Loves U.F.C., the First Sport to Return', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mixed Martial Arts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Ultimate Fighting Championship', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-05-09T15:00:11+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Joe DePaolo', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'DePaolo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/65f8a7b1-801e-5900-a1e3-810afbb2bec9', 'word_count': 2056, 'uri': 'nyt://article/65f8a7b1-801e-5900-a1e3-810afbb2bec9'}, {'abstract': 'Remind her that she’s the best: You can stream these shorts right here, from the safety of home.', 'web_url': 'https://www.nytimes.com/2020/05/09/opinion/mothers-day-documentaries.html', 'snippet': 'Remind her that she’s the best: You can stream these shorts right here, from the safety of home.', 'lead_paragraph': 'Some of us may be far from family this year, but we can still celebrate Mom, wherever she is. We’ve put together a collection of our favorite short documentaries for Mother’s Day, by some of the best filmmakers around. Even if you’re not watching together, these are films to stream with family and then jump on the phone or Zoom to ask each other: Which one moved you most?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/08/opinion/08mothersdaypromo/08mo