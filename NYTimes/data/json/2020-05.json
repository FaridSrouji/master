 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/72cda0e8-e8b8-5e6c-a01f-3c020edddc16', 'word_count': 3088, 'uri': 'nyt://article/72cda0e8-e8b8-5e6c-a01f-3c020edddc16'}, {'abstract': 'If Biden wants to win the White House and govern like a New Dealer, Warren is his indispensable partner.', 'web_url': 'https://www.nytimes.com/2020/05/13/opinion/elizabeth-warren-vp-biden.html', 'snippet': 'If Biden wants to win the White House and govern like a New Dealer, Warren is his indispensable partner.', 'lead_paragraph': 'Joe Biden built his political career as the New Deal order came to an end, one of a generation of Democrats who sought to reconcile the Democratic Party to the Reagan revolution by placing distance between the party and the racial and cultural upheavals of the 1960s and 1970s. His was a politics attuned to the worries and fears of suburban white voters, from busing and crime to guns and drugs.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/opinion/13bouie1/merlin_169381665_22e524b3-e4a3-41af-97d0-3424c16e3aba-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/13/opinion/13bouie1/merlin_169381665_22e524b3-e4a3-41af-97d0-3424c16e3aba-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/opinion/13bouie1/merlin_169381665_22e524b3-e4a3-41af-97d0-3424c16e3aba-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/opinion/13bouie1/merlin_169381665_22e524b3-e4a3-41af-97d0-3424c16e3aba-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/opinion/13bouie1/13bouie1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/13/opinion/13bouie1/13bouie1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/opinion/13bouie1/13bouie1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Elizabeth Warren Knows What Joe Biden Needs in a Vice President', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Vice Presidents and Vice Presidency (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Liberalism (US Politics)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Protection', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-05-13T09:00:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jamelle Bouie', 'person': [{'firstname': 'Jamelle', 'middlename': None, 'lastname': 'Bouie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/60122890-edbf-5238-9895-f69383c8acb0', 'word_count': 1444, 'uri': 'nyt://article/60122890-edbf-5238-9895-f69383c8acb0'}, {'abstract': 'As the coronavirus pandemic keeps him homebound, the greatest living baseball player is missing visits to the ballpark, as well as opportunities to promote a new book on his life.', 'web_url': 'https://www.nytimes.com/2020/05/13/sports/baseball/willie-mays-book.html', 'snippet': 'As the coronavirus pandemic keeps him homebound, the greatest living baseball player is missing visits to the ballpark, as well as opportunities to promote a new book on his life.', 'lead_paragraph': 'Baseball is almost like oxygen for Willie Mays. He spent a month this year with his old team, the San Francisco Giants, at spring training in Scottsdale, Ariz., where baseball’s greatest living player served as unofficial clubhouse greeter. In normal times, Mays would now be a regular presence at the Giants’ home games, sharing stories and laughs.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/sports/12kepner-mays1-print/merlin_64970834_222aec20-446d-4cb3-92b1-1f8c7f762279-articleLarge.jpg', 'height': 434, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/15/sports/12kepner-mays1-print/merlin_64970834_222aec20-446d-4cb3-92b1-1f8c7f762279-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 434}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/sports/12kepner-mays1-print/merlin_64970834_222aec20-446d-4cb3-92b1-1f8c7f762279-jumbo.jpg', 'height': 740, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/sports/12kepner-mays1-print/merlin_64970834_222aec20-446d-4cb3-92b1-1f8c7f762279-superJumbo.jpg', 'height': 1480, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/sports/12kepner-mays1-print/12kepner-mays-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/15/sports/12kepner-mays1-print/12kepner-mays-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/15/sports/12kepner-mays1-print/12kepner-mays-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Willie Mays at 89: ‘My Thing Is Keep Talking and Keep Moving’', 'kicker': 'On Baseball', 'content_kicker': None, 'print_headline': 'The Say Hey Kid at 89:  He Misses the Game, and It Misses Him', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mays, Willie', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': '24: Life Stories and Lessons from the Say Hey Kid (Book)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Shea, John (Journalist)', 'rank': 5, 'major': 'N'}], 'pub_date': '2020-05-13T09:00:27+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tyler Kepner', 'person': [{'firstname': 'Tyler', 'middlename': None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d3a644e-0168-53d6-ba3c-2833e96410b2', 'word_count': 1242, 'uri': 'nyt://article/1d3a644e-0168-53d6-ba3c-2833e96410b2'}, {'abstract': 'The former vice president has unified the party and is leading in the polls. But some Democrats say he faces familiar challenges, including slow decision-making and flaws in his digital operation.', 'web_url': 'https://www.nytimes.com/2020/05/13/us/politics/joe-biden-donald-trump-2020.html', 'snippet': 'The former vice president has unified the party and is leading in the polls. But some Democrats say he faces familiar challenges, including slow decision-making and flaws in his digital operation.', 'lead_paragraph': 'In his first weeks as the presumptive Democratic nominee, Joseph R. Biden Jr. went days at a time with no public events. His campaign staff in early April was about half the size of Hillary Clinton’s at the same time in 2016. A much-touted virtual rally last week was riddled with glitches. And Mr. Biden and his advisers remain stuck at home, uncertain if their Philadelphia headquarters will ever reopen.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/us/politics/13biden-campaign-01/merlin_169715457_72acf7bd-2bf8-4683-8620-114f55d275de-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/13/us/politics/13biden-campaign-01/merlin_169715457_72acf7bd-2bf8-4683-8620-114f55d275de-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/us/politics/13biden-campaign-01/merlin_169715457_72acf7bd-2bf8-4683-8620-114f55d275de-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/13/us/politics/13biden-campaign-01/merlin_169715457_72acf7bd-2bf8-4683-8620-114f55d275de-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 's