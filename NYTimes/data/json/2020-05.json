jor': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Urban Areas', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Buildings (Structures)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Beirut (Lebanon)', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-05-09T16:12:32+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Bernardo Zacka', 'person': [{'firstname': 'Bernardo', 'middlename': None, 'lastname': 'Zacka', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/79e3d26a-b93a-5f3a-8604-dc063c26a0de', 'word_count': 1260, 'uri': 'nyt://article/79e3d26a-b93a-5f3a-8604-dc063c26a0de'}, {'abstract': 'Congress should enact a federal jobs guarantee.', 'web_url': 'https://www.nytimes.com/2020/05/09/opinion/federal-jobs-guarantee-coronavirus.html', 'snippet': 'Congress should enact a federal jobs guarantee.', 'lead_paragraph': 'On Friday, the Labor Department announced that over 20.5 million Americans lost their jobs in April, bringing the unemployment rate to 14.7 percent. This level of devastation has not been reached since the Great Depression. With more than one in four companies shuttered to minimize the pandemic’s death toll and at least 30 million workers seeking unemployment benefits, we are in the throes of an unprecedented jobs crisis.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/09/opinion/09blackwell-hamilton/merlin_172311585_ee7a404a-470f-4a6c-a0cb-6df91931d288-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/09/opinion/09blackwell-hamilton/merlin_17