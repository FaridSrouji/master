umbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14bin2/14bin2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14bin2/14bin2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/14/opinion/14bin2/14bin2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/14/opinion/14bin2/14bin2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'America’s Cities Could House Everyone if They Chose To', 'kicker': None, 'content_kicker': None, 'print_headline': 'America’s Cities Could House Everyone, If They Chose To.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homeless Persons', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Group Homes and Supportive Housing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Public and Subsidized Housing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Affordable Housing', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Urban Areas', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-05-15T09:00:44+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d339e8d2-5715-55e8-b83a-fb9098e8760a', 'word_count': 1996, 'uri': 'nyt://article/d339e8d2-5715-55e8-b83a-fb9098e8760a'}, {'abstract': 'Door attendants and supers keep New York’s miniature vertical cities humming. But that’s not all they’re doing.', 'web_url': 'https://www.nytimes.com/2020/05/15/nyregion/coronavirus-doormen-residential-nyc.html', 'snippet': 'Door attendants and supers keep New York’s miniature vertical cities humming. But that’s not all they’re doing.', 'lead_paragraph': 'When Genc Rrahmani was growing up in Kosovo, he would fantasize about his future life in New York City. “I was thinking that the U.S. has a lot of money,” Genc said recently. “That I would work hard and start a business, and have a beautiful future with a beautiful family.”', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/17/nyregion/17nyvirus-doormen-1/merlin_172224498_a519cbc9-9f6e-4185-ad04-80a095ee933a-articleLarge.jpg', 'height': 412, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/17/nyregion/17nyvirus-doormen-1/merlin_172224498_a519cbc9-9f6e-4185-ad04-80a095ee933a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 412}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/17/nyregion/17nyvirus-doormen-1/merlin_172224498_a519cbc9-9f6e-4185-ad04-80a095ee933a-jumbo.jpg', 'height': 704, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type'