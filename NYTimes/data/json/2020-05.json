: 'N'}, {'name': 'subject', 'value': 'Oxygen', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Immune System', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Jacobi Medical Center', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Weiler, Jack D, Hospital (Bronx, NY)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 12, 'major': 'N'}], 'pub_date': '2020-05-02T18:37:02+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6d842c41-37db-5d09-9ff5-1bdb58649ff2', 'word_count': 1289, 'uri': 'nyt://article/6d842c41-37db-5d09-9ff5-1bdb58649ff2'}, {'abstract': 'We may not be able to worship together, but that doesn’t mean we can’t act in concert.', 'web_url': 'https://www.nytimes.com/2020/05/02/opinion/coronavirus-church-christianity.html', 'snippet': 'We may not be able to worship together, but that doesn’t mean we can’t act in concert.', 'lead_paragraph': 'In public life we spend a lot of time talking about what should be done. When it comes to who should do it, the discussion often becomes an impersonal, contentious and dehumanizing debate that reduces people to “the poor” or “the middle class” or “the 1 percent.” No one really likes it, but that’s the way we talk about politics.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/02/opinion/02Buskirk/02Buskirk-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/