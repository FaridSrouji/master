s_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Juliet Macur', 'person': [{'firstname': 'Juliet', 'middlename': None, 'lastname': 'Macur', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/99ecc6a8-9951-5f7b-aab2-5f3e35e35d7e', 'word_count': 1621, 'uri': 'nyt://article/99ecc6a8-9951-5f7b-aab2-5f3e35e35d7e'}, {'abstract': 'The drug failed as a treatment for hepatitis and Ebola. With federal funding, scientists trained it on the coronavirus.', 'web_url': 'https://www.nytimes.com/2020/05/01/health/coronavirus-remdesivir.html', 'snippet': 'The drug failed as a treatment for hepatitis and Ebola. With federal funding, scientists trained it on the coronavirus.', 'lead_paragraph': 'Remdesivir, an antiviral drug designed to treat both hepatitis and a common respiratory virus, seemed fated to join thousands of other failed medications after proving useless against those diseases. The drug was consigned to the pharmaceutical scrap heap, all but forgotten by the scientists who once championed it.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/01/science/01VIRUS-REMDESIVIR2/01VIRUS-REMDESIVIR2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/01/science/01VIRUS-REMDESIVIR2/01VIRUS-REMDESIVIR2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/01/science/01VIRUS-REMDESIVIR2/01VIRUS-REMDESIVIR2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/01/sci