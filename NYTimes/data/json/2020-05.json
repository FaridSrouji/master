ank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1f04c45a-463b-51ec-a6e1-e215845987c4', 'word_count': 797, 'uri': 'nyt://article/1f04c45a-463b-51ec-a6e1-e215845987c4'}, {'abstract': 'Vernon Chalker helped to turn what was once considered a menial job, bartending, into a celebrated career.', 'web_url': 'https://www.nytimes.com/2020/05/08/world/australia/vernon-chalker-gin-palace-cocktails-melbourne.html', 'snippet': 'Vernon Chalker helped to turn what was once considered a menial job, bartending, into a celebrated career.', 'lead_paragraph': 'A couple of decades ago, I took the long trip from New York to Queensland to visit my family for Christmas. My birthday falls in early January, and I told my brother that I’d like to go out for some cocktails to celebrate. He looked perplexed — there weren’t many cocktails to be found in Queensland back then.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/08/world/08australialetter156-1/08australialetter156-1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/08/world/08australialetter156-1/08australialetter156-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/08/world/08australialetter156-1/08australialetter156-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/08/world/08australialetter156-1/08australialetter156-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020