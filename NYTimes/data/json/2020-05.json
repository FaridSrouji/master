/ml-hulihuli-chicken/ml-hulihuli-chicken-articleLarge-v2.jpg', 'height': 480, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/24/dining/ml-hulihuli-chicken/ml-hulihuli-chicken-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 480}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/dining/ml-hulihuli-chicken/ml-hulihuli-chicken-jumbo-v2.jpg', 'height': 819, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/dining/ml-hulihuli-chicken/ml-hulihuli-chicken-superJumbo-v2.jpg', 'height': 1638, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/dining/ml-hulihuli-chicken/ml-hulihuli-chicken-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/24/dining/ml-hulihuli-chicken/ml-hulihuli-chicken-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/24/dining/ml-hulihuli-chicken/ml-hulihuli-chicken-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'So Much Flavor', 'kicker': None, 'content_kicker': None, 'print_headline': '5 Dishes To Cook This Week', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}], 'pub_date': '2020-05-22T16:30:05+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Emily Weinstein', 'person': [{'firstname': 'Emily', 'middlename': N