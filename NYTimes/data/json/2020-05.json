aption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/18/fashion/18joy-slowjog/18joy-slowjog-superJumbo.gif', 'height': 1080, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/18/fashion/18joy-slowjog/18joy-slowjog-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/18/fashion/18joy-slowjog/18joy-slowjog-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/18/fashion/18joy-slowjog/18joy-slowjog-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Joy of Jogging Very, Very Slowly', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Joy of Jogging Very, Very Slowly', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Exercise', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'New York City Marathon', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 5, 'major': 'N'}], 'pub_date': '2020-05-18T04:10:06+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Alexandra Jacobs', 'person': [{'firstname': 'Alexandra', 'middlename': None, 'lastname': 'Jacobs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5e127212-1ad0-57ee-93dd-ebf56247796e', 'word_count': 785, 'uri': 'nyt://article/5e127212-1ad0-57ee-93dd-ebf56247796e'}, {'abstract': 'No longer do I have to make creative excuses for the things I don’t want to do. Science and nature have done that for me.', 'web_url': 'https://www.nytimes.com/2020/05/18/style/no-plans-joy.html', 'snippet': 'No longer do I have to make creative excuses for the things I don’t want to do. Science and nature have done that for me.', 'lead_paragraph': 'We isolated as a family a full 10 days before others; one of my sons has asthma, and it was clear we weren’t getting good information — Sure! Masks won’t help prevent a respiratory illness! Sure! We became like Pompeii, frozen in place in a house in the suburbs that I’d longed to leave until all of this happened. Now, we’re left to find the smaller things that give us joy, and I’m not finding much. Also, my 9-year-old? He hums all the time, it turns out. All. The. Time.', 'print_section': 'TP', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/18/fashion/18joy-plans/18joy-plans-articleLarge-v2.jpg', 'height': 263, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/18/fashion/18joy-plans/18joy-plans-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 263}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/18/fashion/18joy-plans/18joy-plans-jumbo-v2.jpg', 'height': 448, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/18/fashion/18joy-plans/18joy-plans-superJumbo.gif', 'height': 1080, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/18/fashion/18joy-plans/18joy-plans-thumbStandard-v2.jpg', 