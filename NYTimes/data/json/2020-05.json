ages/2020/05/19/opinion/19convoWeb/19convoWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/05/19/opinion/19convoWeb/19convoWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/19/opinion/19convoWeb/19convoWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Strange Things Happen When You Spend a Couple of Months in Lockdown', 'kicker': 'The conversation', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Russian Interference in 2016 US Elections and Ties to Trump Associates', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Nineties', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantine (Life and Culture)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Sweden', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Flynn, Michael T', 'rank': 8, 'major': 'N'}], 'pub_date': '2020-05-19T09:00:19+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Gail Collins and Bret Stephens', 'person': [{'firstname': 'Gail', 'middlename': None, 'lastname': 'Collins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Bret', 'middlename': None, 'lastname': 'Stephens', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/3d370365-d541-5685-ac5e-83fca01aa369', 'word_count': 1524, 'uri': 'nyt://article/3d370365-d541-5685-ac5e-83fca01aa369'}, {'abstract': 'Researchers thought Covid-19 might displace climate change as a threat in the American mind. It hasn’t, according to a new survey.', 'web_url': 'https://www.nytimes.com/2020/05/19/climate/coronavirus-climate-change-survey.html', 'snippet': 'Researchers thought Covid-19 might displace climate change as a threat in the American mind. It hasn’t, according to a new survey.', 'lead_paragraph': 'Americans’ positions on climate change have remained largely unshaken by the coronavirus pandemic and economic crisis, according to a new national survey that showed acceptance of the reality of global warming at record highs in some categories.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/19/climate/19CLI-YALESURVEY1/merlin_161144961_82461bfb-b65c-4387-a202-e95bedbdcf39-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/05/19/climate/19CLI-YALESURVEY1/merlin_161144961_82461bfb-b65c-4387-a202-e95bedbdcf39-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/19/climate/19CLI-YALESURVEY1/merlin_161144961_82461bfb-b65c-4387-a202-e95bedbdcf39-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/05/19/climate/19CLI-YALESURVEY1/merlin_161144961_82461bfb-b65c-4387-a202-e95bedbdcf39-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': N