c510ce-7fc8-5fe1-b27d-4b306a3c3d75', 'word_count': 115, 'uri': 'nyt://article/e8c510ce-7fc8-5fe1-b27d-4b306a3c3d75'}, {'abstract': 'Miller is electric in a Matthew Williamson dress at the All Saints dinner in Richmond, England.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/10/14/look-of-the-moment-sienna-miller-2/', 'snippet': 'Miller is electric in a Matthew Williamson dress at the All Saints dinner in Richmond, England.', 'lead_paragraph': 'The Look: Fluff Piece — an electric dress with feathers and plenty of sparkling appliqués is as attention-grabbing as any bird of paradise.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Look of The Moment | Sienna Miller', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Miller, Sienna', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T20:15:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Edward Barsamian', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Barsamian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/504afb8d-3f29-5be1-a7d8-48f83af7e137', 'word_count': 58, 'uri': 'nyt://article/504afb8d-3f29-5be1-a7d8-48f83af7e137'}, {'abstract': 'A new report by Better Markets, a nonprofit group advocating constraints on speculative trading, blames Wall Street for inflating prices at the gas pump and the grocery store.', 'web_url': 'https://dealbook.nytimes.com/2011/10/14/report-faults-wall-street-for-high-energy-prices/', 'snippet': 'A new report by Better Markets, a nonprofit group advocating constraints on speculative trading, blames Wall Street for inflating prices at the gas pump and the grocery store.', 'lead_paragraph': 'A new report by Better Markets, a nonprofit group advocating constraints on speculative trading, blames Wall Street for inflating prices at the gas pump and the grocery store.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Report Faults Wall Street for High Energy Prices', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-14T20:15:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Protess', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c498b55c-d31f-5d52-922e-140ee271c6ea', 'word_count': 320, 'uri': 'nyt://article/c498b55c-d31f-5d52-922e-140ee271c6ea'}, {'abstract': 'Riding the Great Allegheny Passage, the author is glad to be outdoors as the colors change.', 'web_url': 'https://intransit.blogs.nytimes.com/2011/10/14/a-burst-of-autumn-color-in-the-great-allegheny-passage/', 'snippet': 'Riding the Great Allegheny Passage, the author is glad to be outdoors as the colors change.', 'lead_paragraph': 'CUMBERLAND, Md. — One reason I began my cross-country bike trip in midsummer was so I could be on the road as the seasons changed. I had some chilly, autumnal weather before it was actually autumn, but the foliage has been slow to turn this year. It’s only in the past week or so that the colors have taken on the burned yellows and burnished reds that we associate with fall, but I was lucky enough to be in the woods when it happened. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Burst of Autumn Color in the Great Allegheny Passage', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bicycles and Bicycling', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Maryland', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-14T20:15:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Bruce Weber', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Weber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6be622ab-e34d-5d3f-9b90-34565b04c139', 'word_count': 536, 'uri': 'nyt://article/6be622ab-e34d-5d3f-9b90-34565b04c139'}, {'abstract': 'A reporter for Politico resigned on Thursday after allegations that she had used content in a number of stories from that had been published by other sources.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/10/14/politico-reporter-resigns-amid-plagiarism-allegations/', 'snippet': 'A reporter for Politico resigned on Thursday after allegations that she had used content in a number of stories from that had been published by other sources.', 'lead_paragraph': 'A reporter for the news Web site Politico resigned on Thursday after allegations that she had used content in a number of her stories from articles that had been published in The New York Times, The Associated Press, NJ.com and other sources.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Politico Reporter Resigns Amid Plagiarism Allegations', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Politico, The', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T20:18:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_