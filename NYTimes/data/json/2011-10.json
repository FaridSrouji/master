_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New York City', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Bowery (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Occupy Wall Street', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T23:15:40+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/9a2db4ac-b064-5aa7-9b62-88eea1d8a9c7', 'word_count': 0, 'uri': 'nyt://slideshow/9a2db4ac-b064-5aa7-9b62-88eea1d8a9c7'}, {'abstract': 'The Spanish choreographer Cuqui Jerez presented “The Rehearsal” at home at the Performing Garage, headquarters of the Wooster Group.', 'web_url': 'https://www.nytimes.com/2011/10/15/arts/dance/one-definition-of-collaboration-putting-heads-together-then-taking-turns.html', 'snippet': 'The Spanish choreographer Cuqui Jerez presented “The Rehearsal” at home at the Performing Garage, headquarters of the Wooster Group.', 'lead_paragraph': 'Cuqui Jerez is a Spanish choreographer, but her show “The Rehearsal” is not a dance. It is being presented by Performance Space 122, but not at Performance Space 122, which is undergoing renovations. And those are only two of the contradictions built into this offering at the Crossing the Line festival. At the show’s opening on Wednesday, Ms. Jerez and the four other troupe members seemed right at home at the Performing Garage, headquarters of the playfully experimental Wooster Group.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/REHEARSAL/REHEARSAL-jumbo.jpg', 'height': 765, 'width': 1024, 'subType': 'jumbo', 'crop_name':