'}, {'abstract': 'A deal with the International Monetary Fund will end a period of uncertainty for donors and the Afghan government about whether small development projects and salary support programs will go forward.', 'web_url': 'https://www.nytimes.com/2011/10/07/world/asia/afghanistan-deal-with-imf-will-renew-credit-program.html', 'snippet': 'A deal with the International Monetary Fund will end a period of uncertainty for donors and the Afghan government about whether small development projects and salary support programs will go forward.', 'lead_paragraph': 'KABUL, Afghanistan — Afghanistan’s management of its banking system has improved enough that the International Monetary Fund is ready to renew its credit program with the country, the fund said in a statement on Thursday. ', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Afghan Deal With I.M.F. Will Revive Flow of Aid', 'kicker': None, 'content_kicker': None, 'print_headline': 'Afghan Deal With I.M.F. Will Revive Flow of Aid', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'International Monetary Fund', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Kabul Bank', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-06T23:37:13+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Alissa J. Rubin', 'person': [{'firstname': 'Alissa', 'middlename': 'J.', 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4709334d-c971-5f1e-8b32-07b3d422ab38', 'word_count'