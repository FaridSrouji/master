 'N'}, {'name': 'persons', 'value': 'Ramirez, Cesar', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Fare', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Michelin Group', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-04T20:09:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90912cdd-e282-54b4-840f-059abe7f9a73', 'word_count': 365, 'uri': 'nyt://article/90912cdd-e282-54b4-840f-059abe7f9a73'}, {'abstract': 'The famed French chef has a Japanese restaurant in Monaco.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/10/04/joel-robuchon-is-stephen-hansons-japanese-consultant-for-kibo/', 'snippet': 'The famed French chef has a Japanese restaurant in Monaco.', 'lead_paragraph': 'Joël Robuchon, the renowned French chef, is the consultant for Kibo, the first Japanese restaurant from Stephen Hanson’s BR Guest restaurant group. That may seem like an unusual choice, but Mr. Robuchon does have a Japanese restaurant in Monaco, Yoshi, with a Michelin star.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Joël Robuchon Is Stephen Hanson’s ‘Japanese’ Consultant for Kibo', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hanson, Steve', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Robuchon, Joel', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-04T20:09:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bbaca24d-be31-56e2-9d4f-dc6aba173cf5', 'word_count': 415, 'uri': 'nyt://article/bbaca24d-be31-56e2-9d4f-dc6aba173cf5'}, {'abstract': 'The Moscow String Quartet’s interpretation of Borodin’s String Quartet No. 2 was enhanced by the Frick Collection’s elegant space.', 'web_url': 'https://www.nytimes.com/2011/10/05/arts/music/moscow-string-quartet-at-frick-collection-review.html', 'snippet': 'The Moscow String Quartet’s interpretation of Borodin’s String Quartet No. 2 was enhanced by the Frick Collection’s elegant space.', 'lead_paragraph': 'One of the sunniest pieces of classical music ever written, Borodin’s String Quartet No. 2, which the composer dedicated to his wife of 20 years, seems to imply that all is well with the world. The third-movement Notturno, which furnished the melody of the song “And This Is My Beloved” in the Borodin-drenched musical “Kismet,” is particularly dewy.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/arts/QUARTET/QUARTET-articleLarge.jpg', 'height': 362, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/05/arts/QUARTET/QUARTET-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 362}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/arts/QUARTET/QUARTET-jumbo.jpg', 'height': 726, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/arts/QUARTET/QUARTET-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/05/arts/QUARTET/QUARTET-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Borodin Glows in an Intimate Salon', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Borodin Glows in an Intimate Salon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Moscow String Quartet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Frick Collection', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Borodin Quartet', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-04T20:15:18+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/97261c07-866d-5cee-b132-106c0c8d63b1', 'word_count': 397, 'uri': 'nyt://article/97261c07-866d-5cee-b132-106c0c8d63b1'}, {'abstract': 'Calvin Tomkins will be honored by the Whitney Museum of American Art for his artist profiles in The New Yorker.', 'web_url': 'https://www.nytimes.com/2011/10/05/arts/calvin-tomkins-continues-to-chronicle-artists.html', 'snippet': 'Calvin Tomkins will be honored by the Whitney Museum of American Art for his artist profiles in The New Yorker.', 'lead_paragraph': 'Calvin Tomkins, who has chronicled the lives of artists for The New Yorker for half a century, has somehow managed to escape the ritual of interrogation to which he has subjected everyone from Andy Warhol on down. One recent afternoon, sitting at a glass-topped table in his brightly minimalist apartment on the Upper East Side, he mentioned that he had never been profiled and is pr