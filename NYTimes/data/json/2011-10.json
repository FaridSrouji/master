images/2011/10/28/arts/28PUSS_SPAN/PUSS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 255}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/28/arts/28PUSS_SPAN/PUSS-jumbo.jpg', 'height': 435, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/28/arts/28PUSS_SPAN/28PUSS_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/28/arts/28PUSS_SPAN/28PUSS_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Fairy Tale Mix With 9 Lives and Dozens of Egg Jokes', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'A Fairy Tale Mix With 9 Lives and Dozens of Egg Jokes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hayek, Salma', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Banderas, Antonio', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Galifianakis, Zach', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Miller, Chris', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ANIMATED FILMS', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-27T21:49:00+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d297adfc-5340-51ef-97ac-e57017675fc8', 'word_count': 720, 'uri': 'nyt://article/d297adfc-5340-51ef-97ac-e57017675fc8'}, {'abstract': '“Like Crazy” is about young lovers struggling to get their lives together and what happens when immigration policies keep them apart.', 'web_url': 'https://www.nytimes.com/2011/10/28/movies/like-crazy-from-drake-doremus-review.html', 'snippet': '“Like Crazy” is about young lovers struggling to get their lives together and what happens when immigration policies keep them apart.', 'lead_paragraph': 'Love takes a beating (though really it just gets roughed up some) in “Like Crazy,” Drake Doremus’s romance about young lovers struggling to get it — their relationship, emotions, sentences, time zones and paperwork — together. The likable Anton Yelchin and Felicity Jones play Jacob and Anna, two very un-crazy kids who, after meeting at their Los Angeles college, fall in like and then bed, love and then trouble when Anna, a British citizen, overstays her visa, as Jacob nods his approval. Later, when she tries to return to the United States, the meanies at immigration don’t let her back into the country. Tears, separations and texting ensue in this low-key slice of American indie-film realism.', 'print_section': 'C', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In This Tale of Modern Love, a Visa Stands in the Way of Desire', 'kicker': "Movie Review | 'Like Crazy'", 'content_kicker': None, 'print_headline': 'In This Tale of Modern Love, a Visa Stands in the Way of Desire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Doremus, Drake', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Yelchin, Anton', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Felicity', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lawrence, Jennifer', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-27T22:04:17+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d75d34e7-98cf-5161-a812-9a9473801932', 'word_count': 703, 'uri': 'nyt://article/d75d34e7-98cf-5161-a812-9a9473801932'}, {'abstract': '“The Age of Movies” and “Pauline Kael: A Life in the Dark” chronicle the life and career of the movie critic who transformed the sensibility and standards of mainstream pop culture criticism in America.', 'web_url': 'https://www.nytimes.com/2011/10/30/books/review/roaring-at-the-screen-with-pauline-kael.html', 'snippet': '“The Age of Movies” and “Pauline Kael: A Life in the Dark” chronicle the life and career of the movie critic who transformed the sensibility and standards of mainstream pop culture criticism in America.', 'lead_paragraph': 'In his introduction to “The Age of Movies,” the Library of America anthology canonizing Pauline Kael, Sanford Schwartz writes that she was “undoubtedly the most fervently read American critic of any art” during her two-\xaddecade tenure at The New Yorker. That’s not hyperbole. Such was the power of Kael’s voluminous writing about movies that she transformed the sensibility and standards of mainstream pop culture criticism in America — mostly for the better, despite her bullying personality (in print and in life), her sloppy professional ethics and her at times careerist escapades in self-dramatizing contrarianism. She had a lot to write about. Her prime years as a critic happily coincided with sequential renaissances in foreign cinema (the 1960s) and American movies (the 1970s). Week after week, she whipped up torrents of copy that could make causes célèbres out of even the most ephemeral Hollywood fluff. She upended journalistic criticism the way contemporaneous New Journalists like Tom Wolfe and Hunter Thompson revolutionized reportage. Her essays, fiercely present in the moment and epic in length, buttonholed readers so they’d feel as if they were sitting next to her in the dark, seeing every\xadthing she saw. She fired up her exultantly vernacular American prose as if she were writing high-octane fiction, not passing judgment on “Cabaret.”', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/books/review/30-RICH-COVER/30-RICH-COVER-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/30/books/review/30-RICH-COVER/30-RICH-COVER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/books/review/30-RICH-COVER/30-RICH-COVER-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/books/review/30-RICH-COVER/30-RICH-COVER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/30/books/review/30-RICH-COVER/30-RICH-COVER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Roaring at the Screen With Pauline Kael', 'kicker': None, 'content_kicker': None, 'print_headline': 'Roaring at the Screen', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kellow, Brian', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kael, Pauline', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-27T22:07:20+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Frank Rich', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/50fa489e-0992-585b-bd3b-32f5da719a95', 'word_count': 3490, 'uri': 'nyt://article/50fa489e-0992-585b-bd3b-32f5da719a95'}, {'abstract': 'The former Times theater critic and Op-Ed columnist recalls a night out with Pauline Kael, and being impressed by her “capacity for alcohol and her garrulous laughter.”', 'web_url': 'https://www.nytimes.com/2011/10/30/books/review/up-front-frank-rich.html', 'snippet': 'The former Times theater critic and Op-Ed columnist recalls a night out with Pauline Kael, and being impressed by her “capacity for alcohol and her garrulous laughter.”', 'lead_paragraph': 'On this week’s cover, Frank Rich reviews a biography of Pauline Kael and an anthology of her writings. “My fondest memory of Kael is being invited to tag along with her and a few acolytes (I was not one) to the old Downey’s saloon on Eighth Avenue after a screening,” Rich said in an e-mail, “and being impressed by her capacity for alcohol and her garrulous laughter.”', 'print_section': 'BR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/books/review/Upfront/Upfront-jumbo.jpg', 'height': 1024, 'width': 743, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/books/review/Upfront/Upfront-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/30/books/review/Upfront/Upfront-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Up Front: Frank Rich', 'kicker': None, 'content_kicker': None, 'print_headline': 'Up Front', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rich, Frank', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-27T22:07:26+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By The Editors', 'person': [], 'organization': 'The Editors'}, 'type_of_material': 'News', '_id': 'nyt://article/8c4bb5e2-463e-511c-9ad0-a6ca8fc2d535', 'word_count': 327, 'uri': 'nyt://article/8c4bb5e2-463e-511c-9ad0-a6ca8fc2d535'}, {'abstract': 'Horror has not been as important to the video game industry as it has been for Hollywood, yet the scariest games have become as terrifying as the likes of “Paranormal Activity 3.”', 'web_url': 'https://www.nytimes.com/2011/10/28/arts/video-games/zork-to-amnesia-the-dark-descent-horror-in-video-games.html', 'snippet': 'Horror has not been as important to the video game industry as it has been for Hollywood, yet the scariest games have become as terrifying as the likes of “Paranormal Activity 3.”', 'lead_paragraph': 'The first time a video game frightened me, the only graphics system was my own imagination.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/28/arts/28HORROR_SPAN/28HORROR_SPAN-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/28/arts/28HORROR_SPAN/28HORROR_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/28/arts/28HORROR_SPAN/28HORROR-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 