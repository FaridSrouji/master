': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Budapest (Hungary)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Hungary', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-11T13:41:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/95e9ec1a-fe0e-5fe6-abf2-c339830bd00e', 'word_count': 263, 'uri': 'nyt://article/95e9ec1a-fe0e-5fe6-abf2-c339830bd00e'}, {'abstract': 'A 16-year-old’s efforts to share his thoughts aloud in a college class bring into sharp relief the tenuous balance between an individual’s needs and the good of a group.', 'web_url': 'https://thechoice.blogs.nytimes.com/2011/10/11/hand-raised-high-a-stutterer/', 'snippet': 'A 16-year-old’s efforts to share his thoughts aloud in a college class bring into sharp relief the tenuous balance between an individual’s needs and the good of a group.', 'lead_paragraph': 'I hope readers of The Choice will take a moment today to read my colleague Richard Perez-Pena’s nuanced account of Phillip Garber Jr.’s efforts to get his professor at County College of Morris in New Jersey to call on him in class.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hand Raised High, a Stutterer Struggles to be Heard in Class', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-11T13:47:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Jacques Steinberg', 'person': [{'firstname': 'Jacques', 'middlename': None, 'lastname': 'Steinberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b43496ac-64f2-589c-9cb0-525a126852c6', 'word_count': 222, 'uri': 'nyt://article/b43496ac-64f2-589c-9cb0-525a126852c6'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/10/11/what-were-reading-287/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'Fresh Off the Boat: Eddie Huang says Andy Ricker of Pok Pok, in Portland, Ore., will be taking over the original BaoHaus in a few weeks to serve up his famous Thai-style chicken wings. Mr. Ricker won Best Chef Northwest at the James Beard Awards this year. — Nick Fox', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-11T13:53:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/29929004-5638-561b-944b-b014a2b92409', 'word_count': 568, 'uri': 'nyt://article/29929004-5638-561b-944b-b014a2b92409'}, {'abstract': 'Immelt really doesn’t get it.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/10/11/intellectual-styles-of-the-rich-and-clueless/', 'snippet': 'Immelt really doesn’t get it.', 'lead_paragraph': 'Oh, my. Jeff Immelt, who President Obama for some reason appointed to head his job creation panel, insists that what’s good for GE is good for America:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Intellectual Styles Of The Rich And Clueless', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-11T13:59:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/826b1cec-37a3-50d0-8a93-6b225494abce', 'word_count': 176, 'uri': 'nyt://article/826b1cec-37a3-50d0-8a93-6b225494abce'}, {'abstract': 'Activists who write about protests in Bahrain and the government’s response say they face an often aggressive effort to cajole, harass and intimidate them.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/10/11/twitter-trolls-haunt-discussions-of-bahrain-online/', 'snippet': 'Activists who write about protests in Bahrain and the government’s response say they face an often aggressive effort to cajole, harass and intimidate them.', 'lead_paragraph': 'That bit of advice about Bahrain, delivered to Twitter followers of a conference of Arab bloggers in Tunisia last week, highlights an often aggressive effort on social media to cajole, harass and intimidate commentators and journalists who write about the protests in Bahrain and the government’s response. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Twitter Trolls’ Haunt Discussions of Bahrain Online', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Twitter', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Bahrain', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-11T14:00:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By J. David Goodman', 'person': [{'firstname': 'J.', 'middlename': 'David', 'lastname': 'Goodman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f014f4bd-2013-514d-b1f3-48b895c95f31', 'word_count': 1008, 'uri': 'nyt://article/f014f4bd-2013-514d-b1f3-48b895c95f31'}, {'abstract': 'Two sisters turn pie baking into a booming business in industrial Brooklyn.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/10/11/edible-selby-pie-squared/', 'snippet': 'Two sisters turn pie baking into a booming business in industrial Brooklyn.', 'lead_paragraph': 'Melissa and Emily Elsen, two sisters from South Dakota, opened Four & Twenty Blackbirds, their pie and coffee shop in the Gowanus section of Brooklyn, with the expectation that they would serve about 10 pies a day. A little over a year later, they are averaging more like 50 pies a day, with customers traveling from around New York City to sample their fresh, seasonal fillings, like blueberry rhubarb or strawberry balsamic. Though they are doing a brisk business, the sisters Elsen continue to make their crust from scratch, two pounds at a time. “We love the homespun, hands-on intensity of it,” Emily says. “When you make a good pie crust, it’s really gratifying.” Go to interactive feature >>', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Edible Selby | Pie Squared', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pies', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Four & Twenty Blackbirds', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-11T14:00:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Todd Selby and Abby Aguirre', 'person': [{'firstname': 'Todd', 'middlename': None, 'lastname': 'Selby', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Abby', 'middlename': None, 'l