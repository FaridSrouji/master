 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c0550dd0-4e4b-5b99-9d60-5f877020efe1', 'word_count': 433, 'uri': 'nyt://article/c0550dd0-4e4b-5b99-9d60-5f877020efe1'}, {'abstract': 'A study of a City Council proposal to increase pay for workers on city-subsidized projects has added fuel to the debate over the measure.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/10/05/study-says-higher-wage-bill-for-city-projects-would-cost-jobs/', 'snippet': 'A study of a City Council proposal to increase pay for workers on city-subsidized projects has added fuel to the debate over the measure.', 'lead_paragraph': 'A proposal that would require companies to pay higher wages on city-subsidized projects would result in a loss of jobs, according to the final version of a long-awaited study of the proposal released by the city’s economic development agency.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Study Says Higher-Wage Bill for City Projects Would Cost Jobs', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-05T14:11:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By KATE TAYLOR', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'TAYLOR', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1f13ee63-772f-5b42-8484-16a79bb80ec9', 'word_count': 693, 'uri': 'nyt://article/1f13ee63-772f-5b42-8484-16a79bb80ec9'}, {'abstract': 'A.J. Burnett saves the Yankees, to everyone’s surprise, but the Tigers are feeling the sting of Curtis Granderson’s spectacular catches.', 'web_url': 'https://bats.blogs.nytimes.com/2011/10/05/leading-off-the-unlikeliest-hero/', 'snippet': 'A.J. Burnett saves 