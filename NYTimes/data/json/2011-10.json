ption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/12/dining/12KITCH2_SPAN/12KITCH2_SPAN-jumbo-v3.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/12/dining/12KITCH2_SPAN/12KITCH2_SPAN-superJumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/12/dining/12KITCH2_SPAN/12KITCH2_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/12/dining/12KITCH2_SPAN/12KITCH2_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/12/dining/12KITCH2_SPAN/12KITCH2_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Worldly Mussel Likes Time at Home', 'kicker': 'City Kitchen', 'content_kicker': None, 'print_headline': 'The Worldly Mussel Likes Time at Home', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mussels', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fish and Other Marine Life', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-07T18:17:09+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e6a0a20-7106-5ea1-8ad4-48726235b977', 'word_count': 402, 'uri': 'nyt://article/0e6a0a20-7106-5ea1-8ad4-48726235b977'}, {'abstract': 'France wants to dip into the European bailout fund to replenish its banks’ capital stock; Germany says no. The dispute between two biggest guarantors of the fund clouds any end to the debt crisis.', 'web_url': 'https://www.nytimes.com/2011/10/08/business/global/europe-seems-to-agree-on-recapitalizing-banks-but-how.html', 'snippet': 'France wants to dip into the European bailout fund to replenish its banks’ capital stock; Germany says no. The dispute between two biggest guarantors of the fund clouds any end to the debt crisis.', 'lead_paragraph': 'European leaders are finally coming around to the view that banks must be compelled to replenish their capital reserves if the euro area is ever to emerge from the debt crisis. But whether the politicians can make it happen in a convincing manner is another question — especially given that Germany and France are already divided.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/08/business/BANK/BANK-jumbo.jpg', 'height': 730, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Europe Seems to Agree on Recapitalizing Banks — but How?', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'In France and Germany, Divergence On How to Recapitalize Their Banks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-07T18:20:33+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Jack Ewing and Stephen Castle', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Ewing', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Stephen', 'middlename': None, 'lastname': 'Castle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/e931204b-a511-52d4-918a-b71b4c6cf1a6', 'word_count': 1306, 'uri': 'nyt://article/e931204b-a511-52d4-918a-b71b4c6cf1a6'}, {'abstract': 'Autumn Unfolds: The patch of forest in Inwood Hill Park lost a yellow, but it picked up some cherry, crimson and scarlet.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/10/07/reds-increase-and-a-monarch-makes-an-appearance/', 'snippet': 'Autumn Unfolds: The patch of forest in Inwood Hill Park lost a yellow, but it picked up some cherry, crimson and scarlet.', 'lead_paragraph': 'See a larger version of the forest from this week. Compare with the blow-up of last week. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reds Increase, and a Monarch Makes an Appearance', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Flowers and Plants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Forests and Forestry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Insects', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Seasons and Months', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'INWOOD HILL PARK (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-07T18:21:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Marielle Anzelone', 'person': [{'firstname': 'Marielle', 'middlename': None, 'lastname': 'Anzelone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a607ca04-6b54-568c-b880-0b4893dfd971', 'word_count': 529, 'uri': 'nyt://article/a607ca04-6b54-568c-b880-0b4893dfd971'}, {'abstract': 'Theaster Gates, a Chicago artist, takes wood from old factories and turns it into art — or ladders.', 'web_url': 'https://www.nytimes.com/2011/10/09/fashion/salvaged-industrial-wood-becomes-art.html', 'snippet': 'Theaster Gates, a Chicago artist, takes wood from old factories and turns it into art — or ladders.', 'lead_paragraph': 'LIKE many people today, from amateurs to avant-garde architects, Theaster Gates has a soft spot for the glory days of the American industrial past. Mr. Gates, a Chicago artist, salvages what he can from the warehouses and factories that are being torn down in and around the city, many of which date to the turn of the last century. Sturdy old wood timbers have proved a special weakness. ', 'print_section': 'ST', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/fashion/09POSSESSED/09POSSESSED-jumbo.jpg', 'height': 1024, 'width': 495, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/fashion/09POSSESSED/09POSSESSED-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/fashion/09POSSESSED/09POSSESSED-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Finding the Poetry in the Industrial Past', 'kicker': 'Possessed', 'content_kicker': None, 'print_headline': 'Finding the Poetry In the Industrial Past', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ladders', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wood and Wood Products', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Museum of Contemporary Art', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-07T18:25:39+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By David Colman', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Colman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/53e774b9-e9b0-57e9-8672-bd6e114211b8', 'word_count': 680, 'uri': 'nyt://article/53e774b9-e9b0-57e9-8672-bd6e114211b8'}, {'abstract': "Megan Liberman and Nicholas Confessore discuss Mitt Romney's new donors as he takes advantage of the settled field.", 'web_url': 'https://www.nytimes.com/video/multimedia/100000001098952/the-caucus--new-mitt-romney-donors.html', 'snippet': "Megan Liberman and Nicholas Confessore discuss Mitt Romney's new donors as he takes advantage of the settled field.", 'lead_paragraph': "Megan Liberman and Nicholas Confessore discuss Mitt Romney's new donors as he takes advantage of the settled field.", 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/07/multimedia/video-caucus-100711-romney/video-caucus-100711-romney-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/07/multimedia/video-caucus-100711-romney/video-caucus-100711-romney-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/07/multimedia/video-caucus-100711-romney/video-caucus-100711-romney-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/20