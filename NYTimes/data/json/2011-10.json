 experiences.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Shot Heard Round Brooklyn', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Branca, Ralph', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Thomson, Bobby', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Dodgers', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-26T00:07:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ken Belson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Belson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/49ef9b44-9ff4-5312-ab89-12fcaede9c1b', 'word_count': 750, 'uri': 'nyt://article/49ef9b44-9ff4-5312-ab89-12fcaede9c1b'}, {'abstract': 'Heinz Tomato Ketchup Blended with Balsamic Vinegar will be available on Facebook starting Nov. 14 in advance of its supermarket debut in December.', 'web_url': 'https://www.nytimes.com/2011/10/26/business/media/ketchup-moves-upmarket-with-a-balsamic-tinge.html', 'snippet': 'Heinz Tomato Ketchup Blended with Balsamic Vinegar will be available on Facebook starting Nov. 14 in advance of its supermarket debut in December.', 'lead_paragraph': 'TO emphasize its thickness, Heinz ketchup introduced a series of commercials in the 1970s that featured “Anticipation,” the Carly Simon song, which played as actors waited longingly for ketchup to pour onto burgers and fries. ', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/26/business/ADCO/ADCO-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/26/business/ADCO/ADCO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/26/business/ADCO/ADCO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Ketchup Moves Upmarket, With a Balsamic Tinge', 'kicker': 'Advertising', 'content_kicker': None, 'print_headline': 'Ketchup Moves Upmarket, With A Balsamic Tinge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ketchup', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Behavior', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Condiments', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Vinegar', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Heinz, H J, Co', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-26T00:09:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Andrew Adam Newman', 'person': [{'firstname': 'Andrew', 'middlename': 'Adam', 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/864b9866-c21a-52d5-8958-89ba37381054', 'word_count': 925, 'uri': 'nyt://article/864b9866-c21a-52d5-8958-89ba37381054'}, {'abstract': 'Whenever the lockout is resolved, the N.B.A. will build a new schedule from scratch, using all arena dates that are still reserved, according to people who ar