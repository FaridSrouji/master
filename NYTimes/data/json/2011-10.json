cker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cantor, Eric', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 9, 'major': 'N'}], 'pub_date': '2011-10-05T17:56:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ben Werschkul', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Werschkul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e44acb0-f016-53d9-bcba-50d7d0ca2a8b', 'word_count': 32, 'uri': 'nyt://article/8e44acb0-f016-53d9-bcba-50d7d0ca2a8b'}, {'abstract': 'David Cronenberg, the director of “A Dangerous Method,” discusses his film about Sigmund Freud and Carl Jung.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/10/05/david-cronenbergs-method/', 'snippet': 'David Cronenberg, the director of “A Dangerous Method,” discusses his film about Sigmund Freud and Carl Jung.', 'lead_paragraph': 'While the latest film from David Cronenberg is a further departure from the psychological horror films of his early career, it does still put psychology (and psychoanalysis) at the forefront. “A Dangerous Method,” starring Viggo Mortensen, Michael Fassbender and Keira Knightley, takes place on the eve of World War I and looks at the relationship between the psychiatrist Carl Jung and his mentor Sigmund Freud. That relationship shifts when Jung takes on and develops a close bond to a new patient, Sabina Spielrein, played by Ms. Knightley. The film’s screenplay was adapted by Christopher Hampton from his stage play, “The Talking Cure.” The Times’s Stephen Holden writes about “A Dangerous Method” in his notebook about films in the festival. In this video, Mr. Cronenberg discusses how he and his team used source material — letters written by the two main subjects — to create an accurate account of both the personal and professional lives of these men.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'David Cronenberg’s ‘Method’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New York Film Festival', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cronenberg, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fassbender, Michael', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Freud, Sigmund', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hampton, Christopher', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Jung, Carl Gustav', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Knightley, Keira', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Mortensen, Viggo', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-10-05T18:00:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7dc40338-2cd7-5801-ae57-d43da27c3c6b', 'word_count': 157, 'uri': 'nyt://article/7dc40338-2cd7-5801-ae57-d43da27c3c6b