rds': [{'name': 'subject', 'value': 'Fires and Firefighters', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parachutes and Parachute Jumping', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Forest Service', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Winthrop (Wash)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-02T23:57:52+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By William Yardley', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Yardley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29b06633-6e27-5ada-8015-3662466eedb6', 'word_count': 951, 'uri': 'nyt://article/29b06633-6e27-5ada-8015-3662466eedb6'}, {'abstract': 'A reader responds to an editorial on a bill in New York that would ban mandatory mail-order programs.', 'web_url': 'https://www.nytimes.com/2011/10/03/opinion/mail-order-pharmacies.html', 'snippet': 'A reader responds to an editorial on a bill in New York that would ban mandatory mail-order programs.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mail-Order Pharmacies', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Mail-Order Pharmacies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mail Order Companies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-02T23:59:34+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/736c0a8b-9b4a-5b52-9755-4a458bf91a6c', 'word_count': 216, 'uri': 'nyt://article/736c0a8b-9b4a-5b52-9755-4a458bf91a6c'}, {'abstract': 'Transforming the single-family home by paying attention to what residents, and communities, really need.', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/10/02/shifting-the-suburban-paradigm/', 'snippet': 'Transforming the single-family home by paying attention to what residents, and communities, really need.', 'lead_paragraph': 'Is there anything made in America that’s less innovative than the single-family home? While we obsess over the new in terms of what we keep in our houses — the ever-increasing speed and functionality of our Smartphones, entertainment options built into refrigerators, sophisticated devices that monitor, analyze and report on our sleep cycles, even the superior technology of the running shoes we put on before heading out the flimsy fiberboard door — we’re incredibly undemanding of the houses themselves. These continue to be built the same way they have for over a century, and usually not as well. Walls and windows are thin, materials cheap, design (and I use the term loosely) not well-considered. The building process is a protracted affair, taking far too long and creating embarrassing amounts of building waste (over 50 percent of all waste produced in the United States, in fact).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Shifting the Suburban Paradigm', 'kicker': 'Allison Arieff', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-03T00:00:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Allison Arieff', 'person': [{'firstname': 'Allison', 'middlename': None, 'lastname': 'Arieff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b317c49-939f-57a6-874e-2d15dfa275bc', 'word_count': 1689, 'uri': 'nyt://article/1b317c49-939f-57a6-874e-2d15dfa275bc'}, {'abstract': 'Mashable, a news Web site focusing on the world of digital culture and social media, is becoming an attractive place for advertisers.', 'web_url': 'https://www.nytimes.com/2011/10/03/business/media/mashable-once-a-one-man-blog-gains-clout-in-social-media.html', 'snippet': 'Mashable, a news Web site focusing on the world of digital culture and social media, is becoming an attractive place for advertisers.', 'lead_paragraph': 'Pete Cashmore acknowledged he was nervous. Only a few years ago, he was living with his parents in a small town in northeast Scotland, trying to start a technology blog. Now, at 26, he was about to interview Elie Wiesel, the 82-year-old Holocaust survivor and Nobel Peace Prize winner, onstage at the 92nd Street Y, about the future of ethics in a digitally connected world. ', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/03/business/jp-MASHABLE-2/jp-MASHABLE-2-jumbo.jpg', 'height': 1024, 'width': 614, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/03/business/jp-MASHABLE-2/jp-MASHABLE-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/03/business/jp-MASHABLE-2/jp-MASHABLE-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Social Media News Site Gains Clout', 'kicker': None, 'content_kicker': None, 'print_headline': 'Social Media News Site Gains Clout', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blogs and Blogging (Internet)', 'rank': 1, 'major'