major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Scorsese, Martin', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-04T21:51:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5d1000d6-1d65-5f9c-8edb-d4c86d8f4793', 'word_count': 741, 'uri': 'nyt://article/5d1000d6-1d65-5f9c-8edb-d4c86d8f4793'}, {'abstract': '“Benito Cereno” by Robert Lowell, is certainly poetic, and its questions concerning cruelty and civilized life are ripe for inquiry.', 'web_url': 'https://www.nytimes.com/2011/10/05/theater/reviews/benito-cereno-from-horizon-theater-rep-review.html', 'snippet': '“Benito Cereno” by Robert Lowell, is certainly poetic, and its questions concerning cruelty and civilized life are ripe for inquiry.', 'lead_paragraph': '“Benito Cereno” has so much to say. Based on a novella by Herman Melville, the play, by the poet Robert Lowell, is keen to rail against oppression and condemn political hypocrisy. It’s a pity, then, that the stagey production by the Horizon Theater Rep sometimes muffles the script’s voice.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/arts/BENITO/BENITO-jumbo.jpg', 'height': 650, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/arts/BENITO/BENITO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/05/arts/BENITO/BENITO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Strange Ship, Stranger Crew', 'kicker': "Theater Review | 'Benito Cereno'", 'content_kicker': None, 'print_headline': 'Strange Ship, Stranger Crew', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Horizon Theater Rep', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lowell, Robert', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-04T21:55:57+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'subsection_name': 'Theater Reviews', 'byline': {'original': 'By Ken Jaworowski', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Jaworowski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6fd1dab3-97aa-52e6-b7c9-bbd6fe2d1469', 'word_count': 281, 'uri': 'nyt://article/6fd1dab3-97aa-52e6-b7c9-bbd6fe2d1469'}, {'abstract': 'Sonny Vandevelde’s Paris fashion week photo diary.', 'web_url': 'https://www.nytimes.com/slideshow/2011/10/04/t-magazine/04potm-paco.html', 'snippet': 'Sonny Vandevelde’s Paris fashion week photo diary.', 'lead_paragraph': 'Sonny Vandevelde’s Paris fashion week photo diary.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/04/t-magazine/04potm-paco-slide-SOU6/04potm-paco-slide-SOU6-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/04/t-magazine/04potm-paco-slide-SOU6/04potm-paco-slide-SOU6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/04/t-magazine/04potm-paco-slide-SOU6/04potm-paco-slide-SOU6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Photos of the Moment | Paco Rabanne', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-04T21:56:48+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/ae855cee-a861-5824-aadf-38dc74dc723f', 'word_count': 0, 'uri': 'nyt://slideshow/ae855cee-a861-5824-aadf-38dc74dc723f'}, {'abstract': '“Jesus Christ Superstar” which has been an audience and critical favorite there since May, will transfer to Broadway and begin preview performances on March 1.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/10/04/jesus-christ-superstar-returning-to-broadway/', 'snippet': '“Jesus Christ Superstar” which has been an audience and critical favorite there since May, will transfer to Broadway and begin preview performances on March 1.', 'lead_paragraph': 'Musicals with religious themes – as well as those with Andrew Lloyd Webber scores – are filling up Broadway theaters this season. The Stratford Shakespeare Festival’s production of Mr. Lloyd Webber’s “Jesus Christ Superstar,” which has been an audience and critical favorite there since May, will transfer to Broadway and begin preview performances on March 1, 2012, at the Neil Simon Theater, the producers announced on Tuesday. The revival of the 1971 rock opera, which has lyrics by Tim Rice, will first move to the La Jolla Playhouse later this year. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Jesus Christ Superstar’ Returning to Broadway', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-04T22:00:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c12c54f2-0ecd-5f84-a4ca-3960c793dbab', 'word_count': 256, 'uri': 'nyt://article/c12c54f2-0ecd-5f84-a4ca-3960c793dbab'}, {'abstract': 'The owner of the Cheese Store of Beverly Hills, will be answering readers’ questions on cheese.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/10/04/q-and-a-with-norbert-wabnig/', 'snippet': 'The owner of the Cheese Store of Beverly Hills, will be answering readers’ questions on cheese.', 'lead_paragraph': 'This week, Jeff Gordinier writes about affinage, the practice of aging cheese until it ripens —\xa0a touchy topic among fromage fanatics. Norbert Wabnig, the owner of the Cheese Store of Beverly Hills, will be answering readers’ questions on cheese, from the social (how do you assemble the perfect cheese plate?) to the more gustatory (when are you supposed to eat the rind?). If you would like to ask a question, post it as a comment below and he will respond in a later post.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Q. and A. With Norbert Wabnig', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-04T22:03:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/edf1a96d-c196-50c9-998d-0f3bc3b9b0bd', 'word_count': 86, 'uri': 'nyt://article/edf1a96d-c196-50c9-998d-0f3bc3b9b0bd'}, {'abstract': 'Mr. Langone’s decision came just hours after Mr. Christie announced to the world that he would not make a bid for the White House.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/10/04/leading-christie-supporter-turns-to-romney/', 'snippet': 'Mr. Langone’s decision came just hours after Mr. Christie announced to the world that he would not make a bid for the White House.', 'lead_paragraph': 'Ken Langone, the billionaire Home Depot founder who in recent weeks led an intense but unsuccessful effort to draft the New Jersey governor, Christopher J. Christie, into the presidential race, has decided he will now support Mitt Romney, the former Massachusetts governor, according to two people with knowledge of the decision.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Leading Christie Supporter Turns to Romney', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Druckenmiller, Stanley F', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lee, James B Jr', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-10-04T22:05:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': 