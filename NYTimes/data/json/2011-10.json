major': 'N'}, {'name': 'glocations', 'value': 'Colorado', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T15:39:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By J. David Goodman', 'person': [{'firstname': 'J.', 'middlename': 'David', 'lastname': 'Goodman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/41f3166d-d8f6-5e6a-844e-47aab2e8592b', 'word_count': 313, 'uri': 'nyt://article/41f3166d-d8f6-5e6a-844e-47aab2e8592b'}, {'abstract': 'No phone plus no cable equals no business for many frustrated merchants in one of Manhattan’s most expensive commercial districts.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/10/14/is-verizon-out-again-madison-ave-cant-connect/', 'snippet': 'No phone plus no cable equals no business for many frustrated merchants in one of Manhattan’s most expensive commercial districts.', 'lead_paragraph': 'At Bistro Chat Noir, an upscale French restaurant on Manhattan’s Upper East Side frequented by celebrities like Woody Allen, Madonna and Natalie Portman, the phone and Internet service is often out, so credit cards cannot be processed. When that happens, Suzanne Latapie, a manager and one of the owners, asks customers to fill out forms with their credit card information, so she can process payments later, sometimes using a neighbor’s Internet line.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is Verizon Out Again?  Madison Ave. Can’t Connect', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Telephones and Telecommunications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Verizon Communications Inc', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Madison Avenue (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T15:43:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Alice Speri', 'person': [{'firstname': 'Alice', 'middlename': None, 'lastname': 'Speri', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c43f0321-a5b8-58cc-bf13-043753c2312f', 'word_count': 858, 'uri': 'nyt://article/c43f0321-a5b8-58cc-bf13-043753c2312f'}, {'abstract': 'Sgt. Jeffrey Sarver said the film was based on him without his permission.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/10/14/judge-dismisses-war-veterans-suit-over-the-hurt-locker/', 'snippet': 'Sgt. Jeffrey Sarver said the film was based on him without his permission.', 'lead_paragraph': ' Score one for the screenwriter. A United States District Court judge in Los Angeles has dismissed a lawsuit by an Iraq war veteran, Sgt. Jeffrey Sarver, that claimed the film “The Hurt Locker” was based on him without his permission and that he had suffered ridicule because of it and was denied employment. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Veteran’s ‘Hurt Locker’ Lawsuit Dismissed', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Boal, Mark', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-14T15:46:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44e76e87-ec40-5637-886c-c1af7478e571', 'word_count': 226, 'uri': 'nyt://article/44e76e87-ec40-5637-886c-c1af7478e571'}, {'abstract': 'A visitor fondly recalls the crystal-clear water in deserted coves of the Maddalena archipelago.', 'web_url': 'https://www.nytimes.com/slideshow/2011/10/16/travel/20111016-SARDINIA.html', 'snippet': 'A visitor fondly recalls the crystal-clear water in deserted coves of the Maddalena archipelago.', 'lead_paragraph': 'A visitor fondly recalls the crystal-clear water in deserted coves of the Maddalena archipelago.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/travel/16SARDINIA-slide-V3BA/16SARDINIA-slide-V3BA-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/travel/16SARDINIA-slide-V3BA/16SARDINIA-slide-V3BA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/travel/16SARDINIA-slide-V3BA/16SARDINIA-slide-V3BA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sardinia, Remembered', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Sardinia (Italy)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T15:52:42+0000', 'document_type': 'multimedia', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/1a1b7703-ccb0-5699-bd4e-83bbdc09dcf9', 'word_count': 0, 'uri': 'nyt://slideshow/1a1b7703-ccb0-5699-bd4e-83bbdc09dcf9'}, {'abstract': 'The deserted coves and crystal-clear waters of childhood are now matched by upscale hotels.', 'web_url': 'https://www.nytimes.com/2011/10/16/travel/a-return-to-sardinias-maddalena-archipelago.html', 'snippet': 'The deserted coves and crystal-clear waters of childhood are now matched by upscale hotels.', 'lead_paragraph': 'ON a mid-September day in the Maddalena archipelago, off the northeast shore of Sardinia, autumn still felt far off. The temperature hovered around 85 degrees, but a light Mediterranean wind kept our sailboat moving briskly and the ship’s captain, Luca Imbagliazzo, and me pleasantly cool.', 'print_section': 'TR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/travel/16JOURNEYS1_SPAN/16JOURNEYS1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/16/travel/16JOURNEYS1_SPAN/16JOURNEYS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/travel/16JOURNEYS1_SPAN/16JOURNEYS1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/travel/16JOURNEYS1_SPAN/16JOURNEYS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/travel/16JOURNEYS1_SPAN/16JOURNEYS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In S