: 'images/2011/10/29/nyregion/NOCTURNALIST/NOCTURNALIST-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/29/nyregion/NOCTURNALIST/NOCTURNALIST-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'What a Gentleman Wears to Receive an Award', 'kicker': 'Nocturnalist', 'content_kicker': None, 'print_headline': 'What a Gentleman Wears to Receive an Award', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'GQ', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parties (Social)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lucas, Josh', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sudeikis, Jason', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kutcher, Ashton', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rivers, Joan', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Peterson, Adrian', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Hayek, Salma', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Varvatos, John', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Shoes and Boots', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Redbook', 'rank': 13, 'major': 'N'}], 'pub_date': '2011-10-29T02:04:31+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sarah Maslin Nir', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eb00ca55-a5c4-5c70-ad75-8064a2bf064a', 'word_count': 754, 'uri': 'nyt://article/eb00ca55-a5c4-5c70-ad75-8064a2bf064a'}, {'abstract': 'Numbers don’t lie. The United States gets low scores in a new report on social justice.', 'web_url': 'https://www.nytimes.com/2011/10/29/opinion/blow-americas-exploding-pipe-dream.html', 'snippet': 'Numbers don’t lie. The United States gets low scores in a new report on social justice.', 'lead_paragraph': 'We are slowly — and painfully — being forced to realize that we are no longer the America of our imaginations. Our greatness was not enshrined. Being a world leader is less about destiny than focused determination, and it is there that we have faltered.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/charles-m-blow/charles-m-blow-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'America’s Exploding Pipe Dream', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'America’s Exploding Pipe Dream', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Bertelsmann Foundation', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Poverty', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-29T02:05:55+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Charles M. Blow', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9328d465-c7c2-5a1f-840a-c43329244b9b', 'word_count': 284, 'uri': 'nyt://article/9328d465-c7c2-5a1f-840a-c43329244b9b'}, {'abstract': 'Some specialists are taking a stand against overreliance on the scans, saying they are easily misinterpreted.', 'web_url': 'https://www.nytimes.com/2011/10/29/health/mris-often-overused-often-mislead-doctors-warn.html', 'snippet': 'Some specialists are taking a stand against overreliance on the scans, saying they are easily misinterpreted.', 'lead_paragraph': 'Dr. James Andrews, a widely known sports medicine orthopedist in Gulf Breeze, Fla., wanted to test his suspicion that M.R.I.’s, the scans given to almost every injured athlete or casual exer