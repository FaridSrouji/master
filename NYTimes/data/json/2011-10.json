ice?”', 'print_section': 'AR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/arts/30AUCTIONS1/30AUCTIONS1-jumbo.jpg', 'height': 1011, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/arts/30AUCTIONS1/30AUCTIONS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/30/arts/30AUCTIONS1/30AUCTIONS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Bouquet of Offerings to Test Uncertain Waters', 'kicker': 'Art', 'content_kicker': None, 'print_headline': 'A Bouquet of Offerings To Test Uncertain Waters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': "Sotheby's", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Christie's", 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Phillips de Pury & Company', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-28T18:33:47+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1402d8ed-28ec-5a53-9c72-7187da85d6de', 'word_count': 713, 'uri': 'nyt://article/1402d8ed-28ec-5a53-9c72-7187da85d6de'}, {'abstract': 'The fall auction season features a conservative mix of works by tried-and-true artists.', 'web_url': 'https://w