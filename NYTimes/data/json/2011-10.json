es', 'multimedia': [], 'headline': {'main': 'My Three Favorite TV Ads', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-27T19:20:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Gail Bichler', 'person': [{'firstname': 'Gail', 'middlename': None, 'lastname': 'Bichler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ea62ebd-cfd0-5e85-8417-7985803f3b80', 'word_count': 134, 'uri': 'nyt://article/0ea62ebd-cfd0-5e85-8417-7985803f3b80'}, {'abstract': 'Suggesting he is skeptical of the settlement, Judge Jed S. Rakoff laid out what he wanted the sides to answer at next month’s federal court hearing on the proposed $285 million deal.', 'web_url': 'https://dealbook.nytimes.com/2011/10/27/judge-rakoff-skeptical-of-s-e-c-settlement-with-citigroup/', 'snippet': 'Suggesting he is skeptical of the settlement, Judge Jed S. Rakoff laid out what he wanted the sides to answer at next month’s federal court hearing on the proposed $285 million deal.', 'lead_paragraph': '7:19 p.m. | Updated ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Judge Rakoff Questions S.E.C. Accord With Citigroup', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Securities and Commodities Violations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rakoff, Jed S', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stoker, Brian H', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Citigroup Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 6, 'majo