bstract': 'Thousands of Greeks walked off the job on Wednesday to protest a relentless austerity drive by a government that is struggling to avert a default.', 'web_url': 'https://www.nytimes.com/2011/10/06/world/europe/greek-workers-general-strike-protest-austerity.html', 'snippet': 'Thousands of Greeks walked off the job on Wednesday to protest a relentless austerity drive by a government that is struggling to avert a default.', 'lead_paragraph': 'ATHENS — Dino Giannopoulos, 50, kept right on selling papers from his newsstand in Syntagma Square on Wednesday even as thousands of public servants gathered nearby to protest a relentless series of government austerity measures.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/06/world/06greece2/06greece2-articleLarge.jpg', 'height': 368, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/06/world/06greece2/06greece2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 368}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/06/world/06greece2/06greece2-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/06/world/06greece2/06greece2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/06/world/06greece2/06greece2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Greeks Protest Cutbacks Amid Growing Weariness', 'kicker': None, 'content_kicker': None, 'print_headline': 'Greeks Protest Cutbacks Amid Growing Weariness', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations',