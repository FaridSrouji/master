me': 'Andy', 'middlename': None, 'lastname': 'Benoit', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/812d5c53-8837-5c6a-b370-380ae55b346c', 'word_count': 1498, 'uri': 'nyt://article/812d5c53-8837-5c6a-b370-380ae55b346c'}, {'abstract': 'The Brighton Veteran Car Run takes place annually with a procession of pre-1905 cars driving from London to Brighton, about 60 miles away, this year from Nov. 4 to 6.', 'web_url': 'https://intransit.blogs.nytimes.com/2011/10/31/antique-cars-on-display-and-on-the-road-in-london/', 'snippet': 'The Brighton Veteran Car Run takes place annually with a procession of pre-1905 cars driving from London to Brighton, about 60 miles away, this year from Nov. 4 to 6.', 'lead_paragraph': 'Two hundred years ago it was illegal to drive over four miles per hour on the streets of England, and cars had to be preceded by a man on foot waving a red flag. Luckily, in 1896, the speed limit was raised to 14 miles per hour and cars no longer had to have someone walk ahead of them — the red flag requirement having been eliminated in 1878. In the fall of 1896, motorists celebrated their newfound freedom by driving an “Emancipation Run” from London to the seaside town of Sussex. Today, a re-enactment of the event, now called the Brighton Veteran Car Run, takes place annually with a procession of pre-1905 cars driving from London to Brighton, about 60 miles away, this year from Nov. 4 to 6. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Antique Cars on Display, and on the Road, in London', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-31T10:00:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Amy Rose Dobson', 'person': [{'firstname': 'Amy', 'middlename': 'Rose', 'lastname': 'Dobson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d32a2a1b-c8b4-50ee-9424-9e529dce4639', 'word_count': 247, 'uri': 'nyt://article/d32a2a1b-c8b4-50ee-9424-9e529dce4639'}, {'abstract': 'Political news from today’s Times and a look at what’s happening in Washington.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/10/31/the-early-word-shortage/', 'snippet': 'Political news from today’s Times and a look at what’s happening in Washington.', 'lead_paragraph': 'Today’s Times', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Early Word: Shortage', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-31T10:00:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jada F. Smith', 'person': [{'firstname': 'Jada', 'middlename': 'F.', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d893c134-63fd-5a5b-a2c4-376624a72535', 'word_count': 254, 'uri': 'nyt://article/d893c134-63fd-5a5b-a2c4-376624a72535'}, {'abstract': 'People who provide care to their own families and others deserve better protections from the government, an economist writes.', 'web_url': 'https://economix.blogs.nytimes.com/2011/10/31/the-depreciation-of-care-at-home/', 'snippet': 'People who provide care to their own families and others deserve better protections from the government, an economist writes.', 'lead_paragraph': 'Nancy 