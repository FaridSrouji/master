tions', 'value': 'Indianapolis Museum of Art', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Indianapolis (Ind)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-20T21:33:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2d832dea-ab7d-5fda-af2a-1b7fe631a919', 'word_count': 173, 'uri': 'nyt://article/2d832dea-ab7d-5fda-af2a-1b7fe631a919'}, {'abstract': '“Wikipedia! The Musical!,” at the New York Public Library for the Performing Arts on Saturday, is intended to improve that Web site’s entries related to musical theater.', 'web_url': 'https://www.nytimes.com/2011/10/21/theater/editing-wikipedia-at-the-new-york-public-library-for-the-performing-arts.html', 'snippet': '“Wikipedia! The Musical!,” at the New York Public Library for the Performing Arts on Saturday, is intended to improve that Web site’s entries related to musical theater.', 'lead_paragraph': 'AMATEUR digital archivists and musical theater devotees are invited to the New York Public Library for the Performing Arts on Saturday for a six-hour “editathon,” an event meant to improve Wikipedia’s musical-theater-related entries using the library’s special collections.', 'print_section': 'C', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wikipedia’s Deep Dive Into a Library Collection', 'kicker': None, 'content_kicker': None, 'print_headline': 'Wikipedia’s Deep Dive Into a Library Collection', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Public Library for the Performing Arts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Libraries and Librarians', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Wikipedia', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-20T21:35:41+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Theater', 'byline': {'original': 'By Amanda Petrusich', 'person': [{'firstname': 'Amanda', 'middlename': None, 'lastname': 'Petrusich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac7967c3-92cf-504e-a5b4-b1f9758d8ab8', 'word_count': 562, 'uri': 'nyt://article/ac7967c3-92cf-504e-a5b4-b1f9758d8ab8'}, {'abstract': 'The International Fine Art & Antique Dealers Show at the Park Avenue Armory lets its more than 60 dealers run wild in their exhibits.', 'web_url': 'https://www.nytimes.com/2011/10/21/arts/design/fine-art-antique-dealers-at-park-avenue-armory-review.html', 'snippet': 'The International Fine Art & Antique Dealers Show at the Park Avenue Armory lets its more than 60 dealers run wild in their exhibits.', 'lead_paragraph': 'One size does not fit all at the annual International Fine Art & Antique Dealers Show, which is back at the Park Avenue Armory for a 23rd year. Unlike some other fairs at this space, this exposition doesn’t try to rein in its more than 60 exhibitors — a group that includes specialists in arms and armor, fine jewelry and illuminated manuscripts among its purveyors of art and antiques.', 'print_section': 'C', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/21/arts/21fair-span/21fair-span-articleLarge.jpg', 'height': 366, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/21/arts/21fair-span/21fair-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 366}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type'