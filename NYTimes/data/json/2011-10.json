nk': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8c622119-9870-5957-b45a-2aeb4b037b73', 'word_count': 1193, 'uri': 'nyt://article/8c622119-9870-5957-b45a-2aeb4b037b73'}, {'abstract': 'Advice on how to plate food for a crowd, handle a stingy host and react to a dish that’s gone horribly wrong.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/10/07/dear-flofab-what-do-you-say-about-a-cold-sweet-fish-course/', 'snippet': 'Advice on how to plate food for a crowd, handle a stingy host and react to a dish that’s gone horribly wrong.', 'lead_paragraph': 'Each week, Florence Fabricant gives advice on the fine points of entertaining at home and eating in restaurants. Have a dining dilemma? Ask FloFab.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dear FloFab: What Do You Say About a Cold, Sweet Fish Course?', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-07T12:00:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/340955d5-e9c5-5954-a70b-ca4e0b4981a6', 'word_count': 775, 'uri': 'nyt://article/340955d5-e9c5-5954-a70b-ca4e0b4981a6'}, {'abstract': 'The stage version of the Oscar-winning film will tour in Britain first.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/10/07/a-detour-on-road-to-broadway-for-the-kings-speech/', 'snippet': 'The stage version of the Oscar-winning film will tour in Britain first.', 'lead_paragraph': 'A stage version of “The King’s Speech,” the film that won the Academy Award for best picture this year, is no longer on a fast track to Broadway, as its author and one of its producers had originally envisioned. The play by David Seidler, who won an Oscar for best original screenplay for the film, will have a world-premiere production in February in Guildford, England, and then tour theaters in five other British cities through mid-March, according to the producers. A London production of the play may follow, according to a spokesman for the show, and Broadway remains a possibility.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Detour on Road to Broadway for ‘The King’s Speech’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Edwards, Charles', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Firth, Colin', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'George VI, King of Great Britain', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Noble, Adrian', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Rush, Geoffrey', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Seidler, David', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Royal Shakespeare Co', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'England', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 13, 'major': 'N'}], 'pub_date': '2011-10-07T12:11:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a2a941e6-a7c1-5ffb-985b-0f21f7eda4ed', 'word_count': 247, 'uri': 'nyt://article/a2a941e6-a7c1-5ffb-985b-0f21f7eda4ed'}, {'abstract': 'Looking for the Mumbai street staple in New York', 'web_url': 'https://india.blogs.nytimes.com/2011/10/07/the-worlds-best-vada-pav-nyc-edition/', 'snippet': 'Looking for the Mumbai street staple in New York', 'lead_paragraph': 'There’s something in the genetic makeup of every Indian which sparks nagging pangs for street food. On a late summer morning, as a strong breeze softened the stifling humidity, my husband Mahir and I had our cravings fulfilled on the Williamsburg waterfront.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The World’s Best Vada Pav, N.Y.C. Edition', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Local Food', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'BABBO', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Williamsburg (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-07T12:22:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Shivani Vora', 'person': [{'firstname': 'Shivani', 'middlename': None, 'lastname': 'Vora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b80db923-514b-5881-a08f-06fc27f27390', 'word_count': 494, 'uri': 'nyt://article/b80db923-514b-5881-a08f-06fc27f27390'}, {'abstract': 'American employers added 103,000 jobs in September, the Labor Department said Friday, indicating that the economy is at least not weakening. The jobless rate held steady at 9.1 percent.', 'web_url': 'https://www.nytimes.com/2011/10/08/business/economy/us-adds-103000-jobs-rate-steady-at-9-1.html', 'snippet': 'American employers added 103,000 jobs in September, the Labor Department said Friday, indicating that the economy is at least not weakening. The jobless rate held steady at 9.1 percent.', 'lead_paragraph': 'American companies are adding jobs slowly and unevenly, just enough to plug the dike against a wave of fears that the economy could slip back into recession. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/08/business/jobs/jobs-articleLarge.jpg', 'height': 335, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/08/business/jobs/jobs-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 335}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/08/business/jobs/jobs-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/08/business/jobs/jobs-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/08/business/jobs/jobs-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Adding Jobs, but Not Many, U.S. Economy Seems to Idle', 'kicker': None, 'content_kicker': None, 'print_headline': 'Modest Growth In Jobs Tempers Recession Fears', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major