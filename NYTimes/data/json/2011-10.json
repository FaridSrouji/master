': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/16/business/16-APPLE/16-APPLE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/business/16-APPLE/16-APPLE-jumbo.jpg', 'height': 606, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/business/16-APPLE/16-APPLE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/business/16-APPLE/16-APPLE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Genius of the Storefront, Too', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Genius of the Storefront, Too', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Apple Incorporated', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jobs, Steven P', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Glass', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-15T18:03:40+0000', 'document_type': 'article', 'news_desk': 'NAT', 'section_name': 'Business Day', 'byline': {'original': 'By James B. Stewart', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf0793a7-47f7-5942-8a50-e0861c812489', 'word_count': 1277, 'uri': 'nyt://article/cf0793a7-47f7-5942-8a50-e0861c812489'}, {'abstract': 'Why the tax plan is so bad, continued.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/10/15/a-bit-more-about-cain/', 'snippet': 'Why the tax plan is so bad, continued.', 'lead_paragraph': 'A brief note while waiting for a family member to finish with the doctor: From comments I see that some readers believe that Cain’s second “9” is a profits tax, which I’ve argued in the past probably falls on capital owners. But it isn’t: it’s a tax on all business income, defined as sales minus purchased inputs and dividends — but with no deduction for wages. So the new element here is, in effect, a 9 percent tax on wages paid.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Bit More About Cain', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-15T18:21:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b2f2ba44-9784-57f6-b6dd-72bab524ffad', 'word_count': 186, 'uri': 'nyt://article/b2f2ba44-9784-57f6-b6dd-72bab524ffad'}, {'abstract': 'A television advertisement that helped put Rick Perry over the top in his 1990 race for agriculture commissioner is still making racially tinged waves.', 'web_url': 'https://www.nytimes.com/2011/10/16/us/politics/news-analysis-perry-was-accused-of-racism-in-1990.html', 'snippet': 'A television advertisement that helped put Rick Perry over the top in his 1990 race for agriculture commissioner is still making racially tinged waves.', 'lead_paragraph': 'Critics largely gave Gov. Rick Perry a pass for hunting on a deer lease that once carried a racist name. Even the White House accepted Mr. Perry’s explanation that his family found the word abhorren