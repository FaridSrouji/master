: None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-03T23:08:14+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'None None', 'person': [{'firstname': 'None', 'middlename': None, 'lastname': 'None', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/573bcde0-d25c-5afe-8ccc-2a46eae92a84', 'word_count': 0, 'uri': 'nyt://video/573bcde0-d25c-5afe-8ccc-2a46eae92a84'}, {'abstract': 'A reading guide for the week that was.', 'web_url': 'https://bittman.blogs.nytimes.com/2011/10/03/last-week-in-food/', 'snippet': 'A reading guide for the week that was.', 'lead_paragraph': 'From the “With Friends Like These, Who Needs …” Department: Here’s a look inside the American Dietetic Association’s nutrition conference/expo, where you’ll hear all about how processed foods are an important source of nutrients. Argh. And: In an attempt to undermine the Food and Drug Administration’s current efforts to rationalize front-of-package labeling, industry groups have devised a new campaign: change “nutrition keys” to “facts up front.” And: Julia Moskin on the new United States Farmers and Ranchers Alliance, a well-funded Big Ag group that is – incredibly — trying to position itself as an underdog in the current food climate. (Apparently it doesn’t like the term “Big Ag,” but when you have $11 million to spend on public relations, and your members include the American Egg Board, the National Milk Producers Federation and the National Pork Board, that’s what you are.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Last Week in Food', 'kicker': 'Mark Bittman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Agriculture and Farming', 'rank': 1, 'maj