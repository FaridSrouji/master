ource': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Tough Year for Market Predictions', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Forecasts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-07T20:19:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Phyllis Messinger', 'person': [{'firstname': 'Phyllis', 'middlename': None, 'lastname': 'Messinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9f7a2cf8-81cb-5a3d-a097-bc854ded189f', 'word_count': 166, 'uri': 'nyt://article/9f7a2cf8-81cb-5a3d-a097-bc854ded189f'}, {'abstract': 'The Texas governor contrasts himself to Mitt Romney in an appearance before social conservatives.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/10/07/perry-highlights-abortion-stance-swipes-at-romney/', 'snippet': 'The Texas governor contrasts himself to Mitt Romney in an appearance before social conservatives.', 'lead_paragraph': 'Gov. Rick Perry of Texas sought on Friday to ease concerns of Republican primary voters who have questioned his credentials, highlighting his unwavering support for some red-meat conservative issues: Fighting abortion. Defunding Planned Parenthood. Support for Israel.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Swipe at Romney, Perry Highlights Abortion Stance', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 3, 'major': 'N'}, {'name':