name': 'persons', 'value': 'Nasser, Gamal Abdel', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-01T18:19:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Douglas Martin', 'person': [{'firstname': 'Douglas', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/bcf785a3-b00e-5414-9f02-f39618b47a3e', 'word_count': 567, 'uri': 'nyt://article/bcf785a3-b00e-5414-9f02-f39618b47a3e'}, {'abstract': 'The forceful personality of Antrel Rolle, the Giants’ leading tackler, has helped him assume a leadership role with the team.', 'web_url': 'https://www.nytimes.com/2011/10/02/sports/football/giants-rolle-dishes-punishing-hits-and-pugnacious-talk.html', 'snippet': 'The forceful personality of Antrel Rolle, the Giants’ leading tackler, has helped him assume a leadership role with the team.', 'lead_paragraph': 'EAST RUTHERFORD, N.J. — In a little more than a year and a half with the button-down, low-key Giants, Antrel Rolle has found some measure of controversy for, among other things, criticizing Tom Coughlin’s coaching style; comparing Coughlin to Rex Ryan; likening football players to soldiers serving in Iraq; opining on what would happen if the Giants were to play the Washington Redskins 100 times (the Giants would win 95); and, most recently, stating that it is sometimes essential for him to take a 15-yard unnecessary-roughness penalty. ', 'print_section': 'SP', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/02/sports/giants/giants-jumbo.jpg', 'height': 1024, 'width': 711, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'ran