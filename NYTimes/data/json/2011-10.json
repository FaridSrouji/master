: None}, 'type_of_material': 'News', '_id': 'nyt://article/92b43dc4-a102-5a47-a17d-ec2dcf21876b', 'word_count': 1347, 'uri': 'nyt://article/92b43dc4-a102-5a47-a17d-ec2dcf21876b'}, {'abstract': 'More Americans are questioning the Republicans’ flat tax plans, which keep rewarding the rich.', 'web_url': 'https://www.nytimes.com/2011/10/31/opinion/flat-taxes-and-angry-voters.html', 'snippet': 'More Americans are questioning the Republicans’ flat tax plans, which keep rewarding the rich.', 'lead_paragraph': 'By wide margins, Americans are now telling pollsters they want a tax system that raises more money and is more fair by asking the rich to pay more. They are connecting the dots between the lavish high-end tax cuts of the past decade and today’s serious problems — including widening inequality and mounting deficits — and demanding change. The Republican presidential candidates aren’t listening. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Flat Taxes and Angry Voters', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Flat Taxes and Angry Voters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Tax', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-10-31T02:08:18+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': No