title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b450810-f165-578a-b762-b375bdd534a2', 'word_count': 400, 'uri': 'nyt://article/1b450810-f165-578a-b762-b375bdd534a2'}, {'abstract': 'The musician and record producer Nile Rodgers has published a memoir, “Le Freak: An Upside Down Story of Family, Disco and Destiny.”', 'web_url': 'https://www.nytimes.com/2011/10/20/arts/music/nile-rodgerss-new-music-memoir-is-le-freak.html', 'snippet': 'The musician and record producer Nile Rodgers has published a memoir, “Le Freak: An Upside Down Story of Family, Disco and Destiny.”', 'lead_paragraph': 'The venerable musician and record producer Nile Rodgers, wearing a bandanna tied around his dreadlocks, fade-out sunglasses and a charcoal-gray pinstripe jacket, arrived at Cafe Luxembourg right on schedule one morning last week.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/arts/Nile/Nile-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/20/arts/Nile/Nile-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/arts/Nile/Nile-jumbo.jpg', 'height': 658, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/arts/Nile/Nile-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/20/arts/Nile/Nile-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Hit Maker’s Life and Lyrics', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Hit Maker’s Life and Lyrics', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rodgers, Nile', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-19T22:35:33+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/191f3e6e-e972-54b3-846a-390df5d3fbeb', 'word_count': 1304, 'uri': 'nyt://article/191f3e6e-e972-54b3-846a-390df5d3fbeb'}, {'abstract': 'Perhaps a response to the formal “Mad Men” mania in fashion, the greaser — with his slicked-back hair and fondness for leather jackets — has returned.', 'web_url': 'https://www.nytimes.com/2011/10/20/fashion/the-greaser-the-1950s-rebel-returns-to-fashion-noticed.html', 'snippet': 'Perhaps a response to the formal “Mad Men” mania in fashion, the greaser — with his slicked-back hair and fondness for leather jackets — has returned.', 'lead_paragraph': 'THE models at the September N. Hoolywood show were turned out as various early 1960s male archetypes, all with Brylcreem coifs. College nerds, sharkskin-suited flimflam men and “West Side Story” street toughs in high waters were well represented. But the leader of the pack was the greaser, in all of his popped-collar glory. ', 'print_section': 'E', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/fashion/20NOTICED2/20NOTICED2-jumbo.jpg', 'height': 1024, 'width': 679, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/fashion/20NOTICED2/20NOTICED2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/20/fashion/20NOTICED2/20NOTICED2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Grease Is the Word ... Again', 'kicker': 'Noticed', 'content_kicker': None, 'print_headline': 'Grease Is the Word ... Again', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-19T22:37:12+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By William Van Meter', 'person': [{'firstname': 'William', 'middlename': 'Van', 'lastname': 'Meter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e7312e4c-bf00-5b70-aa18-2e2429e66f5e', 'word_count': 571, 'uri': 'nyt://article/e7312e4c-bf00-5b70-aa18-2e2429e66f5e'}, {'abstract': 'The after-work scene during the week may be civil, but on the weekends, this tavern’s proximity to the meatpacking district becomes palpable.', 'web_url': 'https://www.nytimes.com/2011/10/20/fashion/the-tippler-a-tavern-under-chelsea-market-nyc-review.html', 'snippet': 'The after-work scene during the week may be civil, but on the weekends, this tavern’s proximity to the meatpacking district becomes palpable.', 'lead_paragraph': 'THE after-work scene at the Tippler, a new tavern under the Chelsea Market, is nothing if not civilized. Thirty-somethings in blazers and oxfords (for the guys) and skirts and ballet flats (for the girls) mingle over oysters and handmade cocktails, presumably discussing the goings-on at their respective advertising agencies or Web startups. ', 'print_sectio