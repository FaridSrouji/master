tname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/61741c4f-2e35-5f86-a87a-d220b3900994', 'word_count': 760, 'uri': 'nyt://article/61741c4f-2e35-5f86-a87a-d220b3900994'}, {'abstract': 'This word has appeared in 37 New York Times articles in the past year.', 'web_url': 'https://learning.blogs.nytimes.com/2011/10/04/word-of-the-day-memorialize/', 'snippet': 'This word has appeared in 37 New York Times articles in the past year.', 'lead_paragraph': 'memorialize •\\mə-ˈmȯr-e-ə-liz\\• verb', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Word of the Day | memorialize', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-04T04:05:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By The Learning Network', 'person': [], 'organization': 'The Learning Network'}, 'type_of_material': 'News', '_id': 'nyt://article/60cdf4bd-4e57-5712-82bc-670f1628c47c', 'word_count': 246, 'uri': 'nyt://article/60cdf4bd-4e57-5712-82bc-670f1628c47c'}, {'abstract': 'Justin Verlander was dominant enough for the Tigers while C.C. Sabathia struggled in the matchup of aces that was washed out in Game 1. Game 4 of the best-of-five division series is Tuesday.', 'web_url': 'https://www.nytimes.com/2011/10/04/sports/baseball/sabathia-stumbles-putting-yankees-on-verge-of-elimination.html', 'snippet': 'Justin Verlander was dominant enough for the Tigers while C.C. Sabathia struggled in the matchup of aces that was washed out in Game 1. Game 4 of the best-of-five division series is Tuesday.', 'lead_paragraph': 'DETROIT — Justin Verlander had done his job, pitching well enough to put his team in a position for a pivotal victory, but the final outcome was still in doubt. It was the ninth inning and Verlander, the Detroit Tigers ace, was out of the game and the closer Jose Valverde was on the mound, pitching to Derek Jeter with runners on first and second in a one-run game.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/sports/subYANKEES1/subYANKEES1-articleLarge.jpg', 'height': 341, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/05/sports/subYANKEES1/subYANKEES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 341}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/sports/subYANKEES1/subYANKEES1-jumbo.jpg', 'height': 874, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Season Starting to Slip Away', 'kicker': 'Tigers 5, Yankees 4', 'content_kicker': None, 'print_headline': 'Running Out Of Options: Sabathia Gives Lead Back, Putting Yankees On the Brink', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Verlander, Justin', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Tigers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sabathia, C C', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Soriano, Rafael', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-04T04:14:24+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4ea9746b-730f-52e5-9c6a-426c651aa97b', 'word_count': 995, 'uri': 'nyt://article/4ea9746b-730f-52e5-9c6a-426c651aa97b'}, {'abstract': 'Top stories in the news Tuesday morning.', 'web_url': 'https://india.blogs.nytimes.com/2011/10/04/newswallah-in-the-english-language-press-tuesday-2/', 'snippet': 'Top stories in the news Tuesday morning.', 'lead_paragraph': 'The leader of the movement to carve a separate state out of Andhra Pradesh rejected Prime Minister Manmohan Singh’s plea on Monday to end the ongoing agitation and provide more time to resolve the issue. (The Hindu) K. Chandrasekhar Rao, who had previously gone on a hunger strike in 2009, threatened again to fast to death unless the center came out with a clear-cut announcement mentioning a time frame within which the state of Telangana would be formed. “People are dying every day for the cause of Telangana,” Rao said.Jammu and Kashmir Chief Minister Omar Abdullah on Monday threatened to sue opposition leader Mehbooba Mufti for claiming he was involved in the death of a party worker (Hindustan Times). In a blistering statement during a swiftly convened news conference, Abdullah said he was ready to appear before the panel probing the matter. The Jammu and Kashmir Assembly adjourned Monday after members swapped abuses (Indian Express).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Newswallah: In the English-Language Press Tuesday', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rao, K Chandrasekhar', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-04T04:27:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Sruthi Gottipati', 'person': [{'firstname': 'Sruthi', 'middlename': None, 'lastname': 'Gottipati', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2f0a82b7-419a-57bb-8737-21c775dd9d8a', 'word_count': 313, 'uri': 'nyt://article/2f0a82b7-419a-57bb-8737-21c775dd9d8a'}, {'abstract': 'NYT Front Page for 10/04/11', 'web_url': 'https://www.nytimes.com/audio/2011/10/04/multimedia/04frontpage.html', 'snippet': 'NYT Front Page for 10/04/11', 'lead_paragraph': 'NYT Front Page for 10/04/11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'NYT Front Page for 10/04/11', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-04T05:05:59+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/db3dbafd-2d45-56ad-978c-b7e2f9574a7e', 'word_count': 0, 'uri': 'nyt://audio/db3dbafd-2d45-56ad-978c-b7e2f9574a7e'}, {'abstract': 'On ego problems in Congress and his own camp, yoga breathing and why democracy needs people of character.', 'web_url': 'https://india.blogs.nytimes.com/2011/10/04/a-conversation-with-anna-hazare/', 'snippet': 'On ego problems in Congress and his own camp, yoga breathing and why democracy needs people of character.', 'lead_paragraph': 'When we arrived in Anna Hazare’s village, the famous Ralegan Siddhi in rural Maharashtra, late last week, an aide had a curt message for us. Anna-ji, he said icily, was recovering from a long journey the previous day and would not be receiving any visitors. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Conversation With: Anna Hazare', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Legislatures and Parliaments', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gandhi, Mohandas K', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hazare, Anna', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Singh, Manmohan', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-04T05:19:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Lydia Polgreen and Hari Kumar', 'person': [{'firstname': 'Lydia', 'middlename': None, 'lastname': 'Polgreen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Hari', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4b034ad2-3f7d-5f60-a376-1dc19292f420', 'word_count': 689, 'uri': 'nyt://article/4b034ad2-3f7d-5f60-a376-1dc19292f420'}, {'abstract': 'Justin Verlander, the winning pitcher in Game 3 on Monday night, said he threw “harder than I would have liked for most of the game.”', 'web_url': 'https://www.nytimes.com/2011/10/04/sports/baseball/al-division-series-tigers-verlander-rides-his-fastball-past-the-yankees.html', 'snippet': 'Justin Verlander, the winning pitcher in Game 3 on Monday night, said he threw “harder than I would have liked for most of the game.”', 'lead_paragraph': 'DETROIT — Out of the 205 starts Justin Verlander has made in his major league career, he could not remember throwing as hard, or under as much duress, as he did against the Yankees on Monday night.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url