btype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/MORE/MORE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/15/arts/MORE/MORE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Messages From Prison to an Irresistible Beat', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Messages From Prison To an Irresistible Beat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Linyekula, Faustin', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T23:03:29+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Claudia La Rocco', 'person': [{'firstname': 'Claudia', 'middlename': None, 'lastname': 'La Rocco', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f27cb7dc-6880-5a8e-9322-db1162b38736', 'word_count': 652, 'uri': 'nyt://article/f27cb7dc-6880-5a8e-9322-db1162b38736'}, {'abstract': 'Apple’s virtual personal assistant tackles the big issues.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2011/10/14/siri-answers-questions-from-readers/', 'snippet': 'Apple’s virtual personal assistant tackles the big issues.', 'lead_paragraph': 'On Thursday, we asked readers to submit questions for Siri, Apple’s new virtual personal assistant in the iPhone 4S. Below are some of Siri’s most entertaining answers. We threw in some questions of our own because, well, once we got started, it was hard to stop. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Siri Answers Questions From Readers', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Siri Inc', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T23:04:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Sam Grobart', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Grobart', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7d8d5b3c-59e8-56af-ab76-a60587286e6a', 'word_count': 385, 'uri': 'nyt://article/7d8d5b3c-59e8-56af-ab76-a60587286e6a'}, {'abstract': 'Liz Gerring’s “She Dreams in Code,” at the Baryshnikov Arts Center, has several steps that stay powerfully in the memory.', 'web_url': 'https://www.nytimes.com/2011/10/15/arts/dance/she-dreams-in-code-by-liz-gerring-review.html', 'snippet': 'Liz Gerring’s “She Dreams in Code,” at the Baryshnikov Arts Center, has several steps that stay powerfully in the memory.', 'lead_paragraph': 'The amalgam of formality and informality, of technique and rawness (sometimes wildness) in the work of the choreographer Liz Gerring is something rare. Her six dancers, all attractive, look purpose-bred. The intensity with which they all use their backs is particularly impressive, as is the accentuation they bring to very simple steps. Yet they look neither homogenized nor groomed. Though the way any one of them raises a limb often looks wholly unschooled, you later realize that each moves the very same way the next time, and that so do the others. What looked naïve proves to be precise. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/GERRING/GERRING-jumbo.jpg', 'height': 866, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/GERRING/GERRING-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/15/arts/GERRING/GERRING-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Toe to Spine, a Study in Precision', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Toe to Spine, A Study In Precision', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gerring, Liz', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T23:05:09+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/cd23d502-0a47-5dea-845b-8135b9587c44', 'word_count': 615, 'uri': 'nyt://article/cd23d502-0a47-5dea-845b-8135b9587c44'}, {'abstract': 'The early-music master Jordi Savall was joined by his son, Ferran, for a performance the blended a range of music from the New World and Old at the Morgan Library & Museum.', 'web_url': 'https://www.nytimes.com/2011/10/15/arts/music/jordi-and-ferran-savall-at-morgan-library-museum-review.html', 'snippet': 'The early-music master Jordi Savall was joined by his son, Ferran, for a performance the blended a range of music from the New World and Old at the Morgan Library & Museum.', 'lead_paragraph': 'The dull, conservative older generation and the rebellious, daring younger one: this is the primal narrative of the arts. But these days the situation is all too often reversed, with up-and-coming artists creating cautious, bland work that would have been unthinkable to their pioneering elders.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/JORDI/JORDI-jumbo.jpg', 'height': 718, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Generational Exchange: Father and Son, Side by Side', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Generational Exchange: Father and Son, Side by Side', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Morgan Library & Museum', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Savall, Jordi', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-14T23:06:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5cb7b24b-226c-5d56-b2ba-aa2b2228a76c', 'word_count': 435, 'uri': 'nyt://article/5cb7b24b-226c-5d56-b2ba-aa2b2228a76c'}, {'abstract': "MTV's college channel, mtvU, will next attempt to capture university life of an entirely deaf university.", 'web_url': 'https://www.nytimes.com/video/education/100000001114091/mtvs-next-reality-star.html', 'snippet': "MTV's college channel, mtvU, will next attempt to capture university life of an entirely deaf university.", 'lead_paragraph': "MTV's college channel, mtvU, will next attempt to capture university life of an entirely deaf university.", 'source': 'The New York Times', 'multimedia