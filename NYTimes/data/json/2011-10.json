: 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Seeking Reward, Giants Cornerback Found Risk Instead', 'kicker': None, 'content_kicker': None, 'print_headline': 'Seeking Reward, Finding Risk', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Giants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Thomas, Terrell', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-26T22:24:12+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be80cce0-1842-5827-8fd2-4d3ae7822ad8', 'word_count': 1921, 'uri': 'nyt://article/be80cce0-1842-5827-8fd2-4d3ae7822ad8'}, {'abstract': 'A House veteran’s retirement has made life easier for those in charge of eliminating a Congressional district, and a top challenger to Elizabeth Warren is bowing out.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/10/26/two-massachusetts-democrats-say-they-wont-run-clarifying-state-politics/', 'snippet': 'A House veteran’s retirement has made life easier for those in charge of eliminating a Congressional district, and a top challenger to Elizabeth Warren is bowing out.', 'lead_paragraph': 'Two Democrats announced decisions in Massachusetts today that drained a bit of suspense from the state’s politics. Members of the state’s House delegation who feared getting drawn out of their districts when one is stripped from the map breathed a sigh of relief as one of their own announced his retirement, and the Senate primary field narrowed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Two Massachusetts Democrats Say They Won’t Run, Clarifying State Politics', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Scott P', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Khazei, Alan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'League of Conservation Voters', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 9, 'major': 'N'}], 'pub_date': '2011-10-26T22:26:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Southall and Sarah Wheaton', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Southall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sarah', 'middlename': None, 'lastname': 'Wheaton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aef9a37c-de46-51a2-ac76-98ea3674d14d', 'word_count': 493, 'uri': 'nyt://article/aef9a37c-de46-51a2-ac76-98ea3674d14d'}, {'abstract': 'Levante is back in first place in Spain’s La Liga after Wednesday’s victory, its seventh straight win.', 'web_url': 'https://goal.blogs.nytimes.com/2011/10/26/in-spain-levante-is-back-on-top/', 'snippet': 'Levante is back in first place in Spain’s La Liga after Wednesday’s victory, its seventh straight win.', 'lead_paragraph': 'Spain’s Mediterranean coast is, for now, home to the top team in La Liga — a