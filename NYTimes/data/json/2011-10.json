7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/23/opinion/22OPEDBLAIR/22OPEDBLAIR-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/23/opinion/22OPEDBLAIR/22OPEDBLAIR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/23/opinion/22OPEDBLAIR/22OPEDBLAIR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Running Out of Bandwidth', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Running Out of Bandwidth', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Radio Spectrum', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'National Debt (US)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Communications Commission', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-21T23:14:54+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Lowell C. McAdam', 'person': [{'firstname': 'Lowell', 'middlename': 'C.', 'lastname': 'McAdam', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/68b448bc-d33c-5e2f-bd2e-7cf15ce48304', 'word_count': 722, 'uri': 'nyt://article/68b448bc-d33c-5e2f-bd2e-7cf15ce48304'}, {'abstract': 'Critics say a proposed nat