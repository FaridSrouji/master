, 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a48cbd44-debc-510a-9c5c-3764bbc871c2', 'word_count': 2161, 'uri': 'nyt://article/a48cbd44-debc-510a-9c5c-3764bbc871c2'}, {'abstract': 'A look at the latest Weekend Business podcast, and a listen.', 'web_url': 'https://economix.blogs.nytimes.com/2011/10/29/podcast-european-debt-settlement-talks-fed-policy-and-jim-collins/', 'snippet': 'A look at the latest Weekend Business podcast, and a listen.', 'lead_paragraph': 'European leaders reached agreement this week on a far-reaching package aimed at resolving the Greek debt problem, recapitalizing vulnerable banks and bolstering the euro zone’s financial rescue fund. Stock markets around the world rallied on the news.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Podcast: European Debt, Settlement Talks, Fed Policy and Jim Collins', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Collins, Jim', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Subprime Mortgage Crisis', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romer, Christina D', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-29T17:34:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Jeff Sommer', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Sommer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a35ccd87-d180-597a-8c30-22f8e3d604d5', 'word_count': 371, 'uri': 'nyt://article/a35ccd87-d180-597a-8c30-22f8e3d604d5'}, {'abstract': '