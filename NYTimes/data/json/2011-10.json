ight': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/05/sports/JPVECSEY/JPVECSEY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For Jeter, It’s Been Hit or Miss', 'kicker': None, 'content_kicker': None, 'print_headline': 'Jeter Is Missing Something', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jeter, Derek', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Detroit Tigers', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-05T05:37:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Pat Borzi', 'person': [{'firstname': 'Pat', 'middlename': None, 'lastname': 'Borzi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1573676f-af27-5edf-b5fe-5e3fbb20c065', 'word_count': 601, 'uri': 'nyt://article/1573676f-af27-5edf-b5fe-5e3fbb20c065'}, {'abstract': 'The man behind the Delhi Metro on curbing corruption and using the Bhagavad Gita as a management guide.', 'web_url': 'https://india.blogs.nytimes.com/2011/10/05/a-conversation-with-e-sreedharan/', 'snippet': 'The man behind the Delhi Metro on curbing corruption and using the Bhagavad Gita as a management guide.', 'lead_paragraph': 'At a time when corruption seems to stalk nearly every corner of the Indian government, the Delhi Metro’s star shines brighter than ever. Under Elattuvalapil Sreedharan, the 9-year-old Metro provides stellar service, completes projects on time and under budget, and is making a profit, despite having the lowest fares of any metr