: None, 'type': 'image', 'url': 'images/2011/10/13/arts/book/book-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/13/arts/book/book-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'After a Quarter-Century, an Author Looks Back at His Holocaust Comic', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'After a Quarter-Century, an Author Looks Back at His Holocaust Comic', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Spiegelman, Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Auschwitz (Poland)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Comic Books and Strips', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Cartoons and Cartoonists', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-12T20:05:11+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Dwight Garner', 'person': [{'firstname': 'Dwight', 'middlename': None, 'lastname': 'Garner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fb39fcbb-5137-597f-9c36-bb4708f427f6', 'word_count': 997, 'uri': 'nyt://article/fb39fcbb-5137-597f-9c36-bb4708f427f6'}, {'abstract': 'Short-lived collaborations between designers and discount stores have produced inflated resale prices online and in consignment shops.', 'web_url': 'https://www.nytimes.com/2011/10/13/fashion/first-stop-target-next-stop-ebay.html', 'snippet': 'Short-lived collaborations between designers and discount stores have produced inflated resale prices online and in consignment shops.', 'lead_paragraph': 'IT’S been a month since Target released its Missoni for Target line and scrums of shoppers cleared the discount retailer’s shelves and crashed its Web site. But as with some earlier limited-edition “masstige” collections, the frenzy has continued in the secondary market, with sold-out items going for breathtakingly inflated prices on eBay and Craigslist and in consignment shops. ', 'print_section': 'E', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/13/fashion/13EBAY1/13EBAY-jumbo.jpg', 'height': 730, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/13/fashion/13EBAY1/13EBAY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/13/fashion/13EBAY1/13EBAY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'First Stop: Target. Next Stop: eBay.', 'kicker': None, 'content_kicker': None, 'print_headline': 'First Stop: Target. Next Stop: eBay.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Target Corp', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'eBay Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-12T20:06:34+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Kate Murphy', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1da28edd-868a-5d31-98d9-869f6794f581', 'word_count': 1298, 'uri': 'nyt://article/1da28edd-868a-5d31-98d9-869f6794f581'}, {'abstract': 'Two experimental vaccines against dengue fever are being developed, and researchers think they may be available commercially in five to seven years.', 'web_url': 'https://www.nytimes.com/slideshow/2008/11/03/health/110408-Dengue_index.html', 'snippet': 'Two experimental vaccines against dengue fever are being developed, and researchers think they may be available commercially in five to seven years.', 'lead_paragraph': 'Two experimental vaccines against dengue fever are being developed, and researchers think they may be available commercially in five to seven years.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2008/11/03/health/deng75.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2008/11/03/health/deng75.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Hunting for a Vaccine', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dengue Fever', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vaccination and Immunization', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-12T20:06:56+0000', 'document_type': 'multimedia', 'news_desk': 'Health', 'section_name': 'Health', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/52456eab-9e49-5443-a6e1-2811db92dff0', 'word_count': 0, 'uri': 'nyt://slideshow/52456eab-9e49-5443-a6e1-2811db92dff0'}, {'abstract': 'For bargain hunters of discounted designer labels, Century 21 branches out uptown.', 'web_url': 'https://www.nytimes.com/2011/10/13/fashion/a-big-discount-store-moves-uptown-critical-shopper.html', 'snippet': 'For bargain hunters of discounted designer labels, Century 21 branches out uptown.', 'lead_paragraph': 'THE discount department store Century 21 and I go way back — well, back to 1999 or so, when, like thousands of brides attempting the minimalist glamour of Carolyn Bessette Kennedy, I bought an off-white slip dress at its flagship across from the World Trade Center. Never mind that I wasn’t yet engaged; I reveled in the price tag ($159, down from $1,595 — that’s 90 percent off) and designer label (Vera Wang, as opposed to Bessette Kennedy’s more original Narciso Rodriguez, but still) and stashed the gown confidently in a trunk.', 'print_section': 'E', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/13/fashion/13CRITIC1_SPAN/13CRITIC1_SPAN-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/13/fashion/13CRITIC1_SPAN/13CRITIC1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/13/fashion/13CRITIC1_SPAN/13CRITIC1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/13/fashion/13CRITIC1_SPAN/13CRITIC1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/13/fashion/13CRITIC1_SPAN/13CRITIC1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For Bargain Fanatics, Uptown Mayhem', 'kicker': 'Critical Shopper', 'content_kicker': None, 'p