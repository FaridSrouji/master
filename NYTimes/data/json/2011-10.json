1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d0e26bc6-d3a3-5756-820d-1033d7ab9d37', 'word_count': 476, 'uri': 'nyt://article/d0e26bc6-d3a3-5756-820d-1033d7ab9d37'}, {'abstract': 'Ms. Sorokina was a principal dancer with the Bolshoi Ballet, along with her husband and partner, Yuri Vladimirov.', 'web_url': 'https://www.nytimes.com/2011/10/13/arts/dance/nina-sorokina-dancer-with-the-bolshoi-dies-at-69.html', 'snippet': 'Ms. Sorokina was a principal dancer with the Bolshoi Ballet, along with her husband and partner, Yuri Vladimirov.', 'lead_paragraph': 'Nina Sorokina, a principal dancer with the Bolshoi Ballet from the 1960s to the 1980s whose impeccable technique, charm and buoyancy made her an ideal partner for her husband, the fiery, athletic Yuri Vladimirov, died on Oct. 8 in Moscow. She was 69.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/arts/dogSOROKINA-obit/dogSOROKINA-obit-jumbo.jpg', 'height': 1024, 'width': 732, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/arts/dogSOROKINA-obit/dogSOROKINA-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/arts/dogSOROKINA-obit/dogSOROKINA-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Nina Sorokina, Dancer With the Bolshoi Ballet, Dies at 69', 'kicker': None, 'content_kicker': None, 'print_headline': 'Nina Sorokina, 69, Dancer With the Bolshoi Ballet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Bolshoi Ballet', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Moscow (Russia)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-13T05:24:19+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By William Grimes', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Grimes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/0c7d2f7e-f4f6-5ca5-ac03-ee222864f311', 'word_count': 474, 'uri': 'nyt://article/0c7d2f7e-f4f6-5ca5-ac03-ee222864f311'}, {'abstract': 'The European Championship has a history of underdog success stories, but a bonus automatic spot and a weighted playoff draw seem to put a thumb on the scale in favor of bigger nations.', 'web_url': 'https://goal.blogs.nytimes.com/2011/10/13/euro-2012-playoffs-first-among-seconds/', 'snippet': 'The European Championship has a history of underdog success stories, but a bonus automatic spot and a weighted playoff draw seem to put a thumb on the scale in favor of bigger nations.', 'lead_paragraph': 'For a reason that has yet to be uncovered, UEFA’s European Championship seems to routinely provide the stage for unfancied nations to upset the odds. Whether it was Denmark’s triumph as a last-minute entry in 1992, Latvia’s reaching the 2004 tournament at the expense of Turkey, whom it eliminated in the qualification playoffs, or Greece’s triumph over Portugal in Lisbon in the same year, the Euros retain a shock quality that their more illustrious relative, the World Cup, often lacks.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Euro 2012 Playoffs: First Among Seconds', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Union of European Football Assns (UEFA)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-13T05:26:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Graham Ruthven', 'person': [{'firstname': 'Graham', 'middlename': None, 'lastname': 'Ruthven', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8cc0b0d9-9fb9-56c6-bf55-631262bdf79d', 'word_count': 511, 'uri': 'nyt://article/8cc0b0d9-9fb9-56c6-bf55-631262bdf79d'}, {'abstract': 'Mr. Hess wrote songs for Elvis Presley and Pat Boone, and appeared in many films as a villain.', 'web_url': 'https://www.nytimes.com/2011/10/13/arts/music/david-hess-songwriter-and-actor-dies-at-75.html', 'snippet': 'Mr. Hess wrote songs for Elvis Presley and Pat Boone, and appeared in many films as a villain.', 'lead_paragraph': 'David Hess, a songwriter for Elvis Presley, Pat Boone and others in the 1950s and 1960s who went on to play murderous movie villains, died on Friday in Tiburon, Calif. He was 75.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/sports/Hess1/Hess1-jumbo.jpg', 'height': 517, 'width': 538, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/sports/Hess1/Hess1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/14/sports/Hess1/Hess1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'David Hess, Songwriter and Actor, Dies at 75', 'kicker': None, 'content_kicker': None, 'print_headline': 'David Hess, Songwriter and Actor, Dies at 75', 'name': None, 'seo': None, '