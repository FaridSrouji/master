hannels', 'kicker': None, 'content_kicker': None, 'print_headline': 'YouTube Plans to Make Big Bet on New Online Channels', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Google Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Web-Original Programming', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings and Downloads', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-29T01:56:19+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter and Claire Cain Miller', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Claire', 'middlename': 'Cain', 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ccf167f9-c61b-5c48-9baf-12e53ba16f86', 'word_count': 555, 'uri': 'nyt://article/ccf167f9-c61b-5c48-9baf-12e53ba16f86'}, {'abstract': 'Barry C. Silk tells us to stop being a bunch of babies.', 'web_url': 'https://wordplay.blogs.nytimes.com/2011/10/28/stars/', 'snippet': 'Barry C. Silk tells us to stop being a bunch of babies.', 'lead_paragraph': 'SATURDAY’S PUZZLE — It’s one thing for someone to think that we are immature. It’s another thing entirely for someone to say it in a crossword puzzle, and that’s what Barry C. Silk seems to be doing. Not once but twice Mr. Silk admonishes us to ACT ONE’S AGE and that it would be nice if we GREW UP.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Saturday: Producer of Shooting Stars', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-29T02:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/603ff53d-8822-5c45-9302-9f80d6618d1f', 'word_count': 333, 'uri': 'nyt://article/603ff53d-8822-5c45-9302-9f80d6618d1f'}, {'abstract': 'If you submit one of the 50 most accurate responses this week, you can win a prize from FantasyPros.com.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/10/28/fantasy-football-week-8s-toughest-picks/', 'snippet': 'If you submit one of the 50 most accurate responses this week, you can win a prize from FantasyPros.com.', 'lead_paragraph': 'Jason and Justin Sablich are here to help you with your fantasy football team. The Sablich brothers will provide fantasy football advice throughout the season on this blog and on Twitter (@5thDownFantasy). ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fantasy Football: Week 8’s Toughest Picks', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fantasy Sports', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-29T02:01:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Justin Sablich and Jason Sablich', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Sablich', 'qualifier': None,