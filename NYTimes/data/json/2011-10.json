ank': 4, 'major': 'N'}], 'pub_date': '2011-10-24T23:46:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tom Spousta', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Spousta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b6142ac7-c2a6-58a0-b140-88b3434ec687', 'word_count': 2429, 'uri': 'nyt://article/b6142ac7-c2a6-58a0-b140-88b3434ec687'}, {'abstract': 'Readers respond to a recent Op-Ed on reasoning and evangelicals.', 'web_url': 'https://www.nytimes.com/2011/10/25/opinion/can-science-and-faith-exist-together.html', 'snippet': 'Readers respond to a recent Op-Ed on reasoning and evangelicals.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/opinion/25LETTERSBLAIR/25LETTERSBLAIR-jumbo.jpg', 'height': 1024, 'width': 806, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/opinion/25LETTERSBLAIR/25LETTERSBLAIR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/25/opinion/25LETTERSBLAIR/25LETTERSBLAIR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Can Science and Faith Exist Together?', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'Can Science and Faith Exist Together?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Science and Technology', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Evangelical Movement', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Evolution', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Creationism and Intelligent Design', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-24T23:51:20+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/8356c0dd-4498-5e7e-8a0c-ca0f02c70df5', 'word_count': 840, 'uri': 'nyt://article/8356c0dd-4498-5e7e-8a0c-ca0f02c70df5'}, {'abstract': 'Yuri M. Luzhkov, Moscow’s former mayor, said Monday that he had been summoned for questioning in an embezzlement investigation of the Bank of Moscow.', 'web_url': 'https://www.nytimes.com/2011/10/25/world/europe/ex-mayor-of-moscow-faces-embezzlement-inquiry.html', 'snippet': 'Yuri M. Luzhkov, Moscow’s former mayor, said Monday that he had been summoned for questioning in an embezzlement investigation of the Bank of Moscow.', 'lead_paragraph': ' Yuri M. Luzhkov, Moscow’s former mayor, said Monday that he had been summoned for questioning in an embezzlement investigation of the Bank of Moscow, which is suspected of illegally funneling money into his wife’s personal accounts. Mr. Luzhkov, who was fired last year after running afoul of the Kremlin, told the Interfax news agency that he was being singled out for criticizing the authorities in a recent radio interview. Investigators have accused the bank’s former chief executive of illegally issuing a loan of more than $400 million to a shell company linked to Mr. Luzhkov’s wife. The couple, who are currently outside Russia, have denied any wrongdoing, and no charges have been filed against them. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Russia: Questions for Ex-Mayor', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'Russia: Questions for Ex-Mayor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Luzhkov, Yuri M', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Moscow (Russia)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Embezzlement', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-24T23:52:04+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Michael Schwirtz', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Schwirtz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/d4a3b67d-37aa-5ed1-a4e6-2d8ee5d0ce58', 'word_count': 115, 'uri': 'nyt://article/d4a3b67d-37aa-5ed1-a4e6-2d8ee5d0ce58'}, {'abstract': 'How to turn off the automatic spell-correction in Mac OS X Lion.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2011/10/24/qa-darn-you-mac-os-x-autocorrect/', 'snippet': 'How to turn off the automatic spell-correction in Mac OS X Lion.', 'lead_paragraph': 'Q.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Q&A: Darn You, Mac OS X AutoCorrect', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Incorporated', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-24T23:57:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By J.d. Biersdorfer', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3220eb7-ef68-5fa3-af1f-f424e21d7474', 'word_count': 183, 'uri': 'nyt://article/c3220eb7-ef68-5fa3-af1f-f424e21d7474'}, {'abstract': 'Why we owe Will Shortz an arm sling.', 'web_url': 'https://wordplay.blogs.nytimes.com/2011/10/24/drawing-contest/', 'snippet': 'Why we owe Will Shortz an arm sling.', 'lead_paragraph': 'SPECIAL POST — Many readers have asked about the number of entries received in Patrick Berry’s “Crossing” Words Contest and how the drawing was to be made. I don’t know if this is some sort of record for a puzzle contest, but I was impressed not only by the sheer volume of entries but by how smart you all are. Approximately 96% percent of you submitted the correct answer, so pat yourselves on the back for outwitting Mr. Berry.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Entry Count and the Drawing', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-25T00:00:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e1fcc07-997b-5b4c-909c-29d984528ded', 'word_count': 296, 'uri': 'nyt://article/8e1fcc07-997b-5b4c-909c-29d984528ded'}, {'abstract': 'As the IndyCar Series investigates the wreck that killed Dan Wheldon, drivers defended top racing officials.', 'web_url': 'https://www.nytimes.com/2011/10/25/sports/autoracing/drivers-discuss-safety-with-top-indycar-officials.html', 'snippet': 'As the IndyCar Series investigates the wreck that killed Dan Wheldon, drivers defended top racing officials.', 'lead_paragraph': 'As an IndyCar Series investigation continued into Dan Wheldon’s fatal accident Oct. 16 at Las Vegas, series officials met for three hours Monday with about two dozen drivers in Indianapolis to discuss ways to avoid catastrophic crashes.', 'print_section': 'B', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Declining to Criticize, IndyCar Drivers Discuss Safety With Top Racing Officials', 'kicker': None, 'content_kicker': None, 'print_headline': 'Declining to Criticize, IndyCar Drivers Discuss Safety With Top Racing Officials', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Safety Features and Defects', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Accidents and Safety', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bernard, Randy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wheldon, Dan', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Indy Racing League', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Automobile Racing', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-25T00:01:12+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Auto Racing', 'byline': {'original': 'By Dave Caldwell', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Caldwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/84d416b0-0b60-5f61-a78d-f50dd97cf21a', 'word_count': 390, 'uri': 'nyt://article/84d416b0-0b60-5f61-a78d-f50dd97cf21a'}, {'abstract': 'The still-emerging boom is bringing energy exploration to communities with no experience dealing with it and areas that were once, in rosier times, earmarked for other uses.', 'web_url': 'https://www.nytimes.com/2011/10/25/us/oil-drilling-in-new-areas-ushers-in-era-of-tension.html', 'snippet': 'The still-emerging boom is bringing energy exploration to communities with no experience dealing with it and areas that were once, in rosier times, earmarked for other uses.', 'lead_paragraph': 'DENVER — The pattern is clear in the oil and gas business: drilling fields are going into new places. North Dakota, better known for growing wheat, is now booming with rigs. Fort Worth has upward of 2,000 gas wells right in the city itself, with most of that growth within just the last five years. Pittsburgh, facing the prospect of urban drilling, forbade it last year by a vote of the City Council.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/us/OIL-1/OIL-1-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/25/us/OIL-1/OIL-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/us/OIL-1/OIL-1-jumbo.jpg', 'height': 546, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/us/OIL-1/OIL-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/25/us/OIL-1/OIL-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Drilling in Fast-Growing Areas Ushers in New Era of Tension', 'kicker': None, 'content_kicker': None, 'print_headline': 'Drilling in Fast-Growing Areas Ushers In New Era of Tension', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drilling and Boring', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Land Use Policies', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Colorado', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hydraulic Fracturing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-25T00:03:48+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Kirk Johnson', 'person': [{'firstname': 'Kirk', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8390510a-a7d2-5443-a49b-eb316d299965', 'word_count': 1060, 'uri': 'nyt://article/8390510a-a7d2-5443-a49b-eb316d299965'}, {'abstract': 'Dr. Hauptman, a mathematician, shared the 1985 Nobel Prize in chemistry with Jerome Karle for their revolutionary methods of studying molecular structure.', 'web_url': 'https://www.nytimes.com/2011/10/25/us/herbert-a-hauptman-nobel-winning-mathematician-dies-at-94.html', 'snippet': 'Dr. Hauptman, a mathematician, shared the 1985 Nobel Prize in chemistry with Jerome Karle for their revolutionary methods of studying molecular structure.', 'lead_paragraph': 'Herbert A. Hauptman, a mathematician who shared the 1985 Nobel Prize in Chemistry with the chemist Jerome Karle for their development of revolutionary methods for determining the structure of molecules vital to life, died on Sunday in Buffalo. He was 94.', 'print_section': 'A', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/us/25obit-hauptman/25obit-hauptman-jumbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/us/25obit-hauptman/25obit-hauptman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/25/us/25obit-hauptman/25obit-hauptman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Herbert A. Hauptman, Nobel Laureate, Dies at 94', 'kicker': None, 'content_kicker': None, 'print_headline': 'Herbert A. Hauptman, 94, Nobel Laureate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mathematics', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Chemistry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Nobel Prizes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-25T00:06:09+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By William Grimes', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Grimes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/86a2a864-b505-599d-871f-f5a1a59325b3', 'word_count': 707, 'uri': 'nyt://article/86a2a864-b505-599d-871f-f5a1a59325b3'}, {'abstract': 'The app-laden version of Bjork’s new release, “Biophilia,” lets listeners manipulate the music.', 'web_url': 'https://www.nytimes.com/2011/10/25/arts/video-games/bjorks-biophilia-an-album-as-game.html', 'snippet': 'The app-laden version of Bjork’s new release, “Biophilia,” lets listeners manipulate the music.', 'lead_paragraph': 'Since Thomas Edison invented the phonograph, there has been only one way to listen to recorded music: Listen to it. That is, to consume passively a precise sequence of sounds exactly as they have been arranged. But what if, in addition to songs, a musician provided intuitive, creative tools that let you control the basic components of the music itself? What if the musician joined with programmers and visual artists to turn the songs into encompassing interactive experiences? What if listeners were to become participants?', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/arts/JPBJORK1/JPBJORK1-articleLarge-v2.jpg', 'height': 440, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/25/arts/JPBJORK1/JPBJORK1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 440}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/arts/JPBJORK1/JPBJORK1-jumbo.jpg', 'height': 751, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/25/arts/JPBJORK1/JPBJORK1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/25/arts/JPBJORK1/JPBJORK1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Playing the New Bjork Album, and Playing Along, With Apps', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Playing the New Bjork Album, And Playing Along, With Apps', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bjork', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computer and Video Games', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-25T00:10:36+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_na