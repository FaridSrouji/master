: 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jazz Was the Answer', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jazz', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-21T12:36:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By David Gonzalez', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gonzalez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f88b5150-8da7-5f79-9d29-6227479cf5da', 'word_count': 625, 'uri': 'nyt://article/f88b5150-8da7-5f79-9d29-6227479cf5da'}, {'abstract': 'West Village, a community at the University of California at Davis whose net energy consumption is zero, is described as the largest project of its kind and just opened its doors to students.', 'web_url': 'https://green.blogs.nytimes.com/2011/10/21/beyond-green-a-net-zero-college-community/', 'snippet': 'West Village, a community at the University of California at Davis whose net energy consumption is zero, is described as the largest project of its kind and just opened its doors to students.', 'lead_paragraph': 'Designing buildings that leave a lighter imprint on the environment has become the de facto standard these days. The target for many is zero net energy use, meaning that a building makes as much energy as it uses over the course of a year. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Beyond Green: A Net-Zero College Community', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conservation of Resources', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Re