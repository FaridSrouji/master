ganization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/0d93bad8-bc2c-54e7-b06b-ce0e07565543', 'word_count': 363, 'uri': 'nyt://article/0d93bad8-bc2c-54e7-b06b-ce0e07565543'}, {'abstract': 'The Badgers’ star quarterback, Russell Wilson, completed 14 of 20 passes for 255 yards and 2 touchdowns.', 'web_url': 'https://www.nytimes.com/2011/10/02/sports/ncaafootball/wilson-and-wisconsin-run-down-nebraska-48-17.html', 'snippet': 'The Badgers’ star quarterback, Russell Wilson, completed 14 of 20 passes for 255 yards and 2 touchdowns.', 'lead_paragraph': 'MADISON, Wis. — On his first day on the Wisconsin campus this summer after transferring from North Carolina State, Wisconsin quarterback Russell Wilson called his own team meeting. He delivered a short and simple message to his new teammates: he had come to work hard and compete. But just the simple act of introducing himself to his teammates and acknowledging that nothing would be handed to him spoke to his savvy and maturity. ', 'print_section': 'SP', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/01/sports/01thequad-11/01thequad-11-jumbo.jpg', 'height': 797, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Wisconsin’s Wilson Is Living Up to His Billing', 'kicker': 'Wisconsin 48, Nebraska 17', 'content_kicker': None, 'print_headline': 'Wisconsin’s Wilson Is Living Up to His Billing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Wisconsin-Madison', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, Russell', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Wisconsin', 'rank': 5, 'major':