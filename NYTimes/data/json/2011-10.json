es', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/01/arts/hollinghurst/hollinghurst-jumbo.jpg', 'height': 1024, 'width': 801, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/01/arts/hollinghurst/hollinghurst-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/11/01/arts/hollinghurst/hollinghurst-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For a Basso Profundo, a New Literary Tune', 'kicker': None, 'content_kicker': None, 'print_headline': 'For a Basso Profundo, A New Literary Tune', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hollinghurst, Alan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-31T21:51:14+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/616f7b12-a3d3-57c9-b4ca-b6088f67fa35', 'word_count': 1174, 'uri': 'nyt://article/616f7b12-a3d3-57c9-b4ca-b6088f67fa35'}, {'abstract': 'The possibility that hotels might purchase a lot more bandwidth from their Internet providers and offer Wi-Fi to guests in a tiered-fee system provoked anger.', 'web_url': 'https://www.nytimes.com/2011/11/01/business/readers-choice-words-on-fees-for-hotel-wi-fi.html', 'snippet': 'The possibility that hotels might purchase a lot more bandwidth from their Internet providers and offer Wi-Fi to guests in a tiered-fee system provoked anger.', 'lead_paragraph': 'AS someone who is derided by relatives and friends for not knowing how to text on a cellphone, I approach the task of evaluating technology as warily as a man wading into the Everglades with a pork chop tied around his neck. ', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/01/business/Road/Road-jumbo.jpg', 'height': 1024, 'width': 871, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/01/business/Road/Road-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/11/01/business/Road/Road-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Readers’ Choice Words on Fees for Hotel Wi-Fi', 'kicker': 'On the Road', 'content_kicker': None, 'print_headline': 'Readers’ Choice Words On Fees for Hotel Wi-Fi', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'HOTELS AND MOTELS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wireless Communications', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-31T21:58:15+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Joe Sharkey', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Sharkey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4856b5da-7f74-5341-a7ff-7a9d5a00a510', '