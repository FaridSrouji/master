e': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'CMJ Music Marathon', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bowery Ballroom', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-21T17:45:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0571584c-b0ef-5bd1-a1e8-15db35a29b8d', 'word_count': 318, 'uri': 'nyt://article/0571584c-b0ef-5bd1-a1e8-15db35a29b8d'}, {'abstract': 'Secretary of State Hillary Rodham Clinton for a second day called on Pakistan’s government to shut down safe havens from which extremists have mounted attacks in Afghanistan.', 'web_url': 'https://www.nytimes.com/2011/10/22/world/asia/clinton-prods-pakistanis-again-though-more-gently.html', 'snippet': 'Secretary of State Hillary Rodham Clinton for a second day called on Pakistan’s government to shut down safe havens from which extremists have mounted attacks in Afghanistan.', 'lead_paragraph': 'ISLAMABAD, Pakistan — When Secretary of State Hillary Rodham Clinton invited questions from a selected group of Pakistanis here on Friday, a woman in the audience humorously captured the essence of a very troubled relationship, at least from Pakistan’s point of view.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/22/world/22DIPLO/22DIPLO-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/22/world/22DIPLO/22DIPLO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}