None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/87acc3f6-23b9-5561-a40e-db2ddf592a2c', 'word_count': 630, 'uri': 'nyt://article/87acc3f6-23b9-5561-a40e-db2ddf592a2c'}, {'abstract': 'The court is being asked whether corporations and political groups can be sued in the United States on accusations of human rights abuses abroad.', 'web_url': 'https://www.nytimes.com/2011/10/18/business/supreme-court-to-hear-2-human-rights-cases.html', 'snippet': 'The court is being asked whether corporations and political groups can be sued in the United States on accusations of human rights abuses abroad.', 'lead_paragraph': 'WASHINGTON — The Supreme Court agreed on Monday to hear a pair of cases on whether corporations and political groups may be sued in American courts for complicity in human rights abuses abroad.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Supreme Court to Hear 2 Human Rights Cases', 'kicker': None, 'content_kicker': None, 'print_headline': 'Two Human Rights Cases On Supreme Court Docket', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Corporations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Palestine Liberation Organization', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Royal Dutch Shell Plc', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'West Bank', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Palestinian Authority', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Alien Tort Statute (1789)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Nigeria', 'rank': 10, 'major': 'N'}], 'pub_date': '2011-10-17T19:35:58+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Adam Liptak', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Liptak', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/211df2d4-ca81-513b-8280-aaac390e0827', 'word_count': 638, 'uri': 'nyt://article/211df2d4-ca81-513b-8280-aaac390e0827'}, {'abstract': 'Before the IndyCar Vegas 300, fans, commentators and drivers themselves said that Las Vegas Motor Speedway was an exceptionally dangerous circuit, an opinion given chilling credence after Dan Wheldon’s fatal crash.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/10/17/bad-premonitions-before-and-ominous-signs-after-dan-wheldons-crash-in-las-vegas/', 'snippet': 'Before the IndyCar Vegas 300, fans, commentators and drivers themselves said that Las Vegas Motor Speedway was an exceptionally dangerous circuit, an opinion given chilling credence after Dan Wheldon’s fatal crash.', 'lead_paragraph': 'LAS VEGAS — The IndyCar racing community, its fans and even drivers themselves seemed almost braced for tragedy Sunday, as the season finale unfolded here. When it came, in the form of a 15-car pileup that killed the two-time Indianapolis 500 champion Dan Wheldon, there seemed to be little shock, just sadness that the worst-case scenario had indeed occurred.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bad Premonitions Before, and Ominous Signs After, Dan Wheldon’s Crash in Las Vegas', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Indianapolis 500 (Auto Race)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Traffic Accidents and Safety', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wheldon, Dan', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Indy Racing League', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Las Vegas Motor Speedway', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Las Vegas (Nev)', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-10-17T19:35:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Jerry Garrett', 'person': [{'firstname': 'Jerry', 'middlename': None, 'lastname': 'Garrett', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6d704f3-ff8d-5937-a44c-caee374d0e08', 'word_count': 536, 'uri': 'nyt://article/d6d704f3-ff8d-5937-a44c-caee374d0e08'}, {'abstract': 'Staying conscious allows the increased release of body chemicals to keep blood pressure elevated, and helps protect a victim’s airway.', 'web_url': 'https://www.nytimes.com/2011/10/18/science/18qna.html', 'snippet': 'Staying conscious allows the increased release of body chemicals to keep blood pressure elevated, and helps protect a victim’s airway.', 'lead_paragraph': 'Q. Often in movies or on TV, and in real life too (the motorcyclist recently dragged from under the flaming car), a trauma victim will be told to “stay with me.” Are there circumstances when it is vital for a trauma victim to remain conscious? If so, what are they, and why is it helpful?', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/18/science/18QA/18QA-jumbo.jpg', 'height': 1018, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'sub