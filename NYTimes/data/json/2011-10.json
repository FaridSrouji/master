yline': {'original': 'By Jerry Garrett', 'person': [{'firstname': 'Jerry', 'middlename': None, 'lastname': 'Garrett', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/70486b79-a19d-50a8-be3b-c0ab0ce12f16', 'word_count': 1151, 'uri': 'nyt://article/70486b79-a19d-50a8-be3b-c0ab0ce12f16'}, {'abstract': 'The Cardinals took the injured Matt Holliday off their roster and replaced him with Adron Chambers.', 'web_url': 'https://bats.blogs.nytimes.com/2011/10/28/cardinals-wont-have-holliday-for-game-7/', 'snippet': 'The Cardinals took the injured Matt Holliday off their roster and replaced him with Adron Chambers.', 'lead_paragraph': 'ST. LOUIS — Not only is Matt Holliday not starting Game 7 for the Cardinals on Friday night, he’s off the World Series roster entirely after severely bruising his right pinky finger in Game 6. Adron Chambers replaces him on the roster, while Lance Berkman — fresh off his three-hit, three-R.B.I. night with four runs scored — will bat cleanup again Thursday night.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cardinals Won’t Have Holliday for Game 7', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World Series', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Beltre, Adrian', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Berkman, Lance', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Holliday, Matt', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'St Louis Cardinals', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Texas Rangers', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'St Louis (Mo)', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-10-28T20:36:59+0000', 'document_type': 'a