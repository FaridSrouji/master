ub': None}, 'keywords': [{'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Home Repairs and Improvements', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tools', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T10:01:44+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Edward Lewine', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Lewine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5bd98b57-1ad7-5a3f-8d47-37af85027312', 'word_count': 1072, 'uri': 'nyt://article/5bd98b57-1ad7-5a3f-8d47-37af85027312'}, {'abstract': 'China is slowing. Europe is crashing. The U.S. is dipping. But Brazil is booming, and São Paulo, the country’s gritty, drizzly financial center, has caught luxury-real-estate fever.', 'web_url': 'https://www.nytimes.com/2011/10/16/magazine/key-brazil-makes-its-own-manhattan.html', 'snippet': 'China is slowing. Europe is crashing. The U.S. is dipping. But Brazil is booming, and São Paulo, the country’s gritty, drizzly financial center, has caught luxury-real-estate fever.', 'lead_paragraph': 'São Paulo is almost beyond the imagination — a drizzle-shrouded megacity of almost 20 million that sprawls like Los Angeles and boasts enough skyscrapers to vie with New York. The gritty financial engine of the new Brazil, São Paulo exerts influence over commerce, media and culture. The Brazilian writer Roberto Pompeu de Toledo calls it an “urban labyrinth that reaches toward the infinite.” It might not have the palm-fringed glamour of Rio de Janeiro, but in the view of urbane Paulistanos, Brazil has only one truly global city: theirs.', 'print_section': 'MM', 'print_page': '76', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/magazine/16-brazilthumb/16-brazilthumb-articleLarge-v2.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/16/magazine/16-brazilthumb/16-brazilthumb-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/magazine/16-brazilthumb/16-brazilthumb-jumbo.jpg', 'height': 600, 'width': 900, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/magazine/16-brazilthumb/16-brazilthumb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/magazine/16-brazilthumb/16-brazilthumb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Brazil Makes Its Own Manhattan', 'kicker': 'Key', 'content_kicker': None, 'print_headline': 'Brazil Makes Its Own Manhattan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Sao Paulo (Brazil)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Brazil', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Rio de Janeiro (Brazil)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-14T10:01:47+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Simon Romero', 'person': [{'firstname': 'Simon', 'middlename': None, 'lastname': 'Romero', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a89e461-8b92-56f0-91aa-c6f0270cbe9c', 'word_count': 732, 'uri': 'nyt://article/0a89e461-8b92-56f0-91aa-c6f0270cbe9c'}, {'abstract': 'The Emmy winner for “Mike & Molly” never wanted to do a show about her weight, but she’s glad she did.', 'web_url': 'https://www.nytimes.com/2011/10/16/magazine/talk-melissa-mccarthy-can-take-a-joke.html', 'snippet': 'The Emmy winner for “Mike & Molly” never wanted to do a show about her weight, but she’s glad she did.', 'lead_paragraph': 'At St. Francis Academy, the Catholic girls’ high school you attended in Illinois, you played tennis and were the captain of the cheerleading team. Then you suddenly quit to become a sullen Goth. Why? I remember being in a pep rally, and I heard one of the coaches of the boys’ teams making a dumb joke about the dumb cheerleaders, and I thought, Are you kidding me? I’m out there doing back handsprings and aerials on blacktop to cheer for your stupid team that, by the way, is not doing that well. And you’re in here with the guys making fun of it? I was like, I’m done.', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/magazine/16talk/mag-16talk-t_CA0-jumbo.jpg', 'height': 1024, 'width': 562, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/magazine/16talk/mag-16talk-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/magazine/16talk/mag-16talk-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Melissa McCarthy Can Take a Joke', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'Melissa McCarthy Can Take a Joke', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McCarthy, Melissa', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T10:01:47+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Andrew Goldman', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Goldman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/1e2897d4-2de1-5044-84d4-a0cf363b2fac', 'word_count': 740, 'uri': 'nyt://article/1e2897d4-2de1-5044-84d4-a0cf363b2fac'}, {'abstract': 'Readers respond.', 'web_url': 'https://www.nytimes.com/2011/10/16/magazine/reply-all-food-and-drink.html', 'snippet': 'Readers respond.', 'lead_paragraph': 'I loved Sam Sifton’s description of family dinner in his home and the pictures of other families sharing the meal. My husband is a lawyer with a long commute who returns home long after the children are in bed. We often have a nice family dinner on the weekends, but sitting down together once a week was not enough, so we have tried to make breakfast our family meal of record. It may only be granola and orange juice, but we are around the table, and the television is off. I know that this has a direct impact on our present relationships, because when attitudes get bad in our family, we often realize that we have been short-shrifting family mealtime. It is also a big help that this reduces some of Dad’s guilt about not being home earlier most nights.', 'print_section': 'MM', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Food and Drink', 'kicker': 'Reply All | Letters', 'content_kicker': None, 'print_headline': 'Food And Drink', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T10:01:50+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/f1175c72-cd5c-5f23-9402-836fadc34f01', 'word_count': 799, 'uri': 'nyt://article/f1175c72-cd5c-5f23-9402-836fadc34f01'}, {'abstract': 'He’s everywhere, playing every kind of role: political wonk, brooding loner, cocksure ladies’ man. Is that enough to make him a movie star?', 'web_url': 'https://www.nytimes.com/2011/10/16/magazine/riff-the-curious-case-of-ryan-gosling.html', 'snippet': 'He’s everywhere, playing every kind of role: political wonk, brooding loner, cocksure ladies’ man. Is that enough to make him a movie star?', 'lead_paragraph': 'In the Danish director Nicolas Winding Refn’s “Drive,” Ryan Gosling is a stunt driver and part-time mechanic who moonlights as a wheelman for thieves (when he’s not tooling around late-night Los Angeles listening to moody, synthy pseudo-’80s tunes). In George Clooney’s “Ides of March,” Gosling is a whiz-kid political operator drawn into campaign-trail bloodsport. We’ve all seen enough movies centered on these archetypes — the rigorously self-controlling loner caught up in a heist gone bad; the idealist tested by the way the real world works — that by now we think we know them like old friends. But in Gosling’s hands, these characters seem unknowable and unresolved and volatile. He plays them as men whose easy charm and surface gentleness conceal a capacity for unexpected brutality, whether professional/moral (“Ides of March”) or skull-stompingly physical (“Drive.”) They’re golden-retrieverish golden boys with the potential to burn the world down.', 'print_section': 'MM', 'print_page': '66', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/magazine/16-riff-ides/16-riff-ides-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/magazine/16-riff-ides/16-riff-ides-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/magazine/16-riff-ides/16-riff-ides-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Curious Case of Ryan Gosling', 'kicker': 'Riff', 'content_kicker': None, 'print_headline': '‘Golden Boys With the Potential To Burn the World Down’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pitt, Brad', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clooney, George', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gosling, Ryan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-14T10:01:51+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Alex Pappademas', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Pappademas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a7ecf436-c1ad-5d65-8afb-f9caf30784c1', 'word_count': 1847, 'uri': 'nyt://article/a7ecf436-c1ad-5d65-8afb-f9caf30784c1'}, {'abstract': 'An otherwise healthy man one night discovers he can’t stand up.', 'web_url': 'https://www.nytimes.com/2011/10/16/magazine/diagnosis-a-total-collapse.html', 's