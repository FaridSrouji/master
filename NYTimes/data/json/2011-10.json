acy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/business/FRIDAYS1/FRIDAYS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/14/business/FRIDAYS1/FRIDAYS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Friday Night Blight', 'kicker': None, 'content_kicker': None, 'print_headline': 'Friday Night Blight', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Univision', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox Broadcasting Co', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'CBS Corp', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'ABC INC', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Cable Television', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-10-14T03:06:49+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Bill Carter', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Carter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c2cb1fe-aed2-5835-9a88-e57520f92763', 'word_count': 1321, 'uri': 'nyt://article/6c2cb1fe-aed2-5835-9a88-e57520f92763'}, {'abstract': 'Eleven teachers who were accused of changing scores on state standardized tests will lose their licenses to teach for two years, according to the Georgia Professional Standards Commission.', 'web_url': 'https://www.nytimes.com/2011/10/14/us/georgia-licenses-suspended-in-cheating-scandal.html', 'snippet': 'Eleven teachers who were accused of changing scores on state standardized tests will lose their licenses to teach for two years, according to the Georgia Professional Standards Commission.', 'lead_paragraph': ' The first formal repercussions from a cheating scandal in the Atlanta school district were handed down Thursday by the Georgia Professional Standards Commission. Eleven teachers who were accused of changing scores on state standardized tests will lose their licenses to teach for two years. Three people in “leadership positions” in schools where cheating was discovered have lost their licenses permanently, said Kelly Henson, executive secretary of the commission. The commission is expected to review approximately 200 teachers and administrators, using information gathered by state investigators. About 120 educators named in the report remain on paid leave. Some educators might also face criminal charges. ', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Georgia: Licenses Suspended in Cheating Scandal', 'kicker': 'National Briefing | SOUTH', 'content_kicker': None, 'print_headline': 'Georgia: Licenses Suspended in Cheating Scandal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cheating', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Suspensions, Dismissals and Resignations', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-14T03:09:28+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Kim Severson', 'person': [{'firstname': 'Kim', 'middlename': None, 'lastname': 'Severson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/036786d8-20fe-5661-bb7d-4406b2775014', 'word_count': 103, 'uri': 'nyt://article/036786d8-20fe-5661-bb7d-4406b2775014'}, {'abstract': 'Jets players and officials Thursday closed ranks around the rookie Jeremy Kerley, who supplants the traded Derrick Mason as the team’s No. 3 receiver.', 'web_url': 'https://www.nytimes.com/2011/10/14/sports/football/kerley-jets-rookie-gets-a-crash-course-in-life-in-the-nfl.html', 'snippet': 'Jets players and officials Thursday closed ranks around the rookie Jeremy Kerley, who supplants the traded Derrick Mason as the team’s No. 3 receiver.', 'lead_paragraph': 'FLORHAM PARK, N.J. — Jeremy Kerley has three receptions for 35 yards and one touchdown in his five-game N.F.L. career — or 934 receptions, 11,971 yards and 65 touchdown catches fewer than Derrick Mason has in his 223-game career over 15 seasons.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/sports/jets-1/jets-1-jumbo.jpg', 'height': 899, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/sports/jets-1/jets-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/14/sports/jets-1/jets-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Rookie’s Crash Course in Life in the N.F.L.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rookie’s Crash Course In Life in the N.F.L.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ryan, Rex', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Houston Texans', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mason, Derrick', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kerley, Jeremy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Trades (Sports)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-14T03:26:38+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Dave Caldwell', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Caldwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b6a53df-aba1-59c0-8224-3085d387d4e0', 'word_count': 918, 'uri': 'nyt://article/0b6a53df-aba1-59c0-8224-3085d387d4e0'}, {'abstract': 'The Mexican army said Thursday that it had captured the man responsible for an arson attack on a Monterrey casino that killed 52 people.', 'web_url': 'https://www.nytimes.com/2011/10/14/world/americas/mexico-suspect-arrested-in-casino-fire.html', 'snippet': 'The Mexican army said Thursday that it had captured the man responsible for an arson attack on a Monterrey casino that killed 52 people.', 'lead_paragraph': 'The army said Thursday that it had captured the man responsible for an arson attack on a Monterrey casino that killed 52 people. The suspect, Carlos Oliva Castillo, known as “The Frog,” a leader of the Zeta drug organization, was arrested in Saltillo on Wednesday after hours of shootouts between soldiers and gang members. The authorities have arrested 11 others, including a state police officer, in connection with the August casino attack, one of the worst attacks by organized crime on unarmed civilians in Mexico’s history.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/world/14breifs-castillo/14breifs-castillo-jumbo.jpg', 'height': 970, 'width': 588, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/world/14breifs-castillo/14breifs-castillo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/14/world/14breifs-castillo/14breifs-castillo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Mexico: Suspect Arrested in Casino Fire', 'kicker': 'World Briefing | THE AMERICAS', 'content_kicker': None, 'print_headline': 'Mexico: Suspect Arrested in Casino Fire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Monterrey (Mexico)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Casinos', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Crime', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-14T03:31:06+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Karla Zabludovsky', 'person': [{'firstname': 'Karla', 'middlename': None, 'lastname': 'Zabludovsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/863667f1-3c32-50c0-b32f-70cb830793fd', 'word_count': 87, 'uri': 'nyt://article/863667f1-3c32-50c0-b32f-70cb830793fd'}, {'abstract': 'Call it a menagerie à quatre in Mayor Michael R. Bloomberg’s town house: him, Diana L. Taylor and the two yellow Labradors she cares for.', 'web_url': 'https://www.nytimes.com/2011/10/14/nyregion/girlfriends-dogs-are-not-bloombergs-best-friends.html', 'snippet': 'Call it a menagerie à quatre in Mayor Michael R. Bloomberg’s town house: him, Diana L. Taylor and the two yellow Labradors she cares for.', 'lead_paragraph': 'They curl up on the fringes of New York City royalty, positioned to eavesdrop on conversations no one else can hear, but unlikely to pass along the details. They come from a well-worn class of political companion, intended to generate sympathy for even the surliest of leaders, but have failed to persuade the city’s first man to accept them as his best friends. They stand, and sit, as symbols of compromise in the private life of an uncompromising mayor.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/nyregion/DOGS/DOGS-jumbo.jpg', 'height': 911, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/nyregion/DOGS/DOGS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/14/nyregion/DOGS/DOGS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Mayor Stands Firm Against the Lobbying of Puppy-Dog Eyes', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Mayor Stands Firm Against the Lobbying of Puppy-Dog Eyes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dogs', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Diana L', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T03:31:44+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08e7a120-c5a6-5e67-bea0-ddde10479661', 'word_count': 755, 'uri': 'nyt://article/08e7a120-c5a6-5e67-bea0-ddde10479661'}, {'abstract': 'Range Resources’ suit against Cecil Township over zoning rules adds to the growing debate over how much municipalities can regulate land use as drilling in the Marcellus Shale ramps up.', 'web_url': 'https://www.nytimes.com/2011/10/14/us/pennsylvania-gas-company-sues-over-zoning-rules.html', 'snippet': 'Range Resources’ suit against Cecil Township over zoning rules adds to the growing debate over how much municipalities can regulate land use as drilling in the Marcellus Shale ramps up.', 'lead_paragraph': ' Range Resources, a natural gas drilling company, has filed suit against Cecil Township, saying it did not follow proper legal procedure while drawing up zoning rules that would regulate gas drilling, a company spokesman said. The suit, which was filed on Wednesday in Washington County Court, adds to the growing debate over how much municipalities can regulate land use as drilling in the Marcellus Shale ramps up. This summer, Range sued South Fayette, another western Pennsylvania town, over its zoning ordinance. ', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pennsylvania: Gas Company Sues Over Zoning Rules', 'kicker': 'National Briefing | MID-ATLANTIC', 'content_kicker': None, 'print_headline': 'Pennsylvania: Gas Company Sues Over Zoning Rules', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Suits and Litigation', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Range Resources Corp', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Zoning', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Drilling and Boring', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Land Use Policies', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-14T03:32:28+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sabrina Tavernise', 'person': [{'firstname': 'Sabrina', 'middlename': None, 'lastname': 'Tavernise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/4904f45c-8ff0-5825-ad00-05b92e058314', 'word_count': 82, 'uri': 'nyt://article/4904f45c-8ff0-5825-ad00-05b92e058314'}, {'abstract': 'The controversy this week over an unorthodox circulation deal at the European edition of The Wall Street Journal complicates matters for the company’s leadership.', 'web_url': 'https://www.nytimes.com/2011/10/14/business/media/news-corp-hits-a-bump-as-investors-prepare-to-meet.html', 'snippet': 'The controversy this week over an unorthodox circulation deal at the European edition of The Wall Street Journal complicates matters for the company’s leadership.', 'lead_paragraph': 'The European edition of The Wall Street Journal accounts for less than 1 percent of total business at its parent company, the News Corporation. But the controversy this week over an unorthodox circulation deal that resulted in the resignation of the newspaper’s publisher could carry outsize influence among investors already concerned about ethical practices at the company, analysts said Thursday.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/business/Circ/Circ-jumbo.jpg', 'height': 988, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'News Corp. Hits a Bump as Investors Prepare to Meet', 'kicker': None, 'content_kicker': None, 'print_headline': 'News Corp. Hits a Bump as Investors Prepare to Meet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Newspapers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Wall Street Journal Europe', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Audit Bureau of Circulations', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'NEWS CORP', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Wall Street Journal', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-10-14T03:33:10+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Amy Chozick and Tanzina Vega', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Chozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Tanzina', 'middlename': None, 'lastname': 'Vega', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5161d305-d9b2-560a-96cc-442e4883f700', 'word_count': 1024, 'uri': 'nyt://article/5161d305-d9b2-560a-96cc-442e4883f700'}, {'abstract': 'European astronomers said Thursday that they had taken another step toward the construction of the largest optical telescope on the planet on a mountain in Chile.', 'web_url': 'https://www.nytimes.com/2011/10/14/science/space/14briefs-Chile.html', 'snippet': 'European astronomers said Thursday that they had taken another step toward the construction of the largest optical telescope on the planet on a mountain in Chile.', 'lead_paragraph': ' European astronomers said Thursday that they had taken another step toward the construction of the largest optical telescope on the planet on a mountain in Chile. Known as the European Extremely Large Telescope, it would feature a segmented mirror 131 feet across that would dwarf any that exist or are currently planned. Astronomers say the giant telescope will be able to study planets around other stars. Alfredo Moreno, the Chilean minister of foreign affairs, signed an agreement with the European Southern Observatory, a consortium of 15 nations, donating 189 acres of land around the Cerro Armazones mountain for the telescope, in exchange for 10 percent of the observing time on it. Pending final approval by the European consortium, the billion-dollar telescope could begin operating early in the next decade. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chile: Land Donated for Giant Telescope', 'kicker': 'World Briefing | THE AMERICAS', 'content_kicker': None, 'print_headline': 'Chile: Land Donated for Giant Telescope', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Telescopes and Observatories', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'European Southern Observatory', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Chile', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Astronomy and Astrophysics', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T03:34:00+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'Science', 'subsection_name': 'Space & Cosmos', 'byline': {'original': 'By Dennis Overbye', 'person': [{'firstname': 'Dennis', 'middlename': None, 'lastname': 'Overbye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt:/