ument_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8acd07cf-ac7e-5396-a13a-9ade3d002333', 'word_count': 1123, 'uri': 'nyt://article/8acd07cf-ac7e-5396-a13a-9ade3d002333'}, {'abstract': 'Jason Shelowitz, a graphic designer and artist, has been posting his street signs across the city under the guise of the “Metropolitan Etiquette Authority.”', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/10/09/one-outlaws-campaign-for-urban-decorum/', 'snippet': 'Jason Shelowitz, a graphic designer and artist, has been posting his street signs across the city under the guise of the “Metropolitan Etiquette Authority.”', 'lead_paragraph': 'Jason Shelowitz has made it his mission to educate New Yorkers on proper urban decorum. All he had to do was break the law. Seventy times.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'One Outlaw’s Campaign for Urban Decorum', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Signs and Signage', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Traffic Signals and Signs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Transit Systems', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-09T22:58:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Matt Flegenheimer', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Flegenheimer', 'qualifier': None, 'title': None, 'role