tion': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ce6eb44-04ee-5586-95be-ff5143ec8fd3', 'word_count': 314, 'uri': 'nyt://article/5ce6eb44-04ee-5586-95be-ff5143ec8fd3'}, {'abstract': 'Robin van Persie scored three goals Saturday as a resurgent Arsenal defeated Chelsea, 5-3, at Stamford Bridge in the English Premier League.', 'web_url': 'https://www.nytimes.com/2011/10/30/sports/soccer/arsenal-sends-chelsea-to-second-league-loss-in-row.html', 'snippet': 'Robin van Persie scored three goals Saturday as a resurgent Arsenal defeated Chelsea, 5-3, at Stamford Bridge in the English Premier League.', 'lead_paragraph': 'Robin van Persie scored a hat trick to lead Arsenal to a 5-3 win over Chelsea on Saturday in the English Premier League, while first-place Manchester City beat Wolverhampton, 3-1.', 'print_section': 'SP', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/sports/YSOCCER/YSOCCER-jumbo.jpg', 'height': 790, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Arsenal Sends Chelsea to 2nd League Loss in Row', 'kicker': 'Roundup', 'content_kicker': None, 'print_headline': 'Arsenal Sends Chelsea To 2nd League Loss in Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'UEFA Champions League (Soccer)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Arsenal (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'English Premier League', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-29T19:48:11+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Bloomberg News', 'person': [{'firstname': 'Bloomberg', 'middlename': None, 'lastname': 'News', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5a5c16ad-c594-59ce-a915-e1fa924c99cf', 'word_count': 1029, 'uri': 'nyt://article/5a5c16ad-c594-59ce-a915-e1fa924c99cf'}, {'abstract': 'Catherine Russell, who has played the same role in an off-Broadway play for decades, says anyone in a repetitive job “can do things to make their work more interesting.”', 'web_url': 'https://www.nytimes.com/2011/10/30/jobs/25-years-in-stage-role-actress-still-adds-variety.html', 'snippet': 'Catherine Russell, who has played the same role in an off-Broadway play for decades, says anyone in a repetitive job “can do things to make their work more interesting.”', 'lead_paragraph': 'ASK people to describe a typical day at work and some will say it’s impossible — each day is different. But there are other jobs where people do the same thing every day, like driving the same bus route, or performing the same role in a play year after year. I’ve played the psychiatrist Margaret Brent in “Perfect Crime,” an off-Broadway play, for almost 25 years, ever since it opened.', 'print_section': 'BU', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/business/30-PRE/30-PRE-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/30/business/30-PRE/30-PRE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/business/30-PRE/30-PRE-jumbo.jpg', 'height': 824, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/business/30-PRE/30-PRE-thumbStandard.jp