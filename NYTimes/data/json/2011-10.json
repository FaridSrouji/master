ds': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Evercore Partners Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'JPMorgan Chase & Company', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-03T14:54:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e4ad7642-0db5-5232-8a39-eec48d2e16b1', 'word_count': 174, 'uri': 'nyt://article/e4ad7642-0db5-5232-8a39-eec48d2e16b1'}, {'abstract': 'After a spotty season in W.P.S., Goal blogger Yael Averbuch is back in North Carolina just looking for a game.', 'web_url': 'https://goal.blogs.nytimes.com/2011/10/03/averbuch-always-learning-and-just-playing/', 'snippet': 'After a spotty season in W.P.S., Goal blogger Yael Averbuch is back in North Carolina just looking for a game.', 'lead_paragraph': 'CHAPEL HILL, N.C. — Every time I think I’ve “figured it out,” I’m proven wrong. I think that I’ve gotten to know myself as an athlete, got a handle on my career, dissected this crazy game I play … and then I have some sort of epiphany. The more I learn, the more I realize there is left to learn. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Averbuch: Always Learning and ‘Just Playing’', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dorrance, Anson', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Chapel Hill (NC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-03T14:56:17+0000', 'document_type': 'article', 'news_desk': '', 'sectio