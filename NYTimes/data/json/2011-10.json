 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/661d81d2-5107-5fb2-ac1e-a84516d4e87a', 'word_count': 1532, 'uri': 'nyt://article/661d81d2-5107-5fb2-ac1e-a84516d4e87a'}, {'abstract': 'Netflix, in a deal announced Friday with AMC, will begin streaming the first season of “The Walking Dead.”', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/10/07/netflix-to-stream-amcs-the-walking-dead/', 'snippet': 'Netflix, in a deal announced Friday with AMC, will begin streaming the first season of “The Walking Dead.”', 'lead_paragraph': 'Just in time for people to catch up with “The Walking Dead,” the AMC series that begins its second season on Oct. 16, the first season is now streaming on Netflix.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Netflix to Stream AMC’s ‘The Walking Dead’', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Walking Dead, The (TV Program)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMC (TV Network)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-07T16:42:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b790f15b-1d8e-5c83-a7bc-4318ebf06778', 'word_count': 288, 'uri': 'nyt://article/b790f15b-1d8e-5c83-a7bc-4318ebf06778'}, {'abstract': 'A biographer tries to make sense of John Lennon’s pain.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/lennon-by-tim-riley-book-review.html', 'snippet': 'A biographer tries to make sense of John Lennon’s pain.', 'lead_paragraph': '“I hated Lennon,” one of the old madcaps says, defiantly, in Jonathon Green’s oral history “Days in the Life: Voices From the English Underground, 1961-1971.” “Oh yes. Lennon’s no hero of mine. I cannot separate people and what they do from what they are. Lennon was unmitigatedly evil as far as I was concerned.” Doesn’t that sound terrible, like a kind of spiritual deformity — hating John Lennon? Tangled deep in the nervous system of every earthling over the age of 40, I would argue, is some fiber or filament of peak Beatlemania, some flicker of the old wild adoration. We want, we need — still — to love these men. And yet Lennon in certain aspects was really quite hateable. Cruel at times, chaotic, dissociated: on his bad days little more, so it seems, than a gigantic human flaw through which the shifting light of genius displayed itself.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/SUBPARKER/SUBPARKER-jumbo.jpg', 'height': 1024, 'width': 648, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/SUBPARKER/SUBPARKER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/SUBPARKER/SUBPARKER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'John Lennon’s Primal Screams', 'kicker': None, 'content_kicker': None, 'print_headline': 'Primal Screams', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ono, Yoko', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Beatles, The', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lennon, John', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Riley, Tim', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-07T16:42:23+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By James Parker', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2c7ad857-8e32-5406-82ca-eff68fcf18d0', 'word_count': 1124, 'uri': 'nyt://article/2c7ad857-8e32-5406-82ca-eff68fcf18d0'}, {'abstract': 'This sequel to “Sea of Poppies” unfolds in the Chinese trading outpost of Canton.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/river-of-smoke-by-amitav-ghosh-book-review.html', 'snippet': 'This sequel to “Sea of Poppies” unfolds in the Chinese trading outpost of Canton.', 'lead_paragraph': 'No writer in modern India has held a novelistic lamp to the subcontinent’s densely thicketed past as vividly and acutely as Amitav Ghosh. Since the publication of “The Circle of Reason,” in the mid-1980s, Ghosh’s work has been animated by its inventive collages and connections. “River of Smoke,” the second volume of his ambitious Ibis trilogy, is the work of a writer with a historical awareness and an appetite for polyphony that are equal to the immense demands of the material he seeks to illuminate.', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/09CHOUDRY/09CHOUDRY-jumbo.jpg', 'height': 1024, 'width': 821, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/09CHOUDRY/09CHOUDRY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/09CHOUDRY/09CHOUDRY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Fashioning Narrative Pleasures From Narcotic Ones', 'kicker': None, 'content_kicker': None, 'print_headline': 'Alchemy of Desire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ghosh, Amitav', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Opium', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-07T16:42:40+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Chandrahas Choudhury', 'person': [{'firstname': 'Chandrahas', 'middlename': None, 'lastname': 'Choudhury', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2f1d4223-d3dd-5dd1-85be-f13d5ba4ec96', 'word_count': 611, 'uri': 'nyt://article/2f1d4223-d3dd-5dd1-85be-f13d5ba4ec96'}, {'abstract': 'Near the border of Myanmar is a karst-and-mist landscape where hundreds of caves lie hidden beneath thick vines.', 'web_url': 'https://www.nytimes.com/slideshow/2011/10/09/travel/20111009-journeys.html', 'snippet': 'Near the border of Myanmar is a karst-and-mist landscape where hundreds of caves lie hidden beneath thick vines.', 'lead_paragraph': 'Near the border of Myanmar is a karst-and-mist landscape where hundreds of caves lie hidden beneath thick vines.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/travel/THAI-CAVES-slide-BONJ/THAI-CAVES-slide-BONJ-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/travel/THAI-CAVES-slide-BONJ/THAI-CAVES-slide-BONJ-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/travel/THAI-CAVES-slide-BONJ/THAI-CAVES-slide-BONJ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Cave Hunting in Thailand', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Thailand', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-07T16:43:09+0000', 'document_type': 'multimedia', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/7c096c2c-b28f-56f5-8dc0-34aa812ac015', 'word_count': 0, 'uri': 'nyt://slideshow/7c096c2c-b28f-56f5-8dc0-34aa812ac015'}, {'abstract': 'A village, set amid caves and natural streams, manages to elude the encroachment of modern tourism.', 'web_url': 'https://www.nytimes.com/2011/10/09/travel/ban-tham-lod-in-northern-thailand.html', 'snippet': 'A village, set amid caves and natural streams, manages to elude the encroachment of modern tourism.', 'lead_paragraph': 'MY mother shot me a concerned look. “No,” I said, anticipating her question, “This isn’t our stop.” I knew what she was thinking: This is exactly what we were trying to avoid.', 'print_section': 'TR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/travel/09JOURNEYS4_SPAN/09JOURNEYS4-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/09/travel/09JOURNEYS4_SPAN/09JOURNEYS4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/travel/09JOURNEYS4_SPAN/09JOURNEYS4-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/travel/09JOURNEYS4_SPAN/09JOURNEYS4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/travel/09JOURNEYS4_SPAN/09JOURNEYS4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Caves and Kayaks in a Quiet Corner of Thailand', 'kicker': 'Journeys', 'content_kicker': None, 'print_headline': 'Caves and Kayaks in a Quiet Corner of Thailand', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Thailand', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hikes and Hiking', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Caves and Caverns', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-07T16:43:25+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Russ Juskalian', 'person': [{'firstname': 'Russ', 'middlename': None, 'lastname': 'Juskalian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ccb8a8aa-9cc2-5367-849e-94d97c90e15c', 'word_count': 1752, 'uri': 'nyt://article/ccb8a8aa-9cc2-5367-849e-94d97c90e15c'}, {'abstract': 'The scent of lavender is André Aciman’s madeleine, connecting him with the past.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/alibis-essays-on-elsewhere-by-andre-aciman-book-review.html', 'snippet': 'The scent of lavender is André Aciman’s madeleine, connecting him with the past.', 'lead_paragraph': 'When, in 2005 and 2006, a mysterious sweet smell wafted across Staten Island, Brooklyn and Manhattan, it discomfited already jittery New Yorkers. The same thing happened again three years later, and the smell was finally identified: fenugreek, carried on breezes from a New Jersey flavor and fragrance factory. The incident reminded me of a passage in André Aciman’s fine 1995 memoir, “Out of Egypt,” in which he writes about the fragrance of hilba, fenugreek. Arab Egyptians drank it for its curative powers, and reeked afterward, but for many Alexandrian Jews who aspired to being European, nothing could be more déclassé than the smell of hilba. Aciman’s father called it une odeur d’arabe, an Arab smell, and hated any trace of it in the house or on his clothes. But, Aciman points out, “all homes bear ethnic odors,” and from the various smells of foods and perfumes the stories of communities and persons emerge. The opening chapter of “Alibis,” Aciman’s beautiful new book of essays, is an extended aria on the sense of smell.', 'print_section': 'BR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Cole/Cole-jumbo.jpg', 'height': 1024, 'width': 848, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Cole/Cole-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/Cole/Cole-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Essays From One of Our Best Wishful Thinkers', 'kicker': None, 'content_kicker': None, 'print_headline': 'Purple Haze', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Monet, Claude', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ACIMAN, ANDRE', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Smell (Olfaction)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Perfumes and Fragrances', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Proust, Marcel', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-07T16:43:41+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Teju Cole', 'person': [{'firstname': 'Teju', 'middlename': None, 'lastname': 'Cole', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/67c530fe-7aae-5ab9-89a4-1a5ff6542706', 'word_count': 1199, 'uri': 'nyt://article/67c530fe-7aae-5ab9-89a4-1a5ff6542706'}, {'abstract': 'A crime history of Marcel Petiot, a serial killer in Nazi-occupied Paris.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/death-in-the-city-of-light-by-david-king-book-review.html', 'snippet': 'A crime history of Marcel Petiot, a serial killer in Nazi-occupied Paris.', 'lead_paragraph': 'Three months before D‑Day, in 1944, some Parisians in the chic 16th Arrondissement started complaining about thick smoke with an acrid smell emanating from the stately town house at 21 rue Le Sueur. Worried about a chimney fire, one neighbor finally called the authorities. They discovered that the mansion’s basement was festooned with human bones, its coal stove burning body parts. A smaller outbuilding housed a mysterious, virtually soundproof triangular room. The former stable hid a pit about 10 feet deep filled with quicklime and rotting flesh.', 'print_section': 'BR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Santoro/Santoro-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/09/books/review/Santoro/Santoro-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Santoro/Santoro-jumbo.jpg', 'height': 648, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Santoro/Santoro-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/Santoro/Santoro-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Mysterious Serial Killer Who Terrified Nazi-Occupied Paris', 'kicker': None, 'content_kicker': None, 'print_headline': 'Accomplice to Evil', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Serial Murders', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'King, David', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hitler, Adolf', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-07T16:44:31+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gene Santoro', 'person': [{'firstname': 'Gene', 'middlename': None, 'lastname': 'Santoro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a93fd80c-264e-5c05-a442-084ad3bb7090', 'word_count': 670, 'uri': 'nyt://article/a93fd80c-264e-5c05-a442-084ad3bb7090'}, {'abstract': 'Sylvia Nasar traces the evolution of modern economic thought, from John Maynard Keynes to Amartya Sen.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/grand-pursuit-by-sylvia-nasar-book-review.html', 'snippet': 'Sylvia Nasar traces the evolution of modern economic thought, from John Maynard Keynes to Amartya Sen.', 'lead_paragraph': 'Listen to the economic debates of the past couple of years, and it’s tempting to conclude that no progress has been made in the field in over half a century. There’s John Maynard Keynes on the one side, arguing for deficit spending to offset the aftereffects of a once-in-a-lifetime financial crisis. On the other side there’s Ludwig von Mises (his fellow Austrians Joseph Schumpeter and Friedrich von Hayek seem too moderate for the role), thundering that all govern\xadment intervention in the economy is doomed to failure.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/09FOX/09FOX-jumbo.jpg', 'height': 1024, 'width': 756, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/09FOX/09FOX-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/09FOX/09FOX-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'How the Dismal Science Stopped Being Dismal', 'kicker': None, 'content_kicker': None, 'print_headline': 'Principals of Economics', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Keynes, John Maynard', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sen, Amartya', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Heilbroner, Robert L', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Friedman, Milton', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Nasar, Sylvia', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-07T16:45:26+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Justin Fox', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Fox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2e722a6c-684a-5ce4-ba99-32f6c339688d', 'word_count': 1236, 'uri': 'nyt://article/2e722a6c-684a-5ce4-ba99-32f6c339688d'}, {'abstract': 'A newspaper columnist and grieving father turns to letter writing in this novel.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/the-matter-with-morris-by-david-bergen-book-review.html', 'snippet': 'A newspaper columnist and grieving father turns to letter writing in this novel.', 'lead_paragraph': 'This fine, small-scale novel by the Canadian writer David Bergen starts with the plight of a newspaper columnist who can no longer bear to use his family as fodder. Morris Schutt owes his wide readership to his “seeming annulment of the private” — the description of his older daughter’s live-in boyfriend as “rabbit-like, soft and pale with a curious nose that twitched”; the stories of his son, a university dropout who plays online poker. Yet after his son is killed while serving in Afghanistan, Morris begins “to lose his grasp of himself.” In one of his last columns, before his agent makes him take a break, he shifts from his reader-pleasing first-person voice to the “alienating” second person and echoes a 17th-century mystic: “The wheel turns and you have no destination where to arrive.”', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Morrice/Morrice-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/09/books/review/Morrice/Morrice-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Morrice/Morrice-jumbo.jpg', 'height': 853, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/Morrice/Morrice-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/Morrice/Morrice-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Newspaper Columnist in Recovery', 'kicker': None, 'content_kicker': None, 'print_headline': 'Metaphysics of Mourning', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bergen, David', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-07T16:45:43+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Polly Morrice', 'person': [{'firstname': 'Polly', 'middlename': None, 'lastname': 'Morrice', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4f701905-57be-516d-8828-a100569c4b2d', 'word_count': 640, 'uri': 'nyt://article/4f701905-57be-516d-8828-a100569c4b2d'}, {'abstract': 'Conservatism at its core, this book argues, is about subjugating the lower orders.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/the-reactionary-mind-by-corey-robin-book-review.html', 'snippet': 'Conservatism at its core, this book argues, is about subjugating the lower orders.', 'lead_paragraph': 'The American right has a lot to answer for these days. Members of this group are ardent peddlers of conspiracy theories, anti-intellectualism and the demonization of opponents. This approach has contributed in no small way to the sorry state of contemporary American politics, where epithets have replaced arguments, a sense of common destiny seems lacking among citizens and compromise has become almost impossible on the most pressing national issues. A book documenting the wreckage and carefully tracing the links between right-wing ideas, policies and outcomes would be a significant contribution to public debate. Unfortunately, Corey Robin’s “Reactionary Mind” is not that book.', 'print_section': 'BR', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/BERMAN/BERMAN-jumbo.jpg', 'height': 1017, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/BERMAN/BERMAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/BERMAN/BERMAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Conservative as Elitist', 'kicker': None, 'content_kicker': None, 'print_headline': 'Keeping Them Down', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Burke, Edmund', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ROBIN, COREY', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Palin, Sarah', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-07T16:46:07+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Sheri Berman', 'person': [{'firstname': 'Sheri', 'middlename': None, 'lastname': 'Berman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/72a66022-ac73-5a93-aaba-bf8661a351cd', 'word_count': 1175, 'uri': 'nyt://article/72a66022-ac73-5a93-aaba-bf8661a351cd'}, {'abstract': 'In Erin Morgenstern’s historical novel, two lovestruck magicians are engaged in a battle of imagination and will.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/the-night-circus-by-erin-morgenstern-book-review.html', 'snippet': 'In Erin Morgenstern’s historical novel, two lovestruck magicians are engaged in a battle of imagination and will.', 'lead_paragraph': 'Let me say at the outset that glamour and charm are notoriously difficult qualities to render on the page, and all those words like “mercury” and “lightning” and “ineffability” certainly apply, ditto “catching,” “capturing” and “chasing.” It may well be the case that we still hold “The Great Gatsby” in such high esteem because of those amazing parties to which none of us will ever be invited, and wouldn’t have been in the 1920s, either. If glamour were easy, the entire fashion industry could do its thing on Sunday afternoons with a spool of thread and a few yards of gauze. Moreover, for the true geniuses of glamour, a spool of thread and a few yards of gauze are all it takes to make one feel that one is Marie Antoinette spinning around Versailles. For the rest of us, glamour is a sweaty struggle, rife with pricked thumbs, bulges and gaffes. This is why it is a risky business indeed to devote nearly 400 pages to a confection called le Cirque des Rêves, a circus that occurs at night (as opposed to what other sort of circus, by the way?) and is famous, apparently, for doing wild, magical, life-changing, impossible things. Like a magician, the writer must pull the rabbit from the hat, cut the lady in half, make the elephant disappear and so on. We long to be fooled. In “The Night Circus,” her debut novel, Erin Morgenstern works hard to create just such a sense of magic, but there finally seems to be something too sensible about her sensibility to pull off the trick. The novel is — and it’s an odd thing to say about a work of fiction — just too real to be believed. True magic is dangerous, and there is little of that sort of propulsive danger in these pages; where it does occur is surprising, and oddly marginalized.', 'print_section': 'BR', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/DERASMO-sub/DERASMO-sub-jumbo.jpg', 'height': 1024, 'width': 764, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/DERASMO-sub/DERASMO-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/DERASMO-sub/DERASMO-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Erin Morgenstern’s Magician Death Match', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Illusionists', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Circuses', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Magic and Magicians', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-07T16:46:50+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': "By Stacey D'Erasmo", 'person': [{'firstname': 'Stacey', 'middlename': None, 'lastname': "D'Erasmo", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c86022e9-f8fa-582c-85e8-0a994cccdcad', 'word_count': 1164, 'uri': 'nyt://article/c86022e9-f8fa-582c-85e8-0a994cccdcad'}, {'abstract': 'Jacques Steinberg profiles six everyday athletes and their attempts to complete an Ironman triathlon.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/you-are-an-ironman-by-jacques-steinberg-book-review.html', 'snippet': 'Jacques Steinberg profiles six everyday athletes and their attempts to complete an Ironman triathlon.', 'lead_paragraph': 'The popular satirical blog Stuff White People Like asserts that “if you find yourself in a situation where a white person is talking about a marathon, you must be impressed or you will lose favor with them immediately.” And if the subject of triathlons ever comes up, “just say that triathletes are in better shape than football and basketball players. It’s not true, but it will make the conversation a lot more genial.” I recognize in myself, a sometime marathoner, the species of endurance-sport bore the bloggers are describing.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/SUBJENNINGS/SUBJENNINGS-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/09/books/review/SUBJENNINGS/SUBJENNINGS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/SUBJENNINGS/SUBJENNINGS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/SUBJENNINGS/SUBJENNINGS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/SUBJENNINGS/SUBJENNINGS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'What It Takes to Be an Ironman Triathlete', 'kicker': None, 'content_kicker': None, 'print_headline': 'What Keeps Them Going', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ironman Triathlon (Hawaii)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Steinberg, Jacques', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-07T16:47:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jay Jennings', 'person': [{'firstname': 'Jay', 'middlename': None, 'lastname': 'Jennings', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/cfd73e3c-00ef-5b0b-bf5f-c32838e08661', 'word_count': 644, 'uri': 'nyt://article/cfd73e3c-00ef-5b0b-bf5f-c32838e08661'}, {'abstract': 'Instead of signing her divorce papers, a woman checks into the New Orleans hotel “thick with the ghosts” of her marriage.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/a-small-hotel-by-robert-olen-butler-book-review.html', 'snippet': 'Instead of signing her divorce papers, a woman checks into the New Orleans hotel “thick with the ghosts” of her marriage.', 'lead_paragraph': 'Toward the end of “A Small Hotel,” Robert Olen Butler’s feverish new novel, a Florida lawyer named Michael Hays tries to convince himself that his prospective lover, Laurie, blond and 26 years his junior, is something other than the “ditz” she proclaims herself to be. “She’s a perfect client,” he thinks. “Surprisingly smart and self-aware and honestly self-critical.” Michael could easily be describing any of the characters who populate Butler’s vast and diverse body of fiction — a dozen novels and some half-dozen story collections, some more successful than others — from the Vietnamese immigrants in “A Good Scent From a Strange Mountain,” which won the Pulitzer in 1993, to the panoply of the famous damned in his 2009 novel “Hell.” Despite the humor threaded through his works, Butler’s characters are indisputably tragic, in that their abundant knowledge of their own needs and flaws traps rather than frees them.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Death of a Marriage in New Orleans', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Big Uneasy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Butler, Robert Olen', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-07T16:47:59+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joanna Smith Rakoff', 'person': [{'firstname': 'Joanna', 'middlename': 'Smith', 'lastname': 'Rakoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c2f94abc-50be-5d47-8539-78a8957c60b4', 'word_count': 584, 'uri': 'nyt://article/c2f94abc-50be-5d47-8539-78a8957c60b4'}, {'abstract': 'Moralizing is not the best way of dealing with political evil, Alan Wolfe writes.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/political-evil-by-alan-wolfe-book-review.html', 'snippet': 'Moralizing is not the best way of dealing with political evil, Alan Wolfe writes.', 'lead_paragraph': 'Years ago Irving Kristol, the prime mover of American neoconservatism, said to me, in typical aphoristic style: “The orthodox are always right.” What he meant, I think, is that the enduring truths of traditionalism may at times be hard to grasp, but they endure for a reason. In foreign policy, it is realists who are, in Kristol’s sense, always right.', 'print_section': 'BR', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/06/books/review/rauch/rauch-jumbo.jpg', 'height': 1024, 'width': 1010, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/06/books/review/rauch/rauch-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/06/books/review/rauch/rauch-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'When Moralism Isn’t Moral', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Praise of Politics', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wolfe, Alan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hitler, Adolf', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Stalin, Joseph', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-10-07T16:48:23+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jonathan Rauch', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Rauch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a4938e3f-aace-5ba8-aca6-145c89980d8f', 'word_count': 1220, 'uri': 'nyt://article/a4938e3f-aace-5ba8-aca6-145c89980d8f'}, {'abstract': 'The decisions we make as patients have a lot to do with our personal histories.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/your-medical-mind-by-jerome-groopman-and-pamela-hartzband-book-review.html', 'snippet': 'The decisions we make as patients have a lot to do with our personal histories.', 'lead_paragraph': 'Most of us believe we are rational decision makers. But medical decisions are especially complex, thanks to the numerous unknowns and the uniqueness of each person’s body. Suppose you’ve just found out that you or a loved one has prostate cancer, one of the many examples in Jerome Groopman and Pamela Hartzband’s illuminating new book, “Your Medical Mind.” Nearly every urologist would recommend radical surgery to remove the organ. Sounds reasonable, doesn’t it?', 'print_section': 'BR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/LEVITIN-sub/LEVITIN-sub-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/LEVITIN-sub/LEVITIN-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/LEVITIN-sub/LEVITIN-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'How Patients Think, and How They Should', 'kicker': None, 'content_kicker': None, 'print_headline': 'Heal Thyself', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hartzband, Pamela', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Groopman, Jerome', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Surgery and Surgeons', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Alternative and Complementary Medicine', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-07T16:48:31+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Daniel J. Levitin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Levitin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/162166a5-e35a-5f59-bb05-3e9cd0680486', 'word_count': 1206, 'uri': 'nyt://article/162166a5-e35a-5f59-bb05-3e9cd0680486'}, {'abstract': 'Emanuel Goffer executed trades based on proprietary information his brother Zvi, a former Galleon Group trader, bribed out of others. Zvi Goffer has been sentenced to 10 years in prison.', 'web_url': 'https://dealbook.nytimes.com/2011/10/07/judge-sentences-emanuel-goffer-to-three-years/', 'snippet': 'Emanuel Goffer executed trades based on proprietary information his brother Zvi, a former Galleon Group trader, bribed out of others. Zvi Goffer has been sentenced to 10 years in prison.', 'lead_paragraph': '8:11 p.m. | Updated ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Trader Sentenced to 3 Years in Insider Case', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Insider Trading', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Goffer, Emanuel', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Goffer, Zvi', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rajaratnam, Raj', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Galleon Group', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-07T16:49:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter Lattman', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Lattman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/352cfb8c-23b3-553b-8129-23f8ec623529', 'word_count': 391, 'uri': 'nyt://article/352cfb8c-23b3-553b-8129-23f8ec623529'}, {'abstract': 'Ernest Hemingway’s sympathetic new biography, appearing at No. 14 on the hardcover nonfiction list, includes his earliest recorded love letter to his first wife, Hadley Richardson.', 'web_url': 'https://www.nytimes.com/2011/10/16/books/review/inside-the-list.html', 'snippet': 'Ernest Hemingway’s sympathetic new biography, appearing at No. 14 on the hardcover nonfiction list, includes his earliest recorded love letter to his first wife, Hadley Richardson.', 'lead_paragraph': 'HEMINGWAY IN LOVE: Ernest Hemingway has been having a tough few months. First, he gets slapped around in Paula McLain’s best-\xadselling revenge novel “The Paris Wife,” which retells the story of his years in France from the point of view of his jilted first wife, Hadley Richardson. Then he’s mocked in Woody Allen’s “Midnight in Paris” as a self-serious blowhard. But a little bit of rehabilitation is on the way, thanks to “Hemingway’s Boat,” Paul Hendrickson’s sympathetic biography (new at No. 14 on the hardcover nonfiction list), not to mention the first installment of Hemingway’s complete letters, just out from Cambridge University Press. That project, which includes previously unseen materials from the Finca Vigía, Hemingway’s estate outside Havana, reminds us why we fell in love with the guy to begin with — or at least why Hadley did, even if his spelling and grammar weren’t always so hot. The book — the first of a projected 16 volumes — includes his earliest recorded love letter to “Hash,” written a few days before Christmas 1920. (Hadley burned most of his letters to her after they divorced in 1927.) “You can make me jealous — and you can hurt most awfully — ’cause my loving you is a chink in the armour of telling the world to go to hell and you can thrust a sword into it at any time,” Hemingway wrote, before explaining why he hadn’t kissed her goodbye on the train platform. “Lord — I thot I was loving you — If I wasnt I never could and never would love any one. Guess I was thinking too much about how I didn’t want you to go — Don’t you believe I love you? . . . I didn’t want to kiss you goodbye — that was the trouble — I wanted to kiss you good night — and there’s a lot of difference.”', 'print_section': 'BR', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/books/review/16inside/16inside-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/books/review/16inside/16inside-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Inside the List', 'kicker': 'TBR', 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-07T16:50:12+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jennifer Schuessler', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Schuessler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c74c5bd-f151-5ae2-9a42-d10b6c4f9f8a', 'word_count': 628, 'uri': 'nyt://article/9c74c5bd-f151-5ae2-9a42-d10b6c4f9f8a'}, {'abstract': 'Prime Minister Vladimir V. Putin remains the most popular politician in the country, but his support has been increasingly defined by inertia among voters, a new survey shows.', 'web_url': 'https://www.nytimes.com/2011/10/08/world/europe/russians-shrug-at-prospects-of-long-putin-reign-poll-shows.html', 'snippet': 'Prime Minister Vladimir V. Putin remains the most popular politician in the country, but his support has been increasingly defined by inertia among voters, a new survey shows.', 'lead_paragraph': 'MOSCOW — The majority of Russians have “grown weary” of waiting for Prime Minister Vladimir V. Putin to make positive changes in their lives, and many expect little new from him as he embarks on his second stint as president next year, according to a poll published Friday. ', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/08/world/08PUTIN/08PUTIN-jumbo.jpg', 'height': 715, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Russians Shrug at Prospects of Another Putin Term, Poll Shows', 'kicker': None, 'content_kicker': None, 'print_headline': 'Russians Shrug at Prospects of Another Putin Term, Poll Shows', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-07T16:50:51+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Michael Schwirtz', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Schwirtz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e7f7dfc-5daf-5740-87b3-05fedba79b39', 'word_count': 469, 'uri': 'nyt://article/6e7f7dfc-5daf-5740-87b3-05fedba79b39'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'TRAVELS IN SIBERIA,  by Ian Frazier (Picador, $20.) Dubious meals, broken-down vehicles and relics of the Gulag fill Frazier’s fascinating account of his journeys across the vast, forbidding region. As he demonstrated in “Great Plains” (1989) — a 25,000-mile jaunt from the Dakotas to Texas — Frazier makes us see how the most trivial or ephemeral detail is part of the essential texture of a place.', 'print_section': 'BR', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paperback Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-07T16:50:58+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/b2f4fc37-a3f8-5cfa-b5e4-a9f5244835f5', 'word_count': 513, 'uri': 'nyt://article/b2f4fc37-a3f8-5cfa-b5e4-a9f5244835f5'}, {'abstract': 'A World War II British family deals with its privations in unsettling ways.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/letters-from-an-unknown-woman-by-gerard-woodward-book-review.html', 'snippet': 'A World War II British family deals with its privations in unsettling ways.', 'lead_paragraph': 'In the early days of the blitz, Tory Pace lives with her mother in a little house in the southeast of London. Her children have been evacuated to the Cotswolds, and her husband, Donald, is missing in action in North Africa. Tory spends her days working in Farraway’s Gelatine Factory and her evenings missing her children and not much missing Donald, to whose death she is resigned.', 'print_section': 'BR', 'print_page': '38', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/09WILLITT/09WILLITT-jumbo.jpg', 'height': 1024, 'width': 862, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/books/review/09WILLITT/09WILLITT-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/books/review/09WILLITT/09WILLITT-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sex, Comedy and Life During Wartime', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hunger Pangs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Woodward, Gerard', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-07T16:51:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jincy Willett', 'person': [{'firstname': 'Jincy', 'middlename': None, 'lastname': 'Willett', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bbe3cca5-2fc1-5d94-9734-db2a3fbe897e', 'word_count': 660, 'uri': 'nyt://article/bbe3cca5-2fc1-5d94-9734-db2a3fbe897e'}, {'abstract': 'The e-book may inadvertently be driving footnotes to extinction.', 'web_url': 'https://www.nytimes.com/2011/10/09/books/review/will-the-e-book-kill-the-footnote.html', 'snippet': 'The e-book may inadvertently be driving footnotes to extinction.', 'lead_paragraph': 'When my dog, Pumpernickel, first found a stray grape on my kitchen floor, she licked at it, tumbled it around in her mouth and spat it out. She accepted a lot of food from my plate not traditionally thought of as interesting to dogs: carrots, broccoli, bagels. But she would not eat grapes, nor was she fond of raisins.', 'print_section': 'BR', 'print_page': '39', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/books/review/horowitz/horowitz-jumbo.jpg', 'height': 1024, 'width': 790, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/books/review/horowitz/horowitz-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/05/books/review/horowitz/horowitz-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Will the E-Book Kill the Footnote?', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'De-Noted', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Baker, Nicholson', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electronic Books and Readers', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wallace, David Foster', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-07T16:51:47+0000', 'document_type': 'article', 'news_desk': 'BookRevie