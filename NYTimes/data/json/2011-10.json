nk': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-21T10:57:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Richard W. Stevenson', 'person': [{'firstname': 'Richard', 'middlename': 'W.', 'lastname': 'Stevenson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4d372272-766c-520e-a6b5-d302a812ad2a', 'word_count': 942, 'uri': 'nyt://article/4d372272-766c-520e-a6b5-d302a812ad2a'}, {'abstract': 'Reader reaction to an earlier Goal blog post about spotting jerseys on the streets of New York.', 'web_url': 'https://goal.blogs.nytimes.com/2011/10/21/from-jerseys-on-the-streets-to-jerseys-in-your-closets/', 'snippet': 'Reader reaction to an earlier Goal blog post about spotting jerseys on the streets of New York.', 'lead_paragraph': 'We got a good reaction to our post last week about spotting soccer jerseys in New York. Nicholas Felice was the first to respond to our request for photos; that’s him at right in his 2000-01 Roma jersey — “the year they won the Scudetto,” he made a point to add — but others had some interesting contributions, too.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From Jerseys on the Streets to Jerseys in Your Closets', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-21T11:00:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/5f16a62