title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e1a74d37-ffa7-57ab-8ff3-beee67e7eefb', 'word_count': 1045, 'uri': 'nyt://article/e1a74d37-ffa7-57ab-8ff3-beee67e7eefb'}, {'abstract': 'The Imagine Science Film Festival, in its fourth year, features 80 movies from 15 countries and will screen films at sites across New York City.', 'web_url': 'https://www.nytimes.com/2011/10/14/movies/imagine-science-film-festival-with-80-movies.html', 'snippet': 'The Imagine Science Film Festival, in its fourth year, features 80 movies from 15 countries and will screen films at sites across New York City.', 'lead_paragraph': 'When Alexis Gambis fell in love with fruit flies, it was a difficult relationship to explain to his friends. So he turned the lab where he was studying the flies’ genome sequences into a studio and made a film about his passion. ', 'print_section': 'C', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/arts/14MISER_SPAN/14MISER_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/14/arts/14MISER_SPAN/14MISER_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/arts/14MISER_SPAN/14MISER-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/arts/14MISER_SPAN/14MISER_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/14/arts/14MISER_SPAN/14MISER_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Science of Movies? A Film Festival Judges Just That', 'kicker': 'Weekend Miser', 'content_kicker': None, 'print_headline': 'The Science of Movies? A Film Festival Judges Just That', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-13T20:20:02+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Rachel Lee Harris', 'person': [{'firstname': 'Rachel', 'middlename': 'Lee', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7c22c04f-7ec6-50b4-9c06-d5918bb3344f', 'word_count': 604, 'uri': 'nyt://article/7c22c04f-7ec6-50b4-9c06-d5918bb3344f'}, {'abstract': 'In Bedford-Stuyvesant, casaBAN has set out to offer fresh, distinctive antiques in an area filled with historic, heavily ornamented brownstones.', 'web_url': 'https://www.nytimes.com/2011/10/16/nyregion/casaban-in-bedford-stuyvesant-offers-sleek-antiques.html', 'snippet': 'In Bedford-Stuyvesant, casaBAN has set out to offer fresh, distinctive antiques in an area filled with historic, heavily ornamented brownstones.', 'lead_paragraph': 'IT may not be Bergdorf’s, as its owner likes to joke. But the competitive shopping at casaBAN — an antiques store far from Fifth Avenue, in Bedford-Stuyvesant, Brooklyn — is just as fierce. ', 'print_section': 'MB', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/nyregion/16SUBJOINT-2/16SUBJOINT-2-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/16/nyregion/16SUBJOINT-2/16SUBJOINT-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/16/nyregion/16SUBJOINT-2/16SUBJOINT-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Taste for Modern in Antiques', 'kicker': 'Neighborhood Joint', 'content_kicker': None, 'print_headline': 'A Taste For Modern In Antiques', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Bedford-Stuyvesant (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ANTIQUES', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-13T20:20:57+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Alexis Okeowo', 'person': [{'firstname': 'Alexis', 'middlename': None, 'lastname': 'Okeowo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/702f0cea-f489-5b2e-a838-dbbd1e7aa596', 'word_count': 634, 'uri': 'nyt://article/702f0cea-f489-5b2e-a838-dbbd1e7aa596'}, {'abstract': 'Valery Gergiev and Daniil Trifonov joined with the Mariinsky Orchestra at Carnegie Hall.', 'web_url': 'https://www.nytimes.com/2011/10/14/arts/music/mariinsky-orchestra-valery-gergiev-and-daniil-trifonov-review.html', 'snippet': 'Valery Gergiev and Daniil Trifonov joined with the Mariinsky Orchestra at Carnegie Hall.', 'lead_paragraph': 'For all the attention being lavished on Tchaikovsky’s appearances in the festival that opened Carnegie Hall in 1891 as a pretext for the hall’s 120th anniversary celebration, Carnegie has made no point of reviving the works the composer conducted, which included his “Marche Solennelle,” his Third Orchestral Suite and two of his a cappella choruses. But willy-nilly, one of those works did appear on Tuesday evening, when Daniil Trifonov played Tchaikovsky’s First Piano Concerto with Valery Gergiev and the Mariinsky Orchestra in the hall.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/arts/14TRIFONOV/TRIFONOV-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/14/arts/14TRIFONOV/TRIFONOV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/arts/14TRIFONOV/TRIFONOV-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/14/arts/14TRIFONOV/TRIFONOV-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/14/arts/14TRIFONOV/TRIFONOV-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sounds for a Samovar: Carnegie Hall Russian Night', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Sounds for a Samovar: Carnegie Hall Russian Night', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Mariinsky Theater Orchestra', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-13T20:21:02+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By James R. Oestreich', 'person': [{'firstname': 'James', 'middlename': 'R.', 'lastname': 'Oestreich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a49f959a-78be-5d54-90b8-21c5f723b3dc', 'word_count': 428, 'uri': 'nyt://article/a49f959a-78be-5d54-90b8-21c5f723b3dc'}, {'abstract': 'The cars were collected by 21 people who attended a taping last November of “The Oprah Winfrey Show,” where the host gave the Beetles away.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/10/13/winners-of-oprah-winfreys-ultimate-favorite-things-meet-their-beetles/', 'snippet': 'The cars were collected by 21 people who attended a taping last November of “The Oprah Winfrey Show,” where the host gave the Beetles away.', 'lead_paragraph': 'On Thursday morning, 21 people assembled in Orland Park, Ill., a southwest suburb of Chicago, to receive the keys to their 2012 Volkswagen Beetles. The cars were among 276 promised last November as surprise gifts to attendees at a special “Ultimate Favorite Things” studio taping of “The Oprah Winfrey Show,” now discontinued.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Winners of Oprah Winfrey’s ‘Ultimate Favorite Things’ Meet Their Beetles', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Winfrey, Oprah', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Volkswagen AG', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-13T20:21:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Phil Patton', 'person': [{'firstname': 'Phil', 'middlename': None, 'lastname': 'Patton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/32c04482-4ecb-5f1e-a33f-903393af2300', 'word_count': 419, 'uri': 'nyt://article/32c04482-4ecb-5f1e-a33f-903393af2300'}, {'abstract': 'While many have had trouble loading the new Apple iOS 5, for some the difficultly is severe. Here is a fix for when your phone or pad won’t respond and your computer can’t recognize it.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2011/10/13/a-fix-for-severe-ios-5-loading-problems/', 'snippet': 'While many have had trouble loading the new Apple iOS 5, for some the difficultly is severe. Here is a fix for when your phone or pad won’t respond and your computer can’t recognize it.', 'lead_paragraph': 'A lot of people have experienced problems loading Apple’s new iOS 5 iPhone and iPad operating system, usually getting an error message and being left temporarily without use of the device. It appears that the demand is overtaxing Apple servers, so some people just can’t get to the download, a problem that will clear itself up shortly.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Fix for Severe iOS 5 Loading Problems', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'iPhone', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Incorporated', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-13T20:24:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Roy Furchgott', 'person': [{'firstname': 'Roy', 'middlename': None, 'lastname': 'Furchgott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2124201b-b631-5d50-9c52-752a1a8b812e', 'word_count': 245, 'uri': 'nyt://article/2124201b-b631-5d50-9c52-752a1a8b812e'}, {'abstract': 'People with a condition known as Barrett’s esophagus, a complication of acid reflux disease, have a higher risk of developing esophageal cancer — but the risk is far smaller than widely believed, a new study shows, and routine screening may not be necessary.', 'web_url': 'https://well.blogs.nytimes.com/2011/10/13/cancer-risk-from-barretts-esophagus-lower-than-thought/', 'snippet': 'People with a condition known as Barrett’s esophagus, a complication of acid reflux disease, have a higher risk of developing esophageal cancer — but the risk is far smaller than widely believed, a new study shows, and routine screening may not be...', 'lead_paragraph': 'People who have a condition known as Barrett’s esophagus, a complication of acid reflux disease, have a higher risk of developing esophageal cancer — but the risk is far smaller than widely believed, a new study shows.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cancer Risk From Barrett’s Esophagus Lower Than Thought', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cancer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Esophageal Cancer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-13T20:28:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': "By Anahad O'Connor", 'person': [{'firstname': 'Anahad', 'middlename': None, 'lastname': "O'Connor", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fa65493c-20dc-5e63-8a21-8c06499a814b', 'word_count': 537, 'uri': 'nyt://article/fa65493c-20dc-5e63-8a21-8c06499a814b'}, {'abstract': '“The truth about getting a new dog is that it makes you miss the old one.”', 'web_url': 'https://www.nytimes.com/2011/10/13/books/excerpt-the-puppy-diaries-by-jill-abramson.html', 'snippet': '“The truth about getting a new dog is that it makes you miss the old one.”', 'lead_paragraph': 'Chapter One', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘The Puppy Diaries’', 'kicker': 'Excerpt', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-13T20:30:42+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'byline': {'original': 'By Jill Abramson', 'person': [{'firstname': 'Jill', 'middlename': None, 'lastname': 'Abramson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'First Chapter', '_id': 'nyt://article/96116262-6b4c-556a-9c21-51bf7cb55efc', 'word_count': 1015, 'uri': 'nyt://article/96116262-6b4c-556a-9c21-51bf7cb55efc'}, {'abstract': 'Houdini and his art unshackles the imagination in a retrospective at San Francisco’s Contemporary Jewish Museum.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/10/13/escape-tactics-houdini-art-and-magic/', 'snippet': 'Houdini and his art unshackles the imagination in a retrospective at San Francisco’s Contemporary Jewish Museum.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Escape Tactics | ‘Houdini: Art and Magic’', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-13T20:30:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Stephanie Orma', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'Orma', 'qualifier': None, 'title': None, 'role': 'reported'