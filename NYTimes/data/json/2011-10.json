e': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fa133735-ced9-537b-8be4-d75dc8096afa', 'word_count': 803, 'uri': 'nyt://article/fa133735-ced9-537b-8be4-d75dc8096afa'}, {'abstract': 'The longtime Raiders owner held a series of other positions along the way that gave him a unique pro football résumé.', 'web_url': 'https://www.nytimes.com/2011/10/09/sports/football/al-davis-built-a-unique-pro-football-resume.html', 'snippet': 'The longtime Raiders owner held a series of other positions along the way that gave him a unique pro football résumé.', 'lead_paragraph': 'Al Davis’s résumé at the Pro Football Hall of Fame tells all you need to know about what he accomplished in more than half a century.', 'print_section': 'SP', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/sports/09sotanderson-1/09sotanderson-1-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/09/sports/09sotanderson-1/09sotanderson-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/sports/09sotanderson-1/09sotanderson-1-jumbo.jpg', 'height': 650, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/sports/09sotanderson-1/09sotanderson-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/sports/09sotanderson-1/09sotanderson-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Genius in Silver and Black', 'kicker': 'Sports of The Times', 'content_kicker': None, 'print_headline': 'A Genius In Silver And Black', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Football League', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Oakland Raiders', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Al', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-09T01:02:54+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Dave Anderson', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Anderson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b4fe28ad-a7d6-5d42-9681-884a2251070c', 'word_count': 898, 'uri': 'nyt://article/b4fe28ad-a7d6-5d42-9681-884a2251070c'}, {'abstract': 'Corrections appearing in print on October 9, 2011.', 'web_url': 'https://www.nytimes.com/2011/10/09/pageoneplus/corrections-october-9.html', 'snippet': 'Corrections appearing in print on October 9, 2011.', 'lead_paragraph': 'INTERNATIONAL', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: October 9', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-09T01:05:37+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/fed1efb1-6555-5da7-950a-765113845f6b', 'word_count': 934, 'uri': 'nyt://article/fed1efb1-6555-5da7-950a-765113845f6b'}, {'abstract': 'Al Davis never seemed to care what anybody thought about how he ran his team or how he conducted himself.', 'web_url': 'https://www.nytimes.com/2011/10/09/sports/football/al-davis-was-a-maverick-until-his-death.html', 'snippet': 'Al Davis never seemed to care what anybody thought about how he ran his team or how he conducted himself.', 'lead_paragraph': 'Amy Trask glanced out her office window Saturday morning and glimpsed some fans — one of them with a dog in an Oakland Raiders jersey — who had come to the team’s training center to pay their respects to Al Davis, the iconoclastic, iconic, iron-fisted owner of the team that was defined by him, and in turn reflected him. The youngest of those fans who made the pilgrimage probably thought of Davis as a throwback, perhaps a bit of an eccentric with his white or black Raiders track suits, his Brylcreemed hair, a man whose recent misjudgments of players and coaches had consigned the team to losing, occasionally cartoonish seasons. ', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/sports/battista/battista-jumbo.jpg', 'height': 809, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/09/sports/battista/battista-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/09/sports/battista/battista-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Davis Lived Up to the Label of Maverick Till His Death', 'kicker': 'An Appraisal', 'content_kicker': None, 'print_headline': 'Davis Lived Up to the Label Of Maverick Till His Death', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Football League', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Al', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Oakland Raiders', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-09T01:09:49+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'An Appraisal', '_id': 'nyt://article/02ce6f89-a11c-5942-b2cc-c6b2c7fc0782', 'word_count': 1036, 'uri': 'nyt://article/02ce6f89-a11c-5942-b2cc-c6b2c7fc0782'}, {'abstract': 'Throughout the day, die-hard Raiders fans converged at Ricky’s restaurant to drink to Al Davis’s memory and at the team’s practice facility.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/10/08/fans-raise-a-glass-to-al-davis/', 'snippet': 'Throughout the day, die-hard Raiders fans converged at Ricky’s restaurant to drink to Al Davis’s memory and at the team’s practice facility.', 'lead_paragraph': 'OAKLAND, Calif. — In the back of Ricky’s restaurant in San Leandro, the unofficial headquarters of Raider Nation, a booth was empty Saturday afternoon except for the memories on the tabletop: a Super Bowl XV program; a Raiders program from a Sept. 27, 1964 home game against the Kansas City Chiefs with Al Davis on the cover, stalking the sideline; the California license plate JST WN BBY; a Raider beer mug, a Raider helmet telephone and two pennants, one from the 1977 Super Bowl at the Rose Bowl. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fans Raise a Glass to Al Davis', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name':