major': 'N'}], 'pub_date': '2011-10-19T21:56:09+0000', 'document_type': 'multimedia', 'news_desk': 'World', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/a4c92456-917f-5831-a825-4c3953da6b63', 'word_count': 0, 'uri': 'nyt://slideshow/a4c92456-917f-5831-a825-4c3953da6b63'}, {'abstract': 'The sight of a mother in Prada fur and boots dropping off her child is far more common these days.', 'web_url': 'https://www.nytimes.com/2011/10/20/fashion/mom-uniforms-for-school-run-are-designers.html', 'snippet': 'The sight of a mother in Prada fur and boots dropping off her child is far more common these days.', 'lead_paragraph': 'IN the West Village, a stunningly decked-out woman is nothing unusual. But Rose Cameron still managed to turn heads in the neighborhood recently, with her long black hair and full-length fur coat. Perhaps it was because she wasn’t leaving Bar Pitti at midnight, but exiting the Little Red School House after dropping off her child. The time: 8:30 a.m. ', 'print_section': 'E', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/fashion/20SCHOOLRUN1_SPAN/20SCHOOLRUN_SPAN-articleLarge.jpg', 'height': 215, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/20/fashion/20SCHOOLRUN1_SPAN/20SCHOOLRUN_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 215}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/fashion/20SCHOOLRUN1_SPAN/20SCHOOLRUN_SPAN-jumbo.jpg', 'height': 215, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/20/fashion/20SCHOOLRUN1_SPAN/20SCHOOLRUN_SPAN-thum