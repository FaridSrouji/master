: None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-14T14:47:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Pete Wells', 'person': [{'firstname': 'Pete', 'middlename': None, 'lastname': 'Wells', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ec48c0fd-a350-5c92-ab3a-fd74be996a5f', 'word_count': 276, 'uri': 'nyt://article/ec48c0fd-a350-5c92-ab3a-fd74be996a5f'}, {'abstract': 'A look at the latest study of booster seats for children.', 'web_url': 'https://parenting.blogs.nytimes.com/2011/10/14/getting-the-booster-seat-right/', 'snippet': 'A look at the latest study of booster seats for children.', 'lead_paragraph': 'Time to review the booster seats. Thursday’s Washington Post reported on the most recent booster seats evaluations from the Insurance Institute for Highway Safety, and while more booster seats than ever were “best bets,” meaning that they position a safety belt properly in most cars, many (including ours) were rated “check fit.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Getting the Booster Seat Right', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-14T14:51:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Karin Dell'Antonia", 'person': [{'firstname': 'Karin', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac3b95e0-42ee-5fdc-ad64-e3dd8783855e', 'word_count': 225, 'uri': 'nyt://article/ac3b95e0-42ee-5fdc-ad64-e3dd8783855e'}, {'abstract': 'After fears of eviction, Occupy Wall Street protesters celebrated, marched and continued