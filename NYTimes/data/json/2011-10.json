t_kicker': None, 'print_headline': 'Cloaks: Snuggies With Panache', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coats', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-05T22:44:25+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Marisa Meltzer', 'person': [{'firstname': 'Marisa', 'middlename': None, 'lastname': 'Meltzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b15fbbce-7f3d-5697-b1bf-ac4c2fb8feef', 'word_count': 604, 'uri': 'nyt://article/b15fbbce-7f3d-5697-b1bf-ac4c2fb8feef'}, {'abstract': 'With legalized marijuana, vaporizers are a more efficient, healthier way to get the medicinal effects of the plant.', 'web_url': 'https://www.nytimes.com/2011/10/06/fashion/vaporizers-put-to-use-with-marijuana.html', 'snippet': 'With legalized marijuana, vaporizers are a more efficient, healthier way to get the medicinal effects of the plant.', 'lead_paragraph': 'RICK CUSICK, the associate publisher of the marijuana magazine High Times, remembers the first time he saw a vaporizer. It was in 2000, at a tobacco trade show in Las Vegas. “I was having a party in my room at the Sahara,” Mr. Cusick said, “when two men walked in carrying a 50-pound drill press attached to a plywood board.” The drill press had been set up with copper tubing to heat cannabis just enough so that its active ingredient, tetrahydrocannabinol, was released not as smoke but as a less scorching vapor.', 'print_section': 'E', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/06/fashion/06noticed-span/06noticed-span-articleLarge.jpg', 'height': 353, 'width': 600, 'subType': 'xlarge', 'cro