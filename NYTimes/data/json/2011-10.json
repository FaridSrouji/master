, {'abstract': 'Before a plot was supposedly hatched to assassinate him, Adel al-Jubeir, the Saudi ambassador to the United States, tried to stay out of the spotlight, having once been a man about town.', 'web_url': 'https://www.nytimes.com/2011/10/15/world/middleeast/wild-days-behind-him-saudi-envoy-jubeir-keeps-low-profile.html', 'snippet': 'Before a plot was supposedly hatched to assassinate him, Adel al-Jubeir, the Saudi ambassador to the United States, tried to stay out of the spotlight, having once been a man about town.', 'lead_paragraph': 'WASHINGTON — For years, Adel al-Jubeir was the playboy Saudi envoy and man about town, hosting parties on the diplomatic circuit, hobnobbing with this city’s political elite and appearing at events with media celebrities like Campbell Brown, then the White House correspondent for NBC News.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/world/15ambassador/15ambassador-jumbo.jpg', 'height': 1024, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/world/15ambassador/15ambassador-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/15/world/15ambassador/15ambassador-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Wild Days Behind Him, Envoy Keeps Low Profile', 'kicker': 'Diplomatic Memo', 'content_kicker': None, 'print_headline': 'Wild Days Behind Him, Envoy Keeps Low Profile', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diplomatic Service, Embassies and Consulates', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 2, 'major': 'N'}, {'name': 'subjec