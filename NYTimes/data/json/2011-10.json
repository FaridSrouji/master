00, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/fashion/video-menkes-paris-chloe/video-menkes-paris-chloe-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/05/fashion/video-menkes-paris-chloe/video-menkes-paris-chloe-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'An Interview With Clare Waight Keller', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Paris Fashion Week', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-04T11:10:52+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Fashion & Style', 'byline': {'original': 'Stefania Rousselle', 'person': [{'firstname': 'Stefania', 'middlename': None, 'lastname': 'Rousselle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/fd826c81-7cd5-5a81-8e9d-fd7fb7226590', 'word_count': 0, 'uri': 'nyt://video/fd826c81-7cd5-5a81-8e9d-fd7fb7226590'}, {'abstract': 'A standard known as Scope 3 is aimed at helping companies measure greenhouse gas emissions generated along the supply chain for their products as well as when the products are used and eventually disposed of.', 'web_url': 'https://green.blogs.nytimes.com/2011/10/04/a-new-standard-for-carbon-footprints/', 'snippet': 'A standard known as Scope 3 is aimed at helping companies measure greenhouse gas emissions generated along the supply chain for their products as well as when the products are used and eventually disposed of.', 'lead_paragraph': 'In an article in Tuesday’s Times, I write about new protocols that have been developed to help companies measure their greenhouse gas emissions. The goal is to guide them in tallying emissions across the entire life cycle of a product and the value chain of a corporation. (That’s company-speak for the emissions resulting from gathering the raw materials for the product, using the product and eventually disposing of it.) ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Standard for Carbon Footprints', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-10-04T11:15:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Leslie Kaufman', 'person': [{'firstname': 'Leslie', 'middlename': None, 'lastname': 'Kaufman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3162d4f-429b-51d2-a5a5-d06720793f76', 'word_count': 107, 'uri': 'nyt://article/e3162d4f-429b-51d2-a5a5-d06720793f76'}, {'abstract': 'A blast in Mogadishu, Somalia’s capital, killed more than 50 people and possibly signaled a comeback for the Islamic militant group known as the Shabab.', 'web_url': 'https://www.nytimes.com/2011/10/05/world/africa/truck-bomb-kills-dozens-in-somalias-capital.html', 'snippet': 'A blast in Mogadishu, Somalia’s capital, killed more than 50 people and possibly signaled a comeback for the Islamic militant group known as the Shabab.', 'lead_paragraph': 'MOGADISHU, Somalia — This particular area of Mogadishu was supposed to be safe, a highly fortified government compound in one of the few neighborhoods that Somalia’s transitional government actually controls.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/05/world/SOMALIA/SOMALIA-arti