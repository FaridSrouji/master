inese Diplomacy', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-25T20:39:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Charlie Savage', 'person': [{'firstname': 'Charlie', 'middlename': None, 'lastname': 'Savage', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dff925c9-cb7c-5636-93ad-db23bea6eec6', 'word_count': 717, 'uri': 'nyt://article/dff925c9-cb7c-5636-93ad-db23bea6eec6'}, {'abstract': 'A stretch of the Grand Concourse in the Bronx, an artists’ colony in the far West Village and the Paul Robeson Theater were awarded landmark protection on Tuesday.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/10/25/the-grand-concourse-gets-its-due/', 'snippet': 'A stretch of the Grand Concourse in the Bronx, an artists’ colony in the far West Village and the Paul Robeson Theater were awarded landmark protection on Tuesday.', 'lead_paragraph': 'The city gave an Art Deco-filled stretch of the Grand Concourse in the Bronx — along with an artists’ housing complex in the West Village, a church-turned-synagogue-turned-theater in Brooklyn and a Staten Island cottage — landmark protection on Tuesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Grand Concourse Gets Its Due', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Landmarks Preservation Commission', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Grand Concourse (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date':