 'print_headline': 'Lottery Numbers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lotteries', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-11T01:24:46+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/1dbca818-3926-53b6-b92b-56f22a87f5a5', 'word_count': 175, 'uri': 'nyt://article/1dbca818-3926-53b6-b92b-56f22a87f5a5'}, {'abstract': 'Documents in a legal battle between Chevron and Ecuadoreans over damage to the Amazon rain forest show contacts between lobbyists and then-Attorney General Andrew M. Cuomo.', 'web_url': 'https://www.nytimes.com/2011/10/11/nyregion/documents-in-chevron-suit-show-lobbyists-contacts-with-cuomo.html', 'snippet': 'Documents in a legal battle between Chevron and Ecuadoreans over damage to the Amazon rain forest show contacts between lobbyists and then-Attorney General Andrew M. Cuomo.', 'lead_paragraph': 'Two years ago, Andrew M. Cuomo, then New York’s attorney general, unexpectedly jumped into a legal fight over an issue that had little to do with the state: damage to the Amazon rain forest from oil drilling.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/11/nyregion/cuomo/cuomo-jumbo.jpg', 'height': 345, 'width': 265, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/11/nyregion/cuomo/cuomo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'th