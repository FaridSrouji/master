major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chelsea Market', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Chelsea (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-26T16:56:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Elissa Gootman', 'person': [{'firstname': 'Elissa', 'middlename': None, 'lastname': 'Gootman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b03c547f-fbbc-51cd-8c94-c6da8d1f1dd4', 'word_count': 455, 'uri': 'nyt://article/b03c547f-fbbc-51cd-8c94-c6da8d1f1dd4'}, {'abstract': 'Yale U. Press to publish lost one act play by Eugene O’Neill in book form.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/10/26/yale-press-to-publish-forgotten-eugene-oneill-one-act-in-book-form/', 'snippet': 'Yale U. Press to publish lost one act play by Eugene O’Neill in book form.', 'lead_paragraph': 'In 1912, the 24-year-old Eugene O’Neill tried to kill himself with an overdose of Veronal, but botched the job and was found unconscious by friends. He later wrote about the experience in an autobiographical one-act play, “Exorcism,” which ends with the O’Neill character, Ned Malloy, experiencing a kind of resurrection. “The Past is finally cremated,” he says. “I feel reborn, I tell you.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Yale Press to Publish Forgotten Eugene O’Neill One-Act in Book Form', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-26T17:07:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a2e8431b-2938-56f5-9980-3982706786fc', 'word_count': 346, 'uri': 'nyt://article/a2e8431b-2938-56f5-9980-3982706786fc'}, {'abstract': 'Horror fans offer a list of not-to-be-missed 1980s horror films.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/10/26/big-hair-and-bad-blood-vhs-era-horror-obscurities-from-a-to-z/', 'snippet': 'Horror fans offer a list of not-to-be-missed 1980s horror films.', 'lead_paragraph': 'For a certain subset of horror fan, the high quality of Blu-ray is unwatchable compared with the painfully grainy-hazy look of VHS (especially do-it-yourself titles that look like they were made over a weekend in some guy’s backyard). In recent years, small distributors and a few majors have released 1980s horror movies, mostly of the schlock variety, on special-edition VHS tapes as well as on DVD.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Big Hair and Bad Blood: VHS-Era Horror Obscurities From A to Z', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'DVD (Digital Versatile Disc)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nineteen Hundred Eighties', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings and Downloads', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-26T17:08:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04620241-f480-5a4d-aeb8-b150736f32a9', 'word_count': 901, 'uri': 'nyt://article/04620241-f480-5a4d-aeb8-b150736f32a9'}, {'abstract': 'The storm, which is expected to dump upward of 12 to 14 inches in some parts of the state, delivered more snow than the Denver area typically gets in all of October.', 'web_url': 'https://www.nytimes.com/2011/10/27/us/colorado-slammed-by-early-snow-storm.html', 'snippet': 'The storm, which is expected to dump upward of 12 to 14 inches in some parts of the state, delivered more snow than the Denver area typically gets in all of October.', 'lead_paragraph': 'GOLDEN, Colo. — A heavy, out-of-season winter storm slammed into Colorado and southeast Wyoming on Tuesday night, delivering in one roundhouse punch more snow than the Denver area typically gets in all of October. The piling on then continued through Wednesday, with a total of 12 to 14 inches falling in some places in foothill communities like this one, west of Denver, and even more in the higher peaks and passes of the Rockies.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/27/us/SNOW/SNOW-jumbo.jpg', 'height': 667, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/27/us/SNOW/SNOW-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/27/us/SNOW/SNOW-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Early Snow Turns Colorado’s Fall Foliage to Winter White', 'kicker': None, 'content_kicker': None, 'print_headline': 'Early Snow Turns Colorado’s Fall Foliage to Winter White', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Denver (Colo)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Colorado', 'r