/world/video-indiaband/video-indiaband-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/09/12/world/video-indiaband/video-indiaband-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/09/12/world/video-indiaband/video-indiaband-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'India Wedding Band Blues', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-10T18:23:09+0000', 'document_type': 'multimedia', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'Poh Si Teng', 'person': [{'firstname': 'Poh', 'middlename': 'Si', 'lastname': 'Teng', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/7b158f40-f5c1-559b-8c5c-e2af4a927be2', 'word_count': 0, 'uri': 'nyt://video/7b158f40-f5c1-559b-8c5c-e2af4a927be2'}, {'abstract': 'The struggling Miami Dolphins are next on the Jets’ schedule.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/10/10/are-better-times-ahead-for-the-jets/', 'snippet': 'The struggling Miami Dolphins are next on the Jets’ schedule.', 'lead_paragraph': 'It was somewhat surprising that the Jets left Gillette Stadium late Sunday night with mixed emotions. Players spoke of frustration, of shock, at losing three consecutive games, all against quality A.F.C.opponents. Yet they also sounded much more encouraged than in weeks past, happier certainly than after the debacles in Oakland and Baltimore.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Are Better Times Ahead for the Jets?', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Greene, Shonn', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Slauson, Matt', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Dolphins', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-10-10T18:28:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Ben Shipgel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shipgel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2e432c53-a4d0-5ad7-ab58-7223fa5e461d', 'word_count': 291, 'uri': 'nyt://article/2e432c53-a4d0-5ad7-ab58-7223fa5e461d'}, {'abstract': 'Some may lament the return of the campy commercial-within-a-talk-show, a throwback to the likes of Jack Paar and Faye Emerson.', 'web_url': 'https://www.nytimes.com/2011/10/10/business/media/q-and-a-with-stuart-elliott.html', 'snippet': 'Some may lament the return of the campy commercial-within-a-talk-show, a throwback to the likes of Jack Paar and Faye Emerson.', 'lead_paragraph': 'Q: (Reader)', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2010/05/27/business/media/stuart-elliott-headshot/stuart-elliott-headshot-jumbo.jpg', 'height': 234, 'width': 190, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy