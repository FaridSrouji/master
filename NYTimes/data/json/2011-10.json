stname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/40ad5402-f756-59ab-96fe-a15d904d9a8f', 'word_count': 191, 'uri': 'nyt://article/40ad5402-f756-59ab-96fe-a15d904d9a8f'}, {'abstract': 'At least 2.3 million people across the Northeast found themselves without electricity after an unusual autumn storm dumped record amounts of snow.', 'web_url': 'https://www.nytimes.com/2011/10/31/us/storm-leaves-more-than-2-million-without-power.html', 'snippet': 'At least 2.3 million people across the Northeast found themselves without electricity after an unusual autumn storm dumped record amounts of snow.', 'lead_paragraph': 'Millions of people across the Northeast found themselves without power on Sunday after an unusual autumn storm dumped record amounts of snow.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/31/nyregion/31weather2/31weather2-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/31/nyregion/31weather2/31weather2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/31/nyregion/31weather2/31weather2-jumbo.jpg', 'height': 698, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Storm Leaves More Than 2 Million Without Power', 'kicker': None, 'content_kicker': None, 'print_headline': 'Storm Leaves More Than 2 Million Without Power', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Snow and Snowstorms', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Power Outages and Blackouts', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New England States (US)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Northeastern States (US)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-30T17:15:55+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sarah Maslin Nir', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3d5a291e-4b88-511b-89b1-85621860d06b', 'word_count': 1193, 'uri': 'nyt://article/3d5a291e-4b88-511b-89b1-85621860d06b'}, {'abstract': 'Defying all expectations of failure, India staged its inaugural Grand Prix without a serious glitch, while Sebastian Vettel won, taking his 11th race of the season.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2011/10/30/india-wins-as-vettel-leads-from-start-to-finish/', 'snippet': 'Defying all expectations of failure, India staged its inaugural Grand Prix without a serious glitch, while Sebastian Vettel won, taking his 11th race of the season.', 'lead_paragraph': 'NEW DELHI — Proving both the world and its own skeptics wrong, India staged its first Formula One race on Sunday in what has been hailed as a success for a country with a tarnished reputation for hosting international sporting events.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'India Wins, as Vettel Leads From Start to Finish', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-30T17:18:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Brad Spurgeon', 'person': [{'firstname': 'Brad', 'middlename': None, 'lastname': 'Spurgeon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 