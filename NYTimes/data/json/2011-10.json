ame': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/356617ea-12c4-57e7-a1b4-96eebb1b23f3', 'word_count': 395, 'uri': 'nyt://article/356617ea-12c4-57e7-a1b4-96eebb1b23f3'}, {'abstract': 'Commissioner David Stern canceled all games through Nov. 30, despite substantial progress made in several areas this week.', 'web_url': 'https://www.nytimes.com/2011/10/29/sports/basketball/nba-talks-stall-and-more-games-are-expected-to-be-canceled.html', 'snippet': 'Commissioner David Stern canceled all games through Nov. 30, despite substantial progress made in several areas this week.', 'lead_paragraph': 'Talks sputtered, games disappeared and frustrations simmered anew Friday afternoon when N.B.A. owners and players moved to the precipice of a deal, then squandered the moment. Any hope for a full season died when the negotiations did.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/29/sports/nba/nba-jumbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/29/sports/nba/nba-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/29/sports/nba/nba-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'N.B.A. Talks Stall and More Games Are Canceled', 'kicker': None, 'content_kicker': None, 'print_headline': 'N.B.A. Talks Stall, and More Games Are Canceled', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Lockouts', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Basketball Assn', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stern, David', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-28T22:17:38+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Howard Beck', 'person': [{'firstname': 'Howard', 'middlename': None, 'lastname': 'Beck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e78adab0-c344-5178-9b6f-151c151ace73', 'word_count': 825, 'uri': 'nyt://article/e78adab0-c344-5178-9b6f-151c151ace73'}, {'abstract': 'A new exhibition, “The Dead Sea Scrolls: Life and Faith in Biblical Times,” stresses what preceded the Qumran writings over what followed.', 'web_url': 'https://www.nytimes.com/2011/10/29/arts/design/the-dead-sea-scrolls-at-discovery-times-square-review.html', 'snippet': 'A new exhibition, “The Dead Sea Scrolls: Life and Faith in Biblical Times,” stresses what preceded the Qumran writings over what followed.', 'lead_paragraph': 'Don’t expect to see the glittering marvels of King Tut’s tomb. Few artifacts at the provocative new exhibition at Discovery Times Square —“The Dead Sea Scrolls: Life and Faith in Biblical Times” — will inspire aesthetic wonder. Pottery, silver coins, iron arrowheads, limestone pitchers, scraps of parchment — such are the seemingly mundane yields of many archaeological excavations, and they are prevalent here as well.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/29/arts/29SCROLLS/29SCROLLS-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/29/arts/29SCROLLS/29SCROLLS-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/29/arts/29SCROLLS/29SCROLLS-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/29/arts/29SCROLLS/29SCROLLS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/29/arts/29SCROLLS/29SCROLLS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Scrolls as a Start, Not an End', 'kicker': 'Exhibition Review', 'content_kicker': None, 'print_headline': 'The Scrolls As a Start, Not an End', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Discovery Times Square Exposition', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dead Sea Scrolls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHAEOLOGY', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-28T22:17:43+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Edward Rothstein', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Rothstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d8bae68b-3c67-534a-bf5e-37d349bb4b26', 'word_count': 1329, 'uri': 'nyt://article/d8bae68b-3c67-534a-bf5e-37d349bb4b26'}, {'abstract': 'The flavor of fresh Kaffir lime leaf is so particular and so citrusy and floral, there’s really no substitute.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/10/28/kaffir-lime-and-other-citrus-pleasures/', 'snippet': 'The flavor of fresh Kaffir lime leaf is so particular and so citrusy and floral, there’s really no substitute.', 'lead_paragraph': 'What would we do without citrus fruits? Our cooking would be dull without them. But unless we live in temperate climates, for the most part we depend on their availability to be shipped from citrus-growing zones. So much for locavore leanings: sometimes we just need stuff from elsewhere. We need to be able to add a big squeeze of lime, or the grated zest of lemon or orange, to so many dishes, sweet or savory.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kaffir Lime and Other Citrus Pleasures', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Limes', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-28T22:18:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/199bd0b8-a4aa-52bc-8751-0242341910c6', 'word_count': 223, 'uri': 'nyt://article/199bd0b8-a4aa-52bc-8751-0242341910c6'}, {'abstract': 'All the fashion news of the week that’s fit to reprint.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/10/28/chic-in-review-thumbs-up-for-the-biebers-up-do/', 'snippet': 'All the fashion news of the week that’s fit to reprint.', 'lead_paragraph': 'All the fashion news of the week that’s fit to reprint.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chic in Review | Thumbs Up for the Bieber’s Up Do', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-28T22:19:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Kathryn Branch', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Branch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d53b4fcd-27a2-53cb-b01d-f79924414d71', 'word_count': 464, 'uri': 'nyt://article/d53b4fcd-27a2-53cb-b01d-f79924414d71'}, {'abstract': 'My former husband and I have concentrated not on our rancor but on our children.', 'web_url': 'https://www.nytimes.com/2011/10/30/fashion/the-good-divorce-cultural-studies.html', 'snippet': 'My former husband and I have concentrated not on our rancor but on our children.', 'lead_paragraph': 'I NEVER wanted to get divorced. My parents’ split had been like an antipersonnel bomb, ripping everyone to pieces. So for 16 years, I stayed married.', 'print_section': 'ST', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/fashion/30CULTURAL_SPAN/30CULTURAL-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/30/fashion/30CULTURAL_SPAN/30CULTURAL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/fashion/30CULTURAL_SPAN/30CULTURAL-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/30/fashion/30CULTURAL_SPAN/30CULTURAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/30/fashion/30CULTURAL_SPAN/30CULTURAL-thumbStand