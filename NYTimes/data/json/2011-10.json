: None, 'type': 'image', 'url': 'images/2011/10/15/us/15denver_span/15denver_span-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/15/us/15denver_span/15denver_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/us/15denver_span/15denver_span-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/us/15denver_span/15denver_span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/15/us/15denver_span/15denver_span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Police Clear Camp of Offshoot Demonstrators in Denver', 'kicker': None, 'content_kicker': None, 'print_headline': 'Police Clear Camp of Offshoot Demonstrators in Denver', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Denver (Colo)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Colorado', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Occupy Wall Street', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-10-14T16:46:47+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Dan Frosch and Kirk Johnson', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Frosch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Kirk', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8397c39d-5694-5ea2-8d47-a99f530a83c2', 'word_count': 472, 'uri': 'nyt://article/8397c39d-5694-5ea2-8d47-a99f530a83c2'}, {'abstract': 'For World Food Day, learning about global hunger in a lesson developed with the United Nations World Food Programme.', 'web_url': 'https://learning.blogs.nytimes.com/2011/10/14/world-food-day-addressing-hunger-around-the-globe/', 'snippet': 'For World Food Day, learning about global hunger in a lesson developed with the United Nations World Food Programme.', 'lead_paragraph': 'World Food Day falls on Oct. 16 (Sunday) this year. It is a worldwide event intended to increase awareness, understanding and informed year-round action to fight hunger around the world.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'World Food Day: Addressing Hunger Around the Globe', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Food', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food Aid', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T16:50:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Holly Epstein Ojalvo', 'person': [{'firstname': 'Holly', 'middlename': 'Epstein', 'lastname': 'Ojalvo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/461d2dd5-abde-5c93-967e-000e9eef89be', 'word_count': 1518, 'uri': 'nyt://article/461d2dd5-abde-5c93-967e-000e9eef89be'}, {'abstract': 'The public editor questions the merits of whether publishing anonymous online comments from readers is acceptable in print.', 'web_url': 'https://publiceditor.blogs.nytimes.com/2011/10/14/real-names-please-for-sunday-magazine-reply-all-feature/', 'snippet': 'The public editor questions the merits of whether publishing anonymous online comments from readers is acceptable in print.', 'lead_paragraph': 'Under its new editor, Hugo Lindgren, The New York Times Sunday Magazine underwent a nicely-executed redesign last spring. One change, though, troubles me.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Real Names, Please, for Sunday Magazine Reply All Feature', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-14T16:51:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Arthur S. Brisbane', 'person': [{'firstname': 'Arthur', 'middlename': 'S.', 'lastname': 'Brisbane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da7a37e5-8355-5082-a8a0-0e72f430aef4', 'word_count': 731, 'uri': 'nyt://article/da7a37e5-8355-5082-a8a0-0e72f430aef4'}, {'abstract': 'Russell Banks based his new novel, “Lost Memory of Skin,” on a group of homeless sex offenders who sought refuge under a highway in Florida.', 'web_url': 'https://www.nytimes.com/2011/10/15/books/russell-banks-talks-about-lost-memory-of-skin.html', 'snippet': 'Russell Banks based his new novel, “Lost Memory of Skin,” on a group of homeless sex offenders who sought refuge under a highway in Florida.', 'lead_paragraph': 'MIAMI BEACH — Russell Banks, whose new novel, “Lost Memory of Skin,” is set here, first came to Florida in 1958. He was 18, had just dropped out of Colgate and was hoping to join Fidel Castro and his rebels in Cuba. He never made it off the mainland, Mr. Banks recalled recently, but just being in Florida felt revolutionary. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/JPBANKS/JPBANKS-articleLarge.jpg', 'height': 387, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/10/15/arts/JPBANKS/JPBANKS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 387}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/JPBANKS/JPBANKS-jumbo.jpg', 'height': 658, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/15/arts/JPBANKS/JPBANKS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/15/arts/JPBANKS/JPBANKS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Novelist Bypasses the Middle to Seek Out the Margins', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Novelist Bypasses the Middle to Seek Out the Margins', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Banks, Russell', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-10-14T16:59:14+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ecccdcaf-694f-5c7f-a26e-8b0532c42f60', 'word_count': 1167, 'uri': 'nyt://article/ecccdcaf-694f-5c7f-a26e-8b0532c42f60'}, {'abstract': 'A shoe with a hidden G.P.S. device may help caregivers find wandering family members.', 'web_url': 'https://newoldage.blogs.nytimes.com/2011/10/14/a-shoe-for-wanderers/', 'snippet': 'A shoe with a hidden G.P.S. device may help caregivers find wandering family members.', 'lead_paragraph': 'I hear from lots of publicists touting technology products that supposedly help older adults, and I ignore most of the gizmos they’re promoting. Without a skilled and unbiased Consumer Reports-type lab to test these inventions — and could someone please create one soon? — it’s too hard to tell which actually work well.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Shoe for Wanderers', 'kicker': 'The New Old Age', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Alzheimer's Disease", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dementia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elder Care', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-10-14T16:59:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Paula Span', 'person': [{'firstname': 'Paula', 'middlename': None, 'lastname': 'Span', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dac08bf4-48d7-56cd-9f97-40a0c6e05921', 'word_count': 599, 'uri': 'nyt://article/dac08bf4-48d7-56cd-9f97-40a0c6e05921'}, {'abstract': 'This week’s hearty one-dish vegetarian meals are meant to appeal to families that include a mix of meat-eaters and vegetarians.', 'web_url': 'https://well.blogs.nytimes.com/2011/10/14/hearty-one-dish-vegetarian-meals/', 'snippet': 'This week’s hearty one-dish vegetarian meals are meant to appeal to families that include a mix of meat-eaters and vegetarians.', 'lead_paragraph': 'One-pot meals are easy to make, save on cleanup time and, most important, can taste delicious as the flavors of the various ingredients blend together. This week, Martha Rose Shulman offers five new vegetarian versions of the one-pot meal. She writes:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hearty One-Dish Vegetarian Meals', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetarianism', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-10-14T17:00:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Tara Parker-Pope', 'person': [{'firstname': 'Tara', 'middlename': None, 'lastname': 'Parker-Pope', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be809b97-da7a-5478-9bb0-6b458d203396', 'word_count': 296, 'uri': 'nyt://article/be809b97-da7a-5478-9bb0-6b458d203396'}, {'abstract': 'It is unknown whether the disease is widespread or a blip, researchers say.', 'web_url': 'https://green.blogs.nytimes.com/2011/10/14/on-our-radar-seals-hit-by-baffling-illness/', 'snippet': 'It is unknown whether the disease is widespread or a blip, researchers say.', 'lead_paragraph': 'A mysterious disease is sickening and killing scores of ringed seals along Alaska’s north coast. Since late July, about 100 of the animals, which serve as prey for polar bears, have been found with lesions on their flippers and in their mouths; nearly half have died. [Associated Press]', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Our Radar: Seals Hit by Baffling Illness', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-10-14T17:11:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/744e90b1-e66e-5422-91d6-634be1ac73f1', 'word_count': 219, 'uri': 'nyt://article/744e90b1-e66e-5422-91d6-634be1ac73f1'}, {'abstract': 'The Republican candidate’s energy plan relies on tapping domestic resources to feed the nation’s energy needs and help the economy.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/10/14/perry-urges-aggressive-energy-production-policy/', 'snippet': 'The Republican candidate’s energy plan relies on tapping domestic resources to feed the nation’s energy needs and help the economy.', 'lead_paragraph': '2:17 p.m. | Updated WEST MIFFLIN, Pa. — Gov. Rick Perry of Texas released a long-promised jobs and energy proposal that resembled a wishlist for the oil and gas industry, promising drilling across much of the country, including in Alaska’s wilderness, and a curtailing of environmental regulations that includes a “dismantling” of the Environmental Protection Agency in its current form.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Perry Urges Aggressive Energy Production Policy', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drilling and Boring', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hydraulic Fracturing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Natural Gas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Offshore Drilling and Exploration', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 7, 'major': 'N'}, {'name': 'subje