': 'N'}], 'pub_date': '2011-10-05T20:56:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Erik Eckholm', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Eckholm', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/56003065-7275-5397-b857-6170f160bfbc', 'word_count': 383, 'uri': 'nyt://article/56003065-7275-5397-b857-6170f160bfbc'}, {'abstract': 'The first lady, Michelle Obama, and the model Iman will be honorary chairs of the opening night gala performance of Alvin Ailey American Dance Theater at City Center on Nov. 30.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/10/05/first-lady-michelle-obama-iman-and-john-legend-to-kick-off-ailey-season/', 'snippet': 'The first lady, Michelle Obama, and the model Iman will be honorary chairs of the opening night gala performance of Alvin Ailey American Dance Theater at City Center on Nov. 30.', 'lead_paragraph': 'The first lady, Michelle Obama, and the model Iman will be honorary chairwomen of the opening night gala performance of Alvin Ailey American Dance Theater at City Center on Nov. 30, the company said. The Ailey company also said that John Legend, the musician who has won nine Grammy Awards, will perform “If It’s Magic,” with choreography by the company’s former artistic director, Judith Jamison. This season will be the first under her successor, Robert Battle.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Michelle Obama, Iman and John Legend to Kick Off Ailey Season', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Battle, Robert', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Legend, John', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Michelle'