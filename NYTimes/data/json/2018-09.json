_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/arts/12JUDSON-CURATORS1/merlin_143532150_92badc97-10ac-4f53-be12-9cc1212bdf26-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/12/arts/12JUDSON-CURATORS1/merlin_143532150_92badc97-10ac-4f53-be12-9cc1212bdf26-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/arts/12JUDSON-CURATORS1/merlin_143532150_92badc97-10ac-4f53-be12-9cc1212bdf26-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/arts/12JUDSON-CURATORS1/merlin_143532150_92badc97-10ac-4f53-be12-9cc1212bdf26-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/arts/12JUDSON-CURATORS1/12JUDSON-CURATORS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/12/arts/12JUDSON-CURATORS1/12JUDSON-CURATORS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/arts/12JUDSON-CURATORS1/12JUDSON-CURATORS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At MoMA, How Judson Blew Up the Rules of Dance', 'kicker': None, 'content_kicker': None, 'print_headline': 'How Judson Blew Up the Rules of Movement', 'name': None, 'seo': None, 'sub'