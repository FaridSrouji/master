'}, {'name': 'organizations', 'value': 'Senate Committee on the Judiciary', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cruz, Ted', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Ford, Christine Blasey', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Kavanaugh, Brett M', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-09-25T10:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Gail Collins and Bret Stephens', 'person': [{'firstname': 'Gail', 'middlename': None, 'lastname': 'Collins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Bret', 'middlename': None, 'lastname': 'Stephens', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/40722e9f-9159-5bb8-b8cf-fccded726c33', 'word_count': 1673, 'uri': 'nyt://article/40722e9f-9159-5bb8-b8cf-fccded726c33'}, {'abstract': 'Mr. Ogrodnek, who took a break after closing Dover last year, will return with a cafe in the new Sister City hotel.', 'web_url': 'https://www.nytimes.com/2018/09/25/dining/joseph-ogrodnek-sister-city-hotel-floret.html', 'snippet': 'Mr. Ogrodnek, who took a break after closing Dover last year, will return with a cafe in the new Sister City hotel.', 'lead_paragraph': 'In 2010, Joseph Ogrodnek turned a sleepy Greenpoint restaurant, Anella, into one of Brooklyn’s most talked-about spots — a destination for tightly focused, vegetable-driven cooking. A year later, he and his business partner, Walker Stern, opened Battersby in Carroll Gardens, followed by Dover in 2013; both restaurants helped foster the kale-laden, Provençal-esque cuisine that still suffuses the neighborhood.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subt