sm', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chabad-Lubavitch', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Crown Heights (Brooklyn, NY)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Schneerson, Menachem Mendel', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-09-19T21:08:43+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Sarah Maslin Nir and Sharon Pulwer', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sharon', 'middlename': None, 'lastname': 'Pulwer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29dfcdd0-b8ac-52e2-8939-8d6ebae765b3', 'word_count': 777, 'uri': 'nyt://article/29dfcdd0-b8ac-52e2-8939-8d6ebae765b3'}, {'abstract': "The “Breaking Bad” and “Dear White People” actor reads an essay about a dying man’s final wish and a judge's compassionate decision.", 'web_url': 'https://www.nytimes.com/2018/09/19/style/modern-love-podcast-giancarlo-esposito.html', 'snippet': "The “Breaking Bad” and “Dear White People” actor reads an essay about a dying man’s final wish and a judge's compassionate decision.", 'lead_paragraph': 'Exhausted after an arduous trial, Lloyd Zimmerman was in no mood to fulfill special requests. In fact, the Minnesota judge just wanted to be left alone. But an unexpected call brought out his compassion. On this week’s Modern Love podcast, Giancarlo Esposito reads Mr. Zimmerman’s moving essay, “Making a Judgment on Love.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/23/fashion/23LOVE/23LOVE-articleLarge-v2.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLa