nsider/28ads-1/28ads-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Your Beliefs Here: A Look at Advocacy Advertising in The Times', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Familiar Statement, 27 Years Later', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Times', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate Committee on the Judiciary', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hill, Anita', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ford, Christine Blasey', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-09-28T00:15:38+0000', 'document_type': 'article', 'news_desk': 'Insider', 'section_name': 'Times Insider', 'byline': {'original': 'By Alexandria Symonds and Katie Van Syckle', 'person': [{'firstname': 'Alexandria', 'middlename': None, 'lastname': 'Symonds', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Katie', 'middlename': 'Van', 'lastname': 'Syckle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04a8b8f3-1dd0-5735-b3e1-272037842f6f', 'word_count': 979, 'uri': 'nyt://article/04a8b8f3-1dd0-5735-b3e1-272037842f6f'}, {'abstract': 'Her testimony was heroic. Will it be pointless?', 'web_url': 'https://www.nytimes.com/2018/09/27/opinion/blasey-ford-kavanaugh-hearing.html', 'snippet': 'Her testimony was heroic. Will it be pointless?', 'lead_paragraph': 'On Thursday, Christine Blasey Ford testified to the Senate Judiciary Committee, and the world, that Supreme Court nominee Brett Kavanaugh sexually assaulted her when they were both teenagers. Her soft voice cracked as she spoke. She smiled a lot; her attempts to make everyone see how agreeable and reasonable she is were heart-rending. But she was a