 4, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-09-22T18:30:08+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/36972664-3b02-538c-a941-186594d15b3a', 'word_count': 869, 'uri': 'nyt://article/36972664-3b02-538c-a941-186594d15b3a'}, {'abstract': 'In the Brazil of my childhood, we battled hyperinflation to buy ice cream.', 'web_url': 'https://www.nytimes.com/2018/09/22/opinion/sunday/brazil-venezuela-hyperinflation-economics.html', 'snippet': 'In the Brazil of my childhood, we battled hyperinflation to buy ice cream.', 'lead_paragraph': 'At age 10 in 1980s Brazil, my job was to run around the aisles of the supermarket trying to beat adults, who walked around raising prices throughout the day with comically large label guns. Since I was good at math, my mother would hand me our monthly grocery budget, and I would run through the supermarket filling our shopping cart — not having to stop to input values on a calculator saved us precious time against the labelers.', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/15/opinion/15zeidan/merlin_143676702_3a9a5660-9f21-43bd-a6e7-ba83e037b799-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/15/opinion/15zeidan/merlin_143676702_3a9a5660-9f21-43bd-a6e7-ba83e037b799-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'imag