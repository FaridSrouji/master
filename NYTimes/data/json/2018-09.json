d-7b13-4e7b-81c6-fe56aaaa3ab2-jumbo.jpg', 'height': 695, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/29/arts/29popcast/merlin_144159417_09c7bf4d-7b13-4e7b-81c6-fe56aaaa3ab2-superJumbo.jpg', 'height': 1389, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/29/arts/29popcast/29popcast-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/29/arts/29popcast/29popcast-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/29/arts/29popcast/29popcast-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Should They Stay or Should They Go? Pop Stars and Retirement', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Folk Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McCartney, Paul', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Simon, Paul', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Baez, Joan', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Egypt Station (Album)', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-09-28T16:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7a1295e-6950-53b5-b707-49d346bc71d6', 'word_count': 150, 'uri': 'nyt://article/c7a1295e-6950-53b5-b707-49d346bc71d6'}, {'abstract': 'The third entry in the IQ crime series, “Wrecked,” comes out this month.', 'web_url': 'https://www.nytimes.com/2018/09/28/books/joe-ide-iq-crime-los-angeles-wrecked.html', 'snippet': 'The third entry in the IQ crime series, “Wrecked,” comes out this month.', 'lead_paragraph': 'LOS ANGELES — The crime writer Joe Ide sat in a car at the corner of San Pedro and Adams in South Central Los Angeles and memories of his boyhood returned — mostly in the form of characters. “The winos used to sit out there on orange crates and drink Thunderbird all day,” he said, pointing at the graffiti streaked storefront of what is now a pupuseria. There was one “wino,” tall, immaculate and dapper in a homburg hat “with a little feather in it,” who used to escort Mr. Ide’s mother onto the bus everyday, like a butler.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/29/books/29joeidejp/merlin_143890074_e372126d-a245-4f20-8e36-1d0813fadd7e-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/29/books/29joeidejp/merlin_143890074_e372126d-a245-4f20-8e36-1d0813fadd7e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/29/books/29joeidejp/merlin_143890074_e372126d-a245-4f20-8e36-1d0813fadd7e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/29/books/29joeidejp/merlin_143890074_e372126d-a245-4f20-8e36-1d0813fadd7e-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', '