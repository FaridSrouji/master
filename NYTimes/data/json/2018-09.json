2018/09/13/opinion/13kupchan1/merlin_143449476_c10c508e-c880-40a8-a617-dd6be46f5e94-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/13/opinion/13kupchan1/merlin_143449476_c10c508e-c880-40a8-a617-dd6be46f5e94-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13kupchan1/merlin_143449476_c10c508e-c880-40a8-a617-dd6be46f5e94-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13kupchan1/merlin_143449476_c10c508e-c880-40a8-a617-dd6be46f5e94-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13kupchan1/13kupchan1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/13/opinion/13kupchan1/13kupchan1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13kupchan1/13kupchan1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Offensive Plan for the Balkans That the U.S. Should Get Behind', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Secession and Independence Movements', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'North Atlantic Treaty Organization', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Vucic, Aleksandar', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Thaci, Hashim', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Kosovo', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Serbia', 'rank': 8, 'major': 'N'}], 'pub_date': '2018-09-13T15:00:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Charles A. Kupchan', 'person': [{'firstname': 'Charles', 'middlename': 'A.', 'lastname': 'Kupchan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1455ece3-7f41-5abd-9ea2-64acf0e64a77', 'word_count': 1063, 'uri': 'nyt://article/1455ece3-7f41-5abd-9ea2-64acf0e64a77'}, {'abstract': 'Claire Olshan of Fivestory wants to break all the wellness rules.', 'web_url': 'https://www.nytimes.com/2018/09/13/t-magazine/dada-daily-snacks-claire-olshan-fivestory.html', 'snippet': 'Claire Olshan of Fivestory wants to break all the wellness rules.', 'lead_paragraph': 'Claire Olshan was a bona fide health nut by the time she hit the bar mitzvah circuit in New York City. As a preteen, she sprinkled protein powder on her Häagen-Dazs ice cream and she asked her mother to wrap her tuna fish sandwiches in seaweed instead of white bread. “My mom was like, ‘Okaaaay. Where did you come from?’ ” recalls Olshan. Now 31, her clean-living practices have stuck with her. As the founder of Fivestory — an uptown fashion boutique in a five-story townhouse known for its shoe “garden” and roster of rising designers — she installed a temporary wellness space on the fourth floor last year, filling it with offerings like vitamin-C skin boosters and raw-coconut-oil face highlighters. Her interest manifests not only in the merchandise. If a client should need an energy healer, breathing coach or Transcendental Meditation guru, Olshan has numbers for all three in her phone. Rather than gifting her V.I.P.s with baubles during the holidays, Olshan sends Sakara Life organic meal delivery plans. “I’m going to make you look gorgeous but feel good, too,” she says of her holistic intention.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/t-magazine/food/oakImage-1536789597416/oakImage-1536789597416-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/12/t-magazine/food/oakImage-1536789597416/oakImage-1536789597416-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/t-magazine/food/oakImage-1536789597416/oakImage-1536789597416-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/t-magazine/food/oakImage-1536789597416/oakImage-1536789597416-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/t-magazine/food/oakImage-1536789597416/oakImage-1536789597416-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/12/t-magazine/food/oakImage-1536789597416/oakImage-1536789597416-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'i