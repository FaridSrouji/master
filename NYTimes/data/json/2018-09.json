jor': 'N'}, {'name': 'subject', 'value': 'Insurance', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Coastal Areas', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Oceanic and Atmospheric Administration', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Southeastern States (US)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 10, 'major': 'N'}], 'pub_date': '2018-09-12T20:08:15+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Edward B. Rust Jr', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/68157506-a040-568a-86ee-bbf8c1d77318', 'word_count': 591, 'uri': 'nyt://article/68157506-a040-568a-86ee-bbf8c1d77318'}, {'abstract': 'Why the slump went on so much longer than it should have.', 'web_url': 'https://www.nytimes.com/2018/09/12/opinion/botching-the-great-recession.html', 'snippet': 'Why the slump went on so much longer than it should have.', 'lead_paragraph': 'It has been ten years since the failure of Lehman sent the global financial system into freefall. Why is this date different from any other date? No particular reason. But round-number anniversaries do have the virtue of giving people a reason to look back at experience, and maybe even learn from it.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13krugmanWeb/merlin_32596366_2abbc566-7ade-4f2a-aff3-1839786535e0-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/