imes', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13purtoricoWeb/merlin_139011774_74aea883-6ae1-4443-8971-a23d3a8a7d30-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/13/opinion/13purtoricoWeb/merlin_139011774_74aea883-6ae1-4443-8971-a23d3a8a7d30-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13purtoricoWeb/merlin_139011774_74aea883-6ae1-4443-8971-a23d3a8a7d30-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13purtoricoWeb/merlin_139011774_74aea883-6ae1-4443-8971-a23d3a8a7d30-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13purtoricoWeb/13purtoricoWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/13/opinion/13purtoricoWeb/13purtoricoWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/13/opinion/13purtoricoWeb/13purtoricoWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trump Honors Only One Victim in Puerto Rico: Himself', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Mr. Trump, He’s the Victim in Puerto Rico', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'val