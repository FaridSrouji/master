rop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: A One-Man Funeral With Many Lives in ‘I Hear You and Rejoice’', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Storyteller Magnifies Lives Into Legends', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Irish Arts Center', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': "The Man in the Woman's Shoes (Play)", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Murfi, Mikel', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'I Hear You and Rejoice (Play)', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-09-17T23:10:47+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/84a7217e-202e-5e49-b0ea-40508aa27e25', 'word_count': 606, 'uri': 'nyt://article/84a7217e-202e-5e49-b0ea-40508aa27e25'}, {'abstract': '“These things just take a lot longer than you think they would,” one executive said of the sale of Time magazine. Now Meredith must turn to the sales of Fortune and Sports Illustrated.', 'web_url': 'https://www.nytimes.com/2018/09/17/business/media/time-sale-fortune-sports-illustrated.html', 'snippet': '“These things just take a lot longer than you think they would,” one executive said of the sale of Time magazine. Now Meredith must turn to the sales of Fortune and Sports Illustrated.', 'lead_paragraph': 'When Time magazine started in 1923, it hit upon a popular formula: short, punchy items that aggregated the week’s events and came in an entertaining package. But the newsweekly could never compete with the digital version of its own blueprint: the internet’s bloggers, explainers, listicles and 30-second videos.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/18/business/18TIMEINC-top/merlin_143888925_ad3d1243-cdc4-4f2c-bcdd-25eef8a325a9-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/18/business/18TIMEINC-top/merlin_143888925_ad3d1243-cdc4-4f2c-bcdd-25eef8a325a9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/18/business/18TIMEINC-top/merlin_143888925_ad3d1243-cdc4-4f2c-bcdd-25eef8a325a9-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/18/business/18TIMEINC-top/merlin_143888925_ad3d1243-cdc4-4f2c-bcdd-25eef8a325a9-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/18/business/18TIMEINC-top/18TIMEINC-top-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/18/business/18TIMEINC-top/18TIMEINC-top-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/18/business/18TIMEINC-top/18TIMEINC-top-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Fetching a High Price, Time Magazine Moves Into a New Era', 'kicker': None, 'content_kicker': None, 'pr