_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Bari Weiss', 'person': [{'firstname': 'Bari', 'middlename': None, 'lastname': 'Weiss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/273e7b54-145d-5158-a106-41449493beea', 'word_count': 1307, 'uri': 'nyt://article/273e7b54-145d-5158-a106-41449493beea'}, {'abstract': 'This is a story about an African nation’s fatal disregard of its minority population. It is also a story about the muddled sludge of colonial history.', 'web_url': 'https://www.nytimes.com/2018/09/15/opinion/sunday/chimamanda-ngozi-adichie-cameroon.html', 'snippet': 'This is a story about an African nation’s fatal disregard of its minority population. It is also a story about the muddled sludge of colonial history.', 'lead_paragraph': 'When our friend Theo first met his Chinese wife, Libby, in Shandong Province, her parents, protective of their only daughter and wary of Africans, finally gave their blessing with the words, “at least he’s not a bad looking black.” Theo tells this story with wry amusement, as though he would parse it more if he were not already so burdened. He is a pleasant and gentle man, respectful, trustworthy, the kind of man who in West Africa would be said to have had “good home training.” But for the past year, a dark sighing heaviness has blanketed him. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/sunday-review/16adichie-sub/16adichie-sub-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/16/sunday-review/16adichie-sub/16adichie-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/sunday-review/16adichie-sub/16adichie-sub-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/sunday-review/16adichie-sub/16adichie-sub-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/sunday-review/16adichie-sub/16adichie-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/16/sunday-review/16adichie-sub/16adichie-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/sunday-review/16adichie-sub/16adichie-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chimamanda Ngozi Adichie: The Carnage of the Cameroons ', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Carnage of the Cameroons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Cameroon', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-09-15T18:30:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Chimamanda Ngozi Adichie', 'person': [{'firstname': 'Chimamanda', 'middlenam