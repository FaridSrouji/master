ajor': 'N'}, {'name': 'creative_works', 'value': 'Gloria: A Life (Play)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Steinem, Gloria', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lahti, Christine', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mann, Emily', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Paulus, Diane', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-09-13T14:00:06+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Theater', 'byline': {'original': 'By Laura Collins-Hughes', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Collins-Hughes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fc722699-8a2b-5332-89d6-968bf37ede73', 'word_count': 1779, 'uri': 'nyt://article/fc722699-8a2b-5332-89d6-968bf37ede73'}, {'abstract': 'When she’s not throwing molten wax on chandeliers, the sculptor and photographer Petah Coyne is readying the story of the Guerrilla Girls.', 'web_url': 'https://www.nytimes.com/2018/09/13/arts/design/petah-coyne-guerrilla-girls.html', 'snippet': 'When she’s not throwing molten wax on chandeliers, the sculptor and photographer Petah Coyne is readying the story of the Guerrilla Girls.', 'lead_paragraph': 'WEST NEW YORK, N.J. — Two shrouded female figures rise from a sumptuous landscape of dark velvet and wax-dipped silk flowers. One is imperious in posture, the other turns away in stubborn resistance. Their tense standoff seems to charge the roiling swells and eddies of material between them.', 'print_section': 'AR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/23/arts/23Petah3/23Petah3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/23/arts/23Petah3/23Petah3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/23/arts/23Petah3/23Petah3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/23/arts/23Petah3/23Petah3-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/23/arts/23Petah3/23Petah3-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/23/arts/23Petah3/23Petah3-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/23/arts/23Petah3/23Petah3-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Artist Who Champions and Channels Female Voices', 'kicker': 'Studio Visit', 'content_kicker': None, 'print_headline': 'The Pure Joy of Flinging Molten Wax', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sculpture', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Coyne, Petah', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Grove, Kathy (1948- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Galerie Lelong', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Guerrilla Girls', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-09-13T14:00:07+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Hilarie M. Sheets', 'person': [{'firstname': 'Hilarie', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5a1dcab2-1b9a-5dad-859f-f3693a11e459', 'word_count': 1537, 'uri': 'nyt://article/5a1dcab2-1b9a-5dad-859f-f3693a11e459'}, {'abstract': 'In five of nine races in a first wave of surveys, the result is within one percentage point. ', 'web_url': 'https://www.nytimes.com/2018/09/13/upshot/house-polls-show-very-close-races-but-also-hints-of-democratic-strength.html', 'snippet': 'In five of nine races in a first wave of surveys, the result is within one percentage point. ', 'lead_paragraph': 'With just under two months until the midterms, the races that seem likely to decide control of Congress remain strikingly close, according to a first wave of New York Times Upshot/Siena College polls.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/upshot/up-pollsdem/merlin_142515432_dc1559fe-2e57-4a9e-a28c-6807fe794f39-articleLarge.jpg', 'height': 474, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/12/upshot/up-pollsdem/merlin_142515432_dc1559fe-2e57-4a9e-a28c-6807fe794f39-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 474}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/12/upshot/up-pollsdem/merlin_142515432_dc1559fe-2e57-4a9e-a28c-6807fe794f39-jumbo.jpg', 'height': 810, 'width': 1024, 'subType': 'jumb