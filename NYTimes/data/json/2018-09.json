ins', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New England Patriots', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Cleveland Browns', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Eagles', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-09-27T19:47:08+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Benjamin Hoffman', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Hoffman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d1ecbb3-bdff-5dfb-8679-28e1a4e9a634', 'word_count': 1947, 'uri': 'nyt://article/6d1ecbb3-bdff-5dfb-8679-28e1a4e9a634'}, {'abstract': 'A mother guides her daughter through a rite of passage in their small Colombian village — learning to swim.', 'web_url': 'https://www.nytimes.com/2018/09/27/learning/film-club-dulce.html', 'snippet': 'A mother guides her daughter through a rite of passage in their small Colombian village — learning to swim.', 'lead_paragraph': '“Dulce” is a 10-minute film that touches on themes of growing up and the interdependence of people and nature. It profiles Dulce, an 8-year-old girl, as her mother guides her through a rite of passage in her small Colombian village — learning to swim.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Film Club: ‘Dulce’', 'kicker': 'Film Club', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-09-27T19:50:56+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Natalie Proulx', 'person': [{'firstname': 'Natalie', 'middlename': None, 'lastname': 'Proulx', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_ma