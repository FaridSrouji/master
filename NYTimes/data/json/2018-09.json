ype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-FJAO/rodarte-48hours-slide-FJAO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-FJAO/rodarte-48hours-slide-FJAO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-FJAO/rodarte-48hours-slide-FJAO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '48 Hours With Rodarte', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-09-11T21:13:09+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/ab981312-e257-5ba7-be89-55235009ed21', 'word_count': 0, 'uri': 'nyt://slideshow/ab981312-e257-5ba7-be89-55235009ed21'}, {'abstract': 'The fashion designers Kate and Laura Mulleavy spent two days with T in the lead-up to one of the most anticipated shows of the season.', 'web_url': 'https://www.nytimes.com/2018/09/11/t-magazine/rodarte-new-york-fashion-week.html', 'snippet': 'The fashion designers Kate and Laura Mulleavy spent two days with T in the lead-up to one of the most anticipated shows of the season.', 'lead_paragraph': 'It was an oppressively sultry Wednesday afternoon, and New York City felt like a sauna. “We’ve had extremely hot days on the West Coast this summer, too, but I forgot how different it is here with the humidity,” said Laura Mulleavy, one half of the fashion label Rodarte. Earlier that week, she and her business partner and sister, Kate, had flown in from Los Angeles, where their label is based, to begin preparations for their first New York runway show in two years.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-A15U/rodarte-48hours-slide-A15U-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-A15U/rodarte-48hours-slide-A15U-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-A15U/rodarte-48hours-slide-A15U-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-A15U/rodarte-48hours-slide-A15U-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-A15U/rodarte-48hours-slide-A15U-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-A15U/rodarte-48hours-slide-A15U-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/11/t-magazine/fashion/rodarte-48hours-slide-A15U/rodarte-48hours-slide-A15U-thumbLarg