 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ad62c61-682a-5190-a4f4-19238e00541d', 'word_count': 884, 'uri': 'nyt://article/5ad62c61-682a-5190-a4f4-19238e00541d'}, {'abstract': 'The band, boygenius, is an all-female collaborative effort born out of a joint tour.', 'web_url': 'https://www.nytimes.com/2018/09/11/arts/music/boygenius-julien-baker-phoebe-bridgers-lucy-dacus.html', 'snippet': 'The band, boygenius, is an all-female collaborative effort born out of a joint tour.', 'lead_paragraph': 'For a young musician to crash, suddenly, into renown and adoration can be disorienting. Writing and performing songs may turn fraught with expectations. The road becomes home; communing with audiences of strangers stands in for human connection. It’s a dream — and also just plain weird.', 'print_section': 'AR', 'print_page': '107', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/arts/16boygenius1/merlin_142705716_ed6e79d6-06f3-4340-b0a8-edec99e163ea-articleLarge.jpg', 'height': 905, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/16/arts/16boygenius1/merlin_142705716_ed6e79d6-06f3-4340-b0a8-edec99e163ea-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 905}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/arts/16boygenius1/merlin_142705716_ed6e79d6-06f3-4340-b0a8-edec99e163ea-jumbo.jpg', 'height': 1024, 'width': 679, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/arts/16boygenius1/merlin_142705716_ed6e79d6-06f3-4340-b0a8-edec99e163ea-superJumbo.jpg', 'height': 2048, 'width': 1358, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption':