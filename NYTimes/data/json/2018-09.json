', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/opinion/16krugman-blog/merlin_143393451_3030076e-ef44-4aeb-95eb-08e60c3927ed-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/16/opinion/16krugman-blog/merlin_143393451_3030076e-ef44-4aeb-95eb-08e60c3927ed-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/opinion/16krugman-blog/merlin_143393451_3030076e-ef44-4aeb-95eb-08e60c3927ed-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/opinion/16krugman-blog/merlin_143393451_3030076e-ef44-4aeb-95eb-08e60c3927ed-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/opinion/16krugman-blog/merlin_143393451_3030076e-ef44-4aeb-95eb-08e60c3927ed-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/16/opinion/16krugman-blog/merlin_143393451_3030076e-ef44-4aeb-95eb-08e60c3927ed-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/opinion/16krugman-blog/merlin_143393451_3030076e-ef44-4aeb-95eb-08e60c3927ed-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Do We Actually Know About the Economy? (Wonkish)', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'n