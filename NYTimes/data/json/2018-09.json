9/03/nyregion/00school6-promo/00school6-promo-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘It’s Like, Who’s Next?’: A Troubled School’s Alarming Death Rate', 'kicker': None, 'content_kicker': None, 'print_headline': 'One School, Dozens of Alumni Dead Before 40', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Family Foundation School (Hancock, NY)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'School Discipline (Students)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Alcohol Abuse', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Hancock (NY)', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Ianelli, Elizabeth', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Martin-Crawford, Jon', 'rank': 11, 'major': 'N'}], 'pub_date': '2018-09-02T14:35:02+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael Wilson', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2326beb4-a111-5bb3-84a4-c753be902941', 'word_count': 2884, 'uri': 'nyt://article/2326beb4-a111-5bb3-84a4-c753be902941'}, {'abstract': 'In “Pale Horse Rider,” Mark Jacobson tells the story of Milton William Cooper and a distinctly American brand of fevered conjecture.', 'web_url': 'https://www.nytimes.com/2018/09/02/books/pale-horse-rider-william-cooper-mark-jacobson-interview.html', 'snippet': 'In “Pale Horse Rider,” Mark Jacobson tells the story of Milton William Cooper and a distinctly American brand of fevered conjecture.', 'lead_paragraph': 'To Milton William Cooper, the truth was out there. Way out there. Not in an “X-Files” way — in fact, after dabbling in extraterrestrial theories, Cooper eventually thought U.F.O.s were “possibly the single greatest hoax in history,” just another threat fabricated to keep a docile public in thrall to an increasingly one-world government. Cooper was in the earthly conspiracy business. He was killed in a shootout with police shortly after the events of Sept. 11, 2001, which many say he prophesied. His book “Behold a Pale Horse” has been wildly popular among conspiracy theorists since its publication in 1991. In “Pale Horse Rider,” Mark Jacobson tells the story of Cooper’s life, and explores the roots and consequences of his distinctly American brand of fevered conjecture. Below, Mr. Jacobson discusses Cooper’s appeal to prisoners, the current crisis of faith in America and more.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/03/books/03skybox-right/03jacobson1-articleLarge.jpg', 'height': 833, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/03/books/03skybox-right/03jacobson1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 833}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/03/books/03skybox-right/03jacobson1-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/03/books/03skybox-right/03jacobson1-superJumbo.jpg', 'height': 1830, 'width': 1318, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/03/books/03skybox-right/03jacobson1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/03/books/03skybox-right/03jacobson1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/03/books/03skybox-right/03jacobson1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tell Us 5 Things About Your Book: A Godfather of Conspiracy Thinking', 'kicker': 'Q. & A.', 'content_kicker': None, 'print_headline': 'Inside the Mind of the Prince of Paranoia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jacobson, Mark (Author)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, Milton William', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Pale Horse Rider: William Cooper, the Rise of Conspiracy, and the Fall of Trust in America (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-09-02T15:00:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/84009e0b-6080-575b-80d6-d244ca223c37', 'word_count': 1024, 'uri': 'nyt://article/84009e0b-6080-575b-80d6-d244ca223c37'}, {'abstract': 'It was not immediately clear what caused the singer to lose his voice but a doctor said a likely explanation was laryngitis, which could be treated in a few days.', 'web_url': 'https://www.nytimes.com/2018/09/02/arts/u2-bono-loses-voice.html', 'snippet': 'It was not immediately clear what caused the singer to lose his voice but a doctor said a likely explanation was laryngitis, which could be treated in a few days.', 'lead_paragraph': 'The band U2 ended a concert in Berlin on Saturday partway through its performance after its lead singer, Bono, said he had lost his voice.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/02/arts/03xp-bono/03xp-bono-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/02/arts/03xp-bono/03xp-bono-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/02/arts/03xp-bono/03xp-bono-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/02/arts/03xp-bono/03xp-bono-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/02/arts/03xp-bono/03xp-bono-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/02/arts/03xp-bono/03xp-bono-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/02/arts/03xp-bono/03xp-bono-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bono Suffers a ‘Complete Loss of Voice,’ Prompting U2 to End Concert', 'kicker': None, 'content_kicker': None, 'print_headline': 'U2 Concert Ends When Bono Loses Voice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pop and Rock Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'U2 (Music Group)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bono', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Voice and Speech', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-09-02T15:20:57+0000', 'document_type': 'article', 'news_desk': 'Express', 'section_name': 'Arts', 'byline': {'original': 'By Mihir Zaveri', 'person': [{'firstname': 'Mihir', 'middlename': None, 'lastname': 'Zaveri', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/22c5bb3c-4437-5e16-9a62-265471bf6cab', 'word_count': 435, 'uri': 'nyt://article/22c5bb3c-4437-5e16-9a62-265471bf6cab'}, {'abstract': 'Maria Butina surrounded herself with prominent American conservatives and dubious characters bent on making a fast buck. It was not always easy to tell one from the other.', 'web_url': 'https://www.nytimes.com/2018/09/02/us/politics/maria-butina-russian-spy.html', 'snippet': 'Maria Butina surrounded herself with prominent American conservatives and dubious characters bent on making a fast buck. It was not always easy to tell one from the other.', 'lead_paragraph': 'WASHINGTON — For the young Russian gun rights activist studying in the United States, it would have been an unimaginably rich payday: $1 million to help broker the sale of Russian jet fuel to an American middleman. All she had to do was secure the fuel.', 'print_section': 'A', 'print_page': '