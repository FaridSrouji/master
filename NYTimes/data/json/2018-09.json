subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Fashion: The Heaviest Winter Coats ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Body Armor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coats and Jackets', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Protective Clothing and Gear', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Moncler (Fashion Label)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Undercover (Fashion Label)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Givenchy', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Simons, Raf', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-09-04T15:29:24+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f782d38-563d-56ed-ae23-d0c2d3e2f296', 'word_count': 191, 'uri': 'nyt://article/7f782d38-563d-56ed-ae23-d0c2d3e2f296'}, {'abstract': 'A family’s sauce line ranges in spice from deeply punchy to closer to pesto.', 'web_url': 'https://www.nytimes.com/2018/09/04/dining/bazodee-sauce.html', 'snippet': 'A family’s sauce line ranges in spice from deeply punchy to closer to pesto.', 'lead_paragraph': 'Mavis Davis, her niece Debra Sandler and grandniece Kiah Sandler, all of whom have roots in Trinidad and Venezuela, have formed a company with the expertise of a chef, Martin Little, to bottle and sell the family’s Caribbean sauces. The yellowish Soca Sauce, made with papaya, cauliflower, mustard and cilantro, is chunky and tolerably spiced. Hot Hot Soca Sauce is rust-colored, smoother and takes no prisoners. The grass-green Marvelous Marinade with cilantro and onions, could pass for pesto, and has uses beyond marinating, as a dipping sauce or for dressing pasta.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/05/dining/05burner1/merlin_142436328_977f34f1-c286-4569-bebd-b0ffa9f7a99b-articleLarge.jpg', 'height': 438, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/05/dining/05burner1/merlin_142436328_977f34f1-c286-4569-bebd-b0ffa9f7a99b-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 438}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/05/dining/05burner1/merlin_142436328_977f34f1-c286-4569-bebd-b0ffa9f7a99b-jumbo.jpg', 'height': 748, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/05/dining/05burner1/merlin_142436328_977f34f1-c286-4569-bebd-b0ffa9f7a99b-superJumbo.jpg', 'height': 1496, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/05/dining/05burner1/05burner1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/05/dining/05burner1/05burner1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/05/dining/05burner1/05burner1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Caribbean Flavors, Bottled', 'kicker': None, 'content_kicker': None, 'print_headline': 'To Season: Bottling Flavors Of the Caribbean', 'name': None, 'seo': None, 'sub'