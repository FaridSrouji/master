i-slide-GXSH-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-GXSH/Antoni-slide-GXSH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-GXSH/Antoni-slide-GXSH-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-GXSH/Antoni-slide-GXSH-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-GXSH/Antoni-slide-GXSH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-GXSH/Antoni-slide-GXSH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-GXSH/Antoni-slide-GXSH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gourmet Toast and Bear Walks With Antoni Porowski', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Exercise', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Porowski, Antoni', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-09-20T21:51:38+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Entertainment', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/f051f49f-ecf5-5266-a1ee-2e75ab2d427d', 'word_count': 0, 'uri': 'nyt://slideshow/f051f49f-ecf5-5266-a1ee-2e75ab2d427d'}, {'abstract': 'T spent two days with the food and wine expert as he put the finishing touches on his new menu.', 'web_url': 'https://www.nytimes.com/2018/09/20/t-magazine/48-hours-with-antoni-porowski.html', 'snippet': 'T spent two days with the food and wine expert as he put the finishing touches on his new menu.', 'lead_paragraph': 'On a recent Tuesday afternoon, at a gym in Lower Manhattan, Antoni Porowski was lying flat on his stomach, working his quadriceps over a foam roller, when he let out an exasperated moan. “I make the same noise after I eat too much as I do after I work out,” he said. Porowski, the food and wine expert on Netflix’s “Queer Eye,” had just completed a rigorous workout led by Akin Akman, the trainer who has helped carve action-figure abs onto the torsos of the likes of Jake Gyllenhaal and David Beckham. Watching from across the room, Akman teased that had Porowski not shown up fifteen minutes late, he could have added squats to the bear walks, medicine ball tosses and monster tire rolling that had left his client spread-eagle on the gym floor. “I really wish I could have got the full workout in,” Porowski said in a sarcastic tone.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-XHOS/Antoni-slide-XHOS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/20/t-magazine/entertainment/Antoni-slide-XHOS/Antoni-slide-XHOS-articleLarge.jpg', 'xlargewidth': 600