ht2-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jimmy Fallon Expects to See More White House Tell-All Books', 'kicker': 'Best of Late Night', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Woodward, Bob', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fallon, Jimmy', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Colbert, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kimmel, Jimmy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Macdonald, Norm', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Meyers, Seth', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Fear: Trump in the White House (Book)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Trebek, Alex', 'rank': 9, 'major': 'N'}, {'name': 'creative_works', 'value': 'Late Night with Seth Meyers (TV Program)', 'rank': 10, 'major': 'N'}, {'name': 'creative_works', 'value': 'Late Show with Stephen Colbert (TV Program)', 'rank': 11, 'major': 'N'}], 'pub_date': '2018-09-12T08:28:17+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Giovanni Russonello', 'person': [{'firstname': 'Giovanni', 'middlename': None, 'lastname': 'Russonello', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f5eb094-eaad-5043-8101-0e7ef731968c', 'word_count': 996, 'uri': 'nyt://article/7f5eb094-eaad-5043-8101-0e7ef731968c'}, {'abstract': 'How looking at the location data that the company collects about you lets you see yourself in a whole new way.', 'web_url': 'https://www.nytimes.com/2018/09/12/magazine/google-maps-location-data-privacy.html', 'snippet': 'How looking at the location data that the company collects about you lets you see yourself in a whole new way.', 'lead_paragraph': 'In August, The Associated Press published an investigation into how Google handles the data it collects, following a curious discovery by a graduate researcher at U.C. Berkeley. For years, the company has allowed users to control their “location history,” which stores a detailed record of where they’ve been, based primarily on their activity in Google Maps. This, the researcher suggested — and The A.P. confirmed — did not work as advertised. “Some Google apps automatically store time-stamped location data without asking,” the reporters found. The revelation has since resulted in at least one lawsuit, as well as renewed public criticism from lawmakers.', 'print_section': 'MM', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-ontech-image1/16mag-ontech-image1-articleLarge.png', 'height': 698, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/16/magazine/16mag-ontech-image1/16mag-ontech-image1-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 698}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-ontech-image1/16mag-ontech-image1-jumbo.png', 'height': 1024, 'width': 881, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-ontech-image1/16mag-ontech-image1-superJumbo.png', 'height': 2048, 'width': 1761, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-ontech-image1/16mag-ontech-image1-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/16/magazine/16mag-ontech-image1/16mag-ontech-image1-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-ontech-image1/16mag-ontech-image1-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Google Knows Where You’ve Been, but Does It Know Who You Are?', 'kicker': 'On Technology', 'content_kicker': None, 'print_headline': 'Google Knows Where You’ve Been, but Does It Know Who You Are?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Maps', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-09-12T09:00:01+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By John Herrman', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Herrman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5bf79359-3bca-5224-9551-b8e4c48b9982', 'word_count': 1664, 'uri': 'nyt://article/5bf79359-3bca-5224-9551-b8e4c48b9982'}, {'abstract': 'The former politician on John McCain, the senatorial virtues of a military background and the absurdity of withdrawing from the Trans-Pacific Partnership.', 'web_url': 'https://www.nytimes.com/2018/09/12/magazine/john-kerry-says-the-world-is-worried-about-america.html', 'snippet': 'The former politician on John McCain, the senatorial virtues of a military background and the absurdity of withdrawing from the Trans-Pacific Partnership.', 'lead_paragraph': 'A memoir like your new book, “Every Day Is Extra,” often means people are shaping their legacy. Is that something you’re thinking about now? No, I don’t look at the book as a political book. I really view it as a personal exploration of my life. The things I write about are the things most people have heard about. It’s an opportunity for me to set the record straight in a number of cases.', 'print_section': 'MM', 'print_page': '54', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-talk-image2/16mag-talk-image2-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/09/16/magazine/16mag-talk-image2/16mag-talk-image2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-talk-image2/16mag-talk-image2-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-talk-image2/16mag-talk-image2-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/09/16/magazine/16mag-talk-image2/16mag-talk-image2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/09/16/magazine/