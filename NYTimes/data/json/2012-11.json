or': 'N'}, {'name': 'glocations', 'value': 'Montana', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-08T01:12:33+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'byline': {'original': 'Rebecca Richman Cohen', 'person': [{'firstname': 'Rebecca', 'middlename': 'Richman', 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/7788a2ba-cfee-5752-b091-fbc6b9a3a930', 'word_count': 0, 'uri': 'nyt://video/7788a2ba-cfee-5752-b091-fbc6b9a3a930'}, {'abstract': 'Muhammad A. Salah said in his lawsuit that he was unable to open a bank account, get a job or donate to his mosque without government approval.', 'web_url': 'https://www.nytimes.com/2012/11/08/us/man-removed-from-terror-suspect-list.html', 'snippet': 'Muhammad A. Salah said in his lawsuit that he was unable to open a bank account, get a job or donate to his mosque without government approval.', 'lead_paragraph': 'A suburban Chicago man who sued the Treasury Department in September for keeping him on the government’s list of “specially designated terrorists” since 1995 has been removed from the list, his lawyers said on Wednesday. Muhammad A. Salah of Bridgeview, Ill., who was suspected of ties to Hamas, the militant Palestinian organization, said in his lawsuit that he was unable to open a bank account, get a job or donate to his mosque without special approval from the government. In 2007, Mr. Salah was convicted of lying in a civil lawsuit about his connection to Hamas but was acquitted of more serious conspiracy charges. ', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Man Removed From Terror Suspect List', 'kicker': 'National Briefing | Washington', 'content_kicker': None, 'print_headline': 'Man Removed From Terror Suspect List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Suits and Litigation', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Salah, Muhammad A', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-08T01:14:12+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Scott Shane', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Shane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/e8bb388c-cafa-5ddc-aaf6-ab41cc9fbd8a', 'word_count': 104, 'uri': 'nyt://article/e8bb388c-cafa-5ddc-aaf6-ab41cc9fbd8a'}, {'abstract': 'An Op-Doc profiles Chris Williams, a medical marijuana grower in Montana who now faces life in prison.  The filmmaker explores how Mr. Williams is a casualty of conflicting national and state drug laws.', 'web_url': 'https://www.nytimes.com/2012/11/08/opinion/the-fight-over-medical-marijuana.html', 'snippet': 'An Op-Doc profiles Chris Williams, a medical marijuana grower in Montana who now faces life in prison.  The filmmaker explores how Mr. Williams is a casualty of conflicting national and state drug laws.', 'lead_paragraph': 'Our federal marijuana policy is increasingly out of step with both the values of American citizens and with state law. The result is a system of justice that is schizophrenic and at times appalling.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/10/31/opinion/video-opdoc-marijuana/video-opdoc-marijuana-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/10/31/opinion/video-opdoc-marijuana/video-opdoc-marijuana-articleLarge.jpg', 'xlargewidth': 