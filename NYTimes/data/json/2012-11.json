.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/14/sports/video-kitesurfing/video-kitesurfing-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/14/sports/video-kitesurfing/video-kitesurfing-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/14/sports/video-kitesurfing/video-kitesurfing-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Kite With the Wind', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sailboats and Sailing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Kites', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kiteboarding', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Surfing', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Namibia', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-23T19:45:09+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'Erik Olsen', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Olsen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/c1ef0965-7b8a-5af2-ac05-5a57ec350446', 'word_count': 0, 'uri': 'nyt://video/c1ef0965-7b8a-5af2-ac05-5a57ec350446'}, {'abstract': 'The kiteboarder Rob Douglas will begin his quest to reclaim the world speed record in sailing next week in Salin-de-Giraud, France.', 'web_url': 'https://www.nytimes.com/2012/11/24/sports/kiteboarder-plots-new-course-for-speed-sailing-record.html', 'snippet': 'The kiteboarder Rob Douglas will begin his quest to reclaim the world speed record in sailing next week in Salin-de-Giraud, France.', 'lead_paragraph': 'EDGARTOWN, Mass. — On a frigid weekday in late October, a dozen of the fastest kiteboarders gathered here on a barren spit of beach that bounds Katama Bay on Martha’s Vineyard, eager to ride the blustery autumn winds that tear across the slate gray waters. To some residents, the winds are a noisy nuisance. For members of a tribe of kiteboarders who specialize in speed, they are bliss. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/sports/24kite1/24kite1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/24/sports/24kite1/24kite1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/sports/24kite1/24kite1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/sports/24kite1/24kite1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/sports/24kite1/24kite1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/24/sports/24kite1/24kite1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/sports/24kite1/24kite1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kiteboarder Chases a Speed Title That He Lost to a Rocket-Shaped Boat', 'kicker': None, 'content_kicker': None, 'print_headline': 'Kiteboarder Chases a Speed Title That He Lost to a Rocket-Shaped Boat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kiteboarding', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Records and Achievements', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sailboats and Sailing', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-23T19:51:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Erik Olsen', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Olsen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b082c9e5-9433-5e00-834c-01cbfe6f4fea', 'word_count': 1120, 'uri': 'nyt://article/b082c9e5-9433-5e00-834c-01cbfe6f4fea'}, {'abstract': 'Many physicians who stop accepting insurance do so because of frustration with red tape. But concierge medicine isn’t for everyone.', 'web_url': 'https://www.nytimes.com/2012/11/24/your-money/dealing-with-doctors-who-accept-only-cash.html', 'snippet': 'Many physicians who stop accepting insurance do so because of frustration with red tape. But concierge medicine isn’t for everyone.', 'lead_paragraph': 'A FEW weeks ago, my wife and I were at our wits’ end: our 4-month-old daughter wouldn’t sleep for more than an hour at a time at night. We had consulted books and seen our pediatrician, but nothing was working. So my wife called a pediatrician who specializes in babies who struggle with sleep problems.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'm