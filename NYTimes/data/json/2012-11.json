UTH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/18SOUTH/18SOUTH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A New Southern Strategy', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'A New Southern Strategy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Voting and Voters', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Liberalism (US Politics)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-11-17T21:25:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Karen L. Cox', 'person': [{'firstname': 'Karen', 'middlename': 'L.', 'lastname': 'Cox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/12619d49-f20e-5899-b928-006e8a82f3ff', 'word_count': 1120, 'uri': 'nyt://article/12619d49-f20e-5899-b928-006e8a82f3ff'}, {'abstract': 'Enough with the condescension. Take our liberalism seriously.', 'web_url': 'https://campaignstops.blogs.nytimes.com/2012/11/17/a-new-southern-strategy/', 'snippet': 'Enough with the condescension. Take our liberalism seriously.', 'lead_paragraph': 'Karen L. Cox writes in the Sunday Review that the use of the term “Confederacy” to describe the South says a lot about how hard it is for the region to move beyond its historical reputation, however richly deserved, for one that reflects more current realities. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Southern Strategy', 'kicker': 'Campaign Stops', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-17T21:33:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By THE EDITORS', 'person': [], 'organization': 'THE EDITORS'}, 'type_of_material': 'News', '_id': 'nyt://article/c309143e-7aa6-515d-8470-4011950f675b', 'word_count': 50, 'uri': 'nyt://article/c309143e-7aa6-515d-8470-4011950f675b'}, {'abstract': 'Amtrak’s Quiet Car is our last bastion of civility and calm. And we will defend it.', 'web_url': 'https://www.nytimes.com/2012/11/18/opinion/sunday/the-quiet-ones.html', 'snippet': 'Amtrak’s Quiet Car is our last bastion of civility and calm. And we will defend it.', 'lead_paragraph': 'EVER since I quit hanging out in Baltimore dive bars, the only place where I still regularly find myself in hostile confrontations with my fellow man is Amtrak’s Quiet Car. The Quiet Car, in case you don’t know, is usually the first car in Amtrak’s coach section, right behind business class. Loud talking is forbidden there — any conversations are to be conducted in whispers. Cellphones off; music and movies on headphones only. There are little signs hanging from the ceiling of the aisle that explain this, along with a finger-to-lips icon. The conductor usually makes an announcement explaining the protocol. Nevertheless I often see people who are ignorant of the Quiet Car’s rules take out their cellphones to resume their endless conversation, only to get a polite but stern talking-to from a fellow passenger.', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/18QUIETCAR/18QUIETCAR-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/18/sunday-review/18QUIETCAR/18QUIETCAR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/18QUIETCAR/18QUIETCAR-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/18QUIETCAR/18QUIETCAR-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/18QUIETCAR/18QUIETCAR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/sunday-review/18QUIETCAR/18QUIETCAR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/18QUIETCAR/18QUIETCAR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Quiet Ones', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'The Quiet Ones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Noise', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Railroads', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'AMTRAK', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-17T21:35:50+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Tim Kreider', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Kreider', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d7d5d1b4-3f72-54b1-b38e-777b8ad0acaf', 'word_count': 1356, 'uri': 'nyt://article/d7d5d1b4-3f72-54b1-b38e-777b8ad0acaf'}, {'abstract': 'Now that Republicans are softening their position on immigration, President Obama and Congress need to act.', 'web_url': 'https://www.nytimes.com/2012/11/18/opinion/sunday/new-hope-on-immigration.html', 'snippet': 'Now that Republicans are softening their position on immigration, President Obama and Congress need to act.', 'lead_paragraph': 'Funny how quickly some principles collapse when given the right kind of shove. One day, the Republican Party is rock-ribbed restrictionist, dedicated to the proposition that unauthorized immigrants are an invading army of job stealers, welfare moochers and criminals whose only acceptable destiny is to be caught and deported — the border fence forever, “amnesty” never. The next day: never mind. The party suddenly discovers the merits of a working immigration system. Senators like John McCain and Lindsey Graham, who once bravely supported bipartisan reform but slunk away late in the last Bush administration, are scratching at the door again, as if the last five years never happened.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Hope on Immigration', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'New Hope on Immigration', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dream Act (Development, Relief and Education for Minors Act)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deferred Action for Childhood Arrivals', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Deportation', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-17T21:37:42+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/c93acdaa-90b0-5b7c-9505-794878e0a462', 'word_count': 753, 'uri': 'nyt://article/c93acdaa-90b0-5b7c-9505-794878e0a462'}, {'abstract': 'Republican efforts to eliminate a crucial cost-control board for Medicare are shortsighted.', 'web_url': 'https://www.nytimes.com/2012/11/18/opinion/sunday/a-bad-idea-resurfaces.html', 'snippet': 'Republican efforts to eliminate a crucial cost-control board for Medicare are shortsighted.', 'lead_paragraph': 'House Republicans like to talk about the need to find common ground with President Obama to make progress on important national issues, especially after the election. Yet within days, they were setting an agenda to eliminate an important element of his signature domestic achievement, the Affordable Care Act.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Bad Idea Resurfaces', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Bad Idea Resurfaces', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicare', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Independent Payment Advisory Board', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cantor, Eric', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-17T21:39:45+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/854cc104-8f0e-5852-b867-f7d69d676394', 'word_count': 480, 'uri': 'nyt://article/854cc104-8f0e-5852-b867-f7d69d676394'}, {'abstract': 'If done right, the rules will bring long-overdue transparency and oversight to the multitrillion-dollar derivatives market.', 'web_url': 'https://www.nytimes.com/2012/11/18/opinion/sunday/the-next-round-of-derivatives-regulation.html', 'snippet': 'If done right, the rules will bring long-overdue transparency and oversight to the multitrillion-dollar derivatives market.', 'lead_paragraph': 'In the weeks ahead, federal regulators will finalize rules that, done right, will bring long-overdue transparency and oversight to the multitrillion-dollar derivatives market. The big banks that control derivatives trading, however, are lobbying to dilute the rules. To grasp what is at stake, recall that the $182 billion taxpayer bailout of American International Group during the financial crisis was essentially a bailout of the global financial system, undertaken to make good on derivatives bets gone spectacularly wrong. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Next Round of Derivatives Reg