/04ban-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/education/edlife/04ban/04ban-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hold the Bacon', 'kicker': 'Blackboard | Bans', 'content_kicker': None, 'print_headline': 'The Baggier the Better. No More Bacon. Gosh Darn!', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-02T22:00:14+0000', 'document_type': 'article', 'news_desk': 'EdLife', 'section_name': 'Education', 'subsection_name': 'Education Life', 'byline': {'original': 'By Sarah Maslin Nir', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c407afe-9a34-5450-a357-78a31bb5de6d', 'word_count': 312, 'uri': 'nyt://article/6c407afe-9a34-5450-a357-78a31bb5de6d'}, {'abstract': 'So many choices (1,500!), so few years (4!). With colleges adding new fields of study, picking a major has become harder than ever. How to decide?', 'web_url': 'https://www.nytimes.com/2012/11/04/education/edlife/choosing-one-college-major-out-of-hundreds.html', 'snippet': 'So many choices (1,500!), so few years (4!). With colleges adding new fields of study, picking a major has become harder than ever. How to decide?', 'lead_paragraph': 'WHAT’S your major? It’s the defining question for college students — and the cliché that’s launched a thousand friendships and romances. It’s also a question that has become harder for students to answer.', 'print_section': 'ED', 'print_page': '13', '