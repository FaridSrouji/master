ionalist either. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/arts/22BOOK/22BOOK-jumbo.jpg', 'height': 1024, 'width': 591, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/arts/22BOOK/22BOOK-superJumbo.jpg', 'height': 2048, 'width': 1183, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/arts/22BOOK/22BOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/22/arts/22BOOK/22BOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Cold Case That Warms a Cop’s Heart', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'A Cold Case That Warms A Cop’s Heart', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Connelly, Michael', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-21T20:08:55+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Janet Maslin', 'person': [{'firstname': 'Janet', 'middlename': None, 'lastname': 'Maslin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c557f9db-a407-5b8d-9d6c-3ec1c281b38e', 'word_count': 787, 'uri': 'nyt://article/c557f9db-a407-5b8d-9d6c-3ec1c281b38e'}, {'abstract': '“People, Hell and Angels” is a compilation of previously unreleased recordings.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/11/21/an-album-from-the-hendrix-vault-coming-in-march/', 'snippet': '“People, Hell and Angels” is a compilation of previously unreleased recordings.', 'lead_paragraph': '“People, Hell and Angels,” a new compilation of a dozen previously unreleased recordings by Jimi Hendrix, will be released by Sony Legacy on March 5, as part of a celebration of the 70th anniversary of Hendrix’s birth. (The actual anniversary is on Tuesday.)\xa0 The album, which was produced by Eddie Kramer, Hendrix’s longtime engineer; Janie Hendrix, the guitarist’s sister; and the Hendrix scholar John McDermott, is drawn from the copious amount of material Hendrix recorded between 1968 and his death in 1970.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/arts/21artsbeat-hendrix/21artsbeat-hendrix-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/arts/21artsbeat-hendrix/21artsbeat-hendrix-superJumbo.jpg', 'height': 1500, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/arts/21artsbeat-hendrix/21artsbeat-hendrix-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/21/arts/21artsbeat-hendrix/21artsbeat-hendrix-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/arts/21artsbeat-hendrix/21artsbeat-hendrix-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Album