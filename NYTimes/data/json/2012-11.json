rk Times', 'multimedia': [], 'headline': {'main': 'Obama Defends Susan Rice on Benghazi', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rice, Susan E', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-14T17:49:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By John H. Cushman Jr', 'person': [{'firstname': 'John', 'middlename': 'H.', 'lastname': 'Cushman', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4b7c6574-ddb3-53ee-a439-0b0c3ed9f668', 'word_count': 762, 'uri': 'nyt://article/4b7c6574-ddb3-53ee-a439-0b0c3ed9f668'}, {'abstract': 'Buffalo’s C.J. Spiller will get his chance to be an every-down back and could have a big game against a Dolphins defense that has struggled to stop the run.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/11/14/thursday-matchup-dolphins-at-bills/', 'snippet': 'Buffalo’s C.J. Spiller will get his chance to be an every-down back and could have a big game against a Dolphins defense that has struggled to stop the run.', 'lead_paragraph': 'Dolphins (4-5) at Bills (3-6)', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Thursday Matchup: Dolphins at Bills', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': "Thursday's Matchup", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Buffalo Bills', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Miami Dolphins', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-14T17:49:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'orig