on': None}, 'type_of_material': 'News', '_id': 'nyt://article/2639f955-ed39-5ac1-9707-f8daccdfde5b', 'word_count': 675, 'uri': 'nyt://article/2639f955-ed39-5ac1-9707-f8daccdfde5b'}, {'abstract': 'Palestinian militants fired rockets for the first time at Jerusalem on Friday in a new escalation of hostilities that came as Israel seemed to be edging closer to a ground assault on Gaza.', 'web_url': 'https://www.nytimes.com/interactive/2012/11/16/world/middleeast/20121116-Gaza-POD.html', 'snippet': 'Palestinian militants fired rockets for the first time at Jerusalem on Friday in a new escalation of hostilities that came as Israel seemed to be edging closer to a ground assault on Gaza.', 'lead_paragraph': 'Palestinian militants fired rockets for the first time at Jerusalem on Friday in a new escalation of hostilities that came as Israel seemed to be edging closer to a ground assault on Gaza.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Nov. 16, 2012', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Gaza Strip', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-17T02:57:51+0000', 'document_type': 'multimedia', 'news_desk': 'World', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/9f255b7f-0a4f-5563-8a00-21b4be2cfabf', 'word_count': 0, 'uri': 'nyt://interactive/9f255b7f-0a4f-5563-8a00-21b4be2cfabf'}, {'abstract': 'Marble Hill may be physically attached to the Bronx, but it is legally — and at heart — part of Manhattan.', 'web_url': 'https://www.nytimes.com/2012/11/18/nyregion/attached-to-the-bronx-but-legally-in-manhattan.html', 'snippet': 'Marble Hill may be physically attached to the Bronx, but it is legally — and at heart — part of Manhattan.', 'lead_paragraph': 'When the construction of the Harlem River Ship Canal separated Marble Hill from the rest of Manhattan in 1895, the little neighborhood, perched on a high mound of Inwood marble, was suddenly surrounded by water as if by a moat. Two decades later, when Spuyten Duyvil Creek, to its north, was filled in, Marble Hill joined the mainland Bronx. The hill’s identity, however, remained defiantly — irrationally, even — linked to its past, and it continues to be legally part of the borough of Manhattan. And while two train lines make it easily accessible today, the topographical and cartographic oddity feels like what it once was: an island unto itself. ', 'print_section': 'MB', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/20121118LOCALSTOP-slide-LR0P/20121118LOCALSTOP-slide-LR0P-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/18/nyregion/20121118LOCALSTOP-slide-LR0P/20121118LOCALSTOP-slide-LR0P-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/20121118LOCALSTOP-slide-LR0P/20121118LOCALSTOP-slide-LR0P-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/20121118LOCALSTOP-slide-LR0P/20121118LOCALSTOP-slide-LR0P-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/20121118LOCALSTOP-slide-LR0P/20121118LOCALSTOP-slide-LR0P-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/nyregion/20121118LOCALSTOP-slide-LR0P/20121118LOCALSTOP-slide-LR0P-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/20121118LOCALSTOP-slide-LR0P/20121118LOCALSTOP-slide-LR0P-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hooked on the Bronx, Legally Manhattan’s', 'kicker': 'Local Stop | Marble Hill', 'content_kicker': None, 'print_headline': 'Hooked on Bronx, Legally Manhattan’s', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Canals', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Marble Hill (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-17T02:58:21+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sarah Harrison Smith', 'person': [{'firstname': 'Sarah', 'middlename': 'Harrison', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/48284785-071b-54d9-9dce-95954e98c7bf', 'word_count': 541, 'uri': 'nyt://article/48284785-071b-54d9-9dce-95954e98c7bf'}, {'abstract': 'Corrections appearing in print on November 17, 2012.', 'web_url': 'https://www.nytimes.com/2012/11/17/pageoneplus/corrections-november-17-2012.html', 'snippet': 'Corrections appearing in print on November 17, 2012.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: November 17, 2012', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-17T02:58:36+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/84ae3082-dc7c-5f55-97ff-27fde0ccfa23', 'word_count': 603, 'uri': 'nyt://article/84ae3082-dc7c-5f55-97ff-27fde0ccfa23'}, {'abstract': 'In which Tim Croce breaks our teeth on a particularly crunchy Down entry.', 'web_url': 'https://wordplay.blogs.nytimes.com/2012/11/16/the-red-kryptonite-entry/', 'snippet': 'In which Tim Croce breaks our teeth on a particularly crunchy Down entry.', 'lead_paragraph': 'SATURDAY’S PUZZLE — This was a fun one. First of all, I nominate MISTER MXYZPTLK for crunchy entry of the year. I wonder how long Tim Croce has been waiting to fit that one into a puzzle.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Red Kryptonite Entry', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-17T03:00:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf264ef7-e7c1-56ef-861f-1bc255dfa2c0', 'word_count': 183, 'uri': 'nyt://article/bf264ef7-e7c1-56ef-861f-1bc255dfa2c0'}, {'abstract': 'Security is important, but the president must also address human rights on stops in Thailand, Myanmar and Cambodia.', 'web_url': 'https://www.nytimes.com/2012/11/17/opinion/president-obama-goes-to-asia.html', 'snippet': 'Security is important, but the president must also address human rights on stops in Thailand, Myanmar and Cambodia.', 'lead_paragraph': 'President Obama leaves on Saturday for a trip to Asia that will show his commitment to having the United States engage more intensely with countries there. But it comes at an awkward time. Israel and Hamas are at war in Gaza, and efforts to end the violence are demanding Mr. Obama’s attention. The Middle East is likely to remain a top priority, but he is right to also focus on Asia, where China’s growing assertiveness presents a challenge. ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'President Obama Goes to Asia', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'President Obama Goes to Asia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Obama, Barack', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Far East, South and Southeast Asia and Pacific Areas', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Myanmar', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Cambodia', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Thailand', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-11-17T03:02:04+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/57cd8ceb-72fa-56a5-8a57-9f88dc5664cd', 'word_count': 445, 'uri': 'nyt://article/57cd8ceb-72fa-56a5-8a57-9f88dc5664cd'}, {'abstract': 'The threat of the demise of the cream-filled cake is evoking nostalgia.', 'web_url': 'https://dealbook.nytimes.com/2012/11/16/a-push-to-save-the-twinkies/', 'snippet': 'The threat of the demise of the cream-filled cake is evoking nostalgia.', 'lead_paragraph': 'Few would consider Twinkies fine dining. But the threat of their demise is evoking nostalgia, even from foodies who hadn’t deigned to eat them in years.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Brand Value Could Entice a Corporate Buyer', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'A Push to Save the Twinkies: Brand Value Could \r\nEntice a Corporate Buyer', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bankruptcies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Behavior', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Snack Foods', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Hostess Brands', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-17T03:03:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/918882a2-e568-5a10-87c4-7fab623f27bb', 'word_count': 925, 'uri': 'nyt://article/918882a2-e568-5a10-87c4-7fab623f27bb'}, {'abstract': 'The new winning formula: very expensive voter research.', 'web_url': 'https://www.nytimes.com/2012/11/17/opinion/beware-the-big-data-campaign.html', 'snippet': 'The new winning formula: very expensive voter research.', 'lead_paragraph': '“I AM not a number. I am a free man!” was the famous cry of prisoner Number Six, who could never escape his Kafkaesque village on the 1960s television show “The Prisoner.” This is a prescient cry for an era when numbers follow us everywhere. Jim Messina, the victorious Obama campaign manager, probably agrees that you are not a number. That’s because you are four numbers. ', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Tufekci-Zeynep-circular/Tufekci-Zeynep-circular-articleLarge-v3.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/16/opinion/Tufekci-Zeynep-circular/Tufekci-Zeynep-circular-articleLarge-v3.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Tufekci-Zeynep-circular/Tufekci-Zeynep-circular-jumbo-v3.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Tufekci-Zeynep-circular/Tufekci-Zeynep-circular-superJumbo-v3.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Tufekci-Zeynep-circular/Tufekci-Zeynep-circular-thumbStandard-v3.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/16/opinion/Tufekci-Zeynep-circular/Tufekci-Zeynep-circular-thumbStandard-v3.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Tufekci-Zeynep-circular/Tufekci-Zeynep-circular-thumbLarge-v3.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Beware the Smart Campaign', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Beware the Smart Campaign', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Data-Mining and Database Marketing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Messina, Jim (1969- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-17T03:05:25+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Zeynep Tufekci', 'person': [{'firstname': 'Zeynep', 'middlename': None, 'lastname': 'Tufekci', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/490af7fc-7cc0-53ec-8c52-2c1d01cb4247', 'word_count': 963, 'uri': 'nyt://article/490af7fc-7cc0-53ec-8c52-2c1d01cb4247'}, {'abstract': 'Parole and police officers have been visiting freed convicted burglars in neighborhoods damaged by Hurricane Sandy, sending a message against looting in the storm’s aftermath.', 'web_url': 'https://www.nytimes.com/2012/11/17/nyregion/burglars-are-warned-of-temptation-to-loot-after-the-storm.html', 'snippet': 'Parole and police officers have been visiting freed convicted burglars in neighborhoods damaged by Hurricane Sandy, sending a message against looting in the storm’s aftermath.', 'lead_paragraph': 'It was early on a recent Friday morni