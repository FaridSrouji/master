': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-29T19:23:58+0000', 'document_type': 'multimedia', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': "'Dead Accounts'", 'person': [], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/7ce32a54-7dca-5a53-8343-b4ba0e0b98a6', 'word_count': 0, 'uri': 'nyt://video/7ce32a54-7dca-5a53-8343-b4ba0e0b98a6'}, {'abstract': 'Tthe renowned creative director Fabien Baron reimagined the T as a shattered mold lying in rubble.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/11/29/breaking-the-mold/', 'snippet': 'Tthe renowned creative director Fabien Baron reimagined the T as a shattered mold lying in rubble.', 'lead_paragraph': 'For the latest in our series of artist-designed T’s, the renowned creative director Fabien Baron — currently the editorial director of Interview magazine and the head of his own agency, Baron & Baron — reimagined the T as a shattered mold lying in rubble. He used a 3-D printer to render the letter in powder and glue, and then took a hammer to his creation. What you see is a black-and-white photograph of the aftermath. “I saw what everybody was doing and I wanted to do something different,” says Baron (who is currently doing something very different and very beautiful on Instagram; follow him @FabienBaron). “I wanted to do a picture because I felt like what would be expected of me would be type.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Breaking the Mold', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-29T19:29:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By FABIEN BARON', 'person': [{'firstname': 'Fabien', 'middlename': None, 'lastname': 'BARON', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5bb57f35-bf27-5121-9f9f-fb49a4adf95c', 'word_count': 124, 'uri': 'nyt://article/5bb57f35-bf27-5121-9f9f-fb49a4adf95c'}, {'abstract': 'Shafik Gabr, one of the world’s leading collectors of Orientalist art, believes that the genre can teach the diplomatic world a great deal.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/11/29/seeing-orientalist-art-as-an-aid-to-east-west-dialogue/', 'snippet': 'Shafik Gabr, one of the world’s leading collectors of Orientalist art, believes that the genre can teach the diplomatic world a great deal.', 'lead_paragraph': 'One of the world’s leading collectors of Orientalist art believes the genre can teach the diplomatic world much about East-West relations. Shafik Gabr, an Egyptian businessman and philanthropist, says the sort of immersion that Western painters had in the Middle East in the 19th century is the sort of personal interaction that can lead to better understanding between cultures.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/29/arts/29artsbeat-robin/29artsbeat-robin-jumbo.jpg', 'height': 1024, 'width': 699, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/29/arts/29artsbeat-robin/29artsbeat-robin-superJumbo.jpg', 'height': 1536, 'width': 1048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/29/arts/29artsbeat-robin/29artsbeat-robin-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/29/arts/29artsbeat-robin/29artsbeat-robin-thumbStandard.jpg',