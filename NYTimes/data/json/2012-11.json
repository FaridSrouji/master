it': None, 'type': 'image', 'url': 'images/2012/11/05/sports/YPACKERS/YPACKERS-jumbo.jpg', 'height': 845, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/sports/YPACKERS/YPACKERS-superJumbo.jpg', 'height': 1690, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Green Bay Brings Back Ground Game', 'kicker': 'Packers 31, Cardinals 17', 'content_kicker': None, 'print_headline': 'The Packers Are Hobbled, Not Daunted', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ARIZONA CARDINALS', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Crabtree, Tom', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-05T01:56:57+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Pat Borzi', 'person': [{'firstname': 'Pat', 'middlename': None, 'lastname': 'Borzi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c9dbea9-87f1-5a02-94dc-e2ff48eb1fa3', 'word_count': 593, 'uri': 'nyt://article/6c9dbea9-87f1-5a02-94dc-e2ff48eb1fa3'}, {'abstract': 'Scenes from Rockaway Beach, Queens, where residents are increasingly cold, scared and without heat, water and electricity days after Hurricane Sandy devastated the community.', 'web_url': 'https://www.nytimes.com/video/nyregion/100000001884759/lights-out-in-the-rockaways.html', 'snippet': 'Scenes from Rockaway Beach, Queens, where residents are increasingly cold, scared and without heat, water and electricity days after Hurricane Sandy devastated the community.', 'lead_