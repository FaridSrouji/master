ame': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/00d207f0-5950-5a90-bfa0-68ac2cfee43e', 'word_count': 611, 'uri': 'nyt://article/00d207f0-5950-5a90-bfa0-68ac2cfee43e'}, {'abstract': 'The anonymous man had told the gossip Web site TMZ that he had had a sexual relationship with Kevin Clash, who voices the popular character Elmo, while he was under age.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/11/13/accuser-recants-allegation-against-elmo-puppeteer/', 'snippet': 'The anonymous man had told the gossip Web site TMZ that he had had a sexual relationship with Kevin Clash, who voices the popular character Elmo, while he was under age.', 'lead_paragraph': '9:27 p.m. | Updated\xa0The man who accused Kevin Clash, the voice and puppeteer of the “Sesame Street” character Elmo, of an under-age sexual relationship has recanted that claim, his lawyer said on Tuesday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Accuser Recants Allegation Against Elmo Puppeteer', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'Accuser of ‘Sesame Street’ Puppeteer Recants', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clash, Kevin', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sesame Workshop', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'TMZ.com', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-13T22:20:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter and Elizabeth Jensen', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'E