d_count': 794, 'uri': 'nyt://article/01c31ab8-1c12-5343-8b94-fdca0e9acf61'}, {'abstract': 'Around 683,000 homes remain in the dark in New York, New Jersey and Connecticut.', 'web_url': 'https://green.blogs.nytimes.com/2012/11/08/on-our-radar-utilities-soldier-on/', 'snippet': 'Around 683,000 homes remain in the dark in New York, New Jersey and Connecticut.', 'lead_paragraph': 'A northeaster knocks out power to at least 375,000 homes in New York, New Jersey and Connecticut, but utilities say that most of those losses have been reversed. Nonetheless, about 683,000 homes remain in the dark, post-Sandy. [The New York Times]', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Our Radar: Utilities Soldier On', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-08T16:56:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/61e53bca-b41e-58ee-a84b-656a6633f221', 'word_count': 156, 'uri': 'nyt://article/61e53bca-b41e-58ee-a84b-656a6633f221'}, {'abstract': 'Bertie Carvel, an acclaimed theater actor in England, will once again play Miss Trunchbull in the adaptation of Roald Dahl’s children’s novel.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/11/08/award-winner-to-reprise-role-as-schoolmistress-in-matilda-the-musical/', 'snippet': 'Bertie Carvel, an acclaimed theater actor in England, will once again play Miss Trunchbull in the adaptation of Roald Dahl’s children’s novel.', 'lead_paragraph': 'The hit London musical “Matilda” may be about the misfortunes and moxie of one little girl, but it is her chief persecutor – the sociopathic schoolmistress Miss Trunchbull, known for throwing children by their pigtails – who really steals the show. The British actor Bertie Carvel won a best actor Olivier Award (the equivalent of a Tony) this year for his cross-dressing performance as Miss Trunchbull, and he will reprise the role in this season’s highly anticipated Broadway run of “Matilda the Musical,” the producers announced on Thursday.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/arts/08artsbeat-bertie/08artsbeat-bertie-jumbo.jpg', 'height': 1024, 'width': 681, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/arts/08artsbeat-bertie/08artsbeat-bertie-superJumbo.jpg', 'height': 2048, 'width': 1363, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/arts/08artsbeat-bertie/08artsbeat-bertie-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/08/arts/08artsbeat-bertie/08artsbeat-bertie-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/arts/08artsbeat-bertie/08artsbeat-bertie-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Award-Winning Actor to Reprise Role as Schoolmistress in ‘Matilda the Musical’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Bertie Carvel to Reprise Role in ‘Matilda’ Musical', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Carvel, Bertie', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dahl, Roald', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kelly, Dennis', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Minchin, Tim', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Warchus, Matthew', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-08T17:00:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a97725b1-0330-50ef-a934-6db180f019af', 'word_count': 205, 'uri': 'nyt://article/a97725b1-0330-50ef-a934-6db180f019af'}, {'abstract': 'A Japanese designer adopts Finland’s simple yet refined aesthetic for his whimsical housewares.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/11/08/seeing-things-at-home-with-min-perhonen/', 'snippet': 'A Japanese designer adopts Finland’s simple yet refined aesthetic for his whimsical housewares.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Seeing Things | At Home with Minä Perhonen', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Tokyo (Japan)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-08T17:02:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Brooke Hodge', 'person': [{'firs