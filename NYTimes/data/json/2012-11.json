source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/sports/YJPCOURSE1/YJPCOURSE1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/05/sports/YJPCOURSE1/YJPCOURSE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/sports/YJPCOURSE1/YJPCOURSE1-jumbo.jpg', 'height': 667, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/sports/YJPCOURSE1/YJPCOURSE1-superJumbo.jpg', 'height': 1333, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/sports/YJPCOURSE1/YJPCOURSE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/sports/YJPCOURSE1/YJPCOURSE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/sports/YJPCOURSE1/YJPCOURSE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Along the 26.2 Miles, No Hordes or Cheers, Just Odd Tranquillity', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stepping Out... Along the 26.2 Miles, No Hordes or Cheers, Just Odd Tranquillity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'New York City Marathon', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Marathon Running', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-05T02:11:06+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Jeré Longman', 'person': [{'firstname': 'Jeré', 'middlename': None, 'lastname': 'Longman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/889d891b-0735-58ec-8fc0-de4e2dbcae7d', 'word_count': 1279, 'uri': 'nyt://article/889d891b-0735-58ec-8fc0-de4e2dbcae7d'}, {'abstract': 'The slow pace of recovery is leading residents and officials to wonder if the county is being overlooked in favor of more populous areas.', 'web_url': 'https://www.nytimes.com/2012/11/05/nyregion/100000-in-westchester-remain-without-power.html', 'snippet': 'The slow pace of recovery is leading residents and officials to wonder if the county is being overlooked in favor of more populous areas.', 'lead_paragraph': 'More than 100,000 customers in Westchester County remained without power on Sunday afternoon, with many gas stations throughout the county still without fuel or the electricity to pump it, and long lines at those stations that were in operation. Though the county was spared the devastation experienced in the Rockaways, on Staten Island and on parts of Long Island, six days after Hurricane Sandy touched shore, life was still far from normal for many residents, even as they watched the power go back on in more populous regions. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '100,000 in Westchester Remain Without Power', 'kicker': None, 'content_kicker': None, 'print_headline': '100,000 in Westchester Remain Without Power', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Consolidated Edison In