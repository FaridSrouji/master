0-superJumbo.jpg', 'height': 1500, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/magazine/04talk/04talk-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/04/magazine/04talk/04talk-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/magazine/04talk/04talk-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Last Days of Joementum', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'The Last Days of Joementum', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lieberman, Joseph I', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-02T19:26:51+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Mark Leibovich', 'person': [{'firstname': 'Interview', 'middlename': 'Mark', 'lastname': 'Leibovich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/911c2767-5f50-5b56-b13b-7ea2ec58abd5', 'word_count': 688, 'uri': 'nyt://article/911c2767-5f50-5b56-b13b-7ea2ec58abd5'}, {'abstract': 'How a gimmick that developed as shorthand on Twitter blossomed into a poetic genre all its own.', 'web_url': 'https://www.nytimes.com/2012/11/04/magazine/in-praise-of-the-hashtag.html', 'snippet': 'How a gimmick that developed as shorthand on Twitter blossomed into a poetic genre all its own.', 'lead_paragraph': 'The pound sign is a typographical symbol with ambitions. For decades, it was an afterthought on our telephone keypads, mashed occasionally in frustration during prolonged customer-service calls. But lately, it is conquering new territories, visible on our TV screens (#debates, for example, during the most recent presidential debate); at the box office (#holdyourbreath, plugging the title of a recent horror movie); even spray- painted on your favorite football teams’ turf (#GOHOGS at the 25-yard-line in Razorback Stadium).', 'print_section': 'MM', 'print_page': '48', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/magazine/04riff/mag-04Riff-t_CA0-articleLarge.jpg', 'height': 84, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/04/magazine/04riff/mag-04Riff-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 84}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/magazine/04riff/mag-04Riff-t_CA0-jumbo.jpg', 'height': 143, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/magazine/04riff/mag-04Riff-t_CA0-superJumbo.jpg', 'height': 286, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/magazine/04riff/04riff-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/04/magazine/04riff/04riff-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 