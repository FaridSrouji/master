yline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/561e6381-f06d-5244-9388-9b31ebab22ab', 'word_count': 1739, 'uri': 'nyt://article/561e6381-f06d-5244-9388-9b31ebab22ab'}, {'abstract': 'The animal photographer reveals a passion for swing dancing and French cinema.', 'web_url': 'https://www.nytimes.com/2012/11/18/opinion/sunday/catching-up-with-the-photographer-tim-flach.html', 'snippet': 'The animal photographer reveals a passion for swing dancing and French cinema.', 'lead_paragraph': 'Tim Flach is an English photographer best known for his portraits of animals, which reveal eerily human expressions and gestures. Pictures from his latest project were published last month in the book “More Than Human,” and are the basis of an exhibition of the same name opening Dec. 5 at the Osborne Samuel Gallery in London.', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/1118download/1118download-jumbo.jpg', 'height': 1024, 'width': 309, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/1118download/1118download-superJumbo.jpg', 'height': 2048, 'width': 618, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/sunday-review/1118download/1118download-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/sunday-review/1118download/1118download-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11