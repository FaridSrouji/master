n/08jason-jumbo.jpg', 'height': 1024, 'width': 869, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/sports/baseball/08jason/08jason-superJumbo.jpg', 'height': 2048, 'width': 1738, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/sports/baseball/08jason/08jason-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/08/sports/baseball/08jason/08jason-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/sports/baseball/08jason/08jason-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Whither Jason Bay?', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Free Agents (Sports)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bay, Jason', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Pirates', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Seattle Mariners', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-08T03:40:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Jorge Arangure Jr', 'person': [{'firstname': 'Jorge', 'middlename': None, 'lastname': 'Arangure', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b526ae89-1f1c-5ce8-9f8d-e6b663b4cd35', 'word_count': 422, 'uri': 'nyt://article/b526ae89-1f1c-5ce8-9f8d-e6b663b4cd35'}, {'abstract': 'Since March 2011, nearly 70 Tibetans have self-immolated, and the number on Wednesday was the highest in a single day.', 'web_url': 'https://www.nytimes.com/2012/11/08/world/asia/china-at-least-4-tibetans-set-themselves-on-fire-in-protest.html', 'snippet': 'Since March 2011, nearly 70 Tibetans have self-immolated, and the number on Wednesday was the highest in a single day.', 'lead_paragraph': 'At least four Tibetans set themselves on fire Wednesday to protest Chinese rule in Tibetan areas, according to reports by Free Tibet, an advocacy group, and Radio Free Asia, which is financed by the United States government. Since March 2011, nearly 70 Tibetans have self-immolated, and the number on Wednesday was the highest in a single day. Three of those were teenage boy monks in Aba County, known as Ngaba in Tibetan. One, Dorje, died on the scene, and the other two were taken to a hospital, according to the reports. Elsewhere, a 23-year-old woman set fire to herself and died. Radio Free Asia also reported a fifth self-immolation that took place at night in the Tibet Autonomous Region, but the details remain vague. ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'China: At Least 4 Tibetans Set Themselves on Fire in Protest', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'China: At Least 4 Tibetans Set Themselves on Fire in Protest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Tibet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fires and Firefighters', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Immolation', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-08T03:41:00+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Edward Wong', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/214a2cc6-4e5a-598c-952b-c6b32180c91c', 'word_count': 124, 'uri': 'nyt://article/214a2cc6-4e5a-598c-952b-c6b32180c91c'}, {'abstract': 'The New York Aquarium faced the biggest crisis in its history when Hurricane Sandy hit.', 'web_url': 'https://www.nytimes.com/2012/11/08/nyregion/hurricane-filled-new-york-aquarium-with-dangerous-substance-water.html', 'snippet': 'The New York Aquarium faced the biggest crisis in its history when Hurricane Sandy hit.', 'lead_paragraph': 'The clock in the office of Jon Forrest Dohlin, director of the New York Aquarium, just off the Boardwalk in Coney Island, is frozen at 7:50. “And 10 seconds,” he added, almost cheerily, as he stood surrounded by boxes of soggy papers and office furniture.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/nyregion/AQUARIUM1-bw/AQUARIUM1-bw-articleLarge.jpg', 'height': 365, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/08/nyregion/AQUARIUM1-bw/AQUARIUM1-bw-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 365}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/nyregion/AQUARIUM1-bw/AQUARIUM1-bw-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/nyregion/AQUARIUM1-bw/AQUARIUM1-bw-su