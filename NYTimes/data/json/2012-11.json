n': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6332eb3a-c6dc-5456-a74e-1c7e7e3d32da', 'word_count': 22, 'uri': 'nyt://article/6332eb3a-c6dc-5456-a74e-1c7e7e3d32da'}, {'abstract': 'While the Myanmar leader called attention to the refugees, they say their situation is past help.', 'web_url': 'https://india.blogs.nytimes.com/2012/11/20/daw-aung-san-suu-kyi-offers-little-hope-for-rohingya-refugees/', 'snippet': 'While the Myanmar leader called attention to the refugees, they say their situation is past help.', 'lead_paragraph': 'The first time that a leader of any consequence had spoken about the plight of the Rohingyas of Myanmar, considered one of the most persecuted minorities in the world, was when the Burmese opposition leader Daw Aung San Suu Kyi visited India last week. She told an Indian news channel that the violence against the Muslim minority group was a “huge international tragedy” and that she would try her best to help the situation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Daw Aung San Suu Kyi Offers Little Hope for Rohingya Refugees', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Aung San Suu Kyi', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Human Rights Watch', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National League for Democracy (Myanmar)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Myanmar', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-20T07:29:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Raksha Kumar', 'person': [{'firstname': 'Raksha', 'middlename': None, 'lastname': 'Kumar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a760b4d3-5e99-559e-a348-7c76e61870dd', 'word_count': 823, 'uri': 'nyt://article/a760b4d3-5e99-559e-a348-7c76e61870dd'}, {'abstract': 'Efforts to agree on a cease-fire between Israel and Hamas intensified, with help from Secretary of State Hillary Rodham Clinton, but the sides struggled to achieve even a brief pause in fighting.', 'web_url': 'https://www.nytimes.com/2012/11/21/world/middleeast/israel-gaza-conflict.html', 'snippet': 'Efforts to agree on a cease-fire between Israel and Hamas intensified, with help from Secretary of State Hillary Rodham Clinton, but the sides struggled to achieve even a brief pause in fighting.', 'lead_paragraph': 'JERUSALEM — Efforts to agree on a cease-fire between Israel and Hamas intensified Tuesday, but the struggle to achieve even a brief pause in the fighting emphasized the obstacles to finding any lasting solution.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Seeks\r\nTruce on Gaza\r\nas Enemies\r\nStep Up Attacks', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.S. Seeks Gaza Truce As Foes Step Up Attacks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Hamas', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'West Bank', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Gaza Strip', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Netanyahu, Benjamin', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-11-20T08:30:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Ethan Bronner and David D. Kirkpatrick', 'person': [{'firstname': 'Ethan', 'middlename': None, 'lastname': 'Bronner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'David', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b51d7ce9-b49c-5ec8-992d-1e72be5d7625', 'word_count': 1346, 'uri': 'nyt://article/b51d7ce9-b49c-5ec8-992d-1e72be5d7625'}, {'abstract': 'For President Obama and Secretary of State Hillary Rodham Clinton, this week’s trip to Southeast Asia is to be their last foreign adventure together in office.', 'web_url': 'https://www.nytimes.com/2012/11/21/world/asia/for-obama-and-clinton-a-partnerships-final-road-show.html', 'snippet': 'For President Obama and Secretary of State Hillary Rodham Clinton, this week’s trip to Southeast Asia is to be their last foreign adventure together in office.', 'lead_paragraph': 'PHNOM PENH, Cambodia — They emerged from Air Force One together, side by side, smiling at the crowd waiting on the tarmac below. Then as they headed down the stairs, she held back just a little so that she would stay a step behind him. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/20/world/sub-PREXY/sub-PREXY-articleLarge.jpg', 'height': 440, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/20/world/sub-PREXY/sub-PREXY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 440}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url'