rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6dd91024-bb8c-5043-8113-4bc776ec9061', 'word_count': 1111, 'uri': 'nyt://article/6dd91024-bb8c-5043-8113-4bc776ec9061'}, {'abstract': 'Maryland switched to the Big Ten conference on Monday in search of financial stability, possibly igniting another wave of realignment as Rutgers is expected to follow suit Tuesday.', 'web_url': 'https://www.nytimes.com/2012/11/20/sports/maryland-joins-big-ten-rutgers-is-likely-to-follow.html', 'snippet': 'Maryland switched to the Big Ten conference on Monday in search of financial stability, possibly igniting another wave of realignment as Rutgers is expected to follow suit Tuesday.', 'lead_paragraph': 'Maryland made the latest move in the tectonic plate-shifting that has been college conference realignment by accepting an invitation Monday to join the Big Ten. Rutgers is expected to follow suit Tuesday.', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Maryland and Rutgers Give Big Ten 14 Teams', 'kicker': None, 'content_kicker': None, 'print_headline': 'Maryland And Rutgers Give Big Ten 14 Teams', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Maryland', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Rutgers, The State University of New Jersey', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Big Ten Conference', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-20T00:45:20+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6adb95a0-2cc9-58ee-83f9-a0c4a551675a', 'word_count': 614, 'uri': 'nyt://article/6adb95a0-2cc9-58ee-83f9-a0c4a551675a'}, {'abstract': 'The organizers of the 24-hour live Dirty Weather Report reached more than 16 million viewers. Will it help save the planet?', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/11/19/activists-use-webcast-to-try-to-ignite-climate-change-passions/', 'snippet': 'The organizers of the 24-hour live Dirty Weather Report reached more than 16 million viewers. Will it help save the planet?', 'lead_paragraph': 'In a blog entry this summer, the international correspondent Christiane Amanpour said that the climate\xa0change denial club “is actually now shrinking faster than the polar ice caps.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Activists Use Webcast to Try to Ignite Climate Change Passions', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Global Warming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-20T00:46:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Christopher F. Schuetze', 'person': [{'firstname': 'Christopher', 'middlename': 'F.', 'lastname': 'Schuetze', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed9fb1e7-6daf-5e55-b9c5-d459eb0cd12a', 'word_count': 699, 'uri': 'nyt://article/ed9fb1e7-6daf-5e55-b9c5-d459eb0cd12a'}, {'abstract': 'The retailer is asking for an injunction to stop anti-Wal-Mart protests planned for this week.', 'web_url': 'https://www.nytimes.com/2012/11/20/business/labor-board-to-act-swiftly-on-wal-marts-complaint.html', 'snippet': 'The retailer is asking for an injunction to stop anti-Wal-Mart protests planned for this week.', 'lead_paragraph': 'The National Labor Relations Board, which often takes weeks or months to investigate complaints, said on Monday that it would decide within days whether there is merit to Wal-Mart’s complaint, filed last Thursday, to seek an injunction to stop anti-Wal-Mart protests scheduled for this week. ', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Labor Board to Act Swiftly on Wal-Mart’s Complaint', 'kicker': None, 'content_kicker': None, 'print_headline': 'Labor Board to Act Swiftly on Wal-Mart’s Complaint', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Wal-Mart Stores Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Labor Relations Board', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'United Food and Commercial Workers Union', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Organization United for Respect at Walmart', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-11-20T00:48:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Steven Greenhouse', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Greenhouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9b8f4bb5-e11a-507b-95d2-140dfac3accf', 'word_count': 397, 'uri': 'nyt://article/9b8f4bb5-e11a-507b-95d2-140dfac3accf'}, {'abstract': 'The National Oceanic and Atmospheric Administration is investigating at least four fatal attacks on the sea mammals since June.', 'web_url': 'https://www.nytimes.com/2012/11/20/us/mississippi-dolphin-deaths-investigated.html', 'snippet': 'The National Oceanic and Atmospheric Administration is investigating at least four fatal attacks on the sea mammals since June.', 'lead_paragraph': ' Several dolphins have been found dead and mutilated in recent months in the northern Gulf of Mexico, federal investigators said Monday. The National Oceanic and Atmospheric Administration is investigating at least four fatal attacks on the sea mammals since June. A dolphin was found in September with a 9 millimeter bullet. Another was discovered Friday with its jawbone removed. Another was stabbed to death in June with a screwdriver. The attacks happened from Alabama to Louisiana, and NOAA officials said scientists are conducting necropsies to help determine whether the attacks are related. Killing a dolphin is punishable by up to a $100,000 fine and a year in jail. ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mississippi: Dolphin Deaths Investigated', 'kicker': 'National Briefing | South', 'content_kicker': None, 'print_headline': 'Mississippi: Dolphin Deaths Investigated', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Gulf of Mexico', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dolphins and Porpoises', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Oceanic and Atmospheric Administration', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-20T00:53:44+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Robbie Brown', 'person': [{'firstname': 'Robbie', 'middlename': None, 'lastname': 'Brown', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/7d7a161f-8484-589b-a4d9-bfce07679842', 'word_count': 108, 'uri': 'nyt://article/7d7a161f-8484-589b-a4d9-bfce07679842'}, {'abstract': 'The C.I.A. needs a director who will reject failed counterterrorism policies, not continue them.', 'web_url': 'https://www.nytimes.com/2012/11/20/opinion/john-brennan-is-the-wrong-man-for-the-cia.html', 'snippet': 'The C.I.A. needs a director who will reject failed counterterrorism policies, not continue them.', 'lead_paragraph': 'WITH the resignation of David H. Petraeus, President Obama now has a chance to appoint a new C.I.A. director. Unfortunately, one of the leading candidates for the job is John O. Brennan, who is largely responsible for America’s current flawed counterterrorism strategy, which relies too heavily on drone strikes that frequently kill civilians and provide Al Qaeda with countless new recruits. Rather than keeping us safe, this strategy is putting the United States at greater risk.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Wrong Man for the C.I.A.', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The Wrong Man for the C.I.A.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civilian Casualties', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Al Qaeda in the Arabian Peninsula', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Targeted Killings', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Brennan, John O', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Yemen',