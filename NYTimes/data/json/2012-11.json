UBNOTED-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In China, ‘Audi’ Means ‘Big Shot’', 'kicker': 'Noted', 'content_kicker': None, 'print_headline': 'In China, ‘Audi’ Means ‘Big Shot’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Audi Division of Volkswagen AG', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Beijing (China)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-16T22:24:27+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Michael Wines', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Wines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4230f14-fcc7-5a37-bf8b-f29f49963b28', 'word_count': 597, 'uri': 'nyt://article/d4230f14-fcc7-5a37-bf8b-f29f49963b28'}, {'abstract': 'In 10 key states, the presidential campaigns spent $22.8 million on local Spanish-language media outlets, or just 6.2 percent of the total spent on advertising in those states.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/11/16/a-rare-quiet-zone-during-the-presidential-election-spanish-language-media/', 'snippet': 'In 10 key states, the presidential campaigns spent $22.8 million on local Spanish-language media outlets, or just 6.2 percent of the total spent on advertising in those states.', 'lead_paragraph': 'Voters around the country, especially those who live in the “battleground” states of the presidential election, are probably thankful that the campaign season and, by extension, political advertising, is over. They can now turn on their televisions and watch ads for toothpaste and new cars instead of a steady stream of negative campaign ads.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Rare Quiet Zone During the Presidential Election: Spanish-Language Media', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hispanic-Americans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Spanish Language', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-16T22:25:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Tanzina Vega', 'person': [{'firstname': 'Tanzina', 'middlename': None, 'lastname': 'Vega', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d2cb822c-0bc4-5f81-af0d-141accaa029b', 'word_count': 352, 'uri': 'nyt://article/d2cb822c-0bc4-5f81-af0d-141accaa029b'}, {'abstract': 'Applications for high school, originally due on Dec. 3, will be accepted until Dec. 10.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/11/16/deadline-for-high-school-applications-pushed-back/', 'snippet': 'Applications for high school, originally due on Dec. 3, will be accepted until Dec. 10.', 'lead_paragraph': 'Citing the disruption of Hurricane Sandy, the city’s Department of Education announced on Friday that it would extend by one week the deadline for students applying to high school.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Deadline for High School Applications Pushed Back', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Educatio