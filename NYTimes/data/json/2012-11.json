stname': 'Nick', 'middlename': None, 'lastname': 'Wingfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76f4ad2c-d287-5508-a4dc-ad0a0d00223c', 'word_count': 695, 'uri': 'nyt://article/76f4ad2c-d287-5508-a4dc-ad0a0d00223c'}, {'abstract': 'With his performance on Monday night, point guard Deron Williams helped persuade fans to support the Nets, not just Brooklyn.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2012/11/27/deron-williams-makes-it-about-team-not-place/', 'snippet': 'With his performance on Monday night, point guard Deron Williams helped persuade fans to support the Nets, not just Brooklyn.', 'lead_paragraph': 'Deron Williams deserved every decibel of praise he received from the crowd for his exhilarating, exacting performance Monday night in the Nets’ victory over the Knicks, Brooklyn’s crosstown big brother.', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Nets Earn Brooklyn’s Love a Pass at a Time', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': 'Earning Brooklyn’s Love a Pass at a Time', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Deron', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Nets', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-27T20:22:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Beckley Mason', 'person': [{'firstname': 'Beckley', 'middlename': None, 'lastname': 'Mason', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/53c9abdb-42a2-58a9-877b-a3afb39f9242', 'word_count': 728, 'uri': 'nyt://article/53c9abdb-42a2-58a9-877b-a3afb39f9242'}, {'abstract': 'A closer look at the Film Independent Spirit Award nominations shows they’re more or less in line with the Gothams.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2012/11/27/what-the-spirits-do-and-dont-portend/', 'snippet': 'A closer look at the Film Independent Spirit Award nominations shows they’re more or less in line with the Gothams.', 'lead_paragraph': 'A few filmmakers and stars still recovering from the hangover of the vodka-sponsored Gothams (waiters urged guests to open up the bottles on their tables; some just took them home) are likely to be in for a nice surprise this afternoon. The Film Independent Spirit Awards dovetailed with many Gothams picks, like “Beasts of the Southern Wild,” “Silver Linings Playbook,” “Moonrise Kingdom” and “Bernie.” They drew Spirit nominations for directing, screenplays, and/or performances, as well as best feature.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What the Spirits Do and Don’t Portend', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Beasts of the Southern Wild (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Corinealdi, Emayatzy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lawrence, Jennifer', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Leto, Jared', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'McConaughey, Matthew', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Wallis, Quvenzhane', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Zeitlin, Benh', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'valu