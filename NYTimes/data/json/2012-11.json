r': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-16T10:00:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2eb3bb88-05e7-5884-9b43-cbbb7722e380', 'word_count': 305, 'uri': 'nyt://article/2eb3bb88-05e7-5884-9b43-cbbb7722e380'}, {'abstract': 'A new collection presents the work of O. Winston Link, the rail fan photographer — adopted in recent decades by the fine art world — who documented the end of the steam-powered trains.', 'web_url': 'https://lens.blogs.nytimes.com/2012/11/16/when-steam-locomotion-ground-to-a-halt/', 'snippet': 'A new collection presents the work of O. Winston Link, the rail fan photographer — adopted in recent decades by the fine art world — who documented the end of the steam-powered trains.', 'lead_paragraph': 'O. Winston Link became famous for photographing a moribund technology, lugging his flashbulbs and Rolleiflex around the hills of Appalachia in search of steam locomotives.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'When Steam Locomotion Ground to a Halt', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Railroads', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Link, O Winston', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'APPALACHIAN REGION', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Staunton (Va)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-16T10:00:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Matt McCann', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'McCann', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eb416025-6751-5c8c-b195-5095581c0b82', 'word_count': 800, 'uri': 'nyt://article/eb416025-6751-5c8c-b195-5095581c0b82'}, {'abstract': 'Ikea said political prisoners from the former East Germany provided some of the labor that helped keep its prices so low.', 'web_url': 'https://www.nytimes.com/2012/11/17/business/global/ikea-to-report-on-allegations-of-using-forced-labor-during-cold-war.html', 'snippet': 'Ikea said political prisoners from the former East Germany provided some of the labor that helped keep its prices so low.', 'lead_paragraph': 'BERLIN — Ikea has long been famous for its inexpensive, some-assembly-required furniture. On Friday the company admitted that political prisoners in the former East Germany provided some of the labor that helped it keep its prices so low.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/world/ikea1/ikea1-jumbo.jpg', 'height': 1024, 'width': 739, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/world/ikea1/ikea1-superJumbo.jpg', 'height': 2048, 'width': 1478, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/world/ikea1/ikea1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/17/world/ikea1/ikea1-th