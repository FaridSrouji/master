': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/37b84b40-e8b4-5727-a505-be0f66032e40', 'word_count': 916, 'uri': 'nyt://article/37b84b40-e8b4-5727-a505-be0f66032e40'}, {'abstract': 'Leaders from Franklin D. Roosevelt forward knew that friendly relationships with Latin America encouraged the assimilation and loyalty of Hispanics in the United States.', 'web_url': 'https://www.nytimes.com/2012/11/10/opinion/immigrants-are-also-neighbors.html', 'snippet': 'Leaders from Franklin D. Roosevelt forward knew that friendly relationships with Latin America encouraged the assimilation and loyalty of Hispanics in the United States.', 'lead_paragraph': 'Evanston, Ill.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Migrants Are Also Neighbors', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Migrants Are Also Neighbors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Immigration Detention', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hispanic-Americans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Latin America', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Roosevelt, Franklin Delano', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-11-10T02:02:25+0000', 'document_type': 'article',