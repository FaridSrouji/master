'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a3b5a876-6245-50c3-bbb1-284d306a5d34', 'word_count': 410, 'uri': 'nyt://article/a3b5a876-6245-50c3-bbb1-284d306a5d34'}, {'abstract': 'Former President George Bush, 88, is being treated at a Houston hospital, but a spokesman said Thursday that he is in stable condition and expected to be released within the next 72 hours.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/11/29/former-president-george-h-w-bush-is-hospitalized-but-in-stable-condition/', 'snippet': 'Former President George Bush, 88, is being treated at a Houston hospital, but a spokesman said Thursday that he is in stable condition and expected to be released within the next 72 hours.', 'lead_paragraph': 'HOUSTON – Former President George Bush is being treated at a hospital here for complications related to bronchitis, but a spokesman said Thursday that his condition was stable and that he was expected to be released within 72 hours.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Elder George Bush Is Hospitalized, but Condition Is Stable', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bush, George', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Houston (Tex)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-29T20:37:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Manny Fernandez', 'person': [{'firstname': 'Manny', 'middlename': None, 'lastname': 'Fernandez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e7ebcf3c-d14e-50dc-a686-7694fd21773e', 'word_count': 303, 'uri': 'nyt://article/e7ebcf3c-d14e-50dc-a686-7694fd21773e'}, {'abstract': '“New Photography 2012” offers some interesting examples of conceptually minded artists turning photography back on itself, looking askance at its panoptical gaze.', 'web_url': 'https://www.nytimes.com/2012/11/30/arts/design/new-photography-2012-at-museum-of-modern-art.html', 'snippet': '“New Photography 2012” offers some interesting examples of conceptually minded artists turning photography back on itself, looking askance at its panoptical gaze.', 'lead_paragraph': 'It is an article of faith in contemporary art that consumerism is bad. But if people stopped buying unneeded stuff, the economy would collapse, and where would we be then? So artists continue to worry about consumerism and its soul-eroding effects, as they have been doing for at least the last half century. ', 'print_section': 'C', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/arts/30PHOTO1_SPAN/30PHOTO1_SPAN-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/30/arts/30PHOTO1_SPAN/30PHOTO1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/arts/30PHOTO1_SPAN/30PHOTO1_SPAN-jumbo.jpg', 'height': 831, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/arts/30PHOTO1_SPAN/30PHOTO1_SPAN-superJumbo.jpg', 'height': 1662, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/arts/30PHOTO1_SPAN/30PHOTO1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnai