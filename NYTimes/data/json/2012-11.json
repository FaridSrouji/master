-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/22/garden/22TREES1_SPAN/22TREES1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22TREES1_SPAN/22TREES1_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Save Damaged Trees and Your Limbs, Too', 'kicker': 'The Pragmatist', 'content_kicker': None, 'print_headline': 'Save Damaged Trees And Your Limbs, Too', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Trees and Shrubs', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-21T23:47:03+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Bob Tedeschi', 'person': [{'firstname': 'Bob', 'middlename': None, 'lastname': 'Tedeschi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ccdcdd93-7875-5643-b76e-4abea54f18d0', 'word_count': 1564, 'uri': 'nyt://article/ccdcdd93-7875-5643-b76e-4abea54f18d0'}, {'abstract': 'In a Wheels annual tradition, we at the Wheels blog will be taking some time off to give thanks and maybe hit a few of the Black Friday sales.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/11/21/we-brake-for-turkeys/', 'snippet': 'In a Wheels annual tradition, we at the Wheels blog will be taking some time off to give thanks and maybe hit a few of the Black Friday sales.', 'lead_paragraph': 'We at the Wheels blog will be taking some time off to give thanks and to maybe hit a few of the Black Friday and weekend sales. We’ll be back on Monday, but in the meantime Wheels wishes you safe and happy travels, whether you’re going to grandmother’s house or to the mall.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'We Brake for Turkeys', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Thanksgiving Day', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-21T23:50:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/9e8f5b22-677d-52f4-87c6-c14f6682382c', 'word_count': 53, 'uri': 'nyt://article/9e8f5b22-677d-52f4-87c6-c14f6682382c'}, {'abstract': 'From the New York designer Scott Amron, a toothbrush that rinses, too.', 'web_url': 'https://www.nytimes.com/2012/11/22/garden/a-fountain-springs-from-a-toothbrush.html', 'snippet': 'From the New York designer Scott Amron, a toothbrush that rinses, too.', 'lead_paragraph': 'After a big holiday meal, a good tooth brushing is probably in order. For those looking for the latest in manual toothbrush technology, the New York designer Scott Amron has created the Rinser brush, a model with an integrated miniature funnel that redirects water from the tap into a water-fountain-like arc for swishing.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22BATH/22CURR5-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/22/garden/22BATH/22CURR5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22BATH/22CURR5-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22BATH/22CURR5-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22BATH/22CURR5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/22/garden/22BATH/22CURR5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22BATH/22CURR5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Will This Do to the Dixie Cup?', 'kicker': 'Currents | Bath', 'content_kicker': None, 'print_headline': 'What Will This Do to the Dixie Cup?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Toothbrushes and Toothpaste', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-21T23:52:38+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70040010-a1c0-54db-8d1b-c806972c25fb', 'word_count': 163, 'uri': 'nyt://article/70040010-a1c0-54db-8d1b-c806972c25fb'}, {'abstract': 'A former Whole Foods executive opens a variety store with the flavor of small town America.', 'web_url': 'https://www.nytimes.com/2012/11/22/garden/germantown-variety-opens-in-duchess-county.html', 'snippet': 'A former Whole Foods executive opens a variety store with the flavor of small town America.', 'lead_paragraph': '“Do you have mothballs?” “Shoelaces?” “A book on beekeeping?” Otto Leuschel has been hearing such questions since 2008, when he opened Otto’s Market in Germantown, N.Y., and only had space for food. Now with Germantown Variety across Main Street, he can finally give the nod.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22OPEN1_SPAN/22CURR1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/22/garden/22OPEN1_SPAN/22CURR1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22OPEN1_SPAN/22CURR1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22OPEN1_SPAN/22CURR1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22OPEN1_SPAN/22CURR1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/22/garden/22OPEN1_SPAN/22CURR1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22OPEN1_SPAN/22CURR1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Argyle on Main Street', 'kicker': 'Currents | Open', 'content_kicker': None, 'print_headline': 'Argyle on Main Street', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-21T23:53:25+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Liz Arnold', 'person': [{'firstname': 'Liz', 'middlename': None, 'lastname': 'Arnold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da004637-fcb4-5ba3-bed1-0c3058ebe508', 'word_count': 121, 'uri': 'nyt://article/da004637-fcb4-5ba3-bed1-0c3058ebe508'}, {'abstract': 'Crystal carafes from France that evoke shooting stars and comets.', 'web_url': 'https://www.nytimes.com/2012/11/22/garden/celestial-inspired-carafes-from-saint-louis.html', 'snippet': 'Crystal carafes from France that evoke shooting stars and comets.', 'lead_paragraph': 'The French design star Pierre Charpin, who has worked for Alessi, Ligne Roset and Venini, knows a thing or two about aqueous containers. In 2004, he won a national competition to design a carafe that promoted Parisian tap water as comparable to anything that could be found in a bottle. (Mr. Charpin’s entry fit easily in a refrigerator door shelf.) Recently, Saint-Louis, the venerable French crystal company with a specialty in carafes, asked him to revisit the object.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22GOODS/22CURR6-jumbo.jpg', 'height': 1024, 'width': 956, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/garden/22GOODS/22CURR6-superJumbo.jpg', 'height': 2048, 'wi