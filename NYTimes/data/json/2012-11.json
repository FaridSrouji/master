title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ea7886be-c1b2-5115-a383-b0fc2556c506', 'word_count': 543, 'uri': 'nyt://article/ea7886be-c1b2-5115-a383-b0fc2556c506'}, {'abstract': 'Even if Mitt Romney had won the popular vote by two percentage points, President Obama would still have won the Electoral College.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2012/11/08/as-nation-and-parties-change-republicans-are-at-an-electoral-college-disadvantage/', 'snippet': 'Even if Mitt Romney had won the popular vote by two percentage points, President Obama would still have won the Electoral College.', 'lead_paragraph': 'Two more presidential elections, 2016 and 2020, will be contested under the current Electoral College configuration, which gave Barack Obama a second term on Tuesday. This year’s results suggest that this could put Republicans at a structural disadvantage.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'As Nation and Parties Change, Republicans Are at an Electoral College Disadvantage', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': 'Republicans Face an Electoral Challenge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-08T21:15:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nate Silver', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Silver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}