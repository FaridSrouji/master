 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE2_SPAN/18PRAGUE2_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Forget Sleep: A Prague Day Planner', 'kicker': None, 'content_kicker': None, 'print_headline': 'I’ll Sleep Later: A Day Planner', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Czech Republic', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Prague (Czech Republic)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-16T15:27:22+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Evan Rail', 'person': [{'firstname': 'Evan', 'middlename': None, 'lastname': 'Rail', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/b74c8253-e336-51b3-a37e-1e527d02020a', 'word_count': 519, 'uri': 'nyt://article/b74c8253-e336-51b3-a37e-1e527d02020a'}, {'abstract': 'Sketches of evolving restaurant trends in the Czech capital.', 'web_url': 'https://www.nytimes.com/2012/11/18/travel/as-prague-grows-up-a-food-scene-blossoms.html', 'snippet': 'Sketches of evolving restaurant trends in the Czech capital.', 'lead_paragraph': 'IF there is any way that Prague has truly hit its stride, it would have to be in the ever-expanding culinary scene. After the Velvet Revolution, the best restaurants were usually aimed at foreigners, with prices that were often far out of line with local sensibilities, and served with airs — \xa0white-gloved servers, often in tails; formal plate presentations. But as the city has grown up, the food scene has blossomed. Some of the city’s highest fliers seem to have become far less formal.', 'print_section': 'TR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE3_SPAN/18PRAGUE3_SPAN-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/18/travel/18PRAGUE3_SPAN/18PRAGUE3_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE3_SPAN/18JPPRAGUE5-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE3_SPAN/18JPPRAGUE5-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE3_SPAN/18PRAGUE3_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/travel/18PRAGUE3_SPAN/18PRAGUE3_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE3_SPAN/18PRAGUE3_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As Prague Grows Up, a Food Scene Blossoms', 'kicker': None, 'content_kicker': None, 'print_headline': 'Knives and Forks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Czech Republic', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Prague (Czech Republic)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-16T15:27:24+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Evan Rail', 'person': [{'firstname': 'Evan', 'middlename': None, 'lastname': 'Rail', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10ba4f49-dd8d-510a-a0f7-92c69c76252d', 'word_count': 609, 'uri': 'nyt://article/10ba4f49-dd8d-510a-a0f7-92c69c76252d'}, {'abstract': 'Dancers like Lil Buck and T J Benson are raising the bar for the very American dance form of jookin.', 'web_url': 'https://www.nytimes.com/2012/11/18/arts/dance/jookin-in-memphis-celebrated.html', 'snippet': 'Dancers like Lil Buck and T J Benson are raising the bar for the very American dance form of jookin.', 'lead_paragraph': 'HOW’S this for a surprising success story? In 2007 Katie Smythe, a ballet teacher working out of her native Memphis, was driving her most remarkable student, Charles Riley, across the Mississippi to a lecture-demonstration in Arkansas. Mr. Riley, a young man specializing in the local form of virtuoso hip-hop footwork known as jookin, had started taking ballet lessons to gain strength and extend his range. ', 'print_section': 'AR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/arts/18JOOKIN1_SPAN/18JOOKIN1_SPAN-articleLarge-v2.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/18/arts/18JOOKIN1_SPAN/18JOOKIN1_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/arts/18JOOKIN1_SPAN/18JOOKIN1_SPAN-jumbo-v2.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/arts/18JOOKIN1_SPAN/18JOOKIN1_SPAN-superJumbo-v2.jpg', 'height': 1204, 'width': 1834, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/arts/18JOOKIN1_SPAN/18JOOKIN1_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/arts/18JOOKIN1_SPAN/18JOOKIN1_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/arts/18JOOKIN1_SPAN/18JOOKIN1_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Baryshnikovs Of Jookin', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Baryshnikovs Of Jookin', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lil Buck', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-16T15:27:26+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alastair Macaulay', 'person': [{'firstname': 'Alastair', 'middlename': None, 'lastname': 'Macaulay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/575a8ec5-04d1-5678-8c3e-a636e94caa8f', 'word_count': 1255, 'uri': 'nyt://article/575a8ec5-04d1-5678-8c3e-a636e94caa8f'}, {'abstract': 'Alice Munro’s latest story collection includes “the first and last — and the closest — things I have to say about my own life.”', 'web_url': 'https://www.nytimes.com/2012/11/18/books/review/dear-life-stories-by-alice-munro.html', 'snippet': 'Alice Munro’s latest story collection includes “the first and last — and the closest — things I have to say about my own life.”', 'lead_paragraph': 'That Alice Munro, now 81, is one of the great short story writers not just of our time but of any time ought to go without saying by now. This new volume — her 14th, not counting a collection of selected stories that came out in 1996 — is further proof of her mastery, and also a reminder that unlike a lot of accomplished short story writers — unlike William Trevor, say, her only living rival — Munro did not hit a characteristic note early on and then stick with it. Over the years her work has deepened and enlarged. At the end of “Dear Life” is a suite of four stories that Munro says are “autobiographical in feeling, though not, sometimes, entirely so in fact,” and she adds: “I believe they are the first and last — and the closest — things I have to say about my own life.” They seem to me as good as anything she has ever done, but also to strike out in the direction of a new, late style — one that is not so much a departure as a compressing or summing up of her whole career.', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/1118-McGrath/1118-McGrath-jumbo.jpg', 'height': 1024, 'width': 962, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/1118-McGrath/1118-McGrath-superJumbo.jpg', 'height': 2048, 'width': 1925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/1118-McGrath/1118-McGrath-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/books/review/1118-McGrath/1118-McGrath-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/1118-McGrath/1118-McGrath-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Sense of an Ending', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Sense of an Ending', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Munro, Alice', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-16T15:28:29+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Charles McGrath', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'McGrath', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/87ab4e4f-aee3-5598-9574-17526eb84df2', 'word_count': 1335, 'uri': 'nyt://article/87ab4e4f-aee3-5598-9574-17526eb84df2'}, {'abstract': 'After living in the city for 12 years, discovering the secret corners that guidebooks can miss.', 'web_url': 'https://www.nytimes.com/2012/11/18/travel/my-hidden-prague.html', 'snippet': 'After living in the city for 12 years, discovering the secret corners that guidebooks can miss.', 'lead_paragraph': 'STRAINS of soaring voices echoed down the well-worn cobblestones of Prague’s Old Town. For days, leaving the neo-Baroque library where I write, I’d heard the same music spilling down Bartolomejska Street — though like a ghost it always seemed to disappear just as I approached. Making a guess, I stuck my head through the doorway of what seemed to be an abandoned building with peeling plaster and dingy windows. Inside, weird paintings decorated the walls, and rough-hewn furniture had been cobbled together. As I entered a long, dark room, a chorus of young women returned to their task: knocking out a spot-on, spine-tingling version of Mozart’s Requiem in the middle of a lazy afternoon.', 'print_section': 'TR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE_SPAN/18PRAGUE_SPAN-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/18/travel/18PRAGUE_SPAN/18PRAGUE_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE_SPAN/18PRAGUE-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE_SPAN/18PRAGUE-superJumbo.jpg', 'height': 1355, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE_SPAN/18PRAGUE_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/travel/18PRAGUE_SPAN/18PRAGUE_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18PRAGUE_SPAN/18PRAGUE_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Hidden Prague', 'kicker': None, 'content_kicker': None, 'print_headline': 'My Hidden Prague', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Prague (Czech Republic)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-16T15:29:07+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Evan Rail', 'person': [{'firstname': 'Evan', 'middlename': None, 'lastname': 'Rail', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e925c91b-c2d9-550f-b565-313273d3805b', 'word_count': 2051, 'uri': 'nyt://article/e925c91b-c2d9-550f-b565-313273d3805b'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/11/16/what-were-reading-569/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'The New York Times: Oh no! Hostess really is shutting down (though its Twinkies and Ding Dongs could someday be baked by a new owner). Back when Hostess filed bankruptcy, the Dining section offered some relief. — Susan Edgerley', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-16T15:30:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/b28db716-001a-5e14-a081-006663674a5e', 'word_count': 458, 'uri': 'nyt://article/b28db716-001a-5e14-a081-006663674a5e'}, {'abstract': 'On a trip to Washington State’s Desolation Peak, where Jack Kerouac spent a summer as a fire lookout, connecting the place, the person and his prose.', 'web_url': 'https://www.nytimes.com/2012/11/18/travel/climbing-a-peak-that-stirred-kerouac.html', 'snippet': 'On a trip to Washington State’s Desolation Peak, where Jack Kerouac spent a summer as a fire lookout, connecting the place, the person and his prose.', 'lead_paragraph': 'I PASSED through a stand of fir and out onto the bare ridge, and there it was: the squat white structure where Jack Kerouac spent 63 days as a fire lookout in the summer of 1956. I had assumed that the Desolation Peak lookout would be empty, a silent monument to the Voice of the Beat Generation. But the shutters were propped open on all four sides, the door was ajar, and inside a small, seated silhouette was visible against the hazy late-afternoon sky.', 'print_section': 'TR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18FOOTSTEPS2_SPAN-sf/18FOOTSTEPS2_SPAN-articleLarge-v2.jpg', 'height': 479, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/18/travel/18FOOTSTEPS2_SPAN-sf/18FOOTSTEPS2_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 479}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18FOOTSTEPS2_SPAN-sf/18FOOTSTEPS2-jumbo.jpg', 'height': 1024, 'width': 793, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/travel/18FOOTSTEPS2_SPAN-sf/18FOOTSTEPS2-superJumbo.jpg', 'height': 2048, 'width': 1586, 