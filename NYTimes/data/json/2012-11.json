'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Portland (Ore)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Miami (Fla)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-14T23:02:10+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Great Homes & Destinations', 'byline': {'original': 'By Mike Powell', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Powell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/83bff436-e7fa-5c1c-9dbb-94b69ccc3941', 'word_count': 1114, 'uri': 'nyt://article/83bff436-e7fa-5c1c-9dbb-94b69ccc3941'}, {'abstract': 'Frederick W. Humphries II, a counterterrorism agent, took the initial complaint from Jill Kelley about e-mails accusing  her of inappropriate behavior toward David H. Petraeus.', 'web_url': 'https://www.nytimes.com/2012/11/15/us/frederick-humphries-fbi-agent-in-petraeus-case.html', 'snippet': 'Frederick W. Humphries II, a counterterrorism agent, took the initial complaint from Jill Kelley about e-mails accusing  her of inappropriate behavior toward David H. Petraeus.', 'lead_paragraph': 'DOVER, Fla. — The F.B.I. agent who spurred the investigation that led to the resignation of David H. Petraeus as C.I.A. director is a “hard-charging” veteran who helped investigate the foiled millennium terrorist plot in 1999, colleagues said on Wednesday.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/15/us/15petraeus_inline/15petraeus_inline-jumbo.jpg', 'height': 1024, 'width': 685, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank':