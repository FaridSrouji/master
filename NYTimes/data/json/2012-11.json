s.', 'print_section': 'SR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Landslide Loss for Big Money', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Landslide Loss for Big Money', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Campaign Finance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Political Action Committees', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-10T19:04:07+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/436fc181-1efa-5566-83c5-02db21226fcb', 'word_count': 587, 'uri': 'nyt://article/436fc181-1efa-5566-83c5-02db21226fcb'}, {'abstract': 'Will they help advance health care reform by setting up insurance exchanges?', 'web_url': 'https://www.nytimes.com/2012/11/11/opinion/sunday/the-choice-confronting-republican-governors.html', 'snippet': 'Will they help advance health care reform by setting up insurance exchanges?', 'lead_paragraph': 'Republican governors and legislators routinely rail against federal intrusion in activities that they think would be better managed by the states. This week they will have a chance to show that they really mean it. ', 'print_section': 'SR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Choice Confronting Republican Governors', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Choice Confronting Republican Governors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Reform and Reorganization', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Governors (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-10T19:04:07+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/f6936b24-4470-55a8-8042-33c6db075820', 'word_count': 537, 'uri': 'nyt://article/f6936b24-4470-55a8-8042-33c6db075820'}, {'abstract': 'Who is this “Mitt Romney” fellow, anyway?', 'web_url': 'https://www.nytimes.com/2012/11/11/opinion/sunday/what-election.html', 'snippet': 'Who is this “Mitt Romney” fellow, anyway?', 'lead_paragraph': 'The former Republican presidential nominee Mitt Romney, asked how he was feeling after his loss to President Obama, vehemently denied that he ran for president, calling the accusation laughable.', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Election?', 'kicker': 'Loose Ends', 'content_kicker': None, 'print_headline': 'What Election?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-10T19:05:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By John Kenney', 'person': [{'f