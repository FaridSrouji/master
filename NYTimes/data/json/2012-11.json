ame': 'organizations', 'value': 'Goldman Sachs Group Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-05T02:01:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Susanne Craig', 'person': [{'firstname': 'Susanne', 'middlename': None, 'lastname': 'Craig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fbb061a3-f846-563a-887f-93919241cc06', 'word_count': 710, 'uri': 'nyt://article/fbb061a3-f846-563a-887f-93919241cc06'}, {'abstract': 'The PowerShare Series is using retired stars like Andre Agassi and Pete Sampras to bring new tennis events to several United States cities, including some abandoned by top-level events.', 'web_url': 'https://www.nytimes.com/2012/11/05/sports/tennis/sampras-and-agassi-among-retired-stars-on-new-tennis-tour.html', 'snippet': 'The PowerShare Series is using retired stars like Andre Agassi and Pete Sampras to bring new tennis events to several United States cities, including some abandoned by top-level events.', 'lead_paragraph': 'Nine years ago, Mark Coronado sat courtside at the State Farm Classic, the WTA tour’s only stop in the Phoenix area, and thought to himself, “There just isn’t any energy at this event.”', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Former Stars Bring Back Fall Tennis To New York', 'kicker': None, 'content_kicker': None, 'print_headline': 'Former Stars Bring Back Fall Tennis To New York', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sampras, Pete', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'AGASSI, ANDRE', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Courier, Jim', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-05T02:02:23+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Nicholas McCarvel', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'McCarvel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/82a011dd-3f1c-5230-90ac-73afc493edf9', 'word_count': 725, 'uri': 'nyt://article/82a011dd-3f1c-5230-90ac-73afc493edf9'}, {'abstract': 'Whoever wins, the campaign has solidified (or restored) Bill Clinton’s status as the hardest-working man in a game he loves and plays like no one else.', 'web_url': 'https://www.nytimes.com/2012/11/05/us/politics/bill-clinton-presses-on-in-campaign-for-barack-obama.html', 'snippet': 'Whoever wins, the campaign has solidified (or restored) Bill Clinton’s status as the hardest-working man in a game he loves and plays like no one else.', 'lead_paragraph': 'RALEIGH, N.C. — By Sunday, Bill Clinton sounded awful, as if he had been gargling with Liquid-Plumr. You could hear his voice dying steadily over the last 72 hours of campaigning: hoarse Friday in Florida, cracking Saturday across Virginia and dissolving fully to a slight husk here Sunday, after two stops in New Hampshire and before another in Minnesota. ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/us/politics/sub-05clinton/sub-05clinton-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/05/us/politics/sub-05clinton/sub-05clinton-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/us/politi