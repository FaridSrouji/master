bject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-26T02:18:08+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/228494eb-c883-590d-b655-16edda010c47', 'word_count': 324, 'uri': 'nyt://article/228494eb-c883-590d-b655-16edda010c47'}, {'abstract': 'White House officials are reaching out to voters who supported President Obama during the campaign and asking them to help him as he negotiates with Congress.', 'web_url': 'https://www.nytimes.com/2012/11/26/us/politics/white-house-turns-to-obama-voters-for-support.html', 'snippet': 'White House officials are reaching out to voters who supported President Obama during the campaign and asking them to help him as he negotiates with Congress.', 'lead_paragraph': 'WASHINGTON — When Tea Party activists swamped town hall-style meetings about health care in the summer of 2009, President Obama’s army of campaign volunteers largely stayed away, seemingly less interested in fighting for legislation than they had been in electing the nation’s first African-American president.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/us/JP-ROOTS/JP-ROOTS-articleLarge.jpg', 'height': 314, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/26/us/JP-ROOTS/JP-ROOTS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 314}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/us/JP-ROOTS/JP-ROOTS-jumbo.jpg', 'height': 535, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/us/JP-ROO