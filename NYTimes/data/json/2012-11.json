humbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Oprah at a Crossroads', 'kicker': None, 'content_kicker': None, 'print_headline': 'Oprah at a Crossroads', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Oprah Winfrey Network', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'O: The Oprah Magazine', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Winfrey, Oprah', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Magazines', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-25T21:50:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Christine Haughney', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Haughney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f9ecdba-237a-5007-9bf1-8547e34f8773', 'word_count': 1727, 'uri': 'nyt://article/5f9ecdba-237a-5007-9bf1-8547e34f8773'}, {'abstract': 'The New York Philharmonic paired a furiously intense Shostakovich violin concerto with Dvorak’s “New World” Symphony.', 'web_url': 'https://www.nytimes.com/2012/11/26/arts/music/frank-peter-zimmermann-and-philharmonic-play-shostakovich.html', 'snippet': 'The New York Philharmonic paired a furiously intense Shostakovich violin concerto with Dvorak’s “New World” Symphony.', 'lead_paragraph': 'Besides its buoyant, graceful glow, Mendelssohn’s overture to his light opera “Die Heimkehr aus der Fremde” (often translated as “Son and Stranger”) has a particularly attractive quality: its rarity. Though it was composed in 1829, the piece had never been performed by the New York Philharmonic until last week.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/arts/PHIL1/PHIL1-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/arts/PHIL1/PHIL1-superJumbo.jpg', 'height': 1257, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'When the Fiery and the Quietly Expansive Have Much in Common', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'When the Fiery and the Quietly Expansive Have Much in Common', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Zimmermann, Frank Peter', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Boreyko, Andrey', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-25T21:52:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2f1538a4-4353-58d3-b850-6bc7b8be951f', 'word_count': 397, 'uri': 'nyt://article/2f1538a4-4353-58d3-b850-6bc7b8be951f'}, {'abstract': 'The “perfect” God that philosophers have tried and failed to establish is nowhere to be found. Not even in the Bible.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/11/25/an-imperfect-god/', 'snippet': 'The “perfect” God that philosophers have tried and failed to establish is nowhere to be found. Not even in the Bible.', 'lead_paragraph': 'Is God perfect? You often hear philosophers describe “theism” as the belief in a perfect being — a being whose attributes are said to include being all-powerful, all-knowing, immutable, perfectly good, perfectly simple, and necessarily existent (among others). And today, something like this view is common among lay people as well.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/opinion/24stone-godart/24stone-godart-jumbo.jpg', 'height': 834, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/opinion/24stone-godart/24stone-godart-superJumbo.jpg', 'height': 1669, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/opinion/24stone-godart/24stone-godart-thumbStandard-v2.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/24/opinion/24stone-godart/24stone-godart-thumbStandard-v2.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/24/opinion/24stone-godart/24stone-godart-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Imperfect God', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bible', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-25T22:00:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Yoram Hazony', 'person': [{'firstname': 'Yoram', 'middlename': None, 'lastname': 'Hazony', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bfbdc36-6fe1-5810-9374-e957f34532a3', 'word_count': 1357, 'uri': 'nyt://article/6bfbdc36-6fe1-5810-9374-e957f34532a3'}, {'abstract': 'Young adult fiction has been a bright spot in publishing, and HarperCollins hopes to take advantage of growth in that area with a new digital imprint, HarperTeen Impulse.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/11/25/harpercollins-imprint-aims-at-lucrative-young-adult-market/', 'snippet': 'Young adult fiction has been a bright spot in publishing, and HarperCollins hopes to take advantage of growth in that area with a new digital imprint, HarperTeen Impulse.', 'lead_paragraph': 'The young adult category is perhaps the hottest market in publishing, so it is no surprise that industry executives are looking for every possible entry point. HarperCollins’s latest effort, to be announced Monday, is a digital imprint focusing on young adult short stories and novellas.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'HarperCollins Imprint Aims at Lucrative Young Adult Market', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'A New Imprint for E-Books', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'HarperCollins Publishers', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-25T22:05:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Leslie Kaufman', 'person': [{'firstname': 'Leslie', 'middlename': None, 'lastname': 'Kaufman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3d671e89-7a53-5d47-bc85-e0acba4915f2', 'word_count': 275, 'uri': 'nyt://article/3d671e89-7a53-5d47-bc85-e0acba4915f2'}, {'abstract': 'Moviegoers are in for an unusually manly month from mid-January to mid-February, with at least six guns-and-gangster films scheduled for release.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/11/25/a-manly-month-for-movies-approaches/', 'snippet': 'Moviegoers are in for an unusually manly month from mid-January to mid-February, with at least six guns-and-gangster films scheduled for release.', 'lead_paragraph': 'LOS ANGELES — As a rule, there is no logic to clusters and coincidences that find like-minded movies suddenly piled on top of one another. In 2002 and 2003, the writer and director Ron Shelton had credits on three police-themed movies — “Dark Blue,” “Hollywood Homicide” and “Bad Boys II.” But that didn’t mean the cop genre was back. And two overlapping Truman Capote films in 2005 and 2006, “Capote” and “Infamous,” were not a trend.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Manly Month for Movies Approaches', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'More Manly Movies, Coming Soon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Lions Gate Entertainment Corporation', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Warner Brothers', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-25T22:13:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63eac7e1-fbbf-51b7-a8aa-e4b8e537d0bf', 'word_count': 260, 'uri': 'nyt://article/63eac7e1-fbbf-51b7-a8aa-e4b8e537d0bf'}, {'abstract': 'The two-day Nail Life Master Pairs was won on Saturday night by Zia Mahmood of New York City and Chip Martel of Davis, Calif.', 'web_url': 'https://www.nytimes.com/2012/11/26/crosswords/bridge/bridge-nail-life-master-pairs.html', 'snippet': 'The two-day Nail Life Master Pairs was won on Saturday night by Zia Mahmood of New York City and Chip Martel of Davis, Calif.', 'lead_paragraph': 'SAN FRANCISCO — The two-day Nail Life Master Pairs was won here on Saturday night by Zia Mahmood of New York City and Chip Martel of Davis, Calif. They finished more than one-and-two-thirds boards ahead of Cecilia Rimstedt from Sweden and Meike Wortel from the Netherlands. Third were Joao Paulo Campos and Miguel Villas-Boas from Brazil.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Nail Life Master Pairs', 'kicker': 'Bridge', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bridge (Card Game)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cards and Card Games', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-25T22:23:47+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Crosswords & Games', 'subsection_name': 'Bridge', 'byline': {'original': 'By Phillip Alder', 'person': [{'firstname': 'Phillip', 'middlename': None, 'lastname': 'Alder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/17a866f4-dda4-5319-acc6-783f3d3612d0', 'word_count': 346, 'uri': 'nyt://article/17a866f4-dda4-5319-acc6-783f3d3612d0'}, {'abstract': 'The documentary “The Gatekeepers” explores Israel’s history, present and future through the eyes of six former heads of the internal security agency Shin Bet.', 'web_url': 'https://www.nytimes.com/2012/11/26/movies/the-gatekeepers-documentary-by-israeli-director-dror-moreh.html', 'snippet': 'The documentary “The Gatekeepers” explores Israel’s history, present and future through the eyes of six former heads of the internal security agency Shin Bet.', 'lead_paragraph': '“The Gatekeepers,” a new documentary by the Israeli director Dror Moreh, consists of interviews with six men, all of them retired, most of them bald, one of them a grandfatherly type, well into his 80s, in suspenders and a plaid shirt. They reminisce about past triumphs and frustrations, but Mr. Moreh’s amazing, upsetting film, which opens Monday for a weeklong awards-qualifying run in advance of a wider release next year, is the opposite of nostalgic. It is hard to imagine a movie about the Middle East that could be more timely, more painfully urgent, more challenging to conventional wisdom on all sides of the conflict.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/arts/GATEKEEPER/GATEKEEPER-jumbo.jpg', 'height': 675, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/arts/GATEKEEPER/GATEKEEPER-superJumbo.jpg', 'height': 1349, 'width': 2046, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/arts/GATEKEEPER/GATEKEEPER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/26/arts/GATEKEEPER/GATEKEEPER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/arts/GATEKEEPER/GATEKEEPER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Six Israeli Spymasters on a Shadowy Past and a Dark Future', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Six Israeli Spymasters on a Shadowy Past and a Dark Future', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Shin Bet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-25T22:26:32+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6ad215a2-204c-5f7b-8460-d54557897c1d', 'word_count': 833, 'uri': 'nyt://article/6ad215a2-204c-5f7b-8460-d54557897c1d'}, {'abstract': 'There were two double world champions vying for the record of the youngest triple world champion. But in the end, it was the younger of the two, Sebastian Vettel, who took the record.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/11/25/vettel-becomes-youngest-f1-triple-champion-in-history-but-alonso-proves-hes-a-winner-too/', 'snippet': 'There were two double world champions vying for the record of the youngest triple world champion. But in the end, it was the younger of the two, Sebastian Vettel, who took the record.', 'lead_paragraph': 'SÃO PAULO — There could not have been a more suspenseful end to the 2012 Formula One season than that of the Brazilian Grand Prix on Sunday. And no matter who a fan might have been rooting for, how would it be possible to say that either of the two finalists Sebastian Vettel of Red Bull or Fernando Alonso of Ferrari merited the title more than the other — each vying to become the youngest three-time winner in Formula One history?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/blogs/26rdv-vettel-champ-f1/26rdv-vettel-champ-f1-jumbo.jpg', 'height': 662, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/blogs/26rdv-vettel-champ-f1/26rdv-vettel-champ-f1-superJumbo.jpg', 'height': 1324, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/blogs/26rdv-vettel-champ-f1/26rdv-vettel-champ-f1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/26/blogs/26rdv-vettel-champ-f1/26rdv-vettel-champ-f1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/blogs/26rdv-vettel-champ-f1/26rdv-vettel-champ-f1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Vettel Becomes Youngest F1 Triple Champion in History', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Racing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ALONSO, FERNANDO', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Button, Jenson', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Senna, Ayrton', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Vettel, Sebastian', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Formula One', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-25T22:29:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Brad Spurgeon', 'person': [{'firstname': 'Brad', 'middlename': None, 'lastname': 'Spurgeon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74c16fec-d229-5910-b89f-0e101ccb444b', 'word_count': 628, 'uri': 'nyt://article/74c16fec-d229-5910-b89f-0e101ccb444b'}, {'abstract': '“Sinister Pop,” an exhibition at the Whitney, draws links between the consumerism of early 1960s Pop Art and the counterculture sentiment in Pop that soon followed.', 'web_url': 'https://www.nytimes.com/2012/11/26/arts/design/sinister-pop-at-the-whitney.html', 'snippet': '“Sinister Pop,” an exhibition at the Whitney, draws links between the consumerism of early 1960s Pop Art and the counterculture sentiment in Pop that soon followed.', 'lead_paragraph': 'Pop Art is big money at auction these days, and big box office at museums; witness “Regarding Warhol” at the Met and the touring Lichtenstein survey now at the National Gallery. And with Pop’s popularity comes pressure on museums to make it new, to stop serving up the same old Coke bottles and Brillo boxes.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type