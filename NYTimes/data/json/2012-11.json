very', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'Discovery Cancels ‘Dirty Jobs’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Reality Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rowe, Mike', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Discovery Channel', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-21T18:10:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5d692e2-4bb0-599e-92e0-b8181865c4c2', 'word_count': 215, 'uri': 'nyt://article/c5d692e2-4bb0-599e-92e0-b8181865c4c2'}, {'abstract': 'Andrew Solomon writes about families of individuals affected by a spectrum of cognitive, physical or psychological differences.', 'web_url': 'https://www.nytimes.com/2012/11/25/books/review/far-from-the-tree-by-andrew-solomon.html', 'snippet': 'Andrew Solomon writes about families of individuals affected by a spectrum of cognitive, physical or psychological differences.', 'lead_paragraph': 'How does it feel to be the mother of a teenage dwarf who’s desperate to start dating? What if you love the daughter you conceived when you were raped but can’t bear to be touched by her? And, as the father of a happy, yet profoundly deaf son who’s forgotten how it feels to hear, how do you deal with your memories of the times you played music together?', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/25/books/review/1125-Meyerson/1125-Meyerson-jumbo.jpg', 'height': 1024, 'width': 698, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/25/books/review/1125-Meyerson/1125-Meyerson-superJumbo.jpg', 'height': 2048, 'width': 1396, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/25/books/review/1125-Meyerson/1125-Meyerson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/25/books/review/1125-Meyerson/1125-Meyerson-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/25/books/review/1125-Meyerson/1125-Meyerson-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Coming Into Their Own', 'kicker': None, 'content_kicker': None, 'print_headline': 'Coming Into Their Own', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Families and Family Life', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Disabilities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Solomon, Andrew', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-21T18:17:13+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Julie Myerson', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Myerson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_