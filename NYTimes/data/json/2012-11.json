credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/02APPS3/02APPS3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Shakespeare', 'kicker': None, 'content_kicker': None, 'print_headline': 'Shakespeare', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Shakespeare, William', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-30T16:34:39+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By J. D. Biersdorfer', 'person': [{'firstname': 'J.', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2b8a355a-d99f-58b5-b9ca-85bd8d158c5e', 'word_count': 861, 'uri': 'nyt://article/2b8a355a-d99f-58b5-b9ca-85bd8d158c5e'}, {'abstract': 'New books featuring bears, including “Bear Despair,” a wordless book by the French illustrator Gaëtan Dorémus.', 'web_url': 'https://www.nytimes.com/2012/12/02/books/review/bear-despair-by-gaetan-doremus-and-more.html', 'snippet': 'New books featuring bears, including “Bear Despair,” a wordless book by the French illustrator Gaëtan Dorémus.', 'lead_paragraph': 'Americans tend to be xenophobic when purchasing books for children. Few translated classics exist, apart from Jean de Brunhoff’s “Babar” and Astrid Lindgren’s “Pippi Longstocking” series. Few translations ever appear on the New York Times children’s best-seller lists. Yet in this age of global interdependence, books that show different ways of looking at experience seem ever more necessary. Three recent titles featuring a bear, though radically different in tone and feeling, allow readers to observe this naturally intriguing creature from distinct cultural points of view — French, American and Dutch.', 'print_section': 'BR', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Silvey01/1202-Silvey01-articleLarge.jpg', 'height': 326, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/12/02/books/review/1202-Silvey01/1202-Silvey01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 326}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Silvey01/1202-Silvey01-jumbo.jpg', 'height': 558, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Silvey01/1202-Silvey01-superJumbo.jpg', 'height': 1116, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Silvey01/1202-Silvey01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/12/02/books/review/1202-Silvey01/1202-Silvey01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Silvey01/1202-Silvey01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Three Bears', 'kicker': "Children's Books", 'content_kicker': None, 'print_headline': 'Three Bears', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Doremus, Gaetan', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tolman, Ronald', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hallensleben, Georg', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Banks, Kate', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-30T16:35:22+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Anita Silvey', 'person': [{'firstname': 'Anita', 'middlename': None, 'lastname': 'Silvey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f257c3fe-42a9-5fed-8e5d-ca4499b89710', 'word_count': 943, 'uri': 'nyt://article/f257c3fe-42a9-5fed-8e5d-ca4499b89710'}, {'abstract': 'Philip Pullman tells 50 fairy tales in a straightforward manner, hewing closely to the Grimm originals.', 'web_url': 'https://www.nytimes.com/2012/12/02/books/review/philip-pullmans-fairy-tales-from-the-brothers-grimm.html', 'snippet': 'Philip Pullman tells 50 fairy tales in a straightforward manner, hewing closely to the Grimm originals.', 'lead_paragraph': 'The group of 20th-century philosophers known as the Brady Bunch assured us that transmogrification is inevitable. “When it’s time to change, then it’s time to change,” they warbled in syllogistic harmony. And right now, culture-makers seem to feel that it’s time to change the classic fairy tale.', 'print_section': 'BR', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Once Upon a Time', 'kicker': None, 'content_kicker': None, 'print_headline': 'Once Upon A Time', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Grimm, Wilhelm', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Pullman, Philip', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Grimm, Jacob', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fairy Tales', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-30T16:35:46+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marjorie Ingall', 'person': [{'firstname': 'Marjorie', 'middlename': None, 'lastname': 'Ingall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/43ea2308-7c1a-5b79-b70d-f0658e07a639', 'word_count': 868, 'uri': 'nyt://article/43ea2308-7c1a-5b79-b70d-f0658e07a639'}, {'abstract': 'The essays in “Always Looking” display the qualifications of a novelist that John Updike brought to his moonlighting as an art critic.', 'web_url': 'https://www.nytimes.com/2012/12/02/books/review/always-looking-by-john-updike.html', 'snippet': 'The essays in “Always Looking” display the qualifications of a novelist that John Updike brought to his moonlighting as an art critic.', 'lead_paragraph': 'One of the most beautiful things ever written about visual art is Zbigniew Herbert’s “Still Life With a Bridle,” a book-length study of Dutch painting. Another is “The Birds of Paolo Uccello,” Italo Calvino’s fanciful essay about why there aren’t more birds in the oeuvre of a painter whose name means bird. To this list one could add Charles Simic’s book on Joseph Cornell, “Dime-Store Alchemy,” and Mark Strand’s monograph on Edward Hopper. And “Remembrance of Things Past” is full of meditations on art that we may want to copy out and have embroidered on samplers.', 'print_section': 'BR', 'print_page': '54', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Prose/1202-Prose-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/12/02/books/review/1202-Prose/1202-Prose-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Prose/1202-Prose-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Prose/1202-Prose-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Prose/1202-Prose-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/12/02/books/review/1202-Prose/1202-Prose-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Prose/1202-Prose-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Updike on Art', 'kicker': None, 'content_kicker': None, 'print_headline': 'Updike on Art', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Carduff, Christopher', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Updike, John', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-30T16:38:03+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Francine Prose', 'person': [{'firstname': 'Francine', 'middlename': None, 'lastname': 'Prose', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/029a9123-2f9e-51de-825d-6b6721e6ae07', 'word_count': 1206, 'uri': 'nyt://article/029a9123-2f9e-51de-825d-6b6721e6ae07'}, {'abstract': 'China’s People’s Daily apparently fell for a parody by The Onion when it reported Nov. 27 that North Korean ruler Kim Jong-un had been named “Sexiest Man Alive for 2012.”', 'web_url': 'https://www.nytimes.com/2012/11/30/opinion/global/kim-jong-un-sexiest-man-alive.html', 'snippet': 'China’s People’s Daily apparently fell for a parody by The Onion when it reported Nov. 27 that North Korean ruler Kim Jong-un had been named “Sexiest Man Alive for 2012.”', 'lead_paragraph': 'China’s\xa0People’s Daily apparently fell for a parody by The Onion, the satirical newspaper and Web site, when it reported Nov. 27 that North Korean ruler Kim Jong-un had been named “Sexiest Man Alive for 2012.” ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/opinion/global/iht-30-heng/iht-30-heng-articleLarge.jpg', 'height': 429, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/30/opinion/global/iht-30-heng/iht-30-heng-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 429}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/opinion/global/iht-30-heng/iht-30-heng-jumbo.jpg', 'height': 724, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/opinion/global/iht-30-heng/iht-30-heng-superJumbo.jpg', 'height': 1448, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Kim Jong-un: Sexiest Man Alive?', 'kicker': 'Heng', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kim Jong-un', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'North Korea', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-30T16:39:28+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Global Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b6cceb72-7a92-5fa6-9ba8-d43623e133cd', 'word_count': 36, 'uri': 'nyt://article/b6cceb72-7a92-5fa6-9ba8-d43623e133cd'}, {'abstract': 'The British photographer Tim Walker has become known for collaborating with a team of makeup artists, painters and builders to construct elaborate sets full of ingenious props.', 'web_url': 'https://www.nytimes.com/2012/12/02/books/review/tim-walker-story-teller.html', 'snippet': 'The British photographer Tim Walker has become known for collaborating with a team of makeup artists, painters and builders to construct elaborate sets full of ingenious props.', 'lead_paragraph': 'Telling stories with pictures is not new. In the 1950s, Richard Avedon famously used a series of fashion photographs to construct fictional narratives, a technique affectionately depicted in the film “Funny Face,” in which Audrey Hepburn, posing for a fashion story inspired by “Anna Karenina,” asks the Avedon character, played by Fred Astaire, if she should throw herself in front of a train. The narrative powers of fashion photography have continued to play a central role here; in fact the Museum of Modern Art’s first exhibition devoted exclusively to the genre was entitled “Fashioning Fiction in Photography Since 1990.” In recent years, technical developments in digital photography have led many photographers to tell stories by artificially enhancing or manipulating their images on the computer. By contrast, the British photographer Tim Walker has become known for collaborating with a team of makeup artists, painters and builders to construct elaborate sets full of ingenious props. ', 'print_section': 'BR', 'print_page': '60', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202STEELE/1202STEELE-articleLarge.jpg', 'height': 379, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/12/02/books/review/1202STEELE/1202STEELE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 379}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202STEELE/1202STEELE-jumbo.jpg', 'height': 647, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202STEELE/1202STEELE-superJumbo.jpg', 'height': 1293, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202STEELE/1202STEELE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/12/02/books/review/1202STEELE/1202STEELE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202STEELE/1202STEELE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 