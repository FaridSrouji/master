edia': [], 'headline': {'main': 'Wednesday Reading: The ‘Irrational Cheapskate’ Traveler Trap', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-28T13:10:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed08eb89-b17c-5f05-af9c-2611cb9092dd', 'word_count': 98, 'uri': 'nyt://article/ed08eb89-b17c-5f05-af9c-2611cb9092dd'}, {'abstract': 'It’s only business.', 'web_url': 'https://krugman.blogs.nytimes.com/2012/11/28/ich-bin-ein-berliner-or-something/', 'snippet': 'It’s only business.', 'lead_paragraph': 'A somewhat strange article in TNR about my relationship with Germany — strange because I didn’t know that I had a relationship with Germany. I think and talk a lot about the euro, which means that German economic policy becomes of crucial concern — and I obviously believe that German economic orthodoxy is misguided and a big problem. But as Tessio said, it was only business — and let me say that Berlin is a wonderful city.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ich Bin Ein Berliner, Or Something', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-28T13:21:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d5cc649-8b76-5cd1-95b4-33572a6bde