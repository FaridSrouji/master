large': 'images/2012/11/21/world/video-israel-121121/video-israel-121121-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/world/video-israel-121121/video-israel-121121-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/21/world/video-israel-121121/video-israel-121121-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Explosion Deepens Old Fears', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Gaza Strip', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Hamas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-22T01:41:50+0000', 'document_type': 'multimedia', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'Tamir Elterman', 'person': [{'firstname': 'Tamir', 'middlename': None, 'lastname': 'Elterman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/73418475-a81c-5d04-9fba-dc3492ee74ae', 'word_count': 0, 'uri': 'nyt://video/73418475-a81c-5d04-9fba-dc3492ee74ae'}, {'abstract': 'Once the hustle and bustle is over and the family is ready to feast, to Americans the world over, this is Thanksgiving.', 'web_url': 'https://www.nytimes.com/2012/11/22/opinion/when-thursday-vanishes-on-thanksgiving.html', 'snippet': 'Once the hustle and bustle is over and the family is ready to feast, to Americans the world over, this is Thanksgiving.', 'lead_paragraph': 'Over the years, we have come to love the fixedness of Thanksgiving. Always on a Thursday, by proclamation, this holiday is unmindful of anyone’s inconvenience. Even Christmas Day must fall on a weekend some years, but never Thanksgiving. It causes as much fuss as possible — a stir that disrupts the entire week, year after year. Yet when the last of the guests have arrived and everyone is seated at the table, there comes a pause, a toast, a grace — long or short, secular or sacred, vocal or silent — that says what this holiday is for. Thursday vanishes, and in its place is Thanksgiving.', 'print_section': 'A', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'When Thursday Vanishes', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'When Thursday Vanishes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Thanksgiving Day', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-22T01:42:12+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/086111a8-0f0e-571c-839f-4759393488f2', 'word_count': 324, 'uri': 'nyt://article/086111a8-0f0e-571c-839f-4759393488f2'}, {'abstract': 'The rise of crime on American Indian reservations is a moral atrocity. Tribes need the resources they were promised to maintain law and order.', 'web_url': 'https://www.nytimes.com/2012/11/22/opinion/lawlessness-rages-in-indian-country.html', 'snippet': 'The rise of crime on American Indian reservations is a moral atrocity. Tribes need the resources they were promised to maintain law and order.', 'lead_paragraph': 'Violence and crime rage unchecked in Indian country, yet the federal government, the primary law enforcer on reservations, is investigating and prosecuting fewer violent felonies, and reducing financing for tribal courts and public-safety programs. That is a scandal.', 'print_section': 'A', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lawlessness on Indian Land', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Lawlessness on Indian Land', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Native Americans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Crime Rates', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Navajo Indians', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Crime and Criminals', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Pine Ridge Indian Reservation (SD)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Fort Apache Indian Reservation (Ariz)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-22T01:42:16+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/8c662fd6-5834-54fe-8b25-6b48aa6ada06', 'word_count': 339, 'uri': 'nyt://article/8c662fd6-5834-54fe-8b25-6b48aa6ada06'}, {'abstract': 'A strong international treaty is needed to prevent thousands of needless deaths caused by counterfeit drugs.', 'web_url': 'https://www.nytimes.com/2012/11/22/opinion/the-problem-of-fake-and-useless-drugs.html', 'snippet': 'A strong international treaty is needed to prevent thousands of needless deaths caused by counterfeit drugs.', 'lead_paragraph': 'Global health authorities are making only fitful progress toward eliminating fake or substandard drugs that cause widespread suffering and death in the developing world. Delegates from 76 member countries of the World Health Organization met this week in Buenos Aires to lay the groundwork for more forceful action. ', 'print_se