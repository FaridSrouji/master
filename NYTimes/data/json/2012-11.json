ne': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/7e01b5e2-5f02-5bcb-921f-08468fcc4206', 'word_count': 0, 'uri': 'nyt://slideshow/7e01b5e2-5f02-5bcb-921f-08468fcc4206'}, {'abstract': 'No. 1 Alabama’s defense was battered by Louisiana State for 435 yards but a late drive led by quarterback A J McCarron helped the Crimson Tide stay undefeated.', 'web_url': 'https://www.nytimes.com/2012/11/04/sports/ncaafootball/late-drive-lifts-alabama-over-lsu.html', 'snippet': 'No. 1 Alabama’s defense was battered by Louisiana State for 435 yards but a late drive led by quarterback A J McCarron helped the Crimson Tide stay undefeated.', 'lead_paragraph': 'BATON ROUGE, La. — Death Valley went quiet. And above the lull, an unexpected, unbridled joy came from the southeast corner of Tiger Stadium. With pride and might, some called, “Roll Tide.” T. J. Yeldon had scored. Zach Mettenberger’s second half had been ruined. Louisiana State’s revenge was iced. ', 'print_section': 'SP', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sports/LSU/LSU-jumbo.jpg', 'height': 696, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sports/LSU/LSU-superJumbo.jpg', 'height': 1392, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sports/LSU/LSU-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Touchdown in Final Minute Saves Alabama and Stuns Death Valley', 'kicker': 'Alabama 21, L.S.U. 17', 'content_kicker': None, 'print_headline': 'Touchdown in Final Minute Saves Alabama and Stuns Death Valley', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Louisiana State University', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mettenberger, Zach', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'McCarron, A J', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Alabama', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-11-04T04:52:16+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Tim Rohan', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Rohan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2fd6dc15-2e8b-55c0-931e-d86e27e3b321', 'word_count': 1060, 'uri': 'nyt://article/2fd6dc15-2e8b-55c0-931e-d86e27e3b321'}, {'abstract': 'Professor Current was among the historians who raised the study of Abraham Lincoln to rigorous academic standards.', 'web_url': 'https://www.nytimes.com/2012/11/04/us/richard-n-current-civil-war-historian-dies-at-100.html', 'snippet': 'Professor Current was among the historians who raised the study of Abraham Lincoln to rigorous academic standards.', 'lead_paragraph': 'Richard N. Current, a Civil War historian whose award-winning scholarship helped demythologize Abraham Lincoln and raise Lincoln studies to a professional level of scholarly inquiry, died on Oct. 26 in Boston. He was 100. ', 'print_section': 'A', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/