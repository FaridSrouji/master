cle/33c2753c-1a04-5253-a567-33a1ff2bfcb4'}, {'abstract': 'A local NGO hosts a game of darts to highlight the limitations of Washington’s opportunistic policy toward Cambodia.', 'web_url': 'https://latitude.blogs.nytimes.com/2012/11/20/protests-greet-obamas-visit-to-cambodia/', 'snippet': 'A local NGO hosts a game of darts to highlight the limitations of Washington’s opportunistic policy toward Cambodia.', 'lead_paragraph': 'PHNOM PENH —\xa0 Theary Seng was taking aim with precision and anger. The 41-year-old U.S.-trained lawyer and a regular on Cambodia’s crowded protest circuit was about to throw a dart at a poster of former Secretary of State Henry Kissinger.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kissinger in Cambodia', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kissinger, Henry A', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nixon, Richard Milhous', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Pol Pot', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Asean', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Khmer Rouge', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Cambodia', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-20T11:21:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Luke Hunt', 'person': [{'firstname': 'Luke', 'middlename': None, 'lastname': 'Hunt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d0f12e5a-107e-5920-a245-549c9d853b2e', 'word_count': 800, 'uri': 'nyt://article/d0f12e5a-107e-5920-a245-549c9d853b2e'}, {'abstract': 'Andy Coulson and Rebekah Brooks will be charged with paying bribes of up to $160,000 to public officials, in addition to several earlier charges.', 'web_url': 'https://www.nytimes.com/2012/11/21/world/europe/former-murdoch-aides-to-be-charged-with-bribery.html', 'snippet': 'Andy Coulson and Rebekah Brooks will be charged with paying bribes of up to $160,000 to public officials, in addition to several earlier charges.', 'lead_paragraph': 'LONDON — In a new turn in the scandals swirling around Rupert Murdoch’s British newspaper outpost, prosecutors said on Tuesday that two former top executives would be charged with paying bribes of up to $160,000 to public officials, in addition to several earlier charges against them. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/global-home/21britain-image2/21britain-image2-jumbo.jpg', 'height': 767, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/global-home/21britain-image2/21britain-image2-superJumbo.jpg', 'height': 1535, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/global-home/21britain-image2/21britain-image2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/21/global-home/21britain-image2/21britain-image2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/global-home/21britain-image2/21britain-image2-thumbLarge.jpg', 'height': 150, 'width