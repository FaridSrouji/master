web_url': 'https://www.nytimes.com/2012/11/26/sports/football/in-win-over-packers-giants-lose-andre-brown-to-a-broken-fibula.html', 'snippet': 'Andre Brown, who has 8 of the Giants’ 14 rushing touchdowns, left the game after a 16-yard run with 10:55 to go.', 'lead_paragraph': 'EAST RUTHERFORD, N.J. — The Giants’ startlingly lopsided 38-10 win over the Green Bay Packers on Sunday night came at a price. Running back Andre Brown, who was enjoying a breakthrough season and had 8 of the team’s 14 rushing touchdowns, went down with a broken fibula.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/sports/football/26blue-1/26blue-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/sports/football/26blue-1/26blue-1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/sports/football/26blue-1/26blue-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/26/sports/football/26blue-1/26blue-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/26/sports/football/26blue-1/26blue-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Giants Lose Andre Brown to Broken Fibula', 'kicker': None, 'content_kicker': None, 'print_headline': 'Giants Lose Andre Brown to Broken Fibula', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value