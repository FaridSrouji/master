ualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d7169b99-3285-52ec-b91c-0d726ee294f6', 'word_count': 1061, 'uri': 'nyt://article/d7169b99-3285-52ec-b91c-0d726ee294f6'}, {'abstract': 'While the Kingston Trio gave folk a pop gloss, Mumford & Sons injects folk into rock.', 'web_url': 'https://www.nytimes.com/2012/11/13/booming/like-the-kingston-trio-try-mumford-sons.html', 'snippet': 'While the Kingston Trio gave folk a pop gloss, Mumford & Sons injects folk into rock.', 'lead_paragraph': 'Each week, Val Haller, the founder of the music Web site Valslist.com, matches music from her baby boom generation to music of her 20-something sons’ generation.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/13/booming/13match-booming-kingstontrio/13match-booming-kingstontrio-articleLarge.jpg', 'height': 371, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/13/booming/13match-booming-kingstontrio/13match-booming-kingstontrio-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 371}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/13/booming/13match-booming-kingstontrio/13match-booming-kingstontrio-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/13/booming/13match-booming-kingstontrio/13match-booming-kingstontrio-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/13/booming/13match-booming-kingstontrio/13match-booming-kingstontrio-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/13/booming/13match-booming-kingstontrio/13match-booming-kingstontrio-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/13/booming/13match-booming-kingstontrio/13match-booming-kingstontrio-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'If You Like the Kingston Trio. . .', 'kicker': 'Music Match', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Folk Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-13T21:58:56+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Val Haller', 'person': [{'firstname': 'Val', 'middlename': None, 'lastname': 'Haller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/20c7d2e7-c8eb-5dd6-8a1c-9c19b1937f5f', 'word_count': 726, 'uri': 'nyt://article/20c7d2e7-c8eb-5dd6-8a1c-9c19b1937f5f'}, {'abstract': 'A set decorator, who has worked with Wes Anderson and Kanye West, shows off her skills.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/11/13/timely-prop-star-kate-dougherty/', 'snippet': 'A set decorator, who has worked with Wes Anderson and Kanye West, shows off her skills.', 'lead_paragraph': 'Ever wonder where the campy bibelots in Wes Anderson’s films come from? The flags on the scouts’ canoes in “Moonrise Kingdom,” say, or the lanterns made of sticks? Meet one of the film’s assistant set decorators, Kate Dougherty. “I found fox and raccoon skins from a crazy dude in Virginia,” she says, perfectly enunciating her flair for the Americana style. Similar work can be seen in the décor she’s helped create for Manhattan boîtes like Wilfie & Nell, the Fat Radish and its new sister bar, the Leadbelly, a dimly lit oyster den filled with beat-up records and suitcases, an archery target and a checkers table. Dougherty, a Delaware native, has also decorated a Brooklyn high school for a Drake rap video directed by Kanye West and a dive-bar-themed wedding reception in Red Hook (with the design company Silkstone). For this shot, Dougherty created a photo booth in Paris, a project she sets up for events around the world. She spent days rummaging in antiques markets. “Wes Anderson, eat your heart out,” she says of the Parisian marchés. “He would have died in some of these places.” ', 'print_section': 'M2', 'print_page': '154', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Timely | Prop Star Kate Dougherty', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Prop Star', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'ANDERSON, WES', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-13T22:00:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Kathryn Branch', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Branch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/81990c5a-9df3-54bf-bcb1-7b69791666f1', 'word_count': 188, 'uri': 'nyt://article/81990c5a-9df3-54bf-bcb1-7b69791666f1'}, {'abstract': 'Le Palais des Thés makes its American debut on the Upper West Side this week, with a larger boutique to open in SoHo in December.', 'web_url': 'https://www.nytimes.com/2012/11/14/dining/a-french-tea-importer-opens-in-manhattan-food-stuff.html', 'snippet': 'Le Palais des Thés makes its American debut on the Upper West Side this week, with a larger boutique to open in SoHo in December.', 'lead_paragraph': 'Le Palais des Thés, a French tea importer and retailer, was started in 1987 by François-Xavier Delmas and since then has opened 28 boutiques in several countries. The 29th is its first in the United States and the first outside France that is not a franchise. It makes its debut in Manhattan on Thursday. The company name is a play on words: “palais” means “palace” or “palate” in French. This new branch is being run by Aurélie Bessière, right, a niece of Mr. Delmas, and will sell 84 teas from estates throughout Asia. The teas are available in tins, sachets or bulk. Herbal teas like mint and verbena are blended with South African rooibos. Gift boxes of tea assortments and tea-making accessories are available.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/14/dining/14STUFF_TEA/14STUFF2-jumbo.jpg', 'height': 1024, 'width': 682, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/14/dining/14STUFF_TEA/14STUFF2-superJumbo.jpg', 'height': 2048, 'width': 1363, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/14/dining/14STUFF_TEA/14STUFF_TEA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/14/dining/14STUFF_TEA/14STUFF_TEA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/14/dining/14STUFF_TEA/14STUFF_TEA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The French Like Their Tea as Well', 'kicker': 'Food Stuff ', 'content_kicker': None, 'print_headline': 'The French Like Their Tea as Well', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tea', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-13T22:15:01+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/205f7447-0fd5-552c-b16f-09cb07cebefb', 'word_count': 178, 'uri': 'nyt://article/205f7447-0fd5-552c-b16f-09cb07cebefb'}, {'abstract': 'Ben Roethlisberger’s shoulder sprain and Jay Cutler’s concussion left Pittsburgh and Chicago, respectively, brushing up their backup quarterback plans with conference leads at stake.', 'web_url': 'https://www.nytimes.com/2012/11/14/sports/football/steelers-and-bears-ready-second-string-quarterbacks.html', 'snippet': 'Ben Roethlisberger’s shoulder sprain and Jay Cutler’s concussion left Pittsburgh and Chicago, respectively, brushing up their backup quarterback plans with conference leads at stake.', 'lead_paragraph': 'With enough starting quarterbacks hurt to populate a MASH unit, the N.F.L. prepared for a weekend of backups playing in marquee games.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/14/sports/football/14steelers-pic/14steelers-pic-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name':