'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Green, A J', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cincinnati Bengals', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-12T21:34:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Jonathan Bales', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Bales', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31cb9401-5d22-506a-b235-7eaf4732f54b', 'word_count': 733, 'uri': 'nyt://article/31cb9401-5d22-506a-b235-7eaf4732f54b'}, {'abstract': 'Spurred by new realizations about the risks of breeding resistant bacteria, pediatricians have cut back on prescribing antibiotics.', 'web_url': 'https://well.blogs.nytimes.com/2012/11/12/antibiotics-are-a-gift-to-be-handled-with-care/', 'snippet': 'Spurred by new realizations about the risks of breeding resistant bacteria, pediatricians have cut back on prescribing antibiotics.', 'lead_paragraph': 'I should start by saying as clearly as I can that I love antibiotics. Recently I had dinner with a pediatrician friend, and she told me the story of the day’s sickest child. Before she sent the child to the emergency room in an ambulance, she told me, she gave her 50 milligrams per kilogram of ceftriaxone, a powerful antibiotic.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/13/science/13KLAS/13KLAS-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'cr