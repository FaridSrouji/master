ect', 'value': 'Theater', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-29T19:10:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Steven McElroy', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'McElroy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b33c82d-489d-567d-8241-8816ea930269', 'word_count': 339, 'uri': 'nyt://article/0b33c82d-489d-567d-8241-8816ea930269'}, {'abstract': 'Witch hunts and conspiracy theories abound in Washington.', 'web_url': 'https://takingnote.blogs.nytimes.com/2012/11/29/welcome-to-the-conspiracy-carnival/', 'snippet': 'Witch hunts and conspiracy theories abound in Washington.', 'lead_paragraph': 'It’s getting hard to keep up with all of the news from Washington — witch hunts, conspiracy theories and Republicans tearing each other apart over who is ideologically pure and who is apostate. It’s a real set of carnival sideshows.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Welcome to the Conspiracy Carnival', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Scott P', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'DeMint, Jim', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gohmert, Louis B Jr', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mourdock, Richard E', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Norquist, Grover G', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Rice, Susan E', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Libya', 'rank': 10, 'major': 'N'}], 'pub_date': '2012-11-29T19:10:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/daa0302f-6583-5826-89e7-569ee7bcb375', 'word_count': 652, 'uri': 'nyt://article/daa0302f-6583-5826-89e7-569ee7bcb375'}, {'abstract': 'A bitter controversy among geologists edged into the open when a report offered support for a hypothesis suggesting a much older Grand Canyon than the prevailing view.', 'web_url': 'https://www.nytimes.com/2012/11/30/science/earth/study-sees-older-grand-canyon-stirring-controversy.html', 'snippet': 'A bitter controversy among geologists edged into the open when a report offered support for a hypothesis suggesting a much older Grand Canyon than the prevailing view.', 'lead_paragraph': 'How old is the Grand Canyon? Old enough to be gazed on by dinosaurs, which died out 65 million years ago, or closer to six million years old, formed about when the earliest human ancestors began walking upright?', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/science/earth/30canyon/30canyon-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/30/science/earth/30canyon/30canyon-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/science/earth/30canyon/30canyon-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {