50, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Meaning in a Drawer Full of Old Family Snapshots', 'kicker': 'Shortcuts', 'content_kicker': None, 'print_headline': 'The Meaning in a Drawer Full of Old Family Snapshots', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-16T19:41:50+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Your Money', 'byline': {'original': 'By Alina Tugend', 'person': [{'firstname': 'Alina', 'middlename': None, 'lastname': 'Tugend', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/19dc1d59-f396-5c7c-84d4-a6409a8c4230', 'word_count': 1308, 'uri': 'nyt://article/19dc1d59-f396-5c7c-84d4-a6409a8c4230'}, {'abstract': 'Despite its huge global audience, Formula One has struggled in the United States, but on Sunday the circuit returned to America for the first time in five years with a race in Texas.', 'web_url': 'https://www.nytimes.com/2012/11/18/automobiles/a-truly-foreign-concept-formula-one-in-texas.html', 'snippet': 'Despite its huge global audience, Formula One has struggled in the United States, but on Sunday the circuit returned to America for the first time in five years with a race in Texas.', 'lead_paragraph': 'WHEN the first Grand Prix of the Automobile Club of France was held in 1906, the course was some 64 miles of poorly surfaced public roads near the city of Le Mans, and the event was scheduled for six laps on each of two days, about 769 miles in all. The winner, whose total time was 12 hours and 12 minutes, finished 32 minutes in front of the runner-up, with an average speed close to 63 miles an hour.', 'print_section': 'AU', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/automobiles/18AUST/18AUST-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/18/automobiles/18AUST/18AUST-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/automobiles/18AUST/18AUST-jumbo.jpg', 'height': 614, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/automobiles/18AUST/18AUST-superJumbo.jpg', 'height': 1227, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/automobiles/18AUST/18AUST-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/automobiles/18AUST/18AUST-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/automobiles/18AUST/18AUST-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Truly Foreign Concept: Formula One in Texas', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Truly Foreign Concept: Formula One in Texas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Formula One', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobile Racing', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Austin (Tex)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-16T19:43:50+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'byline': {'original': 'By Leo Levine', 'person': [{'firstname': 'Leo', 'middlename': None, 'lastname': 'Levine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/daab6cb7-04eb-5199-ba97-5d734d3217c2', 'word_count': 1087, 'uri': 'nyt://article/daab6cb7-04eb-5199-ba97-5d734d3217c2'}, {'abstract': 'If you’re going to watch the United States Grand Prix on Speed this Sunday, look closely when a car comes in for a tire change. But look quickly. Pit stops are usually over within three seconds.', 'web_url': 'https://www.nytimes.com/2012/11/18/automobiles/smart-spectating-its-the-pit-stops.html', 'snippet': 'If you’re going to watch the United States Grand Prix on Speed this Sunday, look closely when a car comes in for a tire change. But look quickly. Pit stops are usually over within three seconds.', 'lead_paragraph': 'IF you’re going to watch the United States Grand Prix on Speed this Sunday and you’ve never seen a Formula One race before, look closely when a car comes in for a tire change. But don’t blink: the elapsed time from when the car stops to when it starts rolling again, complete with four new tires (though refueling is not permitted), will be less than three seconds for the faster pit crews. Just how this is managed takes more time to explain than it does to watch.', 'print_section': 'AU', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Smart Spectating: It’s the Pit Stops', 'kicker': None, 'content_kicker': None, 'print_headline': 'Smart Spectating: It’s the Pit Stops', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Pirelli Spa', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Formula One', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobile Racing', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-16T19:47:02+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'byline': {'original': 'By Leo Levine', 'person': [{'firstname': 'Leo', 'middlename': None, 'lastname': 'Levine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5d1d269-aeef-5821-ba08-2918eea6101b', 'word_count': 292, 'uri': 'nyt://article/e5d1d269-aeef-5821-ba08-2918eea6101b'}, {'abstract': 'A rocket fired from Gaza landed near Jerusalem, and Israel called up reserve troops as it contemplates a ground invasion.', 'web_url': 'https://www.nytimes.com/slideshow/2012/11/16/world/middleeast/20121116ISRAEL.html', 'snippet': 'A rocket fired from Gaza landed near Jerusalem, and Israel called up reserve troops as it contemplates a ground invasion.', 'lead_paragraph': 'A rocket fired from Gaza landed near Jerusalem, and Israel called up reserve troops as it contemplates a ground invasion.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/16/world/middleeast/20121116ISRAEL-slide-9CRB/20121116ISRAEL-slide-9CRB-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/16/world/middleeast/20121116ISRAEL-slide-9CRB/20121116ISRAEL-slide-9CRB-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnai