/2012/11/06/us/politics/06semester-cnd-LN/06semester-cnd-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/06/us/politics/06semester-cnd-LN/06semester-cnd-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/06/us/politics/06semester-cnd-LN/06semester-cnd-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/06/us/politics/06semester-cnd-LN/06semester-cnd-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/06/us/politics/06semester-cnd-LN/06semester-cnd-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'School Credit for Campaigning', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-06T09:42:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac402879-9f2c-5ba9-bfd4-3b1a0ccd1925', 'word_count': 68, 'uri': 'nyt://article/ac402879-9f2c-5ba9-bfd4-3b1a0ccd1925'}, {'abstract': 'It has been 60 years since Dwight D. Eisenhower was elected president, without the super PACs, teleprompters, Tweeting and television that characterize today’s elections. But in some ways, little has changed.', 'web_url': 'https://lens.blogs.nytimes.com/2012/11/06/omg-i-like-ike/', 'snippet': 'It has been 60 years since Dwight D. Eisenhower was elected president, without the super PACs, teleprompters, Tweeting and television that characterize today’s elections. But in some ways, little has changed.', 'lead_paragraph': 'It is crunch time for another campaign season, but look around. Where are the smartphones? Where are the satellite hookups? Where are the bloggers, the cable news crews, the “super PAC” advisers, the teleprompters, the network teams, the YouTube watchdogs, the tablet computers and the dare-we-even-mention-them digital cameras?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'OMG, I Like #Ike :-)', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 1960', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Eisenhower, Dwight David', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Truman, Harry S', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-06T10:00:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By John Leland and Darcy Eveleigh', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Leland', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Darcy', 'middlename': None, 'lastname': 'Eveleigh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65deaa00-934b-5f46-8d05-28965c7519c9', 'word_count': 522, 'uri': 'nyt://article/65deaa00-934b-5f46-8d05-28965c7519c9'}, {'abstract': 'The battle for 29th Street might portend the future of the global economy. (Seriously.)', 'web_url': 'https://www.nytimes.com/2012/11/11/magazine/can-manhattans-cheap-goods-district-hold-off-the-yuppies.html', 'snippet': 'The battle for 29th Street might portend the future of the global economy. (Seriously.)', 'lead_paragraph': 'As he leaned against a display case filled with gold-plated and sterling-silver jewelry, Shappy Mehta listed his prices (necklaces: $3 and up; watches start at $1, if you don’t need a battery) and detailed the miseries plaguing his business. The store, M.K. Sterling & Watches Inc., takes up half a storefront on 29th Street, just east of Broadway, in the center of Manhattan’s low-cost wholesale district. Within a few blocks, there are dozens of other stores that import low-cost products from Asia (cheap watches, hair extensions, perfumes) and sell them to store owners visiting from all over the Northeast and, to a surprising extent, much of the developing world too. Business has been awful lately, but Mehta doesn’t blame the lousy global economy; instead, he blames the building across the street. “Because of the hotel, things got bad,” he said. “They want everything high end.”', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/magazine/11economy/11economy-articleLarge.jpg', 'height': 738, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/11/magazine/11economy/11economy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 738}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/magazine/11economy/mag-11Economy-t_CA0-jumbo.jpg', 'height': 1024, 'width': 819, 'subType': 'jumbo', 'crop_name': 'jumbo', 