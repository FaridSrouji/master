or': 'N'}], 'pub_date': '2012-11-07T21:15:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Brian X. Chen', 'person': [{'firstname': 'Brian', 'middlename': 'X.', 'lastname': 'Chen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da80042b-43a8-56b3-8435-e72427a95303', 'word_count': 540, 'uri': 'nyt://article/da80042b-43a8-56b3-8435-e72427a95303'}, {'abstract': 'The Federal Communications Commission is likely to focus on expanding broadband service in a second Obama administration.', 'web_url': 'https://bits.blogs.nytimes.com/2012/11/07/focus-of-the-f-c-c-in-a-second-obama-administration-more-spectrum/', 'snippet': 'The Federal Communications Commission is likely to focus on expanding broadband service in a second Obama administration.', 'lead_paragraph': 'The direction of the Federal Communications Commission during a second Obama Administration will be decided in two places: In the chairman’s office, which could have a new occupant next year, and in federal court, where cases are pending that challenge the F.C.C.’s authority over broadband service, Internet traffic and wireless data.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Focus of the F.C.C. in a Second Obama Administration: More Spectrum', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wireless Communications', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Genachowski, Julius', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Communications Commission', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-07T21:16:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Edward Wyatt', 'person': [{'firstname': 'Edward', 'middlename