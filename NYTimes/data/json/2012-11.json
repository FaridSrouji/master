 abundance.', 'print_section': 'LI', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/18DINELI1/18DINELI1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/18DINELI1/18DINELI1-superJumbo.jpg', 'height': 1361, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/18DINELI1/18DINELI1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/nyregion/18DINELI1/18DINELI1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/nyregion/18DINELI1/18DINELI1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pizza, Pasta and Service to Comfort the Soul', 'kicker': 'Long Island Dining | Huntington', 'content_kicker': None, 'print_headline': 'Pizza, Pasta and Service To Comfort the Soul', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Porto Fino (Huntington, NY, Restaurant)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Island (NY)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Huntington (NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-17T01:07:54+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joanne Starkey', 'person': [{'firs