 [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/TEATRO/TEATRO-jumbo.jpg', 'height': 819, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/TEATRO/TEATRO-superJumbo.jpg', 'height': 1639, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/TEATRO/TEATRO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/arts/TEATRO/TEATRO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/TEATRO/TEATRO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Grabbing Power and Hearts', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Grabbing Power and Hearts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Teatro Grattacielo', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-04T21:12:52+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6d204c7d-dd7f-5db8-9886-d944a8ee3e59', 'word_count': 425, 'uri': 'nyt://article/6d204c7d-dd7f-5db8-9886-d944a8ee3e59'}, {'abstract': 'In Ian McEwan’s “Sweet Tooth,” what begins as a sort of cold war le Carré tale about a spy (and the psychology of spying) soon mutates into something else.', 'web_url': 'https://www.nytimes.com/2012/11/05/books/sweet-tooth-by-ian-mcewan.html', 'snippet': 'In Ian McEwan’s “Sweet Tooth,” what begins as a sort of cold war le Carré tale about a spy (and the psychology of spying) soon mutates into something else.', 'lead_paragraph': 'Ian McEwan’s coy new novel, “Sweet Tooth,” begins with an intriguing confession from the narrator: “My name is Serena Frome (rhymes with plume) and almost 40 years ago I was sent on a secret mission for the British security service. I didn’t return safely. Within 18 months of joining I was sacked, having disgraced myself and ruined my lover, though he certainly had a hand in his own undoing.” ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpbook/jpbook-jumbo.jpg', 'height': 1024, 'width': 921, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpbook/jpbook-superJumbo.jpg', 'height': 1198, 'width': 1078, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpbook/jpbook-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/arts/jpbook/jpbook-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpbook/jpbook-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Spy Who Liked It Hot', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'The Spy Who Liked It Hot', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McEwan, Ian', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-04T21:16:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Michiko Kakutani', 'person': [{'firstname': 'Michiko', 'middlename': None, 'lastname': 'Kakutani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/771a7821-e69d-534e-8eee-35d132a0b58d', 'word_count': 930, 'uri': 'nyt://article/771a7821-e69d-534e-8eee-35d132a0b58d'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2012/11/05/arts/television/whats-on-monday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (Travel) ANTHONY BOURDAIN: NO RESERVATIONS In his final culinary tour for Travel before moving to CNN Mr. Bourdain, left, heads to Brooklyn, where he rides the Coney Island Cyclone for the first time, dines with the restaurateur Eddie Huang at Pok Pok, tries out Randazzo’s Clam Bar in Sheepshead Bay with the chefs Rich Torrisi and Mario Carbone, samples roasted pig at the Primoski restaurant off Brighton Beach Avenue and tosses one back at Sunny’s Bar in Red Hook.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Monday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-04T21:19:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/78f77a33-6796-51b6-9ad8-fb5498b28abc', 'word_count': 764, 'uri': 'nyt://article/78f77a33-6796-51b6-9ad8-fb5498b28abc'}, {'abstract': 'Temperatures fell into the 30s on Sunday and are expected to drop below freezing this week as tens of thousands of people search for a place to live.', 'web_url': 'https://www.nytimes.com/slideshow/2012/11/04/nyregion/20121104_SANDY_GOBIG.html', 'snippet': 'Temperatures fell into the 30s on Sunday and are expected to drop below freezing this week as tens of thousands of people search for a place to live.', 'lead_paragraph': 'Temperatures fell into the 30s on Sunday and are expected to drop below freezing this week as tens of thousands of people search for a place to live.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/nyregion/20121104_SANDY_GOBIG-slide-U2YC/20121104_SANDY_GOBIG-slide-U2YC-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/nyregion/20121104_SANDY_GOBIG-slide-U2YC/20121104_SANDY_GOBIG-slide-U2YC-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/nyregion/20121104_SANDY_GOBIG-slide-U2YC/20121104_SANDY_GOBIG-slide-U2YC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/04/nyregion/20121104_SANDY_GOBIG-slide-U2YC/20121104_SANDY_GOBIG-slide-U2YC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/nyregion/20121104_SANDY_GOBIG-slide-U2YC/20121104_SANDY_GOBIG-slide-U2YC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Homeless and Without Heat', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricanes and Tropical Storms', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Homeless Persons', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Disasters and Emergencies', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'New York City Marathon', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-04T21:43:28+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/1633a367-c5be-5c38-bfce-976502ecab50', 'word_count': 0, 'uri': 'nyt://slideshow/1633a367-c5be-5c38-bfce-976502ecab50'}, {'abstract': 'Returning to school in the wake of Hurricane Sandy, my students didn’t need my lessons. Not right away. Instead, they needed school as a refuge.', 'web_url': 'https://parenting.blogs.nytimes.com/2012/11/04/the-first-day-in-the-classroom-post-sandy/', 'snippet': 'Returning to school in the wake of Hurricane Sandy, my students didn’t need my lessons. Not right away. Instead, they needed school as a refuge.', 'lead_paragraph': 'During this hurricane, my family was among the lucky. No flood. No fires. While our power didn’t go out, we felt powerless, eagerly wanting to find ways to help. So when the school where I teach e-mailed to say we’d be reopening on Friday, I couldn’t wait to get back. After four days away from classes, I was itching to get back to teaching. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The First Day in the Classroom, After a Hurricane', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Emotions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fear (Emotion)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Power Outages and Blackouts', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Weather', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-04T22:00:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Launa Schweizer', 'person': [{'firstname': 'Launa', 'middlename': None, 'lastname': 'Schweizer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/85c2e9a3-dcae-5fd8-990e-875824b3a39f', 'word_count': 745, 'uri': 'nyt://article/85c2e9a3-dcae-5fd8-990e-875824b3a39f'}, {'abstract': 'New York jazz clubs took a hit during Hurricane Sandy last week, but for many it was only a minor disruption.', 'web_url': 'https://www.nytimes.com/2012/11/05/arts/music/the-blue-note-and-other-jazz-spots-weather-hurricane-sandy.html', 'snippet': 'New York jazz clubs took a hit during Hurricane Sandy last week, but for many it was only a minor disruption.', 'lead_paragraph': '“Wow, we all made it, didn’t we?” the pianist Chick Corea said after climbing onstage at the Blue Note on Saturday night. His eyes scanned the crowded room, and then flicked over to his fellow bandleader, the bassist Stanley Clarke. In a tone approaching wry relief, he added a typical morsel of understatement: “Boy, what a week.” ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/JAZZ/JAZZ-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/05/arts/JAZZ/JAZZ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/JAZZ/JAZZ-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/JAZZ/JAZZ-superJumbo.jpg', 'height': 1354, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/JAZZ/JAZZ-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/arts/JAZZ/JAZZ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/JAZZ/JAZZ-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Back in the Groove After the Storm', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Back in the Groove After the Storm', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jazz', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-04T22:41:55+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2784e719-73b2-52e3-a1d5-60c1aea8f80f', 'word_count': 998, 'uri': 'nyt://article/2784e719-73b2-52e3-a1d5-60c1aea8f80f'}, {'abstract': 'The vocal ensemble Tenet performed excerpts from Monteverdi’s madrigals in an elegant room at the Italian Academy.', 'web_url': 'https://www.nytimes.com/2012/11/05/arts/music/tenet-vocal-ensemble-at-italian-academy-columbia-university.html', 'snippet': 'The vocal ensemble Tenet performed excerpts from Monteverdi’s madrigals in an elegant room at the Italian Academy.', 'lead_paragraph': 'On the second floor of the Italian Academy at Columbia University, a 1927 building in the style of a neo-Renaissance palazzo, is the Teatro, a commodious room with a carved-wood ceiling and a small stage. This is the kind of elegant space in which Book 8 of Monteverdi’s madrigals would probably have been performed in the composer’s day. So said the violinist Scott Metcalfe, the guest music director of the estimable vocal ensemble Tenet, on Saturday night to an audience of nearly 200 attending the group’s sold-out performance of excerpts from that astonishing Monteverdi collection, “Madrigals of Love and War.” ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jptenent/jptenent-jumbo.jpg', 'height': 1002, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jptenent/jptenent-superJumbo.jpg', 'height': 1995, 'width': 2038, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jptenent/jptenent-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/arts/jptenent/jptenent-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jptenent/jptenent-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Monteverdi’s Madrigals as Live-Action Dramas', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Monteverdi’s Madrigals as Live-Action Dramas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Tenet (Music Group)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Monteverdi, Claudio', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-04T22:41:57+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Anthony Tommasini', 'person': [{'firstname': 'Anthony', 'middlename': None, 'lastname': 'Tommasini', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d90d1191-a129-5e8d-8b22-241a9ee176c5', 'word_count': 503, 'uri': 'nyt://article/d90d1191-a129-5e8d-8b22-241a9ee176c5'}, {'abstract': 'Hurricane Sandy spared the first phase of a five-year, $13 million public art project in Atlantic City called “Artlantic,” part of an effort to transform the city’s desolate public spaces.', 'web_url': 'https://www.nytimes.com/2012/11/05/arts/design/artlantic-weathers-hurricane-in-atlantic-city.html', 'snippet': 'Hurricane Sandy spared the first phase of a five-year, $13 million public art project in Atlantic City called “Artlantic,” part of an effort to transform the city’s desolate public spaces.', 'lead_paragraph': 'ATLANTIC CITY — As devastating a hit as New Jersey took from Hurricane Sandy, the blow was softer than had been feared for this seaside gambling mecca directly in the storm’s path. None of the waterfront casinos, for instance, reported major damage.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpatlantic1/jpatlantic1-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/05/arts/jpatlantic1/jpatlantic1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpatlantic1/jpatlantic1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpatlantic1/jpatlantic1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpatlantic1/jpatlantic1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/arts/jpatlantic1/jpatlantic1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/jpatlantic1/jpatlantic1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hurricane Spares Seaside Art', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hurricane Spares Seaside Art', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Smith, Kiki', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Atlantic City (NJ)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fung, Lance', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sculpture', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Fung Collaboratives', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-04T22:48:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ted Loos', 'person': [{'firstname': 'Ted', 'middlename': None, 'lastname': 'Loos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1b61c05-7703-5f2c-b110-61f50363a9b7', 'word_count': 1153, 'uri': 'nyt://article/c1b61c05-7703-5f2c-b110-61f50363a9b7'}, {'abstract': 'In addition to shutting down shipping terminals and submerging warehouses, the storm tangled up deliveries, just as retailers normally receive final shipments for the holiday shopping season.', 'web_url': 'https://www.nytimes.com/2012/11/05/business/a-storm-battered-supply-chain-threatens-the-holiday-shopping-season.html', 'snippet': 'In addition to shutting down shipping terminals and submerging warehouses, the storm tangled up deliveries, just as retailers normally receive final shipments for the holiday shopping season.', 'lead_paragraph': 'The economic effects of Hurricane Sandy are reverberating beyond areas hit by the storm as businesses warn customers of delays, try to get merchandise out of closed ports and face canceled orders.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/business/05supply-3/05supply-3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/business/05supply-3/05supply-3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/business/05supply-3/05supply-3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/business/05supply-3/05supply-3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/business/05supply-3/05supply-3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Storm-Battered Supply Chain Threatens Holiday Shopping', 'kicker': None, 'content_kicker': None, 'print_headline': 'Crippled Supply Chain Puts Holiday Shopping at Risk', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Freight (Cargo)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-04T22:50:50+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Stephanie Clifford and Nelson D. Schwartz', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'Clifford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Nelson', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0fb777e3-56df-5193-896a-013160177d60', 'word_count': 1216, 'uri': 'nyt://article/0fb777e3-56df-5193-896a-013160177d60'}, {'abstract': '“Witness” is HBO’s series of four documentaries about photojournalists in crisis spots around the world.', 'web_url': 'https://www.nytimes.com/2012/11/05/arts/television/witness-hbo-documentary-series-on-war-photographers.html', 'snippet': '“Witness” is HBO’s series of four documentaries about photojournalists in crisis spots around the world.', 'lead_paragraph': '“Witness: Juarez,” the first in a series of four HBO documentaries about contemporary war photographers, is the visual equivalent of a fast-paced duet, like Mozart for still camera and video camera rather than violin and viola. The photographer Eros Hoagland and the cinematographer Jared Moossy travel the deadly streets of Ciudad Juárez, Mexico, in tandem, and our view jumps between their lenses; their photographs and moving images echo and amplify one another. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/SUB2JPWITNESS1/SUB2JPWITNESS1-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/05/arts/SUB2JPWITNESS1/SUB2JPWITNESS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/SUB2JPWITNESS1/SUB2JPWITNESS1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/SUB2JPWITNESS1/SUB2JPWITNESS1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/SUB2JPWITNESS1/SUB2JPWITNESS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/05/arts/SUB2JPWITNESS1/SUB2JPWITNESS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/05/arts/SUB2JPWITNESS1/SUB2JPWITNESS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Photographers Amid Chaos', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Photographers Amid Chaos', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'War and Revolution', 'ra