value': 'Sex Education', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Manila (Philippines)', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-11-09T16:14:07+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Floyd Whaley', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Whaley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9a055fa4-4105-5ab6-a55c-0d0ea481b312', 'word_count': 829, 'uri': 'nyt://article/9a055fa4-4105-5ab6-a55c-0d0ea481b312'}, {'abstract': 'The 124-year-old Corbin Building in Lower Manhattan, at one point threatened with demolition during planning for the Fulton Street Transit Center, has been preserved and is coming out of its scaffold covering.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/11/09/a-19th-century-dividend-at-a-21st-century-station/', 'snippet': 'The 124-year-old Corbin Building in Lower Manhattan, at one point threatened with demolition during planning for the Fulton Street Transit Center, has been preserved and is coming out of its scaffold covering.', 'lead_paragraph': 'The brightest new architectural addition to Lower Manhattan is now emerging from its cocoon of scaffolding, 124 years after construction began.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A 19th-Century Dividend at a 21st-Century Station', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value'