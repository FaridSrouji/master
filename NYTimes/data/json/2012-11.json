ge': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/business/Land/Land-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/17/business/Land/Land-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/business/Land/Land-jumbo-v2.jpg', 'height': 720, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/business/Land/Land-superJumbo-v2.jpg', 'height': 1440, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/business/Land/Land-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/17/business/Land/Land-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Back When a Chocolate Puck Tasted, Guiltily, Like America', 'kicker': 'This Land', 'content_kicker': None, 'print_headline': 'Back When a Chocolate Puck Tasted, Guiltily, Like America', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Hostess Brands', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bankruptcies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Desserts', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-17T02:56:23+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Dan Barry', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Barry', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/258cdf7b-c1d2-5dff-9733-096f312e3995', 'word_count': 909, 'uri': 'nyt://article/258cdf7b-c1d2-5dff-9733-096f312e3995'}, {'abstract': 'Residents of Jerusalem said Friday that they had felt largely immune from the current military operation, by virtue of the city’s religious sites and its huge Palestinian population. Until they heard the wartime siren blaring.', 'web_url': 'https://www.nytimes.com/2012/11/17/world/middleeast/sirens-disrupt-the-sabbath-in-jerusalem.html', 'snippet': 'Residents of Jerusalem said Friday that they had felt largely immune from the current military operation, by virtue of the city’s religious sites and its huge Palestinian population. Until they heard the wartime siren blaring.', 'lead_paragraph': 'JERUSALEM — When dusk descends on Jerusalem on a Friday, it usually brings a moment of rare harmony and almost magical tranquillity. A steady siren announces the onset of the Jewish Sabbath just hours after Muslims wind up the special Friday noon prayer at Al Aksa Mosque in the Old City.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/world/sub-jerusalem/sub-jerusalem-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/17/world/sub-jerusalem/sub-jerusalem-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/world/sub-jerusalem/sub-jerusalem-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'ju