: [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e02f8678-9005-5fe4-9d43-9df149fea6dc', 'word_count': 542, 'uri': 'nyt://article/e02f8678-9005-5fe4-9d43-9df149fea6dc'}, {'abstract': 'The decision was rooted in lack of certainty about Ohio.', 'web_url': 'https://publiceditor.blogs.nytimes.com/2012/11/08/more-detail-on-why-the-times-called-the-presidential-election-later/', 'snippet': 'The decision was rooted in lack of certainty about Ohio.', 'lead_paragraph': 'In a post Wednesday, I noted that The Times took longer than most other major news outlets to declare the winner of the presidential election. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'More Detail on Why The Times Called the Presidential Election Later', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Associated Press', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-08T22:40:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5336a7f4-8324-5e94-9e07-ad0a4169f452', 'word_count': 575, 'uri': 'nyt://article/5336a7f4-8324-5e94-9e07-ad0a4169f452'}, {'abstract': 'Brian Stokes Mitchell, performing at Alice Tully Hall for an Actors Fund benefit, makes songs into detailed character studies of carnival barkers and knights.', 'web_url': 'https://www.nytimes.com/2012/11/09/arts/music/brian-stokes-mitchell-at-alice-tully-hall.html', 'snippet': 'Brian Stokes Mitchell, performing at Alice Tully Hall for an Actors Fund benefit, makes songs into detailed character studies of carnival barkers and knights.', 'lead_paragraph': 'Brian Stokes Mitchell wielded his stand-up microphone like a sword on Wednesday evening at Alice Tully Hall, and the audience happily fell on it. That swashbuckling gesture, during his rendition of “Man of La Mancha,” added an extra flourish to a dramatically all-encompassing performance that conjured the illusion of a lavish semi-operatic production. But in fact there were just two musicians on the stage: Mr. Mitchell, and the pianist Marvin Laird, a last-minute substitute for Tedd Firth. ', 'print_section': 'C', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/09/arts/09MITCHELL_SPAN/MITCHELL-articleLarge.jpg', 'height': 361, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/09/arts/09MITCHELL_SPAN/MITCHELL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 361}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/09/arts/09MITCHELL_SPAN/MITCHELL-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/09/arts/09MITCHELL_SPAN/MITCHELL-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/09/arts/09MITCHELL_SPAN/MITCHELL-thumbStandard.jpg