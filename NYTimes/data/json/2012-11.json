nk': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/906a4ba0-25cb-5e40-bcfc-c3345602e08b', 'word_count': 643, 'uri': 'nyt://article/906a4ba0-25cb-5e40-bcfc-c3345602e08b'}, {'abstract': 'Four people were killed and 16 were injured when a train struck a parade float carrying veterans in Midland, Tex.', 'web_url': 'https://www.nytimes.com/2012/11/17/us/4-killed-in-texas-train-crash-were-army-veterans.html', 'snippet': 'Four people were killed and 16 were injured when a train struck a parade float carrying veterans in Midland, Tex.', 'lead_paragraph': 'MIDLAND, Tex. — One was a Union Pacific freight train bound for Louisiana, a 7,200-foot-long behemoth with 84 cargo cars rumbling through the flat industrial edge of this West Texas city. The other was a popular annual parade for wounded veterans and their spouses, a leisurely cruise through the dusty streets that moved slowly enough that the participants comfortably sat in chairs on the back of flatbed trucks.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/us/TEXAS-1/TEXAS-1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/17/us/TEXAS-1/TEXAS-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/us/TEXAS-1/TEXAS-1-jumbo.jpg', 'height': 625, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/us/TEXAS-1/TEXAS-1-superJumbo.jpg', 'height': 1251, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/us/TEXAS-1/TEXAS-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/17/us/TEXAS-1/TEXAS-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/us/TEXAS-1/TEXAS-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Grief and Questions Abound After Fatal Parade Collision', 'kicker': None, 'content_kicker': None, 'print_headline': 'Grief and Questions Abound After Fatal Parade Collision', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Traffic Accidents and Safety', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Railroad Accidents and Safety', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Midland (Tex)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Transportation Safety Board', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-16T16:31:46+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Manny Fernandez and Emma G. Fitzsimmons', 'person': [{'firstname': 'Manny', 'middlename': None, 'lastname': 'Fernandez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Emma', 'middlename': 'G.', 'lastname': 'Fitzsimmons', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6625645-0608-5678-ab45-90f491fd31f7', 'word_count': 1220, 'uri': 'nyt://article/f6625645-0608-5678-ab45-90f491fd31f7'}, {'abstract': 'Tiki Gelana, who won the gold medal in the women’s marathon at the London Olympics, did not get to compete in the New York City Marathon this year. But she says she intends to return to the city.', 'web_url': 'https://marathon.blogs.nytimes.com/2012/11/16/gelana-vows-to-give-new-york-another-try/', 'snippet': 'Tiki Gelana, who won the gold medal in the women’s marathon at the London Olympics, did not get to compete in the New York City Marathon this year. But she says she intends to return to the city.', 'lead_paragraph': 'At 7 a.m. on Nov. 1, as the sun was just beginning to rise over a half-blacked-out Manhattan and just an hour after (partial) subway service had returned to the city for the first time in three days, Tiki Gelana, the women’s Olympic marathon champion, set out for an eight-mile run along the West Side Highway. Normally, elite athletes entered in the New York City Marathon train in Central Park, but the park remained closed due to the damage caused by Hurricane Sandy two days earlier.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gelana Vows to Give New York Another Try', 'kicker': 'On the Run', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gelana, Tiki', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Radcliffe, Paula', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wittenberg, Mary', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Road Runners Club', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-16T16:32:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By David Gendelman', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gendelman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6ce41aed-45d2-508c-9e55-4d8fba633e41', 'word_count': 1578, 'uri': 'nyt://article/6ce41aed-45d2-508c-9e55-4d8fba633e41'}, {'abstract': 'One of the only bars open in Rockaway has become not only a place to get a drink, but also a spot to commiserate and find support among those dealing with the aftermath of Hurricane Sandy.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/11/16/what-theyd-give-for-a-drink-in-rockaway/', 'snippet': 'One of the only bars open in Rockaway has become not only a place to get a drink, but also a spot to commiserate and find support among those dealing with the aftermath of Hurricane Sandy.', 'lead_paragraph': '“Can you imagine, not being able to find a drink in Rockaway?” said Sophia Naccari, who happened to have finally found one. “But for a week after the storm, there were no bars open down here – how could that be?”', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/nyregion/16cityroom-bar/16cityroom-bar-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/nyregion/16cityroom-bar/16cityroom-bar-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/nyregion/16cityroom-bar/16cityroom-bar-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/17/nyregion/16cityroom-bar/16cityroom-bar-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/17/nyregion/16cityroom-bar/16cityroom-bar-thumbLarge.