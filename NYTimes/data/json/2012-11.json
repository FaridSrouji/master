stract': 'Rafael Nadal practiced in Majorca on Tuesday and will play an exhibition next month to end his lengthy injury absence.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/11/20/nadal-prepares-for-a-return/', 'snippet': 'Rafael Nadal practiced in Majorca on Tuesday and will play an exhibition next month to end his lengthy injury absence.', 'lead_paragraph': 'On an indoor hardcourt in Manacor, Majorca Tuesday, several cameramen set up tripods as they waited for one of the more elusive sights in sport in recent months: Rafael Nadal hitting a tennis ball.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/20/sports/tennis/20nadal/20nadal-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/20/sports/tennis/20nadal/20nadal-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/20/sports/tennis/20nadal/20nadal-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/20/sports/tennis/20nadal/20nadal-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/20/sports/tennis/20nadal/20nadal-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nadal Prepares for a Return', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-20T18:48:14+0000', 'document_type': 'ar