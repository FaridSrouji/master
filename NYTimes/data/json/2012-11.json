material': 'News', '_id': 'nyt://article/89ec1306-3ef2-5b06-a663-0e4bae77bd02', 'word_count': 1334, 'uri': 'nyt://article/89ec1306-3ef2-5b06-a663-0e4bae77bd02'}, {'abstract': 'More than 30 stories about young people, collected from the last five weeks of The New York Times. How could you use this collection in your classroom?', 'web_url': 'https://learning.blogs.nytimes.com/2012/11/08/teenagers-in-the-times-october-2012/', 'snippet': 'More than 30 stories about young people, collected from the last five weeks of The New York Times. How could you use this collection in your classroom?', 'lead_paragraph': 'Class Dismissed: A 2009 documentary by Adam B. Ellick profiled Malala Yousafzai, a Pakistani girl whose school was shut down by the Taliban. Ms. Yousafzai was shot by a gunman on Oct. 9.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Teenagers in The Times | October 2012', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-08T18:48:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten and Michael Gonchar', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/56fc1d0e-d051-5c6c-bc6a-b4cfaa4f8cef', 'word_count': 1568, 'uri': 'nyt://article/56fc1d0e-d051-5c6c-bc6a-b4cfaa4f8cef'}, {'abstract': 'Quick ways to teach with our monthly collection of Times articles and multimedia about young people. How might you use this feature? We’d love to include your ideas on our list.', 'web_url': 'https://learning.blogs.nytimes.com/2012/11/08/teaching-with-teenagers-in-the-times/', 'snippet': 'Quick ways to teach with our monthly collection of Times articles and multimedia about young people. How might you use this feature? We’d love to include your ideas on our list.', 'lead_paragraph': 'In July we started a new feature, Teenagers in The Times, which collects recent articles, slide shows and videos about young people published on NYTimes.com. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/10/14/us/14TTKountze2-LN/14TTKountze2-jumbo.jpg', 'height': 727, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/10/14/us/14TTKountze2-LN/14TTKountze2-superJumbo.jpg', 'height': 1445, 'width': 2036, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/10/14/us/14TTKountze2-LN/14TTKountze2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/10/14/us/14TTKountze2-LN/14TTKountze2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/10/14/us/14TTKountze2-LN/14TTKountze2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Teaching With ‘Teenagers in The Times’', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-08T18:49:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Amanda Christy Brown and Katherine Schulten', 'person': [{'firstname': 'Amanda', 'middlename': 'Christy', 'lastname': 'Brown', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92d2d132-287f-555d-b955-3e48e189eb9e', 'word_count': 1131, 'uri': 'nyt://article/92d2d132-287f-555d-b955-3e48e189eb9e'}, {'abstract': 'New research suggests that projections of steeper rises in temperature may be more accurate.', 'web_url': 'https://green.blogs.nytimes.com/2012/11/08/a-new-tweak-for-global-warming-predictions/', 'snippet': 'New research suggests that projections of steeper rises in temperature may be more accurate.', 'lead_paragraph': 'While scientists express confidence that the earth will continue to warm in response to an increase in atmospheric carbon dioxide levels, fine-tuning those projections has been a challenge. The majority of estimates fall between a rise of 2 to 4.5 degrees Celsius (3.6 degrees to 8.1 degrees Fahrenheit), which leaves quite a wide range of uncertainty. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Tweak for Global Warming Predictions', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Carbon Dioxide', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Temperature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Weather', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Science (Journal)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-08T19:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Rachel Nuwer', 'person': [{'firstname': 'Rachel', 'middlename': None, 'lastname': 'Nuwer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f7217ae-a870-5d27-a4f7-ae30dbfc2ea5', 'word_count': 856, 'uri': 'nyt://article/3f7217ae-a870-5d27-a4f7-ae30dbfc2ea5'}, {'abstract': 'For the Travel issue, we escape to Denmark, Italy and the archives of Metro-Goldwyn-Mayer.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/11/08/bookshelf-29/', 'snippet': 'For the Travel issue, we escape to Denmark, Italy and the archives of Metro-Goldwyn-Mayer.', 'lead_paragraph': '“How to Be Danish” (Short Books, $16), Patrick Kingsley’s introduction to Denmark — “from Lego to Lund” — makes fascinating cultural connections between everything from the Nordic food revolution to Danish modern design and the Muhammad cartoon controversy. “Pictures From Italy” (Tara Books, $20) dusts off an early Dickens work, a whimsical cross between a fairy tale and a travelogue covering his trips to Italy and France with his family in the 1840s. This version includes beautiful illustrated collages by the Italian artist Livia Signorini. “Return of the Thin Man” (Mysterious Press, $25) is the first publication of two astringent Dashiell Hammett novellas. Originally written as film treatments, they had spent more than a half century languishing in the archives of Metro-Goldwyn-Mayer.', 'print_section': 'M2', 'print_page': '40', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bookshelf', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Bookshelf', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-08T19:00:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Stephen Heyman', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Heyman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/72a3c071-f2c4-550a-adae-3b4587a9f542', 'word_count': 122, 'uri': 'nyt://article/72a3c071-f2c4-550a-adae-3b4587a9f542'}, {'abstract': 'The purchase by Houghton Mifflin Harcourt of the culinary portfolio of John Wiley & Sons, as well as its reference books, means acquiring the all-American Betty Crocker cookbook series, among other assets.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/11/08/in-deal-with-wiley-houghton-acquires-cookbooks-and-cliffsnotes/', 'snippet': 'The purchase by Houghton Mifflin Harcourt of the culinary portfolio of John Wiley & Sons, as well as its reference books, means acquiring the all-American Betty Crocker cookbook series, among other assets.', 'lead_paragraph': 'Betty Crocker is moving.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Deal With Wiley, Houghton Acquires Cookbooks and CliffsNotes', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'CliffsNotes', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Houghton Mifflin Harcourt', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'John Wiley & Sons', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-08T19:10:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Leslie Kaufman', 'person': [{'firstname': 'Leslie', 'middlename': None, 'lastname': 'Kaufman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_materi