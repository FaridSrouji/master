dit': None, 'type': 'image', 'url': 'images/2012/09/06/health/06well_cancer/06well_cancer-jumbo.jpg', 'height': 1024, 'width': 681, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/06/health/06well_cancer/06well_cancer-superJumbo.jpg', 'height': 2048, 'width': 1362, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/06/health/06well_cancer/06well_cancer-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/06/health/06well_cancer/06well_cancer-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/06/health/06well_cancer/06well_cancer-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Offering Thanks for Caregivers', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-21T18:04:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Susan Gubar', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Gubar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b77496b6-d122-5f67-9526-d89a1da65cd0', 'word_count': 842, 'uri': 'nyt://article/b77496b6-d122-5f67-9526-d89a1da65cd0'}, {'abstract': 'Starting Derrick Favors, Paul Millsap and Al Jefferson is an experiment for the Utah Jazz. Results are not promising, but it is early in the season.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2012/11/21/for-jazz-big-frontcourt-has-mixed-results/', 'snippet': 'Starting Derrick Favors, Paul Millsap and Al Jefferson is an experiment for the Utah Jazz. Results are not promising, but it is early in the season.', 'lead_paragraph': 'In two early trials runs, the Utah Jazz’s experimental starting frontcourt featuring Derrick Favors, Paul Millsap and Al Jefferson has been something of a comedy of errors — the unit was run off the court in a 15-2 flurry in its debut against the winless Washington Wizards on Saturday (a game the Jazz eventually won), while the third-year Favors barely played a minute before picking up two fouls Monday in an eventual blowout home win over the Houston Rockets. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/sports/basketball/21favors/21favors-jumbo.jpg', 'height': 1024, 'width': 574, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/sports/basketball/21favors/21favors-superJumbo.jpg', 'height': 2048, 'width': 1148, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/sports/basketball/21favors/21favors-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/21/sports/basketball/21favors/21favors-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/sports/basketball/21favors/21favors-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Jazz, Big Frontcourt Has Mixed Results', 'kicker':