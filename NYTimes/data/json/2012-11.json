cumbents', 'kicker': None, 'content_kicker': None, 'print_headline': 'Republicans Stand Firm In Controlling the House', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'United States', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Blue Dog Coalition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, House of Representatives', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-07T05:58:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jennifer Steinhauer', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Steinhauer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6f584e7-b272-55c2-b63b-013ca288d3c3', 'word_count': 1089, 'uri': 'nyt://article/d6f584e7-b272-55c2-b63b-013ca288d3c3'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2012/11/07/arts/television/whats-on-today.html', 'snippet': 'Television highlights.', 'lead_paragraph': '10 P.M. (Comedy Central) SOUTH PARK  In this, the show’s 16th-season finale, titled “Obama Wins!,” Cartman, above, is hiding something in his bedroom that could change the outcome of the presidential election just as voters think they know who the winner is.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Today', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-07T06:00:09+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 's