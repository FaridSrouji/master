: None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-09T17:13:57+0000', 'document_type': 'multimedia', 'news_desk': 'Books', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/6d7647f0-b6da-5323-bbf0-4a93d000a745', 'word_count': 0, 'uri': 'nyt://slideshow/6d7647f0-b6da-5323-bbf0-4a93d000a745'}, {'abstract': 'Danielle Steel has two new books on the best-seller lists, including a memoir about her quiet but steady efforts to help the homeless population in San Francisco.', 'web_url': 'https://www.nytimes.com/2012/11/18/books/review/inside-the-list.html', 'snippet': 'Danielle Steel has two new books on the best-seller lists, including a memoir about her quiet but steady efforts to help the homeless population in San Francisco.', 'lead_paragraph': 'YO! ANGEL! Almost 20 years ago, in a New Yorker essay about the best-selling novels of the day, Anthony Lane made the unsurprising observation that popular taste and critical opinion don’t often walk hand in hand. “The editors of The Times Book Review would like to believe that they bring readers together beneath an umbrella of civilized discourse,” he wrote, “but outside it is raining Danielle Steel.” He wasn’t wrong about Steel, anyway, who scores not one but two hardcover hits this week — her latest novel, “The Sins of the Mother,” enters the fiction list at No. 2, and her memoir “A Gift of Hope” is new on the nonfiction list at No. 7.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/18list-img/18list-img-jumbo.jpg', 'height': 226, 'width': 227, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/18list-img/18list-img-superJumbo.jpg', 'height': 226, 'width': 227, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/18list-img/18list-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/18/books/review/18list-img/18list-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/18/books/review/18list-img/18list-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-09T17:14:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9a0ea54-6751-56df-b4c4-703b61415323', 'word_count': 636, 'uri': 'nyt://article/f9a0ea54-6751-56df-b4c4-703b61415323'}, {'abstract': 'Picture books about a picky eater, a hungry fox, a lemonade stand and more.', 'web_url': 'https://www.nytimes.com/2012/11/11/books/review/ganeshas-sweet-tooth-and-more.html', 'snippet': 'Picture books about a picky eater, a hungry fox, a lemonade stand and more.', 'lead_paragraph': 'HAPPY HARRY’S CAFÉ  By Michael Rosen.  Illustrated by Richard Holland.32 pp. Candlewick Press. $16.99. (Picture book; ages 3 to 5) ', 'print_section': 'BR', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/11dig-in-span/11dig-in-span-articleLarge.jpg', 'height': 289, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/11/books/review/11dig-in-span/11dig-in-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 289}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/11dig-in-span/11dig-in-span-jumbo.jpg', 'height': 493, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/11dig-in-span/11dig-in-span-superJumbo.jpg', 'height': 582, 'width': 1210, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/11dig-in-span/11dig-in-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/11/books/review/11dig-in-span/11dig-in-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/11dig-in-span/11dig-in-span-thumbLarge.jpg', 'height': 133, 'width': 133, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bookshelf: Dig In!', 'kicker': "Children's Books", 'content_kicker': None, 'print_headline': 'Dig In!', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rosen, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jenkins, Emily', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Patel, Sanjay', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-09T17:14:14+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Pamela Paul', 'person': [{'firstname': 'Pamela', 'middlename': None, 'lastname': 'Paul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/30ba12b2-0984-50ef-a56e-9db5964527e7', 'word_count': 591, 'uri': 'nyt://article/30ba12b2-0984-50ef-a56e-9db5964527e7'}, {'abstract': 'Jermaine Jackson, brother of Michael, wants to change the spelling of his surname.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/11/09/the-jacksun-1/', 'snippet': 'Jermaine Jackson, brother of Michael, wants to change the spelling of his surname.', 'lead_paragraph': 'Jermaine Jackson wants to change the spelling of his last name. According to a legal petition filed this week in Los Angeles, Mr. Jackson, who has long carried the burden of often being referred to as Michael Jackson’s older brother, now wants to be known as Jermaine Jacksun. That’s Jacksun with a “u.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Jacksun 1?', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jackson, Jermaine', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson, Michael', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-09T17:14:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7ef55565-9688-5e33-9424-e127ec8e2cec', 'word_count': 193, 'uri': 'nyt://article/7ef55565-9688-5e33-9424-e127ec8e2cec'}, {'abstract': 'Readers comment on my column about a soldier who suffered a brain injury and now is accused of a particularly horrific crime.', 'web_url': 'https://kristof.blogs.nytimes.com/2012/11/09/readers-comment-on-the-toll-of-war-at-home/', 'snippet': 'Readers comment on my column about a soldier who suffered a brain injury and now is accused of a particularly horrific crime.', 'lead_paragraph': 'My Sunday column (which is intentionally going online on Friday, so don’t look at your calendar in disbelief!) returns to a theme I’ve periodically explored this year: the toll on the mental health of soldiers and veterans, particularly those exposed to IED concussions in Iraq and Afghanistan. In the past, I looked at the problem of veteran suicides, at the risk that concussions can cause degenerative brain disease, and at a brilliant Army major who found himself slowly losing his mind after his return home. Today I’m exploring the question of whether brain injuries sustained at war might cause a soldier to commit a particularly brutal crime.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Readers Comment on the Toll of War at Home', 'kicker': 'Nicholas Kristof', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-09T17:15:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c753cc1b-74b8-5ca1-9e09-58b8f9666f93', 'word_count': 214, 'uri': 'nyt://article/c753cc1b-74b8-5ca1-9e09-58b8f9666f93'}, {'abstract': 'A fun resource for teaching and learning about Election 2012 from Flocabulary, an organization that we’ll be collaborating with again this year for our December “Year in Rap” writing contest.', 'web_url': 'https://learning.blogs.nytimes.com/2012/11/09/the-week-in-rap-election-edition/', 'snippet': 'A fun resource for teaching and learning about Election 2012 from Flocabulary, an organization that we’ll be collaborating with again this year for our December “Year in Rap” writing contest.', 'lead_paragraph': 'If you missed the news, you’ve been under a rock,The next president is Barack, that’s Obama.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Week in Rap | Election Edition', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-09T17:15:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f59f684-c918-5290-b6d1-e028a6c747d9', 'word_count': 141, 'uri': 'nyt://article/7f59f684-c918-5290-b6d1-e028a6c747d9'}, {'abstract': '(If only all book reviews were really like this.)', 'web_url': 'https://www.nytimes.com/2012/11/11/books/review/an-author-can-dream.html', 'snippet': '(If only all book reviews were really like this.)', 'lead_paragraph': 'Six years ago, with his rambunctious debut novel, “Dr. Pitcher’s Experimental Mistress,” the chronicle of a timid Iowa chiropractor’s Ambien-fueled erotic awakening aboard a sinking Alaskan cruise ship, Samson Graham-Muñoz, then just 23 years old, gained an instant reputation as a limber verbal gymnast. Told in the form of a blog-within-a-blog, written by the eponymous physician in a blurred state of somnambulant arousal (the doctor types notes on his iPad during sex), the book gained a small but zealous following among fans of droll divertissements. Still, there were some critics, including this one, who found the performance more impish than inspired. Graham-Muñoz was clearly a talent on a tear, but where exactly he was headed was anybody’s guess.', 'print_section': 'BR', 'print_page': '55', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/1111-BKS-KIRN/1111-BKS-KIRN-jumbo.jpg', 'height': 1024, 'width': 858, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/1111-BKS-KIRN/1111-BKS-KIRN-superJumbo.jpg', 'height': 2048, 'width': 1716, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/1111-BKS-KIRN/1111-BKS-KIRN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/11/books/review/1111-BKS-KIRN/1111-BKS-KIRN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/11/books/review/1111-BKS-KIRN/1111-BKS-KIRN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Author Can Dream', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'An Author Can Dream', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-11-09T17:16:04+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Walter Kirn', 'person': [{'firstname': 'Walter', 'middlename': None, 'lastname': 'Kirn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6212ee3d-877c-526c-9639-2af024901558', 'word_count': 1243, 'uri': 'nyt://article/6212ee3d-877c-526c-9639-2af024901558'}, {'abstract': 'The Giants are skewered for being too conservative on offense, but their recent failings stem from not being conservative enough.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/11/09/quirks-of-the-game-you-better-run/', 'snippet': 'The Giants are skewered for being too conservative on offense, but their recent failings stem from not being conservative enough.', 'lead_paragraph': 'The New York Giants blogging community seems to have an endless reserve of vitriol for offensive coordinator Kevin Gilbride, called Killdrive by many (in their nicer moments). But the odd twist here is that these pundits are bogged down in misperception — they generally kick and scream about Gilbride calling plays too conservatively, even though the Giants’ increasingly erratic play of late can be attributed to an abandoning the running game and forgoing short to mid-range passes to go for broke at inopportune moments. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/10/sports/football/10andre/10andre-jumbo.jpg', 'height': 1024, 'width': 952, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/10/sports/fo