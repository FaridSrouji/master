jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/02/arts/02VOGEL1/02VOGEL1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Native of Vietnam Wins Hugo Boss Prize', 'kicker': 'Inside Art', 'content_kicker': None, 'print_headline': 'Native of Vietnam\r\nWins Hugo Boss Prize', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Auctions', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Vo, Danh', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Guggenheim, Solomon R, Foundation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum of Fine Arts (Houston)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': "Sotheby's", 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-01T20:27:29+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6b2921c-1d13-51c1-b0c3-bc5309124c75', 'word_count': 1039, 'uri': 'nyt://article/d6b2921c-1d13-51c1-b0c3-bc5309124c75'}, {'abstract': 'The aftermath of the storm has complicated matters for pollsters, some of whom have been studying grids of power failures, county by county.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/11/01/examining-the-effect-of-the-storm-on-polling/', 'snippet': 'The aftermath of the storm has complicated matters for pollsters, some of whom have been studying grids of power failures, county by county.', 'lead_paragraph': 'In the final days of this intensely close election season, polling has taken on an added layer of uncertainty with millions of people stranded without electricity and without phones in several states. It may seem even silly or ridiculous to those experiencing the worst storm damage in their lives to talk about polling (or for that matter receive a survey call on a cellphone whose charged battery is indeed a lifeline), but for the data-obsessed and for pollsters, storm Sandy has complicated matters just a bit.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Examining the Effect of the Storm on Polling', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Levy, Donald', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Miringoff, Lee M', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Newport, Frank', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Zukin, Cliff', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Island (NY)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-11-01T20:34:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Kate Phillips', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Phillips', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/75c1f4d0-3040-554a-a13c-4dec2eec43e5', 'word_count': 1463, 'uri': 'nyt://article/75c1f4d0-3040-554a-a13c-4dec2eec43e5'}, {'abstract': 'In outlining its accusations of market manipulation, the Federal Energy Regulatory Commission contends that Barclays traders were prepared to take losses in the physical market to move the prices of electricity in the financial market.', 'web_url': 'https://dealbook.nytimes.com/2012/11/01/how-barclays-allegedly-took-losses-to-make-bigger-gains/', 'snippet': 'In outlining its accusations of market manipulation, the Federal Energy Regulatory Commission contends that Barclays traders were prepared to take losses in the physical market to move the prices of electricity in the financial market.', 'lead_paragraph': 'Just a few months after the scandal involving the London interbank offered rate, or Libor, Barclays is fending off another set of trading abuse allegations. This time, the regulator pointing the finger is the Federal Energy Regulatory Commission, which oversees the electricity, natural gas and oil markets. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Barclays Allegedly Took Losses to Make Bigger Gains', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electric Light and Power', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Barclays PLC', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Energy Regulatory Commission', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-01T20:36:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter Eavis', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Eavis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f5b7fef3-7523-5042-9b8d-ffbfe6f70d88', 'word_count': 439, 'uri': 'nyt://article/f5b7fef3-7523-5042-9b8d-ffbfe6f70d88'}, {'abstract': 'Off Broadway theaters are still struggling with power outages and other storm-related travails, even as Broadway gets back to business.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/11/01/downtown-theaters-are-still-dark/', 'snippet': 'Off Broadway theaters are still struggling with power outages and other storm-related travails, even as Broadway gets back to business.', 'lead_paragraph': 'The fallout from Sandy continued to punch holes in the Off-Broadway theater landscape, even as the lights came on for all Broadway shows by Thursday night. Heading into the weekend, the popular “Blue Man Group” and “Sleep No More” were halted, the Flea Theater wasn’t sure it could mount the scheduled final performances of the hit plays “Job” and “Heresy,” and previews for the Public Theater’s highly anticipated “Giant” and “Sorry” were delayed.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Downtown Theaters Are Still Dark', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Off Broadway Struggles As Broadway Resumes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Floods', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Buttram, Jan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hawke, Ethan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McGrath, Douglas', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Nelson, Richard', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Abingdon Theater Co', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Blue Man Group', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Classic Stage Company', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Coney Island USA', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Flea Theater', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Theater', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Vineyard Theater', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'York Theater Co', 'rank': 14, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 15, 'major': 'N'}], 'pub_date': '2012-11-01T20:38:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dfa3432d-045a-5bfb-a846-0ead40d859ba', 'word_count': 541, 'uri': 'nyt://article/dfa3432d-045a-5bfb-a846-0ead40d859ba'}, {'abstract': 'The patchy recovery from Hurricane Sandy exposed a split region. Lights flickered on in Manhattan and subways rumbled, but in stretches of Staten Island, Queens, New Jersey and Long Island, gasoline and electricity remained scarce as temperatures dropped.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/11/01/storm-aftermath-live-updates-4/', 'snippet': 'The patchy recovery from Hurricane Sandy exposed a split region. Lights flickered on in Manhattan and subways rumbled, but in stretches of Staten Island, Queens, New Jersey and Long Island, gasoline and electricity remained scarce as temperatures ...', 'lead_paragraph': 'On Monday morning, commuters returned to work on the city’s buses and trains, which were operating on normal or modified schedules, and the majority of students were able to return to classrooms. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Storm Aftermath: Live Updates', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-01T20:39:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/a876b90a-1d81-525d-bf13-323c4d7643de', 'word_count': 41546, 'uri': 'nyt://article/a876b90a-1d81-525d-bf13-323c4d7643de'}, {'abstract': 'The federal Hazard Mitigation Grant Program may be an option for property owners who want to relocate.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/11/01/a-grant-program-for-some-storm-weary-property-owners/', 'snippet': 'The federal Hazard Mitigation Grant Program may be an option for property owners who want to relocate.', 'lead_paragraph': 'Homeowners in New York, New Jersey and Connecticut whose homes were badly damaged by Hurricane Sandy may want to consider whether filing a claim for repairs under their flood insurance policies is their best option.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Grant Program for Some Storm-Weary Property Owners', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Disasters and Emergencies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricane Sandy (2012)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Insurance', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Emergency Management Agency', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-01T20:45:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c707c9cc-4522-5f93-8b8c-bceaa2d628e3', 'word_count': 380, 'uri': 'nyt://article/c707c9cc-4522-5f93-8b8c-bceaa2d628e3'}, {'abstract': 'Along with co-hosting “Weekend Today,” Ms. Hill will be a national correspondent for NBC News, which means she will report stories for “Today,” “NBC Nightly News” and other broadcasts.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/11/01/erica-hill-formerly-of-cbss-morning-show-to-join-weekend-today/', 'snippet': 'Along with co-hosting “Weekend Today,” Ms. Hill will be a national correspondent for NBC News, which means she will report stories for “Today,” “NBC Nightly News” and other broadcasts.', 'lead_paragraph': 'NBC confirmed on Thursday that Erica Hill, a former anchor at CBS and CNN, would become a part of the “Weekend Today” team starting on Saturday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Erica Hill, Formerly of CBS’s Morning Show, to Join ‘Weekend Today’', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hill, Erica', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'NBC News', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-01T20:45:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b140dc9-b42c-5631-8240-3d98ca9f7f5a', 'word_count': 206, 'uri': 'nyt://article/0b140dc9-b42c-5631-8240-3d98ca9f7f5a'}, {'abstract': 'The statistical wizard’s offer to wager on the outcome of the presidential race is a bad choice.', 'web_url': 'https://publiceditor.blogs.nytimes.com/2012/11/01/under-attack-nate-silver-picks-the-wrong-defense/', 'snippet': 'The statistical wizard’s offer to wager on the outcome of the presidential race is a bad choice.', 'lead_paragraph': '“Anybody that thinks that this race is anything but a tossup right now is such an ideologue, they should be kept away from typewriters, computers, laptops and microphones for the next 10 days, because they’re jokes.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Under Attack, Nate Silver Picks the Wrong Defense', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Silver, Nate', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-01T20:48:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8ceb3d84-6082-53e9-93e3-354820ceae15', 'word_count': 657, 'uri': 'nyt://article/8ceb3d84-6082-53e9-93e3-354820ceae15'}, {'abstract': 'Further notes on the great polling debate.', 'web_url': 'https://douthat.blogs.nytimes.com/2012/11/01/who-will-vote/', 'snippet': 'Further notes on the great polling debate.', 'lead_paragraph': 'My Campaign Stops column this week didn’t dive too deeply into the substance of the recent polling controversies, but for anyone confused by the “which polls do you trust?” debate, or why there’s any debate at all,\xa0this piece from National Journal’s Reid Wilson on the unusual discrepancy between Democratic and Republican projections is a very useful read:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Who Will Vote?', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-01T20:49:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8c752a68-f0d5-540e-b238-168c1582eb39', 'word_count': 687, 'uri': 'nyt://article/8c752a68-f0d5-540e-b238-168c1582eb39'}, {'abstract': 'Style news we’re reading now, from Coco Rocha’s Halloween fashion film to the fashion of meteorology.', 'web_url': 'https://runway.blogs.nytimes.com/2012/11/01/what-were-reading-now-besides-hurricane-sandy-aftermath-updates/', 'snippet': 'Style news we’re reading now, from Coco Rocha’s Halloween fashion film to the fashion of meteorology.', 'lead_paragraph': 'In many New York City neighborhoods last night, determined trick-or-treaters and their parents held costumed block parties. Meanwhile, the ever-busy Coco Rocha and Ellen von Unwerth produced a Halloween fashion film. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading Now (Besides Hurricane Sandy Aftermath Updates)', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-01T20:50:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/621c1e12-397b-558b-aa5f-dcc63858133a', 'word_count': 110, 'uri': 'nyt://article/621c1e12-397b-558b-aa5f-dcc63858133a'}, {'abstract': 'Our Getaway columnist searches for the best way to find a hotel in Manhattan, where a broad swath is without power and finds there is no simple answer.', 'web_url': 'https://intransit.blogs.nytimes.com/2012/11/01/booking-a-hotel-in-new-york-use-your-cell-power-to-call-not-surf/', 'snippet': 'Our Getaway columnist searches for the best way to find a hotel in Manhattan, where a broad swath is without power and finds there is no simple answer.', 'lead_paragraph': 'With power still out in Lower Manhattan after Hurricane Sandy, hotels are doing their best to take in stranded tourists, displaced New Yorkers, their own employees and thousands of visitors streaming into town for the New York Marathon.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/01/travel/01-hotels-westin/01-hotels-westin-jumbo.jpg', 'height': 690, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/01/travel/01-hotels-westin/01-hotels-westin-superJumbo.jpg', 'height': 1380, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/01/travel/01-hotels-westin/01-hotels-westin-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/01/travel/01-hotels-westin/01-hotels-westin-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image'