ge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Rolling Stones', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Rolling Stones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wood, Ron', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jagger, Mick', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Norman, Philip', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Watts, Charlie', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Rolling Stones', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Richards, Keith', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-11-30T17:00:52+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Pat Irwin', 'person': [{'firstname': 'Pat', 'middlename': None, 'lastname': 'Irwin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/453991a6-b53b-52e7-b0ba-658ca61404b5', 'word_count': 1093, 'uri': 'nyt://article/453991a6-b53b-52e7-b0ba-658ca61404b5'}, {'abstract': 'This catalog of an exhibition at the National Gallery of Art in Washington offers an account of artists’ use and abuse of the newspaper from 1909 to 2009.', 'web_url': 'https://www.nytimes.com/2012/12/02/books/review/shock-of-the-news-on-artists-and-newspapers.html', 'snippet': 'This catalog of an exhibition at the National Gallery of Art in Washington offers an account of artists’ use and abuse of the newspaper from 1909 to 2009.', 'lead_paragraph': 'When my kids get ready to make art, they reach for the newspaper. Cheap and always available, it’s our household’s all-purpose work surface for messy creativity. And when the kids are done, their creations proudly drying on the kitchen counter, the paint-spattered, goop-glopped newspaper pages spread out to protect the table are often striking to look at in their own right: a Syrian rebel disappearing into a burst of pink watercolor; an exposé of Wall Street crimes redacted with glue blobs and fake feathers.', 'print_section': 'BR', 'print_page': '67', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Rotella/1202-Rotella-jumbo.jpg', 'height': 1024, 'width': 856, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Rotella/1202-Rotella-superJumbo.jpg', 'height': 2048, 'width': 1712, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Rotella/1202-Rotella-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/12/02/books/review/1202-Rotella/1202-Rotella-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/12/02/books/review/1202-Rotella/1202-Rotella-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Recycled Newsprint', 'kicker': None, 'content_kicker': None, 'print_headline': 'Recycled Newsprint', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Newspapers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brodie, Judith', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Gallery of Art', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-30T17:02:51+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Carlo Rotella', 'person': [{'firstname': 'Carlo', 'middlename': None, 'lastname': 'Rotella', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d5b67cbc-889e-5c4a-a540-4d24c9d99917', 'word_count': 616, 'uri': 'nyt://article/d5b67cbc-889e-5c4a-a540-4d24c9d99917'}, {'abstract': 'Interviews with 60 artists about the influence of Andy Warhol, based on a show at the Metropolitan Museum.', 'web_url': 'https://www.nytimes.com/2012/12/02/books/review/regarding-warhol-sixty-artists-fifty-years.html', 'snippet': 'Interviews with 60 artists about the influence of Andy Warhol, based on a show at the Metropolitan Museum.', 'lead_paragraph': '“Regarding Warhol: Sixty Artists, Fifty Years” is the latest entry in the museum annex of the ubiquitous Andy Warhol industry. A purveyor of quotable, gnomic epigrams, ready-made images pinched from popular culture, and experimental films in which nearly nothing happens, Warhol, who died in 1987, was the most famous of the Pop artists. Art world sophisticates also credit him with a major role in the death of painting, which was written off as a medium in the 1960s, and with opening up the sacrosanct domain of art to every kind of subject matter — from celebrity portraits and Brillo boxes to adventures in drag and ads for plastic surgery.', 'print_section': 'BR', 'print_page': '66', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': N