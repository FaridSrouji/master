ddlename': None, 'lastname': 'Raina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd5deb43-ee23-513c-9e9d-0dd793642ad9', 'word_count': 309, 'uri': 'nyt://article/cd5deb43-ee23-513c-9e9d-0dd793642ad9'}, {'abstract': 'India is the largest consumer of whiskey in the world, by volume.', 'web_url': 'https://india.blogs.nytimes.com/2012/11/09/indias-appetite-for-whiskey-attracts-diageo/', 'snippet': 'India is the largest consumer of whiskey in the world, by volume.', 'lead_paragraph': 'India is the largest guzzler of whiskey in the world. One of the fastest-growing whiskey markets, it is estimated to be worth about $10 billion by 2013, according to a trade group study from last year.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'India’s Appetite for Whiskey Attracts Diageo', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Whiskey', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bachchan, Amitabh', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mallya, Vijay', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Diageo PLC', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'United Spirits', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-11-09T14:25:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Sruthi Gottipati', 'person': [{'firstname': 'Sruthi', 'middlename': None, 'lastname': 'Gottipati', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/218f31da-a372-5a0c-88f0-e1bd07096002', 'word_count': 538, 'uri': 'nyt://article/218f31da-a372-5a0c-88f0-e1bd07096002'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/11/09/what-were-reading-564/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'Chicago Reader: “It’s one of those things you almost wish man hadn’t discovered, kind of like nuclear weapons,” said Chris Curren. He was talking about ghost peppers, which are insanely incendiary. Nevertheless he figured out a way to make huevos rancheros with them, and even a Bloody Mary. — Jeff Gordinier ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-09T14:33:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/08f7cc5e-2eb4-5a6e-be37-e506f4afe09b', 'word_count': 483, 'uri': 'nyt://article/08f7cc5e-2eb4-5a6e-be37-e506f4afe09b'}, {'abstract': 'Also, a look at how the Obama campaign’s vaunted “ground game” was aided by mobile technology, open-source software and cloud computing.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/11/09/the-breakfast-meeting-seals-punished-for-video-game-work-and-samsung-in-the-lead/', 'snippet': 'Also, a look at how the Obama campaign’s vaunted “ground game” was aided by mobile technology, open-source software and cloud computing.', 'lead_paragraph': 'Seven members of the secretive Navy SEAL Team 6 have been punished for disclosing classified information to the makers of the video game “Medal of Honor: Warfighter,” The Associated Press reported. The violations by the SEALs — which led to punitive letters of reprimand and a partial forfeiture of pay for two months — include not seeking permission of their command to take part in the video project and showing the video designers some of their specially designed combat equipment unique to their unit.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Breakfast Meeting: SEALs Punished for Video Game Work, and Samsung in the Lead', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Navy Seals', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Samsung Group', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-09T14:37:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Noam Cohen', 'person': [{'firstname': 'Noam', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2c4437ec-661f-5b0c-a74a-df470c4606bf', 'word_count': 301, 'uri': 'nyt://article/2c4437ec-661f-5b0c-a74a-df470c4606bf'}, {'abstract': 'Tips on using squash in your pumpkin pie, tax breaks on gifts are soon to end, submerged older cars may be salvageable and other consumer-focused news from The New York Times.', 'web_url': 'https://bucks.blogs.nytimes.com/2012/11/09/friday-reading-tips-on-using-squash-in-your-pumpkin-pie/', 'snippet': 'Tips on using squash in your pumpkin pie, tax breaks on gifts are soon to end, submerged o