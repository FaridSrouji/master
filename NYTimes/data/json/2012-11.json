d9c18d6-a059-5e80-a8ee-32d933be14d7', 'word_count': 768, 'uri': 'nyt://article/0d9c18d6-a059-5e80-a8ee-32d933be14d7'}, {'abstract': 'The Hall of Fame trainer Bob Baffert, who had a heart operation in March, will saddle the 9-5 favorite Game On Dude in Saturday’s Breeders’ Cup Classic.', 'web_url': 'https://www.nytimes.com/2012/11/01/sports/after-heart-attack-baffert-plans-to-keep-working-hard-and-winning-big.html', 'snippet': 'The Hall of Fame trainer Bob Baffert, who had a heart operation in March, will saddle the 9-5 favorite Game On Dude in Saturday’s Breeders’ Cup Classic.', 'lead_paragraph': 'ARCADIA, Calif. — Bob Baffert, the Hall of Fame trainer, changed many aspects of his life after sustaining a heart attack on March 26 in Dubai and having surgery to relieve blockages in the left side of his heart. He lost 20 pounds. He eats red meat sparingly. He exercises regularly.', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/01/sports/sub-Racing/sub-Racing-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/01/sports/sub-Racing/sub-Racing-superJumbo.jpg', 'height': 1150, 'width': 1771, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/01/sports/sub-Racing/sub-Racing-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/01/sports/sub-Racing/sub-Racing-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/01/sports/sub-Racing/sub-Racing-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After Heart Attack, Baffert Plans to Keep Winning Big', 'kicker': None, 'content_kicker': None, 'print_headline': 'After Heart Attack, Baffert Plans to Keep Winning Big', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jockeys, Drivers and Trainers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Breeders' Cup (Horse Races)", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Heart', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Baffert, Bob', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Horse Racing', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-01T00:56:52+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Tom Pedulla', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Pedulla', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f3d22f6-14d5-502b-8012-b8a6c69a3bc8', 'word_count': 870, 'uri': 'nyt://article/3f3d22f6-14d5-502b-8012-b8a6c69a3bc8'}, {'abstract': 'The approval of the cabinet brings to an end months of uncertainty about who was in charge of the government.', 'web_url': 'https://www.nytimes.com/2012/11/01/world/africa/libya-parliament-approves-new-premiers-cabinet.html', 'snippet': 'The approval of the cabinet brings to an end months of uncertainty about who was in charge of the government.', 'lead_paragraph': 'CAIRO — The Libyan Parliament voted overwhelmingly on Wednesday to approve the new prime minister’s cabinet, ending months of uncertainty about who was in charge of the government. The top officials of defense and security are now expected to take responsibility for investigating the attack on the American Mission in Benghazi on Sept. 11 of this year, as well as the larger challenge of controlling the militias that have dominated Libya since the death of Col. Muammar el-Qaddafi more than a year ago.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Libya Parliament Approves New Premier’s Cabinet', 'kicker': None, 'content_kicker': None, 'print_headline': 'Libya: Legislators Approve New Cabinet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jibril, Mahmoud', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Legislatures and Parliaments', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Libya', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Front for the Salvation of Libya', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-01T00:58:15+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By David D. Kirkpatrick', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/145a21b7-c680-52b2-a8d9-1e455f4216ba', 'word_count': 340, 'uri': 'nyt://article/145a21b7-c680-52b2-a8d9-1e455f4216ba'}, {'abstract': 'A month into another blockbuster term (Affirmative action! Voting rights! Same-sex marriage!), the Supreme Court is curiously missing from our national conversation.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/10/31/the-sound-of-silence/', 'snippet': 'A month into another blockbuster term (Affirmative action! Voting rights! Same-sex marriage!), the Supreme Court is curiously missing from our national conversation.', 'lead_paragraph': 'Reading about the belated scramble by Massachusetts regulators to inspect the compounding pharmacies in their state in the wake of the meningitis crisis left me wondering about the apparent lack of federal oversight of the $3 billion compounding pharmacy industry. And that thought in turn called to mind an obscure Supreme Court decision from a decade ago that invoked the First Amendment to block one avenue of attempted federal regulation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Sound of Silence', 'kicker': 'Linda Greenhouse', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-01T01:00:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Linda Greenhouse', 'person': [{'firstname': 'Linda', 'middlename': None, 'lastname': 'Greenhouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/813a22ab-fce9-5b68-bf2e-00ce5a180731', 'word_count': 1267, 'uri': 'nyt://article/813a22ab-fce9-5b68-bf2e-00ce5a180731'}, {'abstract': 'Mitt Romney can’t admit that the auto bailout helped Detroit and America, so instead he invents problems with it.', 'web_url': 'https://www.nytimes.com/2012/11/01/opinion/mitt-romney-versus-the-automakers.html', 'snippet': 'Mitt Romney can’t admit that the auto bailout helped Detroit and America, so instead he invents problems with it.', 'lead_paragraph': 'When General Motors tells a presidential campaign that it is engaging in “cynical campaign politics at its worst,” that’s a pretty good signal that the campaign has crossed a red line and ought to pull back. Not Mitt Romney’s campaign. Having broadcast an outrageously deceitful ad attacking the auto bailout, the campaign ignored the howls from carmakers and came back with more.', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney Versus the Automakers', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Romney Versus the Automakers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Romney, Mitt', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'General Motors', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Chrysler Group LLC', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-11-01T01:03:17+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/11108ed5-47cf-5b27-8d6c-cdc16e25708b', 'word_count': 540, 'uri': 'nyt://article/11108ed5-47cf-5b27-8d6c-cdc16e25708b'}, {'abstract': 'The constitutional protection from searches without a warrant should include protection from the police using a dog to smell for drugs.', 'web_url': 'https://www.nytimes.com/2012/11/01/opinion/sniffing-dogs-and-the-fourth-amendment.html', 'snippet': 'The constitutional protection from searches without a warrant should include protection from the police using a dog to smell for drugs.', 'lead_paragraph': 'A person’s home is a place where the Constitution resolutely protects the right to privacy and the freedom from unreasonable government intrusion. That should include protection under the Fourth Amendment from the police using a dog to smell for drugs outside the door of a house without a warrant. ', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sniffing Dogs and the Fourth Amendment', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Sniffing Dogs and the Fourth Amendment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Search and Seizure', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fourth Amendment (US Constitution)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dogs', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-11-01T01:03:46+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/7c50d8d3-1b45-5ea1-b128-846dd17e558e', 'word_count': 550, 'uri': 'nyt://article/7c50d8d3-1b45-5ea1-b128-846dd17e558e'}, {'abstract': 'A mile-by-mile look at the New York City Marathon ahead of the Nov. 4 race. Today: Mile 23 takes runners past some of the world’s premier cultural institutions.', 'web_url': 'https://marathon.blogs.nytimes.com/2012/10/31/mile-23-some-culture-to-soothe-the-pain/', 'snippet': 'A mile-by-mile look at the New York City Marathon ahead of the Nov. 4 race. Today: Mile 23 takes runners past some of the world’s premier cultural institutions.', 'lead_paragraph': 'After a little jog around the lovely Marcus Garvey Park, the marathon route returns to Fifth Avenue.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mile 23: Some Culture to Soothe the Pain', 'kicker': 'On the Run', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New York City Marathon', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Running', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'El Museo del Barrio', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum of the City of New York', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'CENTRAL PARK (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Museum Mile (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-01T01:09:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Brian Fidelman', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Fidelman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3bd1e98-5d0c-59d8-b276-e7f6a3d841f2', 'word_count': 299, 'uri': 'nyt://article/e3bd1e98-5d0c-59d8-b276-e7f6a3d841f2'}, {'abstract': 'A decision to fire Scott Forstall, the leader of mobile software development, means the departure of a high-ranking proponent of the visual design style for software favored by Steve Jobs.', 'web_url': 'https://www.nytimes.com/2012/11/01/technology/apple-shake-up-could-mean-end-to-real-world-images-in-software.html', 'snippet': 'A decision to fire Scott Forstall, the leader of mobile software development, means the departure of a high-ranking proponent of the visual design style for software favored by Steve Jobs.', 'lead_paragraph': 'Whether they realize it or not, all of those who swipe a finger down from the top of the iPhone’s screen to check for notifications are bearing witness to a big sore point within Apple.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [