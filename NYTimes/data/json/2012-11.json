rticle/c1122132-25b2-59ef-9a4c-ad8399527066', 'word_count': 1054, 'uri': 'nyt://article/c1122132-25b2-59ef-9a4c-ad8399527066'}, {'abstract': 'The holiday season is a good time to pause and reflect.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/11/30/t-holiday-2012-editors-letter/', 'snippet': 'The holiday season is a good time to pause and reflect.', 'lead_paragraph': 'Every fall, when the editors of T plan the Holiday issue, we start, logically enough, with stuff. And boy is there a lot of it this time of year. Ethel Park and Jane Herman went after it like scientists, indexing and aggregating a head-spinning barrage of bags and perfumes and cakes and canoes into a lusty assortment of gifts — all cleverly displayed à la Bergdorf’s in a series of windows by the set designer Nicholas Des Jardins.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'T Holiday 2012 | Editor’s Letter', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-30T21:00:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Jeffries Blackerby', 'person': [{'firstname': 'Jeffries', 'middlename': None, 'lastname': 'Blackerby', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e1d7e7e3-9084-55de-bc09-4a2900236b66', 'word_count': 339, 'uri': 'nyt://article/e1d7e7e3-9084-55de-bc09-4a2900236b66'}, {'abstract': 'Boston’s defense has shown some cracks this season, and the team is suddenly relying on offense to win games.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2012/11/30/are-the-celtics-losing-their-defensive-identity/', 'snippet': 'Boston’s defense has shown some cracks this season, and the team is suddenly relying on offense to win games.', 'lead_paragraph': '“We’re a soft team right now. We don’t have any toughness. That [fighting] stuff is not toughness.” – Celtics Coach Doc Rivers, after Boston’s 95-83 loss to the Nets on Wednesday', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/sports/basketball/30rivers/30rivers-jumbo.jpg', 'height': 645, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/sports/basketball/30rivers/30rivers-superJumbo.jpg', 'height': 1291, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/sports/basketball/30rivers/30rivers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/30/sports/basketball/30rivers/30rivers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/30/sports/basketball/30rivers/30rivers-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Are the Celtics Losing Their Defensive Identity?', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rivers, Doc', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rondo, Rajon', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sullinger, Jared', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Terry, Jason', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Celtics', 'rank': 6, 'major': 'N'}], 'pub_date'