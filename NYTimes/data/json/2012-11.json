': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sports/YLIVESTRONG/YLIVESTRONG-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Charitable Efforts Go On Without Event', 'kicker': None, 'content_kicker': None, 'print_headline': 'Charitable Efforts Go On Without Event', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New York City Marathon', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Armstrong, Lance, Foundation', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Road Runners Club', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Running', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'ARMSTRONG, LANCE', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-03T17:26:00+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Mary Pilon', 'person': [{'firstname': 'Mary', 'middlename': None, 'lastname': 'Pilon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30df31ec-8d3f-506c-89a8-f30e655948d8', 'word_count': 816, 'uri': 'nyt://article/30df31ec-8d3f-506c-89a8-f30e655948d8'}, {'abstract': 'Hallucinations are often entirely normal and can be entertaining.', 'web_url': 'https://www.nytimes.com/2012/11/04/opinion/sunday/seeing-things-hearing-things-many-of-us-do.html', 'snippet': 'Hallucinations are often entirely normal and can be entertaining.', 'lead_paragraph': 'HALLUCINATIONS are very startling and frightening: you suddenly see, or hear or smell something — something that is not there. Your immediate, bewildered feeling is, what is going on? Where is this coming from? The hallucination is convincingly real, produced by the same neural pathways as actual perception, and yet no one else seems to see it. And then you are forced to the conclusion that something — something unprecedented — is happening in your own brain or mind. Are you going insane, getting dementia, having a stroke?', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sunday-review/04HALLUCINATION/04HALLUCINATION-jumbo.jpg', 'height': 1024, 'width': 974, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sunday-review/04HALLUCINATION/04HALLUCINATION-superJumbo.jpg', 'height': 1997, 'width': 1899, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sunday-review/04HALLUCINATION/04HALLUCINATION-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/04/sunday-review/04HALLUCINATION/04HALLUCINATION-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/04/sunday-review/04HALLUCINATION/04HALLUCINATION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seeing Things? Hearing Things? Many of Us Do', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'Seeing Things? Hearing Things? Many of Us Do', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hallucinations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Schizophrenia', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-03T17:26:16+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Oliver Sacks', 'person': [{'firstname': 'Oliver', 'middlename': None, 'lastname': 'Sacks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/81929375-9410-5a19-910f-06862eddab62', 'word_count': 1074, 'uri': 'nyt://article/81929375-9410-5a19-910f-06862eddab62'}, {'abstract': 'Runners who came to New York for the marathon spent time at the finish line in Central Park on Saturday, taking photos and expressing a range of emotions about the cancellation of the race.', 'web_url': 'https://marathon.blogs.nytimes.com/2012/11/03/in-central-park-understanding-and-unhappiness/', 'snippet': 'Runners who came to New York for the marathon spent time at the finish line in Central Park on Saturday, taking photos and expressing a range of emotions about the cancellation of the race.', 'lead_paragraph': 'They came into Central Park wearing their bright orange New York City Marathon jerseys, and the singlets from their running clubs from around the world. They spoke in French, Italian, Dutch, taking pictures in front of the finish line they would never officially cross. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Central Park, Understanding and Unhappiness', 'kicker': 'On the Run', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-03T17:35:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Liz Robbins', 'person': [{'firstname': 'Liz', 'middlename': None, 'lastname': 'Robbins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cc173407-968b-5ce5-8005-cfc01b542c2a', 'word_count': 351, 'uri': 'nyt://article/cc173407-968b-5ce5-8005-cfc01b542c2a'}, {'abstract': 'No one is having more fun on the campaign trail than the three young children of Paul and Janna Ryan.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/11/03/ryan-children-enjoying-the-trail-in-the-campaigns-final-days/', 'snippet': 'No one is having more fun on the campaign trail than the three young children of Paul and Janna Ryan.', 'lead_paragraph': 'MARIETTA, Ohio — In these final 72 hours of slogging through four states a day, candidates, reporters and staff members can all feel like the walking dead.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ryan Children Enjoying the Trail in the Campaign’s Final Days', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Paul D Jr', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-11-03T17:37:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/106f451b-d187-54be-9764-05ab67c0cad2', 'word_count': 369, 'uri': 'nyt://article/106f451b-d187-54be-9764-05ab67c0cad2'}, {'abstract': 'Mark Gottfried, in his second season as the men’s basketball coach at North Carolina State, plans to take the Wolfpack back to the elite in the A.C.C. and nationally.', 'web_url': 'https://www.nytimes.com/2012/11/04/sports/ncaabasketball/nc-state-hopes-to-hoist-a-new-banner-in-mens