, 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Silver, Nate', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wolfers, Justin', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-02T10:00:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By David Leonhardt', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b1a5f805-fabf-527a-aabc-8a5c1787694e', 'word_count': 1288, 'uri': 'nyt://article/b1a5f805-fabf-527a-aabc-8a5c1787694e'}, {'abstract': 'Political news from today’s Times, plus a look at what’s happening in Washington.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/11/02/the-early-word-bloomberg/', 'snippet': 'Political news from today’s Times, plus a look at what’s happening in Washington.', 'lead_paragraph': 'In Today’s Times:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Early Word: Bloomberg', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-02T10:00:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Emmarie Huetteman', 'person': [{'firstname': 'Emmarie', 'middlename': None, 'lastname': 'Huetteman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/58de152c-3fae-56f5-9e12-0a390954