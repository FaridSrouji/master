middlename': None, 'lastname': 'Zeleny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/348c8573-feac-5497-9d76-afbab611a624', 'word_count': 438, 'uri': 'nyt://article/348c8573-feac-5497-9d76-afbab611a624'}, {'abstract': 'BMW is portraying the “i” brand as a response to big issues like population growth and urban congestion.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/11/14/bmw-shows-off-its-new-i-brand-electrics-in-new-york/', 'snippet': 'BMW is portraying the “i” brand as a response to big issues like population growth and urban congestion.', 'lead_paragraph': 'The portraits of the cars — BMW’s new “i” brand electrics — stand two stories high across from Bryant Park in Manhattan this week. The gleaming images signal the presence of the company’s “Born Electric World Tour,” a display of models from the “i” subbrand, on view at 1095 Avenue of the Americas through Sunday. Hours are 10 a.m. to 10 p.m.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'BMW Shows Off Its New ‘i’ Brand Electrics in New York', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-15T01:43:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Phil Patton', 'person': [{'firstname': 'Phil', 'middlename': None, 'lastname': 'Patton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b1a379f-bc41-5913-b55c-af8ed4d61353', 'word_count': 815, 'uri': 'nyt://article/1b1a379f-bc41-5913-b55c-af8ed4d61353'}, {'abstract': 'The central question in the constitutional debate on the Voting Rights Act is whether times have changed enough to make the law obsolete.', 'web_url': 'https://campaignstops.blogs.nytimes.com/2012/11/14/is-the-voting-rights-act-doomed/', 'snippet': 'The central question in the constitutional debate on the Voting Rights Act is whether times have changed enough to make the law obsolete.', 'lead_paragraph': 'DOES the re-election of the first black president mean the Voting Rights Act of 1965 is unnecessary and perhaps unconstitutional? The Supreme Court’s decision last week to consider a constitutional challenge to a key section of the act suggests that a perverse outcome of the 2012 campaign may be thatPresident Obama’s victory spells doom for the civil rights law most responsible for African-American enfranchisement.', 'print_section': 'A', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is the Voting Rights Act Doomed?', 'kicker': 'Campaign Stops', 'content_kicker': None, 'print_headline': 'Is the Voting Rights Act Doomed?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Constitution (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Voter Registration and Requirements', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Voting Rights Act (1965)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-11-15T01:48:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Nathaniel Persily', 'person': [{'firstname': 'Nathaniel', 'middlename': None, 'lastname': 'Persily', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b47f9ba3-f168-56de-9bf5-183264bc79e0', 'word_count': 902, 'uri': 'nyt://article/b47f9ba3-f168-56de-9bf5-183264bc79e0'}, {'abstract': 'Rita A. Crundwell, former comptroller of Dixon, Ill., is said to have used the money to pay for a lavish life and a horse-breeding business.', 'web_url': 'https://www.nytimes.com/2012/11/15/us/former-official-pleads-guilty-to-defrauding-illinois-town-of-53-million.html', 'snippet': 'Rita A. Crundwell, former comptroller of Dixon, Ill., is said to have used the money to pay for a lavish life and a horse-breeding business.', 'lead_paragraph': 'ROCKFORD, Ill. — Hundreds of horses. Multiple houses. A $2.1 million luxury motor home. In hindsight, they all pointed to the unfathomable: Rita A. Crundwell, while comptroller of a small town two hours west of Chicago, had raided public coffers for decades to pay for a lavish life and a horse-breeding business.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/15/us/DIXON/DIXON-jumbo.jpg', 'height': 477, 'width': 481, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/15/us/DIXON/DIXON-superJumbo.jpg', 'height': 477, 'width': 481, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/15/us/DIXON/DIXON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/15/us/DIXON/DIXON-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/15/us/DIXON/DIXON-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'mai