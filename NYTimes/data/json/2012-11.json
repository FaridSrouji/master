thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/21/booming/21lucillebliss-booming/21lucillebliss-booming-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/21/booming/21lucillebliss-booming/21lucillebliss-booming-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A TV Pioneer, in Rabbit Form', 'kicker': 'An Appreciation', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ANIMATED FILMS', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-21T19:02:40+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b2a33ee7-c632-5722-a4c7-baecc8b6aef2', 'word_count': 461, 'uri': 'nyt://article/b2a33ee7-c632-5722-a4c7-baecc8b6aef2'}, {'abstract': 'Preparing to record his own audiobook, John Schwartz took a closer look at the art of storytelling.', 'web_url': 'https://www.nytimes.com/2012/11/25/books/review/sound-check.html', 'snippet': 'Preparing to record his own audiobook, John Schwartz took a closer look at the art of storytelling.', 'lead_paragraph': 'From inside the booth, the actor quietly spun magic. John Keating was reading “Vengeance,” the latest crime novel by Benjamin Black (the pen name of the Man Booker Prize-\xadwinning author John Banville).', '