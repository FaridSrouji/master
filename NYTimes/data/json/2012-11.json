.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08QNA2_SPAN/8QNA2-jumbo.jpg', 'height': 783, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08QNA2_SPAN/8QNA2-superJumbo.jpg', 'height': 1566, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08QNA2_SPAN/8QNA2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/08/garden/08QNA2_SPAN/8QNA2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08QNA2_SPAN/8QNA2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sitting Pretty on a Cult Classic', 'kicker': 'Currents | Q&A', 'content_kicker': None, 'print_headline': 'Sitting Pretty on a Cult Classic', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Nelson, George (1908-86)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Longinotti, Hilda', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-07T23:51:52+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Julie Lasky', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Lasky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/797319db-ea64-55b1-98fb-6b40fb47d601', 'word_count': 916, 'uri': 'nyt://article/797319db-ea64-55b1-98fb-6b40fb47d601'}, {'abstract': 'Simone Crestani, an Italian designer, finds adventurous forms for Venetian glass chandeliers.', 'web_url': 'https://www.nytimes.com/2012/11/08/garden/limited-edition-chandeliers-in-greenwich-village.html', 'snippet': 'Simone Crestani, an Italian designer, finds adventurous forms for Venetian glass chandeliers.', 'lead_paragraph': 'Simone Crestani, a 28-year-old Italian glass designer, has been putting his own contemporary spin on Venetian glass with lifelike objects inspired by nature, including delicate trees and skeletal fish. But for his new limited-edition chandeliers, on view at Bernd Goeckler Antiques in Greenwich Village, he went a little more abstract. His Net chandelier ($29,000), which encloses frosted orbs in a wavy grid of glass, is inspired “by a cloud with spots of light inside, like sunlight passing through,” Mr. Crestani said, adding that the piece took about three weeks to make.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08LIGHTING/8CURR5-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08LIGHTING/8CURR5-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08LIGHTING/8CURR5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/08/garden/08LIGHTING/8CURR5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08LIGHTING/8CURR5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Frosted Orbs and Sparkling Bubbles', 'kicker': 'Currents | Lighting', 'content_kicker': None, 'print_headline': 'Frosted Orbs and Sparkling Bubbles', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lighting', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Lamps and Lampshades', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Crestani, Simone', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-07T23:52:32+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/858623c5-87a4-57dc-86da-06ad34d81530', 'word_count': 146, 'uri': 'nyt://article/858623c5-87a4-57dc-86da-06ad34d81530'}, {'abstract': 'Having refreshed the look of McDonald’s in France, Patrick Norguet revises another stalwart: the bistro chair.', 'web_url': 'https://www.nytimes.com/2012/11/08/garden/a-classic-bistro-chair-gets-an-update.html', 'snippet': 'Having refreshed the look of McDonald’s in France, Patrick Norguet revises another stalwart: the bistro chair.', 'lead_paragraph': 'Patrick Norguet, the French designer in charge of creating a new architectural identity for McDonald’s in France — the first updated restaurant opened in Villefranche-de-Lauragais early this year, with six more in the pipeline — has also taken on a different icon: Paris’s famed bistro chair. The rattan chaise, which comes in a wide variety of colors and weaves and is the seating at classic Parisian brasseries like Café de Flore and Les Deux Magots, has been produced by Drucker, a French manufacturer, since 1885. Mr. Norguet was seized by the idea of updating it and contacted the surprisingly accommodating manufacturer. Et voilà! His version has a somewhat similar silhouette but now offers an unmistakable modernity. Streamlined and svelte, its metal frame, wrapped in monochromatic rattan, has graceful flowing lines. The chair, Republica, comes in four colors. $300 from Drucker, 011-33-03-44-88-32-92 or drucker.fr.\xa0', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08FURNITURE_SPAN/08FURNITURE_SPAN-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/08/garden/08FURNITURE_SPAN/08FURNITURE_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08FURNITURE_SPAN/08FURNITURE_SPAN-jumbo.jpg', 'height': 637, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08FURNITURE_SPAN/08FURNITURE_SPAN-superJumbo.jpg', 'height': 1275, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/08/garden/08FURNITURE_SPAN/08FURNITURE_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/08/garden/08FURNITURE_SPAN/08FURNITURE_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0