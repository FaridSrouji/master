9-91ca-33c1531364eb', 'word_count': 943, 'uri': 'nyt://article/846e98ae-9443-5df9-91ca-33c1531364eb'}, {'abstract': 'A company proposes a new method for vitrification, in which radioactive material is mixed with glass before being cooled in steel containers.', 'web_url': 'https://green.blogs.nytimes.com/2012/11/06/a-new-approach-to-military-nuclear-waste/', 'snippet': 'A company proposes a new method for vitrification, in which radioactive material is mixed with glass before being cooled in steel containers.', 'lead_paragraph': 'The United States has many pressing nuclear waste problems, but the worst may be the leftovers from the manufacturing of nuclear weapons. Unlike the wastes from civilian reactors, the military wastes are liquids and sludges stored in underground tanks in environmentally sensitive areas. Scores of tanks have leaked some of the material into the dirt. And there is no debate about how the wastes might be repurposed; they have already been scavenged for useful materials like uranium and plutonium. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New Approach to Military Nuclear Waste', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Glass', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Wastes', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Energy Department', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-11-06T17:16:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Matthew L. Wald', 'person': [{'firstname': 'Matthew', 'middlename': 'L.', 'lastname': 'Wald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed14a346-41fd-5509-b877-6031a7023eda', 'word_count': 773, 'uri': 'nyt://article/ed14a346-41fd-5509-b877-6031a7023eda'}, {'abstract': 'A disclosure requirement might be one way to address the “empty creditor” problem that comes up in times of financial distress.', 'web_url': 'https://dealbook.nytimes.com/2012/11/06/restructurings-and-the-impact-of-credit-default-swaps/', 'snippet': 'A disclosure requirement might be one way to address the “empty creditor” problem that comes up in times of financial distress.', 'lead_paragraph': 'Last week we learned that one of the biggest critics of derivatives – Warren E. Buffett – actually made a lot of money from them.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Restructurings and the Impact of Credit-Default Swaps', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bankruptcies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Credit Default Swaps', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Derivatives (Financial Instruments)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-11-06T17:17:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Stephen J. Lubben', 'person': [{'firstname': 'Stephen', 'middlename': 'J.', 'lastname': 'Lubben', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92095475-43a3-55ec-935b-d5df2ad8bb5d', 'word_count': 499, 'uri': 'nyt://article/92095475-43a3-55ec-935b-d5df2ad8bb5d'}, {'abstract': 'While the heyday of top-level athletes serving in Congress seems to have passed, this Election Day offers a supply of reserves.', 'web_url': 'https://www.nytimes.com/2012/11/07/sports/politicians-who-know-how-to-play-ball.html', 'snippet': 'While the heyday of top-level athletes serving in Congress seems to have passed, this Election Day offers a supply of reserves.', 'lead_paragraph': 'BALTIMORE — One very tall man in Maryland knows something about competing hard until the game ends. That man, Tom McMillen, had this advice for candidates in the elections Tuesday: shake every hand.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/07/sports/athletes2/athletes2-articleLarge-v2.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/07/sports/athletes2/athletes2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/07/sports/athletes2/athletes2-jumbo-v2.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/07/sports/athletes2/athletes2-superJumbo-v2.jpg', 'height': 1384, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/07/sports/athletes2/athletes2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/07/sports/athletes2/athletes2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/07/sports/athletes2/athletes2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Washington Politicians Who Know How to Play Ball', 'kick