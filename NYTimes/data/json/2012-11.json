/Gaza/Gaza-jumbo.jpg', 'height': 636, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/world/Gaza/Gaza-superJumbo.jpg', 'height': 1271, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/world/Gaza/Gaza-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/11/22/world/Gaza/Gaza-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/22/world/Gaza/Gaza-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'IHT Quick Read: Nov. 22', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-11-22T06:46:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3e8f369-b3d1-5636-8e62-cdbb8b5a67c8', 'word_count': 313, 'uri': 'nyt://article/c3e8f369-b3d1-5636-8e62-cdbb8b5a67c8'}, {'abstract': 'Palestinians erupted in  celebrations, vowing unity among rival factions and a  commitment to resistance, while Israel sought to soberly sell its military operation to a domestic audience.', 'web_url': 'https://www.nytimes.com/2012/11/23/world/middleeast/israel-gaza-conflict.html', 'snippet': 'Palestinians erupted in  celebrations, vowing unity among rival factions and a  commitment to resistance, while Israel sought to soberly sell its military operation to a domestic audience.', 'lead_paragraph': 'GAZA — Palestinians erupted in triumphant celebrations here on Thursday, vowing new unity among rival factions and a renewed commitment to the tactic of resistance, while Israel’s leaders sought to soberly sell the achievements of their latest military operation to a domestic audience long skeptical of cease-fire deals like the one announced the night before.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Factions in Gaza Make Unity Vow After Cease-Fire', 'kicker': None, 'content_kicker': None, 'print_headline': 'Factions in Gaza Make Unity Vow After Cease-Fire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Palestinians', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Gaza Strip', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Hamas', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-11-22T08:17:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Jodi Rudoren and Isabel Kershner', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Rudoren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Isabel', 'middlename': None, 'lastname': 'Kershner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/435d3ca4-f904-5117-973c-65d029281203', 'word_count': 1556, 'uri': 'nyt://article/435d3ca4-f904-5117-973c-65d029281203'}, {'abstract': 'An adoring biopic of Néstor Kirchner unwittingly augurs the end for Argentina’s ruling family.', 'web_url': 'https://latitude.blogs.nytimes.com/2012/11/22/the-continuing-cult-of-nestor-kirchner-may-augur-the-end-of-argentinas-ruling-family/', 'snippet': 'An adoring biopic of Néstor Kirchner unwittingly augurs the end for Argentina’s ruling family.', 'lead_paragraph': 'BUENOS AIRES — The public speeches of President Cristina Fernández de Kirchner often have the feel of therapy sessions. Since her husband and predecessor died suddenly of a heart attack on Oct. 27, 2010, rare is the appearance in which she doesn’t fight back tears while remembering “him.” She almost never utters Néstor’s name.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Néstor Forever', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kirchner, Cristina Fernandez de', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kirchner, Nestor', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'ARGENTINA', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-11-22T08:25:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Daniel Politi', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'Politi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21600507-f273-587f-89fc-33bfcbb3e81e', 'word_count': 642, 'uri': 'nyt://article/21600507-f273-587f-89fc-33bfcbb3e81e'}, {'abstract': 'Concerns about soundproofing; seller seeks financial statements; dealing with a tardy lawyer.', 'web_ur