 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-11-27T08:27:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By John F. Burns and Alan Cowell', 'person': [{'firstname': 'John', 'middlename': 'F.', 'lastname': 'Burns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Alan', 'middlename': None, 'lastname': 'Cowell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9bb20e6c-2a41-56c0-8dff-bd95ed941cb9', 'word_count': 773, 'uri': 'nyt://article/9bb20e6c-2a41-56c0-8dff-bd95ed941cb9'}, {'abstract': 'The remains of Yasir Arafat were exhumed on Tuesday as part of an investigation into whether the Palestinian leader was poisoned eight years ago.', 'web_url': 'https://www.nytimes.com/2012/11/28/world/middleeast/yasir-arafats-body-is-exhumed-for-poison-tests.html', 'snippet': 'The remains of Yasir Arafat were exhumed on Tuesday as part of an investigation into whether the Palestinian leader was poisoned eight years ago.', 'lead_paragraph': 'RAMALLAH, West Bank — When Yasir Arafat, the longtime Palestinian leader, was buried eight years ago, people crowded the streets and the rooftops in a tumultuous outpouring of passion; the air here was thick and acrid as militiamen fired off their weapons for hours. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/11/27/world/middleeast/ARAFAT/ARAFAT-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/11/27/world/middleeast/ARAFAT/ARAFAT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'capti