il', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/09/01/nyregion/01jpGEMSPA1/merlin_53215914_f471a875-37a4-4164-b41a-996da5b04fe3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/09/01/nyregion/01jpGEMSPA1/merlin_53215914_f471a875-37a4-4164-b41a-996da5b04fe3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/09/01/nyregion/01jpGEMSPA1/merlin_53215914_f471a875-37a4-4164-b41a-996da5b04fe3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can Instagram and Egg Creams Save the Last Punk Rock Bodega?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Can Instagram Save Gem Spa?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Convenience Stores', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Gem Spa (Manhattan, NY, Retailer)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Gentrification', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Instagram Inc', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'East Village (Manhattan, NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-08-29T09:00:13+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Allie Conti', 'person': [{'firstname': 'Allie', 'middlename': None, 'lastname': 'Conti', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/17219b5a-7bce-5a76-8ab1-62840ce503df', 'word_count': 1261, 'uri': 'nyt://article/17219b5a-7bce-5a76-8ab1-62840ce503df'}, {'abstract': 'The weka, a flightless bird in New Zealand, brings plants to new areas by eating their fruit and excreting the seeds. But some choose to stick close to humans and their food, limiting their range.', 'web_url': 'https://www.nytimes.com/2019/08/29/science/weka-birds-seeds-new-zealand.html', 'snippet': 'The weka, a flightless bird in New Zealand, brings plants to new areas by eating their fruit and excreting the seeds. But some choose to stick close to humans and their food, limiting their range.', 'lead_paragraph': 'Humans can be a terrible influence on birds. Crows that live near us end up with high cholesterol, sparrows screech to be heard over oil pumps, and instead of migrating, some storks now just eat trash.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/09/03/science/28TB-WEKA1/28TB-WEKA1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/09/03/science/28TB-WEKA1/28TB-WEKA1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/09/03/science/28TB-WEKA1/28TB-WEKA1-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/09/03/science/28TB-WEKA1/28TB-WEKA1-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/09/03/science/28TB-WEKA1/28TB-WEKA1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/09/03/science/28TB-WEKA1/28TB-WEKA1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {