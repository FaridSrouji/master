: 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/02530586-b989-5425-9fb6-6de268c8f88b', 'word_count': 1155, 'uri': 'nyt://article/02530586-b989-5425-9fb6-6de268c8f88b'}, {'abstract': '“History will absolve me,” the Cuban leader declared. It may not.', 'web_url': 'https://www.nytimes.com/2019/08/21/opinion/castro-cuba-revolution.html', 'snippet': '“History will absolve me,” the Cuban leader declared. It may not.', 'lead_paragraph': 'MEXICO CITY — I was 11 years old when I found out about the triumph of the Cuban Revolution from a friend’s Marxist-leaning mother. “Finally, justice will be served: Everyone may be poor, but equal,” she said. At that time, it was difficult to predict that Fidel Castro would become one of the most influential men of the twentieth century.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21krauze/21krauze-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/21/opinion/21krauze/21krauze-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21krauze/21krauze-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21krauze/21krauze-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21krauze/21krauze-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/21/opinion/21krauze/21krauze-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21krauze/21krauze-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My 60 Years of Disappointment With Fidel Castro', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Communism (Theory and Philosophy)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Institutional Revolutionary Party (Mexico)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Castro, Fidel', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Redeemers: Ideas and Power in Latin America (Book)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-08-21T10:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Enrique Krauze', 'person': [{'firstname': 'Enrique', 'middlename': None, 'lastname': 'Krauze', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/33fdac1d-bc52-5b2b-bb6c-aa58ba23d63a', 'word_count': 1379, 'uri': 'nyt://article/33fdac1d-bc52-5b2b-bb6c-aa58ba23d63a'}, {'abstract': 'Can an alliance of Germany’s political parties save them?', 'web_url': 'https://www.nytimes.com/2019/08/21/opinion/bees-germany.html', 'snippet': 'Can an alliance of Germany’s political parties save them?', 'lead_paragraph': 'ROTTACH-EGERN, Germany — I stand 4,000 feet above sea level, looking at a mountain meadow filled with late summer wildflowers, bees, wet grass. Clouds hang low over the surrounding mountain peaks. I breathe in the cool wind that signals fall is coming. In more than three decades of hiking in the European Alps, such moments have become familiar sources of joy.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21lazerson/21lazerson-articleLarge.jpg', 'height': 550, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/21/opinion/21lazerson/21lazerson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 550}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21lazerson/21lazerson-jumbo.jpg', 'height': 939, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21lazerson/21lazerson-superJumbo.jpg', 'height': 1877, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21lazerson/21lazerson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/21/opinion/21lazerson/21lazerson-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21lazerson/21lazerson-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Without Bees, We Are in Trouble', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bees', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Environment', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Flowers and Plants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Bavaria (Germany)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-08-21T10:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Marvin Lazerson', 'person': [{'firstname': 'Marvin', 'middlename': None, 'lastname': 'Lazerson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/f0aca4a3-c6b5-5c21-8ea3-90efca2183a4', 'word_count': 828, 'uri': 'nyt://article/f0aca4a3-c6b5-5c21-8ea3-90efca2183a4'}, {'abstract': 'Citizens must have things in common and must also agree to forget many other things.', 'web_url': 'https://www.nytimes.com/2019/08/21/opinion/nationalism-yarom-hazony.html', 'snippet': 'Citizens must have things in common and must also agree to forget many other things.', 'lead_paragraph': 'Nationalism comes in many flavors — the ethnic and the civic, the religious and the secular, the right and the left. A century ago, Theodore Roosevelt’s New Nationalism called for inheritance taxes, a ban on corporate money in politics, workers’ compensation and a living wage. By contrast, the recent National Conservative Conference outlined a “new American and British nationalism” that featured balanced budgets, strong national borders and a return to Anglo-American national traditions: “constitutionalism, the common law, the English language, and Christian scripture.”', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21Hyde1/merlin_142345458_12a8191a-a3b6-4a99-8243-7b59015456e2-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/21/opinion/21Hyde1/merlin_142345458_12a8191a-a3b6-4a99-8243-7b59015456e2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21Hyde1/merlin_142345458_12a8191a-a3b6-4a99-8243-7b59015456e2-jumbo.jpg', 'height': 694, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21Hyde1/merlin_142345458_12a8191a-a3b6-4a99-8243-7b59015456e2-superJumbo.jpg', 'height': 1389, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21Hyde1/21Hyde1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/21/opinion/21Hyde1/21Hyde1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/opinion/21Hyde1/21Hyde1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Nationalism Can Destroy a Nation', 'kicker': None, 'content_kicker': None, 'print_headline': 'How Nationalism Can Destroy a Nation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Federal-State Relations (US)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Reagan, Ronald Wilson', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ro