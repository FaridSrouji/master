': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/23/world/23profile-lai-1/merlin_159551868_2b2c946c-1ed7-4e4b-b865-7f4e4d828ca1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/23/world/23profile-lai-1/merlin_159551868_2b2c946c-1ed7-4e4b-b865-7f4e4d828ca1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/23/world/23profile-lai-1/merlin_159551868_2b2c946c-1ed7-4e4b-b865-7f4e4d828ca1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/23/world/23profile-lai-1/merlin_159551868_2b2c946c-1ed7-4e4b-b865-7f4e4d828ca1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Hong Kong ‘Troublemaker’ With a Clean Conscience', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tycoon’s Support for Protests Brings Unenviable Promotion in the ‘Gang of 4’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lai, Jimmy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hong Kong Protests (2019)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'APPLE DAILY', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Next Media Ltd', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Xi Jinping', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-08-23T04:05:03+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Andrew Higgins', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Higgins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Biography', '_id': 'nyt://article/711fb351-4157-59e9-9f46-9c80d6f34dfe', 'word_count': 1418, 'uri': 'nyt://article/711fb351-4157-59e9-9f46-9c80d6f34dfe'}, {'abstract': 'Quotation of the Day for Friday, August 23, 2019.', 'web_url': 'https://www.nytimes.com/2019/08/23/todayspaper/quotation-of-the-day-country-is-full-its-news-to-us-employers-say.html', 'snippet': 'Quotation of the Day for Friday, August 23, 2019.', 'lead_paragraph': '“They want to send all these people back. Who the hell is going to do all this work?”', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day: Country Is Full? It’s News to Us, Employers Say', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quote of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-08-23T04:07:04+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/6b84b71a-9192-5a23-8b0a-445f440ba897', 'word_count': 54, 'uri': 'nyt://article/6b84b71a-9192-5a23-8b0a-445f440ba897'}, {'abstract': 'There are signs of a disconnect between support for Joe Biden in polls and excitement for his campaign on the ground in Iowa.', 'web_url': 'https://www.nytimes.com/2019/08/23/us/politics/joe-biden-candidate.html', 'snippet': 'There are signs of a disconnect between support for Joe Biden in polls and excitement for his campaign on the ground in Iowa.', 'lead_paragraph': 'Good Friday morning. Here are some of the stories making news in Washington and politics today.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Politics: Biden’s Enthusiasm Challenge', 'kicker': None, 'content_kicker': None, 'print_headline': 'Morning Edition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}], 'pub_date': '2019-08-23T04:12:42+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/91e1349a-d3d8-5d6a-a656-139ad7e6a2ae', 'word_count': 465, 'uri': 'nyt://article/91e1349a-d3d8-5d6a-a656-139ad7e6a2ae'}, {'abstract': 'Stream the latest “Mission: Impossible.” Or, for something completely different, watch a well-received take on Chekhov.', 'web_url': 'https://www.nytimes.com/2019/08/23/arts/television/whats-on-tv-friday-mission-impossible-fallout-and-uncle-vanya.html', 'snippet': 'Stream the latest “Mission: Impossible.” Or, for something completely different, watch a well-received take on Chekhov.', 'lead_paragraph': 'MISSION: IMPOSSIBLE — FALLOUT (2018) Stream on Amazon and Hulu. The mission, should you choose to pay attention to it, has something to do with missing plutonium. For most, though, the plot of this most recent “Mission: Impossible” movie will be a secondary matter, a framework to justify another opportunity to watch Tom Cruise. And if it’s big-budget summer entertainment you’re after, “Fallout” is a great choice. In her review for The New York Times, Manohla Dargis called the movie “an entertainment machine par excellence.” It “has plenty of serious interludes, but its overall tone is borderline breezy, with bullets,” she wrote. “The movie is propelled by action scenes that transmit a little something about the characters while nudging the story forward, much like the song-and-dance numbers in a musical.”', 'print_section': 'C', 'print_page': '20', 'source': 'The New York Ti