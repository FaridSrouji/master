ges/2019/08/07/opinion/07parker/merlin_158991081_baafc26f-81a5-4879-ade7-a46ece4eaa1e-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/07/opinion/07parker/merlin_158991081_baafc26f-81a5-4879-ade7-a46ece4eaa1e-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/07/opinion/07parker/merlin_158991081_baafc26f-81a5-4879-ade7-a46ece4eaa1e-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Was Trump’s El Paso Visit a Turning Point?', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Trump, Donald J', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hispanic-Americans', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'El Paso, Tex, Shooting (2019)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'El Paso (Tex)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-08-08T10:00:11+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Richard Parker', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/fd57b961-45c8-57ed-9bb4-541241ea590e', 'word_count': 1312, 'uri': 'nyt://article/fd57b961-45c8-57ed-9bb4-541241ea590e'}, {'abstract': 'The president cannot be absolved of responsibility for inciting the hatreds that led to El Paso.', 'web_url': 'https://www.nytimes.com/2019/08/08/opinion/trump-el-paso-shooting-nationalism.html', 'snippet': 'The president cannot be absolved of responsibility for inciting the hatreds that led to El Paso.', 'lead_paragraph': 'Connor Betts, the alleged Dayton shooter, had left-wing political views, believed in socialism, supported Elizabeth Warren’s candidacy, and regularly inveighed on Twitter against various personages on the right (including, it turns out, me).  This has some conservatives fuming that liberal media is conveniently ignoring the progressive ideology of one shooter while obsessing over the far-right ideology of another — Patrick Crusius, who posted an anti-immigrant manifesto shortly before police say he murdered 22 people at a Walmart in El Paso. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/opinion/08stephens-web/merlin_158970147_ed0ff11c-0c6c-4a66-9001-481642c302ae-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/08/opinion/08stephens-web/merlin_158970147_ed0ff11c-0c6c-4a66-9001-481642c302ae-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/opinion/08stephens-web/merlin_158970147_ed0ff11c-0c6c-4a66-9001-481642c302ae-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/opinion/08stephens-web/merlin_158970147_ed0ff11c-0c6c-4a66-9001-481642c302ae-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/opinion/08stephens-web/08stephens-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/08/opinion/08stephens-web/08stephens-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/opinion/08stephens-web/08stephens-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trump’s Rhetoric and Conservative Denial', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dayton, Ohio, Shooting (2019)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'El Paso, Tex, Shooting (2019)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mass Shootings', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-08-08T10:01:08+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Bret Stephens', 'person': [{'firstname': 'Bret', 'middlename': None, 'lastname': 'Stephens', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c9d7c3ac-de25-580e-aaf4-c68b462a23bc', 'word_count': 839, 'uri': 'nyt://article/c9d7c3ac-de25-580e-aaf4-c68b462a23bc'}, {'abstract': 'A dog that thinks like a person. Where’s the fun in that?', 'web_url': 'https://www.nytimes.com/2019/08/08/movies/the-art-of-racing-in-the-rain-review.html', 'snippet': 'A dog that thinks like a person. Where’s the fun in that?', 'lead_paragraph': 'At first glance, the feeble tear-jerker “The Art of Racing in the Rain” seems to be a movie made for dog lovers. It is told from the perspective of a dog, a beautiful if inexpressive golden retriever named Enzo. But in a twist that undermines the simple-minded sweetness that makes dogs (and dog movies) so appealing, Enzo is not like other pups. He thinks like a person — pondering subjects like death and reincarnation — and he also dreams of being human.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/arts/08artofracing/merlin_158821791_607f3cff-b392-45e9-be5a-23628b19a79c-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/08/arts/08artofracing/merlin_158821791_607f3cff-b392-45e9-be5a-23628b19a79c-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/arts/08artofracing/merlin_158821791_607f3cff-b392-45e9-be5a-23628b19a79c-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/arts/08artofracing/merlin_158821791_607f3cff-b392-45e9-be5a-23628b19a79c-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/arts/08artofracing/08artofracing-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/08/arts/08artofracing/08artofracing-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/08/arts/08artofracing/08artofracing-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘The Art of Racing in the Rain’ Review: Smart Dog, Dumb Movie', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Art of Racing in the Rain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Art of Racing in the Rain (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Curtis, Simon', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ventimiglia, Milo (1977- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Seyfried, Amanda', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Costner, Kevin', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-08-08T11:00:05+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Teo Bugbee', 'person': [{'firstname': 'Teo', 'middlename': None, 'lastname': 'Bugbee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/114f09a9-103c-50d0-ac25-a6e5948bcaaf', 'word_count': 314, 'uri': 'nyt://article/114f09a9-103c-50d0-ac25-a6e5948bcaaf'}, {'abstract': 'A potent performance from Aldis Hodge elevates this formulaic film about a football player seeking redemption.', 'web_url': 'https://www.nytimes.com/2019/08/08/movies/brian-banks-review.html', 'snippet': 'A potent performance from Aldis Hodge elevates this formulaic film about a football player seeking redemption.', 'lead_paragraph': 'With its heart in the right place and its style stuck unabashedly in the familiar grooves of the TV movie, “Brian Banks” tackles a subject — a sexual assault allegation and its aftermath — that would be challenging even without the scrutiny of #MeToo. That its director is Tom Shadyac — best known for a string of cru