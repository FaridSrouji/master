c9-9e0c-bcca84dbc16f', 'word_count': 4297, 'uri': 'nyt://article/693c6a7f-a99c-54c9-9e0c-bcca84dbc16f'}, {'abstract': 'Gillian Wong, who manages much of The Times’s coverage of the protest movement, on the tools and practices behind the operation.', 'web_url': 'https://www.nytimes.com/2019/08/21/reader-center/hong-kong-protests-gillian-wong-insider.html', 'snippet': 'Gillian Wong, who manages much of The Times’s coverage of the protest movement, on the tools and practices behind the operation.', 'lead_paragraph': 'Times Insider explains who we are and what we do, and delivers behind-the-scenes insights into how our journalism comes together.', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/pageoneplus/21insider-hongkong-print/merlin_159101550_b7cef414-0620-45f8-a2e2-a402ee05c030-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/21/pageoneplus/21insider-hongkong-print/merlin_159101550_b7cef414-0620-45f8-a2e2-a402ee05c030-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/pageoneplus/21insider-hongkong-print/merlin_159101550_b7cef414-0620-45f8-a2e2-a402ee05c030-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/pageoneplus/21insider-hongkong-print/merlin_159101550_b7cef414-0620-45f8-a2e2-a402ee05c030-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/pageoneplus/21insider-hongkong-print/21insider-hongkong-print-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/21/pageoneplus/21insider-hongkong-print/21insider-hongkong-print-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/pageoneplus/21insider-hongkong-print/21insider-hongkong-print-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Breathing Masks, Goggles and WhatsApp: How The Times Covers Hong Kong’s Protests', 'kicker': 'Times Insider', 'content_kicker': None, 'print_headline': 'Breathing Masks and WhatsApp: How We Cover Hong Kong’s Protests', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hong Kong Protests (2019)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-08-21T09:00:03+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Reader Center', 'byline': {'original': 'By Jake Lucas', 'person': [{'firstname': 'Jake', 'middlename': None, 'lastname': 'Lucas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3b05379-9b18-5cb1-a38c-fbdb174c4288', 'word_count': 743, 'uri': 'nyt://article/e3b05379-9b18-5cb1-a38c-fbdb174c4288'}, {'abstract': 'Fitness trackers have bolstered the case for even light exercise. The persistent mystery, though, is which movements matter most.', 'web_url': 'https://www.nytimes.com/2019/08/21/magazine/how-many-steps-should-you-take-a-day.html', 'snippet': 'Fitness trackers have bolstered the case for even light exercise. The persistent mystery, though, is which movements matter most.', 'lead_paragraph': 'Humans, once in constant motion as hunters and gatherers, are moving less than ever. At first, this trend seemed like progress: Transferring our heavy and dangerous work to animals, then machines, enabled more people to live longer. As recently as the 1950s, doctors considered exercise dangerous for people over age 40; for heart disease, which was then killing a record number of Americans, they prescribed bed rest. This was partly based on their concept of what “exercise” was: Early physiologists conducted studies on their (typically young, male) graduate students or on military servicemen — and in order to become more fit than they already were, these subjects needed to work out hard. “The mantra was, You have to go to a gym, you have to do high-intensity physical activity,” says Abby C. King, a professor of health research and policy and medicine at Stanford University: “this sort of ‘no pain, no gain’ phenomenon.”', 'print_section': 'MM', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25Studies_01/25Studies_01-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/25/magazine/25Studies_01/25Studies_01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25Studies_01/25Studies_01-jumbo.jpg', 'height': 717, 'width': 717, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25Studies_01/25Studies_01-superJumbo.jpg', 'height': 717, 'width': 717, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25Studies_01/25Studies_01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/25/magazine/25Studies_01/25Studies_01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25Studies_01/25Studies_01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Many Steps Should You Take a Day?', 'kicker': 'Studies Show', 'content_kicker': None, 'print_headline': 'How Many Steps Should You Take a Day?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Exercise', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ANATOMY AND PHYSIOLOGY', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-08-21T09:00:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Kim Tingley', 'person': [{'firstname': 'Kim', 'middlename': None, 'lastname': 'Tingley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5b34f46-697e-5d4f-aaaa-2d8f0f0e4b02', 'word_count': 1417, 'uri': 'nyt://article/e5b34f46-697e-5d4f-aaaa-2d8f0f0e4b02'}, {'abstract': 'How the “runner’s high” might be used as a tool to treat depression.', 'web_url': 'https://www.nytimes.com/2019/08/21/well/move/exercise-may-boost-mood-for-women-with-depression-having-a-coach-may-help.html', 'snippet': 'How the “runner’s high” might be used as a tool to treat depression.', 'lead_paragraph': 'For women with serious depression, a single session of exercise can change the body and mind in ways that might help to combat depression over time, according to a new study of workouts and moods. Interestingly, though, the beneficial effects of exercise may depend to a surprising extent on whether someone exercises at her own pace or gets coaching from someone else. ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/well/physed-cycling/merlin_152027094_e835080e-698a-4ada-9dbb-1e13dc73bba8-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/27/well/physed-cycling/merlin_152027094_e835080e-698a-4ada-9dbb-1e13dc73bba8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/well/physed-cycling/merlin_152027094_e835080e-698a-4ada-9dbb-1e13dc73bba8-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/well/physed-cycling/merlin_152027094_e835080e-698a-4ada-9dbb-1e13dc73bba8-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/well/physed-cycling/physed-cycling-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/27/well/physed-cycling/physed-cycling-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/well/physed-cycling/physed-cycling-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Exercise May Boost Mood for Women With Depression. Having a Coach May Help.', 'kicker': 'Phys Ed', 'content_kicker': None, 'print_headline': 'Exercise May Lift Women’s Mood', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Exercise', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Depression (Mental)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Marijuana', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-08-21T09:00:03+0000', 'document_type': 'article', 'news_desk': 'Well', 'section_name': 'Well', 'subsection_name': 'Move', 'byline': {'original': 'By Gretchen Reynolds', 'person': [{'firstname': 'Gretchen', 'middlename': None, 'lastname': 'Reynolds', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6c4d689-da20-592f-a8a3-f08323f422dc', 'word_count': 912, 'uri': 'nyt://article/e6c4d689-da20-592f-a8a3-f08323f422dc'}, {'abstract': 'Crisp to the bite, tender to the chew, corn sablés are shortbread at its finest.', 'web_url': 'https://www.nytimes.com/2019/08/21/magazine/cookie-corn-sable-recipe.html', 'snippet': 'Crisp to the bite, tender to the chew, corn sablés are shortbread at its finest.', 'lead_paragraph': 'For one brief and mostly glorious moment in 2013, my son, Joshua, and I had a cookie business. We had a kitchen that was as compact as a toy boat’s galley and a shop the size of a capsule hotel room. But the store’s design was beautiful — thank you, Joshua Greenspan — and just seeing the stacks of cookies made me smile. And the cookies were good! At least we thought so. Early on, we decided that we had to be the judges of what was good and what matched our style. If that sounds liberating, it wasn’t. It made us crazy and not much fun to be around either. We became just the kind of food snobs neither of us can stand.', 'print_section': 'MM', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25mag-eat/25mag-eat-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/25/magazine/25mag-eat/25mag-eat-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25mag-eat/25mag-eat-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25mag-eat/25mag-eat-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25mag-eat/25mag-eat-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/25/magazine/25mag-eat/25mag-eat-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/25/magazine/25mag-eat/25mag-eat-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Cookie Inspired by American Cornbread, Perfected in a French Bakery', 'kicker': 'Eat ', 'content_kicker': None, 'print_headline': 'Your New Favorite Cookie', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cookies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Corn', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Poilane Bakery', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-08-21T09:00:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Dorie Greenspan', 'person': [{'firstname': 'Dorie', 'middlename': None, 'lastname': 'Greenspan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9b0c378-6e0f-5b69-9c19-8c7f13a2ed82', 'word_count': 908, 'uri': 'nyt://article/f9b0c378-6e0f-5b69-9c19-8c7f13a2ed82'}, {'abstract': 'A tension between preparing for bad outcomes and scaring the public.', 'web_url': 'https://www.nytimes.com/2019/08/21/upshot/trumps-economic-message-conflicted.html', 'snippet': 'A tension between preparing for bad outcomes and scaring the public.', 'lead_paragraph': 'Every time the economy trembles, the president and White House staff face a quandary.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/20/upshot/up-trump/merlin_159492522_d4e03ec6-0791-45c4-a77c-fa490a3b4f4a-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/20/upshot/up-trump/merlin_159492522_d4e03ec6-0791-45c4-a77c-fa490a3b4f4a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/20/upshot/up-trump/merlin_159492522_d4e03ec6-0791-45c