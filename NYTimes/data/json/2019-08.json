ill/merlin_159789816_14ff723d-7085-40fd-b91e-c904b9f5a8c9-superJumbo.jpg', 'height': 1297, 'width': 1946, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/28/arts/27meekmill/27meekmill-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/28/arts/27meekmill/27meekmill-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/28/arts/27meekmill/27meekmill-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Meek Mill’s Criminal Case Ends With a Misdemeanor Guilty Plea', 'kicker': None, 'content_kicker': None, 'print_headline': 'Minor Guilty Plea Ends Rapper’s Case', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Meek Mill (Rapper)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Criminal Justice', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Philadelphia (Pa)', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-08-27T15:29:31+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Joe Coscarelli', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Coscarelli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://articl