me': 'subject', 'value': 'Olympic Games (2016)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Milak, Kristof (2000- )', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'FINA', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-08-19T22:54:12+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c51bb8d-09e8-5c7f-912a-6a3303496ce3', 'word_count': 1568, 'uri': 'nyt://article/6c51bb8d-09e8-5c7f-912a-6a3303496ce3'}, {'abstract': 'It was troubling to learn that my voice was being recorded, day and night, without my knowledge or permission.', 'web_url': 'https://www.nytimes.com/2019/08/19/opinion/nanny-cams-privacy.html', 'snippet': 'It was troubling to learn that my voice was being recorded, day and night, without my knowledge or permission.', 'lead_paragraph': 'I remember the deep betrayal I felt several years ago when I realized the family I had been working for as a nanny had been recording my voice without my consent. My employer wanted to tell me something about her spouse. “Let’s go into another room,” she said to me in a whisper. “The camera is on.” ', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/19/opinion/sunday/19Poo/19Poo-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/19/opinion/sunday/19Poo/19Poo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/19/opinion/sunday/19Poo/19Poo-jumbo.jpg', 'he