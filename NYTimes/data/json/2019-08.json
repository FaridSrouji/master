mbo-v2.jpg', 'height': 1024, 'width': 854, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/opinion/27hanna-attisha/27hanna-attisha-superJumbo-v2.jpg', 'height': 2048, 'width': 1707, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/opinion/27hanna-attisha/27hanna-attisha-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/27/opinion/27hanna-attisha/27hanna-attisha-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/opinion/27hanna-attisha/27hanna-attisha-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Helped Expose the Lead Crisis in Flint. Here’s What Other Cities Should Do.', 'kicker': None, 'content_kicker': None, 'print_headline': 'What D.C.’s Lead Crisis Can Teach Other Cities', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Water Pollution', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Lead', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Water', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hazardous and Toxic Substances', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Flint (Mich)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Newark (NJ)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-08-27T23:04:21+0000', 'document_type': 'article', 'news_desk': 'OpEd', '