', 'url': 'images/2019/08/09/obituaries/08Ruiz1/08Ruiz1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/09/obituaries/08Ruiz1/08Ruiz1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/09/obituaries/08Ruiz1/08Ruiz1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rosie Ruiz, Who Faked Victory in Boston Marathon, Dies at 66', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rosie Ruiz, 66, Is Dead; Faked Marathon Victory', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'RUIZ, ROSIE', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Boston Marathon', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cheating', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Marathon Running', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-08-08T20:28:03+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Sports', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/dc68d884-b3ee-5f2e-9e43-aae24d079450', 'word_count': 765, 'uri': 'nyt://article/dc68d884-b3ee-5f2e-9e43-aae24d079450'}, {'abstract': 'Suggested reading from critics and editors at The New York Times.', 'web_url': 'https://www.nytimes.com/2019/08/08/books/review/12-new-books-we-recommend-this-week.html', 'snippet': 'Suggested reading from critics and editors at The New York Times.', 'lead_paragraph': 'The anthropologist Franz Boas — he’s the central figure in Charles King’s new book, “Gods of the Upper Air,” below — was more interested in similarities than in differences, ever alert to the things that united human cultures. So maybe he would find a common theme among the 12 titles we recommend this week. Me, I’ll just note how wildly varied they are (an anthology of reporting by Arab women, a study of Supreme Court politics, a gay coming-of-age memoir, a punctuation history and a biography of Confederate sisters, along with King’s book and half a dozen disparate novels), and happily remember the slogan I first saw on a banner at a church carnival years ago: Strength through diversity.', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/11/books/11edchoice1/11edchoice1-articleLarge.jpg', 'height': 289, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/11/books/11edchoice1/11edchoice1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 289}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/11/books/11edchoice1/11edchoice1-jumbo.jpg', 'height': 493, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/11/books/11edchoice1/11edchoice1-superJumbo.jpg', 'height': 632, 'width': 1314, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/11/books/11edchoice1/11edchoice1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/11/books/11edchoice1/11edchoice1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailhe