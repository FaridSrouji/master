jor': 'N'}], 'pub_date': '2019-08-09T09:00:15+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Timothy Williams and John Eligon', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'John', 'middlename': None, 'lastname': 'Eligon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9daabf74-d284-5b47-b784-22a70b6a55fc', 'word_count': 2186, 'uri': 'nyt://article/9daabf74-d284-5b47-b784-22a70b6a55fc'}, {'abstract': 'The Emmy Award-winning journalist spends a lot of time on planes, so on the weekends, it’s all about his boat.', 'web_url': 'https://www.nytimes.com/2019/08/09/nyregion/how-peter-greenberg-travel-expert-spends-his-sundays.html', 'snippet': 'The Emmy Award-winning journalist spends a lot of time on planes, so on the weekends, it’s all about his boat.', 'lead_paragraph': 'As the travel editor for CBS News, Peter Greenberg spends much of the year outside of New York, where he has homes in Manhattan and Fire Island, the latter of which was built by his parents 55 years ago. “I love Fire Island,” he said. “It’s the Hamptons without the attitude.” During the summer, he takes up residence in Ocean Bay Park, on Fire Island, when he can. ', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/09/nyregion/09ROUTINE1/merlin_157867968_e649c66f-e009-4022-a78f-ff721edc07b2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/09/nyregion/09ROUTINE1/merlin_157867968_e649c66f-e009-4022-a78f-ff721edc07b2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 40