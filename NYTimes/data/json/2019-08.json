irth-01/14tmag-neuwirth-01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/27/t-magazine/14tmag-neuwirth-01/14tmag-neuwirth-01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'House Tour | Irene Neuwirth', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jewels and Jewelry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Canals', 'rank': 2, 'major': 'N'}], 'pub_date': '2019-08-21T17:20:00+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': 'By Scott J. Ross', 'person': [{'firstname': 'Scott', 'middlename': 'J.', 'lastname': 'Ross', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/9c81681a-8a70-5261-a118-592cf4e70564', 'word_count': 0, 'uri': 'nyt://video/9c81681a-8a70-5261-a118-592cf4e70564'}, {'abstract': 'The jewelry designer Irene Neuwirth has filled her abode with gemlike colors and pictures of her dog.', 'web_url': 'https://www.nytimes.com/2019/08/21/t-magazine/irene-neuwirth-home-tour.html', 'snippet': 'The jewelry designer Irene Neuwirth has filled her abode with gemlike colors and pictures of her dog.', 'lead_paragraph': 'Irene Neuwirth is known for her playful approach to jewelry. In her namesake line, which she founded in 2003, gold and diamonds intermingle with semiprecious gems in every color of the rainbow, from cherry-red garnets to glossy sky-blue turquoise and milky pink opals. That vibrant eclecticism extends to her airy white, cottage-like home on the Venice Canals in Los Angeles, where fine art (a hot pink watercolor by the California artist Mary Weatherford) and antiques (brass sconces colorfully bejeweled to match Neuwirth’s designs) coexist with an array of contemporary, and occasionally less rarefied, works: a stuffed fabric unicorn head, for example, and a skateboard, painted with her name by her friend the pro skater Natas Kaupas, also adorn the living room walls. The concept, Neuwirth explains, is a balance of high and low. “I decorated my house to look like the inside of my brain,” she says.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/t-magazine/Irenen/Irenen-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/21/t-magazine/Irenen/Irenen-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/t-magazine/Irenen/Irenen-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/t-magazine/Irenen/Irenen-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/t-magazine/Irenen/Irenen-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/21/t-magazine/Irenen/Irenen-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/21/t-magazine/Irenen/Irenen-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'he