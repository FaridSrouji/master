_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7efb382-7bb9-5bc8-8655-254fc64f0c88', 'word_count': 836, 'uri': 'nyt://article/d7efb382-7bb9-5bc8-8655-254fc64f0c88'}, {'abstract': 'Many tourists who come to Poland see a story of Jewish death. In Krakow, not far from Auschwitz, leaders are trying to tell a different story, and spur a resurgence in Jewish life.', 'web_url': 'https://www.nytimes.com/2019/08/11/world/europe/poland-krakow-jewish-culture-festival-holocaust.html', 'snippet': 'Many tourists who come to Poland see a story of Jewish death. In Krakow, not far from Auschwitz, leaders are trying to tell a different story, and spur a resurgence in Jewish life.', 'lead_paragraph': 'KRAKOW, Poland — There were lectures on the journey of Jews from shtetls in Poland to new homes in what would become Israel; workshops on chanting the Torah and cooking for Shabbat; exhibitions documenting the devastation brought by World War II; and debates about Jewish life in Poland today.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/11/world/11Krakow-Dispatch2-promo/11Krakow-Dispatch2-promo-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/11/world/11Krakow-Dispatch2-promo/11Krakow-Dispatch2-promo-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/11/world/11Krakow-Dispatch2-promo/11Krakow-Dispatch2-promo-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/11/world/11Krakow-Dispatch2-prom