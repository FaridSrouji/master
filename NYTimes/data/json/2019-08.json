/01VIEW-01/01VIEW-01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/04/business/01VIEW-01/01VIEW-01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/business/01VIEW-01/01VIEW-01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Rate Cuts Don’t Help Much Anymore', 'kicker': None, 'content_kicker': None, 'print_headline': 'Why Rate Cuts Won’t Help Much', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interest Rates', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Recession and Depression', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Gross Domestic Product', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Inflation (Economics)', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-08-01T09:00:06+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Austan Goolsbee', 'person': [{'firstname': 'Austan', 'middlename': None, 'lastname': 'Goolsbee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4951f794-f75b-56b8-b0f6-ec308e6f7c65', 'word_count': 907, 'uri': 'nyt://article/4951f794-f75b-56b8-b0f6-ec308e6f7c65'}, {'abstract': 'It’s like that saying about how to make God laugh: Just tell him your plans.', 'web_url': 'https://www.nytimes.com/2019/08/01/magazine/gender-reveal-fail-videos.html', 'snippet': 'It’s like that saying about how to make God laugh: Just tell him your plans.', 'lead_paragraph': 'The gender-reveal party has been around for about as long as Instagram has, and the two have gotten out of hand at roughly the same speed. Gender reveals now precede or even replace the traditional baby shower, marking the occasion when the proud parents first learn the sex of their unborn guest of honor. Until recently, expectant parents received this information without much fanfare during a routine ultrasound, or perhaps by phone, when a doctor called to relay amniocentesis results. But around a decade ago, people started passing the results, under seal, to obliging bakers, who would bake pink or blue cakes, conceal them in neutral-colored frosting and then deliver them to be cut open at a party in front of friends and family. The “reveal” allowed the parents to be surprised in public, record the moment for posterity and share it across social platforms, signaling which aggregation of gender norms and limitations friends and family were to immediately begin heaping on the fetus’s soft-skulled head.', 'print_section': 'MM', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-screenland-1/04mag-screenland-1-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/08/04/magazine/04mag-screenland-1/04mag-screenland-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-screenland-1/04mag-screenland-1-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-screenland-1/04mag-screenland-1-superJumbo.jpg', 'height': 590, 'width': 1049, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-screenland-1/04mag-screenland-1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/08/04/magazine/04mag-screenland-1/04mag-screenland-1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-screenland-1/04mag-screenland-1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Gender Reveal Videos Go Spectacularly, Cathartically Wrong', 'kicker': 'Screenland', 'content_kicker': None, 'print_headline': 'Born Identity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gender', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parties (Social)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-08-01T09:00:06+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Carina Chocano', 'person': [{'firstname': 'Carina', 'middlename': None, 'lastname': 'Chocano', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e04d126f-4cb6-5728-b671-07f4c03729ee', 'word_count': 1149, 'uri': 'nyt://article/e04d126f-4cb6-5728-b671-07f4c03729ee'}, {'abstract': 'Details materialize along a space-time continuum that feels intensely familiar yet disquietingly inexplicable. ', 'web_url': 'https://www.nytimes.com/2019/08/01/magazine/poem-before-this-dream.html', 'snippet': 'Details materialize along a space-time continuum that feels intensely familiar yet disquietingly inexplicable. ', 'lead_paragraph': 'In this, my final column after more than a year of weekly choices from current American book publications, I’d like to circle back to a poem that snagged my attention in the early days of my appointment and refuses to let go. It stands as a preface to Duriel E. Harris’s remarkable book “No Dictionary of a Living Tongue,” and as an incantation should not be read as much as entered. Details materialize along a space-time continuum that feels intensely familiar yet disquietingly inexplicable. Despite the opening disclaimer, we find ourselves following the bread-crumb trail of dream logic, each moment folding into the next, as vivid and inscrutable as the nested figurines in a Matryoshka doll. Where does reality end and the dream begin? And if reality is the only perilous constant, have we been dreaming all along? Selected by Rita Dove', 'print_section': 'MM', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-poem-1/04mag-poem-1-jumbo.jpg', 'height': 148, 'width': 266, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-poem-1/04mag-poem-1-superJumbo.jpg', 'height': 148, 'width': 266, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/08/04/magazine/04mag-poem-1/04mag