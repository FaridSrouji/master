The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: January 28, 2015', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-01-28T06:16:52+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac1ae7ee-6b13-570b-93e2-efe0bc4f67c9', 'word_count': 701, 'uri': 'nyt://article/ac1ae7ee-6b13-570b-93e2-efe0bc4f67c9'}, {'abstract': 'Djokovic, the tournament’s top seed, beat the big-serving Milos Raonic and will face Stan Wawrinka of Switzerland, who advanced with a victory over Kei Nishikori.', 'web_url': 'https://www.nytimes.com/2015/01/29/sports/tennis/nishikoris-late-rally-not-enough-to-overcome-wawrinka.html', 'snippet': 'Djokovic, the tournament’s top seed, beat the big-serving Milos Raonic and will face Stan Wawrinka of Switzerland, who advanced with a victory over Kei Nishikori.', 'lead_paragraph': 'MELBOURNE, Australia — Against one of the best servers in the game, top-seeded Novak Djokovic turned in an untouchable performance.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/29/sports/open/open-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/29/sports/open/open-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/29/sports/open/open-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/29/sports/open/open-sup