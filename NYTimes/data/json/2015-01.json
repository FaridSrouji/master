ajor': 'N'}], 'pub_date': '2015-01-03T02:04:06+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/44eba9b7-2279-5c65-92d1-33ff7cc79f5e', 'word_count': 499, 'uri': 'nyt://article/44eba9b7-2279-5c65-92d1-33ff7cc79f5e'}, {'abstract': 'Hong Kong health officials have slaughtered thousands of chickens from mainland China and closed markets, after tests found some birds were infected with a strain of bird flu.', 'web_url': 'https://www.nytimes.com/2015/01/03/world/asia/hong-kong-slaughters-chickens-after-an-outbreak-of-bird-flu.html', 'snippet': 'Hong Kong health officials have slaughtered thousands of chickens from mainland China and closed markets, after tests found some birds were infected with a strain of bird flu.', 'lead_paragraph': 'HONG KONG — Hong Kong health officials have slaughtered thousands of chickens from mainland China, closed one wholesale market and banned imports of live poultry after tests found some birds were infected with a strain of bird flu.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hong Kong Slaughters Chickens After an Outbreak of Bird Flu', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hong Kong Slaughters Chickens After an Outbreak of Bird Flu', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Avian Influenza', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Chickens', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-03T02:08:18+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Michael Forsythe',