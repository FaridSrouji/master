NADAL/NADAL-superJumbo.jpg', 'height': 2048, 'width': 1851, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/sports/NADAL/NADAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/22/sports/NADAL/NADAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/sports/NADAL/NADAL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Another Loss for Nice Guys; This One Wins Praise', 'kicker': None, 'content_kicker': None, 'print_headline': 'Another Loss for Nice Guys; This One Wins Nadal’s Praise', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rothenberg, Ben', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nadal, Rafael', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Smyczek, Tim', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Australian Open (Tennis)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-21T21:28:33+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Ben Rothenberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Rothenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/863f7181-d9fa-5684-875c-42fc88f44c3e', 'word_count': 1018, 'uri': 'nyt://article/863f7181-d9fa-5684-875c-42fc88f44c3e'}, {'abstract': 'Caitlin Mociun, whose custom jewelry is a favorite among the borough’s betrothed, is opening a wedding-oriented boutique that’s anything but traditional.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/01/21/in-williamsburg-a-wedding-salon-for-very-brooklyn-brides/', 'snippet': 'Caitlin Mociun, whose custom jewelry is a favorite among the borough’s betrothed, is opening a wedding-oriented boutique that’s anything but traditional.', 'lead_paragraph': '“I’m hoping to help brides feel more comfortable not wearing white to their weddings,” says Caitlin Mociun, gesturing toward a lemon-yellow gown. That’s not the only tradition the Brooklyn-based designer — noted among the betrothed for her sculptural fine jewelry and eponymous design shop — is looking to upend with today’s opening of Mociun White, her new wedding-oriented boutique. “It’s about a specific experience for a bride,” she says. “I wanted to create a space that redefined what a bridal salon is.” Mociun, who is returning to creating clothing after a three-year hiatus, has set her own not-so-bridal bridal collection — expertly cut Italian lace dresses, shirt-and-skirt combos and plenty of color — against a not-so-bridal interior: railings painted bright hues, intricate tile work, tables made with Archer Modern, a Bec Brittain chandelier and loop lights by Lucas Peet. Embellished pieces by Naeem Khan round out the assortment. The idea for the store came to her after time spent shopping at bridal salons with friends: “There were little vases of white flowers and rococo furniture, and it smelled like potpourri — it felt like a little girl’s dream, not the dream of an adult woman who’s really into design,” she recalls. Instead, she says, “I wanted a beautiful space that was cool architecturally.”', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/21/t-magazine/21mociun-moss/21mociun-moss-articleLarge.jpg', 'height': 500, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/21/t-magazine/21mociun-moss/21mociun-moss-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 500}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/21/t-magazine/21mociun-moss/21mociun-moss-jumbo.jpg', 'height': 853, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/21/t-magazine/21mociun-moss/21mociun-moss-superJumbo.jpg', 'height': 1707, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/21/t-magazine/21mociun-moss/21mociun-moss-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/21/t-magazine/21mociun-moss/21mociun-moss-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/21/t-magazine/21mociun-moss/21mociun-moss-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Williamsburg, a Wedding Salon for Very Brooklyn Brides', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'In Store: Modern Matrimony and More', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Mociun (Brooklyn, NY, Retail Store)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-21T21:30:32+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Hilary Moss', 'person': [{'firstname': 'Hilary', 'middlename': None, 'lastname': 'Moss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eaf65282-b8bd-5ce3-a45b-bca4a0a3f7f9', 'word_count': 314, 'uri': 'nyt://article/eaf65282-b8bd-5ce3-a45b-bca4a0a3f7f9'}, {'abstract': 'Marilyn Horne presided over “The Song Continues,” a celebration of the art of song, at Zankel Hall on Saturday.', 'web_url': 'https://www.nytimes.com/2015/01/22/arts/music/the-song-continues-celebrates-the-art-form-at-zankel-hall.html', 'snippet': 'Marilyn Horne presided over “The Song Continues,” a celebration of the art of song, at Zankel Hall on Saturday.', 'lead_paragraph': 'Since her “retirement,” the mezzo-soprano Marilyn Horne has been a mentor to young singers, offering guidance at festivals and workshops including “The Song Continues” at Carnegie Hall, a series of master classes that culminates in a public performance.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/arts/HORNE1/HORNE1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/22/arts/HORNE1/HORNE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/arts/HORNE1/HORNE1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/arts/HORNE1/HORNE1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 