: 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/25/arts/25SIDEDARGIS_COMBO/25SIDEDARGIS_COMBO-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/arts/25SIDEDARGIS_COMBO/25SIDEDARGIS_COMBO-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Voices From the Front Lines', 'kicker': None, 'content_kicker': None, 'print_headline': 'Voices From the Front Lines', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Streisand, Barbra', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Woolverton, Linda', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-21T16:22:51+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'Interviews by Manohla Dargis', 'person': [{'firstname': 'Interviews', 'middlename': 'Manohla', 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/18901d44-5eb3-5446-a5a1-dd4427d087f4', 'word_count': 749, 'uri': 'nyt://article/18901d44-5eb3-5446-a5a1-dd4427d087f4'}, {'abstract': 'Tara Ison’s essays and Patton Oswalt’s memoir offer personal accounts of intense movie fandom.', 'web_url': 'https://www.nytimes.com/2015/01/25/books/review/reeling-through-life-and-silver-screen-fiend.html', 'snippet': 'Tara Ison’s essays and Patton Oswalt’s memoir offer personal accounts of intense movie fandom.', 'lead_paragraph': 'Are the movies entirely to be trusted as a design for living? “You can’t expect me to keep up that level of charm, I’d have a heart attack,” Woody Allen complains in “Play It Again, Sam,” the 1972 film in which he takes dating tips from Humphrey Bogart. He realizes reality must win in the end, although the fact that the scene that symbolizes this — his ex-wife shooting Bogart in the chest — is itself a re-\xadenactment of a scene from “They Drive by Night” tells you something about the elasticity of the medium, which, like Escher’s eternal stairwell, feeds even our dreams of escape from the movies. We all agree with Allen, on some level. A life lived at a constant pitch of screwball comedy is a recipe for exhaustion. The relationship of most movie couples would not last five minutes beyond the closing credits of the films in which they appear. And yet such is the movies’ unrivaled express train to the limbic brain, where Ingrid Bergman’s face appears projected the size of a mother as seen by an infant, that trying to see what the medium has done to the shape of our desires can be as difficult as trying to see the edges of the sky.', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/10/books/review/SHONE/SHONE-articleLarge.jpg', 'height': 460, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/10/books/review/SHONE/SHONE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 460}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/10/books/review/SHONE/SHONE-jumbo.jpg', 'height': 785, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/10/books/review/SHONE/SHONE-superJumbo.jpg', 'height': 1569, 'width': 2048, 'subType': 'superJumbo', 