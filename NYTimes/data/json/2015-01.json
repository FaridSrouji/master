rd_count': 2140, 'uri': 'nyt://article/78340bb5-fb4e-5b6c-9edc-5a17cb27d0c4'}, {'abstract': 'A selected guide to cultural events for children, teenagers and families in New York City.', 'web_url': 'https://www.nytimes.com/2015/01/23/arts/spare-times-for-children-for-jan-23-29.html', 'snippet': 'A selected guide to cultural events for children, teenagers and families in New York City.', 'lead_paragraph': 'Note: With the snowstorm forcing cancellations across the city on Monday, we advise that you check with venues before setting out to events scheduled for Monday or Tuesday.', 'print_section': 'C', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spare Times for Children for Jan. 23-29', 'kicker': None, 'content_kicker': None, 'print_headline': 'Spare Times: For Children', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-01-23T00:54:16+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Laurel Graeber', 'person': [{'firstname': 'Laurel', 'middlename': None, 'lastname': 'Graeber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/5ca8fe5d-9a88-5b8a-882c-b736bad49952', 'word_count': 3608, 'uri': 'nyt://article/5ca8fe5d-9a88-5b8a-882c-b736bad49952'}, {'abstract': 'The ability to move from the self-centeredness of dating to the self-sacrifice of love requires one to lower the boundaries between self and self.', 'web_url': 'https://www.nytimes.com/2015/01/23/opinion/david-brooks-the-devotion-leap.html', 'snippet': 'The ability to move from the self-centeredness of dating to the self-sacrifice of love requires one to lower the boundaries between self and self.', 'lead_paragraph': 'The on