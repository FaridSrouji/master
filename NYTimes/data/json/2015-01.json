: 'nyt://article/49d88354-1271-5fea-b0a6-f0a7e4a13fe0', 'word_count': 944, 'uri': 'nyt://article/49d88354-1271-5fea-b0a6-f0a7e4a13fe0'}, {'abstract': 'Shinzo Abe, the conservative prime minister of Japan, opened a new front in a battle to sway American views of the country’s wartime history.', 'web_url': 'https://www.nytimes.com/2015/01/30/world/asia/japans-premier-disputes-us-textbooks-portrayal-of-comfort-women.html', 'snippet': 'Shinzo Abe, the conservative prime minister of Japan, opened a new front in a battle to sway American views of the country’s wartime history.', 'lead_paragraph': 'TOKYO — Prime Minister Shinzo Abe of Japan on Thursday criticized an American textbook that he said inaccurately depicted Japan’s actions during World War II, opening a new front in a battle to sway American views of the country’s wartime history.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Textbook Skews History, Prime Minister of Japan Says', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.S. Textbook Skews History, Prime Minister of Japan Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Japan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Textbooks', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ABE, SHINZO', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'McGraw-Hill Education', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 11, 'major': 'N'}], 'pub_date': '2015-01-29T17:10:38+0000', 'document_type': 'article', '