es/2015/01/07/arts/teeth/teeth-articleLarge.jpg', 'height': 384, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/07/arts/teeth/teeth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 384}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/arts/teeth/teeth-jumbo.jpg', 'height': 655, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/arts/teeth/teeth-superJumbo.jpg', 'height': 1311, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/arts/teeth/teeth-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/07/arts/teeth/teeth-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/arts/teeth/teeth-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Symbiotic Evolution of ‘Partita’ and Ensemble', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'The Symbiotic Evolution of ‘Partita’ and Ensemble', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Allen, David', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Choir of Trinity Wall Street', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Trinity Church (Manhattan, NY)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': '