: None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/15/us/VIRGINIA/VIRGINIA-articleLarge.jpg', 'height': 413, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/15/us/VIRGINIA/VIRGINIA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 413}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/15/us/VIRGINIA/VIRGINIA-jumbo.jpg', 'height': 705, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/15/us/VIRGINIA/VIRGINIA-superJumbo.jpg', 'height': 1411, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/15/us/VIRGINIA/VIRGINIA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/15/us/VIRGINIA/VIRGINIA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/15/us/VIRGINIA/VIRGINIA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Virginia Politician Serves 2 Terms: In Jail and in the State Legislature ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Virginia Politician Serves 2 Terms: In Jail and in the State Legislature', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Morrissey, Joseph D (1957- )', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-14T18:57:55+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jennifer Steinhauer', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Steinhauer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e057ff6b-2cd9-5949-9d8e-c13c26d2952b', 'word_count': 714, 'uri': 'nyt://article/e057ff6b-2cd9-5949-9d8e-c13c26d2952b'}, {'abstract': 'A number of runway looks were emblazoned with messages that ranged from the promotional to the polemical.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/01/14/london-mens-collections-trend-words-christopher-shannon-alexander-mcqueen-shaun-samson/', 'snippet': 'A number of runway looks were emblazoned with messages that ranged from the promotional to the polemical.', 'lead_paragraph': 'A handful of designers at the fall/winter 2015 London shows this week had something to say — so much so that their clothes came emblazoned with messages that ranged from the promotional to the polemical. Christopher Shannon, who has made it his signature to deconstruct and dissect active sportswear, used his designs as commentary on commercial industries and the economy. With slogans like “Thanks 4 Nothing,” “Save Me” and “Broke” knitted into brightly colored intarsia jumpers, the ostensibly humorous collection revealed a darker undercurrent. While Sarah Burton’s military-inspired collection for Alexander McQueen displayed a mastery of tailoring, the bold capitalized words “HONOUR,” “VALOUR” and “TRUTH” inscribed across blazers and coats made a bigger statement. And lastly, the American designer Shaun Samson, who returned with a runway show after two seasons away, brought a Southern California flair to the London scene with his collection of bold flannel plaids, Dickies-inspired chinos and aprons adorned with the phrases “DELUSIONAL RADICAL BLISS” and “GNARLY DANK DUDE.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13trend-words/13trend-words-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/13/t-magazine/13trend-words/13trend-words-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13trend-words/13trend-words-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13trend-words/13trend-words-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13trend-words/13trend-words-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/13/t-magazine/13trend-words/13trend-words-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13trend-words/13trend-words-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At the Fall 2015 London Men’s Collections, Designers Had a Few Words to Put on Their Chests', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'London Fashion Week', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McQueen, Alexander', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Shannon, Christopher', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-14T19:00:12+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Alex Tudela', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Tudela', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/757836a3-36d2-510f-9d95-ef0613fde32c', 'word_count': 178, 'uri': 'nyt://article/757836a3-36d2-510f-9d95-ef0613fde32c'}, {'abstract': 'Peter Strickland, the director of “The Duke of Burgundy,” had some fanciful ideas behind the visuals for his film, which explores a couple’s sexual appetites.', 'web_url': 'https://www.nytimes.com/2015/01/18/movies/the-duke-of-burgundy-focuses-on-its-visuals.html', 'snippet': 'Peter Strickland, the director of “The Duke of Burgundy,” had some fanciful ideas behind the visuals for his film, which explores a couple’s sexual appetites.', 'lead_paragraph': 'In “The Duke of Burgundy,” due Jan. 23, a couple (Sidse Babett Knudsen and Chiara D’Anna) blend sadomasochism and role play into their lives. Viewers might think they know what a movie like this looks like. But the film’s director, Peter Strickland, has a more fanciful visual in mind. Rather than just leather and lace, the film is also about butterflies, capes and mansions. It’s often more Hans Christian Andersen than “Fifty Shades of Grey,” creating a melodramatic fantasia that seems to exist both in the real world and outside it.', 'print_section': 'AR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Calculated Look Behind the Lust', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Calculated Look Behind the Lust', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Murphy, Mekado', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Strickland, Peter', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Duke of Burgundy (Movie)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-14T19:05:36+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cad89e89-8ec9-51c8-8247-9fca4ef84105', 'word_count': 820, 'uri': 'nyt://article/cad89e89-8ec9-51c8-8247-9fca4ef84105'}, {'abstract': 'GoBankingRates says nine of the 10 best savings rates are offered on web accounts, with several hitting 1 percent.', 'web_url': 'https://www.nytimes.com/2015/01/15/your-money/look-online-for-best-savings-rates.html', 'snippet': 'GoBankingRates says nine of the 10 best savings rates are offered on web accounts, with several hitting 1 percent.', 'lead_paragraph': 'Americans are not known as great savers, and a tough economy, combined with anemic interest rates on savings, haven’t offered them much opportunity to change.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Savings Rates Are Anemic, but a Survey Shows They Are Less Paltry Online', 'kicker': 'Your Money Adviser', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Savings', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Interest Rates', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Personal Finances', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Bank of America Corporation', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'GE Capital Corp', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-14T19:07:15+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/447458a5-18bc-572e-b397-e99802764f51', 'word_count': 635, 'uri': 'nyt://article/447458a5-18bc-572e-b397-e99802764f51'}, {'abstract': '“Accused,” the Dutch film shortlisted for the foreign-language Oscar, takes on a notorious case in the Netherlands.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2015/01/14/injustice-treated-like-a-thriller/', 'snippet': '“Accused,” the Dutch film shortlisted for the foreign-language Oscar, takes on a notorious case in the Netherlands.', 'lead_paragraph': 'It’s not just the United States that has sensational criminal cases that mesmerize the tabloids. In “Accused,” one of nine films shortlisted for the Oscar for best foreign-language film, a Dutch nurse is falsely accused of murdering patients, demonized in the press as an “angel of death” and sentenced to life in prison, gaining her freedom only when a team of crusading lawyers establishes her innocence.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Injustice Treated Like a Thriller', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Academy Awards (Oscars)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Van der Oest, Paula', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-14T19:07:53+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Larry Rohter', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Rohter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10addaf3-72c8-5162-bc55-c2abc1e6063e', 'word_count': 1092, 'uri': 'nyt://article/10addaf3-72c8-5162-bc55-c2abc1e6063e'}, {'abstract': 'After a divorce, Alexandra Fuller looks to her Zambian past for guidance in leading an independent life.', 'web_url': 'https://www.nytimes.com/2015/01/18/books/review/alexandra-fullers-leaving-before-the-rains-come.html', 'snippet': 'After a divorce, Alexandra Fuller looks to her Zambian past for guidance in leading an independent life.', 'lead_paragraph': 'A memoir often takes one of two basic forms: In the first, the writer has an extraordinary story to tell; in the second, she has the ability to tell the common story in an extraordinary way. Sometimes — Mary McCarthy’s “Memories of a Catholic Girlhood” is an example, Paula Fox’s “Borrowed Finery” another — the two are conflated in events on whose extremity the artistic mind succeeds in imposing literary form. I once heard the writer Aharon Appelfeld, asked why he had underplayed the savagery of his Holocaust childhood in one of his books, give the answer that extremity, whether imaginary or real, is harmful to art. What he perhaps meant was that the artist’s aim is to represent truth, and that certain experiences — those that infringe or violate the common sense of reality — can never be made to seem true. Joan Didion dealt interestingly with this problem in “The Year of Magical Thinking,” making the surreality of her husband’s death at the dinner table a space the reader could philosophically inhabit. And likewise Alexandra Fuller, writing about her often tragically idiosyncratic African childhood in “Don’t Let’s Go to the Dogs Tonight,” brilliantly succeeded in retaining a child’s astonished objectivity at the unfolding of bizarre events.', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/18/books/review/18CUSK/18cusk-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/18/books/review/18CUSK/18cusk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/18/books/review/18CUSK/18cusk-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/18/books/review/18CUSK/18cusk-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/18/books/review/18CUSK/18CUSK-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/18/books/review/18CUSK/18CUSK-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/18/books/review/18CUSK/18CUSK-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Alexandra Fuller’s ‘Leaving Before the Rains Come’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Splitting Up', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {