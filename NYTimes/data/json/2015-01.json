ajor': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rosenthal, Andrew', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Swarns, Rachel', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-10T19:30:09+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Public Editor', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/97082117-6ea9-5045-98d4-d0b7ca28865c', 'word_count': 949, 'uri': 'nyt://article/97082117-6ea9-5045-98d4-d0b7ca28865c'}, {'abstract': 'The newest old art form: Riveting tales, told aloud, as audiobooks.', 'web_url': 'https://www.nytimes.com/2015/01/11/opinion/sunday/hearing-is-believing.html', 'snippet': 'The newest old art form: Riveting tales, told aloud, as audiobooks.', 'lead_paragraph': 'THE thriller writer Jeffery Deaver has released an original work called “The Starling Project” as an audiobook — only it’s not what we think of as an audiobook: a printed book read aloud that you can listen to on your laptop or phone. Featuring 29 actors in more than 80 speaking roles combined with “state-of-the-art sound and music design,” Mr. Deaver’s “book” was conceived as an audio drama for Audible. There are no plans to turn it into a traditional text-based book, either on paper or digitally. ', 'print_section': 'SR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/sunday-review/11AUDIOsub/11AUDIOsub-articleLarge.gif', 'height': 523, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'imag