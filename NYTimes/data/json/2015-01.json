me': 'organizations', 'value': 'AMERICAN FEDERATION OF LABOR-CONGRESS OF INDUSTRIAL ORGANIZATIONS', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-01-08T12:06:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/e0be7027-ae2d-53aa-9d38-86838424d717', 'word_count': 1676, 'uri': 'nyt://article/e0be7027-ae2d-53aa-9d38-86838424d717'}, {'abstract': 'Instead of routing their attacks through decoy servers, the hackers sent them directly from web addresses in North Korea, the F.B.I. said. But some skeptics still wanted to see the agency’s evidence.', 'web_url': 'https://bits.blogs.nytimes.com/2015/01/08/daily-report-f-b-i-offers-more-evidence-linking-north-korea-to-attack-on-sony/', 'snippet': 'Instead of routing their attacks through decoy servers, the hackers sent them directly from web addresses in North Korea, the F.B.I. said. But some skeptics still wanted to see the agency’s evidence.', 'lead_paragraph': 'The F.B.I.’s director, James B. Comey, said on Wednesday that the United States had concluded that North Korea was behind the destructive attacks on Sony Pictures partly because the hackers failed to mask their location when they broke into the company’s servers, Michael S. Schmidt, Nicole Perlroth and Matthew Goldstein report.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/technology/bits-daily-report/bits-daily-report-articleLarge-v4.png', 'hei