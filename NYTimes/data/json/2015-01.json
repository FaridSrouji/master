, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/business/22SIFI/22SIFI-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/22/business/22SIFI/22SIFI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/business/22SIFI/22SIFI-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/business/22SIFI/22SIFI-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/business/22SIFI/22SIFI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/22/business/22SIFI/22SIFI-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/business/22SIFI/22SIFI-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Too Big to Fail’ on Financial Regulators’ Agenda Again', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'u2018Too Big to Failu2019 on the Agenda Again', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Insurance', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Financial Institutions Inc', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-22T01:51:43+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Mary Williams Walsh', 'person': [{'firstname': 'Mary', 'middlename': 'Williams', 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/087f2368-05aa-5501-856b-cacd1425a736', 'word_count': 767, 'uri': 'nyt://article/087f2368-05aa-5501-856b-cacd1425a736'}, {'abstract': 'The book that spans Mrs. Gandhi’s life — from her birth in a small town to her ascent as the Congress Party matriarch — was released without fanfare in India.', 'web_url': 'https://www.nytimes.com/2015/01/22/world/asia/the-red-sari-on-sonia-gandhi-is-released-in-india.html', 'snippet': 'The book that spans Mrs. Gandhi’s life — from her birth in a small town to her ascent as the Congress Party matriarch — was released without fanfare in India.', 'lead_paragraph': 'NEW DELHI — Five years ago, the release in India of “The Red Sari,” about the president of the then-governing Indian National Congress Party, Sonia Gandhi, was unthinkable. Mrs. Gandhi was considered by some the de facto prime minister of the country, and her loyalists were incensed by the book’s contents, which they said was riddled with lies. They burned effigies of its Spanish author, Javier Moro, in Delhi’s streets, and according to the Spanish publisher, lawyers representing the Gandhi family threatened a lawsuit.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/world/GANDHI/GANDHI-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/22/world/GANDHI/GANDHI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', '