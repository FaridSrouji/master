ubtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/31/us/31suge/31suge-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/31/us/31suge/31suge-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/31/us/31suge/31suge-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fallen Hip-Hop Mogul Is Charged With Killing a Man He Struck With His Vehicle', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fallen Hip-Hop Mogul Is Charged With Killing a Man He Struck With His Vehicle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Timothy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Knight, Marion', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Hit-and-Run Drivers', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-30T12:50:32+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Joe Coscarelli and Timothy Williams', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Coscarelli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Timothy', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/927a8d92-dc84-5e51-b2e3-75032dec819f', 'word_count': 741, 'uri': 'nyt://article/927a8d92-dc84-5e51-b2e3-75032dec819f'}, {'abstract': 'Jon Pareles discusses club-hopping with Björk in Iceland and her new album, “Vulnerica,” which explores the singer’s breakup with Matthew Barney.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/01/30/popcast-bjrk-gets-personal/', 'snippet': 'Jon Pareles discusses club-hopping with Björk in Iceland and her new album, “Vulnerica,” which explores the singer’s breakup with Matthew Barney.', 'lead_paragraph': 'Björk’s new album “Vulnicura,” released two months ahead of schedule last week as an emergency response to a leak, is a record about heartbreak and estrangement, and based in real events. But the string arrangements are astringent and intense, the beats spacious or chopped-up, and her lyrics refuse to default in revenge or self-pity. She’s looking for safety, clarity, and the right way to mourn the end of one family construct and to build another. “Don’t remove my pain,” she sings in “Notget.” “It is my chance to heal.” ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/arts/artsbeat-bjork/artsbeat-bjork-articleLarge.jpg', 'height': 386, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/30/arts/artsbeat-bjork/artsbeat-bjork-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 386}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/arts/artsbeat-bjork/artsbeat-bjork-jumbo.jpg', 'height': 658, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/arts/artsbeat-bjork/artsbeat-bjork-superJumbo.jpg', 'height': 1317, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/30/arts/artsbeat-