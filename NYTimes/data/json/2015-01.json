on': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Make Yourself at Home', 'kicker': 'Hungry City', 'content_kicker': None, 'print_headline': 'Comforts of Home, Clutter Included', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gordinier, Jeff', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Lower East Side (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Soy (Manhattan, NY, Restaurant)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-01T13:30:13+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Jeff Gordinier', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Gordinier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/57f75762-44c6-5184-813d-83216115b743', 'word_count': 682, 'uri': 'nyt://article/57f75762-44c6-5184-813d-83216115b743'}, {'abstract': 'The best combination of value and distinctiveness is found in St.-Joseph, a region that follows the sinuous north-south twists of the Rhône River.', 'web_url': 'https://www.nytimes.com/2015/01/07/dining/wine-school-st-joseph.html', 'snippet': 'The best combination of value and distinctiveness is found in St.-Joseph, a region that follows the sinuous north-south twists of the Rhône River.', 'lead_paragraph': 'I tend not to think of wines seasonally. The convention of reds in cold weather, and whites and rosés in warm, doesn’t make much sense to me, as food dictates the choice of a wine more than the temperature. Yet certain exceptions present themselves: namely, the red wines of the northern Rhône Valley of France, which I seem to crave especially in the fall and winter.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/dining/07WINESCHOOL/07WINESCHOOL-articleLarge.jpg', 'height': 690, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/07/dining/07WINESCHOOL/07WINESCHOOL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 690}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/dining/07WINESCHOOL/07WINESCHOOL-jumbo.jpg', 'height': 1024, 'width': 891, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/dining/07WINESCHOOL/07WINESCHOOL-superJumbo.jpg', 'height': 1715, 'width': 1491, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/dining/07WINESCHOOL/07WINESCHOOL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/07/dining/07WINESCHOOL/07WINESCHOOL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/07/dining/07WINESCHOOL/07WINESCHOOL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Your Next Lesson: St.-Joseph', 'kicker': 'Wine School', 'content_kicker': None, 'print_headline': 'A Red to Warm the Season', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Asimov, Eric', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wines', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-01T13:44:11+0000', 'docume