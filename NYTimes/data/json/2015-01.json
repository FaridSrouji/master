ge': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Whitney Houston’s Daughter Found Unresponsive in Tub', 'kicker': None, 'content_kicker': None, 'print_headline': 'Whitney Houston’s Daughter Found Limp in Tub', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fitzsimmons, Emma G', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Bobbi Kristina (1993-2015)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Houston, Whitney', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Bobby', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-31T19:33:46+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Emma G. Fitzsimmons', 'person': [{'firstname': 'Emma', 'middlename': 'G.', 'lastname': 'Fitzsimmons', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/521754aa-fe0f-5d8d-9e7c-2fdb1c865c35', 'word_count': 335, 'uri': 'nyt://article/521754aa-fe0f-5d8d-9e7c-2fdb1c865c35'}, {'abstract': 'Lisa Batiashvili is baffled by the West’s fondness for Valery Gergiev, and by violinists’ obsession with “Strads.”', 'web_url': 'https://www.nytimes.com/2015/02/01/arts/music/lisa-batiashvili-on-violins-ukraine-and-valery-gergiev.html', 'snippet': 'Lisa Batiashvili is baffled by the West’s fondness for Valery Gergiev, and by violinists’ obsession with “Strads.”', 'lead_paragraph': 'Lisa Batiashvili, the 35-year-old Georgian violinist who is this season’s artist in residence with the New York Philharmonic and will perform Barber’s Violin Concerto with that orchestra this week, is an eloquent musician. In concert and on award-winning recordings, she has captivated critics and audiences with her natural elegance, silky sound and the meticulous grace of her articulation. There is a laserlike directness to her playing that enables her to transmit concentrated emotions without a trace of affectation or theatrics: the musical equivalent to laparoscopic surgery.', 'print_section': 'AR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/01/arts/01LISA1/01LISA1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/02/01/arts/01LISA1/01LISA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/01/arts/01LISA1/01LISA1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/01/arts/01LISA1/01LISA1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/01/arts/01LISA1/01LISA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/01/arts/01LISA1/01LISA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/01/arts/01LISA1/01LISA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Politics Is Personal, and Professional', 'kicker': None, 'content_kicker': None, 'print_headline': 'Politics Is Personal, and Professional', 'name': None, 'seo': None, 'sub': None}, 'keywo