e': 'image', 'url': 'images/2015/01/08/us/SHERIFF2/SHERIFF2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/08/us/SHERIFF2/SHERIFF2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/08/us/SHERIFF2/SHERIFF2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rural Justice Focus of Ex-Police Chief’s Murder Trial', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rural Justice Focus of Ex-Police Chief’s Murder Trial', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Blinder, Alan S', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bailey, Bernard (1956-2011)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Combs, Richard J', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'South Carolina', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Self-Defense', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-07T13:57:02+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Alan Blinder', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Blinder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/065755a4-92bb-5436-bd9b-55811e9d5299', 'word_count': 888, 'uri': 'nyt://article/065755a4-92bb-5436-bd9b-55811e9d5299'}, {'abstract': 'His brother and his girlfriend had no idea why he disappeared — or why he turned up in an online video being questioned by Ukraine’s internal security service.', 'web_url': 'https://www.nytimes.com/2015/01/11/magazine/a-russian-soldier-vanishes-in-ukraine.html', 'snippet': 'His brother and his girlfriend had no idea why he disappeared — or why he turned up in an online video being questioned by Ukraine’s internal security service.', 'lead_paragraph': 'After their father died and their mother fell into drink, Petr Khokhlov and his brother, Sergey, were sent to an orphanage in Novouzensk, a small, dusty town of low-slung Soviet-era apartment blocks on Russia’s border with Kazakhstan. The two boys had only each other. Petr was quiet and well behaved, scolding other students at the orphanage when they addressed their teachers with the familiar ty, rather than the more formal vy. He played the balalaika in music class and carried himself as a little gentleman, with any number of pretty girls in tow. As they grew up, Petr would consult with his older brother on just about every decision, down to what T-shirts he should buy. When Sergey was courting the woman who would later become his wife, Petr — just two years Sergey’s junior, but with a soft, boyish face that made him look even younger — would tag along on their dates to the movies and fall asleep in the back seat on the drive home.', 'print_section': 'MM', 'print_page': '39', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/magazine/11soldiert1/11soldiert1-articleLarge-v2.jpg', 'height': 329, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/11/magazine/11soldiert1/11soldiert1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 329}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/magazine/11soldiert1/11soldiert1-jumbo-v2.jpg', 'height': 562, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/magazine/11soldiert1/11soldiert1-superJumbo-v2.jpg', 'height': 1124, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/magazine/11soldiert1/11mag-11soldier.t_CA3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/11/magazine/11soldiert1/11mag-11soldier.t_CA3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/magazine/11soldiert1/11mag-11soldier.t_CA3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Search for Petr Khokhlov', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Inconvenient Soldier', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Khokhlov, Petr', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Ukraine', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Poroshenko, Petro Olekseyevich', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-07T13:58:26+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Joshua Yaffa', 'person': [{'firstname': 'Joshua', 'middlename': None, 'lastname': 'Yaffa', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f2bf51a1-c157-5eaf-a130-363b519f5c90', 'word_count': 8084, 'uri': 'nyt://article/f2bf51a1-c157-5eaf-a130-363b519f5c90'}, {'abstract': 'With “Cake,” Jennifer Aniston hopes to transcend tabloid coverage and earn the kind of recognition reserved for serious actresses.', 'web_url': 'https://www.nytimes.com/2015/01/11/movies/awardsseason/jennifer-aniston-has-something-to-prove-with-cake.html', 'snippet': 'With “Cake,” Jennifer Aniston hopes to transcend tabloid coverage and earn the kind of recognition reserved for serious actresses.', 'lead_paragraph': 'You can star in one of the most beloved sitcoms of the last quarter century, win an Emmy, be paid $1 million per episode, find as much success in movies and still have more than a little something to prove, along with a whole lot to lose.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/arts/11ANISTON2/11JPANISTON1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/11/arts/11ANISTON2/11JPANISTON1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/arts/11ANISTON2/11JPANISTON1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/arts/11ANISTON2/11JPANISTON1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/11/arts/11ANISTON2/11ANISTON2-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/11/arts/11ANISTON2/11ANISTON2-thumbStandar