ne, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-21T22:31:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/2a8e788b-6301-5689-9aae-fccd21d41054', 'word_count': 14, 'uri': 'nyt://article/2a8e788b-6301-5689-9aae-fccd21d41054'}, {'abstract': 'Part 2 of Taylor Mac’s sprawling adventure of culture(s) through music is a frolicsome romp from the 1930s to the 1950s.', 'web_url': 'https://www.nytimes.com/2015/01/22/theater/taylor-macs-a-24-decade-history-of-popular-music-1930s-1950s.html', 'snippet': 'Part 2 of Taylor Mac’s sprawling adventure of culture(s) through music is a frolicsome romp from the 1930s to the 1950s.', 'lead_paragraph': '“Everything you’re feeling is appropriate,” says Taylor Mac, repeatedly, as if to soothe anxious children, during the second three-hour installment of his opus in progress, “A 24-Decade History of Popular Music,” which is having its premiere at New York Live Arts as part of the Under the Radar festival. The assurance may well be needed for anyone in the audience uncomfortable with being uncomfortable — either physically, emotionally or politically. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/arts/taylormac/taylormac-articleLarge.jpg', 'height': 447, 'width': 600, 'subType': 'xlarge', 'crop_name': 'ar