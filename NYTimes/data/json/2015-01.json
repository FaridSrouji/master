', 'url': 'images/2015/02/01/arts/01SNAPSHOT/01SNAPSHOT-superJumbo.jpg', 'height': 2048, 'width': 1398, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/01/arts/01SNAPSHOT/01SNAPSHOT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/02/01/arts/01SNAPSHOT/01SNAPSHOT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/02/01/arts/01SNAPSHOT/01SNAPSHOT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dabbling in Romantic Chemistry ', 'kicker': 'Snapshot', 'content_kicker': None, 'print_headline': 'Dabbling in Romantic Chemistry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Murphy, Mekado', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Starr, Martin', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Amira & Sam (Movie)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-28T19:12:03+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'Interview by Mekado Murphy', 'person': [{'firstname': 'Interview', 'middlename': 'Mekado', 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/bd59a71d-4248-5643-a943-9bc9e42b769b', 'word_count': 600, 'uri': 'nyt://article/bd59a71d-4248-5643-a943-9bc9e42b769b'}, {'abstract': 'About 250 union workers at the museum are planning a five-day strike to protest the privatization of visitor and security services. The museum’s management has said there will be no layoffs.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/01/28/workers-at-londons-national-gallery-plan-five-day-strike/', 'snippet': 'About 250 union workers at the museum are planning a five-day strike to protest the privatization of visitor and security services. The museum’s management has said there will be no layoffs.', 'lead_paragraph': 'LONDON — Employees at the National Gallery here have voted in favor of a five-day strike in response to the museum’s decision to outsource visitor and security services to a private company. The change would affect approximately 400 of the 600 staff members. About 250 employees who are members of the Public and Commercial Services union voted in favor of the strike, which is planned for Feb. 3 to 7. Mark Serwotka, the general secretary of the union, said in a statement that the museum’s plan “risks damaging the worldwide reputation of what is one of the U.K.’s greatest cultural assets.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/29/arts/28artsbeat-national/28artsbeat-national-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/29/arts/28artsbeat-national/28artsbeat-national-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/29/arts/28artsbeat-national/28artsbeat-national-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/29/arts/28artsbeat-national/28artsbeat-national-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_