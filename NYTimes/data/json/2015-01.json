01/26/blogs/26iht-old27-vietnam/26iht-old27-vietnam-superJumbo-v3.png', 'height': 418, 'width': 293, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/26/blogs/26iht-old27-vietnam/26iht-old27-vietnam-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/26/blogs/26iht-old27-vietnam/26iht-old27-vietnam-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/26/blogs/26iht-old27-vietnam/26iht-old27-vietnam-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1965: Fiery Suicide in Vietnam', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Vietnam', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-26T17:01:55+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0893feb7-9d82-556d-a6c5-f301765d1d62', 'word_count': 101, 'uri': 'nyt://article/0893feb7-9d82-556d-a6c5-f301765d1d62'}, {'abstract': 'An employee said the company had acted to comply with an order from a court in Turkey, whose government has not hesitated to cut access to services like Twitter and YouTube for political reasons.', 'web_url': 'https://www.nytimes.com/2015/01/27/world/europe/facebook-said-to-block-pages-on-muhammad-to-avoid-ban-in-turkey.html', 'snippet': 'An employee said the company had acted to comply with an order from a court in Turkey, whose government has not hesitated to cut access to services like Twitter and YouTube for political reasons.', 'lead_paragraph': 'ISTANBUL — To avoid being banned throughout Turkey, Facebook has blocked Turkish users’ access to a number of pages containing content that the authorities had deemed insulting to the Prophet Muhammad, according to a company employee with direct knowledge of the matter and a report by the state broadcaster TRT.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Facebook Is Said to Block Pages Critical of Muhammad to Avoid Shutdown in Turkey', 'kicker': None, 'content_kicker': None, 'print_headline': 'Facebook Said to Block Pages Critical of Muhammad to Avoid Shutdown in Turkey', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Turkey', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Arsu, Sebnem', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Erdogan, Recep Tayyip', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-01-26T17:05:23+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Sebnem Arsu and Mark Scott', 'person': [{'firstname': 'Sebnem', 'middlename': None, 'lastname': 'Arsu', 'qualifier':