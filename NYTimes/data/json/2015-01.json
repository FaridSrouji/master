thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Connecting the Dots on the Art Map', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-01-29T15:35:18+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/c50c9a9a-7e58-507c-bdee-f3f1d99a6947', 'word_count': 0, 'uri': 'nyt://slideshow/c50c9a9a-7e58-507c-bdee-f3f1d99a6947'}, {'abstract': 'Current art-gallery group shows cover a dizzying array of subjects and styles, including judo, erotic haiku in giant letters and unusual self-portraits.', 'web_url': 'https://www.nytimes.com/2015/01/30/arts/design/art-exhibitions-from-chelsea-to-the-lower-east-side.html', 'snippet': 'Current art-gallery group shows cover a dizzying array of subjects and styles, including judo, erotic haiku in giant letters and unusual self-portraits.', 'lead_paragraph': 'Group shows are a staple of the New York gallery scene, but right now they are not only more plentiful than usual, they are especially good. The 15 group shows reviewed or mentioned here form a welcome antidote to the deluge of monolithic, big-name, single-artist shows that have drawn most of the air in the art world over the last year. They take us to a place where money is not king and give us small snapshots from the gigantic disorderly sprawl that is contemporary art. These shows often represent dealers, their gallery directors or invited curators — usually artists or critics — thinking slightly or very outside the box, putting together disparate works often by younger or lesser-known artists, in new and illuminating combinations. The dizzying bounty here reveals not only the elastic nature of the words “art” and “artist” but also of the group-show format itself. ', 'print_section': 'C', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '15 Group Shows Not to Miss', 'kicker': None, 'content_kicker': None, 'print_headline': '15 Group Shows Not to Miss', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'ARTISTS SPACE', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Artworks', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Clifton Benevento Gallery', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': "Gavin Brown's Enterprise", 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Kate Werble Gallery', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Wallspace Gallery', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'White Columns (Manhattan, NY)', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-01-29T15:35:50+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fda23129-f10a-5b76-bc75-35232900957c', 'word_count': 1763, 'uri': 'nyt://article/fda23129-f10a-5b76-bc75-35232900957c'}, {'abstract': 'Perfectionism can take a high toll on children who see it as the only route to living up to their own and their parents’ high standards.', 'web_url': 'https://parenting.blogs.nytimes.com/2015/01/29/helping-a-perfectionist-child-worry-less-and-do-more/', 'snippet': 'Perfectionism can take a high toll on children who see it as the only route to living up to their own and their parents’ high standards.', 'lead_paragraph': 'A question I’ve been getting a