.jpg', 'xlargewidth': 600, 'xlargeheight': 351}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04MCINERNEY/0104-bks-McInerney-jumbo.jpg', 'height': 600, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04MCINERNEY/0104-bks-McInerney-superJumbo.jpg', 'height': 1199, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04MCINERNEY/0104-bks-McInerney-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/04/books/review/04MCINERNEY/0104-bks-McInerney-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04MCINERNEY/0104-bks-McInerney-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Us,’ by David Nicholls', 'kicker': None, 'content_kicker': None, 'print_headline': 'Stations of Grief', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nicholls, David', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-02T16:38:03+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jay McInerney', 'person': [{'firstname': 'Jay', 'middlename': None, 'lastname': 'McInerney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4101754b-748e-53d3-89f9-92bb31dbc1d6', 'word_count': 1135, 'uri': 'nyt://article/4101754b-748e-53d3-89f9-92bb31dbc1d6'}, {'abstract': 'Lydia Millet satirizes our rapacious culture in this novel of mermaids, mercenaries and a Caribbean honeymoon gone awry.', 'web_url': 'https://www.nytimes.com/2015/01/04/books/review/mermaids-in-paradise-by-lydia-millet.html', 'snippet': 'Lydia Millet satirizes our rapacious culture in this novel of mermaids, mercenaries and a Caribbean honeymoon gone awry.', 'lead_paragraph': 'It’s a bold move to make mermaids the center of a grown-up story, even in a novel as hilariously funny as this one. But Lydia Millet’s novels raise the bar for boldness. Through the window of the unlikeliest events or plot twists, she poses the questions many contemporary writers shy away from, or simply skirt: What’s going to happen to the earth? How do we know what to believe? What are the costs of irony? ', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/0104-bks-Steinke/0104-bks-Steinke-articleLarge.jpg', 'height': 736, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/04/books/review/0104-bks-Steinke/0104-bks-Steinke-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 736}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/0104-bks-Steinke/0104-bks-Steinke-jumbo.jpg', 'height': 1024, 'width': 836, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/0104-bks-Steinke/0104-bks-Steinke-superJumbo.jpg', 'height': 1925, 'width': 1570, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype':