o-v3.jpg', 'height': 215, 'width': 211, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/health/well_aging/well_aging-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/06/04/health/well_aging/well_aging-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/06/04/health/well_aging/well_aging-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Many ‘Healthy Obese’ Don’t Stay Healthy', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'Aging: Illness Often Follows Obesity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blood Pressure', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cholesterol', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Heart', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Obesity', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bell, Joshua A', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'University College London', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-07T17:45:48+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Nicholas Bakalar', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Bakalar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0aee8819-fe0c-5c21-a549-e0e212a1a18d', 'word_count': 218, 'uri': 'nyt://article/0aee8819-fe0c-5c21-a549-e0e212a1a18d'}, {'abstract': 'Highlights from the International Herald Tribune archives: 1965: Gunman, John Marson, caught after chase.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/01/07/1965-gunman-caught-after-chase/', 'snippet': 'Highlights from the International Herald Tribune archives: 1965: Gunman, John Marson, caught after chase.', 'lead_paragraph': 'LONDON — Unarmed police captured a dangerous gunman last night [Jan. 7] after cornering him in a basement club and felling him with a barrage of stones, bottles and chairs. But before being captured, the gunman injured two policemen and killed an Alsatian police dog. The gunman, identified as John Marson, a 22-year-old jailbreaker, was charged today with attempted murder. His capture last night took place after he had forced a restaurant owner into a white Mercedes sportscar and led 14 London police cars and motorcycles on a 100-mile-per-hour chase back and forth across the bridges over the River Thames.— New York Herald Tribune, European Edition, Jan. 8, 1965', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1965: Gunman Caught After Chase', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Attacks on Police', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-07T17:46:08+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ba522539-8018-5bdd-9316-96e392563e26', 'word_count': 109, 'uri': 'nyt://article/ba522539-8018-5bdd-9316-96e392563e26'}, 