name': 'Austin', 'middlename': None, 'lastname': 'Ramzy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2590f82d-9010-55c4-b3d4-4f03e59b9828', 'word_count': 642, 'uri': 'nyt://article/2590f82d-9010-55c4-b3d4-4f03e59b9828'}, {'abstract': 'The flight data recorder from Flight 8501 was retrieved on Monday morning, and divers have also pinpointed the location of the cockpit voice recorder.', 'web_url': 'https://www.nytimes.com/2015/01/13/world/asia/first-black-box-is-recovered-from-plane-airasia-flight-8501.html', 'snippet': 'The flight data recorder from Flight 8501 was retrieved on Monday morning, and divers have also pinpointed the location of the cockpit voice recorder.', 'lead_paragraph': 'JAKARTA, Indonesia — Indonesian Navy divers on Monday retrieved one of the so-called black boxes from the AirAsia plane that crashed into the Java Sea late last month and were trying to recover the other one amid strong underwater currents and limited visibility, officials said.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/asia/13plane-1/12watching-plane01-articleLarge.jpg', 'height': 409, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/12/world/asia/13plane-1/12watching-plane01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 409}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/asia/13plane-1/12watching-plane01-jumbo.jpg', 'height': 698, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/asia/13plane-1/12watching-plane01-superJumbo.jpg', 'height': 1395, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/asia/13plane-1/12watching-plane01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/12/world/asia/13plane-1/12watching-plane01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/asia/13plane-1/12watching-plane01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'First Black Box Is Recovered From AirAsia Plane', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AirAsia Flight 8501', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recording Equipment', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Aviation Accidents, Safety and Disasters', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Java (Indonesia)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-12T06:22:50+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Joe Cochrane', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Cochrane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/962cc1ab-e010-5aec-ab14-5ed8ada76fb2', 'word_count': 398, 'uri': 'nyt://article/962cc1ab-e010-5aec-ab14-5ed8ada76fb2'}, {'abstract': 'Jimmy Lai, who has come under attack for his anti-Communist views, speaks about his role in the Occupy Central protests, why he is distancing himself from his media company and the challenges that lie ahead.', 'web_url': 'https://sinosphere.blogs.nytimes.com/2015/01/12/q-and-a-jimmy-lai-on-the-democracy-movement-in-hong-kong/', 'snippet': 'Jimmy Lai, who has come under attack for his anti-Communist views, speaks about his role in the Occupy Central protests, why he is distancing himself from his media company and the challenges that lie ahead.', 'lead_paragraph': 'Jimmy Lai, profiled in Monday’s New York Times, is the founder and owner and was until recently the chairman of Next Media, which publishes the Apple Daily newspaper and Next Magazine in Hong Kong and Taiwan. He was a central figure in the pro-democracy Occupy Central protests, in which demonstrators closed major streets in three sections of Hong Kong between late September and mid-December. Now, officials in Hong Kong are weighing bringing formal charges against scores of people they have identified as key members of the protests. On Friday, Mr. Lai, 66, was instructed to report to police headquarters on Jan. 21.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/12sino-lai01/12sino-lai01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/12/world/12sino-lai01/12sino-lai01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/12sino-lai01/12sino-lai01-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/12sino-lai01/12sino-lai01-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/12sino-lai01/12sino-lai01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/12/world/12sino-lai01/12sino-lai01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/12/world/12sino-lai01/12sino-lai01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Q. and A.: Jimmy Lai on the Democracy Movement in Hong Kong', 'kicker': 'Sinosphere', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARSON', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Media', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lai, Jimmy', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'APPLE DAILY', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Next Media Ltd', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Occupy Central', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Hong Kong', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-01-12T06:59:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Neil Gough and Alan Wong', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Gough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Alan', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b33b7055-51e0-56d0-84a1-7cd82aa03fbf', 'word_