ame': 'organizations', 'value': 'House of Representatives', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-15T17:06:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Parker', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c446c463-d57b-5f85-93cd-dc205281d85e', 'word_count': 441, 'uri': 'nyt://article/c446c463-d57b-5f85-93cd-dc205281d85e'}, {'abstract': 'The visuals for “Tide: The Paradox Effect,” the second single from Richard’s sophomore album, “Blackheart,” find Richard embodied by an animated, Joan of Arc-esque gladiator who battles galactic forces to reach the sun.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/01/15/dawn-richard-tide-paradox-effect-video/', 'snippet': 'The visuals for “Tide: The Paradox Effect,” the second single from Richard’s sophomore album, “Blackheart,” find Richard embodied by an animated, Joan of Arc-esque gladiator who battles galactic forces to reach the sun.', 'lead_paragraph': 'To create her second album, “Blackheart,” the R&B singer Dawn Richard put herself through the ultimate career-defining test: isolation. “I had to get away,” the 31-year-old singer-songwriter says. “I literally left everything I had just to lock myself in a cabin in the woods for months and complete this album. No phone, no nothing. I even deleted my Instagram.” After the abrupt collapse of her fame-making reality-show band, Danity Kane, in August, along with a cancer diagnosis for her father and the death of her grandmother, Richard found herself at a crossroads. “I didn’t know if I wanted to make music anymore,” she says. “It took a lot to come to this point, and this project is definitely the deepest, darkest place I’ve been. It became more than just an album when I decided to keep it going. It was my test. It was my therapy, and I had to go through it.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Stylish, Futuristic New Music Video From the R&B Singer Dawn Richard', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Danity Kane', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-01-15T17:15:42+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Marcus Holmlund', 'person': [{'firstname': 'Marcus', 'middlename': None, 'lastname': 'Holmlund', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4520ac3e-acf8-55a6-a147-9834e3e48c22', 'word_count': 310, 'uri': 'nyt://article/4520ac3e-acf8-55a6-a147-9834e3e48c22'}, {'abstract': 'Ms. Carey will begin a residency at the Colosseum, at Caesars Palace, on May 6.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/01/15/mariah-carey-set-for-a-run-in-las-vegas/', 'snippet': 'Ms. Carey will begin a residency at the Colosseum, at Caesars Palace, on May 6.', 'lead_paragraph': 'In an ideal marriage of dazzle and camp, Mariah Carey will become the latest pop diva to bring her outsize presence to the Las Vegas Strip.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/15artsbeat-mariah/15artsbeat-mariah-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/