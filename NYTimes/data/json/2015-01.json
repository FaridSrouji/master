ns', 'value': 'Democratic Party', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Hershey Foods Corp', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Baltimore (Md)', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-01-15T12:07:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/e38c611d-68bf-5153-ae52-101636beda12', 'word_count': 1601, 'uri': 'nyt://article/e38c611d-68bf-5153-ae52-101636beda12'}, {'abstract': 'Remaining candidates are expected to be questioned individually as jury selection resumes in the trial of Dzhokhar Tsarnaev, the defendant in the 2013 attack.', 'web_url': 'https://www.nytimes.com/2015/01/16/us/dzhokhar-tsarnaev-boston-marathon-bombing-jury-trial.html', 'snippet': 'Remaining candidates are expected to be questioned individually as jury selection resumes in the trial of Dzhokhar Tsarnaev, the defendant in the 2013 attack.', 'lead_paragraph': 'BOSTON — One potential juror said his wife was an intensive care nurse who had treated victims of the Boston Marathon bombing. Another had posted comments on social media while his neighborhood was on lockdown during a manhunt for the suspects. Yet another said he could not imagine any evidence that would make him think the defendant was innocent — and his friends had told him it would be “cool” to impose the death sentence.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/us/MARATHON-web/MARATHON-web-jumbo.jpg', 'height': 604, 'width': 585, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'cred