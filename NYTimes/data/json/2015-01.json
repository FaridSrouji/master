ier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9f0b201e-a0ed-5dbe-a84d-a8f7c09f4875', 'word_count': 1848, 'uri': 'nyt://article/9f0b201e-a0ed-5dbe-a84d-a8f7c09f4875'}, {'abstract': 'The author Tess Gerritsen had claimed that Warner breached a contract with her when it made the film.', 'web_url': 'https://www.nytimes.com/2015/01/31/business/media/judge-rules-for-warner-bros-in-dispute-over-gravity.html', 'snippet': 'The author Tess Gerritsen had claimed that Warner breached a contract with her when it made the film.', 'lead_paragraph': 'LOS ANGELES — While viewers work through this year’s Oscar films, a court here is still working its way through one of last year’s nominees, “Gravity.” On Friday, Judge Margaret M. Morrow of the United States District Court for the Central District of California in Los Angeles dismissed a complaint by the author Tess Gerritsen, who had claimed that Warner Bros. breached a contract with her when it made “Gravity” without giving her credit or 2.5 percent of the film’s net profit.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Judge Rules for Warner Bros. in Dispute Over ‘Gravity’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Gravity (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gerritsen, Tess', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Warner Brothers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-31T02:16:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'rep