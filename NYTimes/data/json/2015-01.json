'type_of_material': 'News', '_id': 'nyt://article/fba3d7ee-857f-54ff-9b06-e598f7291f6d', 'word_count': 412, 'uri': 'nyt://article/fba3d7ee-857f-54ff-9b06-e598f7291f6d'}, {'abstract': '“Roll Along”‘s retro vibe complements the singer’s narrative-style folk sound.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/01/13/singer-songwriter-tom-brosseau-new-video/', 'snippet': '“Roll Along”‘s retro vibe complements the singer’s narrative-style folk sound.', 'lead_paragraph': '“I have all these cinematic ideas, but when it comes to filming it’s all Greek to me,” says Tom Brosseau about “Roll Along with Me,” the first single and video from his forthcoming album, “Perfect Abandon.” Luckily, Brosseau found a kindred spirit and co-conspirator in the director Andrew van Baal early on in his career. The two met in San Diego in the early 2000s, and since then, van Baal has directed a number of music videos for Brosseau, as well as casting him as the lead in van Baal’s 2012 short film, “Wonder Valley.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13symonds-brosseau/13symonds-brosseau-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/13/t-magazine/13symonds-brosseau/13symonds-brosseau-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13symonds-brosseau/13symonds-brosseau-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/13/t-magazine/13symonds-brosseau/13symonds-brosseau-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'r