ame': 'organizations', 'value': 'Senate', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-01-08T01:15:05+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Gail Collins', 'person': [{'firstname': 'Gail', 'middlename': None, 'lastname': 'Collins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c863dedf-ec79-5f55-b286-ae320654c8d2', 'word_count': 809, 'uri': 'nyt://article/c863dedf-ec79-5f55-b286-ae320654c8d2'}, {'abstract': 'The first phase of jury selection in the trial of Dzhokhar Tsarnaev in the Boston Marathon bombing ended Wednesday.', 'web_url': 'https://www.nytimes.com/2015/01/08/us/massachusetts-prospective-jurors-screened-for-trial-of-dzhokhar-tsarnaev.html', 'snippet': 'The first phase of jury selection in the trial of Dzhokhar Tsarnaev in the Boston Marathon bombing ended Wednesday.', 'lead_paragraph': 'The first phase of jury selection in the trial of\xa0Dzhokhar\xa0Tsarnaev in the Boston Marathon bombing ended Wednesday\xa0as the last of\xa0more than\xa01,350\xa0prospective jurors filled out questionnaires intended to help lawyers and the court find 12 jurors and six alternates for the capital case. For the third day,\xa0several hundred\xa0prospective jurors were introduced by Judge George O’Toole to the defendant, who is accused of killing three people and injuring more than 260. One of those injured, Jaymi Cohen, a college student, watched the proceedings alongside Carmen Ortiz, the United States attorney for the District of Massachusetts. The questionnaires\xa0will be reviewed, and some of the prospective jurors will be summoned for further questioning. ', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Massachusetts: Prospective Jurors Screened for Trial of Dzhokhar Tsarnaev', 'kicker': 'National Briefing | New England', 'content_kicker': None, 'print_headline': 'Massachusetts: Prospective Jurors Screened', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Boston Marathon Bombings (2013)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bidgood, Jess', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jury System', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tsarnaev, Dzhokhar A', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-08T01:16:57+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jess Bidgood', 'person': [{'firstname': 'Jess', 'middlename': None, 'lastname': 'Bidgood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/40f8df29-8f90-5abd-b8fa-031976d7b994', 'word_count': 109, 'uri': 'nyt://article/40f8df29-8f90-5abd-b8fa-031976d7b994'}, {'abstract': 'Both sides will have to give a little, a matter of politics more than principle. Everyone will have to swallow as much contrition as they can stomach.', 'web_url': 'https://www.nytimes.com/2015/01/08/opinion/charles-blow-who-should-apologize-in-police-conflict.html', 'snippet': 'Both sides will have to give a little, a matter of politics more than principle. Everyone will have to swallow as much contrition as they can stomach.', 'lead_paragraph': 'Patrick Lynch, the president of New York City’s largest police union, has once again called on Mayor Bill de Blasio to apologize to the police officers.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/blow-circular/blow-circular-articleLarge-v2.jpg', 'height': 601, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/201