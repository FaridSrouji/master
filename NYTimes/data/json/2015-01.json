a mother.” ', 'print_section': 'BR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04LOPATE/04LOPATE-articleLarge.jpg', 'height': 896, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/04/books/review/04LOPATE/04LOPATE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 896}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04LOPATE/04LOPATE-jumbo.jpg', 'height': 1024, 'width': 686, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04LOPATE/04LOPATE-superJumbo.jpg', 'height': 2048, 'width': 1371, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04LOPATE/04LOPATE-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/04/books/review/04LOPATE/04LOPATE-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/04/books/review/04LOPATE/04LOPATE-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Loitering,’ Essays by Charles D’Ambrosio', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Heart of the Matter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': "D'Ambrosio, Charles", 'rank': 2, 'major': 'N'}], 'pub_date': '2