MA-slide-2C6N/20150116-SELMA-slide-2C6N-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/16/arts/design/20150116-SELMA-slide-2C6N/20150116-SELMA-slide-2C6N-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/design/20150116-SELMA-slide-2C6N/20150116-SELMA-slide-2C6N-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Freedom Journey 1965’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Somerstein, Stephen', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights Movement (1954-68)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ALABAMA', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Montgomery (Ala)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Selma (Ala)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'New-York Historical Society', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-01-15T23:02:51+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/702a7762-8a9e-5dbb-8e78-5259af440f2d', 'word_count': 0, 'uri': 'nyt://slideshow/702a7762-8a9e-5dbb-8e78-5259af440f2d'}, {'abstract': 'Two shows on the Upper East Side of Manhattan form a valuable exchange about the physical processes of making art and what they impart.', 'web_url': 'https://www.nytimes.com/2015/01/16/arts/design/jasper-johns-and-ray-johnson-on-the-upper-east-side.html', 'snippet': 'Two shows on the Upper East Side of Manhattan form a valuable exchange about the physical processes of making art and what they impart.', 'lead_paragraph': '“Make it new” was Barnett Newman’s famous injunction to his fellow Abstract Expressionists. It has an idealistic, exhortatory urgency, but achieving newness is in some ways quite mundane: It involves doing something physical, usually with materials, that hasn’t been done before. This can include new twists on old techniques, like the tiny dots of oil paint with which the Post-Impressionist Georges Seurat formed his images; the introduction of nonart materials or objects, as with Cubist collage and Marcel Duchamp’s ready-mades; or the repurposing of a commercial technique or tool, like the silk-screen process or the portable video camera. ', 'print_section': 'C', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16JASPER1/16JASPER1-articleLarge.jpg', 'height': 363, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/16/arts/16JASPER1/16JASPER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 363}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16JASPER1/16JASPER1-jumbo.jpg', 'height': 620, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16JASPER1/16JASPER1-superJumbo.jpg', 'height': 1240, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16JASPER1/16JASPER1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': '