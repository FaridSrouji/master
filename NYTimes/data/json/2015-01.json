r': None, 'print_headline': 'Carl N. Degler, 93, a Scholarly Voice of the Oppressed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Degler, Carl N (1921-2014)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': "Women's Rights", 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'AFFIRMATIVE ACTION', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Stanford University', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-10T22:55:39+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sam Roberts', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Roberts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/4e53778f-e133-56df-bb67-a53cf3f6dd31', 'word_count': 753, 'uri': 'nyt://article/4e53778f-e133-56df-bb67-a53cf3f6dd31'}, {'abstract': 'The Cavaliers paid a steep price in trading for Timofey Mozgov because seven-footers with respectable statistics are a relative rarity in the N.B.A.', 'web_url': 'https://www.nytimes.com/2015/01/11/sports/basketball/cavaliers-trade-for-timofey-mozgov-highlights-need-for-competent-big-men.html', 'snippet': 'The Cavaliers paid a steep price in trading for Timofey Mozgov because seven-footers with respectable statistics are a relative rarity in the N.B.A.', 'lead_paragraph': 'Red Auerbach won nine N.B.A. titles as coach of the Boston Celtics and seven more as an executive. He was known for, among other things, lighting victory cigars and having an aversion to cheerleaders. One of his most enduring quotations referred to virtually any player who stands 7 feet or taller: “You can’t teach height.”', 'print_section': 'SP', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge