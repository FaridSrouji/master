, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/sports/CITY-KNICKS/CITY-KNICKS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/sports/CITY-KNICKS/CITY-KNICKS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/22/sports/CITY-KNICKS/CITY-KNICKS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/22/sports/CITY-KNICKS/CITY-KNICKS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': ' Facing 76ers, Knicks Earn a Win. Someone Had To. ', 'kicker': 'Knicks 98, 76ers 91', 'content_kicker': None, 'print_headline': 'Facing 76ers, Knicks Earn a Win. Someone Had To.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Brett (1961- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fisher, Derek (1974- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Knicks', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia 76ers', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-22T03:55:04+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Andrew Keh', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Keh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/360dd6e0-35ae-5690-a7e1-36ed82