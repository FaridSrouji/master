': 'glocations', 'value': 'Yemen', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Naggar, Mona el-', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Houthis', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sunni Muslims', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Al Qaeda in the Arabian Peninsula', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Hezbollah', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Sana (Yemen)', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-29T17:27:51+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Mona El-Naggar', 'person': [{'firstname': 'Mona', 'middlename': None, 'lastname': 'El-Naggar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b391396-113f-5ec9-a235-f0e0a0d49f6a', 'word_count': 1405, 'uri': 'nyt://article/0b391396-113f-5ec9-a235-f0e0a0d49f6a'}, {'abstract': 'The Chinese authorities are no longer tolerating the workarounds used by millions of people who rely heavily on less-fettered access to the Internet.', 'web_url': 'https://www.nytimes.com/2015/01/30/world/asia/china-clamps-down-still-harder-on-internet-access.html', 'snippet': 'The Chinese authorities are no longer tolerating the workarounds used by millions of people who rely heavily on less-fettered access to the Internet.', 'lead_paragraph': 'BEIJING — Jing Yuechen, the founder of an Internet start-up here in the Chinese capital, has no interest in overthrowing the Communist Party. But these days she finds herself cursing the nation’s smothering cyberpolice as she tries — and fails — to browse photo-sharing websites like Flickr and struggles to stay in touch with the Facebook friends she has made during trips to France, India and Singapore.', 'print_section': 'A', 'print_page': '1', 'sourc