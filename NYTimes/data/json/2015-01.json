ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63c95787-62e4-5895-8739-dddfde6b6435', 'word_count': 1025, 'uri': 'nyt://article/63c95787-62e4-5895-8739-dddfde6b6435'}, {'abstract': 'Vermont Yankee brought high-paying jobs and an expanded tax base to an area with precious little industry. But it drew decades of protest from residents who feared a nuclear disaster.', 'web_url': 'https://www.nytimes.com/2015/01/05/us/vermont-yankee-nuclear-plant-begins-slow-process-of-closing.html', 'snippet': 'Vermont Yankee brought high-paying jobs and an expanded tax base to an area with precious little industry. But it drew decades of protest from residents who feared a nuclear disaster.', 'lead_paragraph': 'VERNON, Vt. — When the Vermont Yankee nuclear plant rose on a bank of the Connecticut River, in a region known more for farms and back-to-the-land communes, it was viewed by some as an economic adrenaline shot and by others as an incongruous curse on the land.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/05/us/NUCLEAR1/NUCLEAR1-articleLarge.jpg', 'height': 266, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/05/us/NUCLEAR1/NUCLEAR1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 266}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/05/us/NUCLEAR1/NUCLEAR1-jumbo.jpg', 'height': 454, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/05/us/NUCLEAR1/NUCLEAR1-superJumbo.jpg', 'height': 908, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 