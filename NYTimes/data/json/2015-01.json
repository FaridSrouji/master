mages/2015/01/25/fashion/25MODERNLOVE/25MODERNLOVE-articleLarge.jpg', 'height': 797, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/25/fashion/25MODERNLOVE/25MODERNLOVE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 797}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/fashion/25MODERNLOVE/25MODERNLOVE-jumbo.jpg', 'height': 1024, 'width': 771, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/fashion/25MODERNLOVE/25MODERNLOVE-superJumbo.jpg', 'height': 2048, 'width': 1542, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/fashion/25MODERNLOVE/25MODERNLOVE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/25/fashion/25MODERNLOVE/25MODERNLOVE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/fashion/25MODERNLOVE/25MODERNLOVE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': ' In Manila, Two Seasons, No Regrets  ', 'kicker': 'Modern Love', 'content_kicker': None, 'print_headline': 'In Manila, Two Seasons, No Regrets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Modern Love (Times Column)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Love (Emotion)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dating and Relationships', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Manila (Philippines)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-22T21:01:26+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Laurel Fantauzzo', 'person': [{'firstname': 'Laurel', 'middlename': None, 'lastname': 'Fantauzzo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/72cdb7b9-3db0-596f-ba56-cf0eee77f19d', 'word_count': 1515, 'uri': 'nyt://article/72cdb7b9-3db0-596f-ba56-cf0eee77f19d'}, {'abstract': 'Sufjan Stevens’s latest commission from the Brooklyn Academy of Music is “Round-Up,” inspired by one of the world’s largest rodeos.', 'web_url': 'https://www.nytimes.com/2015/01/23/arts/music/sufjan-stevens-brings-the-rodeo-to-bam.html', 'snippet': 'Sufjan Stevens’s latest commission from the Brooklyn Academy of Music is “Round-Up,” inspired by one of the world’s largest rodeos.', 'lead_paragraph': '“Let ’er buck” is the slogan of the Pendleton Round-Up in Oregon, founded in 1910 and now one of the world’s largest rodeos. Perhaps that brought out a contrarian side in the songwriter and composer Sufjan Stevens. His latest commission from the Brooklyn Academy of Music is “Round-Up,” a wordless, arty documentary with its score performed live for six nights at the BAM Harvey Theater, ending on Sunday. “Round-Up” was filmed in slow motion — 300 frames a second — and the music doesn’t buck; it’s steady and meditative, treating the rodeo as a ritual.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/SUFJAN/SUFJAN-articleLarge-v2.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/23/arts/SUFJAN/SUFJAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'ima