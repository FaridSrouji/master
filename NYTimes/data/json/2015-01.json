ubType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/06/world/DRESDEN-1/DRESDEN-1-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/06/world/DRESDEN-1/DRESDEN-1-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/06/world/DRESDEN-1/DRESDEN-1-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Anti-Immigration Rallies in Germany Defy Calls to Desist ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Anti-Immigration Rallies in Germany Defy Calls to Desist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Pegida (Germany)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Dresden (Germany)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Foreign Workers', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-01-05T17:20:19+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Alison Smale', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Smale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/880d9ac7-5166-5f3f-af73-d6c244ff03d1', 'word_count': 1069, 'uri': 'nyt://article/880d9ac7-5166-5f3f-af73-d6c244ff03d1'}, {'abstract': 'Highlights from the International Herald Tribune archives: 1915: Plot to Smuggle Opium into Britain Foiled.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/01/05/1915-plot-to-smuggle-opium-foiled/', 'snippet': 'Highlights from the International Herald Tribune archives: 1915: Plot to Smuggle Opium into Britain Foiled.', 'lead_paragraph': 'LONDON — The American Embassy here, with the assistance of the Home Office, has succeeded in nipping in the bud a plot to smuggle huge supplies of opium into England from America. The first installment of the drug, contained in three large trunks in charge of Sophie Ghee, wife of a Chinese, was confiscated upon the arrival of the Baltic here on Friday, and the woman was sent back to New York on board the Philadelphia on Saturday. Mr. Horace Lee Washington, the American Consul at Liverpool, by getting in touch with the Baltic’s officers by wireless, enabled them to have everything ready for the woman’s detention when the liner reached port. — The New York Herald, European Edition, Jan. 6, 1915', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1915: Plot to Smuggle Opium Foiled', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crime and Criminals', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Opium', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smuggling', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Liverpool (England)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-05T17:24:01+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune',