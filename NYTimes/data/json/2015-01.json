: 'Business Day', 'byline': {'original': 'By Mark Scott', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/434771f7-570d-54fb-8253-25a8beca9f74', 'word_count': 207, 'uri': 'nyt://article/434771f7-570d-54fb-8253-25a8beca9f74'}, {'abstract': 'West Point cadets and faculty learn how environmental problems in prosperous places sometimes end up shunted to communities still fighting for full civil rights.', 'web_url': 'https://dotearth.blogs.nytimes.com/2015/01/19/in-alabama-west-point-cadets-explore-polluted-civil-rights/', 'snippet': 'West Point cadets and faculty learn how environmental problems in prosperous places sometimes end up shunted to communities still fighting for full civil rights.', 'lead_paragraph': 'On the first Martin Luther King, Jr., Day since the Civil Rights Act had its 50th anniversary, it’s worth reflecting on how — despite much progress in leveling societal playing fields — many environmental “cleanups” in this country simply shift problems to poor communities of color.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/blogs/dotashlandfil/dotashlandfil-articleLarge.png', 'height': 368, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/19/blogs/dotashlandfil/dotashlandfil-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 368}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/blogs/dotashlandfil/dotashlandfil-jumbo.png', 'height': 598, 'width': 975, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/blogs/dotashlandfil/dotashlandfi