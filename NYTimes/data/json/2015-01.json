jor': 'N'}, {'name': 'subject', 'value': 'ANTI-SEMITISM', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Oswiecim (Poland)', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-27T15:57:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Joanna Berendt', 'person': [{'firstname': 'Joanna', 'middlename': None, 'lastname': 'Berendt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/180127ee-8038-5af4-96d5-1a4901629d44', 'word_count': 899, 'uri': 'nyt://article/180127ee-8038-5af4-96d5-1a4901629d44'}, {'abstract': 'Earnest, a start-up lender, is moving into the student debt market. Using data-science tools, Earnest says it can offer lower, tailored rates and flexible repayment schedules.', 'web_url': 'https://bits.blogs.nytimes.com/2015/01/27/a-data-science-lender-takes-on-student-debt/', 'snippet': 'Earnest, a start-up lender, is moving into the student debt market. Using data-science tools, Earnest says it can offer lower, tailored rates and flexible repayment schedules.', 'lead_paragraph': 'Louis Beryl insists that financially responsible young people are the borrowers most disadvantaged by the traditional math of consumer lending. The standard scoring of creditworthiness relies largely on a person’s credit history, and that’s a blunt instrument. Since young people have slender credit histories, he said, they pay higher rates than they should.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/27/technology/27bits-debt/27bits-debt-articleLarge.jpg', 'height': 352, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/27/technology/27bits-debt/27bits-debt-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 352}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/27/technology/27bits-debt/27bits-debt-jumbo.jpg', 'height': 600, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/27/technology/27bits-debt/27bits-debt-superJumbo.jpg', 'height': 1200, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/27/technology/27bits-debt/27bits-debt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/27/technology/27bits-debt/27bits-debt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/27/technology/27bits-debt/27bits-debt-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Data-Science Lender Takes on Student Debt', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Student Loans', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Earnest Inc', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-27T16:00:07+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Steve Lohr', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Lohr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_o