gined Him', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tommasini, Anthony', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Paris National Opera', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mozart, Wolfgang Amadeus', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Haneke, Michael', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Schrott, Erwin', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Don Giovanni (Opera)', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-18T23:19:39+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Anthony Tommasini', 'person': [{'firstname': 'Anthony', 'middlename': None, 'lastname': 'Tommasini', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f74246f5-ee5f-5ef8-bec5-c5cf63a08302', 'word_count': 723, 'uri': 'nyt://article/f74246f5-ee5f-5ef8-bec5-c5cf63a08302'}, {'abstract': 'Illstyle and Peace Productions presented “IMpossible IZZpossible,” a program that blended hip-hop, tap, ballet and West African dance, at the Brooklyn Academy of Music.', 'web_url': 'https://www.nytimes.com/2015/01/19/arts/illstyle-and-peaces-impossible-izzpossible-at-bam-fisher.html', 'snippet': 'Illstyle and Peace Productions presented “IMpossible IZZpossible,” a program that blended hip-hop, tap, ballet and West African dance, at the Brooklyn Academy of Music.', 'lead_paragraph': 'Peace, love and respect are excellent values for a theatrical production to promote, especially one directed at children. But it takes more than good intentions to make a good show, and Illstyle and Peace Productions’ “IMpossible IZZpossible,” which played over the weekend at BAM Fisher as part of the BAM Kids series, is an incoherent jumble. ', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/arts/IMPOSSIBLE/IMPOSSIBLE-articleLarge.jpg', 'height': 816, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/19/arts/IMPOSSIBLE/IMPOSSIBLE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 816}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/arts/IMPOSSIBLE/IMPOSSIBLE-jumbo.jpg', 'height': 1024, 'width': 753, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/arts/IMPOSSIBLE/IMPOSSIBLE-superJumbo.jpg', 'height': 2048, 'width': 1506, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/arts/IMPOSSIBLE/IMPOSSIBLE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/19/arts/IMPOSSIBLE/IMPOSSIBLE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/arts/IMPOSSIBLE/IMPOSSIBLE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hybridized Hip-Hop, Playing to the Kids ', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Hybridized Hip-Hop, Playing to the Kids', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Illstyle and Peace Productions', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-01-18T23:26:57+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Brian Seibert', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Seibert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bb5972d0-2983-59f6-a257-4a334df118c3', 'word_count': 398, 'uri': 'nyt://article/bb5972d0-2983-59f6-a257-4a334df118c3'}, {'abstract': 'Green Bay scored the first 16 points of the game and tied the score after Seattle took a late lead, but the Seahawks quickly drove for a touchdown in overtime, on a 35-yard pass to Jermaine Kearse.', 'web_url': 'https://www.nytimes.com/2015/01/19/sports/football/seahawks-rally-past-packers-in-overtime-for-nfc-championship-and-spot-in-super-bowl.html', 'snippet': 'Green Bay scored the first 16 points of the game and tied the score after Seattle took a late lead, but the Seahawks quickly drove for a touchdown in overtime, on a 35-yard pass to Jermaine Kearse.', 'lead_paragraph': 'SEATTLE — The Seahawks huddled on their sideline Sunday afternoon, and inside the circle, their coach, Pete Carroll, pointed and shouted and waved. Above the din, in a stadium that two hours earlier had been stunned into silence, many players nodded along as he spoke.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Seahawks Rally Past Packers in Overtime to Return to Super Bowl', 'kicker': 'Seahawks 28, Packers 22', 'content_kicker': None, 'print_headline': 'A Recovery and a Romp', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rodgers, Aaron', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, Russell', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Seattle Seahawks', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-18T23:34:09+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a3c8b84-60f7-5264-81ee-ca590ffa81ce', 'word_count': 1224, 'uri': 'nyt://article/2a3c8b84-60f7-5264-81ee-ca590ffa81ce'}, {'abstract': '“The Nightly Show” on Comedy Central has its premiere on Monday night, and its host, Larry Wilmore, is working hard to prepare while keeping his options open.', 'web_url': 'https://www.nytimes.com/2015/01/19/arts/television/larry-wilmore-prepares-for-his-nightly-show.html', 'snippet': '“The Nightly Show” on Comedy Central has its premiere on Monday night, and its host, Larry Wilmore, is working hard to prepare while keeping his options open.', 'lead_paragraph': 'Seated at the head of the oblong table where he will preside over his new Comedy Central series, “The Nightly Show,” Larry Wilmore was moderating a vigorous, sometimes sincere, sometimes acerbic panel discussion about the attack on the French newspaper Charlie Hebdo.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/19/arts/WILMORE/WILMORE-articleLarge.jpg', 'height': 379, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/19/arts/WILMORE/WILMORE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 379}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image',