 'keywords': [{'name': 'subject', 'value': 'Airport Security', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Murphy, Kate', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Transportation Security Administration', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-17T19:30:14+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Sunday Review', 'byline': {'original': 'By Kate Murphy', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News Analysis', '_id': 'nyt://article/c3afc539-df71-5821-b8e8-961413212ea7', 'word_count': 1246, 'uri': 'nyt://article/c3afc539-df71-5821-b8e8-961413212ea7'}, {'abstract': 'I couldn’t believe people were shunning my 99-year-old Nanna.', 'web_url': 'https://www.nytimes.com/2015/01/18/opinion/sunday/mean-girls-in-the-retirement-home.html', 'snippet': 'I couldn’t believe people were shunning my 99-year-old Nanna.', 'lead_paragraph': 'ABOUT 18 months ago, my 97-year-old grandmother went out to dinner with some friends. As Nanna got out of the car, she tripped over her friend Shirley’s cane, fell to the pavement and came down hard on her elbow. Back at home, she headed to the kitchen to get some dessert — “and my left leg just crumpled.” ', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Weiner-Jennifer-circular/Weiner-Jennifer-circular-articleLarge.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/16/opinion/Weiner-Jennifer-circular/Weiner-Jennifer-circular-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption