anization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a250f6de-3e80-508b-828d-206792651e49', 'word_count': 266, 'uri': 'nyt://article/a250f6de-3e80-508b-828d-206792651e49'}, {'abstract': 'Senator Dean Heller of Nevada is calling on the N.F.L. to take “decisive actions” to make sure teams play by the rules.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2015/01/22/verbatim-n-f-l-must-punish-cheaters/', 'snippet': 'Senator Dean Heller of Nevada is calling on the N.F.L. to take “decisive actions” to make sure teams play by the rules.', 'lead_paragraph': '– Senator Dean Heller, Republican of Nevada, calling on the N.F.L. to take “decisive actions” to make sure teams play by the rules.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Verbatim: N.F.L. Must Punish Cheaters', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-01-22T21:24:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By First Draft', 'person': [{'firstname': 'First', 'middlename': None, 'lastname': 'Draft', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39f8650e-8c61-5388-9061-4a61bbb1c601', 'word_count': 46, 'uri': 'nyt://article/39f8650e-8c61-5388-9061-4a61bbb1c601'}, {'abstract': 'Caroline Bergvall’s installation takes its inspiration from an incident in which African immigrants were left to drift in the Mediterranean.', 'web_url': 'https://www.nytimes.com/2015/01/23/arts/design/caroline-bergvalls-drift-at-callicoon.html', 'snippet': 'Caroline Bergvall’s installation takes its inspiration from an incident in which African immigrants were left to drift in the Mediterranean.', 'lead_paragraph': 'One of the blockbusters of Western art history, Théodore Géricault’s “The Raft of the Medusa” (1818-19), took as its impetus the true story of sailors left to die at sea, drifting on a raft off the coast of Senegal. Caroline Bergvall’s “Drift,” an installation of prints, sound works and a digital, algorithmic collage, was inspired by a similar tale, only set in the present day. In 2011, African migrants trying to reach the island of Lampedusa in the Mediterranean were left to drift at sea despite being sighted by officials; more than 60 people died.', 'print_section': 'C', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23BERGVALL-GALLERY3/BERGVALL-GALLERY3-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/23/arts/23BERGVALL-GALLERY3/BERGVALL-GALLERY3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23BERGVALL-GALLERY3/BERGVALL-GALLERY3-jumbo.jpg', 'height': 575, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23BERGVALL-GALLERY3/BERGVALL-GALLERY3-superJumbo.jpg', 'height': 1151, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23BERGVALL-GALLERY3/23BERGVALL-GALLERY3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/23/arts/23BERGVALL-GALLERY3/23BERGVALL-GALLERY3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url':