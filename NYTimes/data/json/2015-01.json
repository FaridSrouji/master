ry/RFDJury-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': "When a Local Jury Won't Do", 'kicker': 'Room for Debate', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-01-08T01:31:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8dc54192-a6d5-58d6-8683-b77295b0519e', 'word_count': 0, 'uri': 'nyt://article/8dc54192-a6d5-58d6-8683-b77295b0519e'}, {'abstract': 'Rather than play defense, financial services firms are taking time to engage engaging their rivals, as disruptive businesses are being taken more seriously.', 'web_url': 'https://dealbook.nytimes.com/2015/01/07/challenged-by-upstarts-lenders-try-new-strategy-cooperation/', 'snippet': 'Rather than play defense, financial services firms are taking time to engage engaging their rivals, as disruptive businesses are being taken more seriously.', 'lead_paragraph': 'Employees at MasterCard thought they saw a drop-off in credit card volume last spring at one of their merchants, a legal services provider. Checking further, they found they had a new competitor, Behalf, a start-up small-business lender backed by two venture capital firms that makes credit decisions in just a few seconds.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/08/business/08INCUMBENTS1/08INCUMBENTS1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/08/business/08INCUMBENTS1/08INCUMBENTS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/08/busine