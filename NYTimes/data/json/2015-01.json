: None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25drink/25drink-articleLarge-v2.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/25/magazine/25drink/25drink-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25drink/25drink-jumbo-v2.jpg', 'height': 648, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25drink/25drink-superJumbo-v2.jpg', 'height': 1246, 'width': 1969, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25drink/25drink-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/25/magazine/25drink/25drink-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25drink/25drink-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The New Orleans Variations', 'kicker': 'Drink', 'content_kicker': None, 'print_headline': 'The New Orleans Variations', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schaap, Rosie', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cocktails', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New Orleans (La)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Thanksgiving Day', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Whiskey', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-23T15:30:16+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Rosie Schaap', 'person': [{'firstname': 'Rosie', 'middlename': None, 'lastname': 'Schaap', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9686d961-f0eb-591a-a9b1-77ba388f6e13', 'word_count': 491, 'uri': 'nyt://article/9686d961-f0eb-591a-a9b1-77ba388f6e13'}, {'abstract': 'An inquiry into the psyche of a mass-handshaking, fingernail-growing, motorcycle-pyramid-building nation.', 'web_url': 'https://www.nytimes.com/2015/01/25/magazine/why-is-india-so-crazy-for-world-records.html', 'snippet': 'An inquiry into the psyche of a mass-handshaking, fingernail-growing, motorcycle-pyramid-building nation.', 'lead_paragraph': 'The first time Nikhil Shukla adjudicated a Guinness world record, two million people turned up. Standing on a makeshift dais just before dawn in January 2012, Shukla gazed with bleary, incredulous eyes; he was 28, and he had never seen such a mammoth crowd in his life. Tolls on the national highway from the nearest city, Rajkot, had been suspended to accommodate the traffic, and Shukla had to trudge 20 minutes from his V.I.P. parking spot, squeezing through dense thickets of bodies, to approach the stage. The throng that gathered in this patch of dusty farmland in western India to watch the event came from villages and towns across the district. They had responded to a call from a Gujarati community organization that, with a vague aim of promoting public harmony, wanted people to pair off and shake hands with one another, setting a world record for the most simultaneous handshakes.', 'print_section': 'MM', 'print_page': '43', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25guinness1/25guinness1-articleLarge-v3.jpg', 'height': 335, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/25/magazine/25guinness1/25guinness1-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 335}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25guinness1/25guinness1-jumbo-v3.jpg', 'height': 571, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25guinness1/25guinness1-superJumbo-v3.jpg', 'height': 1142, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25guinness1/25mag-25guinness.t_CA2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/25/magazine/25guinness1/25mag-25guinness.t_CA2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/25/magazine/25guinness1/25mag-25guinness.t_CA2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Is India So Crazy for World Records?', 'kicker': None, 'content_kicker': None, 'print_headline': 'We’re No. 1', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sabramanian, Samanth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Guinness World Records (Book)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Records and Achievements', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shukla, Nikhil', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Public Relations and Publicity', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-01-23T15:30:17+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Samanth Subramanian', 'person': [{'firstname': 'Samanth', 'middlename': None, 'lastname': 'Subramanian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/69302fbd-9017-5ecb-9474-9d6fe657c02a', 'word_count': 3949, 'uri': 'nyt://article/69302fbd-9017-5ecb-9474-9d6fe657c02a'}, {'abstract': 'In the same spot that “Whiplash” electrified last year, the first-night film is received tepidly.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2015/01/23/sundance-2015-the-bronze-does-not-exactly-wow-on-opening-night/', 'snippet': 'In the same spot that “Whiplash” electrified last year, the first-night film is received tepidly.', 'lead_paragraph': 'PARK CITY, Utah – John Cooper, Sundance’s director, was trying to introduce “The Bronze,” this year’s big opening-night feature, but members of the Eccles Theater audience were not done chatting. He finally stopped to shush them. But this crowd was not in a cooperative mood – right down to the reception of the film.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/the-bronze/the-bronze-articleLarge.jpg', 'height': 340, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/23/arts/the-bronze/the-bronze-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 340}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/the-bronze/the-bronze-jumbo.jpg', 'height': 580, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/the-bronze/the-bronze-superJumbo.jpg', 'height': 1050, 'width': 1853, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/the-bronze/the-bronze-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/23/arts/the-bronze/the-bronze-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/the-bronze/the-bronze-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sundance 2015: ‘The Bronze’ Does Not Exactly Wow on Opening Night', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sundance Film Festival (Park City, Utah)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Buckley, Bryan', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, John', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Park City (Utah)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-23T15:30:18+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/205e3187-8f29-578c-b5bb-386ca3f8e672', 'word_count': 359, 'uri': 'nyt://article/205e3187-8f29-578c-b5bb-386ca3f8e672'}, {'abstract': 'Announcing six winners and six runners-up in our December 2014 contest. Thank you teachers and students!', 'web_url': 'https://learning.blogs.nytimes.com/2015/01/23/student-contest-winners-the-2014-year-in-rap/', 'snippet': 'Announcing six winners and six runners-up in our December 2014 contest. Thank you teachers and students!', 'lead_paragraph': 'In December, we invited students to write raps about the very busy news year that was 2014, and we weren’t at all surprised when nearly every entry mentioned Ferguson, Eric Garner, Tamir Rice or the related protests that roiled the nation from August on. Not only did these events hit close to home for many teenagers, but the hip-hop community at large has been engaged from the very beginning. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/23/us/PROTEST2-LN-copy/PROTEST-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/23/us/PROTEST2-LN-copy/PROTEST-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/23/us/PROTEST2-LN-copy/PROTEST-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/23/us/PROTEST2-LN-copy/PROTEST-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08