change', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-01-23T12:21:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Sydney Ember', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Ember', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e2254c23-b6ad-5c33-8b9f-c5c588883f40', 'word_count': 1866, 'uri': 'nyt://article/e2254c23-b6ad-5c33-8b9f-c5c588883f40'}, {'abstract': 'The production, which has had huge success at the box office on Broadway, will open at the Theater Royal Haymarket in the West End in May.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/01/23/bradley-cooper-to-take-the-elephant-man-to-london-stage/', 'snippet': 'The production, which has had huge success at the box office on Broadway, will open at the Theater Royal Haymarket in the West End in May.', 'lead_paragraph': 'LONDON — The Broadway revival of “The Elephant Man,” starring Bradley Cooper, will travel to London in May, the play’s producers announced on Friday.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bradley Cooper to Take ‘The Elephant Man’ to London Stage', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'u2018Elephant Manu2019 Heading to London', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clarkson, Patricia', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, Bradley', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ellis, Scott', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Merrick, Joseph Carey (1862-90)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Niv