ds': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Protection', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'United Airlines', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-01-15T23:00:41+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Rachel Lee Harris', 'person': [{'firstname': 'Rachel', 'middlename': 'Lee', 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed2ba24b-4980-5a0d-a858-b93d56f294e5', 'word_count': 384, 'uri': 'nyt://article/ed2ba24b-4980-5a0d-a858-b93d56f294e5'}, {'abstract': 'This android-on-the-loose caper with Bruce Willis and Thomas Jane has more bullets than brains.', 'web_url': 'https://www.nytimes.com/2015/01/16/movies/vice-a-sci-fi-thriller-that-lacks-thrills.html', 'snippet': 'This android-on-the-loose caper with Bruce Willis and Thomas Jane has more bullets than brains.', 'lead_paragraph': 'Evidencing more bullets than brains, “Vice” — a bit of ephemeral science-fiction twaddle directed by Brian A. Miller — has absolutely nothing to recommend it. Not Bruce Willis, who navigates his few scenes as if fortified by megadoses of Ambien. Not Yaron Levy’s brittle cinematography, so devoid of richness and texture that even the actors not playing robots seem drained of life. And certainly not the plot, a thin and repetitive android-on-the-loose caper that might have been concocted by a precocious middle-schooler.', 'print_section': 'C', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16VICE/16VICE-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/16/arts/16VICE/16VICE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16VICE/16VICE-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16VICE/16VICE-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16VICE/16VICE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/16/arts/16VICE/16VICE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/arts/16VICE/16VICE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Vice,’ a Sci-Fi Thriller That Lacks Thrills', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Vice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Miller, Brian A', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Vice (Movie)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-15T23:01:13+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'titl