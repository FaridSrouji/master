d/MERKEL/MERKEL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/01/world/MERKEL/MERKEL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Euro and Immigration Promise Challenges for Merkel in 2015 ', 'kicker': 'Memo From Berlin', 'content_kicker': None, 'print_headline': 'Euro and Immigration Promise Challenges for Merkel in 2015', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Germany', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Greece', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-01-01T01:56:30+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Alison Smale', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Smale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0cb0fb24-82b0-5054-aab9-fdde45136134', 'word_count': 1057, 'uri': 'nyt://article/0cb0fb24-82b0-5054-aab9-fdde45136134'}, {'abstract': 'A new job title — chief of laboratory safety — will be created at the Centers for Disease Control and Prevention, the agency announced Wednesday.', 'web_url': 'https://www.nytimes.com/2015/01/01/health/new-cdc-job-overseeing-laboratory-safety-.html', 'snippet': 'A new job title — chief of laboratory safety — will be created at the Centers for Disease Control and Prevention, the agency announced Wednesday.', 'lead_paragraph': "A new job title — chief of laboratory safety — will be created at the Centers for Disease Control and Prevention, the agency said Wednesday. The move follows a series of lab accidents, the most recent of which may have exposed a scientist to the Ebola virus. Applicants are being recruited, and a spokeswoman said that whoever filled the post would report directly to the C.D.C.'s director, currently Dr. Thomas R. Frieden. Each of the agency’s divisions had handled lab safety separately. In the past year, different high-security C.D.C. labs shipped out samples of anthrax, H5N1 bird flu and Ebola that had not been properly killed. Thus far, there have been no injuries and no spread of the pathogens, but the agency’s procedures have been heavily criticized as sloppy.", 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New C.D.C. Job Overseeing Laboratory Safety ', 'kicker': 'National Briefing | Science', 'content_kicker': None, 'print_headline': 'New C.D.C. Job Overseeing Laboratory Safety ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McNeil, Donald G Jr', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Centers for Disease Control and Prevention', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Ebola Virus', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Laboratories and Scientific Equipment', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Frieden, Thomas R', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Accidents and Safety', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-01T01:57:38+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Health', 'byline': {'original': 'By Donald G. McNeil Jr', 'person': [{'firstname': 'Donald', 'middlename': 'G.', 'lastname': 'McNeil', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/67a3e824-5780-5079-9152-e9d57630993f', 'word_count': 129, 'uri': 'nyt://article/67a3e824-5780-5079-9152-e9d57630993f'}, {'abstract': 'Lawyers for Dzhokhar Tsarnaev, the defendant in the 2013 Boston Marathon bombings, made a last-ditch effort late Wednesday to move the trial out of Boston.', 'web_url': 'https://www.nytimes.com/2015/01/01/us/massachusetts-new-effort-to-move-bombings-trial.html', 'snippet': 'Lawyers for Dzhokhar Tsarnaev, the defendant in the 2013 Boston Marathon bombings, made a last-ditch effort late Wednesday to move the trial out of Boston.', 'lead_paragraph': 'Lawyers for Dzhokhar Tsarnaev, the defendant in the 2013 Boston Marathon bombings, made a last-ditch effort late Wednesday to move the trial out of Boston. In a 32-page filing, they asked a federal appeals court to grant a change of venue, or at a minimum to order the trial judge, George A. O’Toole Jr., to hold a hearing on moving the trial. They also asked Judge O’Toole to delay the start of jury selection, which is scheduled for Monday, while the appeals court considers its request. Judge O’Toole has twice denied the request, most recently earlier Wednesday, saying the jury selection process could find impartial jurors. But Mr. Tsarnaev’s lawyers insisted that would be impossible, arguing that virtually everyone in the Boston region has a connection to the marathon and is, “in effect, an actual victim.” Government prosecutors have until 5 p.m. Thursday to respond. ', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Massachusetts: New Effort to Move Bombings Trial', 'kicker': 'National Briefing | New England', 'content_kicker': None, 'print_headline': 'Massachusetts: New Effort to Move Bombings Trial', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Boston Marathon Bombings (2013)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Tsarnaev, Dzhokhar A', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Boston (Mass)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-01-01T01:59:29+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Katharine Q. Seelye', 'person': [{'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/9aa25e12-a19e-5317-bd29-72e701baa2ac', 'word_count': 145, 'uri': 'nyt://article/9aa25e12-a19e-5317-bd29-72e701baa2ac'}, {'abstract': 'Mr. Ben-Israel, a former metal worker from Chicago, became known as a holy father to members of the African Hebrew Israelites of Jerusalem.', 'web_url': 'https://www.nytimes.com/2015/01/01/world/middleeast/ben-ammi-ben-israel-leader-of-black-americans-who-migrated-to-israel-dies-at-75.html', 'snippet': 'Mr. Ben-Israel, a former metal worker from Chicago, became known as a holy father to members of the African Hebrew Israelites of Jerusalem.', 'lead_paragraph': 'Ben Ammi Ben-Israel, a former Chicago metal worker who led a migration of hundreds of fellow black Americans to what they consider their ancestral homeland, Israel, died on Saturday in a hospital in Beersheba, Israel. He was 75.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/31/world/ISRAEL-obit/ISRAEL-obit-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/31/world/ISRAEL-obit/ISRAEL-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/31/world/ISRAEL-obit/ISRAEL-obit-jumbo.jpg', 'height': 68