.', 'print_section': 'C', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23COMMITO-GALLERY1/23COMMITO-GALLERY1-articleLarge.jpg', 'height': 713, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/01/23/arts/23COMMITO-GALLERY1/23COMMITO-GALLERY1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 713}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23COMMITO-GALLERY1/23COMMITO-GALLERY1-jumbo.jpg', 'height': 1024, 'width': 863, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23COMMITO-GALLERY1/23COMMITO-GALLERY1-superJumbo.jpg', 'height': 1683, 'width': 1417, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23COMMITO-GALLERY1/23COMMITO-GALLERY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/23/arts/23COMMITO-GALLERY1/23COMMITO-GALLERY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/23/arts/23COMMITO-GALLERY1/23COMMITO-GALLERY1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gianna Commito', 'kicker': 'Art in Review', 'content_kicker': None, 'print_headline': 'Gianna Commito', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Commito, Gianna', 'rank': 3, 'major': 'N