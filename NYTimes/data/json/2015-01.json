: None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cats', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Meow Parlour (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ha, Christina', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Legrand, Emilie', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-01-15T15:48:36+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'New York', 'byline': {'original': 'By William Grimes', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Grimes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b88a4554-469c-53a5-860a-d9c934dc3be3', 'word_count': 1301, 'uri': 'nyt://article/b88a4554-469c-53a5-860a-d9c934dc3be3'}, {'abstract': 'From the International Herald Tribune archives: Robert Montgomery visits France between shoots of an anti-Nazi film in 1940.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/01/15/1940-montgomerys-anti-nazi-film/', 'snippet': 'From the International Herald Tribune archives: Robert Montgomery visits France between shoots of an anti-Nazi film in 1940.', 'lead_paragraph': 'Wearing one of the only American raccoon coats extant, either off or on a college campus, Robert Montgomery, Hollywood’s sardonic but smiling screen star, and the first to arrive in the European war zone since hostilities began, is now visiting Paris for a few days, prior to returning to England to resume motion-picture work. The first screen shooting for the star at the Denham studios will be a film story of the life of Pastor Martin Niemoeller, the fighting German clergyman and former submarine commander, who is now in a concentration camp for opposing the Nazi regime. — New York Herald Tribune, European Edition, Jan. 16, 1940', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/blogs/16iht-oldjan16-montgomery/16iht-oldjan16-montgomery-jumbo.png', 'height': 577, 'width': 332, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/blogs/16iht-oldjan16-montgomery/16iht-oldjan16-montgomery-superJumbo.png', 'height': 577, 'width': 332, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/blogs/16iht-oldjan16-montgomery/16iht-oldjan16-montgomery-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/01/16/blogs/16iht-oldjan16-montgomery/16iht-oldjan16-montgomery-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/01/16/blogs/16iht-oldjan16-montgomery/16iht-oldjan16-montgomery-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1940: Montgomery’s Anti-Nazi Film', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-01-15T15:52:19+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': Non