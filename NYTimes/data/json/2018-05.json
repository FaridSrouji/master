ports/06derby-top/06derby-top-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Justify Wins Kentucky Derby, Conquering Rain, Mud and a 136-Year Curse', 'kicker': None, 'content_kicker': None, 'print_headline': 'Justifying the Hype', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Horse Racing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Triple Crown (Horse Racing)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kentucky Derby', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Churchill Downs Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Justify (Race Horse)', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-05-05T19:33:51+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Melissa Hoppert', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Hoppert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6800e79e-b131-5485-bf93-316b8cc710ff', 'word_count': 1088, 'uri': 'nyt://article/6800e79e-b131-5485-bf93-316b8cc710ff'}, {'abstract': 'A Connecticut Supreme Court ruling that vacated Michael Skakel’s conviction in the 1975 killing was the latest twist in a case that has been “like a yo-yo” for her family.', 'web_url': 'https://www.nytimes.com/2018/05/05/nyregion/martha-moxley-murder-case.html', 'snippet': 'A Connecticut Supreme Court ruling that vacated Michael Skakel’s conviction in the 1975 killing was the latest twist in a case that has been “like a yo-yo” for her family.', 'lead_paragraph': 'Dorthy Moxley had tears in her eyes as she hugged her son, John, in the courtroom. More than 25 years after her daughter Martha had been beaten to death, a jury had found a man guilty of killing her. She told an interviewer that the day had felt like a dream and she feared she would wake up. John later said that the verdict came as long-awaited relief; he was “just glad it was done.”', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/nyregion/06SKAKEL/merlin_137732598_52cd4b5b-aaf8-4304-81c5-24e324bfd6bb-articleLarge.jpg', 'height': 427, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/06/nyregion/06SKAKEL/merlin_137732598_52cd4b5b-aaf8-4304-81c5-24e324bfd6bb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 427}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/nyregion/06SKAKEL/merlin_137732598_52cd4b5b-aaf8-4304-81c5-24e324bfd6bb-jumbo.jpg', 'height': 728, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/nyregion/06SKAKEL/merlin_137732598_52cd4b5b-aaf8-4304-81c5-24e324bfd6bb-superJumbo.jpg', 'height': 1456, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/nyregion/06SKAKEL/06SKAKEL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/06/nyregion/06SKAKEL/06SKAKEL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/06/nyregion/06SKAKEL/06SKAKEL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Four Decades After Martha Moxley’s Murder, Her Mother Says ‘It’s 