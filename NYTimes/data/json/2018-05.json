riginal': 'By Jesse McKinley', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'McKinley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24054fef-d065-5a63-a3fe-c83c09fe2cb0', 'word_count': 945, 'uri': 'nyt://article/24054fef-d065-5a63-a3fe-c83c09fe2cb0'}, {'abstract': 'A top golfer in the 1950s who had honed his game in the Bronx, he won at Augusta in 1957 after taking the P.G.A. Championship two years earlier.', 'web_url': 'https://www.nytimes.com/2018/05/15/obituaries/doug-ford-oldest-masters-champion-dies-at-95.html', 'snippet': 'A top golfer in the 1950s who had honed his game in the Bronx, he won at Augusta in 1957 after taking the P.G.A. Championship two years earlier.', 'lead_paragraph': 'Doug Ford, who honed his golfing skills on a public course in the Bronx and went on to win the P.G.A. Championship and the Masters as a leading tour player of the 1950s, died on Monday in Palm Beach Gardens, Fla. He was 95 and the oldest surviving Masters champion.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/17/obituaries/17ford1-print/16ford1-articleLarge.jpg', 'height': 497, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/17/obituaries/17ford1-print/16ford1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 497}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/17/obituaries/17ford1-print/16ford1-jumbo.jpg', 'height': 849, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/17/obituaries/17ford1-print/16ford1-superJumbo.jpg', 'height': 1697, 'width': 20