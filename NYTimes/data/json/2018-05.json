'}, {'name': 'creative_works', 'value': 'Solo: A Star Wars Story (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ehrenreich, Alden', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Howard, Ron', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Glover, Donald', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-05-24T23:00:10+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephanie Goodman', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'Goodman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6ba7b6b4-2f50-5894-a7b2-c9d3fe31d7e4', 'word_count': 783, 'uri': 'nyt://article/6ba7b6b4-2f50-5894-a7b2-c9d3fe31d7e4'}, {'abstract': 'The only woman on the president’s senior staff, she courted the religious right in helping to build a Reagan coalition and alienated feminists.', 'web_url': 'https://www.nytimes.com/2018/05/24/obituaries/faith-whittlesey-conservative-voice-and-reagan-aide-dies-at-79.html', 'snippet': 'The only woman on the president’s senior staff, she courted the religious right in helping to build a Reagan coalition and alienated feminists.', 'lead_paragraph': 'Faith Whittlesey, who was the highest-ranking woman on the Reagan White House staff during her time there and who helped lay the foundation for the religious right’s enduring allegiance to the Republican Party, died on May 21 at her home in Washington. She was 79.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/28/obituaries/25WHITTLESEY-OBIT1/merlin_138617709_73e66465-f5db-4387-8d03-2310816d9f49-articleLarge.jpg', 'height': 899, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/28/ob