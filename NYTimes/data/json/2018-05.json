ess/00envion/merlin_138848832_5082a270-a412-4cd6-9acb-781613b9c7e4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/business/00envion/merlin_138848832_5082a270-a412-4cd6-9acb-781613b9c7e4-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/business/00envion/merlin_138848832_5082a270-a412-4cd6-9acb-781613b9c7e4-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/business/00envion/00envion-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/30/business/00envion/00envion-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/business/00envion/00envion-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In the World of Cryptocurrency, Even Good Projects Can Go Bad', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cryptocurrency Sinks Start-Up, And Investors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Envion AG', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Virtual Currency', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bitcoin (Currency)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Start-ups', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-05-31T15:24:45+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Nathaniel Popper', 'person': [{'firstname': 'Nathaniel', 'middlename': None, 'lastname': 'Popper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1215b6d2-8644-5f45-8ec0-970f13874dee', 'word_count': 1164, 'uri': 'nyt://article/1215b6d2-8644-5f45-8ec0-970f13874dee'}, {'abstract': 'Suggested reading from critics and editors at The New York Times.', 'web_url': 'https://www.nytimes.com/2018/05/31/books/review/10-new-books-we-recommend-this-week.html', 'snippet': 'Suggested reading from critics and editors at The New York Times.', 'lead_paragraph': 'Americans love to eat foreign food, and hate to read foreign books. That’s the perception in publishing circles, anyway, and if there are obvious exceptions — I’m looking at you, Paulo Coelho — it’s still the case that even adventurous readers in this country aren’t always sure where to start once they reach the border. We’re here to help. Three of this week’s recommended titles are European novels: “Mirror, Shoulder, Signal,” by the Danish writer Dorthe Nors, “All for Nothing,” by the German writer Walter Kempowski, and “Kudos,” the conclusion of an exceptional trilogy by the British writer Rachel Cusk. Staying in the realm of foreign affairs, you might pick up Ronan Farrow’s “War on Peace,” about the decline of the United States diplomatic corps. And for people in this country or elsewhere who prefer to read about America and its ways, we have books (fiction and non) about Appalachia and Southern California, capitalism, criminal justice and more.', 'print_section': 'BR', 'print_page': '63', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/books/review/03ed-covers/03ed-covers-articleLarge.jpg', 'height': 308, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/06/03/books/review/03ed-covers/03ed-covers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 308}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/books/review/03ed-covers/03ed-covers-jumbo.jpg', 'height': 513, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/books/review/03ed-covers/03ed-covers-superJumbo.jpg', 'height': 513, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/books/review/03ed-covers/03ed-covers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/06/03/books/review/03ed-covers/03ed-covers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/books/review/03ed-covers/03ed-covers-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '10 New Books We Recommend This Week', 'kicker': 'Editors’ Choice', 'content_kicker': None, 'print_headline': 'Editors’ Choice / Staff Picks From the Book Review', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2018-05-31T15:28:37+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/d8d7a834-0295-5b84-a6e4-5171212b8bab', 'word_count': 1172, 'uri': 'nyt://article/d8d7a834-0295-5b84-a6e4-5171212b8bab'}, {'abstract': 'President Trump and his aides have offered a number of reasons — including relief from the investigation into Russian election meddling — for why he fired James B. Comey, the former F.B.I. director. ', 'web_url': 'https://www.nytimes.com/2018/05/31/us/politics/fact-check-trump-fire-comey-russia.html', 'snippet': 'President Trump and his aides have offered a number of reasons — including relief from the investigation into Russian election meddling — for why he fired James B. Comey, the former F.B.I. director. ', 'lead_paragraph': 'Mr. Trump and his aides have given a number of conflicting reasons — sometimes within hours of each other or even in the same interview — for why he fired Mr. Comey from his position as F.B.I. director on May 9, 2017. At the time, Mr. Comey was leading the investigation into whether Mr. Trump’s 2016 presidential campaign had coordinated with Russian election meddling.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/01/us/politics/01dc-fastfact/merlin_138012294_587ad686-7032-4a09-b99d-805e41c53118-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/06/01/us/politics/01dc-fastfact/merlin_138012294_587ad686-7032-4a09-b99d-805e41c53118-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/01/us/politics/01dc-fastfact/merlin_138012294_587ad686-7032-4a09-b99d-805e41c53118-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/01/us/politics/01dc-fastfact/merlin_138012294_587ad686-7032-4a09-b99d-805e41c53118-superJumbo.jpg', 'height': 136