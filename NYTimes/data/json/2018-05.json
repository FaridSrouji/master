es', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/03/opinion/20-opdoc-cruise-img/20-opdoc-cruise-img-articleLarge-v2.jpg', 'height': 249, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/03/opinion/20-opdoc-cruise-img/20-opdoc-cruise-img-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 249}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/03/opinion/20-opdoc-cruise-img/20-opdoc-cruise-img-jumbo-v2.jpg', 'height': 426, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/03/opinion/20-opdoc-cruise-img/20-opdoc-cruise-img-superJumbo-v2.jpg', 'height': 798, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/03/opinion/20-opdoc-cruise-img/20-opdoc-cruise-img-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/03/opinion/20-opdoc-cruise-img/20-opdoc-cruise-img-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/03/opinion/20-opdoc-cruise-img/20-opdoc-cruise-img-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Happiest Guy in the World', 'kicker': 'Op-Docs', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cruises', 'rank': 2, 'major': 'N'}, {'name': '