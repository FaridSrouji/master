'abstract': 'Corrections appearing in print on Tuesday, May 15, 2018.', 'web_url': 'https://www.nytimes.com/2018/05/14/pageoneplus/corrections-may-15-2018.html', 'snippet': 'Corrections appearing in print on Tuesday, May 15, 2018.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: May 15, 2018', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-05-15T01:52:22+0000', 'document_type': 'article', 'news_desk': 'Corrections', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/17fb0969-a165-5a18-93cd-76b39b5b7431', 'word_count': 589, 'uri': 'nyt://article/17fb0969-a165-5a18-93cd-76b39b5b7431'}, {'abstract': 'The Pulitzer Prize-winning cartoonist Garry Trudeau and his son, the New York Times crossword constructor Ross Trudeau, team up to play with our heads.', 'web_url': 'https://www.nytimes.com/2018/05/14/crosswords/daily-puzzle-2018-05-15.html', 'snippet': 'The Pulitzer Prize-winning cartoonist Garry Trudeau and his son, the New York Times crossword constructor Ross Trudeau, team up to play with our heads.', 'lead_paragraph': 'If you are very lucky, you might work at a job that encourages play. I get to solve puzzles for a living, for example, which makes me very lucky indeed. Some people get to pretend they are other people, like actors, or they might be able to spend their days drawing, like our celebrity constructor has been known to do.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/15/crosswords/15wordplay-dj/merlin_133558236_b7f28cb3-11fb-45be-b72e-c9ba12567765-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge',