sub': None}, 'keywords': [{'name': 'subject', 'value': 'Food Trucks and Vendors', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Viajeros (Manhattan, NY, Restaurant)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Turnstyle (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-05-29T15:57:40+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/60d35a08-7fb6-5032-8e5b-3aed64e4955e', 'word_count': 137, 'uri': 'nyt://article/60d35a08-7fb6-5032-8e5b-3aed64e4955e'}, {'abstract': 'The latest resurfacing toners aim to clean your pores and calm your skin at the same time.', 'web_url': 'https://www.nytimes.com/2018/05/29/t-magazine/how-to-exfoliate-toners.html', 'snippet': 'The latest resurfacing toners aim to clean your pores and calm your skin at the same time.', 'lead_paragraph': 'Few beauty practices are embraced as enthusiastically as exfoliation — dermatologists have long said that a good polishing can banish dullness, clean pores and reveal fresh, glowing skin in a matter of minutes. It’s a deeply satisfying ritual. And yet, it’s easy to get carried away. Buffing too often with abrasive scrubs, sponges and facial brushes can obliterate everything — dead skin cells, yes, but also healthy oils and enzymes — leading to inflammation, redness, irritation and even “profound hyperpigmentation,” especially on darker skin tones, says Sumayah Jamal, M.D., of Schweiger Dermatology Group in New York City.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': N