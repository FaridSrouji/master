ued vomit.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/19/books/19graduationbooks-print/graduationchast1-articleLarge.jpg', 'height': 761, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/19/books/19graduationbooks-print/graduationchast1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 761}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/19/books/19graduationbooks-print/graduationchast1-jumbo.jpg', 'height': 1024, 'width': 807, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/19/books/19graduationbooks-print/graduationchast1-superJumbo.jpg', 'height': 2048, 'width': 1614, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/19/books/19graduationbooks-print/graduationchast1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/19/books/19graduationbooks-print/graduationchast1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/19/books/19graduationbooks-print/graduationchast1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Assume the Worst’: This Isn’t Your Ordinary Graduation Speech', 'kicker': 'Reader’s Notebook', 'content_kicker': None, 'print_headline': 'Seize the Day — Some Other Time', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject'