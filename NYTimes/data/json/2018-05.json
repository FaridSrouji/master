: 'nyt://article/416645fc-d4a4-57d0-9f6a-410a8ea3530a'}, {'abstract': 'Even the New York Times climate team is getting in on the royal wedding coverage.', 'web_url': 'https://www.nytimes.com/2018/05/23/climate/harry-meghan-jaguar-electric.html', 'snippet': 'Even the New York Times climate team is getting in on the royal wedding coverage.', 'lead_paragraph': 'Welcome to the Climate Fwd: newsletter. The New York Times climate team emails readers once a week with stories and insights about climate change. Sign up here to get it in your inbox.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/climate/24CLI-NEWSLETTER-promo/merlin_138407751_19495a30-09d2-4bf9-908c-7c2e1b1ce20b-articleLarge.jpg', 'height': 408, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/24/climate/24CLI-NEWSLETTER-promo/merlin_138407751_19495a30-09d2-4bf9-908c-7c2e1b1ce20b-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 408}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/climate/24CLI-NEWSLETTER-promo/merlin_138407751_19495a30-09d2-4bf9-908c-7c2e1b1ce20b-jumbo.jpg', 'height': 696, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/climate/24CLI-NEWSLETTER-promo/merlin_138407751_19495a30-09d2-4bf9-908c-7c2e1b1ce20b-superJumbo.jpg', 'height': 1392, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/climate/24CLI-NEWSLETTER-promo/24CLI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/24/climate/24CLI-NEWSLETTER-pro