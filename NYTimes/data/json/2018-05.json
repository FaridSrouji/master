/05/21/opinion/21lianCOLOR/21lianCOLOR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/21/opinion/21lianCOLOR/21lianCOLOR-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/21/opinion/21lianCOLOR/21lianCOLOR-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/21/opinion/21lianCOLOR/21lianCOLOR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/21/opinion/21lianCOLOR/21lianCOLOR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/21/opinion/21lianCOLOR/21lianCOLOR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'China Has a Vast Influence Machine, and You Don’t Even Know It', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Chinese-Americans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Foreign Students (in US)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Chinese People's Political Consultative Conference", 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Confucius Institutes', 'rank': 6, 'major': 'N'