rganizations', 'value': 'AMERICAN AUTOMOBILE ASSN', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Transportation Alternatives', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Zipcar Inc', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington Heights (Manhattan, NY)', 'rank': 11, 'major': 'N'}], 'pub_date': '2018-05-31T09:00:01+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Sarah Maslin Nir', 'person': [{'firstname': 'Sarah', 'middlename': 'Maslin', 'lastname': 'Nir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1c0a3448-c303-50b0-a510-519d9eeab856', 'word_count': 1095, 'uri': 'nyt://article/1c0a3448-c303-50b0-a510-519d9eeab856'}, {'abstract': 'Selected by Terrance Hayes.', 'web_url': 'https://www.nytimes.com/2018/05/31/magazine/poem-deaths-dictionary.html', 'snippet': 'Selected by Terrance Hayes.', 'lead_paragraph': 'A title can provide wondrous context for a poem. This title, for example, could be a sly nod to “The Devil’s Dictionary,” by Ambrose Bierce. The brackets suggest a secret. We overhear someone contemplating or composing private definitions. The house reappears like a clue in a mysterious riddle. Furtive details create an off-kilter lilt. By the end, you almost forget the title’s dark whisper: Death’s dictionary is full of winks, wordplay and wicked whimsy. Selected by Terrance Hayes', 'print_section': 'MM', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/magazine/03Poem/03Poem-articleLarge.jpg', 'height': 609, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/06/03/magazine/03Poem/0