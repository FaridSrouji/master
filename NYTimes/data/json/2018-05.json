ell/well_pog_pregnancy/well_pog_pregnancy-jumbo.jpg', 'height': 512, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/24/well/well_pog_pregnancy/well_pog_pregnancy-superJumbo-v2.png', 'height': 600, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/24/well/well_pog_pregnancy/well_pog_pregnancy-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/24/well/well_pog_pregnancy/well_pog_pregnancy-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/24/well/well_pog_pregnancy/well_pog_pregnancy-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Breast-Feeding Has No Impact on I.Q. by Age 16', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tracking Intelligence: Breast-Feeding and I.Q.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Breastfeeding', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Intelligence and Intelligence Tests (IQ)', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-05-09T19:19:38+0000', 'document_type': 'article', 'news_desk': 'Well', 'section_name': 'Well', 'subsection_name': 'Family', 'byline': {'original': 'By Nicholas Bakalar', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Bakalar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e61f2e8f-e4d4-580c-8899-04ee1f207769', 'word_count': 215, 'uri': 'nyt://article/e61f2e8f-e4d4-580c-8899-04ee1f207769'}, {'abstract': 'Professional women are often told that consuming alcohol is a problem. And yet the men seem to be causing all the trouble.', 'web_url': 'https://www.nytimes.com/2018/05/09/nyregion/eric-schneiderman-domestic-violence-alcohol-abuse.html', 'snippet': 'Professional women are often told that consuming alcohol is a problem. And yet the men seem to be causing all the trouble.', 'lead_paragraph': 'A few days ago, while searching online for a clip from a recent episode of “Saturday Night Live,’’ I came upon an ad that, for the first time in my history of using YouTube as a procrastination device, compelled me to keep watching. In it, a woman in a sleeveless fuchsia dress, with a disposition that suggests she has never been confounded by a teleconferencing system, looks into the camera and wonders if anyone watching — by which she means anyone female — has ever gone out with the intention of having one or two glasses of wine but instead ended up having a third or fourth and regretting it.', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/13/nyregion/13BIG/13BIG-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/13/nyregion/13BIG/13BIG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/13/nyregion/13BIG/13BIG-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/13/nyregion/13BIG/13BIG-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/13/nyregion/13BIG/13BIG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/13/nyregion/13BIG/13BIG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/13/nyregion/13BIG/13BIG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Schneiderman’s Downfall Puts a Spotlight on Men, Alcohol and Violence', 'kicker': 'Big City', 'content_kicker': None, 'print_headline': 'First the Drinks,  Then the Hitting', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Domestic Violence', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Alcohol Abuse', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New Yorker', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Schneiderman, Eric T', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-05-09T19:20:31+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a84be044-6462-5056-87d1-e2e3df4dbe84', 'word_count': 899, 'uri': 'nyt://article/a84be044-6462-5056-87d1-e2e3df4dbe84'}, {'abstract': 'The rising brands Palomo Spain, Dilara Findikoglu and Vaquera all draw inspiration from Catholicism — but you won’t see their designs in the new Met Costume Institute show.', 'web_url': 'https://www.nytimes.com/2018/05/09/t-magazine/fashion/catholic-designers-palomo-spain-dilara-findikoglu-vaquera.html', 'snippet': 'The rising brands Palomo Spain, Dilara Findikoglu and Vaquera all draw inspiration from Catholicism — but you won’t see their designs in the new Met Costume Institute show.', 'lead_paragraph': 'When the Metropolitan Costume Institute’s new exhibition “Heavenly Bodies: Fashion and the Catholic Imagination” opens to the public tomorrow, visitors will see over 40 vestments on loan, for the first time, from the Vatican. Also on display will be an array of divine, in a less literal sense, garments by modern fashion designers — among them, a monastic genital-revealing Rick Owens tunic, a winged Dior haute couture wedding gown and a Cristóbal Balenciaga evening coat that resembles a 16th-century cardinal’s cape — all informed by the visual traditions of Catholicism. While the show is the Costume Institute’s largest to date, in terms of square footage, its contents represent just a fraction of the collections that have drawn inspiration from the church. Here, the next generation of designers exploring the Catholic imagination.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/09/t-magazine/09tmag-catholic-designers-slide-9KIL/09tmag-catholic-designers-slide-9KIL-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/09/t-magazine/09tmag-catholic-designers-slide-9KIL/09tmag-catholic-designers-slide-9KIL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/09/t-magazine/09tmag-catholic-designers-slide-9KIL/09tmag-catholic-designers-slide-9KIL-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/09/t-magazine/09tmag-catholic-designers-slide-9KIL/09tmag-catholic-designers-slide-9KIL-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/09/t-magazine/09tmag-catholic-designers-slide-9KIL/09tmag-catholic-designers-slide-9KIL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/09/t-magazine/09tmag-catholic-designers-slide-9KIL/09tmag-catholic-designers-slide-9KIL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/09/t-magazine/09tmag-catholic-designers-slide-9KIL/09tmag-catholic-designers-slide-9KIL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Meet the Young Designers Making Catholic-Inspired Fashion', 'kicker': None, 'content_kicker': None, 'print_headline': 'On the Verge; Catholic Taste', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Crosses and Crucifixes', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Costume Institute', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Vaquera (Fashion Label)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Palomo Spain (Fashion Label)', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-05-09T19:23:18+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': 'By Al