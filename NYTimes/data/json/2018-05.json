c-8cad-c2f69fa08076', 'word_count': 817, 'uri': 'nyt://article/e5f34991-f1b4-5e9c-8cad-c2f69fa08076'}, {'abstract': 'A new wave of refugees — this time from neighboring countries — has flooded a country where scars from decades of internal conflict are still raw.', 'web_url': 'https://www.nytimes.com/2018/05/01/world/africa/uganda-lra-refugees.html', 'snippet': 'A new wave of refugees — this time from neighboring countries — has flooded a country where scars from decades of internal conflict are still raw.', 'lead_paragraph': 'PAICHO, Uganda — Just after dawn, Patrick Ogik placed a wooden yoke over the bulging necks of his two oxen and attached a metal plow behind them, the ropes, fraying from wear, tied to the animals.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/world/africa/xxugandafields/xxugandafields-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/26/world/africa/xxugandafields/xxugandafields-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/world/africa/xxugandafields/xxugandafields-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/world/africa/xxugandafields/xxugandafields-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/world/africa/xxugandafields/xxugandafields-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/26/world/africa/xxugandafields/xxugandafields-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/world/africa/xxugandafields/xxugandafields-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sowing Peanuts, Reaping Ammo in Uganda', 'kicker': 'Paicho Journal', 'content_kicker': None, 'print_headline': 'Sowing Peanuts but Reaping War Remnants', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Uganda', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Foreign Aid', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': "Lord's Resistance Army", 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'vis-multimedia', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-05-01T17:38:30+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Megan Specia and Kassie Bracken', 'person': [{'firstname': 'Megan', 'middlename': None, 'lastname': 'Specia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Kassie', 'middlename': None, 'lastname': 'Bracken', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cb9a7dab-c86c-563a-8149-34bd89c20967', 'word_count': 950, 'uri': 'nyt://article/cb9a7dab-c86c-563a-8149-34bd89c20967'}, {'abstract': 'The dealer Sean Kelly has launched an initiative that aims to reframe art collecting as a pursuit centered around passion — rather than investing.', 'web_url': 'https://www.nytimes.com/2018/05/01/t-magazine/art/sean-kelly-collect-wisely.html', 'snippet': 'The dealer Sean Kelly has launched an initiative that aims to reframe art collecting as a pursuit centered around passion — rather than investing.', 'lead_paragraph': 'To a casual observer, the art world probably looks like nothing more than a corporate monolith producing easy profits for auction houses, galleries and collectors, all attracted to the sale of art for its potential investment opportunities. Christie’s reported art sales totaling $6.6 billion in 2017, anchored by the sale of a $450 million Leonardo da Vinci painting — which became the most expensive artwork ever sold — even though its authenticity was questioned by scholars and critics. In March, at the Art Basel fair in Hong Kong (a trade show featuring 248 galleries from across the globe), a co-founder of Microsoft sold a Willem de Kooning painting for $35 million. Later this month, a $150 million Modigliani will go on sale at Sotheby’s in New York, a highlight of a spring auction season that Bloomberg has already predicted “is poised to be the biggest on record.” The rise of this commercial aristocracy has become something of a philosophical dilemma for many in the art world: People seem more interested in money than art itself.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/t-magazine/art/1tmag-kelly-02/1tmag-kelly-02-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/01/t-magazine/art/1tmag-kelly-02/1tmag-kelly-02-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/01/t-ma