humbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/22/obituaries/22ROUNDTREE4/22ROUNDTREE4-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/obituaries/22ROUNDTREE4/22ROUNDTREE4-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dovey Johnson Roundtree, Barrier-Breaking Lawyer, Dies at 104', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dovey Johnson Roundtree, Barrier-Breaking Lawyer And Officer, Is Dead at 104', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Roundtree, Dovey Johnson', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Legal Profession', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights Movement (1954-68)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-05-21T20:45:40+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Obituaries', 'byline': {'original': 'By Margalit Fox', 'person': [{'firstname': 'Margalit', 'middlename': None, 'lastname': 'Fox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/97e0ef4f-efd9-5353-a14c-4d73b59aae91', 'word_count': 2508, 'uri': 'nyt://article/97e0ef4f-efd9-5353-a14c-4d73b59aae91'}, {'abstract': 'While it might be tempting to proclaim that the borough is back, last weekend’s literary celebration proved it never really left. ', 'web_url': 'https://www.nytimes.com/2018/05/21/books/bronx-book-festival.html', 'snippet': 'While it might be tempting to proclaim that the borough is back, last weekend’s literary celebration proved it never really left. ', 'lead_paragraph': 'This weekend’s weather kept most New Yorkers inside. But gray clouds and a little rain did not stop bibliophiles and residents of the Bronx from attending the inaugural Bronx Book Festival in Fordham Plaza. The literary event, which took place on May 19, drew a diverse crowd, one full of adults and children eager to get their hands on a free book or hear from writers such as Elizabeth Acevedo, Daniel José Older and Arlene Alda, who all participated in panel discussions. Organized by Saraciea J. Fennell, a book publicist and South Bronx native, the festival proved a welcomed addition to a borough not often recognized for more than its poverty and baseball team. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/books/review/22BronxBooks1/merlin_138482898_9c0121ea-be54-4993-b40f-2805d1392bd3-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/22/books/review/22BronxBooks1/merlin_138482898_9c0121ea-be54-4993-b40f-2805d1392bd3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/books/review/22BronxBooks1/merlin_138482898_9c0121ea-be54-4993-b40f-2805d1392bd3-jumbo.jpg', 'height': 1024, 'width': 819, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/books/review/22BronxBooks1/merlin_138482898_9c0121ea-be54-4993-b40f-2805d1392bd3-superJumbo.jpg', 'height': 2048, 'width': 1638, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/books/review/22BronxBooks1/22BronxBooks1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/22/books/review/22BronxBooks1/22BronxBooks1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/books/review/22BronxBooks1/22BronxBooks1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Voices From the First Bronx Book Festival', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Book Fairs', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fennell, Saraciea J', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-05-21T20:45:57+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'byline': {'original': 'By Lovia Gyarkye', 'person': [{'firstname': 'Lovia', 'middlename': None, 'lastname': 'Gyarkye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7e7b3def-e585-59d9-b6fb-aab70981fd5c', 'word_count': 323, 'uri': 'nyt://article/7e7b3def-e585-59d9-b6fb-aab70981fd5c'}, {'abstract': 'The event was held at Lake Merritt, where two black men were hassled for grilling. “It was a sea of love and blackness and food and fun,” an organizer said.', 'web_url': 'https://www.nytimes.com/2018/05/21/us/oakland-bbq-while-black.html', 'snippet': 'The event was held at Lake Merritt, where two black men were hassled for grilling. “It was a sea of love and blackness and food and fun,” an organizer said.', 'lead_paragraph': 'They arrived with chicken, sausages and bowls of macaroni salad. D.J.s played hip-hop and ’80s hits. Even the fire marshal showed up, as well as police officers who waved hello to passers-by and guided traffic.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/autossell/22xp-bbq-02/merlin_138486741_c3f6526e-82db-485c-86f0-bc2cc8eae5fb-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/22/autossell/22xp-bbq-02/merlin_138486741_c3f6526e-82db-485c-86f0-bc2cc8eae5fb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/autossell/22xp-bbq-02/merlin_138486741_c3f6526e-82db-485c-86f0-bc2cc8eae5fb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/autossell/22xp-bbq-02/merlin_138486741_c3f6526e-82db-485c-86f0-bc2cc8eae5fb-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/autossell/22xp-bbq-02/22xp-bbq-02-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/22/autossell/22xp-bbq-02/22xp-bbq-02-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/22/autossell/22xp-bbq-02/22xp