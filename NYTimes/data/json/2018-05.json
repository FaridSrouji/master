: 8, 'major': 'N'}], 'pub_date': '2018-05-04T21:03:25+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Frances Robles', 'person': [{'firstname': 'Frances', 'middlename': None, 'lastname': 'Robles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c22ec3a0-af3e-5660-b9e5-d2e61061beb7', 'word_count': 1501, 'uri': 'nyt://article/c22ec3a0-af3e-5660-b9e5-d2e61061beb7'}, {'abstract': 'A by-no-means exhaustive list of the things our editors (and a few contributors) find interesting on a given week.', 'web_url': 'https://www.nytimes.com/2018/05/04/t-magazine/gucci-tote-rick-owens-barneys-editors-picks.html', 'snippet': 'A by-no-means exhaustive list of the things our editors (and a few contributors) find interesting on a given week.', 'lead_paragraph': 'The Berlin-based jewelry designer Lilian von Trapp grew up in a family of lawyers, doctors and professors, where fashion and jewelry were not much discussed. “But my two grandmothers loved jewelry,” says von Trapp, who dutifully went on to study law herself. When her mother passed away and von Trapp inherited her pieces, along with her grandmothers’ and great-grandmothers’, she decided to look for a new direction. She quit law, kept what heirlooms had emotional value, and instead of locking the rest away in a safe, she had them repurposed. With the help of a local goldsmith, she used the metal and stones to create pieces of her own design — and her namesake jewelry brand was born.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/04/t-magazine/04tmag-tel-slide-3PSP/04tmag-tel-slide-3PSP-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/04/t-magazine/04tmag-tel-slide-3PSP/04tmag-tel-slide-3PSP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/04/t-magazine/04tmag-tel-slide-3PSP/04tmag-tel-slide-3PSP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/04/t-magazine/04tmag-tel-slide-3PSP/04tmag-tel-slide-3PSP-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/04/t-magazine/04tmag-tel-slide-3PSP/04tmag-tel-slide-3PSP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/04/t-magazine/04tmag-tel-slide-3PSP/04tmag-tel-slide-3PSP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/04/t-magazine/04tmag-tel-slide-3PSP/04tmag-tel-slide-3PSP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '5 Things T Editors Like Right Now', 'kicker': 'Things editors Like', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Barneys New York', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Owens, Rick', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-05-04T21:08:22+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'origin