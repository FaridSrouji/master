, 'print_headline': 'Waxing Nostalgic As Eviction Looms', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Social Animals (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bennett, Theresa (1983- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wells, Noel', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Radnor, Josh', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Chaikin, Carly', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cash, Aya', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-05-31T11:00:01+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ad569be5-0dc2-5add-9185-841f887d813e', 'word_count': 418, 'uri': 'nyt://article/ad569be5-0dc2-5add-9185-841f887d813e'}, {'abstract': 'The documentary focuses on Vasant Lad and his claims that ayurveda can cure various ailments.', 'web_url': 'https://www.nytimes.com/2018/05/31/movies/the-doctor-from-india-review-documentary.html', 'snippet': 'The documentary focuses on Vasant Lad and his claims that ayurveda can cure various ailments.', 'lead_paragraph': '“This is unbelievable — people will think this is hodgepodge,” Vasant Lad says as he presses a man’s wrist and by doing so, diagnoses the health of the man’s mother, who isn’t there. Mr. Lad is certainly right about the hodgepodge part (he claims that an area on your left arm contains your mother’s pulse, which he can read and analyze), but quite off base when he asserts: “This is a science.”', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0,