POT-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/31/fashion/31SWEETSPOT/31SWEETSPOT-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/31/fashion/31SWEETSPOT/31SWEETSPOT-thumbLarge.gif', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Relationship Makes Me Feel Excruciatingly Lonely. But I Love Her!', 'kicker': 'the sweet spot', 'content_kicker': None, 'print_headline': 'I Love Her, but I Feel Lonely', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dating and Relationships', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Love (Emotion)', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-05-29T15:39:20+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Cheryl Strayed and Steve Almond', 'person': [{'firstname': 'Cheryl', 'middlename': None, 'lastname': 'Strayed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Steve', 'middlename': None, 'lastname': 'Almond', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0165f19-64b5-57ec-9953-11d4b1462318', 'word_count': 1013, 'uri': 'nyt://article/e0165f19-64b5-57ec-9953-11d4b1462318'}, {'abstract': 'St. Agrestis’s bottled Negroni combines the company’s new aperitif with Greenhook gin and vermouth.', 'web_url': 'https://www.nytimes.com/2018/05/29/dining/st-agrestis-bottled-negroni-cocktail.html', 'snippet': 'St. Agrestis’s bottled Negroni combines the company’s new aperitif with Greenhook gin and vermouth.', 'lead_paragraph': 'St. Agrestis, a Brooklyn spirits company known for its amaro, has introduced a ready-to-drink Negroni. It’s based on their new aperitif, Inferno Bitter, which is making its debut in the bottled Negroni. The cocktail is also made with local Greenhook gin and sweet vermouth for a smooth, balanced drink that reins in the bitterness. Serve it with an orange twist or slice, or top it with prosecco. At 48 proof, the cocktail is sessionable as well as convenient, said Louis Catizone, an owner of the company: St. Agrestis Negroni, 100 milliliters (3.3 ounces), $6.49 a bottle, $24.99 for a four-pack, astorwines.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnernegroni/30burnernegroni-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/30/dining/30burnernegroni/30burnernegroni-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnernegroni/30burnernegroni-jumbo.jpg', 'height': 1024, 'width': 820, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnernegroni/30burnernegroni-superJumbo.jpg', 'height': 2048, 'width': 1639, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnernegroni/30burnernegroni-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/30/dining/30burnernegroni/30burnernegroni-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnernegroni/30burnernegroni-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Bottled Cocktail Conjures Summer in Capri', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Sip: Cocktail Conjures Summer of Leisure', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'St Agrestis Distillery', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cocktails and Mixed Drinks', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-05-29T15:42:05+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2970a652-3c4c-5d49-a267-ab54d18d2ca9', 'word_count': 101, 'uri': 'nyt://article/2970a652-3c4c-5d49-a267-ab54d18d2ca9'}, {'abstract': 'At Pondicheri, powdered moringa adds a boost to a frozen dessert.', 'web_url': 'https://www.nytimes.com/2018/05/29/dining/moringa-ice-cream-pondicheri.html', 'snippet': 'At Pondicheri, powdered moringa adds a boost to a frozen dessert.', 'lead_paragraph': 'The flood of so-called super foods from the tropics continues nonstop. Moringa — a tree that grows in hot, arid climates — has leaves that are dried and turned into a powder rich in calcium, vitamin A and protein. Alone the powder is fairly bitter, so it’s best added to smoothies and sauces. At Pondicheri, an Indian restaurant in NoMad, moringa bolsters verdant avocado ice cream. The generous scoops are rolled in chopped pistachios and more of the powder. Ajna Jai, who manages the restaurant for her mother, Anita Jaisinghani, the owner, thought of using moringa because it made a good alternative to the ubiquitous matcha. “In general, moringa works well in Indian food,” Ms. Jai said: Moringa ice cream, $4 a scoop to eat in or take out, $6 in a cone, Pondicheri, 15 West 27th Street, 646-878-4375, pondichericafe.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnermoringa/30burnermoringa-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/30/dining/30burnermoringa/30burnermoringa-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnermoringa/30burnermoringa-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnermoringa/30burnermoringa-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnermoringa/30burnermoringa-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/30/dining/30burnermoringa/30burnermoringa-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/30/dining/30burnermoringa/30burnermoringa-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Matcha Meets Its Match', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Chill: A Powdered Boost That’s Not Matcha', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Food', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dietary Supplements and Herbal Remedies', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Pondicheri (Manhattan, NY, Restaurant)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-05-29T15:48:33+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65bf6cce-a976-56fd-9f53-ad54ac2e3843', 'word_count': 163, 'uri': 'nyt://article/65bf6cce-a976-56fd-9f53-ad54ac2e3843'}, {'abstract': 'Once the suburban ideal, sprawling office parks are quickly becoming relics that stress local tax bases. But they also offer redevelopment possibilities.', 'web_url': 'https://www.nytimes.com/2018/05/29/nyregion/new-jersey-office-parks.html', 'snippet': 'Once the suburban ideal, sprawling office parks are quickly becoming relics that stress local tax bases. But they also offer redevelopment possibilities.', 'lead_paragraph': 'WAYNE, N.J. — Perched off a busy road in northern New Jersey with sweeping vistas of a vast reservoir sits a new relic of the suburban panorama: the international headquarters of Toys “R” Us slogging through its final days after the company announced that it would be shutting down for good.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/21/nyregion/00officeparks6/merlin_138252012_582d4ac2-9520-4fe8-8556-021ab4