acy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/movies/24skyscraper-trailer2/24skyscraper-trailer2-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/24/movies/24skyscraper-trailer2/24skyscraper-trailer2-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/movies/24skyscraper-trailer2/24skyscraper-trailer2-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dwayne Johnson Climbs Higher in New ‘Skyscraper’ Trailer', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Skyscraper (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Dwayne (1972- )', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-05-23T15:58:16+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Bruce Fretts', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Fretts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/175588c9-d010-5719-914d-c4222a0a577a', 'word_count': 173, 'uri': 'nyt://article/175588c9-d010-5719-914d-c4222a0a577a'}, {'abstract': 'Somewhere in Robert Indiana’s home in Maine, there may exist an early version of his famous image — one that will startle his fans.', 'web_url': 'https://www.nytimes.com/2018/05/23/arts/design/robert-indiana-love-and-other-four-letter-words.html', 'snippet': 'Somewhere in Robert Indiana’s home in Maine, there may exist an early version of his famous image — one that will startle his fans.', 'lead_paragraph': 'A “dangerous commodity, fraught with peril” was how the late artist Robert Indiana once described the emotion of love. He could just as easily have been talking about “LOVE,” his own signature artwork created in the mid-1960s.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/arts/24love/24indiana-art1-articleLarge.jpg', 'height': 878, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/24/arts/24love/24indiana-art1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 878}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/arts/24love/24indiana-art1-jumbo.jpg', 'height': 1024, 'width': 700, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/arts/24love/24indiana-art1-superJumbo.jpg', 'height': 2048, 'width': 1400, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/arts/24love/24indiana-art1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/24/arts/24love/24indiana-art1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/arts/24love/24indiana-art1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘LOVE’ and Other Four-Letter Words', 'kicker': None, 'content_kicker': None, 'print_headline': 'There’s A Carnal ‘LOVE,’ Too', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Indiana, Robert', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-05-23T15:59:31+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Brett Sokol', 'person': [{'firstname': 'Brett', 'middlename': None, 'lastname': 'Sokol', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/12ed9f82-e2f8-5f0e-987b-3fb9b17d96ff', 'word_count': 908, 'uri': 'nyt://article/12ed9f82-e2f8-5f0e-987b-3fb9b17d96ff'}, {'abstract': 'As the popularity of online beauty shopping continues to grow, the traditional department store makeup counter is getting a new look.', 'web_url': 'https://www.nytimes.com/2018/05/23/style/makeup-cosmetics-department-stores.html', 'snippet': 'As the popularity of online beauty shopping continues to grow, the traditional department store makeup counter is getting a new look.', 'lead_paragraph': 'Last year, online makeup sales increased by nearly 30 percent, while those in department stores and specialty boutiques like Ulta and Sephora rose just 3 percent, according to the research marketing company NPD Group. For skin-care products, growth of online sales outpaced physical ones by 700 percent. ', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/24/fashion/24SPERREFER/merlin_138482589_7e9905d3-1b9d-4916-b98d-747014f883ac-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/24/fashion/24SPERREFER/merlin_138482589_7e9905d3-1b9d-4916-b98d-747014f883ac-articleLarge.jpg', 'xlar