t': 1975, 'width': 1400, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/magazine/03mag-sentences1/03mag-sentences1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/06/03/magazine/03mag-sentences1/03mag-sentences1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/magazine/03mag-sentences1/03mag-sentences1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'New Sentences: From Christine Schutt’s ‘Pure Hollywood’', 'kicker': 'New Sentences', 'content_kicker': None, 'print_headline': 'From Christine Schutt’s ‘Pure Hollywood’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2018-05-30T09:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Sam Anderson', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Anderson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b02ca8f-33ad-578e-b4fa-0985ac70f9e4', 'word_count': 356, 'uri': 'nyt://article/6b02ca8f-33ad-578e-b4fa-0985ac70f9e4'}, {'abstract': 'Why did female members follow a guru named Keith Raniere, who now stands accused of sex trafficking? He made them feel like they were in control.', 'web_url': 'https://www.nytimes.com/2018/05/30/magazine/sex-cult-empowerment-nxivm-keith-raniere.html', 'snippet': 'Why did female members follow a guru named Keith Raniere, who now stands accused of sex trafficking? He made them feel like they were in control.', 'lead_paragraph': 'One winter morning in a conventional suburb outside Albany, N.Y., Nancy Salzman, the 63-year-old president of a self-improvement company named Nxivm, sat on a mahogany-colored stool in her kitchen. Her tasteful home was surrounded by other Nxivm members’ modest townhouses or capacious stone mansions that seemed to spring up out of nowhere, like mushrooms, on the suburban streets. In Salzman’s den, a photo of her with her two adult daughters hung on a wall, the three of them wearing smiles as wide as ancient Greek masks of comedy; the same happy photo served as the wallpaper on Salzman’s laptop. A hairless Sphynx cat prowled the lovely buffet of croissants and fruit on her kitchen island.', 'print_section': 'MM', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/magazine/03Nxivm-slideshow-slide-GBR7-alpha/03Nxivm-slideshow-slide-GBR7-alpha-articleLarge-v2.png', 'height': 673, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/06/03/magazine/03Nxivm-slideshow-slide-GBR7-alpha/03Nxivm-slideshow-slide-GBR7-alpha-articleLarge-v2.png', 'xlargewidth': 600, 'xlargeheight': 673}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/magazine/03Nxivm-slideshow-slide-GBR7-alpha/03Nxivm-slideshow-slide-GBR7-alpha-jumbo-v2.png', 'height': 1024, 'width': 913, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/06/03/magazine/03Nxivm-slideshow-slide-GBR7-alpha/03Nxivm-slideshow-slide-GBR7-alpha-superJumbo-v2.png', 'height': 2048, 'width': 1825, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 