ryer.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/16/travel/16sicily-frugal2/merlin_137528889_fd1efc2a-4fab-4adc-b737-17add2befcb7-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/05/16/travel/16sicily-frugal2/merlin_137528889_fd1efc2a-4fab-4adc-b737-17add2befcb7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/16/travel/16sicily-frugal2/merlin_137528889_fd1efc2a-4fab-4adc-b737-17add2befcb7-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/16/travel/16sicily-frugal2/merlin_137528889_fd1efc2a-4fab-4adc-b737-17add2befcb7-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/16/travel/16sicily-frugal2/merlin_137528889_fd1efc2a-4fab-4adc-b737-17add2befcb7-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/05/16/travel/16sicily-frugal2/merlin_137528889_fd1efc2a-4fab-4adc-b737-17add2befcb7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/05/16/travel/16sicily-frugal2/merlin_137528889_fd1efc2a-4fab-4adc-b737-17add2befcb7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Tour of Small-Town Sicily', 'kicker': None, 'content_kicker': None, 'print_headli