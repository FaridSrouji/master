': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/21/business/21-FAMOUS-1/21-FAMOUS-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/business/21-FAMOUS-1/21-FAMOUS-1-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/business/21-FAMOUS-1/21-FAMOUS-1-superJumbo.jpg', 'height': 1345, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/business/21-FAMOUS-1/21-FAMOUS-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/21/business/21-FAMOUS-1/21-FAMOUS-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/business/21-FAMOUS-1/21-FAMOUS-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dancing With the Start-Ups', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dancing With the Start-Ups', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Marikar, Sheila', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Celebrities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Venture Capital', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Start-ups', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-20T19:06:16+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Sheila Marikar', 'person': [{'firstname': 'Sheila', 'middlename': None, 'lastname': 'Marikar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8fa11206-e50d-58cc-ab3a-1a0184b6ef7b', 'word_count': 1550, 'uri': 'nyt://article/8fa11206-e50d-58cc-ab3a-1a0184b6ef7b'}, {'abstract': 'Sunday’s game between the Chicago Bears and the San Francisco 49ers showed just how entangled the N.F.L.’s manufactured world of make-believe is with the hard realities of American life.', 'web_url': 'https://www.nytimes.com/2014/09/21/sports/football/as-life-imitates-brutal-sport-cheers-have-uneasy-resonance-.html', 'snippet': 'Sunday’s game between the Chicago Bears and the San Francisco 49ers showed just how entangled the N.F.L.’s manufactured world of make-believe is with the hard realities of American life.', 'lead_paragraph': 'Amid the images and reports of battered women and children, there may finally be consensus that N.F.L. games are superfluous, that the standings matter less than the blotter, bruises and brain scans. But the games go on as scheduled, as if nothing happened, no matter how far the league veers wildly off script. ', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/sports/DOG-jp-branch/DOG-jp-branch-articleLarge.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/21/sports/DOG-jp-branch/DOG-jp-branch-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 377}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/sports/DOG-jp-branch/