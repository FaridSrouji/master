rts/15giants/15giants-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/sports/15giants/15giants-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Offense Makes Strides, but Giants Pay for Turnovers and Special-Teams Play', 'kicker': 'Cardinals 25, Giants 14', 'content_kicker': None, 'print_headline': 'Offense Makes Strides, but Giants Pay for Turnovers and Special-Teams Play', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Palmer, Carson', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ginn, Ted', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'ARIZONA CARDINALS', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-14T21:18:57+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Bill Pennington', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Pennington', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3a59de62-d160-539f-9c9c-4106c0b5bdd8', 'word_count': 1106, 'uri': 'nyt://article/3a59de62-d160-539f-9c9c-4106c0b5bdd8'}, {'abstract': 'The fiery soul singer was added to the Apollo Theater’s fall-winter lineup, organizers announced on Sunday.', 'web_url': 'https://www.nytimes.com/2014/09/15/arts/music/sharon-jones-to-join-label-mates-at-the-apollo.html', 'snippet': 'The fiery soul singer was added to the Apollo Theater’s fall-winter lineup, organizers announced on Sunday.', 'lead_paragraph': 'The fiery soul singer Sharon Jones was added to the Apollo Theater’s fall-winter lineup, organizers announced on Sunday. Ms. Jones will star alongside her band, the Dap-Kings, and the singer Charles Bradley during a three-night revue that is to feature many other musicians on the Daptone Records label. The extended concert, “Daptone Super Soul Revue,” is scheduled for Dec. 4-6 and is to be recorded live for an album. Ms. Jones, above, is familiar to the Apollo stage, but other Daptone acts, like Antibalas and the Budos Band, will be making their Apollo debuts. The album will place Daptone musicians in a long line of celebrated artists with live Apollo albums, including James Brown, B. B. King and Hall & Oates. Additionally, Harry Belafonte and the former New York City Mayor David N. Dinkins were added to an October panel discussion of the connection between Harlem and South Africa. The previously announced season lineup includes a celebration of New Orleans jazz, a tribute concert to Bob Marley and the holiday show “Ellington at Christmas.”', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts2/arts2-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/15/arts/arts2/arts2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts2/arts2-jumbo.jpg', 'height': 677, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts2/arts2-superJumbo.jpg', 'height': 1354, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts2/arts2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/15/arts/arts2/arts2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts2/arts2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sharon Jones to Join Label Mates at the Apollo', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Sharon Jones to Join Label Mates at the Apollo', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'APOLLO THEATER', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Harlem (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Sharon Lafaye (1956- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Dap-Kings (Music Group)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-14T21:20:09+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'Compiled by Andrew R. Chow', 'person': [{'firstname': 'Andrew', 'middlename': 'R.', 'lastname': 'Chow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/9e218465-eb35-5595-9316-162f374d3203', 'word_count': 174, 'uri': 'nyt://article/9e218465-eb35-5595-9316-162f374d3203'}, {'abstract': 'A statue of the British singer was unveiled on Sunday in London on what would have been her 31st birthday.', 'web_url': 'https://www.nytimes.com/2014/09/15/arts/music/amy-winehouse-statue-is-unveiled-in-london.html', 'snippet': 'A statue of the British singer was unveiled on Sunday in London on what would have been her 31st birthday.', 'lead_paragraph': 'A statue of the British singer Amy Winehouse was unveiled on Sunday in London on what would have been her 31st birthday. The bronze work, above, was created by the London sculptor Scott Eaton and features Winehouse’s signature beehive hairstyle, a hand on one hip and stilettos on her feet. Mr. Eaton said the statue was meant to capture Winehouse’s “attitude and strength but also give subtle hints of insecurity,” the BBC reported. The statue was placed in Camden, the neighborhood where Winehouse lived before her death in July 2011 at 27. “Now Amy will oversee the comings and goings of her hometown forever,” her father, Mitch Winehouse, told the BBC. Amy Winehouse won six Grammys in her brief career. She had publicly struggled with alcohol and drug addiction before dying at her home of accidental alcohol poisoning.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts3/arts3-articleLarge.jpg', 'height': 1058, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/15/arts/arts3/arts3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1058}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts3/arts3-jumbo.jpg', 'height': 1024, 'width': 581, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/arts/arts3/arts3-superJumbo.jpg', 'height': 2048, 'width': 1162, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': '