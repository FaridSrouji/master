or': 'N'}], 'pub_date': '2014-09-18T22:57:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/0ca18e9f-6a6c-5d9c-a7ab-1bce028552c9', 'word_count': 114, 'uri': 'nyt://article/0ca18e9f-6a6c-5d9c-a7ab-1bce028552c9'}, {'abstract': 'A film from mainland China has yet to win an Academy Award, and Chinese officials are eager for the cultural validation that an Oscar brings.', 'web_url': 'https://www.nytimes.com/2014/09/21/movies/in-china-dreams-of-vying-for-an-oscar.html', 'snippet': 'A film from mainland China has yet to win an Academy Award, and Chinese officials are eager for the cultural validation that an Oscar brings.', 'lead_paragraph': 'BEIJING — The question that hounds every major Chinese film director was put to Jiang Wen at a news conference here this month. Mr. Jiang and his business associates had organized the event to generate buzz over the coming “Gone With the Bullets,” a gangster film set in 1920s Shanghai that is a follow-up to “Let the Bullets Fly,” the top earner in the Chinese film industry four years ago.', 'print_section': 'AR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/arts/21CHINA1/21CHINA1-articleLarge-v2.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/21/arts/21CHINA1/21CHINA1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/arts/21CHINA1/21CHINA1-jumbo-v2.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image'