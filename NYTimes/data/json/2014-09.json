r': 'N'}], 'pub_date': '2014-09-26T15:00:34+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew C. Revkin', 'person': [{'firstname': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ec57b773-86dd-5969-abc6-17339c4b3c91', 'word_count': 1721, 'uri': 'nyt://article/ec57b773-86dd-5969-abc6-17339c4b3c91'}, {'abstract': 'One of the most vocal and articulate supporters of greater democracy in Hong Kong, the former Chief Secretary Anson Chan, is trying to find room to compromise with the pro-Beijing camp on electing the top leader.', 'web_url': 'https://sinosphere.blogs.nytimes.com/2014/09/26/q-and-a-anson-chan-on-political-compromise-in-hong-kong/', 'snippet': 'One of the most vocal and articulate supporters of greater democracy in Hong Kong, the former Chief Secretary Anson Chan, is trying to find room to compromise with the pro-Beijing camp on electing the top leader.', 'lead_paragraph': 'With students taking to the streets this week in Hong Kong and pro-democracy protesters planning to stage a sit-in protest in the coming week in the heart of Asia’s leading financial center, one of the most vocal and articulate supporters of greater democracy in Hong Kong, the former Chief Secretary Anson Chan, is trying to find some room to compromise with the pro-Beijing camp on how to elect the territory’s leader, the chief executive.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/world/26sino-ANSON2/26sino-ANSON2-articleLarge.jpg', 'height': 434, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/26/world/26sino-ANSON2/26sino-ANSON2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 434}}, {'rank'