 Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/nyregion/21JOINT1/21JOINT1-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/21/nyregion/21JOINT1/21JOINT1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/nyregion/21JOINT1/21JOINT1-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/nyregion/21JOINT1/21JOINT1-superJumbo.jpg', 'height': 1913, 'width': 1913, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/nyregion/21JOINT1/21JOINT1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/21/nyregion/21JOINT1/21JOINT1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/nyregion/21JOINT1/21JOINT1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘You See Your Boys, You Stop’: At Le Basket in Greenwich Village', 'kicker': 'Neighborhood Joint', 'content_kicker': None, 'print_headline': '‘You See Your Boys, You Stop’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Krieger, Daniel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Le Basket (Manhattan, NY, Restaurant)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Lower East Side (Manhattan, NY)',