itle': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73fd990e-15c4-5457-a054-21d4515d4fc2', 'word_count': 857, 'uri': 'nyt://article/73fd990e-15c4-5457-a054-21d4515d4fc2'}, {'abstract': 'The chamber band Alarm Will Sound helped celebrate Nonesuch Records’ 50th anniversary, part of the Brooklyn Academy of Music’s Next Wave Festival.', 'web_url': 'https://www.nytimes.com/2014/09/15/arts/music/alarm-will-sound-devotes-a-concert-to-john-adams.html', 'snippet': 'The chamber band Alarm Will Sound helped celebrate Nonesuch Records’ 50th anniversary, part of the Brooklyn Academy of Music’s Next Wave Festival.', 'lead_paragraph': 'Like being “locked in overnight at a Starbucks.” That’s how the composer John Adams described a program on Friday, one of two given by the chamber band Alarm Will Sound at Nonesuch Records’ 50th anniversary celebrations, part of the Brooklyn Academy of Music’s Next Wave Festival.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Is Your Music on Lots of Caffeine', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'This Is Your Music on Lots of Caffeine', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Allen, David', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Next Wave Festival', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Nonesuch Records', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'ALARM WILL SOUND', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-14T21:52:12+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By David Allen', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Allen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/121a7dcd-4afd-5151-a228-9fcb4a9e2fad', 'word_count': 593, 'uri': 'nyt://article/121a7dcd-4afd-5151-a228-9fcb4a9e2fad'}, {'abstract': 'The popular television series has spawned an apparel collection described in its advertising campaign as “fearless fashions for ladies who lead.”', 'web_url': 'https://www.nytimes.com/2014/09/15/business/media/scandal-inspires-clothing-line-at-the-limited.html', 'snippet': 'The popular television series has spawned an apparel collection described in its advertising campaign as “fearless fashions for ladies who lead.”', 'lead_paragraph': 'DURING New York Fashion Week, which ended on Thursday, there was considerable discussion of designs and designers to die for. Beginning on Monday, the women’s apparel retailer The Limited is hoping to stimulate conversations, both actual and virtual, about dresses to double-cross for, skirts to skulk around in and suits to back-stab for.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/business/adco2/adco2-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/15/business/adco2/adco2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/business/adco2/adco2-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/15/business/adco2/adco2-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJ