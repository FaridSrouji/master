siness/facebookjump2/facebookjump2-superJumbo.jpg', 'height': 2048, 'width': 1044, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/08/business/facebookjump2/facebookjump2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/08/business/facebookjump2/facebookjump2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/08/business/facebookjump2/facebookjump2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Facebook’s Feeds Give Videos a Boost', 'kicker': None, 'content_kicker': None, 'print_headline': 'Facebook’s Feeds Give Videos a Boost', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Facebook Inc', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-08T04:11:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Vindu Goel', 'person': [{'firstname': 'Vindu', 'middlename': None, 'lastname': 'Goel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2cf87f6-3388-59d5-8603-70aaa32af32c', 'word_count': 1194, 'uri': 'nyt://article/c2cf87f6-3388-59d5-8603-70aaa32af32c'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/09/08/arts/television/whats-on-tv-monday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (HBO Signature) BEHIND THE CANDELABRA (2013) Michael Douglas, above, in a Golden Globe-winning role, stars as Liberace, and Matt Damon is Scott Thorson, his chauffeur, lover and adopted son, in this film from the director Steven Soderbergh and the screenwriter Richard LaGravenese. Set in Las Vegas; Los Angeles; and Palm Springs, Calif., the film chronicles the men’s relationship, as Liberace has Mr. Thorson cosmetically altered in his image and legally adopts him before discarding him for a younger model. “There’s something uncanny, even brilliant,” about Mr. Douglas’s impersonation of Liberace, Mike Hale wrote in The New York Times. “Sashaying across Las Vegas stages and epic suburban living rooms with a drum major’s puffed-up grandeur and a lounge lizard’s predatory smile, Mr. Douglas gives a performance so assured, so free of camp or cringe, that you quickly surrender any doubts you might have had about his playing a famously flamboyant, closeted-in-plain-sight gay entertainer.” Still, “a cerebral gloss on, and satire of, a big old Hollywood biopic,” Mr. Hale added, the film is “full of smart, funny details — perfectly sewn in place, like the rhinestones on one of Mr. Douglas’s blinding costumes — but it’s short on heart, or heat.”\xa0 ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On TV Monday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Monday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-09-08T04:17:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'S