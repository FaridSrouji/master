14/09/02/arts/02BARNES1/02BARNES1-jumbo.jpg', 'height': 641, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02BARNES1/02BARNES1-superJumbo.jpg', 'height': 1282, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02BARNES1/02BARNES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/02/arts/02BARNES1/02BARNES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02BARNES1/02BARNES1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Performance Hybrid as Unexpected as Dance on the Radio', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Performance Hybrid as Unexpected as Dance on the Radio', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Radio', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Barnes, Monica Bill', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Glass, Ira', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-01T21:32:50+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Brian Schaefer', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Schaefer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aedbf98c-538c-5c64-8980-376ecc339a77', 'word_count': 1114, 'uri': 'nyt://article/aedbf98c-538c-5c64-8980-376ecc339a77'}, {'abstract': 'Students need an unvarnished picture of our past and the skills to understand and interpret that picture.', 'web_url': 'https://www.nytimes.com/2014/09/02/opinion/the-new-history-wars.html', 'snippet': 'Students need an unvarnished picture of our past and the skills to understand and interpret that picture.', 'lead_paragraph': 'WASHINGTON — WITH the news dominated by stories of Americans dying at home and abroad, it might seem trivial to debate how history is taught in our schools. But if we want students to understand what is happening in Missouri or the Middle East, they need an unvarnished picture of our past and the skills to understand and interpret that picture. People don’t kill one another just for recreation. They have reasons. Those reasons are usually historical. \xa0', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/opinion/0902OPEDspix/0902OPEDspix-articleLarge.jpg', 'height': 724, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/02/opinion/0902OPEDspix/0902OPEDspix-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 724}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/opinion/0902OPEDspix/0902OPEDspix-jumbo.jpg', 'height': 1024, 'width': 849, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/opinion/0902OPEDspix/0902OPEDspix-superJumbo.jpg', 'height': 1928, 'width': 1598, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/opinion/0902OPEDspix/0902OPEDspix-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/02/opinion/0902OPEDspix/0902OPEDspix-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/opinion/0902OPEDspix/0902OPEDspix-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The New History Wars', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The New History Wars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Grossman, James R', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'History (Academic Subject)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tests and Examinations', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'College Board', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Education', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-09-01T21:33:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By James R. Grossman', 'person': [{'firstname': 'James', 'middlename': 'R.', 'lastname': 'Grossman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/035152f5-d586-5533-99ac-9bf985d693f6', 'word_count': 934, 'uri': 'nyt://article/035152f5-d586-5533-99ac-9bf985d693f6'}, {'abstract': 'In the 1864 election, Gotham delivered nearly twice as many votes to the president’s opponent, George B. McClellan.', 'web_url': 'https://opinionator.blogs.nytimes.com/2014/09/01/why-new-york-city-opposed-abe-lincoln/', 'snippet': 'In the 1864 election, Gotham delivered nearly twice as many votes to the president’s opponent, George B. McClellan.', 'lead_paragraph': 'New York may have been the largest city in the Union during the Civil War, but most of its inhabitants were strongly opposed to the conflict – if not downright hostile to the Union’s war aims. During the secession crisis of 1861, the pro-Confederate mayor Fernando Wood even proposed seceding from the Union and establishing itself as an independent city-state, neither for nor against the North or the South. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why New York City Opposed Abe Lincoln', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lincoln, Abraham', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McClellan, George B', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-01T21:34:19+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Bill Morgan', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Morgan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d016619d-74aa-5e39-a6b1-7d1337189364', 'word_count': 1071, 'uri': 'nyt://article/d016619d-74aa-5e39-a6b1-7d1337189364'}, {'abstract': 'Readers respond to a column by Mark Bittman.', 'web_url': 'https://www.nytimes.com/2014/09/02/opinion/the-pleasures-of-drinking-and-the-risks.html', 'snippet': 'Readers respond to a column by Mark Bittman.', 'lead_paragraph': ' To the Editor:', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Pleasures of Drinking, and the Risks', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'The Pleasures of Drinking, and the Risks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Obesity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bittman, Mark', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-01T21:37:20+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/be732281-5250-58c1-a01d-6c1884bfe826', 'word_count': 318, 'uri': 'nyt://article/be732281-5250-58c1-a01d-6c1884bfe826'}, {'abstract': 'Readers respond to a front-page article on the rarity of the poor at elite schools.', 'web_url': 'https://www.nytimes.com/2014/09/02/opinion/leveling-the-college-playing-field.html', 'snippet': 'Readers res