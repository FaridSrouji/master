ations', 'value': 'Creatures of the Wind (Fashion Label)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Nars Cosmetics', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-04T22:30:11+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kari Molvar', 'person': [{'firstname': 'Kari', 'middlename': None, 'lastname': 'Molvar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f12727f-2bc1-5347-95c1-f56749db2949', 'word_count': 207, 'uri': 'nyt://article/5f12727f-2bc1-5347-95c1-f56749db2949'}, {'abstract': 'Times reporters respond to a sampling of readers’ questions about the coming season.', 'web_url': 'https://www.nytimes.com/2014/09/05/sports/football/nfl-writers-respond-to-readers-questions.html', 'snippet': 'Times reporters respond to a sampling of readers’ questions about the coming season.', 'lead_paragraph': "The N.F.L.'s regular season began Thursday night, when the Seattle Seahawks, the defending Super Bowl champions, defeated the Green Bay Packers, 36-16. On Sunday, Rex Ryan’s Jets will play host to the Oakland Raiders, and on Monday night, Eli Manning and the Giants will take on the Lions in Detroit.", 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/05/sports/05football3/05football3-articleLarge.jpg', 'height': 366, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/05/sports/05football3/05football3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 366}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/05/sports/05football3/05football3-jumbo.jpg', 'height': 624, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'super