me': 'persons', 'value': 'Bosman, Julie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Robles, Frances', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ferguson (Mo)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Missouri', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-16T20:13:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Frances Robles', 'person': [{'firstname': 'Frances', 'middlename': None, 'lastname': 'Robles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c28c4f64-70b3-5474-8bf3-40fb09ff462e', 'word_count': 573, 'uri': 'nyt://article/c28c4f64-70b3-5474-8bf3-40fb09ff462e'}, {'abstract': 'Short passes have helped increase completion percentages and decrease yards per completion, but in Houston, Cincinnati and Philadelphia, receivers are making things happen after the catch.', 'web_url': 'https://www.nytimes.com/2014/09/17/sports/football/the-new-nfl-short-passes-and-a-cloud-of-dust.html', 'snippet': 'Short passes have helped increase completion percentages and decrease yards per completion, but in Houston, Cincinnati and Philadelphia, receivers are making things happen after the catch.', 'lead_paragraph': 'In the N.F.L., the short pass is the new run. Through two weeks, teams have completed 63.5 percent of their passes, a rate that would easily break last year’s record-setting 61.2 percent. Thirty-four quarterbacks have attempted at least 30 passes this season, and half of them have completed at least 64.9 percent of their passes. In many ways, it has never been easier for a quarterback to complete a pass.', 'print_section': 'B', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/sports/Y-STUART/Y-STUART-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/17/sports/Y-STUART/Y-STUART-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/sports/Y-STUART/Y-STUART-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/sports/Y-STUART/Y-STUART-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/sports/Y-STUART/Y-STUART-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/17/sports/Y-STUART/Y-STUART-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/sports/Y-STUART/Y-STUART-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Around the N.F.L., the Catch-and-Run Is Gaining ', 'kicker': 'Analysis', 'content_kicker': None, 'print_headline': 'Around the N.F.L., the Catch-and-Run Is Gaining', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cincinnati Bengals', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Houston Texans', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sanu, Mohamed', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Cassel, Matt', 'rank': 6, 'major':