tro', 'section_name': 'New York', 'byline': {'original': 'By Michael M. Grynbaum', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7986d9d-8e9f-5920-bb30-9222608e3682', 'word_count': 1037, 'uri': 'nyt://article/d7986d9d-8e9f-5920-bb30-9222608e3682'}, {'abstract': 'When the No. 15 Sun Devils host U.C.L.A., one of the last things Foster will see before running on the field is a picture of his sister, Jennifer, who died of a drug overdose five years ago.', 'web_url': 'https://www.nytimes.com/2014/09/25/sports/ncaafootball/arizona-state-star-draws-inspiration-from-his-guardian-angel-sister.html', 'snippet': 'When the No. 15 Sun Devils host U.C.L.A., one of the last things Foster will see before running on the field is a picture of his sister, Jennifer, who died of a drug overdose five years ago.', 'lead_paragraph': 'TEMPE, Ariz. — D. J. Foster, Arizona State’s star running back, has a tattoo above his heart with “Sweet Dreams” inscribed below the smiling face of his sister, Jennifer. ', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/25/sports/Y-FOSTER-1/Y-FOSTER-1-articleLarge.jpg', 'height': 440, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/25/sports/Y-FOSTER-1/Y-FOSTER-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 440}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/25/sports/Y-FOSTER-1/Y-FOSTER-1-jumbo.jpg', 'height': 751, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/25/sports/Y-FOS