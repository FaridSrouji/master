lue': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'ALLIANCE BOOTS', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Jana Partners LLC', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Walgreen Company', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-08T13:46:49+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Alexandra Stevenson', 'person': [{'firstname': 'Alexandra', 'middlename': None, 'lastname': 'Stevenson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/85d6531d-84d4-5c0b-b884-8933bafbac5e', 'word_count': 338, 'uri': 'nyt://article/85d6531d-84d4-5c0b-b884-8933bafbac5e'}, {'abstract': 'A study found that though an elite 20 percent of foragers did half of a hive’s foraging, once they were removed, other bees increased their activity.', 'web_url': 'https://www.nytimes.com/2014/09/09/science/no-glass-ceiling-for-worker-bees.html', 'snippet': 'A study found that though an elite 20 percent of foragers did half of a hive’s foraging, once they were removed, other bees increased their activity.', 'lead_paragraph': 'The honeybee hive would not seem to be the place to look for individuality, flexibility in job duties and social mobility. But by using new techniques for analyzing bee behavior, researchers at the University of Illinois at Urbana-Champaign, recently found that the life of a bee is less rigidly determined than had been thought.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Glass Ceiling for Worker Bees', 'kicker': 'ScienceTake', 'content_kicker': None, 'print_headline': 'No Glass Ceiling for Worker Bees', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gorman, James', 'rank': 1, 'major':