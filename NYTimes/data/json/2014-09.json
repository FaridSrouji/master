': 'subject', 'value': 'Baby Boomers', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Homeless Persons', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-20T18:30:06+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/f549970b-9cd5-5b74-869a-01e6ce2c1205', 'word_count': 377, 'uri': 'nyt://article/f549970b-9cd5-5b74-869a-01e6ce2c1205'}, {'abstract': 'A Scottish conceptual artist on the referendum, fossil hunting and bouncing Beethoven off the moon.', 'web_url': 'https://www.nytimes.com/2014/09/21/opinion/sunday/katie-paterson.html', 'snippet': 'A Scottish conceptual artist on the referendum, fossil hunting and bouncing Beethoven off the moon.', 'lead_paragraph': 'Katie Paterson is a Scottish conceptual artist. Her most recent work is “Future Library” — 1,000 seedlings growing in a Norwegian forest, which will be cut down in 100 years and made into previously unpublished books.', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/sunday-review/0921DOWNLOAD/0921DOWNLOAD-articleLarge.jpg', 'height': 717, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/21/sunday-review/0921DOWNLOAD/0921DOWNLOAD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 717}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/sunday-review/0921DOWNLOAD/0921DOWNLOAD-jumbo.jpg', 'height': 1024, 'width': 858, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type':