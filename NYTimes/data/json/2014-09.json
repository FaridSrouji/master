acy': {'xlarge': 'images/2014/09/14/books/review/0914-bks-MICKLETHWAIT/0914-bks-MICKLETHWAIT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 728}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/0914-bks-MICKLETHWAIT/0914-bks-MICKLETHWAIT-jumbo.jpg', 'height': 1024, 'width': 845, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/0914-bks-MICKLETHWAIT/0914-bks-MICKLETHWAIT-superJumbo.jpg', 'height': 2048, 'width': 1689, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/0914-bks-MICKLETHWAIT/0914-bks-MICKLETHWAIT-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/14/books/review/0914-bks-MICKLETHWAIT/0914-bks-MICKLETHWAIT-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/0914-bks-MICKLETHWAIT/0914-bks-MICKLETHWAIT-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As the World Turns', 'kicker': None, 'content_kicker': None, 'print_headline': "'World Order'", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'World Order (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kissinger, Henry A', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-11T20:16:11+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By John Micklethwait', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Micklethwait', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7f448ef7-77ae-5710-809d-fb427a56088a', 'word_count': 1982, 'uri': 'nyt://article/7f448ef7-77ae-5710-809d-fb427a56088a'}, {'abstract': 'Joe Klein reviews Lawrence Wright’s minute-by-minute account of the 1978 Camp David peace talks between Israel and Egypt.', 'web_url': 'https://www.nytimes.com/2014/09/14/books/review/thirteen-days-in-september-by-lawrence-wright.html', 'snippet': 'Joe Klein reviews Lawrence Wright’s minute-by-minute account of the 1978 Camp David peace talks between Israel and Egypt.', 'lead_paragraph': '(This book was selected as one of The New York Times Book Review’s 10 Best Books of 2014. For the rest of the list, click here.)', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14cover/14cover-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/14/books/review/14cover/14cover-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14cover/14cover-jumbo.jpg', 'height': 564, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14cover/14cover-superJumbo.jpg', 'height': 1127, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14cover/14cover-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/14/books/review/14cover/14cover-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14cover/14cover-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Elusive Peace', 'kicker': None, 'content_kicker': None, 'print_headline': '‘Thirteen Days in September’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wright, Lawrence', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Carter, Jimmy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sadat, Anwar El-', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Begin, Menachem', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-11T20:16:27+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joe Klein', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/33cd77c3-59cd-55e0-b637-5656be8fc5ec', 'word_count': 1328, 'uri': 'nyt://article/33cd77c3-59cd-55e0-b637-5656be8fc5ec'}, {'abstract': 'Francis Fukuyama chronicles international political history to define liberal democracy and discover how and why it develops.', 'web_url': 'https://www.nytimes.com/2014/09/14/books/review/francis-fukuyamas-political-order-and-political-decay.html', 'snippet': 'Francis Fukuyama chronicles international political history to define liberal democracy and discover how and why it develops.', 'lead_paragraph': 'In 1989, Francis Fukuyama published an essay in The National Interest entitled “The End of History?” that thrust him into the center of public debate. Although often misunderstood and maligned, its central argument was straightforward and sensible: With the collapse of Communism, liberal democracy stood alone as the only form of government compatible with socio\xad-economic modernity. Over the years since, Fukuyama has continued to argue the case, and has now summed up his efforts with a two-\xadvolume magnum opus that chronicles global political development from prehistory to the present. A quarter-century on, he remains convinced that no other political system is viable in the long run, but concludes his survey with a sobering twist: Liberal democracy’s future is cloudy, but that is because of its own internal problems, not competition from any external opponent.', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14berman/14berman-articleLarge.jpg', 'height': 525, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/14/books/review/14berman/14berman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 525}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14berman/14berman-jumbo.jpg', 'height': 896, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/books/review/14berman/14berman-superJumbo.jpg', 'height': 1792, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subt