_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York Times Expands Newsroom Leadership to Address Shifts in Industry', 'kicker': None, 'content_kicker': None, 'print_headline': 'Times Expands Newsroom Leadership to Address Shifts in Industry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Elder, Janet', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fisher, Ian', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Chira, Susan', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Baquet, Dean', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Kahn, Joseph', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Levy, Clifford J', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Purdy, Matthew', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Ingrassia, Lawrence', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Duenes, Steve', 'rank': 12, 'major': 'N'}], 'pub_date': '2014-09-24T16:47:11+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Ravi Somaiya', 'person': [{'firstname': 'Ravi', 'middlename': None, 'lastname': 'Somaiya', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1ede7edb-731f-578f-b060-41f3e5c45014', 'word_count': 652, 'uri': 'nyt://article/1ede7edb-731f-578f-b060-41f3e5c45014'}, {'abstract': 'See the skyline without battling crowds, sample pastries from a secret gem, sip artisanal beers and soak up culture during a weekend in the Tuscan capital.', 'web_url': 'https://www.nytimes.com/2014/09/28/travel/things-to-do-in-36-hours-in-florence-italy.html', 'snippet': 'See the skyline without battling crowds, sample pastries from a secret gem, sip artisanal beers and soak up culture during a weekend in the Tuscan capital.', 'lead_paragraph': 'Florence was thrust into the spotlight in February when its mayor, the dynamic 39-year-old Matteo Renzi, became Italy’s youngest prime minister. But the Tuscan capital he left behind appears to be flourishing. Once-neglected landmarks have been repurposed as contemporary cultural spaces. This spring, the historic Mercato Centrale market hall unveiled a new floor filled with stalls from the region’s top food artisans, and an ultramodern new opera house began hosting regular performances during the annual Maggio Musicale Fiorentino festival. Meanwhile, a spate of recent openings — bars, boutiques and restaurants squirreled away from the tourist throngs — suggests that the city’s upward trajectory isn’t changing course anytime soon.', 'print_section': 'TR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '36 Hours in Florence, Italy', 'kicker': None, 'content_kicker': None, 'print_headline': '36 Hours in Florence, Italy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Ingrid K', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Florence (Italy)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-24T16:48:30+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Ingrid K. Williams', 'person': [{'firstname': 'Ingrid', 'middlename': 'K.', 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fc817c13-1aa0-5716-bf4a-83e16555f747', 'word_count': 1382, 'uri': 'nyt://article/fc817c13-1aa0-5716-bf4a-83e1