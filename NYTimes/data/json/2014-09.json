arts/subdenude/subdenude-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/27/arts/subdenude/subdenude-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/subdenude/subdenude-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In the Face of Nudity, It’s All About Eye Contact', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'In the Face of Nudity, It’s All About Eye Contact', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ABRONS ARTS CENTER', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Isakovic, Bruno', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Vnucec, Ana', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-26T22:15:47+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Brian Seibert', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Seibert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/699176c7-505a-559e-a15b-43110f148884', 'word_count': 400, 'uri': 'nyt://article/699176c7-505a-559e-a15b-43110f148884'}, {'abstract': 'The spotlight at Fashion Week was on accessories.', 'web_url': 'https://www.nytimes.com/2014/09/28/fashion/bill-cunningham-accessories-as-co-stars.html', 'snippet': 'The spotlight at Fashion Week was on accessories.', 'lead_paragraph': 'The spotlight at fashion week was on accessories, especially whimsical ones: lock and chain necklaces from Chanel, or Lagerfeld fur doll ornaments from Fendi. Strawberry ice cream cones appeared on a handbag, hat and tee, while tweeds and other traditional fabrics were integrated with sneakers, speeding into the mainstream. Sandals and lacy footwear held their own. The black cameras of photographers captured shows, but the newest models wore gold.', 'print_section': 'ST', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bill Cunningham | Accessories as Co-Stars', 'kicker': 'On the Street', 'content_kicker': None, 'print_headline': 'Co-Stars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New York Fashion Week', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cunningham, Bill', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shoes and Boots', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Cunningham, Bill', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'September Fashion Week (2014)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-26T22:18:02+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Bill Cunningham', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Cunningham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d485f2a2-5fa0-5f07-96dc-2e259a936085', 'word_count': 71, 'uri': 'nyt://article/d485f2a2-5fa0-5f07-96dc-2e259a936085'}, {'abstract': 'On this day in history, Nixon and Kennedy met in the first publicly televised presidential debate.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/09/26/on-this-day-nixon-and-kennedy-debate/', 'snippet': 'On this day in history, Nixon and Kennedy met in the first publicly televised presidential debate.', 'lead_paragraph': 'From Ronald Reagan’s “there you go again” to Al Gore’s sigh, presidential debates have long featured flawed stagecraft and verbal stumbles.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On This Day: Nixon and Kennedy Debate', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Debates (Political)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kennedy, John Fitzgerald', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nixon, Richard Milhous', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-26T22:22:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Alan Rappeport', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Rappeport', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a08baa0-a6ce-5d02-9f9e-1ddd647d522d', 'word_count': 193, 'uri': 'nyt://article/0a08baa0-a6ce-5d02-9f9e-1ddd647d522d'}, {'abstract': 'The presumed Republican presidential contenders reached out with personal stories and political reassurances at the Values Voter Summit.', 'web_url': 'https://www.nytimes.com/2014/09/27/us/politics/ted-cruz-and-rand-paul-make-appeal-to-social-conservatives.html', 'snippet': 'The presumed Republican presidential contenders reached out with personal stories and political reassurances at the Values Voter Summit.', 'lead_paragraph': 'WASHINGTON — Senator Ted Cruz of Texas invoked the redemptive story of his parents, both plagued by too much drinking, to show the role that faith has played in his life. Senator Rand Paul of Kentucky, who took the stage as a video of a fetal ultrasound played for the crowd, said that liberty, virtue and God were intertwined, and he quoted Corinthians to make his point.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/us/27values-hp/27values-hp-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/27/us/27values-hp/27values-hp-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/us/27values-hp/27values-hp-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/us/27values-hp/27values-hp-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/us/27values-hp/27values-hp-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/27/us/27values-hp/27values-hp-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/us/27values-hp/27values-hp-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ted Cruz and Rand Paul Make Appeals to Social Conservatives', 'kicker': None, 'content_kicker': None, 'print_headline': '2 Senators, Eyes on 2016, Make Appeals to Social Conservatives', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cruz, Ted', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Peters, Jeremy W', 'rank': 2, 'major': 'N'