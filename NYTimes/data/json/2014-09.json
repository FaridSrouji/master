, 'type': 'image', 'url': 'images/2014/09/12/us/motherlode-ourzo/motherlode-ourzo-superJumbo.jpg', 'height': 667, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/us/motherlode-ourzo/motherlode-ourzo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/12/us/motherlode-ourzo/motherlode-ourzo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/us/motherlode-ourzo/motherlode-ourzo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The End of a Week of Cooking, and a Weekend Plan', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rosenstrach, Jennifer Lee', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-12T16:13:09+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'U.S.', 'byline': {'original': 'By Jenny Rosenstrach', 'person': [{'firstname': 'Jenny', 'middlename': None, 'lastname': 'Rosenstrach', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5c185054-9800-5708-b0b5-5a55e5a9c957', 'word_count': 804, 'uri': 'nyt://article/5c185054-9800-5708-b0b5-5a55e5a9c957'}, {'abstract': 'From the International Herald Tribune archives: East Berliners flocked to see Martin Luther King Jr. in 1964.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/09/12/1964-dr-king-in-east-berlin/', 'snippet': 'From the International Herald Tribune archives: East Berliners flocked to see Martin Luther King Jr. in 1964.', 'lead_paragraph': 'WEST BERLIN — The Rev. Martin Luther King Jr. filled two churches to overflowing in Communist East Berlin today [Sept. 13]. So many East Berliners showed up to hear him deliver a sermon tonight in the Marienkirche, Berlin’s oldest Protestant church, that a second sermon was arranged in another church. Both talks stressed religious, rather than political, themes but in an obvious reference to the Communist-built wall that divides the city, Dr. King declared that “Christian love will overcome all man-made barriers.” His crossing into East Berlin was easier than most. When he arrived at the border, he realized be had forgotten his passport. But police at the Checkpoint Charlie crossing point recognized him and allowed him in without it. At a press conference, he had some sharp words for Republican presidential candidate Sen. Barry Goldwater. His election would bring dangerous signs of Hitlerism, he predicted. — New York Herald Tribune, European Edition, Sept. 13, 1964', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/blogs/14iht-old15-mlk/14iht-old15-mlk-articleLarge.png', 'height': 396, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/14/blogs/14iht-old15-mlk/14iht-old15-mlk-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 396}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/blogs/14iht-old15-mlk/14iht-old15-mlk-jumbo.png', 'height': 676, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'ima