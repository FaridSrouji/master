/09/16/business/16bits-ycombinator/16bits-ycombinator-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/16/business/16bits-ycombinator/16bits-ycombinator-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Y Combinator, a Start-Up Incubator, Goes to College', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Start-ups', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Stanford University', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Y Combinator', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-16T17:00:46+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Mike Isaac', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Isaac', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2ce9455c-b7d0-5d5f-829d-2889ce77d479', 'word_count': 537, 'uri': 'nyt://article/2ce9455c-b7d0-5d5f-829d-2889ce77d479'}, {'abstract': 'In a blow to Gov. Andrew M. Cuomo’s bridge plan, the agency denied most of a $511 million request, saying it was not for environmental use.', 'web_url': 'https://www.nytimes.com/2014/09/17/nyregion/epa-rejects-most-of-511-million-loan-for-tappan-zee-project.html', 'snippet': 'In a blow to Gov. Andrew M. Cuomo’s bridge plan, the agency denied most of a $511 million request, saying it was not for environmental use.', 'lead_paragraph': 'In a significant blow to Gov. Andrew M. Cuomo’s plan for financing a new Tappan Zee Bridge, the federal Environmental Protection Agency on Tuesday rejected most of New York State’s request for a $511 million low-interest loan to help pay for the project, saying the state had planned to use the money almost entirely for construction, rather than its required purpose: enhancing the environment.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/nyregion/TAPPANZEEweb/TAPPANZEEweb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/17/nyregion/TAPPANZEEweb/TAPPANZEEweb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/nyregion/TAPPANZEEweb/TAPPANZEEweb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/nyregion/TAPPANZEEweb/TAPPANZEEweb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/nyregion/TAPPANZEEweb/TAPPANZEEweb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/17/nyregion/TAPPANZEEweb/TAPPANZEEweb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/17/nyregion/TAPPANZEEweb/TAPPANZEEweb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'E.P.A. Cuts Size of Loan New York Sought for Tappan Zee Bridge', 'kicker': None, 'content_kicker': None, 'print_headline': 'E.P.A. Cuts Size of Loan State Sought for Bridge', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Berger, Joseph', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Tappan Zee Bridge', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Clean Water Act', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-16T17:15:06+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joseph Berger', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'Berger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/949edd3e-be32-5563-a08c-41cfb57b2713', 'word_count': 1254, 'uri': 'nyt://article/949edd3e-be32-5563-a08c-41cfb57b2713'}, {'abstract': 'Claudette, a French restaurant just north of Washington Square Park in Greenwich Village, takes its place in New York’s Gallic revival.', 'web_url': 'https://www.nytimes.com/2014/09/17/dining/restaurant-review-claudette-in-greenwich-village.html', 'snippet': 'Claudette, a French restaurant just north of Washington Square Park in Greenwich Village, takes its place in New York’s Gallic revival.', 'lead_paragraph': 'The age of French dining in New York that blossomed in the unpromising soil of the Corona ash dumps during the 1939 World’s Fair, at the French Pavilion’s restaurant, seemed to come to its close about 10 years ago as mastodons like Lutèce lumbered into the fossil record. Today, that seems less like the end of an epoch than a salutary cooling-off period. ', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Inside a Souvenir From France', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside a Souvenir From France', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Claudette (Manhattan, NY, Restaurant)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich Village (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-16T17:19:58+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Pete Wells', 'person': [{'firstname': 'Pete', 'middlename': None, 'lastname': 'Wells', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/92474b7d-fb72-592f-a7e2-246a436016a6', 'word_count': 993, 'uri': 'nyt://article/92474b7d-fb72-592f-a7e2-246a436016a6'}, {'abstract': 'Mr. Mitchell, a founder of the Dance Theater of Harlem, and Mr. Davis, the founder of the DanceAfrica festival, will be recognized for their contributions to the world of dance.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/09/16/bessie-awards-to-honor-arthur-mitchell-and-chuck-davis/', 'snippet': 'Mr. Mitchell, a founder of the Dance Theater of Harlem, and Mr. Davis, the founder of the DanceAfrica festival, will be recognized for their contributions to the world of dance.', 'lead_paragraph': 'Arthur Mitchell, a founder of Dance Theater of Harlem and Chuck Davis, the founder of DanceAfrica, will be honored at the 30th annual Bessie Award ceremony on Oct. 20 at the Apollo Theater, officials announced. Mr. Mitchell will receive an award for\xa0lifetime achievement in dance and Mr. Davis will receive an award for outstanding\xa0service to the field of dance.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bessie Awards to Honor Arthur Mitchell and Chuck Davis', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'New York Dance and Performance Awards (Bessies)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Chuck', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mitchell, Arthur', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-16T17:20:13+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4988763e-3628-5628-9a6d-3cab36bfacd1', 'word_count': 240, 'uri': 'nyt://article/4988763e-3628-5628-9a6d-3cab36bfacd1'}, {'abstract': 'A judge has given an extension of 60 days to the grand jury considering whether to indict Darren Wilson, the Ferguson, Mo., police officer who killed Michael Brown, 18.', 'web_url': 'https://www.nytimes.com/2014/09/17/us/darren-wilson-ferguson-grand-jury-given-more-time.html', 'snippet': 'A judge has given an extension of 60 days to the grand jury considering whether to indict Darren Wilson, the Ferguson, Mo., police officer who killed Michael Brown, 18.', 'lead_paragraph': 'A judge has given an extension of 60 days to the grand jury considering whether to indict Darren Wilson, the Ferguson, Mo., police officer who killed Michael Brown, 18. The jury must decide by Jan. 7 whether Officer Wilson, who is white, will be criminally charged in the death of Mr. Brown, who was black and unarmed.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Grand Jury in Michael Brown Shooting Gets More Time', 'kicker': None, 'content_kicker': None, 'print_headline': 'Missouri: Grand Jury Gets Extension in Ferguson Case', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Ferguson (Mo)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Michael (1996-2014)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, Darren (1986- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Racial Profiling', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-09-16T17:30:52+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e0685c7-9abe-51b4-b067-6a4e34e11480', 'word_count': 192, 'uri': 'nyt://article/1e0685c7-9abe-51b4-b067-6a4e34e11480'}, {'abstract': 'More and more artful, and art-filled, hotels are popping up across the globe, blurring the lines between culture and accommodation.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/09/16/london-hotels-with-art-sculpture-gormley/', 'snippet': 'More and more artful, and art-filled, hotels are popping up across the globe, blurring the lines between culture and accommodation.', 'lead_paragraph': 'Hotels dotted with paintings and prints are hardly rare, but taking a cue from “Al’s Grand Hotel” — Allen Ruppersberg’s bookable, seven-room installation, which popped up on Sunset Boulevard for six weeks in 1971 and was restaged at this year’s Frieze New York — more and more properties are blurring the lines between artwork and accommodation. The 21c Museum Hotel in Louisville, Ky., recently commissioned Jonah Freeman and Justin Lowe to create “Asleep in the Cyclone,” an immersive “architectural collage” that doubles as a 500-square-foot guest room. Everything inside (from the geodesic-domed ceiling to the fake books and magazines) has been created or curated by the American art duo to evoke a ’60s-era hippie commune. Across the pond, one of the suites at the Beaumont in London — set to launch this fall in the Mayfair district as the first hotel from the restaurateurs behind the Wolseley and Brasserie Zédel — has been designed by Antony Gormley as a three-level “inhabitable sculpture.” Featuring fumed-oak interiors, the conjoined cubes of stainless steel mimic the British artist’s own body, a recurring theme in his work. Next spring, Living Architecture plans to unveil “A House for Essex” in the U.K., designed by the Turner Prize winner Grayson Perry in collaboration with the architecture firm FAT. With its ceramic-tile facade and aluminum roof sculptures, not to mention the handmade tapestries and artworks inspired by a fictional local character, it looks like something out of a fairy tale. ', 'print_section': 'M2', 'print_page': '44', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/28/t-magazine/28design-look-hotel/28design-look-hotel-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/28/t-magazine/28design-look-hotel/28design-look-hotel-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/28/t-magazine/28design-look-hotel/28design-look-hotel-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/28/t-magazine/28design-look-hotel/28design-look-hotel-superJumbo.j