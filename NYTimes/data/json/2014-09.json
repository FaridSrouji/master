up-hagan/25up-hagan-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/25/upshot/25up-hagan/25up-hagan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/25/upshot/25up-hagan/25up-hagan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/25/upshot/25up-hagan/25up-hagan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kay Hagan’s Surprising Strength', 'kicker': 'Midterm Calculus', 'content_kicker': None, 'print_headline': 'In North Carolina, Kay Hagan Shows Surprising Strength', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cohn, Nate', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hagan, Kay R', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tillis, Thomas R', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Midterm Elections (2014)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-09-25T04:30:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'The Upshot', 'byline': {'original': 'By Nate Cohn', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Cohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8f9f02f7-4366-5bdf-972b-c8850927a884', 'word_count': 1067, 'uri': 'nyt://article/8f9f02f7-4366-5bdf-972b-c8850927a884'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/09/25/arts/television/whats-on-tv-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '10 P.M. (ABC) HOW TO GET AWAY WITH MURDER This latest entry from ShondaLand — Shonda Rhimes’s production company — to join ABC’s Thursday night lineup stars the Oscar-nominated Viola Davis as Annalise Keating, an intimidating law professor at a Philadelphia college, the likes of whom hasn’t been seen since Prof. Charles Kingsfield (John Houseman) caused the knees of aspiring legal eagles to knock in “The Paper Chase.” Aja Naomi King, Alfred Enoch, Jack Falahee, Karla Souza and Matt McGorry play Keating’s prized pupils, first seen toting a dead body in a rug around campus. Peter Nowalk created this series, which shuttles between the past and present as, thread by thread, it unravels who did what and why. In “Grey’s Anatomy,” leading in at 8, Meredith (Ellen Pompeo) seeks to regain control of her life as a new doctor (Kelly McCreary) comes on board and Derek (Patrick Dempsey) pushes to move to Washington. And in “Scandal,” at 9, Fitz (Tony Goldwyn) begins his second term in the White House determined to make a positive impact on the country; Mellie (Bellamy Young) copes with the loss of her son; and everybody tries to figure out where Olivia (Kerry Washington) and Jake (Scott Foley) have run off to.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Thursday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-09-25T05:00:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn S