: None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/42d64666-6625-5063-a59c-35ff4c6836a3', 'word_count': 571, 'uri': 'nyt://article/42d64666-6625-5063-a59c-35ff4c6836a3'}, {'abstract': 'Susanna Malkki has been named music director of the Helsinki Philharmonic Orchestra.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/09/03/finnish-conductor-will-be-first-woman-to-lead-helsinki-philharmonic/', 'snippet': 'Susanna Malkki has been named music director of the Helsinki Philharmonic Orchestra.', 'lead_paragraph': 'Susanna Malkki, a Finnish conductor who has appeared often in New York and has made a powerful impression in both new music and the standard repertory, has been appointed chief conductor of the Helsinki Philharmonic Orchestra, the orchestra announced. She will be the first female music director of the orchestra, which was founded in 1882 and describes itself as the first professional symphony orchestra founded in the Nordic countries.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Finnish Conductor Will Be First Woman to Lead Helsinki Philharmonic', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Malkki, Susanna', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Helsinki Philharmonic Orchestra', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Opera', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Finland', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-03T16:03:26+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/83ff3ba0-573e-5eb9-9923-d672f1ca1f29', 'word_count': 256, 'uri': 'nyt://article/83ff3ba0-573e-5eb9-9923-d672f1ca1f29'}, {'abstract': 'Ms. Sanders previously worked as president and chief executive officer of Fairchild Fashion Media, which Condé Nast sold to Penske Media last month.', 'web_url': 'https://www.nytimes.com/2014/09/04/business/media/gina-sanders-named-president-of-global-development-at-conde-nast.html', 'snippet': 'Ms. Sanders previously worked as president and chief executive officer of Fairchild Fashion Media, which Condé Nast sold to Penske Media last month.', 'lead_paragraph': 'After a summer of major changes at Condé Nast, the magazine publisher has created a new role for a longtime executive, Gina Sanders, who will become president of the company’s global development.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gina Sanders Named President of Global Development at Condé Nast', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Conde Nast Publications Inc', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-09-03T16:04:17+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Christine Haughney', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Haughney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id'