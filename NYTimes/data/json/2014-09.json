rank': 2, 'major': 'N'}], 'pub_date': '2014-09-08T00:59:35+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'subsection_name': "Women's Runway", 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/e1a4fb83-60ef-54c9-8888-8630229cf52b', 'word_count': 0, 'uri': 'nyt://slideshow/e1a4fb83-60ef-54c9-8888-8630229cf52b'}, {'abstract': 'Mr. David, Stephen Sondheim and Phil Jackson will appear in conversation with contributors to The New Yorker, organizers announced on Sunday.', 'web_url': 'https://www.nytimes.com/2014/09/08/arts/new-yorker-festival-to-feature-larry-david.html', 'snippet': 'Mr. David, Stephen Sondheim and Phil Jackson will appear in conversation with contributors to The New Yorker, organizers announced on Sunday.', 'lead_paragraph': 'Quintessential New Yorkers lead the lineup for next month’s New Yorker Festival. The Manhattanites Larry David, Stephen Sondheim and Phil Jackson will appear in conversation with contributors to The New Yorker, organizers announced on Sunday. Mr. David, who is making his Broadway debut in “Fish in the Dark”  in March, will be paired with the editor of The New Yorker, David Remnick. “I think we’re going to do an in-depth discussion of ‘Palestinian Chicken,’  which is maybe the best episode of sitcom TV ever,” Mr. Remnick said in a phone interview, referring to a 2011 installment of “Curb Your Enthusiasm.” The festival, taking place Oct. 10 to 12, will also feature the films “Listen Up Philip,” directed by Alex Ross Perry, and “The Humbling,” directed by Barry Levinson; both directors will attend. Musical performers include Randy Newman and Sharon Van Etten. In addition, Edward J. Snowden and Ai Weiwei are scheduled to join via live stream and answer audience questions. More information is available at newyorker.com/festival; tickets go on sale Friday at noon online and at the School of Visual Arts theater box office in Chelsea.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Yorker Festival to Feature Larry David', 'kicker': None, 'content_kicker': None, 'print_headline': 'New Yorker Festival to Feature Larry David', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New Yorker Festival', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'David, Larry', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sondheim, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson, Phil (1945- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New Yorker', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-08T01:00:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Andrew R. Chow', 'person': [{'firstname': 'Andrew', 'middlename': 'R.', 'lastname': 'Chow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/062b7acd-8fcc-5a58-90a4-83059170aa57', 'word_count': 186, 'uri': 'nyt://article/062b7acd-8fcc-5a58-90a4-83059170aa57'}, {'abstract': 'At an Arab League gathering, President Mahmoud Abbas accused Islamists of running a shadow government in Gaza despite a reconciliation pact with his Fatah faction.', 'web_url': 'https://www.nytimes.com/2014/09/08/world/middleeast/gaza-strip-palestinian-leader-assails-hamas-calling-unity-pact-into-question.html', 'snippet': 'At an Arab League gathering, President Mahmoud Abbas accused Islamists of running a shadow government in Gaza despite a reconciliation pact with his Fatah faction.', 'lead_paragraph': 'JERUSALEM — President Mahmoud Abbas of the Palestinian Authority lambasted his faction’s longtime rival, Hamas, at a meeting of the Arab League over the weekend, deepening doubts about the durability of their reconciliation pact and pote