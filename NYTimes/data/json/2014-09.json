ank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/132f867e-e608-5474-9c16-9867713c5cb7', 'word_count': 671, 'uri': 'nyt://article/132f867e-e608-5474-9c16-9867713c5cb7'}, {'abstract': 'When children are off to boarding school, some parents are staying connected by buying homes nearby.', 'web_url': 'https://www.nytimes.com/times-insider/2014/09/17/notes-on-a-new-micro-trend-among-affluent-parents/', 'snippet': 'When children are off to boarding school, some parents are staying connected by buying homes nearby.', 'lead_paragraph': 'Penelope Green, a Home section correspondent, writes about parents who buy second homes in order to be closer to their children at boarding schools. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tracking a Microtrend Among Affluent Parents', 'kicker': 'Times Insider', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Penelope', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Deerfield Academy', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-17T22:44:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Penelope Green', 'person': [{'firstname': 'Penelope', 'middlename': None, 'lastname': 'Green', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e649ddb-bae5-548a-8c8d-085bf62afa5f', 'word_count': 359, 'uri': 'nyt://article/4e649ddb-bae5-548a-8c8d-085bf62afa5f'}, {'abstract': 'Too many black parents believe beatings make kids better people.', 'web_url': 'https://www.nytimes.com/2014/09/18/opinion/punishment-or-child-abuse.html', 'snippet': 'Too many black parents believe beatings make kids better people.', 'lead_paragraph': 'WASHINGTON — THE indictment last week of the N.F.L. player Adrian Peterson by a Texas grand jury for reckless or negligent injury to a child has set into relief the harmful disciplinary practices of some black families. Mr. Peterson used a “switch,” a slim, leafless tree branch, to beat his 4-year-old son, raising welts on the youngster’s legs, buttocks and scrotum. This is child abuse dressed up as acceptable punishment. ', 'print_section': 'A', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Dyson-Michael-Eric-circular/Dyson-Michael-Eric-circular-articleLarge-v3.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/03/16/opinion/Dyson-Michael-Eric-circular/Dyson-Michael-Eric-circular-articleLarge-v3.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Dyson-Michael-Eric-circular/Dyson-Michael-Eric-circular-jumbo-v3.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Dyson-Michael-Eric-circular/Dyson-Michael-Eric-circular-superJumbo-v3.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/03/16/opinion/Dyson-Michael-Eric-circular/Dyson-Michael-Eric-circular-thumbStandard-v3.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/03/16/opinion/Dyson-Michael-Eric-circular/Dyson-Michael-Eric-circular-thumbStandard-v3.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumb