k': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SHORT/0907-BKS-SHORT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/0907-BKS-SHORT/0907-BKS-SHORT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SHORT/0907-BKS-SHORT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Medical Memoirs', 'kicker': 'The Shortlist', 'content_kicker': None, 'print_headline': 'Medical Memoirs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ofri, Danielle', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Holt, Terrence', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Marks, Paul A', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Melinek, Judy', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Mitchell, T J', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Sterngold, James', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-09-05T14:47:55+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Danielle Ofri', 'person': [{'firstname': 'Danielle', 'middlename': None, 'lastname': 'Ofri', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b3f247d-f50b-5896-8fb1-7b3e2e901a0b', 'word_count': 950, 'uri': 'nyt://article/1b3f247d-f50b-5896-8fb1-7b3e2e901a0b'}, {'abstract': 'Firearm ads come and go as political staccato punctuating the electioneering season.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/09/05/brandishing-a-gun-to-woo-voters/', 'snippet': 'Firearm ads come and go as political staccato punctuating the electioneering season.', 'lead_paragraph': '“They call me a long shot,” Estakio Beltran, a congressional candidate in Washington state, declares in a TV ad, never once disclosing that he’s a Democrat but taking aim with his shotgun at a piñata — an elephant piñata in case anyone doubts what he’s gunning for. Bam! the gun goes off and the sad-eyed, paper-tattered toy elephant topples. Mr. Beltran’s ad is one of many bamming and kerpowing across the land from candidates pandering to gun enthusiasts. He may not win an election, but his seems the most entertaining or at least the silliest. Particularly so when he racks the empty shell from his gun in macho triumph and rides off like Clint Eastwood, heading east toward the Capitol on a loping donkey (a Democratic donkey?).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Brandishing a Gun to Woo Voters', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-05T14:48:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Francis X. Clines', 'person': [{'firstname': 'Francis', 'middlename': 'X.', 'lastname': 'Clines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/012f5512-31a6-5006-a5f6-19b515fd30d3', 'word_count': 484, 'uri': 'nyt://article/012f5512-31a6-5006-a5f6-19b515fd30d3'}, {'abstract': 'Matthew Thomas, who earned two master’s degrees in writing, says the workshop environment “serves its purpose and then you have to move on.”', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/getting-to-the-heart-of-things.html', 'snippet': 'Matthew Thomas, who earned two master’s degrees in writing, says the workshop environment “serves its purpose and then you have to move on.”', 'lead_paragraph': 'Matthew Thomas’s debut novel, “We Are Not Ourselves,” is reviewed this week by Maggie Scarf.', 'print_section': 'BR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07OPENBOOK/07OPENBOOK-articleLarge.jpg', 'height': 289, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/books/review/07OPENBOOK/07OPENBOOK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 289}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07OPENBOOK/07OPENBOOK-jumbo.jpg', 'height': 493, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07OPENBOOK/07OPENBOOK-superJumbo.jpg', 'height': 987, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07OPENBOOK/07OPENBOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/07OPENBOOK/07OPENBOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07OPENBOOK/07OPENBOOK-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Getting to the Heart of Things', 'kicker': 'Open Book', 'content_kicker': None, 'print_headline': 'Getting to the Heart of Things', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-09-05T14:48:17+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/303f6b04-2891-5026-966f-8829cc6a4c6c', 'word_count': 460, 'uri': 'nyt://article/303f6b04-2891-5026-966f-8829cc6a4c6c'}, {'abstract': 'This first novel probes the lives of three generations of an Irish-American family in the 20th century.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/we-are-not-ourselves-by-matthew-thomas.html', 'snippet': 'This first novel probes the lives of three generations of an Irish-American family in the 20th century.', 'lead_paragraph': 'As a young woman training for a graduate degree in nursing administration, Eileen Tumulty longs for the day when she will marry and take another name. It’s the thoroughgoing Irishness of Tumulty, with its redolence of “peat bogs and sloppy rebel songs” and deep defeat, from which she yearns to detach herself. She wants the sort of bland, decorous WASP name that will label her as an unhyphenated American. Bright, attractive and strong-willed, Eileen is passionately ambitious, determined to shake off the poverty-haunted, alcohol-ridden atmosphere of her childhood and achieve not only wealth and comfort but a sense of belonging. Shame is the deeply buried force that drives her.', 'print_section': 'BR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SCARF/0907-BKS-SCARF-articleLarge.jpg', 'height': 627, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/books/review/0907-BKS-SCARF/0907-BKS-SCARF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 627}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SCARF/0907-BKS-SCARF-jumbo.jpg', 'height': 689, 'width': 659, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SCARF/0907-BKS-SCARF-superJumbo.jpg', 'height': 689, 'width': 659, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SCARF/0907-BKS-SCARF-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/0907-BKS-SCARF/0907-BKS-SCARF-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SCARF/0907-BKS-SCARF-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Family Circle', 'kicker': None, 'content_kicker': None, 'print_headline': 'Family Circle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'We Are Not Ourselves (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Thomas, Matthew A (1975- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-05T14:48:24+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Maggie Scarf', 'person': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'Scarf', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3a80a60a-5242-5d31-b0bc-df04d1f7f60a', 'word_count': 603, 'uri': 'nyt://article/3a80a60a-5242-5d31-b0bc-df04d1f7f60a'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'REIGN OF ERROR: The Hoax of the Privatization Movement and the Danger to America’s Public Schools,  by Diane Ravitch. (Vintage, $16.95.) In her influential 2010 book, “The Death and Life of the Great American School System,” Ravitch joined the vocal opposition to school choice and testing. In “Reign of Error,” she focuses more directly, and polemically, on the attempt to replace public schools with a free-market system, which she argues has fed on the myth that schools are failing.', 'print_section': 'BR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paperback Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-09-05T14:50:06+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/3fe56777-e191-5d12-a1e7-18ab48b654ae', 'word_count': 493, 'uri': 'nyt://article/3fe56777-e191-5d12-a1e7-18ab48b654ae'}, {'abstract': 'Recently reviewed books of particular interest.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/editors-choice.html', 'snippet': 'Recently reviewed books of particular interest.', 'lead_paragraph': 'THE BONE CLOCKS,  by David Mitchell. (Random House, $30.) In this latest head-spinning flight into other dimensions from the author of “Cloud Atlas,” all borders between pubby England and the machinations of the undead begin to blur.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Editors’ Choice | Recent Books of Particular Interest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-09-05T14:50:31+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/ae1ac1fb-6b27-5e4d-969f-9eed0c9cdd85', 'word_count': 253, 'uri': 'nyt://article/ae1ac1fb-6b27-5e4d-969f-9eed0c9cdd85'}, {'abstract': 'With Ebola back in the news, readers are returning to Richard Preston’s scientific adventure story “The Hot Zone,” which is No. 17 on the paperback nonfiction list.', 'web_url': 'https://www.nytimes.com/2014/09/14/books/review/inside-the-list.html', 'snippet': 'With Ebola back in the news, readers are returning to Richard Preston’s scientific adventure story “The Hot Zone,” which is No. 17 on the paperback nonfiction list.', 'lead_paragraph': 'Going Viral: Twenty years ago, Richard Preston scored a nonfiction hit with his scientific adventure story “The Hot Zone,” about an outbreak of Ebola virus among quarantined monkeys in Virginia — the book spent almost two years on the hardcover and paperback lists before fading away in June 1996. (That was a good time for science journalism. During its run, Preston’s book shared space on the list with Oliver Sacks’s collection of neurological case studies “An Anthropologist on Mars” and Nicholas Negroponte’s technology primer “Being Digital,” which predicted the end of fax machines and CD-ROMs.) Now, with Ebola back in the news because of its fatal spread through West Africa, readers are returning to “The Hot Zone.” The Associated Press reported last month that Anchor Books, the paperback publisher, had printed 70,000 new copies, and the book is currently at No. 17 in its 50th week on the paperback nonfiction list. “The thing is,” Preston told CNN early in August, “Ebola has been pulling surprises on all of us. I don’t think anybody really expected that Ebola had the potential to do something like get into the cities and get out of control. But, you know, most of the experts I’m talking to are saying that they are pretty well convinced that, you know, they will be able to get it under control, but there’s huge concern about the possibility that Ebola could get into a major city.” The virus’s return is obviously bad news. But it does retroactively absolve “The Hot Zone” of a charge Colin Harrison leveled against it in the Book Review a few years after its publication. “The outbreak in Virginia resulted in exactly zero human cases,” Harrison noted, complaining about the “happy frenzy” of media attention the story had received. “It was the first time that everyone knew about a disease that nobody had. It was the first time that a virus was famous for being famous.” Now we know we were right to panic.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07preston/07preston-jumbo.jpg', 'height': 450, 'width': 454, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07preston/07preston-superJumbo.jpg', 'height': 450, 'width': 454, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07preston/07preston-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/07preston/07preston-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07preston/07preston-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-09-05T14:51:33+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/644fa42c-72f6-5b7a-be0e-9ed67212c321', 'word_count': 489, 'uri': 'nyt://article/644fa42c-72f6-5b7a-be0e-9ed67212c321'}, {'abstract': 'The third novel in Elena Ferrante’s Neapolitan series tracks a long and complicated friendship.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/elena-ferrantes-those-who-leave-and-those-who-stay.html', 'snippet': 'The third novel in Elena Ferrante’s Neapolitan series tracks a long and complicated friendship.', 'lead_paragraph': 'Elena Ferrante is one of the great novelists of our time. Her voice is passionate, her view sweeping and her gaze basilisk. Her subject is the domestic world, and part of her genius lies in her capacity to turn this sphere into an infernal region, full of rage and violence, unlimited in its intellectual and emotional reach. Ferrante’s view of family life is anything but sentimental, anything but comforting. ', 'print_section': 'BR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-ROBINSON/0907-BKS-ROBINSON-articleLarge-v2.jpg', 'height': 301, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/books/review/0907-BKS-ROBINSON/0907-BKS-ROBINSON-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 301}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-ROBINSON/0907-BKS-ROBINSON-jumbo-v2.jpg', 'height': 514, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-ROBINSON/0907-BKS-ROBINSON-superJumbo-v2.jpg', 'height': 808, 'width': 1609, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-ROBINSON/0907-BKS-ROBINSON-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/0907-BKS-ROBINSON/0907-BKS-ROBINSON-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-ROBINSON/0907-BKS-ROBINSON-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Between Women', 'kicker': None, 'content_kicker': None, 'print_headline': 'Between Women', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Those Who Leave and Those Who Stay (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ferrante, Elena', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Goldstein, Ann (1949- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-05T14:53:00+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Roxana Robinson', 'person': [{'firstname': 'Roxana', 'middlename': None, 'lastname': 'Robinson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3e2d651c-e12e-5ea4-87f2-e5f5c6537998', 'word_count': 1021, 'uri': 'nyt://article/3e2d651c-e12e-5ea4-87f2-e5f5c6537998'}, {'abstract': 'Diane Ackerman surveys the technology and innovations that define our human-dominated epoch.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/the-human-age-by-diane-ackerman.html', 'snippet': 'Diane Ackerman surveys the technology and innovations that define our human-dominated epoch.', 'lead_paragraph': 'For the first time in history, a sentient species, Homo sapiens, has become a force of such magnitude that our impacts are being written into the fossil record. We have decisively changed the carbon cycle, the nitrogen cycle and the rate of extinction. We have created \xadnew atomic isotopes and plastiglomerates that may persist for millions of years. We have built mega\xadcities that will leave a durable footprint long after they have vanished. We have altered the pH of the oceans and have moved so many life-forms around the globe — inadvertently and \xadintentionally — that we are creating novel ecosystems everywhere. Since the late-18th-century industrialization that marks the Anthropocene’s beginnings, humans have \xadshaken Earth’s life systems with a profundity that the paleontologist Anthony Barnosky has likened to an asteroid strike. ', 'print_section': 'BR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-NIXON/0907-BKS-NIXON-articleLarge.jpg', 'height': 585, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/books/review/0907-BKS-NIXON/0907-BKS-NIXON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 585}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-NIXON/0907-BKS-NIXON-jumbo.jpg', 'height': 998, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-NIXON/0907-BKS-NIXON-superJumbo.jpg', 'height': 1647, 'width': 1690, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-NIXON/0907-BKS-NIXON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/0907-BKS-NIXON/0907-BKS-NIXON-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-NIXON/0907-BKS-NIXON-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Future Footprints', 'kicker': None, 'content_kicker': None, 'print_headline': 'Future Footprints', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'ACKERMAN, DIANE', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-05T14:53:29+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Rob Nixon', 'person': [{'firstname': 'Rob', 'middlename': None, 'lastname': 'Nixon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a523d4a8-1462-5f28-81c6-a0f039e32cc4', 'word_count': 1145, 'uri': 'nyt://article/a523d4a8-1462-5f28-81c6-a0f039e32cc4'}, {'abstract': 'Sex and cruelty are tools a 14-year-old uses to cope with a devastatingly irresponsible father in 1970s Greenwich Village.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/rainey-royal-by-dylan-landis.html', 'snippet': 'Sex and cruelty are tools a 14-year-old uses to cope with a devastatingly irresponsible father in 1970s Greenwich Village.', 'lead_paragraph': 'It seems endemic to the enterprise that fiction writers must fall good and hard for their characters — how else could we stand to live with them for weeks, months, years, in sometimes tortuous isolation? As in marriage or a long affair, this abiding attraction can twist and turn into revulsion or obsession. It can also wax and wane. The writer can stray and then beg for forgiveness, banging on a shut door to be let back inside. In conjuring “The Adventures of Tom Sawyer,” Mark Twain became captivated by Huckleberry Finn, Tom’s “idle and lawless and vulgar and bad” sidekick, so much so that Twain rode Huck on to glory with his subsequent masterpiece. J. D. Salinger’s beloved Holden Caulfield appeared in several stories, both published and unpublished, before he found his home in “The Catcher in the Rye.” And, as any fan knows, Salinger had a hell of a time kicking the Glass family to the curb; its members own or make appearances in all three of Salinger’s story collections, as well as in new collections (fingers crossed) that are rumored to be \xadforthcoming. ', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SHULMAN/0907-BKS-SHULMAN-articleLarge.jpg', 'height': 498, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/books/review/0907-BKS-SHULMAN/0907-BKS-SHULMAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 498}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SHULMAN/0907-BKS-SHULMAN-jumbo.jpg', 'height': 850, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SHULMAN/0907-BKS-SHULMAN-superJumbo.jpg', 'height': 1169, 'width': 1409, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SHULMAN/0907-BKS-SHULMAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/0907-BKS-SHULMAN/0907-BKS-SHULMAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/0907-BKS-SHULMAN/0907-BKS-SHULMAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Girlhood Gone', 'kicker': None, 'content_kicker': None, 'print_headline': 'Girlhood Gone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Rainey Royal (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Landis, Dylan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-05T14:54:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Helen Schulman', 'person': [{'firstname': 'Helen', 'middlename': None, 'lastname': 'Schulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/05ced793-3da0-5a1d-93e7-e4c522a65efa', 'word_count': 1375, 'uri': 'nyt://article/05ced793-3da0-5a1d-93e7-e4c522a65efa'}, {'abstract': 'A Brooklyn-based narrator preoccupied with identity decides to help his best friend have a child.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/1004-by-ben-lerner.html', 'snippet': 'A Brooklyn-based narrator preoccupied with identity decides to help his best friend have a child.', 'lead_paragraph': 'Early in “10:04,” Ben Lerner’s frequently brilliant second novel, the central character — a refraction or avatar of this \xadBrooklyn-based author — describes visiting the Metropolitan Museum with a female friend: “We often visited weekday afternoons, since Alex was unemployed, and I, a writer.” Together they look at a melodramatic 19th-century genre painting of Joan of Arc, which the narrator claims is one of his favorite pictures. Lerner uses the strikingly unlovely word “coconstructed” to describe the shared nature of their experience: “We would work out our views as we coconstructed the literal view before us.” A few paragraphs on, he and an 8-year-old boy are seen “coconstructing a shoe-box diorama.” Later he can be found letting an Occupy protester shower in his apartment, wondering if it’s possible to “coconstruct a world in which moments can be something other than the elements of profit.”', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/28/books/review/0907-BKS-KUNZRU/0907-BKS-KUNZRU-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/28/books/review/0907-BKS-KUNZRU/0907-BKS-KUNZRU-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/28/books/review/0907-BKS-KUNZRU/0907-BKS-KUNZRU-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/28/books/review/0907-BKS-KUNZRU/0907-BKS-KUNZRU-superJumbo.jpg', 'height': 1499, 'width': 1499, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/28/books/review/0907-BKS-KUNZRU/0907-BKS-KUNZRU-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/28/books/review/0907-BKS-KUNZRU/0907-BKS-KUNZRU-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/28/books/review/0907-BKS-KUNZRU/0907-BKS-KUNZRU-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Impossible Mirrors', 'kicker': None, 'content_kicker': None, 'print_headline': 'Impossible Mirrors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': '10:04 (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lerner, Ben', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-05T14:54:36+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Hari Kunzru', 'person': [{'firstname': 'Hari', 'middlename': None, 'lastname': 'Kunzru', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/93f721f0-fe3e-5484-867a-828fe47d3eb8', 'word_count': 1236, 'uri': 'nyt://article/93f721f0-fe3e-5484-867a-828fe47d3eb8'}, {'abstract': 'A fictional memoir narrated by Estebanico, a Moroccan slave and the first black explorer of America.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/the-moors-account-by-laila-lalami.html', 'snippet': 'A fictional memoir narrated by Estebanico, a Moroccan slave and the first black explorer of America.', 'lead_paragraph': 'In 1527, the Castilian conquistador Pánfilo de Narváez and a crew of 600 men sailed from Spain to the Gulf Coast of the United States to claim “La Florida” for the Spanish crown. Laila Lalami recounts the voyage — and its brutal aftermath — in her new novel, “The Moor’s Account,” from the perspective of Estebanico, a \xadMoroccan slave of one of the explorers. It’s a fictional memoir, told in a controlled voice that feels at once historical and contemporary, that seeks to offer a truer account of the expedition than the official (and hopelessly biased) version of events provided by Álvar Núñez Cabeza de Vaca, one of the other three survivors. ', 'print_section': 'BR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07ALLEN/07ALLEN-articleLarge-v2.jpg', 'height': 438, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/books/review/07ALLEN/07ALLEN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 438}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07ALLEN/07ALLEN-jumbo-v2.jpg', 'height': 748, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07ALLEN/07ALLEN-superJumbo-v2.jpg', 'height': 1496, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07ALLEN/07ALLEN-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/books/review/07ALLEN/07ALLEN-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07ALLEN/07ALLEN-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'His Manifest Destiny', 'kicker': None, 'content_kicker': None, 'print_headline': 'His Manifest Destiny', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lalami, Laila', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-05T14:55:18+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jeffery Renard Allen', 'person': [{'firstname': 'Jeffery', 'middlename': 'Renard', 'lastname': 'Allen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f03dd50d-ffdb-53e2-9c0a-867922b26afe', 'word_count': 1302, 'uri': 'nyt://article/f03dd50d-ffdb-53e2-9c0a-867922b26afe'}, {'abstract': 'A small town falters after an industrial disaster.', 'web_url': 'https://www.nytimes.com/2014/09/07/books/review/friendswood-by-rene-steinke.html', 'snippet': 'A small town falters after an industrial disaster.', 'lead_paragraph': 'A sinister oily sludge — improperly buried toxic waste reasserting itself — has wormed its way out of the ground in a small Texas town. Birth defects and cancer rates have soared; houses have been abandoned and razed. Now, years later, a peculiar collective amnesia has set in, and only one woman is still fighting the City Council, which has cleared the land for redevelopment, and the predictably sleazy real estate magnate who will profit from the job. ', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/books/review/07SOUTHWOOD/07SOUTHWOOD-articleLarge-v2.jpg', 'height': 877, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/books/review/07SOUTHWOOD/07SOUTHWOOD-articleLar