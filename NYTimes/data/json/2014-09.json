-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Union’s Fake Canadians', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Draft and Recruitment (Military)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-16T20:21:47+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Adam Arenson', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Arenson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74e67e3b-2cef-5c66-9c4b-6d9afd789954', 'word_count': 1378, 'uri': 'nyt://article/74e67e3b-2cef-5c66-9c4b-6d9afd789954'}, {'abstract': 'The companies won the competition to begin flights as early as 2017.', 'web_url': 'https://www.nytimes.com/2014/09/17/science/space/boeing-and-spacex-win-contracts-to-carry-americans-to-space-station.html', 'snippet': 'The companies won the competition to begin flights as early as 2017.', 'lead_paragraph': 'Boeing and the Sp