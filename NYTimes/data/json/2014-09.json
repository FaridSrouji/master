//article/d9ea9c3e-8405-5e17-af6a-1271bb397d00'}, {'abstract': 'A deal would create a combined company worth about $27.4 billion, roughly the same size as the Potash Corporation of Canada, the world’s largest fertilizer producer.', 'web_url': 'https://dealbook.nytimes.com/2014/09/23/fertilizer-makers-yara-and-cf-industries-discussing-merger-of-equals/', 'snippet': 'A deal would create a combined company worth about $27.4 billion, roughly the same size as the Potash Corporation of Canada, the world’s largest fertilizer producer.', 'lead_paragraph': 'Updated, 9:56 a.m. | ', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/business/dbpix-fertilizer/dbpix-fertilizer-articleLarge.png', 'height': 494, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/23/business/dbpix-fertilizer/dbpix-fertilizer-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 494}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/business/dbpix-fertilizer/dbpix-fertilizer-jumbo.png', 'height': 659, 'width': 801, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/business/dbpix-fertilizer/dbpix-fertilizer-superJumbo.png', 'height': 659, 'width': 801, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/business/dbpix-fertilizer/dbpix-fertilizer-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/23/business/dbpix-fertilizer/dbpix-fertilizer-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline'