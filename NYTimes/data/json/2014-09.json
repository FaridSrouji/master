ons', 'kicker': None, 'content_kicker': None, 'print_headline': 'A War Is Long Over, but Many Still Seek to Learn Its Lessons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Erlanger, Steven', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'MacMillan, Margaret O (1943- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'The War That Ended Peace: The Road to 1914 (Book)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-08T21:51:51+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Steven Erlanger', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Erlanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6f9b1dfe-ba9d-5ec2-9bcf-f9f781967c98', 'word_count': 1019, 'uri': 'nyt://article/6f9b1dfe-ba9d-5ec2-9bcf-f9f781967c98'}, {'abstract': 'Narciso Rodriguez has rocks from the birthplace of Aphrodite in his office. He talks to Vanessa Friedman about what else he collects for inspiration.', 'web_url': 'https://www.nytimes.com/video/fashion/100000003096000/in-the-studio-narciso-rodriguez.html', 'snippet': 'Narciso Rodriguez has rocks from the birthplace of Aphrodite in his office. He talks to Vanessa Friedman about what else he collects for inspiration.', 'lead_paragraph': 'Narciso Rodriguez has rocks from the birthplace of Aphrodite in his office. He talks to Vanessa Friedman about what else he collects for inspiration.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/05/multimedia/studio-narcisorodriguez/studio-narcisorodriguez-articleLarge.jpg', 'height': 338, 'w