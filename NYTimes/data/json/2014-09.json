ence/12moral/12moral-superJumbo.jpg', 'height': 254, 'width': 558, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/science/12moral/12moral-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/12/science/12moral/12moral-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/science/12moral/12moral-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In a Study, Text Messages Add Up to a Balance Sheet of Everyday Morality', 'kicker': None, 'content_kicker': None, 'print_headline': 'In a Study, Text Messages Add Up to a Balance Sheet of Everyday Morality', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Carey, Benedict', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Science (Journal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wisneski, Daniel C', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Brandt, Mark J', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Skitka, Linda J', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hofmann, Wilhelm', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-09-11T18:00:05+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'byline': {'original': 'By Benedict Carey', 'person': [{'firstname': 'Benedict', 'middlename': None, 'lastname': 'Carey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0cf32b9a-84f2-5890-8ee1-1b7018a29b28', 'word_count': 879, 'uri': 'nyt://article/0cf32b9a-84f2-5890-8ee1-1b7018a29b28'}, {'abstract': 'A model of the largest known predatory dinosaur, and the only dinosaur known to spend much of its life in water, will be displayed in Washington.', 'web_url': 'https://www.nytimes.com/2014/09/12/science/a-nomads-find-helps-solve-the-mystery-of-the-spinosaurus.html', 'snippet': 'A model of the largest known predatory dinosaur, and the only dinosaur known to spend much of its life in water, will be displayed in Washington.', 'lead_paragraph': 'The first bones came in a cardboard box. Nizar Ibrahim, a paleontologist, was in the Moroccan oasis town of Erfoud at the edge of the Sahara, returning from a dinosaur dig in the sands. Inside the box, brought to him by a nomad, were sediment-encrusted pieces more intriguing than anything he had found himself, including a blade-shaped bone with a reddish streak running through the cross section. He took the bones to a university in Casablanca.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/science/12dino-1/12dino-1-articleLarge.jpg', 'height': 188, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/12/science/12dino-1/12dino-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 188}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/science/12dino-1/12dino-1-jumbo.jpg', 'height': 322, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/science/12dino-1/12dino-1-superJumbo.jpg', 'height': 643, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 's