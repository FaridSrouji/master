 None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/99b1903e-2572-5bef-aa57-2d1e84f7c8ad', 'word_count': 146, 'uri': 'nyt://article/99b1903e-2572-5bef-aa57-2d1e84f7c8ad'}, {'abstract': 'New streams of Syrian refugees fled toward the border with Turkey as shelling hit the town of Kobani.', 'web_url': 'https://www.nytimes.com/2014/09/29/world/middleeast/refugees-flood-turkish-border-as-isis-steps-up-attacks-on-syrian-kurds.html', 'snippet': 'New streams of Syrian refugees fled toward the border with Turkey as shelling hit the town of Kobani.', 'lead_paragraph': 'MURSITPINAR, Turkey — Shelling intensified Sunday on Kobani, the Syrian town at the center of a region of Kurdish farming villages that has been under a weeklong assault by Islamic State militants, setting fire to buildings and driving a stream of new refugees toward the fence here at the border with Turkey.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/world/SYRIA/SYRIA-articleLarge-v3.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/29/world/SYRIA/SYRIA-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/world/SYRIA/SYRIA-jumbo-v3.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/world/SYRIA/SYRIA-superJumbo-v3.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/world/SYRIA/SYRIA-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/29/world/SYRIA/SYRIA-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/world/SYRIA/SYRIA-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Refugees Flood Turkish Border as Islamic State Steps Up Attacks on Syrian Kurds', 'kicker': None, 'content_kicker': None, 'print_headline': 'Refugees Flood Border as Islamic State Steps Up Attacks on Syrian Kurds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Shoumali, Karam', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kurds', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-28T22:34:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Karam Shoumali and Anne Barnard', 'person': [{'firstname': 'Karam', 'middlename': None, 'lastname': 'Shoumali', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Anne', 'middlename': None, 'lastname': 'Barnard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d95bf71d-9c5f-5786-9ac0-198716c9e0f4', 'word_count': 512, 'uri': 'nyt://article/d95bf71d-9c5f-5786-9ac0-198716c9e0f4'}, {'abstract': 'Ilham Tohti\'s only "crime" was to advocate for China\'s own policies for autonomy for ethnic minorities.', 'web_url': 'https://www.nytimes.com/2014/09/29/opinion/chinas-fruitless-repression-of-the-uighurs.html', 'snippet': 'Ilham Tohti\'s only "crime" was to advocate for China\'s own policies for autonomy for ethnic minorities.', 'lead_paragraph': 'Last week, a court in China’s far western Xinjiang region sentenced Ilham Tohti, a member of the Uighur minority, to life in prison for the crime of “inciting separatism.” The conviction of this moderate scholar elicited international condemnation; the sentence was an order of magnitude longer than those given to other Chinese dissidents. But, far from being a show of strength, the sentence is a sign of the confusion and desperation behind the government’s policies toward Uighurs.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/opinion/29millward/29millward-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/29/opinion/29millward/29millward-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/opinion/29millward/29millward-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/opinion/29millward/29millward-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/opinion/29millward/29millward-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/29/opinion/29millward/29millward-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/29/opinion/29millward/29millward-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': "China's Fruitless Repression of the Uighurs", 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Fruitless Repression', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Uighurs (Chinese Ethnic Group)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tohti, Ilham', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Xinjiang (China)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-28T22:51:43+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By James A. Millward', 'person': [{'firstname': 'James', 'middlename': 'A.', 'lastname': 'Millward', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a6d803c2-1368-5340-92b3-5ca4c5aa9b38', 'word_count': 936, 'uri': 'nyt://article/a6d803c2-1368-5340-92b3-5ca4c5aa9b38'}, {'abstract': 'Few in Karada describe the violence in sectarian terms, but most blame Nuri Kamal al-Maliki, the former prime minister, for allowing public security to decay.', 'web_url': 'https://www.nytimes.com/2014/09/29/world/middleeast/shiites-in-a-battered-neighborhood-fault-one-of-their-own.html', 'snippet': 'Few in Karada describe the violence in sectarian terms, but most blame Nuri Kamal al-Maliki, the former prime minister, for allowing public security to decay.', 'lead_paragraph': 'BAGHDAD — Families venture out only by day and as little as possible. Shopkeepers watch the curbs more than their stores, to prevent anyone from parking. The police have erected checkpoints on the avenues and closed the side streets, but more bombs keep coming.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Shiites in a Battered Neighborhood of Baghdad Fault One of Their Own', 'kicker': None, 'content_kicker': None, 'print_headline': 'Shiites in a Battered Neighborhood of Baghdad Fault One of Their Own', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kirkpatrick, David D', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Maliki, Nuri Kamal al-', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Baghdad (Iraq)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Shiite Muslims', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-28T22:58:20+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By David D. Kirkpatrick', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bd57984-6253-5fed-bebf-bb08ae7b51ba', 'word_count': 1115, 'uri': 'nyt://article/6bd57984-6253-5fed-bebf-bb08ae7b51ba'}, {'abstract': 'He didn’t stop his car 