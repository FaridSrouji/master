ht': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/24/business/dbpix-allergan/dbpix-allergan-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/24/business/dbpix-allergan/dbpix-allergan-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/24/business/dbpix-allergan/dbpix-allergan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/24/business/dbpix-allergan/dbpix-allergan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/24/business/dbpix-allergan/dbpix-allergan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Botox Maker Allergan Said to Be in Talks to Acquire Salix', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'ALLERGAN INC', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Pershing Square Capital Management', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Salix Pharmaceuticals Ltd', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Valeant Pharmaceuticals International Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-22T22:56:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By David Gelles', 'person': [{'firstname': 'David', 'middlename': None, 'lastname'