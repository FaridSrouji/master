er': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cotton', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sustainable Living', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Chanin, Natalie', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Reid, Billy', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Council of Fashion Designers of America', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-05T17:31:02+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Rinne Allen', 'person': [{'firstname': 'Rinne', 'middlename': None, 'lastname': 'Allen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7a3feb02-394c-571a-a564-e61f8efc1450', 'word_count': 299, 'uri': 'nyt://article/7a3feb02-394c-571a-a564-e61f8efc1450'}, {'abstract': 'Taking time off is a first step. Learning to simply, and deeply, relax is just as important, Tony Schwartz writes in the Life@Work column.', 'web_url': 'https://dealbook.nytimes.com/2014/09/05/what-i-learned-on-my-vacation/', 'snippet': 'Taking time off is a first step. Learning to simply, and deeply, relax is just as important, Tony Schwartz writes in the Life@Work column.', 'lead_paragraph': 'My first vacation epiphany occurred while taking my two dogs for a walk on the beach at 6 one evening in early August. I’ve always considered walking the dogs obligatory but not especially enjoyable, and I fobbed it off on my wife as often as possible, since she seemed, mysteriously, to enjoy it. But on this night, with the waves lapping on the shore and almost no one in sight, I found myself in a state of deep quiet and contentment. I was happy, nearly rapturous, just walking and taking in the scene.', 'sourc