': 'images/2014/09/26/arts/26DAYSANDNIGHTS/DAYSANDNIGHTS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26DAYSANDNIGHTS/DAYSANDNIGHTS-jumbo.jpg', 'height': 649, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26DAYSANDNIGHTS/DAYSANDNIGHTS-superJumbo.jpg', 'height': 1297, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26DAYSANDNIGHTS/DAYSANDNIGHTS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/26/arts/26DAYSANDNIGHTS/DAYSANDNIGHTS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26DAYSANDNIGHTS/DAYSANDNIGHTS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Chekhovian Bird of a Different Feather', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'A Chekhovian Bird of a Different Feather', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Camargo, Christian', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Janney, Allison', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hurt, William', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Cherry', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Rylance, Mark', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Holmes, Katie', 'rank': 7, '