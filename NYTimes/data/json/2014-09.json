ht': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/24/world/24WATCHING-obama/24WATCHING-obama-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Obama, at U.N., Lays Out Forceful Blueprint to Fight Islamic Extremism', 'kicker': 'United Nations General Assembly', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-09-24T14:47:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/ba06bc24-bf39-5977-a43f-64ad7e15fbee', 'word_count': 11, 'uri': 'nyt://article/ba06bc24-bf39-5977-a43f-64ad7e15fbee'}, {'abstract': 'Several new high-rises, now in the works, will bring change to a landscape of low-rise brownstones, rowhouses and occasional frame houses.', 'web_url': 'https://www.nytimes.com/2014/09/28/realestate/fort-greene-brooklyn-a-neighborhood-with-many-faces.html', 'snippet': 'Several new high-rises, now in the works, will bring change to a landscape of low-rise brownstones, rowhouses and occasional frame houses.', 'lead_paragraph': 'Amid New York’s variegated urban landscape, Fort Greene has been known since the 19th century for its low-rise human habitat: intimately scaled, tree-lined blocks of brownstones, brick rowhouses and occasional frame houses. But a lofty new habitat is emerging on the neighborhood’s western edge, as a forest of mixed-use towers rises in the Brooklyn Cultural District around the Brooklyn Academy of Music’s Peter Jay Sharp Building on Lafayette Avenue. Incorporating more than 1,200 new apartments into a kind of high-rise Lincoln Center, the district will be home in the next few years to more than 400,000 square feet of cultural space, including performance, rehearsal and studio facilities.', 'print_section': 'RE', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fort Greene, Brooklyn: A Neighborhood With Many Faces', 'kicker': 'Living In', 'content_kicker': None, 'print_headline': 'A Neighborhood With Many Faces', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gill, John Freeman', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Fort Greene (Brooklyn, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-24T15:00:06+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By John Freeman Gill', 'person': [{'firstname': 'John', 'middlename': 'Freeman', 'lastname': 'Gill', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/51284ebd-350d-504d-a98c-68111f69de5c', 'word_count': 1272, 'uri': 'nyt://article/51284ebd-350d-504d-a98c-68111f69de5c'}, {'abstract': 'No Labels, the national movement of bipartisan problem-solving, gives its seal of approval to both Republican Joni Ernst and Democrats Bruce Braley in Iowa.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/09/24/no-labels-endorses-two-candidates-in-the-same-race/', 'snippet': 'No Labels, the national movement of bipartisan problem-solving, gives its seal of approval to both Republican Joni Ernst and Democrats Bruce Braley in Iowa.', 'lead_paragraph': 'We’re a little confused, too. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Endorsing Two Candidates, in the Same Race', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Endorsements', 'rank': 1, 'major': 'N'}, {'name': 