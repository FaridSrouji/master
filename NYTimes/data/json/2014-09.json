C/22RIKERS-GRAPHIC-jumbo.jpg', 'height': 1024, 'width': 563, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/22/nyregion/22RIKERS-GRAPHIC/22RIKERS-GRAPHIC-superJumbo.jpg', 'height': 2048, 'width': 1126, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/22/nyregion/22RIKERS-GRAPHIC/22RIKERS-GRAPHIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/22/nyregion/22RIKERS-GRAPHIC/22RIKERS-GRAPHIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/22/nyregion/22RIKERS-GRAPHIC/22RIKERS-GRAPHIC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Softening the Blow', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Correction Department (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Rikers Island Prison Complex', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-09-22T04:11:29+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/880b3d9f-e854-5bb9-b1ff-0f01289c261f', 'word_count': 0, 'uri': 'nyt://interactive/880b3d9f-e854-5bb9-b1ff-0f01289c261f'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/09/22/arts/television/whats-on-tv-monday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (TCM) STARRING BRIGITTE BARDOT Turner Classic Movies celebrates the 80th birthday (it’s actually not till Sunday) of Ms. Bardot, the French actress for whom the term “sex kitten” was coined, with five of her signature films. The tribute begins with “And God Created Woman” (1956), which helped rocket Ms. Bardot to international stardom — and popularized the bikini in the process — in her role, directed by Roger Vadim, as a wanton teenage orphan in love with one brother (Jean-Louis Trintignant, above, with Ms. Bardot) but married to the other (Christian Marquand). “This round and voluptuous little French miss is put on spectacular display and is rather brazenly ogled from every allowable point of view,” Bosley Crowther wrote in The New York Times, calling her “a phenomenon you have to see to believe.” The lineup continues with Michel Boisrond’s “Une Parisienne” (1957), with Ms. Bardot as a daughter of the French president who falls in love with his chief of staff (Henri Vidal) and flirts with a prince (Charles Boyer), at 9:45; Marc Allégret’s “Plucking the Daisy” (1956), in which she portrays a provocative Parisian schoolgirl, at 11:30; “The Night Heaven Fell” (1958), with Ms. Bardot, whose marriage to the film’s director, Mr. Vadim, ended in 1957, as a convent girl who moves in with relatives in Spain and romances a murderer (Stephen Boyd), at 1:30 a.m.; and Jean-Luc Godard’s “Contempt” (1964), in which a film adaptation of “The Odyssey” produced by an American (Jack Palance) and directed by Fritz Lang (as himself), causes friction between a screenwriter (Michel Piccoli) and his wife (Ms. Bardot), at 3:15. ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On TV Monday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Monday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-09-22T04:20:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 