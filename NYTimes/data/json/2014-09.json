The New York Times', 'multimedia': [], 'headline': {'main': 'In Performance: Anthony Wayne of ‘Mighty Real: A Fabulous Sylvester Musical’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wayne, Anthony', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Theater at St Clement's Church", 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-30T12:00:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e088f1dc-81d9-5f7c-92fb-207f9a5a4233', 'word_count': 129, 'uri': 'nyt://article/e088f1dc-81d9-5f7c-92fb-207f9a5a4233'}, {'abstract': '“Men, Women & Children” is Jason Reitman’s multistory film about middle-class families with teenagers, Internet connections and digital issues.', 'web_url': 'https://www.nytimes.com/2014/10/01/movies/adam-sandler-in-jason-reitmans-men-women-children.html', 'snippet': '“Men, Women & Children” is Jason Reitman’s multistory film about middle-class families with teenagers, Internet connections and digital issues.', 'lead_paragraph': '“Men, Women & Children,” Jason Reitman’s glum and thoughtful new film, is not quite as comprehensive as its title suggests. Based on a novel by Chad Kultgen, it surveys a handful of white, middle-class households in a suburban Texas town, each one including a teenager with a smartphone, an Internet connection and some of the attendant problems. Every kid seems to suffer from some kind of digital malaise, and the parents are hardly immune to the seductive, soul-imperiling glow of the interactive screen. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/30/arts/menwomen-image/menwomen-image-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/30/arts/menwomen-image/menwomen-image-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/30/arts/menwomen-image/menwomen-image-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/30/arts/menwomen-image/menwomen-image-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/30/arts/menwomen-image/menwomen-image-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/30/arts/menwomen-image/menwomen-image-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/30/arts/menwomen-image/menwomen-image-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Games People Play, Both Online and Off ', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Games People Play, Both Online and Off', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Reitman, J