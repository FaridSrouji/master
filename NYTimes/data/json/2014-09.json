type_of_material': 'News', '_id': 'nyt://article/12005486-276c-5f81-82a3-af73f066cf67', 'word_count': 565, 'uri': 'nyt://article/12005486-276c-5f81-82a3-af73f066cf67'}, {'abstract': 'Scenes from the New York Fashion Week photo diary of Valerio Mezzanotti.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/09/10/delpozo-new-york-fashion-week-spring-summer-2015/', 'snippet': 'Scenes from the New York Fashion Week photo diary of Valerio Mezzanotti.', 'lead_paragraph': 'Scenes from the New York Fashion Week photo diary of Valerio Mezzanotti.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York Fashion Week: Delpozo Spring/Summer 2015', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'New York Fashion Week', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Delpozo (Fashion Label)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-10T22:48:05+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Valerio Mezzanotti', 'person': [{'firstname': 'Valerio', 'middlename': None, 'lastname': 'Mezzanotti', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73242415-561a-59fb-b269-429a57ae4f16', 'word_count': 28, 'uri': 'nyt://article/73242415-561a-59fb-b269-429a57ae4f16'}, {'abstract': 'Roman and Williams introduces two collections of lighting as part of its R.W. Atlas housewares line for Waterworks.', 'web_url': 'https://www.nytimes.com/2014/09/11/garden/industrial-but-with-a-softer-side.html', 'snippet': 'Roman and Williams introduces two collections of lighting as part of its R.W. Atlas housewares line for Waterworks.', 'lead_paragraph': 'Roman and Williams has added lighting to its R. W. Atlas housewares for Waterworks with two collections, Spunflower and Cupper. Robin Standefer, a founder of Roman and Williams, described the burnished nickel and brass lights as “fairly muscular and sturdy, but with a fine tactility.” In all, there are two pendants, two sconces and a chandelier, any of which can be described as industrial. But a closer look reveals some frills. The Spunflower pendant, for instance, has three tiers of milky white glass crowned with a rim of metal with tiny perforations. Ms. Standefer said these dots would temper any harshness. The quality of illumination in industrial fixtures is often “pure, tough and authentic,” she added, “but a light still has to be soft and beautiful.” Prices range from $1,200 to $3,500. The Cupper ceiling-mounted four-light pendant, shown, is $3,500. Information: 800-899-6757 or waterworks.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR1/11CURR1-articleLarge.jpg', 'height': 794, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/11/garden/11CURR1/11CURR1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 794}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR1/11CURR1-jumbo.jpg', 'height': 1024, 'width': 774, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR1/11CURR1-superJumbo.jpg', 'height': 1895, 'width': 1432, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR1/11CURR1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/11/garden/11CURR1/11CURR1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR1/11CURR1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Industrial, but With a Softer Side', 'kicker': 'Currents: Lighting', 'content_kicker': None, 'print_headline': 'Industrial, but With a Softer Side', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Roman and Williams Buildings and Interiors', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Suqi, Rima', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Lighting', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Lamps and Lampshades', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Waterworks', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Standefer, Robin', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-10T22:48:09+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Rima Suqi', 'person': [{'firstname': 'Rima', 'middlename': None, 'lastname': 'Suqi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d8c2891-bce1-5964-91a0-3716d33fe9a9', 'word_count': 144, 'uri': 'nyt://article/9d8c2891-bce1-5964-91a0-3716d33fe9a9'}, {'abstract': '“Urban Plunge,” an exhibit of unconventional public pools, opens Sept. 13 at the Roca London Gallery, to coincide with the London Design Festival.', 'web_url': 'https://www.nytimes.com/2014/09/11/garden/swimming-holes-for-city-folk.html', 'snippet': '“Urban Plunge,” an exhibit of unconventional public pools, opens Sept. 13 at the Roca London Gallery, to coincide with the London Design Festival.', 'lead_paragraph': 'City waterfronts where swimming is banned have become pet peeves for Jane Withers, a London design consultant and a founder of Wonderwater, an environmental advocacy group. “Urban Plunge,” an exhibition that she curated at the Roca London Gallery, shows how natural bodies of water in metropolises have become primed for public dipping. Marshy basking spots for Londoners are being created in the Thames; Copenhagen already allows bathing in its harbor and the Manhattan coastline could soon have a floating cross-shaped swimming hole called +POOL. Amphitheaters, zigzagging boardwalks, and artificial hummocks surround the swimming areas, so bathers are not left vulnerable in open water. “I like the idea of these semi-wild experiences,” Ms. Withers said. The show opens to coincide with the London Design Festival, Sept. 13 to 21, but runs through Jan. 10, 2015. Information: 44-20-7610-9503 or rocalondongallery.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR4/11CURR4-articleLarge.jpg', 'height': 368, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/11/garden/11CURR4/11CURR4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 368}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR4/11CURR4-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR4/11CURR4-superJumbo.jpg', 'height': 1256, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR4/11CURR4-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/11/garden/11CURR4/11CURR4-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/garden/11CURR4/11CURR4-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Swimming Holes for City Folk', 'kicker': 'Currents: Shows', 'content_kicker': None, 'print_headline': 'Swimming Holes for City Folk', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Swimming Pools', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Withers, Jane', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Roca London Gallery', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-10T22:48:10+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Eve M. Kahn', 'person': [{'firstname': 'Eve', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2409da71-36ba-5912-9720-b4f3767e7537', 'word_count': 138, 'uri': 'nyt://article/2409da71-36ba-5912-9720-b4f3767e7537'}, {'abstract': 'And this time their ships are laden with a new generation of thought-provoking objects and design ideas.', 'web_url': 'https://www.nytimes.com/2014/09/11/garden/the-dutch-are-back-in-town.html', 'snippet': 'And this time their ships are laden with a new generation of thought-provoking objects and design ideas.', 'lead_paragraph': 'On Sept. 24, in an avant-garde condo tower that butts up against the High Line, an unusual gallery called Chamber will open in Chelsea. Like a 17th-century cabinet of curiosities, it will be filled with the eclectic treasures of intrepid explorers. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Dutch Are Back in Town', 'kicker': 'The Details', 'content_kicker': None, 'print_headline': 'The Dutch Are Back in Town', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Studio Job', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Chamber (Manhattan, NY, Retail Store)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Netherlands', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Furniture', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Chamber (Manhattan, NY, Retail Store)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-10T22:50:37+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Julie Lasky', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Lasky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9d7def6-b800-5f7f-8e2d-ca804b06bcd0', 'word_count': 1734, 'uri': 'nyt://article/f9d7def6-b800-5f7f-8e2d-ca804b06bcd0'}, {'abstract': 'In broadening the military operation beyond Iraq, President Obama moves the country back onto a war footing.', 'web_url': 'https://www.nytimes.com/2014/09/11/opinion/president-obamas-speech-on-isis-has-to-address-costs.html', 'snippet': 'In broadening the military operation beyond Iraq, President Obama moves the country back onto a war footing.', 'lead_paragraph': 'By the time President Obama announced the authorization of airstrikes in Syria Wednesday night, he clearly felt that he had little choice militarily or politically. For three years he resisted American military involvement in Syria, where the Assad government and rebel forces are engaged in a bloody civil war.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Attack on ISIS Expands to Syria ', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Attack on ISIS Expands to Syria ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Free Syrian Army', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Dempsey, Martin E', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Joint Chiefs of Staff', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-09-10T22:51:24+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/4e0717e1-9d47-5f04-b49e-9b58178c4ccb', 'word_count': 756, 'uri': 'nyt://article/4e0717e1-9d47-5f04-b49e-9b58178c4ccb'}, {'abstract': 'Presidents have tended to reserve the Oval Office for their most important televised statements, but not always.', 'web_url': 'https://www.nytimes.com/2014/09/11/upshot/locations-of-presidential-tv-speeches-can-give-signals.html', 'snippet': 'Presidents have tended to reserve the Oval Office for their most important televised statements, but not always.', 'lead_paragraph': 'When the current Oval Office was built under Franklin Roosevelt’s supervision in 1934, featuring an Art Deco design that was fashionable at that moment, F.D.R. had no expectation that it would turn out to be a television theater for the president (his single TV appearance was giving a speech opening the New York World’s Fair in Flushing Meadows, Queens, in 1939). But that’s what it turned out to be.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/upshot/11UP-Beschloss/11UP-Beschloss-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/11/upshot/11UP-Beschloss/11UP-Beschloss-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/upshot/11UP-Beschloss/11UP-Beschloss-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/upshot/11UP-Beschloss/11UP-Beschloss-superJumbo.jpg', 'height': 1330, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/upshot/11UP-Beschloss/11UP-Beschloss-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/11/upshot/11UP-Beschloss/11UP-Beschloss-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/upshot/11UP-Beschloss/11UP-Beschloss-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Locations of Presidential TV Speeches Can Give Signals', 'kicker': 'HistorySource', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidents and Presidency (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Speeches and Statements', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-10T23:00:06+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Michael Beschloss', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Beschloss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Web Log', '_id': 'nyt://article/3ccc2b5d-97ca-5302-bb64-d903aa3259b7', 'word_count': 500, 'uri': 'nyt://article/3ccc2b5d-97ca-5302-bb64-d903aa3259b7'}, {'abstract': 'Fall weekends present a chance to bring the right separates all together.', 'web_url': 'https://www.nytimes.com/2014/09/11/fashion/dressing-for-new-york-city-fall-weekends.html', 'snippet': 'Fall weekends present a chance to bring the right separates all together.', 'lead_paragraph': 'Anyone who has brunched in Brooklyn knows that New York is a city that dresses on the weekend. The look, relaxed but put together, is quirkier than your office-appropriate work wear, but polished enough for an unexpected encounter with the boss. To make a casual style statement this fall, start with great separates: a pair of shorts, a classic peacoat. Top it off with fun accessories, and you’re ready to see and be seen.', 'print_section': 'E', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/fashion/11BROWSE9/11zBROWSE9-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/11/fashion/11BROWSE9/11zBROWSE9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/fashion/11BROWSE9/11zBROWSE9-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/fashion/11BROWSE9/11zBROWSE9-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/fashion/11BROWSE9/11zBROWSE9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/11/fashion/11BROWSE9/11zBROWSE9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/fashion/11BROWSE9/11zBROWSE9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dressing for New York City Fall Weekends', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dressing for New York City Fall Weekends', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'va