rds', 'kicker': 'Your Money Adviser', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Credit Cards', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Student Loans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Personal Finances', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-09T19:14:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fc6c1b2a-ddb9-58cd-a58d-5bed00dd0553', 'word_count': 955, 'uri': 'nyt://article/fc6c1b2a-ddb9-58cd-a58d-5bed00dd0553'}, {'abstract': 'Thanks to a few of New York’s finest — Victoria Beckham, The Row and Theory — flaxen fabric is looking less shabby, more chic.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/09/09/new-york-fashion-week-trends-spring-summer-2015-linen-at-beckham-the-row-theory/', 'snippet': 'Thanks to a few of New York’s finest — Victoria Beckham, The Row and Theory — flaxen fabric is looking less shabby, more chic.', 'lead_paragraph': 'Flax isn’t usually thought of as a high-fashion fabric: The wrinkle-prone textile works well for lived-in bedding and loose, low-key layers for weekend jaunts around Brooklyn. But thanks to a few of New York’s finest — Victoria Beckham, The Row and Theory — linen has a new lease on life. Victoria Beckham showed a series of mid calf-length belted coats, sleeveless tops and slit skirts in the material. The Row’s ethereal spring collection opened with basket-weave linen dresses that coiled around the body like snakes. And in Theory’s finely executed minimalist collection, a linen sleeveless trench worn over trousers looked less shabby, more chic.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/t-magazine/09trend-linen/09trend-linen-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/09/t-magazine/09trend-linen/09trend-linen-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/t-magazine/09trend-linen/09trend-linen-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/t-magazine/09trend-linen/09trend-linen-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/t-magazine/09trend-linen/09trend-linen-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/09/t-magazine/09trend-linen/09trend-linen-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/t-magazine/09trend-linen/09trend-linen-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Linen Makes a Comeback at New York Fashion Week', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'New York Fashion Week', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Beckham, Victoria', 'rank': 