int_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/10/opinion/0910OPEDselman/0910OPEDselman-articleLarge.jpg', 'height': 392, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/10/opinion/0910OPEDselman/0910OPEDselman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 392}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/10/opinion/0910OPEDselman/0910OPEDselman-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/10/opinion/0910OPEDselman/0910OPEDselman-superJumbo.jpg', 'height': 1337, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/10/opinion/0910OPEDselman/0910OPEDselman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/10/opinion/0910OPEDselman/0910OPEDselman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/10/opinion/0910OPEDselman/0910OPEDselman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rural Capitals, Big-Time Problems', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Rural Capitals, Big-Time Problems', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Buenos Aires (Argentina)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ARGENTINA', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Santiago del Estero (Argentina)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Corruption (Institutional)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-09T22:44:30+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Filipe R. Campante', 'person': [{'firstname': 'Filipe', 'middlename': 'R.', 'lastname': 'Campante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1537c7a3-505f-5ea3-ab08-788afbda545d', 'word_count': 860, 'uri': 'nyt://article/1537c7a3-505f-5ea3-ab08-788afbda545d'}, {'abstract': 'The Frugal Traveler joins two friends from high school for a low-cost mini-reunion in the Emerald City.', 'web_url': 'https://www.nytimes.com/2014/09/09/travel/budget-friendly-seattle-from-meals-to-massages.html', 'snippet': 'The Frugal Traveler joins two friends from high school for a low-cost mini-reunion in the Emerald City.', 'lead_paragraph': 'My friend Doug and I approached the ticket counter at the Seattle Art Museum, where suggested admission is $19.50. “Is it true we can actually pay whatever we want to get in?” I asked. “Like, 1 cent?” It was, the man said, so long as we didn’t want to see the special exhibitions. And so in tandem we each plunked down a penny. The man did not flinch — or maybe flinched just a little — and printed out our tickets.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/travel/09-frugal-top/09-frugal-top-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/09/travel/09-frugal-top/09-frugal-top-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'r