': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02DEAD/02DEAD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/02/arts/02DEAD/02DEAD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02DEAD/02DEAD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Painful Class Conflict and Youthful Disaffection: Everybody Sing!', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Painful Class Conflict and Youthful Disaffection: Everybody Sing!', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sister Sylvester (Theater Co)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Adams, Brandt', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Dead Behind These Eyes (Play)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kublick, Daniel', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Parquet, Lori E', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hamilton, Kathryn', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-09-01T21:18:08+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Laura Collins-Hughes', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Collins-Hughes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/899163bc-3381-5fbd-af48-e2cc1e23cbb4', 'word_count': 431, 'uri': 'nyt://article/899163bc-3381-5fbd-af48-e2cc1e23cbb4'}, {'abstract': 'College students would do well to make sure their personal belongings are covered in the event of fire, theft, vandalism or natural disaster.', 'web_url': 'https://www.nytimes.com/2014/09/02/your-money/home-insurance/renters-insurance-offers-a-hedge-against-dorm-room-mayhem.html', 'snippet': 'College students would do well to make sure their personal belongings are covered in the event of fire, theft, vandalism or natural disaster.', 'lead_paragraph': 'In the excitement of heading off to college, students may not stop to think about whether they need insurance for all the possessions they’re bringing with them. But that laptop, stereo and other expensive devices — not to mention textbooks — may be worth protecting with a renter’s policy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Renter’s Insurance Offers a Hedge Against Dorm-Room Mayhem', 'kicker': 'Your Money Adviser', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Renter's Insurance", 'rank': 2, 'major': 'N'}], 'pub_date': '2014-09-01T21:21:34+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Your Money', 'subsection_name': 'Home Insurance', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/90b954fa-b3fd-5134-8293-6252d492ea2b', 'word_count': 764, 'uri': 'nyt://article/90b954fa-b3fd-5134-8293-6252d492ea2b'}, {'abstract': 'The singer Miranda Lambert took her “Platinum Tour” to Bethel, N.Y., mixing noble sentiments and rowdy poses.', 'web_url': 'https://www.nytimes.com/2014/09/02/arts/music/miranda-lambert-rowdy-in-the-catskills.html', 'snippet': 'The singer Miranda Lambert took her “Platinum Tour” to Bethel, N.Y., mixing noble sentiments and rowdy poses.', 'lead_paragraph': 'BETHEL, N.Y. — \xa0Miranda Lambert has proved, over a decade-long major-label career, that vulnerability and nuance can share an agenda with her higher-proof concerns: the heady blend of whiskey, tobacco and reprisal that has defined a country-spitfire persona. She’s now one of the biggest names in her field, and evidently regards her platform as a chance for something greater than self-definition. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02MIRANDA/02MIRANDA-articleLarge.jpg', 'height': 387, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/02/arts/02MIRANDA/02MIRANDA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 387}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02MIRANDA/02MIRANDA-jumbo.jpg', 'height': 661, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02MIRANDA/02MIRANDA-superJumbo.jpg', 'height': 1322, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02MIRANDA/02MIRANDA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/02/arts/02MIRANDA/02MIRANDA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02MIRANDA/02MIRANDA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Country Gal Feels the Pressure of Being Tough', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Country Gal Feels the Pressure of Being Tough', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lambert, Miranda', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-01T21:22:14+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9cbc35a5-178d-5fe4-977e-0ddaa45c114d', 'word_count': 639, 'uri': 'nyt://article/9cbc35a5-178d-5fe4-977e-0ddaa45c114d'}, {'abstract': '“Dressing America: Tales From the Garment Center” tells stories about the people who built New York’s fashion industry.', 'web_url': 'https://www.nytimes.com/2014/09/02/arts/television/dressing-america-takes-a-walk-down-fashion-avenue.html', 'snippet': '“Dressing America: Tales From the Garment Center” tells stories about the people who built New York’s fashion industry.', 'lead_paragraph': 'They still give tours of the New York garment district. In “Dressing America: Tales From the Garment Center,” a one-hour documentary Tuesday on WNET in New York, Michael Kaback, a tour guide, points out important buildings: 498, 500 and 512. If you were part of the rag trade, as people in the business seem to love to call it, you never bothered with the rest of the address (Seventh Avenue), he explains. But you may also notice the people walking on the sidewalk behind Mr. Kaback, almost all dressed in T-shirts and jeans.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Stroll Among the Racks', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'A Stroll Among the Racks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gates, Anita', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Dressing America: Tales From the Garment Center (TV Program)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fischler, Steven', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sucher, Joel', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'WNET', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-01T21:24:17+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Anita Gates', 'person': [{'firstname': 'Anita', 'middlename': None, 'lastname': 'Gates', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ed4f7809-d767-5468-9487-ca3eaae4ff3e', 'word_count': 342, 'uri': 'nyt://article/ed4f7809-d767-5468-9487-ca3eaae4ff3e'}, {'abstract': 'Among new albums, Earth’s “Primitive and Deadly,” Yob’s “Clearing the Path to Ascend” and Jeezy’s “Seen It All.”', 'web_url': 'https://www.nytimes.com/2014/09/02/arts/music/new-music-from-earth-yob-and-jeezy.html', 'snippet': 'Among new albums, Earth’s “Primitive and Deadly,” Yob’s “Clearing the Path to Ascend” and Jeezy’s “Seen It All.”', 'lead_paragraph': ' EARTH', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/02/arts/02NEWMUSIC4/02NEWMUSIC4-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/0