': 'N'}, {'name': 'organizations', 'value': 'Institute of Contemporary Art Philadelphia', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Eisenman, Nicole', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Philadelphia (Pa)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': "Women's Rights", 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Gender', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-25T22:23:09+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9f09a2d3-b3d7-5826-a40f-e5a44dee86be', 'word_count': 1318, 'uri': 'nyt://article/9f09a2d3-b3d7-5826-a40f-e5a44dee86be'}, {'abstract': 'Richard McGuire’s comic “Here” becomes a full-length book, previewed at an exhibition at the Morgan Library and Museum.', 'web_url': 'https://www.nytimes.com/2014/09/26/books/here-richard-mcguires-book-an-exhibition-at-the-morgan.html', 'snippet': 'Richard McGuire’s comic “Here” becomes a full-length book, previewed at an exhibition at the Morgan Library and Museum.', 'lead_paragraph': 'GETTING from here to there can be hard enough. But it has taken Richard McGuire 25 years to do something even more complicated: get from here to here.', 'print_section': 'C', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sharing a Sofa With Dinosaurs ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sharing a Sofa With Dinosaurs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McGuire, Richard', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Comic Books and Strips', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'val