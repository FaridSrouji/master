ard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/sports/notredame/notredame-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/sports/notredame/notredame-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Notre Dame Gives Michigan a Powerful Parting Shot', 'kicker': 'Notre Dame 31, Michigan 0', 'content_kicker': None, 'print_headline': 'Irish Give Rivals a Powerful Parting Shot', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Notre Dame', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Michigan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-07T00:34:22+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Mark Viera', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Viera', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ff3cb463-8aec-560f-af84-50c94dbb6a53', 'word_count': 786, 'uri': 'nyt://article/ff3cb463-8aec-560f-af84-50c94dbb6a53'}, {'abstract': 'In Japan, tennis fans rejoiced as Kei Nishikori became the first man from Japan, and Asia, to reach a Grand Slam final.', 'web_url': 'https://www.nytimes.com/2014/09/07/sports/tennis/tennis-fans-rejoice-after-kei-nishikoris-win-over-novak-djokovic.html', 'snippet': 'In Japan, tennis fans rejoiced as Kei Nishikori became the first man from Japan, and Asia, to reach a Grand Slam final.', 'lead_paragraph': 'Bleary-eyed and delirious, tennis fans across Japan reveled Sunday morning at history in the making. Kei Nishikori, the country’s 24-year-old tennis sensation, had just powered past Novak Djokovic to book a place at a Grand Slam final — a first for a Japanese player, and for a man from Asia.', 'print_section': 'SP', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/sports/07JAPAN/07JAPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/07/sports/07JAPAN/07JAPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/sports/07JAPAN/07JAPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/sports/07JAPAN/07JAPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/sports/07JAPAN/07JAPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/07/sports/07JAPAN/07JAPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/07/sports/07JAPAN/07JAPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': '