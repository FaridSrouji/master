: None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/25e6d6d9-eb78-5de8-87c2-eb97ae8bac0e', 'word_count': 362, 'uri': 'nyt://article/25e6d6d9-eb78-5de8-87c2-eb97ae8bac0e'}, {'abstract': 'Liz Lerman’s latest production, “Healing Wars,” deals with the traumatic effects of war on soldiers and on those charged with healing them.', 'web_url': 'https://www.nytimes.com/2014/09/27/arts/dance/healing-wars-by-liz-lerman-portrays-soldiers-trauma.html', 'snippet': 'Liz Lerman’s latest production, “Healing Wars,” deals with the traumatic effects of war on soldiers and on those charged with healing them.', 'lead_paragraph': 'MONTCLAIR, N.J. — “Healing Wars,” the latest production by Liz Lerman, begins backstage. Audience members, en route to their seats, file through a maze of meticulously reconstructed scenes from the Civil War. Along with a costumed performer or two, each tableau vivant comes with wall text imparting an interesting fact: the number of women who disguised themselves as men to fight, the number of letters that the American Red Cross founder Clara Barton received and wrote. At the end of the line, there’s a real and much more recent veteran, the former Navy Gunner’s Mate Paul Hurley, calmly discussing his missing lower leg and his prosthesis.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/LERMAN/LERMAN-articleLarge.jpg', 'height': 372, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/27/arts/LERMAN/LERMAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 372}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/LERMAN/LERMAN-jumbo.jpg', 'height': 635, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/LERMAN/LERMAN-superJumbo.jpg', 'height': 1271, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/LERMAN/LERMAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/27/arts/LERMAN/LERMAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/LERMAN/LERMAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nursing Wounds Deeper Than Scars', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Nursing Wounds Deeper Than Scars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lerman, Liz', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-26T21:59:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Brian Seibert', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Seibert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6a24fc3c-5e41-5ef4-b34e-9177b58f643a', 'word_count': 560, 'uri': 'nyt://article/6a24fc3c-5e41-5ef4-b34e-9177b58f643a'}, {'abstract': 'The legal problems of Jordi Pujol, a former leader of the Convergence party, have cast a shadow over the party’s push for independence from Spain.', 'web_url': 'https://www.nytimes.com/2014/09/27/world/europe/jordi-pujol-defends-legacy-in-catalonia-independence-drive.html', 'snippet': 'The legal problems of Jordi Pujol, a former leader of the Convergence party, have cast a shadow over the party’s push for independence from Spain.', 'lead_paragraph': 'MADRID — Jordi Pujol, the patriarch of Catalan politics, told lawmakers on Friday that money that he has admitted to hiding offshore was inherited and not earned from kickbacks or other corrupt practices during his 23 years in charge of the regional government.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'As Catalonia Weighs Independence From Spain, Leader Seizes Spotlight', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Catalonia (Spain)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pujol, Jordi', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Referendums', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mas, Artur (1956- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-26T22:00:29+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Raphael Minder', 'person': [{'firstname': 'Raphael', 'middlename': None, 'lastname': 'Minder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a3dd0ceb-e77a-5c69-a861-6d82e0ed0279', 'word_count': 588, 'uri': 'nyt://article/a3dd0ceb-e77a-5c69-a861-6d82e0ed0279'}, {'abstract': 'Soldiers’ frantic attempts to resupply ahead of a battle this week exposed some of the Iraqi Army’s glaring weaknesses as it tries to counter the Islamic State.', 'web_url': 'https://www.nytimes.com/2014/09/27/world/middleeast/facing-isis-with-few-supplies-iraqi-soldiers-took-to-phones.html', 'snippet': 'Soldiers’ frantic attempts to resupply ahead of a battle this week exposed some of the Iraqi Army’s glaring weaknesses as it tries to counter the Islamic State.', 'lead_paragraph': 'BAGHDAD — The Iraqi unit, bunkered in a village in Anbar Province, had held the militants at bay for four days. But running perilously low on ammunition, food and water, the soldiers finally took matters into their own hands. ', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Facing Militants With Supplies Dwindling, Iraqi Soldiers Took to Phones', 'kicker': None, 'content_kicker': None, 'print_headline': 'Facing Militants With Supplies Dwindling, Iraqi Soldiers Took to Phones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Iraqi Army', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Semple, Kirk', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ramadi (Iraq)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Baghdad (Iraq)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-26T22:00:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Kirk Semple', 'person': [{'firstname': 'Kirk', 'middlename': None, 'lastname': 'Semple', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8ccfeffa-2329-5392-8ff3-beffed160101', 'word_count': 954, 'uri': 'nyt://article/8ccfeffa-2329-5392-8ff3-beffed160101'}, {'abstract': 'Robert Plant, once Led Zeppelin’s frontman, signaled yet another twist in his rock ’n’ roll road in a concert on Thursday.', 'web_url': 'https://www.nytimes.com/2014/09/27/arts/music/robert-plant-with-led-zeppelin-hits-and-more.html', 'snippet': 'Robert Plant, once Led Zeppelin’s frontman, signaled yet another twist in his rock ’n’ roll road in a concert on Thursday.', 'lead_paragraph': 'PORT CHESTER, N.Y. — Near the midpoint of his shrewdly rollicking concert at the Capitol Theater here on Thursday night, Robert Plant paused to recall a late-night drive down a Mississippi highway and the spell cast by an AM radio signal. He was setting the scene for “Turn It Up,” a brooding new song that builds on this premise. But his words also had the ring of testimony, like a secular salvation narrative. ', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/SUBPLANT/SUBPLANT-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/27/arts/SUBPLANT/SUBPLANT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/SUBPLANT/SUBPLANT-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/SUBPLANT/SUBPLANT-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/SUBPLANT/SUBPLANT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/27/arts/SUBPLANT/SUBPLANT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/SUBPLANT/SUBPLANT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seeking Out the New, Still Rocking His Past', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Seeking Out the New, Still Rocking His Past', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Plant, Robert', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Capitol Theater (Port Chester, NY)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Port Chester (NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-26T22:03:19+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Nate Chinen', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Chinen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/46066d16-90ca-5084-bd69-3583e86c8617', 'word_count': 571, 'uri': 'nyt://article/46066d16-90ca-5084-bd69-3583e86c8617'}, {'abstract': 'Caetano Veloso, enlightened witness from the 1960s, was up to his old tricks in his performance at the Brooklyn Academy of Music.', 'web_url': 'https://www.nytimes.com/2014/09/27/arts/music/caetano-veloso-and-his-band-perform-at-bam.html', 'snippet': 'Caetano Veloso, enlightened witness from the 1960s, was up to his old tricks in his performance at the Brooklyn Academy of Music.', 'lead_paragraph': 'On Caetano Veloso’s current tour, his drummer Marcelo Callado has the word “Abraçaço” spelled out on his bass drum in masking tape, in the style of an oppositional, no-budget punk band. The word is a slang intensification of “abraço,” Portuguese for hug, a typical Brazilian signoff in a letter. (It’s also the title of the most recent album by Mr. Veloso, the Brazilian singer-songwriter, the best of three in what could be called, after the fact, a trilogy.) So, “a big hug,” written in the same style that you typically see words like Toxic Threat, or Riot Alarm.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/27VELOSO/27VELOSO-articleLarge.jpg', 'height': 385, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/27/arts/27VELOSO/27VELOSO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 385}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/27VELOSO/27VELOSO-jumbo.jpg', 'height': 657, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/27VELOSO/27VELOSO-superJumbo.jpg', 'height': 1314, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/27VELOSO/27VELOSO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/27/arts/27VELOSO/27VELOSO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/27/arts/27VELOSO/27VELOSO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Provocations Sung Genially', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Provocations Sung Genially', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 