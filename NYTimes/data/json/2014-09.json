tion': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/24/dining/24HEAT2/24HEAT2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Staying Cool When the Fat Hits the Fire', 'kicker': None, 'content_kicker': None, 'print_headline': 'Staying Cool When the Fat Hits the Fire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Oils and Fats', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-22T19:25:41+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Kim Severson', 'person': [{'firstname': 'Kim', 'middlename': None, 'lastname': 'Severson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2f1e671b-82ff-5b70-a032-98be02b98adb', 'word_count': 723, 'uri': 'nyt://article/2f1e671b-82ff-5b70-a032-98be02b98adb'}, {'abstract': 'Three Pennsylvania law students have formed a “super PAC” dedicated to better beer.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/09/22/new-super-pac-aims-for-better-beer/', 'snippet': 'Three Pennsylvania law students have formed a “super PAC” dedicated to better beer.', 'lead_paragraph': 'A reminder that all you need to form a “super PAC” is a bank account and a stamp: Three Pennsylvania law students have formed Americans for Better Brewing, a new super PAC presumably devoted to, well, higher quality beer. The committee, also known as Six-PAC, is based in Newville, Pa., not far from Penn State’s Dickinson School of Law in Carlisle, where the PAC’s “officers” are students, according to postings on various social networks. No word on whether student beer money will be used to provide funding.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New ‘Super PAC’ Aims for Better Beer', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Dickinson School of Law', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Pennsylvania State University', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-22T19:30:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Derek Willis', 'person': [{'firstname': 'Derek', 'middlename': None, 'lastname': 'Willis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/952e71c6-9525-5899-9954-6311891a9323', 'word_count': 87, 'uri': 'nyt://article/952e71c6-9525-5899-9954-6311891a9323'}, {'abstract': 'Walter Anderson’s first play, “Almost Home,” returns to 1965 and to the dreams and nightmares of the Vietnam War era.', 'web_url': 'https://www.nytimes.com/2014/09/23/theater/almost-home-about-vietnam-debuts-at-the-acorn-theater.html', 'snippet': 'Walter Anderson’s first play, “Almost Home,” returns to 1965 and to the dreams and nightmares of the Vietnam War era.', 'lead_paragraph': 'When the stage lights go up at the Acorn Theater on Harry Feiner’s set for “Almost Home,” a dingy Bronx apartment kitchen in 1965, every prop looks period-perfect. As the play unfolds, Michael McDonald’s costumes and Quentin Chiappetta’s subtle but evocative sound design prove just as commendable. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/theater/23almost-web/23almost-web-articleLarge.jpg', 'height': 398, 'width':