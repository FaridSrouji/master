': 'persons', 'value': 'Bouchard, Andre G', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'ALLERGAN INC', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Pershing Square Capital Management', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Valeant Pharmaceuticals International Inc', 'rank': 12, 'major': 'N'}], 'pub_date': '2014-09-18T20:05:16+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Steven Davidoff Solomon', 'person': [{'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b4ce0a3-92ab-541b-b518-5f4a2cab13ee', 'word_count': 1097, 'uri': 'nyt://article/6b4ce0a3-92ab-541b-b518-5f4a2cab13ee'}, {'abstract': 'The resolution declared the outbreak of the Ebola virus in West Africa a threat to international peace and security.', 'web_url': 'https://www.nytimes.com/2014/09/19/world/security-council-unanimously-passes-ebola-resolution.html', 'snippet': 'The resolution declared the outbreak of the Ebola virus in West Africa a threat to international peace and security.', 'lead_paragraph': 'UNITED NATIONS — The United Nations Security Council, in a highly unusual move, on Thursday declared the Ebola crisis in West Africa to be a threat to international peace and security, unanimously passing a resolution that calls on countries worldwide to urgently send medical personnel and supplies to contain the outbreak.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Security Council Unanimously Passes Ebola Resolution', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Security Council (UN)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ebola Virus', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Sierra Leone', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Liberia', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Guinea', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-18T20:06:56+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Somini Sengupta', 'person': [{'firstname': 'Somini', 'middlename': None, 'lastname': 'Sengupta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c384792d-8aca-58f6-b017-c800e02f0bfc', 'word_count': 183, 'uri': 'nyt://article/c384792d-8aca-58f6-b017-c800e02f0bfc'}, {'abstract': 'The work of the textiles historian Terry Satsuki Milhaupt anchors “Kimono: A Modern History,” an exhibition coming to the Met.', 'web_url': 'https://www.nytimes.com/2014/09/19/arts/design/at-the-met-honoring-kimonos-and-a-scholar-of-the-same.html', 'snippet': 'The work of the textiles historian Terry Satsuki Milhaupt anchors “Kimono: A Modern History,” an exhibition coming to the Met.', 'lead_paragraph': 'The textiles historian Terry Satsuki Milhaupt had nearly finished her comprehensive book on kimonos when she committed suicide in 2012. Her widower, Curtis J. Milhaupt, heroically completed her work, “Kimono: A Modern History” (Reaktion Books/University of Chicago Press), and a show of the same title, based on her scholarship, opens on Sept. 27 at the Metropolitan Museum of Art and runs through Jan. 24.', 'print_section': 'C', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/19ANTIQUES1/19ANTIQUES1-articleLarge-v3.jpg', 'height': 649, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/19/arts/19ANTIQUES1/19ANTIQUES1-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 649}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/19ANTIQUES1/19ANTIQUES1-jumbo-v3.jpg', 'height': 1024, 'width': 947, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/19ANTIQUES1/19ANTIQUES1-superJumbo-v3.jpg', 'height': 1975, 'width': 1826, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/19ANTIQUES1/ANTIQUES1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/19/arts/19ANTIQUES1/ANTIQUES1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/19ANTIQUES1/ANTIQUES1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At the Met, Honoring Kimonos and a Scholar of the Same', 'kicker': None, 'content_kicker': None, 'print_headline': 'At the Met, Honoring Kimonos and a Scholar of the Same', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANTIQUES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Kimonos', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-09-18T20:09:13+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Eve M. Kahn', 'person': [{'firstname': 'Eve', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/197f4d93-60a8-5a27-8cee-7e40e01b78d6', 'word_count': 1115, 'uri': 'nyt://article/197f4d93-60a8-5a27-8cee-7e40e01b78d6'}, {'abstract': 'Metallica is asking fans to vote on which concert recordings should be released as special LPs.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/09/18/forget-about-scotland-crucial-metallica-vote-is-under-way/', 'snippet': 'Metallica is asking fans to vote on which concert recordings should be released as special LPs.', 'lead_paragraph': 'Can’t get enough of Metallica? If that’s the case, you probably already know that the band, like many others – the Allman Brothers, Widespread Panic and Pearl Jam, among them – has been making soundboard recordings of nearly all its concerts, available for download at livemetallica.com for the last decade. The concerts are available in a variety of audio formats, mostly priced between $9.95 (for mp3s) and $17.95 (for HD FLAC), with more than two dozen concerts, including a San Francisco show from this year, available free.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Forget About Scotland. Crucial Metallica Vote Is Under Way.', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Audio Recordings, Downloads and Streaming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Metallica (Music Group)', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-18T20:09:37+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1fdeaa23-bb7b-5883-b7bc-148eeb2d5272', 'word_count': 226, 'uri': 'nyt://article/1fdeaa23-bb7b-5883-b7bc-148eeb2d5272'}, {'abstract': 'Jeff Hobbs tells the story of Robert DeShaun Peace, who went from a New Jersey ghetto to Yale but never truly escaped his past.', 'web_url': 'https://www.nytimes.com/2014/09/21/books/review/the-short-and-tragic-life-of-robert-peace-by-jeff-hobbs.html', 'snippet': 'Jeff Hobbs tells the story of Robert DeShaun Peace, who went from a New Jersey ghetto to Yale but never truly escaped his past.', 'lead_paragraph': 'There are places in America where life is so cheap and fate so brutal that, if they belonged to another country, America might bomb that country to “liberate” them. This book is a mesmeric account of such a place — a ghetto near Newark — that asks the consummate American question: Is it possible to reinvent yourself, to sculpture your own destiny?', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/books/review/0921-bks-Giridharadas/0921-bks-Giridharadas-articleLarge.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/21/books/review/0921-bks-Giridharadas/0921-bks-Giridharadas-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 377}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/books/review/0921-bks-Giridharadas/0921-bks-Giridharadas-jumbo.jpg', 'height': 643, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/books/review/0921-bks-Giridharadas/0921-bks-Giridharadas-superJumbo.jpg', 'height': 1285, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption