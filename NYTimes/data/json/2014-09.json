ype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Destination: Atlanta', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Atlanta (Ga)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-04T21:39:45+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Terry L. Jones', 'person': [{'firstname': 'Terry', 'middlename': 'L.', 'lastname': 'Jones', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5e41f49f-1ab0-5ae3-853c-50ff65f4d721', 'word_count': 1869, 'uri': 'nyt://article/5e41f49f-1ab0-5ae3-853c-50ff65f4d721'}, {'abstract': 'The DanceNow festival continues through Saturday at Joe’s Pub, showcasing 10 performances of less than five minutes each per night.', 'web_url': 'https://www.nytimes.com/2014/09/05/arts/dance/dancenow-festival-keeps-performances-short-and-snappy.html', 'snippet': 'The DanceNow festival continues through Saturday at Joe’s Pub, showcasing 10 performances of less than five minutes each per night.', 'lead_paragraph': 'The DanceNow festival confronts one challenge — that of performing dance on the tiny stage at Joe’s Pub — by adding another: No work may exceed five minutes. This makes for a speedy show, even though 10 different acts share each of the four evenings. Adding to that forward-driving energy is a contest. Each night, the audience chooses a winner, who receives a creative residency in Bucks County, Pa. On Sept. 13, the top 10 return for an encore presentation. A check, a residency and support for a fully produced show go at the end to one contestant chosen by the organizers.', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/05/arts/05DANCENOW1/05DANCENOW1-articleLarge-v2.jpg', 'height': 384, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/05/arts/05DANCENOW1/05DANCENOW1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 384}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/05/arts/05DANCENOW1/05DANCENOW1-jumbo-v2.jpg', 'height': 656, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/05/arts/05DANCENOW1/05DANCENOW1-superJumbo-v2.jpg', 'height': 1312, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/05/arts/05DANCENOW1/05DANCENOW1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/05/arts/05DANCENOW1/05DANCENOW1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': '