 Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26GONE/26GONE-articleLarge-v2.jpg', 'height': 448, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/26/arts/26GONE/26GONE-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 448}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26GONE/26GONE-jumbo-v2.jpg', 'height': 764, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26GONE/26GONE-superJumbo-v2.jpg', 'height': 1529, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26GONE/26GONE-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/26/arts/26GONE/26GONE-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/26/arts/26GONE/26GONE-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'No Job, No Money and Now, No Wife', 'kicker': None, 'content_kicker': None, 'print_headline': 'No Job, No Money and Now, No Wife', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fincher, David', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'New York Film Festival', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'AFFLECK, BEN', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'P