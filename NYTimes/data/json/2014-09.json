': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-09-23T10:02:12+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Annie Correal and Andy Newman', 'person': [{'firstname': 'Annie', 'middlename': None, 'lastname': 'Correal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Andy', 'middlename': None, 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/15bc66c7-5150-540d-a157-9e8371312112', 'word_count': 1014, 'uri': 'nyt://article/15bc66c7-5150-540d-a157-9e8371312112'}, {'abstract': 'Many people praise online education as an equalizing force, but some argue that online resources can amplify certain inequities even as they lessen others.', 'web_url': 'https://op-talk.blogs.nytimes.com/2014/09/23/does-online-education-widen-offline-gaps/', 'snippet': 'Many people praise online education as an equalizing force, but some argue that online resources can amplify certain inequities even as they lessen others.', 'lead_paragraph': 'The value of online education at the college level has been a subject of much dispute. But at The Daily Dot, Cabell Gathman considers the role of the Internet in teaching high school kids — and raises larger questions about how online resources might amplify some inequities even as they lessen others.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/22/opinion/nyto-online/nyto-online-articleLarge.jpg', 'height': 594, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/22/opinion/nyto-online/nyto-online-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 594}}, {'rank': 0, 'subtype': 'jumbo', 'caption