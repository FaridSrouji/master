, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/df79f65d-a201-589b-aa51-a91d238717c4', 'word_count': 589, 'uri': 'nyt://article/df79f65d-a201-589b-aa51-a91d238717c4'}, {'abstract': 'Scenes from the Milan Fashion Week photo diary of Alfredo Piola.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/09/18/prada-milan-fashion-week-spring-summer-2015-collection/', 'snippet': 'Scenes from the Milan Fashion Week photo diary of Alfredo Piola.', 'lead_paragraph': 'Scenes from the Milan Fashion Week photo diary of Alfredo Piola.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Milan Fashion Week: Prada Spring/Summer 2015', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Milan Fashion Week', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Prada SpA', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-18T21:30:11+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Alfredo Piola', 'person': [{'firstname': 'Alfredo', 'middlename': None, 'lastname': 'Piola', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/480c64f4-a03f-5b6a-bf74-8b8b29163554', 'word_count': 27, 'uri': 'nyt://article/480c64f4-a03f-5b6a-bf74-8b8b29163554'}, {'abstract': 'In “A Walk Among the Tombstones” the private investigator Matthew Scudder, from the Lawrence Block novels, pursues a case that leads him to an underworld of brutality.', 'web_url': 'https://www.nytimes.com/2014/09/19/movies/a-walk-among-the-tombstones-adapts-lawrence-blocks-novel.html', 'snippet': 'In “A Walk Among the Tombstones” the private investigator Matthew Scudder, from the Lawrence Block novels, pursues a case that leads him to an underworld of brutality.', 'lead_paragraph': 'Nasty, brutal and unforgiving, “A Walk Among the Tombstones” is one of those rare contemporary cinematic offerings: intelligent pulp. It was written and directed by Scott Frank, a script writer whose credits include “Get Shorty” and “Minority Report,” which means that he’s spent time transposing the likes of Elmore Leonard and Philip K. Dick to the screen. Mr. Frank is working with uglier, less pleasurable material here: a 1992 novel by Lawrence Block featuring his continuing character Matthew Scudder. It’s a story of good and evil in which men are as tough as nails and women little more than meat. The nail image is a metaphor; the meat less so. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/WALKAMONGTOMBSTONES/WALKAMONGTOMBSTONES-articleLarge-v3.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/19/arts/WALKAMONGTOMBSTONES/WALKAMONGTOMBSTONES-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/WALKAMONGTOMBSTONES/WALKAMONGTOMBSTONES-jumbo-v3.jpg', 'height': 577, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/WALKAMONGTOMBSTONES/WALKAMONGTOMBSTONES-superJumbo-v3.jpg', 'height': 1153, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/WALKAMONGTOMBSTONES/WALKAMONGTOMBSTONES-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/19/arts/WALKAMONGTOMBSTONES/WALKAMONGTOMBSTONES-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/19/arts/WALKAMONGTOMBSTONES/WALKAMONGTOMBSTONES-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Good vs. Evil, Both Bloody ', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Good vs. Evil, Both Bloody', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Frank, Scott (1960- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Neeson, Liam', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'A Walk Among the Tombstones (Movie)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-18T21:30:42+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/16a31f70-2947-5b7d-bcad-ae21da9c079a', 'word_count': 742, 'uri': 'nyt://article/16a31f70-2947-5b7d-bcad-ae21da9c079a'}, {'abstract': '“Assyria to Iberia at the Dawn of the Classical Age,” at the Met, is a display of imperial might, and a roll call of states and kingdoms gone.', 'web_url': 'https://www.nytimes.com/2014/09/19/arts/design/assyria-to-iberia-at-the-metropolitan-museum-of-art.html', 'snippet': '“Assyria to Iberia at the Dawn of the Classical Age,” at the Met, is a display of imperial might, and a roll call of states and kingdoms gone.', 'lead_paragraph': 'What are we losing? News reports tell us that the terrorist group referred to as the Islamic State is not only destroying architectural monuments in Syria and Iraq, but is also doing brisk business selling looted antiquities abroad. The specifics of these sales — what has gone where — are so far unclear. But you can get a sense of what might be heading for destinations unknown with a visit to “Assyria to Iberia at the Dawn of the Classical Age” at the Metropolitan Museum, a big, complicated, magnificently esoteric show of a kind the Met persists in doing better than anyone, even as audiences increasingly shy away from the unfamiliar.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Empires’ Remnants, Wonders of Survival', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'In Empires’ Remnants, Wonders of Survival', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cotter, Holland', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Museum of Art', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Middle East', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Mediterranean Sea', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-18T21:31:21+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0ab9a07e-a6c2-5d30-8eea-5f7f7f0431ab', 'word_count': 1376, 'uri': 'nyt://article/0ab9a07e-a6c2-5d30-8eea-5f7f7f0431ab'}, {'abstract': '“This Is Where I Leave You” stars Jason Bateman as a man who loses his marriage and job and then must gather with his family to mourn for his father.', 'web_url': 'https://www.nytimes.com/2014/09/19/movies/fractious-family-mourns-in-this-is-where-i-leave-you.html', 'snippet': '“This Is Where I Leave You” stars Jason Bateman as a man who loses his marriage and job and then must gather with his family to mourn for his father.', 'lead_paragraph': 'Shortly after Judd Altman discovers his wife in bed with his boss, he learns that his father has died. The old man’s dying wish was that the Altman family — his widow and their four children — observe the Jewish custom of sitting shiva, even though he was never especially religious. That means spending seven days together in a big suburban house, accepting condolences amid platters of food. For Judd, embodied by Jason Bateman with his usual air of beleaguered responsibility, a family reunion following a marital calamity is a nightmare. For “This Is Where I Leave You,” Shawn Levy’s adaptation of Jonathan Tropper’s comic best seller, it’s a promising start. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pallbearers Par Excellence', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Pallbearers Par Excellence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Levy, Shawn', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fonda, Jane', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bateman, Jason', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fey, Tina', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Driver, Adam', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Byrne, Rose', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Shepard, Dax', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Stoll, Corey', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-09-18T21:37:33+0000', 'document