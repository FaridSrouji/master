s-t_CA0-jumbo.jpg', 'height': 976, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/magazine/21lives/mag-21Lives-t_CA0-superJumbo.jpg', 'height': 1747, 'width': 1833, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/magazine/21lives/mag-21Lives-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/21/magazine/21lives/mag-21Lives-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/magazine/21lives/mag-21Lives-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bitten to the Quick', 'kicker': 'Lives', 'content_kicker': None, 'print_headline': 'Bitten to the Quick', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Meisel, Abigail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mites', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington Heights (Manhattan, NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-19T14:13:10+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Abigail Meisel', 'person': [{'firstname': 'Abigail', 'middlename': None, 'lastname': 'Meisel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e78490ee-6906-573e-b5a1-c742d14bec45', 'word_count': 773, 'uri': 'nyt://article/e78490ee-6906-573e-b5a1-c742d14bec45'}, {'abstract': 'Switching prices; clipping the public crossword.', 'web_url': 'https://www.nytimes.com/2014/09/21/magazine/a-quick-change-artist.html', 'snippet': 'Switching prices; clipping the public crossword.', 'lead_paragraph': 'My next-door neighbor, who recently quit her job to pursue painting, asked if she could practice by making a portrait of my child. She said she would charge me the cost of supplies since it was for practice, and I agreed. When she finished the painting, she notified me that she had decided to charge me several hundreds of dollars because she had learned inart class the importance of correctly pricing her work. Although I was upset by the change in price, I did not want to ruin the relationship, so I paid what she asked. What was the right thing to do? NADIA, CHICAGO', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/magazine/21ethicist/21ethicist-articleLarge-v3.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/21/magazine/21ethicist/21ethicist-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/magazine/21ethicist/21ethicist-jumbo-v3.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/21/magazine/21ethicist/21ethicist-superJumbo-v3.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image