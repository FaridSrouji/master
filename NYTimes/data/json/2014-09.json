umbo.jpg', 'height': 1015, 'width': 799, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/opinion/0909lettersSUICIDE/0909lettersSUICIDE-superJumbo.jpg', 'height': 1015, 'width': 799, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/opinion/0909lettersSUICIDE/0909lettersSUICIDE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/09/opinion/0909lettersSUICIDE/0909lettersSUICIDE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/09/opinion/0909lettersSUICIDE/0909lettersSUICIDE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Stresses That Put Doctors at Risk', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'The Stresses That Put Doctors at Risk', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Depression (Mental)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-08T23:07:50+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/cfd8d0ee-88fd-524a-b443-c214b1bd0060', 'word_count': 828, 'uri': 'nyt://article/cfd8d0ee-88fd-524a-b443-c214b1bd0060'}, {'abstract': 'Perhaps the most over-the-top take on New York Fashion Week’s breakout hairstyle yet, Eugene Souleiman’s complex plaits required four hands and two packs of hair extensions per model.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/09/08/new-york-fashion-week-spring-summer-2015-donna-karan-hair-elaborate-braids/', 'snippet': 'Perhaps the most over-the-top take on New York Fashion Week’s breakout hairstyle yet, Eugene Souleiman’s complex plaits required four hands and two packs of hair extensions per model.', 'lead_paragraph': 'Backstage at Donna Karan this afternoon, the hairstylist Eugene Souleiman was crouched on the floor, crisscrossing sections of hair, with two assistants by his side. It was a sea of hands weaving back and forth, like a carefully choreographed dance number. When he finished, he stood back from the plait he had just created and said, with a bemused smile, “I don’t even know what you call this braid!” But he was keen to describe his inspiration. “The textiles in the collection are Basquiat-like, or like a Miró print — everything is very illustrative,” he said. “So I wanted to make a braid like a paintbrush.” The technique required at least four hands and two packs of hair extensions per model, but wasn’t too high-fashion to escape a summer-camp reference: “It’s a bit like that style of braiding used to make keychains!”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/08/t-magazine/08beauty-gilchrist/08beauty-gilchrist-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/08/t-magazine/08beauty-gilchrist/08beauty-gilchrist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/08/t-magazine/08beauty-gilchrist/08beauty-gilchrist-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'c