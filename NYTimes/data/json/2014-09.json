jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/03/dining/03OLVSIDE/03OLVSIDE-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/03/dining/03OLVSIDE/03OLVSIDE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/03/dining/03OLVSIDE/03OLVSIDE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/03/dining/03OLVSIDE/03OLVSIDE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Enrique Olvera’s Love for Avocado Filled Vegetarian Tacos', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cue the Toucans and Iguanas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Olvera, Enrique', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tacos', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Avocados', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-02T21:15:52+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Jeff Gordinier', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Gordinier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9375f29a-cc1a-50d6-8702-875a16a8d4b0', 'word_count': 160, 'uri': 'nyt://article/9375f29a-cc1a-50d6-8702-875a16a8d4b0'}, {'abstract': 'Florence Fabricant lists the most interesting and