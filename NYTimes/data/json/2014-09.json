f28-9245-6189e5bddcbd', 'word_count': 574, 'uri': 'nyt://article/cb33f8a6-8ec8-5f28-9245-6189e5bddcbd'}, {'abstract': 'Thom Tillis, the Republican nominee for the Senate election in North Carolina, had an interesting take on a wrongful conviction.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/09/04/no-comment-necessary-30-years-in-jail-for-nothing-but-the-process-worked/', 'snippet': 'Thom Tillis, the Republican nominee for the Senate election in North Carolina, had an interesting take on a wrongful conviction.', 'lead_paragraph': 'Henry Lee McCollum and his half-brother, Leon Brown, were released from prison in North Carolina on Wednesday after having spent decades in jail for a crime they did not commit. That night, ThinkProgress asked Thom Tillis, the North Carolina House Speaker and Republican candidate for the U.S. Senate seat currently occupied by Kay Hagan, if anything needed to change in light of the case.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Comment Necessary: 30 Years in Jail for Nothing, but ‘the Process Worked’', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'False Arrests, Convictions and Imprisonments', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Leon', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McCollum, Henry Lee', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tillis, Thomas R', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-04T16:55:13+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By The Editors', 'person': [], 'organization': 'The Editors'}, 'type_of_material': 'News', '_id': 'nyt://article/233f67db-d601-5fac-9a04-8b4f0e4871ad', 'word_count': 112, 'uri': 'nyt://article/233f67db-d601-5fac-9a04-8b4f0e4871ad'}, {'abstra