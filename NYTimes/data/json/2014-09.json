eight': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/16/science/15brody/15brody-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/16/science/15brody/15brody-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Beating Back the Risk of Diabetes', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'A Gradual Retreat From Diabetes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Alzheimer's Disease", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diabetes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Exercise', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Weight', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-15T14:49:22+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Jane E. Brody', 'person': [{'firstname': 'Jane', 'middlename': 'E.', 'lastname': 'Brody', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/87755232-bc42-5c6d-9065-12695aa990ec', 'word_count': 993, 'uri': 'nyt://article/87755232-bc42-5c6d-9065-12695aa990ec'}, {'abstract': 'Highlights from the International Herald Tribune archives: Parisians are eager to see prisoners of war in 1914.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/09/15/1914-prisoners-escape-paris-crowd/', 'snippet': 'Highlights from the International Herald Tribune archives: Parisians are eager to see prisoners of war in 1914.', 'lead_paragraph': 'More than 300 German prisoners were expected at the Gare de l’Est in Paris on Monday afternoon. But such a large crowd gathered that the Prefect of Police arranged at the last minute that they should be sent round by the Grande Ceinture Railway from Noisy-le-Sec to Juvisy. The rumor of their coming also promised that a real general would be among them. A correspondent of the ‘‘Liberté,’’ who discovered the train on a siding at Juvisy station, saw the general in the flesh and learned that a document had been found on him, signed by the Emperor, nominating him the Assistant Governor of Paris!\xa0— The New York Herald, European Edition, Sept. 16, 1914', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/16/blogs/16iht-oldsept16-juvisy/16iht-oldsept16-juvisy-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/16/blogs/16iht-oldsept16-juvisy/16iht-oldsept16-juvisy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/16/blogs/16iht-oldsept16-juvisy/16iht-oldsept16-juvisy-jumbo.jpg', 'height': 499, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/16/blogs/16iht-oldsept16-juvisy/16iht-oldsept16-juvisy-superJumbo.jpg', 'height': 499, 'width': 768, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/16/blogs/16iht-oldsept16-juvisy/16iht-oldsept16-juvisy-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/16/blogs/16iht-oldsept16-juvisy/16iht-oldsept16-juvisy-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, 