': 'image', 'url': 'images/2014/09/14/sunday-review/0914ART/0914ART-superJumbo.jpg', 'height': 1572, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/sunday-review/0914ART/0914ART-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/14/sunday-review/0914ART/0914ART-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/14/sunday-review/0914ART/0914ART-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Monet of One’s Own', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'A Monet of One’s Own', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hayes, Bill', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Winogrand, Garry', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Museum of Art', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-13T19:05:58+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Bill Hayes', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Hayes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c1032e55-cd4f-5f63-b864-06dfb6531be7', 'word_count': 926, 'uri': 'nyt://article/c1032e55-cd4f-5f63-b864-06dfb6531be7'}, {'abstract': 'The makeup artist Aaron De Mey and the hairstylist Anthony Turner reveal the tricks and products used to create the show’s pure, unadorned beauty statement.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/09/13/jw-anderson-behind-the-minimalist-hair-and-makeup-london-fashion-week-spring-2015/', 'snippet': 'The makeup artist Aaron De Mey and the hairstylist Anthony Turner reveal the tricks and products used to create the show’s pure, unadorned beauty statement.', 'lead_paragraph': '“We’re really trying to amplify a no-makeup state — with no mascara and no eyelash curling either,” said the New Zealand-born, New York-based makeup artist Aaron De Mey backstage at J.W. Anderson this afternoon. Crafting such a pure look called for enhanced skin preparation involving exfoliation around the nose and on the lips and an application of\xa0M.A.C Lightful Softening Lotion\xa0to intensely hydrate the skin. “I’m keeping it elevated, aristocratic — and taking the sex out of it, essentially,” explained De Mey. “No shine, but instead a matte fragility.”\xa0M.A.C’s Mixing Medium Matte\xa0was pressed onto the skin with the index finger, patted lightly around the cheek and nose and swept softly over the forehead and chin. De Mey also used\xa0M.A.C Select Cover-Up\xa0concealer under the eyes, softly blending it with a tapered brush. “The girls feel like themselves as I’m retaining the natural rosy color in their cheeks,” he explained, “which adds to the look of aristocratic purity.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/t-magazine/13scene-anderson-slide-9M5P/13scene-anderson-slide-9M5P-articleLarge-v2.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/13/t-magazine/13scene-anderson-slide-9M5P/13scene-anderson-slide-9M5P-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/t-magazine/13scene-anderson-slide-9M5P/13scene-anderson-slide-9M5P-jumbo-v2.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/t-magazine/13scene-anderson-slide-9M5P/13scene-anderson-slide-9M5P-superJumbo-v2.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/t-magazine/13scene-anderson-slide-9M5P/13scene-anderson-slide-9M5P-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/13/t-magazine/13scene-anderson-slide-9M5P/13scene-anderson-slide-9M5P-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/t-magazine/13scene-anderson-slide-9M5P/13scene-anderson-slide-9M5P-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Behind the Minimalist Hair and Makeup at J.W. Anderson', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cosmetics and Toiletries', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'London Fashion Week', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Anderson, Jonathan William (1984- )', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-13T19:06:20+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Andrea Cusick', 'person': [{'firstname': 'Andrea', 'middlename': None, 'lastname': 'Cusick', 'qualifier': None, 'title': None, '