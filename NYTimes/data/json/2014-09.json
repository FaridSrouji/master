ualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/b1dca450-71fe-57f7-b284-6d8cff1a6f5c', 'word_count': 0, 'uri': 'nyt://video/b1dca450-71fe-57f7-b284-6d8cff1a6f5c'}, {'abstract': 'The NBC singing competition has managed to keep its judges’ panel fresh and lively, qualities that were apparent at a recent luncheon.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/09/22/the-voices-secret-to-longevity/', 'snippet': 'The NBC singing competition has managed to keep its judges’ panel fresh and lively, qualities that were apparent at a recent luncheon.', 'lead_paragraph': 'After a press lunch the other day with cast members from “The Voice,” NBC sent everyone home with goodie bags. The contents included a bottle of Ketel One vodka, around which was tied an index card containing a recipe for “Carson Daly’s Hangover-Curing Magical Bloody Mary.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘The Voice’s’ Secret to Longevity', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Daly, Carson', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Levine, Adam', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stefani, Gwen', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Pharrell', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-22T15:00:46+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_