', 'url': 'images/2014/09/12/arts/12MANONHERMIND/12MANONHERMIND-articleLarge-v3.jpg', 'height': 613, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/12/arts/12MANONHERMIND/12MANONHERMIND-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 613}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/arts/12MANONHERMIND/12MANONHERMIND-jumbo-v3.jpg', 'height': 1024, 'width': 1004, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/arts/12MANONHERMIND/12MANONHERMIND-superJumbo-v3.jpg', 'height': 1175, 'width': 1151, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/arts/12MANONHERMIND/12MANONHERMIND-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/12/arts/12MANONHERMIND/12MANONHERMIND-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/arts/12MANONHERMIND/12MANONHERMIND-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Love and Neuroses in Mamaroneck', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'The Man on Her Mind', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hruska, Alan (Playwright)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-09-11T21:25:02+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Andy Webster', 'person': [{'firs