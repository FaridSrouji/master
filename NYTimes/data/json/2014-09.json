lide-6EID/20140922-lens-oksana-slide-6EID-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Outgrowing Childhood Horrors in Beslan', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-09-22T19:36:52+0000', 'document_type': 'multimedia', 'news_desk': 'Blogs', 'section_name': 'Blogs', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/41c44f63-b1b2-5bba-9080-8ecab15a03e1', 'word_count': 0, 'uri': 'nyt://slideshow/41c44f63-b1b2-5bba-9080-8ecab15a03e1'}, {'abstract': 'When I bought a company in California last year, I was struck by how similar the bureaucratic hoops were. There actually were more of them in California than I typically face in China.', 'web_url': 'https://boss.blogs.nytimes.com/2014/09/22/battling-red-tape-in-america-and-china/', 'snippet': 'When I bought a company in California last year, I was struck by how similar the bureaucratic hoops were. There actually were more of them in California than I typically face in China.', 'lead_paragraph': 'We all carry stereotypes, especially of people we have yet to meet and places we have yet to visit. Sometimes these stereotypes are reinforced by movies and literature, which makes me cringe: I hate to think that foreigners might conclude that Mrs. Cleaver of “Leave it to Beaver” is representative of American women or that John Wayne’s callused tough guys who grit their way through anything are typical of American men.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Battling Red Tape, in America and China', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bribery and Kickbacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Weidenhamer, Deb', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Auction Systems Auctioneers and Appraisers Inc', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-09-22T19:39:25+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Deb Weidenhamer', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Weidenhamer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/59bb8b3f-e3f4-59be-80e3-35e3c41a79e1', 'word_count': 690, 'uri': 'nyt://article/59bb8b3f-e3f4-59be-80e3-35e3c41a79e1'}, {'abstract': 'The man who jumped the White House fence last week had been arrested in July by Virginia State Police with a cache of automatic weapons, law enforcement officials said.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2014/09/22/white-house-fence-jumper-arrested-in-july-with-cache-of-weapons/', 'snippet': 'The man who jumped the White House fence last week had been arrested in July by Virginia State Police with a cache of automatic weapons, law enforcement officials said.', 'lead_paragraph': 'The man who scaled the White House fence on Friday and ran into the front door of the presidential residence had been arrested by Virginia State Police in July with a cache of automatic weapons, a sniper rifle and “a map of Washington, D.C., with writing and a line drawn to the White House,” law enforcement officials said.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'White House Intruder Arrested in July With Cache of Weapons', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gonzalez, Omar J (1972- )', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-22T19:39:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2ce0982e-bf7b-5645-b97f-96edf6cf4482', 'word_count': 141, 'uri': 'nyt://article/2ce0982e-bf7b-5645-b97f-96edf6cf4482'}, {'abstract': 'The orchestra locked out its musicians earlier this month, and has canceled the first seven weeks of its season, through Nov. 8.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/09/22/atlanta-symphony-orchestra-cancels-concerts/', 'snippet': 'The orchestra locked out its musicians earlier this month, and has canceled the first seven weeks of its season, through Nov. 8.', 'lead_paragraph': 'The management of the Atlanta Symphony Orchestra announced on Monday that because of ongoing labor negotiations with its musicians, it has canceled the first seven weeks of its season, from Sept. 25 through Nov. 8.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Atlanta Symphony Orchestra Cancels Concerts', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Lockouts', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Atlanta Symphony Orchestra', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-09-22T19:41:52+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/996e4d46-bb8d-508b-b412-fa9bb7d50610', 'word_count': 249, 'uri': 'nyt://article/996e4d46-bb8d-508b-b412-fa9bb7d50610'}, {'abstract': 'Mark Whitaker’s biography, “Cosby: His Life and Times,” recounts the comedian’s path from poverty to a vastly influential force on national television and in other arenas.', 'web_url': 'https://www.nytimes.com/2014/09/23/books/bill-cosby-in-mark-whitakers-new-biography.html', 'snippet': 'Mark Whitaker’s biography, “Cosby: His Life and Times,” recounts the comedian’s path from poverty to a vastly influential force on national television and in other arenas.', 'lead_paragraph': 'Mark Whitaker’s biography of Bill Cosby is, like its subject, old school. It’s square, competent, gentle, G-rated, dignified and, in the end, a bit distant. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/arts/BOOKWHITAKER/BOOKWIHITAKER-articleLarge.jpg', 'height': 866, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/23/arts/BOOKWHITAKER/BOOKWIHITAKER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 866}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/arts/BOOKWHITAKER/BOOKWIHITAKER-jumbo.jpg', 'height': 1024, 'width': 710, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/arts/BOOKWHITAKER/BOOKWIHITAKER-superJumbo.jpg', 'height': 2048, 'width': 1419, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/arts/BOOKWHITAKER/BOOKWHITAKER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/23/arts/BOOKWHITAKER/BOOKWHITAKER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/arts/BOOKWHITAKER/BOOKWHITAKER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Stand-Up and Sitcoms, Nonchalantly Blazing a Path', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Stand-Up and Sitcoms, Nonchalantly Blazing a Path', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Garner, Dwight', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Whitaker, Mark', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cosby, Bill', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Cosby: His Life and Times (Book)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-09-22T19:50:31+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Dwight Garner', 'person': [{'firstname': 'Dwight', 'middlename': None, 'lastname': 'Garner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d1341ee3-289a-57a8-8bad-d6c698a42181', 'word_count': 1118, 'uri': 'nyt://article/d1341ee3-289a-57a8-8bad-d6c698a42181'}, {'abstract': 'The proteins that latch on to ice crystals in the body of the fish and prevent them from growing also prevent the ice from melting.', 'web_url': 'https://www.nytimes.com/2014/09/23/science/antifreeze-proteins-keep-antarctic-fish-alive-and-icy.html', 'snippet': 'The proteins that latch on to ice crystals in the body of the fish and prevent them from growing also prevent the ice from melting.', 'lead_paragraph': 'Fish in McMurdo Sound and elsewhere in the seas around Antarctica have to survive in temperatures below freezing. It’s not surprising, then, that they have evolved natural antifreeze proteins.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Antifreeze Proteins Keep Antarctic Fish Alive and Icy', 'kicker': 'ScienceTake', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ice', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fish and Other Marine Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Proteins', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'ANTARCTIC REGIONS', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-22T19:51:41+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By James Gorman', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Gorman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6d70dbd-7531-5e24-aa00-ff740615ff76', 'word_count': 277, 'uri': 'nyt://article/e6d70dbd-7531-5e24-aa00-ff740615ff76'}, {'abstract': 'Omar Gonzalez, the intruder, was arrested in July in Virginia after the state police there found several loaded semiautomatic weapons in his car after a high-speed chase on Interstate 81.', 'web_url': 'https://www.nytimes.com/2014/09/23/us/white-house-intruder-was-arrested-in-july-with-trove-of-weapons.html', 'snippet': 'Omar Gonzalez, the intruder, was arrested in July in Virginia after the state police there found several loaded semiautomatic weapons in his car after a high-speed chase on Interstate 81.', 'lead_paragraph': 'WASHINGTON — Secret Service officers stopped Omar Jose Gonzalez last month as he carried a hatchet in front of the White House, but let him go even though he had been arrested this summer in Virginia with a mini-arsenal of semiautomatic weapons, a sniper rifle and a map clearly marking the White House’s location.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/us/JP-WHITEHOUSE1/JP-WHITEHOUSE1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/23/us/JP-WHITEHOUSE1/JP-WHITEHOUSE1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/us/JP-WHITEHOUSE1/JP-WHITEHOUSE1-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/us/JP-WHITEHOUSE1/JP-WHITEHOUSE1-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/us/JP-WHITEHOUSE1/JP-WHITEHOUSE1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/23/us/JP-WHITEHOUSE1/JP-WHITEHOUSE1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/23/us/JP-WHITEHOUSE1/JP-WHITEHOUSE1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'White House Intruder’s Past Raises Concern', 'kicker': None, 'content_kicker': None, 'print_headline': 'Intruder’s Past Raises Concern at White House', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gonzalez, Omar J (1972- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Schmidt, Michael S', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Secret Service', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'White House Building (Washington, DC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-22T19:56:58+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Michael D. Shear and Michael S. Schmidt', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cbf92d1a-e842-565b-8b7b-61302a776903', 'word_count': 1170, 'uri': 'nyt://article/cbf92d1a-e842-565b-8b7b-61302a776903'}, {'abstract': 'A vinaigrette to replace all the store-bought dressings.', 'web_url': 'https://www.nytimes.com/2014/09/24/dining/a-salad-dressing-recipe-to-rule-them-all.html', 'snippet': 'A vinaigrette to replace all the store-bought dressings.', 'lead_paragraph': 'Open your refrigerator: how many bottles of salad dressing are lurking in the door? If you’re an average American shopper, you add one or two bottles to that sticky collection every couple of months.', 'print_sectio