ion': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Big Sound at a Big House', 'kicker': 'The Week Ahead | Pop', 'content_kicker': None, 'print_headline': 'Big Sound at a Big House', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-09-25T15:16:38+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fb1890e0-0ffc-560c-852f-c8ceee86db19', 'word_count': 149, 'uri': 'nyt://article/fb1890e0-0ffc-560c-852f-c8ceee86db19'}, {'abstract': 'A New York Film Festival retrospective, “Joseph L. Mankiewicz: The Essential Iconoclast,” honors that Hollywood director.', 'web_url': 'https://www.nytimes.com/2014/09/28/movies/housewives-newly-desperate.html', 'snippet': 'A New York Film Festival retrospective, “Joseph L. Mankiewicz: The Essential Iconoclast,” honors that Hollywood director.', 'lead_paragraph': '“The most intelligent man in contemporary cinema” wrote Jean-Luc Godard of the Hollywood director Joseph L. Mankiewicz in 1958. That assessment is borne out by the classic “All About Eve” (1950) with its great performances and witty, literate dialogue that set the template for the way sophisticated theater people are viewed. But a previous Mankiewicz movie, the lesser-known “A Letter to Three Wives” (1949), which is being celebrated in a New York Film Festival retrospective, “Joseph L. Mankiewicz: The Essential Iconoclast,” is just as perfect. ', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'imag