ource': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Off the Runway: Day 6', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-09-10T18:42:29+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Elizabeth Bristow', 'person': [{'firstname': 'Elizabeth', 'middlename': None, 'lastname': 'Bristow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9909c98d-ef53-5ade-b2e9-de17b6179b7f', 'word_count': 30, 'uri': 'nyt://article/9909c98d-ef53-5ade-b2e9-de17b6179b7f'}, {'abstract': 'Lawyers for Bradley Ballard, a prisoner who had schizophrenia and diabetes, say he was ignored for seven days while confined in a cell.', 'web_url': 'https://www.nytimes.com/2014/09/11/nyregion/family-of-mentally-ill-rikers-inmate-sues-new-york-city-over-his-death.html', 'snippet': 'Lawyers for Bradley Ballard, a prisoner who had schizophrenia and diabetes, say he was ignored for seven days while confined in a cell.', 'lead_paragraph': 'The night Bradley Ballard died, he lay naked on the floor of his cell in a mental health observation unit at Rikers Island, weak and covered with feces. He had not been given medication for his schizophrenia and diabetes. And, unbeknown to guards, he had tied a rubber band around his genitals, causing them to become badly infected, New York City investigators later concluded.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/11/nyregion/11BALLARD/11BALLARD-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/11/nyregion/11BALLARD/11BALLARD-articleLarge.jpg', 'xlar