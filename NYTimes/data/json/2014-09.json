umbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/blogs/20140912POD-slide-JHAB/20140912POD-slide-JHAB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pictures of the Day: South Africa and Elsewhere', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Liberia', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'South Africa', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-09-12T21:24:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/f49fd664-9d7b-5aed-ba34-3748ce930edf', 'word_count': 13, 'uri': 'nyt://article/f49fd664-9d7b-5aed-ba34-3748ce930edf'}, {'abstract': 'Designers including Rodarte, Adam Selman and Joseph Altuzarra used the iridescent gemstone as a trimming in their collections.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/09/12/new-york-fashion-week-spring-2015-pearls-trend/', 'snippet': 'Designers including Rodarte, Adam Selman and Joseph Altuzarra used the iridescent gemstone as a trimming in their collections.', 'lead_paragraph': 'Today marks the start of London Fashion Week, but editors can’t stop talking about the pearl trend from New York. Rodarte sent a model in a glistening dress with a net skirt and a pearl embellishment walking through its fantastical set of fluorescent lights and shattered Swarovski crystals. Adam Selman, who designed the infamous sheer dress Rihanna wore to the CFDA Awards, added the gemstone to many of the pieces in his rather sporty collection, like a boxy chambray top and shorts with a floating seam connected by pearls. And Joseph Altuzarra’s typically sexy, sharp collection included black dresses with pearls dangling from the trim.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/t-magazine/12pearls-koh/12pearls-koh-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/12/t-magazine/12pearls-koh/12pearls-koh-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/t-magazine/12pearls-koh/12pearls-koh-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/t-magazine/12pearls-koh/12pearls-koh-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/t-magazine/12pearls-koh/12pearls-koh-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/12/t-magazine/12pearls-koh/12pearls-koh-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/12/t-magazine/12pearls-koh/12pearls-koh-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pearls Spotted All Over New York Fashion Week', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': '