+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Ginia Bellafante', 'person': [{'firstname': 'Ginia', 'middlename': None, 'lastname': 'Bellafante', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bc81931c-4792-548c-a0b2-155ce408aca0', 'word_count': 795, 'uri': 'nyt://article/bc81931c-4792-548c-a0b2-155ce408aca0'}, {'abstract': 'Katy Sparks is stepping down at the restaurant in Central Park, which reopened last spring to poor reviews.', 'web_url': 'https://www.nytimes.com/2014/09/13/dining/chef-leaves-tavern-on-the-green.html', 'snippet': 'Katy Sparks is stepping down at the restaurant in Central Park, which reopened last spring to poor reviews.', 'lead_paragraph': 'Less than five months after the revered but troubled Central Park restaurant Tavern on the Green reopened with a costly renovation, a new management and a new menu, its executive chef, Katy Sparks, has left.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/dining/13Tavern/13Tavern-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/13/dining/13Tavern/13Tavern-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/dining/13Tavern/13Tavern-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/13/dining/13Tavern/13Tavern-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank'