umbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/10/nyregion/BALLARD-lawsuit-1410377053906/BALLARD-lawsuit-1410377053906-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lawsuit Filed by Bradley Ballard’s Mother', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Rikers Island Prison Complex', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Schizophrenia', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-09-10T19:26:39+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/1956ab64-2a10-54aa-8c58-bbc9b32b26fb', 'word_count': 0, 'uri': 'nyt://interactive/1956ab64-2a10-54aa-8c58-bbc9b32b26fb'}, {'abstract': 'In “The Short and Tragic Life of Robert Peace,” Jeff Hobbs writes about his roommate at Yale.', 'web_url': 'https://www.nytimes.com/2014/09/11/books/the-short-and-tragic-life-of-robert-peace-by-jeff-hobbs.html', 'snippet': 'In “The Short and Tragic Life of Robert Peace,” Jeff Hobbs writes about his roommate at Yale.', 'lead_paragraph': 'Jeff Hobbs and Robert Peace were roommates throughout their four years at Yale, class of 2002. Their friendship got off to a slightly bumpy start. Mr. Hobbs, a wealthy, second-generation Yalie who grew up in a house with a pool, had the impression that his future roommate came from a similar background, perhaps because Rob Peace had gone to a prep school and played water polo. But Rob was a black kid from a ghetto called Illtown, just outside Newark. And when they compar