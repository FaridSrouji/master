 'major': 'N'}, {'name': 'subject', 'value': 'Mosquitoes', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Clinical Trials', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Tests (Medical)', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-09-03T16:02:02+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Andrew Pollack', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Pollack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/00038bd9-ca00-50bb-be5e-b181b74a53ed', 'word_count': 842, 'uri': 'nyt://article/00038bd9-ca00-50bb-be5e-b181b74a53ed'}, {'abstract': 'Sam, a defensive lineman who is the first openly gay player to be drafted by an N.F.L. team, was released by the St. Louis Rams on Saturday.', 'web_url': 'https://www.nytimes.com/2014/09/04/sports/football/michael-sam-to-join-cowboys-practice-squad.html', 'snippet': 'Sam, a defensive lineman who is the first openly gay player to be drafted by an N.F.L. team, was released by the St. Louis Rams on Saturday.', 'lead_paragraph': 'The rookie defensive lineman Michael Sam, who was released by the St. Louis Rams on Saturday, joined the practice squad of the Dallas Cowboys on Wednesday. Sam, the first openly gay player drafted by an N.F.L. team, had failed to win a spot with the Rams despite a solid showing in the preseason in which he had 11 tackles and three sacks.', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/04/sports/04nfl/04nfl-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/04/sports/04nfl/04nfl-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subt