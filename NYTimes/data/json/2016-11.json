/2016/11/08/business/08DECISION2-sub/08DECISION2-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/08/business/08DECISION2-sub/08DECISION2-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/business/08DECISION2-sub/08DECISION2-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'TV Networks Face a Skeptical Public on Election Night', 'kicker': None, 'content_kicker': None, 'print_headline': 'TV Networks Are Facing a Skeptical Audience  During Election Night', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-11-07T17:42:17+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael M. Grynbaum', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e0906f6-a4a5-55a5-850e-c605bf143766', 'word_count': 1210, 'uri': 'nyt://article/1e0906f6-a4a5-55a5-850e-c605bf143766'}, {'abstract': 'Mr. Obama has appeared on several talk shows in recent weeks, something that has provided insights about him and about the sensibilities of these shows.', 'web_url': 'https://www.nytimes.com/2016/11/08/arts/television/its-late-night-with-president-obama.html', 'snippet': 'Mr. Obama has appeared on several talk shows in recent weeks, something that has provided insights about him and about the sensibilities of these shows.', 'lead_paragraph': 'When you’re nearing the end of eight years in a demanding and stressful job, what do you do for enjoyment? If you’re President Obama, you hit the late-night talk shows. During the past few weeks, he has turned up on four of these programs — “The Late Show With Stephen Colbert,” “Jimmy Kimmel Live!,” “Full Frontal With Samantha Bee” and “Real Time With Bill Maher” — to take questions that are both sincere and silly, perform in comedy sketches, crack some jokes and be the butt of others.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/arts/08OBAMATV/08OBAMATV-articleLarge.jpg', 'height': 335, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/08/arts/08OBAMATV/08OBAMATV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 335}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/arts/08OBAMATV/08OBAMATV-jumbo.jpg', 'height': 571, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/arts/08OBAMATV/08OBAMATV-superJumbo.jpg', 'height': 1142, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/arts/08OBAMATV/08OBAMATV-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/08/arts/08OBAMATV/08OBAMATV-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/arts/08OBAMATV/08OBAMATV-thumbLarge-v2.jpg', 'height': 150, 'width'