rJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Travel Coloring Books for Grown-Ups', 'kicker': 'The Getaway', 'content_kicker': None, 'print_headline': 'Hotels Embrace the Coloring Trend', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rosenbloom, Stephanie', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hotels and Travel Lodgings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Morgans Hotel Group LLC', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'W Hotel', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Yotel Ltd', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-11-21T20:04:04+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Stephanie Rosenbloom', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'Rosenbloom', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/df0ff8eb-1c6c-5c94-91cb-7cb4bdd3bcae', 'word_count': 1091, 'uri': 'nyt://article/df0ff8eb-1c6c-5c94-91cb-7cb4bdd3bcae'}, {'abstract': 'Laurent Tourondel’s Dough to Go kit will make one margherita pie in a home oven.', 'web_url': 'https://www.nytimes.com/2016/11/21/dining/pizza-kit-dough-to-go-lamico.html', 'snippet': 'Laurent Tourondel’s Dough to Go kit will make one margherita pie in a home oven.', 'lead_paragraph': 'The chef Laurent Tourondel, who makes pizza in the wood-fueled ovens of L’Amico, is sharing the recipe with home cooks. With this kit you can nearly replicate the classic 12-inch pizza margherita from his Chelsea restaurant in a gas or electric oven. The dough is a breeze to handle, and =buffalo mozzarella, basil a tomato sauce with personality are included. Add a drizzle of good olive oil, chile flakes and whatever else you like on your pie with ingredients from your larder: Dough to Go, $14 for pickup only, L’Amico, 849 Avenue of the Americas (West 30th Street), 212-201-4065, lamico.nyc.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/23/dining/23BURNER-PIZZA/23BURNER-PIZZA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/23/dining/23BURNER-PIZZA/23BURNER-PIZZA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/23/dining/23BURNER-PIZZA/23BURNER-PIZZA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/23/dining/23BURNER-PIZZA/23BURNER-PIZZA-articleLarge-v2.jpg', 'height': 410, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/23/dining/23BURNER-PIZZA/23BURNER-PIZZA-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 410}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/23/dining/23BURNER-PIZZA/23BURNER-PIZZA-jumbo-v2.jpg', 'height': 701, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/23/dining/23BURNER-PIZZA/23BURNER-PIZZA-superJumbo-v2.jpg', 'height': 1401, 'width': 2048, 'sub