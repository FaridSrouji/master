h': 1384, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'John Alexander Skelton’s Fall Collection', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-11-14T22:12:50+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/12c779e1-a7ae-5873-8960-68f400edbf38', 'word_count': 0, 'uri': 'nyt://slideshow/12c779e1-a7ae-5873-8960-68f400edbf38'}, {'abstract': 'John Alexander Skelton sources vintage materials from around England and then hand-dyes them before sewing them into men’s garments.', 'web_url': 'https://www.nytimes.com/2016/11/14/t-magazine/fashion/john-alexander-skelton-menswear.html', 'snippet': 'John Alexander Skelton sources vintage materials from around England and then hand-dyes them before sewing them into men’s garments.', 'lead_paragraph': 'When it comes to finding inspiration, the designer John Alexander Skelton is more likely to turn to museums and archives than the internet. After all, he got the idea for his MA collection at Central Saint Martins — which earned him the school’s prestigious L’Oreal Prize earlier this year — from the archives of Mass Observation, an extensive anthropological survey in the mid-20th century. “The British Library is an amazing resource,” Skelton says. “I love research because you enter different worlds and it’s so enriching. It’s interesting how intertwined textiles has been with politics and social history.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Person to Know: The Designer Making One-of-a-Kind Pieces From Sustainable Fabrics', 'kicker': 'On the Verge', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'sub