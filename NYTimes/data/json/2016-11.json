/16/crosswords/16wordplay-batmobile2/16wordplay-batmobile2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/16/crosswords/16wordplay-batmobile2/16wordplay-batmobile2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/16/crosswords/16wordplay-batmobile2/16wordplay-batmobile2-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/16/crosswords/16wordplay-batmobile2/16wordplay-batmobile2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/16/crosswords/16wordplay-batmobile2/16wordplay-batmobile2-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/16/crosswords/16wordplay-batmobile2/16wordplay-batmobile2-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Midweek Pick-Me-Up', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2016-11-16T03:00:06+0000', 'document_type': 'article', 'news_desk': 'Games', 'section_name': 'Crosswords & Games', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3741f140-820d-5f8a-a3bd-b41f31599d5f', 'word_count': 1072, 'uri': 'nyt://article/3741f140-820d-5f8a-a3bd-b41f31599d5f'}, {'abstract': 'This semidocumentary play at the Public Theater, from the spoken-word collective Universes, may be the most frightening and exciting piece of theater now up.', 'web_url': 'https://www.nytimes.com/2016/11/16/theater/party-people-review.html', 'snippet': 'This semidocumentary play at the Public Theater, from the spoken-word collective Universes, may be the most frightening and exciting piece of theater now up.', 'lead_paragraph': 'There were shouts and moans and finger snaps at a weekend performance of “Party People” at the Public Theater. Tears and laughter joined together; so did sympathy and rage. Commissioned by the Oregon Shakespeare Festival for its “American Revolutions” cycle, developed by the director Liesl Tommy and written by the spoken-word collective Universes, this semidocumentary work is a disjointed exploration of two 1960s radical groups, the Black Panther Party and the Young Lords Party. In the current political climate, it may be the most frightening and exciting piece of theater now up.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/17/arts/17PARTYPEOPLE/16PARTYPEOPLE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/17/arts/17PARTYPEOPLE/16PARTYPEOPLE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/17/arts/17PARTYPEOPLE/16PARTYPEOPLE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/17/arts/17PARTYPEOPLE/16PARTYPEOPLE-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {