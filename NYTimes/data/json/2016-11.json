'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-11-10T17:58:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Mark Scott', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d16bdf3b-eb0b-5923-97d7-7126e8fb47c3', 'word_count': 889, 'uri': 'nyt://article/d16bdf3b-eb0b-5923-97d7-7126e8fb47c3'}, {'abstract': 'Businesses and corporations hopeful that gridlock will end in Washington have started turning to lobbying firms on K Street to help them navigate the change.', 'web_url': 'https://www.nytimes.com/2016/11/11/us/politics/lobbyists-trump.html', 'snippet': 'Businesses and corporations hopeful that gridlock will end in Washington have started turning to lobbying firms on K Street to help them navigate the change.', 'lead_paragraph': 'WASHINGTON — Trent Lott, the former Republican senator from Mississippi, had gleefully flown back from Florida, where he had been working for the campaign of Donald J. Trump. Now a powerful lobbyist, his phone had been buzzing nonstop and he was busy helping to organize a briefing Thursday morning for dozens of corporate clients.', 'print_section': 'P', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/us/11lobby1/11lobby1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/11/us/11lobby1/11lobby1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type'