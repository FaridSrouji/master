ht Now', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jeans (Apparel)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Masks', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-11-21T21:04:06+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2622dad6-234d-52b6-8136-43bd08ea8edc', 'word_count': 385, 'uri': 'nyt://article/2622dad6-234d-52b6-8136-43bd08ea8edc'}, {'abstract': 'The former mayor of New York remains in the running for a post in Donald Trump’s cabinet. This documentary on Amazon chronicles Giuliani’s controversial ascent.', 'web_url': 'https://www.nytimes.com/2016/11/21/watching/rudy-giuliani-documentary.html', 'snippet': 'The former mayor of New York remains in the running for a post in Donald Trump’s cabinet. This documentary on Amazon chronicles Giuliani’s controversial ascent.', 'lead_paragraph': 'For those who didn’t live in New York City under the two-term mayor Rudolph W. Giuliani, you might know him only as one of the heroes of 9/11. The man who held together a shattered metropolis. America’s Mayor. After a long stint out of the spotlight, Giuliani was back in the public eye on the campaign trail for Donald J. Trump. And now he’s one of President-elect Trump’s many candidates for a cabinet position.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/15/watching/rudy-giuliani-watching/rudy-giuliani-watching-articleLarge.jpg', 'height': 426, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/15/watching/rudy-giuliani-watching/rudy-gi