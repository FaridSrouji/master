rticle/470350ff-c92a-5a98-a117-a3ed42a7959b'}, {'abstract': 'He made permanent a policy announced last year that allows priests worldwide to grant absolution for an act that the Roman Catholic Church considers a sin.', 'web_url': 'https://www.nytimes.com/2016/11/21/world/europe/pope-francis-abortion-priests.html', 'snippet': 'He made permanent a policy announced last year that allows priests worldwide to grant absolution for an act that the Roman Catholic Church considers a sin.', 'lead_paragraph': 'VATICAN CITY — The Roman Catholic Church will allow priests throughout the world to grant absolution for abortion, the Vatican said on Monday, making permanent a policy that Pope Francis announced a year ago.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pope Francis Extends Priests’ Ability to Forgive Abortion', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pope Extends Priests’ Ability to Forgive the ‘Grave Sin’ of Abortion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Priests', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stack, Liam', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Francis', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-11-21T14:51:42+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Elisabetta Povoledo and Liam Stack', 'person': [{'firstname': 'Elisabetta', 'middlename': None, 'lastname': 'Povoledo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Liam', 'middlename': None, 'lastname': 'Stack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material':