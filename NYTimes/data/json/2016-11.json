op_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/06/travel/06HIGHENDBROOKLYN-JP1/06HIGHENDBROOKLYN-JP1-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/06/travel/06HIGHENDBROOKLYN-JP1/06HIGHENDBROOKLYN-JP1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/06/travel/06HIGHENDBROOKLYN-JP1/06HIGHENDBROOKLYN-JP1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/06/travel/06HIGHENDBROOKLYN-JP1/06HIGHENDBROOKLYN-JP1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Adventures in Upscale Brooklyn', 'kicker': None, 'content_kicker': None, 'print_headline': '… And Its High-End Life', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Moon, Freda', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-11-01T10:00:19+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Freda Moon', 'person': [{'firstname': 'Freda', 'middlename': None, 'lastname': 'Moon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fceffe0a-b3b2-5062-9f1d-e645459da0d9', 'word_count': 1976, 'uri': 'nyt://article/fceffe0a-b3b2-5062-9f1d-e645459da0d9'}, {'abstract': 'Brooklyn is a bona fide cultural capital — but you don’t have to spend a lot to appreciate it.', 'web_url': 'https://www.nytimes.com/2016/11/06/travel/brooklyn-budget-frugal-travel.html', 'snippet': 'Brooklyn is a bona fide cultural capital — but you don’t have to spend a lot to appreciate it.', 'lead_paragraph': 'Green-Wood cemetery seemed a natural place to spend a few hours in the midst of a hectic urban tour. I passed under its imposing Gothic Revival gates and began heading uphill on Battle Avenue, named after a Revolutionary War battle that took place across its nearly 500-acre grounds. The views of the surrounding area and New York Bay became impressive after just a few minutes of walking. After several days in Brooklyn, I was realizing not just how huge it was, but how flat — so even the smallest changes in altitude provided for some great panoramas. The highest natural point in Brooklyn, Battle Hill, stands (at a mere 220 feet) within the cemetery.', 'print_section': 'TR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/06/travel/06FRUGALBROOKLYN/06FRUGALBROOKLYN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/06/travel/06FRUGALBROOKLYN/06FRUGALBROOKLYN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/06/travel/06FRUGALBROOKLYN/06FRUGALBROOKLYN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/06/travel/06FRUGALBROOKLYN/06FRUGALBROOKLYN-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None