th': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The 11.13.16 Issue', 'kicker': 'The Thread', 'content_kicker': None, 'print_headline': 'The 11.13.16 Issue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-11-23T10:00:05+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/18f3c288-85f5-55c2-95d8-faf674ed0d5d', 'word_count': 687, 'uri': 'nyt://article/18f3c288-85f5-55c2-95d8-faf674ed0d5d'}, {'abstract': 'A republic of doting parents and proud siblings, supportive neighbors and sentimental alumni.', 'web_url': 'https://www.nytimes.com/2016/11/23/magazine/letter-of-recommendation-high-school-football-games.html', 'snippet': 'A republic of doting parents and proud siblings, supportive neighbors and sentimental alumni.', 'lead_paragraph': 'Kenny Byrd broke one tackle, then another, and soon he had nothing in front of him but end zone. The crowd roared with delight; the marching band lifted its horns and belted out a celebratory rendition of “Shut Up and Dance.” Cowbells clanged. Behind me, the superintendent of schools celebrated next to a local Republican candidate for the State Legislature. In front of me, a Latino family embraced before turning around to offer me high-fives. I obliged them. Though I hadn’t lived in Hot Springs, Ark., for more than 20 years, this was my alma mater.', 'print_section': 'MM', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27lor/27mag-27lor-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/27/magazine/27lor/27mag-27lor-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight