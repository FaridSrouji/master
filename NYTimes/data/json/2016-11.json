tes Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Voter Registration and Requirements', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Southern States (US)', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-11-07T17:22:58+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Eric Lichtblau', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Lichtblau', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe068734-409f-58b0-a184-52506f7e70cd', 'word_count': 433, 'uri': 'nyt://article/fe068734-409f-58b0-a184-52506f7e70cd'}, {'abstract': 'This Stony Brook organic oil is a fine alternative to extra-virgin olive oil.', 'web_url': 'https://www.nytimes.com/2016/11/09/dining/sunflower-seed-oil-finger-lakes.html', 'snippet': 'This Stony Brook organic oil is a fine alternative to extra-virgin olive oil.', 'lead_paragraph': 'For several years, the oils sold with the Stony Brook label have been pressed from organic squashes in western New York. The company has added a sunflower-seed oil to its portfolio. Made from locally grown sunflowers, the oil is cold-pressed and unrefined, with a charming, nutty flavor. And it’s reasonably priced, making it a fine alternative to extra-virgin olive oil: Stony Brook Organic Finger Lakes Sunflower Seed Oil, 12.7 ounces $8.95, 25 ounces, $12.95, wholeheartedfoods.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/09/dining/09BURNER-OIL/09BURNER-OIL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/09/di