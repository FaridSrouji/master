nt_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'To Help Close Wage Gap, de Blasio Tells Agencies to Stop Asking About Applicants’ Past Pay', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mayor Tells Agencies to Stop Asking About Applicants’ Past Pay', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rosenberg, Eli', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Orders and Memorandums', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-11-04T19:25:25+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Eli Rosenberg', 'person': [{'firstname': 'Eli', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7c51b404-a627-53c3-97c0-9ff36d9463a9', 'word_count': 624, 'uri': 'nyt://article/7c51b404-a627-53c3-97c0-9ff36d9463a9'}, {'abstract': 'The die-hards who had been hoping for this victory for decades said they could finally savor the moment to celebrate the World Series title over Cleveland.', 'web_url': 'https://www.nytimes.com/2016/11/05/us/chicago-cubs-parade.html', 'snippet': 'The die-hards who had been hoping for this victory for decades said they could finally savor the moment to celebrate the World Series title over Cleveland.', 'lead_paragraph': 'CHICAGO — Cubs fans are used to waiting. So it was a given that Richard David,