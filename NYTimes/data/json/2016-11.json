er': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Archives and Records', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Faminsky, Valery', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Red Army (Soviet Union)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Berlin (Germany)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Ukraine', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'USSR (Former Soviet Union)', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-11-29T09:00:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80562622-a5d8-5d08-8250-65b866ea6569', 'word_count': 758, 'uri': 'nyt://article/80562622-a5d8-5d08-8250-65b866ea6569'}, {'abstract': 'Hao Jingfang, the first Chinese woman to win a Hugo Award, reflects on the line between reality and fiction and giving voice to “invisible people.”', 'web_url': 'https://www.nytimes.com/2016/11/29/world/asia/china-hao-jingfang-science-fiction.html', 'snippet': 'Hao Jingfang, the first Chinese woman to win a Hugo Award, reflects on the line between reality and fiction and giving voice to “invisible people.”', 'lead_paragraph': 'Sunlight is so scarce that it is rationed based on economic class. Schools are so packed that the poorest parents must wait in line for days to secure spots for their children.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, '