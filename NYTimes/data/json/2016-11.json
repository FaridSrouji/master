jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-KF24/10tmag-sozzani-slide-KF24-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-KF24/10tmag-sozzani-slide-KF24-articleLarge.jpg', 'height': 423, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-KF24/10tmag-sozzani-slide-KF24-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 423}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-KF24/10tmag-sozzani-slide-KF24-jumbo.jpg', 'height': 722, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-KF24/10tmag-sozzani-slide-KF24-superJumbo.jpg', 'height': 1443, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Photographs from Carla Sozzani’s Personal Collection', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-11-10T21:10:52+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Art', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/d12379ce-9335-58b6-88bb-10bae331de4d', 'word_count': 0, 'uri': 'nyt://slideshow/d12379ce-9335-58b6-88bb-10bae331de4d'}, {'abstract': 'Carla Sozzani of 10 Corso Como never planned to exhibit her collection of 650-plus photos — but then Azzedine Alaïa called.', 'web_url': 'https://www.nytimes.com/2016/11/10/t-magazine/art/carla-sozzani-galerie-alaia-photo-show.html', 'snippet': 'Carla Sozzani of 10 Corso Como never planned to exhibit her collection of 650-plus photos — but then Azzedine Alaïa called.', 'lead_paragraph': 'As a longtime editor and the creator of 10 Corso Como, Milan’s high-end retail and dining complex, Carla Sozzani is a well-known figure in the fashion world; and as the founder of the gallery there that bears her name, she’s been a longtime force in the art world as well. What many don’t know is that she is also a passionate collector of photography. For more than 40 years, she has built a collection of over 650 works, mostly in black and white, representing more than 70 artists from the 19th century to today: big names like Helmut Newton, Alfred Stieglitz, August Sanders and Irving Penn, but also lesser-known photographers like Xanti Schawinsky, an experimental artist from the 1920s.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-GGJF/10tmag-sozzani-slide-GGJF-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-GGJF/10tmag-sozzani-slide-GGJF-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-GGJF/10tmag-sozzani-slide-GGJF-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-GGJF/10tmag-sozzani-slide-GGJF-articleLarge.jpg', 'height': 470, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-GGJF/10tmag-sozzani-slide-GGJF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 470}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-GGJF/10tmag-sozzani-slide-GGJF-jumbo.jpg', 'height': 802, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/t-magazine/art/10tmag-sozzani-slide-GGJF/10tmag-sozzani-slide-GGJF-superJumbo.jpg', 'height': 1604, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Stunning, Rare Images Collected by a Fashion-World Force', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Collectors and Collections', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Alaia, Azzedine', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-11-10T21:10:55+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Art', 'byline': {'original': 'By Gay Gassmann', 'person': [{'firstname': 'Gay', 'middlename': None, 'lastname': 'Gassmann', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6a94146-a88a-57de-a5b1-47a5e9e37bda', 'word_count': 375, 'uri': 'nyt://article/e6a94146-a88a-57de-a5b1-47a5e9e37bda'}, {'abstract': 'Nicolas Cage stars in the movie, which manages to make one of World War II’s great disasters dull going — even with the shark attacks.', 'web_url': 'https://www.nytimes.com/2016/11/11/movies/uss-indianapolis-men-of-courage-review-nicolas-cage.html', 'snippet': 'Nicolas Cage stars in the movie, which manages to make one of World War II’s great disasters dull going — even with the shark attacks.', 'lead_paragraph': 'The lack of subtlety in its title tells you what you need to know about “U.S.S. Indianapolis: Men of Courage,” a dramatization of an almost unbelievable World War II catastrophe. The film, directed by Mario Van Peebles, brays the story in broad strokes and clichés as if the horror of it didn’t speak for itself, which it most certainly does.', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11USSINDY/11USSINDY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/11/arts/11USSINDY/11USSINDY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11USSINDY/11USSINDY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11USSINDY/11USSINDY-articleLarge.jpg', 'height': 378, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/11/arts/11USSINDY/11USSINDY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 378}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11USSINDY/11USSINDY-jumbo.jpg', 'height': 646, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11USSINDY/11USSINDY-superJumbo.jpg', 'height': 1261, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Review: ‘U.S.S. Indianapolis,’ a War (Yawn) Catastrophe', 'kicker': None, 'content_kicker': None, 'print_headline': 'Review: ‘U.S.S. Indianapolis,’ a War (Yawn) Catastrophe', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cage, Nicolas', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'USS Indianapolis: Men of Courage (Movie)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'van Peebles, Mario', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-11-10T21:11:28+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e0b87221-0ece-5e43-a138-2d02ec3a29df', 'word_count': 269, 'uri': 'nyt://article/e0b87221-0ece-5e43-a138-2d02ec3a29df'}, {'abstract': 'After a graphic designer in California invites his ex-boyfriend to spend the weekend, lovemaking and much talk ensue.', 'web_url': 'https://www.nytimes.com/2016/11/11/movies/lazy-eye-review.html', 'snippet': 'After a graphic designer in California invites his ex-boyfriend to spend the weekend, lovemaking and much talk ensue.', 'lead_paragraph': 'The title of “Lazy Eye” is the common name for amblyopia, an ocular problem afflicting Dean (Lucas Near-Verbrugghe), a successful Los Angeles graphic designer with a second home in the Mojave Desert. As a child, he recalls, his condition was diagnosed, but he never bothered doing the recommended eye exercises to correct it.', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Review: In ‘Lazy Eye,’ Yakking Ex-Lovers Reconnect', 'kicker': None, 'content_kicker': None, 'print_headline': 'Review: In ‘Lazy Eye,’ Yakking Ex-Lovers Reconnect', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Lazy Eye (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ganis, Aaron Costa', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Near-Verbrugghe, Lucas', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kirkman, Tim', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-11-10T21:14:06+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/faa5317b-06db-5129-aed7-28c7bfab596b', 'word_count': 275, 'uri': 'nyt://article/faa5317b-06db-5129-aed7-28c7bfab596b'}, {'abstract': '“Betrayal. Sadness. Heartbreak. Numbness. Disbelief.” Despite these feelings, a reader says she will keep fighting to overcome hate and bigotry.', 'web_url': 'https://www.nytimes.com/2016/11/11/opinion/an-american-muslim-womans-heartbreak-and-hope-after-the-election.html', 'snippet': '“Betrayal. Sadness. Heartbreak. Numbness. Disbelief.” Despite these feelings, a reader says she will keep fighting to overcome hate and bigotry.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An American