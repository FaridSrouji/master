28mon2web/28mon2web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/28/opinion/28mon2web/28mon2web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/28/opinion/28mon2web/28mon2web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/28/opinion/28mon2web/28mon2web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/28/opinion/28mon2web/28mon2web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/28/opinion/28mon2web/28mon2web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pentagon: Looking for a Few Good Hackers', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Pentagon: Looking for a Few Good Hackers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cyberwarfare and Defense', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Carter, Ashton B', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-11-28T08:21:05+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/da783633-99e7-54d4-8f53-2d661a35ab8e', 'word_count': 397, 'uri': 'nyt://article/da783633-99e7-54d4-8f53-2d661a35ab8e'}, {'abstract': 'It’s not the money, it’s the incentives.', 'web_url': 'https://www.nytimes.com/2016/11/28/opinion/why-corruption-matters.html', 'snippet': 'It’s not the money, it’s the incentives.', 'lead_paragraph': 'Remember all the news reports suggesting, without evidence, that the Clinton Foundation’s fund-raising created conflicts of interest? Well, now the man who benefited from all that innuendo is on his way to the White House. And he’s already giving us an object lesson in what real conflicts of interest look like, as authoritarian governments around the world shower favors on his business empire.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/28/opinion/28krugmanWeb/28krugmanWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/28/opinion/28krugmanWeb/28krugmanWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/28/opinion/28krugmanWeb/28krugmanWeb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/28/opinion/28krugmanWeb/28krugmanWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'i