argewidth': 600, 'xlargeheight': 404}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/opinion/sunday/27whippman/27whippman-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/opinion/sunday/27whippman/27whippman-superJumbo.jpg', 'height': 1050, 'width': 1560, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/opinion/sunday/27whippman/27whippman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/27/opinion/sunday/27whippman/27whippman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/opinion/sunday/27whippman/27whippman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Actually, Let’s Not Be in the Moment', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'Actually, Let’s Not Be in the Moment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Philosophy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Brain', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-11-26T19:30:26+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ruth Whippman', 'person': [{'firstname': 'Ruth', 'middlename': None, 'lastname': 'Whippman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0b24c2d8-6880-56b9-8831-457eedf1ceeb', 'word_count': 965, 'uri': 'nyt://article/0b24c2d8-6880-56b9-8831-457eedf1ceeb'}, {'abstract': 'Bars used to be a hub for working-class politics. We could use them again today.', 'web_url': 'https://www.nytimes.com/2016/11/26/opinion/sunday/the-saloon-americas-forgotten-democratic-institution.html', 'snippet': 'Bars used to be a hub for working-class politics. We could use them again today.', 'lead_paragraph': 'Frothy lager on tap. A communal “mustache towel” hanging by the bar. Partisan debate rattling the glassware. America’s saloons once served as boisterous “poor man’s clubs,” where 19th-century laborers could make their political voices heard. In the wake of the 2016 election, with both parties struggling to connect with a disaffected working class, and just about everyone in need of a drink, Americans might want to belly up to the once-maligned saloon.', 'print_section': 'SR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/opinion/sunday/27grinspan/27grinspan-articleLarge.jpg', 'height': 440, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/27/opinion/sunday/27grinspan/27grinspan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 440}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/opinion/sunday/27grinspan/27grinspan-jumbo.jpg', 'height': 751, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/opinion/sunday/27grinspan/27grinspan-superJumbo.jpg', 'height': 1502, 'width': 2048, 'subTyp