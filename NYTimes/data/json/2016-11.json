, 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Confessore, Nicholas', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Voting and Voters', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Whites', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Midwestern States (US)', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-11-10T02:21:50+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore and Nate Cohn', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Nate', 'middlename': None, 'lastname': 'Cohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9b9c3bd6-b9b3-59ae-95c5-b72983831fe2', 'word_count': 1293, 'uri': 'nyt://article/9b9c3bd6-b9b3-59ae-95c5-b72983831fe2'}, {'abstract': 'Coming to grips with a Trump presidency, the mayor and governor cited infrastructure as a possible area of collaboration with Mr. Trump.', 'web_url': 'https://www.nytimes.com/2016/11/10/nyregion/seeking-common-ground-with-trump-cuomo-and-de-blasio-focus-on-new-york-ties.html', 'snippet': 'Coming to grips with a Trump presidency, the mayor and governor cited infrastructure as a possible area of collaboration with Mr. Trump.', 'lead_paragraph': 'As election returns poured in and panic became palpable for Democrats in New York, Gov. Andrew M. Cuomo and Mayor Bill de Blasio held fast. Hillary Clinton would be president, they told increasingly uneasy crowds on Tuesday night at what would have been her victory party in Midtown Manhattan.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10BDBCUOMO1/10BDBCUOMO1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/10/nyregion/10BDBCUOMO1/10BDBCUOMO1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10BDBCUOMO1/10BDBCUOMO1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10BDBCUOMO1/10BDBCUOMO1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/10/nyregion/10BDBCUOMO1/10BDBCUOMO1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10BDBCUOMO1/10BDBCUOMO1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10BDBCUOMO1/10BDBCUOMO1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Seeking Common Ground With Trump, Cuomo and de Blasio Focus on New York Ties', 'kicker': None, 'content_kicker': None, 'print_headline': 'Common Ground de Blasio and Cuomo Might Find With Trump? Ties to New York', 'name': None, 'seo': None, 'sub':