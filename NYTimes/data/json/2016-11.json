 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8dfe9b4e-4aaa-5933-be9e-241f64841e81', 'word_count': 487, 'uri': 'nyt://article/8dfe9b4e-4aaa-5933-be9e-241f64841e81'}, {'abstract': 'Elizabeth Eaton Converse’s story and heartbreakingly fragile songs form the backbone of Howard Fishman’s play with music.', 'web_url': 'https://www.nytimes.com/2016/11/11/theater/a-star-has-burnt-my-eye-review.html', 'snippet': 'Elizabeth Eaton Converse’s story and heartbreakingly fragile songs form the backbone of Howard Fishman’s play with music.', 'lead_paragraph': 'Popular music is rife with one-album wonders and oddball trajectories, but Elizabeth Eaton Converse, known as Connie, is a textbook cult artist. When her lone record, “How Sad, How Lovely,” came out in 2009, she had been gone for 35 years. One day in 1974, she got into her VW Beetle and left her Ann Arbor, Mich., home. She had recently turned 50, and was never heard from again.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11STARBURNT/11STARBURNT-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/11/arts/11STARBURNT/11STARBURNT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11STARBURNT/11STARBURNT-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11STARBURNT/11STARBURNT-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11STARBURNT/11STARBURNT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/11/arts/11STARBURNT/11STARBURNT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11STARBURNT/11STARBURNT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: A Lost Folk Musician’s Haunted Dreamland in ‘A Star Has Burnt My Eye’', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Fragile Songs of a Cult Artist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Vincentelli, Elisabeth', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'A Star Has Burnt My Eye (Play)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fishman, Howard (1970- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Converse, Elizabeth Eaton (Connie)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Lazar, Paul', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Academy of Music', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-11-10T22:30:04+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Theater', 'byline': {'original': 'By Elisabeth Vincentelli', 'person': [{'firstname': 'Elisabeth', 'middlename': None, 'lastname': 'Vincentelli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/520a3bfd-0b52-5690-884e-4b899c2dd65b', 'word_count': 440, 'uri': 'nyt://article/520a3bfd-0b52-5690-884e-4b899c2dd65b'}, {'abstract': '“Marilyn Minter: Pretty/Dirty,” an exhibition at the Brooklyn Museum, regularly fulfills its contradictory subtitle; many works are ravishingly beautiful.', 'web_url': 'https://www.nytimes.com/2016/11/11/arts/design/a-nasty-woman-of-contemporary-art-fearlessly-renders-the-body.html', 'snippet': '“Marilyn Minter: Pretty/Dirty,” an exhibition at the Brooklyn Museum, regularly fulfills its contradictory subtitle; many works are ravishingly beautiful.', 'lead_paragraph': 'After a presidential campaign that underscored various women’s rights issues, what better art exhibition to review than one devoted to provocative images of female independence at its most intimate, centering explicitly on the body.', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11MINTERJP1/11MINTERJP1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/11/arts/11MINTERJP1/11MINTERJP1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11MINTERJP1/11MINTERJP1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11MINTERJP1/11MINTERJP1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/11/arts/11MINTERJP1/11MINTERJP1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/11/arts/11MINTERJP1/11MINTERJP1-