mbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/19/world/21KOREAWOMEN4/21KOREAWOMEN4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gender Colors Outrage Over Scandal Involving South Korea’s President', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gender Invoked in Outrage Over Scandal in South Korea', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Park Geun-hye', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': "Women's Rights", 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Choi Soon-sil', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Extortion and Blackmail', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-11-21T09:20:55+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Choe Sang-Hun', 'person': [{'firstname': 'Choe', 'middlename': None, 'lastname': 'Sang-Hun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b6457ede-3b2d-50c3-b43a-97538c6073dd', 'word_count': 1320, 'uri': 'nyt://article/b6457ede-3b2d-50c3-b43a-97538c6073dd'}, {'abstract': 'White Americans are starting, once again, to see themselves as a distinct identity group — and to wield power as one.', 'web_url': 'https://www.nytimes.com/2016/11/27/magazine/the-identity-politics-of-whiteness.html', 'snippet': 'White Americans are starting, once again, to see themselves as a distinct identity group — and to wield power as one.', 'lead_paragraph': 'Three years ago, I read “Adventures of Huckleberry Finn” to my daughter. She smiled as she heard about Huck’s mischief, his jokes, his dress-up games, but it was his relationship with the runaway slave Jim that intrigued her most. Huck and Jim travel together as Jim seeks his freedom; at times, Huck wrestles with his decision to help. In the end, Tom Sawyer concocts an elaborate scheme for Jim’s release.', 'print_section': 'MM', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27firstwords1/27firstwords1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/27/magazine/27firstwords1/27firstwords1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27firstwords1/27firstwords1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27firstwords1/27firstwords1-articleLarge-v3.jpg', 'height': 482, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/27/magazine/27firstwords1/27firstwords1-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 482}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27firstwords1/27firstwords1-jumbo-v3.jpg', 'height': 823, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27firstwords1/27firstwords1-superJumbo-v3.jpg', 'height': 1646, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The Identity Politics of Whiteness', 'kicker': 'First Words', 'content_kicker': None, 'print_headline': 'Group Think', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lalami, Laila', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Whites', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 10, 'major': 'N'}], 'pub_date': '2016-11-21T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Laila Lalami', 'person': [{'firstname': 'Laila', 'middlename': None, 'lastname': 'Lalami', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0161a2ef-8b0a-56e4-bc67-225f64060d36', 'word_count': 1330, 'uri': 'nyt://article/0161a2ef-8b0a-56e4-bc67-225f64060d36'}, {'abstract': 'The media personality on learning from his mistakes and why Donald Trump could be one of the most dangerous presidents to ever come into the Oval Office.', 'web_url': 'https://www.nytimes.com/2016/11/27/magazine/glenn-beck-is-sorry-about-all-that.html', 'snippet': 'The media personality on learning from his mistakes and why Donald Trump could be one of the most dangerous presidents to ever come into the Oval Office.', 'lead_paragraph': 'You’ve recently been talking a lot about wanting to warn liberals, based on your experience, now that Donald Trump is president-elect. I don’t imagine that many liberals listen to your show, but here you are on the back page of The New York Times Magazine. Here is your liberal audience. What do you want to say to them? Please be better than I was. Please learn from my mistakes. Let’s just take it from 2000: George W. Bush was called an idiot, among other things. It got so bad that Republicans and conservatives just stopped listening to the media, because we made everything about jingoism. And so what happened? The pendulum swung back so far the other way that the next guy who was elected president offered hope and change, but all a lot of people saw was that he, for a while, wasn’t wearing a flag pin. They stopped listening to people on the left. Now we’re here in crazy town. What we need now is for reasonable people to sit down with each other and say: O.K., your guy wasn’t the end of the world. My guy wasn’t the end of the world. How can we talk to each other?', 'print_section': 'MM', 'print_page': '70', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/20/magazine/20talk1/20talk1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/20/magazine/20talk1/20talk1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/20/magazine/20talk1/20talk1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/20/magazine/20talk1/20talk1-articleLarge-v2.jpg', 'height': 996, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/20/magazine/20talk1/20talk1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 996}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/20/magazine/20talk1/20talk1-jumbo-v2.jpg', 'height': 1024, 'width': 618, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/20/magazine/20talk1/20talk1-superJumbo-v2.jpg', 'height': 1369, 'width': 825, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Glenn Beck Is Sorry About All That', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'Glenn Beck Is Sorry About All That', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cox, Ana Marie', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Beck, Glenn', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-11-21T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Ana Marie Cox', 'person': [{'firstname': 'Interview', 'middlename': 'Ana', 'lastname': 'Marie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d7112e6-316e-5827-825f-c02c99287400', 'word_count': 697, 'uri': 'nyt://article/0d7112e6-316e-5827-825f-c02c99287400'}, {'abstract': 'In his new film, “Silence,” he returns to a subject that has animated his entire life’s work and that also sparked his career’s greatest controversy: the nature of faith.', 'web_url': 'https://www.nytimes.com/2016/11/27/magazine/the-passion-of-martin-scorsese.html', 'snippet': 'In his new film, “Silence,” he returns to a subject that has animated his entire life’s work and that also sparked his career’s greatest controversy: the nature of faith.', 'lead_paragraph': 'A\u2009man was on a train in Japan, reading a novel set in Japan. The train slid past the mountains, bound for Kyoto, where the man, bearded, bright-eyed, was headed. The year was 1989. The train was a bullet train.', 'print_section': 'MM', 'print_page': '44', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27scorsese1/27scorsese1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/27/magazine/27scorsese1/27scorsese1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27scorsese1/27scorsese1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27scorsese1/27scorsese1-articleLarge-v2.jpg', 'height': 770, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/27/magazine/27scorsese1/27scorsese1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 770}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27scorsese1/27scorsese1-jumbo-v2.jpg', 'height': 1024, 'width': 799, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/27/magazine/27scorsese1/