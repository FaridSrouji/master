 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'European Commission', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Ireland', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Vestager, Margrethe', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Shelters', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-11-09T21:55:56+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Mark Scott', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/64c7d8b9-cb42-5a40-b32c-4f671ad5205c', 'word_count': 383, 'uri': 'nyt://article/64c7d8b9-cb42-5a40-b32c-4f671ad5205c'}, {'abstract': 'Elections determine power, not truth.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/11/09/now-what-personal-thoughts/', 'snippet': 'Elections determine power, not truth.', 'lead_paragraph': 'Anyone who claims to be philosophical and detached after yesterday is either lying or has something very wrong with him (or her, but I doubt many women are in that camp.) It’s a disaster on multiple levels, and the damage will echo down the decades if not the generations. And like anyone on my side of this debate, I keep feeling waves of grief.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Now What? Personal Thoughts', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-11-09T22:00:55+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/61a26160-1082-5b9c-9121-7b668dc3e9f2', 'word_count': 321, 'uri': 'nyt://article/61a26160-1082-5b9c-9121-7b668dc3e9f2'}, {'abstract': 'The departure of Adam Bain and reshuffling of his duties and aides are part of a significant shake-up under Jack Dorsey, who became C.E.O. last year.', 'web_url': 'https://www.nytimes.com/2016/11/10/technology/adam-bain-twitter-chief-operating-officer-step-down.html', 'snippet': 'The departure of Adam Bain and reshuffling of his duties and aides are part of a significant shake-up under Jack Dorsey, who became C.E.O. last year.', 'lead_paragraph': 'SAN FRANCISCO — For many months, Twitter has been trying to reshape itself as a growing social media service. That attempt now includes reshaping the company’s top ranks.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/business/10TWITTER/10TWITTER-articleLarge.jpg', 'height': 381, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/10/business/10TWITTER/10TWITTER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 381}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/business/10TWITTER/10TWITTER-jumbo.jpg', 'height': 651, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/business/10TWITTER/10TWITTER-superJumbo.jpg', 'height': 1301, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/business/10TWITTER/10TWITTER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/10/business/10TWITTER/10TWITTER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/business/10TWITTER/10TWITTER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Twitter’s Chief Operating Officer to Step Down', 'kicker': None, 'content_kicker': None, 'print_headline': 'Shake-Up at Twitter as Chief Operating Officer Announces His Departure', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Twitter', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bain, Adam M (1973- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Noto, Anthony J', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-11-09T22:01:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Mike Isaac', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Isaac', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/99ff2946-3c17-585d-97ab-eb2f8f5deffe', 'word_count': 599, 'uri': 'nyt://article/99ff2946-3c17-585d-97ab-eb2f8f5deffe'}, {'abstract': 'Supporters of Hillary Clinton who gathered outside the New Yorker hotel in Manhattan before her concession speech expressed their trepidation about the years ahead.', 'web_url': 'https://www.nytimes.com/2016/11/10/nyregion/hillary-clinton-supporters-election-trump.html', 'snippet': 'Supporters of Hillary Clinton who gathered outside the New Yorker hotel in Manhattan before her concession speech expressed their trepidation about the years ahead.', 'lead_paragraph': 'Under a drizzling gray sky, they arrived in droves on Wednesday to bid an anguished farewell to the woman they had dreamed of calling Madam President. The streets abutting the New Yorker hotel in Manhattan teemed with the bereft, with the emotionally and politically wounded seeking solace, camaraderie and some kind of reassurance that they could weather Hillary Clinton’s astonishing loss to Donald J. Trump.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10NYVOICES/10NYVOICES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/10/nyregion/10NYVOICES/10NYVOICES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10NYVOICES/10NYVOICES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10NYVOICES/10NYVOICES-articleLarge.jpg', 'height': 409, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/10/nyregion/10NYVOICES/10NYVOICES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 409}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyregion/10NYVOICES/10NYVOICES-jumbo.jpg', 'height': 698, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/10/nyreg