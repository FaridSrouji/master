ork Times', 'multimedia': [], 'headline': {'main': 'Mikheil Saakashvili Resigns Post in Ukraine, Citing Corruption', 'kicker': None, 'content_kicker': None, 'print_headline': 'Former Georgian Leader Quits His Reform Effort in Ukraine, Citing Corruption', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Saakashvili, Mikheil', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Kiev (Ukraine)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia (Georgian Republic)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ukraine', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Poroshenko, Petro Olekseyevich', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-11-07T15:47:32+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Ivan Nechepurenko', 'person': [{'firstname': 'Ivan', 'middlename': None, 'lastname': 'Nechepurenko', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45514ef0-486d-5f1d-a8b1-2156fb5290d8', 'word_count': 450, 'uri': 'nyt://article/45514ef0-486d-5f1d-a8b1-2156fb5290d8'}, {'abstract': 'Donald Trump claims the election will be “rigged” in favor of Hillary Clinton, but Republicans are the ones threatening the democratic process.', 'web_url': 'https://www.nytimes.com/2016/11/07/opinion/five-ways-republicans-are-threatening-voting-rights.html', 'snippet': 'Donald Trump claims the election will be “rigged” in favor of Hillary Clinton, but Republicans are the ones threatening the democratic process.', 'lead_paragraph': 'Donald Trump has been claiming for months now that Tuesday’s election will be “rigged.” But the only ones threatening the democratic process are Mr. Trump, with his thinly veiled calls for voter suppression, and Republicans in state governments doing their utmost to keep minority voters from the polls. Below are five ways the candidate and the Republican Party are working to suppress voting this year, drawn from recent editorials:', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/07/opinion/07northWeb/07northWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/07/opinion/07northWeb/07northWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/07/opinion/07northWeb/07northWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/07/opinion/07northWeb/07northWeb-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/07/opinion/07northWeb/07northWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/07/opinion/07northWeb/07northWeb-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/07/opinion/07northWeb/07northWeb-superJumbo.jpg', 'height': 1063, 'width': 1890, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Five Ways Republicans Are Threatening Voting Rights', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{