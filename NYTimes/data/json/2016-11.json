h': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/07/learning/booksLN/booksLN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Books Do You Think Every Teenager Should Read?', 'kicker': 'Student Opinion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-11-08T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be7bb3a0-23e2-5f68-8279-49b144d80dd7', 'word_count': 339, 'uri': 'nyt://article/be7bb3a0-23e2-5f68-8279-49b144d80dd7'}, {'abstract': 'The 2016 campaign has been about changing demographics and shifting party coalitions as much as the two main candidates.', 'web_url': 'https://www.nytimes.com/2016/11/08/us/politics/election-live.html', 'snippet': 'The 2016 campaign has been about changing demographics and shifting party coalitions as much as the two main candidates.', 'lead_paragraph': 'Donald J. Trump’s victory in the presidential race on Tuesday night capped a remarkable election in which several Democratic Senate candidates fell short and Republicans retained their majority in the House of Representatives. Here are some key takeaways from a stunning result that upended conventional expectations and set the stage for a drastic reordering of politics in Washington:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Presidential Election Live: Donald Trump’s Victory', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-11-08T10:00:07+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bc13cacd-5d38-5b02-a1d3-414868636e1d', 'word_count': 801, 'uri': 'nyt://article/bc13cacd-5d38-5b02-a1d3-414868636e1d'}, {'abstract': 'Amid criticism, officials have shelved new rules that would limit the number of fairs, spread them into more areas of the city and require a greater diversity of offerings.', 'web_url': 'https://www.nytimes.com/2016/11/09/nyregion/plan-to-rein-in-new-yorks-street-fairs-prompts-unexpected-backlash.html', 'snippet': 'Amid criticism, officials have shelved new rules that would limit the number of fairs, spread them into more areas of the city and require a greater diversity of offerings.', 'lead_paragraph': 'They hold the promise of vibrancy, the allure of a city thoroughfare repurposed with the tent-lined look of a traveling circus. But the street fairs that can sometimes clog the corridors of Manhattan are also the bane of many, from drivers caught in the resulting snarl to those grown weary of the fairs’ banal ubiquity.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/nyregion/08STREETFAIRS1/08STREETFAIRS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/11/08/nyregion/08STREETFAIRS1/08STREETFAIRS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/nyregion/08STREETFAIRS1/08STREETFAIRS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/nyregion/08STREETFAIRS1/08STREETFAIRS1-articleLarge.jpg', 'height': 408, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/08/nyregion/08STREETFAIRS1/08STREETFAIRS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 408}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/nyregion/08STREETFAIRS1/08STREETFAIRS1-jumbo.jpg', 'height': 697, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/08/nyregion/08STREETFAIRS1/08STREETFAIRS1-superJumbo.jpg', 'height': 1394, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Plan to Rein In New York’s Street Fairs Prompts Unexpected Backlash', 'kicker': None, 'content_kicker': None, 'print_headline': 'Plan to Limit Street Fairs Ignites Swift Resistance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Street Fairs and Festivals', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Midtown Area (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-11-08T10:00:22+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By J. David Goodman', 'perso