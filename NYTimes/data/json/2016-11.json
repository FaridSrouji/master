ticleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/03/business/04WHEELS/04WHEELS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/03/business/04WHEELS/04WHEELS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/03/business/04WHEELS/04WHEELS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In Russia, a Western Taste for High-End Auto Sales', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': 'In a Slow Russian Market, a Taste for Luxury Cars From the West', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Mercedes-Benz', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Porsche AG', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Bayerische Motorenwerke AG', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Luxury Goods and Services', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-11-03T16:23:50+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Automobiles', 'subsection_name': 'Wheels', 'byline': {'original': 'By Stephen Williams', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ffb1e95-6cd3-54df-a3cb-7dfd57d28944', 'word_count': 808, 'uri': 'nyt://article/0ffb1e95-6cd3-54df-a3cb-7dfd57d28944'}, {'abstract': 'It’s the best way to make sense of the continent’s epic scope, wild splendor and bloody colonial history.', 'web_url': 'https://www.nytimes.com/2016/11/03/t-magazine/africa-train-travel.html', 'snippet': 'It’s the best way to make sense of the continent’s epic scope, wild splendor and bloody colonial history.', 'lead_paragraph': 'JUST A FEW HOURS INTO our train ride, we know the passengers in the cabins on either side of ours: On one side are two young Canadians on a monthslong, round-the-world backpacking trip. On the other are four middle-aged women on a trading expedition from their towns in Zambia to Dar es Salaam, where they’ll buy supplies for their shops, including clothes and spare parts for cars. They’re not waiting to get to Dar to get started: At every whistle-stop town along the way, vendors try to sell things through the window — often produce at prices far below those in the Tanzanian metropolis. So the women are stocking up on items they can sell for a profit when we arrive in a day or two: tomatoes, oranges, passion fruit, boiled peanuts and, just this morning, roasted caterpillars.', 'print_section': 'M2', 'print_page': '179', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/03/t-magazine/africa-train-travel-slide-F2RZ/africa-train-travel-slide-F2RZ-articleLarge.jpg', 'height': 489, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/11/03/t-magazine/africa-train-travel-slide-F2RZ/africa-train-travel-slide-F2RZ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 489}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/11/03/t-magazine/africa-train-travel-slide-F2RZ/africa-train-travel-slide-F2RZ-jumbo.jpg', 'height': 834, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'capti