umbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/01/science/01SLEEP/01SLEEP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/01/science/01SLEEP/01SLEEP-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/12/01/science/01SLEEP/01SLEEP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/01/science/01SLEEP/01SLEEP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/01/science/01SLEEP/01SLEEP-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Insomniacs Are Helped by Online Therapy, Study Finds', 'kicker': None, 'content_kicker': None, 'print_headline': 'Chronic Insomniacs Are Helped by Online Therapy, Study Finds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Insomnia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Carey, Benedict', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'JAMA Psychiatry (Journal)', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-11-30T17:02:09+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Health', 'byline': {'original': 'By Benedict Carey', 'person': [{'firstname': 'Benedict', 'middlename':