-v2.jpg', 'height': 433, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/12/arts/dance/12TALLCHIEF/12TALLCHIEF-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 433}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/dance/12TALLCHIEF/12TALLCHIEF-jumbo-v2.jpg', 'height': 739, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/dance/12TALLCHIEF/12TALLCHIEF-superJumbo-v2.jpg', 'height': 1477, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/dance/12TALLCHIEF/12TALLCHIEF-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/12/arts/dance/12TALLCHIEF/12TALLCHIEF-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/dance/12TALLCHIEF/12TALLCHIEF-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Maria Tallchief, a Dazzling Ballerina and Muse for Balanchine, Dies at 88', 'kicker': None, 'content_kicker': None, 'print_headline': 'Maria Tallchief, a Dazzling Ballerina and Muse for Balanchine, Dies at 88', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Anderson, Jack', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tallchief, Maria', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'organiz