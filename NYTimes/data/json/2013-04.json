id': 'nyt://article/1ca68753-bc0a-57c5-b15b-37a67a2d5b89', 'word_count': 501, 'uri': 'nyt://article/1ca68753-bc0a-57c5-b15b-37a67a2d5b89'}, {'abstract': 'About half of the pay for the bank’s chief executive, Brian Moynihan, is now tied to hitting specific targets for average return on assets and tangible book value by 2015.', 'web_url': 'https://dealbook.nytimes.com/2013/04/17/for-bank-of-america-c-e-o-greed-would-be-a-good-thing/', 'snippet': 'About half of the pay for the bank’s chief executive, Brian Moynihan, is now tied to hitting specific targets for average return on assets and tangible book value by 2015.', 'lead_paragraph': 'Bank of America investors had better hope the bank’s chief executive, Brian T. Moynihan, is long-term greedy. About half his pay is now tied to hitting specific targets for average return on assets and tangible book value by 2015. The bank’s first-quarter showing of $2.3 billion applicable to shareholders is better than last year. But without significant further improvement, Mr. Moynihan’s going to fall way short.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For Bank of America, C.E.O. Greed Would Be a Good Thing', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Company Reports', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Compensation', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Moynihan, Brian T', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bank of America Corporation', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-17T20:41:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Agnes T. Crane', 'person': [{'firstname': 'Agnes', 'middlename': 'T.', 'lastname': 'Crane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_materia