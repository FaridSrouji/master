iness/Bizday-Week-in-Pictures-slide-XDO7/Bizday-Week-in-Pictures-slide-XDO7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pictures From the Week in Business', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Goldman Sachs Group Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-20T04:56:08+0000', 'document_type': 'multimedia', 'news_desk': 'Business Day', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/eaf215eb-8907-5c51-8d21-7376271643a8', 'word_count': 0, 'uri': 'nyt://slideshow/eaf215eb-8907-5c51-8d21-7376271643a8'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/04/20/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '10 P.M. (Cinemax) SEEKING A FRIEND FOR THE END OF THE WORLD (2012) As global calamity looms, Dodge (Steve Carell), a nebbishy New York insurance salesman whose wife has fled, embarks on a road trip with the girl next door (Keira Knightley, above with Mr. Carell) to find his long-lost high school love in this comedy directed by Lorene Scafaria. Connie Britton, Rob Corddry and Patton Oswalt round out the cast as Dodge’s friends, who encourage him to react to imminent doom the way they would: by throwing off all inhibitions. Writing in The New York Times, A. O. Scott called the film a “sweet, whimsical and seriously misguided romp through end times, which goes very gentle into that good night.” The problem is not that Ms. Scafaria “takes her grave subject too lightly,” he said. “Laughter is an entirely appropriate response to something so abstractly awful as an unstoppable meteor speeding toward earth.” But, he added, “it seems downright unfair that billions of people have to die so that a middle-aged sad sack can cop a cuddle with a cute, younger bohemian neighbor.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-20T05:00:10+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/b9560981-689a-5f05-b952-5027aae686c0', 'word_count': 746, 'uri': 'nyt://article/b9560981-689a-5f05-b952-5027aae686c0'}, {'abstract': 'On the streets of Watertown, Mass., residents and police officers celebrated after a suspect was brought into custody.', 'web_url': 'https://www.nytimes.com/video/us/100000002182625/an-end-to-the-boston-manhunt.html', 'snippet': 'On the streets of Watertown, Mass., residents and police officers celebrated after a suspect was brought into custody.', 'lead_paragraph': 'On the streets of Watertown, Mass., residents and police officers celebrated after a suspect was brought into custody.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/20/us/video-tc-130419-reaction/video-tc-130419-reaction-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy':