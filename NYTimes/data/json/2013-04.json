ame': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Flattening of Design', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': 'When Design Turned Flat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ive, Jonathan', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-23T17:00:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nick Bilton', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Bilton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d240369-7808-5145-ae67-b44acdf4a0af', 'word_count': 583, 'uri': 'nyt://article/6d240369-7808-5145-ae67-b44acdf4a0af'}, {'abstract': 'On average, it’s $174.17, according to Michael Scissons, chief executive of a social media marketing firm. A conversation.', 'web_url': 'https://boss.blogs.nytimes.com/2013/04/23/putting-a-dollar-value-on-a-facebook-fan/', 'snippet': 'On average, it’s $174.17, according to Michael Scissons, chief executive of a social media marketing firm. A conversation.', 'lead_paragraph': 'As noted in Monday’s Dashboard summary of the week’s small-business news, a social media marketing firm, Syncapse, has published a report that says the average value of a Facebook fan is $174.17. Seeking further details about the calculation and its potential impact on a small-business owner’s social media investment, we reached out to the company’s chief executive, Michael Scissons, and had the following conversation, which has been edited and condensed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Putting a Dollar Value on a Facebook Fan', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-23T17:00:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Gene Marks', 'person': [{'firstname': 'Gene', 'middlename': None, 'lastname': 'Marks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c082e18-313d-5111-b46b-896111d911b1', 'word_count': 645, 'uri': 'nyt://article/9c082e18-313d-5111-b46b-896111d911b1'}, {'abstract': 'Some national parks will have reduced visiting hours and maintenance because of the across-the-board spending cuts known as the sequester.', 'web_url': 'https://intransit.blogs.nytimes.com/2013/04/23/parks-museums-and-budget-cuts/', 'snippet': 'Some national parks will have reduced visiting hours and maintenance because of the across-the-board spending cuts known as the sequester.', 'lead_paragraph': 'The across-the-board spending cuts known as the sequester may have vanished from public consciousness a couple of news cycles ago, but travelers visiting national parks and monuments and museums in Washington this summer will find sporadic reminders of them, testimony at a recent Congressional hearing suggests.', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Parks, Museums and Budget Cuts', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': 'Trending: Parks, Museums and Budget Cuts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Park Service', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Smithsonian Institution', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-23T17:00:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Tanya Mohn', 'person': [{'firstname': 'Tanya', 'middlename': None, 'lastname': 'Mohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4e89dfb-a49d-5037-a564-0b1c13b065ee', 'word_count': 197, 'uri': 'nyt://article/d4e89dfb-a49d-5037-a564-0b1c13b065ee'}, {'abstract': 'In “The New Mind of the South,” the Georgia-born writer Tracy Thompson pops in on various communities to explore how the region has changed over the last few decades, in some cases irrevocably.', 'web_url': 'https://www.nytimes.com/2013/04/24/books/the-new-mind-of-the-south-by-tracy-thompson.html', 'snippet': 'In “The New Mind of the South,” the Georgia-born writer Tracy Thompson pops in on various communities to explore how the region has changed over the last few decades, in some cases irrevocably.', 'lead_paragraph': 'W. J. Cash, the author of “The Mind of the South” (1941), was a newspaperman, a Mencken devotee and a manic-depressive. When he killed himself, not long after his book was published, he was newly married and had a fresh Guggenheim fellowship in his pocket. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/books/24book-1/24book-1-articleLarge.jpg', 'height': 923, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/24/books/24book-1/24book-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 923}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url':