iew', 'content_kicker': None, 'print_headline': 'This Ain’t California', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Berlin (Germany)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Persiel, Marten', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-12T01:30:48+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/45f2371d-f0db-5246-809c-9101e06ead28', 'word_count': 274, 'uri': 'nyt://article/45f2371d-f0db-5246-809c-9101e06ead28'}, {'abstract': 'A documentary by Graham Meriwether addresses the ills of the American meat industry and an alternative, grass-based system.', 'web_url': 'https://www.nytimes.com/2013/04/12/movies/american-meat-a-documentary-by-graham-meriwether.html', 'snippet': 'A documentary by Graham Meriwether addresses the ills of the American meat industry and an alternative, grass-based system.', 'lead_paragraph': 'Plainly and persistently presented, the inelegantly titled “American Meat” argues like a fair-minded editorial for a return to more healthful methods in meat farming. Instead of playing up modern industrial farms as hell on earth, this documentary by Graham Meriwether takes a tack sympathetic to farmers in setting forth its alternative, but it’s still an advocacy film better suited for a class than for a cinema.', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/arts/14RDP_