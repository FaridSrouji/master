er': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1464d8e-9efa-5d7d-9de7-9ea0ae0999a3', 'word_count': 706, 'uri': 'nyt://article/c1464d8e-9efa-5d7d-9de7-9ea0ae0999a3'}, {'abstract': 'A Texas lawmaker has filed legislation that would allow trucks to pay an $80 fee in exchange for crossing the border overweight.', 'web_url': 'https://www.nytimes.com/2013/04/14/us/heavier-trucks-from-mexico-could-prove-boon-for-texas.html', 'snippet': 'A Texas lawmaker has filed legislation that would allow trucks to pay an $80 fee in exchange for crossing the border overweight.', 'lead_paragraph': 'Each year, just before they approach the United States border, thousands of truck drivers hauling produce from western Mexico to southern Texas stop in the city of Reynosa to lighten their loads.', 'print_section': 'A', 'print_page': '23A', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/us/14TTProduce1-combo/14TTProduce1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/14/us/14TTProduce1-combo/14TTProduce1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/us/14TTProduce1-combo/14TTProduce1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/us/14TTProduce1-combo/14TTProduce1-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/us/14TTProduce1-combo/14TTProduce1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/14/us/14TTProduce1-combo/14TTProduce1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/us/14TTProduce1-combo/14TTProduce1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Heavier Trucks From Mexico Could Prove a Boon for Texas', 'kicker': 'The Texas Tribune', 'content_kicker': None, 'print_headline': 'Heavier Trucks From Mexico Could Prove a Boon for Texas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Texas', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Trucks and Trucking', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-13T16:55:03+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Aman Batheja', 'person': [{'firstname': 'Aman', 'middlename': None, 'lastname': 'Batheja', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5a5f2968-4673-5b4a-aec6-8796f80677a0', 'word_count': 590, 'uri': 'nyt://article/5a5f2968-4673-5b4a-aec6-8796f80677a0'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/04/13/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8:30 P.M. (HBO) THE CAMPAIGN (2012) In this comedy about rival candidates in a North Carolina Congressional election, directed by Jay Roach, Will Ferrell, above, plays Cam Brady, a blow-dried Democrat espousing a platform of guns, God and family while violating his marriage vows at every turn. Zach Galifianakis is Marty Huggins, the sweet, wimpy son of a local politico (Brian Cox), plucked from obscurity by Republicans. Dylan McDermott plays the hatchet man dispatched to make Marty into a political machine. “You can chuckle at the buffoonery, raise your eyebrows at the baroque scatological and sexual humor — Mom, they said ‘penis’ again! — and conclude that ‘The Campaign’ goes too far,” A. O. Scott wrote in The New York Times. “But then a glance at some of the clowns we do elect, perhaps especially to our national legislature, might lead you in the opposite direction. Really, the movie could not possibly go far enough unless the screenwriters (Chris Henchy and Shawn Harwell) had abandoned all invention and transcribed the script directly from C-Span.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-13T17:00:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/13011d9a-afd5-5b18-885f-6563de176123', 'word_count': 755, 'uri': 'nyt://article/13011d9a-afd5-5b18-885f-6563de176123'}, {'abstract': 'The evangelical relationship with God often resembles that between client and therapist. The theological problem of evil isn’t as significant as it is for Protestants and Catholics.', 'web_url': 'https://www.nytimes.com/2013/04/14/opinion/sunday/luhrmann-when-god-is-your-therapist.html', 'snippet': 'The evangelical relationship with God often resembles that between client and therapist. The theological problem of evil isn’t as significant as it is for Protestants and Catholics.', 'lead_paragraph': 'IT had never occurred to me to think of God as a therapist when I began to spend time, 10 years ago, at an evangelical church in Chicago. Like many secular observers, I was interested in the fact that people like me seemed to experience reality in a fundamentally different manner. I soon came to realize that one of the most important features of these churches is that they offer a powerful way to deal with anxiety and distress, not because of what people believe but because of what they do when they pray.', 'print_section': 'SR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/opinion/tanya-lurmann/tanya-lurmann-articleLarge-v3.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/05/opinion/tanya-lurmann/tanya-lurmann-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/opinion/tanya-lurmann/tanya-lurmann-jumbo-v3.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/opinion/tanya-lurmann/tanya-lurmann-superJumbo-v3.jpg', 'height': 1024, 'width': 1024, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/opinion/tanya-lurmann/tanya-lurmann-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/05/opinion/tanya-lurmann/tanya-lurmann-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/opinion/tanya-lurmann/tanya-lurmann-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When God Is Your Therapist', 'kicker': 'Op-Ed Guest Columnist', 'content_kicker': None, 'print_headline': 'When God Is Your Therapist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Luhrmann, T M', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Evangelical Movement', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-13T17:07:05+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By T. M. Luhrmann', 'person': [{'firstname': 'T.', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7474e3cd-1bae-5820-964c-5cba3fe62505', 'word_count': 871, 'uri': 'nyt://article/7474e3cd-1bae-5820-964c-5cba3fe62505'}, {'abstract': 'The overwhelming majority of chemicals in use today have never been independently tested for safety.', 'web_url': 'https://www.nytimes.com/2013/04/14/sunday-review/think-those-chemicals-have-been-tested.html', 'snippet': 'The overwhelming majority of chemicals in use today have never been independently tested for safety.', 'lead_paragraph': 'MANY Americans assume that th