organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d119d9ae-d759-5238-9096-f2e39f7e2826', 'word_count': 812, 'uri': 'nyt://article/d119d9ae-d759-5238-9096-f2e39f7e2826'}, {'abstract': 'Directors at financial institutions faced little consequences for their poor decisions, before and after the financial crisis, according to a study.', 'web_url': 'https://dealbook.nytimes.com/2013/04/05/little-accountability-for-directors-despite-poor-performance/', 'snippet': 'Directors at financial institutions faced little consequences for their poor decisions, before and after the financial crisis, according to a study.', 'lead_paragraph': 'Aficionados of good corporate governance shouldn’t get too excited about the fact that two Hewlett-Packard directors are leaving the board and a third, Raymond J. Lane, is stepping down as chairman. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Little Accountability for Directors, Despite Poor Performance', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Boards of Directors', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lane, Raymond J', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Hewlett-Packard Company', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-05T15:07:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Steven Davidoff Solomon', 'person': [{'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3fd54067-25d6-5942-b9b4-a28c2499af5b', 'word_count': 838, 'uri': 'nyt://article/3fd54067-25d6-5942-b9b4-a28c2499af5b'}, {'abstract': 'Bill Nelson of Florida is the 51st senator to come out in support of same-sex marriage.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/04/05/marriage-equality-tipping-point/', 'snippet': 'Bill Nelson of Florida is the 51st senator to come out in support of same-sex marriage.', 'lead_paragraph': 'Florida Senator Bill Nelson, who said last week that “marriage is between a man and a woman,” said yesterday that he supports marriage equality. “If we are endowed by our creator with rights, then why shouldn’t those be attainable by gays and lesbians?” he wrote in a statement to The Tampa Bay Times. “Simply put, if the Lord made homosexuals as well as heterosexuals, why should I discriminate against their civil marriage? I shouldn’t, and I won’t. So I will add my name to the petition of senators asking the Supreme Court to declare the law that prohibits gay marriage unconstitutional.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Marriage Equality Tipping Point', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Nelson, Bill (1942- )', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-05T15:08:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Juliet Lapidos', 'person': [{'firstname': 'Juliet', 'middlename': None, 'lastname': 'Lapidos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/58a689cf-f4f5-543a-8b00-3017d1fbf910', 'word_count': 227, 'uri': 'nyt://article/58a689cf-f4f5-543a-8b00-3017d1fbf910'}, {'abstract': 'The question is whether the bondholders can get the bankruptcy court to force Stockton out of Calpers, perhaps as the price for continuing its Chapter 9 case.', 'web_url': 'https://dealbook.nytimes.com/2013/04/05/a-bankruptcy-and-now-a-pension-test/', 'snippet': 'The question is whether the bondholders can get the bankruptcy court to force Stockton out of Calpers, perhaps as the price for continuing its Chapter 9 case.', 'lead_paragraph': 'Stockton, Calif.,  has been allowed into Chapter 9 bankruptcy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Bankruptcy, and Now a Pension Test', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bankruptcies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pensions and Retirement Plans', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'California Public Employees Retirement System', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Stockton (Calif)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-05T15:11:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Stephen J. Lubben', 'person': [{'firstname': 'Stephen', 'middlename': 'J.', 'lastname': 'Lubben', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1dad7793-1c9b-574c-8af6-d353a97f8aea', 'word_count': 688, 'uri': 'nyt://article/1dad7793-1c9b-574c-8af6-d353a97f8aea'}, {'abstract': 'Closets are increasingly being recognized as a factor in the sale — or lack thereof — of a New York City apartment.', 'web_url': 'https://www.nytimes.com/2013/04/07/realestate/closets-please-and-the-bigger-the-better.html', 'snippet': 'Closets are increasingly being recognized as a factor in the sale — or lack thereof — of a New York City apartment.', 'lead_paragraph': 'When Apartment J in a Prospect Heights co-op went on the market last summer, 120 people streamed through to see it. At packed open houses, potential buyers marveled at the beautifully renovated kitchen, the privacy-friendly split bedroom layout, and the proximity to Prospect Park.', 'print_section': 'RE', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/07JUMPCOVER1_SPAN/07JUMPCOVER1_SPAN-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/realestate/07JUMPCOVER1_SPAN/07JUMPCOVER1_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/07JUMPCOVER1_SPAN/07JUMPCOVER1_SPAN-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/07JUMPCOVER1_SPAN/07JUMPCOVER1_SPAN-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/07JUMPCOVER1_SPAN/07JUMPCOVER1_SPAN-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/07/realestate/07JUMPCOVER1_SPAN/07JUMPCOVER1_SPAN-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/07JUMPCOVER1_SPAN/07JUMPCOVER1_SPAN-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Closets, Please, and the Bigger the Better', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hooked by a Closet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gootman, Elissa', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Closets', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Storage', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-05T15:12:59+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Elissa Gootman', 'person': [{'firstname': 'Elissa', 'middlename': None, 'lastname': 'Gootman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4e234ad-1d6c-57b7-92ae-803108d40da8', 'word_count': 1889, 'uri': 'nyt://article/d4e234ad-1d6c-57b7-92ae-803108d40da8'}, {'abstract': 'Ken Salazar took over an agency that had been the scene of financial scandal and political malpractice in the Bush administration and succeeded in restoring a measure of ethics and morale.', 'web_url': 'https://www.nytimes.com/2013/04/06/us/politics/ken-salazar-joyful-run-interior-secretary.html', 'snippet': 'Ken Salazar took over an agency that had been the scene of financial scandal and political malpractice in the Bush administration and succeeded in restoring a measure of ethics and morale.', 'lead_paragraph': 'WASHINGTON — Ken Salazar, a man of unnaturally sunny disposition in an often gloomy town, may be the happiest person in the Obama administration these days. He is going home to Colorado next week, provided his successor as interior secretary is confirmed as expected.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/politics/06salazar/06salazar-articleLarge.jpg', 'height': 975, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/06/us/politics/06salazar/06salazar-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 975}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/politics/06salazar/06salazar-jumbo.jpg', 'height': 1024, 'width': 631, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/politics/06salazar/06salazar-superJumbo.jpg', 'height': 2048, 'width': 1261, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/politics/06salazar/06salazar-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/06/us/politics/06salazar/06salazar-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/politics/06salazar/06salazar-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Salazar Looks Back on a ‘Joyful Run’ as Interior Secretary', 'kicker': None, 'content_kicker': None, 'print_headline': 'Salazar Looks Back on a ‘Joyful Run’ as Interior Secretary', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Salazar, Ken', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Interior Department', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-05T15:14:03+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By John M. Broder', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a611b285-2989-5197-931d-ff05f409b3fe', 'word_count': 719, 'uri': 'nyt://article/a611b285-2989-5197-931d-ff05f409b3fe'}, {'abstract': 'A day in the life of armed America.', 'web_url': 'https://nocera.blogs.nytimes.com/2013/04/05/the-gun-report-april-5-2013/', 'snippet': 'A day in the life of armed America.', 'lead_paragraph': 'As regular readers know, the Gun Report has become somewhat obsessed with the many cases of — let’s not mince words here — reckless endangerment, where a parent or guardian leaves a loaded gun around the house, which is found by a small child, who then accidentally discharges it, killing or maiming either herself or someone else.\xa0We understand how heart-wrenching this must be for the parents, who will have to face their grief and guilt for the rest of their lives.\xa0Having said that, however, we also think that if prosecutors took these parents to court on a consistent basis, these incidents would dramatically decrease. The prospect of going to jail would convince people to lock up their guns.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Gun Report: April 5, 2013', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Aurora (Colo)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Camden (NJ)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Jackson (Miss)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Kansas City (Mo)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Milwaukee (Wis)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Missouri', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Oakland (Calif)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Oklahoma City (Okla)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Paterson (NJ)', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'San Jose (Calif)', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank': 14, 'major': 'N'}], 'pub_date': '2013-04-05T15:15:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Mascia', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Mascia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e652a375-2174-5777-a3bf-5a400451e680', 'word_count': 1049, 'uri': 'nyt://article/e652a375-2174-5777-a3bf-5a400451e680'}, {'abstract': 'The Brooklyn pizza restaurant opens Monday in a new, bigger place with a bigger menu.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/04/05/why-did-frannys-cross-the-road-to-grow/', 'snippet': 'The Brooklyn pizza restaurant opens Monday in a new, bigger place with a bigger menu.', 'lead_paragraph': 'Imagine moving from a studio apartment to a classic six. That seemed to be the theme as Francine Stephens showed off the new Franny’s, opening Monday in Park Slope, Brooklyn, across Flatbush Avenue from the original. “We’re kind of growing in every way: the space, the kitchen, the menu,” she said. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Why Did Franny’s Cross the Road? To Grow', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pizza', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'ADLER, JOHN', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Park Slope (Brooklyn, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-05T15:15:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/845df9b1-ed15-519e-9722-ab4144078696', 'word_count': 241, 'uri': 'nyt://article/845df9b1-ed15-519e-9722-ab4144078696'}, {'abstract': 'A Grinnell College player scored a record 138 points in a rout over Faith Baptist Bible, and with his accomplishment came thoughts on ethical behavior in such games.', 'web_url': 'https://www.nytimes.com/2013/04/06/us/a-basketball-blowout-raises-theological-questions.html', 'snippet': 'A Grinnell College player scored a record 138 points in a rout over Faith Baptist Bible, and with his accomplishment came thoughts on ethical behavior in such games.', 'lead_paragraph': 'During the next several days, the men’s college basketball season will culminate with the Final Four of the N.C.A.A. tournament. Something like 15 million viewers will take in the telecasts, and they will reasonably assume they are watching the most important games of the year.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/06religion-grinnell1/06religion-grinnell1-articleLarge.jpg', 'height': 442, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/06/us/06religion-grinnell1/06religion-grinnell1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 442}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/06religion-grinnell1/06religion-grinnell1-jumbo.jpg', 'height': 755, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/06religion-grinnell1/06religion-grinnell1-superJumbo.jpg', 'height': 1510, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/06religion-grinnell1/06religion-grinnell1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/06/us/06religion-grinnell1/06religion-grinnell1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/us/06religion-grinnell1/06religion-grinnell1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Basketball Blowout and Its Celebration Raise Theological Questions', 'kicker': 'On Religion', 'content_kicker': None, 'print_headline': 'A Basketball Blowout and Its Celebration Raise Theological Questions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Religion and Belief', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Freedman, Samuel G', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Grinnell College', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Jack', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball (College)', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Faith Baptist Bible College and Theological Seminary (Ankeny, Iowa)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Christians and Christianity', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-04-05T15:20:10+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Samuel G. Freedman', 'person': [{'firstname': 'Samuel', 'middlename': 'G.', 'lastname': 'Freedman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8fdb3e9a-f36e-5e6b-8d6d-ab369b30c842', 'word_count': 1029, 'uri': 'nyt://article/8fdb3e9a-f36e-5e6b-8d6d-ab369b30c842'}, {'abstract': 'The former director of Design Miami has created a web site devoted to the work of artisans around the world.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/04/05/over-the-rainbow/', 'snippet': 'The former director of Design Miami has created a web site devoted to the work of artisans around the world.', 'lead_paragraph': 'Nearly three years ago, Ambra Medda, the wunderkind co-founder and director of Design Miami (and Design Miami/Basel), announced that she was resigning from the high-profile fairs that she helped start in 2005, leaving the design world to wonder what her next move would be. Well, she’s made it, and, perhaps not surprisingly, it’s a Web site. L’ArcoBaleno (Italian for “The Rainbow”), which will go live in late May, bills itself as “a content and marketplace site devoted to collectible design.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Over the Rainbow', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Design', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Medda, Ambra', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-05T15:30:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Pilar Viladas', 'person': [{'firstname': 'Pilar', 'middlename': None, 'lastname': 'Viladas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/344aa987-452b-5835-b34e-b08aca02f4ca', 'word_count': 297, 'uri': 'nyt://article/344aa987-452b-5835-b34e-b08aca02f4ca'}, {'abstract': 'John Eliot Gardiner, a founder of the period-instrument movement who turns 70 this month, has a soft spot for Bach — as evidenced by his nine-hour marathon last week.', 'web_url': 'https://www.nytimes.com/2013/04/07/arts/music/john-eliot-gardiner-and-period-music.html', 'snippet': 'John Eliot Gardiner, a founder of the period-instrument movement who turns 70 this month, has a soft spot for Bach — as evidenced by his nine-hour marathon last week.', 'lead_paragraph': 'As a child John Eliot Gardiner saw Johann Sebastian Bach every day. He would pass him on his way to the dining room, where he sang Bach motets with his parents and siblings after meals. He would glance up at Bach, returning from accompanying his mother in an aria from a cantata, in which he played the obbligato violin part. The portrait of the ruddy-faced and bewigged Bach painted in 1748 by Elias Gottlob Haussmann hung above the staircase of the family home in Dorset, England, on loan from its owner, a German musician who had befriended Mr. Gardiner’s father in the interwar years then settled in a nearby village.', 'print_section': 'AR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/arts/07GARDINER_SPAN/07GARDINER_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/arts/07GARDINER_SPAN/07GARDINER_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/arts/07GARDINER_SPAN/07GARDINER_SPAN-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/arts/07GARDINER_SPAN/07GARDINER_SPAN-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/arts/07GARDINER_SPAN/07GARDINER1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/07/arts/07GARDINER_SPAN/07GARDINER1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/arts/07GARDINER_SPAN/07GARDINER1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Crops and Music, Each in Its Season', 'kicker': None, 'content_kicker': None, 'print_headline': 'Crops and Music, Each in Its Season', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'da Fonseca-Wollheim, Corinna', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Gardiner, John Eliot', 'rank': 3, 'major': 'N'}, {'name': '