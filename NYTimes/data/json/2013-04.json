/', 'snippet': 'Facing a fear of flying, thinking twice about calcium supplements, answers to your college decision questions and other consumer-focused news from The New York Times.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Monday Reading: Facing a Fear of Flying', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-08T11:55:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/117e2d60-c5d6-50fc-b649-0760887646b6', 'word_count': 119, 'uri': 'nyt://article/117e2d60-c5d6-50fc-b649-0760887646b6'}, {'abstract': 'Clean Power Finance, an online platform that provides software and financial services to solar professionals and investors, has raised a fresh $37 million, in a sign that enthusiasm for the solar sector has not dimmed entirely.', 'web_url': 'https://dealbook.nytimes.com/2013/04/08/clean-power-finance-raises-37-million/', 'snippet': 'Clean Power Finance, an online platform that provides software and financial services to solar professionals and investors, has raised a fresh $37 million, in a sign that enthusiasm for the solar sector has not dimmed entirely.', 'lead_paragraph': 'Clean Power Finance, an online platform that provides software and financial services to solar power professionals and investors, has raised a fresh $37 million, in a sign that enthusiasm for the solar sector has not dimmed entirely.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Clean Power Finance Raises $37 Million', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub':