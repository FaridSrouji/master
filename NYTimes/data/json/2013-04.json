role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e570cbb-423d-51d6-a8a6-ae35f1d591c0', 'word_count': 841, 'uri': 'nyt://article/0e570cbb-423d-51d6-a8a6-ae35f1d591c0'}, {'abstract': 'Kong Nay played the chapei dang weng, a lute, during a Season of Cambodia concert at the Asia Society.', 'web_url': 'https://www.nytimes.com/2013/04/22/arts/music/kong-nay-at-the-season-of-cambodia-festival.html', 'snippet': 'Kong Nay played the chapei dang weng, a lute, during a Season of Cambodia concert at the Asia Society.', 'lead_paragraph': 'The troubadour wielding a stringed instrument and singing praises, dance tunes, love songs, histories or wry comments is a nearly universal figure in traditional music, from Appalachian banjo pickers to Moroccan gnawa musicians to West African griots to Japanese minyo singers. Kong Nay, who performed at the Asia Society on Saturday night, is one of them, playing the Cambodian style called chapei: singing in a hearty voice and playing the chapei dang weng, a long-necked, two-stringed lute. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/22/arts/kong/kong-articleLarge.jpg', 'height': 447, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/22/arts/kong/kong-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 447}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/22/arts/kong/kong-jumbo.jpg', 'height': 763, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/22/arts/kong/kong-superJumbo.jpg', 'height': 1526, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'