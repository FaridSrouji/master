arah/farah-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/movies/farah/farah-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nora Ephron Prize Is Given to Director of  ‘Farah Goes Bang’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tribeca Film Festival (NYC)', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-25T16:00:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Stephanie Goodman', 'person': [{'firstname': 'Stephanie', 'middlename': None, 'lastname': 'Goodman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ce7bbac6-457a-5212-ba0f-1112a679e35c', 'word_count': 168, 'uri': 'nyt://article/ce7bbac6-457a-5212-ba0f-1112a679e35c'}, {'abstract': 'Over the summer and into autumn, the Saratoga Automobile Museum will showcase BMW cars and motorcycles from throughout the company’s long history.', 'web_url': 'https://wheels.blogs.nytimes.com/2013/04/25/from-horses-to-horsepower-bmws-come-to-saratoga-springs/', 'snippet': 'Over the summer and into autumn, the Saratoga Automobile Museum will showcase BMW cars and motorcycles from throughout the company’s long history.', 'lead_paragraph': 'The high society summer season in Saratoga Springs, in upstate New York, was built around the horse racing scene. But horsepower is the theme at the Saratoga Automobile Museum, where a herd of historic BMW cars and motorcycles go on display in an exhibition opening May 6 and running through Nov. 3.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From Horses to Horsepower: BMWs Come to Saratoga Springs', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Motorcycles, Motor Bikes and Motorscooters', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fisker, Henrik', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Presley, Elvis', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Redman, Brian', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Warhol, Andy', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Saratoga Springs (NY)', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-04-25T16:00:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Phil Patton', 'person': [{'firstname': 'Phil', 'middlename': None, 'lastname': 'Patton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b97c8306-533c-55c6-87d8-5d889493f373', 'word_count': 407, 'uri': 'nyt://article/b97c8306-533c-55c6-87d8-5d889493f373'}, {'abstract': 'Rejecting an appeal by the police, the court ruled that five women detained for wearing men’s-style prayer shawls and singing at the Western Wall were not disturbing the peace.', 'web_url': 'https://www.nytimes.com/2013/04/26/world/middleeast/jerusalem-court-upholds-ruling-in-women-of-the-wall-case.html', 'snippet': 'Rejecting an appeal by the police, the court ruled that five women detained for wearing men’s-style prayer shawls and singing at the Western Wall were not disturbing the peace.', 'lead_paragraph': 'JERUSALEM — A Jerusalem court on Thursday upheld a ruling that five women who had been detained at the Western Wall for wearing prayer shawls traditionally used by men and singing were not disturbing the public order, rejecting an appeal by the police. The decision, by the Jerusalem District Court, upheld a ruling last Thursday by a magistrates’ court. The women, activists with Women of the Wall, a feminist and pluralist religious group, have been challenging the enforcement of strict Orthodox codes at the holy site. Lawyers for the group said Thursday’s ruling undermined the basis for future detentions and arrests. There was no immediate response from the police. Israeli officials are examining a proposal to create a new prayer area for more egalitarian worship after tensions over rituals at the site caused discord between the Israeli authorities and Jewish leaders abroad.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jerusalem Court Upholds Ruling in Women of the Wall Case', 'kicker': 'World Briefing | Middle East', 'content_kicker': None, 'print_headline': 'Israel: Court Backs Women Who Pray at Western Wall', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Western Wall (Jerusalem)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Women of the Wall', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Jerusalem (Israel)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-04-25T16:04:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Isabel Kershner', 'person': [{'firstname': 'Isabel', 'middlename': None, 'lastname': 'Kershner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/cf0a7b21-1d62-5c89-8049-f1e821cca52b', 'word_count': 142, 'uri': 'nyt://article/cf0a7b21-1d62-5c89-8049-f1e821cca52b'}, {'abstract': 'The narrative is shaping up for Spain to hand over the torch to Germany as soccer’s next great superpower.', 'web_url': 'https://goal.blogs.nytimes.com/2013/04/25/the-rise-of-german-soccer/', 'snippet': 'The narrative is shaping up for Spain to hand over the torch to Germany as soccer’s next great superpower.', 'lead_paragraph': 'It was a memorable and historic week for German soccer to say the least. An all-German final now beckons after Bayern Munich and Borussia Dortmund’s emphatic victories against Barcelona and Real Madrid. Their success in Europe this season marks a significant turning point and is indicative of a larger trend, namely the rise of the Bundesliga and German soccer in general. Slowly but surely, the narrative is shaping up for Spain to hand over the torch to Germany as the game’s next great superpower.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/soccer/25bayernmunich-goal/25bayernmunich-goal-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/25/sports/soccer/25bayernmunich-goal/25bayernmunich-goal-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/soccer/25bayernmunich-goal/25bayernmunich-goal-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/soccer/25bayernmunich-goal/25bayernmunich-goal-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/soccer/25bayernmunich-goal/25bayernmunich-goal-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/25/sports/soccer/25bayernmunich-goal/25bayernmunich-goal-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/soccer/25bayernmunich-goal/25bayernmunich-goal-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Rise of German Soccer', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Bayern Munich (Soccer Team)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Dortmund (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'German Bundesliga', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-25T16:06:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Cristian Nyari', 'person': [{'firstname': 'Cristian', 'middlename': None, 'lastname': 'Nyari', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/413000d9-418a-5377-bbd4-f7729aad95c5', 'word_count': 693, 'uri': 'nyt://article/413000d9-418a-5377-bbd4-f7729aad95c5'}, {'abstract': 'The latest deaths bring the total number of Tibetans who have killed themselves by fire since February 2009 to 118, said Radio Free Asia.', 'web_url': 'https://www.nytimes.com/2013/04/26/world/asia/three-more-tibetans-die-in-self-immolations.html', 'snippet': 'The latest deaths bring the total number of Tibetans who have killed themselves by fire since February 2009 to 118, said Radio Free Asia.', 'lead_paragraph': 'BEIJING — Two Tibetans died on Wednesday after setting fire to themselves in a Tibetan region of western China to protest Chinese rule, according to reports on Thursday by Tibet advocacy groups and Radio Free Asia, which is financed by the American government. The two Tibetans, monks named Kunchok Woser and Lobsang Dawa, carried out their protest near their monastery in Dzoge County in Sichuan Province, according to Free Tibet, an advocacy group based in London. Radio Free Asia reported earlier that a third person, a 23-year-old woman, had set herself on fire in Dzamthang County of Sichuan, but then issued a new report saying that it could not confirm that episode. The news service said the two acts on Wednesday raised to 118 the number of Tibetans who have set themselves on fire since February 2009, when a young monk named Tapey did so in the town of Ngaba. Chinese security forces have flooded towns across the Tibetan plateau in an effort to stamp out the protests.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '2 Tibetans Die in Self-Immolations', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'China: 2 Tibetans Die After Setting Themselves on Fire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Tibet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immolation', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Buddhism', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-25T16:06:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Edward Wong', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/9d5ce7dd-84a7-5014-ab78-31e508547977', 'word_count': 168, 'uri': 'nyt://article/9d5ce7dd-84a7-5014-ab78-31e508547977'}, {'abstract': 'With the National Candidate Reply Date arriving on May 1, a director of college counseling advises students to look beyond statistics and go with their guts.', 'web_url': 'https://thechoice.blogs.nytimes.com/2013/04/25/tip-sheet-making-the-final-college-decision/', 'snippet': 'With the National Candidate Reply Date arriving on May 1, a director of college counseling advises students to look beyond statistics and go with their guts.', 'lead_paragraph': 'Brennan Barnard is the director of college counseling at the Derryfield School in Manchester, N.H. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/17/education/choice-tipsheet-75/choice-tipsheet-75-jumbo-v2.jpg', 'height': 75, 'width': 75, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/17/education/choice-tipsheet-75/choice-tipsheet-75-superJumbo-v2.jpg', 'height': 75, 'width': 75, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/17/education/choice-tipsheet-75/choice-tipsheet-75-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/17/education/choice-tipsheet-75/choice-tipsheet-7