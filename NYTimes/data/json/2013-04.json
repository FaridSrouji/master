nd-click adventure on a touch screen.', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/04/business/SMART1/SMART1-articleLarge.jpg', 'height': 446, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/04/business/SMART1/SMART1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 446}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/04/business/SMART1/SMART1-jumbo.jpg', 'height': 760, 'width': 1022, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/04/business/SMART1/SMART1-superJumbo.jpg', 'height': 760, 'width': 1022, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/04/business/SMART1/SMART1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/04/business/SMART1/SMART1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/04/business/SMART1/SMART1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fun, Intrigue and Drama in Touch-Screen Adventures', 'kicker': 'App Smart', 'content_kicker': None, 'print_headline': 'Fun, Intrigue and Drama in Touch-Screen Adventures', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Games', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Eaton, Kit', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile