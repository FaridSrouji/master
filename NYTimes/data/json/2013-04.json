e': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2010/05/27/business/media/stuart-elliott-headshot/stuart-elliott-headshot-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2010/05/27/business/media/stuart-elliott-headshot/stuart-elliott-headshot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Q. and A. With Stuart Elliott', 'kicker': None, 'content_kicker': None, 'print_headline': 'Q. and A. With Stuart Elliott', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Geico Corp', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-01T17:02:13+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/ae886621-6af2-5ccc-9408-c423f917a2ac', 'word_count': 535, 'uri': 'nyt://article/ae886621-6af2-5ccc-9408-c423f917a2ac'}, {'abstract': 'Adam Grant, the organizational psychologist who was the subject of Sunday’s cover story, is here to answer your career questions.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2013/04/01/the-worlds-most-helpful-guy-wants-to-help-you/', 'snippet': 'Adam Grant, the organizational psychologist who was the subject of Sunday’s cover story, is here to answer your career questions.', 'lead_paragraph': 'Sure, you could ask your therapist, hypnotherapist, life coach, medium or mom what to do about the intractable problem at work that is keeping you up at night. Or you could ask the world’s most helpful organizational psychologist, Adam Grant, whom I wrote about in this past Sunday’s cover story, to draw on the hundreds of research papers he can he can recall to shed some light on just what to do. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The World’s Most Helpful Guy Wants to Help You', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Altruism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-01T17:12:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Susan Dominus', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Dominus', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/07be04cb-341f-5334-ba47-a8c1990dbc8f', 'word_count': 197, 'uri': 'nyt://article/07be04cb-341f-5334-ba47-a8c1990dbc8f'}, {'abstract': 'American Association of Advertising Agencies, New York, is joining with units of the McCann Worldgroup to sponsor a contest that will seek ideas to help market the ad industry to a broader audience.', 'web_url': 'https://www.nytimes.com/2013/04/01/business/media/webdenda.html', 'snippet': 'American Association of Advertising Agencies, New York, is joining with units of the McCann Worldgroup to sponsor a contest that will seek ideas to help market the ad industry to a broader audience.', 'lead_paragraph': 'American Association of Advertising Agencies, New York, is joining with two units of the McCann Worldgroup to sponsor a contest called the Truth About Advertising, that will seek the best creative idea to help market the ad industry to a broader audience. The contest was spurred by research showing that although industry professionals believe the public has harsh, negative attitudes about them and the work they do, the public has many positive opinions about advertising and those who work in the industry. The contest entries are due by May 15. The other sponsors of the contest are the McCann Truth Central and Momentum Worldwide division of the McCann Worldgroup, which is part of the Interpublic Group of Companies.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Accounts and People of Note in the Advertising Industry', 'kicker': 'Webdenda', 'content_kicker': None, 'print_headline': 'Webdenda', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Public Relations and Publicity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hiring and Promotion', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-01T17:12:08+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/ee741fa8-793e-5a8a-a641-9ea60cdcaafd', 'word_count': 1268, 'uri': 'nyt://article/ee741fa8-793e-5a8a-a641-9ea60cdcaafd'}, {'abstract': 'Kai Hakone, a new high-design hotel, offers a luxuriously modern take on the traditional Japanese inn.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/04/01/soak-in-japan/', 'snippet': 'Kai Hakone, a new high-design hotel, offers a luxuriously modern take on the traditional Japanese inn.', 'lead_paragraph': 'For centuries, travelers have streamed into Hakone, Japan, to bathe in the bubbling hot springs at traditional ryokans. Kai Hakone, a new high-design hotel and thermal spa on the banks of the Sugumo river, offers a luxuriously modern take on this relaxing tradition. Guests wear chic, black-padded kimonos with their wooden clogs and bob in a series of hot pools that all have views onto pristine woods. Deluxe rooms come with their own little tatami-floored teahouses, and the food — ridiculously fresh sashimi or spring flowers with sesame — is delicate yet nourishing. Bustling Tokyo, reachable in 45 minutes by bullet train, seems a world away.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Soak in Japan', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Spas', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Hakone (Japan)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-01T17:28:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Julie Earle-Levine', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Earle-Levine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/48bc8ebc-d2c4-5835-ad37-b391bdeada56', 'word_count': 112, 'uri': 'nyt://article/48bc8ebc-d2c4-5835-ad37-b391bdeada56'}, {'abstract': 'An initiative by the 76 brand of gasoline humorously tries to eradicate the incessant beeping of car horns.', 'web_url': 'https://www.nytimes.com/2013/04/01/business/media/gasoline-brand-urges-drivers-to-stop-honkaholism.html', 'snippet': 'An initiative by the 76 brand of gasoline humorously tries to eradicate the incessant beeping of car horns.', 'lead_paragraph': 'Efforts by a leading gasoline brand to woo consumers in a nontraditional fashion are continuing with a light-hearted initiative aimed at discouraging a particularly annoying kind of vehicular noise pollution.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/business/Adco1/Adco1-articleLarge.jpg', 'height': 334, 'width': 600, 'subType': 'xlarge', 'crop_name': 'article