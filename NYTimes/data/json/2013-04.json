: [{'firstname': 'Catherine', 'middlename': None, 'lastname': 'Wagley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e36488f5-ffd3-55ff-9de1-4e78cee501f5', 'word_count': 416, 'uri': 'nyt://article/e36488f5-ffd3-55ff-9de1-4e78cee501f5'}, {'abstract': 'The National Youth Orchestra of the United States of America will perform a series of concerts in Europe, including a stop at the prestigious concert series in London.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/18/american-youth-orchestra-to-perform-at-bbc-proms/', 'snippet': 'The National Youth Orchestra of the United States of America will perform a series of concerts in Europe, including a stop at the prestigious concert series in London.', 'lead_paragraph': 'The maiden tour by a new youth orchestra established by Carnegie Hall will include an appearance at the BBC Proms concerts, Carnegie said on Thursday. The Proms engagement is a sign of the hall’s influence and the weight it is throwing behind the venture. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'American Youth Orchestra to Perform at BBC Proms', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Youth Orchestra of the United States of America', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-18T13:00:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d0811f9-4e38-59ff-810a-130c59dc7f5b', 'word_count': 121, 'uri': 'nyt://article/1d0811f9-4e38-59ff-810a-130c59dc7f5b'}, {'abstract': 'Challenging Gujarat chief minister’s credentials for the prime ministerial post, Bihar’s chief minster has upset coalition allies.', 'web_url': 'https://india.blogs.nytimes.com/2013/04/18/does-nitish-kumar-need-the-b-j-p/', 'snippet': 'Challenging Gujarat chief minister’s credentials for the prime ministerial post, Bihar’s chief minster has upset coalition allies.', 'lead_paragraph': 'NEW DELHI — Earlier this week, Bihar’s chief minister, Nitish Kumar, expressed reservations about the Gujarat chief minister Narendra Modi’s suitability for prime minister, brooking the strongest opposition yet Mr. Modi has faced from an ally.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/world/asia/18-nitish-kumar-IndiaInk/18-nitish-kumar-IndiaInk-articleLarge.jpg', 'height': 423, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/18/world/asia/18-nitish-kumar-IndiaInk/18-nitish-kumar-IndiaInk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 423}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/world/asia/18-nitish-kumar-IndiaInk/18-nitish-kumar-IndiaInk-jumbo.jpg', 'height': 722, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/world/asia/18-nitish-kumar-IndiaInk/18-nitish-kumar-IndiaInk-superJumbo.jpg', 'height': 1443, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/world/asia/18-nitish-kumar-IndiaInk/18-nitish-kumar-IndiaInk-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/18/world/asia/18-nit