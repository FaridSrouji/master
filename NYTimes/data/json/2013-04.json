ne, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Wortham, Jenna', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Hulu.com', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-10T13:03:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7030fae-e216-5d03-a20c-d1b99fe722a3', 'word_count': 841, 'uri': 'nyt://article/d7030fae-e216-5d03-a20c-d1b99fe722a3'}, {'abstract': 'Two of the National Rifle Association’s favorites in the Senate came together in a last-ditch effort on a background check deal that opened the door for Congress to consider new gun laws.', 'web_url': 'https://www.nytimes.com/2013/04/11/us/politics/compromise-on-background-checks.html', 'snippet': 'Two of the National Rifle Association’s favorites in the Senate came together in a last-ditch effort on a background check deal that opened the door for Congress to consider new gun laws.', 'lead_paragraph': 'WASHINGTON — Senator Joe Manchin III so craved a pro-gun-rights Republican as a partner for a bill to expand background checks on gun buyers that he took to buttonholing senators on the in-house subway that ferries them from their offices to the Capitol, making his pitch while his colleagues were trapped with him in the tiny car.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type':