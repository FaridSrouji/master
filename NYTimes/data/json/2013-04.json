50, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'L.A.’s Modern Architecture', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-08T17:12:17+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/3aa449c3-a5fa-5a96-beb4-c628c6239576', 'word_count': 0, 'uri': 'nyt://slideshow/3aa449c3-a5fa-5a96-beb4-c628c6239576'}, {'abstract': 'An experiment with monkeys who worked together following rules in order to get food treats suggests coordination is possible without language.', 'web_url': 'https://www.nytimes.com/2013/04/09/science/monkeys-show-ability-to-coordinate-to-solve-problems.html', 'snippet': 'An experiment with monkeys who worked together following rules in order to get food treats suggests coordination is possible without language.', 'lead_paragraph': 'Researchers have found that monkeys can cooperate to solve a problem, demonstrating that coordination among groups does not necessarily require language. The scientists, who report their findings in the journal Current Biology, had a group of vervet monkeys play a game called the forbidden circle. A single low-ranking female was trained to open a container holding a large amount of food — but only when dominant monkeys in the group stayed outside an imaginary circle. For anyone to get any treats, they all had to coordinate their activity and show restraint.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09OBOX_SPAN/09OBOX-articleLarge.jpg', 'height': 343, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/09/science/09O