ia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-jumbo.jpg', 'height': 597, 'width': 670, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-superJumbo.jpg', 'height': 597, 'width': 670, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hoping for One More ‘Yes’ Before High School Ends', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADMISSIONS STANDARDS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Cleveland (Ohio)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-08T17:58:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Will Walker', 'person': [{'firstname': 'Will', 'middlename': None, 'lastname': 'Walker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1273ed76-1c7b-5b86-8318-260306a58e71', 'word_count': 843, 'uri': 'nyt://article/1273ed76-1c7b-5b86-8318-260306a58e71'}, {'abstract': 'Walnuts are versatile enough to eat every day, from appetizers and salads to healthy desserts.', 'web_url': 'https://www.nytimes.com/2013/04/08/health/leek-and-turnip-soup-with-kale-and-walnut-garnish.html', 'snippet': 'Walnuts are versatile enough to eat every day, from appetizers and salads to healthy desserts.', 'lead_paragraph': 'Nuts in general have a lot going for them when it comes to nutritional benefits, and of all nuts walnuts may be the king. Enough scientific studies have shown proof of their cholesterol-lowering properties that the Food and Drug Administration accepted a petition filed by the California Walnut Commission in 2004 to allow them to list this is a health claim. Walnuts are also associated with a reduced risk of heart disease and inflammation, perhaps because of their high vitamin E and omega-3 content and the presence of antioxidant-rich phenolic acids, tannins and flavonoids in their skins.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/08recipehealth/08recipehealth-articleLarge.jpg', 'height': 411, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/09/science/08recipehealth/08recipehealth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 411}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/08recipehealth/08recipehealth-jumbo.jpg', 'height': 701, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/08recipehealth/08recipehealth-superJumbo.jpg', 'height': 1402, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'l