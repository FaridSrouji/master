name': 'Nick', 'middlename': None, 'lastname': 'Bilton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a1d3dfea-d69a-54fd-9e4c-f18f89d416c6', 'word_count': 743, 'uri': 'nyt://article/a1d3dfea-d69a-54fd-9e4c-f18f89d416c6'}, {'abstract': 'Is Gwyneth Paltrow’s new cookbook quack science?', 'web_url': 'https://bittman.blogs.nytimes.com/2013/04/07/healthy-eating-on-just-300-a-day/', 'snippet': 'Is Gwyneth Paltrow’s new cookbook quack science?', 'lead_paragraph': 'Gwyneth Paltrow’s second cookbook, “It’s All Good,” which was released last week, is taking heat for being an elitist farm-to-table guide sprinkled with duck eggs and $25-a-jar Manuka honey. At best it makes it seem like healthy eating is strictly for the wealthy; at worst, it’s quack science for attempting to export Paltrow’s wacky elimination diet (no bell peppers, eggplant or corn? Huh?) to a populace that’s improperly nourished and financially struggling.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Healthy Eating on Just $300 a Day', 'kicker': 'Mark Bittman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Paltrow, Gwyneth', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-07T15:24:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Mascia', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Mascia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/def89ceb-d6b2-526c-bc7a-cdbca3022123', 'word_count': 352, 'uri': 'nyt://article/def89ceb-d6b2-526c-bc7a-cdbca3022123'}, {'abstract': 'Research shows that the association between red meat and heart disease risk might be related not just to fat but also to bacteria that thrive on a component of red meat.', 'web_url': 'https://www.nytimes.com/2013/04/08/health/study-points-to-new-culprit-in-heart-disease.html', 'snippet': 'Research shows that the association between red meat and heart disease risk might be related not just to fat but also to bacteria that thrive on a component of red meat.', 'lead_paragraph': 'It was breakfast time and the people participating in a study of red meat and its consequences had hot, sizzling sirloin steaks plopped down in front of them. The researcher himself bought a George Foreman grill for the occasion, and the nurse assisting him did the cooking.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/us/MEAT/MEAT-articleLarge.jpg', 'height': 782, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/08/us/MEAT/MEAT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 782}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/us/MEAT/MEAT-jumbo.jpg', 'height': 1024, 'width': 786, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/us/MEAT/MEAT-superJumbo.jpg', 'height': 2048, 'width': 1572, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/us/MEAT/MEAT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/us/MEAT/MEAT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/us/MEAT/MEAT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Culprit in Heart Disease Goes Beyond Meat’s Fat', 'kicker': None, 'content_kicker': None, 'print_headline': 'Culprit in Heart Disease Goes Beyond Meat’s Fat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Research', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kolata, Gina', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Meat', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Heart', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Veganism', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Cleveland Clinic', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Nature Medicine (Journal)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Blood', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-04-07T17:01:26+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Health', 'byline': {'original': 'By Gina Kolata', 'person': [{'firstname': 'Gina', 'middlename': None, 'lastname': 'Kolata', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39db4c8e-8643-508a-807e-ed88056fccc7', 'word_count': 1352, 'uri': 'nyt://article/39db4c8e-8643-508a-807e-ed88056fccc7'}, {'abstract': 'The horror movie, which cost about $17 million to produce, took in a better-than-expected $26 million over the weekend.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/07/evil-dead-sets-pace-at-busy-movie-theaters/', 'snippet': 'The horror movie, which cost about $17 million to produce, took in a better-than-expected $26 million over the weekend.', 'lead_paragraph': 'North American moviegoers bellied up to a smorgasbord of choices over the weekend: R-rated demons, animated cave people, meaty action heroes and 3-D dinosaurs all delivered solid ticket sales. “Evil Dead” (Sony) was No. 1, taking in a better-than-expected $26 million; it cost about $17 million to produce. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/movies/08evildead/08evildead-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/08/movies/08evildead/08evildead-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/movies/08evildead/08evildead-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/movies/08evildead/08evildead-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/movies/08evildead/08evildead-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/movies/08evildead/08evildead-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/movies/08evildead/08evildead-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Evil Dead’ Sets Pace at Busy Movie Theaters', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '‘Evil Dead’ Steps Lively on a Busy Weekend', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Hollywood.com', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-07T17:16:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/112771ae-7792-54bf-99da-63d7f24a50c0', 'word_count': 176, 'uri': 'nyt://article/112771ae-7792-54bf-99da-63d7f24a50c0'}, {'abstract': 'The White House says a threatened filibuster by Republicans on gun control was an affront to the families of the children who died in a school shooting in Connecticut.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/04/07/white-house-pressures-g-o-p-on-gun-control/', 'snippet': 'The White House says a threatened filibuster by Republicans on gun control was an affront to the families of the children who died in a school shooting in Connecticut.', 'lead_paragraph': '6:30 p.m. | Updated WASHINGTON — The White House is stepping up its public efforts to shame Republicans into allowing a vote on gun control legislation in the Senate, saying that a threatened filibuster is an affront to the families of the children who died in the December school massacre in Newtown, Conn.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'White House Pressures G.O.P. on Gun Control', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Newtown, Conn, Shooting (2012)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-07T17:48:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b06b524-98a1-5209-aef8-bf5cdd06c48a', 'word_count': 691, 'uri': 'nyt://article/5b06b524-98a1-5209-aef8-bf5cdd06c48a'}, {'abstract': 'Ms. Pulitzer, whose tropical print dresses became a fashion classic, got her start in 1959 by spilling orange juice on her clothes.', 'web_url': 'https://www.nytimes.com/2013/04/08/fashion/lilly-pulitzer-socialite-turned-designer-dies-at-81.html', 'snippet': 'Ms. Pulitzer, whose tropical print dresses became a fashion classic, got her start in 1959 by spilling orange juice on her clothes.', 'lead_paragraph': 'Lilly Pulitzer, the Palm Beach princess of prints who created an enduring fashion uniform for wealthy socialites and jet setters almost by accident, died on Sunday at her home in Florida. She was 81.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08pulitzer_obit_2/08pulitzer_obit_2-jumbo.jpg', 'height': 594, 'width': 589, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08pulitzer_obit_2/08pulitzer_obit_2-superJumbo.jpg', 'height': 594, 'width': 589, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08pulitzer_obit_2/08pulitzer_obit_2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/obituaries/08pulitzer_obit_2/08pulitzer_obit_2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08pulitzer_obit_2/08pulitzer_obit_2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lilly Pulitzer Dies at 81; Heiress Who Gave Elite Clothes a Tropical Splash', 'kicker': None, 'content_kicker': None, 'print_headline': 'Heiress Who Gave Elite Clothes Tropical Splash', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pulitzer, Lilly (1931-2013)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, Eric', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Palm Beach (Fla)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-07T18:36:28+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Eric Wilson', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/c026cacf-ff00-58f3-b2dc-96d80fb636d9', 'word_count': 1085, 'uri': 'nyt://article/c026cacf-ff00-58f3-b2dc-96d80fb636d9'}, {'abstract': 'Mr. Blank’s films are considered timeless, well-crafted essays on subjects like garlic and its devotees, Mardi Gras, gaptoothed women and polka enthusiasts.', 'web_url': 'https://www.nytimes.com/2013/04/08/movies/les-blank-documentary-filmmaker-dies-at-77.html', 'snippet': 'Mr. Blank’s films are considered timeless, well-crafted essays on subjects like garlic and its devotees, Mardi Gras, gaptoothed women and polka enthusiasts.', 'lead_paragraph': 'Les Blank, whose sly, sensuous and lyrical documentaries about regional music and a host of other idiosyncratic subjects, including Mardi Gras, gaptoothed women, garlic and the filmmaker Werner Herzog, were widely admired by critics and other filmmakers if not widely known by moviegoers, died on Sunday at his home in Berkeley, Calif. He was 77.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08blank_obit/08blank_obit-articleLarge.jpg', 'height': 741, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/08/obituaries/08blank_obit/08blank_obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 741}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08blank_obit/08blank_obit-jumbo.jpg', 'height': 1024, 'width': 830, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08blank_obit/08blank_obit-superJumbo.jpg', 'height': 1185, 'width': 960, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08blank_obit/08blank_obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/obituaries/08blank_obit/08blank_obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/obituaries/08blank_obit/08blank_obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Les Blank, Filmmaker of America’s Periphery, Dies at 77', 'kicker': None, 'content_kicker': None, 'print_headline': 'Les Blank, Filmmaker of America’s Periphery, Dies at 77', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Blank, Les (1935-2013)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weber, Bruce', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-07T18:36:40+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Bruce Weber', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Weber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/cc9eb25e-89fe-5bd4-afa1-cd73a2229122', 'word_count': 1260, 'uri': 'nyt://article/cc9eb25e-89fe-5bd4-afa1-cd73a2229122'}, {'abstract': 'Gwen Welliver’s dancers explored tracing the human form in their performance of “Beasts and Plots” at New York Live Arts.', 'web_url': 'https://www.nytimes.com/2013/04/08/arts/dance/gwen-wellivers-beasts-and-plots-at-new-york-live-arts.html', 'snippet': 'Gwen Welliver’s dancers explored tracing the human form in their performance of “Beasts and Plots” at New York Live Arts.', 'lead_paragraph': 'At the start of Gwen Welliver’s “Beasts and Plots” the dancer Stuart Singer sits on a folding chair with each of his arms wrapped in a long spiral of brown paper. Painstakingly he raises his arms and crosses them in front of his chair, resting the tips of paper on the floor. The sound composition, by Jake Meginsky and Bill Nace, generates a crisp score of snaps and crackles as Mr. Singer, a little like a praying mantis, spreads his legs and bends his knees. He’s not exactly a beast, yet he’s not quite human either. ', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/welliver/welliver-articleLarge.jpg', 'height': 363, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/08/arts/welliver/welliver-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 363}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/welliver/welliver-jumbo.jpg', 'height': 620, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/welliver/welliver-superJumbo.jpg', 'height': 1240, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/welliver/welliver-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/arts/welliver/welliver-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/welliver/welliver-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Works on Paper, Drawn From Life, in Mixed Mediums', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Works on Paper, Drawn From Life, in Mixed Mediums', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'New York Live Arts', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Welliver, Gwen', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-07T19:05:58+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Gia Kourlas', 'person': [{'firstname': 'Gia', 'middlename': None, 'lastname': 'Kourlas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d0008c37-428b-5c54-989b-493086053f44', 'word_count': 516, 'uri': 'nyt://article/d0008c37-428b-5c54-989b-493086053f44'}, {'abstract': 'Susanna Malkki led the New Jersey Symphony Orchestra in four youthful works by Richard Strauss, Debussy and Messiaen on Friday at the New Jersey Performing Arts Center.', 'web_url': 'https://www.nytimes.com/2013/04/08/arts/music/new-jersey-symphony-led-by-susanna-malkki-in-newark.html', 'snippet': 'Susanna Malkki led the New Jersey Symphony Orchestra in four youthful works by Richard Strauss, Debussy and Messiaen on Friday at the New Jersey Performing Arts Center.', 'lead_paragraph': 'NEWARK — Richard Strauss was 24 when he wrote “Don Juan” (1888), his first major tone poem. His next, “Tod und Verklärung” (“Death and Transfiguration”), came right on its heels, in 1889. That was also the year Claude Debussy turned 27 and began composing his Fantaisie for Piano and Orchestra, the closest he ever came to a piano concerto.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/jersey/jersey-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/08/arts/jersey/jersey-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/jersey/jersey-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/jersey/jersey-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/jersey/jersey-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/arts/jersey/jersey-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/jersey/jersey-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'These Guys Were Good in Their 20s', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'These Guys Were Good In Their 20s', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Woolfe, Zachary', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Malkki, Susanna', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New Jersey Symphony Orchestra', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New Jersey Performing Arts Center', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Newark (NJ)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-07T19:23:19+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/693635e7-d936-5a62-911c-c706f77a2f80', 'word_count': 517, 'uri': 'nyt://article/693635e7-d936-5a62-911c-c706f77a2f80'}, {'abstract': '“50 Children: The Rescue Mission of Mr. and Mrs. Kraus,” on HBO, tells of a Philadelphia couple’s liberation of 50 Jewish children from 1939 Austria.', 'web_url': 'https://www.nytimes.com/2013/04/08/arts/television/50-children-about-saving-jewish-children-on-hbo.html', 'snippet': '“50 Children: The Rescue Mission of Mr. and Mrs. Kraus,” on HBO, tells of a Philadelphia couple’s liberation of 50 Jewish children from 1939 Austria.', 'lead_paragraph': 'True stories of people who helped likely victims escape an onrushing genocide never grow old, partly because they all have at their core soul-searching questions that will always be current. How can we respond to similar horrors today? Would we personally have risen to the occasion the way a few did as the Nazi nightmare was enveloping Europe or murderous extremism was sweeping Rwanda?', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/08children-SUB/children-1365360012814-articleLarge.jpg', 'height': 345, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/08/arts/08children-SUB/children-1365360012814-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 345}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/08children-SUB/children-1365360012814-jumbo.jpg', 'height': 589, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/08children-SUB/children-1365360012814-superJumbo.jpg', 'height': 1178, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/08children-SUB/children-1365360012814-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/arts/08children-SUB/children-1365360012814-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/arts/08children-SUB/children-1365360012814-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '50 Small Victories in a Time of Unbearable Loss', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': '50 Small Victories in a Time of Unbearable Loss', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Home Box Office', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-07T19:29:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1bce26f2-2941-5b9a-97f7-574feffb3457', 'word_count': 494, 'uri': 'nyt://article/1bce26f2-2941-5b9a-97f7-574feffb3457'}, {'abstract': 'On a recent mission, a unit of the Afghan National Army gave some clues to how prepared it was to fight the Taliban after American forces are gone.', 'web_url': 'https://www.nytimes.com/2013/04/08/world/asia/afghan-army-learning-to-fight-on-its-own.html', 'snippet': 'On a recent mission, a unit of the Afghan National Army gave some clues to how prepared it was to fight the Taliban after American forces are gone.', 'lead_paragraph': 'DAMDARA, Afghanistan — Through the crackle of the hand radio, the Taliban fighter could be heard screaming at his comrades, berating them to strike from their mountain hide-outs and kill the infidel forces gathered nearby.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/world/asia/afghan/afghan-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/08/world/asia/afghan/afghan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/world/asia/afghan/afghan-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/world/asia/afghan/afghan-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/world/asia/afghan/afghan-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/world/asia/afghan/afghan-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'ran