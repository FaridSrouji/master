: {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/travel/02-frugal-combo/02-frugal-combo-superJumbo.jpg', 'height': 1260, 'width': 1900, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/travel/02-frugal-combo/02-frugal-combo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/02/travel/02-frugal-combo/02-frugal-combo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/travel/02-frugal-combo/02-frugal-combo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A $100 Weekend in Boston', 'kicker': 'Frugal Traveler', 'content_kicker': None, 'print_headline': 'A $100 Weekend in Boston', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Budget Travel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Boston (Mass)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-02T18:15:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Seth Kugel', 'person': [{'firstname': 'Seth', 'middlename': None, 'lastname': 'Kugel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d522bd4f-54ca-59fd-bcd7-52322b78f014', 'word_count': 1038, 'uri': 'nyt://article/d522bd4f-54ca-59fd-bcd7-52322b78f014'}, {'abstract': 'The announcement comes two days after the third-season premiere of “Game of Thrones,” which set ratings records for the HBO fantasy series.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/02/hbo-orders-fourth-season-of-game-of-thrones/', 'snippet': 'The announcement comes two days after the third-season premiere of “Game of Thrones,” which set ratings records for the HBO fantasy series.', 'lead_paragraph': 'George R. R. Martin, it will soon be time to put down your remote control and pick up your pen (or get behind your computer keyboard), because HBO will have need for more of your narrative content. The cable network said on Tuesday that it had officially ordered a fourth season of “Game of Thrones,” its epic fantasy series created by David Benioff and D. B. Weiss, and adapted from Mr. Martin’s best-selling “Song of Ice and Fire” novels. This announcement comes two days after the third-season premiere of “Game of Thrones,” which set ratings records for that series, drawing 4.4 million viewers first episode and exceeding the 4.2 million viewers who watched the initial broadcast of its second-season finale last June. HBO said that “Game of Thrones” had an average gross audience (including showings on the network as well as plays on DVRs and digital services like HBO Go) of 11.6 million viewers in Season 2.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'HBO Orders Fourth Season of ‘Game of Thrones’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Benioff, David', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, George R R', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Weiss, D B', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-02T18:23:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cbf57d1c-f70a-5e27-b78c-c983ac3de83e', 'word_count': 211, 'uri': 'nyt://article/cbf57d1c-f70a-5e27-b78c-c983ac3de83e'}, {'abstract': 'The secret to a good jog on the High Line, the crowded pedestrian park built on an abandoned elevated railway in Manhattan, is to go early in the morning.', 'web_url': 'https://well.blogs.nytimes.com/2013/04/02/the-roving-runner-elevating-the-jog/', 'snippet': 'The secret to a good jog on the High Line, the crowded pedestrian park built on an abandoned elevated railway in Manhattan, is to go early in the morning.', 'lead_paragraph': 'No smoking, dog-walking, biking, skating or scooting.', 'print_section': 'B', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Roving Runner: Elevating the Jog', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'High Line Elevates The Morning Jog', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'High Line (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Running', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Friends of the High Line', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Chelsea (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-02T18:23:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Brian Fidelman', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Fidelman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee5462aa-a5fe-5be7-9285-689600ae2052', 'word_count': 1028, 'uri': 'nyt://article/ee5462aa-a5fe-5be7-9285-689600ae2052'}, {'abstract': 'Paying for someone else’s hot beverage is the idea behind the “suspended coffee” movement.', 'web_url': 'https://bucks.blogs.nytimes.com/2013/04/02/coffees-to-go-and-make-one-suspended/', 'snippet': 'Paying for someone else’s hot beverage is the idea behind the “suspended coffee” movement.', 'lead_paragraph': 'A while back, I wrote about how I was pleasantly surprised to receive a free coffee at a bagel shop drive-through, during “Random Acts of Kindness” week. The customer in front of me paid for my order before driving away.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Coffees to Go, and Make One ‘Suspended’', 'kicker': 'Bucks', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coffee', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Consumerist, The', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-02T18:27:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/89d8e87c-722e-5147-8b5c-3075f98ec480', 'word_count': 374, 'uri': 'nyt://article/89d8e87c-722e-5147-8b5c-3075f98ec480'}, {'abstract': 'The group’s new report on school security is profoundly depressing.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/04/02/the-n-r-a-s-useless-advice/', 'snippet': 'The group’s new report on school security is profoundly depressing.', 'lead_paragraph': 'Paging through the new National Rifle Association report on improving school security, I stopped short at a photograph illustrating how profoundly depressing that document really is.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The N.R.A.’s Useless Advice', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'School Shootings', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Rifle Assn', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-02T18:33:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Firestone', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Firestone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ece96324-4db1-5cda-b44e-c26e8108441b', 'word_count': 521, 'uri': 'nyt://article/ece96324-4db1-5cda-b44e-c26e8108441b'}, {'abstract': 'A hamlet in central New Jersey that offers a diverse housing stock, much of it expanded in the last two decades, along with a good school district and commute to New York.', 'web_url': 'https://www.nytimes.com/2013/04/07/realestate/basking-ridge-nj-blending-rural-and-urban.html', 'snippet': 'A hamlet in central New Jersey that offers a diverse housing stock, much of it expanded in the last two decades, along with a good school district and commute to New York.', 'lead_paragraph': 'When Meghan Fedor opened her mailbox recently, she found a brown paper bag with a length of green ribbon enclosed, along with a note explaining that a local high school girl was undergoing treatment for lymphoma and that the ribbons could serve as a show of support. Within days, some 150 homes in Ms. Fedor’s Basking Ridge neighborhood had ribbons waving from mailboxes and lamp posts. It’s this kind of neighborly act, said Ms. Fedor, who commutes to a job at the Environmental Protection Agency in New York three days a week, that has had her marveling since she moved here almost two years ago.', 'print_section': 'RE', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/0407LIVING01/0407LIVING01-articleLarge.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/realestate/0407LIVING01/0407LIVING01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 377}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/0407LIVING01/0407LIVING01-jumbo.jpg', 'height': 644, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/0407LIVING01/0407LIVING01-superJumbo.jpg', 'height': 1288, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/0407LIVING01/0407LIVING01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/07/realestate/0407LIVING01/0407LIVING01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/0407LIVING01/0407LIVING01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Polished Past and Polite People', 'kicker': 'Living In | Basking Ridge, N.J.', 'content_kicker': None, 'print_headline': 'A Polished Past and Polite People', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Basking Ridge (NJ)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-02T18:34:04+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Jill P. Capuzzo', 'person': [{'firstname': 'Jill', 'middlename': 'P.', 'lastname': 'Capuzzo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f341e467-0133-570c-b8b4-19a501baf090', 'word_count': 1352, 'uri': 'nyt://article/f341e467-0133-570c-b8b4-19a501baf090'}, {'abstract': 'Open tracts, a friendly downtown and a rich history characterize the commutable town.', 'web_url': 'https://www.nytimes.com/slideshow/2013/04/07/realestate/20130407-livingin-ss.html', 'snippet': 'Open tracts, a friendly downtown and a rich history characterize the commutable town.', 'lead_paragraph': 'Open tracts, a friendly downtown and a rich history characterize the commutable town.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/20130407-livingin-ss-slide-HPGL/20130407-livingin-ss-slide-HPGL-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/realestate/20130407-livingin-ss-slide-HPGL/20130407-livingin-ss-slide-HPGL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/realestate/20130407-livingin-ss-slide-HPGL/20130407-livingin-ss-slide-HPGL-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/rea