imedia': [], 'headline': {'main': 'Guggenheim Hires Lehman Veteran in Continued Hiring Spree', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Guggenheim Partners LLC', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-24T15:56:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/83079da1-cb95-5c5c-b714-f34d4b0427a5', 'word_count': 254, 'uri': 'nyt://article/83079da1-cb95-5c5c-b714-f34d4b0427a5'}, {'abstract': 'Kenyon Martin has repaid the Knicks for acquiring him in February by producing 20 rebounds and 6 blocks in the first two games of the Celtics series.', 'web_url': 'https://www.nytimes.com/2013/04/25/sports/basketball/knicks-provide-a-clean-slate-kenyon-martin-fills-it-with-numbers.html', 'snippet': 'Kenyon Martin has repaid the Knicks for acquiring him in February by producing 20 rebounds and 6 blocks in the first two games of the Celtics series.', 'lead_paragraph': 'Here came Kenyon Martin, finished with postgame-interview-room duties, following an earnest Knicks public-relations employee through the exit and into the corridor. A reporter was well positioned there to shoot Martin a follow-up question. Like an express train scheduled to run through local stations, Martin was not supposed to stop.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/25araton/25araton-articleLarge.jpg', 'height': 466, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xla