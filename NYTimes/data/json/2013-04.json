f0c9072', 'word_count': 486, 'uri': 'nyt://article/5be803df-ec2e-5e54-a9fe-457cff0c9072'}, {'abstract': "A new ad criticizes Christine C. Quinn, the City Council speaker, for her role in the closing of St. Vincent's hospital.", 'web_url': 'https://www.nytimes.com/video/multimedia/100000002189241/nowhere-to-go.html', 'snippet': "A new ad criticizes Christine C. Quinn, the City Council speaker, for her role in the closing of St. Vincent's hospital.", 'lead_paragraph': "A new ad criticizes Christine C. Quinn, the City Council speaker, for her role in the closing of St. Vincent's hospital.", 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/23/multimedia/video-quinn-vincent-ad/video-quinn-vincent-ad-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/23/multimedia/video-quinn-vincent-ad/video-quinn-vincent-ad-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/23/multimedia/video-quinn-vincent-ad/video-quinn-vincent-ad-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/23/multimedia/video-quinn-vincent-ad/video-quinn-vincent-ad-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/23/multimedia/video-quinn-vincent-ad/video-quinn-vincent-ad-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Nowhere to Go’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-24T14:23:14+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/46fea764-0627-5cec-9621-b3dd4717f8db', 'word_count': 0, 'uri': 'nyt://video/46fea764-0627-5cec-9621-b3dd4717f8db'}, {'abstract': '“My Happy Life,” written by Rose Lagercrantz and illustrated by Eva Eriksson, is about an admirable little girl who learns to overcome sadness.', 'web_url': 'https://www.nytimes.com/2013/04/24/books/my-happy-life-by-rose-lagercrantz.html', 'snippet': '“My Happy Life,” written by Rose Lagercrantz and illustrated by Eva Eriksson, is about an admirable little girl who learns to overcome sadness.', 'lead_paragraph': 'Certain phrases cycle in and out of child-rearing vogue, with “executive function” and “emotional intelligence” and “kinetic learning” zooming before parental headlights and then passing into oblivion until the next generation comes along. At our current moment, “resilience” is front and center, in large part courtesy of Paul Tough’s excellent book on education, “How Children Succeed.” And to this parent, at least, it seems as good a concept\xa0as any\xa0to cling to and to encourage.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/books/24childrens-1/24childrens-1-articleLarge.jpg', 'height': 366, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/24/books/24childrens-1/24childrens-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 366}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/books/24childrens-1/24childrens-1-jumbo.jpg', 'height': 538, 'width': 882, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/books/24childrens-1/24childrens-1-superJumbo.jpg', 'height': 538, 'width': 882, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/books/24childrens-1/24childrens-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/24/books/24childrens-1/24childrens-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/books/24childrens-1/24childrens-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bouncing Back', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lagercrantz, Rose', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Eriksson, Eva', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-24T14:30:31+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Pamela Paul', 'person': [{'firstname': 'Pamela', 'middlename': None, 'lastname': 'Paul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0d4093cc-c00f-5fdc-8b1e-ce770b4399d6', 'word_count': 599, 'uri': 'nyt://article/0d4093cc-c00f-5fdc-8b1e-ce770b4399d6'}, {'abstract': 'At the Swedish retailer Gudrun Sjoden’s SoHo store, eco-conscious clothes meant for the mature woman, but more fanciful than practical.', 'web_url': 'https://www.nytimes.com/2013/04/25/fashion/critical-shopper-gudrun-sjoden-in-soho.html', 'snippet': 'At the Swedish retailer Gud