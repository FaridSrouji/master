New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Friday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-05T05:00:11+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/94586422-767c-5a9d-9ad4-8a948efc129b', 'word_count': 740, 'uri': 'nyt://article/94586422-767c-5a9d-9ad4-8a948efc129b'}, {'abstract': 'Brandon Cronenberg, 33, son of David Cronenberg, explains how he never intended to make films like his father’s.', 'web_url': 'https://www.nytimes.com/2013/04/07/movies/brandon-cronenberg-on-his-film-antiviral.html', 'snippet': 'Brandon Cronenberg, 33, son of David Cronenberg, explains how he never intended to make films like his father’s.', 'lead_paragraph': 'Body horror and biological obsessions have often been present in the gooey, sometimes shocking films of the Canadian director David Cronenberg. So it may not be surprising that the debut feature from Brandon Cronenberg, the son of the man once called the baron of blood, has similar themes. But what is surprising is how small a role his father’s films may have played in the making of his own.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Backing Into His Father’s Footsteps', 'kicker': 'Snapshot', 'content_kicker': None, 'print_headline': 'Backing Into His Father’s Footsteps', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Murphy, Mekado', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': '