nk': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09KLAS/09KLAS-articleLarge.jpg', 'height': 531, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/09/science/09KLAS/09KLAS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 531}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09KLAS/09KLAS-jumbo.jpg', 'height': 907, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09KLAS/09KLAS-superJumbo.jpg', 'height': 1487, 'width': 1679, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09KLAS/09KLAS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/09/science/09KLAS/09KLAS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09KLAS/09KLAS-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Advice Shifts on Feeding Baby', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'Advice Shifts on Feeding Baby', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Babies and Infants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-08T19:38:26+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Perri Klass, M.D', 'person': [{'firstname': 'Perri', 'middlename': None, 'lastname': 'Klass', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/254677ee-30ed-56be-82c8-30dd30710876', 'word_count': 907, 'uri': 'nyt://article/254677ee-30ed-56be-82c8-30dd30710876'}, {'abstract': 'Using a laser-printer-like machine, chiplets can be used singly or placed precisely in a circuit, upending the convention of squeezing as many transistors as possible into one tiny chip.', 'web_url': 'https://www.nytimes.com/2013/04/09/science/tiny-chiplets-are-a-new-level-of-micro-manufacturing.html', 'snippet': 'Using a laser-printer-like machine, chiplets can be used singly or placed precisely in a circuit, upending the convention of squeezing as many transistors as possible into one tiny chip.', 'lead_paragraph': 'PALO ALTO, Calif. — Under a microscope, four slivers of silicon — electronic circuits called chiplets — perform an elaborate, jerky dance as if controlled by a hidden puppet master. Then on command, they all settle with pinpoint accuracy, precisely touching a pattern of circuit wires, each at just the right point of contact.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09CHIP_SPAN/09CHIP-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/09/science/09CHIP_SPAN/09CHIP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/science/09CHIP_SPAN/09CHIP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'cap