/2010/04/19/business/norris-75-standardinline/norris-75-standardinline-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2010/04/19/business/norris-75-standardinline/norris-75-standardinline-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Finding a Rate That’s Fairer Than Libor', 'kicker': 'High & Low Finance', 'content_kicker': None, 'print_headline': 'Finding A Rate That’s Fairer Than Libor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Interest Rates', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Libor (London Interbank Offered Rate)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Commodity Futures Trading Commission', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Gensler, Gary S', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-04-04T20:15:27+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Floyd Norris', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/43ed0009-aff4-5380-8f00-37db946af466', 'word_count': 1482, 'uri': 'nyt://article/43ed0009-aff4-5380-8f00-37db946af466'}, {'abstract': 'Many readers are thrilled by T-Mobile’s new policies. But there is, as always, a sizable crowd who object.', 'web_url': 'https://pogue.blogs.nytimes.com/2013/04/04/hurrahs-and-harrumphs-for-t-mobile/', 'snippet': 'Many readers are thrilled by T-Mobile’s new policies. But there is, as always, a sizable crowd who object.', 'lead_paragraph': 'In my Times column on Thursday, I cheered T-Mobile’s bold decision to abandon the standard United States cellphone business model. There will be no more two-year contracts, no more idiotic 15-second voice mail instruction recordings, no more games with the cost of your phone.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hurrahs and Harrumphs for T-Mobile', 'kicker': 'Pogue&#039;s Posts', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-04T20:23:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By David Pogue', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Pogue', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39a9cc15-7415-5d30-8995-f06d09b77eff', 'word_count': 861, 'uri': 'nyt://article/39a9cc15-7415-5d30-8995-f06d09b77eff'}, {'abstract': 'A good Beaujolais is a talented companion, going well with many dishes, like this duck with ginger and chile.', 'web_url': 'https://www.nytimes.com/2013/04/10/dining/what-to-eat-with-beaujolais.html', 'snippet': 'A good Beaujolais is a talented companion, going well with many dishes, like this duck with ginger and chile.', 'lead_paragraph': 'I’m tempted to take Eric Korsh up on his offer to teach me how to make his tête de porc (head cheese). “You need a butcher who’ll bone out a pig’s head for you,” said Mr. Korsh, the chef and an owner of Calliope in the East Village. That gave me second thoughts. But there is nothing better with Beaujolais cru, as I confirmed soon after our tasting, dining at Calliope with St.-Amour in my glass. With the pig’s head on hold, I braised a duck seasoned with ginger and chile just to prove that you can serve a delicious Beaujolais with almost anything. The duck offered up excess fat, which, stashed in the refrigerator, is a treasure to use for frying.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/dining/10PAIR/10PAIR-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/10/dining/10PAIR/10PAIR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/dining/10PAIR/10PAIR-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/dining/10PAIR/10PAIR-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/dining/10PAIR/10PAIR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/10/dining/10PAIR/10PAIR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/dining/10PAIR/10PAIR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What to Eat With Beaujolais', 'kicker': 'Pairings', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ducks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wines', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-04T20:25:47+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9c43cf63-126c-5620-89de-11378940149a', 'word_count': 122, 'uri': 'nyt://article/9c43cf63-126c-5620-89de-11378940149a'}, {'abstract': 'Recent polls found majority support for a nationwide ban on the sale of assault weapons and support for a process for illegal immigrants to become citizens, but with strong partisan division.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/04/04/polls-find-continued-support-for-stricter-gun-laws-and-a-path-to-citizenship/', 'snippet': 'Recent polls found majority support for a nationwide ban on the sale of assault weapons and support for a process for illegal immigrants to become citizens, but with strong partisan division.', 'lead_paragraph': 'As Congress prepares to debate gun safety laws and tries to hash out an immigration overhaul, recent polls find continued public support for stricter restrictions on firearms and a path to citizenship for immigrants in the country illegally.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Polls Find Continued Support for Stricter Gun Laws and a Path to Citizenship', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Citizenship and Naturalization', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 4, 'major': 'N'}, {'name': 'organizations',