man/06batman-jumbo.jpg', 'height': 600, 'width': 397, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/books/06batman/06batman-superJumbo.jpg', 'height': 600, 'width': 397, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/06/books/06batman/06batman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/06/books/06batman/06batman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Graphic Books Best Sellers: Batman Team Back on Top', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Graphic Novels', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Capullo, Greg', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Snyder, Scott', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-05T18:00:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By George Gene Gustines', 'person': [{'firstname': 'George', 'middlename': 'Gene', 'lastname': 'Gustines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0786d77c-c6c1-5caa-8a71-6985a585d824', 'word_count': 349, 'uri': 'nyt://article/0786d77c-c6c1-5caa-8a71-6985a585d824'}, {'abstract': 'Experience the connection between visual elements and scents with Olfactive Studio’s new collection of fragrances.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/04/05/vain-glorious-olfactive-studio/', 'snippet': 'Experience the connection between visual elements and scents with Olfactive Studio’s new collection of fragrances.', 'lead_paragraph': '“Images and perfumes have always been linked,” says Céline Verleure, a 20-year fragrance industry veteran based in Paris. “When we smell a perfume, it gives us images in our heads, like a landscape or a scene.” A few years ago, she decided to explore this relationship further by asking perfumers to collaborate with photographers on a series of eau de parfums inspired by the visual artists’ works. Thus, Olfactive Studio was born, and the French brand’s five highly concentrated unisex scents arrive in the United States on April 8. “The perfumers are able to create on a spiritual level. Olivier Cresp, who worked on the Flash Back fragrance with the photographer Laurent Segretier, says there’s a new and special freedom in starting with the visual,” Verleure notes. Her current favorite in the lineup is Lumière Blanche, a milky yet fresh and spicy concoction from the perfumer Sidonie Lancesseur, who drew her inspiration from the famed photographer Massimo Vitali’s picture of sunbathers gathered on the ivory-hued Scala dei Turchi cliff in southern Sicily. To fully experience the connection between the visual and olfactory elements, Verleure suggests first choosing a scent based on the image, which adorns the fragrance box, and then smelling the juice second. “Pick the photo that gives you the most emotion, and you will really like that perfume. It works!” she says.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Vain Glorious | Olfactive Studio', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Perfumes and Fragrances', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-05T18:00:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Jane Shin Park', 'person': [{'firstname': 'Jane', 'middlename': 'Shin', 'lastname': 'Park', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/54c2c3cd-1735-5019-becb-d168bb5fdf9e', 'word_count': 235, 'uri': 'nyt://article/54c2c3cd-1735-5019-becb-d168bb5fdf9e'}, {'abstract': 'You can make chicken stock from just the back.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/04/05/stock-from-every-chicken/', 'snippet': 'You can make chicken stock from just the back.', 'lead_paragraph': 'In today’s video I demonstrate how to cut up a whole chicken, which is a worthwhile thing to know and not at all hard. I also show how to take the chicken back (and neck and innards, if your chicken came with them — not all of them do) and turn it into a small batch of chicken stock. I usually make the stock immediately after cutting up the chicken, but you could also save the back for later. You could freeze it if you’ve got the freezer space or, if you want to combine it with the leftover bones from the chicken you are cooking, like I did with the chicken curry that I describe in this week’s column, you can stick the back in the fridge for a day or two.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Stock From Every Chicken', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chickens', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-05T18:02:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Melissa Clark', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Clark', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bab5870f-aafc-5e74-bcc7-e3aba2057c7f', 'word_count': 241, 'uri': 'nyt://article/bab5870f-aafc-5e74-bcc7-e3aba2057c7f'}, {'abstract': 'When verbs and adjectives get nouned, the practice can eliminate context and mask any sense of agency.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/04/05/the-dark-side-of-verbs-as-nouns/', 'snippet': 'When verbs and adjectives get nouned, the practice can eliminate context and mask any sense of agency.', 'lead_paragraph': 'In my previous essay, I wrote about nominalization — the deployment as nouns of words we mostly expect to encounter as verbs or adjectives. Aware of many people’s tendency to vilify this kind of usage, I speculated about the psychology behind it. I was interested in thinking about why someone might prefer “Do you have a solve for this problem?” to “Can you solve this problem?”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Dark Side of Verbs-as-Nouns', 'kicker': 'Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grammar', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Reading and Writing Skills', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-05T18:03:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Henry Hitchings', 'person': [{'firstname': 'Henry', 'middlename': None, 'lastname': 'Hitchings', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e4953f06-8bef-5a58-8123-e2653b97be73', 'word_count': 853, 'uri': 'nyt://article/e4953f06-8bef-5a58-8123-e2653b97be73'}, {'abstract': 'The Times’s Pam Belluck explains how the emergency nature of the morning-after pill pushed a federal judge to increase its availability.', 'web_url': 'https://www.nytimes.com/video/science/100000002156886/easing-access-to-contraception.html', 'snipp