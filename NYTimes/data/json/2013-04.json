rstname': 'Peter', 'middlename': None, 'lastname': 'Lattman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8f1d107-a77a-52ac-892a-cb2678040c35', 'word_count': 463, 'uri': 'nyt://article/e8f1d107-a77a-52ac-892a-cb2678040c35'}, {'abstract': 'Food-related events around New York.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/04/26/weekend-fare-139/', 'snippet': 'Food-related events around New York.', 'lead_paragraph': 'With its assortment of artisanal food vendors, craft makers and more, the Hester Street Fair, at the corner of Hester and Essex Streets on the Lower East Side, returns on Saturday for the season. The market is open from 10 a.m. to 6 p.m. on Saturdays through Oct. 26.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Weekend Fare', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-26T18:52:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Bao Ong', 'person': [{'firstname': 'Bao', 'middlename': None, 'lastname': 'Ong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/222fd8e3-4fd8-5b44-81d4-a79ec499cfc7', 'word_count': 528, 'uri': 'nyt://article/222fd8e3-4fd8-5b44-81d4-a79ec499cfc7'}, {'abstract': 'Jeff Nichols, the director of “Mud,” narrates a scene from the film.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/26/anatomy-of-a-scene-mud/', 'snippet': 'Jeff Nichols, the director of “Mud,” narrates a scene from the film.', 'lead_paragraph': 'In Jeff Nichols’s latest film “Mud,” Matthew McConaughey plays the title character as a man who is always on the move. The character is discovered hiding out on an island in the Mississippi River by two Arkansas boys (Tye Sheridan and Jacob Lofland). To capture a constantly moving character, Mr. Nichols and his crew used a Steadicam camera to create sense of fluidity. In this video, Mr. Nichols narrates a scene where the boys bring food to Mud on the island. He discusses his camera choices and how they supplement his narrative.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Anatomy of a Scene: ‘Mud’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McConaughey, Matthew', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Nichols, Jeff (1978- )', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-26T19:00:08+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f2990cdc-a7cc-5bd0-8442-ffef2fb75f02', 'word_count': 92, 'uri': 'nyt://article/f2990cdc-a7cc-5bd0-8442-ffef2fb75f02'}, {'abstract': 'The film was pulled from theaters in April, but is now set to debut on May 12. Sony Pictures officials declined to say if the movie had been edited.', 'web_url': 'https://www.nytimes.com/2013/04/27/business/media/technical-problem-resolved-django-to-open-in-china-in-may.html', 'snippet': 'The film was pulled from theaters in April, but is now set to debut on May 12. Sony Pictures officials declined to say if the movie had been edited.', 'lead_paragraph': 'LOS ANGELES — After being pulled from theaters this month over what Chinese officials described as a “technical” problem, Quentin Tarantino’s “Django Unchained” will return to movie screens in China on May 12.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Technical’ Problem Resolved, ‘Django’ to Open in China in May', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '‘Django’ Back in China', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Django Unchained (Movie)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sony Pictures Entertainment', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Tarantino, Quentin', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-26T19:02:41+0000', 'document_type': 'article', 'news_desk': 'Media', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael Cieply', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/60c33bbf-34a6-56b9-bcb3-5f58d4bb7591', 'word_count': 120, 'uri': 'nyt://article/60c33bbf-34a6-56b9-bcb3-5f58d4bb7591'}, {'abstract': 'The committee administering the awards contradicted a precedent set when three performers playing “Billy Elliot” were jointly eligible, and won, the prize for best actor in a musical.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/26/matilda-quartet-will-get-special-tony-but-wont-be-eligible-for-best-actress/', 'snippet': 'The committee administering the awards contradicted a precedent set when three performers playing “Billy Elliot” were jointly eligible, and won, the prize for best actor in a musical.', 'lead_paragraph': 'The four child actresses who rotate in the title role of the Broadway musical “Matilda” will not be eligible for a joint Tony Award nomination for best actress in a musical this spring, the Tony administrative committee ruled on Friday. The decision, the most newsworthy result of a busy committee meeting, sets aside a controversial precedent from 2009 when the three teenage boys sharing the lead role in “Billy Elliot” were deemed eligible for a joint best actor nomination — and went on to win that June.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/27/theater/27matildas/27matildas-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/27/theater/27matildas/27matildas-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/27/theater/27matildas/27matildas-jumbo.jpg', 'height': 400, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/27/theater/27matildas/27matildas-superJumbo.jpg', 'height': 400, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/27/theater/27matildas/27matildas-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/27/theater/27matildas/27matildas-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/27/theater/27matildas/27matildas-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Matilda’ Quartet Ruled Ineligible for Best Actress Tony', 'kicker': 'ArtsBeat', 'content_kick