', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/travel/14JOURNEYS_SPAN/14JOURNEYS3-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/14/travel/14JOURNEYS_SPAN/14JOURNEYS3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/travel/14JOURNEYS_SPAN/14JOURNEYS3-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/travel/14JOURNEYS_SPAN/14JOURNEYS3-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/travel/14JOURNEYS_SPAN/14JOURNEYS_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/14/travel/14JOURNEYS_SPAN/14JOURNEYS_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/travel/14JOURNEYS_SPAN/14JOURNEYS_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Mexico, Where the Waves Still Win', 'kicker': 'Journeys ', 'content_kicker': None, 'print_headline': 'Following the Waves Back In', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ralston, Jeannie', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Surfing', 'rank': 2, 'major': 'N'}, {'name': 'subject',