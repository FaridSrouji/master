nyregion/Lynchobit1/Lynchobit1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 425}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/nyregion/Lynchobit1/Lynchobit1-jumbo.jpg', 'height': 448, 'width': 633, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/nyregion/Lynchobit1/Lynchobit1-superJumbo.jpg', 'height': 448, 'width': 633, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/nyregion/Lynchobit1/Lynchobit1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/18/nyregion/Lynchobit1/Lynchobit1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/nyregion/Lynchobit1/Lynchobit1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gerald W. Lynch, Who Fought to Save John Jay College, Dies at 76', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gerald Lynch, 76, President\r\nWho Saved John Jay College', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lynch, Gerald W', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'John Jay College of Criminal Justice', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-17T14:48:01+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Daniel E. Slotnik', 'person': [{'f