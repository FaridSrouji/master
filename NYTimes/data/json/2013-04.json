 None, 'lastname': 'DeNitto', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6e8b7d8-d26a-55d7-84b4-aeaeda2f9268', 'word_count': 693, 'uri': 'nyt://article/d6e8b7d8-d26a-55d7-84b4-aeaeda2f9268'}, {'abstract': 'The 2010 Corchaug Estate reserve from McCall Wines was the star from a selection of wines produced in East End vineyards.', 'web_url': 'https://www.nytimes.com/2013/04/14/nyregion/pairing-long-island-pinot-noir-with-duck.html', 'snippet': 'The 2010 Corchaug Estate reserve from McCall Wines was the star from a selection of wines produced in East End vineyards.', 'lead_paragraph': 'Many red wine lovers consider pinot noir and duck an ideal combination. And many fans of duck think the white Pekin breed farmed on Long Island is America’s best. That’s where East End pinot noir producers come in.', 'print_section': 'LI', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Seven Pinots to Pair With Duck', 'kicker': 'Long Island Vines', 'content_kicker': None, 'print_headline': 'Seven Pinots to Pair With Duck', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pinot Noir (Wine)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Island (NY)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wines', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-12T22:22:44+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Howard G. Goldberg', 'person': [{'firstname': 'Howard', 'middlename': 'G.', 'lastname': 'Goldberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5b8bf86-f311-5e01-98c0-b952f81a53ed', 'word_count': 319, 'uri': 'nyt://article/e5b8bf86-f311-5e01-98c0-b952f81a53ed'}, {'abstract': 'The Food and Drug Administration took $1 million in foodstuffs made by V.I.P. Foods’ KoJel division plant in Ridgewood, Queens, last month after inspections between October and February.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/04/12/kosher-food-makers-inventory-seized-over-rodent-infestation/', 'snippet': 'The Food and Drug Administration took $1 million in foodstuffs made by V.I.P. Foods’ KoJel division plant in Ridgewood, Queens, last month after inspections between October and February.', 'lead_paragraph': 'Fans of KoJel kosher foods like instant pudding, hot chocolate mix and instant noodle soup, brace yourselves: V.I.P. Foods, the Queens food supplier that manufactures the products, had about $1 million in inventory seized by the federal Food and Drug Administration because of “widespread rodent infestation,” federal prosecutors said on Friday.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/nyregion/12cityroom-vip/12cityroom-vip-jumbo.png', 'height': 811, 'width': 599, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/nyregion/12cityroom-vip/12cityroom-vip-superJumbo.png', 'height': 811, 'width': 599, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/nyregion/12cityroom-vip/12cityroom-vip-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/12/nyregion/12cityroom-vip/12cityroom-vip-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 