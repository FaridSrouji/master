': 'Jesse', 'middlename': None, 'lastname': 'McKinley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/54f0ab10-56e9-584d-a82c-798a6710ccb5', 'word_count': 1217, 'uri': 'nyt://article/54f0ab10-56e9-584d-a82c-798a6710ccb5'}, {'abstract': 'The thrill of going to the movies is at the heart of Annie Baker’s bittersweet play “The Flick,” now at Playwrights Horizons. Asked about her influences, she offers thoughts on six.', 'web_url': 'https://www.nytimes.com/2013/04/02/theater/in-the-flick-annie-bakers-film-influences.html', 'snippet': 'The thrill of going to the movies is at the heart of Annie Baker’s bittersweet play “The Flick,” now at Playwrights Horizons. Asked about her influences, she offers thoughts on six.', 'lead_paragraph': 'The thrill of moviegoing — even in a less than thrilling setting — is at the heart of Annie Baker’s bittersweet play “The Flick,” which runs through Sunday at Playwrights Horizons. Set in a rundown Massachusetts movie theater, the play explores the daily grind and emotional lives of Rose, a projectionist; Avery, a new employee who is a film fanatic; and Sam, who trains him, as the future of this oneplex hangs in the balance.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/theater/02flick-web/02flick-web-articleLarge.jpg', 'height': 439, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/02/theater/02flick-web/02flick-web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 439}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/theater/02flick-web/02flick-web-jumbo.jpg', 'height': 749, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/theater/02flick-web/02flick-web-superJumbo.jpg', 'height': 1497, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/theater/02flick-web/02flick-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/02/theater/02flick-web/02flick-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/theater/02flick-web/02flick-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Six Movies That Helped Lead a Playwright From the Cineplex to the Stage', 'kicker': None, 'content_kicker': None, 'print_headline': 'Six Movies That Helped Lead a Playwright From the Cineplex to the Stage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Piepenburg, Erik', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baker, Annie', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Flick (Play)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-02T00:15:22+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f4653f34-0f79-5bd4-a621-99f580b8aa3a', 'word_count': 798, 'uri': 'nyt://article/f4653f34-0f79-5bd4-a621-99f580b8aa3a'}, {'abstract': 'The government’s announcement of the rising rate appeared to be an acknowledgment of the effects of Western sanctions.', 'web_url': 'https://www.nytimes.com/2013/04/02/world/middleeast/irans-double-digit-inflation-worsens.html', 'snippet': 'The government’s announcement of the rising rate appeared to be an acknowledgment of the effects of Western sanctions.', 'lead_paragraph': 'Iran’s double-digit inflation rate worsened for the sixth consecutive month in March, the government said on Monday, in what appeared to be an implicit acknowledgment that international sanctions linked to the disputed Iranian nuclear program are causing some economic harm.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Double-Digit Inflation Worsens in Iran', 'kicker': None, 'content_kicker': None, 'print_headline': 'Double-Digit Inflation Worsens in Iran', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iran', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Inflation (Economics)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Economic Sanctions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-02T00:18:38+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Rick Gladstone', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Gladstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8c9e1ad3-e1e0-5500-b27b-b9f38cbf6c11', 'word_count': 450, 'uri': 'nyt://article/8c9e1ad3-e1e0-5500-b27b-b9f38cbf6c11'}, {'abstract': 'Making people angry is an occupational hazard of being a prosecutor, but it is impossible to know who might follow through with deadly intent.', 'web_url': 'https://www.nytimes.com/2013/04/02/us/killings-of-prosecutors-put-focus-on-threats.html', 'snippet': 'Making people angry is an occupational hazard of being a prosecutor, but it is impossible to know who might follow through with deadly intent.', 'lead_paragraph': 'The defendant had accosted the prosecutor before, shouting death threats at him on a Washington street. Then one day in court, he caught the eye of the prosecutor, Roger Canaff, and slowly drew his finger across his throat. ', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/us/THREATS/THREATS-articleLarge.jpg', 'height': 355, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/02/us/THREATS/THREATS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 355}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/us/THREATS/THREATS-jumbo.jpg', 'height': 606, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/us/THREATS/THREATS-superJumbo.jpg', 'height': 1212, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/02/us/THREATS/THREATS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/02/us/THREATS/THREATS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type