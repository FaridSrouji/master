9/sports/basketball/09adelman/09adelman-jumbo.jpg', 'height': 1024, 'width': 721, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/basketball/09adelman/09adelman-superJumbo.jpg', 'height': 2048, 'width': 1442, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/basketball/09adelman/09adelman-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/09/sports/basketball/09adelman/09adelman-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/basketball/09adelman/09adelman-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Adelman at 1,000 Wins', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Adelman, Rick', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nelson, Don', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Riley, Pat', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wilkens, Lenny', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Minnesota Timberwolves', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-08T19:54:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Steve McPherson', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'McPherson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f81d838c-afbc-52ee-9226-7b49221403c1', 'word_count': 769, 'uri': 'nyt://article/f81d838c-afbc-52ee-9226-7b49221403c1'}, {'abstract': 'In admiring obituaries, an appreciation of the tragic element as well.', 'web_url': 'https://douthat.blogs.nytimes.com/2013/04/08/the-thatcher-legacy-in-full/', 'snippet': 'In admiring obituaries, an appreciation of the tragic element as well.', 'lead_paragraph': 'Reading the obituaries for Margaret Thatcher, dead today at eighty-seven, it strikes me that her relatively long post-political afterlife — it’s been twenty-three years since she left Downing Street, almost a generation\xa0—\xa0has probably made it easier to get some distance on her era, and to marry an appreciation for her achievements with a judicious weighing of her legacy in full. I’m particularly struck by the appropriate dose of the tragic sense that runs through a number of admiring right-of-center appreciations. Start with this passage from\xa0Andrew Sullivan’s moving eulogy, in which he explains how Thatcherism turned out to be “a much more complicated thing than many analyses contain”:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Thatcher Legacy in Full', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Capitalism (Theory and Philosophy)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Organized Labor', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'John Paul II', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Reagan, Ronald Wilson', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Thatcher, Margaret H', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-08T19:56:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c1399b7-0896-5ec8-9036-c8815c4dd06a', 'word_count': 892, 'uri': 'nyt://article/6c1399b7-0896-5ec8-9036-c8815c4dd06a'}, {'abstract': 'Prominent American and Canadian research universities earned mostly C’s on the first report card assessing how much their laboratories benefit the world’s poor.', 'web_url': 'https://www.nytimes.com/2013/04/09/health/universities-get-middling-grades-in-helping-poor.html', 'snippet': 'Prominent American and Canadian research universities earned mostly C’s on the first report card assessing how much their laboratories benefit the world’s poor.', 'lead_paragraph': 'Prominent American and Canadian research universities earned mostly C’s on the first report card assessing how much their laboratories benefit the world’s poor.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Universities Get Middling Grades in Helping Poor', 'kicker': 'Global Health', 'content_kicker': None, 'print_headline': 'Universities Get Middling Grades in Helping Poor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McNeil, Donald G Jr', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Third World and Developing Countries', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Education', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Poverty', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Universities Allied for Essential Medicines', 'rank': 6, '