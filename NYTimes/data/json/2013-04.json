a, a boho tapas bistro.', 'print_section': 'LI', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/nyregion/07SUBDINELI2_SPAN/07SUBDINELI2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/nyregion/07SUBDINELI2_SPAN/07SUBDINELI2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/nyregion/07SUBDINELI2_SPAN/07SUBDINELI2-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/nyregion/07SUBDINELI2_SPAN/07SUBDINELI2-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/nyregion/07SUBDINELI2_SPAN/07SUBDINELI2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/07/nyregion/07SUBDINELI2_SPAN/07SUBDINELI2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/nyregion/07SUBDINELI2_SPAN/07SUBDINELI2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Beyond the Whimsy, Sushi With Ambition', 'kicker': 'Long Island Dining | Sea Cliff', 'content_kicker': None, 'print_headline': 'Beyond the Whimsy, Sushi With Ambition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N