ction_name': 'Technology', 'byline': {'original': 'By John Markoff', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Markoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7ef90072-5675-591a-877d-55ec0720e303', 'word_count': 783, 'uri': 'nyt://article/7ef90072-5675-591a-877d-55ec0720e303'}, {'abstract': 'New shows from the playwright Nicky Silver and the the team of John Kander and Greg Pierce are part of the theater’s new season.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/04/new-works-by-john-kander-nicky-silver-set-for-the-vineyard/', 'snippet': 'New shows from the playwright Nicky Silver and the the team of John Kander and Greg Pierce are part of the theater’s new season.', 'lead_paragraph': 'The Vineyard Theater has announced that it will produce two premieres as part of its 2013-14 Off Broadway season. This fall brings the musical “The Landing,” with a score by the Tony Award-winning composer John Kander and book and lyrics by Greg Pierce. In the spring of 2014, the theater will mount “Too Much Sun,” a new play by Nicky Silver (“The Lyons”), with direction by Mark Brokaw. Run dates and casting were not announced for either show.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Works by John Kander and Nicky Silver Set for the Vineyard', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kander, John', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Pierce, Greg', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Silver, Nicky', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Vineyard Theater', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-04T20:45:59+0000', 'document_type': 'article', 'news_desk