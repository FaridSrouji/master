ub_date': '2013-04-09T00:59:58+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Joe Nocera', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Nocera', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a36dabb9-b02d-5553-b6fd-01cf19999d6f', 'word_count': 796, 'uri': 'nyt://article/a36dabb9-b02d-5553-b6fd-01cf19999d6f'}, {'abstract': 'Immigration and Customs Enforcement is putting new policies into place after a series of botched raids on innocent immigrants.', 'web_url': 'https://www.nytimes.com/2013/04/09/opinion/when-ice-ran-amok.html', 'snippet': 'Immigration and Customs Enforcement is putting new policies into place after a series of botched raids on innocent immigrants.', 'lead_paragraph': 'In a series of raids in suburban New York in 2006 and 2007, agents of Immigration and Customs Enforcement burst into private homes in the dead of night, without warrants, looking for undocumented immigrants, often in the wrong houses. They pounded on doors, terrorized innocent residents, ineptly drew guns on police officers who were supposed to be their partners, and found hardly any of the gang members they were hunting. It was a stunning display of aggression and incompetence. ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'When ICE Ran Amok', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'When ICE Ran Amok', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Immigration and Customs Enforcement (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Search and Seizure', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fourth Amendment (US Constitution)', 'rank': 4, 'majo