op_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/realestate/14DEAL1_SPAN/Deal1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/realestate/14DEAL1_SPAN/14DEAL1_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/14/realestate/14DEAL1_SPAN/14DEAL1_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/realestate/14DEAL1_SPAN/14DEAL1_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Is It Art, or Is It Just Real Estate?', 'kicker': 'Big Deal', 'content_kicker': None, 'print_headline': 'Is It Art, or Is It Just Real Estate?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Barrionuevo, Alexei', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Condominiums', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Meatpacking District (Manhattan, NY)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Miami Beach (Fla)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-11T22:56:04+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Alexei Barrionuevo', 'person': [{'firstname': 'Alexei', 'middlename': None, 'lastname': 'Barrionuevo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bbfe343f-8873-507d-940e-a54f0e304ad9', 'word_count': 1188, 'uri': 'nyt://article/bbfe343f-8873-507d-940e-a54f0e304ad9'}, {'abstract': 'In Todd Berger’s comedy, Julia Stiles and David Cross play one of four Los Angeles couples whose weekly brunch is interrupted by a large-scale catastrophe.', 'web_url': 'https://www.nytimes.com/2013/04/12/movies/julia-stiles-and-david-cross-in-its-a-disaster.html', 'snippet': 'In Todd Berger’s comedy, Julia Stiles and David Cross play one of four Los Angeles couples whose weekly brunch is interrupted by a large-scale catastrophe.', 'lead_paragraph': 'It may be the end of the world, but they feel fine, even oblivious. That, at any rate, appears to be the principal, really the only point of the impishly, unfortunately titled “It’s a Disaster,” an underbaked comedy about eight people facing their mortality. Set in the present, it mostly unfolds in a Los Angeles house within gasping distance of a large-scale catastrophe of the kind usually let loose by masters of disaster, like Roland Emmerich. The writer and director, Todd Berger, is working on a far smaller scale than his blockbuster brethren do, and that may explain why he keeps calamitous details fuzzy, using two corpses, a Hazmat suit and a murder of crows to suggest the apocalyptic big picture. ', 'print_section': 'C', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Apocalypse, for Laughs', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'The Apocalypse, for Laughs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Berger, Todd', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Stiles, Julia', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cross, David', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-11T22:58:38+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e9a662f5-6f7c-53b0-8857-dff23339b57d', 'word_count': 403, 'uri': 'nyt://article/e9a662f5-6f7c-53b0-8857-dff23339b57d'}, {'abstract': 'A South African doctor on a layover in the United Arab Emirates is trapped there by criminal charges he had not been aware of.', 'web_url': 'https://www.nytimes.com/2013/04/12/world/middleeast/united-arab-emirates-laws-ensnare-a-doctor.html', 'snippet': 'A South African doctor on a layover in the United Arab Emirates is trapped there by criminal charges he had not been aware of.', 'lead_paragraph': 'JOHANNESBURG — For Dr. Cyril Karabus, it was a routine job, albeit in an exotic location. For six weeks in 2002, he filled in for another doctor in Abu Dhabi, lured like many other foreign professionals by the big paychecks that doctors, bankers, lawyers and architects can earn in the United Arab Emirates and other Persian Gulf nations.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/world/dubai/dubai-articleLarge.jpg', 'height': 381, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/12/world/dubai/dubai-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 381}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/world/dubai/dubai-jumbo.jpg', 'height': 400, 'width': 630, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images