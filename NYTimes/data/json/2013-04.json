0/arts/10artsbeat-hytner/10artsbeat-hytner-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 456}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/arts/10artsbeat-hytner/10artsbeat-hytner-jumbo.jpg', 'height': 778, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/arts/10artsbeat-hytner/10artsbeat-hytner-superJumbo.jpg', 'height': 1361, 'width': 1791, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/arts/10artsbeat-hytner/10artsbeat-hytner-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/10/arts/10artsbeat-hytner/10artsbeat-hytner-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/arts/10artsbeat-hytner/10artsbeat-hytner-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Two National Theater Directors to Depart', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hytner, Nicholas', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Starr, Nick', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Theater Co', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-10T17:35:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline'