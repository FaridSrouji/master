e': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Finding the Human Factor in Bank Risk', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Uncovering the Human Factor in Risk Management Models', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Statistics', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Subprime Mortgage Crisis', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Merrill Lynch & Co', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-03T16:15:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Jesse Eisinger', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'Eisinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fb1aff76-7ecd-5fcd-8906-2380c422a6dc', 'word_count': 1211, 'uri': 'nyt://article/fb1aff76-7ecd-5fcd-8906-2380c422a6dc'}, {'abstract': 'Carolina Hurricanes defenseman Joni Pitkanen sustained a broken heel during a high-speed icing race against the Washington Capitals on Tuesday night.', 'web_url': 'https://slapshot.blogs.nytimes.com/2013/04/03/pitkanens-injury-renews-debate-about-icing-rule/', 'snippet': 'Carolina Hurricanes defenseman Joni Pitkanen sustained a broken heel during a high-speed icing race against the Washington Capitals on Tuesday night.', 'lead_paragraph': 'After Carolina Hurricanes defenseman Joni Pitkanen broke his heel in a high-speed icing race on Tuesday night, there were revived calls to do away with traditional icing, which can lead to what the former Maple Leafs coach Ron Wilson called “train wreck” injuries.', 'source': 'The New York Times', 'multimedia': [