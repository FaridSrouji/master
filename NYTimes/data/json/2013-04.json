, 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19RDP_OCONOMOWOC/OCONOMOWOC-jumbo.jpg', 'height': 462, 'width': 333, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19RDP_OCONOMOWOC/OCONOMOWOC-superJumbo.jpg', 'height': 462, 'width': 333, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19RDP_OCONOMOWOC/OCONOMOWOC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/19/arts/19RDP_OCONOMOWOC/OCONOMOWOC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19RDP_OCONOMOWOC/OCONOMOWOC-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A T-Shirt War in Small-Town Wisconsin', 'kicker': 'Movie Review ', 'content_kicker': None, 'print_headline': 'Oconomowoc', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gillies, Andy', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-18T23:53:10+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/883cc402-12eb-5f86-80b7-b99ee590543a', 'word_count': 268, 'uri': 'nyt://article/883cc402-12eb-5f86-80b7-b99ee590543a'}, {'abstract': 'The hit Broadway musical “Mamma Mia!” will transfer from the Winter Garden Theater to the Broadhurst Theater six blocks south this year so the Shubert Organization — which owns both theaters — can clear the way for the possible opening of a new musical, “Rocky.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/18/mamma-mia-to-move/', 'snippet': 'The hit Broadway musical “Mamma Mia!” will transfer from the Winter Garden Theater to the Broadhurst Theater six blocks south this year so the Shubert Organization — which owns both theaters — can clear the way for the possible opening of a new mu...', 'lead_paragraph': 'The hit Broadway musical “Mamma Mia!” will transfer from the Winter Garden Theater to the Broadhurst Theater six blocks south this year so the Shubert Organization — which owns both theaters — can clear the way for the possible opening of a new musical, “Rocky,” at the Winter Garden next season. “Rocky,” which had its world premiere in Hamburg in November, has not been announced for Broadway, but two theater executives familiar with the “Rocky” plans said Thursday that the current plan is to open it at the Winter Garden by next spring, though nothing is set. They spoke on condition of anonymity because the “Rocky” plans are confidential. ', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Mamma Mia!’ to Move', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '‘Mamma Mia!’ to Move', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-19T00:00:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a8401b7b-9d7a-5720-bb17-48c684426278', 'word_count': 224, 'uri': 'nyt://article/a8401b7b-9d7a-5720-bb17-48c684426278'}, {'abstract': 'Stuart Holden has been challenged by injuries, but strong recent performances have him thinking about playing for the United States national team.', 'web_url': 'https://goal.blogs.nytimes.com/2013/04/18/after-a-series-of-setbacks-holden-stages-a-comeback/', 'snippet': 'Stuart Holden has been challenged by injuries, but strong recent performances have him thinking about playing for the United States national team.', 'lead_paragraph': 'As the 2012-13 season draws to a close, the American midfielder Stuart Holden is looking to finish a rocky journey that has tested his limits both physically and mentally.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/sports/soccer/19holden/19holden-articleLarge.jpg', 'height': 378, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/19/sports/soccer/19holden/19holden-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 378}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/sports/soccer/19holden/19holden-jumbo.jpg', 'height': 644, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/sports/soccer/19holden/19holden-superJumbo.jpg', 'height': 1289, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/sports/soccer/19holden/19holden-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/19/sports/soccer/19holde