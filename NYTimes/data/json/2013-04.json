/16/science/16CONV_SPAN/16CONV-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/16/science/16CONV_SPAN/16CONV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/16/science/16CONV_SPAN/16CONV-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/16/science/16CONV_SPAN/16CONV-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/16/science/16CONV_SPAN/16CONV-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/16/science/16CONV_SPAN/16CONV-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/16/science/16CONV_SPAN/16CONV-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Human Genome, Then and Now', 'kicker': 'A Conversation With', 'content_kicker': None, 'print_headline': 'Human Genome, Then and Now', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kolata, Gina', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Human Genome Project', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Genetics and Heredity', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Human Genome Research Institute', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Eric D (1959- )', 'rank': 5, 'major': 'N