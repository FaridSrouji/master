/14e1dd65-c317-5bb9-9f56-56cb3ef10cb5'}, {'abstract': 'Food-related events around New York.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/04/12/weekend-fare-137/', 'snippet': 'Food-related events around New York.', 'lead_paragraph': 'The documentary “American Meat,” about the meat production industry, will open Friday at Cinema Village, 22 East 12th Street in Greenwich Village. There will be a panel discussion after the film. Tickets are $11 per person, and Chipotle Mexican Grill, one of the sponsors of the premiere, will hand out a free gift after the screening and at other showings over the weekend.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Weekend Fare', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-12T16:57:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Bao Ong', 'person': [{'firstname': 'Bao', 'middlename': None, 'lastname': 'Ong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcca6890-8748-53af-a4b1-4c841884c21b', 'word_count': 437, 'uri': 'nyt://article/bcca6890-8748-53af-a4b1-4c841884c21b'}, {'abstract': 'Transmedia, a marriage of narrative and new technology, gets its nod in programming like “A Journal of Insomnia” at the Tribeca Film Festival.', 'web_url': 'https://www.nytimes.com/2013/04/14/movies/tribeca-film-festival-recognizes-transmedia.html', 'snippet': 'Transmedia, a marriage of narrative and new technology, gets its nod in programming like “A Journal of Insomnia” at the Tribeca Film Festival.', 'lead_paragraph': 'Visitors to “A Journal of Insomnia,” part of the Storyscapes section of the forthcoming Tribeca Film Festival, will set up an appointment and, at the agreed-upon hour, receive a phone call. They will then presumably stumble sleepless to their computers, click on the “Insomnia” Web site and interact with one of four characters featured in the festival’s foray into transmedia: the crazy-quilt crossroads of new technology, uncertain expectations and audience participation.', 'print_section': 'AR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/arts/14TRANS1_SPAN/14TRANS1-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/14/arts/14TRANS1_SPAN/14TRANS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/arts/14TRANS1_SPAN/14TRANS1-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/arts/14TRANS1_SPAN/14TRANS1-superJumbo.jpg', 'height': 1080, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/arts/14TRANS1_SPAN/14TRANS1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/14/arts/14TRANS1_SPAN/14TRANS1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/arts/14TRANS1_SPAN/14TRANS1_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'As You Watch, Invasion of the Platforms', 'kicker': None, 'content_kicker': None, 'print_headline': 'As You Watch, Invas