umbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/01/sports/METSFAN/METSFAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/01/sports/METSFAN/METSFAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/01/sports/METSFAN/METSFAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Fan’s Ballpark Routine Outlasting the Park', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Ballpark Routine Outlasting the Park', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ostertag, Robert', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Dodgers', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Citi Field (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-01T04:13:14+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ken Belson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Belson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31851dd9-48b2-56dd-bd28-7ac16442e4e7', 'word_count': 1048, 'uri': 'nyt://article/31851dd9-48b2-56dd-bd28-7ac16442e4e7'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/04/01/arts/television/whats-on-monday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '6:35 P.M. (Cinemax) SHAUN OF THE DEAD (2004) In this horror comedy directed by Edgar Wright, Simon Pegg plays Shaun, a worthless layabout who seems content to go nowhere fast as long as he can hang out at his favorite pub with his best friend, Ed (Nick Frost), and his girlfriend, Liz (Kate Ashfield). But then Liz dumps Shaun, and he decides to get his life together to win her back. Of course there’s also the small matter of a zombie apocalypse going on outside his door. Writing in The New York Times, Stephen Holden said the film skillfully satirized the zombie genre by “implying that Britain may already be populated with the living dead, metaphorically speaking.” He added: “The motley Londoners who face down the creatures are so inept and unthinking in their response to the catastrophe that the uncharitable part of you may decide that they deserve their probable (but not guaranteed) fates during what panicked television commentators label Z-Day.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Monday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-01T04:15:09+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/7c829cca-4299-54a0-bc31-9b4b5260fd3f', 'word_count': 759, 'uri': 'nyt://article/7c829cca-4299-54a0-bc31-9b4b5260fd3f'}, {'abstract': 'Pattycake, who is survived by 10 offspring, was described by the director of the Bronx Zoo as “an institution in New York City.”', 'web_url': 'https://www.nytimes.com/2013/04/01/nyregion/pattycake-elderly-re