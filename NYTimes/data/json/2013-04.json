ers.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hazy Future for Thriving S.E.C. Whistle-Blower Effort', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Hazy Future for S.E.C. Whistle-Blower Effort', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Securities and Commodities Violations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Whistle-Blowers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McKessy, Sean X', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Knight Capital Group Inc', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Whistleblowers Center', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Oppenheimer Holdings Inc', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-04-24T01:04:58+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Protess and Nathaniel Popper', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Nathaniel', 'middlename': None, 'lastname': 'Popper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3a0a8f49-5db6-5329-a60b-4a8b528feeb5', 'word_count': 1305, 'uri': 'nyt://article/3a0a8f49-5db6-5329-a60b-4a8b528feeb5'}, {'abstract': 'In Afghanistan, a Chinese mining company threatens to destroy the remains of an ancient Buddhist city, which archaeologists are now racing to excavate.', 'w