ank': 2, 'major': 'N'}], 'pub_date': '2013-04-24T23:43:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Natasha Singer', 'person': [{'firstname': 'Natasha', 'middlename': None, 'lastname': 'Singer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/12262a3f-bba7-5da8-bdbe-00230efb2101', 'word_count': 449, 'uri': 'nyt://article/12262a3f-bba7-5da8-bdbe-00230efb2101'}, {'abstract': 'Taking women’s names off the list of American novelists makes it harder and slower for women to gain equality in the literary world.', 'web_url': 'https://www.nytimes.com/2013/04/28/opinion/sunday/wikipedias-sexism-toward-female-novelists.html', 'snippet': 'Taking women’s names off the list of American novelists makes it harder and slower for women to gain equality in the literary world.', 'lead_paragraph': 'I JUST noticed something strange on Wikipedia. It appears that gradually, over time, editors have begun the process of moving women, one by one, alphabetically, from the “American Novelists” category to the “American Women Novelists” subcategory. So far, female authors whose last names begin with A or B have been most affected, although many others have, too.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/opinion/sunday/28wikipedia/28wikipedia-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/opinion/sunday/28wikipedia/28wikipedia-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/opinion/sunday/28wikipedia/28wikipedia-jumbo.jpg', 'height': 825, 'width': 825, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/opinion/sunday/28wikipedia/28wikipedia-superJumbo.jpg', 'height': 825, 'width': 825, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/opinion/sunday/28wikipedia/28wikipedia-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/opinion/sunday/28wikipedia/28wikipedia-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/opinion/sunday/28wikipedia/28wikipedia-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Wikipedia’s Sexism Toward Female Novelists', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Wikipedia’s Sexism Toward Female Novelists', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Wikipedia', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-24T23:45:35+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Amanda Filipacchi', 'person': [{'firstname': 'Amanda', 'middlename': None, 'lastname': 'Filipacchi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/11b928fa-161d-5dad-8217-d5687f2ed4c3', 'word_count': 608, 'uri': 'nyt://article/11b928fa-161d-5dad-8217-d5687f2ed4c3'}, {'abstract': 'Robert P. Astorino, the Westchester County executive, had vetoed a similar bill but was threatened with personal fines by the Justice Department.', 'web_url': 'https://www.nytimes.com/2013/04/25/nyregion/westchester-leader-agrees-to-sign-anti-bias-housing-bill.html', 'snippet': 'Robert P. Astorino, the Westchester County executive, had vetoed a similar bill but was threatened with personal fines by the Justice Department.', 'lead_paragraph': 'Facing a threat of a contempt lawsuit by the Justice Department, the Westchester County executive, Robert P. Astorino, sent county legislators a letter on Wednesday asking them to pass a law forbidding landlords to discriminate against renters based on their source of income, as required under the county’s 2009 fair-housing settlement.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Westchester Leader Acts on a Fair-Housing Bill', 'kicker': None, 'content_kicker': None, 'print_headline': 'County Chief Acts on a Bill Against Bias In Housing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Applebome, Peter', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Westchester County (NY)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Astorino, Robert P', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Affordable Housing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Housing and Urban Development Department', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Segregation', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Landlords', 'rank': 10, 'major': 'N'}, {'name': 