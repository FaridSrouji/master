pe': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Tom Marshall', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Marshall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/66b10d50-9716-56dc-88c8-cc3908e492da', 'word_count': 2070, 'uri': 'nyt://article/66b10d50-9716-56dc-88c8-cc3908e492da'}, {'abstract': 'Watch the exclusive premiere of the Saturdays Surf NYC video in celebration of the release of their second issue.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2013/04/16/now-showing-saturdays-surf-nyc/', 'snippet': 'Watch the exclusive premiere of the Saturdays Surf NYC video in celebration of the release of their second issue.', 'lead_paragraph': '“Twenty years ago, if you told somebody on the West Coast that you were from New York or New Jersey and that you surf, they would look at you like you had two heads,” says Danny DiMauro, a surfer and New Jersey native. The same reaction may result at the suggestion of starting a lifestyle periodical in print that is entirely free of advertising. But this week, the fellows behind Saturdays Surf NYC, a hybrid brand that acts as a surf shop, bookshop, coffee bar and men’s-wear boutique, release the second issue of their biannual publication called Saturdays Magazine.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Now Showing | Saturdays Surf NYC', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Surfing', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Saturdays Surf NYC (Manhattan, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-16T19:30:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original':