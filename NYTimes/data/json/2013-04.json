le': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/8d840710-859e-56bb-9fe2-c1d9300c4613', 'word_count': 0, 'uri': 'nyt://slideshow/8d840710-859e-56bb-9fe2-c1d9300c4613'}, {'abstract': 'Subaru plans to recall 10,000 Foresters over potentially pedal-obstructing floor mats, and Schneider Electric USA, a maker of E.V. chargers, is calling back charging units with potentially defective connectors.', 'web_url': 'https://wheels.blogs.nytimes.com/2013/04/26/attack-of-the-curly-floor-mats-subaru-issues-recall/', 'snippet': 'Subaru plans to recall 10,000 Foresters over potentially pedal-obstructing floor mats, and Schneider Electric USA, a maker of E.V. chargers, is calling back charging units with potentially defective connectors.', 'lead_paragraph': 'Subaru says it will recall about 10,000 of its 2014 Foresters over defective floor mats, and a supplier of charging stations for electric vehicles announced a recall of some charging units that could overheat, according to reports posted recently on Web site of the National Highway Traffic Safety Administration. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Attack of the Curly Floor Mats: Subaru Issues Recall', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Safety Features and Defects', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recalls and Bans of Products', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Highway Traffic Safety Administration', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Schneider Electric SA', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-26T16:30:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Christopher Jensen', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f72cbf5-7dff-5028-8eb9-ae2cac6c1bd8', 'word_count': 281, 'uri': 'nyt://article/5f72cbf5-7dff-5028-8eb9-ae2cac6c1bd8'}, {'abstract': 'An updated, but always incomplete, blogroll. Never let the perfect be the enemy of the good.', 'web_url': 'https://parenting.blogs.nytimes.com/2013/04/26/the-motherlode-blogroll-freshly-linked-but-never-final/', 'snippet': 'An updated, but always incomplete, blogroll. Never let the perfect be the enemy of the good.', 'lead_paragraph': 'Weeks ago, I set out to update the Motherlode blogroll. I want to read blogs, I said — the kind of blogs I used to read, funny and honest and compelling. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Motherlode Blogroll: Freshly Linked but Never Final', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blogs and Blogging (Internet)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-26T16:32:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8769e220-ade5-53dc-9995-64ce5ada64e6', 'word_count': 768, 'uri': 'nyt://article/8769e220-ade5-53dc-9995-64ce5ada64e6'}, {'abstract': 'Times critics on “Mud,” “Pain & Gain” and “The Reluctant Fundamentalist.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/26/this-weeks-movies-pain-gain-mud-and-the-reluctant-fundamentalist/', 'snippet': 'Times critics on “Mud,” “Pain & Gain” and “The Reluctant Fundamentalist.”', 'lead_paragraph': 'In this week’s video, Times critics offer their thoughts on “Pain & Gain,” “Mud” and “The Reluctant Fundamentalist.” See all of this week’s reviews here.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Week’s Movies: ‘Pain & Gain,’ ‘Mud’ and ‘The Reluctant Fundamentalist’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-26T16:37:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/6a39de39-6330-5cae-a42c-c356e6afaf74', 'word_count': 25, 'uri': 'nyt://article/6a39de39-6330-5cae-a42c-c356e6afaf74'}, {'abstract': 'The authorities said the collapse at the hospital in Bhopal, India, seriously injured at least four people and left more than a dozen trapped.', 'web_url': 'https://www.nytimes.com/2013/04/27/world/asia/hospital-wing-collapses-in-india.html', 'snippet': 'The authorities said the collapse at the hospital in Bhopal, India, seriously injured at least four people and left more than a dozen trapped.', 'lead_paragraph': 'NEW DELHI — A wing of a public hospital in Bhopal, India, collapsed on Friday afternoon, seriously injuring at least four people and leaving more than a dozen trapped, according to Indian authorities.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hospital Wing Collapses in India', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'India: Hospital Wing Collapses', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New Delhi (India)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Accidents and Safety', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-26T16:41:21+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Gardiner Harris', 'person': [{'firstname': 'Gardiner', 'middlename': None, 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/47e89b23-53a0-5112-9328-8a8de824cf08', 'word_count': 230, 'uri': 'nyt://article/47e89b23-53a0-5112-9328-8a8de824cf08'}, {'abstract': 'Iris Johansen, whose new novel, “Taking Eve,” is at No. 5 on the hardcover fiction list, cites Ayn Rand as one of her favorite authors, but says, “I’m not aware of a Randian influence in my work.”', 'web_url': 'https://www.nytimes.com/2013/05/05/books/review/inside-the-list.html', 'snippet': 'Iris Johansen, whose new novel, “Taking Eve,” is at No. 5 on the hardcover fiction list, cites Ayn Rand as one of her favorite authors, but says, “I’m not aware of a Randian influence in my work.”', 'lead_paragraph': ' IRIS SHRUGGED: Iris Johansen’s new suspense novel, “Taking Eve,” enters the hardcover fiction list at No. 5. The book features her longtime heroine Eve Duncan, a forensic sculptor with a tragic past, and is the first in a trilogy scheduled for publication this year. “Writing a trilogy is always a difficult challenge,” Johansen told me via e-mail, “because I use an entire ensemble of characters that are familiar to fans but must be introduced to new readers.” ', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28list-img/28list-img-jumbo.jpg', 'height': 450, 'width': 454, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28list-img/28list-img-superJumbo.jpg', 'height': 450, 'width': 454, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28list-img/28list-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/books/review/28list-img/28list-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28list-img/28list-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'TBR: Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-26T16:41:35+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e35a3c68-cd85-5702-aaa0-91093a47c47a', 'word_count': 646, 'uri': 'nyt://article/e35a3c68-cd85-5702-aaa0-91093a47c47a'}, {'abstract': 'A Marine Corps veteran turned journalist explores the contentious issue of whether veterans with post-traumatic stress disorder should be allowed to possess firearms.', 'web_url': 'https://atwar.blogs.nytimes.com/2013/04/26/should-gun-restrictions-be-placed-on-veterans-with-ptsd/', 'snippet': 'A Marine Corps veteran turned journalist explores the contentious issue of whether veterans with post-traumatic stress disorder should be allowed to possess firearms.', 'lead_paragraph': 'When Phillip Barker received the official report from the Department of Veterans Affairs in 2008, it said he suffered from homicidal ideations of a passive-aggressive nature. It also said that he had an alcohol dependency. That he experiences anxiety, sleeplessness, hypervigilance and nervous tics as part of his post-traumatic stress disorder, diagnosed in 2007 after his honorable discharge from the Marine Corps. And that he has flashbacks from his deployment to Falluja, Iraq, in 2004. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Should Gun Restrictions Be Placed on Veterans With PTSD?', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Newtown, Conn, Shooting (2012)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Post-Traumatic Stress Disorder', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Veterans', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'National Rifle Assn', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Marine Corps', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Veterans Affairs Department', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Marine Corps Base Camp Lejeune (SC)', 'rank': 11, 'major': 'N'}], 'pub_date': '2013-04-26T16:47:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Thomas James Brennan', 'person': [{'firstname': 'Thomas', 'middlename': 'James', 'lastname': 'Brennan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/de091cdd-8960-5bf1-b6ed-ccefb39abc27', 'word_count': 983, 'uri': 'nyt://article/de091cdd-8960-5bf1-b6ed-ccefb39abc27'}, {'abstract': 'Mr. Jones sang about heartbreak and hard drinking.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2013/04/26/george-jones-country-singer/', 'snippet': 'Mr. Jones sang about heartbreak and hard drinking.', 'lead_paragraph': 'When you think of George Jones, you might think of country songs about heartache and regret. We think of his hit “White Lightning,” which was all about him and his pappy making moonshine and trying to outsmart revenoors looking for them. Mr. Jones died Friday after a career that spanned more than 50 years. Our colleague Jon Pareles writes that Mr. Jones was “universally respected and just as widely imitated,” and that his songs held “the echoes of a life in which success and excess battled for decades.” Here’s Mr. Jones on YouTube singing “White Lightning,” a No. 1 country hit in 1959.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'George Jones, Country Singer', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-26T16:48:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/08a6666d-b704-5d21-8c4d-589d12905757', 'word_count': 103, 'uri': 'nyt://article/08a6666d-b704-5d21-8c4d-589d12905757'}, {'abstract': 'With an ambitious redevelopment plan, city officials are seeking to dispel Staten Island’s reputation as the unhip borough.', 'web_url': 'https://www.nytimes.com/2013/04/28/realestate/north-shore-staten-island-borough-seeks-the-spotlight.html', 'snippet': 'With an ambitious redevelopment plan, city officials are seeking to dispel Staten Island’s reputation as the unhip borough.', 'lead_paragraph': 'The 19th-century buildings at the former lighthouse service depot on the North Shore of Staten Island are in such a state of decay that tree branches reach out of the dormer windows. But the city hopes this abandoned site, which dates to the French and Indian War, will soon re-emerge as a bustling urban center with shops, restaurants, a hotel and housing.', 'print_section': 'RE', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/realestate/28ISLAND1_SPAN/28ISLAND1_SPAN-articleLarge-v2.jpg', 'height': 352, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/realestate/28ISLAND1_SPAN/28ISLAND1_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 352}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/realestate/28ISLAND1_SPAN/28ISLAND1_SPAN-jumbo-v2.jpg', 'height': 601, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/realestate/28ISLAND1_SPAN/28ISLAND1_SPAN-superJumbo-v2.jpg', 'height': 1202, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/realestate/28ISLAND1_SPAN/28ISLAND1_SPAN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/realestate/28ISLAND1_SPAN/28ISLAND1_SPAN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/realestate/28ISLAND1_SPAN/28ISLAND1_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Borough Seeks the Spotlight', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Borough Seeks the Spotlight', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Staten Island (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Area Planning and Renewal', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-26T16:55:51+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Ronda Kaysen', 'person': [{'firstname': 'Ronda', 'middlename': None, 'lastname': 'Kaysen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0014c99d-cfe3-596d-81cd-627b8a1d54cc', 'word_count': 1053, 'uri': 'nyt://article/0014c99d-cfe3-596d-81cd-627b8a1d54cc'}, {'abstract': 'Nomura reported its best full-year results since 2007. But much of those gains relied on better performance domestically, which make it very dependent on the success of Japan’s economic policies, the author writes.', 'web_url': 'https://dealbook.nytimes.com/2013/04/26/nomuras-profit-gains-closely-tied-to-japans-economic-success/', 'snippet': 'Nomura reported its best full-year results since 2007. But much of those gains relied on better performance domestically, which make it very dependent on the success of Japan’s economic policies, the author writes.', 'lead_paragraph': 'Nomura has spent most of the last five years trying to break out of Japan. So it’s ironic that the investment bank’s best full-year results since 2007 were propelled by a revival at home. As with Japan’s economic renaissance, however, investors’ hopes are running ahead of reality.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Nomura’s Profit Gains Closely Tied to Japan’s Economic Success', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Nomura Group', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-26T16:56:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter Thal Larsen', 'person': [{'firstname': 'Peter', 'middlename': 'Thal', 'lastname': 'Larsen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a76ffd2e-cedd-58f1-8e4e-2c0a0a9a36b4', 'word_count': 372, 'uri': 'nyt://article/a76ffd2e-cedd-58f1-8e4e-2c0a0a9a36b4'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2013/04/28/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'A DISPOSITION TO BE RICH: Ferdinand Ward, the Greatest Swindler of the Gilded Age,  by Geoffrey C. Ward. (Vintage, $16.) In 1880, Ferdinand Ward persuaded Ulysses S. Grant to become a partner in a brokerage house that reported astonishing profits but was really a vast Ponzi scheme. (It blew up in 1884, causing panic on Wall Street and bankrupting Grant.) Geoffrey C. Ward scrupulously documents his great-grandfather’s rise to riches and fame, and his even more dizzying fall from grace.', 'print_section': 'BR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paperback Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-26T16:59:13+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/849a17bd-a47b-5527-a510-9ac8c5cc6e24', 'word_count': 494, 'uri': 'nyt://article/849a17bd-a47b-5527-a510-9ac8c5cc6e24'}, {'abstract': 'The Carpenter family — David, Sean and Lauren — are the force behind the Salomé Chamber Orchestra.', 'web_url': 'https://www.nytimes.com/2013/04/28/arts/music/the-family-behind-the-salome-chamber-orchestra.html', 'snippet': 'The Carpenter family — David, Sean and Lauren — are the force behind the Salomé Chamber Orchestra.', 'lead_paragraph': '“It’s your solo, take it away,” said the violist David Aaron Carpenter to the vibraphonist David Stevens during a recent rehearsal at a synagogue on Central Park West. Mr. Carpenter was directing the Salomé Chamber Orchestra in Lera Auerbach’s alluring “Sogno di Stabat Mater,” for violin, viola, vibraphone and orchestra, in preparation for a concert at the Metropolitan Museum. ', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28SALOME1_SPAN/28SALOME1-artic