itle': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/b802e1c4-103e-5b4a-9598-8241d6a9ac93', 'word_count': 0, 'uri': 'nyt://video/b802e1c4-103e-5b4a-9598-8241d6a9ac93'}, {'abstract': 'The Senate majority leader urged his colleagues to pass a gun-safety bill.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/04/17/harry-reids-conscience/', 'snippet': 'The Senate majority leader urged his colleagues to pass a gun-safety bill.', 'lead_paragraph': 'Senate Majority Leader Harry Reid generally isn’t thought of as a conviction politician. He’s a vote-counter; a highly cautious pragmatist who not long ago ducked an opportunity to reform the filibuster, and with it the increasingly slow-to-non-existent legislative process.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Harry Reid’s Conscience', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Newtown, Conn, Shooting (2012)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Reid, Harry', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-17T21:01:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Juliet Lapidos', 'person': [{'firstname': 'Juliet', 'middlename': None, 'lastname': 'Lapidos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8dc2483-4d49-5ba0-8890-07d0eabffe96', 'word_count': 430, 'uri': 'nyt://article/f8dc2483-4d49-5ba0-8890-07d0eabffe96'}, {'abstract': 'The Swedish company X5 Music Group is the envy of the industry with its cheap, best-selling compilation packages.', 'web_url': 'https://www.nytimes.com/2013/04/18/arts/music/cheap-compilations-make-classical-pay-for-x5-music-group.html', 'snippet': 'The Swedish company X5 Music Group is the envy of the industry with its cheap, best-selling compilation packages.', 'lead_paragraph': 'Among iTunes’s top classical albums are plenty by Yo-Yo Ma and Glenn Gould. But the list is also filled with budget compilations, like “The 50 Most Essential Pieces of Classical Music” and “Beethoven: 100 Supreme Classical Masterpieces,” that pack in dozens of “1812” Overtures and “Für Elises” for as little as $6. ', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/compilation/compilation-articleLarge.jpg', 'height': 833, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/18/arts/compilation/compilation-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 833}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/compilation/compilation-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/compilation/compilation-superJumbo.jpg', 'height': 2048, 'width': 1475, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/compilation/compilation-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/18/arts/compilation/compilation-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/compilation/compilation-thumbLarge.jpg', 'height': 1