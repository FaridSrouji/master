cleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 788}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/basketball/25brown/25brown-jumbo.jpg', 'height': 1024, 'width': 780, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/basketball/25brown/25brown-superJumbo.jpg', 'height': 2048, 'width': 1559, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/basketball/25brown/25brown-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/25/sports/basketball/25brown/25brown-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/sports/basketball/25brown/25brown-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Mike Brown Redux in Cleveland', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Mike', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Irving, Kyrie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'James, LeBron', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Cleveland Cavaliers', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Cleveland (Ohio)', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-24T19:39:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e34c6784-77d6-5e5d-98b7-f613f5a886cf', 'word_count': 350, 'uri': 'nyt://article/e34c6784-77d6-5e5d-98b7-f613f5a886cf'}, {'abstract': 'I heard Havens’ version of “Here Comes the Sun” after Harrison’s. Why did the two versions make me feel so different?', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/04/24/richie-havens-1941-2013/', 'snippet': 'I heard Havens’ version of “Here Comes the Sun” after Harrison’s. Why did the two versions make me feel so different?', 'lead_paragraph': 'In 1971, around when I first heard the voice that was Richie Havens, I was 7 years old. Radio was the way you formed your musical brain and mine was hungry. It was a good time for that. The pop airwaves were almost completely integrated. The Stones, the Beatles, and CCR mingled with Stevie Wonder, Marvin Gaye, the Temptations, the Isleys, the Jacksons and even the Osmonds into one dizzying sonic mix. I learned to love practically everything. But some things leapt out.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Richie Havens, 1941 – 2013', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Folk Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Havens, Richie (1941-2013)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-24T19:40:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Peter Catapano', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Catapano', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08ad6559-e53a-5b03-95de-619653554c8a', 'word_count': 553, 'uri': 'nyt://article/08ad6559-e53a-5b03-95de-619653554c8a'}, {'abstract': 'In the latest installment of the Intersection street stylse video series, we head up to Burnside and Grand Avenues in the Bronx and met residents who draw style inspiration from Rihanna to the 4 train.', 'web_url': 'https://runway.blogs.nytimes.com/2013/04/24/intersection-video-bold-on-burnside/', 'snippet': 'In the latest installment of the Intersection street stylse video series, we head up to Burnside and Grand Avenues in the Bronx and met residents who draw style inspiration from Rihanna to the 4 train.', 'lead_paragraph': 'In the latest installment of the Intersection street style video series, we headed up to Burnside and Grand Avenues in the Bronx and met residents who draw style inspiration anywhere from Rihanna to the No. 4 train. We interviewed Tiffany Trinidad, a student at the High School of Fashion Industries, who sews her own clothes and praises Kanye West for “bringing leather back.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Intersection Video: Bold on Burnside', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-24T19:42:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Joanna Nikas', 'person': [{'firstname': 'Joanna', 'middlename': None, 'lastname': 'Nikas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f1b951d-0b9b-5fd3-a629-6a17df1f3d80', 'word_count': 64, 'uri': 'nyt://article/3f1b951d-0b9b-5fd3-a629-6a17df1f3d80'}, {'abstract': 'Darren Johnson on how the hoarding taskforce works.', 'web_url': 'https://www.nytimes.com/audio/2013/04/29/health/Hoarding_Darren.html', 'snippet': 'Darren Johnson on how the hoarding taskforce works.', 'lead_paragraph': 'Darren Johnson on how the hoarding taskforce works.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Darren Johnson', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-24T19:47:49+0000', 'document_type': 'audio', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': '', '_id': 'nyt://audio/2a905567-e2dd-5775-914a-bb507e45e582', 'word_count': 0, 'uri': 'nyt://audio/2a905567-e2dd-5775-914a-bb507e45e582'}, {'abstract': 'Michael P. Huerta told skeptical Republicans on a House appropriations subcommittee that sequestration had forced the agency to be run like a starving airline.', 'web_url': 'https://www.nytimes.com/2013/04/25/us/politics/faa-chief-michael-huerta-comes-under-fire-on-capitol-hill.html', 'snippet': 'Michael P. Huerta told skeptical Republicans on a House appropriations subcommittee that sequestration had forced the agency to be run like a starving airline.', 'lead_paragraph': 'WASHINGTON — Amid an increasingly partisan atmosphere, the head of the Federal Aviation Administration told skeptical Republicans on Wednesday that automatic budget cuts had forced the F.A.A. to run somewhat like a starving airline: it has reduced its inventory of spare parts, stopped hiring and training new employees, and cut back on modernization.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/us/FAA/FAA-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/25/us/FAA/FAA-article