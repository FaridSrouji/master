, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Funicello, Annette', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-08T18:06:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Daniel McDermon', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'McDermon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/56a85faa-1f49-5173-826e-cc5a56c7c558', 'word_count': 186, 'uri': 'nyt://article/56a85faa-1f49-5173-826e-cc5a56c7c558'}, {'abstract': 'A leader who transformed Britain by pushing the nation in new directions.', 'web_url': 'https://www.nytimes.com/2013/04/09/opinion/margaret-thatcher-prime-minister.html', 'snippet': 'A leader who transformed Britain by pushing the nation in new directions.', 'lead_paragraph': 'Margaret Thatcher, who died of a stroke on Monday at age 87, transformed Britain more thoroughly than any other prime minister of the past half-century. She was a pathbreaker from the moment she took office in 1979 as Britain’s first, and so far only, female prime minister. And she was the rare conservative leader to come not from the upper echelons of Britain’s class-obsessed society, but from a modest apartment above her father’s grocery.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Margaret Thatcher, Prime Minister', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Margaret Thatcher, Prime Minister', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Thatcher, Margaret H', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 