imedia': [], 'headline': {'main': 'Beating Dead Horses', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-13T12:04:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3927227f-0791-53a2-84ec-7436472b905c', 'word_count': 55, 'uri': 'nyt://article/3927227f-0791-53a2-84ec-7436472b905c'}, {'abstract': 'After being assessed a two-stroke penalty Saturday for hitting from the wrong spot on the 15th hole a day earlier at the Masters, Tiger Woods finished the third round at three under par.', 'web_url': 'https://www.nytimes.com/2013/04/14/sports/golf/woods-faces-disqualification-at-augusta.html', 'snippet': 'After being assessed a two-stroke penalty Saturday for hitting from the wrong spot on the 15th hole a day earlier at the Masters, Tiger Woods finished the third round at three under par.', 'lead_paragraph': 'AUGUSTA, Ga. — As the cheers for Tiger Woods on the first tee gave way to the relative hush of patrons hoofing it to the green, a man behind the tee box turned to his wife and said, “I didn’t hear anybody call Tiger a cheater.”', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/sports/golf/14woods1-img/14woods1-img-articleLarge.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/14/sports/golf/14woods1-img/14woods1-img-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type':