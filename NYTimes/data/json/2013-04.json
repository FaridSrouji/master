': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-29T13:08:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Sruthi Gottipati', 'person': [{'firstname': 'Sruthi', 'middlename': None, 'lastname': 'Gottipati', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1d1fc97-c684-54be-8399-ca91b8fa6b31', 'word_count': 512, 'uri': 'nyt://article/c1d1fc97-c684-54be-8399-ca91b8fa6b31'}, {'abstract': 'The team cut quarterback Tim Tebow, acquired 13 months ago, with no pomp and no mention of his statistics, perhaps in part because there were none worth mentioning.', 'web_url': 'https://www.nytimes.com/2013/04/30/sports/football/jets-release-quarterback-tim-tebow.html', 'snippet': 'The team cut quarterback Tim Tebow, acquired 13 months ago, with no pomp and no mention of his statistics, perhaps in part because there were none worth mentioning.', 'lead_paragraph': 'It was 13 months ago that the Jets welcomed Tim Tebow to the team, introducing him in their spacious field house at a news conference attended by more than 200 members of the news media that snarled traffic around the team’s facility in Florham Park, N.J.', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/sports/30tebow2_cnd/30tebow2_cnd-articleLarge.jpg', 'height': 449, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/30/sports/30tebow2_cnd/30tebow2_cnd-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 449}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/sports/30tebow2_cnd/30tebow2_cnd-jumbo.jpg', '