on': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/business/YUAN/YUAN-superJumbo.jpg', 'height': 1340, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/business/YUAN/YUAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/10/business/YUAN/YUAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/business/YUAN/YUAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Images of Dead Pigs Reduce China’s Appetite for Pork, Keep Prices Down', 'kicker': None, 'content_kicker': None, 'print_headline': 'Images of Dead Pigs Cut China’s Pork Appetite and Keep Consumer Prices Down', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pork', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bradsher, Keith', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Inflation (Economics)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-09T04:37:34+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Keith Bradsher', 'person': [{'firstname': 'Keith', 'middlename': None, 'lastname': 'Bradsher', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3c46fb5-b75e-5525-97df-b40e99c68c22', 'word_count': 805, 'uri': 'nyt://article/c3c46fb5-b75e-5525-97df-b40e99c68c22'}, {'abstract': 'Michigan’s Spike Albrecht got off to a torrid start, but Louisville’s Luke Hancock ultimately prevailed in a 3-pointer showdown.', 'web_url': 'https://www.nytimes.com/2013/04/09/sports/ncaabasketball/a-3-point-shootout-between-michigans-spike-albrecht-and-louisvilles-luke-hancock.html', 'snippet': 'Michigan’s Spike Albrecht got off to a torrid start, but Louisville’s Luke Hancock ultimately prevailed in a 3-pointer showdown.', 'lead_paragraph': 'ATLANTA — The nets did not move. That is how pure their jumpers were. In they went, again and again, from 21 feet and beyond, shot by a Michigan freshman named Spike and a Louisville junior named Luke. No one dared miss, and neither did. It was the highest-stakes game of Horse they had ever played — on the raised court of the Georgia Dome, a national championship the prize — and, perhaps, the unlikeliest one, too.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/ncaabasketball/09sider1-img/09sider1-img-articleLarge.jpg', 'height': 435, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/09/sports/ncaabasketball/09sider1-img/09sider1-img-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 435}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/ncaabasketball/09sider1-img/09sider1-img-jumbo.jpg', 'height': 743, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/ncaabasketball/09sider1-img/09sider1-img-superJumbo.jpg', 'height': 1486, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/ncaabasketball/09sider1-img/09sider1-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/09/sports/ncaabasketball/09sider1-img/09sider1-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/sports/ncaabasketball/09sider1-img/09sider1-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For 2 Unheralded Players, a 3-Point Shootout', 'kicker': None, 'content_kicker': None, 'print_headline': 'For 2 Unheralded Players, A 3-Point Shootout', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball (College)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'NCAA Basketball Championships (Men)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Michigan', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Louisville', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hancock, Luke', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Albrecht, Spike', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-09T04:45:49+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Basketball', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c0f7fb67-bc95-504b-bc20-0df61d6e59e4', 'word_count': 1126, 'uri': 'nyt://article/c0f7fb67-bc95-504b-bc20-0df61d6e59e4'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2013/04/09/arts/television/whats-on-tuesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (Sundance) THE GIRL WHO PLAYED WITH FIRE (2010) Noomi Rapace, above, reprises her role as Lisbeth Salander, the vulnerable yet ruthlessly competent computer hacker, and Michael Nyqvist is Mikael Blomkvist, the crusading journalist who is her confidant and alter ego, in this sequel to “The Girl With the Dragon Tattoo,” based on the second novel in the Swedish trilogy by Stieg Larsson and directed by Daniel Alfredson. The plot this time concerns a young journalist and his girlfriend, a graduate student, who have been investigating a sex-trafficking ring with patrons high up the political chain. “It is Ms. Rapace’s fierce and sly performance, more than the themes or the plot, that sustains ‘The Girl Who Played With Fire,’\xa0” A. O. Scott wrote in The New York Times. “Without her, it would be a not bad procedural, touching on some knotty contemporary issues and infused with a paranoia that is at once unsettling and comforting.” But, he added, “Ms. Rapace, tiny and agile, her steely rage showing now and then the tiniest crack of vulnerability, belongs to another dimension altogether. She makes this movie good enough, but also makes you wish it were much better.” ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Tuesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Today', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-09T05:00:08+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/9efd59c2-d83a-5b47-93a2-3542b650c534', 'word_count': 694, 'uri': 'nyt://article/9efd59c2-d83a-5b47-93a2-3542b650c534'}, {'abstract': 'Margaret Thatcher was famed as the “iron lady” who didn’t turn. Yet she did on the issue of Hong Kong, when she ceded China total sovereignty after a year of trying to hold on for Britain, according to witnesses and historians.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2013/04/09/the-time-the-iron-lady-turned-before-china/', 'snippet': 'Margaret Thatcher was famed as the “iron lady” who didn’t turn. Yet she did on the issue of Hong Kong, when she ceded China total sovereignty after a year of trying to hold on for Britain, according to witnesses and historians.', 'lead_paragraph': '4:28 a.m. | Updated BEIJING — “The lady’s not for turning,” Margaret Thatcher, who died on Monday, told an audience of fellow Conservatives in Britain in late 1980. The phrase would become a signature of her personality and governing style.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/world/asia/09ThatcherRDV/09ThatcherRDV-articleLarge-v2.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/09/world/asia/09ThatcherRDV/09ThatcherRDV-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/world/asia/09ThatcherRDV/09ThatcherRDV-jumbo-v2.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/world/asia/09ThatcherRDV/09ThatcherRDV-superJumbo-v2.jpg', 'height': 1384, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'typ