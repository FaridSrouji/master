charts I.Q. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/12MATILDA_SPAN/12MATILDA_SPAN-articleLarge.jpg', 'height': 327, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/12/arts/12MATILDA_SPAN/12MATILDA_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 327}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/12MATILDA_SPAN/12MATILDA_SPAN-jumbo.jpg', 'height': 558, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/12MATILDA_SPAN/12MATILDA_SPAN-superJumbo.jpg', 'height': 1115, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/12MATILDA_SPAN/12MATILDA_SPAN-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/12/arts/12MATILDA_SPAN/12MATILDA_SPAN-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/12/arts/12MATILDA_SPAN/12MATILDA_SPAN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Children of the World, Unite!', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Children of the World, Unite!', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Matilda the Musical (Play)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Shubert Th