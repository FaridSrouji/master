son': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5d3ad617-2df2-5780-9bb2-ddd417f70ebf', 'word_count': 831, 'uri': 'nyt://article/5d3ad617-2df2-5780-9bb2-ddd417f70ebf'}, {'abstract': 'Mercedes-Benz will introduce its Concept GLA compact crossover this weekend at the Shanghai Motor Show in China.', 'web_url': 'https://wheels.blogs.nytimes.com/2013/04/18/the-mercedes-concept-gla-is-a-personal-drive-in-theater/', 'snippet': 'Mercedes-Benz will introduce its Concept GLA compact crossover this weekend at the Shanghai Motor Show in China.', 'lead_paragraph': 'Mercedes-Benz is going smaller and sportier with its Concept GLA, a compact crossover aimed at younger buyers. The GLA, to be unveiled at the Shanghai Motor Show this weekend, has a long, muscular nose, large wheels and squat haunches. The mechanical bits include a turbocharged 2-liter 4-cylinder gasoline engine, making 208 horsepower, a 7-speed dual-clutch automatic transmission and 4Matic all-wheel drive.', 'print_section': 'AU', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Mercedes Concept GLA Is a Personal Drive-In Theater', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': 'Mercedes Reveals Concept GLA Crossover', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Utility Vehicles and Light Trucks', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Mercedes-Benz', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Shanghai (China)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-18T15:53:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', '