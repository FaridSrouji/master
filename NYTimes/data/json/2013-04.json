/08/us/CONDOM/CONDOM-superJumbo-v2.jpg', 'height': 1231, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/us/CONDOM/CONDOM-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/08/us/CONDOM/CONDOM-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/08/us/CONDOM/CONDOM-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ban on Free Condoms Jeopardizes Group’s Work With Catholic College', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ban on Free Condoms Jeopardizes Student Group’s Work With Catholic College', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Boston College', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bidgood, Jess', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Condoms', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-08T01:14:30+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jess Bidgood', 'person': [{'firstname': 'Jess', 'middlename': None, 'lastname': 'Bidgood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad5c9846-bb2c-5785-8dbf-ebc4ed293607', 'word_count': 1045, 'uri': 'nyt://article/ad5c9846-bb2c-5785-8dbf-ebc4ed293607'}, {'abstract': 'Research in neuroscience suggests that exposure to fear-inducing situations is not the only way to overcome them.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/04/07/for-the-anxious-avoidance-can-have-an-upside/', 'snippet': 'Research in neuroscience suggests that exposure to fear-inducing situations is not the only way to overcome them.', 'lead_paragraph': 'Shortly after 9/11, I wrote an editorial in the American Journal of Psychiatry with Jack Gorman, a psychiatrist with whom I was collaborating. \xa0Many people seemed to be coping with the extraordinary events of the terror attacks by staying close to home and avoiding going back out in the world.\xa0 This was not unexpected since avoidance is a well-known form of coping with traumatic events. Politicians were urging people to go back to work, to re-engage in social activities, to get on with life.\xa0 Gorman and I thought this was really good advice because of something I’d discovered in my work as a neuroscientist.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For the Anxious, Avoidance Can Have an Upside', 'kicker': 'Anxiety', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Brain', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rats', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-08T01:15:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Joseph LeDoux', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'LeDoux', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a70bb5d9-a5e8-564c-b74d-f68989053ec7', 'word_count': 1466, 'uri': 'nyt://article/a70bb5d9-a5e8-564c-b74d-f68989053ec7'}, {'abstract': 'President Obama still hasn’t laid out a formal legal framework for drone strikes.', 'web_url': 'https://www.nytimes.com/2013/04/08/opinion/the-trouble-with-drones.html', 'snippet': 'President Obama still hasn’t laid out a formal legal framework for drone strikes.', 'lead_paragraph': 'The Obama administration has floated a plan to shift drone operations from the Central Intelligence Agency to the military. This is supposed to make targeted killings of suspected terrorists more transparent and accountable, but so far it looks as if it would be a marginal improvement.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Trouble With Drones', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Trouble With Drones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Targeted Killings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-08T01:17:08+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/b5a33082-b469-51a3-9a99-d644fda021f1', 'word_count': 464, 'uri': 'nyt://article/b5a33082-b469-51a3-9a99-d644fda021f1'}, {'abstract': 'Nevada gets millions of tax dollars from legal sports betting. No wonder other states want a piece of the gambling pie.', 'web_url': 'https://www.nytimes.com/2013/04/08/opinion/betting-on-the-buzzer-beaters.html', 'snippet': 'Nevada gets millions of tax dollars from legal sports betting. No wonder other states want a piece of the gambling pie.', 'lead_paragraph': 'The parallel universe of widespread gambling has been in full swing during the N.C.A.A. basketball tournament, whose championship game is Monday night. Betting furiously on every game, fans produced a legal take in Nevada that will exceed $200 million — twice what was bet there on the last Super Bowl. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Betting on the Buzzer Beaters', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Betting on the Buzzer Beaters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'College Athletics', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gambling', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'NCAA Basketball Championships (Men)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Collegiate Athletic Assn', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Nevada', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'States (US)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball (College)', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-04-08T01:17:30+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/d24a4065-7fa8-5a68-a539-9a15926c9a81', 'word_count': 340, 'uri': 'nyt://article/d24a4065-7fa8-5a68-a539-9a15926c9a81'}, {'abstract': 'Congress must fix policies that leave skilled workers and their families in limbo for years.', 'web_url': 'https://www.nytimes.com/2013/04/08/opinion/reforms-for-work-visas.html', 'snippet': 'Congress must fix policies that leave skilled workers and their families in limbo for years.', 'lead_paragraph': 'The debate about immigration reform has properly focused on giving the 11 million unauthorized immigrants in America a shot at citizenship. But broad reform should also include improvements to employment-based visas and green cards that make it possible to attract and keep highly skilled workers in technology, medical and educational fields, among others. ', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reforms for Work Visas', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Reforms for Work Visas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Foreign Workers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Reform and Reorganization', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-08T01:18:49+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/44a731d3-ad8a-53ae-a97a-4c1a884d662d', 'word_count': 457, 'uri': 'nyt://article/44a731d3-ad8a-53ae-a97a-4c1a884d662d'}, {'abstract': 'Lottery numbers for New York, New Jersey and Connecticut.', 'web_url': 'https://www.nytimes.com/2013/04/08/nyregion/lottery-numbers-for-new-york-new-jersey-and-connecticut.html', 'snippet': 'Lottery numbers for New York, New Jersey and Connecticut.', 'lead_paragraph': 'April 7, 2013', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lottery Numbers', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lottery Numbers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lotteries', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-08T01:19:09+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/7035b4fc-4fce-5008-8dd3-1145e62e64e4', 'word_count': 169, 'uri': 'nyt://article/7035b4fc-4fce-5008-8dd3-1145e62e64e4'}, {'abstract': 'Is health coverage the death of liberty?', 'web_url': 'https://www.nytimes.com/2013/04/08/opinion/krugman-insurance-and-freedom.html', 'snippet': 'Is health coverage the death of liberty?', 'lead_paragraph': 'President Obama will soon release a new budget, and the commentary is already flowing fast and furious. Progressives are angry (with good reason) over proposed cuts to Social Security; conservatives are denouncing the call for more revenues. But it’s all Kabuki. Since House Republicans will block anything Mr. Obama proposes, his budget is best seen not as policy but as positioning, an attempt to gain praise from “centrist” pundits.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-kru