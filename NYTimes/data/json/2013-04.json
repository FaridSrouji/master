s/vecsey1/vecsey1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/03/sports/vecsey1/vecsey1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Double Dose on Opening Day Warms the Soul', 'kicker': 'Sports of The Times', 'content_kicker': None, 'print_headline': 'Double Dose on Opening Day Warms the Soul', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Vecsey, George', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-02T16:11:21+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By George Vecsey', 'person': [{'firstname': 'George', 'middlename': None, 'lastname': 'Vecsey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/959722c2-4cc6-55af-b19d-bfac9e33e47f', 'word_count': 1062, 'uri': 'nyt://article/959722c2-4cc6-55af-b19d-bfac9e33e47f'}, {'abstract': 'This year’s World Nomads Festival will focus on the culture of Tunisia, where artists played a crucial role in overthrowing the country’s authoritarian government in January 2011.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/02/french-arts-festival-in-new-york-to-focus-on-tunisia/', 'snippet': 'This year’s World Nomads Festival will focus on the culture of Tunisia, where artists played a crucial role in overthrowing the country’s authoritarian government in January 2011.', 'lead_paragraph': 'This year’s World Nomads Festival, presented in May by the French Institute Alliance Française, will focus on the culture of Tunisia, where artists played a crucial role in overthrowing the country’s authoritarian government in January 2011. Those street protests ignited demonstrations in other nations and helped usher in the Arab Spring. Marie-Monique Steckel, the president of Alliance Française, said that the festival, which runs from May 3 – June 1, will feature some of the “phenomenal artistic creativity that has emerged on the heels of the Arab Spring.” There will be art, film, photography and dance shows, an ideas forum, and a Tunisian craft market. Performing alongside his Tunisian-born father, Tsvi Bokaer, the dancer and choreographer Jonah Bokaer will present the United States premiere of “The Ulysses Syndrome.” Some of the country’s best-known artists, including Sonia M’Barek, Ghalia Benali, Emel Mathlouthi, will also be performing. For more information, go to www.fiaf.org.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'World Nomads Arts Festival to Focus on Tunisia', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-02T16:33:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Patricia', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/449c651e-1c4e-5cee-9197-c6def611f5af', 'word_count': 151, 'uri': 'nyt://article/449c651e-1c4e-5cee-9197-c6def611f5af'}, {'abstract': 'Two more senators, one from each party, announced their support for same-sex marriage rights on Tuesday.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2013/04/02/kirk-and-carper-announce-support-for-same-sex-marriage/', 'snippet': 'Two more senators, one from each party, announced their support for same-sex marriage rights on Tuesday.', 'lead_paragraph': 'Two more senators, one from each party, announced their support for same-sex marriage on Tuesday. Their shifts appear to mark 50 votes to legalize such unions in the Senate. ', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'G.O.P. and Democratic Senators Back Gay Marriage', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': 'More Senators Support Gay Marriage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Carper, Thomas R', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kirk, Mark Steven', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-02T16:33:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Sarah Wheaton', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Wheaton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aaeb7d0d-d9f0-5ddd-a309-86e0c3e29a56', 'word_count': 232, 'uri': 'nyt://article/aaeb7d0d-d9f0-5ddd-a309-86e0c3e29a56'}, {'abstract': 'The Times’s Michael Barbaro on how the arrest of two lawmakers and a half-dozen other politicians could shake up New York’s Republican Party.', 'web_url': 'https://www.nytimes.com/video/nyregion/100000002150587/bribery-accusations-before-city-election.html', 'snippet': 'The Times’s Michael Barbaro on how the arrest of two lawmakers and a half-dozen other politicians could shake up New York’s Republican Party.', 'lead_paragraph': 'The Times’s Michael Barbaro on how the arrest of two lawmakers and a half-dozen other politici