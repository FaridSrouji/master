 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Carrion, Adolfo Jr', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Catsimatidis, John A', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lhota, Joseph J', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McDonald, George T', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-24T20:50:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Stephen Farrell', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Farrell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8bb9582a-22af-5f4d-a365-a66903939c2d', 'word_count': 843, 'uri': 'nyt://article/8bb9582a-22af-5f4d-a365-a66903939c2d'}, {'abstract': 'The Broadway musical “Nice Work if You Can Get It” will close on June 15 after 27 preview performances and 478 regular performances.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/24/nice-work-to-close-on-broadway/', 'snippet': 'The Broadway musical “Nice Work if You Can Get It” will close on June 15 after 27 preview performances and 478 regular performances.', 'lead_paragraph': 'The Broadway musical “Nice Work if You Can Get It,” a venture involving the heirs of George and Ira Gershwin and several veteran theater producers to showcase famous songs by the brothers, will close on June 15 after 27 preview performances and 478 regular performances, the producers announced on Wednesday. The Jazz Age-style show, which originally paired Tony Award winner Matthew Broderick as a playboy with Tony nominee Kelli O’Hara as a bootlegger, opened last April to mixed reviews and never caught real fire at the box office. (Ms. O’Hara’s role is now played by Tony nominee Jessie Mueller.) ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'mai