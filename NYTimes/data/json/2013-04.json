ject', 'value': 'Grand Central Terminal (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pedestrian Malls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Roads and Traffic', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sidewalk Cafes', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Grand Central Partnership', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Quennell Rothschild & Partners', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Park Avenue (Manhattan, NY)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-25T19:00:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By David W. Dunlap', 'person': [{'firstname': 'David', 'middlename': 'W.', 'lastname': 'Dunlap', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e75ec90-42cb-5aa8-835b-d7b2ea7b532d', 'word_count': 747, 'uri': 'nyt://article/8e75ec90-42cb-5aa8-835b-d7b2ea7b532d'}, {'abstract': 'A rare 1988 Porsche supercar is about to go up for sale in Texas.', 'web_url': 'https://wheels.blogs.nytimes.com/2013/04/25/porsche-959-komfort-goes-up-for-auction/', 'snippet': 'A rare 1988 Porsche supercar is about to go up for sale in Texas.', 'lead_paragraph': 'On Saturday in Fort Worth, RM Auctions will sell, without reserve, some 64 cars from the collection of a Texas businessman, including 10 Porsches, like a 1973 911 Carrera RS Touring and a 1958 356A 1600 Speedster. But the jewel for many Porsche collectors is a 1988 959 “Komfort,” the more civilized version of the supercar that excited the world with its nearly 200 mile per hour top speed and zero to 60 m.p.h. time of under 4 seconds.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Porsche 959 ‘Komfort’ Goes Up for Auction', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': Non