t_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Terrorism', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schneier, Bruce', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AL QAEDA', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-16T20:28:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/77514539-391f-5357-8166-96c7ce83fbd8', 'word_count': 623, 'uri': 'nyt://article/77514539-391f-5357-8166-96c7ce83fbd8'}, {'abstract': 'The naming is in recognition of a $3 million gift given to the Museum of the Moving Image by the charitable foundation of Mr. Redstone, the executive chairman of Viacom Inc. and CBS Corporation.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/16/museum-of-the-moving-image-naming-its-theater-for-sumner-m-redstone/', 'snippet': 'The naming is in recognition of a $3 million gift given to the Museum of the Moving Image by the charitable foundation of Mr. Redstone, the executive chairman of Viacom Inc. and CBS Corporation.', 'lead_paragraph': 'In 2013, your moviegoing dollar may not get you the same number of feature-length entertainments and concession-stand goodies that it used to. But for the right amount of those dollars, you can still get a movie theater named in your honor.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Museum of the Moving Image Naming Theater for Sumner M. Redstone', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Redstone, Sumner M', 'rank': 2, 'ma