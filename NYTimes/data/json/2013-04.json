': 'subject', 'value': 'ADMISSIONS STANDARDS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Financial Aid (Education)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kantrowitz, Mark', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-04T10:01:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Tanya Abrams', 'person': [{'firstname': 'Tanya', 'middlename': None, 'lastname': 'Abrams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/54d71c15-4ceb-5063-97a2-f2cbdd9ebbfa', 'word_count': 174, 'uri': 'nyt://article/54d71c15-4ceb-5063-97a2-f2cbdd9ebbfa'}, {'abstract': 'The German central bank is sending a team to New York to look into allegations that Deutsche Bank hid billions of dollars in losses to avoid a potential bailout during the financial crisis, according to people with direct knowledge of the matter.', 'web_url': 'https://dealbook.nytimes.com/2013/04/04/german-authorities-are-said-to-investigate-deutsche-bank/', 'snippet': 'The German central bank is sending a team to New York to look into allegations that Deutsche Bank hid billions of dollars in losses to avoid a potential bailout during the financial crisis, according to people with direct knowledge of the matter.', 'lead_paragraph': 'PARIS — The German central bank is investigating allegations that Deutsche Bank hid billions of dollars in losses to avoid a potential bailout during the financial crisis, people with direct knowledge of the matter said on Thursday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'German Authorities Are Said to Investigate Deutsche Bank', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ban