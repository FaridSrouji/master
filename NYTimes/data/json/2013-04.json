: 'nyt://article/14bba6c2-3cf3-5782-91c4-242060fc9abe', 'word_count': 814, 'uri': 'nyt://article/14bba6c2-3cf3-5782-91c4-242060fc9abe'}, {'abstract': 'Caring for Albert Einstein’s childhood teacup or Meyer Lansky’s marriage certificate, archivists in New York are assuming a higher profile and doing more networking.', 'web_url': 'https://www.nytimes.com/2013/04/29/nyregion/archivists-bringing-past-into-future-are-now-less-cloistered.html', 'snippet': 'Caring for Albert Einstein’s childhood teacup or Meyer Lansky’s marriage certificate, archivists in New York are assuming a higher profile and doing more networking.', 'lead_paragraph': 'Their gatherings take place at locations as disparate as the Metropolitan Museum of Art in Manhattan or the Bohemian Hall and Beer Garden in Queens, but they always reflect their consummate knowledge of New York. And when the conversation turns to topics like chaos or history’s turning points, no one is in a hurry to go home. ', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Leaving Cloister of Dusty Offices, Young Archivists Meet Like Minds', 'kicker': None, 'content_kicker': None, 'print_headline': 'Leaving Cloister Of Dusty Offices, Young Archivists Find Like Minds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Archives and Records', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Archivists Round Table of Metropolitan New York', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-29T02:01:12+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Alison Leigh Cowan', 'person': [{'firstname': 'Alison', 'middlename': 'Leigh', 'lastname': 'Cowan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'ny