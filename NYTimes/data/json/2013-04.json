ion': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9bedbeb6-6c32-5e9d-b04d-9890b77c3ba6', 'word_count': 1056, 'uri': 'nyt://article/9bedbeb6-6c32-5e9d-b04d-9890b77c3ba6'}, {'abstract': 'An April 28 concert devoted to Hindemith at Weill Recital Hall will recall his pranks and provocations.', 'web_url': 'https://www.nytimes.com/2013/04/21/arts/music/hindemith-master-and-prankster-at-weill-recital-hall.html', 'snippet': 'An April 28 concert devoted to Hindemith at Weill Recital Hall will recall his pranks and provocations.', 'lead_paragraph': 'In 1925 Paul Hindemith wrote a short piece for string quartet that — when played well — provides seven minutes of some of the most excruciatingly painful music ever to offend the ear. Its title, rendered in English, is “Overture to the ‘Flying Dutchman’ as Played on Sight by a Bad Spa Orchestra by the Village Well at 7 in the Morning,” and if you’re a devoted Wagner fan you might want to stop reading now. ', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/21/arts/21HINDEMITH_SPAN/21HINDEMITH_SPAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/21/arts/21HINDEMITH_SPAN/21HINDEMITH_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/21/arts/21HINDEMITH_SPAN/21HINDEMITH_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/21/arts/21HINDEMITH_SPAN/21HINDEMITH_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/21/arts/21HINDEMITH_SPAN/HINDEMITH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/21/arts/21HINDEMITH_SPAN/HINDEMITH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/21/arts/21HINDEMITH_SPAN/HINDEMITH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Slyly Pricking the Wagnerian Balloon', 'kicker': None, 'content_kicker': None, 'print_headline': 'Slyly Pricking the Wagnerian Balloon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hindemith, Paul', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-19T14:58:55+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/98ba5404-4838-56bc-86df-a55a14f20079', 'word_count': 1020, 'uri': 'nyt://article/98ba5404-4838-56bc-86df-a55a14f20079'}, {'abstract': 'How have you handled this week’s breaking news stories? Here is how our classroom collaborators in New Jersey taught about them.', 'web_url': 'https://learning.blogs.nytimes.com/2013/04/19/common-core-practice-the-boston-bombings-and-a-supreme-court-case/', 'snippet': 'How have you handled this week’s breaking news stories? Here is how our classroom collaborators in