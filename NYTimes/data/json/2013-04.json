/19AINT_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19AINT_SPAN/19AINT_SPAN-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19AINT_SPAN/19AINT_SPAN-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19AINT_SPAN/19AINT_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/19/arts/19AINT_SPAN/19AINT_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/19/arts/19AINT_SPAN/19AINT_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Playing Notes That Linger', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Playing Notes That Linger', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Helm, Levon', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hatley, Jacob', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-04-18T22:22:47+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/cb2e8f2f-8255-58c1-a602-eb4d84f4e9d7', 'word_count': 377, 'uri': 'nyt://article/cb2e8f2f-8255-58c1-a602-eb4d84f4e9d7'}, {'abstract': 'A listing of walking tours, spoken word events, street fairs and more in New York.', 'web_url': 'https://www.nytimes.com/2013/04/19/arts/spare-times-for-april-19-25.html', 'snippet': 'A listing of walking tours, spoken word events, street fairs and more in New York.', 'lead_paragraph': '‘The Woolworth Building @ 100’ (through July 14) Opening in April 1913, the Woolworth Building reigned supreme as the world’s tallest office building for 17 years, losing the title in 1930 to 40 Wall Street. A month later the honor went to the Chrysler Building, and then in 1931 to the Empire State Building, which held it until the World Trade Center opened in the early ’70s. But, at 100 years old this year, the Woolworth Building, designed by Cass Gilbert, is again ahead of the pack — at least in age — and the subject of an exhibition of blueprints and photographs at the Skyscraper Museum, 39 Battery Place, Lower Manhattan.', 'print_section': 'C', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spare Times for April 19-25', 'kicker': None, 'content_kicker': None, 'print_headline': 'Spare Times', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Culture (Arts)', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-18T22:23:44+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Anne Mancuso', 'person': [{'firstname': 'Anne', 'middlename': None, 'lastname': 'Mancuso', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/08ca24d5-9f7b-5285-bb83-2c34867dc31e', 'word_count': 3095, 'uri': 'nyt://article/08ca24d5-9f7b-5285-bb83-2c34867dc31e'}, {'abstract': 'At the bridge table, when your task appears to be impossible, try to find a lie of the cards that allows you to succeed.', 'web_url': 'https://www.nytimes.com/2013/04/18/crosswords/bridge/bridge-premier-division-play-in-norway-in-february.html', 'snippet': 'At the bridge table, when your task appears to be impossible, try to find a lie of the cards that allows you to succeed.', 'lead_paragraph': 'We’ve all heard variations on this idea: The difficult we do immediately; the impossible takes a little longer.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/18bridge-1/18bridge-1-jumbo.jpg', 'height': 370, 'width': 203, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/18bridge-1/18bridge-1-superJumbo.jpg', 'height': 370, 'width': 203, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/18bridge-1/18bridge-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/18/arts/18bridge-1/18bridge-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/18/arts/18bridge-1/18bridge-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bridge — Premier Division Play in Norway in February', 'kicker': 'Bridge', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'k