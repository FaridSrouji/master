York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/9457f48c-7596-5c08-b439-b05b3d04db9c', 'word_count': 184, 'uri': 'nyt://article/9457f48c-7596-5c08-b439-b05b3d04db9c'}, {'abstract': 'Tom Perrotta talks about a new selection of the great American writer’s correspondence.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/26/book-review-podcast-willa-cathers-letters/', 'snippet': 'Tom Perrotta talks about a new selection of the great American writer’s correspondence.', 'lead_paragraph': 'This week in The New York Times Book Review, Tom Perrotta reviews “The Selected Letters of Willa Cather,” a look at correspondence that the great American writer wanted to keep private. Mr. Perrotta writes:', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28cover-shadow/28cover-shadow-jumbo.jpg', 'height': 214, 'width': 190, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28cover-shadow/28cover-shadow-superJumbo.jpg', 'height': 214, 'width': 190, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28cover-shadow/28cover-shadow-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/books/review/28cover-shadow/28cover-shadow-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28cover-shadow/28cover-shadow-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Book Review Podcast: Willa Cather’s Letters', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Podcasts', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bosman, Julie', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Cather, Willa', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cowles, Gregory', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Perrotta, Tom', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, John', 'rank': 10, 'major': 'N'}], 'pub_date': '2013-04-26T17:00:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cfc6098f-6d44-549e-a7f6-c491a766a875', 'word_count': 259, 'uri': 'nyt://article/cfc6098f-6d44-549e-a7f6-c491a766a875'}, {'abstract': 'Marina Abramovic, a performance artist whose mostly solo works often involve feats of endurance and madness, has found pleasure working with the Paris Opera Ballet.', 'web_url': 'https://www.nytimes.com/2013/04/28/arts/dance/marina-abramovic-with-bolero-at-paris-opera-ballet.html', 'snippet': 'Marina Abramovic, a performance artist whose mostly solo works often involve feats of endurance and madness, has found pleasure working with the Paris Opera Ballet.', 'lead_paragraph': 'PARIS — “I am fascinated by these dancers,” the performance artist Marina Abramovic whispered this month, sitting at the front of a huge, light-filled rehearsal studio at the top of the Bastille opera house. Before her, nine Paris Opera Ballet members moved dreamily around the room in an improvisation as the inexorable strains of Ravel’s “Bolero” resounded. ', 'print_section': 'AR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BOLERO1_SPAN/28BOLERO1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/arts/28BOLERO1_SPAN/28BOLERO1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BOLERO1_SPAN/28BOLERO1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BOLERO1_SPAN/28BOLERO1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BOLERO1_SPAN/28BOLERO1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/arts/28BOLERO1_SPAN/28BOLERO1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BOLERO1_SPAN/28BOLERO1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Loner Enjoys Company', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Loner Enjoys Company', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sulcas, Roslyn', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Paris Opera Ballet', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ABRAMOVIC, MARINA', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-26T17:01:24+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7937e5a-5149-5178-a4ea-39317f911fd1', 'word_count': 1263, 'uri': 'nyt://article/c7937e5a-5149-5178-a4ea-39317f911fd1'}, {'abstract': 'Warren Lee Hill, Jr., has an I.Q. of 70. He shouldn’t be on death row.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/04/26/disgracing-the-quintessential-system-of-justice/', 'snippet': 'Warren Lee Hill, Jr., has an I.Q. of 70. He shouldn’t be on death row.', 'lead_paragraph': ' The state of Georgia may soon execute Warren Lee Hill, Jr., an intellectually disabled man with an I.Q of 70. Under a 2002 Supreme Court ruling it is unconstitutional to execute him or anyone in that category — but the Constitution, in this case, may not win out.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Disgracing ‘the Quintessential System of Justice’', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': 'Disgracing Justice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Capital Punishment', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Barkett, Rosemary', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-26T17:01:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Lincoln Caplan', 'person': [{'firstname': 'Lincoln', 'middlename': None, 'lastname': 'Caplan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/28116273-3180-511c-b3a5-ed8a1b3ce11e', 'word_count': 349, 'uri': 'nyt://article/28116273-3180-511c-b3a5-ed8a1b3ce11e'}, {'abstract': 'At the Hearing Voices symposium, music and psychology address those imagined sounds that might annoy, or that might be preludes to creative output.', 'web_url': 'https://www.nytimes.com/2013/04/28/arts/music/auditory-hallucinations-what-they-are-what-they-do.html', 'snippet': 'At the Hearing Voices symposium, music and psychology address those imagined sounds that might annoy, or that might be preludes to creative output.', 'lead_paragraph': 'PALO ALTO, CALIF. — The performance space of the Center for Computer Research in Music and Acoustics at Stanford University was filled to capacity on a recent Saturday morning, the blinds drawn against the optimistic California sunshine. Sets of loudspeakers positioned on either side of the room emitted a repetitive pattern of phonemes that were so short as to resemble brief electronic bleeps. After a few seconds, a voice with zero inflection but crisp diction seemed to emerge out of the bleeps, barking at me, “Wake up — wake up — wake up — wake up,” over and over, steady as a metronome. Then it changed tack: “Window — window — where’s the window — where’s the rainbow — where’s the rainbow.”', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BRAIN_SPAN/28BRAIN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/arts/28BRAIN_SPAN/28BRAIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BRAIN_SPAN/28BRAIN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BRAIN_SPAN/28BRAIN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BRAIN_SPAN/28BRAIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/arts/28BRAIN_SPAN/28BRAIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/arts/28BRAIN_SPAN/28BRAIN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Sounds of a Mystery', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Sounds of a Mystery', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Noise', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-26T17:02:53+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/634d714e-c71e-5adb-9372-b012ecf83426', 'word_count': 1264, 'uri': 'nyt://article/634d714e-c71e-5adb-9372-b012ecf83426'}, {'abstract': 'Recently reviewed books of particular interest.', 'web_url': 'https://www.nytimes.com/2013/04/28/books/review/editors-choice.html', 'snippet': 'Recently reviewed books of particular interest.', 'lead_paragraph': 'THE THIRD COAST: When Chicago Built the American Dream,  by Thomas Dyja. (Penguin Press, $29.95.) This robust cultural history weaves together the stories of the artists, styles and ideas that developed in Chicago before and after World War II.', 'print_section': 'BR', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': "Editor's Choice | Recent Books of Particular Interest", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-26T17:06:38+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/68123c4d-bf79-5219-b2b0-29fa24998593', 'word_count': 269, 'uri': 'nyt://article/68123c4d-bf79-5219-b2b0-29fa24998593'}, {'abstract': 'How it feels to be the victim of a serial plagiarist.', 'web_url': 'https://www.nytimes.com/2013/04/28/books/review/nice-poem-ill-take-it.html', 'snippet': 'How it feels to be the victim of a serial plagiarist.', 'lead_paragraph': 'If you read British newspapers, you might have heard of Christian Ward. In 2011, Ward won the Exmoor Society’s Hope Bourne prize for his poem “The Deer at Exmoor,” only to have his work revealed as a copy of “The Deer,” by Helen Mort, which won the Café Writers Open Poetry Competition in England in 2009. Ward defended himself by saying, “I had no intention of deliberately plagiarizing,” and suggested he had used Mort’s work as a model and had submitted a premature draft.', 'print_section': 'BR', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-BEASLEY/0428-bks-BEASLEY-articleLarge.jpg', 'height': 752, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/books/review/0428-bks-BEASLEY/0428-bks-BEASLEY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 752}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-BEASLEY/0428-bks-BEASLEY-jumbo.jpg', 'height': 1024, 'width': 818, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-BEASLEY/0428-bks-BEASLEY-superJumbo.jpg', 'height': 1674, 'width': 1336, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-BEASLEY/0428-bks-BEASLEY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/books/review/0428-bks-BEASLEY/0428-bks-BEASLEY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-BEASLEY/0428-bks-BEASLEY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nice Poem; I’ll Take It', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'Nice Poem; I’ll Take It', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poetry and Poets', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Beasley, Sandra', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Plagiarism', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-26T17:07:21+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Sandra Beasley', 'person': [{'firstname': 'Sandra', 'middlename': None, 'lastname': 'Beasley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7507c9fd-44a9-54fd-af49-b30163ffc094', 'word_count': 1248, 'uri': 'nyt://article/7507c9fd-44a9-54fd-af49-b30163ffc094'}, {'abstract': 'The novelist Tom Perrotta considers Willa Cather “one of the truly underrated” American writers.', 'web_url': 'https://www.nytimes.com/2013/04/28/books/review/up-front.html', 'snippet': 'The novelist Tom Perrotta considers Willa Cather “one of the truly underrated” American writers.', 'lead_paragraph': 'The novelist Tom Perrotta, who reviews Willa Cather’s letters this week, said in a recent e-mail that for all of Cather’s renown, he still considers her “one of the truly underrated” American writers. “She’s trapped in a regionalist pigeonhole,” he said. “She’s the bard of the prairie, Laura Ingalls Wilder for college kids, and doesn’t get the credit she deserves as a stylist and storyteller.”', 'print_section': 'BR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-UPFRONT/0428-bks-UPFRONT-articleLarge.jpg', 'height': 1077, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/books/review/0428-bks-UPFRONT/0428-bks-UPFRONT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1077}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-UPFRONT/0428-bks-UPFRONT-jumbo.jpg', 'height': 1024, 'width': 571, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-UPFRONT/0428-bks-UPFRONT-superJumbo.jpg', 'height': 2048, 'width': 1141, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-UPFRONT/0428-bks-UPFRONT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/books/review/0428-bks-UPFRONT/0428-bks-UPFRONT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/0428-bks-UPFRONT/0428-bks-UPFRONT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Up Front', 'kicker': None, 'content_kicker': None, 'print_headline': 'Up Front', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Perrotta, Tom', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-26T17:08:24+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By The Editors', 'person': [], 'organization': 'The Editors'}, 'type_of_material': 'News', '_id': 'nyt://article/f8fb22cd-f6aa-524e-825e-08d6b940766a', 'word_count': 260, 'uri': 'nyt://article/f8fb22cd-f6aa-524e-825e-08d6b940766a'}, {'abstract': 'James Salter’s first novel in more than 30 years follows the loves and losses of a World War II veteran.', 'web_url': 'https://www.nytimes.com/2013/04/28/books/review/all-that-is-by-james-salter.html', 'snippet': 'James Salter’s first novel in more than 30 years follows the loves and losses of a World War II veteran.', 'lead_paragraph': 'It’s been almost 35 years since the publication of James Salter’s previous novel, “Solo Faces.” In the meantime, he’s written two volumes of stories and one of poetry, a memoir, a collection of travel essays and, with his wife, Kay Eldredge Salter, a book about food. He has not been idle. Still, any or all of those books, excellent as they are, might suggest a career in twilight, with grand gestures and major lifts all in the rearview mirror. And why not? Salter is 87, with a reputation so secure he has nothing left to prove. If there were a Mount Rushmore for writers, he’d be there already. He could have published nothing, and no one would have thought less of him. ', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28JONES/28JONES-articleLarge.jpg', 'height': 758, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/books/review/28JONES/28JONES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 758}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28JONES/28JONES-jumbo.jpg', 'height': 1024, 'width': 811, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28JONES/28JONES-superJumbo.jpg', 'height': 2048, 'width': 1621, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28JONES/28JONES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/books/review/28JONES/28JONES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28JONES/28JONES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Changed Man', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Changed Man', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Salter, James', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-26T17:10:41+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Malcolm Jones', 'person': [{'firstname': 'Malcolm', 'middlename': None, 'lastname': 'Jones', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e5798dc5-ff7f-569b-ad92-626bd3acbdda', 'word_count': 1207, 'uri': 'nyt://article/e5798dc5-ff7f-569b-ad92-626bd3acbdda'}, {'abstract': 'Low morale at banks and other financial institutions in London is leading some employees to behave at work as if they were still at home wearing pajamas, according to a business coach.', 'web_url': 'https://dealbook.nytimes.com/2013/04/26/a-wrinkle-in-the-workplace/', 'snippet': 'Low morale at banks and other financial institutions in London is leading some employees to behave at work as if they were still at home wearing pajamas, according to a business coach.', 'lead_paragraph': 'LONDON — There was a time not long ago when the image of pajamas evoked ideas like innovation, creativity, even freedom. Unshackled from the grind of the everyday workplace, employees or entrepreneurs could use a loose-fitting approach to unleash productivity.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Wrinkle in the Workplace', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Executives and Management (Theory)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Environment', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-26T17:10:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Julia Werdigier', 'person': [{'firstname': 'Julia', 'middlename': None, 'lastname': 'Werdigier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4259ff9-8144-5cd7-bd5d-dc970798c297', 'word_count': 472, 'uri': 'nyt://article/d4259ff9-8144-5cd7-bd5d-dc970798c297'}, {'abstract': 'A fractious family comes together to defend a troubled relative in Elizabeth Strout’s novel.', 'web_url': 'https://www.nytimes.com/2013/04/28/books/review/the-burgess-boys-by-elizabeth-strout.html', 'snippet': 'A fractious family comes together to defend a troubled relative in Elizabeth Strout’s novel.', 'lead_paragraph': 'Stories of marital relations — strained, destroyed or restored — surely take up a larger section of our fiction shelves than stories of brothers and sisters. Yet why should that be, given the deep imprint siblings can make? Staying intimate with one’s spouse is a challenge, certainly, but the problems posed by a difficult brother or sister can be just as painful.', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28BROWNRIGG/28BROWNRIGG-articleLarge.jpg', 'height': 369, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/books/review/28BROWNRIGG/28BROWNRIGG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 369}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28BROWNRIGG/28BROWNRIGG-jumbo.jpg', 'height': 630, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28BROWNRIGG/28BROWNRIGG-superJumbo.jpg', 'height': 1261, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28BROWNRIGG/28BROWNRIGG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/books/review/28BROWNRIGG/28BROWNRIGG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/books/review/28BROWNRIGG/28BROWNRIGG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sibling Rivals', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sibling Rivals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Strout, Elizabeth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-26T17:10:54+0000', 'document_type': 'artic