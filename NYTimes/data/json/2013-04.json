nyt://article/6e2f6e73-4d15-59b8-a7ff-b91d9d27c8bc'}, {'abstract': 'Federal regulators are under pressure to rein in a multibillion-dollar consulting industry after the firms stumbled during a recent review of foreclosure abuses. But the efforts may be stymied, by the regulators’ cozy ties to the consultants and limited legal authority to penalize them.', 'web_url': 'https://dealbook.nytimes.com/2013/04/10/despite-pressure-to-police-consultants-regulators-face-obstacles/', 'snippet': 'Federal regulators are under pressure to rein in a multibillion-dollar consulting industry after the firms stumbled during a recent review of foreclosure abuses. But the efforts may be stymied, by the regulators’ cozy ties to the consultants and l...', 'lead_paragraph': 'Federal regulators are facing pressure from Capitol Hill to rein in a multibillion-dollar consulting industry after the companies stumbled during their recent review of mortgage foreclosure abuses. But the efforts could be stymied, given regulators’ close ties to consultants and limited legal authority to penalize them.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Efforts to Regulate Consultants Face Big Obstacles', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'U.S. Efforts to Regulate Consultants Face Big Obstacles', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Brown, Sherrod', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cummings, Elijah', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ludwig, Eugene A', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Schapiro, Mary L', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Deloitte & Touche', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'PricewaterhouseCoopers', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Promontory Financial Group', 'rank': 8, 'major': 'N'}], 'pub_date': '2013-04-10T22:00:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Protess and Jessica Silver-Greenberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jessica', 'middlename': None, 'lastname': 'Silver-Greenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6cd1cd42-9150-5f14-bf28-31deb3a1b681', 'word_count': 934, 'uri': 'nyt://article/6cd1cd42-9150-5f14-bf28-31deb3a1b681'}, {'abstract': 'Philippe Petit , the high-wire artist who walked between the towers of the World Trade Center in 1974, recently held a party for the release of his new book about the knots he relies on during his walks.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/04/10/tightrope-expert-extols-the-knots-that-held-him/', 'snippet': 'Philippe Petit , the high-wire artist who walked between the towers of the World Trade Center in 1974, recently held a party for the release of his new book about the knots he relies on during his walks.', 'lead_paragraph': 'This time, Philippe Petit was only a couple of feet off the ground.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/11/nyregion/10cityroom-petite1/10cityroom-petite1-articleLarge.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/11/nyregion/10cityroom-petite1/10cityroom-petite1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 403}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/11/nyregion/10cityroom-petite1/10ci