/IMMIG-superJumbo.jpg', 'height': 1420, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/us/IMMIG/IMMIG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/24/us/IMMIG/IMMIG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/24/us/IMMIG/IMMIG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Immigration Bill Would Aid Security, Napolitano Says', 'kicker': None, 'content_kicker': None, 'print_headline': 'Immigration Bill Would Aid Security, Napolitano Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate Committee on the Judiciary', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Homeland Security Department', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Napolitano, Janet', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Boston Marathon Bombings (2013)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-23T21:50:51+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Parker', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf6f2284-c9ae-59f3-a4ff-61711523f109', 'word_count': 826, 'uri': 'nyt://article/bf6f2284-c9ae-59f3-a4ff-61711523f109'}, {'abstract': 'Last night’s show at the Bowery Ballroom proved that salvation can still be found in well-written three-minute pop songs.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2013/04/23/pop-relief-from-the-generationals/', 'snippet': 'Last night’s show at the Bowery Ballroom proved that salvation can still be found in well-written three-minute pop songs.', 'lead_paragraph': 'Innocence was regained for an hour or so last night during a late set by the New Orleans duo the Generationals at the Bowery Ballroom onthe Lower East Side. They’ve been roaming the indie circuit for a few years, and a couple of their songs — “When They Fight, They Fight” and “Ten-Twenty-Ten” — have been heard in movies or in TV shows or commercials. Even if they did leave out one of my favorite tracks, “Carrying the Torch,” the reaction to last night’s show proved that salvation can still be found in well-written three-minute pop songs with freshly showered hooks, delivered at full nozzle.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/23/magazine/23-generationals-2/23-generationals-2-articleLarge.jpg', 'height': 803, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/23/magazine/23-generationals-2/23-generationals-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 803}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/23/magazine/23-generationals-2/23-generationals-2-jumbo.jpg', 'height': 1024, 'width': 765, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/23/magazine/23-generationals-2/23-generationals-2-superJumbo.jpg', 'height': 1296, 'width': 968, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'r