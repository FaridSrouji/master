, 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/world/JP-CASHBAGS/JP-CASHBAGS-superJumbo.jpg', 'height': 1461, 'width': 1996, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/world/JP-CASHBAGS/JP-CASHBAGS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/29/world/JP-CASHBAGS/JP-CASHBAGS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/world/JP-CASHBAGS/JP-CASHBAGS-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'With Bags of Cash, C.I.A. Seeks Influence in Afghanistan', 'kicker': None, 'content_kicker': None, 'print_headline': 'Karzai’s Office Gets Bags Full Of C.I.A. Cash', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rosenberg, Matthew', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Karzai, Hamid', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-28T22:33:19+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Matthew Rosenberg', 'person': [{'firstname': 'Matthew', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/683011bc-2b53-56ed-8a87-54848374f65a', 'word_count': 1454, 'uri': 'nyt://article/683011bc-2b53-56ed-8a87-54848374f65a'}, {'abstract': 'Some residents of the town, Umm Ruwaba, about 300 miles southwest of the capital, criticized local officials for failing to provide adequate security.', 'web_url': 'https://www.nytimes.com/2013/04/29/world/africa/sudans-army-retakes-town-after-rebel-attack.html', 'snippet': 'Some residents of the town, Umm Ruwaba, about 300 miles southwest of the capital, criticized local officials for failing to provide adequate security.', 'lead_paragraph': 'KHARTOUM, Sudan — Sudan’s government said that its troops had regained control of a town attacked by members of a rebel alliance, but some of the town’s residents lashed out at local officials for failing to provide adequate security, state media and witnesses said Sunday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sudan Says It Took Back Town Struck by Rebels', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sudan Says It Took Back Town Struck By Rebels', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Sudan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Umm Ruwaba (Sudan)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sudanese Revolutionary Front', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-28T22:40:38+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': "By Isma'il Kushkush", 'person': [{'firstname': "Isma'il", 'middlename': None, 'lastname': 'Kushkush', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2b555931-e227-5436-a41c-dcc0772818c3', 'word_count': 416, 'uri': 'nyt://article/2b555931-e227-5436-a41c-dcc0772818c3'}, {'abstract': 'A federal court ruling last week determined that licensing fees on essential communications and data-handling patents used in devices like smartphones, tablets and game consoles should be low. The opinion, legal experts say, may help blunt the use of so-called standard-essential patents as weapons.', 'web_url': 'https://bits.blogs.nytimes.com/2013/04/28/court-ruling-takes-a-stand-on-essential-high-tech-patents/', 'snippet': 'A federal court ruling last week determined that licensing fees on essential communications and data-handling patents used in devices like smartphones, tablets and game consoles should be low. The opinion, legal experts say, may help blunt the use...', 'lead_paragraph': 'The high-tech patents wars are fed by the value of patents as weapons for extracting rich sums from companies and competitors.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/technology/bits-court/bits-court-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/28/technology/bits-court/bits-court-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/technology/bits-court/bits-court-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/technology/bits-court/bits-court-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/technology/bits-court/bits-court-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thum