/us/CONSERVATIVE/CONSERVATIVE-superJumbo.jpg', 'height': 1555, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/us/CONSERVATIVE/CONSERVATIVE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/10/us/CONSERVATIVE/CONSERVATIVE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/10/us/CONSERVATIVE/CONSERVATIVE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lobbyists Fighting Spending Cuts Find Ally in Group That Often Backs Them', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lobbyists Fighting Spending Cuts Find Ally in Group That Often Backs Them', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Confessore, Nicholas', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN CONSERVATIVE UNION', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Lobbying and Lobbyists', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-09T14:44:24+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/16438030-f41a-57ce-b509-1ddb73e7b157', 'word_count': 1151, 'uri': 'nyt://article/16438030-f41a-57ce-b509-1ddb73e7b157'}, {'abstract': 'How much do you need?', 'web_url': 'https://krugman.blogs.nytimes.com/2013/04/09/doing-the-math/', 'snippet': 'How much do you need?', 'lead_paragraph': 'Wonkblog links to a lovely piece by E.O. Wilson on how much math you need to do research. Wilson’s answer is, not much; and I agree with a caveat. The caveat is this: at least in the areas I work in, you do need some mathematical intuition, even if you don’t necessarily need to know a lot of formal theorems.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Doing the Math', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-09T14:50:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e3b98f0c-cfdd-551d-aa28-d766f40260f1', 'word_count': 297, 'uri': 'nyt://article/e3b98f0c-cfdd-551d-aa28-d766f40260f1'}, {'abstract': 'On a recent chilly afternoon, we talked to a few visitors at MoMA PS1, and an employee, about how they put personal touches on their transitional spring looks.', 'web_url': 'https://runway.blogs.nytimes.com/2013/04/09/intersection-spring-style-in-long-island-city/', 'snippet': 'On a recent chilly afternoon, we talked to a few visitors at MoMA PS1, and an employee, about how they put personal touches on their transitional spring looks.', 'lead_paragraph': 'For the latest Intersection video, we went to Long Island City, Queens, and visited MoMA PS1, the contemporary art space. On a recent chilly afternoon, we talked to a few visitors and an employee about how they put personal touches on their transitional spring looks.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '[Video] Intersection: Spring Style in Long Island City', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'MoMA PS1', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Island City (Queens, NY)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Queens (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-09T15:00:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Simone S. Oliver', 'person': [{'firstname': 'Simone', 'middlename': 'S.', 'lastname': 'Oliver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1969c5fb-6709-5d9c-a88f-be2255182ea3', 'word_count': 45, 'uri': 'nyt://article/1969c5fb-6709-5d9c-a88f-be2255182ea3'}, {'abstract': 'Doom at 90, and other misconceptions.', 'web_url': 'https://krugman.blogs.nytimes.com/2013/04/09/deficit-derangement-syndrome/', 'snippet': 'Doom at 90, and other misconceptions.', 'lead_paragraph': 'This Dylan Matthews piece on the evils people perceive from deficits, and why they’re almost all wrong, is a must-read. I would quibble with a few points — in particular, it really doesn’t matter how much of our public debt foreigners own, what matters is our overall net international investment position (do we as a country owe more to foreigners than they owe to us). And I wish he’d made the no-crowding-out point in terms of the state of the economy, not just actual interest rates. But these are minor points, and the overall thrust of the piece is excellent.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Deficit Derangement Syndrome', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-09T15:13:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/78c1450b-3d59-5389-bdf0-5f3eccfbdf1c', 'word_count': 480, 'uri': 'nyt://article/78c1450b-3d59-5389-bdf0-5f3eccfbdf1c'}, {'abstract': 'A video provided by the Metropolitan Transportation Authority shows sandhogs setting off one of the last blasts under Grand Central Terminal as part of the East Side Access project.', 'web_url': 'https://cityroom.blogs.nytimes.com/2013/04/09/video-an-explosion-160-feet-below-grand-central/', 'snippet': 'A video provided by the Metropolitan Transportation Authority shows sandhogs setting off one of the last blasts under Grand Central Terminal as part of the East Side Access project.', 'lead_paragraph': 'Those who enjoy watching things blowing up (and nobody getting hurt) and men playing with toys should get a kick out of this video provided on Tuesday by the Metropolitan Transportation Authority.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video: An Explosion 160 Feet Below Grand Central', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bombs and Explosives', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Railroads', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Transit Systems', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Long Island Rail Road Co', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-09T15:23:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/01d94fac-b08d-597a-b739-ec968bba5a3f', 'word_count': 174, 'uri': 'nyt://article/01d94fac-b08d-597a-b739-ec968bba5a3f'}, {'abstract': 'The book from President Obama’s longtime strategist is due out in the fall of 2014.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/09/david-axelrod-writing-a-memoir/', 'snippet': 'The book from President Obama’s longtime strategist is due out in the fall of 2014.', 'lead_paragraph': 'David Axelrod, the political strategist behind the rise of President Obama, has signed with Penguin Press to write a memoir, the publisher said Tuesday morning. Release is slated for fall 2014.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'David Axelrod Writing a Memoir', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Axelrod, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Blagojevich, Rod R', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Edwards, John', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Penguin Group', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Chicago (Ill)', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-09T15:28:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Leslie Kaufman', 'person': [{'firstname': 'Leslie', 'middlename': None, 'lastname': 'Kaufman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7e7ea7b0-9c7f-5fa3-8c07-dc8521aecccd', 'word_count': 147, 'uri': 'nyt://article/7e7ea7b0-9c7f-5fa3-8c07-dc8521aecccd'}, {'abstract': 'Southeastern Asset management says that proposals from the Blackstone Group and Carl C. Icahn are superior to the $13.65-a-share offer from Michael S. Dell and the private equity firm Silver Lake.', 'web_url': 'https://dealbook.nytimes.com/2013/04/09/big-dell-shareholder-prefers-two-rival-bids/', 'snippet': 'Southeastern Asset management says that proposals from the Blackstone Group and Carl C. Icahn are superior to the $13.65-a-share offer from Michael S. Dell and the private equity firm Silver Lake.', 'lead_paragraph': 'One of the most vocal critics of Dell’s proposed $24.4 billion sale to its founder has clearly not been swayed by the argument for the buyout made in the company’s recent proxy statement. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Big Dell Shareholder Prefers 2 Rival Bids', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dell, Michael S', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Icahn, Carl C', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Dell Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Silver Lake Partners', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'The Blackstone Group', 'rank': 6, 'major': 'N'}], 'pub_date': '2013-04-09T15:31:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/46a123f3-dced-549d-a79d-7a8340669c51', 'word_count': 380, 'uri': 'nyt://article/46a123f3-dced-549d-a79d-7a8340669c51'}, {'abstract': 'Known as “the Jewish terrorist,” Yaakov Teitel, who lived in a West Bank settlement, was convicted of killing two Palestinians in 1997.', 'web_url': 'https://www.nytimes.com/2013/04/10/world/middleeast/2-life-terms-for-us-immigrant-to-israel.html', 'snippet': 'Known as “the Jewish terrorist,” Yaakov Teitel, who lived in a West Bank settlement, was convicted of killing two Palestinians in 1997.', 'lead_paragraph': 'JERUSALEM — A Jerusalem court on Tuesday sentenced an American immigrant convicted of killing two Palestinians in 1997 to two consecutive life terms in prison, as well as additional time for attempted murders, weapons violations and incitement to violence or terrorism. Known as “the Jewish terrorist,” Yaakov (Jack) Teitel, an extremist who lived in a West Bank settlement, was convicted of other crimes including bombings in 2008 that wounded a leftist Israeli professor and a teenage boy belonging to a community of Jews who believe in Jesus. Mr. Teitel was also ordered to pay compensation to the families of the victims.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Israeli Court Sentences U.S. Immigrant to 2 Life Terms', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Teitel, Yaakov', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-09T15:35:05+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Isabel Kershner', 'person': [{'firstname': 'Isabel', 'middlename': None, 'lastname': 'Kershner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/95a56625-4607-5bb6-a03b-b37ca0a1c3d3', 'word_count': 101, 'uri': 'nyt://article/95a56625-4607-5bb6-a03b-b37ca0a1c3d3'}, {'abstract': 'Since 2009, while Nelson L. Castro represented the West Bronx in the State Legislature, he was secretly recording and informing on his colleagues to prosecutors.', 'web_url': 'https://www.nytimes.com/2013/04/10/nyregion/assemblyman-and-informer-nelson-l-castro-led-double-life.html', 'snippet': 'Since 2009, while Nelson L. Castro represented the West Bronx in the State Legislature, he was secretly recording and informing on his colleagues to prosecutors.', 'lead_paragraph': 'On a drizzly Monday in Albany, Nelson L. Castro, in sharp red tie, rose on the floor of the State Assembly to welcome a delegation of fellow Dominican-Americans visiting from New York City. The 199th anniversary of the birth of Juan Pablo Duarte, a founding father of the Dominican Republic, was approaching, and Mr. Castro had prepared a resolution to honor him.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/nyregion/09-CASTRO-01/09-CASTRO-01-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/09/nyregion/09-CASTRO-01/09-CASTRO-01-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/nyregion/09-CASTRO-01/09-CASTRO-01-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/09/nyregion/09-CASTRO-01/09-CASTRO-01-superJumbo-v