_kicker': None, 'print_headline': 'Violence at F.A. Cup Semifinal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Millwall (Soccer Team)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Wigan Athletic (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Football Association Cup (Soccer)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-14T00:09:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/680f10cc-b400-53f6-90f4-54a488f393e8', 'word_count': 769, 'uri': 'nyt://article/680f10cc-b400-53f6-90f4-54a488f393e8'}, {'abstract': 'With Toronto and Baltimore stronger this season, the American League East, a division that for the last 12 years has been won by a team with 95 or more victories, could have a champion with only 90 wins.', 'web_url': 'https://www.nytimes.com/2013/04/14/sports/baseball/in-american-league-east-90-wins-may-be-enough.html', 'snippet': 'With Toronto and Baltimore stronger this season, the American League East, a division that for the last 12 years has been won by a team with 95 or more victories, could have a champion with only 90 wins.', 'lead_paragraph': 'The Baltimore Orioles unloaded on Phil Hughes on Saturday, hitting him so hard for three innings that Hughes said he could not remember the last time he had pitched so badly. Maybe there were better times to ask Hughes about the strength of the division, times when he could have been more objective. But his perspective seemed to sum up the new reality of the American League East.', 'print_section': 'SP', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/sports/KEPNER/KEPNER-articleLarge.jpg', 'height': 312, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/14/sports/KEPNER/KEPNER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 312}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/sports/KEPNER/KEPNER-jumbo.jpg', 'height': 533, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/sports/KEPNER/KEPNER-superJumbo.jpg', 'height': 1066, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/sports/KEPNER/KEPNER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/14/sports/KEPNER/KEPNER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/14/sports/KEPNER/KEPNER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Early Signs of Parity in A.L. East, Where 90 Wins May Be Enough', 'kicker': 'On Baseball', 'content_kicker': None, 'print_headline': 'Early Signs of Parity in A.L. East, Where 90 Wins May Be Enough', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kepner, Tyler', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN LEAGUE', 'rank': 3, 'major': 'N'}, {'name': 'organiz