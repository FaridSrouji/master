 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6e3dc23-75a1-54b7-86a9-d365ea4ed35f', 'word_count': 448, 'uri': 'nyt://article/d6e3dc23-75a1-54b7-86a9-d365ea4ed35f'}, {'abstract': 'Our account executives are really good at closing deals when they have the opportunity to meet with a company in person. How do we increase the number of in-person meetings?', 'web_url': 'https://boss.blogs.nytimes.com/2013/04/04/how-data-analysis-led-us-to-reassess-sales-and-open-a-lead-generation-center/', 'snippet': 'Our account executives are really good at closing deals when they have the opportunity to meet with a company in person. How do we increase the number of in-person meetings?', 'lead_paragraph': 'Here is a quote I love from “Good to Great,” the Jim Collins book: “But once we looked at the facts, there was really no question about what we had to do. So we just did it.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Data Analysis Led Us to Reassess Sales and Open a Lead-Generation Center', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customer Relations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Burkhart, Bryan', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Pittsburgh (Pa)', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-04T11:00:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Bryan Burkhart', 'person': [{'firstname': 'Bryan', 'middlename': None, 'lastname': 'Burkhart', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7533abae-e1d9-51e9-8b75-b1ddc5f10fb4', 'word_count': 872, 'uri': 'nyt://article/7533abae-e1d9-51e9-8b75-b1ddc5f10fb4'}, {'abstract': 'There is a very good reason to visit the obscure Black Forest Village of Baiersbronn.', 'web_url': 'https://www.nytimes.com/2013/04/07/magazine/one-tiny-german-town-seven-big-michelin-stars.html', 'snippet': 'There is a very good reason to visit the obscure Black Forest Village of Baiersbronn.', 'lead_paragraph': 'It was Saturday night at Restaurant Bareiss, an eight-table dining room in Baiersbronn, a small town in Germany’s Black Forest, and the chef, Claus-Peter Lumpp, needed seven orders of John Dory in garam masala. Three line cooks darted around him, fussing over black plates laid out on a checkered towel under a heating lamp, saucing and garnishing and somehow not running into one another. Germany was not, until very recently, known for its chefs, but it does have a well-earned reputation for quality control. Chefs used syringes to deliver pinpoint droplets of sauce and tested temperatures with yellow electric thermometers that looked like Geiger counters. The bulk of the cooking takes place on nine electric burners that were made to Lumpp’s exact specifications.', 'print_section': 'MM', 'print_page': '50', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07germany1/07germany1-articleLarge-v2.jpg', 'height': 342, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/magazine/07germany1/07germany1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 342}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07germany1/07germany1-jumbo-v2.jpg', 'height': 583, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07germany1/07germany1-superJumbo-v2.jpg', 'height': 649, 'width': 1140, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07germany1/mag-07Germany-t_CA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/07/magazine/07germany1/mag-07Germany-t_CA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07germany1/mag-07Germany-t_CA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'One Tiny German Town, Seven Big Michelin Stars', 'kicker': None, 'content_kicker': None, 'print_headline': 'One Tiny German Town, Seven Big Michelin Stars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Restaurant Bareiss (Baiersbronn, Germany)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kulish, Nicholas', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lumpp, Claus-Peter', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Baiersbronn (Germany)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wohlfahrt, Harald', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Schwarzwaldstube (Baiersbronn, Germany, Restaurant)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Hotel Bareiss (Baiersbronn, Germany)', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Hotel Traube Tonbach (Baiersbronn, Germany)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Vocational Training', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Chefs', 'rank': 12, 'major': 'N'}], 'pub_date': '2013-04-04T11:01:10+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Nicholas Kulish', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kulish', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29e460cf-51b0-5187-bd6a-3ce70f50cadf', 'word_count': 3873, 'uri': 'nyt://article/29e460cf-51b0-5187-bd6a-3ce70f50cadf'}, {'abstract': 'With a sprinkling of Lior Lev Sercarz’s pixie dust, almost anything might be edible.', 'web_url': 'https://www.nytimes.com/2013/04/07/magazine/the-spice-is-right.html', 'snippet': 'With a sprinkling of Lior Lev Sercarz’s pixie dust, almost anything might be edible.', 'lead_paragraph': 'There’s an eschatological thrill to walking into La Boîte, a shop wedged between an auto-repair garage and a dismal fenced-in garden on the far west side of Midtown Manhattan. At a cultural moment that has given us a storefront dedicated to artisanal mayonnaise, La Boîte manages to advance the genre. The shop is open to the public a total of 12 hours a week. Inside, it’s serene and nearly empty. At the entrance, a plexiglass obelisk contains a tin the size of a paperback packed with minuscule spiced biscuits (pronounced bis-KWEE; they’re cookies, and the tin costs $65). Farther in, there’s a display with numbered canisters that look as if they encase costly Japanese cosmetics but in fact contain spice blends that have been doled out with a jeweler’s parsimony. As I took in the glossy photos of pods and rhizomes lining the walls and handled the decadently cool, silvery pucks, I couldn’t help wondering whether this is what ancient Rome must have been like near the end, before the Vandals trashed Palatine Hill.', 'print_section': 'MM', 'print_page': '64', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07spice2/07spice2-articleLarge-v5.jpg', 'height': 536, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/magazine/07spice2/07spice2-articleLarge-v5.jpg', 'xlargewidth': 600, 'xlargeheight': 536}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07spice2/07spice2-jumbo-v5.jpg', 'height': 894, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07spice2/07spice2-superJumbo-v5.jpg', 'height': 894, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07spice2/07spice2-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/07/magazine/07spice2/07spice2-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/magazine/07spice2/07spice2-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Transformational Power of the Right Spice', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Spice Is Right', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Spices', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lev Sercarz, Lior', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'La Boite (Manhattan, NY)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 