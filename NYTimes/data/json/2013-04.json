eight': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Street Style: Neon', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}], 'pub_date': '2013-04-29T16:37:23+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/84686b47-5a31-5555-9dab-de1b75d287ea', 'word_count': 0, 'uri': 'nyt://slideshow/84686b47-5a31-5555-9dab-de1b75d287ea'}, {'abstract': 'The 15th-century volume of the Mishneh Torah had an estimated sale price of $4.5 million to $6 million.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/29/the-met-and-israel-museum-buy-illuminated-torah-before-its-auctioned/', 'snippet': 'The 15th-century volume of the Mishneh Torah had an estimated sale price of $4.5 million to $6 million.', 'lead_paragraph': 'A 15th-century illustrated volume of the Mishneh Torah that was to be the star of a Sotheby’s auction on Monday was withdrawn from the sale and bought jointly by the Israel Museum in Jerusalem and the Metropolitan Museum of Art. Widely considered one of the finest illuminated Hebrew manuscripts ever created, it was from the collection of the New York philanthropists Judy and Michael Steinhardt, who are selling their world-class collection of Judaica at Sotheby’s on Monday. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Met and Israel Museum Buy Illuminated Jewish Manuscript Before It’s Auctioned', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Torah', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Israel Museum', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Museum of Art', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': "Sotheby's", 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Jerusalem (Israel)', 'rank': 9, 'major': 'N'}], 'pub_date': '2013-04-29T16:41:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Carol Vogel', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Vogel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/28d55c8a-ff1e-5f80-b769-f776de617819', 'word_count': 212, 'uri': 'nyt://article/28d55c8a-ff1e-5f80-b769-f776de617819'}, {'abstract': 'The Ralph Lauren Corporation’s settlement of an investigation into foreign bribery is a powerful example of the incentive for companies to turn themselves in rather than even hint at fighting the government.', 'web_url': 'https://dealbook.nytimes.com/2013/04/29/ralph-lauren-case-shows-the-benefits-of-cooperation/', 'snippet': 'The Ralph Lauren Corporation’s settlement of an investigation into foreign bribery is a powerful example of the incentive for companies to turn themselves in rather than even hint at fighting the government.', 'lead_paragraph': 'The Ralph Lauren Corporation’s settlement of an investigation into whether it made illegal payments and gifts to foreign officials shows once again just how much a company’s cooperation can provide it with the benefit of a slap on the wrist by the government rather than the trumpeting of embarrassing details. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ralph Lauren Case Shows the Benefits of Cooperation', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-29T16:47:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter J. Henning', 'person': [{'firstname': 'Peter', 'middlename': 'J.', 'lastname': 'Henning', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/15535ef5-7fbe-5043-bb87-111ebd7aa741', 'word_count': 1079, 'uri': 'nyt://article/15535ef5-7fbe-5043-bb87-111ebd7aa741'}, {'abstract': 'The singer-songwriter’s debut album has spent 63 weeks in the British top 10, surpassing the 62-week record held by the Beatles’ debut.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/29/emeli-sand-bests-a-beatles-chart-record/', 'snippet': 'The singer-songwriter’s debut album has spent 63 weeks in the British top 10, surpassing the 62-week record held by the Beatles’ debut.', 'lead_paragraph': 'The Beatles fended off all contenders for half a century, but the Scottish singer-songwriter Emeli Sandé has toppled one of the band’s longest-standing chart records. Ms. Sandé’s debut album, “Our Version of Events,” has spent the last 63 weeks in the British top 10, surpassing the 62 consecutive weeks that the Beatles’ debut, “Please Please Me,” spent in the top 10 in 1963 and 1964.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/arts/29artsbeat-sande/29artsbeat-sande-articleLarge.jpg', 'height': 691, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/29/arts/29artsbeat-sande/29artsbeat-sande-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 691}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/arts/29artsbeat-sande/29artsbeat-sande-jumbo.jpg', 'height': 1024, 'width': 889, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/arts/29artsbeat-sande/29artsbeat-sande-superJumbo.jpg', 'height': 2000, 'width': 1736, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/arts/29artsbeat-sande/29artsbeat-sande-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/29/arts/29artsbeat-sande/29artsbeat-sande-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/arts/29artsbeat-sande/29artsbeat-sande-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Emeli Sandé Bests a Beatles Chart Record', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sande, Emeli', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Beatles, The', 'rank': 3, 'major': 'N'}], 'pub_date': '2013-04-29T16:54:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b8de204e-d89b-5da9-9957-53a78b765530', 'word_count': 286, 'uri': 'nyt://article/b8de204e-d89b-5da9-9957-53a78b765530'}, {'abstract': 'The surprising story of bondage and freedom for California’s Native Americans.', 'web_url': 'https://opinionator.blogs.nytimes.com/2013/04/29/freedom-for-californias-indians/', 'snippet': 'The surprising story of bondage and freedom for California’s Native Americans.', 'lead_paragraph': 'On April 27, 1863, nearly five months after President Abraham Lincoln issued the Emancipation Proclamation, California abolished its system of forced apprenticeship for American Indians. Under the apprenticeship provisions of the state’s Act for the Government and Protection of Indians, several thousand California Indians, mostly children, had suffered kidnapping, sale and involuntary servitude for over a decade. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Freedom for California’s Indians', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Native Americans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Slavery', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-29T16:54:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Stacey L. Smith', 'person': [{'firstname': 'Stacey', 'middlename': 'L.', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/289f92b9-ae82-5fbe-a1eb-5e0170ff60fe', 'word_count': 1448, 'uri': 'nyt://article/289f92b9-ae82-5fbe-a1eb-5e0170ff60fe'}, {'abstract': 'Creating a non-political conversation around children and gun-safety.', 'web_url': 'https://parenting.blogs.nytimes.com/2013/04/29/the-play-date-gun-debate/', 'snippet': 'Creating a non-political conversation around children and gun-safety.', 'lead_paragraph': 'Returning from a play date, my 6-year-old son tumbled through the door and announced, “Did you know so-and-so’s dad has guns?” The concept, in and of itself, wasn’t surprising. We’d recently moved to a bucolic town in northern Michigan where many families were recreational hunters. But the fact that I didn’t know any real details about the situation — whether the guns were locked away or who had access to them — suddenly made me nervous. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/style/motherlode-gun-safe-dad/motherlode-gun-safe-dad-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/29/style/motherlode-gun-safe-dad/motherlode-gun-safe-dad-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/style/motherlode-gun-safe-dad/motherlode-gun-safe-dad-jumbo.jpg', 'height': 938, 'width': 938, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/style/motherlode-gun-safe-dad/motherlode-gun-safe-dad-superJumbo.jpg', 'height': 938, 'width': 938, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/style/motherlode-gun-safe-dad/motherlode-gun-safe-dad-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/29/style/motherlode-gun-safe-dad/motherlode-gun-safe-dad-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/29/style/motherlode-gun-safe-dad/motherlode-gun-safe-dad-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Play Date Gun Debate', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}], 'pub_date': '2013-04-29T17:02:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Lisa Maxbauer', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': 'Maxbauer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1e457e84-2db4-5b20-9f8b-05a35dd67e66', 'word_count': 1130, 'uri': 'nyt://article/1e457e84-2db4-5b20-9f8b-05a35dd67e66'}, {'abstract': 'In Game 5, a must-win, the Nets found a way to outlast the Bulls, sending the series back to Chicago for Game 6 on Thursday.', 'web_url': 'https://www.nytimes.com/2013/04/30/sports/basketball/game-5-nets-bulls.html', 'snippet': 'In Game 5, a must-win, the Nets found a way to outlast the Bulls, sending the series back to Chicago for Game 6 on Thursday.', 'lead_paragraph': 'The Nets did not give the impression they were a team playing its last game of the season on Monday. They prepared as if Game 6 in Chicago was inevitable. There was no fire-and-brimstone pregame speech by a veteran teammate to rouse emotions. ', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/sports/NETS/NETS-articleLarge-v3.jpg', 'height': 482, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/30/sports/NETS/NETS-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 482}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/sports/NETS/NETS-jumbo-v3.jpg', 'height': 823, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/sports/NETS/NETS-superJumbo-v3.jpg', 'height': 1646, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/sports/NETS/NETS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/30/sports/NETS/NETS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/sports/NETS/NETS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Nets, No Overtime and No Surrender', 'kicker': 'Nets 110, Bulls 91', 'content_kicker': None, 'print_headline': 'For Nets, No Overtime and No Surrender', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Bulls', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hinrich, Kirk', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Nets', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lopez, Brook', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-29T17:25:59+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Zach Schonbrun', 'person': [{'firstname': 'Zach', 'middlename': None, 'lastname': 'Schonbrun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/204be566-b099-549a-8149-328f0e2f2dbc', 'word_count': 772, 'uri': 'nyt://article/204be566-b099-549a-8149-328f0e2f2dbc'}, {'abstract': 'As pro tennis players who rely on a one-handed backhand begin to retire, the shot seems destined for the dustbin of history.', 'web_url': 'https://straightsets.blogs.nytimes.com/2013/04/29/the-disappearing-one-handed-backhand/', 'snippet': 'As pro tennis players who rely on a one-handed backhand begin to retire, the shot seems destined for the dustbin of history.', 'lead_paragraph': 'If you simply glance at the top tier of tennis, you might think the one-handed topspin backhand is alive and very well. Roger Federer’s is especially versatile. Richard Gasquet’s is downright electric. Grigor Dimitrov’s helped him nearly upset Rafael Nadal in Monte Carlo recently.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Disappearing One-Handed Backhand', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-29T17:33:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By MARV SALTER', 'person': [{'firstname': 'Marv', 'middlename': None, 'lastname': 'SALTER', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/74754bc2-2caf-58f0-991e-f9325e1e1fc7', 'word_count': 651, 'uri': 'nyt://article/74754bc2-2caf-58f0-991e-f9325e1e1fc7'}, {'abstract': 'Based on Jason Collins’s talents on the court, and not his announcement that he is gay, what are the chances that this 34-year-old free agent will remain a professional basketball player?', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2013/04/29/jason-collins-breaks-a-barrier-but-will-he-find-another-n-b-a-job/', 'snippet': 'Based on Jason Collins’s talents on the court, and not his announcement that he is gay, what are the chances that this 34-year-old free agent will remain a professional basketball player?', 'lead_paragraph': 'Jason Collins, who played for the N.B.A.’s Boston Celtics and Washington Wizards last season, on Monday became the first active male athlete in a major American team sport to publicly announce that he is gay.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jason Collins Breaks a Barrier. But Will He Find Another N.B.A. Job?', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': 'An Aging Big Man’s Chances To Hang On', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2013-04-29T17:38:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nate Silver', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Silver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d11d787e-57f6-58f7-bdda-863467a0ed2c', 'word_count': 424, 'uri': 'nyt://article/d11d787e-57f6-58f7-bdda-863467a0ed2c'}, {'abstract': 'Will Walker, who was accepted to Williams College under a binding early decision application, felt like he “made a mistake” just before a recent campus visit.', 'web_url': 'https://thechoice.blogs.nytimes.com/2013/04/29/envelope-please-will-walker-8/', 'snippet': 'Will Walker, who was accepted to Williams College under a binding early decision application, felt like he “made a mistake” just before a recent campus visit.', 'lead_paragraph': 'While everyone else was getting their acceptance letters, learning about their aid packages, and weighing their future college options, I spent the week doing something a little different: I visited Williams College, the school I’m committed to attend for the next four years, to try to get a taste of what my future is going to look like.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-jumbo.jpg', 'height': 597, 'width': 670, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-superJumbo.jpg', 'height': 597, 'width': 670, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-will/envpls13-will-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After a College Decision, a Fear of Getting It Wrong', 'kicker': 'The Choice', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subje