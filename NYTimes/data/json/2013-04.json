-30T20:30:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Jenny Nichols', 'person': [{'firstname': 'Jenny', 'middlename': None, 'lastname': 'Nichols', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0eae7954-3f84-5171-8d3b-e5085df980e4', 'word_count': 368, 'uri': 'nyt://article/0eae7954-3f84-5171-8d3b-e5085df980e4'}, {'abstract': 'In time for outdoor dining, pizzas at the Standard; a Latin spot from Jean-Georges Vongerichten; barbecue on the High Line and more restaurant openings.', 'web_url': 'https://www.nytimes.com/2013/05/01/dining/off-the-menu-pizzas-at-the-standard-barbecue-on-the-high-line-and-more-restaurant-openings.html', 'snippet': 'In time for outdoor dining, pizzas at the Standard; a Latin spot from Jean-Georges Vongerichten; barbecue on the High Line and more restaurant openings.', 'lead_paragraph': 'Headliner ', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/dining/01OFF_SPAN/01OFF-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/05/01/dining/01OFF_SPAN/01OFF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/dining/01OFF_SPAN/01OFF-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/05/01/dining/01OFF_SPAN/01OFF-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'cre