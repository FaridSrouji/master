alifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ec631700-82a2-5a2b-b52a-b67f08779f0b', 'word_count': 183, 'uri': 'nyt://article/ec631700-82a2-5a2b-b52a-b67f08779f0b'}, {'abstract': 'An immigration reform bill, as opposed to mere talk, seems tantalizingly real.', 'web_url': 'https://www.nytimes.com/2013/04/07/opinion/sunday/finally-maybe-at-last.html', 'snippet': 'An immigration reform bill, as opposed to mere talk, seems tantalizingly real.', 'lead_paragraph': 'Look to Washington in the next week or so for the first legislative rumblings of the great battle over comprehensive immigration reform, 2013. The effort will end either in collapse and failure, followed by years of political recriminations, or, amazingly, a big fat bill.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Finally, Maybe, at Last', 'kicker': 'Editorial | Notebook', 'content_kicker': None, 'print_headline': 'Finally, Maybe, at Last', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Downes, Lawrence', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigrants', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Citizenship and Naturalization', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-06T17:26:05+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Lawrence Downes', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Downes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/6f8af4a4-1a49-5f1b-a3a8-71975dc14a06', 'word_count': 491, 'uri': 'nyt://article/6f8af4a4-1a49-5f1b-a3a8-71975dc14a06'}, {'abstract': 'It appears that cable TV may be in the early stages of a transition.', 'web_url': 'https://www.nytimes.com/2013/04/07/opinion/sunday/ready-to-cut-the-cord.html', 'snippet': 'It appears that cable TV may be in the early stages of a transition.', 'lead_paragraph': 'How easy is it to live without cable TV? I have been finding out for the last several months while staying with a friend who, like several people I know, does not subscribe to cable or satellite TV. So far, thanks to Netflix and Amazon Prime’s streaming of movies and TV shows, I haven’t missed cable TV much, except maybe the HBO show “Girls.” And when the sixth season of “Mad Men” kicks off on Sunday, I’ll keep up with the dark lives of Don Draper and company by buying the whole season on iTunes for $22.99, and watching the episodes as they become available for download each week. Come May, when I move into my own place, I’ll have to make a decision: Should I join the ranks of the so-called cord cutters, who rely solely on Netflix, iTunes and the rest of the Internet for TV (or use high-definition TV antennas to get broadcast stations)?', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/sunday-review/07editorial/07editorial-articleLarge.jpg', 'height': 487, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/07/sunday-review/07editorial/07editorial-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 487}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/sunday-review/07editorial/07editorial-jumbo.jpg', 'height': 832, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/sunday-review/07editorial/07editorial-superJumbo.jpg', 'height': 1664, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/sunday-review/07editorial/07editorial-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/07/sunday-review/07editorial/07editorial-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/07/sunday-review/07editorial/07editorial-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ready to Cut the Cord?', 'kicker': 'Editorial | Notebook', 'content_kicker': None, 'print_headline': 'Ready to Cut the Cord', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bajaj, Vikas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cable Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Behavior', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-06T17:26:23+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Vikas Bajaj', 'person': [{'firstname': 'Vikas', 'middlename': None, 'lastname': 'Bajaj', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/8d3bb410-1888-566f-a1b2-1fbad2acb19f', 'word_count': 482, 'uri': 'nyt://article/8d3bb410-1888-566f-a1b2-1fbad2acb19f'}, {'abstract': 'Ivy Leaguers don’t need advice on how to preserve their privilege.', 'web_url': 'https://www.nytimes.com/2013/04/07/opinion/sunday/douthat-the-secrets-of-princeton.html', 'snippet': 'Ivy Leaguers don’t need advice on how to preserve their privilege.', 'lead_paragraph': 'SUSAN PATTON, the Princeton alumna who became famous for her letter urging Ivy League women to use their college years to find a mate, has been denounced as a traitor to feminism, to coeducation, to the university ideal. But really she’s something much more interesting: a traitor to her class.', 'print_section': 'SR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/ross-douthat/ross-douthat-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/20