ON-obit/dog-BRANTON-obit-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 458}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/us/dog-BRANTON-obit/dog-BRANTON-obit-jumbo-v2.jpg', 'height': 781, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/us/dog-BRANTON-obit/dog-BRANTON-obit-superJumbo-v2.jpg', 'height': 1563, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/us/dog-BRANTON-obit/dog-BRANTON-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/04/28/us/dog-BRANTON-obit/dog-BRANTON-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/28/us/dog-BRANTON-obit/dog-BRANTON-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Leo Branton Jr., Activists’ Lawyer, Dies at 91', 'kicker': None, 'content_kicker': None, 'print_headline': 'Leo Branton Jr., Activists’ Lawyer, Dies at 91', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Branton, Leo Jr (1922-2013)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Yardley, William', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Legal Profession', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Davis, Angela Y', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-28T02:10:42+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.