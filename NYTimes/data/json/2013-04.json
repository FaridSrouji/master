height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Before Rewards, Demands', 'kicker': 'Critic on the Road', 'content_kicker': None, 'print_headline': 'Before Rewards, Demands', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Saison (San Francisco, Calif, Restaurant)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Skenes, Joshua', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-30T19:48:45+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'subsection_name': 'Dining & Wine', 'byline': {'original': 'By Pete Wells', 'person': [{'firstname': 'Pete', 'middlename': None, 'lastname': 'Wells', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/a32067b6-fa9c-54e4-895b-446832eb8965', 'word_count': 1517, 'uri': 'nyt://article/a32067b6-fa9c-54e4-895b-446832eb8965'}, {'abstract': 'The coverage of the Boston Marathon bombings increased average total viewership of CNN in April by 80 percent compared with last April.', 'web_url': 'https://www.nytimes.com/2013/05/01/business/media/cnn-gets-a-ratings-boost-from-boston.html', 'snippet': 'The coverage of the Boston Marathon bombings increased average total viewership of CNN in April by 80 percent compared with last April.', 'lead_paragraph': 'Breaking news is always good news for CNN, and April’s ratings are the latest example.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In a Newsy Month, CNN Gets a Big Bounce, Fox News a Little Bounce and MSNBC a Drop', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ratings (Audience Measurement)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'MSNBC', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'CNN', 'rank': 5, 'major': 'N'}], 'pub_date': '2013-04-30T19:49:05+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Bill Carter', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Carter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10cca535-d0c3-5e73-93d4-01d47c2ef0c9', 'word_count': 325, 'uri': 'nyt://article/10cca535-d0c3-5e73-93d4-01d47c2ef0c9'}, {'abstract': 'By tying up the White House with short-term matters, Congress is making it impossible to discuss the big issues that will determine the country’s economic prospects.', 'web_url': 'https://takingnote.blogs.nytimes.com/2013/04/30/missing-the-big-picture/', 'snippet': 'By tying up the White House with short-term matters, Congress is making it impossible to discuss the big issues that will determine the country’s economic prospects.', 'lead_paragraph': 'President Obama used the better part of a rare news conference this morning to explain why Congress bears much of the responsibility for three of his most prominent failures: the pain of the sequester, the inability to close Guantánamo, and the problems implementing health-care reform. There’s no doubt that he’s right, particularly on the first two, but the questions and answers this morning missed the big picture: By tying up the White House with short-term matters like these, Republicans and many Democrats in Congress are making it impossible to even discuss the overriding issues that will determine the country’s economic prospects.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Missing the Big Picture', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Infrastructure (Public Works)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}], 'pub_date': '2013-04-30T19:49:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Firestone', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Firestone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c5d7a496-0dbb-5b02-85d6-4ffe025cb92f', 'word_count': 604, 'uri': 'nyt://article/c5d7a496-0dbb-5b02-85d6-4ffe025cb92f'}, {'abstract': 'Richard Ford and James Salter appeared at the 92nd Street Y on Monday, where Mr. Ford read from a new story starring his iconic character Frank Bascombe.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2013/04/30/an-evening-with-salter-ford-and-bascombe/', 'snippet': 'Richard Ford and James Salter appeared at the 92nd Street Y on Monday, where Mr. Ford read from a new story starring his iconic character Frank Bascombe.', 'lead_paragraph': 'The acclaimed novelists Richard Ford and James Salter shared the stage at the 92nd Street Y on Monday night, accompanied by a surprise guest —Frank Bascombe.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/30/books/30salter-ford/30salter-ford-articleLarge-v2.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/30/books/30salter-ford/30salter-ford-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', '