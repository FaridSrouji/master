ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d04f685-24f9-5cae-bade-839b8125d424', 'word_count': 1178, 'uri': 'nyt://article/5d04f685-24f9-5cae-bade-839b8125d424'}, {'abstract': 'Harold Guskin’s “Down the Shore” centers on an amusement park worker, the woman he loves, and the man who married her.', 'web_url': 'https://www.nytimes.com/2013/04/05/movies/down-the-shore-with-james-gandolfini-and-famke-janssen.html', 'snippet': 'Harold Guskin’s “Down the Shore” centers on an amusement park worker, the woman he loves, and the man who married her.', 'lead_paragraph': '“Down the Shore,” a delicate drama set on the New Jersey coast, would be rewarding just for the fine performances from a cast led by James Gandolfini and Famke Janssen. But recent history has given it an extra layer of poignancy that the filmmakers never intended.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/arts/05RDP_DOWN_SPAN/05RDP_DOWN_SPAN-articleLarge-v2.jpg', 'height': 449, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/05/arts/05RDP_DOWN_SPAN/05RDP_DOWN_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 449}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/arts/05RDP_DOWN_SPAN/05RDP_DOWN_SPAN-jumbo-v2.jpg', 'height': 766, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/05/arts/05RDP_DOWN_SPAN/05RDP_DOWN_SPAN-superJumbo-v2.jpg', 'height': 1496, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit':