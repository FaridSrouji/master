 'value': 'Staal, Marc', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sutter, Brent', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sutter, Ron', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Carolina Hurricanes', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Hockey League', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 7, 'major': 'N'}], 'pub_date': '2013-04-24T21:07:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9719b1cd-aba0-53ec-b2ce-cf23e8cd017e', 'word_count': 296, 'uri': 'nyt://article/9719b1cd-aba0-53ec-b2ce-cf23e8cd017e'}, {'abstract': 'When faced with unfamiliar words, smartphone and tablet users can look them up in a variety of dictionary apps.', 'web_url': 'https://www.nytimes.com/2013/04/25/technology/personaltech/dictionary-apps-for-smartphones-and-tablets.html', 'snippet': 'When faced with unfamiliar words, smartphone and tablet users can look them up in a variety of dictionary apps.', 'lead_paragraph': 'Philtrum. Salubriousness. Thaumaturge. These are three of my favorite words, but they’re not common ones. So you may be reaching for a dictionary right now. ', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/04/25/business/SMART1/SMART1-articleLarge.jpg', 'height': 1051, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/04/25/business/SMART1/SMART1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1051}}, {'rank': 0, 'sub