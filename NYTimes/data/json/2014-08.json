': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'AT&T Inc', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'DirecTV', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'RFD-TV (TV Network)', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Rural Areas', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-08-23T21:45:12+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Emily Steel', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': 'Steel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8a683c8d-2295-5693-9adb-d46b29b3bd31', 'word_count': 1196, 'uri': 'nyt://article/8a683c8d-2295-5693-9adb-d46b29b3bd31'}, {'abstract': 'Thank goodness. After the Saturday madness, a Patrick Berry puzzle that makes sense.', 'web_url': 'https://wordplay.blogs.nytimes.com/2014/08/23/second-shift/', 'snippet': 'Thank goodness. After the Saturday madness, a Patrick Berry puzzle that makes sense.', 'lead_paragraph': 'SUNDAY’S PUZZLE — I don’t know about you, but it was a huge relief to do Patrick Berry’s puzzle after the Saturday puzzle where I thought I was losing my mind. I feel like I have my sanity back and all is right with the world. Heaven knows what Will Shortz and his constructing cabal have in store for us next week.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Second Shift', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-08-23T22:00:40+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastnam