': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-WIndolf/0803-bks-WIndolf-articleLarge.jpg', 'height': 767, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/books/review/0803-bks-WIndolf/0803-bks-WIndolf-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 767}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-WIndolf/0803-bks-WIndolf-jumbo.jpg', 'height': 1024, 'width': 802, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-WIndolf/0803-bks-WIndolf-superJumbo.jpg', 'height': 1800, 'width': 1409, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-WIndolf/0803-bks-WIndolf-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/books/review/0803-bks-WIndolf/0803-bks-WIndolf-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-WIndolf/0803-bks-WIndolf-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nowhere to Run', 'kicker': None, 'content_kicker': None, 'print_headline': 'Nowhere to Run', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rachman, Tom', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Windolf, Jim', 'rank': 2, 'majo