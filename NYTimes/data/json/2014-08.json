umbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/05/business/dbpix-hsbc2/dbpix-hsbc2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/05/business/dbpix-hsbc2/dbpix-hsbc2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/05/business/dbpix-hsbc2/dbpix-hsbc2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Profits Decrease at HSBC as Business in Asia Slows', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Profits Decrease at HSBC as Business in Asia Slows', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Company Reports', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Flint, Douglas', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Osborne, George', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'HSBC Holdings PLC.', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Far East, South and Southeast Asia and Pacific Areas', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-08-04T10:04:51+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Chad Bray', 'person': [{'firstname': 'Chad', 'middlename': None, 'lastname': 'Bray', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/07f61442-5fb9-5dfd-a5e6-61095d9939a7', 'word_count': 574, 'uri': 'nyt://article/07f61442-5fb9-5dfd-a5e6-61095d9939a7'}, {'abstract': 'Opinions on family super PACs, fast-food employee fairness, climate reality and a failed state in Libya.', 'web_url': 'https://op-talk.blogs.nytimes.com/2014/08/04/morning-views-50/', 'snippet': 'Opinions on family super PACs, fast-food employee fairness, climate reality and a failed state in Libya.', 'lead_paragraph': '“Attention, parents of political candidates. There is now a way to spend an unlimited amount on your child’s campaign for Congress, completely ignoring that annoying $2,600 legal limit on what you can give,”\xa0says an editorial in The New York Times. “All you do is set up a ‘super PAC’ for your kid and start writing checks. It’s not much harder than that 529 account you used for the same kid’s college education.” This is apparently what Martine Rothblatt, the founder of Sirius Satellite Radio, did for her son, Gariel Rothblatt, who is running for a Florida congressional seat. A group calling itself\xa0Space PAC,\xa0in promoting Mr. Rothblatt’s campaign, “has raised $225,000, all of it from Martine Rothblatt.” The Times says, “family-financed super PACs are only the latest and most outrageous examples of how super PACs are used in this campaign cycle to evade the limits on donations.” Congress should\xa0pass the\xa0Empowering Citizens Act, “a bill introduced in the House that would put strict limits on these kinds of coordinated contributions. But the more members of Congress depend on these groups, the less chance they will want to put a stop to them.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Views', 'kicker': 'Op-Talk', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-04T10:40:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jake Flanagin', 'person': [{'firstname': 'Jake', 'middlename': None, 'lastname': 'Flanagin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a2c6dd2c-9c94-54c1-879a-563b5aab2c43', 'word_count': 684, 'uri': 'nyt://article/a2c6dd2c-9c94-54c1-879a-563b5aab2c43'}, {'abstract': 'A vote to effectively end a program for undocumented children is unlikely to hurt the G.O.P. in midterm elections because Hispanic voters are underrepresented in close races.', 'web_url': 'https://www.nytimes.com/2014/08/05/upshot/why-house-republicans-feel-safe-ignoring-hispanics.html', 'snippet': 'A vote to effectively end a program for undocumented children is unlikely to hurt the G.O.P. in midterm elections because Hispanic voters are underrepresented in close races.', 'lead_paragraph': 'Republican hopes for attracting more Hispanic voters suffered another setback on Friday when the House passed a bill to effectively end President Obama’s program to defer deportations of undocumented children. Yet the vote is unlikely to deal a severe blow to the party’s chances in November’s midterm elections. Hispanic voters may be flexing their growing political muscles in presidential elections, but they have far less sway over the composition of the House or the Senate, particularly in 2014.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/upshot/04up-hispanic/04up-hispanic-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/04/upshot/04up-hispanic/04up-hispanic-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'ima