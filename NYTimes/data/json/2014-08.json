 carbon fiber called Hypetex.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/garden/07FURNITURE/0807CURRENTS6-articleLarge.jpg', 'height': 288, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/07/garden/07FURNITURE/0807CURRENTS6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 288}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/garden/07FURNITURE/0807CURRENTS6-jumbo.jpg', 'height': 492, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/garden/07FURNITURE/0807CURRENTS6-superJumbo.jpg', 'height': 983, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/garden/07FURNITURE/0807CURRENTS6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/07/garden/07FURNITURE/0807CURRENTS6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/garden/07FURNITURE/0807CURRENTS6-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lightweight Lounging on Racecar Technology', 'kicker': 'Currents: Furniture', 'content_kicker': None, 'print_headline': 'Lightweight Lounging on Racecar Technology', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chairs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and