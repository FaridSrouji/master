k': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-08-22T17:40:48+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Katherine Bouton', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Bouton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/59247b14-bc86-58dc-8f28-2f2059645e88', 'word_count': 590, 'uri': 'nyt://article/59247b14-bc86-58dc-8f28-2f2059645e88'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2014/08/24/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'THE RESIDUE YEARS,  by Mitchell S. Jackson. (Bloomsbury, $17.) Told in chapters that alternate between mother and son, Jackson’s raw, autobiographical novel describes a black family in Portland, Ore., struggling with the cycles of poverty and addiction. Grace, just out of rehab, is determined to get her kids back. Her eldest, Champ, is in college but deals crack, convinced it’s the only way to achieve his dream.', 'print_section': 'BR', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paperback Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-08-22T17:40:49+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/6e8ead51-08fd-5cc8-bea0-0daf9bdf6344', 'word_count': 478, 'uri': 'nyt://article/6e8ead51-08fd-5cc8-bea0-0daf9bdf6344'}, {'abstract': 'A professor surveys youth uprisings in the Middle East.', 'web_url': 'https://www.nytimes.com/2014/08/24/books/review/the-new-arabs-by-juan-cole.html', 'snippet': 'A professor surveys youth uprisings in the Middle East.', 'lead_paragraph': 'It isn’t easy to track down a positive word about the Middle East these days. Then again, Juan Cole is not your typical observer. A professor of history at the University of Michigan, he is also a prolific and popular blogger on current affairs. An American, he spent part of his childhood in France and Ethiopia. A left-leaning idealist, he comes across as far more optimistic than the dour Occupy crowd. A cosmopolitan in constant touch with 20-somethings, he seems to be addressing boomers in his latest book, “The New Arabs,” which is replete with explanations that digital natives would never need. (Don’t know what the “meatspace” is? Read on.)', 'print_section': 'BR', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/review/24MANJI/24MANJI-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/books/review/24MANJI/24MANJI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/review/24MANJI/24MANJI-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/review/24MANJI/24MANJI-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 