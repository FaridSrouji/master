: 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/review/24KATZSUB/0824-bks-KATZ-sub-superJumbo.jpg', 'height': 638, 'width': 638, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/review/24KATZSUB/0824-bks-KATZ-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/24/books/review/24KATZSUB/0824-bks-KATZ-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/review/24KATZSUB/0824-bks-KATZ-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Providence', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Providence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sternlight, Judy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Brown University', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-22T17:40:44+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Amanda Katz', 'person': [{'firstname': 'Amanda', 'middlename': None, 'lastname': 'Katz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/db171c5b-7a78-5c4c-81a6-6798cc29c779', 'word_count': 694, 'uri': 'nyt://article/db171c5b-7a78-5c4c-81a6-6798cc29c779'}, {'abstract': 'Dana Goldstein surveys the history of American public education and offers suggestions for its reform.', 'web_url': 'https://www.nytimes.com/2014/08/24/books/review/the-teacher-wars-by-dana-goldstein.html', 'snippet': 'Dana Goldstein surveys the history of American public education and offers suggestions for its reform.', 'lead_paragraph': 'America loves to dream an impossible dream when it comes to education. We see our public schools as the bedrock of the equal-opportunity society we wish to be, the land where a poor boy in a log cabin — or a bungalow in Honolulu — can grow up to be president. And teachers are the angel-magicians who make it all happen. ', 'print_section': 'BR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/24WALLIS/24WALLIS-articleLarge.jpg', 'height': 499, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/books/24WALLIS/24WALLIS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 499}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/24WALLIS/24WALLIS-jumbo.jpg', 'height': 851, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/24WALLIS/24WALLIS-superJumbo.jpg', 'height': 1703, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/24WALLIS/24WALLIS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/24/books/24WALLIS/24WALLIS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/24WALLIS/24WALLIS-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Progress Report', 'kicker': None, 'content_kicker': None, 'print_headline': 'Progress Report', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': "The Teacher Wars: A History of America's Most Embattled Profession (Book)", 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Goldstein, Dana', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Education', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-22T17:40:45+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Claudia Wallis', 'person': [{'firstname': 'Claudia', 'middlename': None, 'lastname': 'Wallis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2870b0cd-82f7-5c4a-a8d1-92d5f5ae345b', 'word_count': 1242, 'uri': 'nyt://article/2870b0cd-82f7-5c4a-a8d1-92d5f5ae345b'}, {'abstract': 'Recently reviewed books of particular interest.', 'web_url': 'https://www.nytimes.com/2014/08/24/books/review/editors-choice.html', 'snippet': 'Recently reviewed books of particular interest.', 'lead_paragraph': 'KILL MY MOTHER: A Graphic Novel,   written and illustrated by Jules Feiffer. (Liveright, $27.95.) The renowned cartoonist’s terrific tribute to film noir and detective fiction is also a meditation on female identity and the morality of murder.', 'print_section': 'BR', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Editors’ Choice | Recent Books of Particular Interest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-08-22T17:40:45+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/d6a3e5c2-1b95-54de-a4f4-138535fdf6a7', 'word_count': 264, 'uri': 'nyt://article/d6a3e5c2-1b95-54de-a4f4-138535fdf6a7'}, {'abstract': 'Joshua Wolf Shenk challenges the notion of the lone genius.', 'web_url': 'https://www.nytimes.com/2014/08/24/books/review/powers-of-two-by-joshua-wolf-shenk.html', 'snippet': 'Joshua Wolf Shenk challenges the notion of the lone genius.', 'lead_paragraph': 'The pair is a precious unit — private, generative, even holy. We can explore a couple’s inner workings if we have an invitation to do so. Otherwise, we must use any available external means: letters in archives, revealing anecdotes, loose-lipped quips in interviews. In order to understand creativity, we must learn from couples, Joshua Wolf Shenk argues in his new book, “Powers of Two.” Defying the myth of the lone genius, he makes the case that the chemistry of creative pairs — of people, of groups — forms the primary (albeit frequently hidden) structural basis of innovation.', 'print_section': 'BR', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/books/review/24lewis/24lewis-articleLarge.jpg', 'height': 541, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/books/review/24lewis/24lewis-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 541}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/