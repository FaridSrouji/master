, 'type': 'image', 'url': 'images/2014/08/10/arts/10BFRANK1/10BFRANK1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/10/arts/10BFRANK1/10BFRANK1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/arts/10BFRANK1/10BFRANK1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Musicians Who Are Bigheaded but Only When Onstage ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Musicians Who Are Bigheaded but Only When Onstage', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Arcade Fire (Music Group)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Beatles, The', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Frank (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-07T15:37:27+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Marc Spitz', 'person': [{'firstname': 'Marc', 'middlename': None, 'lastname': 'Spitz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6607267-4a2f-5423-9109-c282d503ffb2', 'word_count': 267, 'uri': 'nyt://article/e6607267-4a2f-5423-9109-c282d503ffb2'}, {'abstract': 'The film “Frank” is primarily inspired by Frank Sidebottom (real name: Chris Sievey), who performed in an oversize costume head.', 'web_url': 'https://www.nytimes.com/2014/08/10/movies/8216frank8217-riffs-on-the-pop-curiosity-frank-sidebottom.html', 'snippet': 'The film “Frank” is primarily inspired by Frank Sidebottom (real name: Chris Sievey), who performed in an oversize costume head.', 'lead_paragraph': 'We have grown used to verisimilitude in our musician biopics. “The Buddy Holly Story,” “Walk the Line” and “Ray,” and even those that seem a little campy today, like Oliver Stone’s “The Doors,” follow the rules: The wigs can’t be too terrible, and the facts need to be intact. The recent James Brown biopic, “Get On Up,” is similarly straightforward. Even “24 Hour Party People” playfully broke the fourth wall but treated the life and death of its most famous figure, Ian Curtis, faithfully. But what if the musician at the heart of the story was a man who wore a giant puppet head in public? ', 'print_section': 'AR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Self-Invention in a Papier-Mâché Head', 'kicker': None, 'content_kicker': None, 'print_headline': 'Self-Invention in a Papier-Mâché Head', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Abrahamson, Lenny', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fassbender, Michael', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Frank (Movie)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-07T15:38:17+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Marc Spitz', 'person': [{'firstname': 'Marc', 'middlename': None, 'lastname': 'Spitz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/77e080d1-7515-504a-9c5e-0f5a6bc5b53e', 'word_count': 1303, 'uri': 'nyt://article/77e080d1-7515-504a-9c5e-0f5a6bc5b53e'}, {'abstract': 'Ann Coulter has no sympathy for Kent Brantley, the American doctor who contracted Ebola in Liberia.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/08/07/no-comment-necessary-blaming-the-ebola-victim/', 'snippet': 'Ann Coulter has no sympathy for Kent Brantley, the American doctor who contracted Ebola in Liberia.', 'lead_paragraph': 'Ann Coulter, the conservative firebrand, expressed little sympathy for the American doctor, Kent Brantley, who contracted Ebola in Liberia and was transported back to the United States on Saturday for treatment.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Comment Necessary: Blaming the Ebola Victim', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ebola Virus', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Coulter, Ann', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Liberia', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-08-07T15:41:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65074094-a2d6-5109-93a8-21082ed78f66', 'word_count': 128, 'uri': 'nyt://article/65074094-a2d6-5109-93a8-21082ed78f66'}, {'abstract': 'Anatoly G. Kucherena, the lawyer for the former American intelligence contractor Edward Snowden, said Russia has granted his client a three-year residence permit.', 'web_url': 'https://www.nytimes.com/video/world/europe/100000003044031/snowdens-lawyer-on-residence-status.html', 'snippet': 'Anatoly G. Kucherena, the lawyer for the former American intelligence contractor Edward Snowden, said Russia has granted his client a three-year residence permit.'