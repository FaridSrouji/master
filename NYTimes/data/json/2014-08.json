le': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d6c64aee-7b31-5a22-9638-d7a1d37ade91', 'word_count': 1249, 'uri': 'nyt://article/d6c64aee-7b31-5a22-9638-d7a1d37ade91'}, {'abstract': 'Can an old house really be energy efficient? Polly Guth is determined to prove it can, if it’s the last thing she does. ', 'web_url': 'https://www.nytimes.com/2014/08/07/garden/greening-the-gilded-age.html', 'snippet': 'Can an old house really be energy efficient? Polly Guth is determined to prove it can, if it’s the last thing she does. ', 'lead_paragraph': 'DUBLIN, N.H. — It was a gray and cloudy morning, and the fog was rolling across the grounds of Stonlea (pronounced stone-LEE), a sprawling Gilded Age estate here on a hill overlooking Dublin Lake, with a view, on most days, of Mount Monadnock. Polly Guth, the 87-year-old owner, was leading a visitor on a house tour that featured lots of the expected Gilded Age-y things.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Greening the Gilded Age', 'kicker': 'House Proud', 'content_kicker': None, 'print_headline': 'Greening the Gilded Age', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restoration and Renovation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New Hampshire', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Solar Energy', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-08-06T23:18:43+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Steven Kurutz', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Kurutz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/43e55e87-95eb-515a-8095-ac8367d6fb4d', 'word_count': 1880, 'uri': 'nyt://article/43e55e87-95eb-515a-8095-ac8367d6fb4d'}, {'abstract': 'Two cities now know what it’s like when the taps are shut off.', 'web_url': 'https://www.nytimes.com/2014/08/07/opinion/the-threats-to-our-drinking-water.html', 'snippet': 'Two cities now know what it’s like when the taps are shut off.', 'lead_paragraph': 'SAN FRANCISCO — THOSE of us who live in the United States are fortunate; generally we don’t have to give a lot of thought to the safety of our tap water. This makes our collective experience with water very different from that of hundreds of millions of people across the globe who lack access to clean water.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/opinion/0807OPEDfreshwater/0807OPEDfreshwater-articleLarge.jpg', 'height': 928, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/07/opinion/0807OPEDfreshwater/0807OPEDfreshwater-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 928}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/opinion/0807OPEDfreshwater/0807OPEDfreshwater-jumbo.jpg', 'height': 1024, 'width': 663, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/opinion/0807OPEDfreshwater/0807OPEDfreshwater-superJumbo.jpg', 'height': 2048, 'width': 1325, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtyp