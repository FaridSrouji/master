usiness', 'byline': {'original': 'By Danny Hakim', 'person': [{'firstname': 'Danny', 'middlename': None, 'lastname': 'Hakim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d45b6e4-6dc4-58dd-ae2c-499acb695898', 'word_count': 1634, 'uri': 'nyt://article/1d45b6e4-6dc4-58dd-ae2c-499acb695898'}, {'abstract': 'The American wife of Ivan Y. Pavlov, a human rights lawyer in St. Petersburg, was called a “threat to national security” by Russian authorities.', 'web_url': 'https://www.nytimes.com/2014/08/06/world/europe/russia-moves-to-deport-wife-of-an-activist.html', 'snippet': 'The American wife of Ivan Y. Pavlov, a human rights lawyer in St. Petersburg, was called a “threat to national security” by Russian authorities.', 'lead_paragraph': 'MOSCOW — Russia’s Federal Migration Service moved to deport the American wife of a high-profile human rights lawyer living in St. Petersburg on Tuesday, labeling her “a threat to national security.”', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Russia Moves to Deport Wife of an Activist', 'kicker': None, 'content_kicker': None, 'print_headline': 'Russia Moves to Deport Wife of an Activist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deportation', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pavlov, Ivan Y', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gaspar, Jennifer', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Hermitage Museum (Saint Petersburg, Russia)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'St Petersburg (Russia)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-08-05T23:58:16+0000', 'document