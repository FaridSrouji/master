: 'glocations', 'value': 'Chicago (Ill)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Morristown (NJ)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Newark (NJ)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-19T21:00:24+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Elaine Glusac', 'person': [{'firstname': 'Elaine', 'middlename': None, 'lastname': 'Glusac', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac843381-624d-5414-a287-d68277f55032', 'word_count': 201, 'uri': 'nyt://article/ac843381-624d-5414-a287-d68277f55032'}, {'abstract': 'Alice Könitz won the top prize in the Hammer Museum’s “Made in L.A.” biennial for her collaborative Los Angeles Museum of Art.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/08/19/hammer-museum-announces-three-biennial-prizes/', 'snippet': 'Alice Könitz won the top prize in the Hammer Museum’s “Made in L.A.” biennial for her collaborative Los Angeles Museum of Art.', 'lead_paragraph': 'The Los Angeles Museum of Art is the important-sounding, official-seeming name that the artist Alice Könitz gives to her rather homegrown collaborative and curatorial efforts, which typically take the form of displaying others’ artworks on a mobile wooden platform. Now, it’s also the big winner of the Hammer Museum prizes given to artists in its “Made in L.A.” biennial, which runs through Sept. 7. Ms. Könitz’s enterprise has received the $100,000 Mohn Award, named after Jarl Mohn, the art collector (and chief executive of National Public Radio) who sponsored the prize.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hammer Museum Announces Three Biennial Prizes', 'kicker': 'ArtsBeat', 'content_kicker':