bject', 'value': 'Black People', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Michael (1996-2014)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-19T21:04:54+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Alan Blinder and Marc Santora', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Blinder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Marc', 'middlename': None, 'lastname': 'Santora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7611f16c-464d-5b6b-89db-ed1b6d00d527', 'word_count': 462, 'uri': 'nyt://article/7611f16c-464d-5b6b-89db-ed1b6d00d527'}, {'abstract': 'The Times’s foreign editor, Joseph Kahn, responded to reader complaints.', 'web_url': 'https://publiceditor.blogs.nytimes.com/2014/08/19/why-the-times-didnt-cover-an-amnesty-international-report-on-torture/', 'snippet': 'The Times’s foreign editor, Joseph Kahn, responded to reader complaints.', 'lead_paragraph': ' Many readers have written to me in recent days, protesting that The Times did not cover a new report from Amnesty International about charges of United States torture and another human rights abuses in Afghanistan. That report was covered in other publications, including The Washington Post, The Los Angeles Times and The Daily Beast.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Why The Times Didn’t Cover an Amnesty International Report on Torture', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Torture', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baquet, Dean', 'rank': 2,