-slide-B591/02fantasy-football-photos-slide-B591-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/02/sports/football/02fantasy-football-photos-slide-B591/02fantasy-football-photos-slide-B591-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/02/sports/football/02fantasy-football-photos-slide-B591/02fantasy-football-photos-slide-B591-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/02/sports/football/02fantasy-football-photos-slide-B591/02fantasy-football-photos-slide-B591-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/02/sports/football/02fantasy-football-photos-slide-B591/02fantasy-football-photos-slide-B591-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Top 15 Fantasy Football Running Backs', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fantasy Sports', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Charles, Jamaal', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Foster, Arian', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'McCoy, LeSean', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-01T18:23:29+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/48cf48bd-80fb-5501-95b0-513019e6c046', 'word_count': 0, 'uri': 'nyt://slideshow/48cf48bd-80fb-5501-95b0-513019e6c046'}, {'abstract': 'It’s how you navigate a tricky running back field that will most likely determine the true strength of your fantasy team in 2014.', 'web_url': 'https://www.nytimes.com/2014/08/02/sports/football/fantasy-football-running-back-primer.html', 'snippet': 'It’s how you navigate a tricky running back field that will most likely determine the true strength of your fantasy team in 2014.', 'lead_paragraph': 'Along with a pass-happy mentality, a “running back by committee” approach has become the norm for N.F.L. offenses in recent years. This has made the most coveted of all positions that much harder to plan for on draft day. Last season, we had to endure nine running back busts among the first 20 taken, based on their Average Draft Position. That is a 20 percent increase from a rate of just 25 percent in 2012. As a result, more owners are de-emphasizing the running back position in favor of top-tier receivers and quarterbacks in the early rounds.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fantasy Football: Running Back Primer', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fantasy Sports', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ball, Montee', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Charles, Jamaal', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Forte, Matthew G', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Foster, Arian', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lacy, Eddie', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lynch, Marshawn', 'rank': 8, 'major': 'N'}, {'name': 