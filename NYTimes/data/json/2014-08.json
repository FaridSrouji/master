e': 'subject', 'value': 'Yazidi (Religious Sect)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': "Kurdistan Workers' Party", 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Atta, Qassim', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Sinjar (Iraq)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-08-04T19:37:25+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Tim Arango', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Arango', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da7ea5ca-50d5-5e68-99cb-b79b6c3f30fd', 'word_count': 842, 'uri': 'nyt://article/da7ea5ca-50d5-5e68-99cb-b79b6c3f30fd'}, {'abstract': 'Highlights from the International Herald Tribune archives: Two U.S. warships have come under fire in Vietnam in 1964.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/08/04/1964-attack-in-the-gulf-of-tonkin/', 'snippet': 'Highlights from the International Herald Tribune archives: Two U.S. warships have come under fire in Vietnam in 1964.', 'lead_paragraph': 'WASHINGTON — North Vietnamese PT boats tonight [Aug. 4] made a ‘‘deliberate attack’’ on the U.S. destroyers Maddox and C. Turner Joy in the Gulf of Tonkin and two Communist vessels were believed sunk, the Defense Department announced. The department said the attack, involving six to ten PT boats, took place in the same general area where the Maddox’s guns drove off an attack on Sunday. The announcement of the new attack was made shortly after President Johnson had summoned congressional leaders to the White House to brief them on the turn of events in Southeast Asia.\xa0—\xa0New York Herald Tribune, 