type': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE7/24GUIDE7-articleLarge-v2.jpg', 'height': 359, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/arts/24GUIDE7/24GUIDE7-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 359}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE7/24GUIDE7-jumbo-v2.jpg', 'height': 613, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE7/24GUIDE7-superJumbo-v2.jpg', 'height': 1226, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE7/24GUIDE7-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/24/arts/24GUIDE7/24GUIDE7-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE7/24GUIDE7-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Photographer’s Portrait', 'kicker': 'The Week Ahead | Television', 'content_kicker': None, 'print_headline': 'Photographer’s Portrait', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lange, Dorothea', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-08-22T16:19:37+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92af00f2-356f-5289-89ec-546e6f34b7cd', 'word_count': 183, 'uri': 'nyt://article/92af00f2-356f-5289-89ec-546e6f34b7cd'}, {'abstract': 'Taka Kigawa, a gifted and daring pianist, will take on the music of Pierre Boulez, the doyen of complexity and kaleidoscopic colors.', 'web_url': 'https://www.nytimes.com/2014/08/24/arts/music/taka-kigawa-tackles-pierre-boulezs-repertoire.html', 'snippet': 'Taka Kigawa, a gifted and daring pianist, will take on the music of Pierre Boulez, the doyen of complexity and kaleidoscopic colors.', 'lead_paragraph': 'If anything can cut through the late-August humidity, it’s the bracing music of Pierre Boulez, the doyen of complexity and kaleidoscopic colors. Taka Kigawa, a gifted and daring pianist who specializes in 20th-century and contemporary music, takes on not just some Boulez, but all Boulez: the complete solo piano works, at least, which stretch from the 1940s to the past decade. The program on Monday will include “12 Notations,” “Incises,” “Une Page d’Éphéméride” and all three sonatas, including the fearsomely difficult second, from the late ’40s, with which the pugnacious Mr. Boulez, now 89, aimed to destroy the traditional sonata form. “Sigle,” a rarely performed fragment associated with the third, will be a treat for completists. (7:30 p.m., Le Poisson Rouge, 158 Bleecker Street, near Thompson Street, Greenwich Village; 212-505-3474, lepoissonrouge.com.)', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE1/24GUIDE1-articleLarge.jpg', 'height': 1257, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/arts/24GUIDE1/24GUIDE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1257}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE1/24GUIDE1-jumbo.jpg', 'height': 1024, 'width': 489, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE1/24GUIDE1-superJumbo.jpg', 'height': 2048, 'width': 978, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE1/24GUIDE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/24/arts/24GUIDE1/24GUIDE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24GUIDE1/24GUIDE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Night Packed With Boulez', 'kicker': 'The Week Ahead | Classical', 'content_kicker': None, 'print_headline': 'A Night Packed With Boulez', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kigawa, Taka', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Boulez, Pierre', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Le Poisson Rouge', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Pianos', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-22T16:19:42+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/303b6970-ae69-568b-a64d-795f81a37394', 'word_count': 131, 'uri': 'nyt://article/303b6970-ae69-568b-a64d-795f81a37394'}, {'abstract': 'Adrien Brody discusses his new mini-series, “Houdini,” and his choice of roles.', 'web_url': 'https://www.nytimes.com/2014/08/24/arts/television/adrien-brody-prepares-houdini-mini-series.html', 'snippet': 'Adrien Brody discusses his new mini-series, “Houdini,” and his choice of roles.', 'lead_paragraph': 'WEST HOLLYWOOD, Calif. — It’s not because the guy needs an acting coach. He can be mesmerizing on screen and has an Oscar to prove it. His work ethic is most definitely not the reason. He starved himself for one part, gained 25 pounds for another and has gone to other extremes — wetting his pants, for instance — when a role has required it.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24BRODY1/24BRODY-articleLarge.jpg', 'height': 414, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/arts/24BRODY1/24BRODY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 414}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24BRODY1/24BRODY-jumbo.jpg', 'height': 706, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/arts/24BRODY1/24BRODY-superJumbo.jpg', 'height': 1412, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'typ