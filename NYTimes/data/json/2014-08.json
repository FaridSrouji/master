lead_paragraph': 'As the war in Gaza appears to wind down, readers are responding to Times columns about the self-perpetuating nature of armed conflict, the ethics of the United States’ position toward the Israeli offensive, and the suffering of the victims of war.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Readers Respond to Friedman and Saif on the Gaza Conflict', 'kicker': 'Op-Talk', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Hamas', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Gaza Strip', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-07T20:46:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Marie Tessier', 'person': [{'firstname': 'Marie', 'middlename': None, 'lastname': 'Tessier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2ca48c38-991b-5225-92e6-a8eff6b27b07', 'word_count': 654, 'uri': 'nyt://article/2ca48c38-991b-5225-92e6-a8eff6b27b07'}, {'abstract': 'Your nightly briefing is ready for you.', 'web_url': 'https://www.nytimes.com/2014/08/07/us/your-evening-briefing.html', 'snippet': 'Your nightly briefing is ready for you.', 'lead_paragraph': 'Here’s what you need to know from NYT Now:', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/business/07nytnow-iraq7/07nytnow-iraq7-articleLarge.jpg', 'height': 375, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/07/business/07ny