: 'image', 'url': 'images/2014/08/03/world/03nepal1/03nepal1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/world/03nepal1/03nepal1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/world/03nepal1/03nepal1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Landslide in Nepal Kills at Least 8; Hundreds Are Missing ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Landslide in Nepal Kills at Least 8; Hundreds Are Missing ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Landslides and Mudslides', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Nepal', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-08-02T11:03:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Bhadra Sharma and Gardiner Harris', 'person': [{'firstname': 'Bhadra', 'middlename': None, 'lastname': 'Sharma', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Gardiner', 'middlename': None, 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f8e38b89-9d4f-5c3a-ba0f-00de59091de7', 'word_count': 287, 'uri': 'nyt://article/f8e38b89-9d4f-5c3a-ba0f-00de59091de7'}, {'abstract': 'Yes, the right is anti-science.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/08/02/anti-intellectualism-that-dares-not-speak-its-name/', 'snippet': 'Yes, the right is anti-science.', 'lead_paragraph': 'The right-wing attack on Neil deGrasse Tyson — which has reached a sort of apogee in the National Review cover story — is notable for a number of reasons. What’s especially interesting, as I see it, is the attempt to have it both ways. On one side, there’s the sneering disapproval of anyone who tries to bring facts and evidence into political debate — you think you’re so smart, huh? At the same time, there’s the claim that liberal “experts” are poseurs, not real experts. Hey, we’re not anti-science, not us!', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Anti-Intellectualism That Dares Not Speak Its Name', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-02T13:16:32+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6a01d400-aeac-5c17-9eb7-d17dbfe75724', 'word_count': 247, 'uri': 'nyt://article/6a01d400-aeac-5c17-9eb7-d17dbfe75724'}, {'abstract': 'Highlights from the International Herald Tribune archives: Last fashion supplement in 1914.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/08/02/1914-last-fashion-supplement/', 'snippet': 'Highlights from the International Herald Tribune archives: Last fashion supplement in 1914.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/02/blogs/02iht-retrospective-fashion/02iht-retrospective-fashion-jumbo-v2.png', 'height': 884, 'width': 589, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/02/blogs/02iht-retrospective-fashion/02iht-retros