, 'legacy': {'thumbnail': 'images/2014/08/19/nyregion/MINORweb/MINORweb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/19/nyregion/MINORweb/MINORweb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Man Who Helped Long Island Counselor to Kill Himself Makes Plea Deal, Lawyer Says ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Man Who Helped Long Island Counselor to Kill Himself Makes Plea Deal, Lawyer Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Minor, Kenneth', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Locker, Jeffrey', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Euthanasia and Assisted Suicide', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-08-18T21:54:35+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/427c4dd3-dd6b-536e-8e54-29cf1ef47b51', 'word_count': 456, 'uri': 'nyt://article/427c4dd3-dd6b-536e-8e54-29cf1ef47b51'}, {'abstract': 'Despite recent sharp criticism and a $650 million settlement, hundreds of thousands of consumers with atrial fibrillation continue to take the blood thinner.', 'web_url': 'https://well.blogs.nytimes.com/2014/08/18/weighing-pradaxas-risks/', 'snippet': 'Despite recent sharp criticism and a $650 million settlement, hundreds of thousands of consumers with atrial fibrillation continue to take the blood thinner.', 'lead_paragraph': 'Patients taking traditional blood thinners like warfarin must have tests every few weeks to ensure that blood levels of the drug are in an acceptable range. But 2010 brought a seemingly welcome alternative: Pradaxa.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/28/health/well_symptoms/well_symptoms-jumbo.jpg', 'height': 214, 'width': 222, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/28/health/well_symptoms/well_symptoms-superJumbo.jpg', 'height': 214, 'width': 222, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/28/health/well_symptoms/well_symptoms-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/03/28/health/well_symptoms/well_symptoms-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/03/28/health/well_symptoms/well_symptoms-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Weighing Pradaxa’s Risks', 'kicker': 'Well', 'content_kicker': None, 'print_headline': 'Weighing Pradaxa’s Risks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Clinical Trials', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'ra