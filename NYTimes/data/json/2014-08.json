r': None, 'content_kicker': None, 'print_headline': 'G.M.’s Woes Multiply as It Announces Further Recalls', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'General Motors', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobile Safety Features and Defects', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Recalls and Bans of Products', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-08T23:48:06+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Danielle Ivory', 'person': [{'firstname': 'Danielle', 'middlename': None, 'lastname': 'Ivory', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d61497d-59c0-56dd-8501-3e5f09218722', 'word_count': 731, 'uri': 'nyt://article/5d61497d-59c0-56dd-8501-3e5f09218722'}, {'abstract': 'Chris Marker’s movies are the work of a poet and collagist and slightly obsessive philosopher.', 'web_url': 'https://www.nytimes.com/2014/08/10/movies/bamcinematek-shows-a-chris-marker-retrospective.html', 'snippet': 'Chris Marker’s movies are the work of a poet and collagist and slightly obsessive philosopher.', 'lead_paragraph': 'The French filmmaker Chris Marker (1921-2012) has been described as a cine-essayist, which is true but inadequate. His movies are the work of a poet and collagist and slightly obsessive philosopher, who roams widely but keeps looping back to a potently cinematic theme: memory. BAMcinématek’s retrospective “Chris Marker” also roams widely, providing a chance for the curious to catch up on films from his best-known works, like “La Jetée” (1962), a time-traveling meditation on war and (of course) memory, made up mostly of still photographs, to “Level Five” (1997), receiving its North American theatrical premiere in a weeklong run (Friday through Aug. 21).', 'print_section': 'AR', 'print_page':