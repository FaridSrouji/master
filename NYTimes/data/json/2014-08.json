_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0144d757-00be-57f2-81e9-6d16e0be0d57', 'word_count': 364, 'uri': 'nyt://article/0144d757-00be-57f2-81e9-6d16e0be0d57'}, {'abstract': 'An auction of items owned by Waylon Jennings include hundreds of items, including tokens from musical titans.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/08/06/at-a-waylon-jennings-sale-hanks-boots-buddys-bike-and-willies-hair/', 'snippet': 'An auction of items owned by Waylon Jennings include hundreds of items, including tokens from musical titans.', 'lead_paragraph': 'How much for a matched set of vintage Willie Nelson braids? The hammer will go down on this unusual example of pop memorabilia on Oct. 5 at the Musical Instrument Museum in Phoenix, when Guernsey’s auctions off about 2,000 items owned by the country singer Waylon Jennings, who died in 2002.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/06/arts/06artsbeat-waylon4/06artsbeat-waylon4-articleLarge.jpg', 'height': 428, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/06/arts/06artsbeat-waylon4/06artsbeat-waylon4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 428}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/06/arts/06artsbeat-waylon4/06artsbeat-waylon4-jumbo.jpg', 'height': 589, 'width': 826, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/06/arts/06artsbeat-waylon4/06artsbeat-