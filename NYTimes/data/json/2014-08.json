it': None, 'type': 'image', 'url': 'images/2014/08/23/arts/23ENSEMBLE/23ENSEMBLE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Concert Where a Shellfish Helps With the Sound', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Concert Where a Shellfish Helps With the Sound', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'da Fonseca-Wollheim, Corinna', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mostly Mozart Festival', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'International Contemporary Ensemble', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-22T21:49:53+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/415d8aad-3420-5d2b-95fd-c63cfff8bc60', 'word_count': 519, 'uri': 'nyt://article/415d8aad-3420-5d2b-95fd-c63cfff8bc60'}, {'abstract': 'The illusion that the streets of Manhattan are paved with gold almost came to a reality this week.', 'web_url': 'https://www.nytimes.com/2014/08/24/fashion/golden-days.html', 'snippet': 'The illusion that the streets of Manhattan are paved with gold almost came to a reality this week.', 'lead_paragraph': 'The streets aren’t paved with gold, but it was applied to the Crown Building on Fifth Avenue. The gilding was reflected on women in gold beads and shoulder bags, and dresses entirely of gold or gold-flecked. Participants in a Fifth Avenue parade, bottom left and top right, also wore it. And on a Hamptons-bound train, gold sandals stretched up to a baggag