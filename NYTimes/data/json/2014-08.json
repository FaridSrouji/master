int_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Identity Crisis Under Cover', 'kicker': 'The Week Ahead', 'content_kicker': None, 'print_headline': 'Television: Identity Crisis Under Cover', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bean, Sean', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Turner Network Television', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Legends (TV Program)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-09T20:14:13+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2fe2a614-f215-5459-b86e-d46c61497ffc', 'word_count': 176, 'uri': 'nyt://article/2fe2a614-f215-5459-b86e-d46c61497ffc'}, {'abstract': 'Eminem and Rihanna may be two of the biggest pop stars of the 2000s, and are frequent collaborators, but the similarities stop there.', 'web_url': 'https://www.nytimes.com/2014/08/10/arts/music/eminem-and-rihanna-come-to-metlife-stadium.html', 'snippet': 'Eminem and Rihanna may be two of the biggest pop stars of the 2000s, and are frequent collaborators, but the similarities stop there.', 'lead_paragraph': 'Eminem and Rihanna may be two of the biggest pop stars of the 2000s, and are frequent collaborators, but the similarities stop there. Eminem is a scabrous self-excavator, a man who raps his way through trauma at lightning speed and with a disregard for the feelings of others (or his own, for that matter). Rihanna is a chilly narcissist with a slick voice that’s almost never touched a feeling. Still, they’re uniting for a brief tour — first a pair of shows in Pasadena, Calif., then a pair in New Jersey before closing out with a pair in Eminem’s hometown, Detroit. Maybe they want to celebrate their collaborations — “The Monster,” “Love the Way You Lie (Part II)” — which have served to soften Eminem and coarsen Rihanna, each achieving something they can’t quite nail on their own. (Next Saturday and Sunday, MetLife Stadium, East Rutherford, N.J.; metlifestadium.com.) ', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/arts/10GUIDE2/10GUIDE2-articleLarge.jpg', 'height': 465, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/10/arts/10GUIDE2/10GUIDE2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 465}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/arts/10GUIDE2/10GUIDE2-jumbo.jpg', 'height': 794, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/arts/10GUIDE2/10GUIDE2-superJumbo.jpg', 'height': 1587, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/arts/10GUIDE2/10GUIDE2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/10/arts/10GUIDE2/10GUIDE2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/arts/10GUIDE2/10GUIDE2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy'