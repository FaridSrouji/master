day, August 22, 2014', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-22T04:20:57+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/a02f3a72-921a-5c90-bbea-53815d59e67c', 'word_count': 70, 'uri': 'nyt://article/a02f3a72-921a-5c90-bbea-53815d59e67c'}, {'abstract': 'Corrections appearing in print on August 22, 2014.', 'web_url': 'https://www.nytimes.com/2014/08/22/pageoneplus/corrections-august-22-2014.html', 'snippet': 'Corrections appearing in print on August 22, 2014.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: August 22, 2014', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-22T04:20:59+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/05fb01bc-5748-5432-b4d7-ae4d9cadeebf', 'word_count': 692, 'uri': 'nyt://article/05fb01bc-5748-5432-b4d7-ae4d9cadeebf'}, {'abstract': 'The books “Blindfolds Off: Judges on How They Decide,” “New York City in 3D: The Gilded Age” and “East in Eden: William Niblo and His Pleasure Garden of Yore” are examined.', 'web_url': 'https://www.nytimes.com/2014/08/24/nyregion/judges-are-people-too.html', 'snippet': 'The books “Blindfolds Off: Judges on How They Decide,” “New York City in 3D: The Gilded Age” and “East in Eden: William Niblo and His Pleasure Garden of Yore” are examined.', 'lead_paragraph': 'For centuries, Justice was routinely depicted as blind, but jurists knew otherwise. “The life of the law has not been logic: it has been experience,” Oliver Wendell Holmes said. Benjamin Cardozo agreed that “the great tides and currents which engulf the rest of men, do not turn aside in their course and pass judges by.” And Sonia Sotomayor, when she was still an appeals court judge, declared that a judge’s ethnicity and gender “may and will make a difference in our judging.”', 'print_section': 'MB', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/nyregion/24BOOKSHELFSUB/24BOOKSHELFSUB-articleLarge.jpg', 'height': 312, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/nyregion/24BOOKSHELFSUB/24BOOKSHELFSUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 312}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/nyregion/24BOOKSHELFSUB/24BOOKSHELFSUB-jumbo.jpg', 'height': 533, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/nyregion/24BOOKSHELFSUB/24BOOKSHELFSUB-superJumbo.jpg', 'height': 1067, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/nyregion/24BOOKSHELFSUB/24BOOKSHELFSUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/24/nyregion/24BOOKSHELFSUB/24BOOKSHELFSUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/nyregion/24BOOKSHELFSUB/24BOOKSHELFSUB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thum