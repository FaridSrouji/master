2artsbeat-photo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 349}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/13/arts/12artsbeat-photo/12artsbeat-photo-jumbo.jpg', 'height': 596, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/13/arts/12artsbeat-photo/12artsbeat-photo-superJumbo.jpg', 'height': 1192, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/13/arts/12artsbeat-photo/12artsbeat-photo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/13/arts/12artsbeat-photo/12artsbeat-photo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/13/arts/12artsbeat-photo/12artsbeat-photo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Photoville Exhibition Returning to Brooklyn Bridge Park', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn Bridge Park (Brooklyn, NY)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-08-12T15:30:08+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9862c33-c0ba-5297-910c-d9d4890c4a30', 'word_count': 251, 'uri': 'nyt://article/e9862c33-c0ba-5297-910c-d9d4890c4a30'}, {'abstract': 'The Parisian jewelry designer is debuting her first U.S. flagship on Lafayette Street.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/08/12/aurelie-bidermann-shop-in-soho/', 'snippet': 'The Parisian jewelry designer is debuting her first U.S. flagship on Lafayette Street.', 'lead_paragraph': 'Aurelie Bidermann’s fanciful, travel-inspired jewelry has for several seasons been the toast of Paris. Tomorrow, the French designer opens her first U.S. boutique in New York, a city she calls her “second home.” The Lafayette Street storefront, with its striped awning and airy color palette, was inspired by New York and Los Angeles in the ’60s and ’70s, while the assortment within includes a series of exclusive scarab-themed pieces accented with lapis lazuli. “The blue felt very New York to me,” Bidermann explains.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/12/t-magazine/12bidermann-gilchrist/12bidermann-gilchrist-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/12/t-magazine/12bidermann-gilchrist/12bidermann-gilchrist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/12/t-magazine/12bidermann-gilchrist/12bidermann-gilchrist-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/12/t-magazine/12bidermann-gilchrist/12bidermann-gilchrist-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank':