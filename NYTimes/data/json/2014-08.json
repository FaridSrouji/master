5354-affa-1e6fcd9e4636', 'word_count': 397, 'uri': 'nyt://article/3ad2188c-40eb-5354-affa-1e6fcd9e4636'}, {'abstract': 'Hillary Rodham Clinton and President Obama attended a party days after she criticized his foreign policy.', 'web_url': 'https://www.nytimes.com/2014/08/15/us/politics/hillary-clinton-and-obama-attend-party-days-after-she-criticized-him.html', 'snippet': 'Hillary Rodham Clinton and President Obama attended a party days after she criticized his foreign policy.', 'lead_paragraph': 'The White House on Thursday declined to say whether President Obama and Hillary Rodham Clinton actually hugged at a party the night before on Martha’s Vineyard.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'If Not Hugging It Out, at Least Cutting a Rug', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': "Martha's Vineyard (Mass)", 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-14T20:24:54+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Amy Chozick', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Chozick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/85fe0a0d-aee9-52bf-ab18-3ca6899e888e', 'word_count': 303, 'uri': 'nyt://article/85fe0a0d-aee9-52bf-ab18-3ca6899e888e'}, {'abstract': 'A Lucas Samaras show at the Metropolitan Museum emphasizes the diversity of his artistic output, from Happenings to works in which he tinkered with his own image.', 'web_url': 'https://www.nytimes.com/2014/08/15/arts/design/lucas-samaras-at-the-metropolitan-museum-of-art.html', 'snippet': 'A Lucas Samaras show at the Metropolitan Museum emphasizes the diversity of his artistic output, from Happenings to works in which he tinkered with his own image.', 'lead_paragraph': 'Despite its grand, somewhat romantic title, “Lucas Samaras: Offerings From a Restless Soul” at the Metropolitan Museum of Art demonstrates quite clearly that Mr. Samaras is at his best as an artist when he settles down — particularly with photography, the medium he’s most associated with. Unfortunately this show, drawn from the museum’s collection — particularly a cache of works bequeathed to the Met by Mr. Samaras’s art dealer, Arnold Glimcher, and Mr. Glimcher’s wife, Milly — is rather slim on photography. Instead, it tries to bolster Mr. Samaras’s status as a versatile artist, with negligible results. ', 'print_section': 'C', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15SAMARAS2/15SAMARAS2-articleLarge-v2.jpg', 'height': 439, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/15/arts/15SAMARAS2/15SAMARAS2-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 439}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15SAMARAS2/15SAMARAS2-jumbo-v2.jpg', 'height': 749, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15SAMARAS2/15SAMARAS2-superJumbo-v2.jpg', 'height': 1498, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank'