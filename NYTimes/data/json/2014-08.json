': 'N'}, {'name': 'persons', 'value': 'Vick, Michael', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Eagles', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-27T21:48:13+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Tom Pedulla', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Pedulla', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b0abe621-8cfc-58c7-a1ce-94a623a6a199', 'word_count': 870, 'uri': 'nyt://article/b0abe621-8cfc-58c7-a1ce-94a623a6a199'}, {'abstract': 'Andrew Kramer discussed how one of the dangers of covering war is that it can require moving across vast territories.', 'web_url': 'https://www.nytimes.com/times-insider/2014/08/27/reporting-on-the-front-lines-in-ukraine/', 'snippet': 'Andrew Kramer discussed how one of the dangers of covering war is that it can require moving across vast territories.', 'lead_paragraph': 'Covering the war in eastern Ukraine has been a challenge partly because it has involved a lot of moving across vast territories of shifting front lines and cutting through rural farmland and industrial urban sprawl on trips that sometimes take hours in each direction. And as in all conflict reporting, the risks of any particular trip, frustratingly, do not always correlate with the payoff in newsworthiness.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/27/blogs/Novoazovsk/Novoazovsk-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/27/blogs/Novoazovsk/