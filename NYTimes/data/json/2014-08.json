/15TRIP/15TRIP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15TRIP/15TRIP-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15TRIP/15TRIP-superJumbo.jpg', 'height': 1357, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15TRIP/15TRIP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/15/arts/15TRIP/15TRIP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15TRIP/15TRIP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'On the Road Again, Riffing Over Pasta', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'On the Road Again, Riffing Over Pasta', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Winterbottom, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Coogan, Steve', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brydon, Rob', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-14T21:07:57+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8fe43a00-a641-5b6b-a31c-104896df34e1', 'word_count': 620, 'uri': 'nyt://article/8fe43a00-a641-5b6b-a31c-104896df34e1'}, {'abstract': 'The artist Jim Hodges is the subject of a career retrospective, “Give More Than You Take,” at the Institute of Contemporary Art in Boston.', 'web_url': 'https://www.nytimes.com/2014/08/15/arts/design/jim-hodges-at-the-institute-of-contemporary-art-boston.html', 'snippet': 'The artist Jim Hodges is the subject of a career retrospective, “Give More Than You Take,” at the Institute of Contemporary Art in Boston.', 'lead_paragraph': 'BOSTON — In the 21st century, we tend to talk about new art in terms of medium and style: Performance is back, painting is back, Pop is back, and so on. But for roughly a decade, from the late 1980s to the late 1990s, the emphasis was on ideas and emotions. As racial and gender politics navigated the culture wars, and the toll taken by AIDS grew overwhelming, content often trumped form. In a lesson learned from feminism, personal history and feeling were O.K. Even spirituality, which the New York art world handles with tongs, became an admissible subject.', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Taking Wing in a Time of Extremis', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Taking Wing in a Time of Extremis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cotter, Holland', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Institute of Contemporary Art', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Boston (Mass)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hodges, Jim', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-14T21:09:52+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5521ca90-3f16-5f96-ad9b-eac6ec966fb7', 'word_count': 1184, 'uri': 'nyt://article/5521ca90-3f16-5f96-ad9b-eac6ec966fb7'}, {'abstract': 'Jeff Baena, the writer and director of “Life After Beth,” narrates a sequence from his film.', 'web_url': 'https://www.nytimes.com/video/movies/100000003047555/anatomy-of-a-scene-life-after-beth.html', 'snippet': 'Jeff Baena, the writer and director of “Life After Beth,” narrates a sequence from his film.', 'lead_paragraph': 'Jeff Baena, the writer and director of “Life After Beth,” narrates a sequence from his film.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/08/multimedia/life-after-beth-anatomy/life-after-beth-anatomy-articleLarge-v2.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/08/multimedia/life-after-beth-anatomy/life-after-beth-anatomy-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/08/multimedia/life-after-beth-anatomy/life-after-beth-anatomy-jumbo-v2.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/08/multimedia/life-after-beth-anatomy/life-after-beth-anatomy-superJumbo-v2.jpg', 'height': 1080, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'ima