nizations', 'value': 'Time Warner Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'CNN', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'HLN', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Vice Media Inc', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, John K Jr', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Zucker, Jeff', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-08-26T17:22:01+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Jonathan Mahler', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Mahler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e6e9a5a-a493-51d2-a46e-d964baebd521', 'word_count': 364, 'uri': 'nyt://article/9e6e9a5a-a493-51d2-a46e-d964baebd521'}, {'abstract': 'James Conlon, the music director of the Ravinia Festival since 2005, will step down to pursue other projects.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/08/26/conlon-to-step-down-from-ravinia-festival/', 'snippet': 'James Conlon, the music director of the Ravinia Festival since 2005, will step down to pursue other projects.', 'lead_paragraph': 'James Conlon announced on Tuesday that he would give up the music directorship of the Ravinia Festival – the Chicago Symphony Orchestra’s summer home – after the 2015 festival. He has been music director at Ravinia since 2005, and has conducted there regularly since 1977. Welz Kauffman, the president and chief executive of the festival, said that the programming for next summer would celebrate some of the repertory areas Mr. Conlon has explored during his tenure, including Mahler symphonies,