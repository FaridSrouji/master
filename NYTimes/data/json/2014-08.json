title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f452059c-4424-58be-bc52-628b45f71482', 'word_count': 907, 'uri': 'nyt://article/f452059c-4424-58be-bc52-628b45f71482'}, {'abstract': 'The designer and his wife and business partner, Erica Lennard, source both materials and inspiration from the spiritual Nepali capital.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/08/29/denis-colombs-cashmere-kathmandu-nepal-travels/', 'snippet': 'The designer and his wife and business partner, Erica Lennard, source both materials and inspiration from the spiritual Nepali capital.', 'lead_paragraph': 'Twice a year for the past decade, the Los Angeles–based designer Denis Colomb has traveled to Kathmandu with his wife and business partner, Erica Lennard. They spend their weekdays visiting the five Nepali workshops that help create the cashmere collections for Colomb’s eponymous label. But on Saturdays the workshops are closed and the couple is free to roam Nepal’s capital. “Initially drawn here to Nepal by the quality of the hand-weaving techniques and the ability to procure the finest cashmere,” Lennard explains, “we are constantly in awe of the deep spirituality and traditional lifestyle that have been part of the Nepali way of life for centuries.” Their Nepali-Tibetan production coordinator, Namdu Bajracharya, shares with them the holiest corners of the city, from small temples to stupas, or Buddhist monasteries, with breathtaking views.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Denis Colomb’s Cashmere Connection to the Holy City of Kathmandu', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Colomb, Denis', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Nepal', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-08-29T13:00:29+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e0106099-ca60-51aa-a92f-e594143775c4', 'word_count': 169, 'uri': 'nyt://article/e0106099-ca60-51aa-a92f-e594143775c4'}, {'abstract': 'Why the weakness?', 'web_url': 'https://krugman.blogs.nytimes.com/2014/08/29/austerity-and-the-hapless-left/', 'snippet': 'Why the weakness?', 'lead_paragraph': 'In today’s column I am not nice to Francois Hollande, who has shown about as much strength in standing up to austerians as a wet Kleenex. But one does have to admit that he’s not alone in his haplessness; where, indeed, are the major political figures on the European left taking a stand against disastrous policies? Britain’s Labour Party has been almost surreally unwilling to challenge Cameron/Osborne’s core premises; is anyone doing better?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Austerity and the Hapless Left', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-29T13:00:50+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f232986c-f399-546c-a6a7-4ec5863ece50', 'word_count': 420, 'uri': 'nyt://article/f232986c-f399-546c-a6a7-4ec5863ece50'}, {'abstract': 'A surge in fighting around Donetsk and Luhansk brought the total number of people killed since mid-April to at least 2,220, and the number of injured to at least 5,956.', 'web_url': 'https://www.nytimes.com/2014/08/30/world/europe/ukraine-toll.html', 'snippet': 'A surge in fighting around Donetsk and Luhansk brought the total number of people killed since mid-April to at least 2,220, and the number of injured to at least 5,956.', 'lead_paragraph': 'GENEVA — The United Nations said on Friday that casualties in the fighting between Ukrainian government forces and pro-Russian rebels had doubled in the past month, with an average of 36 people killed every day.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/30/world/30civilians/30civilians-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/30/world/30civilians/30civilians-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/30/world/30civilians/30civilians-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/30/world/30civilians/30civilians-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/30/world/30civilians/30civilians-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/30/world/30civilians/30civilians-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/30