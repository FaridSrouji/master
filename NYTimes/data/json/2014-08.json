me': 'Neil', 'middlename': None, 'lastname': 'Irwin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44ddcfee-3c03-5728-981f-0b8796490506', 'word_count': 621, 'uri': 'nyt://article/44ddcfee-3c03-5728-981f-0b8796490506'}, {'abstract': '“The Knick,” Steven Soderbergh’s Cinemax series about early-20th-century medicine, is striving for historical accuracy, no matter how gruesome.', 'web_url': 'https://www.nytimes.com/2014/08/03/arts/television/modern-medicine-circa-1900-in-soderberghs-the-knick.html', 'snippet': '“The Knick,” Steven Soderbergh’s Cinemax series about early-20th-century medicine, is striving for historical accuracy, no matter how gruesome.', 'lead_paragraph': 'The Burns Archive, a trove of more than a million historic photographs crammed into a ramshackle townhouse on East 38th Street in Manhattan, is well known to scholars as one of the world’s most important repositories of early medical history, and to the ophthalmology patients who visit its proprietor, Dr. Stanley Burns, one day each week as surely the most atmospheric place in New York City to get an annual eye exam.', 'print_section': 'AR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/arts/03KNICK1/03KNICK1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/arts/03KNICK1/03KNICK1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/arts/03KNICK1/03KNICK1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/arts/03KNICK1/03KNICK1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/arts/03KNICK1/03KNICK1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/arts/03KNICK1/03KNICK1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/arts/03KNICK1/03KNICK1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Cocaine, the Blood, the Body Count', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Cocaine, the Blood, the Body Count', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Soderbergh, Steven', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Cinemax', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Knick (TV Program)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-01T13:46:10+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Jennifer Schuessler', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Schuessler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/929b2553-82b9-519d-8456-56f0074a713e', 'word_count': 1551, 'uri': 'nyt://article/929b2553-82b9-519d-8456-56f0074a713e'}, {'abstract': 'Starting in October tourists will have the right to carry handguns in public, and even flaunt them openly.', 'web_url': 'http