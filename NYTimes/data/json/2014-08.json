on', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/618c3cce-5c69-5994-8e57-be7ae503b46e', 'word_count': 258, 'uri': 'nyt://article/618c3cce-5c69-5994-8e57-be7ae503b46e'}, {'abstract': '“Abuse of Weakness,” based on the director Catherine Breillat’s own book, focuses on a woman entranced by a swindler.', 'web_url': 'https://www.nytimes.com/2014/08/15/movies/abuse-of-weakness-stars-isabelle-huppert-and-kool-shen.html', 'snippet': '“Abuse of Weakness,” based on the director Catherine Breillat’s own book, focuses on a woman entranced by a swindler.', 'lead_paragraph': 'It is hard to imagine that any other actress could muster the stubborn ferocity that Isabelle Huppert brings to the role of Maud, a successful French filmmaker recovering from a stroke in Catherine Breillat’s “Abuse of Weakness.” Like many of Ms. Huppert’s screen characters, Maud is an imperious, willful woman with a perverse drive to play with fire. She refuses to be stopped, even after her left side is paralyzed, and she is barely able to walk. ', 'print_section': 'C', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15ABUSE/15ABUSE-articleLarge-v2.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/15/arts/15ABUSE/15ABUSE-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/arts/15ABUSE/15ABUSE-jumbo-v2.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014