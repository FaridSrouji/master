seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Arangure, Jorge Jr', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Cubs', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Colon, Bartolo', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Torres, Carlos', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-18T20:18:01+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Jorge Arangure Jr', 'person': [{'firstname': 'Jorge', 'middlename': None, 'lastname': 'Arangure', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/28264255-973e-54da-a16b-7c0888e597a1', 'word_count': 584, 'uri': 'nyt://article/28264255-973e-54da-a16b-7c0888e597a1'}, {'abstract': 'Will Power won at Milwaukee; the 10-race MotoGP winning streak of Marc Márquez ended with a loss to his teammate, Dani Pedrosa.', 'web_url': 'https://www.nytimes.com/2014/08/19/automobiles/monday-motorsports-power-moves-closer-to-elusive-indycar-title.html', 'snippet': 'Will Power won at Milwaukee; the 10-race MotoGP winning streak of Marc Márquez ended with a loss to his teammate, Dani Pedrosa.', 'lead_paragraph': 'Will Power held off the fast-closing Juan Pablo Montoya by 2.794 seconds at the finish of the IndyCar race in Milwaukee on Sunday and now is in better position of winning his first series championship. Before the race, Power estimated that he would have to win two of the remaining three races this season to clinch the title. The races remaining include one in Sonoma, Calif., on Sunday and another on Aug. 30 in Fontana, Calif. Power has a 39-point lead over Helio Castroneves in the standings.', 'source': 'The New York Times