s/2014/09/01/sports/jpSHARAPOVA2/jpSHARAPOVA2-jumbo.jpg', 'height': 1024, 'width': 922, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/sports/jpSHARAPOVA2/jpSHARAPOVA2-superJumbo.jpg', 'height': 1770, 'width': 1593, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/sports/jpSHARAPOVA2/jpSHARAPOVA2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/01/sports/jpSHARAPOVA2/jpSHARAPOVA2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/sports/jpSHARAPOVA2/jpSHARAPOVA2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Upsets Persist at U.S. Open as Caroline Wozniacki Ousts Maria Sharapova', 'kicker': None, 'content_kicker': None, 'print_headline': 'Upsets Persist as Wozniacki Ousts Sharapova', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Meyers, Naila-Jean', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wozniacki, Caroline', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sharapova, Maria', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-31T21:13:27+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Naila-Jean Meyers', 'person': [{'firstname': 'Naila-jean', 'middlename': None, 'lastname': 'Meyers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/68004992-d086-5062-9deb-01969eb1e9df', 'word_count': 664, 'uri': 'nyt://article/68004992-d086-5062-9deb-01969eb1e9df'}, {'abstract': '“No Man’s Land: Fiction From a World at War 1914-1918” and “The Burning of the World” bring diverse voices to World War I literature.', 'web_url': 'https://www.nytimes.com/2014/09/01/books/no-mans-land-unfamiliar-writing-about-world-war-i.html', 'snippet': '“No Man’s Land: Fiction From a World at War 1914-1918” and “The Burning of the World” bring diverse voices to World War I literature.', 'lead_paragraph': 'In our high school history classes, teachers might have mentioned Verdun or the Battle of the Somme, but it’s unlikely they got around to the Brusilov Offensive, the Siege of Przemysl or the battles of the Masurian Lakes. Though World War I was the first truly global conflict, and the first to employ the technologies that now dominate warfare, most Americans’ knowledge of the fighting that began 100 years ago this summer is limited.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/BOOKMOLDOVAN/BOOKMOLDOVAN-jumbo.jpg', 'height': 456, 'width': 327, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/BOOKMOLDOVAN/BOOKMOLDOVAN-superJumbo.jpg', 'height': 456, 'width': 327, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/BOOKMOLDOVAN/BOOKMOLDOVAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/01/arts/BOOKMOLDOVAN/BOOKMOLDOVAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/BOOKMOLDOVAN/BOOKMOLDOVAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Delving Deep Into the Crannies of a Brutal War', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Delving Deep Into the Crannies of a Brutal War', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-31T21:17:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Larry Rohter', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Rohter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5e998b24-e8e0-517d-b5c5-50890c22d68a', 'word_count': 1071, 'uri': 'nyt://article/5e998b24-e8e0-517d-b5c5-50890c22d68a'}, {'abstract': 'The first season of the British detective series “Hinterland” is available Monday on Netflix.', 'web_url': 'https://www.nytimes.com/2014/09/01/arts/television/the-british-cop-show-hinterland-comes-to-netflix.html', 'snippet': 'The first season of the British detective series “Hinterland” is available Monday on Netflix.', 'lead_paragraph': 'The title of the cop series “Hinterland” refers to its location, a windy and rugged stretch of coast in western Wales, an out-of-the-way part of an out-of-the-way country. But it could also be a television in-joke: For the last decade, Wales has served silently as the home base and filming location for some of the most acclaimed TV shows set in England, including “Doctor Who,” “Life on Mars” and “Sherlock.” Here, finally, was a major show made by the Welsh about the Welsh.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/HINTERLAND/HINTERLAND-articleLarge.jpg', 'height': 345, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/09/01/arts/HINTERLAND/HINTERLAND-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 345}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/HINTERLAND/HINTERLAND-jumbo.jpg', 'height': 589, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/HINTERLAND/HINTERLAND-superJumbo.jpg', 'height': 1178, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/HINTERLAND/HINTERLAND-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/09/01/arts/HINTERLAND/HINTERLAND-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/arts/HINTERLAND/HINTERLAND-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Following Trails at the Welsh Countryside', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Following Trails at the Welsh Countryside', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Hinterland (TV Program)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-31T21:19:59+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/61a6331e-8943-527c-b28e-95378572a7f5', 'word_count': 423, 'uri': 'nyt://article/61a6331e-8943-527c-b28e-95378572a7f5'}, {'abstract': 'At the 15th World Youth Teams Championships, in the Junior event, the 56-board quarterfinals featured easy wins for France, the Netherlands and Poland.', 'web_url': 'https://www.nytimes.com/2014/09/01/crosswords/bridge/cagey-play-is-a-winner-at-world-youth-championships.html', 'snippet': 'At the 15th World Youth Teams Championships, in the Junior event, the 56-board quarterfinals featured easy wins for France, the Netherlands and Poland.', 'lead_paragraph': 'ISTANBUL — At the 15th World Youth Teams Championships here last month, in the Junior event, for players born in 1989 or later, the 56-board quarterfinals featured easy wins for France, the Netherlands (over USA-1) and Poland. In the fourth match, Norway was down to China by 28 international match points at halftime, but won by 29 imps.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/crosswords/bridge/01card/01card-jumbo.gif', 'height': 895, 'width': 509, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/09/01/crosswords/bridge/01card/01card-superJumbo.gif'