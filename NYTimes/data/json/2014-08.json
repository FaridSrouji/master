t': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/19/world/19SAUDI-1/19SAUDI-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/19/world/19SAUDI-1/19SAUDI-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Saudi Is Robbed in Paris, Quickly and Efficiently', 'kicker': None, 'content_kicker': None, 'print_headline': 'Saudi Is Robbed in Paris, Quickly and Efficiently', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Robberies and Thefts', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Saudi Arabia', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Royal Family', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Four Seasons Hotel George V (Paris, France)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Fahd, Abdul Aziz bin (1973- )', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-08-18T12:07:16+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Dan Bilefsky', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Bilefsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dc72fb0f-18c5-51c2-b14a-0bfd5c4d7fcd', 'word_count': 1078, 'uri': 'nyt://article/dc72fb0f-18c5-51c2-b14a-0bfd5c4d7fcd'}, {'abstract': 'From the International Herald Tribune archives: Lord Kitchener sends out a message to soldiers in 1914.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/08/18/1914-lord-kitchener-sends-messages/', 'snippet': 'From the International Herald Tribune archives: Lord Kitchener sends out a message to soldiers in 1914.', 'lead_paragraph': ' LONDON — The following instructions have been issued by Lord Kitchener to every soldier in the expeditionary army: — “You are ordered abroad as a soldier of the King to help our French comrades against the invasion of a common enemy. You have to perform a task which will need your courage, your energy, your patience. Remember that the honor of the British army depends on your individual conduct. … In this new experience you may find temptation, both in wine and women. You must entirely resist both temptations, and, while treating all women with perfect courtesy, you should avoid intimacy. Do your duty bravely. Fear God; honor the King.” (Signed) KITCHENER. Field Marshal. — The New York Herald, European Edition, Aug. 19, 1914', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1914: Lord Kitchener Sends Messages', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kitchener, Lord', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-08-18T12:11:08+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a9074af9-4f23-53a5-81b8-e5d5b5d9a9be', 'word_count': 125, 'uri': 'nyt://article/a9074af9-4f23-53a5-81b8-e5d5b5d9a9be'}, {'abstract': 'Ingersoll-Rand has agreed to acquire Cameron International