multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/business/Solar/Solar-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/15/business/Solar/Solar-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/business/Solar/Solar-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/business/Solar/Solar-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/business/Solar/Solar-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/15/business/Solar/Solar-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/business/Solar/Solar-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'NRG Energy Buys Goal Zero, a Start-Up, as Entry to Mobile Solar Business', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'NRG Energy Buys Goal Zero, a Start-Up, as Entry to Mobile Solar Business', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-14T11:00:36+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Diane Cardwell', 'person': [{'firstname': 'Diane', 'middlename': None, 'lastname': 'Cardwell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8827f9f7-77e0-5189-b0d7-a0d7ac3d8068', 'word_count': 675, 'uri': 'nyt://article/8827f9f7-77e0-5189-b0d7-a0d7ac3d8068'}, {'abstract': 'Highlights from the International Herald Tribune archives: Italy bans books it deems unsuited for the fascist spirit in 1939.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/08/14/1939-fascist-italy-issues-book-ban/', 'snippet': 'Highlights from the International Herald Tribune archives: Italy bans books it deems unsuited for the fascist spirit in 1939.', 'lead_paragraph': 'ROME — The works of famous writers, including many Jews, and such books as the Nick Carter series of red-blooded adventures that thrilled American boys a generation or two ago, as well as Emil Ludwig’s biography of Lincoln, have been condemned officially as unsuited to the Fascist spirit. Booksellers and librarians received the list, which included books that have been seized and destroyed and others of which the sale has been forbidden. The condemned authors include Casanova, Balzac, Boccaccio, Machiavelli, Rabelais, Voltaire and Poe.\xa0— New York Herald Tribune, European Edition, August 15, 1939', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1939: Fascist Italy Issues Book Ban', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-14T11:12:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63605a0a-8020-59e7-a551-00c25f376b1d', 'word_count': 93, 'uri': 'nyt://article/63605a0a-8020-59e7-a551-00c25f376b1d'}, {'abstract': 'The housing recovery is creating a market for delinquent-mortgage bonds. | A call for a more ambitious overhaul of the repo market. | William A. Ackman pitches for an I.P.O. of his Pershing Square Holdings fund. | A takeover battle for Chiquita Brands International may put inversions to the test.', 'web_url': 'https://dealbook.nytimes.com/2014/08/14/morning-agenda-a-market-for-delinquent-mortgages/', 'snippet': 'The housing recovery is creating a market for delinquent-mortgage bonds. | A call for a more ambitious overhaul of the repo market. | William A. Ackman pitches for an I.P.O. of his Pershing Square Holdings fund. | A takeover battle for Chiquita Br...', 'lead_paragraph': 'The recovery in housing is creating a market for newly minted bonds that are backed by the mortgages on homes on the verge of foreclosure, DealBook’s Matthew Goldstein writes. “It is not just vulture hedge funds swooping in to try to profit from the last remnants of the housing crisis,” he adds. The investors making money off these obscure bonds, none of which are rated by a top credit rating agency, include United States mutual funds. One of the biggest sellers of severely delinquent mortgages to investors is a United States government housing agency.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Agenda: A Market for Delinquent Mortgages', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-14T11:35:57+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Busines