': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-21T20:50:37+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Rick Rojas and Victoria Shannon', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Rojas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Victoria', 'middlename': None, 'lastname': 'Shannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/28ec201d-60de-502b-959f-f2bfdeec97ae', 'word_count': 850, 'uri': 'nyt://article/28ec201d-60de-502b-959f-f2bfdeec97ae'}, {'abstract': '“Behind the Curtain” at the Queens Museum brings together memorabilia of the World’s Fairs of 1939 and 1964 from personal collections.', 'web_url': 'https://www.nytimes.com/2014/08/22/arts/design/worlds-fair-artifacts-from-39-and-64-at-queens-museum.html', 'snippet': '“Behind the Curtain” at the Queens Museum brings together memorabilia of the World’s Fairs of 1939 and 1964 from personal collections.', 'lead_paragraph': 'QUEENS is not the borough to hog center stage, but every once in a while, the spotlight turns its way. It happened, in spectacular fashion, 75 years ago. Out in Forest Hills, Bobby Riggs, fresh from victory at Wimbledon, defeated Welby Van Horn to take the singles title at the United States National Championships, while the incomparable Alice Marble repeated as women’s champion by putting away Helen Hull Jacobs. And over in Flushing Meadows, thousands of visitors were getting a glimpse of the “world of tomorrow” at the New York World’s Fair.', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/22/arts/22FAIRS/22FAIRS-articleLarge.jpg', 'height': 560, 'width': 600, 'subT