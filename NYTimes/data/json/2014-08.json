': 'images/2014/08/17/books/review/0817-bks-SHORT/0817-bks-SHORT-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-SHORT/0817-bks-SHORT-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Financial Crisis', 'kicker': 'The Shortlist', 'content_kicker': None, 'print_headline': 'The Financial Crisis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mandelbaum, Michael', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Drezner, Daniel W', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kunkel, Benjamin', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ivry, Bob', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-15T14:37:51+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Zachary Karabell', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Karabell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fddb58a7-56fe-5c37-8d1c-bba67283db4e', 'word_count': 1013, 'uri': 'nyt://article/fddb58a7-56fe-5c37-8d1c-bba67283db4e'}, {'abstract': 'Richard Bausch’s novel, about a relationship under strain, mixes personal and public horrors.', 'web_url': 'https://www.nytimes.com/2014/08/17/books/review/richard-bauschs-before-during-after.html', 'snippet': 'Richard Bausch’s novel, about a relationship under strain, mixes personal and public horrors.', 'lead_paragraph': 'Marriages, divorces, rebound affairs, second marriages, adulterous liaisons, thwarted desires, unhappy celibacy, empty intercourse, rape: “Before, During, After” is awash in romantic turmoil and sexual predation. At the center of a landscape of almost unrelieved alienation, of relationships not so much broken as revealed as conceits, are Michael Faulk and Natasha Barrett, hurtling toward matrimony. The title of Richard Bausch’s 20th work of fiction refers to the fractured trajectory of their relationship as well as to the terrorist attacks on Sept. 11, 2001, which provide the novel with both elements of plot and an ever-present threat of annihilation that amplifies how his characters strive, and fail, to connect.', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Harrison/0817-bks-Harrison-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/17/books/review/0817-bks-Harrison/0817-bks-Harrison-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Harrison/0817-bks-Harrison-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Harrison/0817-bks-Harrison-superJumbo.jpg', 'height': 1422, 'width': 1422, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Harrison/0817-bks-Harrison-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/17/books/review/0817-bks-Harrison/0817-bks-Harrison-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Harrison/0817-bks-Harrison-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Frayed Ties', 'kicker': None, 'content_kicker': None, 'print_headline': 'Frayed Ties', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Before, During, After (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bausch, Richard', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-08-15T14:39:16+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Kathryn Harrison', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Harrison', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/dc1c16c4-3869-52dd-93b3-549d0d276d38', 'word_count': 1204, 'uri': 'nyt://article/dc1c16c4-3869-52dd-93b3-549d0d276d38'}, {'abstract': 'The American furniture maker who battled Wall Street, Chinese competition and his own relatives to keep his company going.', 'web_url': 'https://www.nytimes.com/2014/08/17/books/review/factory-man-by-beth-macy.html', 'snippet': 'The American furniture maker who battled Wall Street, Chinese competition and his own relatives to keep his company going.', 'lead_paragraph': 'It is impossible to read Beth Macy’s “Factory Man” without casting the inevitable movie version to come. Picture an updated “Norma Rae” in which the hero isn’t an oppressed factory worker but a desperate factory owner battling scheming relatives, callous Wall Street bankers and ruthless Chinese competitors — all to save his workers’ jobs and his family’s bricks-and-mortar legacy, a furniture business in a speck of a town in south central Virginia. Who would play the black sheep turned white knight, John D. Bassett III? George Clooney or Tom Hanks? How about \xadMeryl Streep or Blythe Danner as the family matriarch, Pocahontas Hundley Bassett, a.k.a. Miss Pokey? And what tough-\xadtalking star — Ted Danson, perhaps? — would take on the role of the devious brother-in-law, Bob Spilman, who, by Macy’s account, snatched control of the family business away from the rightful heir, the aforementioned “JBIII”? And what of the book’s villain, Larry Moh, the Chinese übercapitalist seemingly bent on putting American furniture makers out of business? Or the fancy lawyers who wind up making more money than anybody else? “Factory Man” is so thick with rich characters, family secrets and backwoods wisdom that this very abundance becomes its one flaw. ', 'print_section': 'BR', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/17SUBSWARTZ/17SUBSWARTZ-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/17/books/review/17SUBSWARTZ/17SUBSWARTZ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/17SUBSWARTZ/17SUBSWARTZ-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/17SUBSWARTZ/17SUBSWARTZ-superJumbo.jpg', 'height': 1121, 'width': 1685, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/17SUBSWARTZ/17SUBSWARTZ-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/17/books/review/17SUBSWARTZ/17SUBSWARTZ-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/17SUBSWARTZ/17SUBSWARTZ-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Still Made in the U.S.A.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Still Made in the U.S.A.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Swartz, Mimi', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Macy, Beth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Factory Man: How One Furniture Maker Battled Offshoring, Stayed Local and Helped Save an American Town (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-15T14:39:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Mimi Swartz', 'person': [{'firstname': 'Mimi', 'middlename': None, 'lastname': 'Swartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f9ac9bb6-4149-54bb-a945-5391839ccb6a', 'word_count': 1214, 'uri': 'nyt://article/f9ac9bb6-4149-54bb-a945-5391839ccb6a'}, {'abstract': 'Chelsea Cain’s new heroine can’t escape her past.', 'web_url': 'https://www.nytimes.com/2014/08/17/books/review/one-kick-by-chelsea-cain.html', 'snippet': 'Chelsea Cain’s new heroine can’t escape her past.', 'lead_paragraph': 'There are echoes of Lisbeth Salander, Stieg Larsson’s steely heroine, in Kick Lannigan, the protagonist of Chelsea Cain’s unsettling new thriller, which delves into the bleak and disturbing subject of child abduction and pedophilia. Like Salander, Kick is both tough and dangerous. A student of taekwondo, the Korean martial art, she can also box and do a great deal of damage with knives. She’s expert at escaping from confined spaces and can pick locks like the most adept safecracker. But she’s a far more human and likable protagonist than Lisbeth Salander could ever be.', 'print_section': 'BR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Lebor/0817-bks-Lebor-articleLarge.jpg', 'height': 756, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/17/books/review/0817-bks-Lebor/0817-bks-Lebor-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 756}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Lebor/0817-bks-Lebor-jumbo.jpg', 'height': 1024, 'width': 813, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Lebor/0817-bks-Lebor-superJumbo.jpg', 'height': 1440, 'width': 1143, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/books/review/0817-bks-Lebor/0817-bks-Lebor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/17/books/review/0817-bks-Lebor/0817-bks-Lebor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thu