.nytimes.com/2014/08/06/opinion/stop-the-cia-spin-on-the-senate-torture-report.html', 'snippet': 'Abu Ghraib should have taught us that oversight is not the enemy.', 'lead_paragraph': 'ALEXANDRIA, Va. — THE Senate Intelligence Committee will soon release key sections of its report on the Central Intelligence Agency’s detention and interrogation of terrorism suspects after 9/11. In remarks on Friday anticipating the report’s release, which he has publicly supported, President Obama acknowledged that “we tortured some folks.”', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Stop the C.I.A. Spin on the Senate Torture Report', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Stop the C.I.A. Spin on Torture', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Taguba, Antonio M', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Torture', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate Committee on Intelligence', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Classified Information and State Secrets', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Detainees', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Espionage and Intelligence Services', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Interrogations', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-08-06T00:10:36+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Antonio M. Taguba', 'person': [{'firstname': 'Antonio', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/46653d84-2826-5ff5-9e43-6b70def905c3', 'word_count': 886, 'uri': 'nyt://article/46653d84-2826-5ff5-9e43-6b70def905c3'}, {'abstract': 'Richard G. Hendrickson has been giving the Weather Service daily readings from Bridgehampton for 84 years, the longest unbroken streak in the service’s history.', 'web_url': 'https://www.nytimes.com/2014/08/06/nyregion/long-island-weather-observer-sets-us-record-with-84-year-streak.html', 'snippet': 'Richard G. Hendrickson has been giving the Weather Service daily readings from Bridgehampton for 84 years, the longest unbroken streak in the service’s history.', 'lead_paragraph': 'BRIDGEHAMPTON, N.Y. — Richard G. Hendrickson dials a certain telephone number by 10 a.m. every day. “Bridgehampton,” he says into the receiver. “Good morning.”', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/06/nyregion/BRIDGEHAMPTON-REFER/BRIDGEHAMPTON-REFER-articleLarge.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/06/nyregion/BRIDGEHAMPTON-REFER/BRIDGEHAMPTON-REFER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/06/nyregion/BRIDGEHAMPTON-REFER/BRIDGEHAMPTON-REFER-jumbo.jpg', 'height': 674, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/06/nyregion/BRIDGEHAMPTON-REFER/BRIDGEHAMPTON-REFER-superJumbo.jpg', 'height': 1348, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype