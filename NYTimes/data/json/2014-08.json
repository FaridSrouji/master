cations', 'value': 'Mariupol (Ukraine)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Crimea (Ukraine)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-08-27T16:42:47+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Andrew E. Kramer and Michael R. Gordon', 'person': [{'firstname': 'Andrew', 'middlename': 'E.', 'lastname': 'Kramer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Michael', 'middlename': 'R.', 'lastname': 'Gordon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3428afb2-380d-50c3-af33-78eaffb35f19', 'word_count': 1364, 'uri': 'nyt://article/3428afb2-380d-50c3-af33-78eaffb35f19'}, {'abstract': 'The annual Origin’s 1st Irish Festival will include a number of world premiere productions as well as at least one return engagement.', 'web_url': 'https://www.nytimes.com/2014/08/31/theater/waiting-for-godot-at-origins-1st-irish-festival.html', 'snippet': 'The annual Origin’s 1st Irish Festival will include a number of world premiere productions as well as at least one return engagement.', 'lead_paragraph': 'A new season on and Off Broadway is revving up, and it will be a busy and somewhat star-studded fall. But before we get sidetracked with all of that, let’s give some thought to a smaller but no less notable event: the annual Origin’s 1st Irish Festival.', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/31/arts/31GUIDE6/31GUIDE6-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/31/arts/31GUIDE6/31GUIDE6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'