one, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-08-10T22:00:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d2317b5-5b55-51b3-84f4-73429ca2244d', 'word_count': 658, 'uri': 'nyt://article/0d2317b5-5b55-51b3-84f4-73429ca2244d'}, {'abstract': 'The organization said that it believed it had not violated antitrust laws and that it was seeking clarification on details of the decision, such as the notion of trust funds for athletes.', 'web_url': 'https://www.nytimes.com/2014/08/11/sports/ncaabasketball/ncaa-will-appeal-obannon-ruling.html', 'snippet': 'The organization said that it believed it had not violated antitrust laws and that it was seeking clarification on details of the decision, such as the notion of trust funds for athletes.', 'lead_paragraph': 'The N.C.A.A. on Sunday announced plans to appeal the ruling in the so-called O’Bannon case, in which a federal judge took the legs out from under most of the justifications for the amateur model and kicked the billion-dollar college sports industry further down the road to professionalization than anyone before her ever had. An appeal had been widely expected.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'N.C.A.A. Will Appeal the O’Bannon Ruling', 'kicker': None, 'content_kicker': None, 'print_headline': 'N.C.A.A. Will Appeal the O’Bannon Ruling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tracy, Marc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 2, 'major': 'N'},