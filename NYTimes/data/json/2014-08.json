nk': 4, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Tests', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-08-09T03:25:29+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Douglas Martin', 'person': [{'firstname': 'Douglas', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/1a949383-0301-50d4-9b85-401e919350ed', 'word_count': 1083, 'uri': 'nyt://article/1a949383-0301-50d4-9b85-401e919350ed'}, {'abstract': '“My Life Is a Musical” at the Bay Street Theater in Sag Harbor is Adam Overett’s inspired new musical.', 'web_url': 'https://www.nytimes.com/2014/08/10/nyregion/a-review-of-my-life-is-a-musical-in-sag-harbor.html', 'snippet': '“My Life Is a Musical” at the Bay Street Theater in Sag Harbor is Adam Overett’s inspired new musical.', 'lead_paragraph': 'In a flashback to an experience when he was 7 years old, Parker, the bewildered hero of “My Life Is a Musical,” discovers that he is apparently the only person who hears people bursting into song all around him every day. His mother tries to teach him the difference between song and spoken conversation by demonstrating: “This is singing. This is talking.” But the audience hears her as he does, trilling with operatic abandon (in a funny performance by Wendi Bergamini) during the second sentence as well as the first.', 'print_section': 'LI', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/nyregion/10ARTSLI1/10ARTSLI1-articleLarge.jpg', 'height': 542, 'width': 600, 'subType': 'xlarge', '