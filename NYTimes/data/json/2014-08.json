edit': None, 'type': 'image', 'url': 'images/2014/08/03/magazine/03spoon1/mag-03Spoon-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Spoon, the Molecular Gastronomists of Rock', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Dismantlers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kois, Dan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Audio Recordings, Downloads and Streaming', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Spoon (Music Group)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-01T14:30:15+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Dan Kois', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Kois', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2444dbf4-3624-5c0f-af75-2cb63bbdeb4d', 'word_count': 2835, 'uri': 'nyt://article/2444dbf4-3624-5c0f-af75-2cb63bbdeb4d'}, {'abstract': 'Meditations on exposing an innocent adorable creature to this brutal, perverse world.', 'web_url': 'https://www.nytimes.com/2014/08/03/magazine/can-parenthood-and-pessimism-live-side-by-side.html', 'snippet': 'Meditations on exposing an innocent adorable creature to this brutal, perverse world.', 'lead_paragraph': 'When I was about 10 or 11, my father took me to a nursing home one summer evening. As a pharmacist in the small Irish city of Kilkenny, he sometimes visited customers and other elderly acquaintances who were hospitalized or bedridden, and I would insist on going with him, as in those days I insisted on accompanying him wherever he went, relishing even the prospect of a trip to the dump if it meant spending time alone with my father, whom I idolized. This nursing home, a low and dreary building, was a place I’d never been to before; known locally as “the poor house,” it was a state-run institution for elderly and senile patients whose families could not afford to pay for their care.', 'print_section': 'MM', 'print_page': '44', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/magazine/03riff/mag-03Riff-t_CA0-articleLarge.jpg', 'height': 93, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/magazine/03riff/mag-03Riff-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 93}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/magazine/03riff/mag-03Riff-t_CA0-jumbo.jpg', 'height': 159, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/magazine/03riff/mag-03Riff-t_CA0-superJumbo.jpg', 'height': 317, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/magazine/03riff/03riff-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/magazine/03riff/03riff-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/magazine/03riff/03riff-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can Parenthood and Pessimism Live Side by Side?', 'kicker': N