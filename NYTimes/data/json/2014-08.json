}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/257a73a9-0dd0-5d53-b4bd-e1d4d688eb7f', 'word_count': 81, 'uri': 'nyt://article/257a73a9-0dd0-5d53-b4bd-e1d4d688eb7f'}, {'abstract': 'An air travel expert warns about new baggage and seating restrictions when you fly.', 'web_url': 'https://www.nytimes.com/2014/08/03/travel/george-hobica-finds-air-travels-rare-silver-linings.html', 'snippet': 'An air travel expert warns about new baggage and seating restrictions when you fly.', 'lead_paragraph': 'With the Transportation Security Administration increasing its fees and airlines charging extra for everything from seats to bags, flying has become an even costlier proposition, especially for families.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/travel/03QNA1-sf/03QNA1-sf-jumbo-v2.jpg', 'height': 401, 'width': 500, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/travel/03QNA1-sf/03QNA1-sf-superJumbo-v2.jpg', 'height': 401, 'width': 500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/travel/03QNA1-sf/03QNA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/travel/03QNA1-sf/03QNA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/travel/03QNA1-sf/03QNA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'George Hobica Finds Air Travel’s Rare Silver Linings', 'kicker': 'Q&A', 'content_kick