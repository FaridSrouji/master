ownhouse4-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/realestate/03TOWNHOUSE4/03townhouse4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/realestate/03TOWNHOUSE4/03townhouse4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/realestate/03TOWNHOUSE4/03townhouse4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Townhouse, Minus the Past', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Townhouse, Minus the Past', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Cobble Hill (Brooklyn, NY)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Dumbo (Brooklyn, NY)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Williamsburg (Brooklyn, NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-01T15:30:07+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Michelle Higgins', 'person': [{'firstname': 'Michelle', 'middlename': None, 'lastname': 'Higgins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9cc4af0-3116-573a-b72c-25df7779e591', 'word_count': 1331, 'uri': 'nyt://article/f9cc4af0-3116-573a-b72c-25df7779e591'}, {'abstract': 'The chef behind Mission Chinese and MIssion Cantina discusses biking style, where to buy the best T-shirts and the virtues of kitchen clogs.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/08/01/danny-bowien-on-style-mission-cantina-chinese-bikes-style/', 'snippet': 'The chef behind Mission Chinese and MIssion Cantina discusses biking style, where to buy the best T-shirts and the virtues of kitchen clogs.', 'lead_paragraph': 'The chef and restaurateur Danny Bowien claims he’s not into fashion, but he’s clearly got his own idiosyncratic ideas about style. A typical look involves an oversize, vintage Bulls athletic tank jersey turned inside out, blazing red nylon shorts from Creatures of Comfort and dark leather Bragard slip-on kitchen shoes paired with black knit socks. His trademarks are a pair of worn-in, sciencey specs and his two-tone hair, which he recently trimmed himself. The cut was inspired both by his six-month-old son Mino (“I didn’t want to be that dad with weird hair”) and his insanely busy schedule, which leaves little time for grooming. With two restaurants to run — Mission Cantina in New York and Mission Chinese Food in San Francisco — along with various pop-ups, including his newest at Mile End Deli on Bond Street, Bowien has been living out of his Y-3 backpack and traveling on his 3Rensho bike whenever possible. Earlier this week, he took a break in between lunch and dinner services to talk about his love of band T-shirts, why he had to quit using cologne and his former stint as a Uniqlo model (watch out, it could happen again).', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/01/t-magazine/01bowien-molvar-2/01bowien-molvar-2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/01/t-magazine/01bowien-molvar-2/01bowien-molvar-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/01/t-magazine/01bowien-molvar-2/01bowien-molvar-2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/01/t-magazine/01bowien-molvar-2/01bowien-molvar-2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/01/t-magazine/01bowien-molvar-2/01bowien-molvar-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/01/t-magazine/01bowien-molvar-2/01bowien-molvar-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/01/t-magazine/01bowien-molvar-2/01bowien-molvar-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rules of Style | Danny Bowien on How to Look Sharp and Why He Chopped His Locks', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bowien, Danny', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-08-01T15:30:41+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kari Molvar', 'person': [{'firstname': 'Kari', 'middlename': None, 'lastname': 'Molvar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6cdf8bc9-76b4-5419-8ec9-ff2d14131f43', 'word_count': 1173, 'uri': 'nyt://article/6cdf8bc9-76b4-5419-8ec9-ff2d14131f43'}, {'abstract': 'In Yannick Murphy’s thriller “This Is the Water,” the mother of two girls on a competitive swim team is having an affair with her friend’s husband.', 'web_url': 'https://www.nytimes.com/2014/08/03/books/review/yannick-murphys-this-is-the-water-and-more.html', 'snippet': 'In Yannick Murphy’s thriller “This Is the Water,” the mother of two girls on a competitive swim team is having an affair with her friend’s husband.', 'lead_paragraph': 'Rules, rules, so many stupid rules: “Don’t switch point of view.” “Don’t give away the identity of the killer.” “Don’t write in the second person.” Yannick Murphy, an author who seems drawn to high cliffs, ignores all the warnings in THIS IS THE WATER (Harper Perennial, paper, $14.99), an inventive thriller set in suburbia — and in the troubled minds of her characters. The second-person narrative voice that feels alienating at the outset (“This is the water. . . . This is the swim mom. . . . This is the bathroom”) soon becomes hypnotic (“This is you, Annie”) and then seriously unsettling (“This is the killer”). Annie, the mother of two girls on a competitive swim team, is the most appealing of all the moms in their pretty New England town who shell out $1,000 per child to get their kids on the team and hundreds more for those sadistically engineered racing suits that are supposed to shave milliseconds off their records. But while Annie dutifully volunteers to time the girls’ practice swims and drive to out-of-town meets, she can never satisfy a fanatic like Dinah, who monitors everyone’s moves and complains that “Annie and her daughters always seem to be doing what they’re not supposed to do.”', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03CRIME/03CRIME-articleLarge-v2.jpg', 'height': 831, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/books/review/03CRIME/03CRIME-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 831}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03CRIME/03CRIME-jumbo-v2.jpg', 'height': 1024, 'width': 740, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03CRIME/03CRIME-superJumbo-v2.jpg', 'height': 2048, 'width': 1479, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03CRIME/03CRIME-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/books/review/03CRIME/03CRIME-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03CRIME/03CRIME-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Deep End', 'kicker': None, 'content_kicker': None, 'print_headline': 'Deep End', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Murphy, Yannick', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Morris, Bill', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ulfelder, Steve', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mark, David', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-01T15:33:12+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marilyn Stasio', 'person': [{'firstname': 'Marilyn', 'middlename': None, 'lastname': 'Stasio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c9385870-dbe8-54b0-952f-019aa9cd286d', 'word_count': 919, 'uri': 'nyt://article/c9385870-dbe8-54b0-952f-019aa9cd286d'}, {'abstract': 'Fifty-nine short stories about love and other passionate longings, tinged with surreal potential, by Stuart Dybek, a master of the form.', 'web_url': 'https://www.nytimes.com/2014/08/03/books/review/ecstatic-cahoots-and-paper-lantern-by-stuart-dybek.html', 'snippet': 'Fifty-nine short stories about love and other passionate longings, tinged with surreal potential, by Stuart Dybek, a master of the form.', 'lead_paragraph': 'Our American present seems best served by a literature of swerves. Whiplash plot changes. Arrivals that surprise, departures that are kicks in the teeth. Characters who veer violently off course: Think of poor Ned Stark from “A Game of Thrones,” or erratic Amy Dunne from “Gone Girl.” This is popular fiction’s response to the cloud of dark news that won’t quit raining on us. If life really has taken on a schizoid vibe, then maybe a narrative schizophrenia has come to look like real life.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03strauss/03strauss-articleLarge.jpg', 'height': 920, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/books/review/03strauss/03strauss-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 920}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03strauss/03strauss-jumbo.jpg', 'height': 1024, 'width': 669, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03strauss/03strauss-superJumbo.jpg', 'height': 2048, 'width': 1337, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03strauss/03strauss-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/books/review/03strauss/03strauss-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03strauss/03strauss-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What the Hearts Want', 'kicker': None, 'content_kicker': None, 'print_headline': 'What the Hearts Want', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dybek, Stuart', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Ecstatic Cahoots: Fifty Short Stories (Book)', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Paper Lantern: Love Stories (Book)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-01T15:33:46+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Darin Strauss', 'person': [{'firstname': 'Darin', 'middlename': None, 'lastname': 'Strauss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/dabd4087-3898-5cb7-b693-9e18df7169ee', 'word_count': 845, 'uri': 'nyt://article/dabd4087-3898-5cb7-b693-9e18df7169ee'}, {'abstract': 'Elizabeth Pisani trekked 26,000 miles around the Indonesian archipelago, searching for what binds this disparate nation.', 'web_url': 'https://www.nytimes.com/2014/08/03/books/review/indonesia-etc-by-elizabeth-pisani.html', 'snippet': 'Elizabeth Pisani trekked 26,000 miles around the Indonesian archipelago, searching for what binds this disparate nation.', 'lead_paragraph': 'This year, three of the world’s largest democracies are holding national elections — vast polls spread over several days and thousands of miles of territory, involving more than a billion voters. Two of these elections have attracted intense media coverage, or will. India’s national elections, which took place in May, swept out of office the long-ruling Congress Party and handed government of a rising economic and political power to the Hindu nationalist Bharatiya Janata Party. Brazil’s elections, which will be held in October, are coming on the heels of the World Cup, one of several high-profile events that have marked the country’s emergence as the second giant of the Americas. ', 'print_section': 'BR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-Kurkantzick/0803-bks-Kurkantzick-articleLarge.jpg', 'height': 210, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/books/review/0803-bks-Kurkantzick/0803-bks-Kurkantzick-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 210}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-Kurkantzick/0803-bks-Kurkantzick-jumbo.jpg', 'height': 358, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-Kurkantzick/0803-bks-Kurkantzick-superJumbo.jpg', 'height': 716, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-Kurkantzick/0803-bks-Kurkantzick-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/books/review/0803-bks-Kurkantzick/0803-bks-Kurkantzick-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/0803-bks-Kurkantzick/0803-bks-Kurkantzick-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'All Over the Map', 'kicker': None, 'content_kicker': None, 'print_headline': 'All Over the Map', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pisani, Elizabeth', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Indonesia', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Indonesia Etc.: Exploring the Improbable Nation (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-08-01T15:33:58+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joshua Kurlantzick', 'person': [{'firstname': 'Joshua', 'middlename': None, 'lastname': 'Kurlantzick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8dc7666b-559b-5a39-ba83-42462fa6bf82', 'word_count': 1285, 'uri': 'nyt://article/8dc7666b-559b-5a39-ba83-42462fa6bf82'}, {'abstract': 'Thomas Robert Malthus’s ideas about population and scarcity have been invoked, extrapolated and polemicized for centuries.', 'web_url': 'https://www.nytimes.com/2014/08/03/books/review/malthus-by-robert-j-mayhew.html', 'snippet': 'Thomas Robert Malthus’s ideas about population and scarcity have been invoked, extrapolated and polemicized for centuries.', 'lead_paragraph': 'Getting people to attach an “ian” (or an “ist”) to the end of your name is pretty impressive. Getting them to keep doing so 180 years after your death, not as a musty reference but as part of vital contemporary debates, well, that’s a phenomenon worth studying.', 'print_section': 'BR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03fox/03fox-articleLarge.jpg', 'height': 693, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/books/review/03fox/03fox-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 693}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03fox/03fox-jumbo.jpg', 'height': 1024, 'width': 888, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03fox/03fox-superJumbo.jpg', 'height': 1825, 'width': 1581, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03fox/03fox-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/books/review/03fox/03fox-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03fox/03fox-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Head Count', 'kicker': None, 'content_kicker': None, 'print_headline': 'Head Count', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mayhew, Robert J', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Malthus, Thomas Robert', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Malthus: The Life and Legacies of an Untimely Prophet (Book)', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-01T15:34:12+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Justin Fox', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Fox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d75f0871-f843-5464-bcec-351877f5b349', 'word_count': 1238, 'uri': 'nyt://article/d75f0871-f843-5464-bcec-351877f5b349'}, {'abstract': 'Nigel Hamilton argues that Roosevelt’s genius for military leadership has been underrated and overshadowed.', 'web_url': 'https://www.nytimes.com/2014/08/03/books/review/the-mantle-of-command-by-nigel-hamilton.html', 'snippet': 'Nigel Hamilton argues that Roosevelt’s genius for military leadership has been underrated and overshadowed.', 'lead_paragraph': 'Our understanding of the past is shaped in no small part by the letters and memoirs of the people who made history, or claimed to. Rival statesmen have long understood this. In their nearly 40 years of intimate but tendentious correspondence, Thomas Jefferson and John Adams were jockeying for posterity; in dueling memoirs a century and a half later, so were Richard Nixon and Henry Kissinger. Indeed, one reason Nixon installed the secret White House taping system was to make sure he could rebut Kissinger’s version of events.', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03thomas/03thomas-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/03/books/review/03thomas/03thomas-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03thomas/03thomas-jumbo.jpg', 'height': 666, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03thomas/03thomas-superJumbo.jpg', 'height': 1332, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03thomas/03thomas-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/03/books/review/03thomas/03thomas-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/03/books/review/03thomas/03thomas-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'War Comes to America', 'kicker': None, 'content_kicker': None, 'print_headline': 'War Comes to America', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Thomas, Evan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hamilton, Nigel', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Roosevelt, Franklin Delano', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Mantle of Command: FDR at War, 1941-1942 (Book)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-08-01T15:34:20+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Evan Thomas', 'person': [{'firstname': 'Evan', 'middlename': None, 'lastname': 'Thomas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3b5c757c-6749-55a9-977e-6ec57e103759', 'word_count': 1232, 'uri': 'nyt://article/3b5c757c-6749-55a9-977e-6ec57e103759'}, {'abstract': 'The problems, philosophical and practical, with seeking greater conservative representation in the arts.', 'web_url': 'https://douthat.blogs.nytimes.com/2014/08/01/searching-for-john-milius/', 'snippet': 'The problems, philosophical and practical, with seeking greater conservative representation in the arts.', 'lead_paragraph': 'My post on conservatives and the arts has prompted an interesting reply from Micah Mattix, of the “Prufrock” blog and newsletter:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Searching For John Milius', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Coppola, Francis Ford', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Milius, John', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Spielberg, Steven', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-01T15:42:08+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f3ec7667-3fce-581d-9986-1dbfa1d8df80', 'word_count': 1000, 'uri': 'nyt://article/f3ec7667-3fce-581d-9986-1dbfa1d8df80'}, {'abstract': 'Experts see a mix of conservation and groundwater management as the cheapest way for Californians to grapple with deepening drought.', 'web_url': 'https://dotearth.blogs.nytimes.com/2014/08/01/how-conservation-and-groundwater-management-can-gird-california-for-a-drier-era/', 'snippet': 'Experts see a mix of conservation and groundwater management as the cheapest way for Californians to grapple with deepening drought.', 'lead_paragraph': 'It’s way past time for California to come to grips with the possibility that its extraordinary water woes are the new normal — and essentially the return of the old normal given the state’s climate history, in which drought has been the rule and the verdant 20th century the exception. In the weekly update to the U.S. Drought Monitor site yesterday, nearly 80 percent of the state was in extreme or exceptional drought conditions.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/01/blogs/dotcaldry/dotcaldry-articleLarge.jpg', 'height': 640, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/20