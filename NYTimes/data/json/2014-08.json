media': [], 'headline': {'main': 'Another Night In Brooklyn', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-23T13:47:36+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35d2cea8-66de-57ff-8e69-b0b84219e0c0', 'word_count': 133, 'uri': 'nyt://article/35d2cea8-66de-57ff-8e69-b0b84219e0c0'}, {'abstract': 'A study shows that working from home can make you happier. Face time at the office, however, has value, too.', 'web_url': 'https://www.nytimes.com/2014/08/24/business/yes-flexible-hours-ease-stress-but-is-everyone-on-board.html', 'snippet': 'A study shows that working from home can make you happier. Face time at the office, however, has value, too.', 'lead_paragraph': 'Everyone with a job knows how stressful it can be when personal priorities clash with work schedules. The conflict could involve a continuing medical concern, taking care of children or aging parents, or getting enough exercise or running errands. A too-strict schedule combined with too many demands can cause workers to feel that they have let down their companies, their families and themselves. ', 'print_section': 'BU', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/24-APPLIED/24-APPLIED-articleLarge.jpg', 'height': 449, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/business/24-APPLIED/24-APPLIED-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 449}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/24-APPLIED/24-APPLIED-jumbo.jpg', 'height': 767, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/24-APPLIED/24-APPLIED-superJumbo.jpg', 'height': 1533, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/24-APPLIED/24-APPLIED-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/24/business/24-APPLIED/24-APPLIED-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/24-APPLIED/24-APPLIED-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Yes, Flexible Hours Ease Stress. But Is Everyone on Board?', 'kicker': 'Applied Science', 'content_kicker': None, 'print_headline': 'Yes, Flexible Hours Ease Stress. But Is Everyone on Board?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Korkki, Phyllis', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Work-Life Balance', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'American Sociological Review (Journal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Working Hours', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Environment', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Telecommuting', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-08-23T13:50:13+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Phyllis Korkki', 'person': [{'firstname': 'Phyllis', 'middlename': None, 'lastname': 'Korkki', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3236bca6-e8f5-5933-b379-efddefa64c21', 'word_count': 669, 'uri': 'nyt://article/3236bca6-e8f5-5933-b379-efddefa64c21'}, {'abstract': 'An economist says companies’ moves abroad offer another reminder that it’s time to rethink the entire tax system — and to base it on consumption.', 'web_url': 'https://www.nytimes.com/2014/08/24/upshot/one-way-to-fix-the-corporate-tax-repeal-it.html', 'snippet': 'An economist says companies’ moves abroad offer another reminder that it’s time to rethink the entire tax system — and to base it on consumption.', 'lead_paragraph': '“Some people are calling these companies ‘corporate deserters.’\xa0” ', 'print_section': 'BU', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/VIEW/VIEW-articleLarge.jpg', 'height': 541, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/business/VIEW/VIEW-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 541}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/VIEW/VIEW-jumbo.jpg', 'height': 923, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/VIEW/VIEW-superJumbo.jpg', 'height': 1845, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/business/VIEW/VIEW-th