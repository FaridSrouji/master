rpt from the seller’s tale in the eBay listing.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/t-magazine/15wornstories_inline/15wornstories_inline-articleLarge.jpg', 'height': 807, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/15/t-magazine/15wornstories_inline/15wornstories_inline-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 807}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/t-magazine/15wornstories_inline/15wornstories_inline-jumbo.jpg', 'height': 1024, 'width': 762, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/t-magazine/15wornstories_inline/15wornstories_inline-superJumbo.jpg', 'height': 2000, 'width': 1487, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/t-magazine/15wornstories_inline/15wornstories_inline-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/15/t-magazine/15wornstories_inline/15wornstories_inline-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/15/t-magazine/15wornstories_inline/15wornstories_inline-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Greta Gerwig, Marcus Samuelsson and Others Tell Stories About Beloved Garments', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Bookshelf: Narrative Threa