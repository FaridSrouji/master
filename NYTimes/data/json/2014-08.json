main only spottily tracked.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/dotwaterspout/dotwaterspout-articleLarge.jpg', 'height': 369, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/25/blogs/dotwaterspout/dotwaterspout-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 369}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/dotwaterspout/dotwaterspout-jumbo.jpg', 'height': 630, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/dotwaterspout/dotwaterspout-superJumbo.jpg', 'height': 1260, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/dotwaterspout/dotwaterspout-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/25/blogs/dotwaterspout/dotwaterspout-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/dotwaterspout/dotwaterspout-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Closer Look at Turbulent Oceans and Greenhouse Heating', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ATLANTIC OCEAN', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'El Nino Southern Oscillation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value'