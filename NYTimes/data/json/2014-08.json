: 'images/2014/08/09/upshot/09up-studentdebt/09up-studentdebt-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/09/upshot/09up-studentdebt/09up-studentdebt-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/09/upshot/09up-studentdebt/09up-studentdebt-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/09/upshot/09up-studentdebt/09up-studentdebt-superJumbo.jpg', 'height': 1325, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/09/upshot/09up-studentdebt/09up-studentdebt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/09/upshot/09up-studentdebt/09up-studentdebt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/09/upshot/09up-studentdebt/09up-studentdebt-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What We Mean When We Say Student Debt Is Bad', 'kicker': 'Value of a Degree', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Student Loans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-08-08T16:42:06+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Susan Dynarski', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Dynarski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4870884f-7aaa-5d68-9f88-b58f93dc8104', 'word_count': 995, 'uri': 'nyt://article/4870884f-7aaa-5d68-9f88-b58f93dc8104'}, {'abstract': "Kevin Carr, who's in the middle of a trip that will cover more than 18,000 miles, talks about the challenges and surprises he's encountered so far.", 'web_url': 'https://www.nytimes.com/2014/08/10/travel/going-for-a-run-around-the-world.html', 'snippet': "Kevin Carr, who's in the middle of a trip that will cover more than 18,000 miles, talks about the challenges and surprises he's encountered so far.", 'lead_paragraph': 'After struggling with depression and anxiety in his early 20s, Kevin Carr, 34, decided “mental illness must never be confused with mental weakness.” He set out to prove this through extreme running. He ran 50 marathons in 50 days and then tackled the mountainous route between Land’s End, England, and John O’Groats, Scotland, taking a roundabout 1,200-mile, six-week journey between the two points on opposite ends of Britain. Now, he is about halfway through an around-the-world run in which he will cover more than 18,000 miles over six continents.', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/travel/10-qna-top-new/10-qna-top-new-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/10/travel/10-qna-top-new/10-qna-top-new-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/10/travel/10-qna-top-new/10-qna-top-new-jumbo.jpg', 'heig