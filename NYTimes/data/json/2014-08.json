imedia': [], 'headline': {'main': 'The Search for Calm in Missouri', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Search for Calm in Missouri', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Ferguson (Mo)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Michael (1996-2014)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nixon, Jay', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-08-15T00:57:04+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/c972a28b-c145-5977-b020-324559bb55e9', 'word_count': 654, 'uri': 'nyt://article/c972a28b-c145-5977-b020-324559bb55e9'}, {'abstract': 'The marriage of Lucinda Franks, a Pulitzer Prize winner, and Robert M. Morgenthau, who was Manhattan’s district attorney for 34 years, represents a kind of glamour that seems to have lost some of its currency.', 'web_url': 'https://www.nytimes.com/2014/08/17/nyregion/an-original-power-couple.html', 'snippet': 'The marriage of Lucinda Franks, a Pulitzer Prize winner, and Robert M. Morgenthau, who was Manhattan’s district attorney for 34 years, represents a kind of glamour that seems to have lost some of its currency.', 'lead_paragraph': 'From the time of Ward McAllister to Dawn Powell to Candace Bushnell to Jay Z, the quintessential New York love story has been dependent on a certain kind of brand building. It involves something beyond simply the merging of two compatible spirits — that alone would be boring — and instead requires a shared exceptionalism, heightened ambitions, a mutual interest in power or at least significance on a grand scale. ', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/nyregion/17BIG/17BIG-articleLarge.jpg', 'height': 329, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/17/nyregion/17BIG/17BIG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 329}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/nyregion/17BIG/17BIG-jumbo.jpg', 'height': 561, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/nyregion/17BIG/17BIG-superJumbo.jpg', 'height': 1122, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/nyregion/17BIG/17BIG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/17/nyregion/17BIG/17BIG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/17/nyregion/17BIG/17BIG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Original Power Couple', 'kicker': 'Big City', 'content_kicker': None, 'print_headline': 'An Original Power Couple', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Franks, Lucinda', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Morgenth