12, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/24/world/asia/25XINJIANG/25XINJIANG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 412}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/world/asia/25XINJIANG/25XINJIANG-jumbo.jpg', 'height': 704, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/world/asia/25XINJIANG/25XINJIANG-superJumbo.jpg', 'height': 1408, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/world/asia/25XINJIANG/25XINJIANG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/24/world/asia/25XINJIANG/25XINJIANG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/24/world/asia/25XINJIANG/25XINJIANG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'China Says 8 Executed in Western Region; Charges Stem From Separatist Attacks ', 'kicker': None, 'content_kicker': None, 'print_headline': 'China Says 8 Executed in Western Region; Charges Stem From Separatist Attacks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'China', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Capital Punishment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Uighurs (Chinese Ethnic Group)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Xinjiang (China)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Tiananmen Square (Beijing)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-08-24T08:12:24+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Chris Buckley', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Buckley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d1063374-f196-5429-9add-86f6863a4b55', 'word_count': 494, 'uri': 'nyt://article/d1063374-f196-5429-9add-86f6863a4b55'}, {'abstract': 'Highlights from the International Herald Tribune archives: The actress Sarah Bernhardt faces the funeral of her husband in 1889.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2014/08/24/1889-sarah-bernhardts-courage-in-real-death-scene/', 'snippet': 'Highlights from the International Herald Tribune archives: The actress Sarah Bernhardt faces the funeral of her husband in 1889.', 'lead_paragraph': 'Sarah Bernhardt, who has so wonderfully impersonated death in all its phases, has just had a painful experience of its dread reality on the occasion of the funeral of her husband, M. Damala. A report was spread by the Rappel to the effect that when the body was carried down to the ground floor of the house, the coffin was found to be too small, and it took an hour to make it large enough. During this operation, said the report, the body was placed in an armchair, and Mme. Bernhardt had the courage to support the head on her shoulder the whole time. The sight was blood curdling, and created a sad impression on those present. — The New York Herald, European Edition, Aug. 25, 1889', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/25iht-oldaug25-bernhardt/25iht-oldaug25-bernhardt-jumbo.jpg', 'height': 760, 'width': 512, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/25iht-oldaug25-bernhardt/25iht-oldaug25-bernhardt-superJumbo.jpg', 'height': 760, 'width': 512, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/25iht-oldaug25-bernhardt/25iht-oldaug25-bernhardt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/25/blogs/25iht-oldaug25-bernhardt/25iht-oldaug25-bernhardt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/blogs/25iht-oldaug25-bernhardt/25iht-oldaug25-bernhardt-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1889: Sarah Bernhardt’s Courage in Real Death Scene', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bernhardt, Sarah', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-08-24T09:46:36+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c30c632c-5783-59b4-84bc-894adf30f0a3', 'word_count': 127, 'uri': 'nyt://article/c30c632c-5783-59b4-84bc-894adf30f0a3'}, {'abstract': 'Sophisticated hackers are infiltrating video game makers not only to steal credit card numbers, passwords and trade secrets, but also, it turns out, simply for the virtual street cred.', 'web_url': 'https://bits.blogs.nytimes.com/2014/08/24/hackers-target-video-games-for-fun-profit-and-better-scores/', 'snippet': 'Sophisticated hackers are infiltrating video game makers not only to steal credit card numbers, passwords and trade secrets, but also, it turns out, simply for the virtual street cred.', 'lead_paragraph': 'Hackers are breaking into American companies for credit card numbers, passwords, trade secrets and — it turns out — for phony video game scores.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/business/25hack-web1/25hack-web1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/25/business/25hack-web1/25hack-web1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/business/25hack-web1/25hack-web1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/business/25hack-web1/25hack-web1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/25/business/25hack-web1/25hack-web1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'imag