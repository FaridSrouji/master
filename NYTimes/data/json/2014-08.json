3ae81a6', 'word_count': 534, 'uri': 'nyt://article/67a3f8e9-1192-5d03-86d3-fd5423ae81a6'}, {'abstract': 'A&E Networks will invest $250 million in Vice Media and receive a 10 percent stake in the company.', 'web_url': 'https://www.nytimes.com/2014/08/30/business/media/time-warner-ends-negotiations-to-buy-stake-in-vice-media.html', 'snippet': 'A&E Networks will invest $250 million in Vice Media and receive a 10 percent stake in the company.', 'lead_paragraph': 'After spending the summer flirting with various suitors, Vice Media said on Friday that it was close to choosing a partner: A&E Networks.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Vice Media Stakes Future on A&E Networks Deal', 'kicker': None, 'content_kicker': None, 'print_headline': 'Vice Media Stakes Future on A&E Networks Deal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Vice Media Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ARTS & ENTERTAINMENT NETWORK', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cable Television', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Time Warner Inc', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-29T17:10:01+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Jonathan Mahler', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Mahler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/93f6ca9d-923b-53ac-bd37-0a8a3aeb25f9', 'word_count': 823, 'uri': 'nyt://article/93f6ca9d-923b-53ac-bd37-0a8a3aeb25f9'}, {'abstract': 'The Oscar Hammerstein Festival at the Bucks County Playhouse wants to encourage lyricists to engage with sophistication and wit.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/08/29/hammerstein-festival-seeks-to-inspire-great-lyrics/', 'snippet': 'The Oscar Hammerstein Festival at the Bucks County Playhouse wants to encourage lyricists to engage with sophistication and wit.', 'lead_paragraph': 'Robyn Goodman and Alexander Fraser, the directors of the Bucks County Playhouse in New Hope, Pa., are presenting the first Oscar Hammerstein Festival next month. The festival, Sept. 26-28, will offer a weekend of performances and panel discussions, all open to the public. An affiliated yearlong mentorship program intends to remind composers and, particularly, lyricists in the early stages of their careers that musicals were once known for their sophistication and wit, and that they can be again.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hammerstein Festival Seeks to Inspire Great Lyrics', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Hammerstein Festival Starts Next Month', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hammerstein, Oscar II', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bucks County Playhouse', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-08-29T17:14:15+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d658c0e-0765-5a7e-9bcc-0fb86a48d454', 'word_count': 233, 'uri': 'nyt://article/1d658c0e-0765-5a7e-9bcc-0fb86a48d454'}, {'abstract': 'Some classic cars, including a 1962 Ferrari 250 GTO Berlinetta, are setting records at auctions, prom