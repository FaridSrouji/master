ilwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/upshot/07up-prison/07up-prison-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why the Hepatitis Cure Sovaldi Is a Budgetary Disaster for Prisons', 'kicker': 'Losing Cost Control', 'content_kicker': None, 'print_headline': 'Boon for Hepatitis C Patients, Disaster for Prison Budgets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sanger-Katz, Margot', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hepatitis', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sovaldi (Drug)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Budgets and Budgeting', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-08-07T04:31:04+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'The Upshot', 'byline': {'original': 'By Margot Sanger-Katz', 'person': [{'firstname': 'Margot', 'middlename': None, 'lastname': 'Sanger-Katz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dc3626db-2862-57a5-aaea-62702075ccd2', 'word_count': 959, 'uri': 'nyt://article/dc3626db-2862-57a5-aaea-62702075ccd2'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/08/07/arts/television/whats-on-tv-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '6 P.M. (Starz Cinema) THE LAST DAYS OF DISCO (1998) The director Whit Stillman plumbs the malaise of the young and privileged in this tale about the New York nightclub scene of the early 1980s and two young denizens, the confident Charlotte (Kate Beckinsale) and her less-secure college chum Alice (Chloë Sevigny, above right, with Ms. Beckinsale). “We look really good tonight,” Charlotte tells Alice. “I’m sure we’re going to get in.” Janet Maslin wrote in The New York Times: “Humorously and fondly, with an entertaining supply of what he has called ‘prosaic license,’ Mr. Stillman again displays a pitch-perfect ear for both the cattiness and the camaraderie that bind his characters into collective friendship. Weaving together the disco backdrop (clearly a labor of love) with more sharp-edged material about college graduates finding their first footing in New York and learning to cook with Campbell’s mushroom soup, he creates a bright panorama of shrewd young strivers.”', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On TV Thursday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-08-07T05:00:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/9866cdfc-044d-5fb0-b23e-53731fde8712', 'word_count': 696, 'uri': 'nyt://article/9866cdfc-044d-5fb0-b23e-53731fde8712'}, {'abstract': 'Phelps, in his opening event at the United States long-course national championships, looked strong over the first 50 meters but badly misjudged his turn.', 'web_url': 'https://www.nytimes.com/2014/08/07/sports/michael-phelps-returning-to-major-competition-is-7th-in-100-freestyle.html', 'snippet': 'Phelps, in his opening event at the United States long-course national championships, looked strong over the first 50 meters but badly misjudged his turn.', 'lead_paragraph': 'IRVINE, Calif. — For more than a decade, Michael Phelps was known for his numbing consistency. He won swim races in sickness and in health, despite bad starts, poor finishes, untied swim suits and malfunctioning goggles. ', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/sports/SUB-2-CITY-BRIEFS/SUB-2-CITY-BRIEFS-articleLarge.jpg', 'height': 374, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/07/sports/SUB-2-CITY-BRIEFS/SUB-2-CITY-BRIEFS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 374}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/sports/SUB-2-CITY-BRIEFS/SUB-2-CITY-BRIEFS-jumbo.jpg', 'height': 638, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/sports/SUB-2-CITY-BRIEFS/SUB-2-CITY-BRIEFS-superJumbo.jpg', 'height': 1275, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/sports/SUB-2-CITY-BRIEFS/SUB-2-CITY-BRIEFS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/07/sports/SUB-2-CITY-BRIEFS/SUB-2-CITY-BRIEFS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/07/sports/SUB-2-CITY-BRIEFS/SUB-2-CITY-BRIEFS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Michael Phelps, Returning to Major Competition, Is 7th in 100 Freestyle', 'kicker':