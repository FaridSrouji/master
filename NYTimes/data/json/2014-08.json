ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6ba1f143-e4ef-5e11-a718-ae37ca23379c', 'word_count': 1333, 'uri': 'nyt://article/6ba1f143-e4ef-5e11-a718-ae37ca23379c'}, {'abstract': 'The Santa Fe Opera sets “Fidelio” in a concentration camp, though the details of the Holocaust are too abhorrent and too well known to be shoehorned into that work.', 'web_url': 'https://www.nytimes.com/2014/08/04/arts/music/santa-fe-opera-sets-fidelio-in-a-concentration-camp.html', 'snippet': 'The Santa Fe Opera sets “Fidelio” in a concentration camp, though the details of the Holocaust are too abhorrent and too well known to be shoehorned into that work.', 'lead_paragraph': 'SANTA FE, N.M. — No audience members staggered out of the Santa Fe Opera House in search of assistance on Thursday evening after Stephen Wadsworth’s production of Beethoven’s “Fidelio” inspired by Bergen-Belsen. This wasn’t Burkhard C. Kosminski’s staging of Wagner’s “Tannhäuser,” which last year upset audience members in Düsseldorf, Germany, so much with its graphic depiction of gassings and shootings that some required medical attention. Mr. Wadsworth’s concentration-camp spin on the tale of a political prisoner who is liberated by his wife after she has disguised herself as a man and apprenticed with the prison warden was perfectly tasteful.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/FIDELIO/FIDELIO-articleLarge.jpg', 'height': 381, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/04/arts/FIDELIO/FIDELIO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 381}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/FIDELIO/FIDELIO-jumbo.jpg', 'height': 651, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/FIDELIO/FIDELIO-superJumbo.jpg', 'height': 1302, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/FIDELIO/FIDELIO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/08/04/arts/FIDELIO/FIDELIO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/FIDELIO/FIDELIO-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Holocaust Grafted to Beethoven', 'kicker': 'Opera Review', 'content_kicker': None, 'print_headline': 'Holocaust Grafted to Beethoven', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'da Fonseca-Wollheim, Corinna', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Santa Fe Opera', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Beethoven, Ludwig van', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Wadsworth, Stephen', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Fidelio (Opera)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-08-03T21:32:44+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/37b16d13-ef2d-5176-8d10-5525b058b32e', 'word_count': 950, 'uri': 'nyt://article/37b16d13-ef2d-5176-8d10-5525b058b32e'}, {'abstract': 'At the Vail International Dance Festival in Colorado, dancers are paired with colleagues from other companies and dare to try new material.', 'web_url': 'https://www.nytimes.com/2014/08/04/arts/dance/at-damian-woetzels-vail-international-dance-festival.html', 'snippet': 'At the Vail International Dance Festival in Colorado, dancers are paired with colleagues from other companies and dare to try new material.', 'lead_paragraph': 'VAIL, Colo. — High in the Rockies amid pine forests and ski slopes, the Vail International Dance Festival, now in its 26th season, has become an event of prestige, history and startling ambition. Each year, it features premieres, debuts, new partnerships and an admirably eclectic taste. Even for those performers and choreographers who return each year (a large number, and high level), it often opens some new chapter in their careers.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/jpVAIL1/jpVAIL1-articleLarge.jpg', 'height': 667, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/08/04/arts/jpVAIL1/jpVAIL1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 667}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/jpVAIL1/jpVAIL1-jumbo.jpg', 'height': 1024, 'width': 922, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/08/04/arts/jpVAIL1/jpVAIL1-superJumbo.jpg', 'height': 1880, 'width': 1692, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, '