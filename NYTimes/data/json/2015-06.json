'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/802078ff-ee1d-5711-8f6a-89598c2e8266', 'word_count': 1063, 'uri': 'nyt://article/802078ff-ee1d-5711-8f6a-89598c2e8266'}, {'abstract': 'Welcome to Motherlode’s weekly open thread. Do you have thoughts about the news this week, and how it affects families? A question to ask? A rant to share? This is your place. Go.', 'web_url': 'https://parenting.blogs.nytimes.com/2015/06/12/your-turn-a-weekend-thread-open-for-comments-61/', 'snippet': 'Welcome to Motherlode’s weekly open thread. Do you have thoughts about the news this week, and how it affects families? A question to ask? A rant to share? This is your place. Go.', 'lead_paragraph': 'Welcome to Motherlode’s weekly open thread. Do you have thoughts about the news this week, and how it affects families? A question to ask? A rant to share? This is your place. Go.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Your Turn: A Weekend Thread, Open for Comments', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-12T04:56:33+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'U.S.', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9c6ec0c-849f-5ded-bf99-6c025c7607f1', 'word_count': 33, 'uri': 'nyt://article/e9c6ec0c-849f-5ded-bf99-6c025c7607f1'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/06/12/arts/television/whats-on-tv-friday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8:45 A.M. (Sundance) DOMINO (2005) Keira Knightley stars as Domino Harvey, the daughter of a jet-setting mother and the movie actor Laurence Harvey, who, despite her privileged upbringing, became a bounty hunter in South Central Los Angeles. Writing in The New York Times, Manohla Dargis called this biopic, whose ensemble cast features Mickey Rourke, Christopher Walken, Delroy Lindo, Jacqueline Bisset, Dabney Coleman and Mo’Nique, a “lollapalooza of delectable cheap thrills.” What makes it “the ultimate Tony Scott movie — or as a friend put it, ‘It’s all the Tony Scott you could possibly want in a Tony Scott movie!’ — is its uncharacteristically sharp screenplay,” she said of its script by Richard Kelly. “Mr. Scott has worked with talented writers before, but this is the first time he has shot a film written by a screenwriter who both cops to the great enjoyment that can be had from the modern action movie — perhaps best illustrated here by the sight of Ms. Knightley unloading two machine guns at once — and blows the action-movie tropes to smithereens.”', 'print_section': 'C', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Friday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What&#8217;s On TV Friday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-12T05:00:06+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/c53ee097-f55a-5d75-960f-3426f6973ec9', 'word_count': 725, 'uri': 'nyt://article/c53ee097-f55a-5d75-960f-3426f6973ec9'}, {'abstract': 'Quotation of the Day for Friday, June 12, 2015.', 'web_url': 'https://www.nytimes.com/2015/06/12/pageoneplus/quotation-of-the-day.html', 'snippet': 'Quotation of the Day for Friday, June 12, 2015.', 'lead_paragraph': '“There are dead fish in my living room.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-12T05:18:47+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/882740f1-c66b-5b75-bf82-4a54d7069959', 'word_count': 27, 'uri': 'nyt://article/882740f1-c66b-5b75-bf82-4a54d7069959'}, {'abstract': 'Corrections appearing in print on Friday, June 12, 2015.', 'web_url': 'https://www.nytimes.com/2015/06/12/pageoneplus/corrections-june-12-2015.html', 'snippet': 'Corrections appearing in print on Friday, June 12, 2015.', 'lead_paragraph': 'INTERNATIONAL', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: June 12, 2015', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-12T05:18:49+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5036b021-88bb-5c69-b8d9-2365c503d4b7', 'word_count': 630, 'uri': 'nyt://article/5036b021-88bb-5c69-b8d9-2365c503d4b7'}, {'abstract': 'Smuggling is an integral way of life in Kurdish villages where, for many, there is no other way to earn a living. It is a business that some families have practiced for generations.', 'web_url': 'https://lens.blogs.nytimes.com/2015/06/12/following-smugglers-in-kurdistan/', 'snippet': 'Smuggling is an integral way of life in Kurdish villages where, for many, there is no other way to earn a living. It is a business that some families have practiced for generations.', 'lead_paragraph': 'Born in the Sulaimaniyah Governorate of Iraqi Kurdistan, Aram Karim had long been aware of the smugglers whose covert businesses, ferrying all manner of goods, operated along the borders that fragmented his native land. Granted, he had a personal insight from years ago: He had tried — and failed — to be smuggled into Turkey three times. Yet while the struggles of these impoverished villagers living on the margins were widely known, they were rarely documented.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Following Smugglers in Kurdistan', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-12T07:00:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By ANIA BARTKOWIAK', 'person': [{'firstname': 'Ania', 'middlename': None, 'lastname': 'BARTKOWIAK', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/627835a1-d8d8-5307-a20c-418585327a54', 'word_count': 880, 'uri': 'nyt://article/627835a1-d8d8-5307-a20c-418585327a54'}, {'abstract': 'Smuggling is an integral way of life in Kurdish villages where, for many, there is no other way to earn a living. It is a business that some families have practiced for generations.', 'web_url': 'https://lens.blogs.nytimes.com/2015/06/12/following-smugglers-in-kurdistan/', 'snippet': 'Smuggling is an integral way of life in Kurdish villages where, for many, there is no other way to earn a living. It is a business that some families have practiced for generations.', 'lead_paragraph': 'Born in the Sulaimaniyah Governorate of Iraqi Kurdistan, Aram Karim had long been aware of the smugglers whose covert businesses, ferrying all manner of goods, operated along the borders that fragmented his native land. Granted, he had a personal insight from years ago: He had tried — and failed — to be smuggled into Turkey three times. Yet while the struggles of these impoverished villagers living on the margins were widely known, they were rarely documented.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Following Smugglers in Kurdistan', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kurds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smuggling', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Karim, Aram (Photographer)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-06-12T07:00:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Ania Bartkowiak', 'person': [{'firstname': 'Ania', 'middlename': None, 'lastname': 'Bartkowiak', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c3aa57d-0978-5861-8119-f074da7722ff', 'word_count': 880, 'uri': 'nyt://article/6c3aa57d-0978-5861-8119-f074da7722ff'}, {'abstract': 'The “Odyssey Years” before age 30 are a crucial part of American adults’ formation.', 'web_url': 'https://www.nytimes.com/2015/06/12/opinion/david-brooks-how-adulthood-happens.html', 'snippet': 'The “Odyssey Years” before age 30 are a crucial part of American adults’ formation.', 'lead_paragraph': 'Every society has its rites of passage, marking the transition from youth to adulthood. Most of these rites of passage are ritualized and structured, with adult supervision and celebration. But the major rite of passage in our society is unritualized, unstructured and unnamed. Most of the people in the middle of it don’t even know it is going on. It happens between ages 22 and 30.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/brooks-circular/brooks-circular-articleLarge-v2.jpg', 'height': 588, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/01/opinion/brooks-circular/brooks-circular-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 588}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/brooks-circular/brooks-circular-jumbo-v5.jpg', 'height': 1003, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/brooks-circular/brooks-circular-superJumbo-v5.jpg', 'height': 1852, 'width': 1891, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/brooks-circular/brooks-circular-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/brooks-circular/brooks-circular-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/brooks-circular/brooks-circular-thumbLarge-v7.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Adulthood Happens', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'How  Adulthood  Happens', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Age, Chronological', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Arum, Richard', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Roksa, Josipa', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 9, 'major': 'N'}, {'name': 'creative_works', 'value': 'Aspiring Adults Adrift: Tentative Transitions of College Students (Book)', 'rank': 10, 'major': 'N'}], 'pub_date': '2015-06-12T07:21:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Brooks', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/25a3c12a-7314-5278-a439-9b563d2dd71e', 'word_count': 797, 'uri': 'nyt://article/25a3c12a-7314-5278-a439-9b563d2dd71e'}, {'abstract': 'The financial crisis has given remarkable staying power to false explanations of big events. And they continue to warp policy.', 'web_url': 'https://www.nytimes.com/2015/06/12/opinion/paul-krugman-seriously-bad-ideas.html', 'snippet': 'The financial crisis has given remarkable staying power to false explanations of big events. And they continue to warp policy.', 'lead_paragraph': 'Oxford, Britain — One thing we’ve learned in the years since the financial crisis is that seriously bad ideas — by which I mean bad ideas that appeal to the prejudices of Very Serious People — have remarkable staying power. No matter how much contrary evidence comes in, no matter how often and how badly predictions based on those ideas are proved wrong, the bad ideas just keep coming back. And they retain the power to warp policy.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-articleLarge-v2.jpg', 'height': 591, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 591}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-jumbo-v5.jpg', 'height': 1008, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-superJumbo-v5.jpg', 'height': 1852, 'width': 1881, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbLarge-v7.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seriously Bad Ideas', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Seriously  Bad  Ideas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Great Britain', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Krugman, Paul', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Osborne, George', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-06-12T07:21:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c20be67d-7742-5e1d-bd93-67fece73eb7f', 'word_count': 787, 'uri': 'nyt://article/c20be67d-7742-5e1d-bd93-67fece73eb7f'}, {'abstract': 'Readers express concern about the hardships imposed on women seeking abortions by a law a federal court just upheld.', 'web_url': 'https://www.nytimes.com/2015/06/12/opinion/the-effects-of-texas-abortion-laws.html', 'snippet': 'Readers express concern about the hardships imposed on women seeking abortions by a law a federal court just upheld.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Effects of Texas’ Abortion Laws', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'The Effects of Texas’ Abortion Laws', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Texas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-06-12T07:21:05+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/d68753bb-2471-5e72-a1de-aede157aefb2', 'word_count': 441, 'uri': 'nyt://article/d68753bb-2471-5e72-a1de-aede157aefb2'}, {'abstract': 'A reader writes that he “should have the option of charging for advertising” on his private property.', 'web_url': 'https://www.nytimes.com/2015/06/12/opinion/on-not-sharing-my-data.html', 'snippet': 'A reader writes that he “should have the option of charging for advertising” on his private property.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Not Sharing My Data', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'On Not Sharing My Data', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Data-Mining and Database Marketing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-12T07:21:05+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/f99fa414-175b-5ab3-8a1d-5e23add9143f', 'word_count': 94, 'uri': 'nyt://article/f99fa414-175b-5ab3-8a1d-5e23add9143f'}, {'abstract': 'The drug should only be approved if measures are taken to reduce safety concerns.', 'web_url': 'https://www.nytimes.com/2015/06/12/opinion/a-pill-to-boost-female-libido.html', 'snippet': 'The drug should only be approved if measures are taken to reduce safety concerns.', 'lead_paragraph': 'A federal advisory panel has recommended that the Food and Drug Administration approve the first drug to treat a lack of sexual desire in otherwise healthy women. Some women’s groups are hailing this as a breakthrough in gender equality, a start to closing the gap between men, who have numerous drugs to treat sexual dysfunction, and women, who have none. But the panel’s recommendation was laced with so many caveats that it seems clear that this particular drug — flibanserin — is only marginally effective and carries some risk of serious adverse effects.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/opinion/11fri2/11fri2-articleLarge.jpg', 'height': 739, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/12/opinion/11fri2/11fri2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 739}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/opinion/11fri2/11fri2-jumbo.jpg', 'height': 1024, 'width': 832, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/opinion/11fri2/11fri2-superJumbo.jpg', 'height': 1684, 'width': 1368, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/opinion/11fri2/11fri2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/12/opinion/11fri2/11fri2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/opinion/11fri2/11fri2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Pill to Boost Female Libido', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Pill to Boost Female Libido', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Sprout Pharmaceuticals Inc', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sex', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-06-12T07:21:18+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/c1a2c7ce-5eec-5832-883c-a8b32c669302', 'word_count': 519, 'uri': 'nyt://article/c1a2c7ce-5eec-5832-883c-a8b32c669302'}, {'abstract': 'Pre-K for all shouldn’t reinforce economic segregation.', 'web_url': 'https://www.nytimes.com/2015/06/12/opinion/let-rich-and-poor-learn-together.html', 'snippet': 'Pre-K for all shouldn’t reinforce economic segregation.', 'lead_paragraph': 'THE mayor of New York City, Bill de Blasio, campaigned on a promise to provide free universal pre-K classes to more than 70,000 4-year-olds. The city is now poised to meet this ambitious goal.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/opinion/12Hemphill/12Hemphill-articleLarge.jpg', 'height': 417, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/