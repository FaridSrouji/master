': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/05/26/us/02taxidermy-promo2/20150526taxidermy-slide-TC9Z-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/05/26/us/02taxidermy-promo2/20150526taxidermy-slide-TC9Z-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/05/26/us/02taxidermy-promo2/20150526taxidermy-slide-TC9Z-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/05/26/us/02taxidermy-promo2/20150526taxidermy-slide-TC9Z-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/05/26/us/02taxidermy-promo2/20150526taxidermy-slide-TC9Z-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/05/26/us/02taxidermy-promo2/20150526taxidermy-slide-TC9Z-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/05/26/us/02taxidermy-promo2/20150526taxidermy-slide-TC9Z-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Masters of Taxidermy Seek to Replicate More Than an Animal’s Appearance', 'kicker': 'Springfield Journal', 'content_kicker': None, 'print_headline': 'Human Face of Taxidermy Changes, but Animal Heads Stay Mounted', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject'