rce': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/15/t-magazine/15symonds-hasbeens2/15symonds-hasbeens2-articleLarge-v3.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/15/t-magazine/15symonds-hasbeens2/15symonds-hasbeens2-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/15/t-magazine/15symonds-hasbeens2/15symonds-hasbeens2-jumbo-v3.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/15/t-magazine/15symonds-hasbeens2/15symonds-hasbeens2-superJumbo-v3.jpg', 'height': 1384, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/15/t-magazine/15symonds-hasbeens2/15symonds-hasbeens2-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/15/t-magazine/15symonds-hasbeens2/15symonds-hasbeens2-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/15/t-magazine/15symonds-hasbeens2/15symonds-hasbeens2-thumbLarge-v5.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fashion’s Ex-Enfant Terrible Launches an Auction House', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 