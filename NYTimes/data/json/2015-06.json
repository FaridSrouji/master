r': 'N'}], 'pub_date': '2015-06-01T20:51:44+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Michiko Kakutani', 'person': [{'firstname': 'Michiko', 'middlename': None, 'lastname': 'Kakutani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e1e1b7fa-1f61-5035-b109-3632e2d56575', 'word_count': 803, 'uri': 'nyt://article/e1e1b7fa-1f61-5035-b109-3632e2d56575'}, {'abstract': 'Three of the Tony-nominated new musicals still had good news to report.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/06/01/on-eve-of-tony-awards-broadway-box-office-dips/', 'snippet': 'Three of the Tony-nominated new musicals still had good news to report.', 'lead_paragraph': 'After a big Memorial Day weekend brought a strong end to a record-breaking season, Broadway’s box office sales sagged a bit last week.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Eve of Tony Awards, Broadway Box Office Dips', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Javerbaum, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Parsons, Jim', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-01T20:53:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Michael Paulson', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Paulson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aeb4cfa5-a91d-5c69-974c-95822f24793a', 'word_count': 300, 'uri': 'nyt://article/aeb4cfa5-a91d-5c69-974c-95822f24793a'}, {'abstract': 'The Chequit on Shelter Island reopens, and boasts a new restaurant.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/06/01/chequit-shelter-island/', 'snippet': 'The Chequit on Shelter Island reopens, and boasts a new restaurant.', 'lead_paragraph': 'Finding a place to stay in the Hamptons during the summer can be a greater headache than the traffic, hence the anticipated reopening of the Chequit on Shelter Island. Built in 1872 as a dining hall for a local Methodist group, it has been transformed into a quaint boutique hotel with bright, airy rooms overlooking the harbor. There’s also a new restaurant, Red Maple — named after the towering tree in the center of the outdoor terrace — that serves up small plates such as smoked bluefish rillettes and oysters from nearby Montauk. ', 'print_section': 'M2', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/t-magazine/14beauty-look-chequit/14beauty-look-chequit-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/14/t-magazine/14beauty-look-chequit/14beauty-look-chequit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/t-magazine/14beauty-look-chequit/14beauty-look-chequit-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/t-magazine/14beauty-look-chequit/14beauty-look-chequit-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/t-magazine/14beauty-look-chequit/14beauty-look-chequit-thumbStandard.jpg',