ard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/17/arts/17starr-1-obit-web/17starr-1-obit-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Blaze Starr, Burlesque Queen Who Was Linked to a Governor, Dies at 83', 'kicker': None, 'content_kicker': None, 'print_headline': 'Blaze Starr, 83, Burlesque Queen Tied to Scandal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Strip Clubs and Strippers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Burlesque', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Long, Earl K (1895-1960)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Starr, Blaze (1932-2015)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-06-16T04:28:16+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'U.S.', 'byline': {'original': 'By Ashley Southall', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Southall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/80b99a58-0e38-541d-9db2-e2683b541083', 'word_count': 836, 'uri': 'nyt://article/80b99a58-0e38-541d-9db2-e2683b541083'}, {'abstract': 'The Aldeburgh Festival presented these two chamber operas, which draw from the story of Orpheus and Eurydice, and an episode in the varied life of Medea.', 'web_url': 'https://www.nytimes.com/2015/06/16/arts/music/review-harrison-birtwistles-the-cure-and-the-corridor-myths-with-a-twist.html', 'snippet': 'The Aldeburgh Festival presented these two chamber operas, which draw from the story of Orpheus and Eurydice, and an episode in the varied life of Medea.', 'lead_paragraph': 'SNAPE, England — Harrison Birtwistle was once a radical presence at the Aldeburgh Festival. At the 1968 premiere of his violent production of seaside puppetry, “Punch and Judy,” the festival’s appalled founders, Benjamin Britten and Peter Pears, not so quietly excused themselves from the sonic carnage.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/16/arts/16BIRTWISTLE1/16BIRTWISTLE1-articleLarge.jpg', 'height': 375, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/16/arts/16BIRTWISTLE1/16BIRTWISTLE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 375}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/16/arts/16BIRTWISTLE1/16BIRTWISTLE1-jumbo.jpg', 'height': 640, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/16/arts/16BIRTWISTLE1/16BIRTWISTLE1-superJumbo.jpg', 'height': 1280, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/16/arts/16BIRTWISTLE1/16BIRTWISTLE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/16/arts/16BIRTWISTLE1/16BIRTWISTLE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/16/arts/16BIRTWISTLE1/16BIRTWISTLE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Harrison Birtwistle’s ‘The Cure’ and ‘The Corridor,’ Myths With a Twist', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Double Bill of Myths From Unexpected Perspectives ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Allen, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Opera', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Birtwistle, Harrison', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'England', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Padmore, Mark', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Festivals', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Corridor (Opera)', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Cure (Opera)', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Atherton, Elizabeth', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Harsent, David (1942- )', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-06-16T04:54:19+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By David Allen', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Allen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f91a7ee6-605d-53d5-932a-413e7416d7b2', 'word_count': 777, 'uri': 'nyt://article/f91a7ee6-605d-53d5-932a-413e7416d7b2'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/06/16/arts/television/whats-on-tv-tuesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '10 P.M. (TNT) PROOF Parachuting off Mount Everest doesn’t faze Ivan Turing, a tech wizard with a referential surname and a fondness for Steve Jobsian turtlenecks. But terminal cancer has given him pause. “I’ve always hated unknowns,” he tells Dr. Carolyn Tyler, a cardiothoracic surgeon with little patience for speculation and a wellspring of grief all her own. “And now that I’m facing the biggest one there is, I want to know what to expect.” His offer: He’ll give her control of his $10 billion estate if she’ll help him prove what, if anything, exists after the body flat lines. Beautiful minds (and some intriguingly nutty concepts) collide in this new series, which stars Jennifer Beals and Matthew Modine, and counts Kyra Sedgwick among its executive producers. As Dr. Tyler investigates the murky realm that believers call the afterlife, the doctor in her chafes at the notion that the nearly dead share experiences that science can’t explain. But as the mother of a teenage son killed a year earlier, she can’t help but want to believe herself.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Tuesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What&#8217;s On TV Tuesday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-16T05:00:04+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/b62c5edb-a896-576a-8755-417d53a73f80', 'word_count': 718, 'uri': 'nyt://article/b62c5edb-a896-576a-8755-417d53a73f80'}, {'abstract': 'Sony showed off its lineup of PlayStation 4 games on Monday at the start of the E3 conference, including the whimsical titles The Last Guardian and Dreams.', 'web_url': 'https://bits.blogs.nytimes.com/2015/06/16/sony-previews-game-lineup-at-e3/', 'snippet': 'Sony sh