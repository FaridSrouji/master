b_date': '2015-06-19T21:25:41+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4ab111cf-dbfd-53a7-b115-ce6d2fdfa3c5', 'word_count': 0, 'uri': 'nyt://slideshow/4ab111cf-dbfd-53a7-b115-ce6d2fdfa3c5'}, {'abstract': 'A new project from Robert Herman explores world cities with images similar to analog work from past decades.', 'web_url': 'https://www.nytimes.com/2015/06/21/nyregion/robert-herman-squares-new-photos-with-past-work-using-an-iphone-app.html', 'snippet': 'A new project from Robert Herman explores world cities with images similar to analog work from past decades.', 'lead_paragraph': 'For decades, Robert Herman shot street photography mainly in New York and primarily on Kodachrome film. Mr. Herman was born in Brooklyn and raised on Long Island and began shooting on the city streets in the late 1970s while working as a set photographer. “There’s a lot of time between takes, so I started taking photos in the neighborhoods where we were shooting,” he said.', 'print_section': 'MB', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Robert Herman Squares New Photos With Past Work, Using an iPhone App', 'kicker': 'Album', 'content_kicker': None, 'print_headline': 'Finding It Hip to Be Square', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Correal, Annie', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Herman, Robert', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'iPhone', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 7, 'major': 'N'}], 'pu