}], 'pub_date': '2015-06-20T00:02:38+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Kevin Allison', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'Allison', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bdf9755-7d53-5555-96cd-ffde2f861f42', 'word_count': 369, 'uri': 'nyt://article/6bdf9755-7d53-5555-96cd-ffde2f861f42'}, {'abstract': 'Testimony of the death of a 6-year-old concluded the prosecution’s case against Mr. Holmes, who could face the death penalty over a theater shooting in Aurora, Colo.', 'web_url': 'https://www.nytimes.com/2015/06/20/us/testimony-in-james-holmes-trial-of-gunfire-and-loss.html', 'snippet': 'Testimony of the death of a 6-year-old concluded the prosecution’s case against Mr. Holmes, who could face the death penalty over a theater shooting in Aurora, Colo.', 'lead_paragraph': 'DENVER — As the movie theater lights dimmed and the previews rolled, Ashley Moser shifted her 6-year-old daughter, Veronica, off her lap and into the seat next to her. Ms. Moser had just learned she was pregnant, and Veronica’s bony frame hurt her stomach, she testified\xa0on Friday. They were sitting side-by-side in the dark when the gunman walked in, lobbed a gas canister and opened fire.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/20/us/20aurora/20aurora-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/20/us/20aurora/20aurora-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/20/us/20au