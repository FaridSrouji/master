dline': {'main': 'Classical Music This Week: Kirill\xa0Petrenko in Berlin, Gunther Schuller and Roomful of Teeth', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Petrenko, Kirill (1972- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mussorgsky, Modest Petrovich', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Schuller, Gunther', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Lindberg, Magnus', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Oppens, Ursula', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-06-24T12:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Zachary Woolfe', 'person': [{'firstname': 'Zachary', 'middlename': None, 'lastname': 'Woolfe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/346ecaed-f748-5ef6-9db3-7f67be9c522c', 'word_count': 499, 'uri': 'nyt://article/346ecaed-f748-5ef6-9db3-7f67be9c522c'}, {'abstract': 'Times critics share what they’ve been listening to lately.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/06/24/classical-playlist-rihm-brahms-glass-and-messiaen/', 'snippet': 'Times critics share what they’ve been listening to lately.', 'lead_paragraph': 'RIHM: ‘Et Lux’ Paul Van Nevel, conductor; Huelgas Ensemble; Minguet Quartet(ECM)This eerie and uncomfortably hypnotic hourlong work for vocal ensemble and string quartet is a setting of the words of the Latin Requiem Mass, but not in any functional liturgical order. Instead, the text fragments, veiled by a gauzy haze of strings, appear like brittle remnants of a ritual half-forgotten. The Minguet Quartet plays the queasy dissonances and occasional snatches of almost-familiar tonal material with wonderful transparency; the voices of the Huelgas Ensemble are pure and airy conduits of the eternal light evoked in the title. (Corinna da Fonseca-Wollheim)', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24playlist/24playlist-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/24/arts/24playlist/24playlist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24playlist/24playlist-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24playlist/24playlist-superJumbo.jpg', 'height': 1369, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24playlist/24playlist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/24/arts/24playlist/24playlist-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24playlist/24playlist-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Classical Playlist: Rihm, Brahms, Glass and Messiaen', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}], 'pub_date':