': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ahmed Zayat’s Journey: Bankruptcy and Big Bets', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bankruptcy, Big Bets, and Maybe a Triple Crown ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Horse Racing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Belmont Stakes', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Zayat, Ahmed', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Zayat Stables', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'American Pharoah (Race Horse)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Fifth Third Bank', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Triple Crown (Horse Racing)', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-06-04T20:57:55+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Joe Drape', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Drape', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c00669c-dd55-57d3-82a0-afb3d3ee465b', 'word_count': 2543, 'uri': 'nyt://article/6c00669c-dd55-57d3-82a0-afb3d3ee465b'}, {'abstract': 'The Republican party has 16 major presidential candidates this cycle — three times the number of Democrats and more than any other field in recent history.', 'web_url': 'https://www.nytimes.com/interactive/2015/06/04/us/politics/stacking-up-the-presidential-fields.html', 'snippet': 'The Republican party has 16 major presidential candidates this cycle — three times the number of Democrats and more than any other field in recent history.', 'lead_paragraph': 'The Republican party has 16 major presidential candidates this cycle — three times the number of Democrats and more than any other field in recent history.', 'source': 'The N