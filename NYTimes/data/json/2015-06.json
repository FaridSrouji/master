': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Review: Jeremy Jordan, Take-No-Prisoners Heartthrob, Has a New Cabaret Act', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Go-Getter Who Defies Gravity ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jordan, Jeremy (1984- )', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-26T21:35:18+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6abf436d-4b6f-5751-8c73-4faec6a1a03d', 'word_count': 358, 'uri': 'nyt://article/6abf436d-4b6f-5751-8c73-4faec6a1a03d'}, {'abstract': 'Seeking meaning in abstract photographic views of Earth from orbit or inside a split stone.', 'web_url': 'https://dotearth.blogs.nytimes.com/2015/06/26/earth-as-art-from-near-inside-a-stone-and-far-the-space-station/', 'snippet': 'Seeking meaning in abstract photographic views of Earth from orbit or inside a split stone.', 'lead_paragraph': 'NASA astronaut Scott Kelly, who is 91 days into a yearlong mission as commander of the International Space Station, has been posting strings of photographs of our remarkable planet on Twitter using the hashtags #EarthArt and #YearInSpace. Here are a few examples from earlier in June: ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/blogs/dotkellyearthart/dotkellyearthart-articleLarge.jpg', 'height': 402, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/26/bl