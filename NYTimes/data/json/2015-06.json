nding-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/15/blogs/Trending/Trending-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What’s Trending on Trending', 'kicker': 'Times Insider', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Social Media', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-06-16T09:45:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Priya Ollapally', 'person': [{'firstname': 'Priya', 'middlename': None, 'lastname': 'Ollapally', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ba11fba6-4216-57a9-8d41-49feb0a2756b', 'word_count': 316, 'uri': 'nyt://article/ba11fba6-4216-57a9-8d41-49feb0a2756b'}, {'abstract': 'Soccer officials decry an imperialist plot, as Western boosters claim a triumph of liberal values. Both are phony.', 'web_url': 'https://www.nytimes.com/2015/06/17/opinion/-2015-06-17-opinion-malik-the-corrupt-rhetoric-of-the-fifa-scandalhtml.html', 'snippet': 'Soccer officials decry an imperialist plot, as Western boosters claim a triumph of liberal values. Both are phony.', 'lead_paragraph': 'LONDON — “We have fought colonialism and defeated it and we still fight imperialism and we will fight it whenever it manifests itself.” So claimed South Africa’s sports minister, Fikile Mbalula, recently. He was talking not of war or invasion but about the F.B.I.’s investigation into corruption involving FIFA, world soccer’s governing body. Other officials from Africa, Asia and the Caribbean have expressed similar sentiments.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/04/opinion/Malik-contributor/contributors-images-slide-RPHF-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2013/10/04/opinion/Malik-contributor/contributors-images-slide-RPHF-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/04/opinion/Malik-contributor/contributors-images-slide-RPHF-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/04/opinion/Malik-contributor/contributors-images-slide-RPHF-superJumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/04/opinion/Malik-contributor/contributors-images-slide-RPHF-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2013/10/04/opinion/Malik-contributor/contributors-images-slide-RPHF-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2013/10/04/opinion/Malik-contributor/contributors-images-slide-RPHF-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Corrupt Rhetoric of the FIFA Scandal', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'The Corrupt Rhetoric of the FIFA Scandal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'n