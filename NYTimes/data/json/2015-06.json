umbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/sports/SUB-Y-CLAREY-1/SUB-Y-CLAREY-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/02/sports/SUB-Y-CLAREY-1/SUB-Y-CLAREY-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/sports/SUB-Y-CLAREY-1/SUB-Y-CLAREY-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Djokovic vs. Nadal: A Quarterfinal That Feels Like a Final', 'kicker': 'On Tennis', 'content_kicker': None, 'print_headline': 'A Quarterfinal That Feels Like a Final ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clarey, Christopher', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Djokovic, Novak', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nadal, Rafael', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Federer, Roger', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'French Open (Tennis)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Murray, Andy (1987- )', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-06-01T18:57:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Christopher Clarey', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Clarey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2282b148-dcaf-5430-8137-ce7b34cabcc2', 'word_count': 1207, 'uri': 'nyt://article/2282b148-dcaf-5430-8137-ce7b34cabcc2'}, {'abstract': 'So many large, plant-eating animals coexist in Africa because each species has its own diet, a new study concludes.', 'web_url': 'https://www.nytimes.com/2015/06/02/science/herbivores-of-varied-tastes.html', 'snippet': 'So many large, plant-eating animals coexist in Africa because each species has its own diet, a new study concludes.', 'lead_paragraph': 'How is it possible that so many large herbivores coexist in Africa? That incredible diversity is possible because each species has a distinct diet, a new study concludes. Little is known about the specific plants that elephants, impalas, zebras and other large herbivores eat. With a technique called DNA metabarcoding, researchers at Princeton University analyzed the feces of seven species, matching gene sequences they found to a reference library of plant DNA. All of the species consumed different diets, the scientists found, even those similar in size, digestive physiology and location. The findings, which appear in the Proceedings of the National Academy of the Sciences, may help researchers maintain wildlife diversity in the African savannas.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/science/02FLOATER/02FLOATER-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/02/science/02FLOATER/02FLOATER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/science/02FLOATER/02FLOATER-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/science/02FLOATER/02FLOATER-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name