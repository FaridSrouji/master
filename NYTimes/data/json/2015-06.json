l Health and Disorders', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN PSYCHIATRIC ASSN', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 11, 'major': 'N'}, {'name': 'creative_works', 'value': 'Diagnostic and Statistical Manual of Mental Disorders (Book)', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-06-24T20:25:37+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Jenna Wortham', 'person': [{'firstname': 'Interview', 'middlename': 'Jenna', 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cc35a640-aeb1-5192-9afb-344ab6ffeeac', 'word_count': 1341, 'uri': 'nyt://article/cc35a640-aeb1-5192-9afb-344ab6ffeeac'}, {'abstract': '“I Don’t Poem” features painters’ work alongside their poetry.', 'web_url': 'https://www.nytimes.com/2015/06/28/books/review/canvas-and-verse.html', 'snippet': '“I Don’t Poem” features painters’ work alongside their poetry.', 'lead_paragraph': 'When the writer Claudia La Rocco asked several visual artists if they also wrote poetry, Don Voisine told her: “I don’t poem.” That cheeky response ultimately became the title of a book La Rocco edited featuring painters’ work alongside their verse. Its contributors include Voisine, who, it turns out, does, at least on occasion, poem.', 'print_section': 'BR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/books/review/28openbook-1/28openbook-1-articleLarge.jpg', 'height': 473, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/28/books/review/28openbook-1/28openbook-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 473}}, {'rank': 0, 'subtype': 'jumbo',