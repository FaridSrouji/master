major': 'N'}], 'pub_date': '2015-06-05T08:59:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Mikhail Iossel', 'person': [{'firstname': 'Mikhail', 'middlename': None, 'lastname': 'Iossel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/649433d4-7270-5a7f-93cc-ab597a830efd', 'word_count': 372, 'uri': 'nyt://article/649433d4-7270-5a7f-93cc-ab597a830efd'}, {'abstract': 'When an Internet connection was as spotty as it was essential.', 'web_url': 'https://www.nytimes.com/2015/06/07/magazine/hit-send-then-pray.html', 'snippet': 'When an Internet connection was as spotty as it was essential.', 'lead_paragraph': 'We lived on a hill in a mountainous region of Maharashtra, India. The 200 16- and 17-year-old boarding-school students were from nearly every corner of the world. The Internet connection was unreliable, as was the power plant generating electricity for the entire school. Communicating with our families was a matter of calcu\xadlating probabilities: The longer it took to write an email, the higher the chance of losing your Internet connection.', 'print_section': 'MM', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/magazine/07magicmail/07mag-07watchessidebar-t_CA0-articleLarge.png', 'height': 657, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/07/magazine/07magicmail/07mag-07watchessidebar-t_CA0-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 657}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/magazine/07magicmail/07mag-07watchessidebar-t_CA0-jumbo.png', 'height': 1024, 'width': 935, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, 