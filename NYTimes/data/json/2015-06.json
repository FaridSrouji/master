/realestate/28HUNTMAIN/28HUNTMAIN-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/realestate/28HUNTMAIN/28HUNTMAIN-superJumbo.jpg', 'height': 1368, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/realestate/28HUNTMAIN/28HUNTMAIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/28/realestate/28HUNTMAIN/28HUNTMAIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/realestate/28HUNTMAIN/28HUNTMAIN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Token of Affection With a Manhattan View', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Token of Affection With a View ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cohen, Joyce', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-25T12:59:04+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Joyce Cohen', 'person': [{'firstname': 'Joyce', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/181f1c53-89d8-5da8-a5f7-47c13fbe3d13', 'word_count': 950, 'uri': 'nyt://article/181f1c53-89d8-5da8-a5f7-47c13fbe3d13'}, {'abstract': 'Grayson Perry attempts to illuminate the complicated contradictions of modern art and the world of dealers, collectors and tastemakers that surrounds it.', 'web_url': 'https://www.nytimes.com/2015/06/28/books/review/playing-to-the-gallery-by-grayson-perry.html', 'snippet': 'Grayson Perry attempts to illuminate the complicated contradictions of modern art and the world of dealers, collectors and tastemakers that surrounds it.', 'lead_paragraph': 'In the 1990s, Britain suddenly developed a hugely popular appreciation for contemporary art, and the potter Grayson Perry has been one of its beneficiaries. Known for making vessels covered with erotic imagery and texts that address subjects like sex, war and child abuse, he’s the master of what the British magazine Ceramic Review once termed “shock art on a pot.” Perry’s frank-talking, cross-dressing persona only adds to his appeal: A long-married father of one, he speaks in a strong London accent and delights in appearing in women’s makeup and clothing.', 'print_section': 'BR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Playing to the Gallery,’ by Grayson Perry', 'kicker': None, 'content_kicker': None, 'print_headline': 'Exhibit A', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Grayson', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Playing to the Gallery (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-06-25T13:00:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Carol Kino', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Kino', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5c028250-32a7-5db2-81ba-00695eb10423', 'word_count': 662, 'uri': 'nyt://article/5c028250-32a7-5db2-81ba-00695eb10423'}, {'abstract': 'Cy Twombly’s last paintings celebrate his lifelong interest in flowers, Greek mythology, ships and the sea, and lines of enigmatic writing.', 'web_url': 'https://www.nytimes.com/2015/06/28/books/review/cy-twombly-late-paintings-2003-2011-by-nela-pavlouskova.html', 'snippet': 'Cy Twombly’s last paintings celebrate his lifelong interest in flowers, Greek mythology, ships and the sea, and lines of enigmatic writing.', 'lead_paragraph': 'Painters in their old age present an interesting spectrum. André Derain and Giorgio de Chirico, who had been so shocking, drifted off after World War I in a conservative, neoclassical direction (De Chirico even faked his trademark earlier metaphysical paintings from time to time). Titian did some of his greatest work into his 80s; Jasper Johns continues to hold his own as a master. De Kooning painted despite dementia, with contested results.', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/books/review/28WHITE/28WHITE-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/28/books/review/28WHITE/28WHITE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/books/review/28WHITE/28WHITE-jumbo.jpg', 'height': 695, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/books/review/28WHITE/28WHITE-superJumbo.jpg', 'height': 1391, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/books/review/28WHITE/28WHITE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/28/books/review/28WHITE/28WHITE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/books/review/28WHITE/28WHITE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Cy Twombly: Late Paintings 2003-2011,’ by Nela Pavlouskova', 'kicker': None, 'content_kicker': None, 'print_headline': 'Twombly', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Pavlouskova, Nela', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Twombly, Cy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-06-25T13:00:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Edmund White', 'person': [{'firstname': 'Edmund', 'middlename': None, 'lastname': 'White', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8a98010a-4e69-5a96-9024-5c3a69df843c', 'word_count': 890, 'uri': 'nyt://article/8a98010a-4e69-5a96-9024-5c3a69df843c'}, {'abstract': 'Julien de Casabianca has hit the streets of over 17 cities with art that he photographed, printed in large proportions and then pasted onto whatever surfaces move him.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/06/25/julien-de-casabianca-outings-project/', 'snippet': 'Julien de Casabianca has hit the streets of over 17 cities with art that he photographed, printed in large proportions and then pasted onto whatever surfaces move him.', 'lead_paragraph': 'In 1877, William-Adolphe Bouguereau painted “Le Jeunesse et l’Amour,” a sensuous nude shouldering a playful angel, a work now hanging on the main level of the Musée d’Orsay. In early June, Julien de Casabianca pasted an oversize simulacrum of the figures on the wall of a nondescript building in the 18th Arrondissement. The wall just so happened to be between two food distribution businesses run by Muslim men. “I asked if it bothered him and he said no,” said de Casabianca, referring to one of the owners. “I often ask for their thoughts. It’s always a discussion. This time, one of the employees said, ‘Yeah, it’s a bit shocking.’ But then, voilà, it becomes a discussion about art. ”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Day With the Man Who Brings Museum Works to City Walls', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-06-25T13:00:57+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Amy Verner', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'Verner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b2b0c8d4-82e4-585c-a772-6a6a0bff3041', 'word_count': 768, 'uri': 'nyt://article/b2b0c8d4-82e4-585c-a772-6a6a0bff3041'}, {'abstract': 'The director discusses the opening credits sequence.', 'web_url': 'https://www.nytimes.com/2015/06/26/movies/ted-2-with-movie-trailer-seth-macfarlane-narrates-a-scene.html', 'snippet': 'The director discusses the opening credits sequence.', 'lead_paragraph': 'Ted hasn’t quite cleaned up his act in this sequel. But the foulmouthed teddy bear has more pizazz than ever in the opening credits sequence for “Ted 2.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Ted 2’ (With Movie Trailer): Seth MacFarlane Narrates a Scene', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'MacFarlane, Seth', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Ted 2 (Movie)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-25T13:02:54+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Mekado Murphy', 'person': [{'firstname': 'Mekado', 'middlename': None, 'lastname': 'Murphy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/926e546e-a200-510a-9fac-0899308c251e', 'word_count': 541, 'uri': 'nyt://article/926e546e-a200-510a-9fac-0899308c251e'}, {'abstract': 'The push to remove Confederate symbols is gaining momentum, and there are few places where those symbols are in more abundance than at the Capitol.', 'web_url': 'https://www.nytimes.com/2015/06/26/us/politics/search-for-confederate-symbols-finds-them-aplenty-in-washington.html', 'snippet': 'The push to remove Confederate symbols is gaining momentum, and there are few places where those symbols are in more abundance than at the Capitol.', 'lead_paragraph': 'WASHINGTON — Just outside a dining room where senators gather for lunch hangs a large painting of John C. Calhoun, the 19th-century South Carolina statesman who once called slavery “indispensable to the peace and happiness” of Americans.', 'print_section': 'A', 'print_page': '14', 'sou