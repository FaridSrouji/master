iques-dutch-mirror-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/04/arts/05antiques-dutch-mirror/05antiques-dutch-mirror-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/04/arts/05antiques-dutch-mirror/05antiques-dutch-mirror-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/04/arts/05antiques-dutch-mirror/05antiques-dutch-mirror-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/04/arts/05antiques-dutch-mirror/05antiques-dutch-mirror-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Collection of Dutch Artifacts 50 Years in the Making', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Passion for Pieces Owned by Dutch Settlers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANTIQUES', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Way, George', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Orangetown Historical Museum and Archives', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-06-04T14:51:03+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Eve M. Kahn', 'person': [{'firstname': 'Eve', 'middlename': None, 'lastname': '', 'qualifier': None, 't