.jpg', 'xlargewidth': 600, 'xlargeheight': 1084}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDE3/07GUIDE3-jumbo.jpg', 'height': 1024, 'width': 568, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDE3/07GUIDE3-superJumbo.jpg', 'height': 2048, 'width': 1135, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDE3/07GUIDE3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/07/arts/07GUIDE3/07GUIDE3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDE3/07GUIDE3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Wildcat! Wraps Up ‘Forward Ferguson’ at JACK in Brooklyn', 'kicker': 'Dance', 'content_kicker': None, 'print_headline': '&#8216;I Do Mind Dying&#8217;: Mulling Injustice', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-05T16:00:08+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Siobhan Burke', 'person': [{'firstname': 'Siobhan', 'middlename': None, 'lastname': 'Burke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1928362e-40ee-5b18-9eb9-523fa012b9d7', 'word_count': 155, 'uri': 'nyt://article/1928362e-40ee-5b18-9eb9-523fa012b9d7'}, {'abstract': 'In an angry and polarized social climate, humor has become as divisive a force as any other. It can also be a catalyst for arguments about issues we’d rather avoid.', 'web_url': 'https://www.nytimes.com/2015/06/07/movies/adjusting-to-a-world-that-wont-laugh-with-you.html', 'snippet': 'In an angry and polarized social climate, humor has become as divisive a force as any other. It can also be a catalyst for arguments about issues we’d rather avoid.', 'lead_paragraph': 'It is often said that we are living in a golden age of comedy, when new varieties of funny sprout from every screen and nightclub stage. We are lucky to be around in the era of Hannibal Buress and Amy Schumer, of “Jane the Virgin” and “black-ish,” of “Broad City” and “Louie,” of Amy Poehler and Tig Notaro and a “Saturday Night Live” cast that may have finally broken that show’s 40-year cycle of tokenism and dude-centrism. Every week, on cable and the networks, YouTube and Twitter, boundaries are breached, categories scrambled and stereotypes shattered as hot-button topics are transformed into grist for fresh riffs, gags and flights of goofiness.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07CROSSCUTS/07CROSSCUTS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/07/arts/07CROSSCUTS/07CROSSCUTS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07CROSSCUTS/07CROSSCUTS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07CROSSCUTS/07CROSSCUTS-superJumbo.jpg', 'height': 1200, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07CROSSCUTS/07CROSSCUTS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/07/arts/07CROSSCUTS/07CROSSCUTS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07CROSSCUTS/07CROSSCUTS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Adjusting to a World That Won’t Laugh With You', 'kicker': None, 'content_kicker': None, 'print_headline': 'A World That Won&#8217;t Laugh With You', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Comedy and Humor', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-06-05T16:00:10+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/448ed7a9-a472-5d49-a30d-fc91c2ededec', 'word_count': 1718, 'uri': 'nyt://article/448ed7a9-a472-5d49-a30d-fc91c2ededec'}, {'abstract': 'Classical offerings include a performance by the St. Petersburg Philharmonic at Carnegie Hall.', 'web_url': 'https://www.nytimes.com/2015/06/07/arts/music/joan-of-arc-at-the-stake-brahms-on-a-barge-and-a-russian-day-treat.html', 'snippet': 'Classical offerings include a performance by the St. Petersburg Philharmonic at Carnegie Hall.', 'lead_paragraph': 'June is traditionally a less busy time for classical music in New York, though the New York Philharmonic has a big week with its staged performances of Honegger’s “Joan of Arc at the Stake” (7:30 p.m., Wednesday through Friday, 8 p.m. Saturday, nyphil.org.) But Bargemusic, everyone’s favorite floating recital hall in Brooklyn, never slows down. An enticing concert takes place Sunday afternoon. ', 'print_section': 'AR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDESUB1/07GUIDESUB1-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/07/arts/07GUIDESUB1/07GUIDESUB1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDESUB1/07GUIDESUB1-jumbo.jpg', 'height': 664, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDESUB1/07GUIDESUB1-superJumbo.jpg', 'height': 1167, 'width': 1801, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07GUIDESUB1/07GUIDESUB1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/07/arts/07GUIDESUB1/07GUIDESUB1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/07/arts/07G