eadline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-19T18:44:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By MAGGIE HABERMAN', 'person': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'HABERMAN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3c10267-5964-5466-a570-3ff4df79afac', 'word_count': 498, 'uri': 'nyt://article/c3c10267-5964-5466-a570-3ff4df79afac'}, {'abstract': 'The United Nations mediator for Yemen’s talks with Houthi rebels said discussions yielded no progress, not even for a humanitarian cease-fire.', 'web_url': 'https://www.nytimes.com/2015/06/20/world/middleeast/yemen-mediator-optimistic-as-humanitarian-crisis-worsens.html', 'snippet': 'The United Nations mediator for Yemen’s talks with Houthi rebels said discussions yielded no progress, not even for a humanitarian cease-fire.', 'lead_paragraph': 'UNITED NATIONS — In Yemen, hospitals are reeling from a stream of war-wounded. A million people have fled their homes. Hunger is rising so steeply that hospital admissions for malnutrition have more than doubled, while aid agencies say a de facto blockade has made it difficult to get food and fuel into the country, the poorest in the Arab world.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/20/world/YEMEN/YEMEN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/20/world/YEMEN/YEMEN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/20/world/YEMEN/YEMEN-jumbo.jpg', 'height': 683, 'wi