title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/700f4ceb-2b13-51cd-8511-5de03bca912b', 'word_count': 930, 'uri': 'nyt://article/700f4ceb-2b13-51cd-8511-5de03bca912b'}, {'abstract': 'In an interview on “The Kelly File,” Jim Bob and Michelle Duggar defended their handling of their son’s behavior and the decision to start a reality TV show.', 'web_url': 'https://www.nytimes.com/2015/06/04/business/media/josh-duggar-molested-four-of-his-sisters-his-parents-tell-fox-news.html', 'snippet': 'In an interview on “The Kelly File,” Jim Bob and Michelle Duggar defended their handling of their son’s behavior and the decision to start a reality TV show.', 'lead_paragraph': 'In their first interview since allegations emerged that their son had molested several underage girls, Jim Bob and Michelle Duggar defended their handling of his behavior and their later decision to start a reality show about their family.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/04/business/media/04duggars1/04duggars1-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/04/business/media/04duggars1/04duggars1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/04/business/media/04duggars1/04duggars1-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/04/business/media/04duggars1/04duggars1-superJumbo.jpg', 'height': 856, 'width': 1280, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credi