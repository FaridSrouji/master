ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bccbae54-dc98-5792-a879-5d89292cd58b', 'word_count': 914, 'uri': 'nyt://article/bccbae54-dc98-5792-a879-5d89292cd58b'}, {'abstract': 'The Russian president called to talk about the battle against ISIS, while the American president focused on the separatist war in Ukraine.', 'web_url': 'https://www.nytimes.com/2015/06/26/world/europe/putin-breaks-silence-with-call-to-obama.html', 'snippet': 'The Russian president called to talk about the battle against ISIS, while the American president focused on the separatist war in Ukraine.', 'lead_paragraph': 'WASHINGTON — President Obama spoke with President Vladimir V. Putin of Russia on Thursday in their first direct contact in four months as the United States and Russia try to manage their conflict over Ukraine while still working together on other issues like Syria and Iran’s nuclear program.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Putin Breaks Silence With Call to Obama Touching on Ukraine and ISIS', 'kicker': None, 'content_kicker': None, 'print_headline': 'Calling Obama, Putin Breaks His Silence ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baker, Peter', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Ukraine', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'valu