ews_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Fandos and Michael S. Schmidt', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Fandos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Michael', 'middlename': 'S.', 'lastname': 'Schmidt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bfe0b2b7-ada3-5940-9d47-8f6f1f307ea3', 'word_count': 767, 'uri': 'nyt://article/bfe0b2b7-ada3-5940-9d47-8f6f1f307ea3'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/06/17/arts/television/whats-on-tv-wednesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '11 P.M. (Sundance) DEUTSCHLAND 83 Martin (Jonas Nay), a 24-year-old East German, is extracted from his military existence and forced by the secret police to assume the identity of an aide to a West German general at the center of NATO’s nuclear-deterrence strategy in Anna and Jörg Winger’s new Cold War espionage series. Maria Schrader (above, with Mr. Nay) plays Martin’s manipulative aunt, who pushes him into the assignment by using his mother, who needs a kidney transplant, as a weapon. “The series doesn’t have the depth of that other ‘80s spy show, ‘The Americans’ on Fox, but intentionally so,” Neil Genzlinger wrote in The New York Times. “It’s decidedly a drama — lots of close calls and complications for Martin to deal with — but there’s a slight wink throughout as well, as if it were saying, ‘Don’t take this too seriously.’\xa0”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On TV Wednesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What&#8217;s On TV Wednesday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'valu