ia/28india-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/28/opinion/sunday/28india/28india-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/28/opinion/sunday/28india/28india-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Saving the Cows, Starving the Children', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'Saving the Cows, Starving the Children', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Faleiro, Sonia', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hinduism', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Modi, Narendra', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Malnutrition', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Bharatiya Janata Party', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Madhya Pradesh (India)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Maharashtra (India)', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetarianism', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Chouhan, Shivraj Singh (1959- )', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-06-26T22:20:28+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Sonia Faleiro', 'person': [{'firstname': 'Sonia', 'middlename': None, 'lastname': 'Faleiro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization'