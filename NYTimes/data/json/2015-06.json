op_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Monday’s Travel News and Tips', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-08T12:28:31+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Elaine Glusac', 'person': [{'firstname': 'Elaine', 'middlename': None, 'lastname': 'Glusac', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/00024a49-8df9-509e-8c4d-391627f432ba', 'word_count': 438, 'uri': 'nyt://article/00024a49-8df9-509e-8c4d-391627f432ba'}, {'abstract': 'Tourists, fans, and family and friends of the artist flocked to the opening the exhibition to see the show and, more important for many, to catch a glimpse of Mr. Ai.', 'web_url': 'https://sinosphere.blogs.nytimes.com/2015/06/08/ai-weiwei-solo-exhibition-china-beijing/', 'snippet': 'Tourists, fans, and family and friends of the artist flocked to the opening the exhibition to see the show and, more important for many, to catch a glimpse of Mr. Ai.', 'lead_paragraph': 'Barred since 2011 from traveling outside his home country, the artist Ai Weiwei has become a master of what might be called “remote exhibition-making” — using 3-D computer models, Skype, and a team of curators and assistants to create large-scale installations around the world from his studio in Beijing. But no virtual simulation was needed for the artist’s newest exhibition, which opened last weekend at the Galleria Continua and at the Tang Contemporary Art Center in the trendy 798 Art District of Beijing.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/08/world/08sino-weiwei01/08sino-weiwei01-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/08/world/08sino-weiwei01/08sino-weiwei01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/08/world/08sino-weiwei01/08sino-weiwei01-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/08/world/08sino-weiwei01/08sino-weiwei01-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/08/world/08sino-weiwei01/08sino-weiwei01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/08/world/08sino-weiwei01/08sino-weiwei01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/08/world/08sino-weiwei01/08sino-weiwei01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ai Weiwei Trades Politics for Subtlety in First Solo Exhibition in China', 'kicker': 'Sinosphere', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ai Weiwei', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Beijing (China)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-08T12:37:43+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia P