 on Tuesday.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'With Loan Deadline Looming, Europe Offers Greece a Last-Minute Deal', 'kicker': None, 'content_kicker': None, 'print_headline': 'With Loan Deadline Looming, Europe Offers Greece a Last-Minute Deal ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Higgins, Andrew', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Greece', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'International Monetary Fund', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Tsipras, Alexis', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Eurozone', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Juncker, Jean-Claude', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'European Central Bank', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'European Commission', 'rank': 13, 'major': 'N'}], 'pub_date': '2015-06-29T18:04:09+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Andrew Higgins and Alison Smale', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Higgins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Alison', 'middlename': None, 'lastname': 'Smale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3fd353b-0485-5cee-9f4b-140acc3c3297', 'word