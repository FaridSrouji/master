': 'images/2015/07/01/arts/01MAGICMIKE/01MAGICMIKE-jumbo-v2.jpg', 'height': 539, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/arts/01MAGICMIKE/01MAGICMIKE-superJumbo-v2.jpg', 'height': 1078, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/arts/01MAGICMIKE/01MAGICMIKE-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/01/arts/01MAGICMIKE/01MAGICMIKE-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/arts/01MAGICMIKE/01MAGICMIKE-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Magic Mike XXL,’ Fleshing Out a Sequel With Heart as Well as Pecs and Abs', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Sequel With Heart as Well as Pecs and Abs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jacobs, Gregory (Film Director)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Carolin, Reid', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tatum, Channing', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Adam', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Manganiello, Joe', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Bomer, Matt', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Glover, Donald', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Jada Pinkett', 'rank': 9, 'major': 'N'}, {'na