ight': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/14/arts/14HANNIBAL2/14HANNIBAL2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/arts/14HANNIBAL2/14HANNIBAL2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Hannibal’: 3 Steps to TV’s Scariest Soundtrack', 'kicker': None, 'content_kicker': None, 'print_headline': 'Music for Cannibals (One in Particular)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Reitzell, Brian (1965- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Hannibal (TV Program)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-06-12T14:23:07+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Libby Hill', 'person': [{'firstname': 'Libby', 'middlename': None, 'lastname': 'Hill', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7971ba48-a441-535e-bd05-3be59d3d9dbf', 'word_count': 901, 'uri': 'nyt://article/7971ba48-a441-535e-bd05-3be59d3d9dbf'}, {'abstract': 'From the International Herald Tribune archives: The Allies meet success in Gallipoli in 1915.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/06/12/1915-fierce-fighting-in-gallipoli/', 'snippet': 'From the International Herald Tribune archives: The Allies meet success in Gallipoli in 1915.', 'lead_paragraph': 'Fierce fighting is reported from the Gallipoli Peninsula, with big successes for the Allies. According to despatches from Mitylene, a great battle began on Thursday in the Maidos sector, where the Allied troops delivered five furious attacks, and captured the heights dominating Maidos. They are now within two hours of the town, the occupation of which, telegraphs the ‘‘Times’’ Athens correspondent, was prevented by the fire of Fort Nagara and the coastal batteries, which bombarded the Allies with indirect fire.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/13/blogs/13iht-oldjune13-map/13iht-oldjune13-map-articleLarge.png', 'height': 497, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/13/blogs/13iht-oldjune13-map/13iht-oldjune13-map-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 497}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/13/blogs/13iht-oldjune13-map/13iht-oldjune13-map-jumbo.png', 'height': 795, 'width': 960, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/13/blogs/13iht-oldjune13-map/13iht-oldjune13-map-superJumbo.png', 'height': 795, 'width': 960, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/13/blogs/13iht-oldjune13-map/13iht-oldjune13-map-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/13/blogs/13iht-oldjune13-map/13iht-oldjune13-map-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/13