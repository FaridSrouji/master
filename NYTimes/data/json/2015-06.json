'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-17T16:27:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ce64ece9-14c9-5e4f-adeb-2328c66a0a68', 'word_count': 949, 'uri': 'nyt://article/ce64ece9-14c9-5e4f-adeb-2328c66a0a68'}, {'abstract': 'From the International Herald Tribune archives: President Johnson rejects Viet Cong talks in 1965.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/06/17/1965-u-s-rejects-viet-cong-talks/', 'snippet': 'From the International Herald Tribune archives: President Johnson rejects Viet Cong talks in 1965.', 'lead_paragraph': 'WASHINGTON — President Johnson today [June 16] rejected any idea of direct negotiations over Vietnam with the Viet Cong or their political arm, the National Liberation Front. ‘‘What would you think about the state of Mississippi negotiating for the United States?’’ the president asked at a surprise press conference. ‘‘I have no doubt that if the Viet Cong wished to negotiate, they would have no trouble in finding a government to negotiate for them,’’ he said. His statement was a reference to his administration’s firmly held belief that the South Vietnamese Communists are controlled, directed, supplied and now reinforced by North Vietnam. — New York Herald Tribune, European Edition, June 18, 1965', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1965: U.S. Rejects Viet Cong Talks', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Vietnam War', 'rank': 1, 'major': 'N'}, {'name': '