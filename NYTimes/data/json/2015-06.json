tion': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/18/opinion/17westWeb/17westWeb-superJumbo.jpg', 'height': 1423, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/18/opinion/17westWeb/17westWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/18/opinion/17westWeb/17westWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/18/opinion/17westWeb/17westWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Obama’s Plan to Send Advisers to Iraq Will Fail', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'How Not to Save Iraq', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Iraq', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'West, Owen', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Iraqi Army', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-06-18T07:21:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Owen West', 'person': [{'firstname': 'Owen', 'middlename': None, 'lastname': 'West', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0f3c942c-1eab-5fc1-9051-ba7886309933', 'word_count': 898, 'uri': 'nyt://article/0f3c942c-1eab-5fc1-9051-ba7886309933'}, {'abstract': 'House Republicans are moving two bills to repeal small but important provisions of the health care law.', 'web_url': 'https://www.nytimes.com/2015/06/18/opinion/destructive-health-care-proposals.html', 'snippet': 'House Republicans are moving two bills to repeal small but important provisions of the health care law.', 'lead_paragraph': 'Frustrated by their inability to repeal the Affordable Care Act and unable to produce a conservative alternative to replace it, House Republicans are moving two bills to repeal small but important provisions of the law — a tax on medical device manufacturers and an independent board to clamp down on out-of-control Medicare spending. The two bills would harm the federal budget and do nothing to help consumers, but were approved by the House Ways and Means Committee and are expected to pass the House on Thursday.', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/18/opinion/18thu2web/18thu2web-articleLarge.jpg', 'height': 476, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/18/opinion/18thu2web/18thu2web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 476}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/18/opinion/18thu2web/18thu2web-jumbo.jpg', 'height': 813, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/18/opinion/18thu2web/18thu2web-superJumbo.jpg', 'height': 1626, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'th