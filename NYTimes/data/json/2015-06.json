eb_url': 'https://artsbeat.blogs.nytimes.com/2015/06/08/municipal-art-society-president-steps-down-to-take-new-role-with-lincoln-center/', 'snippet': 'The job of raising the rest of the money to renovate Lincoln Center’s home of the New York Philharmonic is being taken on by Vin Copolla, of the Municipal Arts Society.', 'lead_paragraph': 'In the wake of David Geffen’s $100 million gift toward the $500 million transformation of Avery Fisher Hall, many have wondered how Lincoln Center and the New York Philharmonic would go about trying to raise the rest of such a daunting budget. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Municipal Art Society President to Step Down for New Lincoln Center Role', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'A Fund-Raising Leader For Geffen Hall', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cipolla, Vin', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Geffen, David', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Avery Fisher Hall', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Lincoln Center for the Performing Arts', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Municipal Art Society', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Philharmonic', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-06-08T22:00:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a0212858-91b9-5eb1-a216-51770b654c5b', 'word_count': 212, 'uri': 'nyt://article/a0212858-91