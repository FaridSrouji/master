: 'N'}], 'pub_date': '2015-06-11T04:09:48+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Ben Shpigel', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Shpigel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2843550f-5c0b-5cab-9681-4fe81a796c83', 'word_count': 1044, 'uri': 'nyt://article/2843550f-5c0b-5cab-9681-4fe81a796c83'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2015/06/11/arts/television/whats-on-tv-thursday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '11:35 A.M. (Starz Cinema) HIGHER GROUND (2011) Corinne Walker, a freewheeling teenage mother turned fundamentalist Christian (played by Vera Farmiga, who also directed, as an adult; her sister Taissa Farmiga as a teenager; and McKenzie Turner as a child) comes to question her faith — and her marriage — when faced with a crisis in this adaptation of “This Dark World,” a 2002 memoir by Carolyn S. Briggs. Joshua Leonard and Boyd Holbrook share the role of Corinne’s husband, a rock guitarist who saves their daughter from death after a bus crash, leading the couple onto the path of salvation. Norbert Leo Butz plays the pastor of their cultlike church. And Dagmara Dominczyk is Corinne’s best friend, who speaks in tongues to God and makes her feel loved. “There is something remarkable — you might even say miraculous — about the way ‘Higher Ground’ makes its gentle, thoughtful way across the burned-over terrain of the American culture wars,” A. O. Scott wrote in The New York Times. “Focused with sympathetic intensity on the ordeal of a single soul, it illuminates, as though from within, a complex spiritual struggle.” But, he added, “what faith and doubt have in common is that both are hard work, and the hard-won wisdom of ‘Higher Ground’ is that human nature does not necessarily distinguish between saints and sinners.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on TV Thursday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What&#8217;s On TV Thursday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-11T05:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/a3b92c6d-9dd0-5b3b-8350-c6132d00ca52', 'word_count': 711, 'uri': 'nyt://article/a3b92c6d-9dd0-5b3b-8350-c6132d00ca52'}, {'abstract': 'Corrections appearing in print on Thursday, June 11, 2015.', 'web_url': 'https://www.nytimes.com/2015/06/11/pageoneplus/corrections-june-11-2015.html', 'snippet': 'Corrections appearing in print on Thursday, June 11, 2015.', 'lead_paragraph': 'FRONT PAGE', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: June 11, 2015', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-11T05:11:33+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29642d02-58ba-5517-b4e3-e8884ade44c8', 'word_count': 416, 'uri': 'nyt://article/29642d02-58ba-5517-b4e3-e8884ade44c8'}, {'abstract': 'Quotation of the Day for Thursday, June 11, 2015.', 'web_url': 'https://www.nytimes.com/2015/06/11/pageoneplus/quotation-of-the-day.html', 'snippet': 'Quotation of the Day for Thursday, June 11, 2015.', 'lead_paragraph': '“It sets up a system where first there’s the punishment, and then there’s the opportunity to go to court for trial.”', 'print_section': 'A', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quotation of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-11T05:12:47+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/f4b835cf-8255-5cc7-bb83-4cd74655647a', 'word_count': 39, 'uri': 'nyt://article/f4b835cf-8255-5cc7-bb83-4cd74655647a'}, {'abstract': 'Tim Smith was looking for a day picture when a quick glimpse of Hutterite women led him to pursue a project about their simple, communal life.', 'web_url': 'https://lens.blogs.nytimes.com/2015/06/11/simple-life-among-the-hutterites/', 'snippet': 'Tim Smith was looking for a day picture when a quick glimpse of Hutterite women led him to pursue a project about their simple, communal life.', 'lead_paragraph': 'When it comes to feature photos, the more you drive the luckier you’ll get. Tim Smith learned that lesson one crisp spring day in 2009, when he was searching for something — anything — worth photographing. He needed to find a day picture to fill space on the pages of the Brandon Sun newspaper in Manitoba, Canada. Unfortunately, nothing much was happening in his corner of western Manitoba. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Simple Life Among the Hutterites', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Canada', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Manitoba (Canada)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-11T07:00:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By James Estrin', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Estrin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2b97dcb9-8f84-5747-bcb5-d8dd7e0da113', 'word_count': 852, 'uri': 'nyt://article/2b97dcb9-8f84-5747-bcb5-d8dd7e0da113'}, {'abstract': 'Tim Smith was looking for a day picture when a quick glimpse of Hutterite women led him to pursue a project about their simple, communal life.', 'web_url': 'https://lens.blogs.nytimes.com/2015/06/11/simple-life-among-the-hutterites/', 'snippet': 'Tim Smith was looking for a day picture when a quick glimpse of Hutterite women led him to pursue a project about their simple, communal life.', 'lead_paragraph': 'When it comes to feature photos, the more you drive the luckier you’ll get. Tim Smith learned that lesson one crisp spring day in 2009, when he was searching for something — anything — worth photographing. He needed to find a day picture to fill space on the pages of the Brandon Sun newspaper in Manitoba, Canada. Unfortunately, nothing much was happening in his corner of western Manitoba. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Simple Life Among the Hutterites', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-11T07:00:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By JAMES ESTRIN', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'ESTRIN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization