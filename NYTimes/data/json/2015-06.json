0d3-cc7f-5017-b4a2-d0813c2024e6', 'word_count': 941, 'uri': 'nyt://article/629410d3-cc7f-5017-b4a2-d0813c2024e6'}, {'abstract': 'The new findings try to correct for problems in the way global temperatures were measured and suggest there has not been a slowdown in global warming since 2000.', 'web_url': 'https://www.nytimes.com/2015/06/05/science/noaa-research-presents-evidence-against-a-global-warming-hiatus.html', 'snippet': 'The new findings try to correct for problems in the way global temperatures were measured and suggest there has not been a slowdown in global warming since 2000.', 'lead_paragraph': 'Scientists have long labored to explain what appeared to be a slowdown in global warming that began at the start of this century as, at the same time, heat-trapping emissions of carbon dioxide were soaring. The slowdown, sometimes inaccurately described as a halt or hiatus, became a major talking point for people critical of climate science.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/05/science/05HIATUS/05HIATUS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/05/science/05HIATUS/05HIATUS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/05/science/05HIATUS/05HIATUS-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/05/science/05HIATUS/05HIATUS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/20