keywords': [{'name': 'persons', 'value': 'Lohr, Steve', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AU Optronics Corporation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Motorola Mobility LLC', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-06-01T01:31:10+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Steve Lohr', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Lohr', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8629273b-2659-5e18-a998-fcb7bdcf89fa', 'word_count': 1194, 'uri': 'nyt://article/8629273b-2659-5e18-a998-fcb7bdcf89fa'}, {'abstract': 'The fact that Congress allowed counterterrorism laws to lapse is an extraordinary moment in the story of the tensions between post-9/11 policies and privacy rights.', 'web_url': 'https://www.nytimes.com/2015/06/01/us/a-gap-in-surveillance-but-ways-around-it.html', 'snippet': 'The fact that Congress allowed counterterrorism laws to lapse is an extraordinary moment in the story of the tensions between post-9/11 policies and privacy rights.', 'lead_paragraph': 'WASHINGTON — For the first time since the aftermath of the terrorist attacks of Sept. 11, 2001, Americans are again free to place phone calls — to friends, lovers, business associates, political groups, doctors and pizza restaurants — without having logs of those contacts vacuumed up in bulk by the National Security Agency.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times