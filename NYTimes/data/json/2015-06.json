 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/02/health/document-mri-new-lesion-redacted/document-mri-new-lesion-redacted-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/health/document-mri-new-lesion-redacted/document-mri-new-lesion-redacted-thumbLarge.gif', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'MRI Report', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-02T19:59:04+0000', 'document_type': 'multimedia', 'news_desk': 'Health', 'section_name': 'Health', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/53e22bfc-73fe-5338-9d01-e41bb99aeb5a', 'word_count': 0, 'uri': 'nyt://interactive/53e22bfc-73fe-5338-9d01-e41bb99aeb5a'}, {'abstract': 'The mosaic artist Jason Dussault will begin a four-week residency at the Montauk lodge this month.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/06/02/jason-dussault-ruschmeyer-surfboards/', 'snippet': 'The mosaic artist Jason Dussault will begin a four-week residency at the Montauk lodge this month.', 'lead_paragraph': '“I believe some of the best of art is born from a juxtaposition that makes you smile,” says the artist Jason Dussault, who this summer will spend four weeks creating a surf-inspired art installation in an on-site residency at Ruschmeyer’s hotel — a “commune for the cool,” as Dussault puts it. Dussault will be setting up his temporary workspace and makeshift showroom in the communal lawn, the Magic Garden, at the center of the boutique hotel’s 19 guest rooms; among the picnic and Ping-Pong tables, he’ll be creating and displaying mosaic sculptures on vintage surfboards. Using canvases sourced from eBay and local surf shops, the work Dussault is creating for the series, “Off Duty,” portrays Lego-like superheroes on vacation — a Lego Wolverine, for example, wearing a “Kiss the Cook” BBQ apron and using his talons as shish kebabs.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/t-magazine/02surfboard-may/02surfboard-may-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/02/t-magazine/02surfboard-may/02surfboard-may-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/t-magazine/02surfboard-may/02surfboard-may-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/t-magazine/02surfboard-may/02surfboard-may-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/t-magazine/02surfboard-may/02surfboard-may-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/02/t-magazine/02surfboard-may/02surfboard-may-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/02/t-magazine/02surfboard-may/02surfboard-may-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At Ruschmeyer’s Summer Surf-Art Installation, Hotel Guests Are Invited to Pitch In', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Mad for Mosaics', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-02T19:59:46+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Hana May', 'person': [{'firstname': 'Hana', 'middlename': None, 'lastname': 'May', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/94bc83da-0fea-51d5-a394-0408b2f1ed57', 'word_count': 331, 'uri': 'nyt://article/94bc83da-0fea-51d5-a394-0408b2f1ed57'}, {'abstract': 'The 1902 painting, which has been in private hands for over a century, is estimated at $18 million to $28 million.', 'web_url': 'https://www.nytimes.com/2015/06/02/arts/design/klimts-portrait-of-gertrud-loew-to-be-auctioned.html', 'snippet': 'The 1902 painting, which has been in private hands for over a century, is estimated at $18 million to $28 million.', 'lead_paragraph': 'London — A painting by Gustav Klimt that has been in private hands for over a century will be auctioned at Sotheby’s Impressionist and Modern Art Evening Sale here on June 24. The work, “Portrait of Gertrud Loew,” painted in 1902, has an estimated sale price of 12 million to 18 million pounds (about $18 million to $28 million), and is for sale as a result of a settlement between the Felsovanyi family, the heirs of the painting’s subject, and the Klimt Foundation.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/03/arts/KLIMT/KLIMT-articleLarge.jpg', 'height': 2062, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/03/arts/KLIMT/KLIMT-articleLarge.jpg', 'xlargewidth': 600, 'xl