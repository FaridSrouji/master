, 'content_kicker': None, 'print_headline': 'Head Shots', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'La Spina, David', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bach, Michael P (1960- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-06-26T11:00:06+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By David La Spina', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'La Spina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/128a0778-a215-54bb-9426-cba727d329a2', 'word_count': 244, 'uri': 'nyt://article/128a0778-a215-54bb-9426-cba727d329a2'}, {'abstract': 'It was déjà vu once again for Republicans as the Supreme Court granted another lifeline to the health care law by upholding the subsidies that underpin it.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2015/06/26/today-in-politics-g-o-p-finds-much-to-add-to-justices-final-say-on-health-care-law/', 'snippet': 'It was déjà vu once again for Republicans as the Supreme Court granted another lifeline to the health care law by upholding the subsidies that underpin it.', 'lead_paragraph': 'Good Friday morning from Washington, where the Supreme Court has taken over both the Capitol and the campaign trail. Its ruling in favor of a central provision of the Affordable Care Act prompted declarations of victory from the White House and increased pledges to repeal the law from the Republicans looking to move in. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/25/us/politics/25firstdraft-newsletter/25firstdraft-newsle