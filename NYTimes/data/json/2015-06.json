mbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/24/business/24sand-web1/24sand-web1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/business/24sand-web1/24sand-web1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Reimagining in Washington Divides the Neighbors', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Reimagining in Washington Divides the Neighbors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate (Commercial)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Meyer, Eugene L', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Area Planning and Renewal', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-06-23T21:40:27+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Real Estate', 'subsection_name': 'Commercial Real Estate', 'byline': {'original': 'By Eugene L. Meyer', 'person': [{'firstname': 'Eugene', 'middlename': 'L.', 'lastname': 'Meyer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ff682fb-ae01-55fd-9527-d5a9eca4a330', 'word_count': 1211, 'uri': 'nyt://article/9ff682fb-ae01-55fd-9527-d5a9eca4a330'}, {'abstract': 'The nightclub singer performed ballads like “I Made a New Friend,” a song that distilled the essence of her musical personality.', 'web_url': 'https://www.nytimes.com/2015/06/24/arts/music/review-karen-mason-a-well-seasoned-belter-at-dont-tell-mama.html', 'snippet': 'The nightclub singer performed ballads like “I Made a New Friend,” a song that distilled the essence of her musical personality.', 'lead_paragraph': '“I’ve come home at last!” Norma Desmond’s triumphant announcement in the semioperatic ballad, “As If We Never Said Goodbye,” from “Sunset Boulevard” has rarely been put to more powerful use than in Karen Mason’s show at the Midtown cabaret Don’t Tell Mama on Monday evening. Ms. Mason, who was a stand-in for three Broadway Normas — Glenn Close, Betty Buckley and Elaine Paige — captured the character’s scarily compelling essence in clawing body language. This dramatic tour de force was especially impressive because as a nightclub singer, Ms. Mason is utterly guileless. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24MASON/24MASON-articleLarge.jpg', 'height': 424, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/24/arts/24MASON/24MASON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 424}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24MASON/24MASON-jumbo.jpg', 'height': 724, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24MASON/24MASON-superJumbo.jpg', 'height': 1447, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/24/arts/24MASON/24MASON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/24/arts/24MASON/24MASON-thumbStandard.jpg', 'th