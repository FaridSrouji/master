/05/opinion/05surveilWeb/05surveilWeb-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/05/opinion/05surveilWeb/05surveilWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/05/opinion/05surveilWeb/05surveilWeb-jumbo.jpg', 'height': 664, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/05/opinion/05surveilWeb/05surveilWeb-superJumbo.jpg', 'height': 1329, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/05/opinion/05surveilWeb/05surveilWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/05/opinion/05surveilWeb/05surveilWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/05/opinion/05surveilWeb/05surveilWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Edward Snowden: The World Says No to Surveillance', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The World Says No to Surveillance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Snowden, Edward J', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Agency', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'USA PATRIOT Act', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-06-05T01:15:23+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Edward J. Snowden', 'person': [{'firstname': 'Edward', 'middlename': 'J.', 'lastname': 'Snowden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/8a25f1c3-d20f-5c23-a3c8-d9d9f27e053e', 'word_count': 819, 'uri': 'nyt://article/8a25f1c3-d20f-5c23-a3c8-d9d9f27e053e'}, {'abstract': 'Airstrikes carried out by a military alliance led by Saudi Arabia have killed at least 50 people in the northern Yemeni province of Saada.', 'web_url': 'https://www.nytimes.com/2015/06/05/world/middleeast/yemen-civilians-bombed-officials-say.html', 'snippet': 'Airstrikes carried out by a military alliance led by Saudi Arabia have killed at least 50 people in the northern Yemeni province of Saada.', 'lead_paragraph': ' Airstrikes carried out by a military alliance led by Saudi Arabia have killed at least 50 people in the northern Yemeni province of Saada, officials and the director of a hospital said Thursday. The victims of the bombings, in two separate districts, were mostly civilians, according to Dr. Muhammed Abdulwahab Hajar, the director of the Republican Hospital in Saada. Since the beginning of its offensive against Yemen’s Houthi rebels in late March, the Saudi-led coalition has been accused of killing hundreds of people in airstrikes that have at times failed to distinguish between military targets and civilian facilities, according to human rights groups. Saudi officials, who say their offensive is aimed at restoring to power Yemen’s ousted president, Abdu Rabbu Mansour Hadi, have accused the Houthis of fighting from populated areas. Dr. Hajar said airstrikes on one village on Wednesday killed at least 42 people, including many who were killed in nine homes that were destroyed by the bombing. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Yemen: Civilians Bombed, Officials Say', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Middle East; Yemen: Civilians Bombed, Officials Say', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Almosawa, Shuaib', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Yemen', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Saudi Arabia', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Houthis', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Civilian Casualties', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hadi, Abdu Rabbu Mansour', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-06-05T01:17:13+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Shuaib Almosawa', 'person': [{'firstname': 'Shuaib', 'middlename': None, 'lastname': 'Almosawa', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/06bb6518-38c5-5a64-9066-a663f34e69b4', 'word_count': 159, 'uri': 'nyt://article/06bb6518-38c5-5a64-9066-a663f34e69b4'}, {'abstract': 'The Federal Reserve’s practices are the focus of investigations by the Justice Department, the House Financial Services Committee and the Fed’s inspector general.', 'web_url': 'https://www.nytimes.com/2015/06/05/business/fed-deflects-outside-aid-to-investigate-data-leaks.html', 'snippet': 'The Federal Reserve’s practices are the focus of investigations by the Justice Department, the House Financial Services Committee and the Fed’s inspector general.', 'lead_paragraph': 'A review of the Federal Reserve’s response to recent leaks about its bond-buying plans raises new questions about the central bank’s efforts to police interactions with investors who can profit handsomely from inside information.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fed Deflects Outside Aid to Investigate Data Leaks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fed Deflects Outside Aid to Investigate Data Leaks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Appelbaum, Binyamin', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House Financial Services Committee', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Insider Trading', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Inspectors General', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Quantitative Easing', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Yellen, Janet L', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-06-05T01:17:22+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6bc23f46-8b47-5099-8917-0d670d37faed', 'word_count': 1360, 'uri': 'nyt://article/6bc23f46-8b47-5099-8917-0d670d37faed'}, {'abstract': 'Through a lawyer, the family of the man kille