age', 'url': 'images/2015/06/23/arts/22artsbeat-neumeier2/22artsbeat-neumeier2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/23/arts/22artsbeat-neumeier2/22artsbeat-neumeier2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/23/arts/22artsbeat-neumeier2/22artsbeat-neumeier2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'John Neumeier, Choreographer, Wins $400,000 Kyoto Prize', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Choreographer Wins $400,000 Kyoto Prize', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Neumeier, John', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-06-22T18:09:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/95cd6425-a284-508d-80c8-8e5232764d3a', 'word_count': 140, 'uri': 'nyt://article/95cd6425-a284-508d-80c8-8e5232764d3a'}, {'abstract': 'Recent years have seen the buttoned-up fair in a sleepy Swiss hamlet injected with some of the famous revelry of its sister spectacle in Miami Beach.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/06/22/art-basel-pop-up-clubs/', 'snippet': 'Recent years have seen the buttoned-up fair in a sleepy Swiss hamlet injected with some of the famous revelry of its sister spectacle in Miami Beach.', 'lead_paragraph': 'It was quite late on Tuesday night in Switzerland — just hours before the next morning’s First Choice VIP opening of Art Basel — but the bar at the Grand Hotel Trois Rois was packed. Leonardo DiCaprio sauntered through, sucking on an e-cigarette. Steven A. Cohen, the billionaire who has dropped $240 million on Giacomettis in the past year, chatted casually with a few dealers. The artist Rirkrit Tiravanija never removed his red sunglasses amid the smoke-filled room; the fashion world darling Peter Brant II sat with a chair-hopping contingent of the cosmopolitan and well-groomed; and Larry Gagosian — the king of the world’s most powerful gallery empire — sat casually in a plush velvet booth, greeting well-wishers.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/22/t-magazine/22symonds-basel2/22symonds-basel2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/22/t-magazine/22symonds-basel2/22symonds-basel2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/22/t-magazine/22symonds-basel2/22symonds-basel2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/22/t-magazine/22symonds-basel2/22symonds-basel2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/22/t-magazine/22symonds-basel2/22symonds-basel2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/22/t-magazine/22symonds-basel2/22symonds-basel2-thumbSta