eywords': [{'name': 'subject', 'value': 'Maritime Accidents and Safety', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Oceans and Seas', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Boats and Boating', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sailboats and Sailing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Volvo Ocean Race', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-06-11T11:00:40+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/c87bd7a6-55d5-58f9-91f5-13bd4575b81c', 'word_count': 0, 'uri': 'nyt://slideshow/c87bd7a6-55d5-58f9-91f5-13bd4575b81c'}, {'abstract': 'The youngest evangelists in the country’s Pentecostal churches try to balance the demands of their youth with those of their faith.', 'web_url': 'https://www.nytimes.com/2015/06/14/magazine/the-child-preachers-of-brazil.html', 'snippet': 'The youngest evangelists in the country’s Pentecostal churches try to balance the demands of their youth with those of their faith.', 'lead_paragraph': 'It was fall in Brazil, and rain drizzled under a gray moon. The faithful were beginning to arrive at the International Mission of Miracles, a Pentecostal church in the poor and working-class city of São Gonçalo, 10 miles from Rio de Janeiro. In front of the church, which was located between a supermarket and an abandoned lot, a banner staked in the muddy ground advertised a young girl named Alani Santos, whose touch could heal.', 'print_section': 'MM', 'print_page': '47', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/magazine/14preachers_ss-slide-KN5J/14preachers_ss-slide-KN5J-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/14/magazine/14preachers_ss-slide-KN5J/14preachers_ss-slide-KN5J-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/magazine/14preachers_ss-slide-KN5J/14preachers_ss-slide-KN5J-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/magazine/14preachers_ss-slide-KN5J/14preachers_ss-slide-KN5J-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/magazine/14preachers_ss-slide-KN5J/14preachers_ss-slide-KN5J-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/14/magazine/14preachers_ss-slide-KN5J/14preachers_ss-slide-KN5J-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/14/magazine/14preachers_ss-slide-KN5J/14preachers_ss-slide-KN5J-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Child Preachers of Brazil', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Mouths of Babes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Brazil', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Shapiro, Samantha M', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Christians and Christianity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ministers (Protestant)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Pentecostal Churches', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-06-11T11:00:45+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Samantha M. Shapiro', 'person': [{'firstname': 'Samantha', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c0236a58-f94e-5bf9-a3fa-60916ff24d90', 'word_count': 5176, 'uri': 'nyt://article/c0236a58-f94e-5bf9-a3fa-60916ff24d90'}, {'abstract': 'Since an inquiry into a crash that stranded members of Team Vestas Wind, small changes have been made to the rules in the Volvo Ocean Race, and officials have said there would be more.', 'web_url': 'https://www.nytimes.com/2015/06/12/sports/after-crash-in-volvo-ocean-race-a-team-shifts-its-focus-and-an-event-changes-its-rules.html', 'snippet': 'Since an inquiry into a crash that stranded members of Team Vestas Wind, small changes have been made to the rules in the Volvo Ocean Race, and officials have said there would be more.', 'lead_paragraph': 'Even though Chris Nicholson entered the Volvo Ocean Race only two months before the start last October, his four races’ worth of experience made him a favorite in the around-the-world event. He believed he could win.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Crash in Volvo Ocean Race, a Team Shifts Its Focus and an Event Changes Its Rules ', 'kicker': None, 'content_kicker': None, 'print_headline': 'After Crash, a Favorite Returns to the Fleet of a Modified Race', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sailboats and Sailing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Maritime Accidents and S