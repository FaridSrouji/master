yline': {'original': 'By Victor Mather', 'person': [{'firstname': 'Victor', 'middlename': None, 'lastname': 'Mather', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d378abc2-45cf-5bc5-ae8d-14d411968f34', 'word_count': 713, 'uri': 'nyt://article/d378abc2-45cf-5bc5-ae8d-14d411968f34'}, {'abstract': 'From the archives of the Intentional Herald Tribune: 1965: Jewish cemetery vandalized in Bamberg, Germany.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/06/15/1965-jewish-cemetery-vandalized/', 'snippet': 'From the archives of the Intentional Herald Tribune: 1965: Jewish cemetery vandalized in Bamberg, Germany.', 'lead_paragraph': 'BAMBERG, GERMANY — The ancient cemetery was found grossly vandalized today [June 15] in what is one of the worst anti-Semitic outbreaks recorded in Germany since the war. Police reported that vandals had desecrated 23 tombstones in the cemetery with yard-high swastikas and anti-Semitic smearings such as ‘‘six million Jews were too few.’’ The desecration was discovered by two American families who had returned here to visit the graves of relatives. — New York Herald Tribune, European Edition, June 16, 1965', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1965: Jewish Cemetery Vandalized', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANTI-SEMITISM', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cemeteries', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Vandalism', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Bamberg (Germany)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-06-15T13:59:38+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byli