//article/75bc5189-74ad-5752-a8db-54d2a40c36f6'}, {'abstract': 'Joel Fagliano hands out Twitter handles.', 'web_url': 'https://wordplay.blogs.nytimes.com/2015/06/21/hawaiis-state-bird/', 'snippet': 'Joel Fagliano hands out Twitter handles.', 'lead_paragraph': 'MONDAY PUZZLE — If you do not have a Twitter account, this puzzle might be a bit, well, puzzling for you. Even if you got the joke, it might be more than you were expecting on a Monday, but as the constructor, Joel Fagliano, remarks in his notes, there’s nothing wrong with a curve ball once in a while.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hawaii’s State Bird', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-21T22:00:52+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd77584a-818a-5154-b8b7-1814dfaf8f29', 'word_count': 348, 'uri': 'nyt://article/fd77584a-818a-5154-b8b7-1814dfaf8f29'}, {'abstract': 'A look at rehearsals for the opera by the Harlem Renaissance composer H. Lawrence Freeman.', 'web_url': 'https://www.nytimes.com/slideshow/2015/06/21/arts/music/20150622VOODOO.html', 'snippet': 'A look at rehearsals for the opera by the Harlem Renaissance composer H. Lawrence Freeman.', 'lead_paragraph': 'A look at rehearsals for the opera by the Harlem Renaissance composer H. Lawrence Freeman.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/21/arts/music/20150622VOODOO-slide-Y6DN/20150622VO