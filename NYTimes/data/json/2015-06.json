ies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Student Loans', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Siegel, Lee', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-06-11T14:16:08+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Susan Dynarski', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Dynarski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/27d6cbd1-dd4f-5403-aae6-f2f6dda4ccd7', 'word_count': 280, 'uri': 'nyt://article/27d6cbd1-dd4f-5403-aae6-f2f6dda4ccd7'}, {'abstract': 'David Miller and his team at Credit Suisse made one of their most aggressive loans to Timothy Blixseth, a land and timber baron who now sits in jail.', 'web_url': 'https://www.nytimes.com/2015/06/12/business/dealbook/after-financial-crisis-fates-of-lender-and-borrower-diverge.html', 'snippet': 'David Miller and his team at Credit Suisse made one of their most aggressive loans to Timothy Blixseth, a land and timber baron who now sits in jail.', 'lead_paragraph': 'Timothy L. Blixseth, a 65-year-old former billionaire, now sits in his eighth week of solitary confinement in a county jail in Great Falls, Mont., one of the few people being held accountable in connection with Wall Street’s profligate behavior in the years leading up to the 2008 financial crisis.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/10/business/dealbook/dbpix-blixseth/dbpix-blixseth-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/10/business/dealbook/dbpix-blixseth/dbpix-blixseth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'ty