: [{'name': 'subject', 'value': 'Families and Family Life', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Father's Day", 'rank': 2, 'major': 'N'}], 'pub_date': '2015-06-08T11:00:07+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Tara Parker-Pope', 'person': [{'firstname': 'Tara', 'middlename': None, 'lastname': 'Parker-Pope', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f57834ca-77f5-5700-bbab-cb22db979b66', 'word_count': 239, 'uri': 'nyt://article/f57834ca-77f5-5700-bbab-cb22db979b66'}, {'abstract': 'Foreign policy, which has factored heavily in Republican stump speeches so far, will be center stage this week from Europe to the campaigns.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2015/06/08/today-in-politics-trips-abroad-pull-focus-to-foreign-policy/', 'snippet': 'Foreign policy, which has factored heavily in Republican stump speeches so far, will be center stage this week from Europe to the campaigns.', 'lead_paragraph': 'Good Monday morning from Washington. The Republican candidates have a busy week lined up, and the Iowa caucuses have added some technology to their traditions. But the week begins with President Obama in Europe, a Bush heading there and the politics of foreign affairs taking a step into the spotlight. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Today in Politics: Trips Abroad Pull Focus to Foreign Policy', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-06-08T11:00:08+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'ny