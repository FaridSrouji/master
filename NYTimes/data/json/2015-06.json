t-mitch/17firstdraft-mitch-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/17/us/politics/17firstdraft-mitch/17firstdraft-mitch-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Today in Politics: The Congressional Money Wars Are Heating Up', 'kicker': 'First Draft', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-18T11:00:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/f4998a36-2d46-5d99-8ece-01906c4d936c', 'word_count': 1173, 'uri': 'nyt://article/f4998a36-2d46-5d99-8ece-01906c4d936c'}, {'abstract': 'The network is in the middle of a creative renaissance — and a business-model crisis.', 'web_url': 'https://www.nytimes.com/2015/06/21/magazine/comedy-central-in-the-post-tv-era.html', 'snippet': 'The network is in the middle of a creative renaissance — and a business-model crisis.', 'lead_paragraph': 'Backstage at Cobb’s Comedy Club on the first Saturday in May, Trevor Noah, fresh from the stage, stood sweating through a blue T-shirt, beside a refrigerator stocked with energy drinks. He guzzled from a can as well-wishers popped into his dressing room, getting in their hellos and handshakes before Noah’s second set of the evening. Noah is a 31-year-old comedian from South Africa, and in September, he is scheduled to take over for Jon Stewart as host of “The Daily Show.” For this reason, Noah gave an especially warm welcome to one backstage visitor: Kent Alterman, the president of content and original programming at Comedy Central, the network Noah had just joined. Alterman had flown from Los Angeles, where he lives and works, to San Francisco, where Cobb’s is located, to watch Noah perform. He helped lead the search for Stewart’s replacement, but tonight would be his first time seeing Noah work a crowd in person. “I’ve known Trevor a few years now, and he’s someone we’ve had our eyes on,” Alterman said. “But I’ve never actually seen him do stand-up before.”', 'print_section': 'MM', 'print_page': '39', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/21/magazine/21mag-comedycentral5/21mag-comedycentral5-articleLarge-v2.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/21/magazine/21mag-comedycentral5/21mag-comedycentral5-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/21/magazine/21mag-comedycentral5/21mag-comedycentral5-jumbo-v2.jpg', 'height': 767, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/21/magazine/21mag-comedycentral5/21mag-comedycentral5-superJumbo-v2.jpg', 'height': 1535, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/21/magazine/21mag-comedycentral5/21mag-comedycentral5-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/21/magazine/21mag-comedycentral5/21mag-comedycentral5-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'c