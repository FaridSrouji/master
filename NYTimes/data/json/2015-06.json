ary', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Howard, Arliss', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Kelemen, Henry', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Ritter, Jason', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Frangione, Jim', 'rank': 10, 'major': 'N'}, {'name': 'creative_works', 'value': 'Ghost Stories (Play)', 'rank': 11, 'major': 'N'}, {'name': 'creative_works', 'value': 'Shawl, The (Play)', 'rank': 12, 'major': 'N'}, {'name': 'creative_works', 'value': 'Prairie du Chien (Play)', 'rank': 13, 'major': 'N'}], 'pub_date': '2015-06-17T02:00:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/83d73c0e-a10b-562a-8c70-ddcdf5838ebe', 'word_count': 829, 'uri': 'nyt://article/83d73c0e-a10b-562a-8c70-ddcdf5838ebe'}, {'abstract': 'This Shakespeare in the Park production about a duke living in exile features well-known names and the unpredictability of the weather.', 'web_url': 'https://www.nytimes.com/2015/06/17/theater/review-the-tempest-stars-sam-waterston-and-the-weather-at-delacorte-theater.html', 'snippet': 'This Shakespeare in the Park production about a duke living in exile features well-known names and the unpredictability of the weather.', 'lead_paragraph': 'As befits a work called “The Tempest,” there’s thunder and lightning aplenty in the production that opened on Tuesday night at the Delacorte Theater in Central Park. Yet “rough magic” — which is abjured at the play’s end by its ruling wizard, Prospero (a sagely bearded Sam Waterston) — is scarce throughout this exquisite-looking interpretation of Shakespeare’s valedictory romance.', 'print_section': 'C', 'print_page': '1', 'source':