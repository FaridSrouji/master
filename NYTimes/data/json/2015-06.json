TCH1/17KITCH1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/17/dining/17KITCH1/17KITCH1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/17/dining/17KITCH1/17KITCH1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Fresh Ricotta Turns a Simple Pasta Dish Sublime', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fresh Ricotta Elevates the Simple to the Sublime', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tanis, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cheese', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Pasta', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetables', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Summer (Season)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-06-12T15:39:40+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d5a87bf-94e2-5eb1-9d2b-b20d74c83401', 'word_count': 588, 'uri': 'nyt://article/1d5a87bf-94e2-5eb1-9d2b-b20d74c83401'}, {'abstract': 'Getting beyond the “red family” versus “blue family” debate.', 'web_url': 'https://douthat.blogs.nytimes.com/2015/06/12/folkways-and-family-structure/', 'snippet': 'Getting beyond the “red family” versus “blue family” debate.', 'lead_paragraph': 'Occasionally in the debates about family structure in America, I’ve had reason to point out the limits of the popular\xa0“red family, blue family” dichotomy, which portrays a post-sexual revolution America divided between a late-marrying, lower-divorce-rate model of family formation in liberal regions and an earlier-marrying, frequently-divorcing model in more conservative and religious states. This portrayal, particularly associated with the sociologists Naomi Cahn and June Carbone, definitely captures one distinctive reality of American life\xa0— the fact that stable two-parent homes are more common among secular liberal Bobos in the BosWash corridor and elsewhere than they are\xa0in, say, certain regions in the Bible Belt. But it’s also important to recognize the exceptions to this pattern, from “red” social models (in the High Plains and Mormon Utah, in particular) that combine high marriage rates and birthrates and relative family stability to “blue” social models (inner city, Rust Belt, Southwestern) that are as unstable as anything Alabaman and Mississippian. (And that’s without getting into the issue of abortion as a necessary prop for “blue” stability.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Folkways and Family in America', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Mormons (Church of Jesus Christ of Latter-Day Saints)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Cahn, Naomi', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Carbone, June', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Leonhardt, David', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Novak, Michael (1933- )', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Midwestern States (US)', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'New England States (US)', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Pacific Northwestern States (US)', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Rocky Mountain States (US)', 'rank': 14, 'major': 'N'}, {'name': 'glocations', 'value': 'Southwestern States (US)', 'rank': 15, 'major': 'N'}, {'name': 'glocations', 'value': 'Utah', 'rank': 16, 'major': 'N'}], 'pub_date': '2015-06-12T15:41:58+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ab997ab1-d773-5933-b334-2611b2439416', 'word_count': 1190, 'uri': 'nyt://article/ab997ab1-d773-5933-b334-2611b2439416'}, {'abstract': '“She’s an ideal fit for us,” said Chris D’Amelio, a partner of David Zwirner.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/06/12/sherrie-levine-moves-to-david-zwirner/', 'snippet': '“She’s an ideal fit for us,” said Chris D’Amelio, a partner of David Zwirner.', 'lead_paragraph': 'Sherrie Levine is switching galleries, but she won’t be moving very far. After more than a decade and a half with the Paula Cooper Gallery, Ms. Levine will join the David Zwirner Gallery, just a couple blocks south in Chelsea.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sherrie Levine Moves to David Zwirner', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Sherrie Levine Moves To Zwirner Gallery', 'name': None, 'seo': None, 'sub': None}