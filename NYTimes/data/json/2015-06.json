a': [], 'headline': {'main': 'Botany of Desire', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Botany of Desire', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jewels and Jewelry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}], 'pub_date': '2015-06-11T13:00:48+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad138edf-974c-56c1-8f5f-fb9a991d6ef8', 'word_count': 13, 'uri': 'nyt://article/ad138edf-974c-56c1-8f5f-fb9a991d6ef8'}, {'abstract': 'A system where confessions are obtained under torture and terrorism suspects are tried in secret results in outrage abroad.', 'web_url': 'https://www.nytimes.com/2015/06/11/opinion/no-justice-in-pakistan.html', 'snippet': 'A system where confessions are obtained under torture and terrorism suspects are tried in secret results in outrage abroad.', 'lead_paragraph': 'In Pakistan, the innocent are executed and the guilty go free. On Wednesday, Aftab Bahadur, who was 15 years old when he was convicted of murder after a forced confession under torture, was executed. Mr. Bahadur had spent 22 years on death row. Two witnesses against him later recanted and declared him innocent. Meanwhile, it came to light last Friday that eight of 10 men who were reported to have been given life sentences by a secret military court in April for their role in the 2012 attack on the Nobel Prize winner and education activist Malala Yousafzai had quietly been released.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Justice in Pakistan', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'No Justice in Pakistan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Pakistan', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-06-11T13:03:46+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/0174387f-4440-582d-ba6d-6a153e16e630', 'word_count': 384, 'uri': 'nyt://article/0174387f-4440-582d-ba6d-6a153e16e630'}, {'abstract': 'Mr. Coleman was a leader in making jazz less beholden to rules of harmony and rhythm.', 'web_url': 'https://www.nytimes.com/2015/06/12/arts/music/ornette-coleman-jazz-saxophonist-dies-at-85-obituary.html', 'snippet': 'Mr. Coleman was a leader in making jazz less beholden to rules of harmony and rhythm.', 'lead_paragraph': 'Ornette Coleman, the alto saxophonist and composer who was one of the most powerful and contentious innovators in the history of jazz, died on Thursday in Manhattan. He was 85.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/arts/12coleman-web2-copy/12coleman-web2-copy-articleLarge-v3.jpg', 'height': 825, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/12/arts/12coleman-web2-copy/12coleman-web2-copy-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 825}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/arts/12coleman-web2-copy/12coleman-web2-copy-jumbo-v3.jpg', 'height': 1024, 'width': 745, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/12/arts/12coleman-web2-copy/12coleman-web2-copy-superJumbo-v3.jpg', 'height': 2048, 'width': 