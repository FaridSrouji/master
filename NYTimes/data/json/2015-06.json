merican Tale', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Illegal Immigration', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Fred C', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Tyson, Mike', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Queens (NYC)', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Yukon Territory', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-06-30T19:57:27+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Lawrence Downes', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Downes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8aec2418-082b-51c4-9895-e7589a5f7ee8', 'word_count': 397, 'uri': 'nyt://article/8aec2418-082b-51c4-9895-e7589a5f7ee8'}, {'abstract': 'An Israeli man, shot while riding in a car, died Tuesday as Israel blamed Palestinian television for inciting a recent wave of violence.', 'web_url': 'https://www.nytimes.com/2015/07/01/world/middleeast/israeli-man-dies-in-attack-near-west-bank-settlement.html', 'snippet': 'An Israeli man, shot while riding in a car, died Tuesday as Israel blamed Palestinian television for inciting a recent wave of violence.', 'lead_paragraph': 'JERUSALEM — An Israeli man died Tuesday after being shot in the West Bank the night before. Palestinian gunmen are suspected in the attack on the victim, Malakhi Rosenfeld, 26, a student at the Hebrew University of Jerusalem, and three other Israelis as they rode in a car near an Israeli settlement. Also Tuesday, Israeli security guards shot and wounded a Palestinian man at the Kalandia crossing between Jerusalem and the West Bank city of Ramallah. The Israeli police said the man had run at the guards and ignored warnings to stop. Israel’s defense minister, Moshe Yaalon, blamed a recent wave of attacks on programs on Palestinian television that he said incited violence.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Israeli Man Dies in Attack Near West Bank Settlement', 'kicker': None, 'content_kicker': None, 'print_headline': 'World Briefing | Middle East; Israel: Man Dies After West Bank Attack', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'West Bank', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Israeli Settlements', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Rosenfeld, Malakhi (d 2015)', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-06-30T20:00:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Isabel Kershner', 'person': [{'firstname': 'Isabel', 'middlename': None, 'lastname': 'Kershner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e6ae093-c366-5a6f-a315-f2ad41