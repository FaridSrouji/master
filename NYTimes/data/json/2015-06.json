': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/science/30BIRTH/30BIRTH-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/07/01/science/30BIRTH/30BIRTH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/science/30BIRTH/30BIRTH-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/science/30BIRTH/30BIRTH-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/science/30BIRTH/30BIRTH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/07/01/science/30BIRTH/30BIRTH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/07/01/science/30BIRTH/30BIRTH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Report Shows Widespread Mistreatment by Health Workers During Childbirth', 'kicker': None, 'content_kicker': None, 'print_headline': 'Abusive Treatment in Childbirth Is Detailed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Grady, Denise', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'PLoS Medicine (Journal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Hospitals', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-06-30T18:41:20+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'Health', 'byline': {'original': 'By Denise Grady', 'person': [{'firstname': 'Denise', 'middlename': None, 'lastname': 'Grady', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5336d09a-23ff-58f2-8350-81dc6d74c38f', 'word_count': 678, 'uri': 'nyt://article/5336d09a-23ff-58f2-8350-81dc6d74c38f'}, {'abstract': 'Los Angeles-based Nick Fouquet’s bold techniques have included using fire and paint, distressing felt and reinventing classic shapes altogether.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2015/06/30/nick-fouquet-hat-maker-beloved-by-madonna-sia-bob-dylan/', 'snippet': 'Los Angeles-based Nick Fouquet’s bold techniques have included using fire and paint, distressing felt and reinventing classic shapes altogether.', 'lead_paragraph': 'Los Angeles-based Nick Fouquet is in many ways the ultimate California dude — tall and lanky, with a shaggy blond mane that simply begs to have a hat put on it — but don’t call him a milliner. His approach to hat making is anything but traditional. “I’ve always wanted to do my own thing,” he says, “and it’s such a niche market and undervalued accessory. To me, hats are the pinnacle of elegance. I’m not here to reinvent them — but to do it with my twist; not over-the-top or dramatic, like a milliner might.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/30/t-magazine/30symonds-fouquet2/30symonds-fouquet2-articleLarge.jpg', 'height': 660, 'width': 600, 'subType': 'xlarge', '