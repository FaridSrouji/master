name': 'Erik', 'middlename': None, 'lastname': 'Eckholm', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44de2edf-e10a-57bb-b7a3-b67ea038f38d', 'word_count': 376, 'uri': 'nyt://article/44de2edf-e10a-57bb-b7a3-b67ea038f38d'}, {'abstract': 'Miró’s American influences come through in this exhibition at Nahmad Contemporary.', 'web_url': 'https://www.nytimes.com/2015/06/26/arts/design/reviewjoan-mirooiseaux-dans-lespace.html', 'snippet': 'Miró’s American influences come through in this exhibition at Nahmad Contemporary.', 'lead_paragraph': '“The Birth of the World,” Joan Miró’s clairvoyant masterpiece from 1927, presaged much of postwar American painting — the early date can elicit a double take when you see it at the Museum of Modern Art. Its expansive surface of thin gray pours and washes, and the delicate lines and shapes in black, red and white that dance across them, open a pathway to so much: the automatic drawing of Surrealism, the frank painterliness and scale of Abstract Expressionism and the lightness and elegance of Color Field painting.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26MIROGALLERY1/0626MIROGALLERY1-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/26/arts/26MIROGALLERY1/0626MIROGALLERY1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26MIROGALLERY1/0626MIROGALLERY1-jumbo.jpg', 'height': 769, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26MIROGALLERY1/0626MIROGALLERY1-superJumbo.jpg', 'height': 1537, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26MIROGALLERY1/0626MIROGALLERY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/06/26/arts/26MIROGALLERY1/0626MIROGALLERY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26MIROGALLERY1/0626MIROGALLERY1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review:\xa0Joan Miró,\xa0‘Oiseaux Dans l’Espace’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Joan Miró', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Miro, Joan', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-06-25T21:32:49+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/63bc0725-c743-584d-97e8-41a21ea9abcc', 'word_count': 266, 'uri': 'nyt://article/63bc0725-c743-584d-97e8-41a21ea9abcc'}, {'abstract': 'This exhibition at the New Museum traces a transformative exploration of the medium, covering 10 series of images made between 1978 and 2012.', 'web_url': 'https://www.nytimes.com/2015/06/26/arts/design/review-sarah-charlesworth-doubleworld-studies-perceptions-shaped-by-photography.html', 'snippet': 'This exhibition at the New Museum traces a transformative exploration of the medium, covering 10 series of images made between 1978 and 2012.', 'lead_paragraph': 'In 1990, when Sarah Charlesworth characterized her interest in photography as “an engagement with a problem rather than a medium,” she spoke for many photo-based artists. Called the Pictures Generation, they were born around 1950 and emerged in the late 1970s and early ’80s, standing on the shoulders of the Conceptualists, and for them, photography was very much a “problem.” It sold products, objectified women, glorified men, mythologized nations and rarely told the truth. The Pictures artists were less focused on taking photographs than on making them — through appropriation, distortion and rephotography — to expose the medium’s many manipulations, fictions and tricks. ', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26SARAH/26SARAH-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/06/26/arts/26SARAH/26SARAH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26SARAH/26SARAH-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26SARAH/26SARAH-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/06/26/arts/26SARAH/26SARAH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thum