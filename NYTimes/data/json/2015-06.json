r it.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/t-magazine/21moskowitz-hartman-slide-V502/21moskowitz-hartman-slide-V502-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/10/21/t-magazine/21moskowitz-hartman-slide-V502/21moskowitz-hartman-slide-V502-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/t-magazine/21moskowitz-hartman-slide-V502/21moskowitz-hartman-slide-V502-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/t-magazine/21moskowitz-hartman-slide-V502/21moskowitz-hartman-slide-V502-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/t-magazine/21moskowitz-hartman-slide-V502/21moskowitz-hartman-slide-V502-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/10/21/t-magazine/21moskowitz-hartman-slide-V502/21moskowitz-hartman-slide-V502-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/10/21/t-magazine/21moskowitz-hartman-slide-V502/21moskowitz-hartman-slide-V502-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Design Secrets of eBay’s Tastemaker in Chief', 'kicker': 'Home and Work', 'content_kicker': None, 'print_headline': ''