REST-slide-MSLR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Chelsea, a Refined Approach to Korean Dining', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Korean Food (Cuisine)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hwaban (Manhattan, NY, Restaurant)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Chelsea (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-12-31T18:33:54+0000', 'document_type': 'multimedia', 'news_desk': 'Food', 'section_name': 'Food', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/3247c582-39af-59fe-b4e4-9af9dc47e36c', 'word_count': 0, 'uri': 'nyt://slideshow/3247c582-39af-59fe-b4e4-9af9dc47e36c'}, {'abstract': 'A tranquil dining room in Chelsea with an inexpensive prix-fixe menu stands out in a crowd of youth-oriented kimchi palaces.', 'web_url': 'https://www.nytimes.com/2018/12/31/dining/hwaban-korean-restaurant-review.html', 'snippet': 'A tranquil dining room in Chelsea with an inexpensive prix-fixe menu stands out in a crowd of youth-oriented kimchi palaces.', 'lead_paragraph': 'Americans who weren’t born into Korean cuisine have discovered it in many ways and many locales over the past decade or two. Bulgogi folded into tortillas has been handed out through the window of a roving truck. Smoked kimchi has been draped over pulled pork between halves of a cheese-glazed doughnut to make an outdoor food-stall sandwich called the Chonut. Hwe, raw fish eaten with condiments that typically spread across an entire table, has been streamlined to one or two bites in a tasting menu administered by servers in sci-fi tunics. The pork belly dish bo ssam has been reimagined as a whole roasted pork shoulder that a gang of hungry people could use in a bonding ritual involving heads of lettuce, a platter of oysters and a pair of tongs.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/01/02/dining/02REST-slide-MSLR/02REST-slide-MSLR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtyp