s/2018/12/03/opinion/03TP-LEE1/03TP-LEE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03TP-LEE1/03TP-LEE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Creating a United, and Welcoming, Korea', 'kicker': 'Turning Points', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defectors (Political)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'North Korea', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-12-04T00:00:04+0000', 'document_type': 'article', 'news_desk': 'SpecialSections', 'section_name': 'Opinion', 'byline': {'original': 'By Hyeonseo Lee', 'person': [{'firstname': 'Hyeonseo', 'middlename': None, 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/281abb72-87b7-59f6-9be7-6ead7f4b9fa3', 'word_count': 931, 'uri': 'nyt://article/281abb72-87b7-59f6-9be7-6ead7f4b9fa3'}, {'abstract': 'It’s where the conspiracy theorizing and menacing of critics began.', 'web_url': 'https://www.nytimes.com/2018/12/03/opinion/climate-denial-trump-gop.html', 'snippet': 'It’s where the conspiracy theorizing and menacing of critics began.', 'lead_paragraph': 'Many observers seem baffled by Republican fealty to Donald Trump — the party’s willingness to back him on all fronts, even after severe defeats in the midterm elections. What kind of party would show such support for a leader who is not only evidently corrupt and seemingly in the pocket of foreign dictators, but also routinely denies facts and tries to criminalize anyone who points them out?', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03krugman/merlin_143606511_e9fb4be2-a97b-4031-b2f5-9ebc760a1c96-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/03/opinion/03krugman/merlin_143606511_e9fb4be2-a97b-4031-b2f5-9ebc760a1c96-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03krugman/merlin_143606511_e9fb4be2-a97b-4031-b2f5-9ebc760a1c96-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03krugman/merlin_143606511_e9fb4be2-a97b-4031-b2f5-9ebc760a1c96-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03krugman/03krugman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/03/opinion/03krugman/03krugman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03krugman/03krugman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Climate Denial Was the Crucible for Trumpism', 'kicker': None, 'content_kicker': None, 'print_headline': 'Climate Denial As the Crucible For Trumpism', 'name'