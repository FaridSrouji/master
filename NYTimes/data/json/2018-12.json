rge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seahawks Puff Out Their Chests and Turn Toward the Playoffs', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rebuilt Seahawks Celebrate Playoffs And Perseverance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Seattle Seahawks', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Carroll, Pete', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, Russell (1988- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-12-24T15:33:27+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Kurt Streeter', 'person': [{'firstname': 'Kurt', 'middlename': None, 'lastname': 'Streeter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/06594d93-4f44-55b0-8508-2f1769cca21e', 'word_count': 883, 'uri': 'nyt://article/06594d93-4f44-55b0-8508-2f1769cca21e'}, {'abstract': 'Christmas is a reminder of the radical power of humility, amazement and embracing the Other. ', 'web_url': 'https://www.nytimes.com/2018/12/24/opinion/christmas-wonder.html', 'snippet': 'Christmas is a reminder of the radical power of humility, amazement and embracing the Other. ', 'lead_paragraph': 'For me, few images of Christ’s nativity convey its strange, luminescent wonder as much as William Blake’s “The Descent of Peace.” Painted in the early 19th century as part of a series of illustrations for John Milton’s “On the Morning of Christ’s Nativity,” Blake imagined the scene as bathed in an otherworldly light that holds the darkness at bay while an angel somersaults in the heavens. Within the manger, the infant Christ floats in the air with arms outstretched above an exhausted Virgin Mary. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/opinion/24STONE/24STONE-articleLarge.jpg', 'height': 755, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/24/opinion/24STONE/24STONE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 755}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/opinion/24STONE/24STONE-jumbo.jpg', 'height': 1024, 'width': 814, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/opinion/24STONE/24STONE-superJumbo.jpg', 'height': 2048, 'width': 1628, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/opinion/24STONE/24STONE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/24/opinion/24STONE/24STONE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/opinion/24STONE/24STONE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Praise of Wonder', 'kicker': 'THE STONE', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christmas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jesus Christ', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Blake, William', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-12-24T16:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ed Simon', 'person': [{'firstname': 'Ed', 'middlename': None, 'lastname': 'Simon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/310ab1bc-3e33-56b3-bdb0-66ea1b49a6a1', 'word_count': 1033, 'uri': 'nyt://article/310ab1bc-3e33-56b3-bdb0-66ea1b49a6a1'}, {'abstract': 'A documentary and a hologram concert re-creation celebrating the famous opera singer are testament to her enduring legacy. Get in line. ', 'web_url': 'https://www.nytimes.com/2018/12/24/opinion/maria-callas-movie-hologram.html', 'snippet': 'A documentary and a hologram concert re-creation celebrating the famous opera singer are testament to her enduring legacy. Get in line. ', 'lead_paragraph': 'Why do we find such enduring fascination with Maria Callas more than 40 years after her death at age 53? What is it about this opera diva, whose life and career were equal parts brilliant and tormented, that excites us so? And what the heck did she see in Aristotle Onassis?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/27/opinion/27belcher/merlin_145896783_ee1ff32d-6700-47ca-8e35-07a6021b5acc-articleLarge.jpg', 'height': 634, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/27/opinion/27belcher/merlin_145896783_ee1ff32d-6700-47ca-8e35-07a6021b5acc-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 634}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/27/opinion/27belcher/merlin_145896783_ee1ff32d-6700-47ca-8e35-07a6021b5acc-jumbo.jpg', 'height': 1024, 'width': 970, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 