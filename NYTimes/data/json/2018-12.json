on': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'Astor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d08be39f-c68b-5d5b-a519-cb7a4446ecd2', 'word_count': 799, 'uri': 'nyt://article/d08be39f-c68b-5d5b-a519-cb7a4446ecd2'}, {'abstract': 'Danielle Macdonald stars in this uninspired adaptation of Julie Murphy’s young adult novel about a big girl’s struggle against small minds.', 'web_url': 'https://www.nytimes.com/2018/12/05/movies/dumplin-review.html', 'snippet': 'Danielle Macdonald stars in this uninspired adaptation of Julie Murphy’s young adult novel about a big girl’s struggle against small minds.', 'lead_paragraph': 'In the comedy “Dumplin’,” the sometimes sweet and occasionally sour story is just another excuse for packaged uplift. The title refers to the unwelcome nickname that the teenage Willowdean, a.k.a. Will (an irrepressible Danielle Macdonald), has been given by her mother, Rosie (Jennifer Aniston, fine if miscast). A former beauty queen, Rosie devotes much of her energy to pageants, including the local Miss Teen Bluebonnet contest. Rosie has obvious issues with Will, who seems as reasonably sane and together as anyone her age. She’s pretty, smart, mindful. But the nickname suggests that her mother sees her daughter as a blob of dough — barely formed, malleable, disposable.', 'print_section': 'C', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07dumplin/merlin_147541866_b63a4710-9231-4d7c-af19-d0d94aac03c7-articleLarge.jpg', 'height': 461, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/07/arts/07dumplin/merlin_147541866_b63a4710-9231-4d7c-af19-d0d94aac03c7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 461}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07dumplin/merlin_147541866_b63a4710-9231-4d7c-af19-d0d94aac03c7-jumbo.jpg', 'height': 787, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07dumplin/merlin_147541866_b63a4710-9231-4d7c-af19-d0d94aac03c7-superJumbo.jpg', 'height': 1574, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07dumplin/07dumplin-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/07/arts/07dumplin/07dumplin-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07dumplin/07dumplin-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Dumplin’’ Shares an Ordinary Girl’s Truth', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Strong Girl Takes a Detour, Thanks to Mom', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ANISTON, JENNIFER', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fletcher, Anne', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rush, Odeya', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': "Dumplin' (Movie)", 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Macdonald, Danielle (Actor)', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-12-05T23:28:51+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': '