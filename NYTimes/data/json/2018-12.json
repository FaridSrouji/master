pe': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/20/opinion/20GreenHouse/20GreenHouse-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/20/opinion/20GreenHouse/20GreenHouse-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/20/opinion/20GreenHouse/20GreenHouse-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Supreme Court Divided. On the Right.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conservatism (US Politics)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-12-20T11:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Linda Greenhouse', 'person': [{'firstname': 'Linda', 'middlename': None, 'lastname': 'Greenhouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/99b3361c-faa4-5cb3-b761-277d7f2e31a6', 'word_count': 1503, 'uri': 'nyt://article/99b3361c-faa4-5cb3-b761-277d7f2e31a6'}, {'abstract': 'The president and the senator both want you to know that our system is “rigged.”', 'web_url': 'https://www.nytimes.com/2018/12/20/opinion/elizabeth-warren-trump.html', 'snippet': 'The president and the senator both want you to know that our system is “rigged.”', 'lead_paragraph': 'For decades, the left sought to dethrone the idea of truth. Truth was not an absolute. It was a matter of power. Of perspective. Of narrative. “Truth is a thing of this world,” wrote Michel Foucault. “Each society has its regime of truth, its ‘general politics’ of truth: that is, the types of discourse which it accepts and makes function as true.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/20/opinion/20stephensWeb/merlin_148145634_f1a181fd-47d6-4a2a-a8cf-41bf086a82ff-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/20/opinion/20stephensWeb/merlin_148145634_f1a181fd-47d6-4a2a-a8cf-41bf086a82ff-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/20/opinion/20stephensWeb/merlin_148145634_f1a181fd-47d6-4a2a-a8cf-41bf086a82ff-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/20/opinion/20stephensWeb/merlin_148145634_f1a181fd-47d6-4a2a-a8cf-41bf086a82ff-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/20/opinion/20stephensWeb/20stephensWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/20/opinion/20stephensWeb/20stephensWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/20/opinion/20stephensWeb/20stephensWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}