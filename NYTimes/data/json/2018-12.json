rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/df0a06d3-1189-58ff-a717-1e5e7eff4016', 'word_count': 869, 'uri': 'nyt://article/df0a06d3-1189-58ff-a717-1e5e7eff4016'}, {'abstract': 'The No. 1 pick in the 2017 draft will receive physical therapy for neurogenic thoracic outlet syndrome, an issue more associated with baseball players.', 'web_url': 'https://www.nytimes.com/2018/12/04/sports/markelle-fultz-injury-76ers.html', 'snippet': 'The No. 1 pick in the 2017 draft will receive physical therapy for neurogenic thoracic outlet syndrome, an issue more associated with baseball players.', 'lead_paragraph': 'Markelle Fultz, a guard for the Philadelphia 76ers who has struggled to stay on the court and endured heavy criticism for ongoing shooting woes, has been diagnosed with a nerve disorder. The team announced Tuesday that the injury, which could explain many of his basketball issues, would sideline him indefinitely.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/05/sports/05fultz/merlin_144693558_24fbd80b-c772-4573-a561-0b8d4feb5dae-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/05/sports/05fultz/merlin_144693558_24fbd80b-c772-4573-a561-0b8d4feb5dae-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/05/sports/05fultz/merlin_144693558_24fbd80b-c772-4573-a561-0b8d4feb5dae-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/05/sports/05fultz/merlin_144693558_24fbd80b-c772-4573-a561-0b8d4feb5dae-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name'