o.jpg', 'height': 630, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/27/upshot/27up-hospital-sleep/27up-hospital-sleep-superJumbo.jpg', 'height': 1261, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/27/upshot/27up-hospital-sleep/27up-hospital-sleep-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/27/upshot/27up-hospital-sleep/27up-hospital-sleep-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/27/upshot/27up-hospital-sleep/27up-hospital-sleep-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Hospitals Should Let You Sleep', 'kicker': 'the New Health Care', 'content_kicker': None, 'print_headline': 'Patients Need Rest; Hospitals Should Help', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hospitals', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sleep', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Noise', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tests (Medical)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sedatives', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-12-03T10:00:01+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f061e64b-1d53-5a1a-88b0-6901c7d3ca48', 'word_count': 662, 'uri': 'nyt://article/f061e64b-1d53-5a1a-88b0-6901c7d3ca48'}, {'abstract': 'Small children are especially vulnerable to dehydration, and it’s not only stomach bugs that are a problem. Upper respiratory infections can make it difficult for them to drink.', 'web_url': 'https://www.nytimes.com/2018/12/03/well/family/baby-infant-dehydration-risk.html', 'snippet': 'Small children are especially vulnerable to dehydration, and it’s not only stomach bugs that are a problem. Upper respiratory infections can make it difficult for them to drink.', 'lead_paragraph': 'I saw a worried mother with a sickish 18-month-old in clinic recently. I say sickish because the mother was much more worried than the toddler was sick; the child was ping-ponging around the room, squirming with outrage when examined, and shrieking with delight when tickled. But she had had some low-grade fevers in recent days, and she was still having some diarrhea, and she had thrown up that morning. Her mother was deeply concerned about dehydration, because, as she kept saying, she knew that was dangerous.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/well/family/03klass-bottles/03klass-bottles-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/03/well/family/03klass-bottles/03klass-bottles-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/well/family/03klass-bottles/03klass-bottles-jumbo.jpg', 'height': 575, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/well/family/03klass-bottles/03klass-bottles-superJumbo.jpg', 'height': 767, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumb