: 2, 'major': 'N'}, {'name': 'subject', 'value': 'Area Planning and Renewal', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Relocation of Business', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Island City (Queens, NY)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-onlyinnewyork', 'rank': 8, 'major': 'N'}], 'pub_date': '2018-12-12T23:51:46+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Karen Weise', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Weise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e264090-40dc-5e7f-b87b-76ba9cba59bc', 'word_count': 1180, 'uri': 'nyt://article/8e264090-40dc-5e7f-b87b-76ba9cba59bc'}, {'abstract': 'Practice speaking in a new way in front of a mirror. Give the puppet a persona, then improvise dialogue.', 'web_url': 'https://www.nytimes.com/2018/12/12/magazine/how-to-converse-with-a-hand-puppet.html', 'snippet': 'Practice speaking in a new way in front of a mirror. Give the puppet a persona, then improvise dialogue.', 'lead_paragraph': '“Ventriloquism is more than just knowing how to speak without moving your lips,” says Cecilia Ustav, a Swede who performs as Zillah and appears with a two-foot-tall chimpanzee puppet named Totte. Still, that’s where you should start: in front of a mirror, with your mouth slightly open in a smile, teeth close but not touching. Practice saying the same sentences over and over, until any movement in the jaw and lips becomes undetectable. Ustav, now 29, went to a weekend ventriloquism workshop when she was 12. It took her five years of regular practice to master it. At 18, she won Sweden’s version of the “Got Talent” franchise which led to fame, television shows and a busy performing schedule, sometimes in front of as many as 15,000 people.', 'print_section': 'MM', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/16/magazine/16Mag-Tip-1/16Mag-Tip-1-articleLarge.jpg', 'height': 578, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/16/magazine/16Mag-Tip-1/16Mag-Tip-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 578}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/16/magazine/16Mag-Tip-1/16Mag-Tip-1-jumbo.jpg', 'height': 986, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/16/magazine/16Mag-Tip-1/16Mag-Tip-1-superJumbo.jpg', 'height': 1814, 'width': 1884, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/16/magazine/16Mag-Tip-1/16Mag-Tip-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/16/magazine/16Mag-Tip-1/16Mag-Tip-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/16/magazine/16Mag-Tip-1/16Mag-Tip-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Converse With a Hand Puppet', 'kicker': 'Tip', 'content_kicker': None, 'print_headline': 'How to Converse With A Hand Puppet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pup