us.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/30/us/politics/30dc-hulse-print/merlin_148555578_77e638eb-1e24-4611-a4d9-6c1b487cb2eb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/30/us/politics/30dc-hulse-print/merlin_148555578_77e638eb-1e24-4611-a4d9-6c1b487cb2eb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/30/us/politics/30dc-hulse-print/merlin_148555578_77e638eb-1e24-4611-a4d9-6c1b487cb2eb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/30/us/politics/30dc-hulse-print/merlin_148555578_77e638eb-1e24-4611-a4d9-6c1b487cb2eb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/30/us/politics/30dc-hulse-print/30dc-hulse-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/30/us/politics/30dc-hulse-print/30dc-hulse-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/30/us/politics/30dc-hulse-print/30dc-hulse-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘You Control Nothing’: House Republicans Brace for Life in the Minority', 'kicker': 'On Washington', 'content_kicker': None, 'print_headl