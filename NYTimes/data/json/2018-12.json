on', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-12-06T16:12:21+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Ceylan Yeginsu', 'person': [{'firstname': 'Ceylan', 'middlename': None, 'lastname': 'Yeginsu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed1285ee-83c0-5179-907c-397fff83bf39', 'word_count': 696, 'uri': 'nyt://article/ed1285ee-83c0-5179-907c-397fff83bf39'}, {'abstract': 'Recent research shows that social safety net programs benefit everyone. ', 'web_url': 'https://www.nytimes.com/2018/12/06/opinion/medicaid-immigrants-food-stamps-trump.html', 'snippet': 'Recent research shows that social safety net programs benefit everyone. ', 'lead_paragraph': 'Recent Republican attempts to weaken the social safety net have one big thing in common: The pain they would inflict on poor children could last a lifetime. This is not only miserly but also shortsighted. Research shows that safety net programs keep children in school and out of trouble, and increase their chances of being healthier and living longer. All of this has a positive effect on our economy. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/opinion/00kirpWeb/00kirpWeb-articleLarge.jpg', 'height': 405, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/30/opinion/00kirpWeb/00kirpWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 405}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/opinion/00kirpWeb/00kirpWeb-jumbo.jpg', 'hei