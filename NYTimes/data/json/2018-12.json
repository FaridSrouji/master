 toward extinction.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/26/us/politics/26dc-wildlife1-print/merlin_141690645_4f51fa16-918f-4d9d-baa6-e10cf5c96597-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/26/us/politics/26dc-wildlife1-print/merlin_141690645_4f51fa16-918f-4d9d-baa6-e10cf5c96597-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/26/us/politics/26dc-wildlife1-print/merlin_141690645_4f51fa16-918f-4d9d-baa6-e10cf5c96597-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/26/us/politics/26dc-wildlife1-print/merlin_141690645_4f51fa16-918f-4d9d-baa6-e10cf5c96597-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/26/us/politics/26dc-wildlife1-print/00dc-wildlife1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/26/us/politics/26dc-wildlife1-print/00dc-wildlife1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/26/us/politics/26dc-wildlife1-print/00dc-wildlife1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Did Rifles With an American Stamp End Up in the Hands of African Poachers?', 