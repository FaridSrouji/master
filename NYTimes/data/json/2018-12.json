es/2018/12/19/dining/19burner1/merlin_147823401_1e919e4e-8ec1-4fde-91d5-00a5714e0171-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner1/merlin_147823401_1e919e4e-8ec1-4fde-91d5-00a5714e0171-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner1/merlin_147823401_1e919e4e-8ec1-4fde-91d5-00a5714e0171-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/19/dining/19burner1/merlin_147823401_1e919e4e-8ec1-4fde-91d5-00a5714e0171-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner1/merlin_147823401_1e919e4e-8ec1-4fde-91d5-00a5714e0171-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chocolates to Give or Receive', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Serve: Wintry Treats To Give or Receive', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chocolate', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Valerie Confections', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-12-17T18:20:26+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be809cf6-c6af-5d71-b900-6cb390f96f8e', 'word_count': 103, 'uri': 'nyt://article/be809cf6-c6af-5d71-b900-6cb390f96f8e'}, {'abstract': 'Outrage over civilian deaths in Yemen has focused on airstrikes. But at sea, the Saudi-led coalition is suspected of attacking many fishing boats, killing dozens of people.', 'web_url': 'https://www.nytimes.com/2018/12/17/world/middleeast/yemen-fishing-boats-saudi.html', 'snippet': 'Outrage over civilian deaths in Yemen has focused on airstrikes. But at sea, the Saudi-led coalition is suspected of attacking many fishing boats, killing dozens of people.', 'lead_paragraph': 'KHOKHA, Yemen — The first sign of trouble was the helicopter that hovered over the small Yemeni fishing trawler as it cut across the Red Sea. Then a warship appeared, its guns pointed at the boat.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/18/world/xxyemen1-promo/xxyemen1-promo-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/18/world/xxyemen1-promo/xxyemen1-promo-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/18/world/xxyemen1-promo/xxyemen1-promo-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/18/world/xxyemen1-promo/xxyemen1-promo-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/18/world/xxyemen1-promo/xxyemen1-promo-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/18/world/xxyemen1-promo/xxyemen1-promo-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/18/world/xxyemen1-promo/xxyemen1-promo-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Saudi Arabia’s War in Yemen, No Refuge on Land or Sea', 'kicker': None, 'content_kicker': None, 'print_headline': 'Yemen’s Seas Become Deadly For Fishermen in a War Zone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Yemen', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Saudi Arabia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Civilian Casualties', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fishing, Commercial', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Houthis', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-12-17T18:24:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Declan Walsh', 'person': [{'firstname': 'Declan', 'middlename': None, 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/905e0033-8222-5814-a877-5b506d5e005c', 'word_count': 2310, 'uri': 'nyt://article/905e0033-8222-5814-a877-5b506d5e005c'}, {'abstract': 'Prime Minister Theresa May is adamantly opposed to the idea, but many now see it as the way out of Britain’s Brexit nightmare. Here is a guide to the process.', 'web_url': 'https://www.nytimes.com/2018/12/17/world/europe/brexit-second-referendum-may.html', 'snippet': 'Prime Minister Theresa May is adamantly opposed to the idea, but many now see it as the way out of Britain’s Brexit nightmare. Here is a guide to the process.', 'lead_paragraph': 'Just a few months ago, the idea of a so-called “people’s vote,” or second referendum, on Britain’s withdrawal from the European Union was regarded by most commentators as fanciful. Now, an increasing number see it as the way out of Britain’s Brexit nightmare.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is a 2nd Brexit Referendum Really the Answer? A User’s Guide', 'kicker': None, 'content_kicker': None, 'print_headline': 'Could Second Referendum End the Brexit Nightmare?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Great Britain Withdrawal from EU (Brexit)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'May, Theresa M', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Boris', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Referendums', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 7, 'major': 'N'}], 'pub_date': '2018-12-17T18:24:50+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Stephen Castle', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Castle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/304f6904-2141-5b9d-8350-30439ca9ff7d', 'word_count': 995, 'uri': 'nyt://article/304f6904-2141-5b9d-8350-30439ca9ff7d'}, {'abstract': 'Several butchers around the country offer meat-of-the-month gifts for the connoisseur.', 'web_url': 'https://www.nytimes.com/2018/12/17/dining/salami-charcuterie-meat-gifts.html', 'snippet': 'Several butchers around the country offer meat-of-the-month gifts for the connoisseur.', 'lead_paragraph': 'I make my own choices, so I’m not a fan of the curated box of goods as something to give or to receive. But there are a few notable exceptions. Sausage assortments, for example, can provide tasty discoveries. Several boutique sausage makers offer subscriptions for monthly deliveries of their salami and other cured sausages. Peter Seghesio’s Journeyman Meat Company in Healdsburg, Calif., sells subscriptions to its Meat Guild for quarterly salami deliveries. Olympia Provisions in Portland, Ore., has charcuterie boxes with several meats for monthly delivery. Justin Severino of Salty Pork Bits in Pittsburgh, who makes some unusual salami like leek-ash-porcini, and Iberian pepper, has subscriptions that sell out quickly.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner2/merlin_147823452_c49f6275-bce1-4368-8422-113580b835cb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/19/dining/19burner2/merlin_147823452_c49f6275-bce1-4368-8422-113580b835cb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner2/merlin_147823452_c49f6275-bce1-4368-8422-113580b835cb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner2/merlin_147823452_c49f6275-bce1-4368-8422-113580b835cb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner2/19burner2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/19/dining/19burner2/19burner2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner2/19burner2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Subscription Salami. Charcuterie, Too.', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Sample: Subscription Meats For the Connoisseur', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sausages', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Meat', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Gifts', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Olympia Provisions', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Journeyman Meat Co', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Salty Pork Bits (Retailer)', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-12-17T18:32:35+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/266157e4-cfa1-5d73-adeb-29d0826df3da', 'word_count': 165, 'uri': 'nyt://article/266157e4-cfa1-5d73-adeb-29d0826df3da'}, {'abstract': 'Rum, vodka and gin from Harlem Haberdashery dress up any cocktail.', 'web_url': 'https://www.nytimes.com/2018/12/17/dining/drinks/hh-bespoke-spirits.html', 'snippet': 'Rum, vodka and gin from Harlem Haberdashery dress up any cocktail.', 'lead_paragraph': 'Bespoke is a term used for custom-tailored clothing, and it describes some of the goods at the uptown New York boutique Harlem Haberdashery and its parent company, 5001 Flavors. Sharene and Guy Wood, who run the company with family members and other partners, have also used the term for their new line of spirits. HH Bespoke Gin is in the dry London style, with a mellow finish. Bespoke Vodka is a clean spirit made mainly from corn. Bespoke Rum, a barrel-aged blend, delivers sweetness and spice, and could stand in for bourbon in a cocktail. Because of liquor laws, these bottles are not sold at Harlem Haberdashery.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner6/19burner6-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/19/dining/19burner6/19burner6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner6/19burner6-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/19/dining/19burner6/19burner6-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, '