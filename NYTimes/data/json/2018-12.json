 None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/79eea9e3-3ed8-581f-a960-f65f63a53f1d', 'word_count': 833, 'uri': 'nyt://article/79eea9e3-3ed8-581f-a960-f65f63a53f1d'}, {'abstract': 'Jim Mattis was a scholar of war, blunt, courageous and loyal to his troops. Our enemies will cheer his departure.', 'web_url': 'https://www.nytimes.com/2018/12/23/opinion/jim-mattis-resignation-trump.html', 'snippet': 'Jim Mattis was a scholar of war, blunt, courageous and loyal to his troops. Our enemies will cheer his departure.', 'lead_paragraph': 'I met Jim Mattis in Anbar Province, Iraq, in 2004. He was a major general, commanding the First Marine Division in a tough counterinsurgency fight. I was an Army major, serving in a tank battalion that the Army had provided to the Marines to give them extra firepower. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/23/opinion/23nagl/merlin_148365936_c90f37ca-a191-42a7-9c19-84484cacfea2-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/23/opinion/23nagl/merlin_148365936_c90f37ca-a191-42a7-9c19-84484cacfea2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/23/opinion/23nagl/merlin_148365936_c90f37ca-a191-42a7-9c19-84484cacfea2-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/23/opinion/23nagl/merlin_148365936_c90f37ca-a191-42a7-9c19-84484cacfea2-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/23/opinion/23nagl/23nagl-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/23/opinion/23nagl/23nagl-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/23/opinion/23nagl/23nagl-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jim Mattis and I Fought Together. No One Called Him Mad Dog.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Marine Corps', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Mattis, James N', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'ANBAR PROVINCE (IRAQ)', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-12-23T16:00:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By John A. Nagl', 'person': [{'firstname': 'John', 'middlename': 'A.', 'lastname': 'Nagl', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/da751b5d-106d-5c63-b8ea-65bea02a22fb', 'word_count': 895, 'uri': 'nyt://article/da751b5d-106d-5c63-b8ea-65bea02a22fb'}, {'abstract': 'The museum and other cultural organizations were singled out in a paper demanding that the German government cut funding to groups hostile to Israel.', 'web_url': 'https://www.nytimes.com/2018/12/23/arts/design/berlin-jewish-museum-israel-bds-welcome-to-jerusalem.html', 'snippet': 'The museum and other cultural organizations were singled out in a paper demanding that the German government cut funding to groups hostile to Israel.', 'lead_paragraph': 'BERLIN — This city’s Jewish Museum prides itself on stirring things up. In recent exhibitions exploring Jewish stereotypes and attitudes to circumcision, the museum pushed visitors to question what it means to be Jewish in Germany, and the world.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/arts/25GERMANY-ISRAEL-7/merlin_148383288_44defa9b-5b74-4a00-b0ed-e25aa5586acf-articleLarge.jpg', 'height': 404, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/25/arts/25GERMANY-ISRAEL-7/merlin_148383288_44defa9b-5b74-4a00-b0ed-e25aa5586acf-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 404}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/arts/25GERMANY-ISRAEL-7/merlin_148383288_44defa9b-5b74-4a00-b0ed-e25aa5586acf-jumbo.jpg', 'height': 689, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/arts/25GERMANY-ISRAEL-7/merlin_148383288_44defa9b-5b74-4a00-b0ed-e25aa5586acf-superJumbo.jpg', 'height': 1378, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/arts/25GERMANY-ISRAEL-7/25GERMANY-ISRAEL-7-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/25/arts/25GERMANY-ISRAEL-7/25GERMANY-ISRAEL-7-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/arts/25GERMANY-ISRAEL-7/25GERMANY-ISRAEL-7-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jerusalem Criticizes Berlin’s Jewish Museum for ‘Anti-Israel Activity’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Jewish Museum in Berlin Called ‘Anti-Israel’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Culture (Arts)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Berlin (Germany)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Jerusalem (Israel)', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Jewish Museum Berlin', 'rank': 10, 'major': 'N'}], 'pub_date': '2018-12-23T16:14:16+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Melissa Eddy and Isabel Kershner', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Eddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Isabel', 'middlename': None, 'lastname': 'Kershner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8a192069-4073-52a0-9e9a-0e92b6705518', 'word_count': 1386, 'uri': 'nyt://article/8a192069-4073-52a0-9e9a-0e92b6705518'}, {'abstract': 'Mr. Trump, in a Twitter post, said that Patrick M. Shanahan, Mr. Mattis’s deputy, would serve as the acting defense secretary.', 'web_url': 'https://www.nytimes.com/2018/12/23/us/politics/trump-mattis.html', 'snippet': 'Mr. Trump, in a Twitter post, said that Patrick M. Shanahan, Mr. Mattis’s deputy, would serve as the acting defense secretary.', 'lead_paragraph': 'WASHINGTON — Less than two hours after Defense Secretary Jim Mattis went to the White House on Thursday to hand a resignation letter to President Trump, the president stood in the Oval Office and dictated a glowing tweet announcing that Mr. Mattis was retiring “with distinction” at the end of February.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/us/24dc-mattis-print/24dc-mattis-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/24/us/24dc-mattis-print/24dc-mattis-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/us/24dc-mattis-print/24dc-mattis-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/24/us/24dc-mattis-print/24dc-mattis-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype'