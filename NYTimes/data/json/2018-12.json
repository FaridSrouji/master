one}, 'keywords': [{'name': 'subject', 'value': 'Cyberattacks and Hackers', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Quora.com', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Identity Theft', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-12-04T06:00:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Raymond Zhong', 'person': [{'firstname': 'Raymond', 'middlename': None, 'lastname': 'Zhong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/836b756c-2bcb-5766-aa52-7cba89fe1ea0', 'word_count': 360, 'uri': 'nyt://article/836b756c-2bcb-5766-aa52-7cba89fe1ea0'}, {'abstract': 'The Times’s staff critics give their choices of the best fiction and nonfiction works of the year.', 'web_url': 'https://www.nytimes.com/2018/12/04/books/critics-favorite-books.html', 'snippet': 'The Times’s staff critics give their choices of the best fiction and nonfiction works of the year.', 'lead_paragraph': 'If we had to use a single word to describe the past year in books, it might be eclectic. Novels were told from the perspective of a woman imprisoned for murder, a woman who suddenly inherits a Great Dane and a woman having an affair with a writer who strongly resembles Philip Roth. We also got an esteemed literary biographer turning her lens on herself, a sprawling, fresh look at New York’s postwar art world and cleareyed advice about how to die. As in 2017, some of the year’s best nonfiction addressed global tumult — but a bit more subtly, in several cases, by casting an eye back to distant but still-resonant history, like the decades of deferral and denial that led to the Civil War. Below, The New York Times’s three daily book critics — Dwight Garner, Parul Sehgal and Jennifer Szalai — share their thoughts about their favorites among the books they reviewed this year, each list alphabetical by author. ', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07books-list-lead/07books-list-lead-articleLarge-v3.jpg', 'height': 312, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/07/arts/07books-list-lead/07books-list-lead-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 312}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07books-list-lead/07books-list-lead-jumbo-v3.jpg', 'height': 533, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07books-list-lead/07books-list-lead-superJumbo-v3.jpg', 'height': 1066, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07books-list-lead/07books-list-lead-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/07/arts/07books-list-lead/07books-list-lead-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07books-list-lead/07books-list-lead-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Times Critics’ Top Books of 2018', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Times