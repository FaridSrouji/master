one, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 1, 'major': 'N'}], 'pub_date': '2018-12-21T03:24:15+0000', 'document_type': 'article', 'news_desk': 'Games', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4ab2467d-6a98-5c64-9ddc-d94e43b0649a', 'word_count': 399, 'uri': 'nyt://article/4ab2467d-6a98-5c64-9ddc-d94e43b0649a'}, {'abstract': 'Galt MacDermot had come to my piano from his home on Staten Island, and for no reason other than the spirit of collaboration he’d written the perfect tune to go with my imperfect song.', 'web_url': 'https://www.nytimes.com/2018/12/20/opinion/galt-macdermot.html', 'snippet': 'Galt MacDermot had come to my piano from his home on Staten Island, and for no reason other than the spirit of collaboration he’d written the perfect tune to go with my imperfect song.', 'lead_paragraph': 'Well over a decade ago, Galt MacDermot, a personal hero who died this week, walked into my Greenwich Village apartment with some sheet music, shook my hand and sat down at my piano. I was reeling. To me this wasn’t just the man who wrote the music for “Hair.” This was the underappreciated Grammy Award-winning wizard whose other soulful melodies and unabashed lyricism first spoke to me in my youth and became the choirmaster of my life.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/21/opinion/21MORRIS/merlin_148265361_a2d425a8-9d39-4555-9f15-8f952d5b92f6-articleLarge.jpg', 'height': 903, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/21/opinion/21MORRIS/merlin_148265361_a2d425a8-9d39-4555-9f15-8f952d5b92f6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 903}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/21/opinion/21MORRIS/merlin_148265361_a2d425a8-9d39-4555-9f15-8f952d5b92f6-jumbo.jpg', 'height': 1024, 'width': 681, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/21/opinion/21MORRIS/merlin_148265361_a2d425a8-9d39-4555-9f15-8f952d5b92f6-superJumbo.jpg', 'height': 2048, 'width': 1361, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/21/opinion/21MORRIS/21MORRIS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/21/opinion/21MORRIS/21MORRIS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/21/opinion/21MORRIS/21MORRIS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Composer of ‘Hair,’ Choirmaster of My Life', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'MacDermot, Galt', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Hair (Play)', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-12-21T03:26:48+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Bob Morris', 'person': [{'firstname': 'Bob', 'middlename': None, 'lastname