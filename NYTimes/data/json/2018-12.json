D-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/02/opinion/02DOWD/02DOWD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/02DOWD/02DOWD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Curtains for the Clintons', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Curtains for  The Clintons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Bill', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Toronto (Ontario)', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-12-01T19:30:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Maureen Dowd', 'person': [{'firstname': 'Maureen', 'middlename': None, 'lastname': 'Dowd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/4f8dcc35-75bf-5d22-8deb-025678b84275', 'word_count': 960, 'uri': 'nyt://article/4f8dcc35-75bf-5d22-8deb-025678b84275'}, {'abstract': 'The season’s scents of fir and pine evoke primal experiences, and remind us what we may lose. ', 'web_url': 'https://www.nytimes.com/2018/12/01/opinion/sunday/holidays-trees-odors-memory-hanukkah-christmas.html', 'snippet': 'The season’s scents of fir and pine evoke primal experiences, and remind us what we may lose. ', 'lead_paragraph': 'Walking in New York this season, I stumble into a time warp. The smell of fir from sidewalk Christmas tree vendors plunges me into memories: sparkling red and silver lights on childhood holiday boughs, the judder of a saw in my hand as I built spruce bookshelves, and the songs of wrens and hermit thrushes along a forested trail in Canada. This portal into the past is opened by odor alone, by the fir needles perfuming whole city blocks.', 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/sunday/02haskell/merlin_147537240_58b22f0d-9363-4845-8e8e-876818742db3-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/02/opinion/sunday/02haskell/merlin_147537240_58b22f0d-9363-4845-8e8e-876818742db3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/sunday/02haskell/merlin_147537240_58b22f0d-9363-4845-8e8e-876818742db3-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/sunday/02haskell/merlin_147537240_58b22f0d-9363-4845-8e8e-876818742db3-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/sunday/02haskell/02haskell-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/02/opinion/sunday/02haskell/02haskell-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/sunday/02haskell/02haskell-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Most Wonderful Smelling Time of the Year', 'kicker': None, 'content_kicker': None, 'print_headline': 'Time Traveling With Trees', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Trees and Shrubs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Christmas Trees', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smell (Olfaction)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Winter (Season)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Forests and Forestry', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Memory', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-12-01T19:30:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By David George Haskell', 'person': [{'firstname': 'David', 'middlename': 'George', 'lastname': 'Haskell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0394b6b1-8b80-5592-8abd-4ebdaae9023c', 'word_count': 787, 'uri': 'nyt://article/0394b6b1-8b80-5592-8abd-4ebdaae9023c'}, {'abstract': 'The evidence from the special counsel’s investigation is already damning, but it must contend with a haze of lies, confusion and “alternative facts.” ', 'web_url': 'https://www.nytimes.com/2018/12/01/opinion/sunday/robert-mueller-trump-manafort-corsi-report.html', 'snippet': 'The evidence from the special counsel’s investigation is already damning, but it must contend with a haze of lies, confusion and “alternative facts.” ', 'lead_paragraph': "After a period of quiet, the special counsel Robert Mueller's investigation is seizing headlines yet again. In the past week, we learned that Paul Manafort, Donald Trump’s former campaign chairman, broke the terms of his cooperation agreement by lying to Mr. Mueller’s investigators, all while his lawyer was briefing Mr. Trump’s legal team on what Mr. Manafort told the special counsel. The conservative author Jerome Corsi, facing possible indictment, made public a potential draft plea agreement with Mr. Mueller that contains incendiary allegations of attempted coordination between Mr. Corsi and the Trump campaign adviser Roger Stone with WikiLeaks. ", 'print_section': 'SR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/02JURECIC/merlin_147456165_36f2261d-7ed4-4981-b2d0-3e51e222b8ed-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/02/opinion/02JURECIC/merlin_147456165_36f2261d-7ed4-4981-b2d0-3e51e222b8ed-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/02JURECIC/merlin_147456165_36f2261d-7ed4-4981-b2d0-3e51e222b8ed-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/02JURECIC/merlin_147456165_36f2261d-7ed4-4981-b2d0-3e51e222b8ed-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/opinion/02JURECIC/02JURECIC-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/02/opinion/02JURECIC/02JURECIC-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75