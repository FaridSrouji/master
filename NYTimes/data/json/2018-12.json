py/25mag-eat-image1-superJumbo.jpg', 'height': 1507, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/magazine/25mag-eat-image1-copy/25mag-eat-image1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/25/magazine/25mag-eat-image1-copy/25mag-eat-image1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/magazine/25mag-eat-image1-copy/25mag-eat-image1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What to Cook Right Now', 'kicker': 'What to Cook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}], 'pub_date': '2018-12-03T15:30:00+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/25cc53cc-b246-51b2-9aef-96c95338207f', 'word_count': 598, 'uri': 'nyt://article/25cc53cc-b246-51b2-9aef-96c95338207f'}, {'abstract': 'Recent research is making it clearer than ever that the notion that sex determines the fundamentals of brain structure and behavior is a misconception.', 'web_url': 'https://www.nytimes.com/2018/12/03/opinion/male-female-brains-mosaic.html', 'snippet': 'Recent research is making it clearer than ever that the notion that sex determines the fundamentals of brain structure and behavior is a misconception.', 'lead_paragraph': 'In 17th and 18th century Europe, the rise of egalitarian ideals created the need for a scientific account of women’s inferior status. Thus was born gender biological complementarity — the notion that, as historian of science Londa Schiebinger explains in The Mind Has No Sex, “Women were not to be viewed merely as inferior to men but as fundamentally different from, and thus incomparable to, men.” It has been with us in one way or another, roping in science to explain the gender status quo, ever since.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03joelWeb/03joelWeb-articleLarge.jpg', 'height': 867, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/03/opinion/03joelWeb/03joelWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 867}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03joelWeb/03joelWeb-jumbo.jpg', 'height': 1024, 'width': 709, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03joelWeb/03joelWeb-superJumbo.jpg', 'height': 2048, 'width': 1418, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03joelWeb/03joelWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/03/opinion/03joelWeb/03joelWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03joelWeb/03joelWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can We Finally Stop Talking About ‘Male’ and ‘Female’ Brains?', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Brain', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-12-03T16:00:03+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Daphna Joel and Cordelia Fine', 'person': [{'firstname': 'Daphna', 'middlename': None, 'lastname': 'Joel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Cordelia', 'middlename': None, 'lastname': 'Fine', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/59933268-491c-5525-b036-0a9c00f92df4', 'word_count': 1158, 'uri': 'nyt://article/59933268-491c-5525-b036-0a9c00f92df4'}, {'abstract': 'If I attempt to control a conversation based on the fact of my gender, I may be a bully, looking for a way to humiliate you. But I may be justified.', 'web_url': 'https://www.nytimes.com/2018/12/03/opinion/what-does-it-mean-to-speak-as-a-woman.html', 'snippet': 'If I attempt to control a conversation based on the fact of my gender, I may be a bully, looking for a way to humiliate you. But I may be justified.', 'lead_paragraph': 'Suppose a man and I are having a conversation about recent events, and suppose I introduce one of my statements with “As a woman, …” ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03stoneWeb/merlin_115250426_3f44dbbc-b0b4-4163-8a63-00f4862d7719-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/03/opinion/03stoneWeb/merlin_115250426_3f44dbbc-b0b4-4163-8a63-00f4862d7719-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03stoneWeb/merlin_115250426_3f44dbbc-b0b4-4163-8a63-00f4862d7719-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03stoneWeb/merlin_115250426_3f44dbbc-b0b4-4163-8a63-00f4862d7719-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03stoneWeb/03stoneWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/03/opinion/03stoneWeb/03stoneWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/03/opinion/03stoneWeb/03stoneWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Does It Mean to ‘Speak as a Woman’?', 'kicker': 'THE STONE', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Philosophy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Language and Languages', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-1