 the Bronx Documentary Center.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07galleries-chast/merlin_147535542_2991a9e6-59c8-4dc5-999d-8971023d2c5c-articleLarge.jpg', 'height': 679, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/07/arts/07galleries-chast/merlin_147535542_2991a9e6-59c8-4dc5-999d-8971023d2c5c-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 679}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07galleries-chast/merlin_147535542_2991a9e6-59c8-4dc5-999d-8971023d2c5c-jumbo.jpg', 'height': 1024, 'width': 905, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07galleries-chast/merlin_147535542_2991a9e6-59c8-4dc5-999d-8971023d2c5c-superJumbo.jpg', 'height': 1596, 'width': 1410, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07galleries-chast/07galleries-chast-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/07/arts/07galleries-chast/07galleries-chast-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/07/arts/07galleries-chast/07galleries-chast-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What to See in New York Art Galleries This Week', 'kicker': None, 'content_kicker': None, 'print_headline': 'Galleries', 'name': No