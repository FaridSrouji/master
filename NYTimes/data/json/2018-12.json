mages/2018/12/30/sports/orange-folo-top/orange-folo-top-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/30/sports/orange-folo-top/orange-folo-top-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/30/sports/orange-folo-top/orange-folo-top-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Long Can Oklahoma Be the Bridesmaid of College Football?', 'kicker': None, 'content_kicker': None, 'print_headline': 'How Often Can Sooners Fall Short?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football (College)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'College Football Playoff National Championship', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Alabama', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Oklahoma', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Clemson University', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-12-30T15:57:59+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Randal C. Archibold', 'person': [{'firstname': 'Randal', 'middlename': 'C.', 'lastname': 'Archibold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80eb1dad-8fdd-57a6-9cd1-a74147f1290b', 'word_count': 1016, 'uri': 'nyt://article/80eb1dad-8fdd-57a6-9cd1-a74147f1290b'}, {'abstract': 'To coincide with the 20th anniversary of the series premiere, the critics Matt Zoller Seitz and Alan Sepinwall have published “The Sopranos Sessions,” a collection that includes episode recaps, conversations with creator David Chase and more.', 'web_url': 'https://www.nytimes.com/2018/12/30/books/sopranos-sessions-matt-zoller-seitz-alan-sepinwall-interview.html', 'snippet': 'To coincide with the 20th anniversary of the series premiere, the critics Matt Zoller Seitz and Alan Sepinwall have published “The Sopranos Sessions,” a collection that includes episode recaps, conversations with creator David Chase and more.', 'lead_paragraph': 'The world of TV now “barely resembles the one into which Tony Soprano’s SUV rumbled back in 1999,” the critics Matt Zoller Seitz and Alan Sepinwall write in “The Sopranos Sessions.” “All the aspects of the series that once startled viewers have become accepted: serialization; narrative and moral ambiguity; antiheroes or villains as main characters; beauty for its own sake.” The book, being published to coincide with the 20th anniversary of the show’s premiere, includes highly detailed recaps of each episode; several interviews the two authors conducted with the series creator, David Chase; a debate about the much-discussed final moment of the final episode; and writings by Seitz and Sepinwall that were published in The Star-Ledger, the New Jersey newspaper, when “The Sopranos” originally aired. Below, Seitz, the television critic for New York magazine, and Sepinwall, the chief television critic for Rolling Stone, talk about the show’s ambiguous finale, the nature of Chase’s recollections and more.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/31/books/31seitz1/31seitz1-articleLarge.jpg', 'height': 855, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/31/books/31seitz1/31seitz1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 855}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/31/books/31seitz1/31seitz1-jumbo.jpg', 'height': 1024, 'width': 719, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/31/books/31seitz1/31seitz1-superJumbo.jpg', 'height': 1710, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/31/books/31seitz1/31seitz1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/31/books/31seitz1/31seitz1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/31/books/31seitz1/31seitz1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Deep Dive Back Into ‘The Sopranos’', 'kicker': '5 Things About Your Book', 'content_kicker': None, 'print_headline': 'A Deep Dive Back Into ‘The Sopranos’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'The Sopranos Sessions (Book)', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Sopranos (TV Program)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Seitz, Matt Zoller', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sepinwall, Alan', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-12-30T16:00:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reporte