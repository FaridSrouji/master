lename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9bdec532-2cd9-5fa5-b4a9-3e14e46ee83c', 'word_count': 2581, 'uri': 'nyt://article/9bdec532-2cd9-5fa5-b4a9-3e14e46ee83c'}, {'abstract': 'Jean Curran’s dye-transfer prints from film frames, and a stop-time movie by Catherine Opie, continue the 60-year love affair with Hitchcock’s “Vertigo.” ', 'web_url': 'https://www.nytimes.com/2018/12/13/arts/design/obsessing-over-vertigo.html', 'snippet': 'Jean Curran’s dye-transfer prints from film frames, and a stop-time movie by Catherine Opie, continue the 60-year love affair with Hitchcock’s “Vertigo.” ', 'lead_paragraph': 'Since the lackluster initial reception of Alfred Hitchcock’s “Vertigo” 60 years ago, its reputation has risen — steadily, tectonically — until it now looms high in cinema history. On the last critic’s poll conducted by the film magazine Sight & Sound, it ranked as the No. 1 movie of all time. A peak so lofty casts a long shadow. Indeed, we’ve reached the point where “Vertigo,” like Giorgione’s “Sleeping Venus” or Delacroix’s “Women of Algiers in Their Apartment,” is part of the cultural landscape, inspiring new classics that cast shadows of their own.', 'print_section': 'C', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/14/arts/14vertigo1/merlin_147723447_a5e3ad2d-7f24-4ca1-90d7-def44a95e776-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/14/arts/14vertigo1/merlin_147723447_a5e3ad2d-7f24-4ca1-90d7-def44a95e776-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/14/arts/14vertigo1/merlin_147723447_a5e3ad2d-7f24-4ca1-90d7-def44a95e776-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/14/arts/14vertigo1/merlin_147723447_a5e3ad2d-7f24-4ca1-90d7-def44a95e776-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/14/arts/14vertigo1/14vertigo1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/14/arts/14vertigo1/14vertigo1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/14/arts/14vertigo1/14vertigo1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Vertigo,’ Through Two Artists’ Eyes', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'A Love Affair With ‘Vertigo’ Continues', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Curran, Jean (Artist)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'DANZIGER, JAMES, GALLERY', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Opie, Catherine', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Lehmann Maupin Gallery', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Hitchcock, Alfred', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Eggleston, William (1939- )', 'rank': 9, 'major': 'N'}, {'name': 'creative_works', 'value': 'Vertigo (Movie)', 'rank': 10, 'major': 'N'}], 'pub_date': '2018-12-13T11:00:13+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Arthur Lubow', 'person': [{'firstname': 'Arthur', 'middlename': None, 'lastname': 'Lubow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7fff631a-03e9-53a1-8a20-bed9ea5ba605', 'word_count': 1482, 'uri': 'nyt://article/7fff631a-03e9-53a1-8a20-bed9ea5ba605'}, {'abstract': 'Six former governors call on California’s governor to follow in their footsteps and grant clemency to death row prisoners. ', 'web_url': 'https://www.nytimes.com/2018/12/13/opinion/jerry-brown-california-death-row.html', 'snippet': 'Six former governors call on California’s governor to follow in their footsteps and grant clemency to death row prisoners. ', 'lead_paragraph': 'Among a governor’s many powers, none is more significant than signing a death warrant. It’s a terrible responsibility, hard even to imagine until you’re asked to carry it out, as we were. But we became convinced that it wasn’t something a civilized society should ask of its leaders. That’s why we halted executions in our states, and we call on Gov. Jerry Brown of California to do the same. ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/13/opinion/13CELESTE02/merlin_146841648_caa4f66d-adc7-43a2-9757-08cef56e2f5f-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/13/opinion/13CELESTE02/merlin_146841648_caa4f66d-adc7-43a2-9757-08cef56e2f5f-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None