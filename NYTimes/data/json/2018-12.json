ay', 'content_kicker': None, 'print_headline': 'Fiction’s New Fake Drugs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Burroughs, William S', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Eisenberg, Deborah', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Franzen, Jonathan', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Maazel, Fiona', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Marcus, Ben', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Moshfegh, Ottessa (1981- )', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Wallace, David Foster', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Southern, Terry', 'rank': 10, 'major': 'N'}, {'name': 'creative_works', 'value': 'My Year of Rest and Relaxation (Book)', 'rank': 11, 'major': 'N'}, {'name': 'creative_works', 'value': 'Naked Lunch (Book)', 'rank': 12, 'major': 'N'}, {'name': 'creative_works', 'value': 'Odyssey (Book)', 'rank': 13, 'major': 'N'}, {'name': 'creative_works', 'value': 'Alice in Wonderland (Opera)', 'rank': 14, 'major': 'N'}, {'name': 'creative_works', 'value': 'Hystopia (Book)', 'rank': 15, 'major': 'N'}, {'name': 'creative_works', 'value': 'A Little More Human (Book)', 'rank': 16, 'major': 'N'}, {'name': 'persons', 'value': 'Means, David (1961- )', 'rank': 17, 'major': 'N'}], 'pub_date': '2018-12-24T10:00:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Jonathan Lethem', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Lethem', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe21763d-5326-5b92-b58d-2f5c909ecac6', 'word_count': 1237, 'uri': 'nyt://article/fe21763d-5326-5b92-b58d-2f5c909ecac6'}, {'abstract': 'A small study suggests the body clocks of the reindeer said to pull Mr. Claus’s sleigh swing wildly through the seasons, bringing near-hibernation in winter.', 'web_url': 'https://www.nytimes.com/2018/12/24/science/reindeer-body-clock.html', 'snippet': 'A small study suggests the body clocks of the reindeer said to pull Mr. Claus’s sleigh swing wildly through the seasons, bringing near-hibernation in winter.', 'lead_paragraph': 'Reindeer can’t fly around the world helping distribute gifts to all the good boys and girls in a single night — at least, as far as science can tell. But they are capable of other impressive feats.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/science/25TB-REINDEER-print/25TB-REINDEER1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/25/science/25TB-REINDEER-print/25TB-REINDEER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/science/25TB-REINDEER-print/25TB-REINDEER1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/science/25TB-REINDEER-print/25TB-REINDEER1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/25/science/25TB-REINDEER-print/25TB-REINDEER1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy':