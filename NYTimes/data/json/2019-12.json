r': None, 'print_headline': 'Divided Israel Faces a Third Election as Netanyahu Clings to Office', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Israel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Blue and White (Israeli Political Party)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Likud Party (Israel)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gantz, Benny', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Netanyahu, Benjamin', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lapid, Yair', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Saar, Gideon', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-12-11T10:15:26+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By David M. Halbfinger and Isabel Kershner', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/052a9a9c-9c51-52ae-8a86-65d57a54a2a2', 'word_count': 1558, 'uri': 'nyt://article/052a9a9c-9c51-52ae-8a86-65d57a54a2a2'}, {'abstract': 'The government says it is trying to protect religious minorities from being persecuted in Muslim countries. Indian Muslims say the bill is discriminatory, and protests are spreading.', 'web_url': 'https://www.nytimes.com/2019/12/11/world/asia/india-muslims-citizenship-narendra-modi.html', 'snippet': 'The government says it is trying to protect religious minorities from being persecuted in Muslim countries. Indian Muslims say the bill is discriminatory, and protests are spreading.', 'lead_paragraph': 'NEW DELHI — The upper house of the Indian Parliament passed a contentious citizenship bill on Wednesday, bringing a religiously polarizing measure one step closer to law as new protests erupted across the country.The measure, called the Citizenship Amendment Bill, uses religion as a criterion for determining whether illegal migrants in India can be fast-tracked for citizenship. The bill favors members of all South Asia’s major religions except Islam, and leaders of India’s 200-million-strong Muslim community have called it blatant discrimination. The Rajya Sabha, India’s version of a senate, approved the bill in a 125-to-105 vote. It next goes to the president’s desk, where it is expected to be signed into law in the coming days.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/11/world/11india-citizenship-1/merlin_165782520_8ca55e78-d761-437e-991f-c1ad8d56c4e4-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/11/world/11india-citizenship-1/merlin_165782520_8ca55e78-d761-437e-991f-c1ad8d56c4e4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/11/world/11india-citizenship-1/merlin_165782520_8ca55e78-d761-437e-991f-c1ad8d56c4e4-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/11/world/11india-citizenship-1/merlin_165782520_8ca55e78-d761-437e-991f-c1ad8d56c4e4-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/11/world/11india-citizenship-1/11india-citizen