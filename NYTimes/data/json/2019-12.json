'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tests (Medical)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Vagina', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sex', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': "Women's Rights", 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'TI (1980- )', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Abstinence (Sexual)', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Solages, Michaelle C', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Persaud, Roxanne Jacqueline', 'rank': 11, 'major': 'N'}], 'pub_date': '2019-12-03T10:00:21+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Luis Ferré-Sadurní', 'person': [{'firstname': 'Luis', 'middlename': None, 'lastname': 'Ferré-Sadurní', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2cd27cf1-e678-5206-b0e1-228e0722c6ed', 'word_count': 878, 'uri': 'nyt://article/2cd27cf1-e678-5206-b0e1-228e0722c6ed'}, {'abstract': 'The translator Ken Liu has done more than anyone to bridge the gap between Chinese science fiction and American readers.', 'web_url': 'https://www.nytimes.com/2019/12/03/magazine/ken-liu-three-body-problem-chinese-science-fiction.html', 'snippet': 'The translator Ken Liu has done more than anyone to bridge the gap between Chinese science fiction and American readers.', 'lead_paragraph': 'In the fall of 2012, Ken Liu received an intriguing offer from a Chinese company with a blandly bureaucratic name: China Educational Publications Import and Export Corporation, Ltd. It was seeking an English-language translator for a trippy science-fiction novel titled “The Three-Body Problem.” Liu — an American computer programmer turned corporate lawyer turned science-fiction writer — was a natural choice: fluent in Mandarin, familiar with Chinese sci-fi tropes and culture and a rising star in the genre. Liu had only translated short fiction at the time, though, and capturing the novel in all its complexity seemed daunting.', 'print_section': 'MM', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/08/magazine/08-mag-liu/08-mag-liu-articleLarge.jpg', 'height': 509, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/08/magazine/08-mag-liu/08-mag-liu-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 509}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/08/magazine/08-mag-liu/08-mag-liu-jumbo.jpg', 'height': 868, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/08/magazine/08-mag-liu/08-mag-liu-superJumbo.jpg', 'height': 1736, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/08/magazine/08-mag-liu/08-mag-liu-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/08/magazine/08-mag-liu/08-mag-liu-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/08/magazine/08-mag-liu/08-mag-liu-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', '