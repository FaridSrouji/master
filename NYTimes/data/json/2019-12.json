edit': None, 'type': 'image', 'url': 'images/2019/12/21/science/21OBS-AUKS1-inyt/04TB-AUKS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/21/science/21OBS-AUKS1-inyt/04TB-AUKS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/21/science/21OBS-AUKS1-inyt/04TB-AUKS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why the Great Auk Is Gone for Good', 'kicker': 'Trilobites', 'content_kicker': None, 'print_headline': 'It Was a Human Thing: Why the Great Auk, Once Counted by Millions, Is Gone for Good', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Birds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Endangered and Extinct Species', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Conservation of Resources', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Genetics and Heredity', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'eLife (Journal)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'North America', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Atlantic Ocean', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Thomas, Jessica E', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-science', 'rank': 11, 'major': 'N'}], 'pub_date': '2019-12-04T17:13:59+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Cara Giaimo', 'person': [{'firstname': 'Cara', 'middlename': None, 'lastname': 'Giaimo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9f36d1cf-cd59-569a-9fe7-a472ec611888', 'word_count': 656, 'uri': 'nyt://article/9f36d1cf-cd59-569a-9fe7-a472ec611888'}, {'abstract': 'Rhett Baruch has transformed his compact Los Angeles apartment into a showroom for the colorful, unconventional items that he sells.', 'web_url': 'https://www.nytimes.com/2019/12/04/t-magazine/rhett-baruch.html', 'snippet': 'Rhett Baruch has transformed his compact Los Angeles apartment into a showroom for the colorful, unconventional items that he sells.', 'lead_paragraph': 'A humdrum exterior belies the artfully wacky world behind the doors of Rhett Baruch’s home in Los Angeles. While the building — a stuccoed two-story structure set on the border of Koreatown and Westlake — is fairly unremarkable, Baruch has transformed his 1,200-square-foot second-floor apartment into an ever-evolving series of colorful vignettes; a burl-wood console in the style of the Dutch de Stijl designer Gerrit Rietveld might be paired with a lumpy ceramic étagère by the Los Angeles-based artist Emilie Carroll, or the sensual curves of a Flemming Lassen chair could be offset by an amoeba-like neon sculpture (called “Blooops”) from Alina Hayes. A collector and dealer of contemporary art and design, Baruch uses the space as a de facto showroom, a place to display beguiling curios and whimsical home décor for the benefit of clients, though of course he also takes personal pleasure in living among eccentric and beautiful things.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/10/16/t-magazine/design/16tmag-baruch-slide-Q8JV/16tmag-baruch-slide-Q8JV-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/10/16/t-magazine/design/16tmag-baruch-slid