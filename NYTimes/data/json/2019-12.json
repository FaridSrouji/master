umbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Military’s Illusions About Donald Trump', 'kicker': 'nonfiction', 'content_kicker': None, 'print_headline': 'Military Delusions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mattis, James N', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'McMaster, H R', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Trump and His Generals: The Cost of Chaos (Book)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Bergen, Peter', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-12-10T16:00:04+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Eliot A. Cohen', 'person': [{'firstname': 'Eliot', 'middlename': 'A.', 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1a73c2eb-2a51-5440-99d4-fbd7d2905b38', 'word_count': 1205, 'uri': 'nyt://article/1a73c2eb-2a51-5440-99d4-fbd7d2905b38'}, {'abstract': 'To change course, the country’s leaders must take on the moneyed elite and religious extremism.', 'web_url': 'https://www.nytimes.com/2019/12/10/opinion/pakistan-economy.html', 'snippet': 'To change course, the country’s leaders must take on the moneyed elite and religious extremism.', 'lead_paragraph': 'If an airplane took off a dozen times only to come crashing down each time, the only logical conclusion would be that the aircraft requires a fundamental redesign. Pakistan’s economy, like the airplane, has crashed 13 times in the last 60 years, each time requiring an International Monetary Fund bailout.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/10/opinion/10Mian2/merlin_163401291_d43a8f0d-1b63-4011-bbeb-5a057d7072c5-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/10/opinion/10Mian2/merlin_163401291_d43a8f0d-1b63-4011-bbeb-5a057d7072c5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/10/opinion/10Mian2/merlin_163401291_d43a8f0d-1b63-4011-bbeb-5a057d7072c5-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/10/opinion/10Mian2/merlin_163401291_d43a8f0d-1b63-4011-bbeb-5a057d7072c5-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/10/opinion/10Mian2/10Mian2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/10/opinion/10Mian2/10Mian2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/10/opinion/10Mian2/10Mian2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Fix Pakistan’s Crashing Economy', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Income Tax', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Agriculture and Farming', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Land Use Policies', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Pakistan Tehreek-e-Insaf', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'International Monetary Fund', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': "Pakistan People's Party", 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Khan, Imran', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 10, 'major': 'N'}], 'pub_date': '2019-12-10T16:00:08+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Atif Mian', 'person': [{'firstname': 'Atif', 'middlename': None, 'lastname': 'Mian', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7053b90e-1d18-5f3d-8a49-5353c555f59c', 'word_count': 1196, 'uri': 'nyt://article/7053b90e-1d18-5f3d-8a49-5353c555f59c'}, {'abstract': 'Through the back of Vacheron Constantin’s luxurious new timepiece, you can see what makes it tick.', 'web_url': 'https://www.nytimes.com/2019/12/10/t-magazine/vacheron-constantin-watch.html', 'snippet': 'Through the back of Vacheron Constantin’s luxurious new timepiece, you can see what makes it tick.', 'lead_paragraph': 'History often treats the engineering marvels of the 21st century as exponentially more virtuosic than what came before, but consider the tourbillon. Created in 1795 by the Paris-based watchmaker Abraham-Louis Breguet, a favorite of Louis XVI and Marie Antoinette, the mechanism (French for “whirlwind”) is perhaps the most esoteric and elegant watch complication ever conceived. Born of horology’s obsession with maintaining accuracy to the millisecond, the tourbillon counteracts the effect of the earth’s gravity by constantly rotating the cage that holds the timepiece’s balance wheel, balance spring and escapement while the movement is running. The idea was to eliminate errors in rate — the loss or gain in time that would arise if the watch stayed too long in one position — by crafting an internal apparatus that continually turned on an axis. Such a marvel of intricacy must be witnessed to be fully understood: It is as transfixing as watching a heart beat. In this new incarnation by the Swiss company Vacheron Constantin, which has specialized in rarefied timepieces since its founding in 1755, you can stare at it all you want through the round porthole at the bottom of the blue lacquer dial or through its sapphire crystal back. Because the case is fashioned from stainless steel instead of the platinum or gold used for most tourbillon watches, this exemplar of late 18th-century ingenuity seems decidedly contemporary — and, perhaps, ever so slightly less beyond our grasp. Vacheron Constantin Overseas Tourbillon, $98,500, (877)\u2009701-1755.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/10/t-magazine/10tmag-watch/10tmag-watch-articleLarge.jpg', 'height': 899, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/10/t-magazine/10tmag-watch/10tmag-watch-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 899}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/10/t-magazine/10tmag-watch/10tmag-watch-jumbo.jpg', 'height': 1024, 'width': 684, 'subTy