r': None, 'print_headline': 'On the Road, and Your Nerves', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Straights (Play)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Adamson, T (Playwright)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Detlefsen, Will', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Jack (Brooklyn, NY, Performance Space)', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-12-13T16:15:43+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Laura Collins-Hughes', 'person': [{'firstname': 'Laura', 'middlename': None, 'lastname': 'Collins-Hughes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c217e495-345e-5b49-8a0c-95ee0261c54b', 'word_count': 525, 'uri': 'nyt://article/c217e495-345e-5b49-8a0c-95ee0261c54b'}, {'abstract': '“Anything Can Happen in the Theater: The Musical World of Maury Yeston” is an old-fashioned revue that ably showcases the Tony-winning songwriter.', 'web_url': 'https://www.nytimes.com/2019/12/13/theater/anything-can-happen-in-the-theater-review-maury-yeston.html', 'snippet': '“Anything Can Happen in the Theater: The Musical World of Maury Yeston” is an old-fashioned revue that ably showcases the Tony-winning songwriter.', 'lead_paragraph': 'Tired of hearing your favorite songs shoehorned into a random story (looking at you, “Mamma Mia!”) or used to illustrate a biographical yarn (“The Cher Show,” “Ain’t Too Proud”)? Fret no more: “Anything Can Happen in the Theater” is not a jukebox musical but an old-fashioned revue that just strings numbers together, and to heck with plot and character motivation. For that matter, to heck with characters altogether.', 'print_section': 'C', 'print_page': '5', 'source': 'The Ne