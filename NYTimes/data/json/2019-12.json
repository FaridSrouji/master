ng Down', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Collectors and Collections', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'PICASSO, OLIVIER WIDMAIER', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Picasso, Pablo', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Miami Beach (Fla)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Othoniel, Jean-Michel', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-12-18T10:00:25+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Shivani Vora', 'person': [{'firstname': 'Shivani', 'middlename': None, 'lastname': 'Vora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90f89230-5ed2-5c57-a924-f6ea58c0b578', 'word_count': 718, 'uri': 'nyt://article/90f89230-5ed2-5c57-a924-f6ea58c0b578'}, {'abstract': 'Artificial intelligence is starting to take over repetitive tasks in classrooms, like grading, and is optimizing coursework and revolutionizing the preparation for college entrance exams.', 'web_url': 'https://www.nytimes.com/2019/12/18/education/artificial-intelligence-tutors-teachers.html', 'snippet': 'Artificial intelligence is starting to take over repetitive tasks in classrooms, like grading, and is optimizing coursework and revolutionizing the preparation for college entrance exams.', 'lead_paragraph': 'This article is part of our continuing Fast Forward series, which examines technological, economic, social and cultural shifts that happen as businesses evolve.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/18/multimedia/18sp-ff-edai-1/merlin_165922518_7007ab0e-57e5-4bba-844d-d359adec