/05/arts/04graffiti-museum9/04graffiti-museum9-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/05/arts/04graffiti-museum9/04graffiti-museum9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/05/arts/04graffiti-museum9/04graffiti-museum9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/05/arts/04graffiti-museum9/04graffiti-museum9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Graffiti Museum Where the Writers Are in Charge', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'The Writers Are in Charge Here', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Museum of Graffiti', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Graffiti', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Miami (Fla)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Chalfant, Henry', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Ket, Alan', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-12-04T20:07:47+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6280cf40-0ede-5495-b20f-687fdb4fcff9', 'word_count': 1610, 'uri': 'nyt://article/6280cf40-0ede-5495-b20f-687fdb4fcff9'}, {'abstract': 'Yes, transitioning to a more equitable system might eliminate some jobs. But the status quo is morally untenable.', 'web_url': 'https://www.nytimes.com/2019/12/04/opinion/healthcare-industry-medicare.html', 'snippet': 'Yes, transitioning to a more equitable system might eliminate some jobs. But the status quo is morally untenable.', 'lead_paragraph': 'Won’t you spare a thought for America’s medical debt collectors? And while you’re at it, will you say a prayer for the nation’s health care billing managers? Let’s also consider the kindly, economically productive citizens in swing states whose job it is to jail pregnant women and the parents of cancer patients for failing to pay their radiology bills. Put yourself in the entrepreneurial shoes of the friendly hospital administrator who has found a lucrative new revenue stream: filing thousands of lawsuits to garnish sick people’s wages.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/opinion/04manjoo1/merlin_142991301_185e4aea-dc64-433c-999c-ca4359caf441-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/04/opinion/04manjoo1/merlin_142991301_185e4aea-dc64-433c-999c-ca4359caf441-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/opinion/04manjoo1/merlin_142991301_185e4aea-dc64-433c-999c-ca4359caf441-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/opinion/04manjoo1/merlin_142991301_185e4aea-dc64-433c-999c-ca4359caf441-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/opinion/04manjoo1/04manjoo1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/04/opinion/04manjoo1/04manjoo1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/opinion/04manjoo1/04manjoo1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The American Health Care Industry Is Killing People', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Layoffs and Job Reductions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Opioids and Opiates', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Lobbying and Lobbyists', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-12-04T20:18:15+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Farhad Manjoo', 'person': [{'firstname': 'Farhad', 'middlename': None, 'lastname': 'Manjoo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/eb5e1e