. ', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/03/obituaries/02Hoffman1/02Hoffman1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/03/obituaries/02Hoffman1/02Hoffman1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/03/obituaries/02Hoffman1/02Hoffman1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/03/obituaries/02Hoffman1/02Hoffman1-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/03/obituaries/02Hoffman1/02Hoffman1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/03/obituaries/02Hoffman1/02Hoffman1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/03/obituaries/02Hoffman1/02Hoffman1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Perry Hoffman, 75, Dies; Saw Family Support as Key to Psychiatric Care', 'kicker': None, 'content_kicker': None, 'print_headline': 'Perry Hoffman, Who Studied Mental Health, Dies at 75', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'HOFFMAN, PERRY', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituar