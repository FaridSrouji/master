litics', 'byline': {'original': 'By Maggie Astor', 'person': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'Astor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/60b04ca3-75aa-5718-ae1f-7c864e3293e8', 'word_count': 1216, 'uri': 'nyt://article/60b04ca3-75aa-5718-ae1f-7c864e3293e8'}, {'abstract': 'Here’s what you need to know.', 'web_url': 'https://www.nytimes.com/2019/12/20/briefing/Malta-Club-World-Cup-Airbnb.html', 'snippet': 'Here’s what you need to know.', 'lead_paragraph': '(Want to get this briefing by email? Here’s the sign-up.)', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/19/nyregion/20AMbriefing-eu-promo/19-eu-briefingfPARNUS-FRUMAN-01-PRINT-copy-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/19/nyregion/20AMbriefing-eu-promo/19-eu-briefingfPARNUS-FRUMAN-01-PRINT-copy-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/19/nyregion/20AMbriefing-eu-promo/20AMbriefing-eu-promo--jumbo-v3.jpg', 'height': 188, 'width': 624, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/19/nyregion/20AMbriefing-eu-promo/20AMbriefing-eu-promo--superJumbo-v3.jpg', 'height': 188, 'width': 624, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/19/nyregion/20AMbriefing-eu-promo/parnas-fruman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbn