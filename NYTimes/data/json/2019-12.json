ajor': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Guterres, Antonio', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'ARCTIC REGIONS', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-12-14T19:30:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Durwood J. Zaelke and Paul Bledsoe', 'person': [{'firstname': 'Durwood', 'middlename': 'J.', 'lastname': 'Zaelke', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Paul', 'middlename': None, 'lastname': 'Bledsoe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/07122db6-0e44-530e-b653-171b6837a8a0', 'word_count': 794, 'uri': 'nyt://article/07122db6-0e44-530e-b653-171b6837a8a0'}, {'abstract': 'It will always mean more to get a card than a text or an email, no matter how heartfelt the words.', 'web_url': 'https://www.nytimes.com/2019/12/14/opinion/sunday/greeting-cards-holidays.html', 'snippet': 'It will always mean more to get a card than a text or an email, no matter how heartfelt the words.', 'lead_paragraph': 'I knew she liked sparkly things. So this spring, I found myself in the greeting card aisle of my local supermarket looking for the perfect card to give the bubbly fourth-grade girl I’d spent the last three years reading to as part of a weekly volunteer program. She was moving away and I wanted to give her something to commemorate our time together.', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/11/05/opinion/00cox3/00cox3-articleLarge.jpg', 'height': 878, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge