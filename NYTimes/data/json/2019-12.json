als.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/us/politics/04dc-rudy1/merlin_137735562_7531382a-1be1-4459-80ce-9f2d4debdda8-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/04/us/politics/04dc-rudy1/merlin_137735562_7531382a-1be1-4459-80ce-9f2d4debdda8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/us/politics/04dc-rudy1/merlin_137735562_7531382a-1be1-4459-80ce-9f2d4debdda8-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/us/politics/04dc-rudy1/merlin_137735562_7531382a-1be1-4459-80ce-9f2d4debdda8-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/us/politics/04dc-rudy1/04dc-rudy1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/12/04/us/politics/04dc-rudy1/04dc-rudy1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/04/us/politics/04dc-rudy1/04dc-rudy1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Giuliani, Facing Scrutiny, Travels to Europe to Interview Ukrainians', 'kicker': None, 'content_kicker': None, 'print_headline': 'Giuliani, Unbowed by Scrutiny, Travels to Europe