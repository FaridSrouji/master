ymore', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Great Britain Withdrawal from EU (Brexit)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'British Pound (Currency)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Boris', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Conservative Party (Great Britain)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-12-13T03:11:12+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Amie Tsang and Matt Phillips', 'person': [{'firstname': 'Amie', 'middlename': None, 'lastname': 'Tsang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Matt', 'middlename': None, 'lastname': 'Phillips', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a00885a8-dc92-5f1b-85e6-3788ec5b902f', 'word_count': 817, 'uri': 'nyt://article/a00885a8-dc92-5f1b-85e6-3788ec5b902f'}, {'abstract': 'Voters pick whichever candidate exhausts them less.', 'web_url': 'https://www.nytimes.com/2019/12/12/opinion/UK-election-politics-boris-johnson.html', 'snippet': 'Voters pick whichever candidate exhausts them less.', 'lead_paragraph': 'There are two power blocs driving politics today. First, there’s the proletariat. These are the working-class voters who go to Trump rallies in the U.S. and powered Brexit and Boris Johnson’s campaign in the U.K. They see their best world receding and they want a tough guy to bring it back.', 'print_section': 'A', 