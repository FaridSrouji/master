ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/664b6010-bcb9-5c34-b8ed-8274baad47f2', 'word_count': 990, 'uri': 'nyt://article/664b6010-bcb9-5c34-b8ed-8274baad47f2'}, {'abstract': 'The newest entry in the series is directed by Cary Joji Fukunaga and features Lashana Lynch.', 'web_url': 'https://www.nytimes.com/2019/12/04/movies/james-bond-no-time-to-die-trailer-daniel-craig.html', 'snippet': 'The newest entry in the series is directed by Cary Joji Fukunaga and features Lashana Lynch.', 'lead_paragraph': 'The new James Bond movie may be called “No Time to Die,” but judging by the first trailer for the film, which was co-written by Phoebe Waller-Bridge (“Killing Eve” and “Fleabag”), a more apt title might be “Time’s Up.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/05/arts/04bond-trailer2/04bond-trailer2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/05/arts/04bond-trailer2/04bond-trailer2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/05/arts/04bond-trailer2/04bond-trailer2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/05/arts/04bond-trailer2/04bond-trailer2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/05/arts/04bond-trailer2/04bond-trailer2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'c