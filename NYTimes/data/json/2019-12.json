ywords': [{'name': 'persons', 'value': 'Marrero, Storm', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Circuses', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Big Apple Circus', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-12-13T10:00:18+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Alix Strauss', 'person': [{'firstname': 'Alix', 'middlename': None, 'lastname': 'Strauss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d27e9e6-34ac-5bbd-86d7-920cb0129530', 'word_count': 806, 'uri': 'nyt://article/5d27e9e6-34ac-5bbd-86d7-920cb0129530'}, {'abstract': '“The bottom of my stomach fell out,” one bird owner said of the news. “Not many people will take a Macaw.”', 'web_url': 'https://www.nytimes.com/2019/12/13/nyregion/birdcamp-nyc-boarding-pet-birds.html', 'snippet': '“The bottom of my stomach fell out,” one bird owner said of the news. “Not many people will take a Macaw.”', 'lead_paragraph': 'Around this time of year, Birdcamp is usually a cacophony of chirps, squawks, and screams. Feathers flap and bits of food are flicked out of cages. Birds strut and check one another out. ', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/13/nyregion/13birdcamp04/13birdcamp04-articleLarge.jpg', 'height': 749, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/12/13/nyregion/13birdcamp04/13birdcamp04-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 749}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/12/13/nyregion/13birdcamp04/13birdcamp04-jumbo.jpg', '