': None}, 'type_of_material': 'News', '_id': 'nyt://article/68b16c25-b9a1-592a-b312-75fd2a9b16c0', 'word_count': 394, 'uri': 'nyt://article/68b16c25-b9a1-592a-b312-75fd2a9b16c0'}, {'abstract': 'The police on Tuesday appealed for witnesses in a fatal stabbing that shut down London’s main shopping street on one of the busiest retail days of the year.', 'web_url': 'https://www.nytimes.com/2011/12/28/world/europe/echoes-of-summer-violence-in-london-stabbing.html', 'snippet': 'The police on Tuesday appealed for witnesses in a fatal stabbing that shut down London’s main shopping street on one of the busiest retail days of the year.', 'lead_paragraph': 'LONDON — Eleven people between 16 and 22 years old were in custody on Tuesday after a fatal stabbing 24 hours earlier shut down London’s main shopping street during one of its busiest days of the year, a move that prompted frustrated consumers to surge against police lines and a police officer to fire a stun gun. ', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/29/world/28stabbing-image2/28stabbing-image2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': '11 Detained Over Attack at a Store in London', 'kicker': None, 'content_kicker': None, 'print_headline': '11 Are Detained After Stabbing In London Store', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-27T10:11:16+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By John F. Burns and Harvey Morris', 'person': [{'firstname': 'John', 'middlename': 'F.', 'lastname': 'Burns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Harvey', 'middlename': None, 'lastname': 'Morris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4bc2f19-49e8-56ca-8c3a-fb66993953c2', 'word_count': 612, 'uri': 'nyt://article/d4bc2f19-49e8-56ca-8c3a-fb66993953c2'}, {'abstract': 'Receiving visitors from South Korea, the North expressed its wish to enact agreements on economic exchange that were scuttled by the South Korean leader, Lee Myung-bak.', 'web_url': 'https://www.nytimes.com/2011/12/28/world/asia/north-korea-calls-for-enactment-of-investment-pact.html', 'snippet': 'Receiving visitors from South Korea, the North expressed its wish to enact agreements on economic exchange that were scuttled by the South Korean leader, Lee Myung-bak.', 'lead_paragraph': 'SEOUL, South Korea — North Korea said on Tuesday that it wanted to restore scuttled agreements with South Korea that could channel extensive investments from the developed South into the impoverished North. The request was conveyed in the first official interaction with visitors from the South since the death of the North’s leader, Kim Jong-il.', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/28/world/asia/28korea_1/28korea_1-jumbo.jpg', 'height': 739, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'North Korea Asks South to Restore Deal to Spur Investment', 'kicker': None, 'content_kicker': None, 'print_headline': 'North Korea Asks South to Restore Deal to Spur Investment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kim Jong Il', 'rank': 1, 'major': 'N