tion than the University of North Carolina. ', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/09/sports/y-creighton-2/y-creighton-2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/09/sports/y-creighton-2/y-creighton-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/09/sports/y-creighton-2/y-creighton-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Coach Trades Up by Going to a Midmajor', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Coach Trades Up by Going to a Midmajor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'College Athletics', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'University of North Carolina', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Creighton University', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'NCAA Soccer Championships', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-09T04:21:55+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Matt Dasilva', 'person': [{'firstname': 'Matt', 'middlename': None, 'lastname': 'Dasilva', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f5ef44ef-79aa-5a