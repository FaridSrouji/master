url': 'images/2011/12/19/arts/jump-book/jump-book-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/19/arts/jump-book/jump-book-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/19/arts/jump-book/jump-book-jumbo.jpg', 'height': 799, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/19/arts/jump-book/jump-book-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/19/arts/jump-book/jump-book-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Don’t Scowl, Beethoven, You’re Loved', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Don’t Scowl, Beethoven, You’re Loved', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Beethoven, Ludwig van', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-18T19:43:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8bf5c3cf-1f90-5271-9a0e-71534d1e343b', 'word_count': 1195, 'uri': 'nyt://article/8bf5c3cf-1f90-5271-9a0e-71534d1e343b'}, {'abstract': 'New Yorkers will have a chance to see the Sydney Theater Company’s celebrated production of “Uncle Vanya” with Cate Blanchett and Hugo Weaving next summer.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/18/a-new-york-stop-for-cate-blanchett-hugo-weaving-and-uncle-vanya/', 'snippet': 'New Yorkers will have a chance to see the Sydney Theater Company’s celebrated production of “Uncle Vanya” with Cate Blanchett and Hugo Weaving next summer.', 'lead_paragraph': 'New Yorkers will have a chance to see the Sydney Theater Company’s celebrated production of “Uncle Vanya” with Cate Blanchett and Hugo Weaving next summer. The production, which received rave reviews when it appeared last August at the John F. Kennedy Center for the Performing Arts in Washington, will be presented at City Center from July 19 through July 28 as part of the Lincoln Center Festival, a festival spokeswoman, Eileen McMahon, said. Ms. Blanchett plays Yelena, and Mr. Weaving plays Astrov in the farcical-yet-heartbreaking production, which was staged by the Hungarian director Tamas Ascher. Ms. Blanchett’s husband, Andrew Upton, provided the actors a new English translation of Chekov’s in 1897 play in Russian.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A New York Stop for Cate Blanchett, Hugo Weaving and ‘Uncle Vanya’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lincoln Center Festival', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ascher, Tamas', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Blanchett, Cate', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Chekov, Anton', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Weaving, Hugo', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-18T19:44:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/25ce86ce-5aa1-5382-82fe-dd6eb1e8a16c', 'word_count': 114, 'uri': 'nyt://article/25ce86ce-5aa1-5382-82fe-dd6eb1e8a16c'}, {'abstract': 'On “Face the Nation,” Newt Gingrich proposes  a subpoena for judges who issue “terrible” decisions.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/18/gingrich-continues-his-crusade-against-activist-judges/', 'snippet': 'On “Face the Nation,” Newt Gingrich proposes  a subpoena for judges who issue “terrible” decisions.', 'lead_paragraph': 'Newt Gingrich continued his crusade against activist judges Sunday, saying he would consider sending the Capitol Police or a United States Marshal to subpoena any federal judge who issued an opinion he thought was out of sync with American values. He would then encourage Congress to impeach the judge.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gingrich Continues His Crusade Against Activist Judges', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Schieffer, Bob', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-18T20:27:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Katharine Q. Seelye', 'person': [{'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3a1bf557-aad0-5a99-a40c-d2fe7a39c7c7', 'word_count': 416, 'uri': 'nyt://article/3a1bf557-aad0-5a99-a40c-d2fe7a39c7c7'}, {'abstract': 'A look back at the theatrical work of a playwright, politician and writer.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/18/remembering-the-words-of-vaclav-havel/', 'snippet': 'A look back at the theatrical work of a playwright, politician and writer.', 'lead_paragraph': 'Among the tributes coming in after the death of Vaclav Havel, the playwright who helped found the Czech Republic and was its president for a decade, are several from the theater world. “There is less morality in politics with his death,” Natalia Koliada, a co-founder of the Belarus Free Theater, which had a supporter in Mr. Havel, wrote on her Twitter feed. (The company’s play “Being Harold Pinter” made Ben Brantley’s list of the best shows of 2011.) The Public Theater, which produced the American premieres of several of Mr. Havel’s plays, wrote on Twitter: “We are saddened by the death of Vaclav Havel.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Remembering the Words of Vaclav Havel', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Havel, Vaclav', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Belarus Free Theater', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Theater', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Wilma Theater', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-18T20:38:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Erik Piepenburg', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Piepenburg', 'qualifier