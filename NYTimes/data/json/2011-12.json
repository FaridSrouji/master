s', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/sports/baseball/06vecseySUB/06vecseySUB-articleLarge.jpg', 'height': 410, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/06/sports/baseball/06vecseySUB/06vecseySUB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 410}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/sports/baseball/06vecseySUB/06vecseySUB-jumbo.jpg', 'height': 858, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/sports/baseball/06vecseySUB/06vecseySUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/06/sports/baseball/06vecseySUB/06vecseySUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Madoff Had Everything to Do With Reyes’s Leaving', 'kicker': 'Sports of The Times', 'content_kicker': None, 'print_headline': 'Madoff Had Everything to Do With Reyes’s Leaving', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Madoff, Bernard L', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Free Agents (Sports)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wilpon, Fred', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Reyes, Jose', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-05T15:24:10+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By George Vecsey', 'person': [{'firstname': 'George', 'middlename': None, 'lastname': 'Vecsey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5fb46c57-c5ba-52f4-a154-2b05a62495d7', 'word_count': 912, 'uri': 'nyt://article/5fb46c57-c5ba-52f4-a154-2b05a62495d7'}, {'abstract': 'A look back at statements from President Nicolas Sarkozy of France and Chancellor Angela Merkel of Germany over the last two months.', 'web_url': 'https://economix.blogs.nytimes.com/2011/12/05/sarkozy-and-merkels-delicate-dance/', 'snippet': 'A look back at statements from President Nicolas Sarkozy of France and Chancellor Angela Merkel of Germany over the last two months.', 'lead_paragraph': 'For weeks, attitudes toward Europe’s debt crisis have gone through a recurring cycle: markets flail, spurring leaders to gather and confer; grim-faced, they issue statements of guarded optimism and determination. Rinse. Repeat.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sarkozy and Merkel’s Delicate Dance', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Merkel, Angela', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sarkozy, Nicolas', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-05T15:43:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Daniel McDermon', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': 'McDermon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed625d32-