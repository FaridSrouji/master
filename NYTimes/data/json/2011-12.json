nk': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/46a900b0-5064-5c4d-be2b-aa3847d23e14', 'word_count': 508, 'uri': 'nyt://article/46a900b0-5064-5c4d-be2b-aa3847d23e14'}, {'abstract': 'Newt Gingrich refers to his rivals as  “Republican friends of mine,’’ with no small amount of irony.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/20/in-iowa-gingrich-calls-for-an-end-to-negative-ads/', 'snippet': 'Newt Gingrich refers to his rivals as  “Republican friends of mine,’’ with no small amount of irony.', 'lead_paragraph': 'MOUNT PLEASANT, Iowa — Newt Gingrich again sought to beat back the barrage of attack ads eroding his lead in Iowa by trying to shame his rivals into pulling them from the air. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Iowa, Gingrich Calls for an End to Negative Ads', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-20T18:49:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10805c0e-1080-532d-a9b7-4a5c588302f4', 'word_count': 448, 'uri': 'nyt://article/10805c0e-1080-532d-a9b7-4a5c588302f4'}, {'abstract': 'An author writes that physical bookstores and books are not jeopardized by online stores and e-books. Readers are invited to respond.', 'web_url': 'https://www.nytimes.com/2011/12/21/opinion/invitation-to-a-dialogue-the-future-of-books.html', 'snippet': 'An author writes that physical bookstores and books are not jeopardized by online stores and e-books. Readers are invited to respond.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '38', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/opinion/1221LETTERSgibson/1221LETTERSgibson-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/opinion/1221LETTERSgibson/1221LETTERSgibson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/21/opinion/1221LETTERSgibson/1221LETTERSgibson-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Invitation to a Dialogue: The Future of Books', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Invitation to a Dialogue: The Future of Books', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'E-Books and Readers', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Barnes & Noble Inc', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-20T19:00:36+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/531deb14-a3ca-5de4-8c81-162db078b0f3', 'word_count': 326, 'uri': 'nyt://article/531deb14-a3ca-5de4-8c81-162db078b0f3'}, {'abstract': 'The bug-eating game show had a surprisingly successful premiere last week; this Monday, it dropped 30 percent but still represented a sturdy increase for the network. “Terra Nova” was little help for Fox.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/12/20/ratings-for-fear-factor-fall-but-still-help-nbc/', 'snippet': 'The bug-eating game show had a surprisingly successful premiere last week; this Monday, it dropped 30 percent but still represented a sturdy increase for the network. “Terra Nova” was little help for Fox.', 'lead_paragraph': 'Maybe the holidays aren’t the season for bug eating, after all.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ratings for ‘Fear Factor’ Fall but Still Help NBC', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Contests and Prizes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-20T19:11:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Bill Carter', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Carter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8d75aa65-28f4-50cd-a527-b919201d3143', 'word_count': 225, 'uri': 'nyt://article/8d75aa65-28f4-50cd-a527-b919201d3143'}, {'abstract': 'The Federal Reserve’s plan for capital and liquidity requirements would be introduced in two phases and would not be likely to go beyond international standards.', 'web_url': 'https://www.nytimes.com/2011/12/21/business/fed-proposes-new-capital-rules-for-banks.html', 'snippet': 'The Federal Reserve’s plan for capital and liquidity requirements would be introduced in two phases and would not be likely to go beyond international standards.', 'lead_paragraph': 'WASHINGTON — The Federal Reserve on Tuesday proposed rules that would require the largest American banks to hold more capital — and to keep it more easily accessible — to protect against another financial crisis.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fed Proposes New Capital Rules for Banks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fed Unveils Plan to Limit Chance of a Banking Crisis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-20T19:13:58+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Edward Wyatt', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Wyatt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d5c873f9-07b9-52da-8320-ed940a2501c3', 'word_count': 885, 'uri': 'nyt://article/d5c873f9-07b9-52da-8320-ed940a2501c3'}, {'abstract': 'After the last diamond-encrusted bauble had been snatched up, the last item of Dior couture sold, the last Fendi handbag handed on to a new owner, the sale of Elizabeth Taylor’s vast collections netted $156.8 million.', 'web_url': 'https://runway.blogs.nytimes.com/2011/12/20/elizabeth-taylors-final-legacy/', 'snippet': 'After the last diamond-encrusted bauble had been snatched up, the last item of Dior couture sold, the last Fendi handbag handed on to a new owner, the sale of Elizabeth Taylor’s vast collections netted $156.8 million.', 'lead_paragraph': 'After the last diamond-encrusted bauble had been snatched up, the last item of Dior couture sold, the last Fendi handbag handed on to a new owner, the sale of Elizabeth Taylor’s vast collections netted\xa0$156.8 million. The four days of sales at Christie’s became the most valuable private jewelry sale in history ($137.2 million) and the most valuable private collection of fashion ever sold ($5.5 million). The first online-only Christie’s sale drew 57,000 bids and reaped $9.5 million. The complete collection sold out, a testament to both the star’s magnetism and the quality of the merchandise.\xa0All the proceeds benefit the Elizabeth Taylor Trust, which manages the Taylor estate.\xa0 Taylor was well-known in her later years for her fund-raising and activism for AIDS research. A portion of the profit generated by Christie’s sale of exhibition tickets (58,000 people saw the exhibit in its international\xa0travels), event\xa0 sponsorship and the ongoing sales of “select publications,” will be donated to the Elizabeth Taylor AIDS Foundation. The auction house also raised $170,00 through the sale of a deluxe limited edition boxed set of the catalogs on the first evening of the auction, which will also go to the foundation. \xa0Some highlights from the later sales: those Vuitton trunks, with the violet-colored tags reading “Mine!” sold for $245,500, the top figure for the accessories sale. The Andy Warhol lithograph signed and dedicated by the artist went for $662,000. A (quite hideous) beaded Versace bolero jacket featuring rhinestone images of Taylor in some of her famous roles fetched $128,500. Even rocks Taylor never actually wore went for big sums: a large gray “scholar’s rock” netted $386,500, more than 30 times its estimate of $8,000 to $12,000.\xa0Christie’s will complete the dispersal of the Taylor collections in the new year with sales of her Old Master paintings (Jan. 25 in New York), including a Frans Hals portrait (not of Taylor), and her Impressionist and modern art collection (London, Feb. 7 and 8).\xa0Chris Wilding, Taylor’s son and a trustee of the foundation, said, “My mother always acknowledged that she was merely the temporary custodian of the incredible things she owned. Today, I think she would be happy to know that her collections will continue to enrich the lives of those who have acquired pieces.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Elizabeth Taylor’s Final Legacy', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Auctions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jewels and Jewelry', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Taylor, Elizabeth', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "Christie's", 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-20T19:14:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Charles Isherwood', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': 'Isherwood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d74aefc-f977-5cf5-951a-6787e00e13fc', 'word_count': 373, 'uri': 'nyt://article/5d74aefc-f977-5cf5-951a-6787e00e13fc'}, {'abstract': 'The Iowa caucuses look and feel democratic, but are they really?', 'web_url': 'https://campaignstops.blogs.nytimes.com/2011/12/20/the-romance-of-iowa/', 'snippet': 'The Iowa caucuses look and feel democratic, but are they really?', 'lead_paragraph': 'Why should the Iowa caucuses, two weeks from tonight, be the first political event of 2012?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Romance of Iowa', 'kicker': 'Campaign Stops', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Voting and Voters', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bachmann, Michele M', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Branstad, Terry E', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Carter, Jimmy', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Huckabee, Mike', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'McGovern, George S', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Ron', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 12, 'major': 'N'}, {'name': 'persons', 'value': 'Santorum, Rick', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 15, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 16, 'major': 'N'}], 'pub_date': '2011-12-20T19:19:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Adam Clymer', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Clymer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/633e4ffb-4cf0-50a2-93c4-f410e530fcc7', 'word_count': 1201, 'uri': 'nyt://article/633e4ffb-4cf0-50a2-93c4-f410e530fcc7'}, {'abstract': 'The province of Diyala is often described as a microcosm of Iraq itself — Sunnis and Shiite Arabs live there, there are Kurdish areas, and it is profoundly affected by what happens on its borders.', 'web_url': 'https://atwar.blogs.nytimes.com/2011/12/20/what-iraqis-think-of-the-american-withdrawal-diyala-province/', 'snippet': 'The province of Diyala is often described as a microcosm of Iraq itself — Sunnis and Shiite Arabs live there, there are Kurdish areas, and it is profoundly affected by what happens on its borders.', 'lead_paragraph': 'As American forces pulled out of Iraq, we asked Iraqis around the country three questions:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Iraqis Think of the American Withdrawal: Diyala Province', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Diyala Province (Iraq)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-20T19:27:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Stephen Farrell and Baghdad Bureau', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Farrell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Baghdad', 'middlename': None, 'lastname': 'Bureau', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8b87eab1-fad9-5582-b822-b40b7385e9c9', 'word_count': 531, 'uri': 'nyt://article/8b87eab1-fad9-5582-b822-b40b7385e9c9'}, {'abstract': 'In “The Flowers of War,” the director Zhang Yimou revisits the 1937 Nanjing massacre in a story narrated by a convent student taking refuge in a church.', 'web_url': 'https://www.nytimes.com/2011/12/21/movies/flowers-of-war-zhang-yimou-on-nanjing-massacre-review.html', 'snippet': 'In “The Flowers of War,” the director Zhang Yimou revisits the 1937 Nanjing massacre in a story narrated by a convent student taking refuge in a church.', 'lead_paragraph': 'Eventually, it seems, every senseless waste of life gets its own gauzy tear-jerker. That’s about the only way to justify “The Flowers of War,” in which the veteran Chinese director Zhang Yimou revisits the Nanjing massacre of 1937 by making something resembling a backstage musical, with breaks for the occasional ghastly murder or rape.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/movies/flowers-span/flowers-span-articleLarge.jpg', 'height': 362, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/20/movies/flowers-span/flowers-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 362}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/movies/flowers-span/flowers-span-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/movies/flowers-span/flowers-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/20/movies/flowers-span/flowers-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Shady American in the Nanjing Massacre', 'kicker': "Movie Review | 'The Flowers of War'", 'content_kicker': None, 'print_headline': 'A Shady American In the Nanjing Massacre', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Zhang Yimou', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bale, Christian', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-20T19:28:39+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/46a9af49-92e4-55a8-8ba3-f522949885d1', 'word_count': 1083, 'uri': 'nyt://article/46a9af49-92e4-55a8-8ba3-f522949885d1'}, {'abstract': 'The Giving Spree continues with more gifts to give and get from T’s friends and family.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/12/20/the-giving-spree-bill-powers/', 'snippet': 'The Giving Spree continues with more gifts to give and get from T’s friends and family.', 'lead_paragraph': 'Who: Bill Powers, who is the co-owner of Half Gallery and a judge on the Bravo reality show “Work of Art: The Next Great Artist.”What He’s Giving: “I bought this Rebecca Kolsrud painting for my wife, but it will probably wind up hanging in my daughter’s room. I saw it at Karma on Downing Street in a small exhibition called “Yackety Yack Girls.” It reminds me of early John Currin paintings and it hints at Martin Kippenberger somehow, too.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Giving Spree | Bill Powers', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-20T19:30:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f17eb1f6-0116-58ed-9a4b-d2c13530bd72', 'word_count': 126, 'uri': 'nyt://article/f17eb1f6-0116-58ed-9a4b-d2c13530bd72'}, {'abstract': 'Rick Perry adds to his campaign message.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/20/caucus-click-perrys-expanded-message/', 'snippet': 'Rick Perry adds to his campaign message.', 'lead_paragraph': 'When Gov. Rick Perry of Texas entered the Republican presidential race four months ago, his bumper-sticker message (and the slogan painted on his bus) was “Get America Working Again.” Two weeks before the Iowa caucuses, his campaign bus, parked outside the historic Decker Hotel in Maquoketa, Iowa, on Tuesday, reflected how faith was central to his closing argument. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Caucus Click: Perry’s Expanded Message', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Perry, Rick', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-20T19:35:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jeff Zeleny', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Zeleny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9443e290-ee00-5701-a143-8340df05a967', 'word_count': 59, 'uri': 'nyt://article/9443e290-ee00-5701-a143-8340df05a967'}, {'abstract': 'The denouement of the political career of State Senator Carl Kruger, who pleaded guilty to corruption charges, encompasses tales of romance and perhaps even sacrifice.', 'web_url': 'https://www.nytimes.com/2011/12/21/nyregion/senator-carl-kruger-pleads-guilty-in-corruption-case.html', 'snippet': 'The denouement of the political career of State Senator Carl Kruger, who pleaded guilty to corruption charges, encompasses tales of romance and perhaps even sacrifice.', 'lead_paragraph': 'In the annals of municipal corruption in New York City, the themes of graft, greed and betrayal have been familiar running mates from one century to the next, accompanying the fall of the Tammany boss William Tweed in the 1870s, the resignation of the popular mayor James J. Walker in 1932, and the bribes, appetites and suicide of Donald R. Manes, a former Queens borough president, in 1986. ', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/nyregion/ALT-Kruger-1/ALT-Kruger-1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/21/nyregion/ALT-Kruger-1/ALT-Kruger-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/nyregion/ALT-Kruger-1/ALT-Kruger-1-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/nyregion/ALT-Kruger-1/ALT-Kruger-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/21/nyregion/ALT-Kruger-1/ALT-Kruger-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'After Resigning, Tearful Senator Pleads Guilty to Accepting Bribes', 'kicker': None, 'content_kicker': None, 'print_headline': 'After Resigning, a Tearful Senator Pleads Guilty to Accepting Bribes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rakoff, Jed S', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Bribery and Kickbacks', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Boyland, William F Jr', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Turano, Michael S', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'MediSys Health Network', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Kruger, Carl', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 11, 'major': 'N'}], 'pub_date': '2011-12-20T19:44:55+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By William K. Rashbaum', 'person': [{'firstname': 'William', 'middlename': 'K.', 'lastname': 'Rashbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/703ec51b-9076-53a9-bec6-a34f57ef88d5', 'word_count': 1214, 'uri': 'nyt://article/703ec51b-9076-53a9-bec6-a34f57ef88d5'}, {'abstract': "Mitt Romney said campaigns should be allowed to raise as much money as they want and “just get rid of these ‘super PACs.'”", 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/20/romney-says-super-pacs-have-been-a-disaster/', 'snippet': "Mitt Romney said campaigns should be allowed to raise as much money as they want and “just get rid of these ‘super PACs.'”", 'lead_paragraph': 'Visit msnbc.com for breaking news, world news, and news about the economy', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney Says ‘Super PACs’ Have Been a ‘Disaster’', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Restore Our Future', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-20T19:47:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b9091835-14cd-5db7-9d99-08855aa0f553', 'word_count': 292, 'uri': 'nyt://article/b9091835-14cd-5db7-9d99-08855aa0f553'}, {'abstract': 'Reuters photographer Damir Sagolj visited North Korea in October and had a rare glimpse of the extent of the food crisis in rural areas.', 'web_url': 'https://lens.blogs.nytimes.com/2011/12/20/revisiting-north-koreas-hunger-crisis/', 'snippet': 'Reuters photographer Damir Sagolj visited North Korea in October and had a rare glimpse of the extent of the food crisis in rural areas.', 'lead_paragraph': 'The death of the North Korean leader Kim Jong-il comes not only at a time of political uncertainty, but also against a hunger crisis caused by storms and floods. This year, the Reuters photographer Damir Sagolj was part of a group of journalists invited by the government – itself a rare step — to document the emergency facing the country’s farm region. As Lens republishes his images today from a post in October, we asked him for an update.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Revisiting North Korea’s Hunger Crisis', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-20T19:49:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By David Gonzalez', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gonzalez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80754483-3163-50d8-abed-b3f34941fd0d', 'word_count': 1267, 'uri': 'nyt://article/80754483-3163-50d8-abed-b3f34941fd0d'}, {'abstract': 'Michel Gondry remakes Travis Bickle, DIY-style. Tu parle a moi?', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2011/12/20/you-talking-to-moi-its-the-french-travis-bickle/', 'snippet': 'Michel Gondry remakes Travis Bickle, DIY-style. Tu parle a moi?', 'lead_paragraph': 'Every major filmmaker seems to be delivering his own ode to classic cinema this season and Michel Gondry is no exception. The French director of “Eternal Sunshine of the Spotless Mind” and “The Green Hornet” has paid homage to “Taxi Driver” by remaking it, DIY-style. In other words, sweding it — a phrase and a concept borrowed from his own 2008 film, “Be Kind Rewind.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'You Talking to Moi? It’s the French Travis Bickle', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gondry, Michel', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-12-20T19:54:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ced8eba8-93a4-5fab-8729-5feb2b897c38', 'word_count': 152, 'uri': 'nyt://article/ced8eba8-93a4-5fab-8729-5feb2b897c38'}, {'abstract': 'The Arab Spring seems like a distant memory.', 'web_url': 'https://takingnote.blogs.nytimes.com/2011/12/20/battlefield-earth/', 'snippet': 'The Arab Spring seems like a distant memory.', 'lead_paragraph': 'Have you ever had one of those days when the news is so disturbing it makes you want to sit quietly in a darkened room? Or if you’re a liberal, make a donation to Doctors Without Borders? Or if you’re a Republican, play golf? That’s how I feel today.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Battlefield Earth', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-20T19:55:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30b66b78-0fc4-5d6d-8730-7464d74b066a', 'word_count': 751, 'uri': 'nyt://article/30b66b78-0fc4-5d6d-8730-7464d74b066a'}, {'abstract': 'In response to the scandal involving players trading memorabilia for tattoos, Ohio State’s football program was given a one-year bowl ban and docked nine scholarships.', 'web_url': 'https://www.nytimes.com/2011/12/21/sports/ncaa-hands-ohio-state-one-year-bowl-ban.html', 'snippet': 'In response to the scandal involving players trading memorabilia for tattoos, Ohio State’s football program was given a one-year bowl ban and docked nine scholarships.', 'lead_paragraph': 'COLUMBUS, Ohio — Ohio State’s football team wil