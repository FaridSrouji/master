ay', 'content_kicker': None, 'print_headline': 'Reinvention and Survival, Circa 1915', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ANTARCTIC REGIONS', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'South Pole', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Exploration and Explorers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Shackleton, Ernest', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Disasters and Emergencies', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Executives and Management (Theory)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-24T18:39:15+0000', 'document_type': 'article', 'news_desk': 'NAT', 'section_name': 'Business Day', 'byline': {'original': 'By Nancy F. Koehn', 'person': [{'firstname': 'Nancy', 'middlename': 'F.', 'lastname': 'Koehn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/79d5e66f-86ec-52c5-b3bf-696ddcb5aaba', 'word_count': 1834, 'uri': 'nyt://article/79d5e66f-86ec-52c5-b3bf-696ddcb5aaba'}, {'abstract': 'Long before Newt Gingrich’s counterfactual novels and Dickensian proposals, Dickens himself was brilliantly exploring “what ifs” and class inequities.', 'web_url': 'https://www.nytimes.com/2011/12/25/opinion/sunday/dowd-a-victorian-christmas.html', 'snippet': 'Long before Newt Gingrich’s counterfactual novels and Dickensian proposals, Dickens himself was brilliantly exploring “what ifs” and class inequities.', 'lead_paragraph': 'WASHINGTON', 'print_section': 'SR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/maureen-do