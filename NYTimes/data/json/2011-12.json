ES-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/11/sports/YJPCOACHES/YJPCOACHES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/11/sports/YJPCOACHES/YJPCOACHES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Coaching Gives Abusers Opportunity and Trust', 'kicker': None, 'content_kicker': None, 'print_headline': 'Opportunity and Authority Attract Sexual Abusers to Coaching Roles', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball (College)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football (College)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hockey, Ice', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sandusky, Jerry', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Fine, Bernie', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Pennsylvania State University', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Syracuse University', 'rank': 14, 'major': 'N'}], 'pub_date': '2011-12-10T16:33:59+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn'