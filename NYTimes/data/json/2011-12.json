: 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Yoga', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Choudhury, Bikram', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-02T00:22:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Meredith Hoffman', 'person': [{'firstname': 'Meredith', 'middlename': None, 'lastname': 'Hoffman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c88a9fca-aa09-51fa-9b97-bfabd02f6ed2', 'word_count': 845, 'uri': 'nyt://article/c88a9fca-aa09-51fa-9b97-bfabd02f6ed2'}, {'abstract': 'The chairman of the House subcommittee investigating the Solyndra loan objects to an editorial.', 'web_url': 'https://www.nytimes.com/2011/12/02/opinion/the-solyndra-loan-inquiry.html', 'snippet': 'The chairman of the House subcommittee investigating the Solyndra loan objects to an editorial.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '38', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Solyndra Loan Inquiry', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'The Solyndra Loan Inquiry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Solyndra Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'House Committee on Energy and Commerce', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Stearns, Clifford Bundy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Aid (US)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Solar Energy', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-12-02T00:24:10+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/9fc366e5-bd11-5678-86c2-efe69961ef4f', 'word_count': 203, 'uri': 'nyt://article/9fc366e5-bd11-5678-86c2-efe69961ef4f'}, {'abstract': '“The Big Fix,” directed by Josh Tickell and Rebecca Harrell Tickell, is an enraged exposé of the crimes of Big Oil.', 'web_url': 'https://www.nytimes.com/2011/12/02/movies/the-big-fix-and-big-oil-review.html', 'snippet': '“The Big Fix,” directed by Josh Tickell and Rebecca Harrell Tickell, is an enraged exposé of the crimes of Big Oil.', 'lead_paragraph': '“The Big Fix” is an enraged exposé of the crimes of Big Oil, specifically BP, which has been accused of negligence and of taking shortcuts that helped lead to the explosion of the Deepwater Horizon rig off the Louisiana coast in April 2010. Eleven workers on the platform died and nearly five million barrels of oil spilled into the Gulf of Mexico over the next five months, killing vast numbers of marine animals before much of it washed ashore, where it wrought incalculable damage.', 'print_section': 'C', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/02/arts/02THEBIGFIX_SPAN/02THEBIGFIX_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/02/arts/02THEBIGFIX_SPAN/02THEBIGFIX_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/02/arts/02THEBIGFIX_SPAN/THE-BIG-FIX-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'captio