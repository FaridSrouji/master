ame': 'Roberts', 'lastname': 'Joe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/3d6730ce-f657-5abb-8a23-639439eb28e3', 'word_count': 0, 'uri': 'nyt://video/3d6730ce-f657-5abb-8a23-639439eb28e3'}, {'abstract': 'Walmart’s Prime Time Smile kit includes a pre-treatment that claims to protect against tooth sensitivity.', 'web_url': 'https://www.nytimes.com/2011/12/05/fashion/a-tooth-whitener-promises-gain-without-pain-trial-run.html', 'snippet': 'Walmart’s Prime Time Smile kit includes a pre-treatment that claims to protect against tooth sensitivity.', 'lead_paragraph': 'ANYONE who has erased years of coffee and wine stains from their teeth knows that a pageant-worthy smile can come with a price: tooth sensitivity. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/fashion/05trialrun/05trialrun-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/06/fashion/05trialrun/05trialrun-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/fashion/05trialrun/05trialrun-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/fashion/05trialrun/05trialrun-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/06/fashion/05trialrun/05trialrun-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Promise of Gain Without Pain', 'kicker': 'Trial Run', 'content_kicker': None, 'print_headline': 'A Promise of Gain Without Pain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beauty', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cosmetics and Toiletries', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Teeth and Dentistry', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-05T21:56:39+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By STEPHANIE&ensp;ROSENBLOOM', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b1349598-3123-5031-b307-b6780302fb83', 'word_count': 223, 'uri': 'nyt://article/b1349598-3123-5031-b307-b6780302fb83'}, {'abstract': 'Sinclair, who also shot our May cover story about the conjoined twins Krista and Tatiana Hogan, was given remarkable access by the Cox family during the three days she spent with them. “To me, this is a story about love and how Judy and Wayne Cox are willing to try everything to make Chris better,” Sinclair says.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2011/12/05/caring-for-chris-now-that-he-has-opened-his-eyes/', 'snippet': 'Sinclair, who also shot our May cover story about the conjoined twins Krista and Tatiana Hogan, was given remarkable access by the Cox family during the three days she spent with them. “To me, this is a story about love and how Judy and Wayne Cox ...', 'lead_paragraph': 'The photographer Stephanie Sinclair, who is known for her ability to connect with the subjects of her pictures, was able to bring even more than her usual empathy to her most recent assignment for the magazine, photographing the minimally conscious patient Chris Cox. That’s because Sinclair’s own mother suffered a brain injury in 2001. “When you share the experience of someone you love having a brain injury — of becoming a different person — there’s an instant intimacy,” Sinclair says. “My mom has recovered a lot more than Chris has, but I had to do a lot of the things they’re doing.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Caring for Chris, Now That He Has Opened His Eyes', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-05T21:57:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Stacey Baker', 'person': [{'firstname': 'Stacey', 'middlename': None, 'lastname': 'Baker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7ede78e-0671-5943-8cb2-9f0fb620d1b7', 'word_count': 181, 'uri': 'nyt://article/c7ede78e-0671-5943-8cb2-9f0fb620d1b7'}, {'abstract': 'N.H.L. Commissioner Gary Bettman speaks with New York Times reporter John Branch on the role of fighting in hockey and the recent death of enforcer Derek Boogaard.', 'web_url': 'https://www.nytimes.com/video/sports/100000001200443/gary-bettman.html', 'snippet': 'N.H.L. Commissioner Gary Bettman speaks with New York Times reporter John Branch on the role of fighting in hockey and the recent death of enforcer Derek Boogaard.', 'lead_paragraph': 'N.H.L. Commissioner Gary Bettman speaks with New York Times reporter John Branch on the role of fighting in hockey and the recent death of enforcer Derek Boogaard.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/sports/video-boogaard-bettman/video-boogaard-bettman-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/11/30/sports/video-boogaard-bettman/video-boogaard-bettman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/11/30/sports/video-boogaard-bettman/video-boogaard-bettman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/11/30/sports/video-boogaard-bettman/video-boogaard-bettman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'N.H.L. Commissioner’s Response', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bettman, Gary', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-05T21:58:31+0000', 'document_type': 'multimedia', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'Shayla Harris', 'person': [{'firstname': 'Shayla', 'middlename': None, 'lastname': 'Harris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/620020d5-4fb1-5a0b-ae89-1845f5f0bc04', 'word_count': 0, 'uri': 'nyt://video/620020d5-4fb1-5a0b-ae89-1845f5f0bc04'}, {'abstract': 'New York City Opera announced on Monday that it was seeking the help of a federal mediator to address a deadlock with the unions representing its chorus and orchestra.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/05/city-opera-calls-for-mediator-in-impasse-with-unions/', 'snippet': 'New York City Opera announced on Monday that it was seeking the help of a federal mediator to address a deadlock with the unions representing its chorus and orchestra.', 'lead_paragraph': 'New York City Opera announced on Monday that it was seeking the help of a federal mediator in a deadlock with the unions representing its chorus and orchestra. The company’s management declared an impasse last Thursday when the two sides were unable to come to terms on new contracts. City Opera has reduced its budget by nearly two thirds and has moved out of its Lincoln Center home to save money. It is seeking to pay the chorus members and musicians for each rehearsal and performance, with reduced health benefits, while the unions want to be compensated by the week and are seeking stronger guarantees of employment.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'City Opera Calls for Mediator in Impasse With Unions', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Opera', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-05T22:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/10de7743-04cd-5f5e-92c8-988d062d8a96', 'word_count': 223, 'uri': 'nyt://article/10de7743-04cd-5f5e-92c8-988d062d8a96'}, {'abstract': 'The Brooklyn artist Kenneth E. Parris III is on tour with members of the Merce Cunningham Dance Company, documenting their two-year Legacy Tour.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/05/drawing-dance-the-cunningham-company-in-illinois/', 'snippet': 'The Brooklyn artist Kenneth E. Parris III is on tour with members of the Merce Cunningham Dance Company, documenting their two-year Legacy Tour.', 'lead_paragraph': 'The Brooklyn artist Kenneth E. Parris III is on tour with members of the Merce Cunningham Dance Company, documenting, through a series of drawings and paintings, their two-year legacy tour. After 58 years the company is scheduled to disband on New Year’s Day 2012. This is the 21st in a series of graphite drawings that Mr. Parris plans to create from the road, providing a front-row seat to the final weeks of the company’s journey. This week’s entry is from Champaign and Chicago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Drawing Dance: The Cunningham Company in Illinois', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Cunningham, Merce, Dance Co', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-05T22:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/68ef0e46-a2ba-552c-aafd-105216820f13', 'word_count': 153, 'uri': 'nyt://article/68ef0e46-a2ba-552c-aafd-105216820f13'}, {'abstract': 'Scenes from the stage adaptation of the 1983 film.', 'web_url': 'https://www.nytimes.com/slideshow/2011/12/06/theater/20111206-christmas.html', 'snippet': 'Scenes from the stage adaptation of the 1983 film.', 'lead_paragraph': 'Scenes from the stage adaptation of the 1983 film.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/theater/20111206-christmas-slide-9T8H/20111206-christmas-slide-9T8H-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/06/theater/20111206-christmas-slide-9T8H/20111206-christmas-slide-9T8H-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/06/theater/20111206-christmas-slide-9T8H/20111206-christmas-slide-9T8H-jumbo.jpg', 'height'