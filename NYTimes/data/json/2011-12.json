mes', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/28/world/28russia_inline/28russia_inline-jumbo.jpg', 'height': 1024, 'width': 717, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/28/world/28russia_inline/28russia_inline-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/28/world/28russia_inline/28russia_inline-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Architect of Russia’s Political System Under Putin Is Reassigned', 'kicker': None, 'content_kicker': None, 'print_headline': 'Architect of Russia’s Centralized Political System Under Putin Is Reassigned', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Surkov, Vladislav Y', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-27T14:29:03+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Ellen Barry', 'person': [{'firstname': 'Ellen', 'middlename': None, 'lastname': 'Barry', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1cca261c-6ae3-538b-9387-7ffca8d53569', 'word_count': 832, 'uri': 'nyt://article/1cca261c-6ae3-538b-9387-7ffca8d53569'}, {'abstract': 'Videos have appeared on the band’s Web site showing David Lee Roth performing with Eddie and Alex Van Halen and declaring that tickets for a concert tour will go on sale next month.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/27/van-halen-looks-ready-to-jump-into-reunion-tour/', 'snippet': 'Videos have appeared on the band’s Web site showing David Lee Roth performing with Eddie and Alex Van Halen and declaring that tickets for a concert tour will go on sale next month.', 'lead_paragraph': 'The reunion they said would never happen, already happened once before but didn’t happen in time for a Grammy Awards nomination concert, appears to be happening (again). The classic lineup of Van Halen, including David Lee Roth and the brothers Eddie and Alex Van Halen, and what remains of their colossal 1980s-era hair looked as if they were poised to regroup for a new concert tour after the appearance of videos that were posted on the band’s Web site, www.van-halen.com. The black-and-white segments, set to parts of the Van Halen songs “Jump,” “Panama” and “Hot For Teacher,” show the bandmates rehearsing and goofing around while a ticker on the bottom of the screen reads: “Van Halen on Tour 2012″ and “First tickets on sale Jan. 10.” No other information was immediately available.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Van Halen Looks Ready to Jump Into Reunion Tour', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Roth, David Lee', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Van Halen', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-27T14:42:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/513d56b6-351c-585d-9920-9b8d3ec95db4', 'word_count': 253, 'uri': 'nyt://article/513d56b6-351c-585d-9920-9b8d3ec95db4'}, {'abstract': 'A collection of links from the reporters and editors of the Dining section.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/12/27/what-were-reading-339/', 'snippet': 'A collection of links from the reporters and editors of the Dining section.', 'lead_paragraph': 'National Geographic Traveler: Melina Gerosa Bellows voyages to Mexico to investigate the world (and taste the honey) of a stingless, endangered bee that, in ancient Mayan culture, was viewed as a mystic emissary. — Jeff Gordinier ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What We’re Reading', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-27T14:44:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/be9d8da7-cb37-5924-92ad-540389bbfa58', 'word_count': 370, 'uri': 'nyt://article/be9d8da7-cb37-5924-92ad-540389bbfa58'}, {'abstract': 'A selection of 2011’s best posts on books from The Moment blog.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/12/27/the-best-in-books/', 'snippet': 'A selection of 2011’s best posts on books from The Moment blog.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Best in Books', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-27T14:45:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b0c27678-30e1-5cf3-a357-22ac6f06db55', 'word_count': 29, 'uri': 'nyt://article/b0c27678-30e1-5cf3-a357-22ac6f06db55'}, {'abstract': 'Newt Gingrich’s apparent past support of the Massachusetts health care plan  removes one arrow from his quiver as he takes aim at Mitt Romney in the last week before the Iowa caucuses.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/27/gingrich-once-sided-with-romneys-on-health-care/', 'snippet': 'Newt Gingrich’s apparent past support of the Massachusetts health care plan  removes one arrow from his quiver as he takes aim at Mitt Romney in the last week before the Iowa caucuses.', 'lead_paragraph': 'Before Newt Gingrich was locked in a bitter rivalry with Mitt Romney for the Republican nomination, he offered high praise for the health care law that Mr. Romney signed in 2006 as Massachusetts governor.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gingrich Once Sided With Romney on Health Care', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gingrich, Newt', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-27T14:47:27+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a2086ca2-a523-59ca-9483-16e1964a64dc', 'word_count': 323, 'uri': 'nyt://article/a2086ca2-a523-59ca-9483-16e1964a64dc'}, {'abstract': 'Ms. Frankenthaler, whose staining technique was essential to the development of Color Field painting, was one of the most admired artists of her generation.', 'web_url': 'https://www.nytimes.com/2011/12/28/arts/helen-frankenthaler-abstract-painter-dies-at-83.html', 'snippet': 'Ms. Frankenthaler, whose staining technique was essential to the development of Color Field painting, was one of the most admired artists of her generation.', 'lead_paragraph': 'Helen Frankenthaler, the lyrically abstract painter whose technique of staining pigment into raw canvas helped shape an influential art movement in the mid-20th century and who became one of the most admired artists of her generation, died on Tuesday at her home in Darien, Conn. She was 83.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/obituaries/27frankenthaler_cnd/27frankenthaler_cnd-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/27/obituaries/27frankenthaler_cnd/27frankenthaler_cnd-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/obituaries/27frankenthaler_cnd/27frankenthaler_cnd-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/obituaries/27frankenthaler_cnd/27frankenthaler_cnd-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/27/obituaries/27frankenthaler_cnd/27frankenthaler_cnd-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Helen Frankenthaler, Abstract Painter Who Shaped a Movement, Dies at 83', 'kicker': None, 'content_kicker': None, 'print_headline': 'Helen Frankenthaler, Abstract Painter Who Shaped a Movement, Dies at 83', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Darien (Conn)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Frankenthaler, Helen', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-27T14:54:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Grace Glueck', 'person': [{'firstname': 'Grace', 'middlename': None, 'lastname': 'Glueck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/812eb6c2-1652-526b-9185-e5843de425fd', 'word_count': 1650, 'uri': 'nyt://article/812eb6c2-1652-526b-9185-e5843de425fd'}, {'abstract': 'Roger Goodell, the N.F.L. commissioner, joins William C. Rhoden and others in a barbershop in Harlem for a talk about the safety of the pro game and other issues.', 'web_url': 'https://www.nytimes.com/video/sports/football/100000001231052/in-the-barbers-chair.html', 'snippet': 'Roger Goodell, the N.F.L. commissioner, joins William C. Rhoden and others in a barbershop in Harlem for a talk about the safety of the pro game and other issues.', 'lead_paragraph': 'Roger Goodell, the N.F.L. commissioner, joins William C. Rhoden and others in a barbershop in Harlem for a talk about the safety of the pro game and other issues.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/03/sports/video-barbershopgoodell/video-barbershopgoodell-articleLarge.jpg