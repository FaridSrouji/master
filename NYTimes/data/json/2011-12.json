ame': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/648df2ca-c292-56fa-a288-234f99aefc4d', 'word_count': 232, 'uri': 'nyt://article/648df2ca-c292-56fa-a288-234f99aefc4d'}, {'abstract': 'More debates and fewer deep-pocketed candidates mean fewer campaign ads.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/06/campaign-ads-show-sharp-declines-from-2008/', 'snippet': 'More debates and fewer deep-pocketed candidates mean fewer campaign ads.', 'lead_paragraph': 'At this point in 2007, Iowa residents had been subjected to 26,037 television commercials from presidential candidates and political groups in a barrage of advertising that was unparalleled.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Campaign Ads Show Sharp Declines From 2008', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Debates (Political)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Political Advertising', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2008', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Bachmann, Michele M', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Santorum, Rick', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Kantar Media', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'New Hampshire', 'rank': 14, 'major': 'N'}], 'pub_date': '2011-12-06T18:10:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jeremy W. Peters', 'person': [{'firstname': 'Jeremy', 'middlename': 'W.', 'lastname': 'Peters', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d37eaf7-0c64-5326-a092-38e0fb7217ee', 'word_count': 396, 'uri': 'nyt://article/9d37eaf7-0c64-5326-a092-38e0fb7217ee'}, {'abstract': 'Do Milwaukee’s ads discouraging parents from sleeping with infants — featuring babies cuddled up with butcher knives — target thoughtless bed sharing or vilify every family bed?', 'web_url': 'https://parenting.blogs.nytimes.com/2011/12/06/a-controversial-campaign-against-co-sleeping/', 'snippet': 'Do Milwaukee’s ads discouraging parents from sleeping with infants — featuring babies cuddled up with butcher knives — target thoughtless bed sharing or vilify every family bed?', 'lead_paragraph': 'Last month, Milwaukee introduced two public service announcements intended to stop parents and caregivers from bringing infants into their beds. In the wake of nine infant deaths associated with an “unsafe sleep environment” in 2011 (including one discovered on the day the new campaign was announced), two ads went up citywide on buses and billboards, each showing a young baby (one white, one black) asleep in an adult bed amid much soft bedding, with a butcher knife tucked in alongside. “Your baby sleeping with you can be just as dangerous,” the ads say.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Campaign Against Bed Sharing', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-06T18:13:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9593641b-db5d-5433-9718-1891c9293d1d', 'word_count': 685, 'uri': 'nyt://article/9593641b-db5d-5433-9718-1891c9293d1d'}, {'abstract': 'Pluses and minuses to the N.H.L.’s realignment plan, what it means for rivalries and the playoffs.', 'web_url': 'https://slapshot.blogs.nytimes.com/2011/12/06/plusminus-the-n-h-l-s-realignment-plan/', 'snippet': 'Pluses and minuses to the N.H.L.’s realignment plan, what it means for rivalries and the playoffs.', 'lead_paragraph': 'Gary Bettman is well aware the N.H.L.’s drastic realignment into four conferences is ripe for criticism from league commentators, fans, and even some of the team executives that voted on it.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Plus/Minus: The N.H.L.’s Realignment Plan', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bettman, Gary', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Hockey League', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-06T18:13:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Christopher Botta', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Botta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b445878-ae04-503d-b7be-5418ed7167d5', 'word_count': 623, 'uri': 'nyt://article/0b445878-ae04-503d-b7be-5418ed7167d5'}, {'abstract': 'The company will set up shop at 75 Broad Street.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/06/city-opera-leaving-lincoln-center-will-have-offices-in-lower-manhattan/', 'snippet': 'The company will set up shop at 75 Broad Street.', 'lead_paragraph': ' The New York City Opera, which is moving out of Lincoln Center, said on Tuesday that it had found office space in Lower Manhattan. The company said it would move its administrative operation to 75 Broad Street on Dec. 16, taking residence in temporary quarters there before occupying 14,000 square feet of renovated space in March or April. The company is also renting 4,000 square feet of storage space in the building, partly for its archives.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'City Opera, Leaving Lincoln Center, Will Have Offices in Lower Manhattan', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Academy of Music', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Koch, David H, Theater', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Lincoln Center for the Performing Arts', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Museo del Barrio', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Opera', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-06T18:15:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/