e, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Boogaard, Derek', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-08T01:51:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cb8a68fb-9673-588b-b3ca-f9c26b939f7c', 'word_count': 729, 'uri': 'nyt://article/cb8a68fb-9673-588b-b3ca-f9c26b939f7c'}, {'abstract': 'High-altitude flights of stealth C.I.A. drones from bases in Afghanistan had been among the most secret of many American intelligence-collection efforts against Iran.', 'web_url': 'https://www.nytimes.com/2011/12/08/world/middleeast/drone-crash-in-iran-reveals-secret-us-surveillance-bid.html', 'snippet': 'High-altitude flights of stealth C.I.A. drones from bases in Afghanistan had been among the most secret of many American intelligence-collection efforts against Iran.', 'lead_paragraph': 'WASHINGTON — The stealth C.I.A. drone that crashed deep inside Iranian territory last week was part of a stepped-up surveillance program that has frequently sent the United States’ most hard-to-detect drone into the country to map suspected nuclear sites, according to foreign officials and American experts who have been briefed on the effort.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/08/world/drone/drone-jumbo.jpg', 'height': 393, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credi