ks/review/Crime/Crime-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/18/books/review/Crime/Crime-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Harry Bosch Returns', 'kicker': 'Crime', 'content_kicker': None, 'print_headline': 'Dark Sustenance', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Connelly, Michael', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hill, Susan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cornwell, Patricia', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-16T15:25:54+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marilyn Stasio', 'person': [{'firstname': 'Marilyn', 'middlename': None, 'lastname': 'Stasio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/71989ab1-7b3a-5dbe-89ea-72442716205c', 'word_count': 927, 'uri': 'nyt://article/71989ab1-7b3a-5dbe-89ea-72442716205c'}, {'abstract': 'Julian Barnes’s infolded scrupulousness matches a reduced idea of English fiction, a habit of reading that appeals and wearies.', 'web_url': 'https://www.nytimes.com/2011/12/18/books/review/julian-barnes-and-the-diminishing-of-the-english-novel.html', 'snippet': 'Julian Barnes’s infolded scrupulousness matches a reduced idea of English fiction, a habit of reading that appeals and wearies.', 'lead_paragraph': 'The narrator of Julian Barnes’s acclaimed novel “The Sense of an Ending” is told by Veronica, a girlfriend from his university days, that he just doesn’t get it. Then, after more clues have come his way, she tells him that he still doesn’t get it. There are so many things he doesn’t get that he even considers using the line as his epitaph: “Tony Webster — He Never Got It.”', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/18/books/review/DYER/DYER-articleLarge.jpg', 'height': 365, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/18/books/review/DYER/DYER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 365}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/18/books/review/DYER/DYER-jumbo.jpg', 'height': 626, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/18/books/review/DYER/DYER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/18/books/review/DYER/DYER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Julian Barnes and the Diminishing of the English Novel', 'kicker': 'Reading Life', 'content_kicker': None, 'print_headline': 'Playing The Averages', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Barnes, Julian', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Man Booker Prize', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-16T15:26:25+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Geoff Dyer', 'person': [{'firstname': 'Geoff', 'middlename': None, 'lastname': 'Dyer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '