c.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fed Up With Putin', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Moscow (Russia)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-16T13:24:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Masha Gessen', 'person': [{'firstname': 'Masha', 'middlename': None, 'lastname': 'Gessen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eb2b30ec-82e5-5367-aaa1-292f4e09fc68', 'word_count': 610, 'uri': 'nyt://article/eb2b30ec-82e5-5367-aaa1-292f4e09fc68'}, {'abstract': 'Highlights from the DealBook newsletter.', 'web_url': 'https://dealbook.nytimes.com/2011/12/16/morning-take-out-388/', 'snippet': 'Highlights from the DealBook newsletter.', 'lead_paragraph': 'Corzine Denies Knowing That MF Global Was Tapping Client Money\xa0|\xa0 Jon S. Corzine, the former chief executive of MF Global, on Thursday denied claims that he had known the brokerage firm was improperly tapping customer money to stave off collapse.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Take-Out', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-16T13:27:06+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By 