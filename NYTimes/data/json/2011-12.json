yt://article/48fc9a09-210e-54cc-98ab-1a6d4cdd0e12'}, {'abstract': 'Nets center Brook Lopez underwent surgery on his broken foot Friday and the team expect him back in six to eight weeks.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2011/12/23/lopez-undergoes-surgery-on-broken-foot/', 'snippet': 'Nets center Brook Lopez underwent surgery on his broken foot Friday and the team expect him back in six to eight weeks.', 'lead_paragraph': 'The Nets expect center Brook Lopez to be playing again in about six to eight weeks, after Lopez underwent surgery to repair a broken right foot Friday morning.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lopez Undergoes Surgery on Broken Foot', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lopez, Brook', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New Jersey Nets', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-23T17:58:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Howard Beck', 'person': [{'firstname': 'Howard', 'middlename': None, 'lastname': 'Beck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/42e69f43-a2c4-5b70-b58c-d5d4b2573133', 'word_count': 174, 'uri': 'nyt://article/42e69f43-a2c4-5b70-b58c-d5d4b2573133'}, {'abstract': 'Vice President Joseph R. Biden Jr. enters the fray of the Republican race, and Mitt Romney hits back.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/23/romney-finds-a-new-sparring-partner-in-biden/', 'snippet': 'Vice President Joseph R. Biden Jr. enters the fray of the Republican race, and Mitt Romney hits back.', 'lead_paragraph': 'TILTON, N.H. — Speaking at a diner Friday morning, Mitt Romney said he had woken up to a surprise — and not just the White Christmas snow blanketing parts of northern New Hampshire. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Romney Finds a New Sparring Partner in Biden', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Des Moines Register', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New Hampshire', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-23T18:04:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Ashley Parker', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae579024-20da-5ff5-a173-94d1a694d8ed', 'word_count': 476, 'uri': 'nyt://article/ae579024-20da-5ff5-a173-94d1a694d8ed'}, {'abstract': 'A shopping expedition to a Best Buy in search of an Amazon Kindle illustrates the differences between the two companies.', 'web_url': 'https://bits.blogs.nytimes.com/2011/12/23/amazon-and-best-buy-uneasy-partners/', 'snippet': 'A shopping expedition to a Best Buy in search of an Amazon Kindle illustrates the differences between the two companies.', 'lead_paragraph': ' To venture into a Best Buy during these last days before Christmas is to see land-based retail hastening in its own demise, as if lambs were born with jars of mint jelly tied around their neck.',