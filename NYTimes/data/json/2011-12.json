life.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Finding Reasons to Deploy to Afghanistan', 'kicker': 'At War', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Navy', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-08T18:47:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Andrew Sand', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Sand', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/16c2a025-ab5a-56b4-9957-25a4e4b5bae0', 'word_count': 641, 'uri': 'nyt://article/16c2a025-ab5a-56b4-9957-25a4e4b5bae0'}, {'abstract': 'Donald Trump is holding a debate in Iowa, but there are few takers.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/08/perry-passes-on-trump-debate/', 'snippet': 'Donald Trump is holding a debate in Iowa, but there are few takers.', 'lead_paragraph': '6:51 p.m. | Updated MOUNT PLEASANT, S.C. – Gov. Rick Perry of Texas and Representative Michele Bachmann have joined other candidates, including Mitt Romney, in passing on Donald Trump’s Dec. 27 debate in Iowa. Mr. Perry’s campaign issued this statement on Thursday:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Perry and Bachmann Also Pass on Trump Debate', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2