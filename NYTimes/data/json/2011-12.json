rial': 'News', '_id': 'nyt://article/0474e2a6-65b8-570a-8f65-d894210aa8a6', 'word_count': 198, 'uri': 'nyt://article/0474e2a6-65b8-570a-8f65-d894210aa8a6'}, {'abstract': 'Pressed by the state to take more prisoners but facing tightening budgets, California counties face hard choices.', 'web_url': 'https://www.nytimes.com/2011/12/12/us/in-riverside-california-a-plan-to-charge-inmates.html', 'snippet': 'Pressed by the state to take more prisoners but facing tightening budgets, California counties face hard choices.', 'lead_paragraph': 'RIVERSIDE, Calif. — A one-night stay in this city’s finest hotel costs $190, complete with sumptuous sheets and a gourmet restaurant. Soon, a twin metal bunk at the county jail, with meals served on plastic trays, will run $142.42. ', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/12/us/JAILS/JAILS-articleLarge.jpg', 'height': 354, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/12/us/JAILS/JAILS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 354}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/12/us/JAILS/JAILS-jumbo.jpg', 'height': 736, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/12/us/JAILS/JAILS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/12/us/JAILS/JAILS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In California, a Plan to Charge Inmates for Their Stay', 'kicker': None, 'content_kicker': None, 'print_headline': 'In California, a Plan to Charge Inmates for Their Stay', 'name': None, 'seo': None,