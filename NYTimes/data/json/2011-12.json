major': 'N'}, {'name': 'subject', 'value': 'Christmas', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-24T01:24:14+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': "By Isma'il Kushkush", 'person': [{'firstname': "Isma'il", 'middlename': None, 'lastname': 'Kushkush', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3519e52-f769-5746-b3f3-22852cf21976', 'word_count': 818, 'uri': 'nyt://article/c3519e52-f769-5746-b3f3-22852cf21976'}, {'abstract': 'Golden Temple offers Chinese food as well as a sushi bar, other Japanese fare and dishes from Thailand and Malaysia.', 'web_url': 'https://www.nytimes.com/2011/12/25/nyregion/golden-temple-a-chinese-restaurant-in-syosset-review.html', 'snippet': 'Golden Temple offers Chinese food as well as a sushi bar, other Japanese fare and dishes from Thailand and Malaysia.', 'lead_paragraph': 'A FAMILY sits around a table in a Chinese restaurant on Christmas in the climactic scene from the 1983 movie “A Christmas Story.” It is a scene that is repeated every year on Long Island and elsewhere: for those who do not celebrate the holiday — or who do, but who have had enough of it — there’s not a lot to do on this day but go to the movies or have a meal out. And just try to find a non-Asian restaurant open on Christmas.', 'print_section': 'LI', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/25/nyregion/25DINELI1/25DINELI1-jumbo.jpg', 'height': 690, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/25/nyregion/25DINELI1/25DINELI1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnai