 1}, {'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f0c5de7f-4772-52d4-bb43-7342447b9b13', 'word_count': 495, 'uri': 'nyt://article/f0c5de7f-4772-52d4-bb43-7342447b9b13'}, {'abstract': 'Works by the rock ’n’ roll photographer famous for his iconic images of the ‘70s are showcased in a new exhibition.', 'web_url': 'https://www.nytimes.com/2011/12/15/fashion/mick-rock-70s-photographer-has-new-exhibition.html', 'snippet': 'Works by the rock ’n’ roll photographer famous for his iconic images of the ‘70s are showcased in a new exhibition.', 'lead_paragraph': 'COFFEE. Mick Rock, the rock ’n’ roll photographer as famous for his hedonistic lifestyle as for his iconic images of debauchery and excess, was drinking nothing more than coffee. It was 5 p.m. on a recent Tuesday, and while hotel guests drank cocktails at the lounge of the W New York Downtown, Mr. Rock, a slim and youthful man in his 60s in tinted glasses, got his fix.', 'print_section': 'E', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/15/fashion/15zUPCLOSE/15zUPCLOSE-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/15/fashion/15zUPCLOSE/15zUPCLOSE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/15/fashion/15zUPCLOSE/15zUPCLOSE-jumbo.jpg', 'height': 1024, 'width': 781, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/15/fashion/15zUPCLOSE/15zUPCLOSE-thumbStandard.jpg', 'height': 75, 'width': 75, 'su