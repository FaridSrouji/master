ashion/14FCAL/14FCAL-jumbo.jpg', 'height': 1024, 'width': 735, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/fashion/14FCAL/14FCAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/14/fashion/14FCAL/14FCAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Calendar', 'kicker': None, 'content_kicker': None, 'print_headline': 'Calendar', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Food', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-12-13T23:50:44+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/46250549-906b-582c-8de0-51abd96cdc11', 'word_count': 1060, 'uri': 'nyt://article/46250549-906b-582c-8de0-51abd96cdc11'}, {'abstract': 'Bakery has been placed in terminal’s Grand Central Market.', 'web_url': 'https://www.nytimes.com/2011/12/14/dining/elis-bread-opens-at-grand-central-terminal.html', 'snippet': 'Bakery has been placed in terminal’s Grand Central Market.', 'lead_paragraph': 'The departures and arrivals have come quickly this fall for Grand Central Terminal’s shops and vendors. Now Eli Zabar has opened a bakery, Eli’s Bread, in the Grand Central Market space previously occupied mainly by Corrado Bread and Pastry. Everything sold at Eli’s Bread is made at Mr. Zabar’s bakery on the Upper East Side; construction of a kitchen one floor above the market is expected to be done in a few weeks, and all the breads, breakfast pastries and coffee cakes for Eli’s Bread will be baked there. “That way we can deliver fresh bread to the market several times a day,” Mr. Zabar said. Fancy pastries will still be made uptown. Among the highlights at Eli’s Bread is what Mr. Zabar calls the Grand Central baguette, a handmade bread sold plain or with a liberal scattering of green or black olives in the dough. It’s the same as the Amagansett baguette he sells in the Hamptons in summer. ', 'print_section': 'D', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/dining/14STUFF1_SPAN/14STUFF1_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/14/dining/14STUFF1_SPAN/14STUFF1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/dining/14STUFF1_SPAN/14STUFF1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/dining/14STUFF1_SPAN/14STUFF1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/14/dining/14STUFF1_SPAN/14STUFF1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Eli’s Bread Is at the Station', 'kicker': 'Food Stuff', 'content_kicker': None, 'print_headline': 'Eli’s Bread Is at the Station', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bread', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Grand Central Terminal 