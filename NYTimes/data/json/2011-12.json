value': 'Forests and Forestry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Trees and Shrubs', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'INWOOD HILL PARK (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-16T16:59:10+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Marielle Anzelone', 'person': [{'firstname': 'Marielle', 'middlename': None, 'lastname': 'Anzelone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7c393883-50f2-5716-85b9-4d475502e4e6', 'word_count': 554, 'uri': 'nyt://article/7c393883-50f2-5716-85b9-4d475502e4e6'}, {'abstract': 'The company that installed pod cars at Heathrow Airport’s Terminal 5 will license the technology for a pod-car network in the Indian city of Amritsar.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/12/16/pod-cars-are-poised-to-transform-an-indian-citys-streetscape-and-skyline/', 'snippet': 'The company that installed pod cars at Heathrow Airport’s Terminal 5 will license the technology for a pod-car network in the Indian city of Amritsar.', 'lead_paragraph': 'ULTra Fairwood, an engineering company in India, announced this week that it reached an agreement with the Punjab government to build a personal rapid transit system in Amritsar, an Indian city of 1.5 million about 40 miles from the Pakistani metropolis of Lahore. The system would be based on the pod-car technology of ULTra Global PRT, which recently completed a proof-of-concept at Heathrow Airport in London.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pod Cars Are Poised to Transform an Indian City’s Streetscape and Skyline', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Transit Systems', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Golden Temple (Amritsar, India)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Heathrow Airport (London)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-16T17:00:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Jim Witkin', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Witkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d1df1542-0cf4-5b19-a36d-1fe328a82e5e', 'word_count': 539, 'uri': 'nyt://article/d1df1542-0cf4-5b19-a36d-1fe328a82e5e'}, {'abstract': 'At our annual Hack Day we made the Event Listings API, used by the interactive guide, publicly available to the developer community on the NYTimes Developer Network.', 'web_url': 'https://open.blogs.nytimes.com/2011/12/16/introducing-the-events-api/', 'snippet': 'At our annual Hack Day we made the Event Listings API, used by the interactive guide, publicly available to the developer community on the NYTimes Developer Network.', 'lead_paragraph': 'This past November, The New York Times launched the Arts & Entertainment Guide, an interactive guide to noteworthy cultural events in and around New York City. The application lets you browse through a hand-selected listing of events, customizing the view based on date range, category and location.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Introducing the Events API', 'kicker': 'Open', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-16T17:04:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By BRIAN BALSER', 'person': [{'firstname': 'Brian', 'middlename'