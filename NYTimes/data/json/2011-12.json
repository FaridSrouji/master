tmas-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/21/opinion/video-bhchristmas/video-bhchristmas-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/opinion/video-bhchristmas/video-bhchristmas-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/21/opinion/video-bhchristmas/video-bhchristmas-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Bloggingheads: A Christ-Free Christmas', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christmas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jesus Christ', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-22T02:25:00+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'byline': {'original': 'None None', 'person': [{'firstname': 'None', 'middlename': None, 'lastname': 'None', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/2183fd74-5cd2-5baa-a92f-afa7b102a014', 'word_count': 0, 'uri': 'nyt://video/2183fd74-5cd2-5baa-a92f-afa7b102a014'}, {'abstract': 'Everything I know about the holidays I learned in the sixth grade.', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/12/21/christmas-over-our-dead-bodies/', 'snippet': 'Everything I know about the holidays I learned in the sixth grade.', 'lead_paragraph': 'The sign outside the Cathedral School on the Upper West Side read “School for Children of All Faiths,” but it was also, at least for me and my brother, a school for children of no faith whatsoever. I think our parents, a non-practicing Jew and an agnostic Lutheran, chose it because they liked that we would have to wear uniforms, which would make their mornings less of a trial, and because the idea of entrusting our religious education to professionals might mean that we actually got one.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Christmas, Over Our Dead Bodies', 'kicker': 'Townies', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christmas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dunne, John Gregory', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cathedral School', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-22T02:30:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Emma Straub', 'person': [{'firstname': 'Emma', 'middlename': None, 'lastname': 'Straub', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcfbf329-eb0e-5b59-a1d3-efc1c79f3899', 'word_count': 1451, 'uri': 'nyt://article/bcfbf329-eb0e-5b59-a1d3-efc1c79f3899'}, {'abstract': 'Democrats, who usually have it easy in Hawaii, are in a rough patch — and Republicans may win a Senate seat that has long been out of their reach.', 'web_url': 'https://www.nytimes.com/2011/12/22/us/politics/hawaii-democrats-are-struggling.html', 'snippet': 'Democrats, who usually have it easy in Hawaii, are in a rough patch — and Republicans may win a Senate seat that has long been out of their reach.', 'lead_paragraph': 'HONOLULU — Hawaii should be a happy outpost for the Democratic Party. It has a Democratic governor. Democrats overwhelmingly control the Legislature. It has Barack Obama in the White House and all the prestige that brings, most recently an Asia-Pacific economic summit meeting with the president as its host, packing this city’s streets, restaurants and hotels with international leaders.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/22/us/jp-HAWAII-1/jp-HAWAII-1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/22/us/jp-HAWAII-1/jp-HAWAII-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/22/us/jp-HAWAII-1/jp-HAWAII-1-jumbo.jpg', 'height': 593, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/22/us/jp-HAWAII-1/jp-HAWAII-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/22/us/jp-HAWAII-1/jp-HAWAII-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For Democrats in Hawaii, Unease in an Oasis', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Democrats in Hawaii, Unease in a Once-Dependable Oasis', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Democratic Party', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lingle, Linda', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Hawaii', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'AKAKA, DANIEL K', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 7, 'major': 'N'}, {'name': 'perso