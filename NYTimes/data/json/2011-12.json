bnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Channel’s Swift Rise Attracts Ads and Envy', 'kicker': None, 'content_kicker': None, 'print_headline': 'Channel’s Swift Rise Attracts Ads and Envy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'ARTS & ENTERTAINMENT NETWORK', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Reality Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'History Channel', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cable Television', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-19T02:06:06+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30bd6469-8867-59c2-8b7b-3eca9607c03a', 'word_count': 1114, 'uri': 'nyt://article/30bd6469-8867-59c2-8b7b-3eca9607c03a'}, {'abstract': 'New England perhaps restored some order to the N.F.L. universe with a win over Denver that locked up the A.F.C. East for the Patriots (11-3).', 'web_url': 'https://www.nytimes.com/2011/12/19/sports/football/brady-and-patriots-end-the-broncos-run.html', 'snippet': 'New England perhaps restored some order to the N.F.L. universe with a win over Denver that locked up the A.F.C. East for the Patriots (11-3).', 'lead_paragraph': 'DENVER — At a busy shopping strip Saturday afternoon, there was a man dressed as a robot meant to entertain and lure frantic Christmas shoppers. At one point, as a few men strolled by, the robot yelled, “Now, I’ll Tebow for you!” and he dropped to one knee and lowered his head in an imitation of the now well-known pose of the quarterback who has captivated the N.F.L. this season. The men — a few of them wearing Patriots jerseys — laughed and kept moving. They, after all, have seen pretenders before. ', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/19/sports/ny-broncos/ny-broncos-jumbo.jpg', 'height': 733, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/19/sports/ny-broncos/ny-broncos-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/19/sports/ny-broncos/ny-broncos-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Tebow and Broncos Have No Comeback for Patriots', 'kicker': 'Patriots 41, Broncos 23', 'content_kicker': None, 'print_headline': 'Tebow and Broncos Have No Comeback for Patriots', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Denver Broncos', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brady, Tom', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tebow, Tim', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New England Patriots', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-19T02:12:45+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_