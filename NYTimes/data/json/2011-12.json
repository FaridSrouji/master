ca'}, {'abstract': 'Amid the AIDS epidemic, gay marriage wasn’t even on the radar, say some gay men who lost partners and friends.', 'web_url': 'https://www.nytimes.com/2012/01/01/fashion/aids-casts-a-shadow-over-gay-marriage-victory.html', 'snippet': 'Amid the AIDS epidemic, gay marriage wasn’t even on the radar, say some gay men who lost partners and friends.', 'lead_paragraph': 'ON the evening of June 24, Steve Mendelsohn celebrated in the street with his friends and nearly a thousand other supporters of same-sex marriage outside the Stonewall Inn, the storied gay bar in the West Village. ', 'print_section': 'ST', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/fashion/01MARRIAGE_SPAN/01MARRIAGE_SPAN-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/01/fashion/01MARRIAGE_SPAN/01MARRIAGE_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/fashion/01MARRIAGE_SPAN/01MARRIAGE-jumbo.jpg', 'height': 716, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/fashion/01MARRIAGE_SPAN/01MARRIAGE_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/01/fashion/01MARRIAGE_SPAN/01MARRIAGE_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Gay Marriage Victory Still Shadowed by AIDS', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gay Marriage Victory Still Shadowed by AIDS', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Gay and Les