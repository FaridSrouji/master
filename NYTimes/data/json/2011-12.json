title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73909514-43a6-593f-8db0-d32a00c3c2dd', 'word_count': 93, 'uri': 'nyt://article/73909514-43a6-593f-8db0-d32a00c3c2dd'}, {'abstract': 'Highlights from the DealBook newsletter.', 'web_url': 'https://dealbook.nytimes.com/2011/12/15/morning-take-out-387/', 'snippet': 'Highlights from the DealBook newsletter.', 'lead_paragraph': 'MF Global’s Risk Officer Said to Lack Authority \xa0|\xa0 Congressional investigators are exploring whether regulators and feeble risk controls allowed MF Global to topple.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Take-Out', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-15T13:13:02+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1d228bcc-4490-56b6-90a6-b423f9fb09b6', 'word_count': 2100, 'uri': 'nyt://article/1d228bcc-4490-56b6-90a6-b423f9fb09b6'}, {'abstract': 'The online piracy debate heats up in Congress, Nick Kristof gets embedded in jail and the radio host in Iowa that all the candidates must meet.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/12/15/the-breakfast-meeting-dec-15/', 'snippet': 'The online piracy debate heats up in Congress, Nick Kristof gets embedded in jail and the radio host in Iowa that all the candidates must meet.', 'lead_paragraph': 'On Thursday, a House committee plans to take up the Stop Online Piracy Act, one of a pair of bills in the Congress intended to curb online piracy, particularly of movies, music and television shows. On one side is the entertainment business, which considers the current tools inadequate to fight pirating sites, “a Whac-a-Mole approach,” Edward Wyatt writes. On the other side, technology companies, who argue that the bills are “so broad and heavy-handed that they threaten to close Web sites and broadband service providers and stifle free speech.” Each is marshaling huge resources to lobby Congress and the American public, with the entertainment business framing the issue as about protecting jobs in the United States.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Breakfast Meeting, Dec. 15', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Nast, Conde', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-15T13:14:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Noam Cohen', 'person': [{'firstname': 'Noam', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed170a5b-1505-5e42-bafe-d090163586b2', 'word_count': 745, 'uri': 'nyt://article/ed170a5b-1505-5e42-bafe-d090163586b2'}, {'abstract': 'The Day: Statistics are surely important, but they tell only part of the story about a decade of war. Also, what City Room is reading in other newspapers and blogs.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/12/15/the-war-is-over-the-heartbreak-isnt/', 'snippet': 'The Day: Statistics are surely important, but they tell only part of the story about a decade of war. Also, what City Room is reading in other newspapers and blogs.', 'lead_paragraph': 'Marine Cpl. Robert Marcus Rodriguez of Maspeth, Queens, all of 21 years old, was the first serviceman from New York City to die in the Iraq war. That was a few days after the start of combat in March 2003. He was assuredly not the last to be killed. That sad distinction fell in August 2008 to Army Specialist Jorge Luis Feliz Nieve, 26, of Queens Village.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The War Is Over; the Heartbreak Isn’t', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-15T13:24:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Clyde Haberman', 'person': [{'firstname': 'Clyde', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/851694f5-d6b8-55f7-b50c-db61d4857e5e', 'word_count': 1166, 'uri': 'nyt://article/851694f5-d6b8-55f7-b50c-db61d4857e5e'}, {'abstract': 'Afghanistan withdrew its ambassador from Qatar in protest over reports that the Persian Gulf emirate has been in discussions about hosting a Taliban peace mission.', 'web_url': 'https://www.nytimes.com/2011/12/16/world/asia/new-setback-for-afghan-peace-talks.html', 'snippet': 'Afghanistan withdrew its ambassador from Qatar in protest over reports that the Persian Gulf emirate has been in discussions about hosting a Taliban peace mission.', 'lead_paragraph': 'KABUL, Afghanistan — Afghanistan withdrew its ambassador from Qatar in protest over reports that the Persian Gulf emirate has been in discussions about bringing in Taliban insurgents to jump-start peace talks, officials confirmed Thursday. ', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/16/world/afghanistan/afghanistan-jumbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/16/world/afghanistan/afghanistan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/16/world/afghanistan/afghanistan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Afghan Rebuke of Qatar Sets Back Peace Talks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Afghan Rebuke of Qatar Sets Back Peace Talks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'International Relations', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Zaeef, Abdul Salam', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Qatar', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Karzai, Hamid', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-15T13:29:35+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Rod Nordland and Sharifullah Sahak', 'person': [{'firstname': 'Rod', 'midd