imedia': [], 'headline': {'main': 'Haiti: President Retires Raunchy Singing Act', 'kicker': 'World Briefing | The Americas', 'content_kicker': None, 'print_headline': 'Haiti: President Retires Raunchy Singing Act', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Martelly, Michel', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Haiti', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-23T02:30:37+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Randal C. Archibold', 'person': [{'firstname': 'Randal', 'middlename': 'C.', 'lastname': 'Archibold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/c706fc82-adaa-5208-8db4-a0b7b1cb8944', 'word_count': 84, 'uri': 'nyt://article/c706fc82-adaa-5208-8db4-a0b7b1cb8944'}, {'abstract': 'Among teams with local ties, undersize but feisty Marquette looks to be the horse to ride come tournament time.', 'web_url': 'https://www.nytimes.com/2011/12/23/sports/ncaabasketball/college-hoops-fans-in-chicago-area-must-look-around.html', 'snippet': 'Among teams with local ties, undersize but feisty Marquette looks to be the horse to ride come tournament time.', 'lead_paragraph': 'Journalistic objectivity is put to the test whenever Marquette University plays basketball. I went to school in that gritty, lively patch of Milwaukee just south of the late, great Avalanche Bar, and it was a life-altering experience.', 'print_section': 'A', 'print_page': '25B', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/23/us/23CNCSPORTS/23CNCSPORTS-articleLarge.jpg', 'h