ype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/04/magazine/04eat2/04eat2-jumbo.jpg', 'height': 909, 'width': 930, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Leek-and-Cardamom Fritters', 'kicker': 'Recipe', 'content_kicker': None, 'print_headline': 'Leek-and-Cardamom Fritters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recipes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Leeks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cardamon', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ottolenghi, Yotam', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-01T11:58:11+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/b7b91f71-3b44-5b67-a00c-b3dc37dd7d5f', 'word_count': 318, 'uri': 'nyt://article/b7b91f71-3b44-5b67-a00c-b3dc37dd7d5f'}, {'abstract': 'A medical school poetry contest that elicited a surprising 160 entries has prompted a discussion about the value of medical poetry, which physicians say can help address the emotional demands of doctoring.', 'web_url': 'https://well.blogs.nytimes.com/2011/12/01/the-doctor-as-poet/', 'snippet': 'A medical school poetry contest that elicited a surprising 160 entries has prompted a discussion about the value of medical poetry, which physicians say can help address the emotional demands of doctoring.', 'lead_paragraph': 'There used to be just two sure-fire ways to get a medical student’s attention: offer free food or give the answer to a question on an upcoming exam.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Doctor as Poet', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Doctors', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medical Schools', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-01T12:00:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': 'By Pauline W. Chen, M.D', 'person': [{'firstname': 'Pauline', 'middlename': 'W.', 'lastname': 'Chen', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29fade45-8726-50af-9eaa-50a53621898c', 'word_count': 758, 'uri': 'nyt://article/29fade45-8726-50af-9eaa-50a53621898c'}, {'abstract': 'How to describe the food at the Israel-born chef’s London restaurants? It’s complicated.', 'web_url': 'https://www.nytimes.com/2011/12/04/magazine/yotam-ottolenghis-international-cuisine.html', 'snippet': 'How to describe the food at the Israel-born chef’s London restaurants? It’s complicated.', 'lead_paragraph': 'Yotam Ottolenghi has no trouble embracing complex issues or producing complex, difficult-to-define food. He was born in Jerusalem of European immigrants (his mother is German, his father Italian). His primary business partner, Sami Tamimi — who also grew up in Jerusalem — is Palestinian. Ottolenghi studied philosophy and literature (he has a master’s in comparative literature), and though he attended Le Cordon Bleu for six months, he lacks the bossiness of most chefs. His cooking at his London restaurant, Nopi, and in four gorgeous shops (all called Ottolenghi), is usually thought of and described as broadly Mediterranean, but in fact it’s far more international than that. Not only does he offer out-and-out Asian dishes on the menu; he is also comfortable using soy sauce in what might be thought of as Provençal dishes or hitting tofu with rosemary. What most of the dishes have in common, he says when asked, are “sun” and “intense flavors.”', 'print_section': 'MM', 'print_page': '56', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/04/magazine/04eat_span/mag-04Eat-t-000_CA0-articleLarge.jpg', 'height': 451, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/04/magazine/04eat_span/mag-04Eat-t-000_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 451}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/04/magazine/04eat_span/mag-04Eat-t-000_CA0-jumbo.jpg', 'height': 821, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/04/magazine/04eat_span/mag-04Eat-t-000_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/04/magazine/04eat_span/mag-04Eat-t-000_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Yotam Ottolenghi’s International Cuisine', 'kicker': 'Eat', 'content_kicker': None, 'print_headline': 'International Style', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ottolenghi, Yotam', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetables', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Chefs', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-01T12:00:11+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a297089d-c609-5f50-95d8-797dacda0b5a', 'word_count': 788, 'uri': 'nyt://article/a297089d-c609-5f50-95d8-797dacda0b5a'}, {'abstract': 'In the 1980s, Frank H. Jump thought he didn’t have long to live. Old advertising murals heartened him. They had lasted much longer than they were supposed to. So he recorded them. Now, he has a book.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/12/01/the-handwriting-on-the-wall-says-gigi-young-originals/', 'snippet': 'In the 1980s, Frank H. Jump thought he didn’t have long to live. Old advertising murals heartened him. They had lasted much longer than they were supposed to. So he recorded them. Now, he has a book.', 'lead_paragraph': 'Advertising murals painted by hand on blank brick side walls in the 1800s and 1900s were supposed to have disappeared by now. Color slides were supposed to have disappeared by now. Books were supposed to have disappeared by now.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Handwriting on the Wall Says, ‘GiGi Young Originals’', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Acquired Immune Deficiency Syndrome', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murals', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jump, Frank H', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-01T12:00:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By David W. Dunlap', 'person': [{'firstname': 'David', 'middlename': 'W.', 'lastname': 'Dunlap', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b20c13fe-2a54-56c4-9313-0be7343703fe', 'word_count': 415, 'uri': 'nyt://article/b20c13fe-2a54-56c4-9313-0be7343703fe'}, {'abstract': 'No one has all of the answers. But these are good places to look.', 'web_url': 'https://boss.blogs.nytimes.com/2011/12/01/7-blogs-and-newsletters-that-can-help-you-sell-a-business/', 'snippet': 'No one has all of the answers. But these are good places to look.', 'lead_paragraph': 'In a recent Transaction post, I suggested four questions to ask a business broker. Here is a fifth. Before you hire a business broker, ask something like this: “I’ll bet you’ve seen it all, haven’t you?”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '7 Blogs and Newsletters That Can Help You Sell a Business', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-01T12:00:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Barbara Taylor', 'person': [{'firstname': 'Barbara', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d7f33619-f139-5c66-9366-b7aa9a3aa14b', 'word_count': 677, 'uri': 'nyt://article/d7f33619-f139-5c66-9366-b7aa9a3aa14b'}, {'abstract': 'Each company will help the other gain experience in unfamiliar areas of environmental technology, improving market share, executives said.', 'web_url': 'https://www.nytimes.com/2011/12/02/business/global/toyota-and-bmw-in-technology-alliance.html', 'snippet': 'Each company will help the other gain experience in unfamiliar areas of environmental technology, improving market share, executives said.', 'lead_paragraph': 'TOKYO — BMW said Thursday that it would supply Toyota Motor Corporation with diesel engines and jointly develop car batteries as part of a comprehensive technology alliance. ', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Alliance for BMW and Toyota', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Alliance For BMW And Toyota', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diesel Power', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Bayerische Motorenwerke AG', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Toyota Motor Corporation', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Batteries', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Electric and Hybrid Vehicles', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-01T12:11:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Hiroko Tabuchi', 'person': [{'firstname': 'Hiroko', 'middlename': None, 'lastname': 'Tabuchi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44abb809-e005-59c5-ba65-f58e7c4accf2', 'word_count': 297, 'uri': 'nyt://article/44abb809-e005-59c5-ba65-f58e7c4accf2'}, {'abstract': 'Grammy nominees are announced, Fox News and debates replace retail campaigning and Time Inc. appoints a digital advertising executive as its chief.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/12/01/breakfast-meeting-dec-1/', 'snippet': 'Grammy nominees are announced, Fox News and debates replace retail campaigning and Time Inc. appoints a digital advertising executive as its chief.', 'lead_paragraph': 'The rapper Kanye West received the most nominations for the 54th Annual Grammy Awards during a ceremony broadcast on Wednesday night on CBS, but it was the pop stars Adele and Bruno Mars who dominated the Song of the Year, Record of the Year and Album of the Year nominations, The ArtsBeat blog reported. Adele, the British soul singer, received six nominations for her album “21,” which included the hit “Rolling in the Deep.” (Her singing voice has been temporarily silenced by vocal cord surgery, and it is not clear, The Los Angeles Times reported, whether Adele will have recovered sufficiently to perform when the awards are handed out on Feb. 12.) Mr. Mars also received six nominations, three for “Grenade,” his song about unrequited love, and three for the album “Doowops and Hooligans.” Mr. West was nominated seven times based on two albums — his complex solo set “My Beautiful Dark Twisted Fantasy” and his collaboration with Jay-Z, “Watch the Throne.” Both were left off the Album of the Year list, but were nominated for Rap Album of the Year. (The snub of MBDTF, as Mr. West’s album is known, was certainly the hot topic on Twitter.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Breakfast Meeting, Dec. 1', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Grammy Awards', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Adele (Singer)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Mars, Bruno', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'West, Kanye', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Time Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-01T12:27:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Noam Cohen', 'person': [{'firstname': 'Noam', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dab55160-90d3-5e77-abc0-e429c4174c10', 'word_count': 865, 'uri': 'nyt://article/dab55160-90d3-5e77-abc0-e429c4174c10'}, {'abstract': 'A sick dolphin recovered by researchers may yield clues to the cause of the deaths of nearly 600 bottlenose dolphins along the Gulf Coast.', 'web_url': 'https://green.blogs.nytimes.com/2011/12/01/among-hundreds-of-dead-an-intriguing-survivor/', 'snippet': 'A sick dolphin recovered by researchers may yield clues to the cause of the deaths of nearly 600 bottlenose dolphins along the Gulf Coast.', 'lead_paragraph': 'Four more dolphins washed up on the shores of the Gulf of Mexico this week. For coastal residents from Louisiana to Florida, the beached animals are a familair sight: hundreds of decomposing dolphin carcasses have turned up over the last two years. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Among Hundreds of Dead Dolphins, an Intriguing Survivor', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dolphins and Porpoises', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gulf of Mexico Oil Spill (2010)', 'rank': 2, 'major'