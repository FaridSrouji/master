'nyt://video/3082c855-75d8-55d5-ba0b-b2d163410aab'}, {'abstract': 'President Obama said he thought most parents would agree that emergency contraceptives should not be sold over the counter to girls 16 and younger.', 'web_url': 'https://www.nytimes.com/2011/12/09/us/politics/obama-expresses-support-for-plan-b-decision.html', 'snippet': 'President Obama said he thought most parents would agree that emergency contraceptives should not be sold over the counter to girls 16 and younger.', 'lead_paragraph': 'WASHINGTON — President Obama, noting that he was the father of two daughters, threw his wholehearted support on Thursday behind a decision by his health and human services secretary, Kathleen Sebelius, not to allow emergency contraceptives to be sold over the counter to young teenagers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Obama Backs Limit on Sale to Teenagers of Morning-After Pill', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obama Expresses Support for Plan B Decision', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Plan B (Contraceptive)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sebelius, Kathleen', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Birth Control and Family Planning', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-08T18:35:45+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Mark Landler', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Landler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/761cfa1b-7f67-5604-bd58-232c59e3fe02', 'word_count': 631, 'uri': '