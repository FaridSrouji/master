': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/business/SBNSHELF/SBNSHELF-jumbo.jpg', 'height': 1024, 'width': 688, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/business/SBNSHELF/SBNSHELF-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/01/business/SBNSHELF/SBNSHELF-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Fiat’s Rough Road, and Its Renewal', 'kicker': 'Off the Shelf', 'content_kicker': None, 'print_headline': 'Fiat’s Rough Road, And Its Renewal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Fiat SpA', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Marchionne, Sergio', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chrysler Group LLC', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-31T21:04:22+0000', 'document_type': 'article', 'news_desk': 'NAT', 'section_name': 'Business Day', 'byline': {'original': 'By Bryan Burrough', 'person': [{'firstname': 'Bryan', 'middlename': None, 'lastname': 'Burrough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2b36c95a-10a6-57c0-b833-33b0974356e1', 'word_count': 941, 'uri': 'nyt://article/2b36c95a-10a6-57c0-b833-33b0974356e1'}, {'abstract': 'Members of the Hmong American Writers’ Circle in Fresno, Calif., have written poems and short stories reflecting their culture and lives.', 'web_url': 'https://www.nytimes.com/interactive/2011/12/22/us/Hmong_writings_docs.html', 'snippet': 'Members of the Hmong American Writers’ Circle in Fresno, Calif., have written poems and short stories reflecting their culture and lives.', 'lead_paragraph': 'Members of the Hmong American Writers’ Circle in Fresno, Calif., have written poems and short stories reflecting their culture and lives.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pieces From the Hmong American Writers’ Circle', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hmong Tribe', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-31T21:08:00+0000', 'document_type': 'multimedia', 'news_desk': 'U.S.', 'section_name': 'U.S.', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/6f41bcb6-d0b2-58e9-84ce-90bbdd8210ae', 'word_count': 0, 'uri': 'nyt://interactive/6f41bcb6-d0b2-58e9-84ce-90bbdd8210ae'}, {'abstract': 'Technology’s continuing onslaught, and employees’ responses to it, will be central issues for the American workplace of 2012.', 'web_url': 'https://www.nytimes.com/2012/01/01/jobs/for-multitaskers-2012-may-be-a-year-of-revenge.html', 'snippet': 'Technology’s continuing onslaught, and employees’ responses to it, will be central issues for the American workplace of 2012.', 'lead_paragraph': 'IT’S a far different work world today than it was even 10 years ago. Technology and the economy have converged to create a set of priorities and preoccupations that are unique to our times. Here are just a few workplace and employment issues that are likely to stir debate, frustration and a search for solutions this year. ', 'print_section': 'BU', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/business/SBN010