me': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/15ae6e47-38c9-5a5c-a868-569aa1d89b14', 'word_count': 291, 'uri': 'nyt://article/15ae6e47-38c9-5a5c-a868-569aa1d89b14'}, {'abstract': 'Rick Perry turns his fire on President Obama during a campaign appearance outside Des Moines.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/12/28/perry-hits-obama-on-lack-of-military-parade/', 'snippet': 'Rick Perry turns his fire on President Obama during a campaign appearance outside Des Moines.', 'lead_paragraph': 'URBANDALE, Iowa — Gov. Rick Perry of Texas has plenty of criticism for President Obama on the campaign trail: he typically hits Mr. Obama for the decision to delay a major pipeline project, for the ballooning federal debt and for much, much more.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Perry Hits Obama on Lack of Military Parade', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parades', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Arlington National Cemetery', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'National Guard', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Des Moines (IA)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Iowa', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 12, 'major': 'N'}], 'pub_date': '2011-12-28T16:36:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c05e5861-86aa-5de1-90d5-615c6afc31cb', 'word_count': 250, 'uri': 'nyt://article/c05e5861-86aa-5de1-90d5-615c6afc31cb'}, {'abstract': 'A literacy expert suggests that when we read with our children from e-readers, we may be be impeding their ability to learn.', 'web_url': 'https://parenting.blogs.nytimes.com/2011/12/28/why-books-are-better-than-e-books-for-children/', 'snippet': 'A literacy expert suggests that when we read with our children from e-readers, we may be be impeding their ability to learn.', 'lead_paragraph': 'Do you read to your children from your iPad or other device, or encourage them to use an e-reader to read to you? Many of us do, at least on occasion — even I, who wrote here some weeks ago that I rarely read on my own iPad anymore because I want my children to see me reading books, recommended an app for creating fun picture books for travel last week. If you have a tablet or e-reader, why not add it to your child’s reading repertory as well?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Why Books Are Better Than e-Books for Children', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Reading and Writing Skills', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Guernsey, Lisa', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-28T16:43:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': "By Kj Dell'Antonia", 'person': [{'firstname': 'Kj', 'middlename': None, 'lastname': "Dell'Antonia", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/77a42076-f4db-51c1-8694-a4ff33f645de', 'word_count': 519, 'uri': 'nyt://article/77a42076-f4db-51c1-8694-a4ff33f645de'}, {'abstract': 'In the Maine woods, the author has enough breathing room to contemplate Christmas trees past and present, sheep’s wool, the sign of peace and a new beginning in graduate school.', 'web_url': 'https://green.blogs.nytimes.com/2011/12/28/after-the-holiday-rush-time-for-reveries/', 'snippet': 'In the Maine woods, the author has enough breathing room to contemplate Christmas trees past and present, sheep’s wool, the sign of peace and a new beginning in graduate school.', 'lead_paragraph': 'Today, the lake is smoothly white at nearly noon, glowing in the pale winter sunshine, with grey-blue shadows of clouds stretched across its further reaches. Minute diamonds glitter from within the white snow on our sloping front field, crossed with long ski tracks and the wallows marking falls and wrestling sessions (with one’s inner ski-demon). Earlier this morning the wind on the lake blew up great billows of loose snow, but the air is still now. I thought I heard a snowmobile, which was a surprise since there really isn’t enough snow yet to ride out on one.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After the Holiday Rush, Time for Reveries', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christmas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Christmas Trees', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Friendship', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Gifts', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Knitting and Knit Goods', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sheep', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Snow and Snowstorms', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Maine', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-12-28T16:51:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Susannah Hopkins Leisher', 'person': [{'firstname': 'Susannah', 'middlename': 'Hopkins', 'lastname': 'Leisher', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ea2decdc-5b8f-5e13-9255-acd1833708ac', 'word_count': 1326, 'uri': 'nyt://article/ea2decdc-5b8f-5e13-9255-acd1833708ac'}, {'abstract': 'Roman Catholic bishops see a fight over adoption rules in Illinois as part of an escalating campaign by the government to trample on their religious freedom.', 'web_url': 'https://www.nytimes.com/2011/12/29/us/for-bishops-a-battle-over-whose-rights-prevail.html', 'snippet': 'Roman Catholic bishops see a fight over adoption rules in Illinois as part of an escalating campaign by the government to trample on their religious freedom.', 'lead_paragraph': 'Roman Catholic bishops in Illinois have shuttered most of the Catholic Charities affiliates in the state rather than comply with a new requirement that says they must consider same-sex couples as potential foster-care and adoptive parents if they want to receive state money. The charities have served for more than 40 years as a major link in the state’s social service network for poor and neglected children. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/29/us/FREEDOM-1/FREEDOM-1-jumbo.jpg', 'height': 1024, 'width': 801, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/29/us/FREEDOM-1/FREEDOM-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/29/us/FREEDOM-1/FREEDOM-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Bishops Say Rules on Gay Parents Limit Freedom of Religion', 'kicker': None, 'content_kicker': None, 'print_headline': 'Illinois Bishops Drop Program Over Bias Rule', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Illinois', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Religion', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Catholic Charities', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Foster Care', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'ADOPTIONS', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 9, 'major': 'N'}], 'pub_date': '2011-12-28T16:56:14+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Laurie Goodstein', 'person': [{'firstname': 'Laurie', 'middlename': None, 'lastname': 'Goodstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', 