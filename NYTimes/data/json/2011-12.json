ord_count': 496, 'uri': 'nyt://article/84de1a77-d051-50e7-a530-7068b32234a3'}, {'abstract': 'Prime Minister David Cameron said that he had acted to protect Britain’s interests and that he had not consigned the country to Europe’s sidelines.', 'web_url': 'https://www.nytimes.com/2011/12/13/world/europe/david-cameron-to-address-british-parliament-over-europe-treaty.html', 'snippet': 'Prime Minister David Cameron said that he had acted to protect Britain’s interests and that he had not consigned the country to Europe’s sidelines.', 'lead_paragraph': 'LONDON — Prime Minister David Cameron on Monday vigorously defended his decision to veto the proposed European Union treaty changes at last week’s summit meeting, telling Parliament that he had acted to protect Britain’s interests and that, contrary to criticism, he had not consigned the country to the sidelines of Europe. ', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/13/world/europe/13britain_1/13britain_1-jumbo.jpg', 'height': 733, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/13/world/europe/13britain_1/13britain_1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/13/world/europe/13britain_1/13britain_1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Cameron Says His Veto on Europe Treaty Protects Britain', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cameron Says His Veto on Europe Treaty Protects Britain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clegg, Nick', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cameron, David', 'rank': 2, 'major': 