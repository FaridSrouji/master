': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/us/politics/video-caucus-111214-romney/video-caucus-111214-romney-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/14/us/politics/video-caucus-111214-romney/video-caucus-111214-romney-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/us/politics/video-caucus-111214-romney/video-caucus-111214-romney-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/14/us/politics/video-caucus-111214-romney/video-caucus-111214-romney-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Caucus | Interview With Mitt Romney', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Romney, Mitt', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-12-14T22:31:35+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'Ben Werschkul', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Werschkul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/a5feb53c-e9e2-5a91-b300-c2405c657523', 'word_count': 0, 'uri': 'nyt://video/a5feb53c-e9e2-5a91-b300-c2405c657523'}, {'abstract': 'Feel the hyperinflation.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/12/14/smoothed-inflation/', 'snippet': 'Feel the hyperinflation.', 'lead_paragraph': 'One thing that becomes obvious when you look at inflation data is that the numbers bounce around a lot, not just from month to month but from year to year. One way to try to get past the noise is to use one or another definition of core inflation, which I think is necessary if you want to catch underlying inflation trends early. But to get a historical picture, it’s good enough just to use longish averages.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Smoothed Inflation', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-14T22:32:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c6a84d8d-4778-5ccb-8ccc-a88a6e0cd8b6', 'word_count': 140, 'uri': 'nyt://article/c6a84d8d-4778-5ccb-8ccc-a88a6e0cd8b6'}, {'abstract': 'Anne Hathaway, Ellen Barkin, Alan Cumming and other loyal subjects pay tribute to the Queen of Hollywood.', 'web_url': 'https://www.nytimes.com/slideshow/2011/12/14/fashion/20111215_scenecity.html', 'snippet': 'Anne Hathaway, Ellen Barkin, Alan Cumming and other loyal subjects pay tribute to the Queen of Hollywood.', 'lead_paragraph': 'Anne Hathaway, Ellen Barkin, Alan Cumming and other loyal subjects pay tribute to the Queen of Hollywood.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/fashion/20111215_scenecity-slide-LEAR/20111215_scenecity-slide-LEAR-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/fashion/20111215_scenecity-slide-LEAR/20111215_scenec