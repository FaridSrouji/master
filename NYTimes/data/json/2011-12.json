qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2f520adc-6050-57e6-ba74-60f098032508', 'word_count': 1615, 'uri': 'nyt://article/2f520adc-6050-57e6-ba74-60f098032508'}, {'abstract': 'An oil boom has caused money to to flow by the barrelful into Mountrail County in North Dakota, transforming a sleepy community once proudly situated in the middle of nowhere into an unexpected oasis of prosperity.', 'web_url': 'https://www.nytimes.com/slideshow/2011/12/20/us/20111221_MINERALS.html', 'snippet': 'An oil boom has caused money to to flow by the barrelful into Mountrail County in North Dakota, transforming a sleepy community once proudly situated in the middle of nowhere into an unexpected oasis of prosperity.', 'lead_paragraph': 'An oil boom has caused money to to flow by the barrelful into Mountrail County in North Dakota, transforming a sleepy community once proudly situated in the middle of nowhere into an unexpected oasis of prosperity.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/us/20111221_MINERALS-slide-GZ0W/20111221_MINERALS-slide-GZ0W-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/us/20111221_MINERALS-slide-GZ0W/20111221_MINERALS-slide-GZ0W-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/20/us/20111221_MINERALS-slide-GZ0W/20111221_MINERALS-slide-GZ0W-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Disparities in an Oil Boomtown', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name'