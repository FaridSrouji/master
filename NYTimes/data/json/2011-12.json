ction_name': 'Automobiles', 'byline': {'original': 'By Christopher Jensen', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/db281604-fafd-5df7-9776-ab81f56cf7ca', 'word_count': 328, 'uri': 'nyt://article/db281604-fafd-5df7-9776-ab81f56cf7ca'}, {'abstract': 'Which state has the most ski resorts? (It’s not what you think.) How many dead musicians are honored on Aspen Mountain? It’s all here.', 'web_url': 'https://www.nytimes.com/2011/12/11/travel/21-trivia-facts-on-skiing-around-the-country.html', 'snippet': 'Which state has the most ski resorts? (It’s not what you think.) How many dead musicians are honored on Aspen Mountain? It’s all here.', 'lead_paragraph': 'Number\xa0 of ski areas in New York (the most in the\xa0 U.S.): 52', 'print_section': 'TR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/11/travel/11SKIMAP/11SKIMAP-jumbo-v3.jpg', 'height': 1024, 'width': 841, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Ski Trivia!', 'kicker': 'The Facts', 'content_kicker': None, 'print_headline': 'Home-Grown Skiing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Skiing', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-09T15:50:44+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Cindy Hirschfeld', 'person': [{'firstname': 'Cindy', 'middlename': None, 'lastname': 'Hirschfeld', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/542d60cd-0e80-5877-