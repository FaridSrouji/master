r': None, 'content_kicker': None, 'print_headline': 'Mine Owner Will Pay $209 Million in Blast That Killed 29 Workers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Blankenship, Don L', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Accidents and Safety', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Alpha Natural Resources Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mines and Mining', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Coal', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Massey Energy Co', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Fines (Penalties)', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'West Virginia', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Mine Safety and Health Administration', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Stover, Hughie Elbert', 'rank': 12, 'major': 'N'}], 'pub_date': '2011-12-06T13:42:30+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'U.S.', 'byline': {'original': 'By Sabrina Tavernise and Clifford Krauss', 'person': [{'firstname': 'Sabrina', 'middlename': None, 'lastname': 'Tavernise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Clifford', 'middlename': None, 'lastname': 'Krauss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/451b4f6c-de3e-5360-b966-c4c129a370c0', 'word_count': 1180, 'uri': 'nyt://article/451b4f6c-de3e-5360-b966-c4c129a370c0'}, {'abstract': 'Of GDP, GNP, and austerity.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/12/06/irish-pfizer-smiling/', 'snippet': 'Of GDP, GNP, and austerity.', 'lead_paragraph': 'The Times has a good article on Ireland, focusing on the dissonance between the praise of outsiders and the grim realities for the Irish themselves. And as the Times notes, all this “successful” austerity has still left the interest rate on Irish debt at a completely unsustainable level.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Irish Pfizer Smiling', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-06T13:55:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b203d350-4a23-568d-a0be-96afe09ae8ec', 'word_count': 253, 'uri': 'nyt://article/b203d350-4a23-568d-a0be-96afe09ae8ec'}, {'abstract': 'Highlights from the DealBook newsletter.', 'web_url': 'https://dealbook.nytimes.com/2011/12/06/morning-take-out-380/', 'snippet': 'Highlights from the DealBook newsletter.', 'lead_paragraph': 'TOP STORIES', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Take-Out', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-06T13:56:10+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/89dd99d1-218c-5313-bdbc-0abbbb38398d', 'word_count': 2087, 'uri': 'nyt://article/89dd99d1-218c-5313-bdbc-0abbbb38398d'}, {'abstract': 'The Berlin-based Design Hotels group is staking the first big claim to the pop-up hotel trend on the beach in Tulum, Mexico.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/12/06/now-booking-papaya-play-project/', 'snippet': 'The Berlin-based Design Hotels group is staking the first big claim to the pop-up hotel trend on the beach in Tulum, Mexico.', 'lead_paragraph': 'The pop-up phenomenon may be old news in retail and restaurants, but temporary hotels is a concept just gaining ground (makeshift bedrooms in Kreuzberg or Nakameguro art galleries excepted). Today the Berlin-based Design Hotels group is staking the first big claim to the trend on the beach in Tulum, Mexico. The company’s founder, Claus Sendlinger, who moved with his family to Tulum last year, is spearheading the opening of Papaya Playa, a spiffed-up campus of cabanas once belonging to three now-shuttered resorts on about a half mile of beachfront land.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Now Booking | Papaya Playa Project', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-06T14:00:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Jeffries Blackerby', 'person': [{'firstname': 'Jeffries', 'middlename': None, 'lastname': 'Blackerby', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90b3a168-9485-5d32-a2c2-333c1396a8c0', 'word_count': 379, 'uri': 'nyt://article/90b3a168-9485-5d32-a2c2-333c1396a8c0'}, {'abstract': 'Around the corner from the theater where New Yorkers saw the play “War Horse,” the film based on the play (and the book) had its premiere.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2011/12/06/a-setting-and-score-befitting-a-thoroughbred/', 'snippet': 'Around the corner from the theater where New Yorkers saw the play “War Horse,” the film based on the play (and the book) had its premiere.', 'lead_paragraph': 'If any premiere had the cinematic sweep and heft – and orchestration – of a John Williams score, it would have to be “War Horse” at Lincoln Center. Oh wait: the premiere did have exactly that; the music of Mr. Williams – which even a casual moviegoer would recognize from “Superman,” “Jaws” and “E.T.,” among many, many others – was piped into the afterparty on Sunday night. The soundtrack was just one reason that the world premiere of “War Horse,” Steven Spielberg’s adaptation of the children’s book-turned-theatrical hit felt grand.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Setting, and Score, Befitting a Thoroughbred', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-06T14:00:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c1ca9b4-7ebd-5a64-9c58-0aabeae53f6b', 'word_count': 719, 'uri': 'nyt://article/6c1ca9b4-7ebd-5a64-9c58-0aabeae53f6b'}, {'abstract': 'Rod R. Blagojevich, the former Illinois governor, convicted of 18 felony corruption charges, is expected to testify at his sentencing hearing.', 'web_url': 'https://www.nytimes.com/2011/12/07/us/politics/blagojevich-faces-sentencing-hearing.html', 'snippet': 'Rod R. Blagojevich, the former Illinois governor, convicted of 18 felony corruption charges, is expected to testify at his sentencing hearing.', 'lead_paragraph': 'CHICAGO —\xa0 Rod R. Blagojevich, the former governor of Illinois, is expected to speak on his own behalf on Wednesday before the federal judge who will decide his sentence for 18 felony corruption convictions, including trying to sell or trade the Senate seat that President Obama left behind when he moved to the White House.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/07/us/BLAGO/BLAGO-jumbo.jpg', 'height': 945, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/07/us/BLAGO/BLAGO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/07/us/BLAGO/BLAGO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Hearing May Be an Ex-Governor’s Last Stand', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hearing Today May Be an Ex-Governor’s Last Stand', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Illinois', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Blagojevich, Rod R', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Zagel, James B', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-06T14:03:12+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Monica Davey', 'person': [{'firstname': 'Monica', 'middlename': None, 'lastname': 'Davey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt:/