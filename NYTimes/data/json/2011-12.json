ectric', 'kicker': None, 'content_kicker': None, 'print_headline': 'Japan Recommends Temporary State Control for Tokyo Electric', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fukushima Daiichi Nuclear Power Plant (Japan)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Japan Earthquake and Tsunami (2011)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-27T11:59:51+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Hiroko Tabuchi', 'person': [{'firstname': 'Hiroko', 'middlename': None, 'lastname': 'Tabuchi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/71f0c1c9-6f7d-5e1c-b965-b8893774eece', 'word_count': 428, 'uri': 'nyt://article/71f0c1c9-6f7d-5e1c-b965-b8893774eece'}, {'abstract': 'The year’s best reading for small-business owners.', 'web_url': 'https://boss.blogs.nytimes.com/2011/12/27/this-year-in-small-business-the-best-reads/', 'snippet': 'The year’s best reading for small-business owners.', 'lead_paragraph': 'Until I started writing this weekly column, I never realized how many things can affect my small business. And I never realized how many smart people there are writing about and interpreting these things to try to help people like me better understand them. Of all of the pieces I reviewed this year, here are the best.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Year in Small Business: The Best Reads', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Entrepreneurship', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 2, 'major': 'N'}, {'name': 'su