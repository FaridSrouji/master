acy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/21/dining/video-grapefruitshrimp/video-grapefruitshrimp-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/10/21/dining/video-grapefruitshrimp/video-grapefruitshrimp-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/10/21/dining/video-grapefruitshrimp/video-grapefruitshrimp-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Southeast Asian Shrimp Salad', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Seafood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-23T19:04:36+0000', 'document_type': 'multimedia', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'Gabe Johnson|Krishnan Vasudevan', 'person': [{'firstname': 'Gabe', 'middlename': 'Johnson', 'lastname': 'Krishnan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/aaff6a48-00ce-51ba-ba07-bc4c7438b96c', 'word_count': 0, 'uri': 'nyt://video/aaff6a48-00ce-51ba-ba07-bc4c7438b96c'}, {'abstract': 'Simple preparation creates powerful flavors.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/12/23/the-minimalist-southeast-asian-shrimp-and-grapefruit-salad/', 'snippet': 'Simple preparation creates powerful flavors.', 'lead_paragraph': 'Fish sauce, sugar, mint and cilantro are flavors at the heart of Southeast Asian cooking. It’s amazing how essentially