n': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/26/arts/word/word-jumbo.jpg', 'height': 1024, 'width': 972, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/26/arts/word/word-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/26/arts/word/word-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Muses of Insert, Delete and Execute', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Muses of Insert, Delete and Execute', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Word Processing', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Maryland', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'King, Stephen', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Microsoft Corporation', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-25T21:53:59+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Jennifer Schuessler', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Schuessler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eca81cd4-776d-5a18-aa26-71b92b09d60a', 'word_count': 1309, 'uri': 'nyt://article/eca81cd4-776d-5a18-aa26-71b92b09d60a'}, {'abstract': 'Young musicians participating in the New York String Orchestra Seminar performed with Jaime Laredo and Bella Hristova at Carnegie Hall on Saturday in the first of two concerts.', 'web_url': 'https://www.nytimes.com/2011/12/26/arts/music/new-york-string-orchestra-with-jaime-laredo-review.html', 'snippet': 'Young musicians participating in the New York String Orchestra Seminar performed with Jaime Laredo and Bella Hristova at Carnegie Hall on Saturday in the first of two concerts.', 'lead_paragraph': 'Unlike students in most other fields, fledgling musicians never really take vacations from their training. They can’t. If they stop practicing for a few weeks simply because school is out, they will only need to work harder to get back in trim. Besides, setting aside their instruments is not, typically, what they want to do. Every winter about 60 musicians between 15 and 22 years old put their winter vacations to good use by coming to Manhattan for the New York String Orchestra Seminar, a 10-day program in which they are coached by a starry roster of soloists and chamber players. ', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/26/arts/string/string-jumbo.jpg', 'height': 747, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/26/arts/string/string-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/26/arts/string/string-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Young Artists, Playing With the Stars', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Young Artists, Playing With the Stars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Laredo, Jaime', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York String Orchestra', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hristova, Bella', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Carnegie Hall', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-25T21:55:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c89a716f-9aff-5f7d-bb55-c9a286ac408f', 'word_count': 492, 'uri': 'nyt://article/c89a716f-9aff-5f7d-bb55-c9a286ac408f'}, {'abstract': 'Harvey Araton writes about the 1970s New York Knicks with reverence in “When the Garden Was Eden,” but Scott Raab is comically bloody minded in “The Whore of Akron,” a hate later to LeBron James.', 'web_url': 'https://www.nytimes.com/2011/12/26/books/whore-of-akron-and-when-the-garden-was-eden-review.html', 'snippet': 'Harvey Araton writes about the 1970s New York Knicks with reverence in “When the Garden Was Eden,” but Scott Raab is comically bloody minded in “The Whore of Akron,” a hate later to LeBron James.', 'lead_paragraph': 'Sports are like life, simplified. The rules are enforced instantly and on the spot. Winners are clearly declared. In the stadium there’s delightful relief from the real-world trial of sifting enemies from allies: if they’re wearing your team’s uniforms, they’re good guys.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/26/arts/sub-jp-book-1/sub-jp-book-1-articleLarge.jpg', 'height': 375, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/26/arts/sub-jp-book-1/sub-jp-book-1-a