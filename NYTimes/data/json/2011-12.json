': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'SMITH, HOWARD', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Baseball', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Baseball Players Assn', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-14T22:20:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ken Belson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Belson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96740392-b732-5826-bb1a-82f3d516132c', 'word_count': 279, 'uri': 'nyt://article/96740392-b732-5826-bb1a-82f3d516132c'}, {'abstract': 'The live high-definition cinema broadcast of “George Balanchine’s The Nutcracker,” performed by New York City Ballet, was shown in 600 movie theaters around the United States.', 'web_url': 'https://www.nytimes.com/2011/12/15/arts/dance/city-ballets-nutcracker-recast-for-the-movies-review.html', 'snippet': 'The live high-definition cinema broadcast of “George Balanchine’s The Nutcracker,” performed by New York City Ballet, was shown in 600 movie theaters around the United States.', 'lead_paragraph': 'Onstage in “The Nutcracker” Fritz, the brother of the child heroine, is never alone. You see him in the company of his sister, his parents, his friends and the mysterious visiting magician Drosselmeier. On Tuesday, however, in the live high-definition cinema broadcast of George Balanchine’s production for New York City Ballet, there were moments when he — vividly performed by 9-year-old Maximilian Brooking Landegger — filled the vast screen all by himself. Naughty, impulsive, vulnerable, he became more funnily irresistible than ever. ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 