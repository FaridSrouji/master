': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/fashion/01MODERNLOVE/01MODERNLOVE-jumbo-v3.jpg', 'height': 1024, 'width': 672, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/fashion/01MODERNLOVE/01MODERNLOVE-superJumbo-v2.jpg', 'height': 1998, 'width': 1310, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/fashion/01MODERNLOVE/01MODERNLOVE-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/01/fashion/01MODERNLOVE/01MODERNLOVE-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/fashion/01MODERNLOVE/01MODERNLOVE-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Forgotten Prayer, Answered', 'kicker': 'Modern Love', 'content_kicker': None, 'print_headline': 'A Forgotten Prayer, Answered', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Bhutan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Prayers and Prayer Books', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Infertility', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Modern Love (Times Column)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Monasteries and Monks', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-29T18:34:14+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Charlotte Bacon', 'person': [{'firstname': 'Charlotte', 'middlename': None, 'lastname': 'Bacon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f38dcc3e-08e2-549f-a72d-b4ffe3f0cb75', 'word_count': 1523, 'uri': 'nyt://article/f38dcc3e-08e2-549f-a72d-b4ffe3f0cb75'}, {'abstract': 'Sotheby’s and Christie’s International, the doyennes of the auctions houses, sold $1.7 billion of work during their evening sales of high-value contemporary art in New York and London in 2011, according to calculations made by Scott Reyburn at Bloomberg, up from $1.2 billion in 2010 and $482.3 million in 2009.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/29/auction-houses-enjoy-major-increase-in-high-end-contemporary-art-sales-in-2011/', 'snippet': 'Sotheby’s and Christie’s International, the doyennes of the auctions houses, sold $1.7 billion of work during their evening sales of high-value contemporary art in New York and London in 2011, according to calculations made by Scott Reyburn at Blo...', 'lead_paragraph': 'Big-box stores may be worrying about their sales on Black Friday, Mega Monday and all the days in between, but sellers of high-end contemporary art seem to have done well this year. On the evidence of some auction results, at least, the market for such art rose significantly as jittery investors put their money into art instead of stocks, Bloomberg News reported. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Auction Houses See Increase in High-End Contemporary Art Sales', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'ARNAULT, BERNARD', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Richter, Gerhard', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Bloomberg Business News', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': "Christie's International Plc", 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': "Sotheby's", 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-12-29T18:37:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Patricia', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/95619666-b8c3-56ad-b19c-dfc908fdfd19', 'word_count': 243, 'uri': 'nyt://article/95619666-b8c3-56ad-b19c-dfc908fdfd19'}, {'abstract': 'Reverse auctions have helped bring down prices.', 'web_url': 'https://india.blogs.nytimes.com/2011/12/29/indias-novel-solar-auctions-fuel-boom/', 'snippet': 'Reverse auctions have helped bring down prices.', 'lead_paragraph': 'When the Indian government embarked on an ambitious solar power project two years ago, I wrote that its goals seemed farfetched. Since then, things have changed significantly, and as I note in Thursday’s paper, analysts say the project’s goal of having 20,000 megawatts of solar capacity by 2020 seems well within reach.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'India’s Novel Solar Auctions Fuel Boom', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Solar Energy', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Gujarat State (India)', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-29T18:42:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Vikas Bajaj', 'person': [{'firstname': 'Vika