jor': 'N'}, {'name': 'organizations', 'value': 'Catholic Charities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-13T02:44:48+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By C. J. Hughes', 'person': [{'firstname': 'C.', 'middlename': 'J.', 'lastname': 'Hughes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c657ad2a-10e9-5d32-a7d4-8b1c93b84790', 'word_count': 708, 'uri': 'nyt://article/c657ad2a-10e9-5d32-a7d4-8b1c93b84790'}, {'abstract': 'Cardinal Foley heeded God’s “whisper” to become a priest as well as his own inclinations to go to journalism school, then combined the roles as the Vatican’s communications director.', 'web_url': 'https://www.nytimes.com/2011/12/13/us/cardinal-john-p-foley-76-vatican-spokesman-dies.html', 'snippet': 'Cardinal Foley heeded God’s “whisper” to become a priest as well as his own inclinations to go to journalism school, then combined the roles as the Vatican’s communications director.', 'lead_paragraph': 'Cardinal John Patrick Foley, who heeded God’s “whisper,” as he put it, to become a priest as well as his own inclinations to go to journalism school at 31, then combined the roles as the Vatican’s communications director for almost a quarter-century, died on Sunday in Darby, Pa. He was 76.', 'print_section': 'B', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/13/us/FOLEY-obit/FOLEY-obit-jumbo.jpg', 'height': 1024, 'width': 567, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/13/us/FOLEY-obit/FOLEY-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 's