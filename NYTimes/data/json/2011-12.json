rticle/3bd9cf23-5360-52da-ad75-275dd16d9529'}, {'abstract': 'The successful public offering of Michael Kors Holdings offers a case study on how globalization increasingly allows companies to avoid taxes and regulation in the United States.', 'web_url': 'https://dealbook.nytimes.com/2011/12/20/the-benefits-of-incorporating-abroad-in-an-age-of-globalization/', 'snippet': 'The successful public offering of Michael Kors Holdings offers a case study on how globalization increasingly allows companies to avoid taxes and regulation in the United States.', 'lead_paragraph': 'Michael Kors Holdings not only sells fashion that people crave, it has also offered shares that were a hit with investors. The company’s shareholders, including the designer himself, sold about $944 million worth of stock last week in an initial public offering that valued the company at about $4 billion.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Benefits of Incorporating Abroad in an Age of Globalization', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Corporate Taxes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Initial Public Offerings', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Freescale Semiconductor Holdings I Ltd', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Kors, Michael, Holdings', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-20T20:53:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Steven Davidoff Solomon', 'person': [{'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://artic