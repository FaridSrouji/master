zations', 'value': 'Republican Party', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-12-08T02:13:27+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jeff Zeleny and Jim Rutenberg', 'person': [{'firstname': 'Jeff', 'middlename': None, 'lastname': 'Zeleny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jim', 'middlename': None, 'lastname': 'Rutenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d5a96f47-f97c-5985-853b-779f3d201965', 'word_count': 1092, 'uri': 'nyt://article/d5a96f47-f97c-5985-853b-779f3d201965'}, {'abstract': 'Mitt Romney’s campaign has shifted gears with a newly aggressive phase, less than a month before the Iowa caucuses.', 'web_url': 'https://www.nytimes.com/2011/12/08/us/politics/new-romney-ad-turns-up-heat-on-gingrich.html', 'snippet': 'Mitt Romney’s campaign has shifted gears with a newly aggressive phase, less than a month before the Iowa caucuses.', 'lead_paragraph': 'WASHINGTON — Mitt Romney’s campaign on Wednesday opened a new, more aggressive phase to capture the Republican nomination by moving to draw sharp distinctions with Newt Gingrich in the final weeks before voting begins.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/08/us/ROMNEY/ROMNEY-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/08/us/ROMNEY/ROMNEY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', '