: 'N'}], 'pub_date': '2011-12-14T00:00:59+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Robert Pear and Jennifer Steinhauer', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Pear', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Steinhauer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1c9a2c3b-fb6b-5030-b69f-807c12cc77c7', 'word_count': 1080, 'uri': 'nyt://article/1c9a2c3b-fb6b-5030-b69f-807c12cc77c7'}, {'abstract': 'Narciso Rodriguez’s prefall collection was peppered with color-blocked sweaters and fur sleeves.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/12/13/just-one-look-narciso-rodriguez/', 'snippet': 'Narciso Rodriguez’s prefall collection was peppered with color-blocked sweaters and fur sleeves.', 'lead_paragraph': 'The linear black and pale blue (and red) color-blocked sweaters at Narciso Rodriguez’s prefall collection were hard to ignore. “We’ve never stopped doing knits,” the designer says. “But yes, I guess there are more of them this season.” Other noteworthy pieces include the detachable (read: wonderfully transitional) fox fur sleeves and hooded toppers, and the black body-con leather-blocked dresses that are accented with a graffiti-splash print in black, white and yellow.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Just One Look | Narciso Rodriguez', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-14T00:02:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Chelsea Zalopany', 'person': [{'firstname': 'Chelsea', 'middlename': None, 'lastname': 'Zalopany', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35af87b6-6fa9-58e1-bd3c-5d297cf9e8f6', 'word_count': 71, 'uri': 'nyt://article/35af87b6-6fa9-58e1-bd3c-5d297cf9e8f6'}, {'abstract': 'Megaupload is suing the Universal Music Group for blocking a promotional video from being played on YouTube. The video features artists including Will.i.am, Kanye West and Alicia Keys.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/12/13/file-sharing-company-sues-record-label-for-a-change/', 'snippet': 'Megaupload is suing the Universal Music Group for blocking a promotional video from being played on YouTube. The video features artists including Will.i.am, Kanye West and Alicia Keys.', 'lead_paragraph': 'The way the cats-and-dogs legal fights of the entertainment industry usually work, it’s the big record company or movie studio that sues the offshore Internet corporation, accusing it of violating its rights.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'File-Sharing Company Sues Record Label, for a Change', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Will.i.am (1975- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Universal Music Group', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-14T00:09:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/02a2c3eb-3737-5288-b181-0e7214804bd3', 'word_count': 396, 'uri': 'nyt://article/02a2c3eb-3737-5288-b181-0e7214804bd3'}, {'abstract': 'A nonprofit center that provides substance abuse treatment turned down money from a purveyor of hard liquor that wanted to use the center for a photo shoot.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/12/13/a-perfect-place-for-a-photo-shoot-with-one-catch/', 'snippet': 'A nonprofit center that provides substance abuse treatment turned down money from a purveyor of hard liquor that wanted to use the center for a photo shoot.', 'lead_paragraph': 'The client wanted a grand, winding staircase for the photo shoot, something mansionlike and visually distinctive. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Perfect Place for a Photo Shoot, With One Catch', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Alcohol Abuse', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-14T00:10:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Andy Newman', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Newman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1fda3aac-1245-5dbf-83ef-2641493fc34a', 'word_count': 570, 'uri': 'nyt://article/1fda3aac-1245-5dbf-83ef-2641493fc34a'}, {'abstract': 'An article examining those rare few who have chosen to avoid Facebook completely has sparked a debate online about the merits of belonging to the site. A sampling of the comments from this site and from Facebook and Twitter.', 'web_url': 'https://bits.blogs.nytimes.com/2011/12/13/readers-weigh-in-on-life-with-and-without-facebook/', 'snippet': 'An article examining those rare few who have chosen to avoid Facebook completely has sparked a debate online about the merits of belonging to the site. A sampling of the comments from this site and from Facebook and Twitter.', 'lead_paragraph': ' Soon after my article about people who resist the lure of Facebook was posted on The Times’s Web site on Tuesday afternoon, more than 700 people had “liked” it — on Facebook itself. Many left comments about it on The Times’s Facebook page and on our site.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Readers Weigh In on Life With and Without Facebook', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Social Networking (Internet)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-14T00:15:19+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/14ca51bc-9f09-56c3-b908-053e6ec1c079', 'word_count': 493, 'uri': 'nyt://article/14ca51bc-9f09-56c3-b908-053e6ec1c079'}, {'abstract': 'Public pension plans pay billions in fees to private equity firms, which have made billions for these pension funds. The question is whether it is worth it for the pension plans.', 'web_url': 'https://dealbook.nytimes.com/2011/12/13/wall-st-s-odd-couple-and-their-quest-to-unlock-riches/', 'snippet': 'Public pension plans pay billions in fees to private equity firms, which have made billions for these pension funds. The question is whether it is worth it for the pension plans.', 'lead_paragraph': 'Private equity and public pensions are one of Wall Street’s most peculiar love affairs. Recently, the two have tried to become even closer. But don’t get mushy — this relationship is about money, not romance.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wall St.’s Odd Couple and Their Quest to Unlock Riches', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pensions and Retirement Plans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Private Equity', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'California Public Employees Retirement System', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Kohlberg Kravis Roberts & Co', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'The Blackstone Group', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-14T00:18:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Steven Davidoff Solomon', 'person': [{'firstname': 'Steven', 'middlename': 'Davidoff', 'lastname': 'Solomon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c6c3cd9e-6347-5aec-af7f-14ee79cc56e5', 'word_count': 1182, 'uri': 'nyt://article/c6c3cd9e-6347-5aec-af7f-14ee79cc56e5'}, {'abstract': '“Private Lives” closing at end of year, five weeks early', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/13/private-lives-to-close-on-broadway-at-years-end/', 'snippet': '“Private Lives” closing at end of year, five weeks early', 'lead_paragraph': 'The new Broadway revival of “Private Lives,” starring Kim Cattrall (“Sex and the City”) and Paul Gross, will close five weeks earlier than planned because of weak ticket sales, the producers announced on Tuesday night. The production of the classic Noel Coward play, which opened on Nov. 17 to generally good reviews, will now end on Dec. 31 instead of the original closing date of Feb. 5, 2012.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Private Lives’ To Close on Broadway At Year’s End', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-14T00:23:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/71b93b7e-6594-5779-beef-d806c0ad588f', 'word_count': 243, 'uri': 'nyt://article/71b93b7e-6594-5779-beef-d806c0ad588f'}, {'abstract': 'The Institute for Rational Urban Mobility responds to a City Room item.', 'web_url': 'https://www.nytimes.com/2011/12/14/opinion/crowded-sidewalks-in-new-york.html', 'snippet': 'The Institute for Rational Urban Mobility responds to a City Room item.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Crowded Sidewalks', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Crowded Sidewalks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sidewalks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pedestrian Malls', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sadik-Khan, Janette', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-14T00:29:41+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/41ed8409-4e2b-5f62-beec-66fb84fc4a4f', 'word_count': 200, 'uri': 'nyt://article/41ed8409-4e2b-5f62-beec-66fb84fc4a4f'}, {'abstract': 'Corey Trivino, a Boston University center and the leading goal scorer in the Hockey East conference, was thrown off the team after he was arrested Sunday on charges of indecent assault and battery.', 'web_url': 'https://www.nytimes.com/2011/12/14/sports/hockey/boston-university-star-is-off-team.html', 'snippet': 'Corey Trivino, a Boston University center and the leading goal scorer in the Hockey East conference, was thrown off the team after he was arrested Sunday on charges of indecent assault and battery.', 'lead_paragraph': 'Corey Trivino, a Boston University center and the leading goal scorer in the Hockey East conference, was thrown off the team by Coach Jack Parker after he was arrested Sunday on charges of indecent assault and battery. Trivino pleaded not guilty to all the charges at his arraignment Monday in Brighton District Court. Assistant District Attorney Cameron Merrill of Suffolk County said in court that witnesses described an intoxicated Trivino breaking into the room of a female student and trying to kiss and grope her. He was charged with three counts of indecent assault and battery, two counts of breaking and entering and one count of assault with attempt to rape. Trivino, a senior, was drafted by the Islanders in 2008. ', 'print_section': 'B', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Boston University Star Is Off Team', 'kicker': 'Sports Briefing | Hockey', 'content_kicker': None, 'print_headline': 'Boston U. Star Is Off Team', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Boston University', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hockey, Ice', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'S