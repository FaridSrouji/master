imes', 'multimedia': [], 'headline': {'main': 'Concussion Roster Quickly Expands Again', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Concussions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hockey, Ice', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Crosby, Sidney', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Giroux, Claude', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Hockey League', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-17T21:28:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein and Stu Hackel', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Stu', 'middlename': None, 'lastname': 'Hackel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee8a3593-7281-575c-b633-743a4cf71055', 'word_count': 1073, 'uri': 'nyt://article/ee8a3593-7281-575c-b633-743a4cf71055'}, {'abstract': 'President Dmitri A. Medvedev of Russia said anti-Kremlin street protests reflected “the mood of our people,” but reforms could not be adopted under pressure.', 'web_url': 'https://www.nytimes.com/2011/12/18/world/europe/medvedev-urges-reform-of-russian-political-system.html', 'snippet': 'President Dmitri A. Medvedev of Russia said anti-Kremlin street protests reflected “the mood of our people,” but reforms could not be adopted under pressure.', 'lead_paragraph': 'MOSCOW — President Dmitri A. Medvedev said Saturday that the country’s political system had “exhausted itself” and must be changed, and that the Russian aut