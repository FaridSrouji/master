r': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and the Internet', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bewkes, Jeffrey L', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hastings, Reed', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Time Warner Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-06T23:35:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1ba8c10c-136b-5806-8746-9174487d2ebb', 'word_count': 544, 'uri': 'nyt://article/1ba8c10c-136b-5806-8746-9174487d2ebb'}, {'abstract': 'The Roots have released two albums almost simultaneously. “Undun” arrived on Tuesday, and a collaboration with the soul singer Betty Wright came out on Nov. 15.', 'web_url': 'https://www.nytimes.com/2011/12/07/arts/music/the-roots-2-albums-one-quest.html', 'snippet': 'The Roots have released two albums almost simultaneously. “Undun” arrived on Tuesday, and a collaboration with the soul singer Betty Wright came out on Nov. 15.', 'lead_paragraph': 'One mission isn’t enough for the Roots, who have released two albums almost simultaneously. “Undun” (Def Jam), the Roots’ own 13th studio album, arrived on Tuesday, and a collaboration with the soul singer Betty Wright, “Betty Wright: The Movie” (Ms. B/S-Curve) came out on Nov. 15. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/07/arts/jump-roots-2/jump-roots-2-jumbo.jpg', 'height': 1024, 'width': 805, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/07/arts/jump-roots-2/jump-roots-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/07/arts/jump-roots-2/jump-roots-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'The Roots: 2 Albums, One Quest', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'The Roots: 2 Albums, One Quest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Roots, The', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-06T23:36:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d16ff85-4d7c-5429-a651-640c37801493', 'word_count': 904, 'uri': 'nyt://article/6d16ff85-4d7c-5429-a651-640c37801493'}, {'abstract': '“London River,” by Rachid Bouchareb, is set in the aftermath of the July 2005 London transit system bombings.', 'web_url': 'https://www.nytimes.com/2011/12/07/movies/london-river-stars-brenda-blethyn-review.html', 'snippet': '“London River,” by Rachid Bouchareb, is set in the aftermath of the July 2005 London transit system bombings.', 'lead_paragraph': 'Rachid Bouchareb’s tidy little two-character film, “London River,” demonstrates how great acting can infuse a banal, politically correct drama with dollops of emotional truth. This cozy tale of the rapprochement between two cultures, each personified by an individual, is likable in the same way as “Driving Miss Daisy,” though “London River” is tougher and sadder and not as well written.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/07/arts/RIVER/RIVER-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/07/arts/RIVER/RIVER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/07/arts/RIVER/RIVER-jumbo.jpg', 'height': 1024, 'width': 921, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/07/arts/RIVER/RIVER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/07/arts/RIVER/RIVER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Wake of Terror Attacks, Unlikely Bonds', 'kicker': "Movie Review | 'London River'", 'content_kicker': None, 'print_headline': 'In Wake of Terror Attacks, Unlikely Bonds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Blethyn, Brenda', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bouchareb, Rachid', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-06T23:36:24+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname'