arge.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/20/sports/MERRITT/MERRITT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 403}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/sports/MERRITT/MERRITT-jumbo.jpg', 'height': 734, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/sports/MERRITT/MERRITT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/20/sports/MERRITT/MERRITT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Sprinter Leaves Humiliation Behind', 'kicker': None, 'content_kicker': None, 'print_headline': 'Sprinter Leaves Shame Behind', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Doping (Sports)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'USA Track and Field', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Merritt, LaShawn', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wariner, Jeremy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Track and Field', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Logan, Doug', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Olympic Games (2012)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-20T01:33:46+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Jeré Longman', 'person': [{'firstname': 'Jeré', 'middlename': None, 'lastname': 'Longman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cf127589-c348-591b-8761-8ffe703d8d6c', 'word_count': 2447, 'uri': 'nyt://article/cf127589-c348-591b-8761-8ffe703d8d6c'}, {'abstract': 'For South Korean and American intelligence services to have failed to pick up clues right away about Kim Jong-il’s death attests to the secretive nature of North Korea.', 'web_url': 'https://www.nytimes.com/2011/12/20/world/asia/in-detecting-kim-jong-il-death-a-gobal-intelligence-failure.html', 'snippet': 'For South Korean and American intelligence services to have failed to pick up clues right away about Kim Jong-il’s death attests to the secretive nature of North Korea.', 'lead_paragraph': 'WASHINGTON — Kim Jong-il, the enigmatic North Korean leader, died on a train at 8:30 a.m. Saturday in his country. Forty-eight hours later, officials in South Korea still did not know anything about it — to say nothing of Washington, where the State Department acknowledged “press reporting” of Mr. Kim’s death well after North Korean state media had already announced it. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/world/INTEL/INTEL-articleLarge-v2.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/20/world/INTEL/INTEL-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/world/INTEL/INTEL-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/20/world/INTEL/INTEL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/20/world/INTEL/INTEL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight':