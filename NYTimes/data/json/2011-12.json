01214472/timescast--december-8-2011.html', 'snippet': 'Russia’s prime minister accuses the United States of inciting election protests, and Mexico’s booming business of recycling car batteries leads to growing cases of lead poisoning.', 'lead_paragraph': 'Russia’s prime minister accuses the United States of inciting election protests, and Mexico’s booming business of recycling car batteries leads to growing cases of lead poisoning.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/08/multimedia/video-tc-111208/video-tc-111208-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/08/multimedia/video-tc-111208/video-tc-111208-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/08/multimedia/video-tc-111208/video-tc-111208-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/08/multimedia/video-tc-111208/video-tc-111208-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'TimesCast | December 8, 2011', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-08T18:05:11+0000', 'document_type': 'multimedia', 'news_desk': 'ContinuousNews', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Zena Barakat|Emily B. Hager|Kassie Bracken', 'person': [{'firstname': 'Zena', 'middlename': 'Barakat', 'lastname': 'Emily', 'qualifier': None, 'titl