dia': [], 'headline': {'main': 'Bacteria 1, F.D.A. 0', 'kicker': 'Mark Bittman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recalls and Bans of Products', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Food and Drug Administration', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-28T02:00:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b394ecef-817a-55f8-99b1-9f31815b1ee3', 'word_count': 256, 'uri': 'nyt://article/b394ecef-817a-55f8-99b1-9f31815b1ee3'}, {'abstract': 'Helen Frankenthaler, the lyrically abstract painter who became one of the most admired artists of her generation, died on Tuesday at her home in Darien, Conn. She was 83.', 'web_url': 'https://www.nytimes.com/slideshow/2011/12/27/arts/design/20111228_FRANKENTHALER.html', 'snippet': 'Helen Frankenthaler, the lyrically abstract painter who became one of the most admired artists of her generation, died on Tuesday at her home in Darien, Conn. She was 83.', 'lead_paragraph': 'Helen Frankenthaler, the lyrically abstract painter who became one of the most admired artists of her generation, died on Tuesday at her home in Darien, Conn. She was 83.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/arts/design/20111228_FRANKENTHALER-slide-G1QL/20111228_FRANKENTHALER-slide-G1QL-jumbo.jpg', 'height': 775, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/arts/design/2011122