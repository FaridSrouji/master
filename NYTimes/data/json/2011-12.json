ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a4abadd9-af4d-5f1b-84b5-ba476434f889', 'word_count': 842, 'uri': 'nyt://article/a4abadd9-af4d-5f1b-84b5-ba476434f889'}, {'abstract': 'The Knoedler Gallery, being sued for $17 million over a disputed Jackson Pollock painting, earlier refunded $2 million to a client with similar concerns of authenticity about another work.', 'web_url': 'https://www.nytimes.com/2011/12/17/arts/design/hearings-shed-light-on-dispute-over-authenticity-of-pollocks.html', 'snippet': 'The Knoedler Gallery, being sued for $17 million over a disputed Jackson Pollock painting, earlier refunded $2 million to a client with similar concerns of authenticity about another work.', 'lead_paragraph': 'Years before federal authorities opened their forgery inquiry into a cache of Modernist paintings handled by high-end art dealers, the Knoedler Gallery agreed to refund $2 million to a client who had questioned the authenticity of one of the works, according to court testimony this week.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hearings Shed Light on Pollock Dispute', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hearings Shed Light On Pollock Dispute', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pollock, Jackson', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rosales, Glafira', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Levy, Jack', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Forgery', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-17T01:26:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Pa