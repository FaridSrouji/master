ds': [], 'pub_date': '2011-12-10T03:30:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By David Gonzalez', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Gonzalez', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1b6c76f9-c0fd-5997-92aa-63073cb7a240', 'word_count': 423, 'uri': 'nyt://article/1b6c76f9-c0fd-5997-92aa-63073cb7a240'}, {'abstract': 'In a gambit to polish its image — JPMorgan Chase will sponsor the “American Giving Awards,” an event that will be televised on Saturday and will profile recipients of Chase donations.', 'web_url': 'https://www.nytimes.com/2011/12/10/business/media/jpmorgan-is-promoting-its-charity-on-nbc-show.html', 'snippet': 'In a gambit to polish its image — JPMorgan Chase will sponsor the “American Giving Awards,” an event that will be televised on Saturday and will profile recipients of Chase donations.', 'lead_paragraph': 'When a television network broadcasts an awards show created by a multinational bank’s marketers, what is it? An advertisement? A tribute to deserving charities? An entertainment spectacle?', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For Chase, a TV Show to Promote Its Charity', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Chase, A TV Show To Promote Its Charity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'JPMorgan Chase & Company', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Public Relations and Publicity', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-10T03:33:16+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Brian Stelter', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Stelter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8d96ea39-0016-5a7b-a453-d3743745ae44', 'word_count': 809, 'uri': 'nyt://article/8d96ea39-0016-5a7b-a453-d3743745ae44'}, {'abstract': 'Ashley Bouder, the principal dancer with the New York City Ballet, spends her Sundays unwinding: walking her dogs, napping, enjoying leisurely meals and catching up on social media.', 'web_url': 'https://www.nytimes.com/2011/12/11/nyregion/ashley-bouder-dancer-unwinds-and-stretches-on-sundays.html', 'snippet': 'Ashley Bouder, the principal dancer with the New York City Ballet, spends her Sundays unwinding: walking her dogs, napping, enjoying leisurely meals and catching up on social media.', 'lead_paragraph': 'The first time she performed the role of Dewdrop in “George Balanchine’s The Nutcracker” with the New York City Ballet, Ashley Bouder was 17 and made a memorable entrance: she fell on her face. Now 27 and a principal dancer for the company, Ms. Bouder is in her eighth season as the Sugarplum Fairy and her 11th as Dewdrop. She will perform that role in a live City Ballet broadcast in movie theaters on Tuesday and on the PBS program “Live From Lincoln Center” on Wednesday. Ms. Bouder lives on the Upper West Side with her boyfriend, Matthew Dibble, 35, now touring in Twyla Tharp’s “Come Fly Away,” and their dogs: Scout, a Beagle; and Enid, a Boston terrier. On nonperforming Sundays, she unwinds with the dogs, naps, posts to Twitter and has a big dinner.', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/11/nyregion/11ROUTINE2_SPAN/11ROUTINE2-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/11/nyregion/11ROUTINE2_SPAN/11ROUTINE2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/11/nyregion/11ROUTINE2_SPAN/11ROUTINE2-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/11/nyregion/11ROUTINE2_SPAN/11ROUTINE2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/11/nyregion/11ROUTINE2_SPAN/11ROUTINE2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Dancer as Walker, Baker, Reader', 'kicker': 'Sunday Routine', 'content_kicker': None, 'print_headline': 'Dancer as Walker, Baker, Reader', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Upper West Side (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Ballet', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bouder, Ashley', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-10T03:34:04+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Robin Finn', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Finn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/18c9bc7e-1e06-5c3d-aa57-1941b4096f48', 'word_count': 71