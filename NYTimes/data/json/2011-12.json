', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/us/SUB-CHEETAH/SUB-CHEETAH-articleLarge.jpg', 'height': 391, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/01/us/SUB-CHEETAH/SUB-CHEETAH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/us/SUB-CHEETAH/SUB-CHEETAH-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/us/SUB-CHEETAH/SUB-CHEETAH-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/01/us/SUB-CHEETAH/SUB-CHEETAH-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Farewell to Cheetah, the Original or Otherwise', 'kicker': None, 'content_kicker': None, 'print_headline': 'Death of a Chimpanzee Revives Doubts About Its Film Résumé', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Monkeys and Apes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weissmuller, Johnny', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': "O'Sullivan, Maureen", 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-31T22:18:34+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Kim Severson', 'person': [{'firstname': 'Kim', 'middlename': None, 'lastname': 'Severson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03695e9a-641a-550d-a55d-e94ba1be213e', 'word_count': 922, 'uri