line': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Standard & Poor's 500-Stock Index", 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-02T17:34:54+0000', 'document_type': 'multimedia', 'news_desk': 'Business Day', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/d29f52cb-6cc2-53b5-9ed0-5199dc9be329', 'word_count': 0, 'uri': 'nyt://interactive/d29f52cb-6cc2-53b5-9ed0-5199dc9be329'}, {'abstract': 'The unemployment rate is coming down where the need is greatest, among those with less education.', 'web_url': 'https://economix.blogs.nytimes.com/2011/12/02/jobs-good-headline-better-details/', 'snippet': 'The unemployment rate is coming down where the need is greatest, among those with less education.', 'lead_paragraph': 'The job market seems to be getting better, and it is doing so in surprising areas. Jobs seem to be going to people with less education, and the number of long-term unemployed is coming down.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Jobs: Good Headline, Better Details', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recession and Depression', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-02T17:35:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Floyd Norris', 'person': [{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 