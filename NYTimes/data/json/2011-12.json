son': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7eaedec-b537-5b23-b534-d73a619b2742', 'word_count': 2041, 'uri': 'nyt://article/c7eaedec-b537-5b23-b534-d73a619b2742'}, {'abstract': 'A defiant President Bashar al-Assad of Syria spoke in a rare television interview to be broadcast on Wednesday.', 'web_url': 'https://www.nytimes.com/2011/12/08/world/middleeast/in-rare-interview-assad-denies-ordering-crackdown-in-syria.html', 'snippet': 'A defiant President Bashar al-Assad of Syria spoke in a rare television interview to be broadcast on Wednesday.', 'lead_paragraph': 'PARIS — A defiant President Bashar al-Assad of Syria, speaking in a rare television interview broadcast on Wednesday, denied ordering the bloody crackdown that has convulsed his land for the past nine months and disputed a United Nations estimate that 4,000 people had been killed as protesters took to the streets of cities across his land demanding that he step down.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Rare Interview, Assad Denies Ordering Crackdown in Syria', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Rare Interview, Assad Denies Ordering Crackdown in Syria', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Assad, Bashar al-', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Walters, Barbara', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'ABC News', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-07T13:25:22+0000', 'document_type': 'article', 'news_desk': 'For