e': 'Pro Basketball', 'byline': {'original': 'By Mark Heisler', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Heisler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c61bba36-4557-54c0-9542-c3c688cbd932', 'word_count': 704, 'uri': 'nyt://article/c61bba36-4557-54c0-9542-c3c688cbd932'}, {'abstract': 'A new bill would require developers who profit from public subsidies to pay a minimum wage of $10 an hour, lifting thousands of New Yorkers above the poverty line.', 'web_url': 'https://www.nytimes.com/2011/12/26/opinion/a-living-wage-long-overdue.html', 'snippet': 'A new bill would require developers who profit from public subsidies to pay a minimum wage of $10 an hour, lifting thousands of New Yorkers above the poverty line.', 'lead_paragraph': 'New York City provides hundreds of millions of dollars a year in taxpayer-financed subsidies to private developers. It is only right that the jobs created by those projects pay a decent wage. The Fair Wages for New Yorkers Act, widely known as the living-wage bill, would nudge these employers in the right direction. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Living Wage, Long Overdue', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'A Living Wage, Long Overdue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Living Wage', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Building (Construction)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Edito