rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-27T23:04:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Health', 'byline': {'original': "By Anahad O'Connor", 'person': [{'firstname': 'Anahad', 'middlename': None, 'lastname': "O'Connor", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e8695ef-75d9-5be3-a567-7008217662dc', 'word_count': 282, 'uri': 'nyt://article/0e8695ef-75d9-5be3-a567-7008217662dc'}, {'abstract': 'This year there have been 42 health care related transactions in New York City totaling more than 1.2 million square feet.', 'web_url': 'https://www.nytimes.com/2011/12/28/realestate/commercial/changes-in-health-care-delivery-prompt-property-deals.html', 'snippet': 'This year there have been 42 health care related transactions in New York City totaling more than 1.2 million square feet.', 'lead_paragraph': 'MedRite Urgent Care has a bustling office on Second Avenue and 49th Street, packed with professionals in suits rushing to have their blood drawn between meetings and neighborhood residents who like the convenience. The clinic, which provides checkups, drug testing and other primary and urgent medical care for walk-in patients, opened in February.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/28/business/MEDICAL/MEDICAL-jumbo.jpg', 'height': 705, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/28/business/MEDICAL/MEDICAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/28/business/MEDICAL/MEDICAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Shifts in Health Care Delivery Stimulate a String of Property Deals', 'kicker': 'Square Feet', 'content_kicker': None, 'print_headline': 'Shifts in Health Care Delivery Stimulate a String of Property Deals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Renting and Leasing (Real Estate)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Relocation of Business', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate (Commercial)', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-12-27T23:05:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Real Estate', 'subsection_name': 'Commercial Real Estate', 'byline': {'original': 'By Julie Satow', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Satow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d1646ea4-fd6d-5e69-b0ba-8e9e7e9bd86a', 'word_count': 1147, 'uri': 'nyt://article/d1646ea4-fd6d-5e69-b0ba-8e9e7e9bd86a'}, {'abstract': 'Eric Asimov visits Mas (la grillade), the subject of his last restaurant review, and recalls a life-changing meal at Asador Etxebarri, where the chef cooked under similar constraints.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2011/12/27/reviewing-mas-la-grillade/', 'snippet': 'Eric Asimov visits Mas (la grillade), the subject of his last restaurant review, and recalls a life-changing meal at Asador Etxebarri, where the chef cooked under similar constraints.', 'lead_paragraph': 'A couple of years ago while traveling in Spain I had two life-changing meals. One was at El Bulli, a restaurant some of you may have heard of, which no longer exists. The other was at Asador Etxebarri, in the little Basque town of Axpe, about as far from El Bulli in spirit as you can journey.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Reviewing Mas (la grillade)', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'El Bulli', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-27T23:12:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Eric Asimov', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Asimov', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ca0d4915-88d4-548c-ab5a-de3101c76289', 'word_count': 479, 'uri': 'nyt://article/ca0d4915-88d4-548c-ab5a-de3101c76289'}, {'abstract': 'Mas (la grillade) is a restaurant of rare restraint and craft, where a chef who talks the talk of letting ingredients speak for themselves actually follows through.', 'web_url': 'https://www.nytimes.com/2011/12/28/dining/reviews/mas-la-grillade-nyc-restaurant-review.html', 'snippet': 'Mas (la grillade) is a restaurant of rare restraint and craft, where a chef who talks the talk of letting ingredients speak for themselves actually follows through.', 'lead_paragraph': 'WOOD, fire, smoke and flesh. It doesn’t get any simpler, more elemental or more prehistoric than this fundamental equation.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/28/dining/28REST_SPAN/28REST-articleLarge.jpg', 'height': 350, 'width'