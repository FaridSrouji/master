_name': 'U.S.', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/79128e73-074e-598a-a062-89de1818188d', 'word_count': 0, 'uri': 'nyt://slideshow/79128e73-074e-598a-a062-89de1818188d'}, {'abstract': 'Eight former executives and contractors of the German industrial giant were charged with criminal bribery by the Justice Department in connection with a $1 billion contract with Argentina.', 'web_url': 'https://www.nytimes.com/2011/12/14/business/global/former-siemens-executives-charged-with-bribery.html', 'snippet': 'Eight former executives and contractors of the German industrial giant were charged with criminal bribery by the Justice Department in connection with a $1 billion contract with Argentina.', 'lead_paragraph': 'WASHINGTON — Shell companies, Swiss bank accounts, double-crossing middlemen and cash being smuggled across borders were all part of a decade-long bribery scheme aimed at helping Siemens, the German industrial giant, secure a $1 billion contract to produce national identity cards for Argentina, the Justice Department said Tuesday.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/business/SIEMENS/SIEMENS-jumbo.jpg', 'height': 941, 'width': 677, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Former Siemens Executives Are Charged With Bribery', 'kicker': None, 'content_kicker': None, 'print_headline': 'Former Siemens Executives Are Charged With Bribery', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ARGENTINA', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Siemens A.G', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Bribery and Kickbacks', 'rank': 4, 'major':