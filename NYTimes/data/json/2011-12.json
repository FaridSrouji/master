btype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/business/ROAD/ROAD-jumbo.jpg', 'height': 1024, 'width': 870, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/business/ROAD/ROAD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/27/business/ROAD/ROAD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Airlines Are Retrenching, and Alternatives Are Slim', 'kicker': 'On the Road', 'content_kicker': None, 'print_headline': 'Airlines Are Retrenching, And Alternatives Are Slim', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'High-Speed Rail Projects', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Railroads', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-27T01:18:28+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Joe Sharkey', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Sharkey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/79aaabe7-94ed-54f3-b8ed-e2231ccbc961', 'word_count': 776, 'uri': 'nyt://article/79aaabe7-94ed-54f3-b8ed-e2231ccbc961'}, {'abstract': 'Dave Alberga, the chief executive of an events management software company and a former infantry officer, scans the crowd for unusual goings-on. Then again, he contributes some himself.', 'web_url': 'https://www.nytimes.com/2011/12/27/business/the-military-minds-take-on-civilian-flights.html', 'snippet': 'Dave Alberga, the chief executive of an events management software company and a former infantry officer, scans the crowd for unusual goings-on. Then again, he contributes some himself.', 'lead_paragraph': 'I ACTUALLY enjoy business trips. I really like not being in charge or in control. I can get work done, read a book, or just sit and think without being disturbed. Even though I’m the chief executive of a software company, I almost never fly first class or business class. I’m a coach guy. If I get an upgrade, don’t get me wrong, I’ll take it. But most of the time I’m sitting in the back of the plane. ', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/27/business/FLIER/FLIER-jumbo.jpg', 'height': 710, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'The Military Mind’s Take on Civilian Flights', 'kicker': 'Frequent Flier', 'content_kicker': None, 'print_headline': 'The Military Mind’s Take On Civilian Flights', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Business Travel', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-27T01:23:51+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Dave Alberga', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Alberga', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5748c65d-0552-5a93-922c-64209bd272b4', 