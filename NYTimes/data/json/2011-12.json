role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/455e92b4-59b7-54be-ace0-83474994dda7', 'word_count': 134, 'uri': 'nyt://article/455e92b4-59b7-54be-ace0-83474994dda7'}, {'abstract': 'With the opening of several new hotel restaurants, travelers can experience Spain’s molecular gastronomy in places including Mexico.', 'web_url': 'https://intransit.blogs.nytimes.com/2011/12/01/spains-star-chefs-are-branching-out/', 'snippet': 'With the opening of several new hotel restaurants, travelers can experience Spain’s molecular gastronomy in places including Mexico.', 'lead_paragraph': 'It may be too late to try Ferran Adrià’s molecular gastronomy at El Bulli in Catalonia, which closed in July. But with the opening of several Michelin-starred hotel restaurants in Spain, travelers can experience cutting-edge cookery in places outside remote areas of the Basque Country or Catalonia. The chef Dani García runs Calima in the resort town of Marbella; and the twin chefs Sergio and Javier Torres run Dos Cielos in Barcelona. Both restaurants, part of the Melia hotel chain, are making Spain’s new cuisine easier to reach (if not easier on the wallet).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Spain’s Star Chefs Are Branching Out', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ADRIA, FERRAN', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-01T15:15:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By Sarah Wildman', 'person': [{'firstname': 'Sarah', 'middlename': None, 'lastname': 'Wildman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/249d8919-dab2-5624-b4ec-daaf71346c75', 'word_count': 214, 'uri': 'nyt://article/249d8919-dab2-5624-b4ec-daaf71346c75'}, {'abstract': 'This week’s Poetry Pairing matches J. Allyn Rosser’s “Meeting on the Street” with a Modern Love column about the memory and enduring legacy of former loves.', 'web_url': 'https://learning.blogs.nytimes.com/2011/12/01/poetry-pairing-meeting-on-the-street/', 'snippet': 'This week’s Poetry Pairing matches J. Allyn Rosser’s “Meeting on the Street” with a Modern Love column about the memory and enduring legacy of former loves.', 'lead_paragraph': 'This week’s Poetry Pairing matches J. Allyn Rosser’s “Meeting on the Street” with a Modern Love column, “Romance’s New Format.” ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Poetry Pairing | ‘Meeting on the Street’', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-01T15:15:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Shannon Doyne', 'person': [{'firstname': 'Shannon', 'middlename': None, 'lastname': 'Doyne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/476b0f7f-43c1-5f8c-ad1d-2268ea95f4bd', 'word_count': 584, 'uri': 'nyt://article/476b0f7f-43c1-5f8c-ad1d-2268ea95f4bd'}, {'abstract': 'Right wing politicians have long believed that government jobs aren’t really jobs.', 'web_url': 'https://takingnote.blogs.nytimes.com/2011/12/01/republicans-v-federal-workers/', 'snippet': 'Right wing politicians have long believed that government jobs aren’t really jobs.', 'lead_paragraph': 'Congressional Republicans said yesterday they would support an extension of the payroll tax cut, but refused President Obama’s proposal to make millionaires pay for it with a small surcharge on their earnings. Instead, they want middle-class federal workers to offset the cost.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Republican Attack on Federal Workers', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Payroll Tax', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Perry, Rick', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-01T15:25:11+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Firestone', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Firestone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/58411350-5008-5301-a801-084e51364f46', 'word_count': 367, 'uri': 'nyt://article/58411350-5008-5301-a801-084e51364f46'}, {'abstract': 'The wacky world of the N.H.L. standings has Minnesota at the top, Anaheim firing Randy Carlyle in favor of Bruce Boudreau, and Toronto and Phoenix making rare appearances high in the standings.', 'web_url': 'https://slapshot.blogs.nytimes.com/2011/12/01/leading-off-whats-gotten-into-hockey/', 'snippet': 'The wacky world of the N.H.L. standings has Minnesota at the top, Anaheim firing Randy Carlyle in favor of Bruce Boudreau, and Toronto and Phoenix making rare appearances high in the standings.', 'lead_paragraph': 'N.H.L. seasons are usually fairly predictable. Teams muddle around during the fall when most people think the season hasn’t (or shouldn’t have) started yet. Everyone is within three points of a playoff spot in February. Teams throw players around like throw pillows at the trading deadline. Everyone makes a riveting mad dash at the playoffs, which end ridiculously late in the year when people have sunscreen on their shopping lists.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Leading Off: What’s Gotten Into Hockey?', 'kicker': 'Slap Shot', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coaches and Managers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hockey, Ice', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Stanley Cup', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Boudreau, Bruce', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Leach, Mike', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Neuheisel, Rick', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Rodriguez, Rich', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Sandusky, Jerry', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Anaheim Ducks', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'Big Ten Conference', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Cubs', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Minnesota Wild', 'rank': 14, 'major': 'N'}, {'name': 'organizations', 'value': 'National Hockey League', 'rank': 15, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Islanders', 'rank': 16, 'major': 'N'}, {'name': 'organizations', 'value': 'Pennsylvania State University', 'rank': 17, 'major': 'N'}, {'name': 'organizations', 'value': 'Phoenix Coyotes', 'rank': 18, 'major': 'N'}, {'name': 'organizations', 'value': 'Secret Service', 'rank': 19, 'major': 'N'}, {'name': 'organizations', 'value': 'Syracuse University', 'rank': 20, 'major': 'N'}, {'name': 'organizations', 'value': 'University of California, Los Angeles', 'rank': 21, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington Capitals', 'rank': 22, 'major': 'N'}], 'pub_date': '2011-12-01T15:28:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Lynn Zinser', 'person': [{'firstname': 'Lynn', 'middlename': None, 'lastname': 'Zinser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/492a7d1e-61ec-554d-bdd8-493f5befa34e', 'word_count': 818, 'uri': 'nyt://article/492a7d1e-61ec-554d-bdd8-493f5befa34e'}, {'abstract': 'Many tech industry giants will scramble to sustain relevance because of the convergence of mobile devices, social networking, and cloud-based computing and data storage, IDC predicts in a new study. If the IDC’s view ends up being correct, the technology industry is in the midst of perhaps its fastest-ever transition.', 'web_url': 'https://bits.blogs.nytimes.com/2011/12/01/cloud-computing-endangers-older-tech-companies/', 'snippet': 'Many tech industry giants will scramble to sustain relevance because of the convergence of mobile devices, social networking, and cloud-based computing and data storage, IDC predicts in a new study. If the IDC’s view ends up being correct, the tec...', 'lead_paragraph': 'The International Data Corporation, whose technology analysis and predictions influence a lot of corporate purchases, foresees the creation of a new high-technology industry in the convergence of mobile devices, social networking, and cloud-based computing and data storage. As a result, the company says in a new study, many industry giants will scramble to sustain relevance, and some upstarts will achieve leadership positions or be purchased.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/01/technology/01bits-servers/01bits-servers-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/01/technology/01bits-servers/01bits-servers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/01/technology/01bits-servers/01bits-servers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Cloud Computing as a Threat to Older Tech Companies', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cloud Computing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Enterprise Computing', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'IDC China Telecommunication', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-01T15:33:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Quentin Hardy', 'person': [{'firstname': 'Quentin', 'middlename': None, 'lastname': 'Hardy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d81b4f2-ac2b-5561-b84c-47341b0f69d5', 'word_count': 771, 'uri': 'nyt://article/0d81b4f2-ac2b-5561-b84c-47341b0f69d5'}, {'abstract': 'In the adapted screenplay race, hit books can be especially challenging source material, as the makers of “Tinker, Tailor, Soldier, Spy” can attest.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2011/12/01/how-hard-is-it-to-adapt-a-hit-book-ask-the-makers-of-tinker-tailor/', 'snippet': 'In the adapted screenplay race, hit books can be especially challenging source material, as the makers of “Tinker, Tailor, Soldier, Spy” can attest.', 'lead_paragraph': 'Over at Gold Derby, Adam Waldowski takes a look at the strong competition for the best adapted screenplay Oscar. When it picked up a nod from the New York Film Critics Circle on Tuesday, “Moneyball,” the adaptation of Michael Lewis’s business-of-baseball best seller, got an early lead; it may also be helped by having recognizable writers in Aaron Sorkin and Steve Zaillian. On the other hand, Mr. Sorkin won an Oscar just last year, for “The Social Network,” and Mr. Zaillian picked up one in 1993, for a little film called “Schindler’s List.” (He also adapted this year’s “Girl With the Dragon Tattoo.”) Who else is on deck?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'How Hard Is It to Adapt a Hit Book? Ask the Makers of ‘Tinker, Tailor’', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-01T15:57:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef966524-ae78-57f0-8e47-87bb1ae80afd', 'word_count': 541, 'uri': 'nyt://article/ef966524-ae78-57f0-8e47-87bb1ae80afd'}, {'abstract': 'The stars of the film “Once” and those of the stage musical discuss what is similar — and what is not — about the two versions.', 'web_url': 'https://www.nytimes.com/2011/12/04/theater/the-film-once-becomes-a-new-york-musical.html', 'snippet': 'The stars of the film “Once” and those of the stage musical discuss what is similar — and what is not — about the two versions.', 'lead_paragraph': 'WHILE preparing for the lead role of Girl in the new Off Broadway musical “Once,” Cristin Milioti made a choice common among performers in screen-to-stage adaptations: She avoided watching the original film, a 2006 indie romance from Ireland that won an Academy Award for the song “Falling Slowly.” Her concern was that she might slip into mimicking Marketa Irglova, the spirited young Czech musician who became a fan favorite as Girl in the movie.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/04/arts/04JPONCE/04JPONCE-jumbo.jpg', 'height': 693, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'A Second Arrival for ‘Once’', 'kicker': 'Arts & Leisure', 'content_kicker': None, 'print_headline': 'A Second Arrival For ‘Once’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Milioti, Cristin', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Irglova, Marketa', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Theater Workshop', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hansard, Glen', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kazee, Steve', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-01T16:00:16+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Theater', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac44b101-47c0-57c4-a47f-ea56b71bbfb3', 'word_count': 1664, 'uri': 'nyt://article/ac44b101-47c0-57c4-a47f-ea56b71bbfb3'}, {'abstract': 'The AOL co-founder Steve Case and two former AOL colleagues, Ted Leonsis and Donn Davis, have raised $450 million for a new venture capital fund.', 'web_url': 'https://dealbook.nytimes.com/2011/12/01/steve-case-raises-450-million-venture-fund/', 'snippet': 'The AOL co-founder Steve Case and two former AOL colleagues, Ted Leonsis and Donn Davis, have raised $450 million for a new venture capital fund.', 'lead_paragraph': 'The AOL co-founder Steve Case and two former AOL colleagues, Ted Leonsis and Donn Davis, have raised $450 million for a new venture capital fund. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Steve Case Raises $450 Million Venture Fund', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-01T16:03:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Evelyn M. Rusli', 'person': [{'firstname': 'Evelyn', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0a96ea4c-32fa-574f-8b7b-5e38d92eab0e', 'word_count': 389, 'uri': 'nyt://article/0a96ea4c-32fa-574f-8b7b-5e38d92eab0e'}, {'abstract': 'Action Comics No. 1, which features the first appearance of Superman, sells for more than $2 million.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/12/01/look-up-in-the-sky-its-an-astronomical-price-for-a-comic-book/', 'snippet': 'Action Comics No. 1, which features the first appearance of Superman, sells for more than $2 million.', 'lead_paragraph': 'An auction for a copy of Action Comics No. 1 from 1938 set a record Wednesday night. After 50 bids the closing price was $2,161,000 — the most ever paid for a comic book — to be the owner of the first appearance of Superman. (And that new owner’s identity is currently secret.) The copy of the book was graded at 9.0 on a scale of 1 to 10, a full grade better than a copy of Action Comics No. 1 that sold for $1 million last year. (For a look at other notable debuts, and what they have fetched, click here.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Look! Up in the Sky! It’s an Astronomical Price for a Comic Book!', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Auctions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comic Books and Strips', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Cage, Nicolas', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-01T16:04:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By George Gene Gustines', 'person': [{'firstname': 'George', 'middlename': 'Gene', 'lastname': 'Gustines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/73848d24-41d9-5e07-acdd-bf5f0e0b9922', 'word_count': 222, 'uri': 'nyt://article/73848d24-41d9-5e07-acdd-bf5f0e0b9922'}, {'abstract': "An official of the principals' union writes that when training expands in New York City, his members are likely to view the new teacher evaluation system as punitive to teachers and damaging to students, who would be far better off if the money being spent to develop new tests were invested in true classroom instruction.", 'web_url': 'https://www.nytimes.com/schoolbook/2011/12/01/union-leader-foresees-teacher-evaluation-nightmare/', 'snippet': "An official of the principals' union writes that when training expands in New York City, his members are likely to view the new teacher evaluation system as punitive to teachers and damaging to students, who would be far better off if the money be...", 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': "Union Leader Foresees Teacher Evaluation 'Nightmare'", 'kicker': 'SchoolBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-12-01T16:10:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By PETER J. MCNALLY', 'person': [{'firstname': 'Peter', 'middlename': 'J.', 'lastname': 'MCNALLY', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2ca3743c-8772-555b-8ff4-af9bdf31d105', 'word_count': 0, 'uri': 'nyt://article/2ca3743c-8772-555b-8ff4-af9bdf31d105'}, {'abstract': 'Shortly before he died of cancer in January, the designer Charles Nolan made an unexpected request. He wanted his store in the meatpacking district to remain open, no matter what happened to his label.', 'web_url': 'https://runway.blogs.nytimes.com/2011/12/01/an-unexpected-request/', 'snippet': 'Shortly before he died of cancer in January, the designer Charles Nolan made an unexpected request. He wanted his store in the meatpacking district to remain open, no matter what happened to his label.', 'lead_paragraph': 'Shortly before he died of cancer in January, the designer Charles Nolan made an unexpected request. He wanted his store in the meatpacking district to remain open, no matter what happened to his label.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Unexpected Request', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nolan, Charles', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-01T16:22:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Eric Wilson