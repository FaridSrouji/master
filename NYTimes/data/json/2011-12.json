dustrial — has been exceptionally solid. ', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/business/Specialty/Specialty-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/21/business/Specialty/Specialty-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/business/Specialty/Specialty-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/21/business/Specialty/Specialty-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/21/business/Specialty/Specialty-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Specialty REITs, Exploiting Niche Categories, Outperform the Mainstream Players', 'kicker': 'Square Feet', 'content_kicker': None, 'print_headline': 'Specialty REITs, Exploiting Niche Categories, Outperform the Mainstream Players', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate Investment Trusts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate (Commercial)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Neuberger Berman LLC', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-20T22:04:38+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Real Estate', 'subsection_name': 'Commercial Real Estate', 'byline': {'original': 'By Alison Gregor', 'person': [{'firs