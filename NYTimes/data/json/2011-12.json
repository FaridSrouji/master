major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 15, 'major': 'N'}], 'pub_date': '2011-12-31T22:20:28+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1890b4a3-3588-5bba-83ed-c2882c107c41', 'word_count': 406, 'uri': 'nyt://article/1890b4a3-3588-5bba-83ed-c2882c107c41'}, {'abstract': 'The tiny village of Babanakayama, Japan, had plans to build a road to resettle on higher ground, but opposition has sidelined the project.', 'web_url': 'https://www.nytimes.com/2012/01/01/world/asia/in-babanakayama-japan-road-to-future-leads-nowhere.html', 'snippet': 'The tiny village of Babanakayama, Japan, had plans to build a road to resettle on higher ground, but opposition has sidelined the project.', 'lead_paragraph': 'BABANAKAYAMA, Japan — Freshly carved out of the side of a hill, with layers of rock still exposed along some of its stretches and trees lying nearby, the construction project that was supposed to help this fishing village relocate and rebuild after the earthquake and tsunami in March was optimistically named the Road to the Future. ', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/world/ROAD/ROAD-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/01/01/world/ROAD/ROAD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/01/world/ROAD/ROAD-jumbo.jpg', 'height': 683, 'widt