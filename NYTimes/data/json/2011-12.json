name': 'subject', 'value': 'Reform and Reorganization', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-11T22:25:56+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/2e30388f-a03d-5ecb-82a1-d36773e20319', 'word_count': 663, 'uri': 'nyt://article/2e30388f-a03d-5ecb-82a1-d36773e20319'}, {'abstract': 'Peter Serkin’s interpretive style is so thoughtful and distinctive that disparate works seem to have similarities in his hands.', 'web_url': 'https://www.nytimes.com/2011/12/12/arts/music/peter-serkin-at-92nd-street-y-review.html', 'snippet': 'Peter Serkin’s interpretive style is so thoughtful and distinctive that disparate works seem to have similarities in his hands.', 'lead_paragraph': 'You might not expect works by Stefan Wolpe, Toru Takemitsu and Charles Wuorinen to share much common ground with Beethoven’s “Diabelli” Variations, and few pianists would be able to persuade you that they do. But then few pianists would assemble a program that would even raise the question.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/12/arts/sub-serkin/sub-serkin-jumbo.jpg', 'height': 1024, 'width': 737, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Fluid States of Tension to Celebrate Connections', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'Fluid States Of Tension To Celebrate Connections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Serkin, Peter', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-12-11T22:25:57+0000', 'document_type': 'article', 'news_desk':