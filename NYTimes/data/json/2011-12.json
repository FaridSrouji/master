'major': 'N'}, {'name': 'subject', 'value': 'Emmy Awards', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Screen Actors Guild', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'AMERICAN MUSIC AWARDS', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Golden Globes (Awards)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-30T20:22:47+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/2f22cfe5-14bd-554f-85d3-debb7b56171d', 'word_count': 0, 'uri': 'nyt://slideshow/2f22cfe5-14bd-554f-85d3-debb7b56171d'}, {'abstract': 'The Australian comedian Chris Lilley’s latest show, “Angry Boys,” will have its premiere on HBO on Sunday.', 'web_url': 'https://www.nytimes.com/2011/12/31/arts/television/chris-lilley-stars-in-angry-boys-on-hbo-review.html', 'snippet': 'The Australian comedian Chris Lilley’s latest show, “Angry Boys,” will have its premiere on HBO on Sunday.', 'lead_paragraph': 'HBO has had a crush on the Australian comedian and television auteur Chris Lilley for a while now. It showed his mini-series “Summer Heights High” in 2008 and publicly expressed a desire to work with him directly. Well, mission accomplished: HBO is a producer, along with the Australian Broadcasting Corporation, of Mr. Lilley’s latest project, the 12-episode “Angry Boys.” And as they say, be careful what you wish for.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/31/arts/ANGRY/ANGRY-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/31/arts/ANGRY/ANGRY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit