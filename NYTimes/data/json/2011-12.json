-obit/old-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/05/us/old-obit/old-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Lloyd J. Old, Champion of Using Cells to Fight Cancer, Dies at 78', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lloyd J. Old, 78, Champion Of Using Cells to Fight Illness', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Memorial Sloan-Kettering Cancer Center', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cancer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immune System', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Cancer Research Institute', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Vaccination and Immunization', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-05T02:13:45+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Health', 'subsection_name': 'Research', 'byline': {'original': 'By Paul Vitello', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Vitello', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/d7ac74fd-e629-50ec-b7a5-de619e2918f1', 'word_count': 947, 'uri': 'nyt://article/d7ac74fd-e629-50ec-b7a5-de619e2918f1'}, {'abstract': 'Newt Gingrich’s dissertation is filled with wonkery, lacking human detail, rather than racism.', 'web_url': 'https://www.nytimes.com/2011/12/05/opinion/what-gingrich-didnt-learn-in-congo.html', 'snippet': 'Newt Gingrich’s dissertation is filled with wonkery, lacking human detail, rather than racism.', 'lead_paragraph': 'San Francisco', 'print_section