://article/54593fcb-1801-5e65-b7e3-652616c5b683'}, {'abstract': 'Boxers who won in the Olympic Trials but did not place high enough at the world championships to qualify for the London Games, must win another tournament to advance to a final Olympic qualifier.', 'web_url': 'https://www.nytimes.com/2011/12/14/sports/olympics/in-boxing-not-all-olympic-trial-winners-are-guaranteed-to-become-an-olympian.html', 'snippet': 'Boxers who won in the Olympic Trials but did not place high enough at the world championships to qualify for the London Games, must win another tournament to advance to a final Olympic qualifier.', 'lead_paragraph': 'Ever since Jose Ramirez started boxing, he placed one goal above all others: to represent the United States in the Olympics. To that end, he declined to turn professional, won more than 100 amateur bouts and studied videos of past Olympians like Oscar De La Hoya.', 'print_section': 'B', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/sports/YOLYMPICS2/YOLYMPICS2-jumbo.jpg', 'height': 1024, 'width': 738, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/14/sports/YOLYMPICS2/YOLYMPICS2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/14/sports/YOLYMPICS2/YOLYMPICS2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'In Boxing, Not All Olympic Trial Winners Become Olympians', 'kicker': None, 'content_kicker': None, 'print_headline': 'Some Fighters Are Finding Another Bout, Not Olympic Bid, Follows Olympic Trials', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'De La Hoya, Oscar', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Olymp