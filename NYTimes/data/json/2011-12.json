nk': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'West Bengal (India)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Banerjee, Mamata', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Kolkata (India)', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-12T04:50:02+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Bloomberg News', 'person': [{'firstname': 'Bloomberg', 'middlename': None, 'lastname': 'News', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/314f6c45-eca8-55e1-bec9-0a6f3f73f2b0', 'word_count': 220, 'uri': 'nyt://article/314f6c45-eca8-55e1-bec9-0a6f3f73f2b0'}, {'abstract': 'A drug that was sold for decades despite red flags has prompted questions about the cozy relationship between drug makers, doctors and regulators.', 'web_url': 'https://www.nytimes.com/2011/12/12/health/scandal-widens-over-french-weight-loss-drug-mediator.html', 'snippet': 'A drug that was sold for decades despite red flags has prompted questions about the cozy relationship between drug makers, doctors and regulators.', 'lead_paragraph': 'PARIS — In 33 years on pharmacy shelves here, the diabetes drug Mediator was prescribed to an estimated five million French patients, many of them diabetics, many others hoping simply to lose weight. When French authorities ordered the drug off the market in 2009, alerted to possible cardiovascular risks, there were 300,000 active prescriptions.', 'print_section': 'A', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Scandal Over Mediator, a French Weight-Loss Drug, Prompts Calls for Wide Changes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Scandal Over Mediator, a French Weight-Loss Drug, Prompts Calls for Wide Changes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Diabetes', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Weight', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-12-12T04:57:08+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'Health', 'byline': {'original': 'By Scott Sayare', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Sayare', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f0834b0a-16f4-5167-b8e7-305401dda50f', 'word_count': 1222, 'uri': 'nyt://article/f0834b0a-16f4-5167-b8e7-305401dda50f'}, {'abstract': 'Mr. Lowe has made a deal with Simon & Schuster for “Love Life.”', 'web_url': 'https://www.nytimes.com/2011/12/12/books/rob-lowe-lands-another-book-deal.html', 'snippet': 'Mr. Lowe has made a deal with Simon & Schuster for “Love Life.”', 'lead_paragraph': 'One of the unlikely breakout publishing stars of 2011 was the actor Rob Lowe, whose memoir, “Stories I Only Tell My Friends,” spent months on the New York Times best-seller list and was praised by critics for an intelligence and humor that surpassed that of the typical celebrity book. Seven months after that debut, Mr. Lowe has made another book deal, this time with Simon & Schuster, for “Love Life,” a book that will focus on topics including “sex, marriage, money, work, fatherhood and sports, drawing upon Mr. Lowe’s own experiences and observations,” the publisher is to announce on Monday. “The first book proved that Rob Lowe is a great storyteller,” Jonathan Karp, the publisher of Simon & Schuster, said in a statement. “The second book will prove that he can write about anything and continue to captivate readers.” The book is expected to be released in 2013.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rob Lowe Lands Another Book Deal', 'kicker': 'Arts, Briefly', 'content_kicker': None, 'print_headline': 'Rob Lowe Lands Another Book Deal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lowe, Rob', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-12-12T05:01:07+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/f12f15d3-fbad-53e4-b9e1-96a2c44a5ecd', 'word_count': 149, 'uri': 'nyt://article/f12f15d3-fbad-53e4-b9e1-96a2c44a5ecd'}, {'abstract': 'Ben Smith, one of the foremost writers at Politico, is being hired to help the Web site build a new breed of social news organization.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2011/12/12/buzzfeed-adds-politico-writer/', 'snippet': 'Ben Smith, one of the foremost writers at Politico, is being hired to help the Web site build a new breed of social news organization.', 'lead_paragraph': 'BuzzFeed, a site where the editors and algorithms sift the Web in search of viral articles elsewhere, has decided that it needs articles of its own.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'BuzzFeed Adds Politico Writer', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': Non