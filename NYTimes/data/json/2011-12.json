, died. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/05/science/titanic/titanic-articleLarge-v2.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/05/science/titanic/titanic-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/05/science/titanic/titanic-jumbo.jpg', 'height': 764, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/05/science/titanic/titanic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/05/science/titanic/titanic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Plunging Deep (in Pockets) to See Titanic at 100', 'kicker': None, 'content_kicker': None, 'print_headline': 'Plunging Deep (in Pockets) to See Titanic at 100', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cruises', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diving and Divers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shipwrecks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Submarines and Submersibles', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Titanic (Ship)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Deep Ocean Expeditions', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-05T04:28:14+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'byline': {'original': 'By William J. Bro