imedia': [], 'headline': {'main': 'The Supreme Court’s Recusal Problem', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Supreme Court’s Recusal Problem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Supreme Court', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conflicts of Interest', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Judges', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics (Institutional)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Thomas, Clarence', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-01T03:24:55+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/a2a992dd-1409-56b3-922f-8336405650cd', 'word_count': 419, 'uri': 'nyt://article/a2a992dd-1409-56b3-922f-8336405650cd'}, {'abstract': 'Ms. Lewis, the daughter of an unwed Loretta Young and Clark Gable, was 31 before she confronted her mother and learned the truth of her upbringing.', 'web_url': 'https://www.nytimes.com/2011/12/01/arts/television/judy-lewis-secret-daughter-of-hollywood-dies-at-76.html', 'snippet': 'Ms. Lewis, the daughter of an unwed Loretta Young and Clark Gable, was 31 before she confronted her mother and learned the truth of her upbringing.', 'lead_paragraph': 'Her mother was Loretta Young. Her father was Clark Gable.', 'print_section': 'A', 'print_page': '37', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/01/arts/LEWIS-3-obit/LEWIS-3-obit-jumbo.jpg', 'height': 1010, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}