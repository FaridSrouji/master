mbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Everything in Its Right Place', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Everything in Its Right Place', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Asia Society', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sculpture', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sze, Sarah', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-15T23:22:24+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Karen Rosenberg', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5b5bd86e-4b26-503b-8478-38e97fc9c7ab', 'word_count': 851, 'uri': 'nyt://article/5b5bd86e-4b26-503b-8478-38e97fc9c7ab'}, {'abstract': 'Richard Rhodes tells the story of how the movie star Hedy Lamarr teamed up with an avant-garde composer to design a sophisticated weapons system during World War II.', 'web_url': 'https://www.nytimes.com/2011/12/18/books/review/hedys-folly-by-richard-rhodes-book-review.html', 'snippet': 'Richard Rhodes tells the story of how the movie star Hedy Lamarr teamed up with an avant-garde composer to design a sophisticated weapons system during World War II.', 'lead_paragraph': 'On a sweltering Paris evening in June 1926, a 25-year-old pianist and composer from Trenton stepped out onto the stage of the Théâtre des Champs-Élysées, which was crowded with an array of pianos, bass drums, xylophones, electric bells and electric fans (later to be substituted by enormous airplane propellers), as well as a hand-cranked siren. He nodded to the conductor, and the stuffy air in the hall suddenly began pulsing and throbbing, banging and wailing with a loud and persistent mechanical cacophony. Within a few minutes, according to one eyewitness, the concert had degenerated into a shouting match: “Above the mighty noise of the pianos and drums arose catcalls and booing, shrieking and whistling, shouts of ‘thief’ mixed with ‘bravo.’ ” The audience, which included Eliot, Pound, Joyce and Diaghilev, was in an uproar.', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/18/books/review/Adams-cover-SUB/Adams-cover-SUB-jumbo.jpg', 'height': 1024, 'width': 899, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/18/books/review/Adams-cover-SUB/Adams-cover-SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/18/books/review/Adams-cover-SUB/Adams-cover-SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Hedy Lamarr’s World War II Adventure', 'kicker': None, 'content_kicker': None, 'print_headline': 'Brainy Beauty', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rhodes, Richard', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Lamarr, Hedy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ANTHEIL, GEORGE', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Inventions and Patents', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-12-15T23:22:38+0000', 'document_type': 'article', 'news_desk': 'BookReview', 's