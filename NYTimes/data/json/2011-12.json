rk Times', 'multimedia': [], 'headline': {'main': 'Pentagon Finds No Fault in Ties to TV Analysts', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pentagon Finds No Fault In Ties to TV Analysts', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Conflicts of Interest', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Rumsfeld, Donald H', 'rank': 8, 'major': 'N'}], 'pub_date': '2011-12-24T17:47:19+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By David Barstow', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Barstow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45e3b909-8753-5701-8f11-2ac6587435b7', 'word_count': 954, 'uri': 'nyt://article/45e3b909-8753-5701-8f11-2ac6587435b7'}, {'abstract': 'This year, Ms. Fixit stays at home.', 'web_url': 'https://newoldage.blogs.nytimes.com/2011/12/24/for-the-parents-this-year-simple-pleasures/', 'snippet': 'This year, Ms. Fixit stays at home.', 'lead_paragraph': 'Like a lot of dutiful adult sons and daughters, my friend Margaret braved the airport this week. She and her family are spending Christmas with her elderly parents in South Carolina.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For the Parents, Simple Pleasures', 'kicker': 'The New Old Age'