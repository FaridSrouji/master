tchens3-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/12/17/arts/17hitchens3/17hitchens3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/17/arts/17hitchens3/17hitchens3-jumbo.jpg', 'height': 1024, 'width': 855, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/12/17/arts/17hitchens3/17hitchens3-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/12/17/arts/17hitchens3/17hitchens3-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Christopher Hitchens, Polemicist Who Slashed All, Freely, Dies at 62', 'kicker': None, 'content_kicker': None, 'print_headline': 'Polemicist Who Slashed All, Freely, With Wit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hitchens, Christopher', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Vanity Fair', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-12-16T05:44:25+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By William Grimes', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Grimes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/fc6ecd7b-aabc-58bb-81df-19292b8cb040', 'word_count': 2055, 'uri': 'nyt://article/fc6ecd7b-aabc-58bb-81df-19292b8cb040'}, {'abstract': 'Does the Socratic method stil