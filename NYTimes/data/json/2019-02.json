5f80-de0c-4d47-82b2-5d7d92d2b1b3-jumbo.jpg', 'height': 634, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/sports/22amateur-sub/merlin_150976443_465c5f80-de0c-4d47-82b2-5d7d92d2b1b3-superJumbo.jpg', 'height': 1269, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/sports/22amateur-sub/22amateur-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/22/sports/22amateur-sub/22amateur-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/sports/22amateur-sub/22amateur-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Should College Athletes Be Paid?', 'kicker': 'Student Opinion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2019-02-26T10:00:01+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Jeremy Engle', 'person': [{'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Engle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b4f7ae71-cb92-518a-9a61-8a0bd73d70f2', 'word_count': 881, 'uri': 'nyt://article/b4f7ae71-cb92-518a-9a61-8a0bd73d70f2'}, {'abstract': 'The magazine’s Ethicist columnist on what to do if you suspect racial bias in hiring and compensation.', 'web_url': 'https://www.nytimes.com/2019/02/26/magazine/i-think-my-former-employer-is-underpaying-a-black-employee-should-i-tell-her.html', 'snippet': 'The magazine’s Ethicist columnist on what to do if you suspect racial bias in hiring and compensation.', 'lead_paragraph': 'I worked in human resources at a national nonprofit organization with more than 100 employees. In the summer, we hired two people for the same position. They had similar educational and work experience. One of the employees is a black woman living in a large city in Florida, and the other is a white woman living in a small city in the Midwest. When the employee in the Midwest was offered the position, the hiring manager did not consult the human-resources department and offered her a salary above the typical range. The employee in Florida was hired just a few days later and was offered a salary several thousands of dollars below what the Midwestern employee makes. The cost of living is significantly less in the part of the Midwest where the white employee lives, making the wage difference illogical. I am also furious that the nonprofit is paying a woman of color significantly less than a white woman, simply because of organizational politics.', 'print_section': 'MM', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/07/magazine/03mag-ethicist-image1/03mag-ethicist-image1-articleLarge-v16.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/10/07/magazine/03mag-ethicist-image1/03mag-ethicist-image1-articleLarge-v16.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/07/magazine/03mag-ethicist-image1/03mag-ethicist-image1-jumbo-v16.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/07/magazine/03mag-ethicist-image1/03mag-ethicist-image1-superJumbo-v16.jpg', 'height': 1535, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/07/magazine/03mag-ethicist-image1/03mag-ethicist-image1-thumbStandard-v17.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/10/07/magazine/03mag-ethicist-image1/03mag-ethicist-image1-thumbStandard-v17.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/07/magazine/03mag-ethicist-image1/03mag-ethicist-image1-thumbLarge-v17.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I Think My Former Employer Is Underpaying a Black Employee. Should I Tell Her?', 'kicker': 'The Ethicist ', 'content_kicker': None, 'print_headline': 'I Think My Former Employer Is Underpaying a Black Employee. Should I Tell Her?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ethics (Personal)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Environment', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-02-26T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Kwame Anthony Appiah', 'person': [{'firstname': 'Kwame', 'middlename': 'Anthony', 'lastname': 'Appiah', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/16da8034-d4e2-5c12-adef-61ddc1cc8b42', 'word_count': 1395, 'uri': 'nyt://article/16da8034-d4e2-5c12-adef-61ddc1cc8b42'}, {'abstract': 'A prepper magazine that will make you appreciate what you have.', 'web_url': 'https://www.nytimes.com/2019/02/26/magazine/letter-of-recommendation-offgrids-what-if.html', 'snippet': 'A prepper magazine that will make you appreciate what you have.', 'lead_paragraph': 'I was at the airport, killing time in a Hudson News with a luxury-travel-magazine feature about Cara Delevingne’s favorite private island, when another magazine caught my eye. In bold type, a cover line blared: “What if Your Ocean Liner Is Hijacked?” This event seemed about as likely to happen to me as a visit to Cara Delevingne’s favorite private island, so I purchased both. As I waited to board, I started flipping through the second magazine, Recoil Offgrid. It’s a sister publication to Recoil, the “firearm lifestyle” magazine, but geared toward the more apocalypse-minded. Whereas most prepper culture skews rural, Offgrid welcomes those who live on the grid — and are utterly terrified about what would happen if the grid turned off.', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-LOR-1/0303Mag-LOR-1-articleLarge.jpg', 'height': 441, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/22/magazine/0303Mag-LOR-1/0303Mag-LOR-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 441}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-LOR-1/0303Mag-LOR-1-jumbo.jpg', 'height': 753, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-LOR-1/0303Mag-LOR-1-superJumbo.jpg', 'height': 1506, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-LOR-1/0303Mag-LOR-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/22/magazine/0303Mag-LOR-1/0303Mag-LOR-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-LOR-1/0303Mag-LOR-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Letter of Recommendation: Offgrid’s ‘What If?’', 'kicker': 'Letter of Recommendation', 'content_kicker': None, 'print_headline': 'Recoil Offgrid', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Magazines', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Doomsday', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-02-26T10:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': "By Maureen O'Connor", 'person': [{'firstname': 'Maureen', 'middlename': None, 'lastname': "O'Connor", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/442e043b-0882-5626-845d-2beaa28ec8af', 'word_count': 896, 'uri': 'nyt://article/442e043b-0882-5626-845d-2beaa28ec8af'}, {'abstract': 'This week’s North Korea meeting is just the latest challenge in a larger balancing act for the secretary of state.', 'web_url': 'https://www.nytimes.com/2019/02/26/magazine/mike-pompeo-translates-trump.html', 'snippet': 'This week’s North Korea meeting is just the latest challenge in a larger balancing act for the secretary of state.', 'lead_paragraph': 'One of the first problems that Mike Pompeo solved for Donald Trump was the President’s Daily Brief. On every morning (or at least some of them), the president has traditionally received the most crucial findings of the United States spying apparatus, personally delivered in a solemn face-to-face exchange with a senior intelligence official. Beginning in late 2016, a series of anonymously sourced reports claimed that Trump was not taking the brief with sufficient frequency, or seriousness, or focus, or preparation. Even after the inauguration, there were claims that the spies did not trust him and were holding the good stuff back; there were claims that Trump did not even believe in objective reality. In the middle of it was Pompeo, Trump’s new C.I.A. director, who some in the president’s circle felt was the man best suited to educate Trump about the complexities of foreign policy. The president “has a steep learning curve, but you’ve got to get him up it quickly,” Stephen K. Bannon, Trump’s former senior adviser, says he told Pompeo.', 'print_section': 'MM', 'print_page': '42', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/03/03/magazine/03mag-Pompeo-image1/03mag-Pompeo-image1-articleLarge-v3.jpg', 'height': 429, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/03/03/magazine/03mag-Pompeo-image1/03mag-Pompeo-image1-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight