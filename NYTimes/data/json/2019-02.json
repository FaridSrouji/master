mages/2019/02/25/lens/25Chen1/25Chen1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Young People Left Behind in China’s Snowbound Rust Belt', 'kicker': 'lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Chen, Ronghui', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Snow and Snowstorms', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-02-26T09:00:01+0000', 'document_type': 'article', 'news_desk': 'Photo', 'section_name': 'Lens', 'byline': {'original': 'By Ronghui Chen and Tiffany May', 'person': [{'firstname': 'Ronghui', 'middlename': None, 'lastname': 'Chen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Tiffany', 'middlename': None, 'lastname': 'May', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/81333b14-e151-5044-9b11-452b69bd631b', 'word_count': 826, 'uri': 'nyt://article/81333b14-e151-5044-9b11-452b69bd631b'}, {'abstract': 'Leave your head out of it. Lead with a shoulder and aim low.', 'web_url': 'https://www.nytimes.com/2019/02/26/magazine/how-to-tackle-someone.html', 'snippet': 'Leave your head out of it. Lead with a shoulder and aim low.', 'lead_paragraph': '“If you were trapped in a room and you had to break down the door to get out, you wouldn’t hit that door with your head,” says Rex Norris, who runs football for Atavus, a Seattle-based tackling consultancy that has worked with youth, high school, college and professional teams on shoulder-led tackling. After more than a decade of crisis and controversy over concussions and chronic traumatic encephalopathy, or C.T.E., American football organizations are looking to other sports like rugby and wrestling for alternative, lower-risk sacking methods. Never go into a tackle intending to hit with your head. “Keep your head and neck out of the equation,” Norris says. Last year, even the National Football League began penalizing players for helmet-led contact.', 'print_section': 'MM', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-Tip-1/0303Mag-Tip-1-articleLarge.jpg', 'height': 632, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/22/magazine/0303Mag-Tip-1/0303Mag-Tip-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 632}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-Tip-1/0303Mag-Tip-1-jumbo.jpg', 'height': 1024, 'width': 973, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-Tip-1/0303Mag-Tip-1-superJumbo.jpg', 'height': 2048, 'width': 1946, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-Tip-1/0303Mag-Tip-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/22/magazine/0303Mag-Tip-1/0303Mag-Tip-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/22/magazine/0303Mag-Tip-1/0303Mag-Tip-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', '