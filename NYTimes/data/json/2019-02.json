rge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/08/arts/08high-flying-2/merlin_150225105_7efa875a-549b-4ef4-b06a-1e0b5400902a-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/08/arts/08high-flying-2/merlin_150225105_7efa875a-549b-4ef4-b06a-1e0b5400902a-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/08/arts/08high-flying-2/08high-flying-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/08/arts/08high-flying-2/08high-flying-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/08/arts/08high-flying-2/08high-flying-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘High Flying Bird’ Is Rich With Historical References. Here’s a Closer Look.', 'kicker': None, 'content_kicker': None, 'print_headline': '‘High Flying Bird’ Has the Game’s Number', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Soderbergh, Steven', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Basketball Assn', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'High Flying Bird (Movie)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-02-12T21:34:34+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Jason Bailey', 'person': [{'firstname': 'Jason', 'middlename': None, 'lastname': 'Bailey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3518ed88-8db1-52ac-8f42-48bec405cd03', 'word_count': 1228, 'uri': 'nyt://article/3518ed88-8db1-52ac-8f42-48bec405cd03'}, {'abstract': 'Edward Orloff represents a roster of buzzy writers, but he also builds bookshelves for some of New York’s biggest literary stars.', 'web_url': 'https://www.nytimes.com/2019/02/12/t-magazine/edward-orloff-books-rift-cabinetry.html', 'snippet': 'Edward Orloff represents a roster of buzzy writers, but he also builds bookshelves for some of New York’s biggest literary stars.', 'lead_paragraph': 'A few years ago, the writer Ron Chernow, in need of shelving for his New York City apartment, searched online for “Brooklyn bookcases” and stumbled on a website belonging to a woodworker named Edward Orloff. Chernow emailed Orloff, who had a pretty good idea that his new client was the Ron Chernow, winner of many prestigious prizes and author of the Alexander Hamilton biography that inspired Lin-Manuel Miranda’s blockbuster musical. But Chernow had no idea that his new carpenter was actually first and foremost a book agent — initially at the Wylie Agency, now at McCormick Literary — whose current roster of writers includes up-and-coming talents like Wesley Yang, Mary H.K. Choi and Emily Witt.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/01/11/t-magazine/11tmag-edward-orloff-slide-B9KO/11tmag-edward-orloff-slide-B9