bnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/t-magazine/18tmag-johns-slide-5TPA/18tmag-johns-slide-5TPA-thumbLarge-v7.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jasper Johns, in Images', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Johns, Jasper', 'rank': 2, 'major': 'N'}], 'pub_date': '2019-02-18T10:00:27+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/259922fe-be86-5a21-9bcb-89919a6e4f53', 'word_count': 0, 'uri': 'nyt://slideshow/259922fe-be86-5a21-9bcb-89919a6e4f53'}, {'abstract': 'The artist’s work has managed to speak both to and for the country’s consciousness for the last 60 years — and he’s not done yet.', 'web_url': 'https://www.nytimes.com/2019/02/18/t-magazine/jasper-johns.html', 'snippet': 'The artist’s work has managed to speak both to and for the country’s consciousness for the last 60 years — and he’s not done yet.', 'lead_paragraph': 'JASPER JOHNS LIVES on a sprawling estate in Sharon, Conn., a rural town in the Berkshires with a population of about 2,700 people. The property is stark and hilly, made up of a series of small barnlike structures, one of which houses Johns’s studio. Every detail inside the studio seems intentional, as if each object were a clue about the man himself. There’s the unframed poster, pinned to a wall, of Leonardo da Vinci’s portrait of “Ginevra de’ Benci” (circa 1478), with whom Johns occasionally shares an intense, unsmiling gaze; there are the silver cans that hold his brushes; there is the model of the human skull on a table.', 'print_section': 'M2', 'print_page': '76', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/t-magazine/18tmag-jjpromo/18tmag-jjpromo-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/18/t-magazine/18tmag-jjpromo/18tmag-jjpromo-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/t-magazine/18tmag-jjpromo/18tmag-jjpromo-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/t-magazine/18tmag-jjpromo/18tmag-jjpromo-superJumbo.jpg', 'height': 1000, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/t-magazine/18tmag-jjpromo/18tmag-jjpromo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/18/t-magazine/18tmag-jjpromo/18tmag-jjpromo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/t-magazine/18tmag-jjpromo/18tmag-jjpromo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jasper Johns, American Legend', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Escape Artist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Culture (Arts)', 'rank': 2, 'major': 'N'}, {'name': 