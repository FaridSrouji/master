erlin_150192660_f037eb22-8782-4bcd-8f71-2b986505c1af-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/05/sports/05Ratings2/merlin_150192660_f037eb22-8782-4bcd-8f71-2b986505c1af-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/05/sports/05Ratings2/merlin_150192660_f037eb22-8782-4bcd-8f71-2b986505c1af-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/05/sports/05Ratings2/merlin_150192660_f037eb22-8782-4bcd-8f71-2b986505c1af-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/05/sports/05Ratings2/merlin_150192660_f037eb22-8782-4bcd-8f71-2b986505c1af-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/05/sports/05Ratings2/merlin_150192660_f037eb22-8782-4bcd-8f71-2b986505c1af-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Boring Game Plus New Orleans Rebellion Leads to Ratings Drop', 'kicker': None, 'content_kicker': None, 'print_headline': 'Points Plunge  Off Field, Too:  Ratings Hit  11-Year Low', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ratings (Audience Measurement)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States National Anthem Protests (2016- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'CBS Corporation', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 6, 'major': 'N'}], 'pub_date': '2019-02-04T17:03:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Kevin Draper', 'person': [{'firstname': 'Kevin', 'middlename': None, 'lastname': 'Draper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/361d3809-0301-5e53-a6b8-15ac3123841d', 'word_count': 627, 'uri': 'nyt://article/361d3809-0301-5e53-a6b8-15ac3123841d'}, {'abstract': 'Protecting your skin from the elements no longer means layering on uncomfortably thick salves. A new batch of heavy-duty creams are surprisingly light.', 'web_url': 'https://www.nytimes.com/2019/02/04/t-magazine/winter-skin-cream.html', 'snippet': 'Protecting your skin from the elements no longer means layering on uncomfortably thick salves. A new batch of heavy-duty creams are surprisingly light.', 'lead_paragraph': 'No matter how diligently you pile on moisturizer, dry skin in winter is “almost inevitable,” admits Dr. Sarah Dolder, a clinical instructor of dermatology at Columbia University in New York. It’s hard to overcome the season’s moisture-depleting elements — biting winds, extreme cold and overactive indoor heating systems — all of which can leave skin parched, she explains. But layering on thick creams is not necessarily the answer. “Unless they are formulated to absorb effectively into the skin’s lipid bi-layer,” Dr. Dolder says, “they will sit on the surface and potentially cause clogging of the pores.” This is especially problematic for sensitive and acne-prone skin types. Fortunately, a new batch of rich-but-not-thick moisturizers now delivers ultra-hydrating ingredients — everything from squalane to plant stem cells — with airy textures.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/fashion/04tmag-face/04tmag-face-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/04/t-magazine/fashion/04tmag-face/04tmag-face-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/fashion/04tmag-face/04tmag-face-jumbo.jpg', 'height': 1024, 'width': 820, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/fashion/04tmag-face/04tmag-face-superJumbo.jpg', 'height': 2048, 'width': 1640, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/fashion/04tmag-face/04tmag-face-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/04/t-magazine/fashion/04tmag-face/04tmag-face-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/fashion/04tmag-face/04tmag-face-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Keep Your Skin Moisturized for the Rest of Winter', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Skin', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cosmetics and Toiletries', 'rank': 2, 'major': 'N'}], 'pub_date': '2019-02-04T17:08:06+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kari Molvar', 'person': [{'firstname': 'Kari', 'middlename': None, 'lastname': 'Molvar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1c8e3eab-e656-5392-8bd4-54a3b4244823', 'word_count': 488, 'uri': 'nyt://article/1c8e3eab-e656-5392-8bd4-54a3b4244823'}, {'abstract': 'The newspaper publisher’s board said the $1.3 billion offer “is not in the best interests of Gannett and its shareholders.” But the fight for control is likely to go on.', 'web_url': 'https://www.nytimes.com/2019/02/04/business/media/gannett-media-news.html', 'snippet': 'The newspaper publisher’s board said the $1.3 billion offer “is not in the best interests of Gannett and its shareholders.” But the fight for control is likely to go on.', 'lead_paragraph': 'Gannett, the publisher of USA Today and more than 100 other newspapers across nearly three dozen states, rejected a hostile takeover bid from a hedge fund-backed newspaper group on Monday, kicking off a battle for shareholder votes to determine the future of the company.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/05/business/05GANNETT/05GANNETT-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/05/business/05GANNETT/05GANNETT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/05/business/05GANNETT/05GANNETT-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJum