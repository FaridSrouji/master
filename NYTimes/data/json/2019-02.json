/04/t-magazine/04tmag-sarah-cain-slide-L04I/04tmag-sarah-cain-slide-L04I-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/04/t-magazine/04tmag-sarah-cain-slide-L04I/04tmag-sarah-cain-slide-L04I-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/04tmag-sarah-cain-slide-L04I/04tmag-sarah-cain-slide-L04I-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/04tmag-sarah-cain-slide-L04I/04tmag-sarah-cain-slide-L04I-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/04tmag-sarah-cain-slide-L04I/04tmag-sarah-cain-slide-L04I-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/04/t-magazine/04tmag-sarah-cain-slide-L04I/04tmag-sarah-cain-slide-L04I-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/04/t-magazine/04tmag-sarah-cain-slide-L04I/04tmag-sarah-cain-slide-L04I-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Artist Creating a 150-Foot-Long Glass Rainbow', 'kicker': None, 'content_kicker': None, 'print_headline': 'In The Studio; Her Windows Take Off', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Windows', '