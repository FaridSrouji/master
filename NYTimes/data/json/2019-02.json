tion': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-hermes/15tmag-hermes-articleLarge-v4.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/19/t-magazine/19tmag-hermes/15tmag-hermes-articleLarge-v4.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-hermes/15tmag-hermes-jumbo-v4.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-hermes/15tmag-hermes-superJumbo-v4.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-hermes/15tmag-hermes-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/19/t-magazine/19tmag-hermes/15tmag-hermes-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-hermes/15tmag-hermes-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Making of an Hermès Kelly Bag', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Hermes International SA', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Handbags and Purses', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-02-15T16:05:15+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': 'By Gautier Billotte', 'person': [{'firstname': 'Gautier', 'middlename': None, 'lastname': 'Billotte', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/1859476f-ef01-58f9-a852-789f827f1cfa', 'word_count': 0, 'uri': 'nyt://video/1859476f-ef01-58f9-a852-789f827f1cfa'}, {'abstract': 'The fashion house remains loyal to a way of life more common to Europe’s medieval guilds, dedicating itself to the idea of craftsmanship above all else.', 'web_url': 'https://www.nytimes.com/2019/02/15/t-magazine/hermes.html', 'snippet': 'The fashion house remains loyal to a way of life more common to Europe’s medieval guilds, dedicating itself to the idea of craftsmanship above all else.', 'lead_paragraph': 'IF THERE IS a signifying gesture that contains nearly 200 years of obsession, it is the ballet of the point sellier. This is how it begins: The artisan is young, maybe 35, with a confidence that comes from years on the bench, eyes focused on two small back-to-back precut pieces of leather. She holds in each hand a two-inch needle, threaded with linen fiber that she has dragged through beeswax to render waterproof. Then, wielding the needles like surgical instruments, she pierces the leather, pulling taut the threads to draw the halves together in an unbreakable bond. Whether it’s bleu saphir for the panel of a Birkin or tawny caramel for a harness or juniper suede for the shoulder of a blazer — it would depend on which of the 16 ateliers she works in — the motion, as percussive as the clash of cymbals at the climax of a symphony, has been the same since the leather craftsman Thierry Hermès left Germany for Paris, using just such a stitch to craft harnesses for the gentry at the company he founded in 1837.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/01/t-magazine/oakImage-1549041627377/oakImage-1549041627377-articleLarge.jpg', 'height': 435, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/01/t-magazine/oakImage-1549041627377/oakImage-1549041627377-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 435}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/01/t-magazine/oakImage-1549041627377/oakImage-1549041627377-jumbo.jpg', 'height': 742, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/01/t-magazine/oakImage-1549041627377/oakImage-1549041627377-superJumbo.jpg', 'height': 1333, 'width': 1840, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/01/t-magazine/oakImage-1549041627377/oakImage-1549041627377-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/01/t-magazine/oakImage-1549041627377/oakImage-1549041627377-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/01/t-magazine/oakImage-1549041627377/oakImage-1549041627377-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hermès’s Refusal to Change Is Its Most Radical Gesture Yet', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': '