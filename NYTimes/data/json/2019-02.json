Standard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/07/world/07doctor1/07doctor1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/07/world/07doctor1/07doctor1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'He Performed Surgery in Romania, but Is He a Doctor?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Romania Questions Whether Cosmetic Surgeon Is Even a Doctor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Politi, Matteo (Matthew Mode)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Surgery and Surgeons', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Malpractice', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Italy', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Romania', 'rank': 7, 'major': 'N'}], 'pub_date': '2019-02-06T14:03:54+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Palko Karasz', 'person': [{'firstname': 'Palko', 'middlename': None, 'lastname': 'Karasz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2fc0e153-6f7e-56a8-aff3-416510ece3f5', 'word_count': 871, 'uri': 'nyt://article/2fc0e153-6f7e-56a8-aff3-416510ece3f5'}, {'abstract': 'In his final On Photography column, Teju Cole argues that images of human suffering often implicitly serves the powers that be.', 'web_url': 'https://www.nytimes.com/2019/02/06/magazine/when-the-camera-was-a-weapon-of-imperialism-and-when-it-still-is.html', 'snippet': 'In his final On Photography column, Teju Cole argues that images of human suffering often implicitly serves the powers that be.', 'lead_paragraph': 'I first saw the photograph some years ago, online. Later, I tracked it down to its original source: “In Afric’s Forest and Jungle: Or Six Years Among the Yorubans,” a memoir published in 1899 by the Rev. R.H. Stone. It shows a crowd in what is now Nigeria, but what was then Yorubaland under British colonial influence. The caption below the photograph reads: “A king of Ejayboo. Governor of Lagos on right. For years the rulers of this fierce tribe made the profession of Christianity a capital crime.” This description is familiar in tone from anthropological literature of the period, though the photograph is hard to date precisely. “Ejayboo” is what we would nowadays spell as “Ijebu,” a subgroup of Yoruba. That catches my attention: I am Yoruba and also Ijebu. This picture is a time capsule from a world to which I am connected but had not seen before, a world by colonial encounter.', 'print_section': 'MM', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/10/magazine/10mag-OnPhoto-slide-Q3KN/10mag-OnPhoto-slide-Q3KN-articleLarge.png', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/10/magazine/10mag-OnPhoto-slide-Q3KN/10mag-OnPhoto-slide-Q3KN-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/10/magazine/10mag-OnPhoto-slide-Q3KN/10mag-OnPhoto-slide-Q3KN-jumbo.png', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/10/magazine/10mag-OnPhoto-slide-Q3KN/10mag-OnPhoto-slide-Q3KN-superJumbo.png', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/10/magazine/10mag-OnPhoto-slide-Q3KN/10mag-OnPhoto-slide-Q3KN-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/10/magazine/10mag-OnPhoto-slide-Q3KN/10mag-OnPhoto-slide-Q3KN-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/10/magazine/10mag-OnPhoto-slide-Q3KN/10mag-OnPhoto-slide-Q3KN-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When the Camera Was a Weapon of Imperialism. (And When It Still Is.)', 'kicker': 'On Photography', 'content_kicker': None, 'print_headline': 'Photography has the power to record and reveal the world; but not all things can be recorded or should be revealed.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'ALGERIA', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Lagos (Nigeria)', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-02-06T14:04:46+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Teju Cole', 'person': [{'firstname': 'Teju', 'middlename': None, 'lastname': 'Cole', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a1bd83ff-ccc3-563f-8027-811a5098d2f4', 'w