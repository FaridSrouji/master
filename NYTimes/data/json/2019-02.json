mbo.jpg', 'height': 670, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/21/world/21oz-memorial-1-print/merlin_150244779_1fbe049c-e8ea-474f-8a74-963094849199-superJumbo.jpg', 'height': 1339, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/21/world/21oz-memorial-1-print/00oz-memorial-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/21/world/21oz-memorial-1-print/00oz-memorial-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/21/world/21oz-memorial-1-print/00oz-memorial-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A War Memorial Is Being Expanded. Some Say It Whitewashes History.', 'kicker': None, 'content_kicker': None, 'print_headline': 'A War Memorial Grows, Along With Its Critics', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Monuments and Memorials (Structures)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-02-19T18:00:07+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Australia', 'byline': {'original': 'By Jamie Tarabay', 'person': [{'firstname': 'Jamie', 'middlename': None, 'lastname': 'Tarabay', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/14903abe-d3db-5e3c-a06a-f8c4b1c30eb5', 'word_count': 1233, 'uri': 'nyt://article/14903abe-d3db-5e3c-a06a-f8c4b1c30eb5'}, {'abstract': 'A selection of books published this week; plus, a peek at what our colleagues around the newsroom are reading.', 'web_url': 'https://www.nytimes.com/2019/02/19/books/review/new-this-week.html', 'snippet': 'A selection of books published this week; plus, a peek at what our colleagues around the newsroom are reading.', 'lead_paragraph': 'TELL YOUR CHILDREN By Alex Berenson. (Simon & Schuster, $26.) Berenson, a former New York Times reporter, presents his case against marijuana. With widespread legalization proceeding apace, he wants us to pause and consider the drug’s history of triggering psychotic episodes. COZY By Isabel Gillies. (Harper Wave, $22.99.) For Gillies, coziness is a state of mind, the environments we create in our homes to feel at ease. Think of her as a companion to Marie Kondo, filling up all those spaces once they’ve been decluttered. LAST DAYS AT HOT SLIT By Andrea Dworkin, edited by Johanna Fateman and Amy Scholder. (Semiotext(e), paper, $17.95.) Dworkin became the ultimate symbol of radical feminism for a generation coming of age in the 1970s and ’80s. This collection of her fiction and nonfiction mixes her most controversial writing with autobiography, like “My Suicide,” an essay discovered after her death in 2005. POLITICAL ACTION By Michael Walzer. (New York Review Books, paper, $14.95.) Written during the Nixon administration and drawing on the author’s history in the civil rights and antiwar movements, Walzer’s how-to book for activists, reissued, feels newly relevant. BIRTHDAY By César Aira. (New Directions, paper, $13.95.) Triggered by the Argentine author’s 50th birthday, this is his meditation, in a series of short chapters, on the events that made up his half century of life.', 'print_section': 'BR', 'print_pa