2/08/us/08xp-security/08xp-security-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/08/us/08xp-security/08xp-security-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/08/us/08xp-security/08xp-security-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Florida School Hires 2 Combat Veterans to Take Down Active Shooters', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'School Shootings and Armed Attacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Security and Warning Systems', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Parkland, Fla, Shooting (2018)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Manatee County (Fla)', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Manatee School for the Arts (Palmetto, Fla)', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-02-11T16:16:39+0000', 'document_type': 'article', 'news_desk': 'Express', 'section_name': 'U.S.', 'byline': {'original': 'By Christina Caron', 'person': [{'firstname': 'Christina', 'middlename': None, 'lastname': 'Caron', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76c30d65-437e-5ccb-b036-d6daa317483c', 'word_count': 935, 'uri': 'nyt://article/76c30d65-437e-5ccb-b036-d6daa317483c'}, {'abstract': 'Use the Nacional variety of cocoa powder in a French press, like you’d make coffee.', 'web_url': 'https://www.nytimes.com/2019/02/11/dining/hot-chocolate-ecuador.html', 'snippet': 'Use the Nacional variety of cocoa powder in a French press, like you’d make coffee.', 'lead_paragraph': 'The To’ak brand of rare Ecuadorean chocolate is right up there with luxury items like white truffles and certain caviars. Often aged in bourbon or tequila casks and priced at more than $150 an ounce, it is processed from the heirloom Nacional variety of cacao. Now, those on more modest budgets can sample the chocolate as unsweetened cacao powder, meant for brewing like coffee in a French press for a drink that’s rich, a bit fruity and benefits from a modest splash of milk. You can also add it to your morning coffee or smoothies, or even use it like regular cocoa powder for baking. There are two other options, both sweetened, for making hot chocolate. The Nacional variety was previously thought to be extinct, but it was rediscovered not long ago in a valley in Ecuador. Conservation and high prices, to limit production, have resulted in the gradual restoration of Nacional. ', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner1/13burner1-articleLarge-v2.jpg', 'height': 847, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/13/dining/13burner1/13burner1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 847}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner1/13burner1-jumbo-v2.jpg', 'height': 1024, 'width': 726, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner1/13burner1-superJumbo-v2.jpg', 'height': 2048, 'width': 1452, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner1/13burner1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/13/dining/13burner1/13burner1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner1/13burner1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Brew This Fine Hot Chocolate From Ecuador', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Sip: Hot Chocolate From Ecuador', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Chocolate', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Ecuador', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-02-11T16:24:09+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e61cb44d-bed9-5d1f-bb97-a87848953735', 'word_count': 211, 'uri': 'nyt://article/e61cb44d-bed9-5d1f-bb97-a87848953735'}, {'abstract': 'French cookies by the chef Marie-Aude Rose are available at La Mercerie in SoHo.', 'web_url': 'https://www.nytimes.com/2019/02/11/dining/french-cookies-soho.html', 'snippet': 'French cookies by the chef Marie-Aude Rose are available at La Mercerie in SoHo.', 'lead_paragraph': 'Marie-Aude Rose, the chef at La Mercerie in the Roman and Williams Guild store in SoHo, has started making her sablés, as the French call butter cookies, and other confections to take away.  The delicately burnished cookies — in rounds, oblongs and cut in the shape of birds — are buttery indeed. Oval calissons, the almond flour treats from Aix-en-Provence flavored with orange blossom and candied melon, and nut-rich nougat are also available. All but the nougat are packed in charming wooden baskets; everything is available online.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner3/13burner3-articleLarge-v2.jpg', 'height': 441, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/13/dining/13burner3/13burner3-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 441}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner3/13burner3-jumbo-v2.jpg', 'height': 753, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner3/13burner3-superJumbo-v2.jpg', 'height': 1506, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner3/13burner3-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/13/dining/13burner3/13burner3-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/dining/13burner3/13burner3-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Buttery Sablés in All Shapes', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Nibble: Buttery Sablés In All Shapes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cookies', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'La Mercerie (Manhattan, NY, Restaurant)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'SoHo (Manhattan, NY)', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-02-11T16:26:36+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2d3d3439-8b12-566e-9cc6-3095f8f10897', 'word_count': 131, 'uri': 'nyt://article/2d3d3439-8b12-566e-9cc6-3095f8f10897'}, {'abstract': 'At Charcuterie Masters, an event in Flushing, Queens, there will be more than 60 kinds of charcuterie.', 'web_url': 'https://www.nytimes.com/2019/02/11/dining/charcuterie-queens-new-york.html', 'snippet': 'At Charcuterie Masters, an event in Flushing, Queens, there will be more than 60 kinds of charcuterie.', 'lead_paragraph': 'For the past three years, Charcuterie Masters, an event in Flushing, Queens, has been the ultimate pork showcase in New York. This year, it will be on Feb. 23, and there will be more than 60 kinds of charcuterie, including products that will be sold to take home. Chefs will prepare cured meats, simply sliced and in various preparations, for tasting; there will also be competitions (both professional and people’s choice), and butchery and slicing demonstrations. 