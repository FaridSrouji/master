, 'legacy': {'xlarge': 'images/2019/02/18/opinion/18stone4/merlin_150543351_417700ee-d9dd-4d67-a24a-e00bd7b9da9e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/opinion/18stone4/merlin_150543351_417700ee-d9dd-4d67-a24a-e00bd7b9da9e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/opinion/18stone4/merlin_150543351_417700ee-d9dd-4d67-a24a-e00bd7b9da9e-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/opinion/18stone4/18stone4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/18/opinion/18stone4/18stone4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/opinion/18stone4/18stone4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Athens in Pieces: In Aristotle’s Garden', 'kicker': 'THE STONE', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gardens and Gardening', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ARISTOTLE', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Athens (Greece)', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-02-18T16:00:03+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Simon Critchley', 'person': [{'firstname': 'Simon', 'middlename': None, 'lastname': 'Critchley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e28ecc4e-85ba-539b-8dd8-22b76e495e94', 'word_count': 1816, 'uri': 'nyt://article/e28ecc4e-85ba-539b-8dd8-22b76e495e94'}, {'abstract': 'Before 1919, the music was considered more novelty than art. Then a military band changed everything.', 'web_url': 'https://www.nytimes.com/2019/02/18/opinion/the-year-jazz-came-into-its-own.html', 'snippet': 'Before 1919, the music was considered more novelty than art. Then a military band changed everything.', 'lead_paragraph': 'The Armistice to end World War I brought elation and a sense of relief to millions of Americans, but also a jolt of reality. The country had only been in the conflict for 19 months, but it had already adjusted to the rhythms and strictures of a society on a total-war footing. When it ended so abruptly, the result was a sudden permissiveness in the culture, a weakening of social rules and an opening for new ideas, creating a fertile atmosphere for America’s new, unruly musical child: jazz. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/opinion/18sagerWeb/18sagerWeb-articleLarge.jpg', 'height': 767, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/18/opinion/18sagerWeb/18sagerWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 767}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/opinion/18sagerWeb/18sagerWeb-jumbo.jpg', 'height': 1024, 'width': 801, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/18/opinio