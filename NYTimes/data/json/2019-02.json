'name': 'persons', 'value': 'Moultrie, Olivia', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'NIKE Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "National Women's Soccer League", 'rank': 4, 'major': 'N'}], 'pub_date': '2019-02-25T21:36:11+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Andrew Keh', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Keh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4566d4ba-4abb-516c-8da8-976ca0c51869', 'word_count': 934, 'uri': 'nyt://article/4566d4ba-4abb-516c-8da8-976ca0c51869'}, {'abstract': 'Two producers of “L.A.’s Finest” were hurt on the job last week, after a CBS subsidiary was cited over a “MacGyver” accident and the widow of a stunt double sued.', 'web_url': 'https://www.nytimes.com/2019/02/25/arts/television/stunt-accidents-penalty-safety.html', 'snippet': 'Two producers of “L.A.’s Finest” were hurt on the job last week, after a CBS subsidiary was cited over a “MacGyver” accident and the widow of a stunt double sued.', 'lead_paragraph': 'A stunt that went wrong on the set of the TV show “L.A.’s Finest” last week, leaving two producers injured, is the latest in a string of incidents that have drawn renewed attention to the dangers of stunt work. It came just days after the Occupational Safety and Health Administration cited a subsidiary of CBS for a stunt-related injury, and after a lawsuit was filed by the widow of a man who worked as a stunt double.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/26/arts/26stunt-item/26stunt-item-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/26/arts/26stunt-item/26stunt-item-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/26/arts/26stunt-item/26stunt-item-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/26/arts/26stunt-item/26stunt-item-superJumbo.jpg', 'height': 957, 'width': 1436, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/26/arts/26stunt-item/26stunt-item-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/26/arts/26stunt-item/26stunt-item-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/26/arts/26stunt-item/26stunt-item-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Accident and a Penalty Renew Attention to Stunt Safety', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Accidents and Safety', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stunts and Stuntmen', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Hazards and Violations', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': "L.A.'s Finest (TV Program)", 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'MacGyver (TV Program)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Sony Pictures Television', 'rank': 7, 'major': 'N'}, {'name'