/dining/27off2/merlin_151189923_8c196b54-b2a4-43f2-b2f3-b9e79eac0f85-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/27/dining/27off2/merlin_151189923_8c196b54-b2a4-43f2-b2f3-b9e79eac0f85-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/27/dining/27off2/merlin_151189923_8c196b54-b2a4-43f2-b2f3-b9e79eac0f85-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/27/dining/27off2/merlin_151189923_8c196b54-b2a4-43f2-b2f3-b9e79eac0f85-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/27/dining/27off2/27off2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/27/dining/27off2/27off2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/27/dining/27off2/27off2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Murray’s Opens a Mac-and-Cheese Restaurant in the West Village', 'kicker': 'Off the menu', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "Murray's Cheese Bar (Manhattan, NY, Restaurant)", 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'M Wells Steakhouse (Queens, NY, Restaurant)', 'r