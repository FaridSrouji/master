'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Toy Story 4 (Movie)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Us (Movie)', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Wonder Park (Movie)', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Scary Stories to Tell in the Dark (Movie)', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-02-04T16:57:23+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Bruce Fretts', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Fretts', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2ed3cd58-2040-5834-b22b-589e1e298857', 'word_count': 630, 'uri': 'nyt://article/2ed3cd58-2040-5834-b22b-589e1e298857'}, {'abstract': 'Visit the Brooklyn Museum for an exhibit about the artist and a meal from a rotating roster of New York chefs.', 'web_url': 'https://www.nytimes.com/2019/02/04/dining/frida-kahlo-brooklyn-museum-restaurant.html', 'snippet': 'Visit the Brooklyn Museum for an exhibit about the artist and a meal from a rotating roster of New York chefs.', 'lead_paragraph': 'Alongside the Brooklyn Museum’s exhibit “Frida Kahlo: Appearances Can Be Deceiving” which runs from Feb. 8 through May 12, there will be an elaborate Mexican menu with some specialties devised by consulting guest chefs at the museum’s restaurant, the Norm.  The chef Saul Bolton and Great Performances (a catering and restaurant managing company), who run the restaurant, have invited the chef Sue Torres to kick off the round of special menus with dishes like shrimp flautas, sweet plantain gorditas cakes and pan-roasted marinated red snapper. Following Ms. Torres, the participating chefs will be Carlos and Felipe Arellano of Chela in Park Slope, Justin Bazdarich of Oxomoco in Greenpoint, TJ Steele of Claro in Gowanus and Natalia Mendez of La Morada in Mott Haven, in the Bronx.  Each chef will contribute two to three new dishes to the menu.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/06/dining/06burner8/merlin_150182283_c1206908-9948-4013-ba08-989b389e920e-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/06/dining/06burner8/merlin_150182283_c1206908-9948-4013-ba08-989b389e920e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/06/dining/06burner8/merlin_150182283_c1206908-9948-4013-ba08-989b389e920e-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/06/dining/06burner8/merlin_150182283_c1206908-9948-4013-ba08-989b389e920e-superJumbo.jpg', 'height': 1368, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/06/dining/06burner8/merlin_150182283_c1206908-9948-4013-ba08-989b389e920e-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/06/dining/06burner8/merlin_150182283_c1206908-9948-4013-ba08-989b389e920e-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/06/dining/06burner8/merlin_150182283_c1206908-9948-4013-ba08-989b389e920e-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'he