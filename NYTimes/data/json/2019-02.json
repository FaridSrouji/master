dit': None, 'type': 'image', 'url': 'images/2019/02/28/opinion/28Kronick/28Kronick-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Backup Plan Is Needed to Prevent Venezuelan Famine', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Lima Group', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hussein, Saddam', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Maduro, Nicolas', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Venezuela', 'rank': 5, 'major': 'N'}], 'pub_date': '2019-02-28T11:00:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Dorothy Kronick', 'person': [{'firstname': 'Dorothy', 'middlename': None, 'lastname': 'Kronick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0b1fc9bb-706c-54fd-bd6f-7110f3f38dad', 'word_count': 1010, 'uri': 'nyt://article/0b1fc9bb-706c-54fd-bd6f-7110f3f38dad'}, {'abstract': 'The U.S. is overdue to establish an institute devoted to research on the top cause of poor health.', 'web_url': 'https://www.nytimes.com/2019/02/28/opinion/nutrition-health.html', 'snippet': 'The U.S. is overdue to establish an institute devoted to research on the top cause of poor health.', 'lead_paragraph': 'Poor nutrition is a leading cause of poor health and spiraling health care spending. Research from the Tufts Friedman School suggests that poor eating causes nearly 1,000 deaths each day in the United States from heart disease, stroke or diabetes. In 2016, the direct and indirect costs of chronic diseases as a result of obesity were $1.72 trillion — almost 10 percent of the nation’s gross domestic product. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/28/opinion/28yun/28yun-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/28/opinion/28yun/28yun-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/28/opinion/28yun/28yun-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/28/opinion/28yun/28yun-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/28/opinion/28yun/28yun-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/28/opinion/28yun/28yun-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/28/opinion/28yun/28yun-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'We Need Better Answers on Nutrition', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Obesity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Weight', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value'