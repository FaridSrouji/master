ype': 'image', 'url': 'images/2019/02/13/sports/13bestinshow-hp-promo/13bestinshow-hp-promo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/13/sports/13bestinshow-hp-promo/13bestinshow-hp-promo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/sports/13bestinshow-hp-promo/13bestinshow-hp-promo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Westminster Dog Show: King Continues Reign of Terriers', 'kicker': None, 'content_kicker': None, 'print_headline': 'Growls (by Fans) as Wire Fox Terrier Wins Top Prize for Record 15th Time', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Westminster Kennel Club Dog Show', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dogs', 'rank': 2, 'major': 'N'}], 'pub_date': '2019-02-13T03:59:43+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Kelly Whiteside', 'person': [{'firstname': 'Kelly', 'middlename': None, 'lastname': 'Whiteside', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcca7801-eef6-5f3f-ab5a-70734fa1aea5', 'word_count': 577, 'uri': 'nyt://article/bcca7801-eef6-5f3f-ab5a-70734fa1aea5'}, {'abstract': 'Their agenda still needs to be tax-and-spend, not just spend.', 'web_url': 'https://www.nytimes.com/2019/02/12/opinion/how-much-does-heterodoxy-help-progressives-wonkish.html', 'snippet': 'Their agenda still needs to be tax-and-spend, not just spend.', 'lead_paragraph': 'The center-left is feeling ambitious these days, and it’s a heartening thing to see. Anything can happen politically, but it looks at least possible that in 2021 there won’t just be unified Democratic control of Congress and the White House, but control by a much more consistently progressive party than was the case in 2009. Maybe America can finally get truly universal health care, policies that really tackle inequality, and more.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/opinion/130219krugman2/130219krugman2-articleLarge.png', 'height': 339, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/13/opinion/130219krugman2/130219krugman2-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 339}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/opinion/130219krugman2/130219krugman2-jumbo.png', 'height': 523, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/opinion/130219krugman2/130219krugman2-superJumbo.png', 'height': 523, 'width': 925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/opinion/130219krugman2/130219krugman2-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/13/opinion/130219krugman2/130219krugman2-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/13/opinion/130219krugman2/130219krugman2-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Much Does Heterodoxy Help Progressives? (Wonkish)', 'kicker': None, 'co