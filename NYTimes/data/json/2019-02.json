, 'print_page': '64', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-ceglic-slide-UDLQ/19tmag-ceglic-slide-UDLQ-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/19/t-magazine/19tmag-ceglic-slide-UDLQ/19tmag-ceglic-slide-UDLQ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-ceglic-slide-UDLQ/19tmag-ceglic-slide-UDLQ-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-ceglic-slide-UDLQ/19tmag-ceglic-slide-UDLQ-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-ceglic-slide-UDLQ/19tmag-ceglic-slide-UDLQ-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/02/19/t-magazine/19tmag-ceglic-slide-UDLQ/19tmag-ceglic-slide-UDLQ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/19/t-magazine/19tmag-ceglic-slide-UDLQ/19tmag-ceglic-slide-UDLQ-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Man Who Designed Dean & Deluca, and the Look of Modern Kitchens', 'kicker': 'Home and Work', 'content_kicker': None, 'print_headline': 'Cleaning Up', 'name': None, 'seo': None, 'sub': 