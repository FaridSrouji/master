ame': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Stephen Castle', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Castle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/809fe017-cf4a-56d7-98e0-24da2061446e', 'word_count': 927, 'uri': 'nyt://article/809fe017-cf4a-56d7-98e0-24da2061446e'}, {'abstract': 'In Nigeria and around the world, Ms. Silva worked to bring wide recognition to African artists and to nurture their careers.', 'web_url': 'https://www.nytimes.com/2019/02/25/obituaries/bisi-silva-dead.html', 'snippet': 'In Nigeria and around the world, Ms. Silva worked to bring wide recognition to African artists and to nurture their careers.', 'lead_paragraph': 'Bisi Silva, an adventurous curator who, with her own money, founded a nonprofit art gallery and education center in Lagos, Nigeria’s largest city, that has nurtured the growth and recognition of contemporary African artists, died on Feb. 12 in a hospital there. She was 56.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/26/obituaries/23SILVA1/merlin_150851676_c9540243-e4c7-4841-8ded-5b65090d46e8-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/02/26/obituaries/23SILVA1/merlin_150851676_c9540243-e4c7-4841-8ded-5b65090d46e8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/02/26/obituaries/23SILVA1/merlin_150851676_c9540243-e4c7-4841-8ded-5b65090d46e8-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, '