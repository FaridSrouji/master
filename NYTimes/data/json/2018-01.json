_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Roger Cohen', 'person': [{'firstname': 'Roger', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/b184f8d8-0c79-5d20-a195-397ee5d7526f', 'word_count': 1558, 'uri': 'nyt://article/b184f8d8-0c79-5d20-a195-397ee5d7526f'}, {'abstract': 'Our president is an authoritarian in his Twitter feed and nowhere else.', 'web_url': 'https://www.nytimes.com/2018/01/20/opinion/sunday/trump-so-far-is-more-farce-than-tragedy.html', 'snippet': 'Our president is an authoritarian in his Twitter feed and nowhere else.', 'lead_paragraph': 'Like any strange and quarrelsome sect, the church of anti-Trump conservatism has divided and subdivided since Donald Trump’s election. Some members have apostatized and joined the ranks of Trumpists; others have marched leftward, with anti-Trumpism as a gateway drug to wokeness. There is a faction that is notionally skeptical of Trump but functionally anti-anti-Trump, a faction that insists it’s just calling “balls and strikes” and a faction screaming that the president rigged the game and needs to be thrown out.', 'print_section': 'SR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/opinion/sunday/21Douthat/merlin_131863809_ab0f9e40-6dda-4b57-850d-a8de5a094d7d-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/21/opinion/sunday/21Douthat/merlin_131863809_ab0f9e40-6dda-4b57-850d-a8de5a094d7d-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/opinion/sunday/21Douthat/merlin_131863809_ab0f9e40-6dda-4b57-850d-a8de5a094d7d-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/opinion/sunday/21Douthat/merlin_131863809_ab0f9e40-6dda-4b57-850d-a8de5a094d7d-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/opinion/sunday/21Douthat/21Douthat-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/21/opinion/sunday/21Douthat/21Douthat-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/opinion/sunday/21Douthat/21Douthat-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trump So Far Is More Farce Than Tragedy', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Trump So Far Is More Farce Than Tragedy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Russian Interference in 2016 US Elections and Ties to Trump Associates', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Frum, David J', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-01-20T19:30:02+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': N