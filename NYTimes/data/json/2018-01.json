/2018/01/21/magazine/21mag-eat1-promo/21mag-21eat-t_CA0-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/magazine/21mag-eat1-promo/21mag-eat1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/21/magazine/21mag-eat1-promo/21mag-eat1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/magazine/21mag-eat1-promo/21mag-eat1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Settle In for Winter With This Sausage Risotto', 'kicker': 'Eat', 'content_kicker': None, 'print_headline': 'A Risotto for the Ages', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-01-18T10:00:25+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf6a9696-0b75-59c8-b9df-aa705e9c5a73', 'word_count': 721, 'uri': 'nyt://article/bf6a9696-0b75-59c8-b9df-aa705e9c5a73'}, {'abstract': 'Five photographs reveal the evolution of a master street photographer.', 'web_url': 'https://www.nytimes.com/2018/01/18/magazine/joel-meyerowitzs-career-is-minihistory-of-photography.html', 'snippet': 'Five photographs reveal the evolution of a master street photographer.', 'lead_paragraph': '1. Now wait a second, is this magic? Or has it all been carefully arranged with actors, lighting and special effects? The truth is more surprising: It’s neither. It’s simply a picture snapped by Joel Meyerowitz on a New York City street one day in 1975. No faces are immediately evident, just figures in camel-colored coats turned away from us, a puff of smoke with two people suspended in it. No, four people, if you count those shadows, six if you count the backs on which the shadows fall. In fact there are seven people, if we count the additional shadow in the foreground, the photographer’s — and further figures emerge as the eye adjusts to the deep background. It is a picture that just won’t sit still.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/magazine/21mag-onphoto1/21mag-onphoto1-articleLarge.jpg', 'height': 415, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/21/magazine/21mag-onphoto1/21mag-onphoto1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 415}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/magazine/21mag-onphoto1/21mag-onphoto1-jumbo.jpg', 'height': 708, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/magazine/21mag-onphoto1/21mag-onphoto1-superJumbo.jpg', 'height': 1417, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/magazine/21mag-onphoto1/21mag-onphoto1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/21/magazine/21mag-onphoto1/21mag-onphoto1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/magazine/21mag-onphoto1/21mag-onphoto1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Joel Meyerowitz’s Career Is a Minihistory of Photography', 'kicker': 'On Photography', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Meyerowitz, Joel', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'ARBUS, DIANE', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Frank, Robert', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-01-18T10:00:26+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Teju Cole', 'person': [{'firstname': 'Teju', 'middlename': None, 'lastname': 'Cole', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0475233c-d003-5a81-84c5-a3a5d2c33557', 'word_count': 1589, 'uri': 'nyt://article/0475233c-d003-5a81-84c5-a3a5d2c33557'}, {'abstract': 'The movie thinks it’s saying something profound about human nature and America. But really, it’s off key about so many things.', 'web_url': 'https://www.nytimes.com/2018/01/18/movies/three-billboards-outside-ebbing-missouri.html', 'snippet': 'The movie thinks it’s saying something profound about human nature and America. But really, it’s off key about so many things.', 'lead_paragraph': 'Sometimes, a movie comes along that appears to take the H.O.V. lane through the awards circuit. It gets a bunch of nominations and wins some big prizes, occasionally the biggest ones, and most of the time, people — moviegoers, moviemakers, movie critics — will say they didn’t see it coming, that the enthusiasm for this movie doesn’t make any sense, that the praise being slathered insults how good about a dozen other movies actually are. Nonetheless, the movie is even kind of a hit. In its own accidental way, it does seem to be saying something about, you know, now. And the more love the prize givers throw at it, the more some people want to throw themselves off a cliff.', 'print_section': 'AR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/arts/21ebbing1/21ebbing1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/21/arts/21ebbing1/21ebbing1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/arts/21ebbing1/21ebbing1-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/arts/21ebbing1/21ebbing1-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/arts/21ebbing1/21ebbing1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/21/arts/21ebbing1/21ebbing1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/arts/21ebbing1/21ebbing1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Does ‘Three Billboards’ Say Anything About America? Well …', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Off-Key Oscar Contender', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McDonagh, Martin', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McDormand, Frances', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-01-18T10:00:26+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Wesley Morris', 'person': [{'firstname': 'Wesley', 'middlename': None, 'lastname': 'Morris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0e3c72e8-9769-5261-8279-b4fcff19728a', 'word_count': 2150, 'uri': 'nyt://article/0e3c72e8-9769-5261-8279-b4fcff19728a'}, {'abstract': 'Winter rain makes it more difficult for the animals to feed, particularly pregnant females, researchers find.', 'web_url': 'https://www.nytimes.com/2018/01/18/science/musk-oxen-climate-change.html', 'snippet': 'Winter rain makes it more difficult for the animals to feed, particularly pregnant females, researchers find.', 'lead_paragraph': 'It’s hard to miss a musk ox: It looks like a buffalo decked out in a hairy fur coat. And yet this easy-to-spot giant, which lives on tundras from Siberia to Greenland, is still surprisingly mysterious.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/23/science/23SCI-ZIMMER3/23SCI-ZIMMER3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge