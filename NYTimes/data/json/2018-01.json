e applicable or not.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/12/business/12DB-KNEE1/merlin_132140822_304ab8e2-b953-4776-874d-0c24b437b261-articleLarge.jpg', 'height': 912, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/12/business/12DB-KNEE1/merlin_132140822_304ab8e2-b953-4776-874d-0c24b437b261-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 912}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/12/business/12DB-KNEE1/merlin_132140822_304ab8e2-b953-4776-874d-0c24b437b261-jumbo.jpg', 'height': 1024, 'width': 674, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/12/business/12DB-KNEE1/merlin_132140822_304ab8e2-b953-4776-874d-0c24b437b261-superJumbo.jpg', 'height': 2048, 'width': 1348, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/12/business/12DB-KNEE1/12DB-KNEE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/12/business/12DB-KNEE1/12DB-KNEE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/12/business/12DB-KNEE1/12DB-KNEE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Even on the Internet, What’s Old Is New Again', 'kicker': 'Book Entry', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computers and t