acy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/20/t-magazine/oakImage-1513787327281-copy/oakImage-1513787327281-copy-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/20/t-magazine/oakImage-1513787327281-copy/oakImage-1513787327281-copy-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/20/t-magazine/oakImage-1513787327281-copy/oakImage-1513787327281-copy-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/20/t-magazine/oakImage-1513787327281-copy/oakImage-1513787327281-copy-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Cleansing Juice Recipe, From the Missoni Family', 'kicker': 'My detox', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recipes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Juices', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-01-02T19:19:18+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Kari Molvar', 'person': [{'firstname': 'Kari', 'middlename': None, 'lastname': 'Molvar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9dc30273-dbbb-56b4-858a-b8defb0a7811', 'word_count': 308, 'uri': 'nyt://article/9dc30273-dbbb-56b4-858a-b8defb0a7811'}, {'abstract': 'This documentary about the dancer Marcelo Gomes was completed before he left American Ballet Theater in December after allegations of sexual misconduct.', 'web_url': 'https://www.nytimes.com/2018/01/02/movies/anatomy-of-a-male-ballet-dancer-review-marcelo-gomes.html', 'snippet': 'This documentary about the dancer Marcelo Gomes was completed before he left American Ballet Theater in December after allegations of sexual misconduct.', 'lead_paragraph': 'The experience of watching the documentary “Anatomy of a Male Ballet Dancer” is a lesson for our times. As its title suggests, it is a head-to-battered-toe consideration of a male ballet dancer that takes you from studio to stage and points in between. It is formally conventional and draws on the usual zippy you-are-there moments with lots of gabby talking heads. What elevates it, though, is its charming — and from all accounts — deeply talented subject, Marcelo Gomes. So after it was over I eagerly searched Google for him on my phone only to discover that the day before, on Dec. 21, he had resigned from the American Ballet Theater after he was accused of sexual misconduct.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/03/arts/03anatomy-1/03anatomy-1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/03/arts/03anatomy-1/03anatomy-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/03/arts/03anatomy-1/03anatomy-1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/03/arts/03anatomy-1/03anatomy-1-superJumbo.jpg', 'height': 1365, 'wi