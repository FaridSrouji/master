': 'image', 'url': 'images/2018/01/09/us/mtm-readerart-9-LNmetoo/mtm-readerart-9-articleLarge.gif', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/09/us/mtm-readerart-9-LNmetoo/mtm-readerart-9-articleLarge.gif', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/09/us/mtm-readerart-9-LNmetoo/mtm-readerart-9-jumbo.gif', 'height': 768, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/09/us/mtm-readerart-9-LNmetoo/mtm-readerart-9-superJumbo.gif', 'height': 768, 'width': 768, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/09/us/mtm-readerart-9-LNmetoo/mtm-readerart-9-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/09/us/mtm-readerart-9-LNmetoo/mtm-readerart-9-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/09/us/mtm-readerart-9-LNmetoo/mtm-readerart-9-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Reckoning: Teaching About the #MeToo Moment and Sexual Harassment With Resources From The New York Times', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-01-25T16:19:20+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'subsection_name': 'Lesson Plans', 'byline': {'original': 'By Natalie Proulx, Christopher Pepper and Katherine Schulten', 'person': [{'firstname': 'Natalie', 'middlename': None, 'lastname': 'Proulx', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Christopher', 'middlename': None, 'lastname': 'Pepper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e7d99db2-51c8-5723-91fa-45c592cf739a', 'word_count': 6472, 'uri': 'nyt://article/e7d99db2-51c8-5723-91fa-45c592cf739a'}, {'abstract': 'And: revealing a family secret, dealing with friends who smoke indoors, and barking up the wrong tree.', 'web_url': 'https://www.nytimes.com/2018/01/25/style/hollywood-ageism-friendship.html', 'snippet': 'And: revealing a family secret, dealing with friends who smoke indoors, and barking up the wrong tree.', 'lead_paragraph': 'For years, a college friend (in her 50s) has forbidden me from telling anyone we went to school together. Since moving to Hollywood, she deducted 10 years from her age (some of it with cosmetic surgery) to preserve her writing career, she claims. She is afraid that my salt-and-pepper hair will “bust” her. Lately, she has been mostly out of touch. But the implication that I look so much older than her has rankled for years. When I confided my hurt feelings to her, she was unapologetic. Blame the industry and ageism, she said, not her. Do I have a right to feel hurt?', 'print_section': 'ST', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-jumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-superJumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Hollywood Ageism Hits Close to Home', 'kicker': 'Social Q’s', 'content_kicker': None, 'print_headline': 'Shaving Off the Years', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality and Bisexuality', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Age, Chronological', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-01-25T16:38:22+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Style', 'byline': {'original': 'By Philip Galanes', 'person': [{'firstname': '