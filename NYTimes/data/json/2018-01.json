name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Netflix Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Hulu.com', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-01-02T20:51:45+0000', 'document_type': 'article', 'news_desk': 'Watching', 'section_name': 'Watching', 'byline': {'original': 'By Monica Castillo', 'person': [{'firstname': 'Monica', 'middlename': None, 'lastname': 'Castillo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/21f87981-0143-52a8-a5bf-eb17b4021dde', 'word_count': 2641, 'uri': 'nyt://article/21f87981-0143-52a8-a5bf-eb17b4021dde'}, {'abstract': 'Long-simmering frustration over austerity and inequality have emerged as a nationwide cry for justice.', 'web_url': 'https://www.nytimes.com/2018/01/02/opinion/iran-protests-inequality.html', 'snippet': 'Long-simmering frustration over austerity and inequality have emerged as a nationwide cry for justice.', 'lead_paragraph': 'This is the third mass uprising in Iran in my lifetime. In July 1999, the peaceful protest of students over freedom of speech spread into a considerable uprising. In June 2009, people took to streets to demand a recount of disputed votes in the presidential election, which began the Green Movement. Those were both pushes for civil rights, demanding more flexibility and accountability from the government. They took place largely in Tehran, and attracted the middle class and the university educated. Both were peaceful and persistently nonviolent.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/02/opinion/02Ahmadi/merlin_131808764_5432f838-0a9a-42f1-9b93-e291516366af-articleLarge.jpg', 'height': 418, 'width': 600, 'subType': 'xlarge', '