ge': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/18/business/18apple1/merlin_131532089_d13b7d96-7aed-45cf-8202-4e08a809fd03-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/18/business/18apple1/merlin_131532089_d13b7d96-7aed-45cf-8202-4e08a809fd03-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/18/business/18apple1/merlin_131532089_d13b7d96-7aed-45cf-8202-4e08a809fd03-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/18/business/18apple1/merlin_131532089_d13b7d96-7aed-45cf-8202-4e08a809fd03-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/18/business/18apple1/18apple1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/18/business/18apple1/18apple1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/18/business/18apple1/18apple1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Apple, Capitalizing on New Tax Law, Plans to Bring Billions in Cash Back to U.S.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Apple, After Tax Cut Windfall, Will Bring Billions Back to U.S.', 'name': None, 'seo': None, 'sub': None}, 