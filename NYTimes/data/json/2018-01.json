/01/05/arts/05met-critics/05met-critics-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/05/arts/05met-critics/05met-critics-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/05/arts/05met-critics/05met-critics-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Met Should Be Open to All. The New Pay Policy Is a Mistake.', 'kicker': 'A Critics’ Conversation', 'content_kicker': None, 'print_headline': 'The Museum Should Be Open to All', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Museum of Art', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-01-04T16:49:48+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter and Roberta Smith', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3cdcfdc0-5a84-577f-a6a2-15fd582afa9a', 'word_count': 1283, 'uri': 'nyt://article/3cdcfdc0-5a84-577f-a6a2-15fd582afa9a'}, {'abstract': 'And: the price of end-of-life care, socializing with new parents, and a bystander’s stance on everyday sexism.', 'web_url': 'https://www.nytimes.com/2018/01/04/style/holiday-gift-exchange-rude.html', 'snippet': 'And: the price of end-of-life care, socializing with new parents, and a bystander’s stance on everyday sexism.', 'lead_paragraph': 'I received a nice gift (that I have absolutely no use for) from a relative. It came with a gift receipt in the box. My husband told me this was just a courtesy from the store, not permission from the giver to exchange it. He said it would hurt their feelings if I did. I think that’s crazy! If I keep it, I’ll only use it once or twice, to show my relative that I did. Wouldn’t it be better to exchange it for something I’ll use often and enjoy?', 'print_section': 'ST', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'height': 599, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/07/28/fashion/social_inline/social_inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 599}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-jumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-superJumbo-v2.jpg', 'height': 923, 'width': 925, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/07/28/fashion/social_inline/social_inline-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'th