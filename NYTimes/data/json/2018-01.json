/07-pants2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/08/fashion/07-pants2/07-pants2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/08/fashion/07-pants2/07-pants2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/08/fashion/07-pants2/07-pants2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Women Wear the Pants This Awards Season', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Golden Globes (Awards)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': '#MeToo Movement', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-01-08T04:25:04+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Valeriya Safronova', 'person': [{'firstname': 'Valeriya', 'middlename': None, 'lastname': 'Safronova', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b041f917-272d-57a4-84ca-2927a2220a10', 'word_count': 436, 'uri': 'nyt://article/b041f917-272d-57a4-84ca-2927a2220a10'}, {'abstract': 'There was consensus from the stage and dissonance on the red carpet in a broadcast that was half party, half protest.', 'web_url': 'https://www.nytimes.com/2018/01/07/movies/review-golden-globes.html', 'snippet'