ns', 'value': 'AL QAEDA', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Inter-Services Intelligence', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Kabul (Afghanistan)', 'rank': 12, 'major': 'N'}], 'pub_date': '2018-01-26T10:45:22+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Steve Coll', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Coll', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/9c2af113-7e51-54e3-8756-3cbe40058077', 'word_count': 1528, 'uri': 'nyt://article/9c2af113-7e51-54e3-8756-3cbe40058077'}, {'abstract': 'The federal budget stalemate is keeping the U.S. from making the investments it needs to compete with other nations.', 'web_url': 'https://www.nytimes.com/2018/01/26/opinion/falling-short-on-science.html', 'snippet': 'The federal budget stalemate is keeping the U.S. from making the investments it needs to compete with other nations.', 'lead_paragraph': 'Cambridge, Mass. — Amid the budget turbulence in Washington, it’s easy to miss the fact that part of what’s at stake is America’s dominance in science, engineering and innovation. The United States has been the world leader in these categories for so long that we have stopped believing it could be any other way. But other nations, seeing us lose focus, are seizing the chance to rise.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/26/opinion/26Zuber-web/merlin_132884180_bd0974a8-69b6-43bb-b007-9a664e891501