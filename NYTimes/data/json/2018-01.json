persons', 'value': "O'Neill, Annie (Photographer)", 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'National Geographic', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Pittsburgh (Pa)', 'rank': 11, 'major': 'N'}], 'pub_date': '2018-01-22T09:00:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Jonathan Blaustein', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Blaustein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/135221ad-637b-5f2a-a4a9-5037411f41f9', 'word_count': 776, 'uri': 'nyt://article/135221ad-637b-5f2a-a4a9-5037411f41f9'}, {'abstract': 'The Swiss conglomerate made a surprise $3.4 billion offer nearly three years after Yoox and Net-a-Porter merged in an all-share deal.', 'web_url': 'https://www.nytimes.com/2018/01/22/business/dealbook/richemont-yoox-net-a-porter.html', 'snippet': 'The Swiss conglomerate made a surprise $3.4 billion offer nearly three years after Yoox and Net-a-Porter merged in an all-share deal.', 'lead_paragraph': 'Compagnie Financière Richemont built a conglomerate offering the world’s wealthiest consumers the highest-quality product, often in the most luxurious of settings. Clients walking into a Cartier flagship or a Piaget boutique — both Richemont brands — could expect radiant smiles and soft furnishings, as well as impeccable service for as long as was necessary before they made their purchase.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/23/business/23db-richemont/23db-richemont-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/23/business/23db-richemont/23db-richemont-a