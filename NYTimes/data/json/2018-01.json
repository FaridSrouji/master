w York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/us/politics/24dc-manchin/merlin_132733613_df50cf62-1223-40e8-874c-465705a38bf8-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/24/us/politics/24dc-manchin/merlin_132733613_df50cf62-1223-40e8-874c-465705a38bf8-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/us/politics/24dc-manchin/merlin_132733613_df50cf62-1223-40e8-874c-465705a38bf8-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/us/politics/24dc-manchin/merlin_132733613_df50cf62-1223-40e8-874c-465705a38bf8-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/us/politics/24dc-manchin/24dc-manchin-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/24/us/politics/24dc-manchin/24dc-manchin-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/us/politics/24dc-manchin/24dc-manchin-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Manchin Will Seek Re-election but Sends Democrats a Stern Warning', 'kicker': None, 'content_kicker': None, 'print_headline': 'Vow to Seek Re-election, With Some Grumbling', 'name': None, 'seo': None, 'sub': None}, 'keywords