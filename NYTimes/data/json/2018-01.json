/nyregion/00methadoneclinic-alpha/00methadoneclinic-alpha-superJumbo-v3.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/14/nyregion/00methadoneclinic-alpha/00methadoneclinic-alpha-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/14/nyregion/00methadoneclinic-alpha/00methadoneclinic-alpha-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/14/nyregion/00methadoneclinic-alpha/00methadoneclinic-alpha-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Opioid Addiction Knows No Color, but Its Treatment Does', 'kicker': None, 'content_kicker': None, 'print_headline': 'Separate and Unequal Treatments', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opioids and Opiates', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Buprenorphine (Drug)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Therapy and Rehabilitation', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Methadone', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Poverty', 'rank': 8, 'major': 'N'}], 'pub_date': '2018-01-12T10:00:24+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Jose A. Del Real', 'person': [{'firstname': 'Jose', 'middlename': 'A.', 'lastname': 'Del', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4e010366-8d39-515a-a80b-e0eb4d8f58ef', 'word_count': 2300, 'uri': 'nyt://article/4e010366-8d39-515a-a80b-e0eb4d8f58ef'}, {'abstract': 'Richard Wilbur’s capacity for wonder wasn’t always fashionable. But it was always urgently necessary — and still is, perhaps now more than ever.', 'web_url': 'https://www.nytimes.com/2018/01/12/books/review/richard-wilbur-poetry-happiness.html', 'snippet': 'Richard Wilbur’s capacity for wonder wasn’t always fashionable. But it was always urgently necessary — and still is, perhaps now more than ever.', 'lead_paragraph': 'Many years ago, before the money bomb dropped on San Francisco and made the city uninhabitable, I lived in a basement apartment in the Upper Haight. Aside from the low price, and the big floor-to-ceiling pipe that every so often came alive with waste from above like an ironic rain stick, I think what chiefly appealed to me about the place was the gloom. If you’re going to become a writer in a city that glitters like that one, I thought, you need a little cave of pain.', 'print_section': 'BR', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/books/review/14Wiman/14Wiman-articleLarge.jpg', 'height': 903, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/14/books/review/14Wiman/14Wiman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 903}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/books/review/14Wiman/14Wiman-jumbo.jpg', 'height': 1024, 'width': 681, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/books/review/1