print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Currency', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clarke, Jeffrey J (1961- )', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Eastman Kodak Company', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-01-10T01:44:44+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Tom Buerkle', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Buerkle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d95b2317-d03d-5379-80ca-c9a399066046', 'word_count': 364, 'uri': 'nyt://article/d95b2317-d03d-5379-80ca-c9a399066046'}, {'abstract': 'The humanitarian reasons those who escaped their quake-damaged homeland should be allowed to stay far outweigh the legal reasons to send them home.', 'web_url': 'https://www.nytimes.com/2018/01/09/opinion/dont-deport-the-salvadorans.html', 'snippet': 'The humanitarian reasons those who escaped their quake-damaged homeland should be allowed to stay far outweigh the legal reasons to send them home.', 'lead_paragraph': 'The Trump administration’s decision to end the Temporary Protected Status for nearly 200,000 people from El Salvador who have been allowed to live in the United States for more than a decade comes as no surprise, given President Trump’s attitude toward immigration and his past decisions to end protected status for Haitians and Nicaraguans. It’s the wrong decision, on humanitarian and practical grounds.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/10/opinion/10wed2/10wed2-a