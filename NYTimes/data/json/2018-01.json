major': 'N'}, {'name': 'persons', 'value': 'Waters, Shawn (1980- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-01-19T11:49:11+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Matthew Haag', 'person': [{'firstname': 'Matthew', 'middlename': None, 'lastname': 'Haag', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67488157-71a4-524a-9937-f92c000702a5', 'word_count': 717, 'uri': 'nyt://article/67488157-71a4-524a-9937-f92c000702a5'}, {'abstract': 'The married father of two likes to keep his children active, go out to lunch, watch sports, cook, and make fun of his parenting quirks.', 'web_url': 'https://www.nytimes.com/2018/01/19/nyregion/how-fred-weller-actor-spends-his-sundays.html', 'snippet': 'The married father of two likes to keep his children active, go out to lunch, watch sports, cook, and make fun of his parenting quirks.', 'lead_paragraph': 'The actor Fred Weller has an Ensemble Drama Desk Award and two nominations, as well as dozens of film and television credits. But starting Jan. 22, Mr. Weller, 51, will be part of something a bit different: Steven Soderbergh’s murder-mystery mini-series “Mosaic” on HBO. The six-part show has an interactive twist — viewers can follow different characters’ points of view through an app. On Sundays, Mr. Weller spends time with his wife, the actress Ali Marsh; their 10-year-old daughter, Azalea, and 7-year-old son, Hank; and Gordon, a Maltipoo (a Maltese-poodle mix). The family lives in a three-bedroom apartment in Greenwich Village.', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/21/nyregion/21routine1/21routine1-articleLarge.jpg', 'height': 452, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarg