iddlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2a48591f-32cc-5b26-ae9e-2b04863afc47', 'word_count': 105, 'uri': 'nyt://article/2a48591f-32cc-5b26-ae9e-2b04863afc47'}, {'abstract': 'The Washington, Va., restaurant and hotel will kick off the milestone with a dinner, then a garden party.', 'web_url': 'https://www.nytimes.com/2018/01/22/dining/inn-at-little-washington.html', 'snippet': 'The Washington, Va., restaurant and hotel will kick off the milestone with a dinner, then a garden party.', 'lead_paragraph': 'The 40th birthday of the Inn at Little Washington in Washington, Va., is occasion for at least one party, so Patrick O’Connell, the owner, is doing just that. First up will be a dinner on Sunday ($375 a ticket) at the Inn, four decades to the date of the inn’s opening in what had been an auto repair shop. On June 16, Mr. O’Connell will hold a garden party at Mount Vernon, George Washington’s estate ($2,500 a ticket; event also benefits Mount Vernon Ladies’ Association). On Sept. 2, the village becomes Innstock for an all-day celebration with food, wines and music ($250 a ticket). Proceeds from each event benefit the Patrick O’Connell Foundation, which supports culinary education and historic preservation: The Inn at Little Washington, Washington, Va., 540-675-3800, theinnat40.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerinn-sub/24burnerinn-sub-articleLarge.jpg', 'height': 369, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/24/dining/24burnerinn-sub/24burnerinn-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 369}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerinn-sub/24burnerinn-sub-jumbo.jpg', 'height': 630, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerinn-sub/24burnerinn-sub-superJumbo.jpg', 'height': 1259, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerinn-sub/24burnerinn-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/24/dining/24burnerinn-sub/24burnerinn-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerinn-sub/24burnerinn-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inn at Little Washington Celebrates 40 Years', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Celebrate: Inn at Little Washington Plans Anniversary Events', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parties (Social)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Inn at Little Washington', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-01-22T21:30:21+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id'