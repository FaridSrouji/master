: '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerguac/merlin_131844099_5b715040-53cf-467f-a0ca-058bf085d56e-articleLarge.jpg', 'height': 534, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/24/dining/24burnerguac/merlin_131844099_5b715040-53cf-467f-a0ca-058bf085d56e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 534}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerguac/merlin_131844099_5b715040-53cf-467f-a0ca-058bf085d56e-jumbo.jpg', 'height': 912, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerguac/merlin_131844099_5b715040-53cf-467f-a0ca-058bf085d56e-superJumbo.jpg', 'height': 1823, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerguac/merlin_131844099_5b715040-53cf-467f-a0ca-058bf085d56e-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/24/dining/24burnerguac/merlin_131844099_5b715040-53cf-467f-a0ca-058bf085d56e-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/dining/24burnerguac/merlin_131844099_5b715040-53cf-467f-a0ca-058bf085d56e-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Guacamole Keeper, Peas Not Included', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To 