me': 'Ken', 'middlename': None, 'lastname': 'Jaworowski', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d868a793-d2cf-57b2-86d0-d5bb9e49a7f5', 'word_count': 265, 'uri': 'nyt://article/d868a793-d2cf-57b2-86d0-d5bb9e49a7f5'}, {'abstract': 'In this documentary, the Israeli director Amos Gitai describes himself as an archaeologist of Israeli-Palestinian relations.', 'web_url': 'https://www.nytimes.com/2018/01/25/movies/west-of-the-jordan-river-review.html', 'snippet': 'In this documentary, the Israeli director Amos Gitai describes himself as an archaeologist of Israeli-Palestinian relations.', 'lead_paragraph': 'The Israeli director Amos Gitai models “West of the Jordan River” on his earlier “Field Diary,” a 1982 documentary that he filmed in the occupied territories. At the opening of the new film, Mr. Gitai somewhat pretentiously likens his role to that of an “archaeologist” of negotiations between the Israelis and the Palestinians.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/movies/west1/merlin_132363617_02c873c6-c7e9-434f-843b-14d4b247b4c7-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/24/movies/west1/merlin_132363617_02c873c6-c7e9-434f-843b-14d4b247b4c7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/movies/west1/merlin_132363617_02c873c6-c7e9-434f-843b-14d4b247b4c7-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/movies/west1/merlin_132363617_02c873c6-c7e9-434f-843b-14d4b247b4c7-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/movies/west1/west1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/24/movies/west1/west1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/24/movies/west1/west1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘West of the Jordan River’ Examines the Mideast Peace Process', 'kicker': None, 'content_kicker': None, 'print_headline': 'Excavating The Mideast  Peace Process', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gitai, Amos (1950- )', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'West of the Jordan River (Movie)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-01-25T12:00:23+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Ben Kenigsberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Kenigsberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0c7c9a7f-cd46-5f84-9e80-fce066d06115', 'word_count': 346, 'uri': 'nyt://article/0c7c9a7f-cd46-5f84-9e80-fce066d06115'}, {'abstract': 'The difficult family life of the Polish painter Zdzislaw Beksinski makes for an often funny but also harrowing and heartbreaking film.', 'web_url': 'https://www.nytimes.com/2018/01/25/movies/the-last-family-review.html', 'snippet': 'The difficult family life of the Polish painter Zdzislaw Beksinski makes for an often funny but also harrowing and heartbreaking film.', 'lead_paragraph': 'The Polish painter Zdzislaw Beksinski is not well known here, but an appreciation of this often funny but also harrowing and heartbreaking film does not require expertise on its subject. I should actually say “subjects.” As per the title, this fictionalized portrait is a family one. The movie opens in 2005, the year of Beksinski’s death, with him making some wry and libidinous comments about future technology to a man we’ll learn was his biographer. It then jumps back to 1977, and Beksinski (Andrzej Seweryn, unimpeachable, as is the rest of the cast) and his wife and mother walk across a plaza from their own apartment block to an unfinished one, where Beksinski’s adult son, Tomasz, will live. At this point Tomasz is already struggling with mental illness.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/26/movies/26thelastfamily1/26thelastfamily1-articleLarge-v2.jpg', 'height': 333, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/26/movies/26thelastfamily1/26thelastfamily1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 333}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/26/movies/26thelastfamily1/26thelastfamily1-jumbo-v2.jpg', 'height': 569, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/26/movies/26thelastfamily1/26thelastfamily1-superJumbo-v2.jpg', 'height': 1138, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'su