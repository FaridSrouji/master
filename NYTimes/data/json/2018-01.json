ust about every relevant law on the books.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/23/opinion/23hathaway-web/merlin_119197331_d12bf3b1-d37b-4ace-aa24-6a8c8d1fd755-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/23/opinion/23hathaway-web/merlin_119197331_d12bf3b1-d37b-4ace-aa24-6a8c8d1fd755-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/23/opinion/23hathaway-web/merlin_119197331_d12bf3b1-d37b-4ace-aa24-6a8c8d1fd755-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/23/opinion/23hathaway-web/merlin_119197331_d12bf3b1-d37b-4ace-aa24-6a8c8d1fd755-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/23/opinion/23hathaway-web/23hathaway-web-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/23/opinion/23hathaway-web/23hathaway-web-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/23/opinion/23hathaway-web/23hathaway-web-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Syria Plan That Breaks the Law', 'kicker': 'Op-Ed Contributors', 'content_kicker': None, 'print_headline': 'A Syria P