': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/14/magazine/14mag-ondessert-promo/14mag-ondessert-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/magazine/14mag-ondessert-promo/14mag-ondessert-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Rice Pudding Gave Me Courage', 'kicker': 'On Dessert', 'content_kicker': None, 'print_headline': 'Off the Top of Your Head', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-01-10T10:00:02+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Dorie Greenspan', 'person': [{'firstname': 'Dorie', 'middlename': None, 'lastname': 'Greenspan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d1a0f3cd-0b71-537c-bade-08e3ee15729f', 'word_count': 859, 'uri': 'nyt://article/d1a0f3cd-0b71-537c-bade-08e3ee15729f'}, {'abstract': 'From a penthouse on Central Park, Guo Wengui has exposed a phenomenal web of corruption in China’s ruling elite — if, that is, he’s telling the truth.', 'web_url': 'https://www.nytimes.com/2018/01/10/magazine/the-mystery-of-the-exiled-billionaire-whistleblower.html', 'snippet': 'From a penthouse on Central Park, Guo Wengui has exposed a phenomenal web of corruption in China’s ruling elite — if, that is, he’s telling the truth.', 'lead_paragraph': 'On a recent Saturday afternoon, an exiled Chinese billionaire named Guo Wengui was holding forth in his New York apartment, sipping tea while an assistant lingered quietly just outside the door, slipping in occasionally to keep Guo’s glass cup perfectly full. The tycoon’s Twitter account had been suspended again — it was the fifth or sixth time, by Guo’s count — and he blamed the Communist Party of China. “It’s not normal!” he said, about this cycle of blocking and reinstating. “But it doesn’t matter. I don’t need anyone.”', 'print_section': 'MM', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/magazine/14mag-wengui/14mag-wengui-articleLarge.jpg', 'height': 748, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/14/magazine/14mag-wengui/14mag-wengui-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 748}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/magazine/14mag-wengui/14mag-wengui-jumbo.jpg', 'height': 1024, 'width': 822, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/magazine/14mag-wengui/14mag-wengui-superJumbo.jpg', 'height': 2048, 'width': 1644, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/magazine/14mag-wengui/14mag-14wengui-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/14/magazine/14mag-wengui/14mag-14wengui-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/14/magazine/14mag-wengui/14mag-14wengui-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Mystery of the Exiled Billionaire Whistle-Blower', 'kicker': 'Feature', 'content_kicker': None, 'pr