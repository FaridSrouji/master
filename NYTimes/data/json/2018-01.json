n’t quite ready for what happened next.', 'print_section': 'TR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/28/travel/28frugal-nashville2/merlin_132013499_7f0b93d1-9fea-48bb-8089-280bbdd0a881-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/28/travel/28frugal-nashville2/merlin_132013499_7f0b93d1-9fea-48bb-8089-280bbdd0a881-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/28/travel/28frugal-nashville2/merlin_132013499_7f0b93d1-9fea-48bb-8089-280bbdd0a881-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/28/travel/28frugal-nashville2/merlin_132013499_7f0b93d1-9fea-48bb-8089-280bbdd0a881-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/28/travel/28frugal-nashville2/merlin_132013499_7f0b93d1-9fea-48bb-8089-280bbdd0a881-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/28/travel/28frugal-nashville2/merlin_132013499_7f0b93d1-9fea-48bb-8089-280bbdd0a881-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/28/travel/28frugal-nashville2/merlin_132013499_7f0b93d1-9fea-48bb-8089-280bbdd0a881-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headlin