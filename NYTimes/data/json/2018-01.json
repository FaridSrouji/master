ption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/28/world/28finland-firstdog/28finland-firstdog-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/28/world/28finland-firstdog/28finland-firstdog-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/28/world/28finland-firstdog/28finland-firstdog-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Finland’s Scene-Stealing First Dog Is Missed During Dull Election', 'kicker': None, 'content_kicker': None, 'print_headline': 'In a Dull Election, Finland Is Missing Its Wet-Nosed Star', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Finland', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Dogs', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Niinisto, Sauli', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-01-27T15:55:27+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Richard Martyn-Hemphill', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Martyn-Hemphill', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7a808d61-6372-5438-aa52-8db70b04e9fa', 'word_count': 647, 'uri': 'nyt://article/7a808d61-6372-5438-aa52-8db70b04e9fa'}, {'abstract': 'The Trump administration has removed protections for 200,000 Salvadorans who have been allowed to live here legally since 2001.', 'web_url': 'https://www.nytimes.com/2018/01/27/books/review/el-salvador-immigrants-trump-books.html', 'snippet': 'The Trump administration has removed protections for 200,000 Salvadorans who have been allowed to live here legally since 2001.', 'lead_paragraph': 'This month, the Trump administration reversed protections for Salvadorans living legally in the United States through a program known as Temporary Protected Status, which allows people whose native countries are afflicted by armed conflict, natural disaster or other dire conditions to remain in the United States. El Salvador was first added to the list in the 1980s as a result of a bloody civil war that lasted 12 years and left 75,000 dead. In 2001, when a pair of earthquakes badly impaired the country’s infrastructure, these protections were renewed. In the books below, two writers captured life during the civil war, while a third follows a pair of twin brothers who immigrated in 2013.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/01/books/27newsbook-elsalvador4/27newsbook-elsalvador4-articleLarge.jpg', 'height': 308, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/02/01/books/27newsbook-elsalvador4/27newsbook-elsalvador4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 308}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/01/books/27newsbook-elsalvador4/27newsbook-elsalvador4-jumbo.jpg', 'height': 526, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/02/01/books/27newsbook-elsalvador4/27newsbook-elsalvador4-superJumbo.jpg', 'height': 1052, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'th