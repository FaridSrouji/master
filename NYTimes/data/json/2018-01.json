150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jon Bon Jovi Loves France and Wine (and Now Has His Own Label)', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Jon Bon Jovi His Wine Glass and Schedule Are Full.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bon Jovi, Jon', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-01-30T16:30:12+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Shivani Vora', 'person': [{'firstname': 'Shivani', 'middlename': None, 'lastname': 'Vora', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/127833d4-1ad0-5ea9-838b-c11236f26e0b', 'word_count': 708, 'uri': 'nyt://article/127833d4-1ad0-5ea9-838b-c11236f26e0b'}, {'abstract': 'Silly Chilly Hotsauce is the creation of a fashionista from Bangladesh.', 'web_url': 'https://www.nytimes.com/2018/01/30/dining/silly-chilly-hotsauce.html', 'snippet': 'Silly Chilly Hotsauce is the creation of a fashionista from Bangladesh.', 'lead_paragraph': 'Sufia Hossain, a native of Bangladesh who worked in fashion in New York, turned a career corner and decided to make hot sauces. Months of experimentation led to her company, Silly Chilly Hotsauce, which makes sauces in Englewood and Bloomfield, N.J., from chiles grown at Rutgers University’s farm in New Brunswick, among other sources. Each of the three sauces is agreeably thick: mellow mustard-yellow mango and sweet pepper; musky, smoky mahogany serrano and chipotle; and weaponized neon-orange habanero. Ms. Hossain also teaches classes in making hot sauces, $45 per person for 90 minutes in Manhattan and Brooklyn: Silly Chilly Hotsauce, $10.95 for five ounces, sillychillyhotsauce.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/31/dining/31burnersauce/31burnersauce-articleLarge.jpg', 'height': 806, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/31/dining/31burnersauce/31burnersauce-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 806}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/31/dining/31burnersauce/31burnersauce-jumbo.jpg', 'height': 1024, 'width': 762, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/31/dining/31burnersauce/31burnersauce-superJumbo.jpg', 'height': 2048, 'width': 1524, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/31/dining/31burnersauce/31burnersauce-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/01/31/dining/31burnersauce/31burnersauce-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/31/dining/31burnersauce/31burnersauce-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Hot Sauce With a Fashionable Pedigree', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Slather: Making Hot Sauce A Fashionable Line', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sauces', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Chili Peppers', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Silly Chilly Hotsauce', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hossain, Sufia', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-01-30T16:35:21+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8bfaee69-ff32-5391-874b-f0abe311e180', 'word_count': 128, 'uri': 'nyt://article/8bfaee69-ff32-5391-874b-f0abe311e180'}, {'abstract': 'The calzone’s cousin is the star of the menu at a new cafe, Panzerotti Bites, in Carroll Gardens, Brooklyn.', 'web_url': 'https://www.nytimes.com/2018/01/30/dining/panzerotti-bites-brooklyn.html', 'snippet': 'The calzone’s cousin is the star of the menu at a new cafe, Panzerotti Bites, in Carroll Gardens, Brooklyn.', 'lead_paragraph': 'As calzones are to the Naples area, panzerotti — another filled half-moon turnover — are to Apulia, the heel of Italy. Though panzerotti ooze similar fillings, they are made from a thinner dough than calzones and deep-fried, not baked. Now they’re available in Carroll Gardens, Brooklyn, at Panzerotti Bites. Vittoria Lattanzio and her husband, Pasquale De Ruvo, who are from Apulia, fry them with a dozen fillings, including mortadella, tomato, roasted vegetables and tuna. Sweet ones are filled with ricotta and Nutella. They are quite light, miraculously greaseless, and if you take them home to serve, they need but five minutes in a 350-degree oven to come back to life. A few with fancy fillings like smoked salmon are folded into a heavier casing: Panzerotti, $7 to $12, Panzerotti Bites, 235 Smith Street (Douglass Street), 347-720-0269, panzerottibites.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'cap