Large-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/10/opinion/sunday/10douthat-lead/10douthat-lead-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/10/opinion/sunday/10douthat-lead/10douthat-lead-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/10/opinion/sunday/10douthat-lead/10douthat-lead-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/10/opinion/sunday/10douthat-lead/10douthat-lead-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/04/10/opinion/sunday/10douthat-lead/10douthat-lead-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/10/opinion/sunday/10douthat-lead/10douthat-lead-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Modern-Day Unbelievers, and Believers', 'kicker': 'letters', 'content_kicker': None, 'print_headline': 'Modern-Day Unbelievers, and Believers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Religion and Belief', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Christians and Christianity', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Douthat, Ross G', 'rank': 4, 'major': 'N'}], 'pub_date': '2021-04-18T15:00:05+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'subsection_name': 'Letters', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/de685fb4-3230-58d0-adda-30f73c10a8f2', 'word_count': 642, 'uri': 'nyt://article/de685fb4-3230-58d0-adda-30f73c10a8f2'}, {'abstract': 'Back when we visited in 2002, there was hope that America could help make the country better.', 'web_url': 'https://www.nytimes.com/2021/04/18/opinion/joe-biden-afghanistan-2002.html', 'snippet': 'Back when we visited in 2002, there was hope that America could help make the country better.', 'lead_paragraph': 'I was not surprised that Joe Biden decided to finally pull the plug on the U.S. presence in Afghanistan. Back in 2002 it was reasonable to hope that our invasion there to topple Osama bin Laden and his Taliban allies could be extended to help make that country a more stable, tolerant and decent place for its citizens — and less likely to host jihadist groups. But it was also reasonable to fear from the start that trying to graft a Western political culture onto such a deeply tribalized, male-dominated and Islamic fundamentalist culture like Afghanistan’s was a fool’s errand, especially when you factored in how much neighboring Pakistan never wanted us to succeed because it could wrench Afghanistan from Pakistan’s cultural and geopolitical orbit.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/20/opinion/20friedman-inyt/18friedman-articleLarge.jpg', 'height': 391, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/20/opinion/20friedman-inyt/18friedman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None,