 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4d9fb2fb-4410-527d-92b1-dd1baf6bf546', 'word_count': 1121, 'uri': 'nyt://article/4d9fb2fb-4410-527d-92b1-dd1baf6bf546'}, {'abstract': 'The oil company is arguing against efforts to restrict its involvement in a gas operation in Myanmar that provides funding for the junta there.', 'web_url': 'https://www.nytimes.com/2021/04/22/us/politics/chevron-myanmar-sanctions.html', 'snippet': 'The oil company is arguing against efforts to restrict its involvement in a gas operation in Myanmar that provides funding for the junta there.', 'lead_paragraph': 'WASHINGTON — The Myanmar military’s coup and brutal crackdown on dissent have left it with few allies in the West. But one of the most sophisticated corporate lobbying operations in Washington has mobilized to head off intensifying pressure on the Biden administration to impose broad sanctions against the state-owned oil and gas company helping to finance the junta.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/20/us/politics/20lobby1-sub/merlin_186129705_267bfd0a-3adb-42a4-b7a0-da1ba61bafb5-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/20/us/politics/20lobby1-sub/merlin_186129705_267bfd0a-3adb-42a4-b7a0-da1ba61bafb5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/20/us/politics/20lobby1-sub/merlin_186129705_267bfd0a-3adb-42a4-b7a0-da1ba61bafb5-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/20/us/politics/20lob