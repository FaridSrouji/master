 Queens.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/15/obituaries/13pugach1-print/merlin_186305361_bb4fcd22-38a6-4f02-85e1-68ff71989e46-articleLarge.jpg', 'height': 699, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/15/obituaries/13pugach1-print/merlin_186305361_bb4fcd22-38a6-4f02-85e1-68ff71989e46-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 699}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/15/obituaries/13pugach1-print/merlin_186305361_bb4fcd22-38a6-4f02-85e1-68ff71989e46-jumbo.jpg', 'height': 1024, 'width': 880, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/15/obituaries/13pugach1-print/merlin_186305361_bb4fcd22-38a6-4f02-85e1-68ff71989e46-superJumbo.jpg', 'height': 1880, 'width': 1614, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/15/obituaries/13pugach1-print/13pugach1-print-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/04/15/obituaries/13pugach1-print/13pugach1-print-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/15/obituaries/13pugach1-print/13pugach1-print-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Burt Pugach, Protagonist of a Strange Tabloid Love Story, Dies at 93', 'kicker': None, 'content_kicker': None, 'print_head