nk': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/03/31/opinion/00Lcallout-lead/00Lcallout-lead-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Code to Live By: What Is Yours?', 'kicker': 'letter', 'content_kicker': None, 'print_headline': 'A Code to Live By:  What Is Yours?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2021-04-01T17:11:45+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'subsection_name': 'Letters', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/3d931ce0-5440-56ff-a4c6-b360c2ca303a', 'word_count': 137, 'uri': 'nyt://article/3d931ce0-5440-56ff-a4c6-b360c2ca303a'}, {'abstract': 'Suggested reading from critics and editors at The New York Times.', 'web_url': 'https://www.nytimes.com/2021/04/01/books/review/11-new-books-we-recommend-this-week.html', 'snippet': 'Suggested reading from critics and editors at The New York Times.', 'lead_paragraph': 'A couple of smart writers recently have put words to something that seems self-evident but bears keeping in mind for anybody who loves to read: “Literature is made of culture,” the critic Laura Miller wrote at Slate, while on Twitter the novelist Sheila Heti wrote, “Writers are their times.” (Or something to that effect, anyway: Heti, a dedicated self-deleter, removed her tweet not long after posting it.) The point is that books don’t exist in a vacuum, and even works of pure history or fantasy are shaped by the context of the writer’s own world.', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/01/books/01recbooks/01recbooks-articleLarge.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'c