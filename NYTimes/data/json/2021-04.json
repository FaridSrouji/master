'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a85de4be-a726-5491-a788-608a4fa70ec6', 'word_count': 993, 'uri': 'nyt://article/a85de4be-a726-5491-a788-608a4fa70ec6'}, {'abstract': 'The Biden administration will for now maintain a historically low refugee cap. But after a widespread backlash from Democrats, the White House said it would raise refugee admissions in May.', 'web_url': 'https://www.nytimes.com/2021/04/16/us/politics/joe-biden-refugee-policy.html', 'snippet': 'The Biden administration will for now maintain a historically low refugee cap. But after a widespread backlash from Democrats, the White House said it would raise refugee admissions in May.', 'lead_paragraph': 'WASHINGTON — The White House announced on Friday that President Biden would limit the number of refugees allowed into the United States this year to the historically low level set by the Trump administration, reversing an earlier promise to welcome more than 60,000 people fleeing war and persecution.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/16/us/politics/16dc-biden-refugees-1/merlin_185825508_39c92167-af43-4dd4-8771-b00db7c413e3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/16/us/politics/16dc-biden-refugees-1/merlin_185825508_39c92167-af43-4dd4-8771-b00db7c413e3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/16/us/politics/16dc-biden-refugees-1/merlin_185825508_39c92167-af43-4dd4-8771-b00db7c413e3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/