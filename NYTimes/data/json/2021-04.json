/01/26/well/00well-estrangedgrief/merlin_182850633_23b14068-8ff1-4764-be11-cdf44b9185ab-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/01/26/well/00well-estrangedgrief/merlin_182850633_23b14068-8ff1-4764-be11-cdf44b9185ab-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/01/26/well/00well-estrangedgrief/merlin_182850633_23b14068-8ff1-4764-be11-cdf44b9185ab-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When an Estranged Relative Dies, Some Face Grief, Regret and Relief', 'kicker': None, 'content_kicker': None, 'print_headline': 'Facing Grief, Regret and Relief When an Estranged Relative Dies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Families and Family Life', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Funerals and Memorials', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Death and Dying', 'rank': 4, 'major': 'N'}], 'pub_date': '2021-04-05T09:00:07+0000', 'document_type': 'article', 'news_desk': 'Well', 'section_name': 'Well', 'subsection_name': 'Family', 'byline': {'original': 'By Caitlin Kelly', 'person': [{'firstname': 'Caitlin', 'middlename': None, 'lastname': 'Kelly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3977cc64-e651-5aa3-aba3-1c391fd642cc', 'word_count': 1476, 'uri': 'nyt://article/3977cc64-e651-5aa3-aba3-1c391fd642cc'}, {'abstract': 'Tim Cook views privacy as ‘one of the top issues of the 21st century.’ Other tech leaders don’t seem to agree.', 'web_url': 'https://www.nytimes.com/2021/04/05/opinion/apples-ceo-is-making-very-different-choices-from-mark-zuckerberg.html', 'snippet': 'Tim Cook views privacy as ‘one of the top issues of the 21st century.’ Other tech leaders don’t seem to agree.', 'lead_paragraph': 'It’s a dismal world when two tech giants are embroiled in a fight over your privacy. Yet here we are as updates from Apple that give users more power over their data and make third-party tracking more transparent have sent Facebook into a fury. The social media giant took out a full-page ad last year claiming it was “standing up to Apple.” Or perhaps Facebook was standing up for its bottom line, as tracking is a critical component of the company’s targeted ad business. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Apple’s C.E.O. Is Making Very Different Choices From Mark Zuckerberg', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cook, Timothy D', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Data-Mining and Database Marketing', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Parler LLC', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Driverless and Semiautonomous Vehicles', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Online Advertising', 'rank': 11, 'major': 'N'}], 'pub_date': '2021-04-05T09:00:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': "By ‘Sway'", 'person': [{'firstname': "Swa