', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/25/magazine/25mag-model-image2/25mag-model-image2-superJumbo.png', 'height': 1654, 'width': 1358, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/25/magazine/25mag-model-image2/25mag-model-image2-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/04/25/magazine/25mag-model-image2/25mag-model-image2-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/25/magazine/25mag-model-image2/25mag-model-image2-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Tragedy of Harry Uzoka', 'kicker': 'Feature', 'content_kicker': None, 'print_headline': 'Deadly Bravado', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Uzoka, Harry', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Koh, George', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Models (Professional)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 11, 'ma