ame': 'Emily', 'middlename': None, 'lastname': 'Cochrane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/caada67f-6d32-5698-8bff-ba2f80ed0974', 'word_count': 326, 'uri': 'nyt://article/caada67f-6d32-5698-8bff-ba2f80ed0974'}, {'abstract': 'The bill — labeled H.R. 40 after the unfulfilled Civil War-era promise to give former slaves “40 acres and a mule” — faces an uphill path amid opposition from Republicans and many Democrats.', 'web_url': 'https://www.nytimes.com/2021/04/14/us/house-reparations-bill.html', 'snippet': 'The bill — labeled H.R. 40 after the unfulfilled Civil War-era promise to give former slaves “40 acres and a mule” — faces an uphill path amid opposition from Republicans and many Democrats.', 'lead_paragraph': 'A House committee voted on Wednesday to recommend for the first time the creation of a commission to consider providing Black Americans with reparations for slavery in the United States and a “national apology” for centuries of discrimination. It comes three decades after the measure was first introduced and a century and a half after the end of slavery.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In a historic vote, a House panel advances a bill to form a reparations commission.', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Reparations', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jackson Lee, Sheila', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Conyers, John Jr', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'House Committee on the Judiciary', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-04-14T15:49:39+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'byline': {'original': 'By Nicholas Fandos', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Fandos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f693fbc1-a381-574c-b2a1-59814b3e0090', 'word_count': 635, 'uri': 'nyt://article/f693fbc1-a381-574c-b2a1-59814b3e0090'}, {'abstract': 'The country hasn’t used it since last month, after concerns arose about a possible rare, dangerous side effect. Officials say they have adequate supplies of other vaccines to use instead.', 'web_url': 'https://www.nytimes.com/2021/04/14/world/europe/denmark-astrazeneca-vaccine.html', 'snippet': 'The country hasn’t used it since last month, after concerns arose about a possible rare, dangerous side effect. Officials say they have adequate supplies of other vaccines to use instead.', 'lead_paragraph': 'Denmark on Wednesday became the first country to plan to permanently stop administering the AstraZeneca vaccine, a month after suspending its use following reports that a small number of recipients had developed a rare but serious blood-clotting disorder.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/14/us/14virus-briefing-johnsonacip-2/merlin_186386139_0b9b6aa9-fd18-4ebd-8431-cd711181b78d-articleLarge.jpg', 'height': 425, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/14/us/14virus-briefing-johnsonacip-2/merlin_186386139_0b9b6aa9-fd18-4ebd-8431-cd711181b78d-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 425}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/14/us/14virus-briefing-joh