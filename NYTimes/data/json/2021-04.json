k': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (Minneapolis, Minn)', 'rank': 8, 'major': 'N'}], 'pub_date': '2021-04-19T22:52:48+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Court TV', 'person': [{'firstname': 'Court', 'middlename': None, 'lastname': 'TV', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/03dbb785-5e34-5601-9681-ce434c2af61d', 'word_count': 0, 'uri': 'nyt://video/03dbb785-5e34-5601-9681-ce434c2af61d'}, {'abstract': 'The group’s lobbying power is diminished — but that hasn’t shaken Republican opposition to gun control.', 'web_url': 'https://www.nytimes.com/2021/04/19/us/politics/nra-gun-control.html', 'snippet': 'The group’s lobbying power is diminished — but that hasn’t shaken Republican opposition to gun control.', 'lead_paragraph': 'The National Rifle Association, for decades among the most powerful political groups in the country, is on the rocks. Its president, Wayne LaPierre, has acknowledged secretly taking the N.R.A. into bankruptcy, and its lobbying apparatus is badly diminished as the organization has lost, in Mr. LaPierre’s own private estimation, over $100 million as a result of legal troubles. It’s currently facing suits from New York and the District of Columbia accusing the group of abusing its nonprofit status.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/19/multimedia/19onpolitics-01/19onpolitics-01-articleLarge-v2.png', 'height': 793, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', '