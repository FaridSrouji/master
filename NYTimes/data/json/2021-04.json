rner-book1/19burner-book1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/04/21/dining/19burner-book1/19burner-book1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/21/dining/19burner-book1/19burner-book1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Vegetables Get the Ripert Treatment', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Cook: Vegetables Receive The Ripert Treatment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetables', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ripert, Eric', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Vegetable Simple (Book)', 'rank': 4, 'major': 'N'}], 'pub_date': '2021-04-19T14:42:14+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/091a6e36-647a-5fb6-b1f8-a51d1a9a910e', 'word_count': 394, 'uri': 'nyt://article/091a6e36-647a-5fb6-b1f8-a51d1a9a910e'}, {'abstract': 'A line of kitchen helpers, printed with photographs from Pauline Stevens and quotes from writers, arrives just in time for Mother’s Day.', 'web_url': 'https://www.nytimes.com/2021/04/19/dining/mothers-day-gift-towels.html', 'snippet': 'A line of kitchen helpers, printed with photographs from Pauline Stevens and quotes from writers, arrives just in time for Mother’s Day.', 'lead_paragraph': 'The soft cotton that once went into making flour sacks is what the photographer Pauline Stevens has selected for her vibrant collection of kitchen towels decorated with her food-focused photographs.  Each is also printed with a literary quotation or a recipe for a dish, a drink or a sauce, most well-suited for Mother’s Day giving. There’s a special set for the holiday. One of the towels, showing a bucket of roses, has a quote from E.M. Forster: “I am sure that if mothers of various nations could meet, there would be no more wars.” The other towel in the set also has roses, and a quote from Maya Angelou. Both measure 19-by-27 inches. Most of the towels are 27-inches square and come nicely packaged with a greeting card.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/21/dining/19burner-towel/19burner-towel-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/21/dining/19burner-towel/19burner-towel-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/21/dining/19burner-towel/19burner-towel-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/21/dining/19burner-towel/19burner-towel-superJumbo.jpg', 'height': 1747, 'width': 1747, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/21/dining/19burner-towel/19burner-towel-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 