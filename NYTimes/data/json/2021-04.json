es/2021/04/13/multimedia/13sp-watchinsure-inyt1/13sp-watchinsure-inyt1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/13/multimedia/13sp-watchinsure-inyt1/13sp-watchinsure-inyt1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Should My Watch Be Insured?', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Watches and Clocks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Insurance', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Service', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'CHUBB CORP', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Insurance Information Institute', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Luxury Goods and Services', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Appraisals and Valuation (Property)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Boutros, Paul', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Phillips Auctioneers LLC', 'rank': 9, 'major': 'N'}], 'pub_date': '2021-04-12T09:00:16+0000', 'document_type': 'article', 'news_desk': 'SpecialSections', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Kathleen Beckett', 'person': [{'firstname': 'Kathleen', 'middlename': None, 'lastname': 'Beckett', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/533c7825-781c-5356-9f87-ad880bb545a9', 'word_count': 923, 'uri': 'nyt://article/533c7825-781c-5356-9f87-ad880bb545a9'}, {'abstract': "Though she's best known as a playwright, Suzan-Lori Parks is always looking to evolve as an artist — and derives a particular joy from performing her songs with and for others.", 'web_url': 'https://www.nytimes.com/2021/04/12/t-magazine/suzan-lori-parks-band.html', 'snippet': "Though she's best known as a playwright, Suzan-Lori Parks is always looking to evolve as an artist — and derives a particular joy from performing her songs with and for others.", 'lead_paragraph': 'Suzan-Lori Parks: I started playing guitar in high school in Maryland, where people, Black and white, told me, “Black people don’t play the guitar.” This was before the internet, so I had to hip them to Sister Rosetta Tharpe, Memphis Minnie and Reverend Gary Davis. I’m not disparaging anybody, it’s just what happens when people encourage you to stay in a box. The idea of an award-winning playwright (and a screenwriter-showrunner) playing an instrument is also strange to some. My feeling is, if you find yourself in a box, maybe you want to lower the walls.', 'print_section': 'M2', 'print_page': '86', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/12/t-magazine/12tmag-parksband/12tmag-parksband-articleLarge.jpg', 'height': 429, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/04/12/t-magazine/12tmag-parksband/12tmag-parksband-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 429}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/12/t-magazine/12tmag-parksband/12tmag-parksband-jumbo.jpg', 'height': 732, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/04/12/t-magazine/12tmag-parksband/12tmag-parksband-superJumbo.jpg', 'height': 1463, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': No