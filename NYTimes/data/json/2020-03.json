-refugees6/merlin_170048826_ad46e4fa-43f1-46c6-8952-ffee03387fbd-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/26/world/26virus-refugees6/merlin_170048826_ad46e4fa-43f1-46c6-8952-ffee03387fbd-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/26/world/26virus-refugees6/merlin_170048826_ad46e4fa-43f1-46c6-8952-ffee03387fbd-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/26/world/26virus-refugees6/merlin_170048826_ad46e4fa-43f1-46c6-8952-ffee03387fbd-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/26/world/26virus-refugees6/26virus-refugees6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/26/world/26virus-refugees6/26virus-refugees6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/26/world/26virus-refugees6/26virus-refugees6-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Unprepared for the Worst: World’s Most Vulnerable Brace for Virus', 'kicker': None, 'content_kicker': None, 'print_headline': 'Unprepared for the Worst: The World’s Most Vulnerable Are in Deep Peril', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'val