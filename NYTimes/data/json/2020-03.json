ubType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Read T a Poem | Vanessa Williams', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Poetry and Poets', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'ANGELOU, MAYA', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Vanessa', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-03-06T21:50:18+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Barbara Anastacio', 'person': [{'firstname': 'Barbara', 'middlename': None, 'lastname': 'Anastacio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/4e761152-2913-54d2-982b-ce12902e302e', 'word_count': 0, 'uri': 'nyt://video/4e761152-2913-54d2-982b-ce12902e302e'}, {'abstract': 'As part of our series “Read T a Poem,” the actress performs a work by Maya Angelou.', 'web_url': 'https://www.nytimes.com/2020/03/06/t-magazine/vanessa-williams-international-womens-day.html', 'snippet': 'As part of our series “Read T a Poem,” the actress performs a work by Maya Angelou.', 'lead_paragraph': 'Over her nearly 40-year career, Vanessa Williams has proved herself to be a master of reinvention. In 1983, she made history as the first African-American woman to be crowned Miss America, and later that decade she became a chart-topping musician with multiple platinum albums and a slew of Grammy nominations. From there, she moved on to theater, television and film acting — appearing most memorably as the witch in the 2002 Broadway revival of the musical “Into the Woods” and as the scheming magazine director Wilhelmina Slater in the TV series “Ugly Betty” — and in more recent years, she has co-written a memoir 