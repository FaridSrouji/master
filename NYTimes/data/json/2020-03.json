/05devs-interview1/05devs-interview1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/arts/05devs-interview1/05devs-interview1-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/arts/05devs-interview1/05devs-interview1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/06/arts/05devs-interview1/05devs-interview1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/arts/05devs-interview1/05devs-interview1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Devs’: How the Universe Brought Alex Garland and Nick Offerman Together', 'kicker': None, 'content_kicker': None, 'print_headline': 'These Two Got Together. Was It Predetermined?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Garland, Alex', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Offerman, Nick', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'FX (TV Network)', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-03-05T12:00:07+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Noel Murray', 'person': [{'firstname': 'Noel', 'middlename': None, 'lastname': 'Murray', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': N