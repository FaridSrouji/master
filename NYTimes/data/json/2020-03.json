 'height': 2048, 'width': 1538, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/20/arts/19bearden4/19bearden4-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/20/arts/19bearden4/19bearden4-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/20/arts/19bearden4/19bearden4-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Romare Bearden’s Rarely Seen Abstract Side', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Exposing a Modernist’s Other Side', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bearden, Romare', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Chelsea (Manhattan, NY)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'DC Moore Gallery', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-03-19T14:00:08+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65cc3299-10c9-5687-8764-0e982c889daa', 'word_count': 889, 'uri': 'nyt://article/65cc3299-10c9-5687-8764-0e982c889daa'}, {'abstract': 'Following his 2014 debut album, the singer and songwriter retreated from the spotlight and got married. Now he’s returning to a very different landscape.', 'web_u