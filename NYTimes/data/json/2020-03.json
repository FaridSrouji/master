': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/13/us/coronavirusjobs-promo-1584127244584/coronavirusjobs-promo-1584127244584-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Workers Who Face the Greatest Coronavirus Risk', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Paid Time Off', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Workplace Hazards and Violations', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-03-15T09:00:01+0000', 'document_type': 'multimedia', 'news_desk': 'Business Day', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Lazaro Gamio', 'person': [{'firstname': 'Lazaro', 'middlename': None, 'lastname': 'Gamio', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/48087181-339c-5e22-a585-0a57a14e8219', 'word_count': 0, 'uri': 'nyt://interactive/48087181-339c-5e22-a585-0a57a14e8219'}, {'abstract': 'Some Democrats, including Bernie Sanders, say the government-financed care and education of children should start at birth instead of at kindergarten.', 'web_url': 'https://www.nytimes.com/2020/03/15/upshot/universal-child-care-democratic-platform.html', 'snippet': 'Some Democrats, including Bernie Sanders, say the government-financed care and education of children should start at birth instead of at kindergarten.', 'lead_paragraph': 'In the United States, the chance that a child attends a high-quality preschool — which research has shown sets them on a more successful life path — often depends on whether the parents can afford it. But what if government-funded care and education of children started soon after birth?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/13/upshot/13up-univeralchildcare/merlin_170172273_5a572086-9bce-411b-8ddc-4edbc2bbde46-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/13/upshot/13up-univeralchildcare/merlin_170172273_5a572086-9bce-411b-8ddc-4edbc2bbde46-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/13/upshot/13up-univeralchildcare/merlin_170172273_5a572086-9bce-411b-8ddc-4edbc2bbde46-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/13/upshot/13up-univeralchildcare/merlin_170172273_5a572086-9bce-411b-8ddc-4edbc2bbde46-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/13/upshot/13up-univeralchildcare/13up-univeralchildcare-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/13/upshot/13up-univeralchildcare/13up-univeralchildcare-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/13/upshot/13up-univeralchildcare/13up-univeralchildcare-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Public School Is a Child’s Right. Should Preschool Be Also?', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (Pre-School)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Child Care', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sanders, Bernard', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-03-15T09:00:05+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Claire Cain Miller', 'person': [{'firstname': 'Claire', 'middlename': 'Cain', 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/48688055-bd11-5ff5-8121-009113d708a8', 'word_count': 1234, 'uri': 'nyt://article/48688055-bd11-5ff5-8121-009113d708a8'}, {'abstract': 'Paul Lisicky, author of “Later: My Life at the Edge of the World,” talks about Provincetown, the challenges of memoir and learning not to suppress anger.', 'web_url': 'https://www.nytimes.com/2020/03/15/books/later-memoir-paul-lisicky-interview.html', 'snippet': 'Paul Lisicky, author of “Later: My Life at the Edge of the World,” talks about Provincetown, the challenges of memoir and learning not to suppress anger.', 'lead_paragraph': 'The memoirist and novelist Paul Lisicky says that “versions” of his experiences in Provincetown, Mass. — the Cape Cod community renowned as an art colony and a thriving home for the L.G.B.T.Q. community — have appeared in his previous work. But his new book, “Later: My Life at the Edge of the World,” intimately and extensively recounts the time he spent there in the early 1990s, growing into his own, sexually and emotionally, in a community grappling with the AIDS epidemic. On one page, Lisicky remembers wondering: “How will I ever be able to leave this haven, so far from the repression and punishments of adulthood? Am I trapped in sweetness now?” And soon after, he’s describing the men who had come to Provincetown to live out their last days. “A retirement community,” he calls the town. “Say, Sun City, Ariz., but for young men in their 20s and 30s.” Below, Lisicky talks about the project’s false starts, learning not to suppress anger, his longtime love of Joni Mitchell’s music and more.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/15/books/15Lisicky1/15Lisicky1-articleLarge.png', 'height': 982, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/15/books/15Lisicky1/15Lisicky1-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 982}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/15/books/15Lisicky1/15Lisicky1-jumbo.png', 'height': 1024, 'width': 626, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/15/books/15Lisicky1/15Lisicky1-superJumbo.png', 'height': 2048, 'width': 1252, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/15/books/15Lisicky1/15Lisicky1-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/15/books/15Lisicky1/15Lisicky1-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/15/books/15Lisicky1/15Lisicky1-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Gay Man Remembers His Awakening, as AIDS Shook His World', 'kicker': '5 Things About Your Book', 'content_kicker': None, 'print_headline': 'A Gay Man Remembers His Provincetown Awakening', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lisicky, Paul (1959- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality and Bisexuality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Acquired Immune Deficiency Syndrome', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Provincetown (Mass)', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Later: My Life at the Edge of the World (Book)', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-03-15T09:00:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7a060f7-b691-547b-a121-7cf1d606ffed', 'word_count': 1000, 'uri': 'nyt://article/c7a060f7-b691-547b-a121-7cf1d606ffed'}, {'abstract': 'The coronavirus is getting scarier, but try not to panic. The stock market is doing that for you.\xa0', 'web_url': 'https://www.nytimes.com/2020/03/15/business/the-week-in-business-itll-get-worse-before-it-gets-better.html', 'snippet': 'The coronavirus is getting scarier, but try not to panic. The stock market is doing that for you.\xa0', 'lead_paragraph': 'Hello from my apartment, where I plan to remain for as long as my pretzel and cof