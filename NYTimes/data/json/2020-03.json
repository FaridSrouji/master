ord_count': 1371, 'uri': 'nyt://article/a953e025-db2d-5836-9852-e02f46b89430'}, {'abstract': 'Work on residential and commercial projects is slowing as materials from overseas become harder to get, posing a threat to construction jobs.', 'web_url': 'https://www.nytimes.com/2020/03/20/business/coronavirus-construction.html', 'snippet': 'Work on residential and commercial projects is slowing as materials from overseas become harder to get, posing a threat to construction jobs.', 'lead_paragraph': 'When it comes to obtaining building materials, real estate developers often buy globally, not locally. But as the coronavirus spreads across the world, bringing countries to a standstill, the lack of access to overseas supplies is sending jitters through the construction industry.', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/21/business/19VIRUS-CONSTRUCTION1-print/merlin_170733942_b1bcb30c-db6e-46af-9a2f-555eefa36be7-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/21/business/19VIRUS-CONSTRUCTION1-print/merlin_170733942_b1bcb30c-db6e-46af-9a2f-555eefa36be7-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/21/business/19VIRUS-CONSTRUCTION1-print/merlin_170733942_b1bcb30c-db6e-46af-9a2f-555eefa36be7-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/21/business/19VIRUS-CONSTRUCTION1-print/merlin_170733942_b1bcb30c-db6e-46af-9a2f-555eefa36be7-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtyp