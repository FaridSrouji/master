lo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/06/business/06Adviser-illo/06Adviser-illo-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/business/06Adviser-illo/06Adviser-illo-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Not to Become a Victim of Social Security Fraud Calls', 'kicker': 'Your money adviser', 'content_kicker': None, 'print_headline': 'How Not to Become a Victim of Social Security Fraud Calls', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Identity Theft', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Security (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Impostors (Criminal)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Elderly', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Spam (Electronic)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Personal Finances', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-03-06T14:00:08+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ced75b67-430a-5f58-ab91-b539d738ce52', 'word_count': 831, 'uri': 'nyt://article/ced75b67-430a-5f58-ab91-b539d738ce52'}, {'abstract': 'The designer, who founded the Kenzo label in 1970, relishes the storytelling powers of these ancient objects.', 'web_url': 'https://www.nytimes.com/2020/03/06/t-magazine/kenzo-takada-antique-artifacts.html', 'snippet': 'The designer, who founded the Kenzo label in 1970, relishes the storytelling powers of these ancient objects.', 'lead_paragraph': 'The Japanese designer Kenzo Takada first began collecting antiquities in the early 1990s while decorating his 14,000-square-foot townhouse in Paris’s Bastille neighborhood. The 81-year-old — who founded the fashion house Kenzo in 1970 and retired as its creative director in 1999 — is drawn to ancient statues, instruments, figurines and masks from Africa, Asia and Greece. “Once I started learning about these artifacts and the stories they told, I began to appreciate their history as much as their beauty as decorative objects,” he says. His collection has grown to include over 300 pieces, which he houses in a Haussmannian-style apartment beside the Seine, where he moved to in 2009. Takada sources many of his items from Japan and Hong Kong (he travels to Asia six times a year) and his favorite Paris antique shops. In January, the designer launched K三 (pronounced “K3”), a colorful home-décor line with Eastern influences that will introduce textiles, wallpaper, bedding, ceramics and rugs over the course of this year.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/t-magazine/06tmag-kenzo-slide-NX1S/06tmag-kenzo-slide-NX1S-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/06/t-magazine/06tmag-kenzo-slide-NX1S/06tmag-kenzo-slide-NX1S-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/t-magazine/06tmag-kenzo-slide-NX1S/06tmag-kenzo-slide-NX1S-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/t-magazine/06tmag-kenzo-slide-NX1S/06tmag-kenzo-slide-NX1S-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/t-magazine/06tmag-kenzo-slide-NX1S/06tmag-kenzo-slide-NX1S-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/06/t-magazine/06tmag-kenzo-slide-NX1S/06tmag-kenzo-slide-NX1S-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/t-magazine/06tmag-kenzo-slide-NX1S/06tmag-kenzo-slide-NX1S-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kenzo Takada’s Antique Artifacts', 'kicker': 'Of a Kind', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Takada, Kenzo', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ANTIQUES', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Collectors and Collections', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sculpture', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Kenzo', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-03-06T14:00:10+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By John Wogan and Illustrations by Aurore de La Morinerie', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Wogan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Illustrations', 'middlename': 'Aurore', 'lastname': 'de La Morinerie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/99c6cbc9-3926-5e97-95a6-23ca7a07424c', 'word_count': 409, 'uri': 'nyt://article/99c6cbc9-3926-5e97-95a6-23ca7a07424c'}, {'abstract': 'Decades-old menus, notes and letters are found in a crawl space just as the new owners are bringing the Brooklyn restaurant back to life.', 'web_url': 'https://www.nytimes.com/2020/03/06/realestate/found-in-the-attic-at-gage-tollner-historic-treasure.html', 'snippet': 'Decades-old menus, notes and letters are found in a crawl space just as the new owners are bringing the Brooklyn restaurant back to life.', 'lead_paragraph': 'For an individual, it’s almost a cliché of personal discovery: while poking around in Grandma’s attic, you stumble upon a trunk stuffed with long-lost family artifacts. But for a venerable old restaurant — particularly a defunct one carved up over the past 15 years by a costume jewelry store, a tattoo parlor and an Arby’s — such a find is markedly more surprising.', 'print_section': 'RE', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/realestate/06streetscapes9/merlin_169628436_6a7eabdc-7158-4e35-abd0-feec1be2eafe-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/06/realestate/06streetscapes9/merlin_169628436_6a7eabdc-7158-4e35-abd0-feec1be2eafe-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/realestate/06streetscapes9/merlin_169628436_6a7eabdc-7158-4e35-abd0-feec1be2eafe-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype':