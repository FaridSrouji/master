jor': 'N'}, {'name': 'glocations', 'value': 'Riverside Park (Manhattan, NY)', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-03-20T09:00:22+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Corey Kilgannon and Todd Heisler', 'person': [{'firstname': 'Corey', 'middlename': None, 'lastname': 'Kilgannon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Todd', 'middlename': None, 'lastname': 'Heisler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/30cf204f-3b95-5600-9e12-d5f68a0b1947', 'word_count': 406, 'uri': 'nyt://article/30cf204f-3b95-5600-9e12-d5f68a0b1947'}, {'abstract': 'The gap between the Trump campaign’s boosterism and the reality of a nation under siege from a deadly contagion can be jarring.', 'web_url': 'https://www.nytimes.com/2020/03/20/us/politics/coronavirus-trump-campaign.html', 'snippet': 'The gap between the Trump campaign’s boosterism and the reality of a nation under siege from a deadly contagion can be jarring.', 'lead_paragraph': 'On Sunday, hours before the Centers for Disease Control and Prevention warned against any gatherings of 50 people or more, a measure designed to slow the spread of the coronavirus, President Trump signed an email to his millions of supporters.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/19/us/politics/19trump-digital1/merlin_168008370_75764d35-1704-44c8-a0e1-c75551d8a599-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/19/us/politics/19trump-digital1/merlin_168008370_75764d35-1704-44c8-a0e1-c75551d8a599-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}