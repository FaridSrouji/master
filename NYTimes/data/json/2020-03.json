: 'images/2020/03/20/us/politics/20dc-virus-warnings-jp3/20dc-virus-warnings-jp3-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/20/us/politics/20dc-virus-warnings-jp3/20dc-virus-warnings-jp3-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/20/us/politics/20dc-virus-warnings-jp3/20dc-virus-warnings-jp3-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/20/us/politics/20dc-virus-warnings-jp3/20dc-virus-warnings-jp3-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/20/us/politics/20dc-virus-warnings-jp3/20dc-virus-warnings-jp3-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/20/us/politics/20dc-virus-warnings-jp3/20dc-virus-warnings-jp3-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Before Virus Outbreak, a Cascade of Warnings Went Unheeded', 'kicker': None, 'content_kicker': None, 'print_headline': 'Warning of a Pandemic Last Year Was Unheeded', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Epidemics', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Disasters and Emergencies', 'rank':