'}, {'name': 'subject', 'value': 'Epidemics', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Supermarkets and Grocery Stores', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-03-19T16:21:24+0000', 'document_type': 'article', 'news_desk': 'Well', 'section_name': 'Well', 'subsection_name': 'Live', 'byline': {'original': 'By Tara Parker-Pope', 'person': [{'firstname': 'Tara', 'middlename': None, 'lastname': 'Parker-Pope', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90652e43-ec95-55ab-9563-50d5c8334276', 'word_count': 445, 'uri': 'nyt://article/90652e43-ec95-55ab-9563-50d5c8334276'}, {'abstract': 'In “The Red Lotus,” Chris Bohjalian strikes a fine balance between disclosure and secrecy.', 'web_url': 'https://www.nytimes.com/2020/03/19/books/review-red-lotus-chris-bohjalian.html', 'snippet': 'In “The Red Lotus,” Chris Bohjalian strikes a fine balance between disclosure and secrecy.', 'lead_paragraph': 'We all know what it’s like to worry that something terrible has happened to a person we care about, as the hours pass and there is still no word and even implausible explanations (flat tire, broken phone) become increasingly unlikely. Plunging his main character into that excruciating situation — subjecting her to that “great, black maw of fear” — is the first diabolical thing that Chris Bohjalian does in his terrific new thriller, “The Red Lotus.”', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/20/books/19bookbohjalian1/19bookbohjalian1-articleLarge-v3.jpg', 'height': 878, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/20/books/19bookbohjalian1/19bookbohjalian1-articleLarge-v3.jpg', '