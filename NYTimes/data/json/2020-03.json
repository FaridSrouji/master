 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/science/26TB-NEANDERTHALFISH2/26TB-NEANDERTHALFISH2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/31/science/26TB-NEANDERTHALFISH2/26TB-NEANDERTHALFISH2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/science/26TB-NEANDERTHALFISH2/26TB-NEANDERTHALFISH2-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/science/26TB-NEANDERTHALFISH2/26TB-NEANDERTHALFISH2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/science/26TB-NEANDERTHALFISH2/26TB-NEANDERTHALFISH2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/31/science/26TB-NEANDERTHALFISH2/26TB-NEANDERTHALFISH2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/science/26TB-NEANDERTHALFISH2/26TB-NEANDERTHALFISH2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Neanderthals Feasted on Seafood, Seabirds, Perhaps Even Dolphins', 'kicker': 'trilobites', 'content_kicker': None, 'print_headline': 'A Paleo Diet With a Lot of Fish', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Neanderthal Man', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fish and Other Marine Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Caves and Caverns', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Portugal', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ARCHAEOLOGY AND ANTHROPOLOGY', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Evolution (Biology)', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Science (Journal)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Rodrigues, Filipa', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Zilhao, Joao', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'your-feed-science', 'rank': 11, 'major': 'N'}], 'pub_date': '2020-03-26T18:00:12+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Nicholas St. Fleur', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'St', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a857832d-0efa-5a42-b2fd-fe1f165ad64c', 'word_count': 799, 'uri': 'nyt://article/a857832d-0efa-5a42-b2fd-fe1f165ad64c'}, {'abstract': 'The interior designer Alex P. White transformed two rooms with little natural light into a moody oasis.', 'web_url': 'https://www.nytimes.com/2020/03/26/t-magazine/downtown-manhattan-apartment-alex-p-white.html', 'snippet': 'The interior designer Alex P. White transformed two rooms with little natural light into a moody oasis.', 'lead_paragraph': 'A concrete-ceilinged two-room apartment on the fourth floor of an 11-story building on Manhattan’s Lower East Side gets little natural light — very little. But this didn’t prove particularly daunting for the New York- and Los Angeles-based interior designer Alex P. White, 50, who was tasked with designing this compact space on Orchard Street last spring. White, who trained as an artist before working with the acclaimed interior designer Kelly Behun and then going out on his own three years ago, favors dark, moody lighting anyway; his Instagram page is filled with vintage photos of interiors that, unlike the bright rooms seen in home magazines today, were taken after sundown. After all, says White, “that’s when we spend the most time at home — at night.” For this project, White stuck to his druthers, making lighting a key component in what became an atmospheric oasis that recalls both the minimalism and the glamour of the ’70s.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/t-magazine/design/25tmag-alex-white-slide-KU09/25tmag-alex-white-slide-KU09-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/25/t-magazine/design/25tmag-alex-white-slide-KU09/25tmag-alex-white-slide-KU09-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/t-magazine/design/25tmag-alex-white-slide-KU09/25tmag-alex-white-slide-KU09-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/t-magazine/design/25tmag-alex-white-slide-KU09/25tmag-alex-white-slide-KU09-superJumbo.jpg', 'height': 1535, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/t-magazine/design/25tmag-alex-white-slide-KU09/25tmag-alex-white-slide-KU09-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'c