ster2/06lobster2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/business/06lobster2/06lobster2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/business/06lobster2/06lobster2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/06/business/06lobster2/06lobster2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/06/business/06lobster2/06lobster2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Florida Lobster Got a Break on China Tariffs. Then Came Coronavirus.', 'kicker': None, 'content_kicker': None, 'print_headline': 'China’s Demand for Lobster Dries Up', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lobsters', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Customs (Tariff)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fishing, Commercial', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida Keys', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-03-06T17:43:11+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Patricia', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/93d8d713-ac19-5bc4-a019-60614c638f86', 'word_count': 1361, 'uri': 'nyt://article/93d8d713-ac19-5bc4-a019-60614c638f86'}, {'abstract': 'Marilyn Stasio finds much to like in the latest crop of crime novels.', 'web_url': 'https://www.nytimes.com/2020/03/06/books/review/truants-kate-weinberg-new-crime-fiction.html', 'snippet': 'Marilyn Stasio finds much to like in the latest crop of crime novels.', 'lead_paragraph': 'Coming-of-age novels aren’t my particular passion — unless there’s a murder in the story. There’s a doozy of a murder in Kate Weinberg’s hypnotic debut mystery, THE TRUANTS (Putnam, 311 pp., $26), one that might have met with the approval of the Queen of Crime, Agatha Christie. Dame Agatha happens to figure tangentially in this uncommonly clever whodunit, which makes plentiful references to her books, plot twists, settings and even the 11 days in 1926 when she inexplicably disappeared — all while coming across as madly original.', 'print_section': 'BR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/08/books/review/08Crime/08Crime-articleLarge.jpg', 'height': 838, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/08/books/review/08Crime/08Crime-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 838}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/08/books/review/08Crime/08Crime-jumbo.jpg', 'height': 1024, 'width': 734, 'subType': 'jum