ame': None, 'lastname': 'Greenidge', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/571bbecd-c627-5f28-9f57-ae926cb8e655', 'word_count': 633, 'uri': 'nyt://article/571bbecd-c627-5f28-9f57-ae926cb8e655'}, {'abstract': 'Louis Langrée, a Lincoln Center regular, led the New York Philharmonic for the first time this week.', 'web_url': 'https://www.nytimes.com/2020/03/06/arts/music/new-york-philharmonic-review.html', 'snippet': 'Louis Langrée, a Lincoln Center regular, led the New York Philharmonic for the first time this week.', 'lead_paragraph': 'Louis Langrée is no stranger to David Geffen Hall. For nearly two decades he’s been its summer tenant as music director of the Mostly Mozart Festival. And the Cincinnati Symphony Orchestra, which he has led since 2013, has even stopped by for a visit.', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/07/arts/06nyphil/merlin_170092236_f2736f93-821a-4079-8c72-2aae30a467ba-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/07/arts/06nyphil/merlin_170092236_f2736f93-821a-4079-8c72-2aae30a467ba-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/07/arts/06nyphil/merlin_170092236_f2736f93-821a-4079-8c72-2aae30a467ba-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/07/arts/06nyphil/merlin_170092236_f2736f93-821a-4079-8c72-2aae30a467ba-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJ