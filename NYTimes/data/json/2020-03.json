ages/2020/03/17/opinion/00warzel1/00warzel1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/17/opinion/00warzel1/00warzel1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'They Went Off the Grid. They Came Back to the Coronavirus.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Off the Grid, Then Hit by Reality', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Colorado River', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Grand Canyon (Ariz)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Rafts', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 5, 'major': 'N'}], 'pub_date': '2020-03-17T23:00:06+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Charlie Warzel', 'person': [{'firstname': 'Charlie', 'middlename': None, 'lastname': 'Warzel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/13a05f38-e6ce-51f5-adf7-36bb4ddb3e69', 'word_count': 1389, 'uri': 'nyt://article/13a05f38-e6ce-51f5-adf7-36bb4ddb3e69'}, {'abstract': 'The grounding of the 737 Max after two deadly crashes had already strained the company. The coronavirus is pushing it to the brink.', 'web_url': 'https://www.nytimes.com/2020/03/17/business/economy/boeing-coronavirus-economy.html', 'snippet': 'The grounding of the 737 Max after two deadly crashes had already strained the company. The coronavirus is pushing it to the brink.', 'lead_paragraph': 'As the crisis caused by the coronavirus continues to spiral out of control, the vast ram