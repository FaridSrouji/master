icity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': "New Deal (1930's)", 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Roosevelt, Franklin Delano', 'rank': 5, 'major': 'N'}], 'pub_date': '2020-03-14T15:00:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Sunday Review', 'byline': {'original': 'By Eduardo Porter', 'person': [{'firstname': 'Eduardo', 'middlename': None, 'lastname': 'Porter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/ab415a9c-400f-5a01-a007-dae8645439ac', 'word_count': 1312, 'uri': 'nyt://article/ab415a9c-400f-5a01-a007-dae8645439ac'}, {'abstract': 'When loving your neighbor means keeping your distance.', 'web_url': 'https://www.nytimes.com/2020/03/14/opinion/coronavirus-church-close.html', 'snippet': 'When loving your neighbor means keeping your distance.', 'lead_paragraph': 'The church, the actual building that houses black bodies and souls, stands at the center of black life and culture. It is a fact hiding in plain sight that one of the first cooperative economic ventures former slaves undertook was the purchase and maintenance of churches. Without the cooperation of the church, many black colleges, universities and political organizations would not exist. To this day, American black Christians attend church at a higher rate than any other ethnic group.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/14/opinion/14McCaulley-1/merlin_170021733_9a6d1bea-5aed-42e9-9bfe-4c0b7bc817d7-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': '