rganizations', 'value': 'Treasury Department', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Defense Department', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Wilkie, Robert', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Wolf, Chad F', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Disasters and Emergencies', 'rank': 11, 'major': 'N'}], 'pub_date': '2020-03-26T09:00:17+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jennifer Steinhauer and Zolan Kanno-Youngs', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Steinhauer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Zolan', 'middlename': None, 'lastname': 'Kanno-Youngs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24d13dec-63cc-5a9b-a034-64069328eb57', 'word_count': 1624, 'uri': 'nyt://article/24d13dec-63cc-5a9b-a034-64069328eb57'}, {'abstract': 'A conversation with the Princeton scholar Moulie Vidas on mortality and the embrace of life in Judaism.', 'web_url': 'https://www.nytimes.com/2020/03/26/opinion/judaism-life-death.html', 'snippet': 'A conversation with the Princeton scholar Moulie Vidas on mortality and the embrace of life in Judaism.', 'lead_paragraph': 'This is the second in a series of interviews with religious scholars from several faiths — and one atheist — on the meaning of death. The idea for this series, and the content of this interview, originated shortly before the pandemic. Yet all of it has obviously taken on a deeper and more urgent relevance in the midst of this crisis. The essential ideas being discussed here are ones that people everywhere, religious or not, are grappling with.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'c