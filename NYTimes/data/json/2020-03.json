-v2.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/04/01/dining/27virus-clams1/27virus-clams1-superJumbo-v2.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/04/01/dining/27virus-clams1/27virus-clams1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/04/01/dining/27virus-clams1/27virus-clams1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/04/01/dining/27virus-clams1/27virus-clams1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'One Shop Became a Lifeline for Rhode Island’s Solitary Clam Fishermen', 'kicker': None, 'content_kicker': None, 'print_headline': 'Thin Lifeline for Quahoggers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "Andrade's Catch (Bristol, RI, Retailer)", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Clams', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Bristol (RI)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Seafood', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Supermarkets and Grocery Stores', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Fishing, Commercial', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Narragansett Bay (RI)', 'rank': 9, 'major': 'N'}, {'name':