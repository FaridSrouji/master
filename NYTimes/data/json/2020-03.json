t', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Podcasts', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Public Radio', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Slate (Magazine)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Vox Media Inc', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-03-26T18:24:44+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'byline': {'original': 'By Reggie Ugwu', 'person': [{'firstname': 'Reggie', 'middlename': None, 'lastname': 'Ugwu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c793768-ffba-5e6b-a5d0-8e6b53908e17', 'word_count': 715, 'uri': 'nyt://article/4c793768-ffba-5e6b-a5d0-8e6b53908e17'}, {'abstract': 'The comedy duo wanted to make a sitcom for Adult Swim about a house full of awkward men (and, somehow, one woman). It’s as weird as Tim and Eric fans would expect.', 'web_url': 'https://www.nytimes.com/2020/03/26/arts/television/beef-house-tim-and-eric-sitcom.html', 'snippet': 'The comedy duo wanted to make a sitcom for Adult Swim about a house full of awkward men (and, somehow, one woman). It’s as weird as Tim and Eric fans would expect.', 'lead_paragraph': 'The press tour had been canceled. Everything is canceled. But as anyone familiar with the comedy of Tim Heidecker and Eric Wareheim would appreciate, there was something almost too appropriate about having to view their faces as degraded images on a stuttering, grainy video stream amid a general feeling of discomfort.', 'print_section': 'C', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/27/arts/26beef-house/26beef-house-articleLar