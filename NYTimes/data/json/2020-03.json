, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-K4FJ/31LIVING-CA-EASTCUT-slide-K4FJ-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-K4FJ/31LIVING-CA-EASTCUT-slide-K4FJ-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-K4FJ/31LIVING-CA-EASTCUT-slide-K4FJ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-K4FJ/31LIVING-CA-EASTCUT-slide-K4FJ-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Living In ... East Cut, San Francisco', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-03-31T13:00:17+0000', 'document_type': 'multimedia', 'news_desk': 'Real Estate', 'section_name': 'Real Estate', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/0303d426-cbf2-5f1b-874e-0df6f76a9975', 'word_count': 0, 'uri': 'nyt://slideshow/0303d426-cbf2-5f1b-874e-0df6f76a9975'}, {'abstract': 'A walkable, high-rise neighborhood has opened for business in a hilly, mostly low-rise city.', 'web_url': 'https://www.nytimes.com/2020/03/31/realestate/east-cut-san-francisco-a-newly-rebranded-neighborhood-takes-a-bow.html', 'snippet': 'A walkable, high-rise neighborhood has opened for business in a hilly, mostly low-rise city.', 'lead_paragraph': 'SAN FRANCISCO — After commuting from his home in San Mateo, Calif., to Austin, Texas, for several years, Cristian Azcarate landed a job at the San Francisco-area headquarters of his company and settled in the Bay Area permanently. He and his husband decided to sell their home in Silicon Valley and buy a place that felt as close to the opposite of suburbia as possible. They settled on the East Cut, one of San Francisco’s most recently renamed, and densest, neighborhoods.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-3U50/31LIVING-CA-EASTCUT-slide-3U50-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-3U50/31LIVING-CA-EASTCUT-slide-3U50-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-3U50/31LIVING-CA-EASTCUT-slide-3U50-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/realestate/31LIVING-CA-EASTCUT-slide-3U50/31LIVING-CA-EASTCUT-slide-3U50-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/31/realestate/31LIVI