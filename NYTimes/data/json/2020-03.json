world/17virus-hanks01/17virus-hanks01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tom Hanks and Rita Wilson Are Released From the Hospital', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hanks, Tom', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Wilson, Rita', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Elba, Idris', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Queensland (Australia)', 'rank': 5, 'major': 'N'}], 'pub_date': '2020-03-17T08:36:20+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Australia', 'byline': {'original': 'By Isabella Kwai', 'person': [{'firstname': 'Isabella', 'middlename': None, 'lastname': 'Kwai', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e09a03d2-4bb5-5b07-ba03-5b4482e592f7', 'word_count': 281, 'uri': 'nyt://article/e09a03d2-4bb5-5b07-ba03-5b4482e592f7'}, {'abstract': 'In “Hitler’s First Hundred Days,” Peter Fritzsche charts the audacious and swift changes that occurred once Hitler had been appointed chancellor.', 'web_url': 'https://www.nytimes.com/2020/03/17/books/review-hitlers-first-hundred-days-peter-fritzsche.html', 'snippet': 'In “Hitler’s First Hundred Days,” Peter Fritzsche charts the audacious and swift changes that occurred once Hitler had been appointed chancellor.', 'lead_paragraph': 'The right-wing elites were confident they could use him to their advantage. Yes, Adolf Hitler was ridiculous and vulgar, a tin-pot demagogue instead of a smooth politician, but he knew how to excite the nationalist base and deliver a whopper of a speech. Germany’s conservative politicians assured one another that they would still be the ones to pull the puppet strings. As one of them put it, “In two months, we’ll have pushed Hitler so far into a corner that he’ll squeal.”', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/18/books/18bookfritzsche1/18bookfritzsche1-articleLarge.jpg', 'height': 855, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/18/books/18bookfritzsche1/18bookfritzsche1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 855}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/18/books/18bookfritzsche1/18bookfritzsche1-jumbo.jpg', 'height': 1024, 'width': 719, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/18/books/18bookfritzsche1/18bookfritzsche1-superJumbo.jpg', 'height': 2048, 'width': 1437, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/18/books/18bookfritzsche1/18bookfritzsche1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/18/books/18bookfritzsche1/18bookfritzsche1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/18/books/18bookfritzsche1/18bookfritzsche1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Sobering Look at How Quickly Hitler Transformed Germany', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Lightning-Fast Slide Into Brutality', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hitler, Adolf', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': "Hitler's First Hundred Days: When Germans Embraced the Third Reich (Book)", 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Fritzsche, Peter (1959- )', 'rank': 6, 'major': 'N'}], 'pub_date': '2020-03-17T09:00:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By Jennifer Szalai', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Szalai', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b271d932-feb6-5565-a117-4e546134d819', 'word_count': 1041, 'uri': 'nyt://article/b271d932-feb6-5565-a117-4e546134d819'}, {'abstract': 'It might be fine to skim through a user manual for an office printer, but don’t skim “Anna Karenina” and expect to understand it.', 'web_url': 'https://www.nytimes.com/2020/03/17/magazine/speed-reading.html', 'snippet': 'It might be fine to skim through a user manual for an office printer, but don’t skim “Anna Karenina” and expect to understand it.', 'lead_paragraph': '“There are no shortcuts,” says Elizabeth Schotter, an assistant professor of psychology at the University of South Florida, where she runs the Eye Movements and Cognition Lab. College-educated adults usually read between 200 and 400 words per minute (a comfortable listening rate is around 150 words per minute). The speediest speed readers claim as many as 30,000 words per minute, at which point research would suggest a significant loss of comprehension. It might be fine to skim through a user manual for an office printer, but don’t skim “Anna Karenina” and expect to understand it. “In this modern age, we always want to do everything faster,” says Schotter, whose lab uses high-speed video to analyze readers’ eyes as they dart across text. America’s speed-reading obsession confounds Schotter; on average, people read twice as fast as they can comfortably listen. Reading is visually and cognitively complicated; it’s OK to reread a line because it’s confusing or, better yet, to linger on a phrase so beautiful that it makes you want to close your eyes.', 'print_section': 'MM', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/22/magazine/22Mag-Tip-01/22Mag-Tip-01-articleLarge-v2.jpg', 'height': 348, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/22/magazine/22Mag-Tip-01/22Mag-Tip-01-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 348}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/22/magazine/22Mag-Tip-01/22Mag-Tip-01-jumbo-v2.jpg', 'height': 442, 'width': 763, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/22/magazine/22Mag-Tip-01/22Mag-Tip-01-superJumbo-v2.jpg', 'height': 442, 'width': 763, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/22/magazine/22Mag-Tip-01/22Mag-Tip-01-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/22/magazine/22Mag-Tip-01/22Mag-Tip-01-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/22/magazine/22Mag-Tip-01/22Mag-Tip-01-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Read Faster', 'kicker': 'Tip ', 'content_kicker': None, 'print_headline': 'How to Read Faster', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'University of South Florida', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Reading and Writing Skills (Education)', 'rank': 2, 'major': 'N'}], 'pub_date': '2020-03-17T09:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Malia Wollan', 'person': [{'firstname': 'Malia', 'middlename': None, 'lastname': 'Wollan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7362fb0-1860-5cbc-808c-0cbf2b38199f', 'word_count': 396, 'uri': 'nyt://article/c7362fb0-1860-5cbc-808c-0cbf2b38199f'}, {'abstract': 'The magazine’s Ethicist columnist on supporting politicians in other districts and states, and what transgender medical providers must disclose to their patients.', 'web_url': 'https://www.nytimes.com/2020/03/17/magazine/is-it-wrong-to-donate-to-candidates-you-cant-vote-for.html', 'snippet': 'The magazine’s Ethicist columnist on supporting politicians in other districts and states, and what transgender medical providers must disclose to their patients.', 'lead_paragraph': 'I have felt uncomfortable with the idea of donating money to candidates in elections in which I have no voting rights — such as senators in states other than my own. I always believed that only those able to vote in an election and who will be directly affected by it have the right to donate to the candidates. It has become clear to me, however, that individual sen