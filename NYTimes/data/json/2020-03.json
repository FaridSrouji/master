': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/multimedia/25-Parenting-legalguardianship/25-Parenting-legalguardianship-articleLarge.jpg', 'height': 451, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/25/multimedia/25-Parenting-legalguardianship/25-Parenting-legalguardianship-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 451}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/multimedia/25-Parenting-legalguardianship/25-Parenting-legalguardianship-jumbo.jpg', 'height': 769, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/multimedia/25-Parenting-legalguardianship/25-Parenting-legalguardianship-superJumbo.jpg', 'height': 1160, 'width': 1544, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/multimedia/25-Parenting-legalguardianship/25-Parenting-legalguardianship-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/25/multimedia/25-Parenting-legalguardianship/25-Parenting-legalguardianship-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/multimedia/25-Parenting-legalguardianship/25-Parenting-legalguardianship-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Becoming Guardian to an Adult Prepared Me for Motherhood', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': 