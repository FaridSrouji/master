vision', 'byline': {'original': 'By Mike Hale', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Hale', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9628cf61-4c55-5e70-adc7-906337d98343', 'word_count': 820, 'uri': 'nyt://article/9628cf61-4c55-5e70-adc7-906337d98343'}, {'abstract': 'Mayor Bill de Blasio said that New York City was taking steps to add hospital beds as the coronavirus outbreak continued to spread.', 'web_url': 'https://www.nytimes.com/2020/03/16/nyregion/coronavirus-new-york-update.html', 'snippet': 'Mayor Bill de Blasio said that New York City was taking steps to add hospital beds as the coronavirus outbreak continued to spread.', 'lead_paragraph': '[This briefing has ended. For the latest updates on the coronavirus outbreak in the New York area, read Tuesday’s live coverage.]', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/16/nyregion/16nyvirus-briefingNEW15/16nyvirus-briefingNEW15-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/16/nyregion/16nyvirus-briefingNEW15/16nyvirus-briefingNEW15-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/16/nyregion/16nyvirus-briefingNEW15/16nyvirus-briefingNEW15-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/16/nyregion/16nyvirus-briefingNEW15/16nyvirus-briefingNEW15-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption