imes', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/11/dining/09Roman1/merlin_167078271_81d10212-0ae9-40e3-9d54-7cdbcdba9963-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/11/dining/09Roman1/merlin_167078271_81d10212-0ae9-40e3-9d54-7cdbcdba9963-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/11/dining/09Roman1/merlin_167078271_81d10212-0ae9-40e3-9d54-7cdbcdba9963-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/11/dining/09Roman1/merlin_167078271_81d10212-0ae9-40e3-9d54-7cdbcdba9963-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/11/dining/09Roman1/09Roman1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/11/dining/09Roman1/09Roman1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/11/dining/09Roman1/09Roman1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Pork Noodle Soup Pulled From Your Pantry', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pork Noodle Soup From the Pantry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Noodles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Soups', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-03-09T21:20:04+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Alison Roman', 'person': [{'firstname': 'Alison', 'middlename': None, 'lastname': 'Roman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c38e9c36-389e-5e69-946a-0e268a75d8b0', 'word_count': 571, 'uri': 'nyt://article/c38e9c36-389e-5e69-946a-0e268a75d8b0'}, {'abstract': 'All of Italy’s 60 million people are coming under restrictions that had earlier applied to the northern part of the country.', 'web_url': 'https://www.nytimes.com/2020/03/09/world/europe/italy-lockdown-coronavirus.html', 'snippet': 'All of Italy’s 60 million people are coming under restrictions that had earlier applied to the northern part of the country.', 'lead_paragraph': 'ROME — Italy on Monday became the first European country to announce severe nationwide limits on travel as the government struggled to stem the spread of a coronavirus outbreak that has hobbled the economy, threatened to overwhelm public health care and killed more people than anywhere outside China.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/09/world/09italy-virus/merlin_170261277_fc769bc3-f3d4-4328-a0b5-a702586da35d-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/09/world/09italy-virus/merlin_170261277_fc769bc3-f3d4-4328-a0b5-a702586da35d-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/09/world/09italy-virus/merlin_170261277_fc7