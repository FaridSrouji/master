ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bfad4792-418c-5f90-8a43-7c2326696f25', 'word_count': 677, 'uri': 'nyt://article/bfad4792-418c-5f90-8a43-7c2326696f25'}, {'abstract': 'You don’t need buttermilk on hand to make biscuits: Just about any soured milk works. Melissa Clark can teach you how.', 'web_url': 'https://www.nytimes.com/2020/03/27/dining/pantry-biscuits-coronavirus.html', 'snippet': 'You don’t need buttermilk on hand to make biscuits: Just about any soured milk works. Melissa Clark can teach you how.', 'lead_paragraph': 'My husband is the family bread baker, turning out burnished, crackling sourdough loaves from our Dutch oven on a weekly basis. But biscuits are my domain. And they’re great to make right now, transforming a few pantry staples into buttery, flaky treats.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/27/dining/27pantryblog/merlin_171029406_ecade57c-068d-4e96-9db3-3d96da6ddbfc-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/27/dining/27pantryblog/merlin_171029406_ecade57c-068d-4e96-9db3-3d96da6ddbfc-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/27/dining/27pantryblog/merlin_171029406_ecade57c-068d-4e96-9db3-3d96da6ddbfc-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/27/dining/27pantryblog/merlin_171029406_ecade57c-068d-4e96-9db3-3d96da6ddbfc-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/27/dining/27pantryblog/merlin_171029406_ecade57c-068d-4e96-9db3-3d96da6ddbfc-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/27/dining/27pantryblog/merlin_171029406_ecade57c-068d-4e96-9db3-3d96da6ddbfc-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/27/dining/27pantryblog/merlin_171029406_ecade57c-068d-4e96-9db3-3d96da6ddbfc-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Few Pantry Staples for a Buttery, Flaky Treat', 'kicker': 'FROM THE PANTRY', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bakeries and Baked Products', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Butter', 'rank': 3, 'major': 'N'}], 'pub_date': '2020-03-27T15:37:18+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Melissa Clark', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Clark', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/860bed8f-c500-50ee-9823-6cfa0ae531ac', 'word_count': 454, 'uri': 'nyt://article/860bed8f-c500-50ee-9823-6cfa0ae531ac'}, {'abstract': 'Distance and solitude can make us feel more isolated than ever — but these tales of far-off locales provide something of a distraction.', 'web_url': 'https://www.nytimes.com/2020/03/27/t-magazine/virtual-travel.html', 'snippet': 'Distance and solitude can make us feel more isolated than ever — but these tales of far-off locales provide something of a distraction.', 'lead_paragraph': 'At a time of global crisis, it can be comforting to remember that, in Los Angeles, waves still break on the Santa Monica beaches, though the usual beachcombers are staying home. In Beijing, the Forbidden City still blankets dozens of acres at the heart of the Chinese capital, despite remaining closed to visitors. And in Paris, I.M. Pei’s glass pyramid still sits serenely outside the Louvre, even if the usual crowds milling around it are missing on account of canceled flights and border restrictions. Dashed travel plans can only be mourned so much, of course, but being cooped up can stoke very real feelings of isolation. Which is why it may also be helpful to remember, right around now, the transporting power of a good story — especially a good travel story. Here are a few of T’s most immersive reads — about alluring places on practically every continent — bound to satiate your wanderlust from a healthy, responsible distance.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/t-magazine/26tmag-hebrides-slide-0ZFQ/26tmag-hebrides-slide-0ZFQ-articleLarge.jpg', 'height': 478, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/26/t-magazine/26tmag-hebrides-slide-0ZFQ/26tmag-hebrides-slide-0ZFQ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 478}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/t-magazine/26tmag-hebrides-slide-0ZFQ/26tmag-hebrides-slide-0ZFQ-jumbo.jpg', 'height': 816, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/26/t-magazine/26tmag-hebrides-slide-0ZFQ/26tmag-hebrides-slide-0ZFQ-superJum