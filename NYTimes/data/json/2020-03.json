'major': 'N'}, {'name': 'glocations', 'value': 'Brazil', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Rio de Janeiro (Brazil)', 'rank': 4, 'major': 'N'}], 'pub_date': '2020-03-16T09:00:08+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Vanessa Barbara', 'person': [{'firstname': 'Vanessa', 'middlename': None, 'lastname': 'Barbara', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e2645dd7-00df-5fa0-bc15-eb01a6e52f1f', 'word_count': 1004, 'uri': 'nyt://article/e2645dd7-00df-5fa0-bc15-eb01a6e52f1f'}, {'abstract': 'Five percent of Americans live in counties where two of three key economic measures were worse in 2019 than 2016.', 'web_url': 'https://www.nytimes.com/2020/03/16/upshot/american-counties-left-behind-trump.html', 'snippet': 'Five percent of Americans live in counties where two of three key economic measures were worse in 2019 than 2016.', 'lead_paragraph': 'Although economists now expect that the coronavirus will lead to a major recession, the American economy improved steadily for nearly a decade, under both President Obama and President Trump.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/16/upshot/16up-kolko-map-1584300475619/16up-kolko-map-1584300475619-articleLarge.png', 'height': 391, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/16/upshot/16up-kolko-map-1584300475619/16up-kolko-map-1584300475619-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/16/upshot/16up-kolko-map-1584300475619/16up-kolko-map-1584300475619-jumbo.png', 'height': 667, 'width': 1024, 'sub