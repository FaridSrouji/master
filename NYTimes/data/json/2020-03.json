': {}}], 'headline': {'main': 'Roosevelt Avenue Goes Dark', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Uncertain Hush Where the Sidewalk Normally Overflows', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Jackson Heights (Queens, NY)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Roosevelt Avenue (Queens, NY)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Woodside (Queens, NY)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Quarantines', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Shutdowns (Institutional)', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-03-25T09:00:21+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Todd Heisler', 'person': [{'firstname': 'Todd', 'middlename': None, 'lastname': 'Heisler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/362fc295-483a-5491-be9e-d48689d60bb4', 'word_count': 344, 'uri': 'nyt://article/362fc295-483a-5491-be9e-d48689d60bb4'}, {'abstract': 'Congress shouldn’t concede more power to this president (or any other). That’s the last thing we need.', 'web_url': 'https://www.nytimes.com/2020/03/25/opinion/trump-executive-authority-covid.html', 'snippet': 'Congress shouldn’t concede more power to this president (or any other). That’s the last thing we need.', 'lead_paragraph': 'Everything about the coronavirus crisis looks and feels like a war that is all the more unsettling because the enemy is invisible and immune to brute force. Yet amid all the signs of conflict — declarations of emergency, mobilizations of National Guard troops, the exercise of extraordinary powers — there is enduring constitutional danger in treating this crisis like a war. When this pandemic is over, generations will have to deal both with its terrible human toll and with the constitutional changes it yields.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/opinion/25GregWeiner2/25GregWeiner2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/25/opinion/25GregWeiner2/25GregWeiner2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/opinion/25GregWeiner2/25GregWeiner2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/opinion/25GregWeiner2/25GregWeiner2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/opinion/25GregWeiner2/25GregWeiner2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2020/03/25/opinion/25GregWeiner2/25GregWeiner2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/25/opinion/25GregWeiner2/25GregWeiner2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Are We Sure We Want to Give Trump War Powers?', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Constitution (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Defense Production Act', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Coronavirus (2019-nCoV)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Madison, James (1751-1836)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 9, 'major': 'N'}], 'pub_date': '2020-03-25T09:00:22+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Greg Weiner', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Weiner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1901b070-4e32-5217-a91f-d382e3428304', 'word_count': 1519, 'uri': 'nyt://article/1901b070-4e32-5217-a91f-d382e3428304'}, {'abstract': 'Drivers have contended with Uber and inflated medallion prices. Now the pandemic has caused rides to plummet by two-thirds or more.', 'web_url': 'https://www.nytimes.com/2020/03/25/nyregion/coronavirus-nyc-taxi-drivers.html', 'snippet': 'Drivers have contended with Uber and inflated medallion prices. Now the pandemic has caused rides to plummet by two-thirds or more.', 'lead_paragraph': 'There are so few travelers left at Kennedy International Airport, one of the world’s busiest airfields, that taxis wait six hours or more for a single passenger.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/23/nyregion/00nyviru