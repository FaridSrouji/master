mericans', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 7, 'major': 'N'}], 'pub_date': '2020-03-23T09:00:18+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sabrina Tavernise and Richard A. Oppel Jr', 'person': [{'firstname': 'Sabrina', 'middlename': None, 'lastname': 'Tavernise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Richard', 'middlename': 'A.', 'lastname': 'Oppel', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/43650030-bd31-59fe-aab7-d3b103e9e3ca', 'word_count': 1670, 'uri': 'nyt://article/43650030-bd31-59fe-aab7-d3b103e9e3ca'}, {'abstract': 'It will if we keep up our current strategy.', 'web_url': 'https://www.nytimes.com/2020/03/23/opinion/coronavirus-depression.html', 'snippet': 'It will if we keep up our current strategy.', 'lead_paragraph': 'Covid-19, the most threatening pandemic of the past century, has precipitated both a health crisis and an economic crisis. The strategies that governments have adopted to deal with each crisis separately are contradictory and risk catastrophic, long-term failure.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/23/opinion/23romerWeb/merlin_170643162_3044988e-002b-4301-81de-c88fcf8154a9-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2020/03/23/opinion/23romerWeb/merlin_170643162_3044988e-002b-4301-81de-c88fcf8154a9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2020/03/23/opinion/23romerWeb/merlin_170643162_3044988e-002b-4301-81de-c88fcf8154a9-jumbo.jpg', 