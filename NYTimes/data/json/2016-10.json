.”', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/06/opinion/06Chigumadzi-inyt/06Chigumadzi-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/06/opinion/06Chigumadzi-inyt/06Chigumadzi-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/06/opinion/06Chigumadzi-inyt/06Chigumadzi-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/06/opinion/06Chigumadzi-inyt/06Chigumadzi-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/06/opinion/06Chigumadzi-inyt/06Chigumadzi-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/06/opinion/06Chigumadzi-inyt/06Chigumadzi-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/06/opinion/06Chigumadzi-inyt/06Chigumadzi-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'White Schools vs. Black Hair in Post-Apartheid South Africa', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'White schools, black hair', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hair', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Apartheid (Policy)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'AFRICAN NATIONAL CONGRESS', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'South Africa', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-10-05T12:57:47+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Panashe Chigumadzi', 'person': [{'firstname': 'Panashe', 'middlename': None, 'lastname': 'Chigumadzi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1ab875ab-5283-50df-80be-f7d0461c6277', 'word_count': 1165, 'uri': 'nyt://article/1ab875ab-5283-50df-80be-f7d0461c6277'}, {'abstract': 'A log house in North Carolina, an old farmhouse in Virginia and a water view in Washington', 'web_url': 'https://www.nytimes.com/slideshow/2016/10/09/realestate/what-you-get-for-1000000.html', 'snippet': 'A log house in North Carolina, an old farmhouse in Virginia and a water view in Washington', 'lead_paragraph': 'A log house in North Carolina, an old farmhouse in Virginia and a water view in Washington', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/realestate/09WYG-slide-EX09/09WYG-slide-EX09-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/09/realestate/09WYG-slide-EX09/09WYG-slide-EX09-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'ima