redit': None, 'type': 'image', 'url': 'images/2016/10/04/sports/04-Y-GOLF/04-Y-GOLF-superJumbo.jpg', 'height': 1433, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'France’s Hope for 2018 Ryder Cup: If We Host It, They Will Come', 'kicker': 'On Golf', 'content_kicker': None, 'print_headline': 'France’s Hope for 2018 Ryder Cup: If We Host It, They Will Come', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clarey, Christopher', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Golf', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Ryder Cup (Golf)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-04T00:49:26+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Christopher Clarey', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Clarey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/20880b67-b3cf-5452-aa7c-8faf15f29c01', 'word_count': 1111, 'uri': 'nyt://article/20880b67-b3cf-5452-aa7c-8faf15f29c01'}, {'abstract': 'More than 500,000 individual taxpayers took advantage of the same tax rule as Mr. Trump in 1995. Their average loss: just $97,600.', 'web_url': 'https://www.nytimes.com/2016/10/04/us/politics/donald-trump-taxes.html', 'snippet': 'More than 500,000 individual taxpayers took advantage of the same tax rule as Mr. Trump in 1995. Their average loss: just $97,600.', 'lead_paragraph': 'It is among the least controversial parts of the federal tax code, almost as old as the income tax itself: A business, big or small, can escape taxation if it lost money in a previous year, a rule that helps businesses weather tough economic times, and hopefully thrive again.', 'print_sectio