V/11TAYLORMACSS-slide-RTJV-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/arts/11TAYLORMACSS-slide-RTJV/11TAYLORMACSS-slide-RTJV-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Taylor Mac’s Pop Marathon', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mac, Taylor', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'A 24-Decade History of Popular Music (Play)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': "St Ann's Warehouse (Brooklyn, NY)", 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-10T21:28:03+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/993c63c2-02a3-5d76-b492-dddadb1a26a2', 'word_count': 0, 'uri': 'nyt://slideshow/993c63c2-02a3-5d76-b492-dddadb1a26a2'}, {'abstract': 'I’ve slept on it, and I’m sure. “A 24-Decade History of Popular Music” is sublime.', 'web_url': 'https://www.nytimes.com/2016/10/11/theater/review-taylor-macs-24-hour-concert-was-one-of-the-great-experiences-of-my-life.html', 'snippet': 'I’ve slept on it, and I’m sure. “A 24-Decade History of Popular Music” is sublime.', 'lead_paragraph': 'So after almost 21½ hours and two centuries’ worth of singing, dancing, and jiggling; after all 650 of us had been asked to re-enact everything from the Civil War and the Oklahoma land rush to white flight to the suburbs; after a narcotically swampy rendition of “Amazing Grace” and a production of “The Mikado” that glowed in the dark because its minstrelsy might make sense if it was set on Mars; after visionary drag-queen costumes that called to mind descriptions like geisha Andrews Sister and Tiki apocalypse; after we’d stood in lines for small portions of bread and split pea soup at 3 a.m. and not many people took the bread (because even during a poignant Depression homage some people will still refuse to eat a carb); after we’d batted around an enormous stars-and-stripes penis balloon whose design really did look more like the flag of Puerto Rico and then made a funeral procession for Judy Garland’s corpse; after a mash-up of the Bee Gees’ “Stayin’ Alive” and Led Zeppelin’s “Kashmir”; after Taylor Mac, the performance artist who dreamed this whole thing up, had cavorted onstage and in the laps and arms of strangers; after all of this — the delirium, the mania, the possibly simulated sex — it might have been the balloon that broke us.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/arts/11TAYLORMACSS-slide-5DMN/11TAYLORMACSS-slide-5DMN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/10/arts/11TAYLORMACSS-slide-5DMN/11TAYLORMACSS-slide-5DMN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/arts/11TAYLORMACSS-slide-5DMN/11TAYLORMACSS-slide-5DMN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/arts/11TAYLORMACSS-slide-5DMN/11TAYLORMACSS-slide-5DMN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/10/arts/11TAYLORMACSS-slide-5DMN/11TAYLORMACSS-slide-5DMN-articl