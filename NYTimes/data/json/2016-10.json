5/tiblisi-designers-slide-0CP5-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-0CP5/tiblisi-designers-slide-0CP5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-0CP5/tiblisi-designers-slide-0CP5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-0CP5/tiblisi-designers-slide-0CP5-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Home and Work: Nata Janberidze and Keti Toloraia', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Georgia (Georgian Republic)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Tbilisi (Georgian Republic)', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-10-10T19:19:02+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/790d4075-1f85-579c-9d2e-0705fb705577', 'word_count': 0, 'uri': 'nyt://slideshow/790d4075-1f85-579c-9d2e-0705fb705577'}, {'abstract': 'Nata Janberidze and Keti Toloraia draw inspiration from their Soviet past — to make beautiful, timeless things. Here, inside their homes and studio.', 'web_url': 'https://www.nytimes.com/2016/10/10/t-magazine/design/rooms-nata-janberidze-keti-toloraia.html', 'snippet': 'Nata Janberidze and Keti Toloraia draw inspiration from their Soviet past — to make beautiful, timeless things. Here, inside their homes and studio.', 'lead_paragraph': 'Strictly speaking, Nata Janberidze and Keti Toloraia began their creative collaboration in a vacuum. When they started designing objects and interiors a \xaddecade ago, fresh out of art school, their hometown Tbilisi, the capital of Georgia, a small country on the Black Sea that spent much of the 20th century as part of the Soviet Union, had no creative community for two young designers to gain inspiration from, or any local market for the one-of-a-kind groundbreaking pieces they designed under the distinctly Western, purposefully plain name Rooms.', 'print_section': 'M2', 'print_page': '124', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-JVPY/tiblisi-designers-slide-JVPY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-JVPY/tiblisi-designers-slide-JVPY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-JVPY/tiblisi-designers-slide-JVPY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-JVPY/tiblisi-designers-slide-JVPY-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/10/t-magazine/tiblisi-designers-slide-