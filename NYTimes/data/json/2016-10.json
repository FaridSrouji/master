': 'images/2016/10/04/sports/04-DRESS-METS/04-DRESS-METS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/04/sports/04-DRESS-METS/04-DRESS-METS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/sports/04-DRESS-METS/04-DRESS-METS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/sports/04-DRESS-METS/04-DRESS-METS-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/04/sports/04-DRESS-METS/04-DRESS-METS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/sports/04-DRESS-METS/04-DRESS-METS-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/sports/04-DRESS-METS/04-DRESS-METS-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Terry Collins, Author of Mets’ Playoff Run, Acts as an Open Book', 'kicker': None, 'content_kicker': None, 'print_headline': 'Author of Mets’ Run Acts as Open Book', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wagner, James', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Collins, Terry L', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Bruce, Jay (1987- )', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-04T01:05:59+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By James Wagner', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Wagner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aeeccc30-e232-514a-b620-1c592f6e5963', 'word_count': 1284, 'uri': 'nyt://article/aeeccc30-e232-514a-b620-1c592f6e5963'}, {'abstract': 'No ordinary citizen could benefit from the tax code like Donald Trump did, and his tax proposal would give people like him even more advantages.', 'web_url': 'https://www.nytimes.com/2016/10/04/opinion/mr-trumps-government-bailout.html', 'snippet': 'No ordinary citizen could benefit from the tax code like Donald Trump did, and his tax proposal would give people like him even more advantages.', 'lead_paragraph': 'For more than a year, Donald Trump has said his genius as a businessman makes him uniquely qualified to fix the country’s problems. We can dispense with that fiction now that we know that he claimed a $916 million loss on his 1995 tax returns. Such a mammoth loss amounts to an epic failure, not runaway success.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/opinion/04tue1web/04tue1web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/04/opinion/04tue1web/04tue1web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'imag