5/t-magazine/entertainment/jenny-hval-slide-ZGSJ/jenny-hval-slide-ZGSJ-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-ZGSJ/jenny-hval-slide-ZGSJ-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-ZGSJ/jenny-hval-slide-ZGSJ-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-ZGSJ/jenny-hval-slide-ZGSJ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-ZGSJ/jenny-hval-slide-ZGSJ-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-ZGSJ/jenny-hval-slide-ZGSJ-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Micki Pellerano Reads Jenny Hval’s Tarot', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-10-06T16:19:27+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Entertainment', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/3b762db5-02b4-5af7-a8fd-abb2d58b5e94', 'word_count': 0, 'uri': 'nyt://slideshow/3b762db5-02b4-5af7-a8fd-abb2d58b5e94'}, {'abstract': 'The musician Jenny Hval visited the performer (and occultist) Micki Pellerano at his Greenpoint, Brooklyn, home for a little insight — and brought T along.', 'web_url': 'https://www.nytimes.com/2016/10/06/t-magazine/entertainment/jenny-hval-blood-bitch-tarot.html', 'snippet': 'The musician Jenny Hval visited the performer (and occultist) Micki Pellerano at his Greenpoint, Brooklyn, home for a little insight — and brought T along.', 'lead_paragraph': 'On “Blood Bitch,” Jenny Hval’s beguiling new album, the avant-garde musician sings about menstruation and vampires, blood and politics. A spiritual successor to Kate Bush, Arthur Russell and Björk, Hval uses her breathy voice, programmed beats and Arp Odyssey synthesizer to invoke a pop cosmogony of feminism, humor, sensuality and noise. “It really is a subconscious album,” she says. “I think that I’m probably a little too good with the intellectual side of things after I’ve finished an album. I make it all up.” The music on “Blood Bitch” is an elemental experience; one can imagine moon cycles guiding rhythms, or the tides inspiring its looping melodies. Which is why it’s a surprise that, until very recently, Hval knew almost nothing about astrology.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-1WZM/jenny-hval-slide-1WZM-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-1WZM/jenny-hval-slide-1WZM-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-1WZM/jenny-hval-slide-1WZM-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-1WZM/jenny-hval-slide-1WZM-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-1WZM/jenny-hval-slide-1WZM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-1WZM/jenny-hval-slide-1WZM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/t-magazine/entertainment/jenny-hval-slide-1WZM/jenny-hval-slide-1WZM-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Brooklyn Artist Reads a Norwegian Singer’s Tarot', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Occult Sciences', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Astrology', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hval, Jenny (1980- )', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-06T16:19:31+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Entertainment', 'byline': {'original': 'By Nathan Reese', 'person': [{'firstname': 'Nathan', 'middlename': None, 'lastname': 'Reese', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/250f0e7b-0dac-5e22-b725-9dcee7a26db8', 'word_count': 720, 'uri': 'nyt://article/250f0e7b-0dac-5e22-b725-9dcee7a26db8'}, {'abstract': 'The envoy, Staffan de Mistura, who made the offer as part of a new truce proposal, voiced despair over the relentless bombing of the city.', 'web_url': 'https://www.nytimes.com/2016/10/07/world/middleeast/aleppo-syria-staffan-de-mistura.html', 'snippet': 'The envoy, Staffan de Mistura, who made the offer as part of a new truce proposal, voiced despair over the relentless bombing of the city.', 'lead_paragraph': 'GENEVA — The top United Nations diplomat for the Syria conflict proposed a new truce on Thursday, in hopes of averting what he called the destruction of rebel-held eastern Aleppo by Russian and Syrian forces. He offered to personally escort the jihadist fighters in the area to safety if the bombing is halted.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/world/07aleppo-web1/07aleppo-web1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/07/world/07aleppo-web1/07aleppo-web1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/world/07aleppo-web1/07aleppo-web1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/world/07aleppo-web1/07aleppo-web1-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/07/world/07aleppo-web1/07aleppo-web1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 