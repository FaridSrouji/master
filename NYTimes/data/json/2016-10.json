tions', 'value': 'TD Ameritrade Holding Corp.', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Toronto Dominion Bank', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-10-24T19:22:43+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Antony Currie', 'person': [{'firstname': 'Antony', 'middlename': None, 'lastname': 'Currie', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3ff9f907-1742-5993-b9fe-f3a77cb07052', 'word_count': 384, 'uri': 'nyt://article/3ff9f907-1742-5993-b9fe-f3a77cb07052'}, {'abstract': 'Medicc, a nonprofit, writes that the embargo has “stymied mutual work on critical health problems, like Zika.”', 'web_url': 'https://www.nytimes.com/2016/10/25/opinion/us-cuba-health-collaboration.html', 'snippet': 'Medicc, a nonprofit, writes that the embargo has “stymied mutual work on critical health problems, like Zika.”', 'lead_paragraph': 'To the Editor:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S.-Cuba Health Collaboration', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-10-24T19:22:49+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/07deea55-2824-5540-be46-6bff6c80d267', 'word_count': 207, 'uri': 'nyt://article/07deea55-2824-5540-be46-6bff6c80d267'}, {'abstract': 'At three large rental buildings on the Upper West Side of Manhattan, a movement is underway to rid the properties of Donald J. Trump’s name.', 'web_url': 'https: