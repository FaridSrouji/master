 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Scenes of New York', 'kicker': 'The Look', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New York City', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-10-15T10:00:21+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/7b3ee20a-71d6-59cb-9616-6d8fd5832564', 'word_count': 0, 'uri': 'nyt://slideshow/7b3ee20a-71d6-59cb-9616-6d8fd5832564'}, {'abstract': 'It’s stylish — but don’t call it street style.', 'web_url': 'https://www.nytimes.com/2016/10/16/fashion/street/the-look-scenes-new-york-city.html', 'snippet': 'It’s stylish — but don’t call it street style.', 'lead_paragraph': 'The photographer of this series, Daniel Weiss, 29, was born in New York City and grew up on the Upper West Side. He had two big interests, which fed each other: skateboarding and photography.', 'print_section': 'ST', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'As Seen on the Streets', 'kicker': 'The Look', 'content_kicker': None, 'print_headline': 'As Seen on  the Streets', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-15T10:00:25+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/2236afda-6bce-54d0-8234-440cd24dfab5', 'word_count': 99, 'uri': 'nyt://article/2236afda-6bce-54d0-8234-440cd24dfab5'}, {'abstract': 'The reverend’s intellectualism and distinctive brand of man-up Christianity draws a wide audience to his church, the largest in New York.', 'web_url': 'https://www.nytimes.com/2016/10/16/style/reverend-ar-bernard-new-york-megachurch.html', 'snippet': 'The reverend’s intellectualism and distinctive brand of man-up Christianity draws a wide audience to his church, the largest in New York.', 'lead_paragraph': 'One Saturday in mid-September, the Rev. A. R. Bernard took to the blue carpeted stage of the Christian Cultural Center, the 96,000-square-foot megachurch he built 16 years ago at the edge of Starrett City, in Brooklyn, with his usual accouterments: a smartphone, a bottle of water and a large glass marker board that he would soon cover in bullet points drawn from the playbooks of marketing specialists. Mr. Bernard, 63, is tall and slender, and on this day he wore a distressed black leather jacket, a white polo shirt, bluejeans and white tennis shoes — casual Saturday attire. On Sunday, you would find him impeccably tailored in a light wool suit and tortoiseshell glasses, looking more like the banker he once was than the pastor of a congregation of nearly 40,000.', 'print_section': 'ST', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/16/fashion/16BERNARD1/16BERNARD1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/16/fashion/16BERNARD1/16BERNARD1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/16/fashion/16BERNARD1/16BERNARD1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumb