 'major': 'N'}], 'pub_date': '2016-10-15T18:52:39+0000', 'document_type': 'multimedia', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By REUTERS', 'person': [], 'organization': 'REUTERS'}, 'type_of_material': 'Video', '_id': 'nyt://video/34cb70f6-2744-5313-bd58-d08e415ac2cf', 'word_count': 0, 'uri': 'nyt://video/34cb70f6-2744-5313-bd58-d08e415ac2cf'}, {'abstract': 'The crown prince has asked that King Bhumibol’s cremation be held after a one-year period of mourning, with his own coronation to come later, an official said.', 'web_url': 'https://www.nytimes.com/2016/10/16/world/asia/thailand-king-bhumibol-adulyadej-death-cremation.html', 'snippet': 'The crown prince has asked that King Bhumibol’s cremation be held after a one-year period of mourning, with his own coronation to come later, an official said.', 'lead_paragraph': 'BANGKOK — The cremation of Bhumibol Adulyadej, the revered Thai king who died Thursday, will not take place for at least a year, a top official said Saturday, with the crown prince’s coronation expected to occur some time after that.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Thailand Says Bhumibol’s Cremation Is a Year Away, With Heir’s Coronation to Follow', 'kicker': None, 'content_kicker': None, 'print_headline': 'Year May Pass Before Thais Have New King ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Thailand', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bhumibol Adulyadej', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Vajiralongkorn (1952- )', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Royal Families', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Bangkok (Thailand)', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-15T18:56:44+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsecti