trees/opdoc-taller-than-trees-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/multimedia/opdoc-taller-than-trees/opdoc-taller-than-trees-superJumbo.jpg', 'height': 1080, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/multimedia/opdoc-taller-than-trees/opdoc-taller-than-trees-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/05/multimedia/opdoc-taller-than-trees/opdoc-taller-than-trees-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/multimedia/opdoc-taller-than-trees/opdoc-taller-than-trees-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Taller Than the Trees', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Japan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Alzheimer's Disease", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Dementia', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Tokyo (Japan)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-06T20:07:17+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'byline': {'original': 'By Megan Mylan', 'person': [{'firstname': 'Megan', 'middlename': None, 'lastname': 'Mylan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/db22f119-968b-53ad-ae5f-470c5fec5e2a', 'word_count': 0, 'uri': 'nyt://video/db22f119-968b-53ad-ae5f-470c5fec5e2a'}, {'abstract': 'Japanese men haven’t traditionally been caregivers. But for Masami Hayata, it’s a crucial part of raising his family.', 'web_url': 'https://www.nytimes.com/2016/10/06/opinion/taller-than-the-trees.html', 'snippet': 'Japanese men haven’t traditionally been caregivers. But for Masami Hayata, it’s a crucial part of raising his family.', 'lead_paragraph': 'Japan is a hyper-aging society. People are living longer, and the birthrate is extremely low. For a culture steeped in oya-koko, or filial piety, fewer children has led to a crisis in caregiving. Elder care has traditionally fallen to family members and specifically to daughters and daughters-in-law. With more women working, an unprecedented number of men are breaking with tradition to take hands-on caregiving responsibilities for their families. They often do so in the prime of their careers and many are unable to reconcile their devotion to family with Japan’s intensely competitive workplace culture.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Taller Than the Trees', 'kicker': 'Op-Docs', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Families and Family Life', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Work-Life Balance', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-10-06T20:07:29+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Megan Mylan', 'person': [{'firstname': 'Megan', 'middlename': None, 'lastname': 'Mylan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/bf82e20e-2019-5333-8f34-070f65c3a5a4', 'word_count': 567, 'uri': 'nyt://article/bf82e20e-2019-5333-8f34-070f65c3a5a4'}, {'abstract': 'Ahead of the first Paris Wine Weekend, here are some of the top young producers to know, by region.', 'web_url': 'https://www.nytimes.com/2016/10/06/t-magazine/food/new-french-winemakers-paris-wine-weekend.html', 'snippet': 'Ahead of the first Paris Wine Weekend, here are some of the top young producers to know, by region.', 'lead_paragraph': 'Wine may have always been a cornerstone of French culture and gastronomy, but today, the industry is experiencing a marked wave of change, driven largely by up-and-coming producers. Josh Adler, owner of the four-year-old Paris Wine Company, a Paris-based wine exporter with a special focus on young producers, says it’s truly the golden age of winemaking in France. “You see people taking over family domaines or starting their own, despite the inherent challenges. On top of that, they’re focused on organic farming and all natural wines.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/06/t-magazine/travel/06tmag-french-winemakers-slide-FODT/06tmag-french-winemakers-slide-FODT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/06/t-magazine/travel/06tmag-french-winemakers-slide-FODT/06tmag-french-winemakers-slide-FODT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/06/t-magazine/travel/06tmag-french-winemakers-slide-FODT/06tmag-french-winemakers-slide-FODT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'ca