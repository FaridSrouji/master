, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/fashion/07FOURQUESTIONS1/07FOURQUESTIONS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/fashion/07FOURQUESTIONS1/07FOURQUESTIONS1-articleLarge.jpg', 'height': 750, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/07/fashion/07FOURQUESTIONS1/07FOURQUESTIONS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/fashion/07FOURQUESTIONS1/07FOURQUESTIONS1-jumbo.jpg', 'height': 1024, 'width': 819, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/fashion/07FOURQUESTIONS1/07FOURQUESTIONS1-superJumbo.jpg', 'height': 2048, 'width': 1638, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Steven Alan’s Goals: Subtlety and Quality', 'kicker': 'Four Questions', 'content_kicker': None, 'print_headline': 'The Designer Around the (Global) Corner', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Alan, Steven', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-10-03T16:01:29+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'subsection_name': 'Men’s Style', 'byline': {'original': 'By Max Berlinger', 'person': [{'firstname': 'Max', 'middlename': None, 'lastname': 'Berlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/642910aa-5e42-5544-8ac6-9ba3d50c4f80', 'word_count': 358, 'uri': 'nyt://article/642910aa-5e42-5544-8ac6-9ba3d50c4f80'}, {'abstract': 'Bruto Americano is a brash American take on the aperitif.', 'web_url': 'https://www.nytimes.com/2016/10/05/dining/bruto-americano-aperitif-st-george.html', 'snippet': 'Bruto Americano is a brash American take on the aperitif.', 'lead_paragraph': 'The initial attack in this garnet-hued aperitif from St. George Spirits, an artisanal producer in California, is deceptively sweet. Then gradually, the complex layers of flavor unfold, ending with a bitter swagger. There are hints of citrus — Seville oranges are what the company uses — as well as herbaceous notes. It’s an American take on typical Italian aperitifs like Campari: Bruto Americano, $29.99, Astor Wines and Spirits, 212-674-7500, astorwines.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/dining/05BURNER-APERITIF-WEB/05BURNER-APERITIF-WEB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/05/dining/05BURNER-APERITIF-WEB/05BURNER-APERITIF-WEB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/dining/05BURNER-APERITIF-WEB/05BURNER-APERITIF-WEB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/dining/05BURNER-APERITIF-WEB/05BURNER-APERITIF-WEB-articleLarge.jpg', 'height': 1307, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge'