': 'multimedia', 'news_desk': 'Obituaries', 'section_name': 'Obituaries', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/5382a442-3ed1-55ff-8819-604973f8c98a', 'word_count': 0, 'uri': 'nyt://slideshow/5382a442-3ed1-55ff-8819-604973f8c98a'}, {'abstract': 'The 12-year-old’s tale of survival gained him fame and honors and was turned into a book that became required reading for schoolchildren in the state.', 'web_url': 'https://www.nytimes.com/2016/10/12/us/donn-fendler-who-was-lost-in-wilds-of-maine-as-a-boy-dies-at-90.html', 'snippet': 'The 12-year-old’s tale of survival gained him fame and honors and was turned into a book that became required reading for schoolchildren in the state.', 'lead_paragraph': 'July 1939. The world teetered on the brink of war as Hitler menaced Poland. The 11 millionth visitor passed through the turnstiles of the New York World’s Fair. Baseball fans still reeled after Lou Gehrig’s “luckiest man” speech at Yankee Stadium.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Donn Fendler, Who Was Lost in Wilds of Maine as a Boy, Dies at 90', 'kicker': None, 'content_kicker': None, 'print_headline': 'Donn Fendler, 90, Dies; Became Lost for Days in Maine’s Wilds as Boy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Maine', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Mount Katahdin (Me)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Rye (NY)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Missing Persons', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Fendler, Donn (1926-2016)', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-10-12T01:23:15+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'B