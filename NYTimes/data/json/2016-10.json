, 'kicker': None, 'content_kicker': None, 'print_headline': 'Clinton Hopes for a Mandate and Coattails', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gabriel, Trip', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ohio', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'North Carolina', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Pennsylvania', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, House of Representatives', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 12, 'major': 'N'}], 'pub_date': '2016-10-21T21:14:31+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Trip Gabriel and Ashley Parker', 'person': [{'firstname': 'Trip', 'middlename': None, 'lastname': 'Gabriel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Ashley', 'middlename': None, 'lastname': 'Parker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/386f688d-7f0d-51f1-ada3-fc13ca19725f', 'word_count': 1249, 'uri': 'nyt://article/386f688d-7f0d-51f1-ada3-fc13ca19725f'}, {'abstract': 'The Center for Contemporary Opera staged a combined production of Louis Andriessen’s “Anaïs Nin” and “Odysseus’ Women,” as well as Louis Karchin’s “Jane Eyre.”', 'web_url': 'https://www.nytimes.com/2016/10/22/arts/music/review-when-anais-met-circe-and-other-operatic-adventures.html', 'snippet': 'The Center for Contemporary Opera staged a combined production of Louis Andriessen’s “Anaïs Nin” and “Odysseus’ Women,” as well as Louis Karchin’s “Jane Eyre.”', 'lead_paragraph': 'For 34 seasons, the Center for Contemporary Opera has been grappling with what opera can be today. This genre has evolved over centuries, along with musical and theatrical styles. Yet shouldn’t certain basic elements of the art form remain?', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/24/arts/24OPERA1/24OPERA1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/24/arts/24OPERA1/24OPERA1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/24/arts/24OPERA1/24OPERA1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/24/arts/24OPERA1/24OPERA1-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/24/arts/24OPERA1/24OPERA1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/24/arts/24OPERA1/24OPERA1-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/24/arts/24OPERA1/24OPERA1-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'supe