e': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/17/opinion/17LbrooksWeb/17LbrooksWeb-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The Inner World of Donald Trump', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'The Inner World of Donald Trump', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Narcissism', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brooks, David', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-17T07:21:06+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/c19923ac-a3a0-5da5-a8c3-1dd23fbe7d4b', 'word_count': 534, 'uri': 'nyt://article/c19923ac-a3a0-5da5-a8c3-1dd23fbe7d4b'}, {'abstract': 'The foes of the Consumer Financial Protection Bureau have little to celebrate their putative victory over the agency.', 'web_url': 'https://www.nytimes.com/2016/10/17/opinion/a-consumer-watchdog-lives-for-another-day.html', 'snippet': 'The foes of the Consumer Financial Protection Bureau have little to celebrate their putative victory over the agency.', 'lead_paragraph': 'The Consumer Financial Protection Bureau, which has had an enormously beneficial effect on consumers since it began operating in 2011, has survived the latest legal challenge to its existence with its powers intact.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/15/opinion/17mon2web/17mon2web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subTy