24, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/science/21TB-dinosaur2/21TB-dinosaur2-superJumbo.png', 'height': 1448, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Meet the New Titanosaur. You Can Call It Wade.', 'kicker': 'Trilobites', 'content_kicker': None, 'print_headline': 'A New Angle: Planet Nine in Outer Space', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dinosaurs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Paleontology', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-20T20:49:55+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Nicholas St. Fleur', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'St', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c8eb45fc-e54e-5de9-b1fc-22a8e6dd404a', 'word_count': 698, 'uri': 'nyt://article/c8eb45fc-e54e-5de9-b1fc-22a8e6dd404a'}, {'abstract': 'On Thursday, the Brooklyn district attorney’s office charged a woman in a so-called “blessing scam,” a scheme targeting Chinese immigrants.', 'web_url': 'https://www.nytimes.com/2016/10/21/nyregion/chinese-blessing-scam-arrests.html', 'snippet': 'On Thursday, the Brooklyn district attorney’s office charged a woman in a so-called “blessing scam,” a scheme targeting Chinese immigrants.', 'lead_paragraph': 'A 61-year-old Brooklyn resident from China was walking on the street one day in April when a woman approached her and struck up a friendly conversation in Cantonese. She claimed to be a clairvoyant, and then she delivered a dire warning. “You or a family member will die soon because of a curse,” she said.', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/nyregion/21BLESSING1/21BLESSING1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/21/nyregion/21BLESSING1/21BLESSING1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/nyregion/21BLESSING1/21BLESSING1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/nyregion/21BLESSING1/21BLESSING1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/21/nyregion/21BLESSING1/21BLESSING1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/nyregion/21BLESSING1/21BLESSING1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/nyregion/21BLESSING1/21BLESSING1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In a Promise to Lift a Curse, a Scheme to Steal Chinese Immigrants’ Savings', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lured by a Blessing, Chinese Immigrants Lose Their Savings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chinese-Americans', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Robbins, Liz', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Elderly', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Robberies and Thefts', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Hate Crimes', 'rank': 11, 'major': 'N'}], 'pub_date': '2016-10-20T20:52:58+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Liz Robbins', 'person': [{'firstname': 'Liz', 'middlename': None, 'lastname': 'Robbins', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/de850fd5-35b9-5a91-baae-2ca78baae8b1', 'word_count': 1043, 'uri': 'nyt://article/de850fd5-35b9-5a91-baae-2ca78baae8b1'}, {'abstract': 'Kiyoshi Kurosawa’s movie, blends elements of a detective story, horror film, domestic drama and psychological thriller to create a kind of existential dread.', 'web_url': 'https://www.nytimes.com/2016/10/21/movies/creepy-review.html', 'snippet': 'Kiyoshi Kurosawa’s movie, blends elements of a detective story, horror film, domestic drama and psychological thriller to create a kind of existential dread.', 'lead_paragraph': 'A spine-tingler about love and death, the allure of mystery and its perils, “Creepy” is the latest from the prolific Japanese director Kiyoshi Kurosawa. True to its English-language title, the movie is thoroughly and utterly creepy, partly because Mr. Kurosawa knows how to slither under your skin, but also because his movies transcend the classifications (and limits) valued by critics and content providers. “Creepy” certainly works — looks and feels — like a horror movie, but it also has the conundrums of a detective story, the emotional currents of a domestic drama and the quickening pulse of a psychological thriller, a combination that creates a kind of destabilization. So, what is this movie, exactly?', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/arts/21-CREEPY/21-CREEPY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/21/arts/21-CREEPY/21-CREEPY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/arts/21-CREEPY/21-CREEPY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/arts/21-CREEPY/21-CREEPY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/21/arts/21-CREEPY/21-CREEPY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/arts/21-CREEPY/21-CREEPY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/arts/21-CREEPY/21-CREEPY-superJumbo.jpg', 'height': 1199, 'width': 1798, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Creepy,’ a Cold Case Turns Red Hot, but Don’t Tell the Neighbors', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Cold Case Turns Red Hot, but Don’t Tell the Neighbors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Creepy (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kurosawa, Kiyoshi', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-10-20T20:55:44+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/ce25c3ed-b31c-5d03-b87c-af84b14bf7ea', 'word_count': 812, 'uri': 'nyt://article/ce25c3ed-b31c-5d03-b87c-af84b14bf7ea'}, {'abstract': 'Wunderkammers were once a way for scholars and aristocrats to show off their impressive objects. Now, they’re prized by galleries and museums.', 'web_url': 'https://www.nytimes.com/2016/10/20/t-magazine/art/georg-laue-tefaf-wunderkammer.html', 'snippet': 'Wunderkammers were once a way for scholars and aristocrats to show off their impressive objects. Now, they’re prized by galleries and museums.', 'lead_paragraph': 'At the beginning of the Renaissance, in the 16th century, aristocrats and scholars began to fill rooms with exotic artifacts from far-flung territories — horns said to have belonged to unicorns, brilliant red coral, animal skeletons, chalices made of silver or coconut shells — often displayed among Old Master paintings and sculptures. Over time, the practice of collecting items for one’s “wunderkammer” (“cabinet of wonders”) became more and more elaborate. Kings would gift extraordinary objects to other rulers to impress them with their wealth, such as a windup automaton that poured wine or a boat carved of gold and set with hundreds of precious stones. Perhaps one of the world’s greatest collections, which still exists, is the Green Vault, the treasure chamber of August the Strong, which reopened to the public in Dresden in 2004 and contains thousands of objects, from a cherry stone carved with over a hundred faces to the largest green-hued diamond in the world.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/t-magazine/19tmag-curiosities-slide-VMAP/19tmag-curiosities-slide-VMAP-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/20/t-magazine/19tmag-curiosities-slide-VMAP/19tmag-curiosities-slide-VMAP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/t-magazine/19tmag-curiosities-slide-VMAP/19tmag-curiosities-slide-VMAP-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/t-magazine/19tmag-curiosities-slide-VMAP/19tmag-curiosities-slide-VMAP-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/t-magazine/19tmag-curiosities-slide-VMAP/19tmag-curiosities-slide-VMAP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/20/t-magazine/19tmag-curiosities-slide-VMAP/19tmag-curiosities-slide-VMAP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'ca