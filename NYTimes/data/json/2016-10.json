tion': None}, 'type_of_material': 'News', '_id': 'nyt://article/3306909f-2a45-52a3-80f6-7f77ba55377f', 'word_count': 1276, 'uri': 'nyt://article/3306909f-2a45-52a3-80f6-7f77ba55377f'}, {'abstract': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'web_url': 'https://www.nytimes.com/2016/10/17/business/treasury-auctions-set-for-the-week-of-oct-17.html', 'snippet': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'lead_paragraph': 'The Treasury’s schedule of financing this week includes Monday’s regular weekly auction of new three- and six-month bills and an auction of four-week bills on Tuesday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Treasury Auctions Set for the Week of Oct. 17', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.S. Treasury Auctions to Be Held the Week of Oct. 17', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Municipal Bonds', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Government Bonds', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-10-16T21:47:04+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3ea5ac40-6a2f-5efb-bded-950aaf7a3842', 'word_count': 1063, 'uri': 'nyt://article/3ea5ac40-6a2f-5efb-bded-950aaf7a3842'}, {'abstract': 'Pamela J. Joyner is on a mission to bring more attention to artists who have been overlooked and to help develop the careers of others.', 'web_url': 'https://www.nytimes.com/2016/10/17/arts/design/righting-wrongs-and-generating-attention-for-art-of-the-african-diaspora.html', 'snippet': 'Pamela J. Joyner is on a mission to bring more attention to artists who have been overlooked and to help develop the careers of others.', 'lead_paragraph': 'Sheena Wagstaff, chairwoman of the Metropolitan Museum of Art’s modern and contemporary art department, was relatively new on the job in 2013 when Pamela J. Joyner, a prolific art collector and supporter of artists of African descent, invited her on a trip to Washington to visit the studio of the Color Field painter Sam Gilliam. They looked at Mr. Gilliam’s in-progress pieces, a series of striking works with a thin stream of paint poured on board.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/17/arts/17JOYNER1/17JOYNER1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/17/arts/17JOYNER1/17JOYNER1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/17/arts/17JOYNER1/17JOYNER1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/17/arts/17JOYNER1/17JOYNER1-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/17/arts/17JOYNER1/17JOYNER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/17/arts/17JOYNER1/17JOYNER1-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/17/arts/17JOYNER1/17JOYNER1-superJumbo.jpg', 'height': 1359, 'width': 2048, 'subTy