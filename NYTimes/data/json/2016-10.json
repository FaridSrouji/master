k': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Confessore, Nicholas', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Income Tax', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Credits, Deductions and Exemptions', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Shelters', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-10-04T00:57:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore and Binyamin Appelbaum', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d739ac1-0a65-5aec-a48d-c02f7a3ca597', 'word_count': 1241, 'uri': 'nyt://article/6d739ac1-0a65-5aec-a48d-c02f7a3ca597'}, {'abstract': 'Tax forms and public records show how debt that Mr. Trump amassed fueled enormous losses.', 'web_url': 'https://www.nytimes.com/2016/10/04/nyregion/donald-trump-taxes-debt.html', 'snippet': 'Tax forms and public records show how debt that Mr. Trump amassed fueled enormous losses.', 'lead_paragraph': 'Abraham Wallach thought he had scored a major career break when Donald J. Trump hired him in 1990 for a senior executive role. Based on Mr. Trump’s boasting and gaudy lifestyle, Mr. Wallach imagined he would soon be leading impressive construction projects around the globe.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/nyregion/04TRUMPLOSSES1/04TRUMPLOSSES1-thumbStanda