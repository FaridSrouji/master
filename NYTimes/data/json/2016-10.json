nail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/11/insider/11insider-askpenny/11insider-askpenny-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/11/insider/11insider-askpenny/11insider-askpenny-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/11/insider/11insider-askpenny/11insider-askpenny-articleLarge.jpg', 'height': 397, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/11/insider/11insider-askpenny/11insider-askpenny-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 397}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/11/insider/11insider-askpenny/11insider-askpenny-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/11/insider/11insider-askpenny/11insider-askpenny-superJumbo.jpg', 'height': 1356, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Why Doesn’t the United States (Finally) Get Rid of the Penny?', 'kicker': 'Ask The Times', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Currency', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-10-10T17:27:48+0000', 'document_type': 'article', 'news_desk': 'Insider', 'section_name': 'Times Insider', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/44cd9764-423e-5082-a40e-4efe0618de22', 'word_count': 536, 'uri': 'nyt://article/44cd9764-423e-5082-a40e-4efe0618de22'}, {'abstract': 'Participants can stomp grapes on the sidewalk in front of Little Mo Wine in Prospect-Lefferts Gardens.', 'web_url': 'https://www.nytimes.com/2016/10/12/dining/grape-stomping-little-mo-wine-brooklyn.html', 'snippet': 'Participants can stomp grapes on the sidewalk in front of Little Mo Wine in Prospect-Lefferts Gardens.', 'lead_paragraph': 'Stomping on grapes for wine has gone the way of the horse and buggy, but on occasion it is brought back for a touch of the past and some freewheeling fun. That’s what Mark Schwartz will try in front of his Brooklyn wine shop this weekend. Tubs of grapes will be hauled out for willing participants to try their hand — er, foot — at crushing, either barefoot or wrapped in plastic: Grape stomp, noon to 5 p.m. on Saturday, Little Mo Wine & Spirits, 1125 Nostrand Avenue (Midwood Street), Prospect-Lefferts Gardens, Brooklyn, 718-363-2101, littlemowine.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/12/dining/12BURNER-GRAPES-WEB/12BURNER-GRAPES-WEB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/12/dining/12BURNER-GRAPES-WEB/12BURNER-GRAPES-WEB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/12/dining/12BURNER-GRAPES-WEB/12BURNER-GRAPES-WEB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': '