nals-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/08/sports/08nationals/08nationals-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/08/sports/08nationals/08nationals-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/08/sports/08nationals/08nationals-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Dodgers Defeat Nationals in a Pitchers’ Duel That Wasn’t', 'kicker': 'Dodgers 4, Nationals 3 | Los Angeles leads series, 1-0', 'content_kicker': None, 'print_headline': 'Dodgers Prevail in a Pitchers’ Duel That Wasn’t', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Los Angeles Dodgers', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wagner, James', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington Nationals', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Playoff Games', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Kershaw, Clayton', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Scherzer, Max', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-10-08T02:43:17+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By James Wagner', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Wagner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1c5a243e-1c4a-58