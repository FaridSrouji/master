on': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/fashion/04sonia/04sonia-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/04/fashion/04sonia/04sonia-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 393}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/fashion/04sonia/04sonia-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/04/fashion/04sonia/04sonia-superJumbo.jpg', 'height': 1343, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Remembering Sonia Rykiel, in Fashion’s Own Words', 'kicker': None, 'content_kicker': None, 'print_headline': 'Remembering Sonia Rykiel: ‘A Very Modern Woman’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schneier, Matthew', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Paris Fashion Week', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Rykiel, Sonia', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'de Libran, Julie (1972- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Sarkozy, Carla', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-03T12:54:09+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Matthew Schneier', 'person': [{'firstname': 'Matthew', 'middlename': None, 'lastname': 'Schneier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0669affb-d132-5763-9786-70571fec007d', 'word_count': 787, 'uri': 'nyt://article/0669affb-