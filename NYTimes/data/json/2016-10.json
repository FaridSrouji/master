': 'News', '_id': 'nyt://article/6529aefb-499a-51c3-900a-a1c7e8589f82', 'word_count': 1363, 'uri': 'nyt://article/6529aefb-499a-51c3-900a-a1c7e8589f82'}, {'abstract': '“I will keep you in suspense,” Donald Trump said at a debate that began cordially but turned caustic. Hillary Clinton replied that his statement was “horrifying.”', 'web_url': 'https://www.nytimes.com/2016/10/20/us/politics/presidential-debate.html', 'snippet': '“I will keep you in suspense,” Donald Trump said at a debate that began cordially but turned caustic. Hillary Clinton replied that his statement was “horrifying.”', 'lead_paragraph': 'In a remarkable statement that seemed to cast doubt on American democracy, Donald J. Trump said Wednesday that he might not accept the results of next month’s election if he felt it was rigged against him — a stand that Hillary Clinton blasted as “horrifying” at their final and caustic debate on Wednesday.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Donald Trump Won’t Say if He’ll Accept Result of Election', 'kicker': None, 'content_kicker': None, 'print_headline': 'Trump Won’t Say If He Will Accept Election’s Result', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, Jonathan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Debates (Political)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-20T02:44:56+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Patrick Healy and Jonathan Martin', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'report