Large.jpg', 'height': 425, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/31/t-magazine/palombe-slide-JBVT/palombe-slide-JBVT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 425}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/31/t-magazine/palombe-slide-JBVT/palombe-slide-JBVT-jumbo.jpg', 'height': 726, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/31/t-magazine/palombe-slide-JBVT/palombe-slide-JBVT-superJumbo.jpg', 'height': 1452, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/31/t-magazine/palombe-slide-JBVT/palombe-slide-JBVT-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/31/t-magazine/palombe-slide-JBVT/palombe-slide-JBVT-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/31/t-magazine/palombe-slide-JBVT/palombe-slide-JBVT-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pigeon: From the Wild to the French Table', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pigeons', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hunting and Trapping', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Basques', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-31T09:50:54+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/9537a876-7c32-5173-8392-96a951a63da5', 'word_count': 0, 'uri': 'nyt://slideshow/9537a876-7c32-5173-8392-96a951a63da5'}, {'abstract': 'For centuries, the men of the Basque Country have hunted wild pigeon. Their weapons of choice: paddles and nets.', 'web_url': 'https://www.nytimes.com/2016/10/31/t-magazine/food/palombe-pigeon-basque-country.html', 'snippet': 'For centuries, the men of the Basque Country have hunted wild pigeon. Their weapons of choice: paddles and nets.', 'lead_paragraph': 'FALL IS WILD GAME SEASON in France, and discerning diners at Parisian outposts like L’Ami Jean, La Régalade and Spring come especially for the composed dishes of just-hunted, rich-tasting game. That one might bite into one’s mallard or grouse and land on stray birdshot is perhaps a badge of honor, proof that what’s on your plate has a woodsier back story than the steak. And palombe, or wood pigeon, has a better back story than most. “As a chef, you want something that tastes delicious, but also that’s coherent and has its own tradition,” says Daniel Rose, who serves it rare-roasted at his First Arrondissement restaurant Spring during the bird’s month-and-a-half season from mid-October to the end of November. Generally grayer than its close cousin, the standard pigeon, with distinctive white marks on its neck and wings, the wild-caught palombe is more delicately gamy and less rich. Rose serves his with braised foie gras and cabbage, and a purée of smoked beet. At L’Ami Jean, Stéphane Jégo goes a more traditional route, roasting the birds with thyme and garlic, or stewed in salmi, a mixture of giblets, wine and foie gras. “Wild palombe brings a rustic, old-fashioned moment to the table,” Rose notes. “It evokes the deliciousness of nature and cooking on an open fire.”', 'print_section': 'M2', 