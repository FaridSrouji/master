ticleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/13/nytnow/13eveningss-slide-CC5Z/13eveningss-slide-CC5Z-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/13/nytnow/13eveningss-slide-CC5Z/13eveningss-slide-CC5Z-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/13/nytnow/13eveningss-slide-CC5Z/13eveningss-slide-CC5Z-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Bob Dylan, Donald Trump, Michelle Obama: Your Thursday Evening Briefing', 'kicker': None, 'content_kicker': None, 'print_headline': 'Your Evening Briefing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-10-13T21:42:01+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Karen Zraick, Karen Workman and Sandra Stevenson', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Zraick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Karen', 'middlename': None, 'lastname': 'Workman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Sandra', 'middlename': None, 'lastname': 'Stevenson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/7a870eb8-88ef-5fc0-87b0-5dfbd1f033d3', 'word_count': 764, 'uri': 'nyt://article/7a870eb8-88ef-5fc0-87b0-5dfbd1f033d3'}, {'abstract': 'In this dramatization of a true story, Rebecca Hall is riveting as Christine Chubbuck, a television news reporter who killed herself on the air.', 'web_url': 'https://www.nytimes.com/2016/10/14/movies/christine-review-rebecca-hall.html', 'snippet': 'In this dramatization of a true story, Rebecca Hall is riveting as Christine Chubbuck, a television news reporter who killed herself on the air.', 'lead_paragraph': 'Every so often, an actor takes possession of a role so thoroughly — turning each line, flickering look and gesture into an expression of being — that she becomes your way into the movie as well as the reason you keep watching. That’s the case with Rebecca Hall, the star of “Christine,” a period drama about a television reporter, Christine Chubbuck, that plays more like an autopsy than like a biopic. In 1974 Ms. Chubbuck shot herself on the air, possibly becoming the first person to commit suicide on live TV. The ancient Romans had the Colosseum; we have television.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14CHRISTINE/14CHRISTINE-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/14/arts/14CHRISTINE/14CHRISTINE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14CHRISTINE/14CHRISTINE-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14CHRISTINE/14CHRISTINE-superJumbo.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14CHRISTINE/14CHRISTINE-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/14/arts/14CHRISTINE/14CHRISTINE-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14CHRISTINE/14CHRISTINE-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Christine,’ Why Did She Pull the Trigger? We Don’t Know', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside a Suicide: What Made Her  Pull the Trigger?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Christine (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Campos, Antonio', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Chubbuck, Christine (1944-74)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hall, Rebecca', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Shilowich, Craig', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-13T21:43:53+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/aa6f3b90-6de5-510a-bae9-76485c46ba75', 'word_count': 855, 'uri': 'nyt://article/aa6f3b90-6de5-510a-bae9-76485c46ba75'}, {'abstract': 'A free spirit is tangled up in the political forces paralleling modern-day Brazil in this work from Kleber Mendonça Filho.', 'web_url': 'https://www.nytimes.com/2016/10/14/movies/aquarius-review.html', 'snippet': 'A free spirit is tangled up in the political forces paralleling modern-day Brazil in this work from Kleber Mendonça Filho.', 'lead_paragraph': 'It’s easy enough to say what makes an apartment a home — fond memories, shelves full of cherished books and records, a heap of living — but it’s harder to specify what makes a home a metaphor. Kleber Mendonça Filho’s new film, “Aquarius,” takes place mostly in and around the apartment where its heroine, a 65-year-old music critic named Clara, has lived for much of her adult life. Its rooms are spacious and sunny (the Atlantic Ocean is right across the street), but an intimation of hidden significance drifts in with the light and the breezes, a hint that Clara’s home might also be a microcosm of modern Brazil.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14AQUARIUS/14AQUARIUS-articleLarge.jpg', 'height': 367, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/14/arts/14AQUARIUS/14AQUARIUS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 367}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14AQUARIUS/14AQUARIUS-jumbo.jpg', 'height': 626, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14AQUARIUS/14AQUARIUS-superJumbo.jpg', 'height': 685, 'width': 1120, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/14/arts/14AQUARIUS/14AQUARIUS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/14/arts/14AQUARIUS/14AQUARIUS-thumbStandard.jpg', 'thumbnailw