ericas', 'byline': {'original': 'By Azam Ahmed', 'person': [{'firstname': 'Azam', 'middlename': None, 'lastname': 'Ahmed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/78d5b551-aa56-52a4-9700-339409b24b6c', 'word_count': 782, 'uri': 'nyt://article/78d5b551-aa56-52a4-9700-339409b24b6c'}, {'abstract': 'At the Museum of Chinese in America, an exhibition on Chinese food and identity.', 'web_url': 'https://www.nytimes.com/2016/10/05/dining/museum-of-chinese-in-america-food-exhibit.html', 'snippet': 'At the Museum of Chinese in America, an exhibition on Chinese food and identity.', 'lead_paragraph': 'An exhibition at the Museum of Chinese in America examines the immigrant and second-generation Chinese and Asian experience through food. More than 30 home cooks and professional chefs, including Ken Hom, Anita Lo, Susanna Foo, Danny Bowien and Michael Tong are profiled. Their experiences and interpretations of regional cuisines are presented through video installations, and objects illustrating the chefs’ stories are displayed on an oversize dinner table: “Sour, Sweet, Bitter, Spicy: Stories of Chinese Food and Identity in America,” Oct. 6 to March 26, 2017, Museum of Chinese in America, 215 Centre Street (Grand Street), 855-955-6622, mocanyc.org.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/dining/05BURNER-EXHIBIT-WEB/05BURNER-EXHIBIT-WEB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/05/dining/05BURNER-EXHIBIT-WEB/05BURNER-EXHIBIT-WEB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/di