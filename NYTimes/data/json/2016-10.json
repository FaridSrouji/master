A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/nyregion/07MAYOR/07MAYOR-articleLarge.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/07/nyregion/07MAYOR/07MAYOR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 403}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/nyregion/07MAYOR/07MAYOR-jumbo.jpg', 'height': 688, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/nyregion/07MAYOR/07MAYOR-superJumbo.jpg', 'height': 1376, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/nyregion/07MAYOR/07MAYOR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/07/nyregion/07MAYOR/07MAYOR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/nyregion/07MAYOR/07MAYOR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'De Blasio Snubs New York Post Reporter and Calls Paper a ‘Right-Wing Rag’', 'kicker': None, 'content_kicker': None, 'print_headline': 'To Mayor, New York Post Is Now a ‘Right-Wing Rag’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Newspapers', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Post', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'r