': 'N'}], 'pub_date': '2016-10-31T01:07:00+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tyler Kepner', 'person': [{'firstname': 'Tyler', 'middlename': None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/064efec6-b980-5eb5-b33c-806ab9283d7a', 'word_count': 1210, 'uri': 'nyt://article/064efec6-b980-5eb5-b33c-806ab9283d7a'}, {'abstract': 'As banks prepare to roll out this technology, the experience on the other side of the Atlantic shows how to avoid fraudulent activity on these new types of credit and debit cards.', 'web_url': 'https://www.nytimes.com/2016/10/31/technology/how-to-protect-yourself-when-using-a-contactless-card.html', 'snippet': 'As banks prepare to roll out this technology, the experience on the other side of the Atlantic shows how to avoid fraudulent activity on these new types of credit and debit cards.', 'lead_paragraph': 'For banks and retailers, there is a fine line between making people’s use of credit and debit cards as painless as possible and protecting individuals’ financial details from swindlers.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Lessons From Europe on Using Contactless Cards', 'kicker': None, 'content_kicker': None, 'print_headline': 'Protecting Contactless Payments', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Debit Cards', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Credit Cards', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Identity Theft', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Commerce and Payments', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Europ