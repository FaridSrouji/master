me': 'David', 'middlename': None, 'lastname': 'Leonhardt', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/00426d56-7fe6-5978-b933-210e9e59ef1c', 'word_count': 347, 'uri': 'nyt://article/00426d56-7fe6-5978-b933-210e9e59ef1c'}, {'abstract': 'A reader condemns anger in all its forms.', 'web_url': 'https://www.nytimes.com/2016/10/27/opinion/anger-is-never-the-answer.html', 'snippet': 'A reader condemns anger in all its forms.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Anger Is Never the Answer', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANGER (EMOTION)', 'rank': 1, 'major': 'N'}], 'pub_date': '2016-10-27T10:52:17+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/dfd623f6-53c2-5cdd-ad5c-4e7e405673c0', 'word_count': 117, 'uri': 'nyt://article/dfd623f6-53c2-5cdd-ad5c-4e7e405673c0'}, {'abstract': 'Marathon participants who walked part of their course were fresher and had faster average miles than those who ran all the way.', 'web_url': 'https://www.nytimes.com/2016/10/30/well/move/how-a-run-walk-strategy-might-help-your-marathon.html', 'snippet': 'Marathon participants who walked part of their course were fresher and had faster average miles than those who ran all the way.', 'lead_paragraph': 'Completing a marathon can be triumphant — but also heart-rending, in a surprisingly literal sense. Immediately after a race, many recreational marathoners have been found to have high levels of enzymes in their blood that indicate cardiac damage. These runners have “stunned” their hearts, as some exercise cardiologists put it. Enzyme levels generally return to normal within a week or so, suggesting that hearts recover quickly, but some experts have still wondered if there are less-stressful ways to get through a marathon. For example, should nonelite runners deliberately walk part of the way?', 'print_section': 'MM', 'print_page': '36', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/magazine/30well/30mag-30well-t_CA0-articleLarge.jpg', 'height': 586, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/30/magazine/30well/30mag-30well-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 586}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/magazine/30well/30mag-30well-t_CA0-jumbo.jpg', 'height': 1000, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/magazine/30well/30mag-30well-t_CA0-superJumbo.jpg', 'height': 1500, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/magazine/30well/30mag-30well-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/30/magazine/30well/30mag-30well-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/magazine/30well/30mag-30well-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How a Run-Walk Strategy Might Help Your Marathon', 'kicker': None, 'content_kicker': None, 'print_headline': 'Give Yourself a Break', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Running', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Reynolds, Gretchen', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Marathon Running', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'New York City Marathon', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Journal of Science and Medicine in Sport', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Walking', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-27T11:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Well', 'subsection_name': 'Move', 'byline': {'original': 'By Gretchen Reynolds', 'person': [{'firstname': 'Gretchen', 'middlename': None, 'lastname': 'Reynolds', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b6d9f564-00b9-5d4c-91c0-fa6af00e511f', 'word_count': 502, 'uri': 'nyt://article/b6d9f564-00b9-5d4c-91c0-fa6af00e511f'}, {'abstract': 'You can’t predict a recession based on the length of an expansion; it doesn’t work that way.', 'web_url': 'https://www.nytimes.com/2016/10/28/upshot/will-the-next-president-face-a-recession-dont-assume-so.html', 'snippet': 'You can’t predict a recession based on the length of an expansion; it doesn’t work that way.', 'lead_paragraph': 'The economic expansion that has been underway in the United States since 2009 is getting old, and soon will die.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/upshot/27UP-GDP/27UP-GDP-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/27/upshot/27UP-GDP/27UP-GDP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/upshot/27UP-GDP/27UP-GDP-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/upshot/27UP-GDP/27UP-GDP-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/upshot/27UP-GDP/27UP-GDP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/27/upshot/27UP-GDP/27UP-GDP-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/upshot/27UP-GDP/27UP-GDP-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Will the Next President Face a Recession? Don’t Assume So', 'kicker': 'The 2016 Race', 'content_kicker': None, 'print_headline': 'Expansion Is Old, Not at Death’s Door', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Irwin, Neil', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Recession and Depression', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-10-27T11:00:29+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Neil Irwin', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Irwin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c717c25-e58a-589f-a378-9aa8180622b0', 'word_count': 765, 'uri': 'nyt://article/3c717c25-e58a-589f-a378-9aa8180622b0'}, {'abstract': 'This Philadelphia show of political art from 1910-15 focuses on pioneers of the Mexican movement for artistic nationalism.', 'web_url': 'https://www.nytimes.com/2016/10/28/arts/design/review-paint-the-revolution-offers-mexican-muralist-muscle-and-delicate-beauty.html', 'snippet': 'This Philadelphia show of political art from 1910-15 focuses on pioneers of the Mexican movement for artistic nationalism.', 'lead_paragraph': 'PHILADELPHIA — Politics or beauty? Take your choice. Conventional wisdom says they don’t mix. But “Paint the Revolution: Mexican Modernism, 1910-1950” at the Philadelphia Museum of Art argues, with reservations, otherwise. The show is the first all-out attempt in the United States in seven decades to grapple with the contradictions of early-20th-century Mexican political art. (The last one was also at this museum.) It has plenty of pumped muralist muscle — all those clenched fists — but offsets it with pictures as pretty as valentines.', 'print_section': 'C', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/arts/28REVOLUTION1/28REVOLUTION1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/28/arts/28REVOLUTION1/28REVOLUTION1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/arts/28REVOLUTION1/28REVOLUTION1-thumbLarge.jpg', 'height': 150, 'width'