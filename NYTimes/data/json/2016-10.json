d', 'organization': '', 'rank': 1}, {'firstname': 'Hana', 'middlename': None, 'lastname': 'de Goeij', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96468123-edfa-519d-b87f-bf0c98d0c20b', 'word_count': 711, 'uri': 'nyt://article/96468123-edfa-519d-b87f-bf0c98d0c20b'}, {'abstract': 'Aid work has ceased in the north of Rakhine State after attacks on police officers, and videos purporting to show local Muslims urging jihad have added to fears of unrest.', 'web_url': 'https://www.nytimes.com/2016/10/20/world/asia/myanmar-rakhine-rohingya-violence.html', 'snippet': 'Aid work has ceased in the north of Rakhine State after attacks on police officers, and videos purporting to show local Muslims urging jihad have added to fears of unrest.', 'lead_paragraph': 'HONG KONG — More than a week after attacks on police officers began a wave of bloodshed in western Myanmar, a lockdown by security forces has prevented aid workers from operating in the area, and new videos of what appear to be local Muslims calling for resistance have raised fears of more violence.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/world/20MYANMAR-web1/20MYANMAR-web1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/20/world/20MYANMAR-web1/20MYANMAR-web1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/world/20MYANMAR-web1/20MYANMAR-web1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/