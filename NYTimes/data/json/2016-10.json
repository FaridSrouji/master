eing to go along with whatever tale they’ve spun, while acknowledging that it didn’t actually happen.', 'print_section': 'BR', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/books/review/1023-BKS-AuthorsNote-SUB01/1023-BKS-AuthorsNote-SUB01-articleLarge.jpg', 'height': 521, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/23/books/review/1023-BKS-AuthorsNote-SUB01/1023-BKS-AuthorsNote-SUB01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 521}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/books/review/1023-BKS-AuthorsNote-SUB01/1023-BKS-AuthorsNote-SUB01-jumbo.jpg', 'height': 889, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/books/review/1023-BKS-AuthorsNote-SUB01/1023-BKS-AuthorsNote-SUB01-superJumbo.jpg', 'height': 1411, 'width': 1625, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/books/review/1023-BKS-AuthorsNote-SUB01/1023-BKS-AuthorsNote-SUB01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/23/books/review/1023-BKS-AuthorsNote-SUB01/1023-BKS-AuthorsNote-SUB01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/books/review/1023-BKS-AuthorsNote-SUB01/1023-BKS-AuthorsNote-SUB01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Writer, Writer, Pants