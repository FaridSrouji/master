OVELOVE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/20/arts/20LOVELOVE/20LOVELOVE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/arts/20LOVELOVE/20LOVELOVE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Love, Love, Love,’ All You Need Is Selfishness.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Oh, Forget That Love Stuff. All You Need Is Selfishness.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Love, Love, Love (Play)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'ARMITAGE, RICHARD L', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bartlett, Mike', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Ryan, Amy (1968- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kazan, Zoe', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Mayer, Michael', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Roundabout Theater Co', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-10-20T02:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Ben Brantley', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Brantley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3bb36748-569c-5e1a-ba62-0da31ea83d12', 'word_count': 1045, 'uri': 'nyt://article/3bb36748-569c-5e1a-ba62-0da31ea83d12'}, {'abstract': 'Rick Stocks is the self-appointed caretaker of discarded parts from the Statue of Liberty’s $87 million restoration in the 1980s.', 'web_url': 'https://www.nytimes.com/2016/10/20/nyregion/want-an-old-piece-of-the-statue-of-liberty-this-is-the-man-to-see.html', 'snippet': 'Rick Stocks is the self-appointed caretaker of discarded parts from the Statue of Liberty’s $87 million restoration in the 1980s.', 'lead_paragraph': 'For more than three decades, Rick Stocks has been hoarding a mountain of construction debris — so much of it that he had to squirrel it all away in three different warehouses in Tennessee and Florida.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/nyregion/20liberty1/20liberty1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/20/nyregion/20liberty1/20liberty1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/nyregion/20liberty1/20liberty1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/nyregion/20liberty1/20liberty1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/20/nyregion/20liberty1/20liberty1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/nyregion/20liberty1/20liberty1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/20/nyregion/20liberty