-magazine/art/verhoeven-slide-FUBE/verhoeven-slide-FUBE-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-FUBE/verhoeven-slide-FUBE-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-FUBE/verhoeven-slide-FUBE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/07/t-magazine/art/verhoeven-slide-FUBE/verhoeven-slide-FUBE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-FUBE/verhoeven-slide-FUBE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '“The Toilet Attendant ... Now Wash Your Hands”', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-10-07T19:13:30+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Art', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4416aed8-55cb-5cc3-b1fb-09fb7fe09887', 'word_count': 0, 'uri': 'nyt://slideshow/4416aed8-55cb-5cc3-b1fb-09fb7fe09887'}, {'abstract': 'Julie Verhoeven is taking her (self-imposed) duties as a washroom attendant very, very seriously.', 'web_url': 'https://www.nytimes.com/2016/10/07/t-magazine/art/julie-verhoeven-toilet-frieze-london.html', 'snippet': 'Julie Verhoeven is taking her (self-imposed) duties as a washroom attendant very, very seriously.', 'lead_paragraph': '“Are these toilets unisex?” asks a bemused Frieze London fairgoer who inadvertently wanders into the fair’s ladies’ room, and his confusion is understandable: The artist Julie Verhoeven has turned the public bathrooms into the unlikely site for an art intervention. Disruption is very much the intention behind “The Toilet Attendant… Now Wash Your Hands,” in which Verhoeven act as a washroom attendant alongside the art collector Valeria Napoleone. “The carpet is confusing everyone,” says Verhoeven, gesturing to the gender-disorienting hot pink floor covering in the men’s washrooms, and the royal blue in the women’s. “It’s quite telling about the way we’ve all been brought up. I thought we were all supposed to be ‘art’ and visually astute. There is signage,” she adds gleefully. “I guess the pink and blue thing is deeply bred into the psyche.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-13MV/verhoeven-slide-13MV-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/07/t-magazine/art/verhoeven-slide-13MV/verhoeven-slide-13MV-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-13MV/verhoeven-slide-13MV-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-13MV/verhoeven-slide-13MV-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-13MV/verhoeven-slide-13MV-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/07/t-magazine/art/verhoeven-slide-13MV/verhoeven-slide-13MV-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/t-magazine/art/verhoeven-slide-13MV/verhoeven-slide-13MV-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why One Artist Is Spending Frieze London Hiding in the Bathroom', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bathrooms and Toilets', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Frieze Art Fair', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hygiene and Cleanliness', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-07T19:13:32+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Art', 'byline': {'original': 'By Aimee Farrell', 'person': [{'firstname': 'Aimee', 'middlename': None, 'lastname': 'Farrell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/673b9730-acaf-5c11-a2dc-bf06194e54c1', 'word_count': 453, 'uri': 'nyt://article/673b9730-acaf-5c11-a2dc-bf06194e54c1'}, {'abstract': 'The Russian deputy defense minister said that the Kremlin was working to re-establish the former bases, which closed in 2002.', 'web_url': 'https://www.nytimes.com/2016/10/08/world/europe/russia-seeks-to-reopen-military-bases-in-vietnam-and-cuba.html', 'snippet': 'The Russian deputy defense minister said that the Kremlin was working to re-establish the former bases, which closed in 2002.', 'lead_paragraph': 'MOSCOW — Russia is working to re-establish its former military bases in Vietnam and Cuba, a senior official said on Friday, reflecting Moscow’s growing ambition to reassert itself on the world stage.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Russia Seeks to Reopen Military Bases in Vietnam and Cuba', 'kicker': None, 'content_kicker': None, 'print_headline': 'Russia Aims to Reopen Vietnam and Cuba Bases', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Vietnam', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Military Bases and Installations', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-10-07T19:18:30+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Ivan Nechepurenko', 'person': [{'firstname': 'Ivan', 'middlename': None, 'lastname': 'Nechepurenko', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eabc7581-df80-59f0-97dd-34c588dd6015', 'word_count': 289, 'uri': 'nyt://article/eabc7581-df80-59f0-97dd-34c588dd6015'}, {'abstract': 'What the jury makes of him, and whether his steadfast beliefs come across as arrogance or sincerity, could decide his fate when deliberations start this month.', 'web_url': 'https://www.nytimes.com/2016/10/08/us/ammon-bundy-case-as-inkblot-test-what-will-jurors-see-in-his-words.html', 'snippet': 'What the jury makes of him, and whether his steadfast beliefs come across as arrogance or sincerity, could decide his fate when deliberations start this month.', 'lead_paragraph': 'PORTLAND, Ore. — The beard and cowboy hat that defined Ammon Bundy’s image to Americans on those cold mornings in January are gone. He is cleanshaven now and dressed in ill-fitting jailhouse blue. The federal wildlife refuge that he and other armed militia members occupied for six weeks in Oregon’s high eastern desert has returned to normal.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/08/us/08oregon-jp/08oregon2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/08/us/08oregon-jp/08oregon2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/08/us/08oregon-jp/08oregon2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/08/us/08oregon-jp/08oregon2-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/08/us/08oregon-jp/08oregon2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/08/us/08oregon-jp/08oregon2-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/08/us/08oregon-jp/08oregon2-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Ammon Bundy Case as Inkblot Test: What Will Jurors See in His Words?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bundy Case as Inkblot Test: What Will Jury See in Occupier’s Words?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Malheur National Wildlife Refuge (Oregon)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Kirk', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bundy, Ammon E (1975- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bundy, Ryan C (1972- )', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Lands', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Oregon', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-07T19:28:40+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Kirk Johnson', 'person': [{'firstname': 'Kirk', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cd5f53cd-250d-5204-8f19-f6fce78a9ff6', 'word_count': 1131, 'uri': 'nyt://article/cd5f53cd-250d-5204-8f19-f6fce78a9ff6'}, {'abstract': 'A fish stew offers extraordinary flavor for minimal effort.', 'web_url': 'https://www.nytimes.com/2016/10/12/dining/fish-stew.html', 'snippet': 'A fish stew offers extraordinary flavor for minimal effort.', 'lead_paragraph': 'I think that a stew is more interesting than a steak, whether it’s a beefsteak, a cauliflower steak or a fish steak. In terms of flavor complexity and satisfaction delivered to the diner, a stew always wins, at least for me. The steak is one-dimensional; the stew transcends the sum of its parts.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/12/dining/12KITCH1-WEB/12KITCH1-WEB-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/12/dining/12KITCH1-WEB/12KITCH1-WEB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/12/dining/12KITCH1-WEB/12KITCH1-WEB-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/12/dining/12KITCH1-WEB/12KITCH1-WEB-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/12/dining/12KITCH1-WEB/12KITCH1-WEB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/12/dining/12KITCH1-WEB/12KITCH1-WEB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/12/dining/12KITCH1-WEB/12KITCH1-WEB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Stews Always Beat Steaks', 'kicker': 'City Kitchen', 'content_kicker': None, 'print_headline': 'A Potful of Mediterranean Flavors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tanis, David', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Soups', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Seafood', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-07T19:29:47+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/314bdd1d-c4bc-581b-863f-c51700f77a21', 'word_count': 509, 'uri': 'nyt://article/314bdd1d-c4bc-581b-863f-c51700f77a21'}, {'abstract': 'He started the Instagram account after eavesdropping on Angelenos in juice bars, yoga classes and fair-trade coffeehouses.', 'web_url': 'https://www.nytimes.com/2016/10/09/fashion/founder-of-overheard-la-which-pokes-fun-at-the-citys-pretensions-is-unmasked.html', 'snippet': 'He started the Instagram account after eavesdropping on Angelenos in juice bars, yoga classes and fair-trade coffeehouses.', 'lead_paragraph': 'After decades as the butt of jokes by Johnny Carson, by Steve Martin, by Larry David — basically, by everyone — Los Angeles may seem beyond satire. But over the last year, the West Coast capital of excess has been a target for parody from an unlikely source: random citizens, courtesy of an Instagram feed called @overheardLA.', 'print_section': 'ST', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/fashion/02OVERHEARD-WEB/02OVERHEARD-WEB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/02/fashion/02OVERHEARD-WEB/02OVERHEARD-WEB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/fashion/02OVERHEARD-WEB/02OVERHEARD-WEB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/fashion/02OVERHEARD-WEB/02OVERHEARD-WEB-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/02/fashion/02OVERHEARD-WEB/02OVERHEARD-WEB-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/fashion/02OVERHEARD-WEB/02OVERHEARD-WEB-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/fashion/02OVERHEARD-WEB/02OVERHEARD-WEB-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Founder of Overheard LA, Which Pokes Fun at the City’s Pretensions, Is Unmasked', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Instagram Comedy Star, Revealed', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Social Media', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Alex', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Margolis, Jesse (1975- )', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Instagram Inc', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-10-07T19:30:10+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Alex Williams', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/027516b2-9c24-5967-9b6e-5c59844fbb7f', 'word_count': 1074, 'uri': 'nyt://article/027516b2-9c24-5967-9b6e-5c59844fbb7f'}, {'abstract': 'An advocacy group wanted to place a billboard at Newark Liberty International Airport which explained that requiring a passenger to switch seats based on gender was illegal. It was rejected.', 'web_url': 'https://www.nytimes.com/2016/10/09/nyregion/your-public-service-ad-not-here.html', 'snippet': 'An advocacy group wanted to place a billboard at Newark Liberty International Airport which explained that requiring a passenger to switch seats based on gender was illegal. It was rejected.', 'lead_paragraph': 'Last year, on a Turkish Airlines flight bound for Istanbul from Tel Aviv, Jo-Ann Mort encountered an agitated Hasidic man who had been assigned the seat next to hers. Ms. Mort overheard him ask another man, a Reform rabbi in the next seat of their row, if they could switch places. Adhering to the strictest interpretation of Jewish law, the Hasidic man did not want to sit beside a woman who was not his wife. The rabbi said no, so the man asked several other passengers to change seats with him until one young woman finally agreed. Writing about the episode later in Haaretz, the Israeli newspaper, Ms. Mort described a sense of profound irritation that left her scolding the young woman for her submission.', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/nyregion/09BIGCITY1/09BIGCITY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/09/nyregion/09BIGCITY1/09BIGCITY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/nyregion/09BIGCITY1/09BIGCITY1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 