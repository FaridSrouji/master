3/travel/23UPDATE1/23UPDATE1-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/travel/23UPDATE1/23UPDATE1-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/travel/23UPDATE1/23UPDATE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/23/travel/23UPDATE1/23UPDATE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/travel/23UPDATE1/23UPDATE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Want to Explore Iceland? An Airline Has a Buddy Who Can Help', 'kicker': 'Personal Journeys', 'content_kicker': None, 'print_headline': 'A New ‘Friend’ to Show You Around', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Icelandair', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Negroni, Christine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Flight Attendants', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iceland', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-10-22T10:00:06+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Christine Negroni', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Negroni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a4389c38-1b99-5940-9c65-60e414e57de6', 'word_count': 1144, 'uri': 'nyt://article/a4389c38-1b99-5940-9c65-60e414e57de6'}, {'abstract': 'How Khalil Rafati, a former addict, started a wildly successful juice chain in Southern California, the toughest of markets.', 'web_url': 'https://www.nytimes.com/2016/10/23/fashion/sunlife-juice-bars-malibu-khalil-rafati.html', 'snippet': 'How Khalil Rafati, a former addict, started a wildly successful juice chain in Southern California, the toughest of markets.', 'lead_paragraph': 'MALIBU, Calif. — I wasn’t eating right. Was I even eating? In that miserable winter in 2011, I couldn’t always be sure. Unlike my impossibly slender, toned new neighbors here, where I’d rented a small apartment on the beach to escape my cold Montana hometown, I didn’t count calories, carbs or protein grams. I only counted pounds, the bottom line. Lately, I’d lost track even of those. A combination of workaholic strain and grief over my mother’s recent death had plunged me into a spiral of self-neglect as I veered between pigging out and going hungry. I was failing as a Southern Californian, and my eyes, as yellow as Post-it notes, were proof.', 'print_section': 'ST', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/fashion/23RAFATI/23RAFATI-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/23/fashion/23RAFATI/23RAFATI-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/fashion/23RAFATI/23RAFATI-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'cred