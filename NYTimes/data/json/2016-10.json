e': 'subject', 'value': 'Driver Distraction and Fatigue', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Commuting', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Daylight Saving Time', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Transportation Department (NYC)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-10-26T19:14:04+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Winnie Hu', 'person': [{'firstname': 'Winnie', 'middlename': None, 'lastname': 'Hu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4a9b0f7e-762c-5a14-9a27-c2e3126679a6', 'word_count': 998, 'uri': 'nyt://article/4a9b0f7e-762c-5a14-9a27-c2e3126679a6'}, {'abstract': '“Marilyn Minter: Pretty/Dirty” opens at the Brooklyn Museum. It holds a mirror up to our culture’s obsession with a sensuality that seems to deny the body.', 'web_url': 'https://www.nytimes.com/2016/10/30/arts/design/marilyn-minters-take-on-sexuality-dirt-pimples-and-all.html', 'snippet': '“Marilyn Minter: Pretty/Dirty” opens at the Brooklyn Museum. It holds a mirror up to our culture’s obsession with a sensuality that seems to deny the body.', 'lead_paragraph': '“I’m trying to say it’s time to look at who we really are,” the painter Marilyn Minter once said. And for more than 40 years, her gorgeous, grimy, sexy, icky, sparkly, sweaty work — the subject of her first New York retrospective, “Marilyn Minter: Pretty/Dirty,” opening Friday, Nov. 4, at the Brooklyn Museum — has held an uncomfortable mirror up to our culture’s obsession with a sensuality that seems to deny the human body. In Ms. Minter’s paintings, based on exuberantly composed photographs, fashion tropes appear as if hauled under a truth-telling microscope, where hairs and pimples and dirt hold equal sway with makeup and bling. Her interest in pornography, and what Holland Cotter in The New York Times called a “pathology of glamour,” made for tough going in the 1990s, when she was criticized by some feminists as a sexualizer for its own sake. But at 68, she is seeing history come around to her way of thinking. In a video interview for the retrospective, she says: “My side won, basically.” (brooklynmuseum.org)', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/arts/30WEEKAHEAD-TRIPTYCH/20WEEKAHEAD-TRIPTYCH-articleLarge.jpg', 'height': 238, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/30/arts/30WEEKAHEAD-TRIPTYCH/20WEEKAHEAD-TRIPTYCH-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 238}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/arts/30WEEKAHEAD-TRIPTYCH/20WEEKAHEAD-TRIPTYCH-jumbo.jpg', 'height': 407, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/arts/30WEEKAHEAD-TRIPTYCH/20WEEKAHEAD-TRIPTYCH-superJumbo.jpg', 'height': 814, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/30/arts/30WEEKAHEAD-TRIPTYCH/20WEEKAHEAD-TRIPTYCH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/30/arts/30WEEKAHEAD-TRIPTYCH/20WEEKAHEAD-TRIPTYCH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': 