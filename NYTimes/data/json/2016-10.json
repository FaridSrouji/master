: 'images/2016/10/07/opinion/07LpoliceWeb/07LpoliceWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/07/opinion/07LpoliceWeb/07LpoliceWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/opinion/07LpoliceWeb/07LpoliceWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/07/opinion/07LpoliceWeb/07LpoliceWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'For New York’s Police, Talk Down, Not Take Down', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'For New York’s Police, Talk Down, Not Take Down', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 1, 'major': 'N'}], 'pub_date': '2016-10-06T19:41:06+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/f35dacbd-e4d5-5ccb-aa9e-dddd5fcb9650', 'word_count': 282, 'uri': 'nyt://article/f35dacbd-e4d5-5ccb-aa9e-dddd5fcb9650'}, {'abstract': '“Platform 2016: Lost and Found,” a six-week series organized for Danspace Project, includes performances, conversations and more.', 'web_url': 'https://www.nytimes.com/2016/10/09/arts/dance/theyll-perform-and-talk-to-remember-those-killed-by-aids.html', 'snippet': '“Platform 2016: Lost and Found,” a six-week series organized for Danspace Project, includes performances, conversations and more.', 'lead_paragraph': 'One day in the middle of the 1980s, John Bernd took a taxi to St. Mark’s Church in the East Village, where he did a solo show for Danspace Project. Then he took a taxi back to where he had come from: New York University Hospital, a few blocks away. A friend had to sneak him out for his performance. Mr. Bernd had been sick with AIDS since 1981, before the syndrome had a name.', 'print_section': 'AR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/arts/109AIDSPLATFORM1/109AIDSPLATFORM1-articleLarge.jpg', 'height': 889, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/09/arts/109AIDSPLATFORM1/109AIDSPLATFORM1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 889}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/arts/109AIDSPLATFORM1/109AIDSPLATFORM1-jumbo.jpg', 'height': 1024, 'width': 692, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/arts/109AIDSPLATFORM1/109AIDSPLATFORM1-superJumbo.jpg', 'height': 2048, 'width': 1383, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/arts/109AIDSPLATFORM1/109AIDSPLATFORM1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/09/arts/109AIDSPLATFORM1/109AIDSPLATFORM1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/arts/109AIDSPLATFORM1/109AIDSPLATFORM1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'They’ll Perform and Talk to Remember Those Killed by AIDS', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ready to Look Back and Remember', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bernd, John (1953-88)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Acquired Immune Deficiency Syndrome', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Art AIDS America (Exhibit)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Danspace Project', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Houston-Jones, Ishmael', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Rawls, Will J (1978- )', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-10-06T19:57:01+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Brian Seibert', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Seibert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92ebbde5-d58b-52a1-ac9c-4bb62fca8add', 'word_count': 1283, 'uri': 'nyt://article/92ebbde5-d58b-52a1-ac9c-4bb62fca8add'}, {'abstract': 'Mr. Halsey, perhaps the world’s most sought-after choral conductor, is slowly making his presence felt in New York.', 'web_url': 'https://www.nytimes.com/2016/10/09/arts/music/simon-halsey-preaching-to-and-for-the-choir.html', 'snippet': 'Mr. Halsey, perhaps the world’s most sought-after choral conductor, is slowly making his presence felt in New York.', 'lead_paragraph': 'Since the dawn of the jet age, the globe-trotting maestro has been a familiar feature of the classical music scene — conducting all over the world and often holding positions with orchestras in several nations at once. But jet-setting chorus masters? They are altogether rarer.', 'print_section': 'AR', 'print_p