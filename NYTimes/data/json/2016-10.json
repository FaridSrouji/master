med St. Clement of Ohrid Church crowded the vista.', 'print_section': 'TR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/travel/09SKOPJE1/09SKOPJE1-articleLarge.jpg', 'height': 293, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/09/travel/09SKOPJE1/09SKOPJE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 293}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/travel/09SKOPJE1/09SKOPJE1-jumbo.jpg', 'height': 500, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/travel/09SKOPJE1/09SKOPJE1-superJumbo.jpg', 'height': 1000, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/travel/09SKOPJE1/09SKOPJE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/09/travel/09SKOPJE1/09SKOPJE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/09/travel/09SKOPJE1/09SKOPJE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Beyond Kitsch in Skopje', 'kicker': 'Next Stop', 'content_kicker': None, 'print_headline': 'Beneath the Surface of Skopje', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Crevar, Alex', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'v