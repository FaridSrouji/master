LONweb-jumbo.jpg', 'height': 664, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/sports/20TRIATHLONweb/20TRIATHLONweb-superJumbo.jpg', 'height': 1328, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/sports/20TRIATHLONweb/20TRIATHLONweb-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/20/sports/20TRIATHLONweb/20TRIATHLONweb-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/sports/20TRIATHLONweb/20TRIATHLONweb-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Have You Ever Had to Make a Sacrifice to Help Someone You Care About?', 'kicker': 'Student Opinion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-10-18T08:30:04+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f86dd38f-274d-517f-8522-d03bf5bea80a', 'word_count': 340, 'uri': 'nyt://article/f86dd38f-274d-517f-8522-d03bf5bea80a'}, {'abstract': 'What makes an image surreal is not the artful crafting of illusion but the eruption of the accidental into the everyday.', 'web_url': 'https://www.nytimes.com/2016/10/23/magazine/surreal-photography.html', 'snippet': 'What makes an image surreal is not the artful crafting of illusion but the eruption of the accidental into the everyday.', 'lead_paragraph': 'Look at the photograph by Graciela Iturbide of a small child held on someone’s lap. The child is a boy, and the person holding him is his older sister. What is the first impression the photograph gives? It isn’t one of sweetness or innocence, but rather of a strangeness that is difficult to identify. The boy’s eyes are closed. His head is thrown back at what could be read as an unnatural angle, but could just as well be read as perfectly natural. Something seems not quite right. Is he sick? The composition recalls paintings or sculptures of the Pietà, where the Madonna carries the dead Christ. But here, the girl is too small, too fragile, to be a mother, and that peculiarity of scale is odd, too.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/magazine/23onphotography1/23mag-23onphotography-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/23/magazine/23onphotography1/23mag-23onphotography-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/magazine/23onphotography1/23mag-23onphotography-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/23/magazine/23onphotography1/23mag-23onphotography-t_CA0-articleLarge.jpg', 'height': 405, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/23/magazine/23o