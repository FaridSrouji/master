erial': 'Op-Ed', '_id': 'nyt://article/6306d2de-0faf-50fc-af3a-390afb724229', 'word_count': 946, 'uri': 'nyt://article/6306d2de-0faf-50fc-af3a-390afb724229'}, {'abstract': 'The government’s move to expropriate the building in Braunau am Inn, where Hitler was born in 1889, is intended to remove a site that has drawn neo-Nazis and tourists alike.', 'web_url': 'https://www.nytimes.com/2016/10/19/world/europe/adolf-hitler-birth-house.html', 'snippet': 'The government’s move to expropriate the building in Braunau am Inn, where Hitler was born in 1889, is intended to remove a site that has drawn neo-Nazis and tourists alike.', 'lead_paragraph': 'BERLIN — The Austrian government moved on Tuesday to seize the house where  Hitler was born, and it may tear it down, in an effort to demystify a site that has become a magnet for neo-Nazis as well as tourists.', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Austria Seeks to Seize, and Possibly Tear Down, Hitler’s House', 'kicker': None, 'content_kicker': None, 'print_headline': 'Austria Seeks to Seize Site Where Hitler Was Born', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Eddy, Melissa', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hitler, Adolf', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sobotka, Wolfgang', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Austria', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Braunau Am Inn (Austria)', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-10-18T12:55:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Melissa Eddy', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Eddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization':