lename': None, 'lastname': 'De La Cruz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a7644b06-d662-5d45-bbc8-5bce8bdec385', 'word_count': 947, 'uri': 'nyt://article/a7644b06-d662-5d45-bbc8-5bce8bdec385'}, {'abstract': 'Pakistani terrorists hit India. India’s army hits back — and its film industry, too.', 'web_url': 'https://www.nytimes.com/2016/10/14/opinion/bollywood-goes-to-war.html', 'snippet': 'Pakistani terrorists hit India. India’s army hits back — and its film industry, too.', 'lead_paragraph': 'The Indian Motion Picture Producers’ Association is an industry group with no standing to speak for anyone but its members. Yet it made itself widely heard recently, and became headline news, when it banned Pakistanis from working in Bollywood films — “forever.”', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bollywood Goes to War', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Bollywood goes to war', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Pakistan', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-10-13T12:55:47+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Sonia Faleiro', 'person': [{'firstname': 'Sonia', 'middlename': None, 'lastname': 'Faleiro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/91f6aa58-0a02-551f-ac93-11eff9ad6bb0', 'word_count': 796, 'uri': 'nyt://article/91f6aa58-0a02-551f-ac93-11eff9ad6bb0'}, {'abstract': 'A multinational effort to create a protective reserve in the Ross Sea off Antarctica has long been blocked by Russia. This year may be different.', 'web_url': 'https://www.nytimes.com/2016/10/14/opinion/russia-is-vital-to-protecting-antarcticas-ross-sea.html', 'snippet': 'A multinational effort to create a protective reserve in the Ross Sea off Antarctica has long been blocked by Russia. This year may be different.', 'lead_paragraph': 'SAN JOSE, Costa Rica — The key to protecting Antarctica’s Ross Sea may well lie with Russia. On Monday the Commission for the Conservation of Antarctic Marine Living Resources, comprising 24 nations and the European Union, will discuss, once again, the creation of a large, marine protected area in the Southern Ocean. All but one of the commission members has supported safeguarding this vital region and its threatened inhabitants. The holdout has been Russia, which has blocked similar efforts in recent years.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/13/opinion/13Figueres-INYT/13Figueres-INYT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/13/opinion/13Figueres-INYT/13Figueres-INYT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/13/opinion/13Figueres-INYT/13Figueres-INYT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/13/opinion/13Figueres-INYT/13Figueres-INYT-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/13/opinion/13Figueres-INYT/13Figueres-INYT-articleLarge.jpg', 'xlar