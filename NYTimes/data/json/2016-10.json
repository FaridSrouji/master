ork Times', 'multimedia': [], 'headline': {'main': 'Thousands of Men to Be Pardoned for Gay Sex, Once a Crime in Britain', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.K. Bill Pardons Men for Gay Sex', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality and Bisexuality', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Chan, Sewell', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Amnesties, Commutations and Pardons', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Turing, Alan M', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-10-20T14:15:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Sewell Chan', 'person': [{'firstname': 'Sewell', 'middlename': None, 'lastname': 'Chan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7ac5586b-38c5-5991-aa07-0b6f723d49b0', 'word_count': 1145, 'uri': 'nyt://article/7ac5586b-38c5-5991-aa07-0b6f723d49b0'}, {'abstract': 'What would be signs of a Trump comeback? And can Republicans hold on to the Senate and the House?', 'web_url': 'https://www.nytimes.com/2016/10/21/upshot/with-debates-done-heres-what-to-look-for-in-final-weeks.html', 'snippet': 'What would be signs of a Trump comeback? And can Republicans hold on to the Senate and the House?', 'lead_paragraph': 'Donald J. Trump entered the third presidential debate Wednesday night trailing by a wider margin in national polls than any modern candidate who has ever gone on to win the presidency.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/21/upshot/21UP-Next/21UP-Next-articleLarge.jpg', 'height': 400, 'width': 600, 'su