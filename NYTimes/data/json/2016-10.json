}], 'pub_date': '2016-10-03T16:13:11+0000', 'document_type': 'multimedia', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By ELSA BUTLER', 'person': [{'firstname': 'Elsa', 'middlename': None, 'lastname': 'BUTLER', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/ba53a8a6-d8b6-547d-8c5f-c5aa6e23b46e', 'word_count': 0, 'uri': 'nyt://video/ba53a8a6-d8b6-547d-8c5f-c5aa6e23b46e'}, {'abstract': 'The bottled coffee, from Zingerman’s in Ann Arbor, Mich., is smooth, strong and shelf-stable.', 'web_url': 'https://www.nytimes.com/2016/10/05/dining/a-cold-brew-coffee-to-drink-year-round.html', 'snippet': 'The bottled coffee, from Zingerman’s in Ann Arbor, Mich., is smooth, strong and shelf-stable.', 'lead_paragraph': 'Cold-brew coffee was big this summer, and as fall begins the popularity of coffee made this way, best suited for serving iced, shows no signs of slacking off. This smooth, strong, full-bodied cold brew is bottled without preservatives or sweeteners by Zingerman’s Coffee Company, a division of the diverse food emporium in Ann Arbor, Mich. A special process gives it a year’s shelf-life unrefrigerated (before opening). Well-made cold brew has minimal acidity. This one fits the profile: Zingerman’s Cold Brew Coffee, $3.99 for a 10-ounce bottle; a case of 16, $56, zingermanscoffee.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/05/dining/05BURNER-COFFEE/05BURNER-COFFEE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/05/dining/05BURNER-COFFEE/05BURNER-COFFEE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge