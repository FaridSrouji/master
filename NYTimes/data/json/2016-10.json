5bf9-aece-ff7a43234ce8'}, {'abstract': 'Mr. Trump alluded to abortions happening “on the final day.” Doctors say that scenario does not happen.', 'web_url': 'https://www.nytimes.com/2016/10/21/health/donald-trump-debate-late-abortion-remarks.html', 'snippet': 'Mr. Trump alluded to abortions happening “on the final day.” Doctors say that scenario does not happen.', 'lead_paragraph': 'In the presidential debate Wednesday night, Donald J. Trump expounded on pregnancy and abortion, asserting that under current abortion law, “You can take the baby and rip the baby out of the womb in the ninth month, on the final day.”', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Trump Said Women Get Abortions Days Before Birth. Doctors Say They Don’t.', 'kicker': None, 'content_kicker': None, 'print_headline': '‘Absurd’ Trump Errs on Abortion, Doctors Say  ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Belluck, Pam', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Debates (Political)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-10-20T21:41:56+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Health', 'byline': {'original': 'By Pam Belluck', 'person': [{'firstname': 'Pam', 'middlename': None, 'lastname': 'Belluck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f129f8b1-267a-5ad5-abcc-d0d785935e37', 'word_count': 495, 'uri': 'nyt://article/f129f8