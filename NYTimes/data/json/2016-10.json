'type': 'image', 'url': 'images/2016/10/28/sports/28NBAOPENERSweb1/28NBAOPENERSweb1-superJumbo.jpg', 'height': 1577, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/sports/28NBAOPENERSweb1/28NBAOPENERSweb1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/28/sports/28NBAOPENERSweb1/28NBAOPENERSweb1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/sports/28NBAOPENERSweb1/28NBAOPENERSweb1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '10 Things the N.B.A. Openers Taught Us', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Basketball Assn', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-10-27T14:41:28+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Victor Mather', 'person': [{'firstname': 'Victor', 'middlename': None, 'lastname': 'Mather', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd71061a-c4bb-5cbc-ba0f-24fc97ada13e', 'word_count': 955, 'uri': 'nyt://article/bd71061a-c4bb-5cbc-ba0f-24fc97ada13e'}, {'abstract': 'From the archives of The International Herald Tribune: A military report of the taking of the village of Douaumont by the French Army during World War I in October 1916.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2016/10/27/1916-great-verdun-victory-related-by-eye-witness/', 'snippet': 'From the archives of The International Herald Tribune: A military report of the taking of the village of Douaumont by the French Army during World War I in October 1916.', 'lead_paragraph': 'The following graphic story of the great French victory at Verdun is extracted from a report compiled by a French military eye-witness: “In less than four hours, between 11.40 a.m. and 3 p.m., we wrested from the enemy ground which he had taken eight months to conquer, at the price of several hundred thousand men, and threw him back on the right bank of the Meuse to the line which he occupied on the evening of Feb. 24, the day before the Germans took Douaumont and four days after the commencement of the battle of Verdun. At the same time as they captured Douaumont, our admirable troops carried the Haudromont quarries, the work and farm of Thiaumont, the slopes of the Dame and Couleuvre ravines, the Nawé wood, the village of Douaumont, the Caillette wood, the Bazil ravine and penetrated the Fausse-Côte ravine as far as the Vaux pond. On the extreme right, another regiment carried the Damloup battery.” — The New York Herald, European Edition, Oct. 27, 1916', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/blogs/27oldiht-1916-douaumonteye/27oldiht-1916-douaumonteye-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/27/blogs/27oldiht-1916-douaumonteye/27oldiht-1916-douaumonteye-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/blogs/27oldiht-1916-douaumonteye/27oldiht-1916-douaumonteye-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/blogs/27oldiht-1916-douaumonteye/27oldiht-1916-douaumonteye-articleLarge.jpg', 'height': 775, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/27/blogs/27oldiht-1916-douaumonteye/27oldiht-1916-douaumonteye-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 775}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/blogs/27oldiht-1916-douaumonteye/27oldiht-1916-douaumonteye-jumbo.jpg', 'height': 825, 'width': 639, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/27/blogs/27oldiht-1916-douaumonteye/27oldiht-1916-douaumonteye-superJumbo.jpg', 'height': 825, 'width': 639, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '1916: Great Verdun Victory Related by Eye-Witness', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'FRANCE', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Verdun (France)', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-27T14:41:33+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e95dfd6-1fcb-58f1-970c-c593bd308bcd', 'word_count': 169, 'uri': 'nyt://article/8e95dfd6-1fcb-58f1-970c-c593bd308bcd'}, {'abstract': 'The new rules require broadband providers to get permission to collect data on a subscriber’s web browsing, app use, location and financial information.', 'web_url': 'https://www.nytimes.com/2016/10/28/technology/fcc-tightens-privacy-rules-for-broadband-providers.html', 'snippet': 'The new rules require broadband providers to get permission to collect data on a subscriber’s web browsing, app use, location and financial information.', 'lead_paragraph': 'WASHINGTON — Federal officials approved broad new privacy rules on Thursday that prevent companies like AT&T and Comcast from collecting and giving out digital information about individuals — such as the websites they visited and the apps they used — in a move that creates landmark protections for internet users.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/business/28PRIVACY/28PRIVACY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/28/business/28PRIVACY/28PRIVACY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/business/28PRIVACY/28PRIVACY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/business/28PRIVACY/28PRIVACY-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/28/business/28PRIVACY/28PRIVACY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name