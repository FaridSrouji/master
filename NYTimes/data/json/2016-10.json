 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18brooksWeb/18brooksWeb-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18brooksWeb/18brooksWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/18/opinion/18brooksWeb/18brooksWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18brooksWeb/18brooksWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Power of a Dinner Table', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'What We  Need  Next', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poverty', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-10-18T07:21:13+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Brooks', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d2c6bfbf-a369-5af4-a99f-fbedaec00264', 'word_count': 816, 'uri': 'nyt://article/d2c6bfbf-a369-5af4-a99f-fbedaec00264'}, {'abstract': 'In a time of fear about migrants, it’s worth remembering that finding and resettling the world’s neediest refugees is an American tradition.', 'web_url': 'https://www.nytimes.com/2016/10/18/opinion/refugees-need-a-nations-better-angels.html', 'snippet': 'In a time of fear about migrants, it’s worth remembering that finding and resettling the world’s neediest refugees is an American tradition.', 'lead_paragraph': 'Sixteen years ago, Sasha Chanoff faced a decision that could mean life or death for 144 people. Chanoff, then 29, was working for the International Organization for Migration. He was in the Democratic Republic of Congo on a mission, negotiated by the United States government, to arrange safe passage out of the country for 112 refugees — ethnic Tutsis who had been imprisoned, raped and beaten, and had witnessed family members massacred.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18fixes1web/18fixes1web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/18/opinion/18fixes1web/18fixes1web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18fixes1web/18fixes1web-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18fixes1web/18fixes1web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18fixes1web/18fixes1web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/18/opinion/18fixes1web/18fixes1web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18fixes1web/18fixes1web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Refugees Need a Nation’s Better Angels', 'kicker': 'Fixes', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Chanoff, Sasha', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'International Organization for Migration', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Somalia', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Sudan', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'RefugePoint', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-10-18T07:21:14+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Bornstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Bornstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d586b551-d597-52d1-a2de-369276b9ffbf', 'word_count': 1987, 'uri': 'nyt://article/d586b551-d597-52d1-a2de-369276b9ffbf'}, {'abstract': 'Americans have traded and passed down the remains of executed slaves for generations. It’s time to stop.', 'web_url': 'https://www.nytimes.com/2016/10/18/opinion/nat-turners-skull-and-my-students-purse-of-skin.html', 'snippet': 'Americans have traded and passed down the remains of executed slaves for generations. It’s time to stop.', 'lead_paragraph': 'This month, Richard Hatcher, a former mayor of Gary, Ind., delivered what researchers suspect is the skull of Nat Turner, the rebel slave, to Turner’s descendants. The skull had been kept as a relic, sold and probably handed down through generations, for nearly 185 years. If DNA tests confirm that the skull is genuine, then Turner’s family will have the opportunity to lay their famous relative to rest.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18berry/18berry-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/18/opinion/18berry/18berry-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18berry/18berry-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18berry/18berry-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/18/opinion/18berry/18berry-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18berry/18berry-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/18/opinion/18berry/18berry-superJumbo.jpg', 'height': 1797, 'width': 1797, 'subType': 'superJumbo', 'crop_name': 'su