bType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'App Smart | Beating Black Friday', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mobile Applications', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black Friday and Cyber Monday (Shopping)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-11-25T17:53:11+0000', 'document_type': 'multimedia', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By KIT EATON and DALLAS JENSEN', 'person': [{'firstname': 'Kit', 'middlename': None, 'lastname': 'EATON', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Dallas', 'middlename': None, 'lastname': 'JENSEN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/738f40cd-fbb5-507e-a3dc-17fe253377f4', 'word_count': 0, 'uri': 'nyt://video/738f40cd-fbb5-507e-a3dc-17fe253377f4'}, {'abstract': 'Shopping apps that help buyers build wish lists, track prices and find the best deals.', 'web_url': 'https://www.nytimes.com/2015/11/26/technology/personaltech/video-feature-replacing-the-black-friday-rush-with-a-few-leisurely-taps.html', 'snippet': 'Shopping apps that help buyers build wish lists, track prices and find the best deals.', 'lead_paragraph': 'This Black Friday, you won’t find me charging into stores at the crack of dawn in search of supposed bargains. That’s because often the best prices for many products aren’t found on this famous shopping day. Instead, I plan to buy from the comfort of my couch, with the help of apps that tell me the optimal time to purchase things I want.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video Feature: Replacing the Black Friday Rush With a Few Leisurely Taps', 'kicker': 'App Smart', 'content_kicker': None, 'print_headline': 'Replacing the Black Friday Rush With a Few Leisurely Taps', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Eaton, Kit', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mobile Applications', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Black Friday and Cyber Monday (Shopping)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-25T17:53:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Kit Eaton', 'person': [{'firstname': 'Kit', 'middlename': None, 'lastname': 'Eaton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/81419f8e-da19-5e07-8a72-12cf20f00e16', 'word_count': 770, 'uri': 'nyt://article/81419f8e-da19-5e07-8a72-12cf20f00e16'}, {'abstract': 'MCC Theater is presenting Noah Haidle’s play.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2015/11/25/zachary-quinto-and-robin-tunney-to-star-in-smokefall-off-broadway/', 'snippet': 'MCC Theater is presenting Noah Haidle’s play.', 'lead_paragraph': 'When Zachary Quinto returns to the stage\xa0in MCC Theater’s “Smokefall” early next year, he will be joined by Robin Tunney of CBS’s “The Mentalist” and Julia Garner, a costar with Lily Tomlin in the independent film “Grandma.”', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Zachary Quinto and Robin Tunney to Star in ‘Smokefall’ Off Broadway', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Quinto and Tunney to Star in u2018Smokefallu2019', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Garner, Julia (1994- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kauffman, Anne', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Quinto, Zachary', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Tunney, Robin', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'MCC Theater', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-11-25T17:54:45+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Joshua Barone', 'person': [{'firstname': 'Joshua', 'middlename': None, 'lastname': 'Barone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a65db2be-0256-5891-bafe-6c8dff701a74', 'word_count': 166, 'uri': 'nyt://article/a65db2be-0256-5891-bafe-6c8dff701a74'}, {'abstract': 'The show, by Griffin Matthews, was inspired by his work at an orphanage in Uganda.', 'web_url': 'https://www.nytimes.com/2015/11/29/theater/invisible-thread-a-new-musical-at-second-stage.html', 'snippet': 'The show, by Griffin Matthews, was inspired by his work at an orphanage in Uganda.', 'lead_paragraph': 'When Griffin Matthews, a New York actor in his 20s tired of the usual audition-audition-rejection routine, decided to head to Uganda as a volunteer for a charity, he didn’t have writing a musical in mind. But his work at an orphanage there and its life-changing aspects have become the basis for “Invisible Thread,” a musical he wrote with his partner, Matt Gould, coming to Second Stage Theater.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/arts/29GUIDE2/29GUIDE2-artic