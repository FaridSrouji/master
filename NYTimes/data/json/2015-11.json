name': 'subject', 'value': 'Shopping and Retail', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Economics (Theory and Philosophy)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-11-07T19:30:20+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Diane Coyle', 'person': [{'firstname': 'Diane', 'middlename': None, 'lastname': 'Coyle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0cda508e-d6cc-5d1c-a06c-d000dcae699b', 'word_count': 1171, 'uri': 'nyt://article/0cda508e-d6cc-5d1c-a06c-d000dcae699b'}, {'abstract': 'Science will sometimes be off the mark. That doesn’t mean it can be ignored.', 'web_url': 'https://opinionator.blogs.nytimes.com/2015/11/07/the-rules-of-denialism/', 'snippet': 'Science will sometimes be off the mark. That doesn’t mean it can be ignored.', 'lead_paragraph': 'We’ve all heard the phrase “you’re entitled to your own opinion, but not your own facts.” Opinions are the sorts of things about which we can take a poll. They are sometimes well-informed, but rarely expected to be anything other than subjective. Facts, on the other hand, are “out there” in the world, separate from us, so it makes little sense to ask people what they think of them. As the comedian John Oliver so aptly put it in commenting on a recent Gallup poll that found that one in four Americans disbelieve in climate change: “You don’t need people’s opinion on a fact. You might as well have a poll asking: ‘Which number is bigger, 15 or 5?’ Or ‘Do owls exist’ or ‘Are there hats?’”', 'print_section': 'SR', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/09stoneWeb/09stoneWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/09/opinion/09stoneWeb/09stoneWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/09stoneWeb/09stoneWeb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/09stoneWeb/09stoneWeb-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/09stoneWeb/09stoneWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/09/opinion/09stoneWeb/09stoneWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/09stoneWeb/09stoneWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Price of Denialism', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': 'The Price of Denialism', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Global Warming', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Science and