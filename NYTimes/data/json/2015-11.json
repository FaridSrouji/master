ajor': 'N'}, {'name': 'organizations', 'value': 'H2 (TV Network)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Cable Television', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Media', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-11-03T13:52:32+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Sydney Ember', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Ember', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f68aa9ee-cdc4-553d-a4a6-c7523f4d7206', 'word_count': 585, 'uri': 'nyt://article/f68aa9ee-cdc4-553d-a4a6-c7523f4d7206'}, {'abstract': 'Envisioning a day when prime-time college or pro football telecasts are available every day of the season.', 'web_url': 'https://www.nytimes.com/2015/11/04/upshot/brace-for-the-nonstop-football-league.html', 'snippet': 'Envisioning a day when prime-time college or pro football telecasts are available every day of the season.', 'lead_paragraph': 'With November arrived, Tuesday and Wednesday prime-time football begins — tonight in college action it’s the Northern Illinois Huskies versus the Toledo Rockets. Next month bowl mania kicks off, followed by the N.F.L. postseason: It’s pretty much wall-to-wall cleats and pads. This raises a question many might prefer not be raised: How soon till there is a nationally telecast football game every single day from school back in session till the Super Bowl? That is to say, how long till a Nonstop Football League?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/upshot/04UP-TMQ-A/04UP-TMQ-A-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': '