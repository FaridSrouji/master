ubType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Peculiar Ascent of Bill Murray to Secular Saint', 'kicker': 'Phenomena', 'content_kicker': None, 'print_headline': 'From Star to Symbol', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Murray, Bill', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Celebrities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'ACTORS AND ACTRESSES', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'T-Shirts (Apparel)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-30T21:47:01+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'subsection_name': 'Men’s Style', 'byline': {'original': 'By Steven Kurutz', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Kurutz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d3dd2bef-45d5-5092-9749-25ca33fe1f74', 'word_count': 1832, 'uri': 'nyt://article/d3dd2bef-45d5-5092-9749-25ca33fe1f74'}, {'abstract': 'Researchers found that frosty meadowlands and patchy subalpine forest predominated in the Triangle Lake region during the last ice age.', 'web_url': 'https://www.nytimes.com/2015/12/01/science/oregon-valley-wasnt-always-forest-covered-study-says.html', 'snippet': 'Researchers found that frosty meadowlands and patchy subalpine forest predominated in the Triangle Lake region during the last ice age.', 'lead_paragraph': 'Forests cover the mountainous Triangle Lake valley of the Oregon Coast Range, but that was not always the case, researchers found. Sediment samples from 200 feet below the surface of Little Lake, the remnant of an ancient lake that was much larger, show that frosty meadowlands and patchy subalpine forest predominated in the region during the last ice age, 26,000 to 13,000 years ago. The primary cause of erosion then was not rainfall but frost cracking. Erosion rates were at least two and a half times higher than today’s rates, according to the researchers, who published their study in Science Advances. Parts of the United States not covered by glaciers during the period, from Oregon to Georgia, may have resembled southeastern Alaska, they said.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/12/01/science/01OBSEROSION/01OBSEROSION-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/12/01/science/01OBSEROSION/01OBSEROSION-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/12/01/science/01OBSEROSION/01OBSEROSION-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/12/01/science/01OBSEROSION/01OBSEROSION-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/12/01/science/01OBSEROSION/01OBSEROSION-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/12/01/science/01OBSEROSION/01OBSEROSION-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/12/01/science/01OBSEROSION/01OBSEROSION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Oregon Valley Wasn’t Always Forest-Covered, Study Says', 'kicker': 'Observatory', 'content_kicker': None, 'print_headline': 'Geology: Bottom of Lake Reveals World Above', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Forests and Forestry', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Oregon', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Science Advances (Journal)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Ice Age', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-30T21:52:43+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Sindya N. Bhanoo', 'person': [{'firstname': 'Sindya', 'middlename': 'N.', 'lastname': 'Bhanoo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3b07e8cf-fb33-5fcc-8be9-629f2653377f', 'word_count': 124, 'uri': 'nyt://article/3b07e8cf-fb33-5fcc-8be9-629f2653377f'}, {'abstract': 'Since 1993, the average rate of increase in sea level has nearly doubled. By 2081, yearly increases are likely to be as high as 16 millimeters a year.', 'web_url': 'https://www.nytimes.com/2015/12/01/science/3-2-millimeters-a-troubling-rise-in-sea-level.html', 'snippet': 'Since 1993, the average rate of increase in sea level has nearly doubled. By 2081, yearly increases are likely to be as high as 16 millimeters a year.', 'lead_paragraph': 'Sea levels are rising, and rising faster every year.', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/12/02/science/01number/01number-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/12/02/science/01number/01number-arti