 None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Chefs', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Gardner, Isabella Stewart, Museum', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-11-19T18:36:30+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Katharine Q. Seelye', 'person': [{'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/143f8241-4f0a-541b-a2fe-48962d66db1d', 'word_count': 673, 'uri': 'nyt://article/143f8241-4f0a-541b-a2fe-48962d66db1d'}, {'abstract': 'Plus: What to do when social media takes on the boss; handling an invitee who changes her mind; setting rules for a boorish house guest.', 'web_url': 'https://www.nytimes.com/2015/11/22/fashion/thanksgiving-guest-list-woes.html', 'snippet': 'Plus: What to do when social media takes on the boss; handling an invitee who changes her mind; setting rules for a boorish house guest.', 'lead_paragraph': 'My brother and his wife are divorcing. My sister-in-law usually holds Thanksgiving, but this year I am, due to their circumstances. My brother said he will “give up” the holiday and we should invite his wife and children. (He is seeing another woman and probably wants to spend the day with her. Meanwhile, my sister-in-law has been texting me about his infidelity. Too weird!) I like my sister-in-law, but she’s not family. But if I don’t invite her, we won’t see the kids. I told my brother they should all come, but he was noncommittal. Ideas?', 'print_section': 'ST', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'u