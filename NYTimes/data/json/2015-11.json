ds': [{'name': 'persons', 'value': 'Xi Jinping', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ma Ying-jeou', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Taiwan', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Singapore', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-07T07:08:45+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Austin Ramzy', 'person': [{'firstname': 'Austin', 'middlename': None, 'lastname': 'Ramzy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/27d59db0-9f7f-5309-8277-962701c22679', 'word_count': 1362, 'uri': 'nyt://article/27d59db0-9f7f-5309-8277-962701c22679'}, {'abstract': 'In a speech in Singapore before he met the president of Taiwan, China’s president asked countries “outside the region” to respect stability in the area.', 'web_url': 'https://www.nytimes.com/2015/11/08/world/asia/xi-jinping-china-south-china-sea-singapore.html', 'snippet': 'In a speech in Singapore before he met the president of Taiwan, China’s president asked countries “outside the region” to respect stability in the area.', 'lead_paragraph': 'BEIJING — President Xi Jinping of China said in a speech on Saturday morning in Singapore that islands in the South China Sea “have been China’s territory since ancient times,” and that countries from outside the region should respect the need of Asian nations for a “peaceful and stable environment” so the nations could develop rapidly.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Xi Again Defends China’s Claim to South China Sea Islands', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Xi Jinping', '