value': 'Diaz, Shari', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ball, Wicki', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-03T00:21:04+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Scott Cacciola', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Cacciola', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d79250e3-6665-56dc-bb3b-db9ba9fec7ef', 'word_count': 1058, 'uri': 'nyt://article/d79250e3-6665-56dc-bb3b-db9ba9fec7ef'}, {'abstract': 'More than 2,000 families were displaced, and the main seaport for the island of Socotra was washed away.', 'web_url': 'https://www.nytimes.com/2015/11/03/world/middleeast/yemen-powerful-storm-strikes-island.html', 'snippet': 'More than 2,000 families were displaced, and the main seaport for the island of Socotra was washed away.', 'lead_paragraph': ' A powerful cyclone struck an island off the coast of Yemen on Monday, washing away the island’s main seaport and displacing more than 2,000 families, according to Saeed Bahegeba, the governor of the island, Socotra. The storm, known as Chapala, then threatened the Yemeni mainland. By Monday evening, the cyclone was bearing down on Al Mukalla, the country’s fifth-largest city, which has been under the control of the Al Qaeda affiliate in Yemen since April. ', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Yemen: Powerful Storm Strikes Island', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Middle East; Yemen: Powerful Storm Strikes Island', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Yemen', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricanes and Tropical Storms', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cyclones', 'ra