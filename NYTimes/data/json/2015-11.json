r': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-11-14T06:43:37+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0c57fec1-76c4-59f9-a7e8-09c7f56caf24', 'word_count': 412, 'uri': 'nyt://article/0c57fec1-76c4-59f9-a7e8-09c7f56caf24'}, {'abstract': 'American media outlets rushed reporters to Paris, while networks shifted their programming in the wake of the killings.', 'web_url': 'https://www.nytimes.com/2015/11/15/business/media/paris-shooting-attacks-news-media-coverage.html', 'snippet': 'American media outlets rushed reporters to Paris, while networks shifted their programming in the wake of the killings.', 'lead_paragraph': 'The American news media scrambled on Friday evening and early Saturday to cover the deadly attacks in Paris, an event unfolding thousands of miles away in multiple locations across a city gripped by terror and uncertainty.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'News Media Scrambles to Cover Paris Shootings', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Paris Attacks (November 2015)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bataclan (Paris, France)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-14T09:12:46+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By John Koblin', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Ko