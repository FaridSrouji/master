name': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/599e6e6d-bdeb-5347-ad4e-29326a458c2f', 'word_count': 370, 'uri': 'nyt://article/599e6e6d-bdeb-5347-ad4e-29326a458c2f'}, {'abstract': 'Recently reviewed books of particular interest.', 'web_url': 'https://www.nytimes.com/2015/11/22/books/review/editors-choice.html', 'snippet': 'Recently reviewed books of particular interest.', 'lead_paragraph': 'LETTERS TO VÉRA, by Vladimir Nabokov. Edited and translated by Olga Voronina and Brian Boyd. (Knopf, $40.) For more than half a century, Nabokov told his wife about his writing, his meals and his observations in exquisite and evocative detail.', 'print_section': 'BR', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Editors’ Choice | Recent Books of Particular Interest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2015-11-20T16:42:42+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9861171d-ae14-56ee-8eec-5140810e00fd', 'word_count': 265, 'uri': 'nyt://article/9861171d-ae14-56ee-8eec-5140810e00fd'}, {'abstract': 'A memoir by the singer and songwriter Chrissie Hynde.', 'web_url': 'https://www.nytimes.com/2015/11/22/books/review/chrissie-hyndes-reckless-my-life-as-a-pretender.html', 'snippet': 'A memoir by the singer and songwriter Chrissie Hynde.', 'lead_paragraph': 'As the title indicates, “Reckless” is intended to be a cautionary tale. For 35 years, Chrissie Hynde has carried herself as a keeper of the rock ’n’ roll flame, fearless and invulnerable; while the other members of her band, the Pretenders, continually change, she has never wavered from the punk spirit and pop songcraft, nor the signature bangs and eyeliner, that made her one of music’s great \xadfrontwomen.', 'print_section': 'BR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/22LIGHT/22LIGHT-articleLarge.jpg', 'height': 859, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/22/books/review/22LIGHT/22LIGHT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 859}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/22LIGHT/22LIGHT-jumbo.jpg', 'height': 1024, 'width': 715, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/22LIGHT/22LIGHT-superJumbo.jpg', 'height': 2048, 'width': 1430, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/22LIGHT/22LIGHT-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/22/books/review/22LIGHT/22LIGHT-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/22LIGHT/22LIGHT-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chrissie Hynde’s ‘Reckless: My Life as a Pretender’', 'kicker': 'Audiobooks', 'content_kicker': None, 'print_headline': 'The Great Pretender', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Audiobooks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hynde, Chrissie', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Arquette, Rosanna', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Pretenders (Music Group)', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'Reckless: My Life as a Pretender (Book)', 'rank': 9, 'major': 'N'}], 'pub_date': '2015-11-20T16:44:33+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Alan Light', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Light', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0fbc1e0f-6ac9-5db8-a0b3-4a3baf5b97be', 'word_count': 865, 'uri': 'nyt://article/0fbc1e0f-6ac9-5db8-a0b3-4a3baf5b97be'}, {'abstract': 'The Wallace Stevens poem from which it takes its title helps structure the novella anchoring Colum McCann’s book of short fiction.', 'web_url': 'https://www.nytimes.com/2015/11/22/books/review/thirteen-ways-of-looking-by-colum-mccann.html', 'snippet': 'The Wallace Stevens poem from which it takes its title helps structure the novella anchoring Colum McCann’s book of short fiction.', 'lead_paragraph': 'Colum McCann has an old-school belief in the capabilities of literature. Even as au courant novelists all around him grow skeptical of the artifices of character and plot, and embrace the self as the fiction writer’s only truly accessible subject, McCann’s work continues to assert that nothing human is alien to him, that the empathetic imagination can and should go where it pleases. He has written eight previous books in which he fearlessly simulates identities dauntingly remote from his own — including the identities of real-life figures both dead and living — and in which plot performs a function that might fairly be described as redemptive. From the perspective of academic fashion it is a hoary, virtually benighted approach to narrative art; yet to judge by the enormous success of his work, most notably the panoramic novels “Let the Great World Spin” and “TransAtlantic,” its appeal to readers somehow endures.', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/1122-BKS-Dee/1122-BKS-Dee-articleLarge.jpg', 'height': 565, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/22/books/review/1122-BKS-Dee/1122-BKS-Dee-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 565}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/1122-BKS-Dee/1122-BKS-Dee-jumbo.jpg', 'height': 965, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/1122-BKS-Dee/1122-BKS-Dee-superJumbo.jpg', 'height': 1522, 'width': 1615, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/22/books/review/1122-BKS-Dee/1122-BKS-Dee-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/22/books/review/1122-BKS-Dee/1122-BKS-Dee-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'capt