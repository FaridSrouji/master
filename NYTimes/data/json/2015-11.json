/02series-hp-win-2/02series-hp-win-2-articleLarge-v3.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/02/sports/02series-hp-win-2/02series-hp-win-2-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/02/sports/02series-hp-win-2/02series-hp-win-2-jumbo-v3.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/02/sports/02series-hp-win-2/02series-hp-win-2-superJumbo-v3.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/02/sports/02series-hp-win-2/02series-hp-win-2-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/02/sports/02series-hp-win-2/02series-hp-win-2-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/02/sports/02series-hp-win-2/02series-hp-win-2-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Royals Rally Past Mets for First World Series Title Since 1985', 'kicker': 'Royals 7, Mets 2 (12 innings)', 'content_kicker': None, 'print_headline': 'Their Majesties', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Witz, Billy', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Kansas City Royals', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'World Series', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-02T05:34:40+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Billy Witz', 'person': [{'firstname': 'Billy', 'middlename': None, 'lastname': 'Witz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fab3a933-35d5-5b7f-a08d-8914f9e02a07', 'word_count': 1543, 'uri': 'nyt://article/fab3a933-35d5-5b7f-a08d-8914f9e02a07'}, {'abstract': 'Researchers at the Natural History Museum of Denmark say that climate change is affecting specialized insects that rely on a single food source.', 'web_url': 'https://www.nytimes.com/2015/11/03/science/a-rooftop-view-of-insect-migration-in-a-warming-climate.html', 'snippet': 'Researchers at the Natural History Museum of Denmark say that climate change is affecting specialized insects that rely on a single food source.', 'lead_paragraph': 'The Natural History Museum of Denmark has studied the insect population on its rooftop for 18 years, tracking 1,543 species of moths and beetles and more than 250,000 individuals. In a study appearing in The Journal of Animal Ecology, museum researchers conclude that warming temperatures are affecting specialized insects that rely on a single food source. The nut weevil, for example, feeds only on hazelnuts; it appeared on the roof during the first half of the study but not the second. Scientists at the museum suspect that the nut weevil and other specialists are moving north, where the climate is cooler.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/03/science/03OBS/03OBS-articleLarge-v4.jpg', 'height': 415, 'width': 600, '