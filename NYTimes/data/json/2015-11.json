p_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Weekly News Quiz | Oct. 27-Nov. 2, 2015', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-11-03T12:24:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fa825792-a6c6-5761-a478-09e5b1e5ae6c', 'word_count': 69, 'uri': 'nyt://article/fa825792-a6c6-5761-a478-09e5b1e5ae6c'}, {'abstract': 'Come fall, when the crowds and cars and high-season glamour fade, turkeys, like so many other things in the Hamptons, come into their own.', 'web_url': 'https://www.nytimes.com/2015/11/08/travel/hamptons-autumn-off-season.html', 'snippet': 'Come fall, when the crowds and cars and high-season glamour fade, turkeys, like so many other things in the Hamptons, come into their own.', 'lead_paragraph': 'On a windswept morning in late October, a dozen wild turkeys crashed through the oak trees and landed unceremoniously on the patch of moss, grass and leaves that my husband and I call a lawn. I was on my way out the door, looking forward to a drive on the back roads near our house in Springs, a wooded hamlet in the town of East Hampton. The sight of the birds stopped me in my tracks. The screen door slipped from my hand. The slam rang out like a gunshot. A cloud of crows burst from the trees, and the turkeys, like the fantastical airships in a Philip Pullman novel, sailed across the fence and were gone.', 'print_section': 'TR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/08/travel/08HAMPTONS/08HAMPTONS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/08/travel/08HAMPTONS/08HAMPTONS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/08/travel/08HAMPTONS/08HAMPTONS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/08/travel/08HAMPTONS/08HAMPTONS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/08/travel/08HAMPTONS/08HAMPTONS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/08/travel/08HAMPTONS/08HAMPTONS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/08/travel/08HAMPTONS/08HAMPTONS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hamptons’ True Colors Show in Autumn Off-Season', 'kicker': 'Off-Season', 'content_kicker': None, 'print_headline': 'An Autumnal Stage Set', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'MacNeille, Suzanne', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Autumn (Season)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'East Hampton (NY)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Island (NY)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Hamptons (NY)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-03T12:39:25+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Suzanne MacNeille', 'person': [{'firstname': 'Suzanne', 'middlename': None, 'lastname': 'MacNeille', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c7eba1ce-3c6e-5518-a53f-0ed963a57d37', 'word_count': 1998, 'uri': 'nyt://article/c7eba1ce-3c6e-5518-a53f-0ed963a57d37'}, {'abstract': 'Ms. Colby is now a pro at keeping up her exercise routine on the road, saving time at airports and relying on apps to make travel a bit easier.', 'web_url': 'https://www.nytimes.com/2015/11/08/travel/jamie-colby-travel-tips.html', 'snippet': 'Ms. Colby is now a pro at keeping up her exercise routine on the road, saving time at airports and relying on apps to make travel a bit easier.', 'lead_paragraph': 'As a television journalist specializing in news, Jamie Colby, 54, has traveled the world covering major events like the tsunami in Asia and the papal conclave at the Vatican, but nothing prepared her for being the host of “Strange Inheritance” on Fox Business Network. The second season of the series, debuting on Nov. 11, took her from her home in New York City to 20 states and one country, Britain, to speak with people saddled with unusual inheritances like a military tank collection in California, a frontier fort in Texas and a 17th-century shipwreck in Florida.', 'print_section': 'TR', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/08/travel/08QA2/08QA2-articleLarge.jpg', 'height': 598, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/08/travel/08QA2/08QA2-articleLarge.jpg', 'xlargewidth': 600, 'xlargehei