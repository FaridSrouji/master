N'}, {'name': 'persons', 'value': 'Munoz, Oscar (1959- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hart, Brett J (1969- )', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-06T02:08:00+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Jad Mouawad', 'person': [{'firstname': 'Jad', 'middlename': None, 'lastname': 'Mouawad', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/62788346-5549-5a1f-a213-6745d51361bc', 'word_count': 93, 'uri': 'nyt://article/62788346-5549-5a1f-a213-6745d51361bc'}, {'abstract': 'If you’re looking to wow your crowd this Thanksgiving, consider these festive eggplant rolls.', 'web_url': 'https://well.blogs.nytimes.com/2015/11/05/vegetarian-thanksgiving-festive-eggplant-rolls/', 'snippet': 'If you’re looking to wow your crowd this Thanksgiving, consider these festive eggplant rolls.', 'lead_paragraph': 'If you’re looking to wow your crowd this Thanksgiving, consider these festive eggplant rolls. Courtesy of reader Christine Vartanian Datian of Las Vegas, these decadent rolls of Japanese eggplant strips, ricotta and walnuts are colorful and tasty, with an added crunch.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/06/science/welleggplant/welleggplant-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/06/science/welleggplant/welleggplant-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/06/science/welleggplant/welleggplant-jumbo.jpg', 'height': 682, 'width': 1024, 'subType':