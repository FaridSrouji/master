or': 'N'}, {'name': 'organizations', 'value': 'Louisiana State University', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Alabama', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-08T05:49:16+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Marc Tracy', 'person': [{'firstname': 'Marc', 'middlename': None, 'lastname': 'Tracy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/edaf1de4-0ae2-5d86-9171-6a202ad82a09', 'word_count': 1034, 'uri': 'nyt://article/edaf1de4-0ae2-5d86-9171-6a202ad82a09'}, {'abstract': 'From the International Herald Tribune archives: Robert C. Weaver voices his desire to run the Department of Urban Development in 1965.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/11/08/1965-african-american-seeks-cabinet-post/', 'snippet': 'From the International Herald Tribune archives: Robert C. Weaver voices his desire to run the Department of Urban Development in 1965.', 'lead_paragraph': 'WASHINGTON — It has become an axiom in the Johnson era that if a man wants a high government post, the last thing he does is say so. And a newspaper story saying that an official desires a cabinet job, or is under consideration, is regarded as the surest path to early retirement. Consequently, it raised eyebrows in official Washington today [Nov. 8] when Robert C. Weaver, the highest- ranking Negro in the government, answered ‘‘yes,’’ when asked whether he wanted the cabinet post of secretary of the new Department of Housing and Urban Development. The department, still headless, comes into being at 12:01 a.m. tomorrow. President Johnson hasn’t indicated his choice for the new cabinet post, and won’t until early next year, according to a White House announcement over the weekend. — New York Herald Tribune, European Edition, November 9, 1965', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/blogs/09iht-oldnov09-weaver/09iht-oldnov09-weaver-articleLarge.jpg', 'height': 887, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/09/blogs/09iht-oldnov09-weaver/09iht-oldnov09-weaver-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 887}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/blogs/09iht-oldnov09-weaver/09iht-oldnov09-weaver-jumbo.jpg', 'height': 1024, 'width': 693, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/blogs/09iht-oldnov09-weaver/09iht-oldnov09-weaver-superJumbo.jpg', 'height': 2000, 'width': 1353, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/blogs/09iht-oldnov09-weaver/09iht-oldnov09-weaver-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/09/blogs/09iht-oldnov09-weaver/09iht-oldnov09-weaver-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/blogs/09iht-oldnov09-weaver/09iht-oldnov09-weaver-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '1965: African-American Seeks Cabinet Post', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Johnson, Lyndon Baines', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Housing and Urban Development Department', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Washington (DC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-11-08T06:00:04+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ffb5174-8e5d-57d4-a060-d89b591c6d03', 'word_count': 142, 'uri': 'nyt://article/0ffb5174-8e5d-57d4-a060-d89b591c6d03'}, {'abstract': 'The candidate’s gig as a guest host suggested he is most at ease when hosting his own, seemingly never-ending TV show, rather than somebody else’s.', 'web_url': 'https://www.nytimes.com/politics/first-draft/2015/11/08/donald-trump-is-breezy-but-not-very-funny-as-host-on-saturday-night/', 'snippet': 'The candidate’s gig as a guest host suggested he is most at ease when hosting his own, seemingly never-ending TV show, rather than somebody else’s.', 'lead_paragraph': 'Donald J. Trump, making his first appearance on “Saturday Night Live” as a presidential candidate, was satirized by two well-coiffed doppelgängers, who attempted (admirably) to outboast him in matching red ties. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/nyregion/09trump-snl/08trumpe-snl-articleLarge.jpg', 'height': 435, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/09/nyregion/09trump-snl/08trumpe-snl-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 435}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/nyregion/09trump-snl/08trumpe-snl-jumbo.jpg', 'he