e_of_material': 'News', '_id': 'nyt://article/644177ad-cd63-5df4-830f-1f5ce16d787b', 'word_count': 221, 'uri': 'nyt://article/644177ad-cd63-5df4-830f-1f5ce16d787b'}, {'abstract': 'The United Nations warned that a resurgence of violence has driven tens of thousands of people from their homes and threatens humanitarian aid.', 'web_url': 'https://www.nytimes.com/2015/11/28/world/africa/pope-francis-central-african-republic.html', 'snippet': 'The United Nations warned that a resurgence of violence has driven tens of thousands of people from their homes and threatens humanitarian aid.', 'lead_paragraph': 'GENEVA — Only days before Pope Francis is scheduled to visit the Central African Republic, the United Nations warned on Friday that a resurgence of violence in the conflict-torn nation has driven tens of thousands of people from their homes and increasingly threatens the delivery of humanitarian aid to the impoverished population.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'As Pope Francis’ Visit Nears, Central African Republic Violence Rises', 'kicker': None, 'content_kicker': None, 'print_headline': 'World Briefing | Africa; Central African Republic: Violence Is Rising, U.N. Agency Warns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cumming-Bruce, Nick', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Central African Republic', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Francis', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-27T16:48:04+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Nick Cummi