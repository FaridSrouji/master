1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/07/arts/07lulu/07lulu-articleLarge.jpg', 'height': 422, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/07/arts/07lulu/07lulu-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 422}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/07/arts/07lulu/07lulu-jumbo.jpg', 'height': 720, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/07/arts/07lulu/07lulu-superJumbo.jpg', 'height': 1440, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/07/arts/07lulu/07lulu-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/07/arts/07lulu/07lulu-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/07/arts/07lulu/07lulu-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: Finding Beauty in a Wrenching ‘Lulu’ at the Met', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Taunting Mirror of Her Hapless Lovers’ Desires  ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tommasini, Anthony', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Opera', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Berg, Alban', 'rank': 