, 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Public and Subsidized Housing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Homeless Persons', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Group Homes and Supportive Housing', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-19T02:38:46+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Nikita Stewart', 'person': [{'firstname': 'Nikita', 'middlename': None, 'lastname': 'Stewart', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b8728e6-c637-5b98-aedc-31817b239f6a', 'word_count': 806, 'uri': 'nyt://article/5b8728e6-c637-5b98-aedc-31817b239f6a'}, {'abstract': 'Andre Gomes, a Brooklyn resident, is looking for work after falling twice in 2014 while he was helping to install pipes with a residential building construction company.', 'web_url': 'https://www.nytimes.com/2015/11/19/nyregion/with-eviction-looming-an-injured-worker-accelerates-his-job-search.html', 'snippet': 'Andre Gomes, a Brooklyn resident, is looking for work after falling twice in 2014 while he was helping to install pipes with a residential building construction company.', 'lead_paragraph': 'For the 18 months he was homeless, Andre Gomes spent nights sleeping on No. 6 subway trains. He felt safer on the trains than he did in a shelter, where people had threatened his life and knocked out his bottom teeth.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/17/nyregion/NEEDIEST-Gomes/NEEDIEST-Gomes-articleLarge.jpg', 'height': 400, 'width':