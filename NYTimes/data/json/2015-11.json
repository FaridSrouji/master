w York Times', 'multimedia': [], 'headline': {'main': 'Kevin Barry’s ‘Beatlebone’ Wins Goldsmiths Prize', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Awards, Decorations and Honors', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Barry, Kevin (1969- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-12T20:44:41+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By John Williams', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45a44956-0d7a-56de-9016-9624696273b4', 'word_count': 131, 'uri': 'nyt://article/45a44956-0d7a-56de-9016-9624696273b4'}, {'abstract': 'Nearly one-third of the newly promoted employees are millennials, and one-quarter are women.', 'web_url': 'https://www.nytimes.com/2015/11/13/business/dealbook/goldman-sachs-names-425-new-managing-directors.html', 'snippet': 'Nearly one-third of the newly promoted employees are millennials, and one-quarter are women.', 'lead_paragraph': 'Nearly a third of the Goldman Sachs Group’s 425 newly minted managing directors are millennials, or people born after 1980. Forty percent were hired as analysts. Roughly 21 percent are former summer interns.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Goldman Sachs Names 425 New Managing Directors', 'kicker': None, 'content_kicker': None, 'print_headline': 'Up the Ladder', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Moyer, Liz', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Goldman Sachs Group Inc', 'rank': 2, 'major': '