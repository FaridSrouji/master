land)', 'rank': 4, 'major': 'N'}], 'pub_date': '2015-11-04T20:27:45+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Lawrence Downes', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Downes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2de77a00-6035-5e27-a292-4a1fb82b3ddd', 'word_count': 136, 'uri': 'nyt://article/2de77a00-6035-5e27-a292-4a1fb82b3ddd'}, {'abstract': 'Several Supreme Court justices said they did not want to avoid hearing challenges to gerrymandering, but also said they did not want to be required to rule on them.', 'web_url': 'https://www.nytimes.com/2015/11/05/us/politics/supreme-court-justices-fear-loss-of-control-over-redistricting-cases.html', 'snippet': 'Several Supreme Court justices said they did not want to avoid hearing challenges to gerrymandering, but also said they did not want to be required to rule on them.', 'lead_paragraph': 'WASHINGTON — At a Supreme Court  argument on Wednesday about procedures in redistricting cases, the justices appeared to be trying to reconcile two conflicting impulses. They did not want to close the door entirely on challenges to gerrymandering, but they also did not want to be required to rule on them.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/05/us/05scotus-web-sub/05scotus-web-sub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/05/us/05scotus-web-sub/05scotus-web-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/05/us/05scotus-web-sub/05scotus-web-sub-jumbo