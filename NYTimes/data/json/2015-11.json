n': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4860474f-e243-5f3b-ab13-791abb0c5010', 'word_count': 1046, 'uri': 'nyt://article/4860474f-e243-5f3b-ab13-791abb0c5010'}, {'abstract': 'The Italian painter, who died in 1964, is the subject of two current shows.', 'web_url': 'https://www.nytimes.com/2015/11/20/arts/design/giorgio-morandi-creates-a-universe-on-a-tabletop.html', 'snippet': 'The Italian painter, who died in 1964, is the subject of two current shows.', 'lead_paragraph': 'In memory, the still lifes of the Italian painter Giorgio Morandi (1890-1964) can sometimes seem like the medium’s best comfort food — familiar, satisfying and a little monotonous. His repeating images of humble domestic objects — bottles, long-necked vases and little cookie tins set against expanses of empty wall and tabletop — can blend together and appear steeped in nostalgia. This view is encouraged by the seemingly narrow circumstances of Morandi’s existence: he died in the same Bolognese apartment where he was born and lived his whole life, with his three unmarried sisters.', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20MORANDI/20MORANDI-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/20/arts/20MORANDI/20MORANDI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 393}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20MORANDI/20MORANDI-jumbo.jpg', 'height': 670, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20MORANDI/20MORANDI-superJumbo.jpg', 'height': 772, 'width': 1180, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20MORANDI/20MORANDI-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/20/arts/20MORANDI/20MORANDI-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20MORANDI/20MORANDI-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Giorgio Morandi Creates a Universe on a Tabletop', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Creating a Universe  on a Tabletop', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Center for Italian Modern Art', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Zwirner, David, Gallery', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Morandi, Giorgio', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-19T23:29:27+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/4da01f40-5c63-5079-b6f1-d70c96ff466d', 'word_count': 1180, 'uri': 'nyt://article/4da01f40-5c63-5079-b6f1-d70c96ff466d'}, {'abstract': 'Nohemi Gonzalez, a student from California and the only American known to have died in the attacks, was representative of the young, ambitious people who flock to the French capital.', 'web_url': 'https://www.nytimes.com/2015/11/20/world/europe/paris-terror-attacks-nohemi-gonzalez-cal-state-long-beach.html', 'snippet': 'Nohemi Gonzalez, a student from California and the only American known to have died in the attacks, was representative of the young, ambitious people who flock to the French capital.', 'lead_paragraph': 'PARIS — For Nohemi Gonzalez, a bubbly and determined first-generation Mexican-American from California, studying industrial design in Paris was the culmination of a dream.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paris Victim Nohemi Gonzalez Was Pursuing Her Dreams in Design', 'kicker': None, 'content_kicker': None, 'print_headline': 'American Was Pursuing Her Dreams of Design in Paris', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Paris Attacks (November 2015)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gonzalez, Nohemi (1992-2015)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Long Beach (Calif)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'California State University', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-19T23:31:31+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Dan Bilefsky', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Bilefsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/34bc9f09-e321-56d2-9a26-61e11907ab36', 'word_count': 1094, 'uri': 'nyt://article/34bc9f09-e321-56d2-9a26-61e11907ab36'}, {'abstract': 'This exhibition includes 24 works from the collection of the National Gallery of Denmark, selected by its chief curator, Kasper Monrad.', 'web_url': 'https://www.nytimes.com/2015/11/20/arts/design/vilhelm-hammershois-paintings-at-scandinavia-house.html', 'snippet': 'This exhibition includes 24 works from the collection of the National Gallery of Denmark, selected by its chief curator, Kasper Monrad.', 'lead_paragraph': 'One of Denmark’s most celebrated artists, Vilhelm Hammershoi (1864-1916), was known in his day as “the painter of tranquil rooms.” He worked during an era of great changes in Western art: Around the turn of the 20th century, traditional realism no longer seemed an adequate way to express the myriad revolutionary ideas percolating all over Europe. As viewers may observe in “Painting Tranquility: Masterworks by Vilhelm Hammershoi From SMK – The National Gallery of Denmark,” a beautiful small exhibition at Scandinavia House, his paintings convey a distinctively modern psychological complexity. But unlike another famous Scandinavian, the Expressionist Edvard Munch, Hammershoi practiced a kind of representational painting dating back to Rembrandt and Vermeer. With their severely muted colors, Hammershoi’s portraits and pictures of women in nearly empty rooms may call to mind the suavely subdued paintings of James McNeill Whistler. Although influenced by him, Hammershoi never pushed as far toward abstract abbreviation as Whistler.', 'print_section': 'C', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20HAMMERSHOI1/20HAMMERSHOI1-articleLarge.jpg', 'height': 528, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/20/arts/20HAMMERSHOI1/20HAMMERSHOI1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 528}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20HAMMERSHOI1/20HAMMERSHOI1-jumbo.jpg', 'height': 902, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20HAMMERSHOI1/20HAMMERSHOI1-superJumbo.jpg', 'height': 1803, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20HAMMERSHOI1/20HAMMERSHOI1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/20/arts/20HAMMERSHOI1/20HAMMERSHOI1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20HAMMERSHOI1/20HAMMERSHOI1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Vilhelm Hammershoi’s Paintings at Scandinavia House', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'A Danish Artist’s Mysterious, Tranquil Views', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Gallery of Denmark', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Scandinavia House', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hammershoi, Vilhelm', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-19T23:34:45+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Ken Johnson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b833e324-5c85-5c4a-a87b-318f83f43c04', 'word_count': 796, 'uri': 'nyt://article/b833e324-5c85-5c4a-a87b-318f83f43c04'}, {'abstract': 'The two nations are each acting to toughen emergency powers in the wake of the Paris attacks, but some wonder if the cost to personal liberty is too great.', 'web_url': 'https://www.nytimes.com/2015/11/20/world/europe/as-france-and-belgium-strengthen-security-a-classic-debate-arises.html', 'snippet': 'The two nations are each acting to toughen emergency powers in the wake of the Paris attacks, but some wonder if the cost to personal liberty is too great.', 'lead_paragraph': 'PARIS — Shocked by the carnage of the Paris attacks, France and Belgium moved aggressively on Thursday to strengthen the hand of their security forces, pushing Europe more deeply into a debate that has raged in the United States since Sept. 11, 2001: how to balance counterterrorism efforts and civil liberties.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/world/SECURITY1/SECURITY1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/20/world/SECURITY1/SECURITY1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/world/SECURITY1/SECURITY1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/world/SECURITY1/SECURITY1-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/world/SECURITY1/SECURITY1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbSta