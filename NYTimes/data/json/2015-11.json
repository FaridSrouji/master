e': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e9de0214-6583-5580-b98e-e1876792be49', 'word_count': 1224, 'uri': 'nyt://article/e9de0214-6583-5580-b98e-e1876792be49'}, {'abstract': 'A novel centered on an island actually owned by a Beatle is fashioned on what we know and think we know about him.', 'web_url': 'https://www.nytimes.com/2015/11/29/books/review/kevin-barrys-beatlebone.html', 'snippet': 'A novel centered on an island actually owned by a Beatle is fashioned on what we know and think we know about him.', 'lead_paragraph': 'Some of the very best fiction is spun from a single filament of fact woven \xadtightly — or loosely, if necessary — in and out of an asymmetrical framework of empathy, imagination and sheer audacity. Michael Ondaatje’s “Coming Through Slaughter” (about the early jazz trumpeter Buddy Bolden) and Nick Tosches’ “In the Hand of Dante” (about, among other things, the writing of “The Divine Comedy”) come to mind, both masterly literary extrapolations.', 'print_section': 'BR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Earle-01/1129-BKS-Earle-01-articleLarge-v2.jpg', 'height': 563, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/29/books/review/1129-BKS-Earle-01/1129-BKS-Earle-01-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 563}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Earle-01/1129-BKS-Earle-01-jumbo-v2.jpg', 'height': 961, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Earle-01/1129-BKS-Earle-01-superJumbo-v2.jpg', 'height': 1158, 'width': 1234, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Earle-01/1129-BKS-Earle-01-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/29/books/review/1129-BKS-Earle-01/1129-BKS-Earle-01-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Earle-01/1129-BKS-Earle-01-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kevin Barry’s ‘Beatlebone’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Imagine Lennon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Earle, Steve', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Barry, Kevin (1969- )', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Beatlebone (Book)', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-25T20:17:33+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Steve Earle', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Earle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/f257de1a-67d3-5975-9d4b-a3e14b73942b', 'word_count': 1242, 'uri': 'nyt://article/f257de1a-67d3-5975-9d4b-a3e14b73942b'}, {'abstract': 'Irving’s latest novel chronicles the rise of a child genius from a trash heap in Mexico to literary stardom.', 'web_url': 'https://www.nytimes.com/2015/11/29/books/review/john-irvings-avenue-of-mysteries.html', 'snippet': 'Irving’s latest novel chronicles the rise of a child genius from a trash heap in Mexico to literary stardom.', 'lead_paragraph': 'As the author of 14 novels, John Irving flaunts his obsessions: fatherless children, clergymen, prostitutes, circuses and, of course, writers. Alongside these fascinations is the one that haunts us all: the personal past that surrounds us “like faces in a crowd.”', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Jones/1129-BKS-Jones-articleLarge.jpg', 'height': 687, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/29/books/review/1129-BKS-Jones/1129-BKS-Jones-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 687}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Jones/1129-BKS-Jones-jumbo.jpg', 'height': 1024, 'width': 895, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Jones/1129-BKS-Jones-superJumbo.jpg', 'height': 2048, 'width': 1790, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/29/books/review/1129-BKS-Jones/1129-BKS-Jones-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/29/books/review/1129-BKS-Jones/1129-BKS-Jones-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'th