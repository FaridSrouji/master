, 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f3f36e32-a4d5-5217-912d-be06d017c427', 'word_count': 238, 'uri': 'nyt://article/f3f36e32-a4d5-5217-912d-be06d017c427'}, {'abstract': 'Peter Thiel and Chris Sacca offered a wide-ranging look at the state of the technology world at the DealBook Conference.', 'web_url': 'https://www.nytimes.com/2015/11/04/business/dealbook/major-investors-on-start-up-issues-and-womens-speech-patterns.html', 'snippet': 'Peter Thiel and Chris Sacca offered a wide-ranging look at the state of the technology world at the DealBook Conference.', 'lead_paragraph': 'Silicon Valley may have become known as a land of exuberance and innovation — or one of irrationality as companies pursue the future. But two prominent investors counseled the tech center’s denizens to think of the future in other ways as well.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Major Investors on Start-Up Issues and Women’s Speech Patterns', 'kicker': 'DealBook 2015 Conference', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Start-ups', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Entrepreneurship', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Silicon Valley (Calif)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Thiel, Peter A', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sacca, Chris (1975- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2015-11-03T22:48:17+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e85809bf-fb3c-5668-8666-1034bc2cdf72', 'word_count': 622, 'uri': 'nyt://article/e85809bf-fb3c-5668-8666-1034bc2cdf72'}, {'abstract': 'The former vice president said he has been focused on helping his firm invest only in sustainable companies.', 'web_url': 'https://www.nytimes.com/2015/11/04/business/dealbook/gore-calls-for-exxon-mobil-inquiry-on-climate-change.html', 'snippet': 'The former vice president said he has been focused on helping his firm invest only in sustainable companies.', 'lead_paragraph': 'Former Vice President Al Gore said on Tuesday that there should be an investigation into Exxon Mobil over what he said was the oil company’s misleading the public about the risks of climate change.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gore Calls for Exxon Mobil Inquiry on Climate Change', 'kicker': 'DealBook 2015 Conference', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Exxon Mobil Corp', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'InsideClimate News', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gore, Al', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Sanders, Bernard', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Tillerson, Rex W', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-11-03T22:48:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Leslie Picker', 'person': [{'firstname': 'Leslie', 'middlename': None, 'lastname': 'Picker', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03fcecc7-6187-5c95-90a9-72a1e84d35eb', 'word_count': 359, 'uri': 'nyt://article/03fcecc7-6187-5c95-90a9-72a1e84d35eb'}, {'abstract': 'This film about a familiar American story, the immigrant who arrives with dreams of the future and pangs over leaving home, explores the question: Where do we come from?', 'web_url': 'https://www.nytimes.com/2015/11/04/movies/review-resettling-the-meaning-of-home-in-brooklyn-with-saoirse-ronan.html', 'snippet': 'This film about a familiar American story, the immigrant who arrives with dreams of the future and pangs over leaving home, explores the question: Where do we come from?', 'lead_paragraph': 'Many American families cherish faded memories of the Old Neighborhood and the Old Country, places that help supply both a sense of identity and a story of progress — complementary answers to the question “Where do we come from?”', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/arts/04BROOK/04BROOK-articleLarge.jpg', 'height': 420, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/04/arts/04BROOK/04BROOK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 420}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/arts/04BROOK/04BROOK-jumbo.jpg', 'height': 717, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/arts/04BROOK/04BROOK-superJumbo.jpg', 'height': 1434, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/ar