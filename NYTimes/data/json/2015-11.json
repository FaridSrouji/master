AME-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 283}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/26/arts/26FAME/26FAME-jumbo.jpg', 'height': 481, 'width': 1018, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/26/arts/26FAME/26FAME-superJumbo.jpg', 'height': 481, 'width': 1018, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/26/arts/26FAME/26FAME-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/26/arts/26FAME/26FAME-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/26/arts/26FAME/26FAME-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Hey, Are You Looking at Me? Good. Now, Buzz Off.', 'kicker': "Critic's Notebook", 'content_kicker': None, 'print_headline': 'Hey, Are You Looking at Me? Good. Now, Buzz Off.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Morris, Wesley', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Celebrities', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Pitt, Brad', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jolie, Angelina', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'LaBeouf, Shia', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Performance Art', 'r