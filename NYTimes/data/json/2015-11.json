rgans-web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/26/world/26Organs-web/26Organs-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/26/world/26Organs-web/26Organs-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Transplant Chief in China Denies Breaking Vow to Ban Prisoners’ Organs', 'kicker': None, 'content_kicker': None, 'print_headline': 'Transplant Chief Denies Breaking Vow on Use of Chinese Prisoners’ Organs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tatlow, Didi Kirsten', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Capital Punishment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organ Donation', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Huang Jiefu', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-25T11:11:59+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Didi Kirsten Tatlow', 'person': [{'firstname': 'Didi', 'middlename': 'Kirsten', 'lastname': 'Tatlow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8f6f525-3a34-543c-9e5f-accb62961162', 'word_count': 882, 'uri': 'nyt://article/e8f6f525-3a34-543c-9e5f-accb62961162'}, {'abstract': 'Calpers Reveals Private Equity Fees and Profits | A Season of Silly Deal-Making | Bureacracy Ends Experimental Credit Union', 'web_url': 'https://news.blogs.nytimes.com/2015/11/25/morning-agenda-treasury-secretary-warns-foes-of-dodd-frank/', 'snippet': 'Calpers Reveals Private Equity Fees and Profits | A Season of Silly Deal-Making | Bureacracy Ends Experimental Credit Union', 'lead_paragraph': 'TREASURY SECRETARY WARNS FOES OF DODD-FRANK | Last year, Congress passed a measure dismantling a piece of the Dodd-Frank Act that governed swaps by attaching the new legislation to a wider spending bill. On Tuesday, Treasury Secretary Jacob J. Lew warned critics of Dodd-Frank against trying the same tactic again, saying he would push back against any attempts to weaken financial regulation through amendments to the spending bill, which Congress must pass by Dec. 11 to avert a government shutdown,  Peter Eavis reports in DealBook. “I have publicly made clear that my recommendation to the president would be that if there are legislative measures that will roll back the clock, that would take us back toward where we were before the financial crisis, I would recommend a veto,” Mr. Lew said via email. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Morning Agenda: Treasury Secretary Warns Foes of Dodd-Frank', 'kicker': 'News', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bitcoin (Currency)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Credit Unions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dodd-Frank Wall Street Reform and Consumer Protection Act (2010)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Hedge Funds', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Initial Public Offerings', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value':