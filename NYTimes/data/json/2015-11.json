150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Volkswagen Says Whistle-Blower Pushed It to Admit Broader Cheating', 'kicker': None, 'content_kicker': None, 'print_headline': ' Under New Management, Volkswagen&#8217;s Investigation Turns Up a Whistle-Blower ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Volkswagen AG', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Whistle-Blowers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Air Pollution', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Automobile Safety Features and Defects', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Diesel Power', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Fuel Efficiency', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Carbon Dioxide', 'rank': 11, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 12, 'major': 'N'}], 'pub_date': '2015-11-08T15:48:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Jack Ewing', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Ewing', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/becb1d43-d641-5dc0-8153-f9a6b2a17d33', 'word_count': 805, 'uri': 'nyt://article/becb1d43-d641-5dc0-8153-f9a6b2a17d33'}, {'abstract': 'From the International Herald Tribune archives: The robbing of a Nazi prisoner is declared legal in 1940.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2015/11/08/1940-robbing-nazi-prisoner-is-legal-under-british-law/', 'snippet': 'From the International Herald Tribune archives: The robbing of a Nazi prisoner is declared legal in 1940.', 'lead_paragraph': 'LONDON — Delving 192 years back into musty English jurisprudence, an attorney quoted today [Nov. 8] a decision of the Kings Bench division in the reign of William III that a British subject is ‘‘entitled to what he can take from the King’s enemies.’’ The attorney obtained freedom for a member of the Home Guard, who had been charged with the theft of a German pistol, six rounds of ammunition and a flying helmet from a Nazi airman who had bailed out over Chatham, Kent. These articles were alleged to be ‘‘the property of his majesty,’’ but Gerald Thesiger, defending Harry Foulds, member of the Home Guard, cited the judgment of a prize court of 1748. That court had held that a subject was entitled to whatever he could take from the King’s enemies and that such property had never been vested in the crown. — New York Herald Tribune, European Edition, November 9, 1940', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/blogs/04iht-oldnov04-prisoner/04iht-oldnov04-prisoner-articleLarge.png', 'height': 228, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/04/blogs/04iht-oldnov04-prisoner/04iht-oldnov04-prisoner-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 228}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/blogs/04iht-oldnov04-prisoner/04iht-oldnov04-prisoner-jumbo.png', 'height': 245, 'width': 645, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/04/blogs/04iht-oldnov04-prisoner/04iht-oldnov04-prisoner-superJumbo.png', 'height': 245, 'width': 645, 'subType': 'supe