Large', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Anti-Muslim Is Anti-American', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Anti-Muslim Is Anti-American', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Blow, Charles M', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Muslim Americans', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Shariah (Islamic Law)', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Carson, Benjamin S', 'rank': 11, 'major': 'N'}], 'pub_date': '2015-11-23T08:20:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Charles M. Blow', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/fcb010e4-1787-584b-81d8-27b7fd830d94', 'word_count': 854, 'uri': 'nyt://article/fcb010e4-1787-584b-81d8-27b7fd830d94'}, {'abstract': 'Making a real dent in the federal prison population will require broader reforms than what Congress is currently considering.', 'web_url': 'https://www.nytimes.com/2015/11/23/opinion/cut-sentences-for-low-level-drug-crimes.html', 'snippet': 'Making a real dent in the federal prison population will require broader reforms than what Congress is currently considering.', 'lead_paragraph': 'Now that Congress is within sight of passing the most significant federal sentencing reforms in a generation, it’s worth taking a closer look at where the legislation falls short.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/23/opinion/23mon1/23mon1-articleLarge.jpg', 'height': 743, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/23/opinion/23mon1/23mon1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 743}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/23/opinion/23mon1/23mon1-jumbo.jpg', 'height': 1024, 'width': 828, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/23/opinion/23mon1/23mon1-superJumbo.jpg', 'height': 1198, 'width': 968, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/23/opinion/23mon1/23mon1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/23/opinion/23mon1/23mon1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/23/opinion/23mon1/23mon1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cut Sentences for Low-Level Drug Crimes', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Cut Sentences for Nonviolent Felons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mandatory Sentencing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Prisons and Prisoners', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Sentences (Criminal)', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-11-23T08:20:11+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/9b6104ec-9937-52b3-94fd-4343fa26dbb7', 'word_count': 592, 'uri': 'nyt://article/9b6104ec-9937-52b3-94fd-4343fa26dbb7'}, {'abstract': 'We can come to accept another person’s moral beliefs as true, even if we don’t adopt them ourselves.', 'web_url': 'https://opinionator.blogs.nytimes.com/2015/11/23/moral-dispute-or-cultural-difference/', 'snippet': 'We can come to accept another person’s moral beliefs as true, even if we don’t adopt them ourselves.', 'lead_paragraph': 'The word “relativism” tends to generate strong reactions. This is odd, given that the word is not generally used with a clear and agreed upon meaning. I want to offer a specific proposal about what it means, with a view to navigating the following “real-world” problem, discussed by Alex Rosenberg here at The Stone in July: What should we do when we face what are often described as irresolvable moral disagreements?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-thestone/opinionat