Large', 'legacy': {}}], 'headline': {'main': 'Negotiators Come to Agreement on Revising No Child Left Behind Law', 'kicker': None, 'content_kicker': None, 'print_headline': 'Negotiators Reach Agreement to Revise No Child Left Behind ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'No Child Left Behind Act', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Tests and Examinations', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Duncan, Arne', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 8, 'major': 'N'}], 'pub_date': '2015-11-19T23:14:42+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/38807631-a23b-5fbb-bb26-9f26e0110902', 'word_count': 1014, 'uri': 'nyt://article/38807631-a23b-5fbb-bb26-9f26e0110902'}, {'abstract': 'Donaldson, a third baseman for the Blue Jays, and Harper, a right fielder for the Nationals, easily won their first Most Valuable Player Awards.', 'web_url': 'https://www.nytimes.com/2015/11/20/sports/major-league-baseball-most-valuable-players.html', 'snippet': 'Donaldson, a third baseman for the Blue Jays, and Harper, a right fielder for the Nationals, easily won their first Most Valuable Player Awards.', 'lead_paragraph': 'The final snapshot of the 2015 baseball season was grim for Josh Donaldson and Bryce Harper. Donaldson ended the American League Championship Series for his Toronto Blue Jays by grounding out on the road with the tying run at third in Game 6 against the Kansas City Royals. Harper, after his last at-bat at Nationals Park, was shoved by the throat against the dugout wall by Jonathan Papelbon, Washington’s closer.', 'print_section': 'B', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/sports/20KEPNER2/20KEPNER2-articleLarge.jpg', 'height': 407, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/20/sports/20KEPNER2/20KEPNER2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 407}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/sports/20KEPNER2/20KEPNER2-jumbo.jpg', 'height': 694, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/sports/20KEPNER2/20KEPNER2-superJumbo.jpg', 'height': 1388, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/sports/20KEPNER2/20KEPNER2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/20/sports/20KEPNER2/20KEPNER2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/sports/20KEPNER2/20KEPNER2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Josh Donaldson and Bryce Harper Win M.V.P. Awards', 'kicker': None, 'content_kicker': None, 'print_headline': 'Harper and Donaldson Earn M.V.P. Awards', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kepner, Tyler', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Donaldson, Josh (1985- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Harper, Bryce (1992- )', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Awards, Decorations and Honors', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington Nationals', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Toronto Blue Jays', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-11-19T23:22:50+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tyler Kepner', 'person': [{'firstname': 'Tyler', 'middlename': None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5b256517-a932-508b-92e1-a01858154a73', 'word_count': 833, 'uri': 'nyt://article/5b256517-a932-508b-92e1-a01858154a73'}, {'abstract': 'Two very young women find each other and fall in love in this film from the Lithuanian writer and director Alante Kavaite.', 'web_url': 'https://www.nytimes.com/2015/11/20/movies/review-the-summer-of-sangaile-evanescent-and-too-good-to-be-true.html', 'snippet': 'Two very young women find each other and fall in love in this film from the Lithuanian writer and director Alante Kavaite.', 'lead_paragraph': 'Dreamy and delicate, trite and oh so earnest, “The Summer of Sangaile” presents a soft-core frolic in teenage Sapphic bliss with the solemnity of a world-shattering event. Crowding the screen with more coming-of-age metaphors than either dialogue or story, the Lithuanian writer and director Alante Kavaite composes a hymn to infatuation and a sonnet to afterglow. When it’s over, you’ll suspect that transcendent sex — preferably at sunset, beneath oodles of gauze — is more critical to realizing your dreams than a high school diploma.', 'print_section': 'C', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20SUMMERSANG/20SUMMERSANG-articleLarge.jpg', 'height': 316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/20/arts/20SUMMERSANG/20SUMMERSANG-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20SUMMERSANG/20SUMMERSANG-jumbo.jpg', 'height': 540, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20SUMMERSANG/20SUMMERSANG-superJumbo.jpg', 'height': 1079, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20SUMMERSANG/20SUMMERSANG-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/20/arts/20SUMMERSANG/20SUMMERSANG-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/20/arts/20SUMMERSANG/20SUMMERSANG-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘The Summer of Sangaile,’ Evanescent and Too Good to Be True', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Love Too Good to Last', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'n