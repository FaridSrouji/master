mages/2015/11/15/magazine/15hodgman/15mag-15hodgman-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15hodgman/15mag-15hodgman-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'John Hodgman on What Makes a Creepy Christmas Card', 'kicker': 'Judge John Hodgman', 'content_kicker': None, 'print_headline': 'Bonus Advice From Judge John Hodgman', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christmas', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hodgman, John', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Comedy and Humor', 'rank': 3, 'major': 'N'}], 'pub_date': '2015-11-11T12:00:04+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By John Hodgman', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Hodgman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8e7ab01b-566a-50d2-ace8-22988d56bcd6', 'word_count': 150, 'uri': 'nyt://article/8e7ab01b-566a-50d2-ace8-22988d56bcd6'}, {'abstract': 'A beet soup from a restaurant that embraces the virtues of real-life cooking: eccentricity, imperfection and the unexpected.', 'web_url': 'https://www.nytimes.com/2015/11/15/magazine/the-taste-of-serendipity.html', 'snippet': 'A beet soup from a restaurant that embraces the virtues of real-life cooking: eccentricity, imperfection and the unexpected.', 'lead_paragraph': '‘‘Genius,’’ E.B. White wrote, ‘‘is more often found in a cracked pot than in a whole one.’’ Judging by how many of my possessions are chipped, broken, worn, bowed and burned, it’s apparent I’ve invested in his odds. It’s not a popular attitude — certainly not in cookbooks, where kitchens often seem embodiments of sunny, enameled perfection — but I hold to it. I was particularly glad recently to open the cookbook ‘‘This Is Camino,’’ by Russell Moore and Allison Hopelain, the owners of the Oakland restaurant Camino, and find in its pages a catechism for my crackpot ways.', 'print_section': 'MM', 'print_page': '32', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15eat2/15mag-15eat-t_CA1-articleLarge.jpg', 'height': 461, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/15/magazine/15eat2/15mag-15eat-t_CA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 461}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15eat2/15mag-15eat-t_CA1-jumbo.jpg', 'height': 787, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15eat2/15mag-15eat-t_CA1-superJumbo.jpg', 'height': 1153, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15eat2/15mag-15eat-t_CA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/15/magazine/15eat2/15mag-15eat-t_CA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15eat2/15mag-15eat-t_CA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Taste of Serendipity', 'kicker': 'Eat', 'content_kicker': None, 'print_headline': 'The Taste of Serendipity', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Adler, Tamar', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Oakland (Calif)', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'This Is Camino (Book)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Camino (Oakland, Calif, Restaurant)', 'rank': 6, 'major': 'N'}], 'pub_date': '2015-11-11T12:00:05+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Tamar Adler', 'person': [{'firstname': 'Tamar', 'middlename': None, 'lastname': 'Adler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0fa93c8d-30cc-5b2b-945a-42c80cd29885', 'word_count': 736, 'uri': 'nyt://article/0fa93c8d-30cc-5b2b-945a-42c80cd29885'}, {'abstract': 'The ‘‘decisive moment,’’ in the work of Henri Cartier-Bresson and his stylistic followers, is a mysteriously precise collaboration with the world.', 'web_url': 'https://www.nytimes.com/2015/11/15/magazine/perfect-and-unrehearsed.html', 'snippet': 'The ‘‘decisive moment,’’ in the work of Henri Cartier-Bresson and his stylistic followers, is a mysteriously precise collaboration with the world.', 'lead_paragraph': '‘‘I couldn’t believe such a thing could be caught with the camera. I said, ‘Damn it,’ took my camera and went out into the street.’’ This was Henri Cartier-Bresson’s dazzled and vexed reaction to Martin Munkacsi’s photograph of boys running into the surf in Liberia. He saw it in 1932: the dark, sinuous bodies of three African boys — their rhyming legs at the place where sea meets land; their interweaving arms dialed to varying heights; their interlocking limbs creating abstract shapes; and the grace note, on the left side, of a single silhouetted arm. This image, Cartier-Bresson said, inspired his own approach, showing him that ‘‘photography could reach eternity through the moment.’’', 'print_section': 'MM', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15onphoto1/15mag-15onphoto-t_CA3-articleLarge.jpg', 'height': 765, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2015/11/15/magazine/15onphoto1/15mag-15onphoto-t_CA3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 765}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15onphoto1/15mag-15onphoto-t_CA3-jumbo.jpg', 'height': 1024, 'width': 804, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15onphoto1/15mag-15onphoto-t_CA3-superJumbo.jpg', 'height': 1872, 'width': 1468, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15onphoto1/15mag-15onphoto-t_CA3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/15/magazine/15onphoto1/15mag-15onphoto-t_CA3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/15/magazine/15onphoto1/15mag-15onphoto-t_CA3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Perfect and Unrehearsed', 'k