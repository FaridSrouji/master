': 'images/2015/11/09/opinion/RFDVW/RFDVW-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/RFDVW/RFDVW-jumbo.jpg', 'height': 668, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/RFDVW/RFDVW-superJumbo.jpg', 'height': 1336, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/RFDVW/RFDVW-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/09/opinion/RFDVW/RFDVW-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/09/opinion/RFDVW/RFDVW-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can Companies Be Trusted?', 'kicker': 'Room for Debate', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2015-11-10T08:30:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/245faa36-3542-558d-8ae5-6b0a4f7b68b6', 'word_count': 0, 'uri': 'nyt://article/245faa36-3542-558d-8ae5-6b0a4f7b68b6'}, {'abstract': 'Studies in Sierra Leone confirm that debates by candidates for parliament not only introduce the candidates to voters; they make voting more issue-oriented.', 'web_url': 'https://opinionator.blogs.nytimes.com/2015/11/10/enriching-voting-in-africa-by-having-candidates-debate/', 'snippet': 'Studies in Sierra Leone confirm that debates by candidates for parliament not only introduce the candidates to voters; they make voting more issue-oriented.', 'lead_paragraph': 'Political debates are good even when they’re bad. Even when candidates are cringe-worthy, they’re cringe-worthy in public view. And voters learn about all the candidates, not just new ones. In the United States, for example, Hillary Clinton has been center stage in political life for 24 years. Donald Trump is the very definition of “overexposed.” Still, the debates tell us new things about them — their positions, temperament, grace under pressure (or lack thereof), charisma and political skill.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-fixes/opinionator-pog-fixes-articleLarge.png', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/04/25/opinion/opinionator-pog-fixes/opinionator-pog-fixes-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-fixes/opinionator-pog-fixes-jumbo.png', 'height': 1000, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-fixes/opinionator-pog-fixes-superJumbo.png', 'height': 1000, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-fixes/opinionator-pog-fixes-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-fixes/opinionator-pog-fixes-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-fixes/opinionator-pog-fixes-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Smart African Politics: Candidates Debating Under a Tree', 'kicker': 'Fixes', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Debates (Political)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Legislatures and Parliaments', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Common Ground', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Stanford University', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Sierra Leone', 'rank': 7, 'major': 'N'}], 'pub_date': '2015-11-10T08:30:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Tina Rosenberg', 'person': [{'firstname': 'Tina', 'middlename': None, 'lastname': 'Rosenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/12235310-f868-5c23-9b3c-1c70ccbb0982', 'word_count': 1871, 'uri': 'nyt://article/12235310-f868-5c23-9b3c-1c70ccbb0982'}, {'abstract': 'It took two months, three therapies and a tiny amount of clonazepam.', 'web_url': 'https://opinionator.blogs.nytimes.com/2015/11/10/defeating-my-anxiety/', 'snippet': 'It took two months, three therapies and a tiny amount of clonazepam.', 'lead_paragraph': 'When the stock market crashed in 2008, my wife and I were 70. And we saw half of our retirement funds disappear. Before the crash, we felt secure in the belief that we had enough money to last as long as we lived; after the crash, we feared that we would not, and I worried about it a great deal. I had a hard time going to sleep and an even harder time going back to sleep after getting up to go to the bathroom in the middle of the night. I came to hate going into that bathroom because I knew my demons resided there and would invade my consciousness immediately.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/04/opinion/opinionator-pog-couch/opinionator-pog-couch-articleLarge.png', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/11/04/opinion/opinionator-pog-couch/opinionator-pog-couch-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/04/opinion/opinionator-pog-couch/opinionator-pog-couch-jumbo.png', 'height': 1000, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/04/opinion/opinionator-pog-couch/opinionator-pog-couch-superJumbo.png', 'height': 1000, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/04/opinion/opinionator-pog-couch/opinionator-pog-couch-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/04/opinion/opinionator-pog-couch/opinionator-pog-couch-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, '