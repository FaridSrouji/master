ne, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-24T17:17:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/941a2eee-0d31-5347-bda9-c82a2ce6f062', 'word_count': 270, 'uri': 'nyt://article/941a2eee-0d31-5347-bda9-c82a2ce6f062'}, {'abstract': 'Cornerback Darrelle Revis tore the anterior cruciate ligament in his left knee in Sunday’s game against the Dolphins and is likely to be out for the season.', 'web_url': 'https://www.nytimes.com/2012/09/25/sports/jets-lose-darrelle-revis-to-torn-acl-in-left-knee.html', 'snippet': 'Cornerback Darrelle Revis tore the anterior cruciate ligament in his left knee in Sunday’s game against the Dolphins and is likely to be out for the season.', 'lead_paragraph': 'FLORHAM PARK, N.J. — After uttering the words he hoped he would not have to say, Rex Ryan looked down at the lectern and away from the cameras. A second went by. Then two. Then three, as if by taking time to collect his thoughts Ryan would somehow reverse the harsh sentence rendered Monday, when tests confirmed that the All-Pro cornerback Darrelle Revis had torn the anterior cruciate ligament in his left knee and would require surgery, ending his season after three games. ', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/25/sports/football/25jets-pic/25jets-pic-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/25/sports/football/25jets-pic/25jets-pic-articleLarge-v2.jpg', 'xlarg