s', 'multimedia': [], 'headline': {'main': 'Undies to Match the Season', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lingerie and Underwear', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Blakely, Sara', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Lincoln Center for the Performing Arts', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-10T15:23:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Eric Wilson', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/60ee93a4-fc98-59fe-b43f-c258083fc25c', 'word_count': 296, 'uri': 'nyt://article/60ee93a4-fc98-59fe-b43f-c258083fc25c'}, {'abstract': 'The craftsmen of Gujarat struggle to keep their art alive.', 'web_url': 'https://india.blogs.nytimes.com/2012/09/10/in-northwest-corner-of-india-the-work-of-centuries/', 'snippet': 'The craftsmen of Gujarat struggle to keep their art alive.', 'lead_paragraph': '“In scattered hamlets, weavers, embroiderers, textile painters, tie-dyers, bead workers, potters, carvers, cobblers and bell-makers work as they have for centuries, often taking weeks, even months to finish a single flawless piece,” Claire Spiegel wrote in The International Herald Tribune of the craftsmen of Kutch, in the northwestern state of Gujarat.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Northwest Corner of India, the Work of Centuries', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-10T15:25:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline