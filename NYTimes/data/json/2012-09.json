d_count': 1123, 'uri': 'nyt://article/3ea99696-049b-5199-bd10-07fbc584681f'}, {'abstract': 'A Yale professor’s economic data model is seeing a too-close-to-call presidential election.', 'web_url': 'https://www.nytimes.com/2012/09/09/your-money/weak-economy-is-a-relative-term-this-election-year.html', 'snippet': 'A Yale professor’s economic data model is seeing a too-close-to-call presidential election.', 'lead_paragraph': 'THE unemployment rate is 8.1 percent, hiring has slowed to a trickle and the economy is weak. For a president seeking re-election, those are high hurdles. ', 'print_section': 'BU', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/business/9-STRA/9-STRA-jumbo.jpg', 'height': 622, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/business/9-STRA/9-STRA-superJumbo.jpg', 'height': 1245, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'This Year, a Weak Economy Is a Relative Term', 'kicker': 'Strategies', 'content_kicker': None, 'print_headline': 'This Year, a Weak Economy Is a Relative Term', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fair, Ray C', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-08T18:37:56+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Your Money', 'byline': {'original': 'By Jeff Sommer', 'person': [{'firstname': 'Jeff', 'middlename': None, 'l