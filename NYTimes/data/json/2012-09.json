astname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/516972c6-c7d2-5802-a61e-f2b02fbb337a', 'word_count': 258, 'uri': 'nyt://article/516972c6-c7d2-5802-a61e-f2b02fbb337a'}, {'abstract': 'The TransCultural Express program will feature a variety of American and Russian culture.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/28/brooklyn-academy-of-music-and-nets-owners-charity-join-in-three-year-partnership/', 'snippet': 'The TransCultural Express program will feature a variety of American and Russian culture.', 'lead_paragraph': ' Creating a cultural exchange between the United States and Russia, the Brooklyn Academy of Music and the Mikhail Prokhorov Fund have announced a three-year partnership.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Brooklyn Academy of Music and Nets’ Owner’s Charity Join in Three-Year Partnership', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'BAM and Nets’ Owner In Joint Project', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Culture (Arts)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Prokhorov, Mikhail D', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Prokhorova, Irina', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Academy of Music', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Novosibirsk (Russia)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-28T15:21:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Robin Pogrebin', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Pogrebin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/17644edb-a531-5a12-947e-db4ee5f059b3', 'word_count': 179, 'uri': 'nyt://article/17644edb-a531-5a12-947e-db4ee5f059b3'}, {'abstract': '“Impact investing,” which treats philanthropy as an investment, has brought an interest in determining whether the money is having the effect the philanthropists intended.', 'web_url': 'https://www.nytimes.com/2012/09/29/your-money/measuring-the-impact-of-impact-investing-wealth-matters.html', 'snippet': '“Impact investing,” which treats philanthropy as an investment, has brought an interest in determining whether the money is having the effect the philanthropists intended.', 'lead_paragraph': 'ALL philanthropists want their donations to mean something, be it for a new wing for a hospital or to finance a program aimed at doing social good. Increasingly, though, philanthropists are looking for a way to measure the impact of their dollars. ', 'print_section': 'B', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/29/your-money/29wealth/29wealth-articleLarge-v2.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/29/your-money/29wealth/29wealth-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/29/your-money/29wealth/29wealth-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/29/your-money/29wealth/29wealth-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtyp