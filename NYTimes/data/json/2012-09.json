/12clinton1/12clinton1-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/12/us/12clinton1/12clinton1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/us/12clinton1/12clinton1-jumbo.jpg', 'height': 678, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/us/12clinton1/12clinton1-superJumbo.jpg', 'height': 1356, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/us/12clinton1/12clinton1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/12/us/12clinton1/12clinton1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/us/12clinton1/12clinton1-thumbLarge.jpg', 'height': 151, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Embracing Role as Surrogate, Clinton Hits Campaign Trail', 'kicker': None, 'content_kicker': None, 'print_headline': 'Embracing Role as Surrogate, Clinton Hits Campaign Trail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clinton, Bill', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Miami (Fla)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Florida', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-12T02:50:52+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Mark Landler', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Landler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/47c8797b-23b2-502a-bcb7-c7472c5dc8d6', 'word_count': 917, 'uri': 'nyt://article/47c8797b-23b2-502a-bcb7-c7472c5dc8d6'}, {'abstract': 'President Hamid Karzai’s pick to lead the Afghan spy agency, Asadullah Khalid, has been accused of torture and drug trafficking, but is also seen as a man with political skills and wide connections.', 'web_url': 'https://www.nytimes.com/2012/09/12/world/asia/officials-split-over-nominee-for-afghan-spy-chief.html', 'snippet': 'President Hamid Karzai’s pick to lead the Afghan spy agency, Asadullah Khalid, has been accused of torture and drug trafficking, but is also seen as a man with political skills and wide connections.', 'lead_paragraph': 'KABUL, Afghanistan — President Hamid Karzai’s determination to make a close aide, Asadullah Khalid, his next intelligence chief has divided Western officials here, some of whom say they are troubled by allegations of torture and drug trafficking against Mr. Khalid and worry that in such a powerful role he would be a step back for the country.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/world/SPY/SPY-jumbo.jpg', 'height': 955, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/world/SPY/SPY-superJumbo.jpg', 'height': 1911, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Western and Afghan Officials Split Over Karzai Nomination for Spy Chief', 'kicker': None, 'content_kicker': None, 'print_headline': 'Western and Afghan Officials Split Over Karzai Nomination for Spy Chief', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Espionage and Intelligence Services', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Khalid, Asadullah', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'North Atlantic Treaty Organization', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Karzai, Hamid', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-12T03:03:08+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Richard A. Oppel Jr', 'person': [{'firstname': 'Richard', 'middlename': 'A.', 'lastname': 'Oppel', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04a4b894-a3a6-5ec2-bf06-704121a8d4a9', 'word_count': 1287, 'uri': 'nyt://article/04a4b894-a3a6-5ec2-bf06-704121a8d4a9'}, {'abstract': 'By building warehouses across the country, the retailer hopes to cut as much as a day off its two-day shipping times.', 'web_url': 'https://www.nytimes.com/2012/09/12/technology/amazon-forced-to-collect-sales-tax-aims-to-keep-its-competitive-edge.html', 'snippet': 'By building warehouses across the country, the retailer hopes to cut as much as a day off its two-day shipping times.', 'lead_paragraph': 'PATTERSON, Calif. — At the moment, it is little more than dirt and gravel. But a sunbaked field at the edge of this farming town will play a significant role in one of the most ambitious retailing ventures of the era: the relentless quest by the onl