: 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09eat1/09eat1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Short and Sweet', 'kicker': 'Eat', 'content_kicker': None, 'print_headline': 'Short and Sweet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Butter', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cookies', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-06T11:00:08+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Mark Bittman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Bittman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7037ab95-03ce-5ee3-b268-ee96b04dee52', 'word_count': 520, 'uri': 'nyt://article/7037ab95-03ce-5ee3-b268-ee96b04dee52'}, {'abstract': 'One woman’s crusade to rid our lives of flame-retardant chemicals.', 'web_url': 'https://www.nytimes.com/2012/09/09/magazine/arlene-blums-crusade-against-household-toxins.html', 'snippet': 'One woman’s crusade to rid our lives of flame-retardant chemicals.', 'lead_paragraph': 'In September 1976, a mail runner from Katmandu arrived at Base Camp on Mount Everest with a package for Dr. Arlene Blum, a member of the American Bicentennial Everest Expedition. The package had nothing to do with the climb, or Blum’s status as the first American woman to attempt the world’s highest peak. It concerned pajamas. Inside were the proofs of an article she co-wrote for the journal Science about a chemical then widely used in children’s sleepwear. The subtitle was unusually blunt for a scientific paper: “The main flame retardant in children’s pajamas is a mutagen and should not be used.”', 'print_section': 'MM', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09blum1/09blum1-articleLarge.jpg', 'height': 377, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/09/magazine/09blum1/09blum1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 377}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09blum1/mag-09Blum-t_CA1-jumbo.jpg', 'height': 1024, 'width': 863, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09blum1/mag-09Blum-t_CA1-superJumbo.jpg', 'height': 1500, 'width': 1264, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09blum1/09blum1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/magazine/09blum1/09blum1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09blum1/09blum1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Dangerous Is Your Couch?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Is This The Most Dangerous Thing In Your House?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'California Bureau of Home Furnishings and Thermal Insulation', 'rank': 1, 'major': 'N