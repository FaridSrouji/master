': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/sports/YSOCCER/YSOCCER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/02/sports/YSOCCER/YSOCCER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/sports/YSOCCER/YSOCCER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Altidore Hears Coach’s Message to U.S. National Team: Get Tough', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': 'Altidore Hears Coach&#8217;s Message to U.S. National Team: Get Tough', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Altidore, Jozy', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': "United States Men's National Soccer Team", 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Klinsmann, Jurgen', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-01T16:27:10+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/03255621-510d-5391-b7c4-17194ca1358f', 'word_count': 966, 'uri': 'nyt://article/03255621-510d-5391-b7c4-17194ca1358f'}, {'abstract': 'The 2012 Summer Paralympic Games continue in London after an opening ceremony that was truly cosmic.', 'web_url': 'https://www.nytimes.com/2012/09/02/opinion/sunday/it-began-with-a-bang.html', 'snippet': 'The 2012 Summer Paralympic Games continue in London after an opening ceremony that was truly cosmic.', 'lead_paragraph': 'If you haven’t started following the 2012 Summer Paralympic Games, which began Wednesday in London, you’ve missed some good stuff, including an opening ceremony that was truly cosmic. It featured the physicist Stephen Hawking as master of ceremonies and Sir Ian McKellen as Prospero, wearing a gown of stars and telling Miranda, who was floating above the stadium in a wheelchair, to “shine your light on the beautiful diversity of humanity,” which wasn’t Shakespeare but sounded enough like it. The ceremony, whose theme was “Enlightenment,” re-enacted the Big Bang and featured an appearance by the Large Hadron Collider, the Higgs boson, giant falling apples and a choir singing a new piece, “Principia.”', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/sunday-review/0902weekahead/0902weekahead-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/sunday-review/0902weekahead/0902weekahead-superJumbo.jpg', 'height': 1536, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/sunday-review/0902weekahead/0902weekahead-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/02/sunday-review/0902weekahead/0902weekahead-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/02/sunday-review/0902weekahead/0902weekahead-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge',