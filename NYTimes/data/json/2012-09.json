a-8413-7fae79d11f4c', 'word_count': 914, 'uri': 'nyt://article/f921e693-130f-5d7a-8413-7fae79d11f4c'}, {'abstract': 'The Republicans aren’t the only party struggling to deal with racial politics.', 'web_url': 'https://douthat.blogs.nytimes.com/2012/09/04/the-democrats-identity-politics-problem/', 'snippet': 'The Republicans aren’t the only party struggling to deal with racial politics.', 'lead_paragraph': 'On the eve of the Democratic convention here in Charlotte, Time Magazine’s Joe Klein calls on the party to move away from identity politics:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Democrats’ Identity Politics Problem', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-04T18:15:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b525e3bc-4baa-587f-9e71-274e62e1cc24', 'word_count': 625, 'uri': 'nyt://article/b525e3bc-4baa-587f-9e71-274e62e1cc24'}, {'abstract': 'Target Margin Theater plans a two-year project focusing on Yiddish theater.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/04/target-margin-to-explore-yiddish-theater/', 'snippet': 'Target Margin Theater plans a two-year project focusing on Yiddish theater.', 'lead_paragraph': 'Target Margin Theater, the alternative New York theater company known for its frisky interpretations of plays ranging from Shakespeare to Brecht, is turning its attention to Yiddish theater.\xa0The company has announced a two-season exploration of Yiddish theater called Beyond the Pale,\xa0 which begins with a festival of plays, readings, a scholarly panel and a concert of Yiddish music, to be held Oct. 17 through Nov. 3 at The Brick in Williamsburg, Brooklyn. The festival, all in English, will present four fully staged plays including “God, Man, and Devil,” the circa 1900 play by Jacob Gordin, an influential Yiddish dramatist. In March, Target Margin will present a reworked drama from the Yiddish canon at the Abrons Art Center at the Henry Street Settlement on the Lower East Side of Manhattan. Other productions, workshops and concerts are also planned.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Target Margin to Explore Yiddish Theater', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Target Margin to Explore Yiddish Plays and Music', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Yiddish Language', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Herskovits, David', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Henry Street Settlement', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Target Margin Theater', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Lower East Side (NYC)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-04T18:15:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Felicia R. Lee', 'person': [{'firstname': 'Felicia', 'middlename': 'R.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4f28446-1ab0-5973-be34-7a4dcc5730ae', 'word_count': 208, 'uri': 'nyt://article/d4f28446-1ab0-5973-be34-7a4dcc5730ae'}, {'abstract': 'Whatever the conclusions, whatever the effectiveness, of challenging facts, the idea that we have to debate the necessity of the media doing so strikes me as absurd.', 'web_url': 'https://publiceditor.blogs.nytimes.com/2012/09/04/facts-truth-and-may-the-best-man-win/', 'snippet': 'Whatever the conclusions, whatever the effectiveness, of challenging facts, the idea that we have to debate the necessity of the media doing so strikes me as absurd.', 'lead_paragraph': 'In “Gore Vidal’s The Best Man,” now in an enjoyable and timely revival on Broadway (extended but scheduled to end this week), the lead character – a candidate for president in 1960 – poses a rhetorical question:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Facts, Truth … and May the Best Man Win', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-04T18:15:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6f78eda5-3aad-569f-8b39-e2a86fd46d03', 'word_count': 636, 'uri': 'nyt://article/6f78eda5-3aad-569f-8b39-e2a86fd46d03'}, {'abstract': 'Scooter Braun, whose stable includes Carly Rae Jepsen, announced via YouTube that he would be representing the rapper from Seoul, whose comic video “Gangnam Style” has been an online sensation.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/09/04/digital-notes-justin-biebers-manager-signs-korean-web-star-psy/', 'snippet': 'Scooter Braun, whose stable includes Carly Rae Jepsen, announced via YouTube that he would be representing the rapper from Seoul, whose comic video “Gangnam Style” has been an online sensation.', 'lead_paragraph': 'Can Scooter Braun turn another online phenomenon into a bona fide star?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Digital Notes: Justin Bieber’s Manager Signs Korean Web Star Psy', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cellular Telephones', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings and Downloads', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Interscope', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Nokia Oyj', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'YouTube.com', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-09-04T18:17:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3842cdef-2ae3-51f7-a735-cc5e99bed54e', 'word_count': 373, 'uri': 'nyt://article/3842cdef-2ae3-51f7-a735-cc5e99bed54e'}, {'abstract': 'Tailors pose an odd riddle for our economy: Why can’t a wealthy city support a niche business like bespoke suits?', 'web_url': 'https://www.nytimes.com/2012/09/09/magazine/whats-a-4000-suit-worth.html', 'snippet': 'Tailors pose an odd riddle for our economy: Why can’t a wealthy city support a niche business like bespoke suits?', 'lead_paragraph': 'A few years ago, Peter Frew came to New York with an important professional skill. He was one of maybe a few dozen people in the U.S. who could construct a true bespoke suit. Frew, who apprenticed with a Savile Row tailor, can — all by himself, and almost all by hand — create a pattern, cut fabric and expertly construct a suit that, for about $4,000, perfectly molds to its owner’s body. In a city filled with very rich people, he quickly had all the orders he could handle.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09economy1/09economy1-articleLarge.jpg', 'height': 793, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/09/magazine/09economy1/09economy1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 793}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09economy1/09economy1-jumbo.jpg', 'height': 1001, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09economy1/09economy1-superJumbo.jpg', 'height': 1467, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09economy1/09economy1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/magazine/09economy1/09economy1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09economy1/09economy1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What’s a $4,000 Suit Worth?', 'kicker': 'It’s the Economy', 'content_kicker': None, 'print_headline': 'What’s a $4,000 Suit worth?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Capitalism (Theory and Philosophy)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Factories and Manufacturing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Textiles', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-04T18:21:03+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Adam Davidson', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Davidson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d890878b-0a95-53cb-8313-a3da13e12696', 'word_count': 1310, 'uri': 'nyt://article/d890878b-0a95-53cb-8313-a3da13e12696'}, {'abstract': 'If the wine salt in this week’s pork loin recipe turned into an oozing mess in your oven, here’s why.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/09/04/troubleshooting-the-wine-salt/', 'snippet': 'If the wine salt in this week’s pork loin recipe turned into an oozing mess in your oven, here’s why.', 'lead_paragraph': 'A few readers wrote in that their wine salt (used as a rub for pork loin in this week’s column) turned to an oozing mess in the oven, or it caramelized, browned and hardened. The reason for this is that many home ovens are not properly calibrated, and chances are if this happened to you, your oven might run a bit hot. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Troubleshooting the Wine Salt', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-04T18:23:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Melissa Clark', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Clark', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cb9455e6-d9ae-5238-a157-39163e9d17eb', 'word_count': 313, 'uri': 'nyt://article/cb9455e6-d9ae-5238-a157-39163e9d17eb'}, {'abstract': 'The case highlights the challenge Europe faces to create a competitive market for natural gas when Russia supplies about a quarter of what Europe needs.', 'web_url': 'https://www.nytimes.com/2012/09/05/business/global/eu-opens-inquiry-into-gazprom-trade-practices.html', 'snippet': 'The case highlights the challenge Europe faces to create a competitive market for natural gas when Russia supplies about a quarter of what Europe needs.', 'lead_paragraph': 'BRUSSELS — European Union antitrust authorities opened a formal investigation Tuesday into whether the Russian export monopoly Gazprom had blocked fair competition in the natural gas markets of Central and Eastern Europe.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Europe Opens Inquiry Into Gazprom Trade Practices', 'kicker': None, 'content_kicker': None, 'print_headline': 'E.U. Opens Inquiry Into Gazprom Trade Practices', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Gazprom', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'European Commission', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-04T18:29:34+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By James Kanter', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Kanter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/466db44f-7e7e-5ce0-ac55-2b3c7cfbe8d7', 'word_count': 452, 'uri': 'nyt://article/466db44f-7e7e-5ce0-ac55-2b3c7cfbe8d7'}, {'abstract': 'Over the last five years, the losers in singles matches at Arthur Ashe Stadium have won an average of only 35.3 percent of the games.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/09/04/ashe-stadium-hosts-the-stars-and-also-the-routs/', 'snippet': 'Over the last five years, the losers in singles matches at Arthur Ashe Stadium have won an average of only 35.3 percent of the games.', 'lead_paragraph': 'Serena Williams achieved an elusive “double bagel” in her fourth-round match Monday afternoon on Arthur Ashe Stadium, beating Andrea Hlavackova, 6-0, 6-0, in 57 minutes. Impressive as that is, she accounted for only half of the Ashe bagel haul in the day session — Ana Ivanovic and Marin Cilic each won a 6-0 set as well in the day’s other two matches.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ashe Stadium Hosts the Stars, and Also the Routs', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Hlavackova, Andrea', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Serena', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Ashe, Arthur, Stadium', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-04T18:30:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Ben Rothenberg', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Rothenberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31969390-33e2-5cc4-9031-36fb2fd5e83d', 'word_count': 591, 'uri': 'nyt://article/31969390-33e2-5cc4-9031-36fb2fd5e83d'}, {'abstract': 'Simon Baz, an Arab-American from Michigan, finds himself wearing a Green Lantern power ring.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/04/dc-introducing-an-arab-american-character/', 'snippet': 'Simon Baz, an Arab-American from Michigan, finds himself wearing a Green Lantern power ring.', 'lead_paragraph': 'When the DC universe of superheroes was reintroduced last year  one of the commitments from the company was diversity. Cyborg, a black hero, was promoted to the Justice League; Bunker, a new Teen Titan, is Mexican and gay; and female or minority-group characters were the headliners in many series.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'DC Introducing an Arab-American Character', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'DC Introduces Arab-American Hero', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARAB-AMERICANS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Comic Books and Strips', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Johns, Geoff', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'ARAB AMERICAN NATIONAL MUSEUM', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'DC Comics', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Michigan', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-04T18:30:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By George Gene Gustines', 'person': [{'firstname': 'George', 'middlename': 'Gene', 'lastname': 'Gustines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8cad4672-a983-5f45-844e-edd422a03868', 'word_count': 258, 'uri': 'nyt://article/8cad4672-a983-5f45-844e-edd422a03868'}, {'abstract': 'The new releases are among several projects in the works to mark the band’s 50th anniversary.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/04/rollings-stones-greatest-hits-album-to-offer-2-new-songs/', 'snippet': 'The new releases are among several projects in the works to mark the band’s 50th anniversary.', 'lead_paragraph': 'The Rolling Stones will release two new original songs when they put out a greatest hits record in November, Mojo magazine reported on Tuesday.\xa0 The two songs – entitled “Gloom and Doom” and “One Last Shot” – were recorded in Paris last month and will appear on a three-CD set of the band’s hits, “GRRR!,” which is set to be released on Nov. 13.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rolling Stones’ Greatest Hits Album to Offer 2 New Songs', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Two New Songs From the Rolling Stones', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Rolling Stones', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-04T18:30:30+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By James C. McKinley Jr', 'person': [{'firstname': 'James', 'middlename': 'C.', 'lastname': 'McKinley', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/63822e69-3d8c-5e89-a0e5-fabdf04b7c9c', 'word_count': 174, 'uri': 'nyt://article/63822e69-3d8c-5e89-a0e5-fabdf04b7c9c'}, {'abstract': 'Michelle Obama’s convention speech will mark a new point in her transformation from a Chicago hospital executive who openly called politics a waste of time to a hugely popular first lady.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/09/04/for-michelle-obama-convention-speech-is-a-new-point-in-transformation/', 'snippet': 'Michelle Obama’s convention speech will mark a new point in her transformation from a Chicago hospital executive who openly called politics a waste of time to a hugely popular first lady.', 'lead_paragraph': 'CHARLOTTE, N.C. — In her speech here on Tuesday night, the first lady, Michelle Obama, will have a chance to define her husband on her own terms. But the speech will also mark a new point in her remarkable transformation from a Chicago hospital executive who openly called politics a waste of time to a hugely popular first lady and polished political communicator considered essential to her husband’s re-election efforts.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'For Michelle Obama, Convention Speech Is a New Point in Transformation', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'First Ladies (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Michelle', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-04T18:31:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jodi Kantor', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Kantor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96ac875e-cf20-553d-aff9-7a5e53617108', 'word_count': 522, 'ur