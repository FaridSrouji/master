ame': 'glocations', 'value': 'Somalia', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Kenya', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Shabab', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Nairobi (Kenya)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-30T18:33:31+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': 'By Jeffrey Gettleman', 'person': [{'firstname': 'Jeffrey', 'middlename': None, 'lastname': 'Gettleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3baa20b4-b1fa-54bc-af42-4ead7e631b00', 'word_count': 374, 'uri': 'nyt://article/3baa20b4-b1fa-54bc-af42-4ead7e631b00'}, {'abstract': 'The cultural arm of a real estate company, Brookfield Office Properties, spends more than $3 million a year at its North American office buildings, staging free performances and exhibitions.', 'web_url': 'https://www.nytimes.com/2012/10/01/arts/brookfield-office-properties-free-arts-programs.html', 'snippet': 'The cultural arm of a real estate company, Brookfield Office Properties, spends more than $3 million a year at its North American office buildings, staging free performances and exhibitions.', 'lead_paragraph': 'One recent Monday morning the pianist Taka Kigawa took his place at a keyboard in the lobby of 1 Liberty Plaza, an office building near Wall Street, and worked through Debussy’s Preludes, Book II. A small audience — perhaps a dozen people at first, more than 100 an hour later — sat at tables or stood on the periphery, sipping coffee, listening to Mr. Kigawa and watching the parade of businessmen and tourists drift past the large window to the pianist’s left. ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimed