stname': 'Singh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Channon', 'middlename': None, 'lastname': 'Hodge', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/af0ac9cd-3c3a-5065-8098-85c5e873f45b', 'word_count': 0, 'uri': 'nyt://video/af0ac9cd-3c3a-5065-8098-85c5e873f45b'}, {'abstract': 'Scenes from the Milan fashion week photo diary of Samantha Casolari.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/09/21/photos-of-the-moment-etro-3/', 'snippet': 'Scenes from the Milan fashion week photo diary of Samantha Casolari.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Photos of The Moment | Etro', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-21T17:30:55+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Samantha Casolari', 'person': [{'firstname': 'Samantha', 'middlename': None, 'lastname': 'Casolari', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/272feb61-20ee-594e-a76d-bd519443bb3f', 'word_count': 36, 'uri': 'nyt://article/272feb61-20ee-594e-a76d-bd519443bb3f'}, {'abstract': 'Food-related events around New York.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/09/21/weekend-fare-110/', 'snippet': 'Food-related events around New York.', 'lead_paragraph': 'Countless Oktoberfest celebrations are taking place at restaurants, bars and beer gardens around the city. One to notice is OktoberfestNYC, which runs Saturday through Oct. 7 in a pop-up German beer hall at 1 Penn Plaza, at 33rd Street and Eighth Avenue. A 6,000-square-foot tented beer garden will house long tables where German beers and food will be served. The pop-up is open 5 p.m. to midnight Monday through Friday and 11 a.m. to midnight on weekends. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Weekend Fare', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-21T17:33:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Bao Ong', 'person': [{'firstname': 'Bao', 'middlename': None, 'lastname': 'Ong', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6f0b711b-1a77-5ed1-8d83-430699777d04', 'word_count': 961, 'uri': 'nyt://article/6f0b711b-1a77-5ed1-8d83-430699777d04'}, {'abstract': 'The Mujahedeen Khalq, an opposition group that mounted an extraordinary campaign to get off the State Department’s list of terrorist organizations, has succeeded, officials said.', 'web_url': 'https://www.nytimes.com/2012/09/22/world/middleeast/iranian-opposition-group-mek-wins-removal-from-us-terrorist-list.html', 'snippet': 'The Mujahedeen Khalq, an opposition group that mounted an extraordinary campaign to get off the State Department’s list of terrorist organizations, has succeeded, officials said.', 'lead_paragraph': 'WASHINGTON — Rarely in the annals of lobbying in the capital has so obscure a cause attracted so stellar a group of supporters: former directors of the C.I.A. and the F.B.I., retired generals and famous politicians of both parties.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/world/jp-mek/jp-mek-jumbo.jpg', 'height': 817, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/world/jp-mek/jp-mek-superJumbo.jpg', 'height': 1633, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Iranian Dissidents Convince U.S. to Drop Terror Label', 'kicker': None, 'content_kicker': None, 'print_headline': 'Star Lobbyists Help Iran Group Escape Shadow', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Mujahedeen Khalq', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iran', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'State Department', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-21T17:40:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Scott Shane', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Shane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d24287f3-df03-5076-a40f-e9c10e67ede9', 'word_count': 1202, 'uri': 'nyt://article/d24287f3-df03-5076-a40f-e9c10e67ede9'}, {'abstract': 'The Nets held a ceremonial opening at their new arena in Brooklyn, where their owner, Mikhail D. Prokhorov, predicted a championship within three years.', 'web_url': 'https://www.nytimes.com/2012/09/22/sports/basketball/nets-cut-the-ribbon-on-the-barclays-center.html', 'snippet': 'The Nets held a ceremonial opening at their new arena in Brooklyn, where their owner, Mikhail D. Prokhorov, predicted a championship within three years.', 'lead_paragraph': 'On a stage packed with dignitaries, one man stood tallest, so tall that the microphone had to be raised by a foot to meet his chin. When he spoke, the message was no less striking.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/sports/22nets1/22nets1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/22/sports/22nets1/22nets1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/sports/22nets1/22nets1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/sports/22nets1/22nets1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/sports/22nets1/22nets1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/22/sports/22nets1/22nets1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/sports/22nets1/22nets1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At Unveiling of Barclays Center, Talk of a Nets Championship', 'kicker': None, 'content_kicker': None, 'print_headline': 'At Unveiling of Barclays Center, Owner Talks of a Nets Championship', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn Nets', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Barclays Center (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jay-Z', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Prokhorov, Mikhail D', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-21T17:41:55+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Howard Beck', 'person': [{'firstname': 'Howard', 'middlename': None, 'lastname': 'Beck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/98293000-086b-56dc-8ab2-da4583c8a029', 'word_count': 828, 'uri': 'nyt://article/98293000-086b-56dc-8ab2-da4583c8a029'}, {'abstract': 'Tyjuan Hill was shot and killed by the police during a scuffle on Thursday that stemmed from a prostitute-solicitation sting operation, the police said.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/09/21/man-fatally-shot-by-police-had-pointed-gun-at-officer/', 'snippet': 'Tyjuan Hill was shot and killed by the police during a scuffle on Thursday that stemmed from a prostitute-solicitation sting operation, the police said.', 'lead_paragraph': 'A Brooklyn man who was shot and killed by a New York City police sergeant Thursday night had pointed a loaded handgun at the sergeant before the shooting, the police said on Friday. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/nyregion/21cityroom-gun/21cityroom-gun-jumbo.jpg', 'height': 597, 'width': 695, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/nyregion/21cityroom-gun/21cityroom-gun-superJumbo.jpg', 'height': 597, 'width': 695, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/nyregion/21cityroom-gun/21cityroom-gun-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/nyregion/21cityroom-gun/21cityroom-gun-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/nyregion/21cityroom-gun/21cityroom-gun-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Man Fatally Shot by Police Had Pointed Gun at Officer', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Search and Seizure', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Browne, Paul J', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Carroll Gardens (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-21T17:42:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Wendy Ruderman', 'person': [{'firstname': 'Wendy', 'middlename': None, 'lastname': 'Ruderman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/280f99e0-513d-5a60-a0e8-1a47d91fe8c4', 'word_count': 485, 'uri': 'nyt://article/280f99e0-513d-5a60-a0e8-1a47d91fe8c4'}, {'abstract': 'Did astrology help ensure Hitler’s defeat?', 'web_url': 'https://6thfloor.blogs.nytimes.com/2012/09/21/stargazing-spies-and-clandestine-warmongering-in-world-war-ii/', 'snippet': 'Did astrology help ensure Hitler’s defeat?', 'lead_paragraph': 'Last month the Israeli astrologer Miriam Binyamini predicted, based on her reading of the stars, that war between Israel and Iran is not imminent. Unsurprisingly, the forecast incited some mockery in the letters section of\xa0The Jerusalem Post. “Our defense forces and home front can now relax and breathe a deep sigh of relief,” one correspondent wrote. “However, despite our gratefulness to astrologer Binyamini for the above glad tidings, I feel she was morally remiss for not also activating her star-gazing skills for a matter of lesser importance, but still rather hurtful, when she failed to alert us to the rise of the dollar against the shekel.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/magazine/21-us-soldier-wwii/21-us-soldier-wwii-jumbo.jpg', 'height': 662, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/magazine/21-us-soldier-wwii/21-us-soldier-wwii-superJumbo.jpg', 'height': 1272, 'width': 1968, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/magazine/21-us-soldier-wwii/21-us-soldier-wwii-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/magazine/21-us-soldier-wwii/21-us-soldier-wwii-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/magazine/21-us-soldier-wwii/21-us-soldier-wwii-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Stargazing, Spies and Clandestine Warmongering in World War II', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-21T17:42:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By MAUD NEWTON', 'person': [{'firstname': 'Maud', 'middlename': None, 'lastname': 'NEWTON', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fad4ade8-1330-5224-a923-de0ddb9c82e3', 'word_count': 850, 'uri': 'nyt://article/fad4ade8-1330-5224-a923-de0ddb9c82e3'}, {'abstract': 'In spite of experts’ warnings of its demise, the gran reserva style of Rioja has endured.', 'web_url': 'https://www.nytimes.com/2012/09/26/dining/in-spite-of-dire-warnings-the-rioja-gran-reservas-endure.html', 'snippet': 'In spite of experts’ warnings of its demise, the gran reserva style of Rioja has endured.', 'lead_paragraph': 'ONLY a few years ago, some Spanish wine experts were suggesting that the gran reserva style of Rioja would fade to extinction in a decade or so. Their rationale seemed clear. The worldwide consumer swoon in the last 20 years for plush, dark, bountiful flavors had marginalized these smooth, pale, harmonious wines, which are aged for years in barrels and convey their complexities more through finesse and shimmering textures than bold fruit flavors.', 'print_section': 'D', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26POUR_SPAN/26POUR_SPAN-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/26/dining/26POUR_SPAN/26POUR_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26POUR_SPAN/26POUR_SPAN-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26POUR_SPAN/26POUR_SPAN-superJumbo.jpg', 'height': 1080, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26POUR_SPAN/26POUR_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/26/dining/26POUR_SPAN/26POUR_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26POUR_SPAN/26POUR_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gentle Soul in a World of Bold Fruit', 'kicker': 'The Pour', 'content_kicker': None, 'print_headline': 'Gentle Soul in a World of Bold Fruit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wines', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-21T17:43:29+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Eric Asimov', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Asimov', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cdc4e546-4e68-5164-926d-5bf8d27b8d04', 'word_count': 1125, 'uri': 'nyt://article/cdc4e546-4e68-5164-926d-5bf8d27b8d04'}, {'abstract': 'Nearly 5,000 acres in Colorado will be set aside for protection, which has cultural significance for the modern-day Pueblo and some other tribes.', 'web_url': 'https://green.blogs.nytimes.com/2012/09/21/chimney-rock-declared-a-national-monument/', 'snippet': 'Nearly 5,000 acres in Colorado will be set aside for protection, which has cultural significance for the modern-day Pueblo and some other tribes.', 'lead_paragraph': 'President Obama signed a proclamation on Friday designating nearly 5,000 acres of high desert at Chimney Rock, the site of a striking rock formation in southwestern Colorado, as a national monument. Ken Salazar, the interior secretary, and Tom Vilsack, the agriculture secretary, flew to Colorado for the ceremonial designation. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Chimney Rock Declared a National Monument', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'National Parks, Monuments and Seashores', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Colorado', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-21T17:45:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/9657f654-066c-548e-9d04-096bae2b5a69', 'word_count': 92, 'uri': 'nyt://article/9657f654-066c-548e-9d04-096bae2b5a69'}, {'abstract': 'The creamy salt cod dish brandade de morue is considered normal, everyday stuff, but when well prepared, it borders on ethereal.', 'web_url': 'https://www.nytimes.com/2012/09/26/dining/taking-salt-cod-and-making-it-heavenly.html', 'snippet': 'The creamy salt cod dish brandade de morue is considered normal, everyday stuff, but when well prepared, it borders on ethereal.', 'lead_paragraph': 'IN France, the creamy salt cod dish called brandade de morue (creamed salt cod), despite its elegant-sounding name, is considered ordinary. Good, but fairly ordinary. As familiar as shepherd’s pie or tuna casserole in North America. ', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26KITCH1_SPAN/26KITCH1_SPAN-articleLarge-v2.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/26/dining/26KITCH1_SPAN/26KITCH1_SPAN-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26KITCH1_SPAN/26KITCH1_SPAN-jumbo-v2.jpg', 'height': 676, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26KITCH1_SPAN/26KITCH1_SPAN-superJumbo-v2.jpg', 'height': 1351, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/dining/26KITCH1_SPAN/26KITCH1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/26/dining/26KITCH1_SPAN/26KITCH1_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Taking an Ordinary Dish and Making It Heavenly', 'kicker': 'City Kitchen', 'content_kicker': None, 'print_headline': 'Taking an Ordinary Dish and Making It Heavenly', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cod (Fish)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-21T17:47:43+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By David Tanis', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Tanis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1aea00d5-01c0-5e1a-a45a-0e6629356490', 'word_count': 472, 'uri': 'nyt://article/1aea00d5-01c0-5e1a-a45a-0e6629356490'}, {'abstract': 'The lowly potato is giving root to a lofty food culture in southern Sweden.', 'web_url': 'https://www.nytimes.com/2012/09/23/t-magazine/swedens-pommes-de-terroir.html', 'snippet': 'The lowly potato is giving root to a lofty food culture in southern Sweden.', 'lead_paragraph': 'Near dusk on a summer evening in Cape Bjare, Sweden, I stood in an elegant farmhouse and considered three large bowls of boiled potatoes. These were not hearty russets or Yukon Golds. They were small, delicate new potatoes, three of about two dozen varieties that are grown and harvested young on this green peninsula jutting into the North Sea. My host was Peter Ekelund, a native of Cape Bjare and one of the founders of Absolut Vodka. With farmers from the area, Ekelund has been making a new vodka out of the Cape’s star crop, and he was eager to introduce me to what many here call their “potato culture.” A tasting was in order.', 'print_section': 'M2', 'print_page': '106', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/t-magazine/23well-sweden/23well-sweden-jumbo.jpg', 'height': 826, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/t-magazine/23well-sweden/23well-sweden-superJumbo.jpg', 'height': 1652, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/t-magazine/23well-sweden/23well-sweden-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/23/t-magazine/23well-sweden/23well-sweden-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/t-magazine/23well-sweden/23well-sweden-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pommes de Terroir', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pommes de Terroir', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Sweden', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Potatoes', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-21T17:49:26+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Abby Aguirre', 'person': [{'firstname': 'Abby', 'middlename': None, 'lastname': 'Aguirre', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c4f698b1-9411-5793-9812-4fcd781c2e69', 'word_count': 1472, 'uri': 'nyt://article/c4f698b1-9411-5793-9812-4fcd781c2e69'}, {'abstract': 'Vice President Joseph R. Biden Jr. and his wife, Jill, bought a 36-pound pumpkin and some pies at the Spring Ledge Farm Stand in New London, N.H., while campaigning in the swing state on Friday.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/09/21/the-caucus-click-biden-goes-pumpkin-picking/', 'snippet': 'Vice President Joseph R. Biden Jr. and his wife, Jill, bought a 36-pound pumpkin and some pies at the Spring Ledge Farm Stand in New London, N.H., while campaigning in the swing state on Friday.', 'lead_paragraph': '', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Caucus Click: Biden Goes Pumpkin Picking', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-21T17:51:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By James Hill', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Hill', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9a16b3ed-738f-5b85-96d2-6956785a7805', 'word_count': 1, 'uri': 'nyt://article/9a16b3ed-738f-5b85-96d2-6956785a7805'}, {'abstract': 'A technical malfunction at GoDaddy and an outage at Facebook sent a ripple across the Internet, demonstrating just how complex relationships on the Web have become. A cyberattack or technical snag on one Web site now has the power to take down thousands, if not millions, of other sites.', 'web_url': 'https://bits.blogs.nytimes.com/2012/09/21/no-web-site-is-an-island/', 'snippet': 'A technical malfunction at GoDaddy and an outage at Facebook sent a ripple across the Internet, demonstrating just how complex relationships on the Web have become. A cyberattack or technical snag on one Web site now has the power to take down tho...', 'lead_paragraph': 'Late one night last June, Facebook’s Web site ground to a halt. All around the Web, thousands of other sites with a Facebook “Like” button slowed to a crawl. Last week, a technical malfunction at GoDaddy took down its Web site and millions more, many of which did not use a GoDaddy service.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Web Site Is an Island', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computer Network Outages', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-21T17:53:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nicole Perlroth', 'person': [{'firstname': 'Nicole', 'middlename': None, 'lastname': 'Perlroth', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/de7365fd-8587-5a7b-9731-2ba3857716ec', 'word_count': 345, 'uri': 'nyt://article/de7365fd-8587-5a7b-9731-2ba3857716ec'}, {'abstract': 'Some parents help their adult children financially, while others cannot or do not — and that often unspoken distinction among families can determine who gets ahead.', 'web_url': 'https://www.nytimes.com/2012/09/22/your-money/the-hidden-inheritance-many-parents-already-provide.html', 'snippet': 'Some parents help their adult children financially, while others cannot or do not — and that often unspoken distinction among families can determine who gets ahead.', 'lead_paragraph': 'For all of the conversation this week about Mitt Romney’s views on federal income taxes and personal responsibility, his insistence that “I have inherited nothing” may be the most thought-provoking. ', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/your-money/22money/22money-jumbo.jpg', 'heig