', 'url': 'images/2012/09/24/sports/soccer/24soccer-pic/24soccer-pic-jumbo.jpg', 'height': 448, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/sports/soccer/24soccer-pic/24soccer-pic-superJumbo.jpg', 'height': 897, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/sports/soccer/24soccer-pic/24soccer-pic-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/24/sports/soccer/24soccer-pic/24soccer-pic-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/sports/soccer/24soccer-pic/24soccer-pic-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After a Fitting Tribute, Liverpool’s Inspired Play Falls Short', 'kicker': 'Manchester United 2, Liverpool 1', 'content_kicker': None, 'print_headline': 'Remembrance Overshadows a Rivalry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Hillsborough Stadium (Sheffield, England)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Liverpool (Soccer Team)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Manchester United (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Accidents and Safety', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-23T20:17:07+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Kristian Walsh', 'person': [{'firstname': 'Kristian', 'middlename': None, 'lastname': 'Walsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/376c3bf1-3389-52de-9a55-49d96788bcd5', 'word_count': 786, 'uri': 'nyt://article/376c3bf1-3389-52de-9a55-49d96788bcd5'}, {'abstract': 'New York City Ballet performed four Balanchine pieces at Lincoln Center, incorporating that choreographer’s complexity and leanings.', 'web_url': 'https://www.nytimes.com/2012/09/24/arts/dance/new-york-city-ballet-in-balanchine-at-lincoln-center.html', 'snippet': 'New York City Ballet performed four Balanchine pieces at Lincoln Center, incorporating that choreographer’s complexity and leanings.', 'lead_paragraph': 'The biographies of George Balanchine tell us of his several wives, of his other loves, and of his devotion to the female dancer. His ballets, though, make his feeling for women yet more complicated. Even in moments of amorous surrender one part of his women stays unreachable. And one part of his men always craves, in female terms, what they cannot have.', 'print_section': 'C', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/arts/subnycb/subnycb-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/24/arts/subnycb/subnycb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/arts/subnycb/subnycb-jumbo.jpg', 'height': 656, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/arts/subnycb/subnycb-superJumbo.jpg', 'height': 1312, 'width': 204