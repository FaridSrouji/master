chelle Obama hug takes time.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/04/us/SUBMICHELLE1/SUBMICHELLE1-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/04/us/SUBMICHELLE1/SUBMICHELLE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/04/us/SUBMICHELLE1/SUBMICHELLE1-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/04/us/SUBMICHELLE1/SUBMICHELLE1-superJumbo.jpg', 'height': 1338, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'First Lady Strives for Caring Image Above Partisan Fray', 'kicker': None, 'content_kicker': None, 'print_headline': 'First Lady Strives for Caring Image Above Partisan Fray', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2008', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Democratic National Convention', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Michelle', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-04T00:16:25+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jodi Kantor', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Kantor', 'qualifier'