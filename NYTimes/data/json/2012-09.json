rk Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/business/OECD/OECD-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/14/business/OECD/OECD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/business/OECD/OECD-jumbo.jpg', 'height': 655, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/business/OECD/OECD-superJumbo.jpg', 'height': 1311, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'O.E.C.D. Finds New Signs of Weakness in World Economy', 'kicker': 'Euro Watch', 'content_kicker': None, 'print_headline': 'O.E.C.D. Finds New Signs of Weakness in World Economy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Organization for Economic Cooperation and Development', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Euro (Currency)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-13T11:46:46+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': 'By Stephen Castle', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Castle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/565d9e1b-cbbf-5ce2-a40d-5c0dda6a0e2a', 'word_count': 533, 'uri': 'nyt://article/565d9e1b-cbbf-5ce2-a40d-5c0dda6a0e2a'}, {'abstract': 'The plan is to measure the media consumption patterns of consumers across five platforms: radio, television, mobile phones, tablets and desktop computers.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/09/13/espn-aided-by-arbitron-and-comscore-to-follow-the-audience-wherever-it-goes/', 'snippet': 'The plan is to measure the media consumption patterns of consumers across five platforms: radio, television, mobile phones, tablets and desktop computers.', 'lead_paragraph': 'With more people using Twitter while they watch television, surfing the Web while they listen to the radio, or toggling between the content on their tablets and smartphones, advertisers and media companies are struggling to keep track of the eyeballs they covet.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'ESPN, Aided by Arbitron and comScore, to Follow the Audience Wherever It Goes', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Arbitron Inc', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'comScore Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'ESPN', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-13T12:00:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Tanzina Vega', 'person': [{'firstname': 'Tanzina', 'middlename': None, 'lastname': 'Vega', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6e5a65e4-0a72-5646-b436-95d3bf47b0cc', 'word_count': 487, 'uri': 'nyt://article/6e5a65e4-0a72-5646-b436-95d3bf47b0cc'}, {'abstract': 'Three Chicago theater buddies — the director Dexter Bullard, the actor Michael Shannon and the playwright Craig Wright — make their Broadway debut with Mr. Wright’s “Grace.”', 'web_url': 'https://www.nytimes.com/2012/09/16/theater/midwest-musketeers-storm-broadway.html', 'snippet': 'Three Chicago theater buddies — the director Dexter Bullard, the actor Michael Shannon and the playwright Craig Wright — make their Broadway debut with Mr. Wright’s “Grace.”', 'lead_paragraph': 'TO sit in the orchestra of a Broadway theater in the week before a show begins previews is to wonder that any show ever opens at all. Late on a Friday night, at the close of a technical rehearsal for “Grace,” a play by Craig Wright at the Cort Theater, doors wobbled, lines faltered and costume changes dragged. ', 'print_section': 'AR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16TRIO1_SPAN/16TRIO1_SPAN-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/16/arts/16TRIO1_SPAN/16TRIO1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16TRIO1_SPAN/16SUBTRIO1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16TRIO1_SPAN/16SUBTRIO1-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16TRIO1_SPAN/16TRIO1_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/16