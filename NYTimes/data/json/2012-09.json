: [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4951581a-c29e-5532-a1ad-501a3242a056', 'word_count': 131, 'uri': 'nyt://article/4951581a-c29e-5532-a1ad-501a3242a056'}, {'abstract': 'The millennials whose future I’m robbing are my four children, and it’s costing me a fortune to do it.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13winerip.html', 'snippet': 'The millennials whose future I’m robbing are my four children, and it’s costing me a fortune to do it.', 'lead_paragraph': 'The only way to save America’s children is to lock up the baby boomers. We are robbing the next generation’s future.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13winerip/13winerip-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/13/booming/13winerip/13winerip-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13winerip/13winerip-jumbo.jpg', 'height': 602, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13winerip/13winerip-superJumbo.jpg', 'height': 1205, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13winerip/13winerip-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/13/booming/13winerip/13winerip-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13winerip/13winerip-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Boomers vs. Millennials: Who’s Really Getting Robbed?', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Personal Finances', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:11+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Michael Winerip', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Winerip', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6ae8fb82-e2b3-5330-9ab3-9f7c58235ec6', 'word_count': 884, 'uri': 'nyt://article/6ae8fb82-e2b3-5330-9ab3-9f7c58235ec6'}, {'abstract': 'A special section offers news on social security and advice on how improve your financial standing.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13refer.html', 'snippet': 'A special section offers news on social security and advice on how improve your financial standing.', 'lead_paragraph': 'In case you missed the special retirement section on Wednesday, it’s worth having a look, particularly if you’re a boomer heading that way. It’ll give you a lot to think about. Paul Sullivan has a more than a little worrisome story on how hard it is for retirees to rely on Social Security alone, “The Tightwire Act of Living Only on Social Security.” The numbers are not on our side.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Looking Toward Retirement', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Retirement', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pensions and Retirement Plans', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:11+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/b55662e8-d480-55a0-9007-10b839c8044e', 'word_count': 285, 'uri': 'nyt://article/b55662e8-d480-55a0-9007-10b839c8044e'}, {'abstract': 'Tory Johnson will answer questions about returning to work or starting a business.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13expert.html', 'snippet': 'Tory Johnson will answer questions about returning to work or starting a business.', 'lead_paragraph': 'While the unemployment rate for baby boomers is lower than for younger workers, once boomers lose a job, it takes them longer to find a new one.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13expert/13expert-jumbo.jpg', 'height': 731, 'width': 581, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13expert/13expert-superJumbo.jpg', 'height': 731, 'width': 581, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13expert/13expert-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/13/booming/13expert/13expert-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13expert/13expert-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Getting Back to Work', 'kicker': 'Ask the Expert', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:11+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Michael Winerip', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Winerip', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e1949ac4-2b08-581e-a5a1-5a40b79f95fc', 'word_count': 230, 'uri': 'nyt://article/e1949ac4-2b08-581e-a5a1-5a40b79f95fc'}, {'abstract': 'The Summit Bar in the East Village is an excellent destination for a grownup drink.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13drink.html', 'snippet': 'The Summit Bar in the East Village is an excellent destination for a grownup drink.', 'lead_paragraph': 'Unless you live there, the East Village is usually not the first neighborhood that comes to mind when you want a drink after work. The East Village is where your kids go with their friends — or where they rent an apartment (also with their friends).', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13drink/13drink-jumbo.jpg', 'height': 1024, 'width': 681, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13drink/13drink-superJumbo.jpg', 'height': 2048, 'width': 1363, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13drink/13drink-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/13/booming/13drink/13drink-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13drink/13drink-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mellow Drinks in a Surprising Neighborhood', 'kicker': 'A Quiet Drink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ALCOHOLIC BEVERAGES', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bars', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:11+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Steve Reddicliffe', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Reddicliffe', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e6365aff-df98-586d-ab62-5c960614948b', 'word_count': 449, 'uri': 'nyt://article/e6365aff-df98-586d-ab62-5c960614948b'}, {'abstract': 'A new destination for news, entertainment and commentary about baby boomers and the way they live now.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13intro.html', 'snippet': 'A new destination for news, entertainment and commentary about baby boomers and the way they live now.', 'lead_paragraph': 'This isn’t the best thing to admit, but the term “baby boomer” makes me a little queasy. In my mind it conjures images of 65-year-old hippies skipping through meadows on their way to the local Social Security office.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Welcome to Your Living Room, Boomers', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:11+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Michael Winerip', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Winerip', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ef983ffb-a164-503c-bad6-b1f64f96a34a', 'word_count': 317, 'uri': 'nyt://article/ef983ffb-a164-503c-bad6-b1f64f96a34a'}, {'abstract': 'The journal Neurology reported that football players are three to four times more likely than the rest of us to die from brain diseases.', 'web_url': 'https://learning.blogs.nytimes.com/2012/09/13/if-football-is-so-dangerous-to-players-should-we-be-watching-it/', 'snippet': 'The journal Neurology reported that football players are three to four times more likely than the rest of us to die from brain diseases.', 'lead_paragraph': 'Devon Walker, a Tulane University football player, broke his neck last weekend while making a tackle during a game. Three days earlier the journal Neurology reported that football players are three to four times more likely than the rest of us to die from brain diseases. If football, America’s most popular spectator sport, is inherently dangerous to players, should we be watching it?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'If Football Is So Dangerous to Players, Should We Be Watching It?', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-13T09:00:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8dddc6a8-ea08-5a51-b3e9-a78bda303dc5', 'word_count': 423, 'uri': 'nyt://article/8dddc6a8-ea08-5a51-b3e9-a78bda303dc5'}, {'abstract': 'People with presbyopia find that it is harder and harder to make out objects that are close to them.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13question.html', 'snippet': 'People with presbyopia find that it is harder and harder to make out objects that are close to them.', 'lead_paragraph': 'Your arms can push that book only so far away before you have to admit there is a problem, and it isn’t with your arms: it is with your eyes. It’s called presbyopia, and let’s not sugarcoat it. “That’s a Greek word for old eyes,” said Dr. James J. Salz, a Los Angeles ophthalmologist.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13question/13question-jumbo.jpg', 'height': 308, 'width': 308, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13question/13question-superJumbo.jpg', 'height': 308, 'width': 308, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13question/13question-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/13/booming/13question/13question-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13question/13question-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Can’t I Read This AARP Bulletin?', 'kicker': 'Question Mark', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Eyes and Eyesight', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:27+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Eric Nagourney', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Nagourney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/215579e3-127a-5ec3-92ae-04d9708b0115', 'word_count': 339, 'uri': 'nyt://article/215579e3-127a-5ec3-92ae-04d9708b0115'}, {'abstract': 'Margaret Trudeau turns 64, and Tommy Lee Jones and Oliver Stone hit the 66 mark, among others.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13birthdays.html', 'snippet': 'Margaret Trudeau turns 64, and Tommy Lee Jones and Oliver Stone hit the 66 mark, among others.', 'lead_paragraph': 'Baby boomers are aging gracelessly. It’s exhausting listening to us. How many times have you heard a boomer say, “I can’t believe I’m this old” — as if we are the first people in the history of the planet to turn 58. According to the Yankelovich research firm, the average boomer thinks old age begins at 79. Since average life expectancy is 77, this means boomers believe that first they will die, then they will get old.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13birthdays/13birthdays-jumbo.jpg', 'height': 1024, 'width': 767, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13birthdays/13birthdays-superJumbo.jpg', 'height': 2048, 'width': 1533, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13birthdays/13birthdays-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/13/booming/13birthdays/13birthdays-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13birthdays/13birthdays-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Baby Boomers Who Celebrate Birthdays This Week', 'kicker': 'One Year Older', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Birthdays', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:28+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Michael Winerip', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Winerip', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/16a8accc-d4ad-5aeb-b458-b63844537836', 'word_count': 194, 'uri': 'nyt://article/16a8accc-d4ad-5aeb-b458-b63844537836'}, {'abstract': 'A new feature profiles marriages, civil unions and partnerships that have lasted over 25 years. In the first of the series, one couple reminisces on the glue that holds it all together.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13last.html', 'snippet': 'A new feature profiles marriages, civil unions and partnerships that have lasted over 25 years. In the first of the series, one couple reminisces on the glue that holds it all together.', 'lead_paragraph': 'In Tom Brokaw’s best seller “The Greatest Generation,” he makes the case that the men and women who survived the Depression and led America to victory in World War II — the baby boomers’ parents and grandparents — made a contribution to this country like no other in history. Among the many reasons he cites is their commitment to family. Only one in six of their marriages ended in divorce; for the boomers it has been one in two.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13last-wedding/13last-wedding-jumbo.jpg', 'height': 1024, 'width': 729, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13last-wedding/13last-wedding-superJumbo.jpg', 'height': 2048, 'width': 1457, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13last-wedding/13last-wedding-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/13/booming/13last-wedding/13last-wedding-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13last-wedding/13last-wedding-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Better, for Worse, Couples Who Endure', 'kicker': 'Making It Last', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:35+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Michael Winerip', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Winerip', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d869c9c1-a767-5485-b588-ca8762cbf456', 'word_count': 874, 'uri': 'nyt://article/d869c9c1-a767-5485-b588-ca8762cbf456'}, {'abstract': 'One woman throws in the towel on self-improvement, and instead will hang on to what she’s got.', 'web_url': 'https://www.nytimes.com/2012/09/13/booming/13story.html', 'snippet': 'One woman throws in the towel on self-improvement, and instead will hang on to what she’s got.', 'lead_paragraph': 'I’m turning 58 next month, and the birthday present I’m giving myself is to call a halt to all of my efforts at self-improvement. I’m done trying to better myself. This is as good as I’m going to get. From now on, the goal is to try to hang on to what I’ve got.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13my-story/13my-story-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/13/booming/13my-story/13my-story-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13my-story/13my-story-jumbo.jpg', 'height': 623, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13my-story/13my-story-superJumbo.jpg', 'height': 683, 'width': 1122, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13my-story/13my-story-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/13/booming/13my-story/13my-story-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/13/booming/13my-story/13my-story-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I’m Not Getting Any Better', 'kicker': 'My Story', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:36+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Roz Warren', 'person': [{'firstname': 'Roz', 'middlename': None, 'lastname': 'Warren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/27e73c4c-76f6-5828-8351-b692b76e5987', 'word_count': 690, 'uri': 'nyt://article/27e73c4c-76f6-5828-8351-b692b76e5987'}, {'abstract': 'The tide in Europe is running against Germany and toward a weaker European Central Bank, two economists write.', 'web_url': 'https://economix.blogs.nytimes.com/2012/09/13/introducing-the-latin-euro/', 'snippet': 'The tide in Europe is running against Germany and toward a weaker European Central Bank, two economists write.', 'lead_paragraph': 'Peter Boone is chairman of the charity Effective Intervention and a research associate at the Center for Economic Performance at the London School of Economics. He is also a director of Salute Capital Management Ltd. Simon Johnson is the Ronald A. Kurtz Professor of Entrepreneurship at the M.I.T. Sloan School of Management and former chief economist at the International Monetary Fund.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Introducing the Latin Euro', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Euro (Currency)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Draghi, Mario', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'European Central Bank', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Simon Johnson and Peter Boone', 'person': [{'firstname': 'Simon', 'middlename': None, 'lastname': 'Johnson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Peter', 'middlename': None, 'lastname': 'Boone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/11b8d379-0c84-5ca6-9822-aa95bcd4f5a6', 'word_count': 1002, 'uri': 'nyt://article/11b8d379-0c84-5ca6-9822-aa95bcd4f5a6'}, {'abstract': 'The photographer Robert Nickelsberg has been making trips to Afghanistan since 1988. His new book-length project, “A Distant War,” goes past the current, seemingly intractable American invasion to show how a nation has been beleaguered by decades of almost perpetual conflict.', 'web_url': 'https://lens.blogs.nytimes.com/2012/09/13/a-long-view-of-wars-in-afghanistan/', 'snippet': 'The photographer Robert Nickelsberg has been making trips to Afghanistan since 1988. His new book-length project, “A Distant War,” goes past the current, seemingly intractable American invasion to show how a nation has been beleaguered by decades ...', 'lead_paragraph': 'KABUL, Afghanistan — One of the most troubling things about the national conversation about Afghanistan is that it tends to focus almost solely on the decade since the 2001 American-led invasion. Perhaps this is understandable, since the Afghan conflict marks the longest stretch of time that the United States has actively been at war. And as always, the latest crisis\xad, any of them, dominates attention: the growing threat posed by Afghan forces who kill their NATO colleagues, the unwillingness of Pakistan to stop sheltering militants who carry out attacks in Kabul, the plague of official corruption that undermines Western trust and the Afghan public’s support.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Long View of Afghanistan’s Wars', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Corruption (Institutional)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hazaras (Ethnic Group)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Pashtun (Ethnic Group)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Uzbeks (Ethnic Group)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Haqqani, Jalaluddin', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Hekmatyar, Gulbuddin', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Massoud, Ahmed Shah', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'Haqqani Network', 'rank': 11, 'major': 'N'}, {'name': 'organizations', 'value': 'North Atlantic Treaty Organization', 'rank': 12, 'major': 'N'}, {'name': 'organizations', 'value': 'Northern Alliance', 'rank': 13, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 14, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 15, 'major': 'N'}, {'name': 'glocations', 'value': 'Kabul (Afghanistan)', 'rank': 16, 'major': 'N'}], 'pub_date': '2012-09-13T09:00:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Richard Oppel', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Oppel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/26569795-53de-5ba0-8ccd-59d992797fb3', 'word_count': 2584, 'uri': 'nyt://article/26569795-53de-5ba0-8ccd-59d992797fb3'}, {'abstract': 'The tepid response from the Egyptian government to violence at the American Embassy in Cairo gave American officials cause for worry.', 'web_url': 'https://www.nytimes.com/2012/09/14/world/middleeast/egypt-not-libya-may-be-bigger-challenge-for-white-house.html', 'snippet': 'The tepid response from the Egyptian government to violence at the American Embassy in Cairo gave American officials cause for worry.', 'lead_paragraph': 'WASHINGTON — For all the harrowing images of the deadly attack on the American mission in Benghazi, the Obama administration is grappling with the possibility that its far bigger long-term problem lies in Egypt, not Libya.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/world/14egypt/14egypt-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/14/world/14egypt/14egypt-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/world/14egypt/14egypt-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/world/14egypt/14egypt-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/world/14egypt/14egypt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/14/world/14egypt/14egypt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/world/14egypt/14egypt-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Egypt May Be Bigger Concern Than Libya for White House', 'kicker': None, 'content_kicker': None, 'print_headline': 'Spotlight Is on Libya, but Bigger Challenge for White House May Lie in Egypt', 'name':