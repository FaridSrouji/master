tion': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/magazine/16riff/mag-16Riff-t_CA0-superJumbo.jpg', 'height': 265, 'width': 955, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/magazine/16riff/16riff-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/16/magazine/16riff/16riff-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/magazine/16riff/16riff-thumbLarge.jpg', 'height': 145, 'width': 144, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Not So Hot for Teacher', 'kicker': 'Riff', 'content_kicker': None, 'print_headline': 'Bad Apples', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Breaking Bad (TV Program)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Big C (Movie)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-14T14:35:51+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Elizabeth Alsop', 'person': [{'firstname': 'Elizabeth', 'middlename': None, 'lastname': 'Alsop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/68981410-3ee0-5598-92a5-969a08550c12', 'word_count': 1927, 'uri': 'nyt://article/68981410-3ee0-5598-92a5-969a08550c12'}, {'abstract': 'As the baseball coordinator for the film “Trouble With the Curve,” the former college athlete Aimee McDaniel ensures that the sports scenes are realistic and accurate.', 'web_url': 'https://www.nytimes.com/2012/09/16/movies/aimee-mcdaniel-oversees-sports-in-trouble-with-the-curve.html', 'snippet': 'As the baseball coordinator for the film “Trouble With the Curve,” the former college athlete Aimee McDaniel ensures that the sports scenes are realistic and accurate.', 'lead_paragraph': 'THE first-time director Robert Lorenz anticipated several challenges with the baseball sequences in “Trouble With the Curve,” about an aging scout, his daughter and his rivals. Quite a few roles required actors skilled at the game; one character is even described in the movie as a combination of Randy Johnson, Sandy Koufax and Steve Carlton, three of the greatest left-handed pitchers in the sport’s history. ', 'print_section': 'AR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16MCDANIEL1_SPAN/16MCDANIEL1_SPAN-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/16/arts/16MCDANIEL1_SPAN/16MCDANIEL1_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16MCDANIEL1_SPAN/16MCDANIEL1_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16MCDANIEL1_SPAN/16MCDANIEL1_SPAN-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/arts/16MCDANIEL1_SPAN/16MCDANIEL1_SPAN-thumbSt