ontent_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-14T15:07:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/57b03a32-5479-5a13-809d-06d464986693', 'word_count': 212, 'uri': 'nyt://article/57b03a32-5479-5a13-809d-06d464986693'}, {'abstract': 'Federal Reserve opens new chapter in efforts to stimulate the economy. | Benefiting from the auto bailout, but voting for Mitt Romney.', 'web_url': 'https://dealbook.nytimes.com/2012/09/14/business-day-live-bailouts-success-is-no-guarantee-of-votes/', 'snippet': 'Federal Reserve opens new chapter in efforts to stimulate the economy. | Benefiting from the auto bailout, but voting for Mitt Romney.', 'lead_paragraph': ' Federal Reserve opens new chapter in efforts to stimulate the economy. | Benefiting from the auto bailout, but voting for Mitt Romney.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Business Day Live: Bailout’s Success Is No Guarantee of Votes', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-14T15:07:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0