ualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bea8b523-6b9a-5abf-9f69-619c5aae3e96', 'word_count': 465, 'uri': 'nyt://article/bea8b523-6b9a-5abf-9f69-619c5aae3e96'}, {'abstract': 'In 1992, Congressman Joseph P. Kennedy II went on a fact-finding trip to Germany. Before he came home, he needed a punch line.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2012/09/14/my-brief-career-as-a-kennedy-speechwriter/', 'snippet': 'In 1992, Congressman Joseph P. Kennedy II went on a fact-finding trip to Germany. Before he came home, he needed a punch line.', 'lead_paragraph': 'I’ve never met Joseph P. Kennedy III, the Congressional candidate profiled in this week’s magazine. But as a reporter at The Boston Herald in the early 1990s, I covered his father, Joseph Kennedy II, who was then a congressman. I found the older Kennedy (whatever you may think about his politics) charismatic and curious about the world outside Massachusetts, which led him, and me with him, to Germany.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/magazine/14-joseph-kennedy-ii/14-joseph-kennedy-ii-jumbo.jpg', 'height': 1024, 'width': 778, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/magazine/14-joseph-kennedy-ii/14-joseph-kennedy-ii-superJumbo.jpg', 'height': 2000, 'width': 1520, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/magazine/14-joseph-kennedy-ii/14-joseph-kennedy-ii-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/14/magazine/14-joseph-kennedy-ii/14-joseph-kennedy-ii-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/magazine/14-joseph-kennedy-ii/14-joseph-kennedy-ii-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'My Brief Career as a Kennedy Speechwriter', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Speeches and Statements', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kennedy, Joseph P II', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-14T19:18:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By Harvey Dickson', 'person': [{'firstname': 'Harvey', 'middlename': None, 'lastname': 'Dickson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c51d1f23-1a2c-5874-b13d-1aaae64927c9', 'word_count': 433, 'uri': 'nyt://article/c51d1f23-1a2c-5874-b13d-1aaae64927c9'}, {'abstract': 'Lady Gaga ends Fashion Week with fragrance launch at the Guggenheim.', 'web_url': 'https://www.nytimes.com/slideshow/2012/09/14/fashion/20120914SCENECITYGAGA.html', 'snippet': 'Lady Gaga ends Fashion Week with fragrance launch at the Guggenheim.', 'lead_paragraph': 'Lady Gaga ends Fashion Week with fragrance launch at the Guggenheim.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/14/fashion/20120914SCENECITYGAGA-slide-J3HU/20120914SCENECITYGAGA-slide-J3HU-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/14/fashion/20120914SCENECITYGAGA-sl