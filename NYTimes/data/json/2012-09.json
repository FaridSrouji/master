line': {'main': 'Ratings Gold for Gordon Ramsay’s Reality Empire', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Reality Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ramsay, Gordon', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-07T19:00:06+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Adam W. Kepler', 'person': [{'firstname': 'Adam', 'middlename': 'W.', 'lastname': 'Kepler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f7af2ed5-3847-56f7-965d-0c4422f7bd18', 'word_count': 364, 'uri': 'nyt://article/f7af2ed5-3847-56f7-965d-0c4422f7bd18'}, {'abstract': 'A wheelchair racer discusses strategy and what it takes to win a medal these days in the Paralympic Games.', 'web_url': 'https://london2012.blogs.nytimes.com/2012/09/07/to-contend-at-the-paralympics-race-brave/', 'snippet': 'A wheelchair racer discusses strategy and what it takes to win a medal these days in the Paralympic Games.', 'lead_paragraph': 'The wheelchair racer Joshua George will be competing in the 2012 Paralympic Games in London and writing for the 2012 London blog.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'To Contend at the Paralympics, Race Brave', 'kicker': '2012 London Olympics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-07T19:00:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Joshua George', 'person': [{'firstname': 'Joshua', 'middlename': None, 'lastname': 'George', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', 