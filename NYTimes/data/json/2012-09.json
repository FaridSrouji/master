ubsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1272b63d-7b37-51af-a618-ac0676a39e09', 'word_count': 1240, 'uri': 'nyt://article/1272b63d-7b37-51af-a618-ac0676a39e09'}, {'abstract': 'If we want to encourage more economic growth, we could start by not bashing the few super-ambitious people at the top.', 'web_url': 'https://www.nytimes.com/2012/09/21/opinion/brooks-temerity-at-the-top.html', 'snippet': 'If we want to encourage more economic growth, we could start by not bashing the few super-ambitious people at the top.', 'lead_paragraph': 'I guess we’re all supposed to be talking about how to build the middle class these days and look askance at the top 1 percent. But would you mind if I interrupted this cultural moment to point out that capitalism is an inherently elitist enterprise?', 'print_section': 'A', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/david-brooks/david-brooks-articleLarge-v2.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/david-brooks/david-brooks-articleLarge-v2.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/david-brooks/david-brooks-jumbo-v2.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/david-brooks/david-brooks-superJumbo-v2.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo',