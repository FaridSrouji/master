 album.', 'lead_paragraph': 'The first officially licensed product for sale in the marketing blitz for “Fifty Shades of Grey,” the publishing phenomenon that brought sadomasochism into the pop-culture mainstream, is not a toy whip or a handcuff or even a T-shirt. It’s Bach.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/arts/18artsbeat-shades/18artsbeat-shades-jumbo.jpg', 'height': 731, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/arts/18artsbeat-shades/18artsbeat-shades-superJumbo.jpg', 'height': 1463, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/arts/18artsbeat-shades/18artsbeat-shades-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/18/arts/18artsbeat-shades/18artsbeat-shades-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/arts/18artsbeat-shades/18artsbeat-shades-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Those in the Mood, Some Music', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Giving Sadomasochism a Classy Soundtrack', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'James, E L', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'EMI Group PLC', 'rank': 3, 'major': 'N'}], 'pub_date': '