: '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/16e23fdb-fe4f-5a6f-a2ec-591c7326a570', 'word_count': 160, 'uri': 'nyt://article/16e23fdb-fe4f-5a6f-a2ec-591c7326a570'}, {'abstract': 'Mr. Stacks was a longtime reporter and editor at Time and the author of a biography of James B. Reston.', 'web_url': 'https://www.nytimes.com/2012/09/06/us/john-f-stacks-writer-and-editor-dies-at-70.html', 'snippet': 'Mr. Stacks was a longtime reporter and editor at Time and the author of a biography of James B. Reston.', 'lead_paragraph': 'John F. Stacks, a former reporter and senior editor at Time magazine and the author of a well-regarded biography of James B. Reston, the influential editor and columnist for The New York Times, died on Tuesday in Manhattan. He was 70.', 'print_section': 'A', 'print_page': '29', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/07/sports/stacks1/stacks1-jumbo.jpg', 'height': 1024, 'width': 589, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/07/sports/stacks1/stacks1-superJumbo.jpg', 'height': 2048, 'width': 1179, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/07/sports/stacks1/stacks1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/07/sports/stacks1/stacks1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/07/sports/stacks1/s