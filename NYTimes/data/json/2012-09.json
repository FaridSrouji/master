41c2cca', 'word_count': 0, 'uri': 'nyt://slideshow/442b224e-153f-54f0-830a-c321541c2cca'}, {'abstract': 'Phil Mickelson shot an eight-under-par 64 on Saturday, on the same course he was denied from playing 21 years ago, to move into a tie for the lead with Vijay Singh at the BMW Championship.', 'web_url': 'https://www.nytimes.com/2012/09/09/sports/golf/phil-mickelson-ties-for-lead-at-bmw-championship.html', 'snippet': 'Phil Mickelson shot an eight-under-par 64 on Saturday, on the same course he was denied from playing 21 years ago, to move into a tie for the lead with Vijay Singh at the BMW Championship.', 'lead_paragraph': 'CARMEL, Ind. — Nobody in this week’s BMW Championship field played at Crooked Stick Golf Club when it hosted the 1991 P.G.A. Championship, a major point of contention for Phil Mickelson, who qualified, or so he thought, by virtue of his win at the tour stop that year in Tucson. ', 'print_section': 'SP', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mickelson’s 64 Shouts: Remember, I Can Play', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mickelson’s 64 Shouts: Remember, I Can Play', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Singh, Vijay', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mickelson, Phil', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'PGA Championship', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-09T01:04:45+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Karen Crouse', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Crouse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f7dcdc09-b8bb-5daf-9124-35ded78e3d34', 'word_count': 795, 'u