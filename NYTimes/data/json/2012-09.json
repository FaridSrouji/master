pe': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/fashion/09FIELDNOTES/09FIELDNOTES-jumbo.jpg', 'height': 1011, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/fashion/09FIELDNOTES/09FIELDNOTES-superJumbo.jpg', 'height': 2022, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/fashion/09FIELDNOTES/09FIELDNOTES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/fashion/09FIELDNOTES/09FIELDNOTES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/fashion/09FIELDNOTES/09FIELDNOTES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Paying the Hidden Cost of a Destination Wedding', 'kicker': 'Field Notes', 'content_kicker': None, 'print_headline': 'Paying the Hidden Cost Of a Destination Wedding', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-07T21:26:21+0000', 'document_type': 'article', 'news_desk': 'Society', 'section_name': 'Fashion & Style', 'subsection_name': 'Weddings', 'byline': {'original': 'By Christine Negroni', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Negroni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/db42132d-f6c5-5822-a95b-c988c0b45027', 'word_count': 1517, 'uri': 'nyt://article/db42132d-f6c5-5822-a95b-c988c0b45027'}, {'abstract': 'The founder of Garda World Security, an armored car and security company based in Montreal, has joined with the private equity firm Apax Partners to make a $1.1 billion offer to take the company private.', 'web_url': 'https://dealbook.nytimes.com/2012/09/07/garda-security-gets-1-1-billion-buyout-offer/', 'snippet': 'The founder of Garda World Security, an armored car and security company based in Montreal, has joined with the private equity firm Apax Partners to make a $1.1 billion offer to take the company private.', 'lead_paragraph': 'QUEBEC CITY _ The founder, chairman and chief executive of Garda World Security, an armored car and security company based in Montreal, joined forces with a private equity fund to make a $1.1 billion offer to take the company private on Friday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Garda Security Gets $1.1 Billion Buyout Offer', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'Company News: Garda’s Founder Makes Offer To Take It Private', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARMORED CAR SERVICES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Private Equity', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'APAX PARTNERS', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Garda World Security Corporation', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Montreal (Quebec)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-07T21:27:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Ian Austen', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Austen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fe295850-c2f3-5fb6-839d-80654392527d', 'word_count': 293, 'uri': 'nyt://article/fe295850-c2f3-5fb6-839d-80654392527d'}, {'abstract': 'Our latest issue features Jay-Z and Zadie Smith, rock climbing with Chris Sharma, and David Cronenberg in Cannes.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/09/07/now-online-t-mens-fashion-fall-2012/', 'snippet': 'Our latest issue features Jay-Z and Zadie Smith, rock climbing with Chris Sharma, and David Cronenberg in Cannes.', 'lead_paragraph': 'Jay-Z and Zadie Smith discuss his music, his life, politics and, oh yeah, the new Barclays Center in Brooklyn, in the cover story of the fall men’s fashion issue of T. Inside, the actor Nico Tortorella models the latest knits, the musicians in Sweet Swing Trio show off looks from Paris, and the rock climber Chris Sharma proves he’s actually pretty grounded. For the newest fashion trends, check out our roundup of svelte new overcoats or see what Suzy Menkes has to say about man bags. Don’t forget to check out David Amsden’s report on fitness gear that broadcasts your results to the world; Lynn Yaeger’s look at Artcurial in Paris, where the auction lots include hunks of meat; and Janine di Giovanni’s profile of Gene Sharp, who has helped spread peace around the globe for 40 years. When you’re done, visit a classic Philip Johnson house filled with art; meet Brit Marling, an actress, screenwriter and Georgetown grad; and hit the Cannes red carpet with the likes of Zac Efron, Chris O’Dowd and David Cronenberg, who show off the season’s premier essential: a non-red-carpet coat.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Now Online | T Men’s Fashion Fall 2012', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-07T21:30:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5c06b998-3b81-551b-934d-136b5b07f940', 'word_count': 186, 'uri': 'nyt://article/5c06b998-3b81-551b-934d-136b5b07f940'}, {'abstract': 'Bob and Mike Bryan defeated Radek Stepanek and Leander Paes, 6-3, 6-4, to claim the open era record for major championships in doubles.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/09/07/bryan-brothers-win-12th-grand-slam-doubles-title/', 'snippet': 'Bob and Mike Bryan defeated Radek Stepanek and Leander Paes, 6-3, 6-4, to claim the open era record for major championships in doubles.', 'lead_paragraph': 'Bob and Mike Bryan won the United States Open men’s doubles title on Friday, 6-3, 6-4, over Radek Stepanek of Czech Republic and Leander Paes of India.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bryan Brothers Win 12th Grand Slam Doubles Title', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bryan, Bob', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bryan, Mike', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Paes, Leander', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Stepanek, Radek', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-07T21:32:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By John Martin', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported',