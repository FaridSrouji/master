me': 'Sweeney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6922865b-a404-5695-bb71-6917dc71e370', 'word_count': 872, 'uri': 'nyt://article/6922865b-a404-5695-bb71-6917dc71e370'}, {'abstract': 'A participant in the Elkhart Lake Vintage Festival in Wisconsin will retrace a rally route traveled by his father 60 years ago.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/09/05/a-race-for-the-ages-in-the-midwest/', 'snippet': 'A participant in the Elkhart Lake Vintage Festival in Wisconsin will retrace a rally route traveled by his father 60 years ago.', 'lead_paragraph': 'JACKSON, Mich. — In 1952, Charles Greene Jr. and Cliff Voss, his co-pilot, drove a brand-new MG-TD in a rally staged in conjunction with the sports-car races in Elkhart Lake, Wis. On Wednesday, to celebrate that run’s 60th anniversary, Charles Greene III will set off in the tire tracks of his father.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Rally for the Ages in the Midwest', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Racing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Wisconsin', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-05T10:00:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Larry Edsall', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Edsall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8ebb17f4-d45f-5908-afb2-6a1b8a010c9b', 'word_count': 356, 'uri': 'nyt://article/8ebb17f4-d45f-5908-afb2-6a1b8a010c9b'}, {'abstract': 'Social insurance for unemployment, disability and retirement encourages workers to stop working and employers to lay people off, an economist writes.', 'web_url': 'https://economix.blogs.nytimes.com/2012/09/05/social-insurance-and-layoffs/', 'snippet': 'Social insurance for unemployment, disability and retirement encourages workers to stop working and employers to lay people off, an economist writes.', 'lead_paragraph': 'Casey B. Mulligan is an economics professor at the University of Chicago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Social Insurance and Layoffs', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Unemployment Insurance', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Congressional Budget Office', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-05T10:00:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Casey B. Mulligan', 'person': [{'firstname': 'Casey', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a35374f6-58ac-579f-804f-9909e061e4ed', 'word_count': 882, 'uri': 'nyt://article/a35374f6-58ac-579f-804f-9909e061e4ed'}, {'abstract': 'The makings are here for a breakout season, but Seattle has questionable depth on both sides of the ball.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/09/05/seattle-seahawks-2012-n-f-l-season-preview/', 'snippet': 'The makings are here for a breakout season, but Seattle has questionable depth on both sides of the ball.', 'lead_paragraph': 'This past May when the Seattle Seahawks turned down an invitation to be on “Hard Knocks,” they didn’t just avoid a potentially monster-sized distraction, they also kept the lid on what might just be the best-kept secret in the N.F.L. Want a breakout team for 2012? Turn your attention to the upper left corner of our country’s map.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Seattle Seahawks, 2012 N.F.L. Season Preview', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Seattle Seahawks', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-05T10:00:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Andy Benoit', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Benoit', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9e4da0b3-8e0f-585f-9e6a-3121b5ec860f', 'word_count': 2703, 'uri': 'nyt://article/9e4da0b3-8e0f-585f-9e6a-3121b5ec860f'}, {'abstract': 'The matches to watch at the United States Open on Wednesday.', 'web_url': 'https://straightsets.blogs.nytimes.com/2012/09/05/what-to-watch-on-wednesday-at-the-us-open-2/', 'snippet': 'The matches to watch at the United States Open on Wednesday.', 'lead_paragraph': 'The last time Andy Murray took to these courts against Marin Cilic, things didn’t go quite as planned.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What to Watch on Wednesday', 'kicker': 'Straight Sets', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-05T10:00:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Aron Pilho