 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7f871dda-c5df-5bfd-96b1-5eb2be1a6f83', 'word_count': 829, 'uri': 'nyt://article/7f871dda-c5df-5bfd-96b1-5eb2be1a6f83'}, {'abstract': 'Steve James’s film “Head Games” examines the long-term consequences of some high-impact sports.', 'web_url': 'https://www.nytimes.com/2012/09/21/movies/head-games-a-documentary-about-athletic-injuries.html', 'snippet': 'Steve James’s film “Head Games” examines the long-term consequences of some high-impact sports.', 'lead_paragraph': 'Part of the romance of sports lies in the thrill of controlled, heroic brutality. Modern athletes are often likened to warriors: they sacrifice, put their bodies on the line and take punishment in pursuit of a noble cause. The rest of us — couch potatoes, season-ticket holders, parents on the sidelines — cheer for the toughest players and the hardest hits. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HEAD_SPAN/21HEAD_SPAN-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/21/arts/21HEAD_SPAN/21HEAD_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HEAD_SPAN/21HEAD_SPAN-jumbo.jpg', 'height': 579, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HEAD_SPAN/21HEAD_SPAN-superJumbo.jpg', 'height': 1157, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HEAD_SPAN/21HEAD_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/arts/21HEAD_SPAN/21HEAD_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Hit in the End Zone, a Price for a Lifetime', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'A Hit in the End Zone, a Price for a Lifetime', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sports Injuries', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Head Games (Movie)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'James, Steve (1954- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-20T23:46:19+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/90a79316-3a79-549c-8a01-a15f7f12cd6d', 'word_count': 395, 'uri': 'nyt://article/90a79316-3a79-549c-8a01-a15f7f12cd6d'}, {'abstract': 'Locked out for the third time in his N.H.L. career, Jaromir Jagr received a heartfelt welcome Wednesday in Prague as he suited up for the Czech Extraliga franchise he now owns.', 'web_url': 'https://www.nytimes.com/2012/09/21/sports/hockey/jaromir-jagr-relishes-homecoming-in-czech-league.html', 'snippet': 'Locked out for the third time in his N.H.L. career, Jaromir Jagr received a heartfelt welcome Wednesday in Prague as he suited up for the Czech Extraliga franchise he now owns.', 'lead_paragraph': 'PRAGUE — Nearly 30 years since he began playing junior hockey in the unheralded, blue-collar city of Kladno, Jaromir Jagr has not forgotten his roots. Locked out for the third time in his N.H.L. career, he returned to his hometown to play. ', 'print_section': 'B', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/sports/y-jagr/y-jagr-jumbo.jpg', 'height': 1024, 'width': 614, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/sports/y-jagr/y-jagr-superJumbo.jpg', 'height': 2048, 'width': 1229, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/sports/y-jagr/y-jagr-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/sports/y-jagr/y-jagr-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/sports/y-jagr/y-jagr-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Locked Out, Jagr Returns to His Team Overseas', 'kicker': None, 'content_kicker': None, 'print_headline': 'Locked Out, Jagr Returns To His Team Overseas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Dallas Stars', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Czech Republic', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jagr, Jaromir', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Lockouts', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'H C Kladno (H