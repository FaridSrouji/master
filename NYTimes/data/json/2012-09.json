eight': 134, 'width': 134, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Should Peter Frew, the Struggling Tailor, Do?', 'kicker': 'The 6th Floor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Davidson, Adam', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-22T11:00:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Magazine', 'byline': {'original': 'By The Staff', 'person': [], 'organization': 'The Staff'}, 'type_of_material': 'News', '_id': 'nyt://article/3c90e1fe-b130-5988-9969-1ff751712431', 'word_count': 88, 'uri': 'nyt://article/3c90e1fe-b130-5988-9969-1ff751712431'}, {'abstract': 'A round-up of news from across India.', 'web_url': 'https://india.blogs.nytimes.com/2012/09/22/newswallah-bharat-edition-57/', 'snippet': 'A round-up of news from across India.', 'lead_paragraph': 'Punjab: Gulzar Singh Ranike, a minister in the Punjab state government, resigned on Sunday in the wake of allegations that he misappropriated public funds, The Times of India reported. Mr. Ranike and an associate were accused of transferring 25 million rupees, about $ 460,000, from funds intended for a border area development program.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Newswallah: Bharat Edition', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-22T11:09:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/a8b59e18-e11f-5a65-a571-47359546ab18', 'word_count': 335, 'uri': 'nyt://article/a8b59e18-e11f-5a65-a571-47359546ab18'}, {'abstract': 'Several times in his career, Eli Manning has dealt with the loss of seemingly indispensable receivers.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/09/22/irreplaceable-for-giants-it-applies-only-to-eli/', 'snippet': 'Several times in his career, Eli Manning has dealt with the loss of seemingly indispensable receivers.', 'lead_paragraph': 'In his latest post at CapitalNewYork.com, Greg Hanlon wrote on the N.F.L. version of the old saying that graveyards are full of indispensable men.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Irreplaceable for Giants? It Applies Only to Eli', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Manning, Eli', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-22T11:28:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Toni Monkovic', 'person': [{'firstname': 'Toni', 'middlename': None, 'lastname': 'Monkovic', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be0576e1-9d74-530e-b51d-591136624b98', 'word_count': 283, 'uri': 'nyt://article/be0576e1-9d74-530e-b51d-591136624b98'}, {'abstract': 'The striking detail of Bottega Veneta’s spring collection was a persistent hint of toughness — in spite of the feminine florals, soft knits and silvery fringe that spilled from the waists of cocktail dresses.', 'web_url': 'https://runway.blogs.nytimes.com/2012/09/22/dame-patrol-in-milan/', 'snippet': 'The striking detail of Bottega Veneta’s spring collection was a persistent hint of toughness — in spite of the feminine florals, soft knits and silvery fringe that spilled from the waists of cocktail dresses.', 'lead_paragraph': 'Tanked with caffeine from the espresso bar that Bottega Veneta sets up before its morning shows, I regarded the opening dress — a silk floral print with shoulder pads and a thin belt — and wondered if the designer, Tomas Maier, had been reading James M. Cain over the summer. The jazzy music kept this thought going through several tough little day dresses with a 1940s slant. The impression gradually dissolved as Mr. Maier shifted to almost naïve-looking blouses and skirts in white poplin, and then a sporty tank dress in black jersey spliced with black snakeskin.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dame Patrol in Milan', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Milan Fashion Week', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-22T11:34:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Cathy Horyn', 'person': [{'firstname': 'Cathy', 'middlename': None, 'lastname': 'Horyn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bb00ed53-4f8d-5345-801e-a34effbc891e', 'word_count': 210, 'uri': 'nyt://article/bb00ed53-4f8d-5345-801e-a34effbc891e'}, {'abstract': 'Kevin McClatchy, who owned the Pittsburgh Pirates, comes out and speaks out about the tightly shut closet door in the four major sports leagues.', 'web_url': 'https://www.nytimes.com/2012/09/23/opinion/sunday/bruni-a-new-inning-late-in-the-game.html', 'snippet': 'Kevin McClatchy, who owned the Pittsburgh Pirates, comes out and speaks out about the tightly shut closet door in the four major sports leagues.', 'lead_paragraph': 'LIGONIER, Pa.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/frank-bruni/frank-bruni-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A New Inning, Late in the Game', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'A New Inning, Late in the Game', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Pittsburgh Pirates', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McClatchy, Kevin S', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Athletics and Sports', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-22T11:43:48+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Frank Bruni', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/3ddc078d-b87e-5534-a6e4-c170bf98ee27', 'word_count': 1383, 'uri': 'nyt://article/3ddc078d-b87e-5534-a6e4-c170bf98ee27'}, {'abstract': 'The former owner of a major league baseball team talks about his closeted past and putting an end to it.', 'web_url': 'https://bruni.blogs.nytimes.com/2012/09/22/coming-out-in-the-world-of-sports/', 'snippet': 'The former owner of a major league baseball team talks about his closeted past and putting an end to it.', 'lead_paragraph': 'Kevin McClatchy, who spent 11 ½ years as the managing general partner and chief executive officer of the Pittsburgh Pirates, spoke extensively with me at his home in Ligonier, Penn., about why he hid being gay for so long and about the persistent secrecy in professional sports. Here, in addition to his comments in my Sunday column, are a few excerpts from our conversation.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Coming Out in the World of Sports', 'kicker': 'Frank Bruni', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McClatchy, Kevin', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Major League Baseball', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Pittsburgh (Pa)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-22T11:45:53+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Frank Bruni', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a5646961-d2d7-5345-be15-ad4d73d30276', 'word_count': 874, 'uri': 'nyt://article/a5646961-d2d7-5345-be15-ad4d73d30276'}, {'abstract': 'Gay and lesbian athletes have been a part of sports history.', 'web_url': 'https://bruni.blogs.nytimes.com/2012/09/22/a-timeline-of-incremental-progress/', 'snippet': 'Gay and lesbian athletes have been a part of sports history.', 'lead_paragraph': 'Big-time sports lag behind other areas of American society in terms of the number of gay and lesbian participants who feel they can be open about their sexual orientation. Not once, for example, has an active male player in any of the four major professional sports leagues in America publicly acknowledged being gay. But retired football, basketball and baseball players, along with active players in other sports, have come out. And there are plenty of lesbian athletes in women’s professional sports. Here are some milestones from the last four decades : ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Timeline of Incremental Progress', 'kicker': 'Frank Bruni', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Basketball', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-22T11:46:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Isabella Moschen', 'person': [{'firstname': 'Isabella', 'middlename': None, 'lastname': 'Moschen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dffd309e-089b-5b98-96e2-beeb457e0666', 'word_count': 1323, 'uri': 'nyt://article/dffd309e-089b-5b98-96e2-beeb457e0666'}, {'abstract': 'There are reasons for gay athletes’ hesitation about publicly identifying themselves.', 'web_url': 'https://bruni.blogs.nytimes.com/2012/09/22/the-barriers-to-openness/', 'snippet': 'There are reasons for gay athletes’ hesitation about publicly identifying themselves.', 'lead_paragraph': 'It’s a statistical impossibility that there aren’t at least a few gay men playing in one of the four major American sports leagues right now. It’s an equal impossibility that there haven’t been hundreds of them over time.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Barriers to Openness', 'kicker': 'Frank Bruni', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homosexuality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McClatchy, Kevin', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-22T11:48:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Frank Bruni', 'person': [{'firstname': 'Frank', 'middlename': None, 'lastname': 'Bruni', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/040ad941-a9bf-5462-9a21-fd07d87f77a4', 'word_count': 846, 'uri': 'nyt://article/040ad941-a9bf-5462-9a21-fd07d87f77a4'}, {'abstract': 'Teams in Major League Baseball and other sports leagues report the number of tickets sold, not the number of tickets used.', 'web_url': 'https://bats.blogs.nytimes.com/2012/09/22/the-official-attendance-can-become-empty-of-meaning/', 'snippet': 'Teams in Major League Baseball and other sports leagues report the number of tickets sold, not the number of tickets used.', 'lead_paragraph': 'The Mets announced that the attendance at their game Thursday night against the Phillies was 20,010. Even a casual glance at the game on television, though, suggested that there were no more than a few thousand fans at Citi Field. Were the Mets fibbing?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Official Attendance Can Become Empty of Meaning', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Citi Field (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-22T13:08:39+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ken Belson', 'person': [{'firstname': 'Ken', 'middlename': None, 'lastname': 'Belson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3803f13b-efba-5d0d-a97e-b9df3bcbbf6e', 'word_count': 369, 'uri': 'nyt://article/3803f13b-efba-5d0d-a97e-b9df3bcbbf6e'}, {'abstract': 'Although a German court has decided that a wanted Nazi death camp doctor died 20 years ago, other elderly war criminals from that era are still on the run and Nazi-hunters have not given up hope of bringing them to justice.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/09/22/time-running-short-for-the-nazi-hunters/', 'snippet': 'Although a German court has decided that a wanted Nazi death camp doctor died 20 years ago, other elderly war criminals from that era are still on the run and Nazi-hunters have not given up hope of bringing them to justice.', 'lead_paragraph': 'LONDON — The decision by a German court to close the file on a notorious Nazi fugitive known as Dr. Death is a reminder that time is running out to bring war criminals from World War II to justice.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/blogs/rdv-nazi/rdv-nazi-jumbo.jpg', 'height': 1024, 'width': 706, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/blogs/rdv-nazi/rdv-nazi-superJumbo.jpg', 'height': 1970, 'width': 1359, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/blogs/rdv-nazi/rdv-nazi-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/22/blogs/rdv-nazi/rdv-nazi-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/blogs/rdv-nazi/rdv-nazi-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Time Running Short for the Nazi Hunters', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Heim, Aribert Ferdinand', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Wiesenthal, Simon, Center'