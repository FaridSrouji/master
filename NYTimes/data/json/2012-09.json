'glocations', 'value': 'Italy', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-12T15:00:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Ricardo Bernard', 'person': [{'firstname': 'Ricardo', 'middlename': None, 'lastname': 'Bernard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eec88881-4baa-58a4-8e83-c3d559946d2a', 'word_count': 1010, 'uri': 'nyt://article/eec88881-4baa-58a4-8e83-c3d559946d2a'}, {'abstract': 'And what have you done to improve those rates?', 'web_url': 'https://boss.blogs.nytimes.com/2012/09/12/do-you-track-your-sites-conversion-rates/', 'snippet': 'And what have you done to improve those rates?', 'lead_paragraph': 'Last year, Dr. Stephen Bracci, owner of Verve Medical Cosmetics, realized that his Web site was doing a better job attracting visitors than it was converting those visitors into customers. As Katherine Reynolds Lewis explains in a small-business guide we’ve just published, there are a lot of things a business can do to improve its conversion rates.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Do You Track Your Site’s Conversion Rates?', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Entrepreneurship', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-12T15:03:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': "By You're the Boss Editors", 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'r