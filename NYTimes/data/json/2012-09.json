cks', 'content_kicker': None, 'print_headline': 'Savings Gauge For Retirement', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Pensions and Retirement Plans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Retirement', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Savings', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Fidelity Investments', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-12T16:33:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Your Money', 'byline': {'original': 'By Ann Carrns', 'person': [{'firstname': 'Ann', 'middlename': None, 'lastname': 'Carrns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d15333fe-e96a-57df-af29-0a05886472fc', 'word_count': 283, 'uri': 'nyt://article/d15333fe-e96a-57df-af29-0a05886472fc'}, {'abstract': 'The police are looking for a cyclist who they say incited a crowd to trash a car in NoHo on Thursday and a man who they say jumped on the car.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/09/12/suspects-sought-after-crowd-trashes-car-during-fashion-week/', 'snippet': 'The police are looking for a cyclist who they say incited a crowd to trash a car in NoHo on Thursday and a man who they say jumped on the car.', 'lead_paragraph': 'The police are looking for a cyclist who they say incited a crowd to trash a car in NoHo during Fashion Week last Thursday night and a young man who they say jumped on the car and broke several of its windows. The police released a photo and video of the suspects late Tuesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Suspects Sought After Crowd Trashes Car During Fashion Week', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub'