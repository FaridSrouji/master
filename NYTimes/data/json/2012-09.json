tname': 'Michael', 'middlename': None, 'lastname': 'Schwirtz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/39c4862c-4ce1-5523-a299-68d9c8e2448b', 'word_count': 289, 'uri': 'nyt://article/39c4862c-4ce1-5523-a299-68d9c8e2448b'}, {'abstract': 'Mexico City might be one of the world’s classic megacities, but it is also an archaeological wonder, with surprises still being uncovered in the city’s superimposed layers.', 'web_url': 'https://www.nytimes.com/2012/09/03/world/americas/mexico-citys-aztec-past-keeps-emerging-in-the-present.html', 'snippet': 'Mexico City might be one of the world’s classic megacities, but it is also an archaeological wonder, with surprises still being uncovered in the city’s superimposed layers.', 'lead_paragraph': 'MEXICO CITY — The skeleton is that of a young woman, perhaps an Aztec noble, found intact and buried in the empire’s most sacred spot more than 500 years ago. Almost 2,000 human bones were heaped around her, and she is a mystery.', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/world/sub-mexico1/sub-mexico1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/03/world/sub-mexico1/sub-mexico1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/world/sub-mexico1/sub-mexico1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/world/sub-mexico1/sub-mexico1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo