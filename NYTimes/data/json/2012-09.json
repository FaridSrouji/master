ank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6b56e9a8-c66b-5ea7-8393-42fdbcc95553', 'word_count': 1266, 'uri': 'nyt://article/6b56e9a8-c66b-5ea7-8393-42fdbcc95553'}, {'abstract': 'Politically, it is not certain that the report is going to matter that much. The unemployment rate declined for superficial reasons, which makes for a gentler headline for President Obama.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2012/09/07/effect-of-jobs-numbers-on-presidential-race-is-uncertain/', 'snippet': 'Politically, it is not certain that the report is going to matter that much. The unemployment rate declined for superficial reasons, which makes for a gentler headline for President Obama.', 'lead_paragraph': 'Friday’s jobs report was a weak one — with August’s job growth more in line with the tepid\xa0growth of the spring than the stronger numbers in July or over the winter months.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Effect of Jobs Numbers on Presidential Race Is Uncertain', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-07T16:21:47+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nate Silver', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Silver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35f4f783-327f-5718-ba25-edd89c0b8b68', 'word_count': 475, 'uri': 'nyt://article/35f4f783-327f-5718-ba25-edd89c0b8b68'}, {'abstract': 'In these stories, women are subject to appraisal by men, and one another.', 'web_url': 'https://www.nytimes.com/2012/09/09/books/review/shout-her-lovely-name-by-natalie-serber.html', 'snippet': 'In these stories, women are subject to appraisal by men, and one another.', 'lead_paragraph': 'When 14-year-old Nora gets a pair of diamond earrings in the mail from the father she’s never met, her mother, Ruby, looks at them and dryly remarks, “They’re the size of birth control pills.”', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/books/review/09ROMM/09ROMM-jumbo.jpg', 'height': 1024, 'width': 692, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/books/review/09ROMM/09ROMM-superJumbo.jpg', 'height': 2048, 'width': 1384, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/books/review/09ROMM/09ROMM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/books/review/09ROMM/09ROMM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/books/review/09ROMM/09ROMM-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Side Effects', 'kicker': None, 'content_kicker': None, 'print_headline': 'Side Effects', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Serber, Natalie', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-07T16:22:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Robin Romm', 'person': [{'firstname': 'Robin', 'middlename': None, 'lastname': 'Romm', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9e763d77-be37-5e5b-9ea1-7269b1ca23e5', 'word_count': 819, 'uri': 'nyt://article/9e763d77-be37-5e5b-9ea1-7269b1ca23e5'}, {'abstract': 'His family life a shambles, Jonathan Evison’s floundering hero looks elsewhere for a sense of purpose.', 'web_url': 'https://www.nytimes.com/2012/09/09/books/review/the-revised-fundamentals-of-caregiving-by-jonathan-evison.html', 'snippet': 'His family life a shambles, Jonathan Evison’s floundering hero looks elsewhere for a sense of purpose.', 'lead_paragraph': '“Failure makes me hungry,” Ben Benjamin says in “The Revised Fundamentals of Caregiving,” Jonathan Evison’s third novel. Ben responds to defeat with a Mr. Goodbar and a bag of chips, which is just part of what makes his funny and relatable voice the linchpin of this engaging book. ', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/books/review/0909-Gilmore/0909-Gilmore-jumbo.jpg', 'height': 1024, 'width': 802, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/books/review/0909-Gilmore/0909-Gilmore-superJumbo.jpg', 'height': 2048, 'width': 1605, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/books/review/0909-Gilmore/0909-Gilmore-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/