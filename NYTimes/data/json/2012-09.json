 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Student Loans', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Education Department (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-29T02:33:34+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Education', 'byline': {'original': 'By Tamar Lewin', 'person': [{'firstname': 'Tamar', 'middlename': None, 'lastname': 'Lewin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ffd1b8e-57fd-5352-ac68-a55a14dcec35', 'word_count': 554, 'uri': 'nyt://article/0ffd1b8e-57fd-5352-ac68-a55a14dcec35'}, {'abstract': 'A federal judge has ruled that the United States wrongly imprisoned an American under a law designed to keep trial witnesses from fleeing and that his case should go to trial.', 'web_url': 'https://www.nytimes.com/2012/09/29/us/abdullah-al-kidd-held-after-9-11-wins-right-to-be-tried.html', 'snippet': 'A federal judge has ruled that the United States wrongly imprisoned an American under a law designed to keep trial witnesses from fleeing and that his case should go to trial.', 'lead_paragraph': 'A federal judge in Idaho has ruled that the United States, after the Sept. 11 terrorist attacks, wrongly imprisoned an American under a law designed to keep trial witnesses from fleeing and that since there was evidence that the government may have willfully misused the law against him, his case should go to trial.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/29/us/KIDD-1/KIDD-1-jumbo.jpg', 'height': 1024, 'width': 710, 'subType': 'jumbo