tion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lewis, Salim B (Sandy)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-15T04:37:25+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael Powell and Danny Hakim', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Powell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Danny', 'middlename': None, 'lastname': 'Hakim', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b8095ef2-b221-5e06-9cf5-17102733e134', 'word_count': 2613, 'uri': 'nyt://article/b8095ef2-b221-5e06-9cf5-17102733e134'}, {'abstract': 'Many unpaid jobs in the fashion and magazine industries perpetuate inequality and may violate labor laws.', 'web_url': 'https://www.nytimes.com/2012/09/16/nyregion/seeking-chic-edgy-brilliant-intern-to-thread-needles-free.html', 'snippet': 'Many unpaid jobs in the fashion and magazine industries perpetuate inequality and may violate labor laws.', 'lead_paragraph': 'In February, Xuedan Wang, a 2010 graduate of Ohio University, received modest attention after she filed a lawsuit against the Hearst Corporation claiming that the company violated labor laws when it did not pay her for the work she had done as an intern at Harper’s Bazaar, one of its magazines, over four months last year. Speaking to New York magazine last week, on the occasion of Fashion Week, Ms. Wang, who goes by Diana, explained that she had spent more than half of her life dreaming of Bazaar and approximately 12 months working at a pharmaceutical company in Columbus in order to save enough money to realize her Manhattan vision.', 'print_section': 'MB', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/nyregion/16BIGCITY2_SPAN/16BIGCITY2_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/16/nyregion/16BIGCITY2_SPAN/16BIGCITY2_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/nyregion/16BIGCITY2_SPAN/16SUBJPBIGCITY2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/nyregion/16BIGCITY2_SPAN/16SUBJPBIGCITY2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/nyregion/16BIGCITY2_SPAN/16BIGCITY2_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/16/nyregion/16BIGCITY2_SPAN/16BIGCITY2_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/nyregion/16BIGCITY2_SPAN/16BIGCITY2_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seeking Chic, Brilliant Intern to Thread Needles (No Pay)', 'kicker': 'Big City', 'content_kicker': None, 'print_headline': 'Seeking Brilliant Intern To Thread Needles, Free', 'name': None, 'seo': None, 'sub': 