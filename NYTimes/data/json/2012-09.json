 Regulation', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Accidents and Safety', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fukushima Daiichi Nuclear Power Plant (Japan)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Japan Earthquake and Tsunami (2011)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Energy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Radiation', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Jaczko, Gregory B', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Macfarlane, Allison M', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'McGartland, Al', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Nuclear Regulatory Commission', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 11, 'major': 'N'}], 'pub_date': '2012-09-11T18:51:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Matthew L. Wald', 'person': [{'firstname': 'Matthew', 'middlename': 'L.', 'lastname': 'Wald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76746f91-8f48-532b-b798-e138b8d32a47', 'word_count': 577, 'uri': 'nyt://article/76746f91-8f48-532b-b798-e138b8d32a47'}, {'abstract': 'New York', 'web_url': 'https://www.nytimes.com/slideshow/2012/09/11/fashion/runway-womens/badgley-mischka-spring-2013-rtw.html', 'snippet': 'New York', 'lead_paragraph': 'New York', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/11/fashion/runway-womens/bmischka_spring13app-slide-N0J4/bmisc