'}, {'name': 'persons', 'value': 'Chavez, Hugo', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Venezuela', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-13T11:06:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Francisco Toro', 'person': [{'firstname': 'Francisco', 'middlename': None, 'lastname': 'Toro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/443eafc5-56ce-58e5-8766-82176c3d38df', 'word_count': 585, 'uri': 'nyt://article/443eafc5-56ce-58e5-8766-82176c3d38df'}, {'abstract': 'Photos can fill the screen with the press of a key or two.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2012/09/13/tip-of-the-week-photos-in-full-screen-view/', 'snippet': 'Photos can fill the screen with the press of a key or two.', 'lead_paragraph': 'The ability to see photos in full-screen mode on the computer cuts down background distraction from icons cluttering the desktop. In Windows, when you open a photo in Windows Explorer, press the F11 key on the keyboard to expand the picture to the full screen. If it does not work, the manufacturer may have modified the keyboard function; try pressing the Function key and F11 or check the computer’s manual.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tip of the Week: Photos in Full Screen View', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Desktop Computers', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-13T11:20:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By J.d. Biersdorfer', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', '