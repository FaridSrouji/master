me': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-21T23:43:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Eric Wilson', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ac11ab9e-2fd2-57e7-872a-43b2d2fc7887', 'word_count': 712, 'uri': 'nyt://article/ac11ab9e-2fd2-57e7-872a-43b2d2fc7887'}, {'abstract': 'Formula One drivers arrived in Singapore to take part in the series’ only night race, and it felt during the press meetings as if the night-hours had made some of them drop their usual barriers to expressing their skepticism toward the media.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/09/21/f1-drivers-interrogate-the-press/', 'snippet': 'Formula One drivers arrived in Singapore to take part in the series’ only night race, and it felt during the press meetings as if the night-hours had made some of them drop their usual barriers to expressing their skepticism toward the media.', 'lead_paragraph': 'SINGAPORE — Formula One has arrived in Singapore for its only night race of the year, and that means the whole paddock is kind of out-of-step. Most of the Formula One drivers, team personnel and reporters are living on European time as just about all the track action takes place on European time, although it’s six hours later in Singapore — that is in the dark. The result of this strange time lag is that there is something of a mood change amongst the denizens of F1.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/blogs/21formulaone-button/21formulaone-button-jumbo.jpg', 'height': 329, 'width': 512, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo',