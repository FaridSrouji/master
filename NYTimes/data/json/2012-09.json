_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Kendrick, Phillies Handyman, Sparks Playoff Push as Starter', 'kicker': 'Bats', 'content_kicker': None, 'print_headline': 'Extra Bases: Appreciate, Don’t Imitate, A Young Veteran Learns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Phillies', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-15T16:48:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tyler Kepner', 'person': [{'firstname': 'Tyler', 'middlename': None, 'lastname': 'Kepner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80eb5325-da9b-5ca9-9624-69c549c397a5', 'word_count': 749, 'uri': 'nyt://article/80eb5325-da9b-5ca9-9624-69c549c397a5'}, {'abstract': 'The chief of DJO Global, a medical device company, says that throughout his career, he’s often found situations that need fixing, and raised his hand to solve them.', 'web_url': 'https://www.nytimes.com/2012/09/16/jobs/michael-mogul-of-djo-global-on-pursuing-responsibilities-the-boss.html', 'snippet': 'The chief of DJO Global, a medical device company, says that throughout his career, he’s often found situations that need fixing, and raised his hand to solve them.', 'lead_paragraph': 'WHEN I was in seventh grade, my father sold his word processing company in Washington, D.C. My parents always wanted to live on a boat in retirement, and I was the last child at home, so it was feasible. ', 'print_section': 'BU', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/business/16-BOSS/16-BOSS-jumbo.jpg', 'height': 1024, 'width': 790, 'su