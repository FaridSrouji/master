rce': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Business Day Live: A Manufacturing About-Face', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-21T17:14:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6a21bd5b-9853-5b95-8f5e-ea31ee895afb', 'word_count': 16, 'uri': 'nyt://article/6a21bd5b-9853-5b95-8f5e-ea31ee895afb'}, {'abstract': 'Culture is energizing this border town, known for its seedy side. “I think people are starting to believe in art. I think people are starting to believe in Tijuana,” says a gallerist.', 'web_url': 'https://www.nytimes.com/2012/09/23/travel/tijuana-rebuilds-on-its-art.html', 'snippet': 'Culture is energizing this border town, known for its seedy side. “I think people are starting to believe in art. I think people are starting to believe in Tijuana,” says a gallerist.', 'lead_paragraph': 'ANY city whose most widely known symbol is a painted donkey is used to being the butt of jokes. But Tijuana, often derided as a lowbrow center of debauchery and more recently as a hub of drug-related violence, is transforming itself through something that has quietly always been a strong suit: culture. ', 'print_section': 'TR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/travel/23HEADSUP_SPAN/23HEADSUP_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/23/travel/23HEADSUP_SPAN/23HEADSUP_SPAN-articleLarge.jpg', 'xlargewid