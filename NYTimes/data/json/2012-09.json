: [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/blogs/ihtrdv-wine-mouton-rothschild/ihtrdv-wine-mouton-rothschild-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/blogs/ihtrdv-wine-mouton-rothschild/ihtrdv-wine-mouton-rothschild-superJumbo.jpg', 'height': 1369, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A Wine’s Home Is Its Castle', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Wines', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Bordeaux (France)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-26T16:47:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Eric Pfanner', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Pfanner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f381b7fd-d424-5a98-9cc5-c2190c357676', 'word_count': 675, 'uri': 'nyt://article/f381b7fd-d424-5a98-9cc5-c2190c357676'}, {'abstract': 'Among the readings at a synagogue that has attracted both gays and straights, Jews and Christians, was a poem by Yevgeny Yevtushenko.', 'web_url': 'https://www.nytimes.com/2012/09/26/booming/26yomkippur-booming.html', 'snippet': 'Among the readings at a synagogue that has attracted both gays and straights, Jews and Christians, was a poem by Yevgeny Yevtushenko.', 'lead_paragraph': 'So much has happened in our lifetimes that seemed impossible not so long ago, beside our own aging. Who could have guessed 40 years ago, when a band of gay Jewish men came together in Greenwich Village to worship because they were welcome nowhere else, that today gay marriage would be legal in this state and others? Who could have guessed 20 years later, after AIDS had killed a generation of gay men, faster than they could be properly mourned, that Congregation Beit Simchat Torah would be a “real’’ synagogue, with a lesbian rabbi? Who could have guessed that before long\xa0Beit Simchat Torah would be a magnet for both gays and straights, Jews and Christians, especially on the High Holy Days — Rosh Hashanah and Yom Kippur — when most synagogues are open only to members with tickets? And that their open-door policy would draw crowds so large it meant using New York City’s historic Town Hall for the first holiday and the cavernous Jacob Javits Convention Center for the second? Attending on the first night of Rosh Hashanah, and welcomed as a “practicing heterosexual,’’ I noted that the audience had at least two things in common: A belief that religion could and should be an open tent. And enough years on this earth to know that there is a time to sow and a time to reap, and that the second required both grace and courage. Among the readings was the poem “Autumn” by Yevgeny Yevtushenko.\xa0 Here are the first three stanzas, in slightly different translation. A complete version of the poem, in yet another translation, can be found here if you scroll to the bottom.\xa0', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/booming/26yomkippur-booming/26yomkippur-booming-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/26/booming/26yomkippur-booming/26yomkippur-booming-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/booming/26yomkippur-booming/26yomkippur-booming-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/booming/26yomkippur-booming/26yomkippur-booming-superJumbo.jpg', 'height': 1370, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/booming/26yomkippur-booming/26yomkippur-booming-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/26/booming/26yomkippur-booming/26yomkippur-booming-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/booming/26yomkippur-booming/26yomkippur-booming-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Opening the Religious Tent to All', 'kicker': 'Excerpted', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baby Boomers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Yom Kippur', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-26T16:50:19+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Booming', 'byline': {'original': 'By Jane Gross', 'person': [{'firstname': 'Jane', 'middlename': None, 'lastname': 'Gross', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://articl