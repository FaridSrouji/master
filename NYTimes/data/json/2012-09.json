}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ecbf04e-feba-57de-aaee-a4051567826d', 'word_count': 20, 'uri': 'nyt://article/0ecbf04e-feba-57de-aaee-a4051567826d'}, {'abstract': 'The evening will kick off the company’s five-week season at New York City Center.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/05/monique-to-chair-ailey-gala-and-an-appointment-for-robert-la-fosse/', 'snippet': 'The evening will kick off the company’s five-week season at New York City Center.', 'lead_paragraph': 'The actress and comedian Mo’Nique will serve as the honorary chairwoman of Alvin Ailey American Dance Theater’s gala benefit performance on Nov. 28. The evening will kick off the company’s five-week season at City Center and will also feature Ailey’s signature 1960 work “Revelations,” with special guest musicians. Featured vocalists will include the Tony Award-winning actors and singers Audra McDonald, Brian Stokes Mitchell and Anika Noni Rose. Ticket and additional information is available at www.alvinailey.org.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mo’Nique  Lends Support to  Ailey Gala', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'la Fosse, Robert', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'ABRONS ARTS CENTER', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AILEY, ALVIN, AMERICAN DANCE THEATER', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York City Center Theater', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-05T17:00:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Julie Bloom', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bloom', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material':