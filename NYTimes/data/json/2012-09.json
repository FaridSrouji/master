ph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New York Top 5 | American Sexy and the New Surf', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-14T15:24:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Bruce Pask and Jason Rider', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Pask', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jason', 'middlename': None, 'lastname': 'Rider', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a8a8413c-aeee-5665-8a51-7a9c2c5c3f1b', 'word_count': 514, 'uri': 'nyt://article/a8a8413c-aeee-5665-8a51-7a9c2c5c3f1b'}, {'abstract': 'His parents never went to school on Rosh Hashana while living under their parents’ roofs. But their son, a man according to Jewish law, is determined to go on the High Holy Days.', 'web_url': 'https://parenting.blogs.nytimes.com/2012/09/14/going-to-school-on-rosh-hashana/', 'snippet': 'His parents never went to school on Rosh Hashana while living under their parents’ roofs. But their son, a man according to Jewish law, is determined to go on the High Holy Days.', 'lead_paragraph': 'This year my 15-year old son and I are having yet another conversation about Judaism’s High Holy Days. He’s intent on capitalizing on his hard-won victory last year, the outcome of which was that he went to school on the second day of Rosh Hashana. This was no small concession for his parents. His father and I had never attended school on the High Holy Days while living under our parents’ roofs. But neither of us went to a high school as academically challenging as our son’s. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Going to School on Rosh Hashana', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jews and Judaism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Rosh Hashanah', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Teenagers and Adolescence', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-14T15:24:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Judy Bolton-Fasman', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Bolton-Fasman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c2ae5cbd-3904-547b-8562-e08a4ef7e921', 'word_count': 825, 'uri': 'nyt://article/c2ae5cbd-3904-547b-8562-e08a4ef7e921'}, {'abstract': 'Kelly Blair on the representation of women in the publishing world.', 'web_url': 'https://www.nytimes.com/2012/09/16/books/review/up-front.html', 'snippet': 'Kelly Blair on the representation of women in the publishing world.', 'lead_paragraph': 'Since this week’s issue assesses an array of feminist ideas and arguments, it made particular sense to commission illustrations from a woman, in this case Kelly Blair, who created the cover image and the three other illustrations that accompany our lead essays (by Toni Bentley and Jennifer Homans).', 'print_section': 'BR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/books/review/0916-bks-upfront/0916-bks-upfront-jumbo.jpg',