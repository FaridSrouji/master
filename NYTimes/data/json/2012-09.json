gy/bits-samsungad/bits-samsungad-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/19/technology/bits-samsungad/bits-samsungad-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/19/technology/bits-samsungad/bits-samsungad-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Samsung Takes More Swipes at Apple in Latest Ad', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'iPhone', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Samsung Group', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-19T19:42:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nick Bilton', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Bilton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f9f7b11-22d5-5f7e-9d84-cbd7722b3d95', 'word_count': 190, 'uri': 'nyt://article/4f9f7b11-22d5-5f7e-9d84-cbd7722b3d95'}, {'abstract': 'Two of the season’s most enticing cookbooks come from a pair of unknown grandmothers, legends only within their immigrant families for simple, soulful recipes that taste of home.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/09/19/gran-cuisine/', 'snippet': 'Two of the season’s most enticing cookbooks come from a pair of unknown grandmothers, legends only within their immigrant families for simple, soulful recipes that taste of home.', 'lead_paragraph': 'Two of the season’s most enticing cookbooks come from a pair of unknown grandmothers, legends only within their immigrant families for simple, soulful recipes that taste of home. Salma Hage moved with her family from Northern Lebanon to London in 1967, and “The Lebanese Kitchen” (Phaidon, $50) catalogs all the aromatic dishes she took with her, including eight types of hummus and a wintry twist on tabbouleh with fennel, walnuts and pomegranate syrup. And in “My Abuela’s Table” (Hardie Grant, $30), Daniella Germain sweetly illustrates her Mexican grandmother’s greatest hits, which she’d swoon for as a tot in her native Australia. Germain even draws a step-by-step guide for making picadas — breakfast tortillas topped with chile sauce, onion and cheese — “just the way my abuelo liked it.” Below, a recipe from each book.', 'print_section': 'M2', 'print_page': '40', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gran Cuisine', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': 'Gran Cuisine', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-19T19:45:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Stephen Heyman', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Heyman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b28f3ded-23a1-5b8e-9dc1-dafafc7f2410', 'word_count': 435, 'uri': 'nyt://article/b28f3ded-23a1-5b8e-9dc1-dafafc7f2410'}, {'abstract': 'The European Commission said it would end an e-book pricing investigation of Apple and four e-book publishers if they temporarily allowed online retailers to sell at a discount.', 'web_url': 'https://www.nytimes.com/2012/09/20/business/global/agreement-could-end-europes-e-book-price-fixing-inquiry.html', 'snippet': 'The European Commission said it would end an e-book pricing investigation of Apple and four e-book publishers if they temporarily allowed online retailers to sell at a discount.', 'lead_paragraph': 'BERLIN — The European Commission said Wednesday that it was prepared to drop its investigation into the fixing of e-book prices by Apple and four European publishers after the companies agreed to let online retailers like Amazon sell e-books at a discount for two years.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tentative Deal on E-Book Prices Is Reached in Europe', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tentative Deal on E-Book Prices Is Reached in Europe', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'E-Books and Readers', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'European Commission', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'E-Commerce', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Antitrust Laws and Competition Issues', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-19T19:56:27+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'original': "By Kevin J. O'Brien", 'person': [{'firstname': 'Kevin', 'middlename': 'J.', 'lastname': "O'Brien", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/67285642-be19-5b74-ae95-a25770536a08', 'word_count': 633, 'uri': 'nyt://article/67285642-be19-5b74-ae95-a25770536a08'}, {'abstract': 'With security breaches on the rise, companies are beginning t