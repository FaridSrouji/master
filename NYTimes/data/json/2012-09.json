document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24235479-4b51-5ed6-9904-7a4e3af0ba65', 'word_count': 666, 'uri': 'nyt://article/24235479-4b51-5ed6-9904-7a4e3af0ba65'}, {'abstract': 'An Occupy Wall Street protester is expecting a baby with a man who helped her after she was pepper-sprayed by a police inspector.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/09/24/year-after-pepper-spraying-awaiting-a-new-cry-a-newborns/', 'snippet': 'An Occupy Wall Street protester is expecting a baby with a man who helped her after she was pepper-sprayed by a police inspector.', 'lead_paragraph': 'Buried in the news release on Monday morning that yet another Occupy Wall Street protester is suing the Police Department’s pepper-spraying deputy inspector, Anthony Bologna, was this heartwarming tidbit: Kaylee Dedrick, Inspector Bologna’s co-star in a viral video in which he wields his lachrymatory canister, is about to have a baby with the fellow protester who came to her aid.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/nyregion/24spray-cityroom/24spray-cityroom-jumbo.jpg', 'height': 174, 'width': 109, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/nyregion/24spray-cityroom/24spray-cityroom-superJumbo.jpg', 'height': 174, 'width': 109, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/nyregion/24spray-cityroom/24spray-