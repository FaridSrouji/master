, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ALITO, SAMUEL A JR', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Powell, Lewis F Jr', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-20T18:05:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Lincoln Caplan', 'person': [{'firstname': 'Lincoln', 'middlename': None, 'lastname': 'Caplan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7e0ae946-9b16-5035-a810-ed6663ef6a00', 'word_count': 333, 'uri': 'nyt://article/7e0ae946-9b16-5035-a810-ed6663ef6a00'}, {'abstract': 'Low interest rates have led many corporations to load up on debt, but this could lead to a flood of bankruptcies once maturities hit.', 'web_url': 'https://dealbook.nytimes.com/2012/09/20/cheap-loans-could-spell-long-term-headaches/', 'snippet': 'Low interest rates have led many corporations to load up on debt, but this could lead to a flood of bankruptcies once maturities hit.', 'lead_paragraph': 'The debt issued today is the stuff of tomorrow’s bankruptcy cases. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Cheap Loans Could Spell Long-Term Headaches', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bankruptcies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-20T18:07:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Stephen J. Lubben', 'person': [{'firstname': 'Stephen', 'middlename': 'J.', 'lastname': 'Lubben', 'qualifier': None, 'ti