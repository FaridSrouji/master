he New York Times', 'multimedia': [], 'headline': {'main': 'Taylor Swift’s Record Label Continues Its Online-Offline Royalties Experiment', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Moonves, Leslie', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Swift, Taylor', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Clear Channel Communications Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Entercom', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-20T17:59:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Ben Sisario', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Sisario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e07738a6-7b60-562c-bb6f-83903e215e85', 'word_count': 623, 'uri': 'nyt://article/e07738a6-7b60-562c-bb6f-83903e215e85'}, {'abstract': 'The film critic is being recognized for his advocacy of independent cinema.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/20/sundance-institute-to-honor-ebert/', 'snippet': 'The film critic is being recognized for his advocacy of independent cinema.', 'lead_paragraph': 'The Sundance Institute said on Thursday that it would award the film critic Roger Ebert with its second Vanguard Leadership award, in recognition of his advocacy of independent cinema. The award is the centerpiece of the institute’s next Celebrate Sundance benefit, to be held in Los Angeles in June.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sundance Institute to Honor Ebert', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Sundance Institute To Honor Ebert', 'name': None, 'seo': None,