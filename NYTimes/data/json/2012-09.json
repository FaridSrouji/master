_count': 219, 'uri': 'nyt://article/4e7a57a7-b9c7-50a7-9a22-dea715008f16'}, {'abstract': 'A vast, two-floor show of more than 500 images at the International Center of Photography examines South Africa before and after its years of segregation.', 'web_url': 'https://www.nytimes.com/2012/09/21/arts/design/rise-and-fall-of-apartheid-at-center-of-photography.html', 'snippet': 'A vast, two-floor show of more than 500 images at the International Center of Photography examines South Africa before and after its years of segregation.', 'lead_paragraph': 'Photography is the common language of modern history. It’s everywhere; and everyone, in some way, understands it.', 'print_section': 'C', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/design/21APARTHEID_SPAN/0921APARTHEID_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/21/arts/design/21APARTHEID_SPAN/0921APARTHEID_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/design/21APARTHEID_SPAN/0921APARTHEID_SPAN-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/design/21APARTHEID_SPAN/0921APARTHEID_SPAN-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/design/21APARTHEID_SPAN/0921APARTHEID_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/arts/design/21APARTHEID_SPAN/0921APARTHEID_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/design/21APARTHEID_SPAN/0921APARTHEID_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Images That Preserve History, and Make It', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Images That Preserve History, and Make It', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'South Africa', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Apartheid (Policy)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'International Center of Photography', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-20T21:41:12+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0ac3e2b6-f7ae-585f-b84a-5a4bf3432cd7', 'word_count': 1377, 'uri': 'nyt://article/0ac3e2b6-f7ae-585f-b84a-5a4bf3432cd7'}, {'abstract': 'Julianne Moore, Michael C. Hall, Elaine Stritch, Daniel Gilbert and more discuss what constitutes happiness in a series at the Rubin Museum.', 'web_url': 'https://www.nytimes.com/2012/09/21/arts/design/rubin-museums-happy-talk-pairs-entertainers-and-scholars.html', 'snippet': 'Julianne Moore, Michael C. Hall, Elaine Stritch, Daniel Gilbert and more discuss what constitutes happiness in a series at the Rubin Museum.', 'lead_paragraph': 'TIM McHenry concedes that many people don’t know how to approach the Himalayan art that makes up the collection of the Rubin Museum in Chelsea, where he is the director of public programs. But most people — particularly anxious New York types — probably have spent some time pondering a more existential question, which he puts bluntly: “What the hell is happiness, anyway?”', 'print_section': 'C', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HAPPY1/21HAPPY1-jumbo.jpg', 'height': 1024, 'width': 880, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HAPPY1/21HAPPY1-superJumbo.jpg', 'height': 1376, 'width': 1183, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Don’t Know if You’re Happy? Nobody Does', 'kicker': None, 'content_kicker': None, 'print_headline': 'Don’t Know if You’re Happy? Nobody Does', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Rubin Museum of Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Psychology and Psychologists', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Happiness', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-20T21:41:15+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Kate Zernike', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Zernike', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/478d60f4-6f0b-5888-b898-79b1fce65991', 'word_count': 620, 'uri': 'nyt://article/478d60f4-6f0b-5888-b898-79b1fce65991'}, {'abstract': 'Officials at the Democratic group Priorities USA Action said it raised a record $10 million for the month, above the $7 million raised by Restore Our Future, a Republican group.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/09/20/democratic-super-pac-raised-more-than-republican-counterpart-in-august/', 'snippet': 'Officials at the Democratic group Priorities USA Action said it raised a record $10 million for the month, above the $7 million raised by Restore Our Future, a Republican group.', 'lead_paragraph': '6:36 p.m. | Updated A leading “super PAC” backing Mitt Romney raised less than its Democratic counterpart in August, a rare head-to-head victory for Democrats in an area overwhelmingly dominated by Republican groups and donors.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Democratic ‘Super PAC’ Outraised Republican Counterpart in August', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Political Action Committees', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Rove, Karl', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Election Commission', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Priorities USA', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Restore Our Future', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-09-20T21:42:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nicholas Confessore', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Confessore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f273a2b-ba0a-568e-a102-0ccbecc27d94', 'word_count': 311, 'uri': 'nyt://article/3f273a2b-ba0a-568e-a102-0ccbecc27d94'}, {'abstract': 'Photos from Afghanistan, Pakistan, Yemen and Bangladesh.', 'web_url': 'https://lens.blogs.nytimes.com/2012/09/20/pictures-of-the-day-afghanistan-and-more/', 'snippet': 'Photos from Afghanistan, Pakistan, Yemen and Bangladesh.', 'lead_paragraph': 'Photos from Afghanistan, Pakistan, Yemen and Bangladesh.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Pictures of the Day: Afghanistan and More', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-20T21:43:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/5c618696-be69-554a-9dca-86299b915c42', 'word_count': 12, 'uri': 'nyt://article/5c618696-be69-554a-9dca-86299b915c42'}, {'abstract': 'A new report from the Highway Loss Data Institute argues that collision-claims information can give a sense of the average expense of repairing a vehicle as well as how a repair can affect premiums.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/09/20/from-the-insurance-industry-a-seldom-used-barometer-of-vehicle-cost/', 'snippet': 'A new report from the Highway Loss Data Institute argues that collision-claims information can give a sense of the average expense of repairing a vehicle as well as how a repair can affect premiums.', 'lead_paragraph': 'A study released on Thursday confirms a truism in the insurance trade: If you crash a small car, it will be bad for your health; if you crash an expensive car, it will be bad for your bank account.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From the Insurance Industry, a Seldom-Used Barometer of Vehicle Cost', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Insurance and Liability', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Traffic Accidents and Safety', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Insurance Institute for Highway Safety', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Highway Traffic Safety Administration', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-20T21:44:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Cheryl Jensen', 'person': [{'firstname': 'Cheryl', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45746c62-0f5c-5837-88db-5670b5c3db0f', 'word_count': 713, 'uri': 'nyt://article/45746c62-0f5c-5837-88db-5670b5c3db0f'}, {'abstract': 'The documentary “Blinky & Me” chronicles the life of Yoram Gross, Holocaust survivor turned animator and producer.', 'web_url': 'https://www.nytimes.com/2012/09/21/movies/yoram-gross-in-blinky-me-by-tomasz-magierski.html', 'snippet': 'The documentary “Blinky & Me” chronicles the life of Yoram Gross, Holocaust survivor turned animator and producer.', 'lead_paragraph': 'The connection between an adventurous cartoon koala named Blinky Bill and the Holocaust is hard to fathom at first, but it lies with the animator and producer Yoram Gross, who was born in Krakow. The subject of Tomasz Magierski’s middling documentary, Mr. Gross survived the Nazis and lived to tell the tale, and many more through animation, in his adopted country, Australia.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21RDP_BLINKY_SPAN/21RDP_BLINKY_SPAN-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/21/arts/21RDP_BLINKY_SPAN/21RDP_BLINKY_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21RDP_BLINKY_SPAN/FILMROUNDUP2-jumbo.jpg', 'height': 699, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21RDP_BLINKY_SPAN/FILMROUNDUP2-superJumbo.jpg', 'height': 1397, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21RDP_BLINKY_SPAN/21RDP_BLINKY_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/arts/21RDP_BLINKY_SPAN/21RDP_BLINKY_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21RDP_BLINKY_SPAN/21RDP_BLINKY_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Cute Koala Meets the Holocaust', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Blinky & Me', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Magierski, Tomasz', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-20T21:46:12+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Nicolas Rapold', 'person': [{'firstname': 'Nicolas', 'middlename': None, 'lastname': 'Rapold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3f38abfe-8a3f-5b0e-8d8b-0e79a7849829', 'word_count': 213, 'uri': 'nyt://article/3f38abfe-8a3f-5b0e-8d8b-0e79a7849829'}, {'abstract': 'Christine Baranski on being powerful, Jesse Tyler Ferguson on being the straight man (in the comic sense), and Abi Morgan on learning she was nominated.', 'web_url': 'https://www.nytimes.com/2012/09/21/arts/television/emmy-nominees-baranski-abi-morgan-and-jesse-tyler-ferguson.html', 'snippet': 'Christine Baranski on being powerful, Jesse Tyler Ferguson on being the straight man (in the comic sense), and Abi Morgan on learning she was nominated.', 'lead_paragraph': 'This month on the ArtsBeat blog we’ve been talking to Emmy nominees about their work (one actor chose the role least likely to be cut from the show) and their reaction to the Emmy hoopla — or lack thereof in the case of a writer who didn’t know what she was nominated for. Here are excerpts from those conversations, which appear at artsbeat.blogs.nytimes.com.', 'print_section': 'C', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Road to Nomination Paved With Lots of Caffeine', 'kicker': None, 'content_kicker': None, 'print_headline': 'Road to Nomination Paved With Lots of Caffeine', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Emmy Awards', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Baranski, Christine', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ferguson, Jesse Tyler', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Morgan, Abi', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-20T21:47:25+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck and Jeremy Egner', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jeremy', 'middlename': None, 'lastname': 'Egner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/bd32fbd5-a3bc-5482-9057-39fa34267cd0', 'word_count': 782, 'uri': 'nyt://article/bd32fbd5-a3bc-5482-9057-39fa34267cd0'}, {'abstract': 'In the last year, the Italian-English outerwear label Belstaff has gone from zero to 60 in what could be a record pace.', 'web_url': 'https://runway.blogs.nytimes.com/2012/09/20/a-brand-revival-on-the-fast-track/', 'snippet': 'In the last year, the Italian-English outerwear label Belstaff has gone from zero to 60 in what could be a record pace.', 'lead_paragraph': 'A year ago, if you were familiar with the Italian-English outerwear label Belstaff, it was probably because you followed the credits of Hollywood movies very closely or were an extreme motorcycle enthusiast. Those leather jackets worn by Tom Cruise in “Mission Impossible” and Steve McQueen in his down time were Belstaff, as were the jackets in several dozen films.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Brand Revival on the Fast Track', 'kicker': 'On the Runway', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Milan Fashion Week', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, Martin (1965- )', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-20T21:53:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Eric Wilson', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fb8de489-439b-5282-b5f2-b8301b606089', 'word_count': 405, 'uri': 'nyt://article/fb8de489-439b-5282-b5f2-b8301b606089'}, {'abstract': 'The drop to 9.9 percent in August from 10 percent in June and July was accompanied by positive news about employment losses that are normal at the end of the summer.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/09/20/citys-jobless-rate-dips-for-first-time-in-months/', 'snippet': 'The drop to 9.9 percent in August from 10 percent in June and July was accompanied by positive news about employment losses that are normal at the end of the summer.', 'lead_paragraph': ' New York City’s unemployment rate dropped to 9.9 percent in August, the first decline in four months, as employers shed fewer jobs than they usually do at the end of the summer, the State Labor Department reported late Thursday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'City’s Jobless Rate Dips for First Time in Months', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Unemployment', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Consolidated Edison Inc', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-20T21:53:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Patrick McGeehan', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'McGeehan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3983fb30-0448-570c-8bab-86880210b626', 'word_count': 335, 'uri': 'nyt://article/3983fb30-0448-570c-8bab-86880210b626'}, {'abstract': 'On Tuesday, the Democratic-friendly channel had a rare victory over the traditional leader, Fox News, in the ratings among 25-to-54-year-olds, with Rachel Maddow leading the night in cable news.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/09/20/msnbcs-audience-grows-seemingly-drawn-by-news-of-romneys-troubles/', 'snippet': 'On Tuesday, the Democratic-friendly channel had a rare victory over the traditional leader, Fox News, in the ratings among 25-to-54-year-olds, with Rachel Maddow leading the night in cable news.', 'lead_paragraph': 'How hot is Rachel Maddow’s show on MSNBC? Hot enough to post a rare win this week as the top prime-time show on the cable news networks among the viewers most sought by advertisers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'MSNBC’s Audience Grows, Seemingly Drawn by News of Romney’s Troubles', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'News and News Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Ratings (Audience Measurement)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Maddow, Rachel', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'CNN', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'MSNBC', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-20T21:53:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Bill Carter', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'Carter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7911cbe0-13b9-5fe8-839a-62cb2ff1394f', 'word_count': 655, 'uri': 'nyt://article/7911cbe0-13b9-5fe8-839a-62cb2ff1394f'}, {'abstract': 'Sequence’s new offices are at 337 Broome Street at the Bowery, and it will start with about a dozen employees.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/09/20/san-francisco-agency-expands-eastward/', 'snippet': 'Sequence’s new offices are at 337 Broome Street at the Bowery, and it will start with about a dozen employees.', 'lead_paragraph': 'An innovative agency that works on brand strategy and design assignments, from advertising to app-building, for a blue-chip list of clients like Apple, Chipotle, Walt Disney, Food Network and Google is expanding for the first time outside its home base of San Francisco by opening an office in New York.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'San Francisco Agency Expands Eastward', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-20T21:54:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Stuart Elliott', 'person': [{'firstname': 'Stuart', 'middlename': None, 'lastname': 'Elliott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/349c562f-0cc0-571c-ae0a-256a22d930cd', 'word_count': 277, 'uri': 'nyt://article/349c562f-0cc0-571c-ae0a-256a22d930cd'}, {'abstract': 'Senator Scott P. Brown and Elizabeth Warren met Thursday in the first of four televised debates in their marquee Senate race.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/09/20/massachusetts-senate-candidates-to-meet-in-first-debate/', 'snippet': 'Senator Scott P. Brown and Elizabeth Warren met Thursday in the first of four televised debates in their marquee Senate race.', 'lead_paragraph': 'BOSTON — Senator Scott P. Brown and Elizabeth Warren face off against each other Thursday night in the first of four televised debates in this marquee Senate race.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Massachusetts Senate Candidates to Meet in First Debate', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Debates (Political)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Scott P', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Warren, Elizabeth', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-20T21:55:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Katharine Q. Seelye', 'person': [{'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/225f82cc-3613-5c62-be1d-5bcf9eacaba5', 'word_count': 513, 'uri': 'nyt://article/225f82cc-3613-5c62-be1d-5bcf9eacaba5'}, {'abstract': 'The Barclays Center, home of the Brooklyn Nets, is now also a site of ambitious art, as is the exterior of the Mark Morris Dance Center.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/20/art-joins-nets-at-barclays-center/', 'snippet': 'The Barclays Center, home of the Brooklyn Nets, is now also a site of ambitious art, as is the exterior of the Mark Morris Dance Center.', 'lead_paragraph': 'The Barclays Center, home of the Brooklyn Nets, is now also the site of a few ambitious art projects that include a giant vinyl mural of Brooklyn’s cityscape by Mickalene Thomas (part of which is shown above) and a 70-foot-long painting by the local artist José Parlá. A collaboration of three digital artists — Marc Downie, Shelley Eshkar and Paul Kaiser — who call themselves OpenEndedGroup, will also get prime placement on the center’s 3,000-square-foot, 360-degree LED marquee outside the main entrance. “The works by Mickalene Thomas, José Parlá and OpenEndedGroup are just the beginning,” Bruce Ratner, a co-owner of the center, said. Arnold L. Lehman, director of the Brooklyn Museum, and Eugenie Tsai, a curator of contemporary art there, are serving as advisers for the center’s arts program.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Art for Brooklyn', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Art Joins Nets at Barclays Center', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Barclays Center (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Brooklyn (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-20T21:56:04+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Patricia', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a7e0044d-8c0a-5e88-b1c2-deee15d4638f', 'word_count': 172, 'uri': 'nyt://article/a7e0044d-8c0a-5e88-b1c2-deee15d4638f'}, {'abstract': '“Trouble With the Curve” is the anti-“Moneyball.” The old-time scouts from that earlier film, mocked for their superstitions about “intangibles” and “instincts,” get their revenge this time around.', 'web_url': 'https://www.nytimes.com/2012/09/21/movies/trouble-with-the-curve-with-clint-eastwood-and-amy-adams.html', 'snippet': '“Trouble With the Curve” is the anti-“Moneyball.” The old-time scouts from that earlier film, mocked for their superstitions about “intangibles” and “instincts,” get their revenge this time around.', 'lead_paragraph': 'The trouble with baseball movies like “Trouble With the Curve” is that they tempt reviewers to reach for hackneyed sports metaphors. I’m only human, but I’m also not sure which comparison best suits this easygoing, unsurprising movie, directed by Robert Lorenz from a script by Randy Brown. Regrettably, it is not a home run or a perfect game, but it isn’t a wild throw, an errant bunt or a dropped fly ball either. “Trouble With the Curve” is either an off-speed pitch that just catches the edge of the strike zone or a bloop single lofted into right field. The runner is safe. The movie is too. Crack open a peanut and flag down the beer guy. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21TROUBLE_SPAN/JPTROUBLE-articleLarge.jpg', 'height': 250, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/21/arts/21TROUBLE_SPAN/JPTROUBLE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 250}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21TROUBLE_SPAN/JPTROUBLE-jumbo.jpg', 'height': 427, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21TROUBLE_SPAN/JPTROUBLE-superJumbo.jpg', 'height': 853, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21TROUBLE_SPAN/21TROUBLE_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/arts/21TROUBLE_SPAN/21TROUBLE_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Rooting for One Player in Baseball Politics: Dad', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Rooting for One Player in Baseball Politics: Dad', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Eastwood, Clint', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-20T21:56:35+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c7261139-a533-54be-9df8-4cda98a73f11', 'word_count': 789, 'uri': 'nyt://article/c7261139-a533-54be-9df8-4cda98a73f11'}, {'abstract': 'Contemporary African dance by women taps into serious and playful undercurrents.', 'web_url': 'https://www.nytimes.com/2012/09/21/arts/dance/voices-of-strength-modern-african-dance.html', 'snippet': 'Contemporary African dance by women taps into serious and playful undercurrents.', 'lead_paragraph': '“Voices of Strength” isn’t a new motivational speaker series, but rather a new festival focusing on contemporary dance and theater by five female African artists. An American tour, organized by MAPP International Productions, has, as the curator Cathy Zimmerman points out, brought artists to the United States whose works are largely unknown here.', 'print_section': 'C', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21VOICES/VOICES-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21VOICES/VOICES-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21VOICES/21VOICES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/arts/21VOICES/21VOICES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21VOICES/21VOICES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Women Who Confront, and Involve, Their Audience', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Women Who Confront, and Involve, Their Audience', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Live Arts', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-20T21:57:41+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Gia Kourlas', 'person': [{'firstname': 'Gia', 'middlename': None, 'lastname': 'Kourlas', 'qualifier': None, 'title': None, 'role': 'reported', 'org