': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Deposit Insurance Corp', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Treasury Department', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-09-25T00:45:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Protess and Peter Eavis', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Peter', 'middlename': None, 'lastname': 'Eavis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b4c691bc-1cc0-56d1-94f3-050f8cd4064b', 'word_count': 1185, 'uri': 'nyt://article/b4c691bc-1cc0-56d1-94f3-050f8cd4064b'}, {'abstract': 'Ms. Torrès was best known for “Women’s Barracks,” considered a landmark in lesbian fiction.', 'web_url': 'https://www.nytimes.com/2012/09/25/books/tereska-torres-writer-of-lesbian-fiction-dies-at-92.html', 'snippet': 'Ms. Torrès was best known for “Women’s Barracks,” considered a landmark in lesbian fiction.', 'lead_paragraph': 'Tereska Torrès, a convent-educated French writer who quite by accident wrote America’s first lesbian pulp novel, died on Thursday at her home in Paris. She was 92.', 'print_section': 'B', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/25/arts/TORRES1-obit/TORRES1-obit-jumbo.jpg', 'height': 1024, 'width': 710, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/25/arts/TORRES1-obit/TORRES1-obit-superJumbo.jpg', 'height': 2048, 'width': 1419, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype':