ualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3ac9505f-cada-5ce2-9eee-60eb6ce3062a', 'word_count': 26, 'uri': 'nyt://article/3ac9505f-cada-5ce2-9eee-60eb6ce3062a'}, {'abstract': 'The euro crisis erupted, George Soros says, because the markets didn’t recognize European construction’s fundamental building flaw.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/09/13/soross-wisdom-and-markets-ignorance/', 'snippet': 'The euro crisis erupted, George Soros says, because the markets didn’t recognize European construction’s fundamental building flaw.', 'lead_paragraph': 'In my column this week, I discuss George Soros’s headline-grabbing insistence that the euro will survive only if Germany “leads or leaves.” My column focuses on his passionate conviction that a united Europe’s value goes beyond economics — this is also a political, and even moral, story.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Soros’s Wisdom and Markets’ Ignorance', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Soros, George', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-13T15:36:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Chrystia Freeland', 'person': [{'firstname': 'Chrystia', 'middlename': None, 'lastname': 'Freeland', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e8475ada-15db-52ad-9a99-990dd5305a19', 'word_count': 270, 'uri': 'nyt://article/e8475ada-15db-52ad-9a99-990dd5305a19'}, {'abstract': 'Prof. Sid Watkins, the official neurosurgeon for Formula One from 1978 to 2004 who tended to the Formula One driver Ayrton Senna on multiple occasions, died on Wednesday.', 'web_url': 'https://wheels.blogs.nytimes.com/2012/09/13/wheelies-the-dr-sid-edition/', 'snippet': 'Prof. Sid Watkins, the official neurosurgeon for Formula One from 1978 to 2004 who tended to the Formula One driver Ayrton Senna on multiple occasions, died on Wednesday.', 'lead_paragraph': 'In which we bring you motoring news from around the Web:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wheelies: The Dr. Sid Edition', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Racing', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Senna, Ayrton', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Audi Division of Volkswagen AG', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Bayerische Motorenwerke AG', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Chevrolet Division of General Motors Corp', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Formula One', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'General Motors', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-09-13T15:39:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/dd2b8caa-9a04-537f-a7d0-aa379b67466d', 'word_count': 384, 'uri': 'nyt://article/dd2b8caa-9a04-537f-a7d0-aa379b67466d'}, {'abstract': 'She now will have complete oversight of casting, repertory, the young artists program and a new commissioning project.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/13/a-promotion-for-francesca-zambello-at-washington-national-opera/', 'snippet': 'She now will have complete oversight of casting, repertory, the young artists program and a new commissioning project.', 'lead_paragraph': 'The Washington National Opera said on Thursday it had promoted Francesca Zambello  from artistic adviser to artistic director, solidifying its reorganization after the departure of Plácido Domingo and its merger with the Kennedy Center. Mr. Domingo stepped down as artistic director at the end of the 2010-2011 season, and the company became a Kennedy Center affiliate in response to serious money problems. Ms. Zambello, who is also the artistic and executive director of the Glimmerglass Festival in Cooperstown, N.Y., had stepped in at Washington to fill the void after Mr. Domingo’s departure. She now will have complete oversight of casting, repertory, the young artists program and a new commissioning project. She will continue to direct one production a year, the company said. She will assume the position in January.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Promotion for Francesca Zambello at Washington National Opera', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Zambello Promoted At Washington Opera', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Domingo, Placido', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Zambello, Francesca', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Kennedy, John F, Center for the Performing Arts', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Washington National Opera', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-13T15:45:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 