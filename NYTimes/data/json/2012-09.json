1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/de00d17e-e206-55b3-8245-f97a25cdfeb3', 'word_count': 1010, 'uri': 'nyt://article/de00d17e-e206-55b3-8245-f97a25cdfeb3'}, {'abstract': 'Taylor Swift’s heart-rending song “Ronan,” about the too-short life of a little boy, was based on his mother’s blog and her family’s quest for his cancer treatment.', 'web_url': 'https://well.blogs.nytimes.com/2012/09/17/a-childs-cancer-story-inspires-taylor-swift/', 'snippet': 'Taylor Swift’s heart-rending song “Ronan,” about the too-short life of a little boy, was based on his mother’s blog and her family’s quest for his cancer treatment.', 'lead_paragraph': 'By now you may have heard Taylor Swift’s heart-rending song “Ronan,” about the too-short life of a little boy. Ms. Swift gave it an emotional performance on the Stand Up to Cancer telethon on Sept. 7, and it has been topping the charts ever since.', 'print_section': 'D', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/science/18WELL/18WELL-jumbo.jpg', 'height': 824, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/science/18WELL/18WELL-superJumbo.jpg', 'height': 1647, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/science/18WELL/18WELL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/18/science/18WELL/18WELL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/science/18WELL/18WELL-th