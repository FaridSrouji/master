mbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/26/arts/26NODOUBT1-1348598215483/26NODOUBT1-1348598215483-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/arts/26NODOUBT1-1348598215483/26NODOUBT1-1348598215483-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pop-Punk Bands, Now Grown Up', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Pop-Punk Bands, Now Grown Up', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'NO DOUBT', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rock Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Day', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-25T22:01:48+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b7dd375f-9bb7-5451-bffd-a2bf377b842a', 'word_count': 1201, 'uri': 'nyt://article/b7dd375f-9bb7-5451-bffd-a2bf377b842a'}, {'abstract': 'The San Francisco Ballet’s season in London demonstrated that company’s commitment to new choreography with technical aplomb and stylistic versatility.', 'web_url': 'https://www.nytimes.com/2012/09/26/arts/dance/san-francisco-ballet-finishes-its-london-season.html', 'snippet': 'The San Francisco Ballet’s season in London demonstrated that company’s commitment to new choreography with technical aplomb and stylistic versatility.', 'lead_paragraph': 'LONDON — The San Francisco Ballet season at Sadler’s Wells in London, which ended on Sunday, was an impressive, and tactical, display of ballet power. The company arrived with three programs and 10 ballets for its weeklong run —no small feat on the artistic or financial front. With the exception of Balanchine’s 1956 “Divertimento No. 15,” all the dances were created during the past four years. The company’s commitment to new choreography was clear; its technical aplomb and stylistic versatility shiningly apparent.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/arts/sub-26sfballet/sub-26sfballet-jumbo.jpg', 'height': 692, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/arts/sub-26sfballet/sub-26sfballet-superJumbo.jpg', 'height': 1383, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Insouciant Elegance and Nonchalant Fireworks, Fueled by Ballet Power', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Insouciant Elegance and Nonchalant Fireworks, Fueled by Ballet Power', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'San Francisco Ballet', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tomasson, Helgi', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': "Sadler's Wells", 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Dancing', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-25T22:04:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9b98eb84-6cca-5a28-aec8-b9c3609f2f3d', 'word_count': 826, 'uri': 'nyt://article/9b98eb84-6cca-5a28-aec8-b9c3609f2f3d'}, {'abstract': 'Three correspondents for British news organizations filed vivid television reports from inside Syria in the past week.', 'web_url': 'https://thelede.blogs.nytimes.com/2012/09/25/vivid-dispatches-from-syrias-front-lines/', 'snippet': 'Three correspondents for British news organizations filed vivid television reports from inside Syria in the past week.', 'lead_paragraph': 'Eighteen months have passed since an adviser to President Bashar al-Assad of Syria scolded a BBC correspondent in Damascus for reporting that video posted on YouTube by activists appeared to contradict official accounts of a crackdown on protesters broadcast on state-run television. “The events are happening in Syria,” Bouthaina Shaaban insisted, one week into the uprising, “therefore, it’s Syrian television who tells the truth, nobody else.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Vivid Dispatches From Syria’s Front Lines', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Abdul-Ahad, Ghaith', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'British Broadcasting Corp', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Free Syrian Army', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'ALEPPO (SYRIA)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Damascus (Syria)', 'rank': 8, 'major': 'N'}, {'name': '