pinion/maureen-dowd/maureen-dowd-superJumbo.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/maureen-dowd/maureen-dowd-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Playing Now: Hail to Us Chiefs', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Playing Now: Hail to Us Chiefs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Democratic National Convention', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-08T17:17:07+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Maureen Dowd', 'person': [{'firstname': 'Maureen', 'middlename': None, 'lastname': 'Dowd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1dc146d4-c0ec-5e5a-a1f8-1762eeac42ff', 'word_count': 832, 'uri': 'nyt://article/1dc146d4-c0ec-5e5a-a1f8-1762eeac42ff'}, {'abstract': 'Houston’s run to the playoffs last season set the stage for what the Texans now expect: to rise into the upper echelon of the N.F.L.’s American Conference.', 'web_url': 'https://www.nytimes.com/2012/09/09/sports/football/the-texans-after-tasting-the-playoffs-for-the-first-time-want-seconds.html', 'snippet': 'Houston’s run to the playoffs last season set the stage for what the Texans now expect: to rise into the upper echelon of the N.F.L.’s American Conference.', 'lead_paragraph': 'HOUSTON — The sting of a playoff loss was only a few minutes old, so fresh that the Houston players had not even removed their shoulder pads inside the visitors’ locker room in Baltimore. In their decade of existence, the Texans had never before reached the postseason, let alone dealt with losing in one. Perhaps that explains the players’ unorthodox reaction last January when their best season screeched to an unceremonious halt in the second round. ', 'print_section': 'SP', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/sports/texans/texans-jumbo.jpg', 'height': 893, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/sports/texans/texans-superJumbo.jpg', 'height': 1495, 'width': 1714, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/sports/texans/texans-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/sports/texans/texans-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/sports/texans/texans-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'For Texans, Playoff Lost and Perspective Gained', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Texans, Playoff Lost And Perspective Gained', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kubiak, Gary', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Andre (1981- )', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Houston Texans', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Schaub, Matt', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-08T17:20:12+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7798dccb-a99b-5de0-a368-20de81847d49', 'word_count': 1168, 'uri': 'nyt://article/7798dccb-a99b-5de0-a368-20de81847d49'}, {'abstract': 'Too often, our dysfunctional health care system is failing to control high blood pressure.', 'web_url': 'https://www.nytimes.com/2012/09/09/opinion/sunday/simple-treatments-ignored.html', 'snippet': 'Too often, our dysfunctional health care system is failing to control high blood pressure.', 'lead_paragraph': 'A new federal health analysis has found that 36 million adults in the United States have high blood pressure that is not being controlled even though 32 million of them get regular medical care and 30 million of them have health insurance. ', 'print_section': 'SR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Simple Treatments, Ignored', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Simple Treatments, Ignored', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Blood Pressure', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hypertension', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Preventive Medicine', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Kaiser Permanente', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-08T17:25:06+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/03787857-2a63-50f2-9c26-822f42386025', 'word_count': 709, 'uri': 'nyt://article/03787857-2a63-50f2-9c26-822f42386025'}, {'abstract': 'China’s lust for illegal ivory has turned Africa into a poachers’ playground.', 'web_url': 'https://www.nytimes.com/2012/09/09/opinion/sunday/elephant-slaughter.html', 'snippet': 'China’s lust for illegal ivory has turned Africa into a poachers’ playground.', 'lead_paragraph': 'Not long ago it looked as though elephant poaching in Africa was on the downswing, in part because of more rigorous enforcement of a global ban on trade in most elephant ivory imposed in 1989. That moment is gone and with it, elephants in the tens of thousands every year. These astonishing creatures, which seem more intelligent and emotionally aware the more we know about them, are being gunned down by poachers for their ivory tusks at a fast pace — the worst slaughter seen since the 1980s. ', 'print_section': 'SR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Elephant Slaughter', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Elephant Slaughter', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poaching (Wildlife)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elephants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Ivory', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'State Department', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-09-08T17:30:07+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/cac6027f-e078-51c1-b90e-9afc0d475d52', 'word_count': 498, 'uri': 'nyt://article/cac6027f-e078-51c1-b90e-9afc0d475d52'}, {'abstract': 'Behind the scenes at the casting for today’s Edun show at 1 p.m. in New York.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2012/09/08/fashion-week-casting-edun/', 'snippet': 'Behind the scenes at the casting for today’s Edun show at 1 p.m. in New York.', 'lead_paragraph': 'var data;function jsonSlideshowCallback(response){data = response;}NYTD.options = {source: data,cropType: \'blog480\',appendTo: \'fullScreenSlideShow\',showHeadLine: \'false\', renderstyle: "embeddedSlideShowTmag"}', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fashion Week Casting | Edun', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-08T17:30:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Samantha Casolari', 'person': [{'firstname': 'Samantha', 'middlename': None, 'lastname': 'Casolari', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd3f88c5-877e-5eed-9a3e-e12a76ef51df', 'word_count': 34, 'uri': 'nyt://article/dd3f88c5-877e-5eed-9a3e-e12a76ef51df'}, {'abstract': 'Federal courts have rightly sided with the homeless whose personal property was seized by Los Angeles city employees.', 'web_url': 'https://www.nytimes.com/2012/09/09/opinion/sunday/the-constitution-on-skid-row.html', 'snippet': 'Federal courts have rightly sided with the homeless whose personal property was seized by Los Angeles city employees.', 'lead_paragraph': 'Skid Row in Los Angeles, which has one of the highest concentrations of homeless people in the country, has been the site of extended legal battles over the rights of individuals to live on the streets and the power of the government to impose order. ', 'print_section': 'SR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Constitution on Skid Row', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The Constitution on Skid Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Homeless Persons', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Search and Seizure', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fourth Amendment (US Constitution)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fourteenth Amendment (US Constitution)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-08T17:32:04+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/decdf9d6-7d0e-5ec8-9bcd-f17800be8631', 'word_count': 428, 'uri': 'nyt://article/decdf9d6-7d0e-5ec8-9bcd-f17800be8631'}, {'abstract': 'Serving constituents one at a time is expensive, distracting and un-American.', 'web_url': 'https://www.nytimes.com/2012/09/09/opinion/sunday/a-congress-for-the-many-or-the-few.html', 'snippet': 'Serving constituents one at a time is expensive, distracting and un-American.', 'lead_paragraph': 'OUT of work and stuck with an expensive mortgage, my friend was on the verge of losing her house. Attempts to get the bank to modify her loan led to a situation Kafka would have recognized: scores of letters, hundreds of phone calls — but no modification. Then she called one of her senators. Soon a member of the senator’s staff had contacted the Office of the Comptroller of the Currency, the federal agency that regulates national banks. Not long after, my friend received the loan modification she had been requesting, unavailingly, for years.', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/sunday-review/09BERNSTEIN/09BERNSTEIN-jumbo.jpg', 'height': 978, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/sunday-review/09BERNSTEIN/09BERNSTEIN-superJumbo.jpg', 'height': 1956, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/sunday-review/09BERNSTEIN/09BERNSTEIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/sunday-review/09BERNSTEIN/09BERNSTEIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype