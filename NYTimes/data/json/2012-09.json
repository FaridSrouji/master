nk': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Doping (Sports)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Roenicke, Ron', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-01T16:15:06+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Ben Strauss', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Strauss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70d6afb1-9819-5c91-b736-266fe15896ec', 'word_count': 836, 'uri': 'nyt://article/70d6afb1-9819-5c91-b736-266fe15896ec'}, {'abstract': 'The tobacco industry is evading federal taxes and bans designed to keep tobacco out of the hands of young adults.', 'web_url': 'https://www.nytimes.com/2012/09/02/opinion/sunday/loopholes-in-tobacco-regulation.html', 'snippet': 'The tobacco industry is evading federal taxes and bans designed to keep tobacco out of the hands of young adults.', 'lead_paragraph': 'Give the tobacco industry credit for ingenuity. Just when it looked as if federal regulators could block their ability to addict children and young adults, several companies that make cigars and pipe tobacco have sidestepped the barriers by taking advantage of loopholes in federal law. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Loopholes in Tobacco Regulation', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Loopholes in Tobacco Regulation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 3, 'major': 'N'}, {'name':