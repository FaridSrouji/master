: None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/fashion/runway-womens/armani_spring13app-slide-GFQ7/armani_spring13app-slide-GFQ7-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Giorgio Armani: Spring 2013 RTW', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-23T21:04:34+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'subsection_name': "Women's Runway", 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/0d277b7f-a696-544c-975b-15e6a24afc70', 'word_count': 0, 'uri': 'nyt://slideshow/0d277b7f-a696-544c-975b-15e6a24afc70'}, {'abstract': 'Data to be released will include the Standard & Poor’s/Case-Shiller home price index for July, consumer confidence for September and new-home sales for August.', 'web_url': 'https://www.nytimes.com/2012/09/24/business/economy/economic-reports-for-the-week-of-sept-23.html', 'snippet': 'Data to be released will include the Standard & Poor’s/Case-Shiller home price index for July, consumer confidence for September and new-home sales for August.', 'lead_paragraph': 'ECONOMIC REPORTS Data to be released will include the Standard & Poor’s/Case-Shiller home price index for July, and consumer confidence for September (Tuesday); new-home sales for August (Wednesday); weekly jobless claims, durable goods for August, second-quarter gross domestic product (final) and pending home sales for August (Thursday); and personal income and spending for August, the Chicago purchasing manager index for SeptemberThomson Reuters/University of Michigan consumer sentiment index for September (Friday).', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Economic Reports for the Week Ahead', 'kicker': None, 'content_kicker': None, 'print_headline': 'Looking Ahead', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': "Standard & Poor's Case-Shiller Home Price Index", 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Behavior', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-23T21:06:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/878b368a-dc77-5e33-bf01-6d5e8007e9ea', 'word_count': 344, 'uri': 'nyt://article/878b368a-dc77-5e33-bf01-6d5e8007e9ea'}, {'abstract': '“Habit,” an art-theater project from David Levine, takes place in a structure within the Essex Street Market; audiences look through its windows or walk in.', 'web_url': 'https://www.nytimes.com/2012/09/24/theater/reviews/david-levines-habit-at-the-essex-street-market.html', 'snippet': '“Habit,” an art-theater project from David Levine, takes place in a structure within the Essex Street Market; audiences look through its windows or walk in.', 'lead_paragraph': 'When I first looked in on them, around 4:30 p.m., they were all asleep. Or unconscious. Or dead. It was hard to tell. An hour and some minutes later, the three of them were knocked out again, but this time in different positions, different places and, come to think of it, different clothes. And that was when things started to get interesting.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/24/arts/jphabit2/jphabit2-articleLarge.jpg', 'height': 392, 'width': 600, '