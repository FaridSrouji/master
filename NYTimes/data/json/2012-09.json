LSTOPSS-slide-8I6X-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/nyregion/20120909LOCALSTOPSS-slide-8I6X/20120909LOCALSTOPSS-slide-8I6X-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Local Stop: Fordham Road', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Fordham University', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-08T02:52:03+0000', 'document_type': 'multimedia', 'news_desk': 'New York', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4cf11616-5a36-51c5-887e-761a94400418', 'word_count': 0, 'uri': 'nyt://slideshow/4cf11616-5a36-51c5-887e-761a94400418'}, {'abstract': 'It’s when we’re convinced that somebody is out to get us, whether it be Isaac, Roger Goodell or any other conspirator out there, that we turn genuinely optimistic about our chances.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2012/09/07/we-saints-fans-thrive-on-embracing-the-horror/', 'snippet': 'It’s when we’re convinced that somebody is out to get us, whether it be Isaac, Roger Goodell or any other conspirator out there, that we turn genuinely optimistic about our chances.', 'lead_paragraph': '“The Saints are going to win it all, baby,” Pat Bode, the proprietor of Mugz’s Bar in the New Orleans suburb of Metairie, her excited eyes wide with unwavering certainty, proclaimed to me on a recent evening. “I got a lot of faith in that.”', 'print_section': 'D', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'We Saints Fans Thrive on Embracing the Horror', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': 'We Saints Fans Embrace the Horror', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hurricane Isaac (2012)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Goodell, Roger', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Payton, Sean', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'New Orleans Saints', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-09-08T02:56:50+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Brett Michael Dykes', 'person': [{'firstname': 'Brett', 'middlename': 'Michael', 'lastname': 'Dykes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4de5753a-3b45-5e44-88be-f5e5e46e050b', 'word_count': 968, 'uri': 'nyt://article/4de5753a-3b45-5e44-88be-f5e5e46e050b'}, {'abstract': 'With its mishmash of architectural periods, streets packed with colorful shops and Edgar Allan Poe’s clapboard cottage, the neighborhood has a little of everything.', 'web_url': 'https://www.nytimes.com/2012/09/09/nyregion/fordham-road-near-the-university-is-a-study-in-contrasts.html', 'snippet': 'With its mishmash of architectural periods, streets packed with colorful shops and Edgar Allan Poe’s clapboard cottage, the neighborhood has a little of everything.', 'lead_paragraph': 'Brooklyn has its multitudes, Queens its fathomless diversity. The Bronx trades more in sharp contrasts: lush parks and roaring expressways, majestic architecture and harder times. Exiting the Fordham Road subway station you’ll find elegant 1920s buildings on the Grand Concourse; chain stores on East Fordham Road; Edgar Allan Poe’s tidy, tragic cottage in Poe Park; and down the hill, the campus of Fordham, with its close-cropped lawns and impressive gates, open only to those affiliated with the university. For the students who matriculate here each year, these surroundings might be as much an education as college itself.\xa0', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/nyregion/09subSTOP3/09subSTOP3-jumbo.jpg', 'height': 1024, 'width': 1001, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/nyregion/09subSTOP3/09subSTOP3-superJumbo.jpg', 'height': 1464, 'width': 1431, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/nyregion/09subSTOP3/09subSTOP3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/nyregion/09subSTOP3/09subSTOP3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/nyregion/09subSTOP3/09subSTOP3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'From Poe to Paradise in the Bronx', 'kicker': 'Local Stop | Fordham Road', 'content_kicker': None, 'print_headline': 'From Poe to Paradise in the Bronx', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Fordham University', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Grand Concourse (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-08T03:12:13+0000', 'document_type': 