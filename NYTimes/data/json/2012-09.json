/annasui_spring13app-slide-AG1N/annasui_spring13app-slide-AG1N-superJumbo.jpg', 'height': 2030, 'width': 1353, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Anna Sui: Spring 2013 RTW', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-13T03:46:59+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'subsection_name': "Women's Runway", 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4bc54931-0300-56a0-86ec-31598ebd0482', 'word_count': 0, 'uri': 'nyt://slideshow/4bc54931-0300-56a0-86ec-31598ebd0482'}, {'abstract': 'Harlem Désir, a member of the European Parliament and former leader of an antiracism organization, was designated Wednesday as the next leader of France’s governing Socialist Party, replacing Martine Aubry, who is stepping down.', 'web_url': 'https://www.nytimes.com/2012/09/13/world/europe/france-new-leader-is-named-for-the-socialist-party.html', 'snippet': 'Harlem Désir, a member of the European Parliament and former leader of an antiracism organization, was designated Wednesday as the next leader of France’s governing Socialist Party, replacing Martine Aubry, who is stepping down.', 'lead_paragraph': ' Harlem Désir, a member of the European Parliament and former leader of an antiracism organization, was designated Wednesday as the next leader of France’s governing Socialist Party, replacing Martine Aubry, who is stepping down. Mr. Désir, 52, is an Aubry ally and replaced her as interim party leader when she ran unsuccessfully for the party presidential nomination. She and Prime Minister Jean-Marc Ayrault nominated Mr. Désir; next month’s party vote on the nomination is considered a formality. ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'France: New Leader Is Named for the Socialist Party', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'France: New Leader Is Named for the Socialist Party', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Aubry, Martine', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-13T03:52:00+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Scott Sayare', 'person': [{'firstname': 'Scott', 'middlename': None, 'lastname': 'Sayare', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/3ae81401-c9a8-557f-ba1e-06442e12a86a', 'word_count': 79, 'uri': 'nyt://article/3ae81401-c9a8-557f-ba1e-06442e12a86a'}, {'abstract': 'Fewer than seven million children around the world died before their fifth birthday from disease and birth complications in 2011 — a new low, several agencies announced Wednesday.', 'web_url': 'https://www.nytimes.com/2012/09/13/world/young-childrens-deaths-said-to-drop-again-in-2011.html', 'snippet': 'Fewer than seven million children around the world died before their fifth birthday from disease and birth complications in 2011 — a new low, several agencies announced Wednesday.', 'lead_paragraph': ' Fewer than seven million children around the world died before their fifth birthday from disease and birth complications in 2011 — a new low — the World Health Organization, the United Nations Children’s Fund and other agencies announced Wednesday. About 12 million children that age died in 1990, and the number fell below 10 million for the first time in 2007, so the pace of saving children’s lives is accelerating, experts said. Half of all the deaths occurred in five countries: India, Nigeria, the Democratic Republic of Congo, Pakistan and China. The leading causes, in descending order, were pneumonia, premature birth, diarrhea, birth complications and malaria. Most of those deaths were preventable with relatively cheap interventions, the United Nations agencies said. ', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Young Children’s Deaths Said to Drop Again in 2011', 'kicker': 'World Briefing | United Nations', 'content_kicker': None, 'print_headline': 'Young Children’s Deaths Said to Drop Again in 2011', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': "United Nations Children's Fund", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'World Health Organization', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'United Nations', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-13T03:55:47+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Donald G. McNeil Jr', 'person': [{'firstname': 'Donald', 'middlename': 'G.', 'lastname': 'McNeil', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/63469bd4-d27c-59b9-b8a7-22e1a1cbd18d', 'word_count': 130, 'uri': 'nyt://article/63469bd4-d27c-59b9-b8a7-22e1a1cbd18d'}, {'abstract': 'A solid defense was the backbone of the U.S. victory over Jamaica in a World Cup qualifying match in Columbus, Ohio, Tuesday night.', 'web_url': 'https://goal.blogs.nytimes.com/2012/09/13/quality-defense-a-key-to-u-s-victory/', 'snippet': 'A solid defense was the backbone of the U.S. victory over Jamaica in a World Cup qualifying match in Columbus, Ohio, Tuesday night.', 'lead_paragraph': 'Of all the positives coming out of the United States’ 1-0 victory over Jamaica in Tuesday’s World Cup qualifier in Columbus, Ohio — the way the Americans\xa0 dominated the first half, Danny Williams’s quality showing, another strrong match from Geoff Cameron, Graham Zusi’s solid performance, the number of chances the team created, Herculez Gomez’s free kick for the game’s only goal — perhaps one has been overlooked: the confident and strong play on defense.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/sports/soccer/usa1/usa1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/sports/soccer/usa1/usa1-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/sports/soccer/usa1/usa1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/12/sports/soccer/usa1/usa1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/12/sports/soccer/usa1/usa1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Quality Defense a Key to U.S. Victory', 'kicker': 'Goal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'World Cup (Soccer)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'valu