: 'image', 'url': 'images/2012/09/04/blogs/pesh-rdv/pesh-rdv-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/04/blogs/pesh-rdv/pesh-rdv-superJumbo.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In Harm’s Way in Pakistan: Diplomats Are Targets, Too', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Diplomatic Service, Embassies and Consulates', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Taliban', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Tehrik-e-Taliban', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Federally Administered Tribal Areas (Pakistan)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Pakistan', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Peshawar (Pakistan)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-04T05:23:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Mark McDonald', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'McDonald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/20beaed4-af55-5259-b00d-918f74185be7', 'word_count': 1063, 'uri': 'nyt://article/20beaed4-af55-5259-b00d-918f74185be7'}, {'abstract': 'See what you know about the news of the day.', 'web_url': 'https://learning.blogs.nytimes.com/2012/09/04/news-quiz-september-4-2012/', 'snippet': 'See what you know about the news of the day.', 'lead_paragraph': 'See what you know about the news below. To prepare, you might scan the articles or summaries on today’s paper. Good luck!', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'News Quiz | September 4, 2012', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-04T05:59:37+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Anastasia Economides', 'person': [{'firstname': 'Anastasia', 'middlename': None, 'lastname': 'Economides', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5057490e-4535-5cd0-8610-32820146b290', 'word_count': 22, 'uri': 'nyt://article/5057490e-4535-5cd0-8610-32820146b290'}, {'abstract': 'The remote national park, nestled in the Himalayas, is home to more than 600 varieties of plants.', 'web_url': 'https://india.blogs.nytimes.com/2012/09/04/a-tough-rewarding-journey-to-indias-valley-of-flowers/', 'snippet': 'The remote national park, nestled in the Himalayas, is home to more than 600 varieties of plants.', 'lead_paragraph': 'A grueling four-hour trek from the village of Ghangria in the Garhwal district of Uttaranchal brings visitors to one of India’s most stunning national parks, the Valley of Flowers. These grassy pastures, at an altitude of 13,000 feet in the western Himalayas, are covered in snow most of the year. During July and August, though, many of the valley’s more than 600 varieties of flora are in stunning bloom. The trek, which runs across streams and below shining, snow-covered peaks, eventually brings the traveler to a field of pink and white flowers.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Tough, Rewarding Journey to India’s Valley of Flowers', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'su