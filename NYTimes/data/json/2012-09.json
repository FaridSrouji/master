pe': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Eric Pfanner', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Pfanner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/70f88f1c-6356-5d7a-bb2d-5ee7a3b76931', 'word_count': 826, 'uri': 'nyt://article/70f88f1c-6356-5d7a-bb2d-5ee7a3b76931'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2012/09/16/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'ARGUABLY: Essays,  by Christopher Hitchens. (Twelve, $18.) The esophageal cancer that killed Hitchens last December throws a shadow over this provocative collection, one of the Book Review’s 10 Best Books of 2011. Nearly 800 pages and containing more than 100 essays, it addresses an extraordinary range of topics, including Afghanistan, Harry Potter, Thomas Jefferson, waterboarding, Henry VIII, Saul Bellow and the Ten Commandments.', 'print_section': 'BR', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': 'Paperback Row', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-14T16:03:29+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/744c4307-698d-578f-a288-7825d9d6357d', 'word_count': 502, 'uri': 'nyt://article/744c4307-698d-578f-a288-7825d9d6357d'}, {'abs