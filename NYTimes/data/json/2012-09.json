ri': 'nyt://article/9732ddec-fe63-51fa-a450-c345f9629f2d'}, {'abstract': 'What a regiment of inexperienced Indiana soldiers saw at Antietam.', 'web_url': 'https://opinionator.blogs.nytimes.com/2012/09/18/the-most-desperate-battle-ever-fought/', 'snippet': 'What a regiment of inexperienced Indiana soldiers saw at Antietam.', 'lead_paragraph': 'The men of the 27th Indiana Volunteer Regiment had been in only a few small battles when they reached the cornfield near a Maryland creek named Antietam. The battle that followed, changed not only the course of their lives, but the course of the Civil War itself. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘The Most Desperate Battle Ever Fought’', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gospel Music', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Indiana', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Maryland', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-18T18:48:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Nicole Etcheson', 'person': [{'firstname': 'Nicole', 'middlename': None, 'lastname': 'Etcheson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/92d78bb5-8da5-5646-894c-7a33d4999d0c', 'word_count': 2279, 'uri': 'nyt://article/92d78bb5-8da5-5646-894c-7a33d4999d0c'}, {'abstract': 'Mitt Romney is caught on a hidden camera. | The long journey for the footage online. | Fresh ads from each campaign. | A new Senate model from the FiveThirtyEight blog.', 'web_url': 'https://www.nytimes.com/video/us/politics/100000001791347/timescast-politics-sept-18-2012.html', 'snippet': 'Mitt Romney is caught on a hidden c