qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/9b51e9cf-55ee-5218-a43e-8aa42c3c0d10', 'word_count': 811, 'uri': 'nyt://article/9b51e9cf-55ee-5218-a43e-8aa42c3c0d10'}, {'abstract': 'Good news, bad news, from old newspapers.', 'web_url': 'https://krugman.blogs.nytimes.com/2012/09/27/same-as-it-ever-was-2/', 'snippet': 'Good news, bad news, from old newspapers.', 'lead_paragraph': 'FT Alphaville went trawling through the New York Times archives to look at what people were saying about monetary policy in 1929-33, and produced a wonderful piece that’s both deeply reassuring and deeply frustrating.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Same As It Ever Was', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-27T14:47:42+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d8220146-18bb-5807-b3ed-96618eacfe9e', 'word_count': 336, 'uri': 'nyt://article/d8220146-18bb-5807-b3ed-96618eacfe9e'}, {'abstract': 'Readers tell us if they avoid talking to seatmates during flights.', 'web_url': 'https://intransit.blogs.nytimes.com/2012/09/27/your-views-on-chattering-seatmates/', 'snippet': 'Readers tell us if they avoid talking to seatmates during flights.', 'lead_paragraph': 'A TV producer told The Times about being scolded by a child sitting next to him during a flight after he used a naughty word, and about his plans not to talk to seatmates in the future. We asked on Twitter if you avoid talking to seatmates during flights.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Your Views on Chattering Seatmates', 'kicker': 'In Transit', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-27T14:48:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Travel', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/3236c5b7-19f5-5ea8-9250-e3fb4e372091', 'word_count': 58, 'uri': 'nyt://article/3236c5b7-19f5-5ea8-9250-e3fb4e372091'}, {'abstract': 'With its medieval Old Town and bird’s-eye views of the Adriatic, Dubrovnik is no longer anyone’s best-kept secret.', 'web_url': 'https://www.nytimes.com/2012/09/30/travel/36-hours-in-dubrovnik-croatia.html', 'snippet': 'With its medieval Old Town and bird’s-eye views of the Adriatic, Dubrovnik is no longer anyone’s best-kept secret.', 'lead_paragraph': 'FIRST, the bad news: Dubrovnik is no longer anyone’s best-kept secret. Some 17 years after the end of Croatia’s war of independence, the city’s medieval walled Old Town is gridlocked with tourists during the summer. Yet go in the fall and you’ll quickly see what the fuss is about. Jutting out on a peninsular chunk of the Dalmatian coastline, the former Republic of Ragusa is a Venetian Gothic marvel. Columned porticoes and loggias rim marble-paved Renaissance squares buffed to a sheen by centuries of foot traffic. Yes, many businesses unabashedly cater to cruise ship passengers and other mainstream tourists, but there are plenty of creative local standouts.', 'print_section': 'TR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/travel/30HOURS_SPAN/30HOURS1-articleLarge.jpg', 'height': 493, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/30/travel/30HOURS_SPAN/30HOURS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 493}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/travel/30HOURS_SPAN/30HOURS1-jumbo.jpg', 'height': 842, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/travel/30HOURS_SPAN/30HOURS1-superJumbo.jpg', 'height': 1233, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/travel/30HOURS_SPAN/30HOURS_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/30/travel/30HOURS_SPAN/30HOURS_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/travel/30HOURS_SPAN/30HOURS_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '36 Hours in Dubrovnik, Croatia', 'kicker': None, 'content_kicker': None, 'print_headline': '36 Hours: Dubrovnik, Croatia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Dubrovnik (Croatia)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-27T14:53:28+0000', 'document_type': 'article', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By Charly Wilder', 'person': [{'firstname': 'Charly', 'middlename': None, 'lastname': 'Wilder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'ran