y': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/nyregion/23METROPNJARTS3_SPAN/23METROPNJARTS3_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/23/nyregion/23METROPNJARTS3_SPAN/23METROPNJARTS3_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/23/nyregion/23METROPNJARTS3_SPAN/23METROPNJARTS3_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Deception and Betrayal, All in the Family', 'kicker': 'Arts | New Jersey', 'content_kicker': None, 'print_headline': 'Deception and Betrayal, All in the Family', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Topdog/Underdog (Play)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dirden, Jason', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dirden, Brandon J', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Two River Theater Co', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Parks, Suzan-Lori', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Red Bank (NJ)', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-22T00:46:17+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Anita Gates', 'person': [{'firstname': 'Anita', 'middlename': None, 'lastname': 'Gates', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6cda0277-309c-5ee6-b6dd-c88a924ba4e9', 'word_count': 704, 'uri': 'nyt://article/6cda0277-309c-5ee6-b6dd-c88a924ba4e9'}, {'abstract': 'A Russian tradition flatters writers in a culture where literature has special prestige. But the surprise also promotes the cult of the unpredictable czar.', 'web_url': 'https://www.nytimes.com/2012/09/22/opinion/please-hold-for-mr-putin.html', 'snippet': 'A Russian tradition flatters writers in a culture where literature has special prestige. But the surprise also promotes the cult of the unpredictable czar.', 'lead_paragraph': 'MASHA GESSEN, a Russian journalist, was recently fired for refusing to cover President Vladimir V. Putin’s hang-glider flight with migrating cranes, an exploit that was much mocked. Last week, she received an unexpected phone call, which she recounted in a blog post for The International Herald Tribune, this newspaper’s global edition. “My phone rang. ... I listened to silence for two minutes.” Finally: “Don’t hang up. I will connect you.” Frustrated, she shouted: “Do you want to introduce yourself?” A famous voice replied: “Putin, Vladimir Vladimirovich. I heard you were fired and that I unwittingly served as the reason for it.” He invited her to meet.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Please Hold for Mr. Putin', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Please Hold for Mr. Putin', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Russia', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bulgakov, Mikhail', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gessen, Masha', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Writing and Writers', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Pasternak, Boris', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Stalin, Joseph', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Shostakovich, Dmitri', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-09-22T00:51:13+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Simon Sebag Montefiore', 'person': [{'firstname': 'Simon', 'middlename': 'Sebag', 'lastname': 'Montefiore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/62b4216c-7745-5057-a247-e47d3b014e4f', 'word_count': 817, 'uri': 'nyt://article/62b4216c-7745-5057-a247-e47d3b014e4f'}, {'abstract': 'Mr. Duckworth, a post-Minimalist who wrote “Time Curve Preludes,” grew to embrace the Internet as a focus of electronic works.', 'web_url': 'https://www.nytimes.com/2012/09/22/arts/music/william-duckworth-internet-composer-dies-at-69.html', 'snippet': 'Mr. Duckworth, a post-Minimalist who wrote “Time Curve Preludes,” grew to embrace the Internet as a focus of electronic works.', 'lead_paragraph': 'William Duckworth, a composer, author and performer who was best known for his choral works, piano cycles and, in recent years, interactive electronic projects using the Internet, died on Sept. 13 at his home in West New York, N.J. He was 69.', 'print_section': 'B', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/arts/subDUCKWORTH-obit/subDUCKWORTH-obit-articleLarge.jpg', 'height': 345, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/22/arts/subDUCKWORTH-obit/subDUCKWORTH-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 345}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/arts/subDUCKWORTH-obit/subDUCKWORTH-obit-jumbo.jpg', 'height': 629, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}},