 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Newswallah: Bharat Edition', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-15T09:20:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/9c0577c3-05bf-5bdb-82a8-3bf0efa345fd', 'word_count': 365, 'uri': 'nyt://article/9c0577c3-05bf-5bdb-82a8-3bf0efa345fd'}, {'abstract': 'Leobardo Espinoza Jr., a student at Topeka High School in Kansas, is one of eight high school seniors around the world who are blogging about their college searches.', 'web_url': 'https://thechoice.blogs.nytimes.com/2012/09/15/envelope-please-leobardo-espinoza-jr-1/', 'snippet': 'Leobardo Espinoza Jr., a student at Topeka High School in Kansas, is one of eight high school seniors around the world who are blogging about their college searches.', 'lead_paragraph': 'My full name is Leobardo Espinoza Jr., but everyone here calls me Leo. It’s shorter to say and easier for everyone to understand. I was born in California and moved to Topeka, Kan., when I was in the sixth grade.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/03/education/envpls13-leobardo-espinoza-jr/envpls13-leobardo-espinoza-jr-articleLarge.jpg', 'height': 796, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/03/education/envpls13-leobardo-espinoza-jr/envpls13-leobardo-espinoza-jr-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 796}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2