name': 'Lacava', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd6da8b8-85fd-5595-9a2b-6a9ee03303d6', 'word_count': 169, 'uri': 'nyt://article/fd6da8b8-85fd-5595-9a2b-6a9ee03303d6'}, {'abstract': 'The efforts to extradite Julian Assange and Abu Hamza al-Masri raise the question: How can democratic governments reaffirm their commitment to free speech while at the same time maintaining security?', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/09/28/debating-the-limits-of-free-speech/', 'snippet': 'The efforts to extradite Julian Assange and Abu Hamza al-Masri raise the question: How can democratic governments reaffirm their commitment to free speech while at the same time maintaining security?', 'lead_paragraph': 'LONDON – It was one of the more curious asides of this week’s annual procession at the United Nations General Assembly of heads of states airing their differences, setting out their political stalls and maneuvering for position both internationally and before their audiences and voters at home.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/28/blogs/ihtrdv-assange-2809/ihtrdv-assange-2809-jumbo.jpg', 'height': 752, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/28/blogs/ihtrdv-assange-2809/ihtrdv-assange-2809-superJumbo.jpg', 'height': 1468, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Debating the Limits of Free Speech', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Assange, Julian P', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Masri, Abu Hamza al-', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'General Assembly (UN)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'WikiLeaks', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Sweden', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-09-28T14:01:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Alan Cowell', 'person': [{'firstname': 'Alan', 'middlename': None, 'lastname': 'Cowell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d60a3520-0082-51eb-a991-ae3446462048', 'word_count': 581, 'uri': 'nyt://article/d60a3520-0082-51eb-a991-ae3446462048'}, {'abstract': 'Building Blocks: The three principal public areas of the Lesbian, Gay, Bisexual and Transgender Community Center in Greenwich Village are expected to undergo a 14-month, $7.5 million renovation.', 'web_url': 'https://cityroom.blogs.nytimes.com/2012/09/28/gay-center-to-make-its-village-home-more-open-and-less-noisy/', 'snippet': 'Building Blocks: The three principal public areas of the Lesbian, Gay, Bisexual and Transgender Community Center in Greenwich Village are expected to undergo a 14-month, $7.5 million renovation.', 'lead_paragraph': 'The love that now dares speak its name can still sometimes be hard to hear.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Gay Center to Make Its Village Home More Open and Less Noisy', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murals', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich Village (NYC)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-28T14:02:48+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By David W. Dunlap', 'person': [{'firstname': 'David', 'middlename': 'W.', 'lastname': 'Dunlap', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/393e059d-991b-59d1-960c-046efd9c9873', 'word_count': 623, 'uri': 'nyt://article/393e059d-991b-59d1-960c-046efd9c9873'}, {'abstract': 'Strom Thurmond, champion of segregation, was also a major figure in modern conservative politics.', 'web_url': 'https://www.nytimes.com/2012/09/30/books/review/strom-thurmonds-america-by-joseph-crespino.html', 'snippet': 'Strom Thurmond, champion of segregation, was also a major figure in modern conservative politics.', 'lead_paragraph': 'When Senator Strom Thurmond of South Carolina died in 2003 at the age of 100, he seemed to embody the term “political survivor.” Think of someone who began his career as a Roose\xadvelt Democrat and finished it as a Reagan Republican, who campaigned for president as a white supremacist and ended up supporting a national holiday for Martin Luther King. Decades passed, one generation replaced another, but Thurmond soldiered on, swapping causes, even political parties, with a juggler’s eye. Where many politicians become objects of contempt or indifference over time, with Thurmond the reverse was true: the longer he lasted, the more revered he became. ', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30OSHINSKY/30OSHINSKY-jumbo.jpg', 'height': 959, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30OSHINSKY/30OSHINSKY-superJumbo.jpg', 'height': 1918, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30OSHINSKY/30OSHINSKY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/30/books/review/30OSHINSKY/30OSHINSKY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30OSHINSKY/30OSHINSKY-thumbLarge.jpg', 'height': 151, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'From the Old South to the New Right', 'kicker': None, 'content_kicker': None, 'print_headline': 'From the Old South to the New Right', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Crespino, Joseph', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Thurmond, Strom', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-28T14:08:21+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By David Oshinsky', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Oshinsky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6479720c-0cfe-5ca7-af36-32d4d335ca56', 'word_count': 1203, 'uri': 'nyt://article/6479720c-0cfe-5ca7-af36-32d4d335ca56'}, {'abstract': 'Before there was a religious right, there was a religious left.', 'web_url': 'https://www.nytimes.com/2012/09/30/books/review/moral-minority-by-david-r-swartz.html', 'snippet': 'Before there was a religious right, there was a religious left.', 'lead_paragraph': 'In 1968, Mark Hatfield, one of America’s most prominent evangelical politicians, wanted to abolish the draft and clandestinely wore a Eugene McCarthy pin under his lapel. A Republican senator from Oregon, Hatfield had fans in evangelical churches around the country. When organizers of the 1973 National Prayer Breakfast invited him to address Richard Nixon, Henry Kissinger and other conservative luminaries (the Vietnam War was a “national sin and disgrace,” he told them), he based his remarks on a text written by a renegade seminarian named Jim Wallis — a former member of Students for a Democratic Society who believed that being “pro-life” meant hating war and poverty as much as abortion.', 'print_section': 'BR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30WORTHEN/30WORTHEN-jumbo.jpg', 'height': 750, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30WORTHEN/30WORTHEN-superJumbo.jpg', 'height': 1439, 'width': 1966, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30WORTHEN/30WORTHEN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/30/books/review/30WORTHEN/30WORTHEN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30WORTHEN/30WORTHEN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pro-Life, Pro-Left', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pro-Life, Pro-Left', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Swartz, David R', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Civil Rights and Liberties', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-28T14:12:29+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Molly Worthen', 'person': [{'firstname': 'Molly', 'middlename': None, 'lastname': 'Worthen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e3a9e4aa-743a-5158-867b-2988b739c477', 'word_count': 1298, 'uri': 'nyt://article/e3a9e4aa-743a-5158-867b-2988b739c477'}, {'abstract': 'Steve Stern’s fiction weaves the mischievous and the wondrous.', 'web_url': 'https://www.nytimes.com/2012/09/30/books/review/the-book-of-mischief-by-steve-stern.html', 'snippet': 'Steve Stern’s fiction weaves the mischievous and the wondrous.', 'lead_paragraph': 'Steve Stern’s characters — Shimmele, Avi, Fagie, Morty, Mendy, Mushie — are escape artists. They want to escape doting, caviling parents, the injunctions of Mosaic law and a stifling “atmosphere where sedulous study was valued above action.” They want, in other words, to escape Judaism.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30RICH/30RICH-jumbo.jpg', 'height': 1024, 'width': 1022, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30RICH/30RICH-superJumbo.jpg', 'height': 1867, 'width': 1863, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30RICH/30RICH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/30/books/review/30RICH/30RICH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/30RICH/30RICH-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Save Us', 'kicker': None, 'content_kicker': None, 'print_headline': 'Save Us', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Stern, Steve', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-28T14:23:11+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Nathaniel Rich', 'person': [{'firstname': 'Nathaniel', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/eb61ddaa-0f81-5630-836a-679632aebbb0', 'word_count': 1328, 'uri': 'nyt://article/eb61ddaa-0f81-5630-836a-679632aebbb0'}, {'abstract': 'A satire of the Iraq war and the often chaotic world of those not facing enemy fire.', 'web_url': 'https://www.nytimes.com/2012/09/30/books/review/fobbit-by-david-abrams.html', 'snippet': 'A satire of the Iraq war and the often chaotic world of those not facing enemy fire.', 'lead_paragraph': 'In the American wars of the 20th century, soldiers of the rear echelon were derided as “in the rear with the gear,” or worse. However, the whole concept of a “rear,” predicated on a definable “front,” started slipping in Vietnam and met its official death in Somalia. By the time of the Iraq occupation, the place where clerks did their clerking and infantrymen got a plate of hot chow was no longer in a relatively safe rear area but in the forward operating base, or FOB, smack in the middle of everything, and the soldiers stationed there became known as Fobbits.', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/0930-bks-bauman-03/0930-bks-bauman-03-jumbo.jpg', 'height': 1024, 'width': 671, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/0930-bks-bauman-03/0930-bks-bauman-03-superJumbo.jpg', 'height': 2048, 'width': 1342, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/30/books/review/0930-bks-bauman-03/0930-bks-bauman-03-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/30/books/review/0930-bks-bauman-03/0930-bks-bauman-03-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailh