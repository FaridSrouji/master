: None}, 'type_of_material': 'News', '_id': 'nyt://article/7ddd9dae-564a-57b8-b8bc-2f777f5a71bd', 'word_count': 510, 'uri': 'nyt://article/7ddd9dae-564a-57b8-b8bc-2f777f5a71bd'}, {'abstract': 'After Apple’s maps service in its new iOS 6 operating system was greeted with widespread criticism, the company said Thursday saying that it was working hard to improve the technology.', 'web_url': 'https://bits.blogs.nytimes.com/2012/09/20/apple-on-its-ios-6-maps-things-can-only-get-better/', 'snippet': 'After Apple’s maps service in its new iOS 6 operating system was greeted with widespread criticism, the company said Thursday saying that it was working hard to improve the technology.', 'lead_paragraph': 'Maybe Apple should have slapped beta — the label it reserves for unpolished technologies like Siri — on its new maps application. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/technology/18pogue-ios6/18pogue-ios6-jumbo.jpg', 'height': 847, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/technology/18pogue-ios6/18pogue-ios6-superJumbo.jpg', 'height': 1695, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/18/technology/18pogue-ios6/18pogue-ios6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/18/technology/18pogue-ios6/18pogue-ios6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Apple on Its iOS 6 Maps: Things Can Only Get Better', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Maps', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-20T23:55:08+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Nick Wingfield', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Wingfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9744803c-bfb4-5787-adec-34e255590720', 'word_count': 390, 'uri': 'nyt://article/9744803c-bfb4-5787-adec-34e255590720'}, {'abstract': 'A historian’s finding of a fragment of ancient Coptic text in which Jesus is said to utter the words “my wife” has drawn strong reaction from Christian scholars.', 'web_url': 'https://www.nytimes.com/2012/09/21/us/papyrus-fragment-that-refers-to-jesus-wife-stirs-debate.html', 'snippet': 'A historian’s finding of a fragment of ancient Coptic text in which Jesus is said to utter the words “my wife” has drawn strong reaction from Christian scholars.', 'lead_paragraph': 'When Karen L. King, a historian of early Christianity, announced this week that she had identified a fragment of ancient Coptic text in which Jesus utters the words “my wife,” she said she was making the finding public — despite many unresolved questions — so that her academic colleagues could weigh in.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/us/21jesus_inline/21jesus_inline-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/us/21jesus_inline/21jesus_inline-superJumbo.jpg', 'height': 2048, 'width': 1365, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/us/21jesus_inline/21jesus_inline-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/us/21jesus_inline/21jesus_inline-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/us/21jesus_inline/21jesus_inline-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Coptic Scholars Doubt and Hail a Reference to Jesus’ Wife', 'kicker': None, 'content_kicker': None, 'print_headline': 'Coptic Scholars Doubt and Hail A Reference To Jesus’ Wife', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Christians and Christianity', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jesus Christ', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'King, Karen Leigh', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Bible', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-20T23:55:55+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Laurie Goodstein', 'person': [{'firstname': 'Laurie', 'middlename': None, 'lastname': 'Goodstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/01ca2059-2e07-50ea-9725-e076d306dfd6', 'word_count': 850, 'uri': 'nyt://article/01ca2059-2e07-50ea-9725-e076d306dfd6'}, {'abstract': 'David France’s documentary “How to Survive a Plague” is a history of the fiery force of Act Up in the life-or-death fight for drugs to treat AIDS.', 'web_url': 'https://www.nytimes.com/2012/09/21/movies/how-to-survive-a-plague-aids-documentary-by-david-france.html', 'snippet': 'David France’s documentary “How to Survive a Plague” is a history of the fiery force of Act Up in the life-or-death fight for drugs to treat AIDS.', 'lead_paragraph': 'The currents of rage, fear, fiery determination and finally triumph that crackle through David France’s inspiring documentary, “How to Survive a Plague,” lend this history of the AIDS Coalition to Unleash Power a scorching electrical charge. This aggressive gay activist organization, better known as Act Up, formed in New York in 1987 and became the irresistible force that made seemingly immovable objects — government agencies and drug companies — give way, develop new treatments and speed them to the market as the AIDS epidemic spread unchecked among the gay population. ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HOW_SPAN/21HOW_SPAN-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/21/arts/21HOW_SPAN/21HOW_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HOW_SPAN/HOW-jumbo.jpg', 'height': 698, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HOW_SPAN/HOW-superJumbo.jpg', 'height': 1397, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HOW_SPAN/21HOW_SPAN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/arts/21HOW_SPAN/21HOW_SPAN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/21HOW_SPAN/21HOW_SPAN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'They Wouldn’t Take No for an Answer in the Battle Against AIDS', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'They Wouldn’t Take No for an Answer in the Battle Against AIDS', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Homosexuality', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Acquired Immune Deficiency Syndrome', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'France, David', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'How to Survive a Plague (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-20T23:57:09+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/1a0876a2-f789-50cf-9904-8a939f211a0d', 'word_count': 644, 'uri': 'nyt://article/1a0876a2-f789-50cf-9904-8a939f211a0d'}, {'abstract': 'The N.F.L. and the union that represents its locked-out officials talked this week in an effort to reach an agreement that would end the use of the widely criticized replacement officials.', 'web_url': 'https://www.nytimes.com/2012/09/21/sports/football/nfl-roundup.html', 'snippet': 'The N.F.L. and the union that represents its locked-out officials talked this week in an effort to reach an agreement that would end the use of the widely criticized replacement officials.', 'lead_paragraph': 'The N.F.L. and the union that represents its locked-out officials talked this week in an effort to reach an collective bargaining agreement that would end the use of the widely criticized replacement officials, according to a person briefed on the negotiations.', 'print_section': 'B', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'League and Officials in Talks to End Lockout', 'kicker': 'N.F.L. Roundup', 'content_kicker': None, 'print_headline': 'Jets’ Revis Is Cleared for Contact After Missing a Game With a Concussion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Football League', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Revis, Darrelle', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Buffalo Bills', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Lockouts', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-21T00:01:27+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd519b1b-ebc5-531d-b0a0-bc1419dbf84f', 'word_count': 510, 'uri': 'nyt://article/dd519b1b-ebc5-531d-b0a0-bc1419dbf84f'}, {'abstract': 'The “weather girl” on the NBC radio show “Monitor” in the late 1950s and early ’60s, Ms. Thurman made the forecasts “sound like an irresistible invitation to an unforgettable evening.”', 'web_url': 'https://www.nytimes.com/2012/09/21/arts/tedi-thurman-miss-monitor-weather-girl-dies-at-89.html', 'snippet': 'The “weather girl” on the NBC radio show “Monitor” in the late 1950s and early ’60s, Ms. Thurman made the forecasts “sound like an irresistible invitation to an unforgettable evening.”', 'lead_paragraph': 'At 5-foot-7, with sea-blue eyes, flowing red hair, chiseled cheeks and a shapely figure, Tedi Thurman was a stunner. But it was her breathy, alluring voice that brought her fame. ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/THURMAN-obit/THURMAN-obit-jumbo.jpg', 'height': 1024, 'width': 369, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/THURMAN-obit/THURMAN-obit-superJumbo.jpg', 'height': 2048, 'width': 737, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/THURMAN-obit/THURMAN-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/21/arts/THURMAN-obit/THURMAN-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/arts/THURMAN-obit/THURMAN-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tedi Thurman Dies at 89; Radio’s Miss Monitor', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tedi Thurman, 89, Radio&#8217;s Miss Monitor', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weather', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Thurman, Tedi', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Radio', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Broadcasting Co', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-21T00:02:22+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Dennis Hevesi', 'person': [{'firstname': 'Dennis', 'middlename': None, 'lastname': 'Hevesi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/786a91b5-1a44-5cd8-b21d-8ca6644fc42f', 'word_count': 498, 'uri': 'nyt://article/786a91b5-1a44-5cd8-b21d-8ca6644fc42f'}, {'abstract': 'Thousands demonstrated in the capital, Islamabad, on the eve of a public holiday to protest an anti-Islam video, while the United States Embassy broadcast ads showing American leaders denouncing the video.', 'web_url': 'https://www.nytimes.com/2012/09/21/world/asia/violence-over-anti-islam-video-continues-in-pakistan.html', 'snippet': 'Thousands demonstrated in the capital, Islamabad, on the eve of a public holiday to protest an anti-Islam video, while the United States Embassy broadcast ads showing American leaders denouncing the video.', 'lead_paragraph': 'ISLAMABAD, Pakistan — On the eve of a public holiday to protest an anti-Islam video made in the United States, thousands of demonstrators battled with police officers for hours on Thursday near the capital’s diplomatic quarter, and the United States Embassy broadcast advertisements on local television stations showing American leaders denouncing the video. ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/world/protest/p