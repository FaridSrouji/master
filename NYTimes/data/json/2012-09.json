thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/07/arts/07BOOK1/07BOOK1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Soldiering Amid Hyacinths and Horror', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Soldiering Amid Hyacinths And Horror', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Powers, Kevin C (1980- )', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Yellow Birds (Book)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-06T15:56:06+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Books', 'byline': {'original': 'By Michiko Kakutani', 'person': [{'firstname': 'Michiko', 'middlename': None, 'lastname': 'Kakutani', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/03162500-7b6e-5770-aa7a-7f1362942fa7', 'word_count': 937, 'uri': 'nyt://article/03162500-7b6e-5770-aa7a-7f1362942fa7'}, {'abstract': 'Digital technology is changing movies in such groundbreaking ways that “film” is usually a word of convenience and tradition.', 'web_url': 'https://www.nytimes.com/2012/09/09/movies/how-digital-is-changing-the-nature-of-movies.html', 'snippet': 'Digital technology is changing movies in such groundbreaking ways that “film” is usually a word of convenience and tradition.', 'lead_paragraph': 'IN the beginning there was light that hit a strip of flexible film mechanically running through a camera. For most of movie history this is how moving pictures were created: light reflected off people and things would filter through a camera and physically transform emulsion. After processing, that light-kissed emulsion would reveal Humphrey Bogart chasing the Maltese Falcon in shimmering black and white. ', 'print_section': 'AR', 'print_page': '41', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/arts/09CRITIC4/09CRITIC4-articleLarge.jpg', 'height': 372, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/09/arts/09CRITIC4/09CRITIC4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 372}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/arts/09CRITIC4/09JPCRITICS3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/arts/09CRITIC4/09JPCRITICS3-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/arts/09CRITIC4/09CRITIC4-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/arts/09CRITIC4/09CRITIC4-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/arts/09CRITIC4/09CRITIC4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Film Is Dead? Long Live Movies', 'kicker': 'The New Season', 'content_kicker': None, 'print_headline': 'Film Is Dead? Long Live Movies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-06T16:00:50+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis and A.O. Scott', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a96db5cd-9033-5dfa-a5c5-7698482728cc', 'word_count': 2204, 'uri': 'nyt://article/a96db5cd-9033-5dfa-a5c5-7698482728cc'}, {'abstract': 'It’s important that the public editor’s job at The New York Times be a two-way street, or even one of those insane intersections where traffic is going every which way.', 'web_url': 'https://publiceditor.blogs.nytimes.com/2012/09/06/three-days-in-the-fishbowl-and-here-to-tell-the-tale/', 'snippet': 'It’s important that the public editor’s job at The New York Times be a two-way street, or even one of those insane intersections where traffic is going every which way.', 'lead_paragraph': '“Welcome to the fishbowl,” the corporate spokeswoman Eileen Murphy told me a few weeks back when I was named public editor at The New York Times. She was right. The scrutiny began immediately, in the form of interviews, commentary from pundits, welcoming messages on Twitter and the dredging up of old stories I’d written and forgotten.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Three Days in the Fishbowl, and Here to Tell the Tale', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-06T16:02:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/015b8e6c-9c00-5064-82de-2f94a499b6ae', 'word_count': 482, 'uri': 'nyt://article/015b8e6c-9c00-5064-82de-2f94a499b6ae'}, {'abstract': 'Pizza Brain, a pizza parlor that is home to the world’s largest collection of pizza memorabilia, opens Friday in Philadelphia.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/09/06/worlds-first-pizza-museum-opening-in-philadelphia/', 'snippet': 'Pizza Brain, a pizza parlor that is home to the world’s largest collection of pizza memorabilia, opens Friday in Philadelphia.', 'lead_paragraph': 'Visit any of the nation’s more than 60,000 pizza joints, and you will find plenty of people who believe that the perfect pie is a work of art. Certainly, pizza has become as embedded in American cuisine and culture as the hamburger and apple pie.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'World’s First Pizza Museum Opening in Philadelphia', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Museums', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pizza', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Philadelphia (Pa)', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-06T16:09:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Vindu Goel', 'person': [{'firstname': 'Vindu', 'middlename': None, 'lastname': 'Goel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08a0ac44-5bac-5f80-bbfb-6015c3648aa2', 'word_count': 419, 'uri': 'nyt://article/08a0ac44-5bac-5f80-bbfb-6015c3648aa2'}, {'abstract': 'Every girl, Jewish or Muslim, wonders: how it is that some girls get 