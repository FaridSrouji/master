ess conference.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Call From The Kremlin', 'kicker': 'Latitude', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ANIMALS', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of the Press', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-16T13:48:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Masha Gessen', 'person': [{'firstname': 'Masha', 'middlename': None, 'lastname': 'Gessen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/66afdb3c-453f-5f2a-a643-fceaab455e84', 'word_count': 1368, 'uri': 'nyt://article/66afdb3c-453f-5f2a-a643-fceaab455e84'}, {'abstract': 'London', 'web_url': 'https://www.nytimes.com/slideshow/2012/09/16/fashion/runway-womens/preen-spring-2013-rtw.html', 'snippet': 'London', 'lead_paragraph': 'London', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/fashion/runway-womens/preen_spring13app-slide-Y8XC/preen_spring13app-slide-Y8XC-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/16/fashion/runway-womens/preen_spring13app-slide-Y8XC/preen_spring13app-slide-Y8XC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/16/fashion/runway-womens/preen_spring13app-slide-Y8XC/preen_spring13app-slide-