ker': None, 'print_headline': 'Student Fatally Stabbed in Manhattan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Beckles, Theodore', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-21T02:21:11+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/99bd0efa-6fcb-50ab-b21b-7407096d5315', 'word_count': 137, 'uri': 'nyt://article/99bd0efa-6fcb-50ab-b21b-7407096d5315'}, {'abstract': 'A South Korean phenomenon behind a dance video called “Gangnam Style” got an even clearer sign of success when North Korea parodied the video.', 'web_url': 'https://www.nytimes.com/2012/09/21/world/asia/gangnam-style-video-gets-north-korean-propaganda-treatment.html', 'snippet': 'A South Korean phenomenon behind a dance video called “Gangnam Style” got an even clearer sign of success when North Korea parodied the video.', 'lead_paragraph': 'SEOUL, South Korea — Ordinarily, a star turn on “The Ellen DeGeneres Show” teaching Britney Spears his dance might be one of the surest signs that a performer has made it. But this week, Park Jae-sang, the South Korean phenomenon behind a dance video called Gangnam Style, got an even clearer sign of success. North Korea — so cut off from the world that satellite shots show most of the country plunged in darkness at night — parodied the video.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/21/world/21gangnam_337/21gangnam_337-jumbo.jpg', 'height': 666, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption