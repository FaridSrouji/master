value': 'MC10 Inc', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'NIKE Inc', 'rank': 9, 'major': 'N'}], 'pub_date': '2012-09-07T14:37:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By Quentin Hardy', 'person': [{'firstname': 'Quentin', 'middlename': None, 'lastname': 'Hardy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f17c96c8-ef2a-5a46-a9ea-2e81895cd2bd', 'word_count': 883, 'uri': 'nyt://article/f17c96c8-ef2a-5a46-a9ea-2e81895cd2bd'}, {'abstract': 'A Chinese noodle parlor that opened in June is finally in full swing.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/09/07/niu-noodle-house-not-quite-new-but-up-to-speed/', 'snippet': 'A Chinese noodle parlor that opened in June is finally in full swing.', 'lead_paragraph': 'Niu Noodle House, a Chinese noodle and dumpling parlor done in 1940s style, opened in late June. But the chef, Lo Lung Kit, had to return to China to straighten out his visa and did not return until late August. Now the restaurant is in full swing. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Niu Noodle House: Not Quite New, but Up to Speed', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Noodles', 'rank': 1, 'major': 'N'}], 'pub_date': '2012-09-07T14:39:24+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/544074f0-7d74-5518-9052-d095a0a6bbd7', 'word_count': 84, 'uri': 'nyt://article/544074f0-7d74-5518-9052-d095a0a6bbd7'}, {'abstract': 'ESPN Deportes, the Spanish-language division of ESPN, has reached a three-year agreement with the New York Jets to broadcast their games in Spanish.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/09/07/espn-radio-to-broadcast-jets-games-in-spanish-in-new-york/', 'snippet': 'ESPN Deportes, the Spanish-language division of ESPN, has reached a three-year agreement with the New York Jets to broadcast their games in Spanish.', 'lead_paragraph': '11:56 a.m. | Updated The New York Jets had a rough preseason this year, but they will soon have a chance to make a fresh start, this time in Spanish.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'ESPN Radio to Broadcast Jets Games in Spanish in New York', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Athletics and Sports', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Radio', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Spanish Language', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'ESPN', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-07T14:46:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Tanzina Vega', 'person': [{'firstname': 'Tanzina', 'middlename': None, 'lastname': 'Vega', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cad15e3c-72ed-5b2f-a47a-adad644d087f', 'word_count': 377, 'uri': 'nyt://article/cad15e3c-72ed-5b2f-a47a-adad644d087f'}, {'abstract': 'The birth of a fake-bronze breakthrough.', 'web_url': 'https://www.nytimes.com/2012/09/09/magazine/who-made-that-spray-tan.html', 'snippet': 'The birth of a fake-bronze breakthrough.', 'lead_paragraph': 'In the 1950s, Eva Wittgenstein, a researcher at a Cincinnati hospital who had been treating children with a rare metabolic disorder, noticed that when the medicine she was using splattered, it stained the patients’ bodies but not their clothes. Curious, Wittgenstein painted her own skin with the solution, which contained dihydroxyacetone (DHA). Within hours these patches turned brown. Soon the miraculous substance was bottled into products like Coppertone QT, which promised 1960s-style convenience: bronze yourself while you sleep; “tan groom” your legs, so you won’t need stockings. DHA produced the color changes by what was called a Maillard reaction, browning the top layer of human skin much the same way a steak browns as it cooks. The reaction turned some people as orange as Oompa-Loompas.', 'print_section': 'MM', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09wmt/09wmt-articleLarge-v2.jpg', 'height': 728, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/09/magazine/09wmt/09wmt-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 728}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09wmt/09wmt-jumbo-v2.jpg', 'height': 728, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09wmt/09wmt-superJumbo-v2.jpg', 'height': 728, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09wmt/09wmt-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/magazine/09wmt/09wmt-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09wmt/09wmt-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Who Made That Spray Tan?', 'kicker': 'Design', 'content_kicker': None, 'print_headline': 'Who Made That? (Spray Tan)', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cosmetics and Toiletries', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suntan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Inventions and Patents', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-07T14:49:53+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Pagan Kennedy', 'person': [{'firstname': 'Pagan', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8689a08d-cc3e-523c-b4a8-bab90825d8ce', 'word_count': 445, 'uri': 'nyt://article/8689a08d-cc3e-523c-b4a8-bab90825d8ce'}, {'abstract': 'The former California representative on Newsweek, catfights and why she left the House.', 'web_url': 'https://www.nytimes.com/2012/09/09/magazine/jane-harman-can-take-a-punch.html', 'snippet': 'The former California representative on Newsweek, catfights and why she left the House.', 'lead_paragraph': 'Last April, your 92-year-old husband, Sidney Harman, the owner of Newsweek, died after being given a diagnosis of leukemia a month before. Was there anything left he wanted to do?  He left an unfinished manuscript for a book called “Geezer Golf,” about how golf is a metaphor for life, and if you have an excellent short game, you can play with people 20 or 30 years younger, because although your drives are shorter, the rest of your game is better.', 'print_section': 'MM', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09talk/mag-09Talk-t_CA0-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09talk/mag-09Talk-t_CA0-superJumbo.jpg', 'height': 1500, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09talk/09talk-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/09/magazine/09talk/09talk-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09talk/09talk-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jane Harman Can Take a Punch', 'kicker': 'Talk', 'content_kicker': None, 'print_headline': 'Feeding The Beast', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Harman, Jane', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Harman, Sidney', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Newsweek', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-07T14:49:54+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Interview by Andrew Goldman', 'person': [{'firstname': 'Interview', 'middlename': 'Andrew', 'lastname': 'Goldman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interview', '_id': 'nyt://article/c38dbeea-32e4-5283-81d9-547876bdd7c8', 'word_count': 697, 'uri': 'nyt://article/c38dbeea-32e4-5283-81d9-547876bdd7c8'}, {'abstract': 'How Glenn Gould freed classical music from the concert hall.', 'web_url': 'https://www.nytimes.com/2012/09/09/magazine/30-variations-and-a-microphone.html', 'snippet': 'How Glenn Gould freed classical music from the concert hall.', 'lead_paragraph': 'Glenn Gould was booked into 30th Street Studio for the two middle weeks of June in 1955. The weather in New York was sunny, the temperature in the 60s. He arrived at the studio by taxi from a hotel near Central Park, wearing an overcoat, a beret, a scarf and gloves, and carrying a leather suitcase and his folding chair. He stripped down to a dress shirt and a sleeveless V-neck sweater. Opening the suitcase, he set out pills, bottled water and towels. Rolling up his sleeves, he ran hot water in a sink, the sort of deep-basin porcelain sink that mops are wrung out in, and soaked his hands and forearms until they were red.', 'print_section': 'MM', 'print_page': '48', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09riff/09riff-articleLarge.jpg', 'height': 80, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/09/magazine/09riff/09riff-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 80}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/09/magazine/09riff/mag-09Riff-t_CA0-jumbo.jpg', 'height': 173, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo'