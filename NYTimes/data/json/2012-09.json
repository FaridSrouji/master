web_url': 'https://wheels.blogs.nytimes.com/2012/09/21/in-greenville-s-c-the-first-shoots-of-an-e-v-ecosystem/', 'snippet': 'The Environmental Protection Agency recognized a project in South Carolina that had sought to ease access to and adoption of electric vehicles.', 'lead_paragraph': '“Environmental stewardship is not normally what you might expect from a town in the South, but we’re pretty different,” David Sudduth, the mayor pro tem of Greenville, S.C., said on Thursday. “Innovation is pretty popular here.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Greenville, S.C., the First Shoots of an E.V. Ecosystem', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electric and Hybrid Vehicles', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Enterprise Rent-A-Car Co', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'General Electric Company', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenville (SC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2012-09-21T10:00:07+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Jim Motavalli', 'person': [{'firstname': 'Jim', 'middlename': None, 'lastname': 'Motavalli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/af5426da-a65a-5989-8cde-1ac431431990', 'word_count': 460, 'uri': 'nyt://article/af5426da-a65a-5989-8cde-1ac431431990'}, {'abstract': 'Investing in education is not just morally right, but also provides a strong return on investment, an economist writes.', 'web_url': 'https://economix.blogs.nytimes.com/2012/09/21/income-inequality-and-educational-opportunity/', 'snippet': 'Investing in education is not just morally right, but also provides a strong return on investment, an economist writes.', 'lead_paragraph': 'Laura D’Andrea Tyson is a professor at the Haas School of Business at the University of California, Berkeley, and served as chairwoman of the Council of Economic Advisers under President Clinton. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Income Inequality and Educational Opportunity', 'kicker': 'Economix', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Children and Childhood', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Equal Educational Opportunities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Poverty', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 8, 'major': 'N'}], 'pub_date': '2012-09-21T10:00:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': "By Laura D'Andrea Tyson", 'person': [{'firstname': 'Laura', 'middlename': "D'andrea", 'lastname': 'Tyson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/76a4b6c9-bbdd-57bc-a688-612807a65121', 'word_count': 1171, 'uri': 'nyt://article/76a4b6c9-bbdd-57bc-a688-612807a65121'}, {'abstract': 'Political news from Friday’s Times, plus a look at what’s happening in Washington.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/09/21/the-early-word-china-2/', 'snippet': 'Political news from Friday’s Times, plus a look at what’s happening in Washington.', 'lead_paragraph': 'In Today’s Times:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Early Word: China', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-21T10:00:56+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Emmarie Huetteman', 'person': [{'firstname': 'Emmarie', 'middlename': None, 'lastname': 'Huetteman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/55205c8d-8f72-5ec7-88af-b901bd555d44', 'word_count': 211, 'uri': 'nyt://article/55205c8d-8f72-5ec7-88af-b901bd555d44'}, {'abstract': 'Violent crowds furious over an anti-Islamic video made in the United States convulsed Pakistan’s largest cities, leaving more than 160 people injured in a day of government-sanctioned protests.', 'web_url': 'https://www.nytimes.com/2012/09/22/world/asia/protests-in-pakistan-over-anti-islam-film.html', 'snippet': 'Violent crowds furious over an anti-Islamic video made in the United States convulsed Pakistan’s largest cities, leaving more than 160 people injured in a day of government-sanctioned protests.', 'lead_paragraph': 'ISLAMABAD, Pakistan — Violent crowds furious over an anti-Islamic video made in the United States convulsed Pakistan’s largest cities on Friday, leaving up to 19 people dead and more than 160 injured in a day of government-sanctioned protests. ', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/22/world/unrest1/unrest1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge