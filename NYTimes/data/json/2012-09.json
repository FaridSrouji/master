nt_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Turkey', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Syria', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and North Africa Unrest (2010- )', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-10T17:02:08+0000', 'document_type': 'multimedia', 'news_desk': 'ContinuousNews', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'Erik Olsen, Vijai Singh, Pedro Rosado and Nadia Sussman', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Olsen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Vijai', 'middlename': None, 'lastname': 'Singh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Pedro', 'middlename': None, 'lastname': 'Rosado', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}, {'firstname': 'Nadia', 'middlename': None, 'lastname': 'Sussman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 4}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/70fb327b-c7c0-500a-914f-82b153c068fc', 'word_count': 0, 'uri': 'nyt://video/70fb327b-c7c0-500a-914f-82b153c068fc'}, {'abstract': 'An annual porridge competition in Scotland inspires oatmeal dishes that go beyond the basic breakfast. Today: Steel-Cut Oats and Vegetable Torta.', 'web_url': 'https://www.nytimes.com/2012/09/10/health/nutrition/steel-cut-oats-sweet-and-savory.html', 'snippet': 'An annual porridge competition in Scotland inspires oatmeal dishes that go beyond the basic breakfast. Today: Steel-Cut Oats and Vegetable Torta.', 'lead_paragraph': 'A couple of years ago in the course of touring Bob’s Red Mill, the whole-foods purveyor based in Portland, Ore., I learned a new word: spurtle. A spurtle is a wooden dowel-like implement used to stir oatmeal. They are common in Scotland, where an international porridge-making competition called the Golden Spurtle is held every year in October. There are two sections to the competition: one for plain porridge made with steel-cut oats (also known as pinhead oats) and nothing more than water and salt; and one for specialty porridges, in which the steel-cut oats are used in a dish with other ingredients, sweet or savory.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/11/science/10recipehealth-1347296320547/10recipehealth-1347296320547-articleLarge-v2.jpg', 'height': 408, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/11/science/10recipehealth-1347296320547/10recipehealth-1347296320547-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 408}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/11/science/10recipehealth-1347296320547/10recipehealth-1347296320547-jumbo-v2.jpg', 'height': 696, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/11/science/10recipehealth-1347296320547/10recipehealth-1347296320547-superJumbo-v2.jpg', 'height': 1391, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/11/science/10recipehealth-1347296320547/10recipehealth-1347296320547-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/11/science/10recipehealth-1347296320547/10recipehealth-1347296320547-thumbStandard-v2.jpg', 'thumbnail