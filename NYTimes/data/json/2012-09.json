ported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4c86ff60-901d-541e-a22f-d4c41a30e5d1', 'word_count': 1001, 'uri': 'nyt://article/4c86ff60-901d-541e-a22f-d4c41a30e5d1'}, {'abstract': 'The Republican candidate for Senate in Missouri has been largely abandoned by the party establishment, but home-schoolers have remained loyal.', 'web_url': 'https://www.nytimes.com/2012/09/26/us/politics/todd-akin-counts-on-support-of-home-schoolers.html', 'snippet': 'The Republican candidate for Senate in Missouri has been largely abandoned by the party establishment, but home-schoolers have remained loyal.', 'lead_paragraph': 'HARRISONVILLE, Mo. — On a recent Wednesday, when many teenagers here were doing homework or playing after-school sports, 17-year-old Ania Bishop, in an ankle-length skirt with American flags, was cheering at a political rally for Representative Todd Akin. ', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/us/AKIN-1/AKIN-1-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/26/us/AKIN-1/AKIN-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/us/AKIN-1/AKIN-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/26/us/AKIN-1/AKIN-1-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'One Coalition Stays True to Todd Akin: Home-Schoolers', 'kicker': None, 'content_kicker': None, 'print_headline': 'One Coalition Stays