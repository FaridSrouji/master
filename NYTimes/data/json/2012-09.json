The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/20/us/ENDEVOUR-1/ENDEVOUR-1-jumbo.jpg', 'height': 733, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/20/us/ENDEVOUR-1/ENDEVOUR-1-superJumbo.jpg', 'height': 1467, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/20/us/ENDEVOUR-1/ENDEVOUR-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/20/us/ENDEVOUR-1/ENDEVOUR-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/20/us/ENDEVOUR-1/ENDEVOUR-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Endeavour’s Last Journey, Through Contentious Space', 'kicker': None, 'content_kicker': None, 'print_headline': 'Endeavour’s Last Journey, Through Contentious Space', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Space Shuttles', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Los Angeles (Calif)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'California Science Center', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Endeavour (Space Shuttle)', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-20T00:22:02+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Ian Lovett', 'person': [{'firstname': 'Ian', 'middlename': None, 'lastname': 'Lovett', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8d2c8f4a-7ff9-50a3-9c92-b809a05481cb', 'word_count': 887, 'uri': 'nyt://article/8d2c8f4a-7ff9-50a3-9c92-b809a05481cb'}, {'abstract': 'Mr. Green was a widely respected editor who shepherded more than 500 books into print, including the autobiography of Walter Cronkite and the works of Gabriel García Márquez.', 'web_url': 'https://www.nytimes.com/2012/09/20/books/ashbel-green-longtime-editor-at-knopf-dies-at-84.html', 'snippet': 'Mr. Green was a widely respected editor who shepherded more than 500 books into print, including the autobiography of Walter Cronkite and the works of Gabriel García Márquez.', 'lead_paragraph': 'Ashbel Green, a widely respected editor in the publishing industry who shepherded more than 500 books into print for Alfred A. Knopf, including detective novels, the autobiography of Walter Cronkite and the works of Gabriel García Márquez, died on Tuesday in Westerly, R.I. He was 84.', 'print_section': 'B', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/20/arts/GREEN-obit/GREEN-obit-jumbo.jpg', 'height': 1024, 'width': 709, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/20/arts/GREEN-obit/GREEN-obit-superJumbo.jpg', 'height': 2048, 'width': 1418, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/20/arts/GREEN-obit/GREEN-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/20/arts/GREEN-obit/GREEN-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype'