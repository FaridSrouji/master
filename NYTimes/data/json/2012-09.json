rge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Baltimore Scenes', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Baltimore (Md)', 'rank': 2, 'major': 'N'}], 'pub_date': '2012-09-19T17:35:48+0000', 'document_type': 'multimedia', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/65c974bf-8eb9-5236-b542-9e1f8c2b7b02', 'word_count': 0, 'uri': 'nyt://slideshow/65c974bf-8eb9-5236-b542-9e1f8c2b7b02'}, {'abstract': 'Ten of the world’s largest pharmaceutical companies said they would form a nonprofit group to help accelerate drug development.', 'web_url': 'https://www.nytimes.com/2012/09/20/health/drug-makers-in-joint-effort-to-streamline-research.html', 'snippet': 'Ten of the world’s largest pharmaceutical companies said they would form a nonprofit group to help accelerate drug development.', 'lead_paragraph': 'Ten of the world’s largest pharmaceutical companies said on Wednesday that they would cooperate on research aimed at accelerating drug development, starting with streamlining clinical trials. ', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Drug Makers Join Efforts in Research', 'kicker': None, 'content_kicker': None, 'print_headline': 'Drug Makers Join Efforts in Research', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Clinical Trials', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Nonprofit Organizations', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-19T17:37:13+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Health', 'byline': {'original': 'By Andrew Pollack', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Pollack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/12ecb0eb-4dd9-57ce-ab42-cb423416525f', 'word_count': 580, 'uri': 'nyt://article/12ecb0eb-4dd9-57ce-ab42-cb423416525f'}, {'abstract': 'A left-leaning magazine is garnering attention with the release of a video showing Mitt Romney calling 47 percent of the public “dependent” on government and feeling like victims entitled to help.', 'web_url': 'https://www.nytimes.com/2012/09/20/business/media/mother-jones-grabs-attention-with-romney-report.html', 'snippet': 'A left-leaning magazine is garnering attention with the release of a video showing Mitt Romney calling 47 percent of the public “dependent” on government and feeling like victims entitled to help.', 'lead_paragraph': 'Mother Jones, the left-leaning magazine that was founded above a McDonald’s restaurant in San Francisco 36 years ago, found itself lavished this week with the kind of attention usually reserved for larger news outlets. And that is not a bad thing for a nonprofit publication with a circulation of just over 200,000 and a business model partly dependent on its readers’ largess.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Video of Romney Turns Spotlight on a Magazine', 'kicker': None, 'content_kicker': None, 'print_headline': 'Video of Romney Turns Spotlight on a Magazine', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Video Recordings and Downloads', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Mother Jones', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Magazines', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-19T17:37:44+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Christine Haughney', 'person': [{'firstname': 'Christine', 'middlename': None, 'lastname': 'Haughney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0486fc93-84b3-5b1b-9d16-8e19cfccb371', 'word_count': 602, 'uri': 'nyt://article/0486fc93-84b3-5b1b-9d16-8e19cfccb371'}, {'abstract': 'Add Senator Dean Heller of Nevada to the ranks of Republican political candidates distancing themselves from Republican presidential nominee.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2012/09/19/another-g-o-p-lawmaker-says-he-disagrees-with-romneys-comments/', 'snippet': 'Add Senator Dean Heller of Nevada to the ranks of Republican political candidates distancing themselves from Republican presidential nominee.', 'lead_paragraph': 'Add Senator Dean Heller of Nevada to the ranks of Republican political candidates distancing themselves from Mitt Romney and his comments that 47 percent of Americans\xa0 are dependent on the government and view themselves as victims.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Another G.O.P. Lawmaker Says He Disagrees With Romney’s Comments', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections, Senate', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Heller, Dean', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Nevada', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-19T17:37:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Weisman', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Weisman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/11726686-5889-5d92-843d-4dbdb6f283e9', 'word_count': 218, 'uri': 'nyt://article/11726686-5889-5d92-843d-4dbdb6f283e9'}, {'abstract': 'When the Mad. Sq. Eats festival opens on Friday, a Roman snack may upstage its New York counterparts.', 'web_url': 'https://dinersjournal.blogs.nytimes.com/2012/09/19/a-madison-square-treat-from-rome/', 'snippet': 'When the Mad. Sq. Eats festival opens on Friday, a Roman snack may upstage its New York counterparts.', 'lead_paragraph': 'New York has enjoyed a spectacular shift in the quality, quantity and variety of its street food in the past five years. Rome, however, has more or less remained wedded to fried rice balls and square pizza slices despite its millennial history of fast and cheap street food. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Madison Square Treat, From Rome', 'kicker': 'Diner&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-19T17:41:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Style', 'byline': {'original': 'By Katie Parla', 'person': [{'firstname': 'Katie', 'middlename': None, 'lastname': 'Parla', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ae454692-3857-5b07-aa7f-3caf7f1d3662', 'word_count': 482, 'uri': 'nyt://article/ae454692-3857-5b07-aa7f-3caf7f1d3662'}, {'abstract': 'Both books, “Crazy Salad: Some Things About Women” and “Scribble, Scribble: Notes on Media,” were originally released in the 1970s.', 'web_url': 'https://mediadecoder.blogs.nytimes.com/2012/09/19/two-out-of-print-nora-ephron-books-to-be-published-as-single-volume/', 'snippet': 'Both books, “Crazy Salad: Some Things About Women” and “Scribble, Scribble: Notes on Media,” were originally released in the 1970s.', 'lead_paragraph': 'Two out-of-print books by Nora Ephron will be reissued on Oct. 16 in a single-volume paperback and e-book edition, the publisher, Vintage Books, said on Wednesday. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Two Out-of-Print Nora Ephron Books to Be Published as Single Volume', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'Ephron Books Reissued', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Book Trade and Publishing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ephron, Nora', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Random House', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-19T17:42:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f70c218e-d034-5aa7-9f04-d9296f5605b2', 'word_count': 106, 'uri': 'nyt://article/f70c218e-d034-5aa7-9f04-d9296f5605b2'}, {'abstract': 'Why do the recent calls for reform in economics, politics, administration, even sports, by the Communist Party secretary of Guangdong matter? Because pressure to change often comes from the south in China.', 'web_url': 'https://rendezvous.blogs.nytimes.com/2012/09/19/a-bellwether-of-chinese-revolution/', 'snippet': 'Why do the recent calls for reform in economics, politics, administration, even sports, by the Communist Party secretary of Guangdong matter? Because pressure to change often comes from the south in China.', 'lead_paragraph': 'BEIJING — In Asia, much hinges on China. And in China, much has traditionally hinged on change from the south — from Guangdong province, an outward-looking giant of more than 100 million people next to Hong Kong. Its $840 billion economy is about as big as that of the Netherlands or Indonesia.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Bellwether of Chinese Revolution', 'kicker': 'IHT Rendezvous', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Reform and Reorganization', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Wang Yang (1955- )', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Communist Party of China', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Guangdong Province (China)', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-19T17:46:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'byline': {'original': 'By Didi Kirsten Tatlow', 'person': [{'firstname': 'Didi', 'middlename': 'Kirsten', 'lastname': 'Tatlow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2257ff77-e16a-518e-933e-023b599d1ccd', 'word_count': 383, 'uri': 'nyt://article/2257ff77-e16a-518e-933e-023b599d1ccd'}, {'abstract': 'If it is picked up as a series, “Criminal Justice” would feature Mr. Gandolfini in his first ongoing television role since his heralded run on “The Sopranos.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2012/09/19/james-gandolfini-to-star-in-new-pilot-for-hbo/', 'snippet': 'If it is picked up as a series, “Criminal Justice” would feature Mr. Gandolfini in his first ongoing television role since his heralded run on “The Sopranos.”', 'lead_paragraph': 'Just when he thought he was out, they pull him back in: HBO said on Wednesday that it had ordered the pilot episode of a new series that would star James Gandolfini in his first continuing role at that network (or anywhere else) since his heralded run on “The Sopranos,” confirming a report that appeared on Deadline.com. The new series, called “Criminal Justice,” is adapted from a BBC drama of the same title which, in two five-episode seasons, chronicled the lives of two different characters charged with murder; the HBO version will be written by Steven Zaillian (“Moneyball,” “Schindler’s List”) and Richard Price (“The Wire,” “Clockers”) and directed by Mr. Zaillian.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'James Gandolfini to Star in New Pilot for ‘HBO’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Gandolfini Back at HBO', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gandolfini, James', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Home Box Office', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-19T17:56:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da8aa7c4-4497-5d3e-b19c-b0bd628aa237', 'word_count': 192, 'uri': 'nyt://article/da8aa7c4-4497-5d3e-b19c-b0bd628aa237'}, {'abstract': 'Senator John Kerry said on Wednesday that aid to Iraq might be made contingent on cutting off flights shuttling military supplies from Iran to the repressive regime in Syria.', 'web_url': 'https://www.nytimes.com