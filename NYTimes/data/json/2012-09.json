: 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 3, 'major': 'N'}], 'pub_date': '2012-09-07T01:56:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24d64bb5-ff51-5794-b9fc-a77f87084e5f', 'word_count': 781, 'uri': 'nyt://article/24d64bb5-ff51-5794-b9fc-a77f87084e5f'}, {'abstract': '“Normalcy,” a new play by Bennett Windheim, deals the issue of transracial adoption.', 'web_url': 'https://www.nytimes.com/2012/09/07/theater/reviews/normalcy-at-peter-jay-sharp-theater.html', 'snippet': '“Normalcy,” a new play by Bennett Windheim, deals the issue of transracial adoption.', 'lead_paragraph': 'According to its publicity materials, “Normalcy,” a new drama at the Peter Jay Sharp Theater, “tackles themes of identity, race, terrorism, nationalism, manifest destiny, marriage and the media” as it presents a “brutally honest look at transracial adoption.” Perhaps. But while someone was minding all those issues, the story got up and wandered away.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/07/arts/07NORMALCY_SPAN/07NORMALCY_SPAN-articleLarge.jpg', 'height': 365, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/07/arts/07NORMALCY_SPAN/07NORMALCY_SPAN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 365}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/07/arts/07NORMALCY_SPAN/07NORMALCY_SPAN-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'ju