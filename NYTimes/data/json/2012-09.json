rch', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Priests', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Sex Crimes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Child Abuse and Neglect', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Kansas City (Mo)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2012-09-08T01:41:13+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/b1b1ee6f-eba1-541d-8ee4-f6934425ccdf', 'word_count': 331, 'uri': 'nyt://article/b1b1ee6f-eba1-541d-8ee4-f6934425ccdf'}, {'abstract': 'James Franklin brought a personal touch to a Vanderbilt football program that had two winning seasons in the last 35 years.', 'web_url': 'https://www.nytimes.com/2012/09/08/sports/ncaafootball/vanderbilts-james-franklin-builds-ties-with-his-players-by-opening-up.html', 'snippet': 'James Franklin brought a personal touch to a Vanderbilt football program that had two winning seasons in the last 35 years.', 'lead_paragraph': 'NASHVILLE — \xa0A certain brand of optimism had been required for James Franklin to forgive his father, to forget their past. But now it was being tested. In his father’s new home, Franklin listened to his father’s new wife deny his father’s sins against him, his sister and their mother.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/08/sports/yvandy/yvandy-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/08/sports/yvandy/yvandy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type':