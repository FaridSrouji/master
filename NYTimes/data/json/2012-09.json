ualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/53cf3d60-ae70-50c7-9c0c-2c77eb431f43', 'word_count': 1038, 'uri': 'nyt://article/53cf3d60-ae70-50c7-9c0c-2c77eb431f43'}, {'abstract': 'The filmmaker’s guide to Mayor Michael R. Bloomberg’s proposal to restrict the sale of big, sugary drinks.', 'web_url': 'https://www.nytimes.com/2012/09/10/opinion/soda-ban-explained.html', 'snippet': 'The filmmaker’s guide to Mayor Michael R. Bloomberg’s proposal to restrict the sale of big, sugary drinks.', 'lead_paragraph': 'I don’t drink much soda, I don’t buy Big Gulps, and my body mass index is right where it should be. Until the public hearing on July 24, I had largely ignored Mayor Michael R. Bloomberg’s proposed ban on large, sugary drinks because it would have no effect on my daily life. It was watching supporters of the ban struggle to articulate exactly what it would mean that motivated me to educate myself and ultimately make a movie about it. The proposal is best conveyed visually, not verbally. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/06/opinion/video-opdoc-neistat-soda/video-opdoc-neistat-soda-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/06/opinion/video-opdoc-neistat-soda/video-opdoc-neistat-soda-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/06/opinion/video-opdoc-neistat-soda/video-opdoc-neistat-soda-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/09/06/opinion/video-opdoc-neistat-soda/video-opdoc-neistat-soda-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '‘Soda Ban Explained’', 'kicker': 'Op-Docs', 'content_kicker': None, 'print_headline': '‘Soda Ban Explained’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Soft Drinks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Obesity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2012-09-10T01:05:07+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Casey Neistat', 'person': [{'firstname': 'Casey', 'middlename': None, 'lastname': 'Neistat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/1f0ba51a-fb16-582f-8583-946273a87063', 'word_count': 503, 'uri': 'nyt://article/1f0ba51a-fb16-582f-8583-946273a87063'}, {'abstract': 'The filmmaker Casey Neistat presents a guide to Mayor Michael R. Bloomberg’s proposal to restrict sales of big sugary drinks in New York.', 'web_url': 'https://www.nytimes.com/video/opinion/100000001768095/soda-ban-explained.html', 'snippet': 'The filmmaker Casey Neistat presents a guide to Mayor Michael R. Bloomberg’s proposal to restrict sales of big sugary drinks in New York.', 'lead_paragraph': 'The filmmaker Casey Neistat presents a guide to Mayor Michael R. Bloomberg’s proposal to restrict sales of big sugary drinks in New York.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/06/opinion/video-opdoc-neistat-soda/video-opdoc-neistat-soda-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/20