ier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Elaisha', 'middlename': None, 'lastname': 'Stokes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}, {'firstname': 'Pedro', 'middlename': None, 'lastname': 'Rosado', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 4}, {'firstname': 'Channon', 'middlename': None, 'lastname': 'Hodge', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 5}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/4dfedcd8-22f4-5d2c-a538-f382932682a5', 'word_count': 0, 'uri': 'nyt://video/4dfedcd8-22f4-5d2c-a538-f382932682a5'}, {'abstract': 'Mamata Banerjee withdrew support from the Congress Party-led coalition government.', 'web_url': 'https://india.blogs.nytimes.com/2012/09/18/mercurial-leader-withdraws-support-from-governing-coalition/', 'snippet': 'Mamata Banerjee withdrew support from the Congress Party-led coalition government.', 'lead_paragraph': '“India’s national government was plunged into turmoil on Tuesday night and faced an uncertain future,” after Mamata Banerjee, “a crucial regional ally angrily withdrew support from the governing coalition,”Jim Yardley and Gardiner Harris wrote in The New York Times. Ms. Banerjee decided to walk out to protest the government’s recent “package of fuel price hikes and pro-business economic changes,” they wrote.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mercurial Leader Withdraws Support From Governing Coalition', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2012-09-18T18:51:02+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/9969e3bd-db98-5b45-8e73-e635dda0760c', 'word_count': 146, 'uri': 'nyt://article/9969e3bd-db98-5b45-8e73-e635dda0760c'}, {'abstract': 'Although many Turks at first agreed with their government’s support for the Syrian opposition, many now believe it is undermining Turkey’s economy and security.', 'web_url': 'https://www.nytimes.com/2012/09/19/world/europe/turks-weary-of-leaders-support-for-syria-uprising.html', 'snippet': 'Although many Turks at first agreed with their government’s support for the Syrian opposition, many now believe it is undermining Turkey’s economy and security.', 'lead_paragraph': 'ISTANBUL — As the war in Syria rages next door, Turks have grown increasingly weary of nearly daily reports of troubles at home: Iranian spies working with Kurdish insurgents, soldiers ambushed and killed, millions spent caring for a flood of refugees, lost trade and havoc in border villages.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/19/world/19turkey_span/19turkey_span-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2012/09/19/world/19turkey_span/19turkey_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/19/world/19turkey_span/19turkey_span-jumbo.jpg', 'height': 636, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/09/19/world/19turkey_span/19turkey_span-superJumbo.jpg', 'height': 1272, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/