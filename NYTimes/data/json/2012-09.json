al': 'News', '_id': 'nyt://article/c704f381-9288-51d6-8ec5-605685086859', 'word_count': 445, 'uri': 'nyt://article/c704f381-9288-51d6-8ec5-605685086859'}, {'abstract': 'A personal reminiscence of the man who led The New York Times for 34 years.', 'web_url': 'https://www.nytimes.com/2012/10/01/opinion/mr-sulzberger-publisher-and-projectionist.html', 'snippet': 'A personal reminiscence of the man who led The New York Times for 34 years.', 'lead_paragraph': 'In 1995, at the funeral of the extraordinary journalist James Reston, I watched Arthur Ochs Sulzberger of The New York Times escort Katharine Graham of The Washington Post up the long aisle of the National Cathedral in Washington. I was struck by their grace and dignity, by how symbolic they were of great journalism, and by how much our profession owed to the man who had published The Times for nearly 30 years.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mr. Sulzberger, Publisher and Projectionist', 'kicker': 'Editorial | Appreciations', 'content_kicker': None, 'print_headline': 'Mr. Sulzberger, Publisher and Projectionist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Editorials', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Sulzberger, Arthur Ochs', 'rank': 4, 'major': 'N'}], 'pub_date': '2012-09-29T16:26:18+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/2a703145-3b10-5f00-a957-c00f0351497c', 'word_count': 461, 'u