ype': 'image', 'url': 'images/2017/09/27/opinion/27wed1/25mon2-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/27/opinion/27wed1/25mon2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27wed1/25mon2-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27wed1/25mon2-superJumbo.jpg', 'height': 1198, 'width': 1198, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'How Gun Controls Work Beyond Washington', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Gun Controls Beyond Washington', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Rifle Assn', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Condors', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-09-27T07:21:21+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'subsection_name': 'Editorials', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/db6c31ab-8bd4-5517-a135-09a1288c95f5', 'word_count': 478, 'uri': 'nyt://article/db6c31ab-8bd4-5517-a135-09a1288c95f5'}, {'abstract': 'We need to adapt to succeed, and this president isn’t helping.', 'web_url': 'https://www.nytimes.com/2017/09/27/opinion/globalization-trump-american-progress.html', 'snippet': 'We need to adapt to succeed, and this president isn’t helping.', 'lead_paragraph': 'Former Secretary of State Dean Acheson wrote a famous memoir, “Present at the Creation,” about the birth of the post-World War II order — an order whose institutions produced six decades of security and growth for a lot of people. We’re now at a similar moment of rapid change — abroad and at home. Many institutions have to be rethought. But any book about Washington today would have to be called “Absent at the Creation.”', 'print_section': 'A', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27friedmanWeb/27friedmanWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/27/opinion/27friedmanWeb/27friedmanWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27friedmanWeb/27friedmanWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27friedmanWeb/27friedmanWeb-articleLarge.jpg', 'height': 421, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/27/opinion/27friedmanWeb/27friedmanWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 421}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27friedmanWeb/27friedmanWeb-jumbo.jpg', 'height': 718, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27friedmanWeb/27friedmanWeb-superJumbo.jpg', 'height': 1436, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Folks, We’re Home Alone', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Folks, We’re Home Alone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Labor and Jobs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Global Warming', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-09-27T07:21:22+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Thomas L. Friedman', 'person': [{'firstname': 'Thomas', 'middlename': 'L.', 'lastname': 'Friedman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/3289c045-87de-50b8-8519-09b294bd7824', 'word_count': 848, 'uri': 'nyt://article/3289c045-87de-50b8-8519-09b294bd7824'}, {'abstract': 'Many cultural controversies are well worth fighting over. The president is a virtuoso of the other kind.', 'web_url': 'https://www.nytimes.com/2017/09/27/opinion/trumps-empty-culture-wars.html', 'snippet': 'Many cultural controversies are well worth fighting over. The president is a virtuoso of the other kind.', 'lead_paragraph': 'The secret of culture war is that it is often a good and necessary thing. People don’t like culture wars when they’re on the losing side, and while they’re losing they often complain about how cultural concerns are distractions from the “real” issues, usually meaning something to do with the deficit or education or where to peg the Medicare growth rate or which terrorist haven the United States should be bombing next.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27douthatWeb/27douthatWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/27/opinion/27douthatWeb/27douthatWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27douthatWeb/27douthatWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27douthatWeb/27douthatWeb-articleLarge.jpg', 'height': 390, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/27/opinion/27douthatWeb/27douthatWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 390}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27douthatWeb/27douthatWeb-jumbo.jpg', 'height': 666, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27douthatWeb/27douthatWeb-superJumbo.jpg', 'height': 1331, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Trump’s Empty Culture Wars', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Trump’s Empty Culture Wars', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kaepernick, Colin', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ferguson (Mo)', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Star-Spangled Banner (Song)', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-09-27T07:21:22+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/5177d38d-5fb1-5a11-89be-7bc75b43db2e', 'word_count': 971, 'uri': 'nyt://article/5177d38d-5fb1-5a11-89be-7bc75b43db2e'}, {'abstract': 'Being upfront about my disability on Tinder and other dating sites has liberated me.', 'web_url': 'https://www.nytimes.com/2017/09/27/opinion/online-dating-disability.html', 'snippet': 'Being upfront about my disability on Tinder and other dating sites has liberated me.', 'lead_paragraph': 'The first time I forayed into online dating, I let my wheelchair show just a little in my photos. The good guys, I hoped, would be so taken by my clever profile and witty banter that they’d be able to look beyond my disability, if they even noticed it at all.', 'print_section': 'SR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27disability/27disability-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/27/opinion/27disability/27disability-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27disability/27disability-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27disability/27disability-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27disability/27disability-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/27/opinion/27disability/27disability-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/opinion/27disability/27disability-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Playing the Online Dating Game, in a Wheelchair', 'kicker': 'Disability', 'content_kicker': None, 'print_headline': 'Playing the Online Dating Game, on Wheels', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Disabilities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Online Dating', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-09-27T07:21:22+0000', 'document_type': 'art