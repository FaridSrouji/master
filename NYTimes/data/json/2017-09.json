/2017/09/07/t-magazine/07tmag-normal/07tmag-normal-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/07/t-magazine/07tmag-normal/07tmag-normal-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/07/t-magazine/07tmag-normal/07tmag-normal-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/07/t-magazine/07tmag-normal/07tmag-normal-articleLarge.jpg', 'height': 260, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/07/t-magazine/07tmag-normal/07tmag-normal-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 260}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/07/t-magazine/07tmag-normal/07tmag-normal-jumbo.jpg', 'height': 444, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/07/t-magazine/07tmag-normal/07tmag-normal-superJumbo.jpg', 'height': 650, 'width': 1500, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'In a Topsy-Turvy World, Fashion Finds Solace in the Mundane', 'kicker': None, 'content_kicker': None, 'print_headline': 'The New Normal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Men and Boys', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-09-07T18:51:57+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': 