icle/aacd38d3-abef-569a-981b-2fd9505f8236'}, {'abstract': 'Officials in Oruzgan Province say pressure by the Taliban has closed the region’s health facilities and postponed a vital polio vaccination campaign.', 'web_url': 'https://www.nytimes.com/2017/09/23/world/asia/afghanistan-taliban-oruzgan-hospitals.html', 'snippet': 'Officials in Oruzgan Province say pressure by the Taliban has closed the region’s health facilities and postponed a vital polio vaccination campaign.', 'lead_paragraph': 'KANDAHAR, Afghanistan — Muhammad Anwar, 8, was vomiting all night and had severe diarrhea. His father, Hajji Aslam, did not know what to do.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/24/world/24afghanistan/24afghanistan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/24/world/24afghanistan/24afghanistan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/24/world/24afghanistan/24afghanistan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/24/world/24afghanistan/24afghanistan-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/24/world/24afghanistan/24afghanistan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/24/world/24afghanistan/24afghanistan-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'