4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/10/books/review/10MCNAMARA/10MCNAMARA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/10/books/review/10MCNAMARA/10MCNAMARA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/10/books/review/10MCNAMARA/10MCNAMARA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/10/books/review/10MCNAMARA/10MCNAMARA-articleLarge-v2.jpg', 'height': 582, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/10/books/review/10MCNAMARA/10MCNAMARA-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 582}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/10/books/review/10MCNAMARA/10MCNAMARA-jumbo-v2.jpg', 'height': 677, 'width': 698, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/10/books/review/10MCNAMARA/10MCNAMARA-superJumbo-v2.jpg', 'height': 677, 'width': 698, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'A Sydney Bridge, a Falling Man and Three Witnesses to a Miracle', 'kicker': 'Fiction', 'content_kicker': None, 'print_headline': 'Falling Through Time', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Body in the Clouds (Book)', 'rank': 2, 'major': 'N'}