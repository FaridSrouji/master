e}, 'keywords': [{'name': 'subject', 'value': 'Heart', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cholesterol', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cancer', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-09-27T09:00:02+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Siddhartha Mukherjee', 'person': [{'firstname': 'Siddhartha', 'middlename': None, 'lastname': 'Mukherjee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3c1572c7-55df-526b-b25f-537790905643', 'word_count': 1536, 'uri': 'nyt://article/3c1572c7-55df-526b-b25f-537790905643'}, {'abstract': 'The film executive on foreign crossover appeal and passing on “Slumdog Millionaire.”', 'web_url': 'https://www.nytimes.com/2017/09/27/magazine/franklin-leonard-wants-to-diversify-the-box-office.html', 'snippet': 'The film executive on foreign crossover appeal and passing on “Slumdog Millionaire.”', 'lead_paragraph': 'You graduated from Harvard and worked in politics, then management consulting, then Hollywood. What is the through line with those jobs? It has probably been advocacy for people whose stories have historically been excluded or overlooked. I had pretty much every advantage growing up — my father’s a doctor, my mom was a teacher — but when you grow up a black nerd in the Deep South while Steve Urkel is on television, you learn to identify with those on the outside.', 'print_section': 'MM', 'print_page': '62', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/magazine/01talk-promo/01talk-promo-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/01/magazine/01talk-promo/01talk-promo-thumbStandard.jpg', 'thumbna