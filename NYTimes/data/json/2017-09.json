images/2017/09/20/opinion/20boylanWeb/20boylanWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 406}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20boylanWeb/20boylanWeb-jumbo.jpg', 'height': 693, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20boylanWeb/20boylanWeb-superJumbo.jpg', 'height': 1385, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Vietnam on the Reel-to-Reel', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Vietnam on the Reel-to-Reel', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Nineteen Hundred Sixties', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vietnam War', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Burns, Ken', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Novick, Lynn', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-09-20T07:21:12+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Finney Boylan', 'person': [{'firstname': 'Jennifer', 'middlename': 'Finney', 'lastname': 'Boylan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/74baf423-8401-5878-b684-ecd3064fe8ed', 'word_count': 952, 'uri': 'nyt://article/74baf423-8401-5878-b684-ecd3064fe8ed'}, {'abstract': 'If you crave an anti-new year New Year, consider adopting the Jewish one, which begins Wednesday at sundown, as your own.', 'web_url': 'https://www.nytimes.com/2017/09/20/opinion/rosh-hashana-jewish-celebrate.html', 'snippet': 'If you crave an anti-new year New Year, consider adopting the Jewish one, which begins Wednesday at sundown, as your own.', 'lead_paragraph': 'I hate New Year’s Eve. For years, I tried to rally and convince myself that the hellscape of selfies and stilettos was fun. More recently I’ve wised up and fled the city to my grandparents in Florida, where I play bartender and we’re all in bed by 10 p.m.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20weissWeb/20weissWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/20/opinion/20weissWeb/20weissWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20weissWeb/20weissWeb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20weissWeb/20weissWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20weissWeb/20weissWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/20/opinion/20weissWeb/20weissWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20weissWeb/20weissWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'You Don’t Have to Be Jewish to Celebrate Rosh Hashana', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jews and Judaism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Rosh Hashana', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'New Year', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Amichai, Yehuda', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-09-20T07:21:12+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Bari Weiss', 'person': [{'firstname': 'Bari', 'middlename': None, 'lastname': 'Weiss', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/937d9ed8-fe29-52aa-88d3-3d70236c75a1', 'word_count': 1035, 'uri': 'nyt://article/937d9ed8-fe29-52aa-88d3-3d70236c75a1'}, {'abstract': 'Military tanks, tear gas and rubber bullets won’t bridge the gap between the police and the black community anytime soon.', 'web_url': 'https://www.nytimes.com/2017/09/20/opinion/when-will-black-lives-matter-in-st-louis.html', 'snippet': 'Military tanks, tear gas and rubber bullets won’t bridge the gap between the police and the black community anytime soon.', 'lead_paragraph': 'ST. LOUIS — On Aug. 9, 2014, Mike Brown was killed by Darren Wilson, a police officer in the St. Louis suburb Ferguson, Mo. What followed were months of overwhelmingly nonviolent protests that were policed by law enforcement officers who wore riot gear, shook their batons at protesters and took joy-rides in heavily armored military vehicles. In November 2014, a grand jury decided not to indict Mr. Wilson, and a few months later federal investigators cleared him of any wrongdoing.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/19/opinion/19nelsonWeb/19nelsonWeb-articleLarge.jpg', 'height': 391, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/19/opinion/19nelsonWeb/19nelsonWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 391}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/19/opinion/19nelsonWeb/19nelsonWeb-jumbo.jpg', 'height': 668, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/19/opinion/19nelsonWeb/19nelsonWeb-superJumbo.jpg', 'height': 1336, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/19/opinion/19nelsonWeb/19nelsonWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/19/opinion/19nelsonWeb/19nelsonWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/19/opinion/19nelsonWeb/19nelsonWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'When Will Black Lives Matter in St. Louis?', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Ferguson (Mo)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'St Louis (Mo)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Smith, Anthony Lamar (d 2011)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Stockley, Jason (1980- )', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-09-20T07:21:12+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Nicole D. Nelson', 'person': [{'firstname': 'Nicole', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/bb0365af-3c06-5ab7-9c37-a3f854bc8665', 'word_count': 941, 'uri': 'nyt://article/bb0365af-3c06-5ab7-9c37-a3f854bc8665'}, {'abstract': 'College is supposedly the great leveler. But race still affects average pay for graduates, indicating that discrimination is a major cause.', 'web_url': 'https://www.nytimes.com/2017/09/20/opinion/college-racial-income-gap.html', 'snippet': 'College is supposedly the great leveler. But race still affects average pay for graduates, indicating that discrimination is a major cause.', 'lead_paragraph': 'Education is supposed to be the nation’s great socioeconomic leveler. That belief, however, is not borne out in the data. Pay gaps between white and black workers have grown since 1979, even after controlling for education, experience and location, according to research by the Economic Policy Institute. In fact, racial pay gaps have expanded the most for college graduates, which makes it seem clear that discrimination is a leading cause.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20wed2web/20wed2web-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/20/opinion/20wed2web/20wed2web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20wed2web/20wed2web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20wed2web/20wed2web-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/20/opinion/20wed2web/20wed2web-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20wed2web/20wed2web-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/opinion/20wed2web/20wed2web-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Even College Doesn’t Bridge the Racial Income Gap', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'College Does Not Close Racial Pay Gaps', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Wages and Salaries', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Whites', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 10, 'major': 'N'}], 'pub_date': '2017-09-20T07:21:13+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/d83b1046-561c-5514-9458-5b641315dfca', 'word_count': 605, 'uri': 'nyt://article/d83b1046-561c-5514-9458-5b641315dfca'}, {'abstract': 'In an impoverished port city in the Ivory Coast, women formed a cooperative to eke out a living making charcoal from the castoffs of sawmills and workshops.', 'web_url': 'https://lens.blogs.nytimes.com/2017/09/20/women-work-a-world-of-smoke-in-the-ivory-coast/', 'snippet': 'In an impoverished port city in the Ivory Coast, women formed a cooperative to eke out a living making charcoal from the castoffs of sawmills and workshops.', 'lead_paragraph': 'In the charcoal fields of San Pedro, a bustling port city in the southwest Ivory Coast, hundreds of women and children — some barely school-age — toil day and night among heaps moldering wood, waste water and air thick with smoke. Driving rain, withering heat and sawdust storms come with the job. This used to be men’s work. Not anymore.Making charcoal for sale out of the refuse from nearby sawmills, work for the desperate and destitute, has become almost exclusively women’s work in San Pedro. It may have started with one widow from Bogart, a desperately poor slum, who ventured into one of the three charcoal fields in San Pedro, the Parc Du Pont, intent on making a dollar to feed her family.As Joana Choumali learned when she began documenting the women in 2013, men are happy to sell wood, San Pedro’s largest export, and let women keep the filthy, back-breaking work of making charcoal. Ms. Choumali, a freelance documentary and fine art photographer from Abidjan, was on an assignment in San Pedro when she first spotted the phenomenon.Three years later, Ms. Choumali’s project, “Sissi Barra (The Work of Smoke),” illustrates the harsh reality for women with few choices, the poorest of the poor, in the Ivory Coast. While the country is enjoying an economic revival and now boasts Africa’s fastest growing economy, the charcoal producers of San Pedro live like paupers. Her conversation with Evelyn Nieves has been condensed and edited.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Women Finding Empowerment in ‘A World of Smoke’', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Wood and Wood Products', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Choumali, Joana', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Ivory Coast', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-09-20T08:00:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Evelyn Nieves', 'person': [{'firstname': 'Evelyn', 'middlename': None, 'lastname': 'Nieves', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/88910575-ad82-515e-8229-1cb503d28ba9', 'word_count': 996, 'uri': 'nyt://article/88910575-ad82-515e-8229-1cb503d28ba9'}, {'abstract': 'How does Facebook pit companies against countries in the battle over the control of online speech?', 'web_url': 'https://www.nytimes.com/2017/09/20/learning/teaching-activities-for-facebook-faces-a-new-world-as-officials-rein-in-a-wild-web.html', 'snippet': 'How does Facebook pit companies against countries in the battle over the control of online speech?', 'lea