4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/travel/01Ojai-California4/00Surfacing-Ojai-California4-articleLarge.jpg', 'height': 382, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/03/travel/01Ojai-California4/00Surfacing-Ojai-California4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 382}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/travel/01Ojai-California4/00Surfacing-Ojai-California4-jumbo.jpg', 'height': 652, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/travel/01Ojai-California4/00Surfacing-Ojai-California4-superJumbo.jpg', 'height': 1303, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/travel/01Ojai-California4/00Surfacing-Ojai-California4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/03/travel/01Ojai-California4/00Surfacing-Ojai-California4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/travel/01Ojai-California4/00Surfacing-Ojai-California4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Five Places to Go in Ojai, Calif.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Good Vibrations and a Growing Tourist Magnet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Ojai (Calif)', 'ran