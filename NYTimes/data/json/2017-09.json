mbo.jpg', 'height': 1023, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08andersen/08andersen-superJumbo.jpg', 'height': 1799, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Hands Up. It’s Showtime.', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Hands Up. It’s Showtime.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Violence (Media and Entertainment)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'S.W.A.T. (TV Program)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-09-08T07:21:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Kurt Andersen', 'person': [{'firstname': 'Kurt', 'middlename': None, 'lastname': 'Andersen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/acb1a26b-9028-5631-a8b2-0ebd8b98f660', 'word_count': 959, 'uri': 'nyt://article/acb1a26b-9028-5631-a8b2-0ebd8b98f660'}, {'abstract': 'Something that started in a wave of hope migrated to closed-minded, mercenary quarters.', 'web_url': 'https://www.nytimes.com/2017/09/08/opinion/gop-hippie-food-health.html', 'snippet': 'Something that started in a wave of hope migrated to closed-minded, mercenary quarters.', 'lead_paragraph': 'Some time ago, I found myself in a buffet line around piles of inedible looking grains, greens and grassy-smelling gratins at an alternative food cooperative’s Sunday dinner. No part of this meal, I was assured, had been touched by the corporate food chain, the Big Ag puppeteers with their taxpayer-subsidized toxins.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08eganWeb/08eganWeb-articleLarge.jpg', 'height': 413, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/08/opinion/08eganWeb/08eganWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 413}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08eganWeb/08eganWeb-jumbo.jpg', 'height': 705, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08eganWeb/08eganWeb-superJumbo.jpg', 'height': 1410, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08eganWeb/08eganWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/08/opinion/08eganWeb/08eganWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08eganWeb/08eganWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How the Far Right Came to Love Hippie Food', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Food', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Organic Foods and Products', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Fringe Groups and Movements', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Beck, Glenn', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Alex (1974- )', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Mackey, John P', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 9, 'major': 'N'}], 'pub_date': '2017-09-08T07:21:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/b6df9d51-c473-5999-8275-1282d143ffae', 'word_count': 815, 'uri': 'nyt://article/b6df9d51-c473-5999-8275-1282d143ffae'}, {'abstract': 'Suddenly Trump and the Democrats are making deals. Here’s one the party should avoid.', 'web_url': 'https://www.nytimes.com/2017/09/08/opinion/swap-daca-wall-funding.html', 'snippet': 'Suddenly Trump and the Democrats are making deals. Here’s one the party should avoid.', 'lead_paragraph': 'WASHINGTON — Suddenly, Washington is awash in talk about deal-making. On Wednesday, President Trump agreed with the Democrats on a plan to increase the debt limit and fund the government until December, enraging his Republican allies. This sudden thaw sets up the possibility of an even bigger deal: In exchange for making the Deferred Action for Childhood Arrivals program permanent law, the Democrats would agree to maybe a couple of billion for the president’s beautiful wall on the border.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08tomaskyWeb/08tomaskyWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/08/opinion/08tomaskyWeb/08tomaskyWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08tomaskyWeb/08tomaskyWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08tomaskyWeb/08tomaskyWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/08/opinion/08tomaskyWeb/08tomaskyWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08tomaskyWeb/08tomaskyWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/08/opinion/08tomaskyWeb/08tomaskyWeb-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Swap DACA for Wall Funding? No Way!', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'A Bad Deal for Democrats', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-09-08T07:21:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Michael Tomasky', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Tomasky', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c53da966-49cb-5c19-84cb-8a08a92b76aa', 'word_count': 840, 'uri': 'nyt://article/c53da966-49cb-5c19-84cb-8a08a92b76aa'}, {'abstract': '“There’s nobody who knows how much we spend. You’re the only person I ever said those numbers to out loud.”', 'web_url': 'https://www.nytimes.com/2017/09/08/opinion/sunday/what-the-rich-wont-tell-you.html', 'snippet': '“There’s nobody who knows how much we spend. You’re the only person I ever said those numbers to out loud.”', 'lead_paragraph': 'Over lunch in a downtown restaurant, Beatrice, a New Yorker in her late 30s, told me about two decisions she and her husband were considering. They were thinking about where to buy a second home and whether their young children should go to private school. Then she made a confession: She took the price tags off her clothes so that her nanny would not see them. “I take the label off our six-dollar bread,” she said.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/10/opinion/sunday/10shermanCOVER/10shermanCOVER-articleLarge-v2.jpg', 'height': 606, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/10/opinion/sunday/10shermanCOVER/10shermanCOVER-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight