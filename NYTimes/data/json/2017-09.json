ages/2017/09/29/us/29California-Today-vote/29California-Today-vote-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/29/us/29California-Today-vote/29California-Today-vote-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/us/29California-Today-vote/29California-Today-vote-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/us/29California-Today-vote/29California-Today-vote-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/29/us/29California-Today-vote/29California-Today-vote-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/us/29California-Today-vote/29California-Today-vote-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/us/29California-Today-vote/29California-Today-vote-superJumbo.jpg', 'height': 1202, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'California Today: Why Move Up the 2020 Presidential Primary?', 'kicker': 'California Today', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-09-29T12:56:16+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Mike McPhate', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'McPhate', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/29d372c9-5ab3-5e99-b9a4-fc514648cc19', 'word_count': 1017, 'uri': 'nyt://article/29d372c9-5ab3-5e99-b9a4-fc514648cc19'}, {'abstract': 'The television host and children’s book author “sleeps in” until 6 a.m., enjoys a hearty breakfast, and then hits the town with her family.', 'web_url': 'https://www.nytimes.com/2017/09/29/nyregion/how-savannah-guthrie-of-the-today-show-spends-her-sundays.html', 'snippet': 'The television host and children’s book author “sleeps in” until 6 a.m., enjoys a hearty breakfast, and then hits the town with her family.', 'lead_paragraph': 'A little more than five years ago, Savannah Guthrie became a host of the “Today” show on NBC. Since then, she has married, given birth twice, and most recently, co-written her first children’s book, “Princesses Wear Pants,” with Allison Oppenheim. During the week, Ms. Guthrie, 45, puts in nine-to-16-hour days on set. Having recently covered Hurricanes Harvey, Irma and Maria, when she gets a free Sunday, she relishes it, spending time with her husband, Michael Feldman, 48, a consultant, their daughter, Vale, 3, and their son, Charley, 9 months. The family lives in TriBeCa.', 'print_section': 'MB', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/nyregion/01ROUTINE1/01ROUTINE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/01/nyregion/01ROUTINE1/01ROUTINE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/nyregion/01ROUTINE1/01ROUTINE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': '