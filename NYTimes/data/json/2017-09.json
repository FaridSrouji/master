Jumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Feminist Fiction From the Philippines, Written 50 Years Ago', 'kicker': 'Fiction', 'content_kicker': None, 'print_headline': 'Uncanny Powers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Woman Who Had Two Navels and Tales of the Tropical Gothic (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Joaquin, Nick', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-09-01T09:00:17+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Melissa Chadburn', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Chadburn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0a186d2d-53da-5b12-a8f0-fb0425cba378', 'word_count': 941, 'uri': 'nyt://article/0a186d2d-53da-5b12-a8f0-fb0425cba378'}, {'abstract': 'Julian Lucas considers how family stories go beyond genealogy to discover those “who became ‘our’ ancestors” and those who didn’t.', 'web_url': 'https://www.nytimes.com/2017/09/01/books/review/counternarratives-john-keene-family-sagas.html', 'snippet': 'Julian Lucas considers how family stories go beyond genealogy to discover those “who became ‘our’ ancestors” and those who didn’t.', 'lead_paragraph': 'Family sagas write history through microcosm, tracing a clan’s rise, survival and, more often than not, ultimate dissolution. Thomas Mann’s healthy bourgeois Buddenbrooks succumb to decadent sterility; Gabriel García Márquez’s Buendías are erased by a hurricane; the Starks of Winterfell are massacred in the Riverlands. A family is sacrificed to time, and in their entrails readers find auguries of larger motions. The critic Frank Kermode believed that novels developed alongside a loss of faith in biblical chronology, as substitutes for Adam and Eve’s universal family plot. He is borne out by recent years’ fruitful crop of epics rooted in the familiar soil of fathers and daughters, mothers and sons, blood, sex, bastardy and inheritance.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/books/review/03LucasEssay/03LucasEssay-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/03/books/review/03LucasEssay/03LucasEssay-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/books/review/03LucasEssay/03LucasEssay-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/books/review/03LucasEssay/03LucasEssay-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/03/books/review/03LucasEssay/03LucasEssay-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/books/review/03LucasEssay/03LucasEssay-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/03/books/review/03LucasEssay/03LucasEssay-superJumbo.jpg', 'height': 2048, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}