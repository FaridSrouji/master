ine': {'original': 'By Maggie Haberman and Sharon LaFraniere', 'person': [{'firstname': 'Maggie', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sharon', 'middlename': None, 'lastname': 'LaFraniere', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/24b54684-9cf7-520c-8aee-f5f05eb96059', 'word_count': 530, 'uri': 'nyt://article/24b54684-9cf7-520c-8aee-f5f05eb96059'}, {'abstract': 'Despite budget cuts, Berkeley has already spent almost $1.5 million on security this year.', 'web_url': 'https://www.nytimes.com/2017/09/24/opinion/milo-yiannopoulos-free-speech-week-berkeley.html', 'snippet': 'Despite budget cuts, Berkeley has already spent almost $1.5 million on security this year.', 'lead_paragraph': 'In a typical year, the University of California, Berkeley, allocates around $200,000 to pay for security at campus protests. But since this past February, the school has spent some $1.5 million. That enormous sum excludes the $1 million the administration expected to spend this week on Milo Yiannopoulos’s chaotic and disorganized “Free Speech Week.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/25/opinion/25OnCampus/25OnCampus-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/25/opinion/25OnCampus/25OnCampus-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/25/opinion/25OnCampus/25OnCampus-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': N