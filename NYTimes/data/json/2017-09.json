nick/13klonick-superJumbo.jpg', 'height': 1436, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'The Terrifying Power of Internet Censors', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'The Power Of Internet Censors', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'CloudFlare Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Censorship', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Daily Stormer', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Neo Nazi Groups', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Charlottesville, Va, Violence (August, 2017)', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-09-13T07:21:23+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Kate Klonick', 'person': [{'firstname': 'Kate', 'middlename': None, 'lastname': 'Klonick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/64baa49d-8d37-5dab-b6dc-733dee650e0e', 'word_count': 862, 'uri': 'nyt://article/64baa49d-8d37-5dab-b6dc-733dee650e0e'}, {'abstract': 'In the wealthiest country on the planet, people shouldn’t be deprived of health care simply because they can’t afford it.', 'web_url': 'https://www.nytimes.com/2017/09/13/opinion/bernie-sanders-medicare-single-payer.html', 'snippet': 'In the wealthiest country on the planet, people shouldn’t be deprived of health care simply because they can’t afford it.', 'lead_paragraph': 'This is a pivotal moment in American history. Do we, as a nation, join the rest of the industrialized world and guarantee comprehensive health care to every person as a human right? Or do we maintain a system that is enormously expensive, wasteful and bureaucratic, and is designed to maximize profits for big insurance companies, the pharmaceutical industry, Wall Street and medical equipment suppliers?', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/13/opinion/13sandersWeb/13sandersWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/13/opinion/13sandersWeb/13sandersWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/13/opinion/13sandersWeb/13sandersWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/13/opinion/13sandersWeb/13sandersWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/13/opinion/13sandersWeb/13sandersWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/13/opinion/13sandersWeb/13sandersWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/13/opinion/13sandersWeb/13sandersWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Bernie Sanders: Why We Need Medicare for All', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'W