-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/nyregion/01MISINFORMED/01MISINFORMED-articleLarge-v2.jpg', 'height': 865, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/01/nyregion/01MISINFORMED/01MISINFORMED-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 865}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/nyregion/01MISINFORMED/01MISINFORMED-jumbo-v2.jpg', 'height': 1024, 'width': 711, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/nyregion/01MISINFORMED/01MISINFORMED-superJumbo-v2.jpg', 'height': 1279, 'width': 887, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Lock ’Em Up, Then Dim Sum', 'kicker': None, 'content_kicker': None, 'print_headline': 'Lock ’Em Up. Then, Dim Sum.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Jury System', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-09-28T18:01:50+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Joyce Wadler', 'person': [{'firstname': 'Joyce', 'middlename': None, 'lastname': 'Wadler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/be16b0a9-6b01-5464-b832-a177b09462d4', 'word_count': 902, 'uri': 'nyt://article/be16b0a9-6b01-5464-b832-a177b09462d4'}, {'abstract': 'A single variation in its DNA may have helped equip the virus to attack fetal cells, contributing to a surge of birth defects in Latin America.', 'web_url': 'https://www.nytimes.com/2017/09/28/health/zika-mutation-microcephaly.html', 'snippet': 'A single variation in its DNA may have helped equip the virus to attack fetal cells, contributing to a surge of birth defects in Latin America.', 'lead_paragraph': 'It remains one of the great mysteries of the Zika epidemic: Why did a virus that existed for decades elsewhere in the world suddenly seem to become more destructive when it landed in Latin America?', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/science/29ZIKA1/29ZIKA1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/29/science/29ZIKA1/29ZIKA1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/science/29ZIKA1/29ZIKA1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/science/29ZIKA1/29ZIKA1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/29/science/29ZIKA1/29ZIKA1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/29/science/29ZIKA1/29ZIKA1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/0