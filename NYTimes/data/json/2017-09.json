subsection_name': 'Sunday Review', 'byline': {'original': 'By David Friend', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Friend', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7383659c-faed-5c3d-a786-15c782cdec45', 'word_count': 796, 'uri': 'nyt://article/7383659c-faed-5c3d-a786-15c782cdec45'}, {'abstract': 'People are no longer pouring into America’s cities. And that’s bad news for everyone.', 'web_url': 'https://www.nytimes.com/2017/09/01/opinion/cities-suburbs-housing-crime.html', 'snippet': 'People are no longer pouring into America’s cities. And that’s bad news for everyone.', 'lead_paragraph': 'TORONTO — For all the concern about the gentrification, rising housing prices and the growing gap between the rich and poor in our leading cities, an even bigger threat lies on the horizon: The urban revival that swept across America over the past decade or two may be in danger. As it turns out, the much-ballyhooed new age of the city might be giving way to a great urban stall-out.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/01/opinion/01florida/01florida-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/01/opinion/01florida/01florida-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/01/opinion/01florida/01florida-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/01/opinion/01florida/01florida-articleL