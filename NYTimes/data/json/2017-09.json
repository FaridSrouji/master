eight': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Our Favorite Photographs From New York Fashion Week', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-09-14T20:00:43+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/4fac53b4-1e6c-5cdb-ba90-c14300551ef9', 'word_count': 0, 'uri': 'nyt://slideshow/4fac53b4-1e6c-5cdb-ba90-c14300551ef9'}, {'abstract': 'Highlights from Tom Ford, Calvin Klein and more — on (and off) the runway.', 'web_url': 'https://www.nytimes.com/2017/09/14/t-magazine/new-york-fashion-week-best-photos.html', 'snippet': 'Highlights from Tom Ford, Calvin Klein and more — on (and off) the runway.', 'lead_paragraph': 'New York Fashion Week came to a close with the Marc Jacobs show on Wednesday evening. To cover the week, T’s photographers fanned out across the city to capture Opening Ceremony’s dance performance, Solange Knowles’s concert at Maryam Nassir Zadeh, Tom Ford’s final bow — and much more.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'T’s 25 Best Photos of New York Fashion Week', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'New York Fashion Week', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-09-14T20:01:00+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9ff0b0a7-6432-58a4-8f1d-f7d7c5e2252f', 'word_count': 48, 'uri': 'nyt://article/9ff0b0a7-6432-58a4-8f1d-f7d7c5e2252f'}, {'abstract': 'Suggested reading from critics and editors at The New York Times.', 'web_url': 'https://www.nytimes.com/2017/09/14/books/review/11-new-books-we-recommend-this-week.html', 'snippet': 'Suggested reading from critics and editors at The New York Times.', 'lead_paragraph': 'Mikhail Gorbachev was one of the most influential leaders of the 20th century, and William Taubman’s new biography of him is essential reading for the 21st, as we trace the arc from the fall of the Soviet Union to the rise of Putin’s Russia. Kurt Andersen digs up the roots of alternative facts in American culture (hint: it starts with the Pilgrims) in “Fantasyland”; and Ben Blum investigates a cousin’s inexplicable crime in “Ranger Games.” In fiction, new works by the acclaimed novelists Jesmyn Ward and Claire Messud encompass themes of childhood and loss. And Margaret Wilkerson Sexton makes a luminous debut with her novel set in New Orleans, “A Kind of Freedom.”', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/17/books/review/17ed-covers/17ed-covers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/17/books/review/17ed-covers/17ed-covers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/17/books/review/17ed-covers/17ed-covers-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/17/books/review/17ed-covers/17ed-covers-articleLarge.jpg', 'height': 298, 'width':