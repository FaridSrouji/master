/09/20/world/20oz-flu-1/20oz-flu-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/20/world/20oz-flu-1/20oz-flu-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/world/20oz-flu-1/20oz-flu-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Australia Wasn’t Ready for a Dangerous Flu Season', 'kicker': 'The Breakdown', 'content_kicker': None, 'print_headline': 'Flu Season Hits Australia Hard, Raising Questions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'vis-multimedia', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Influenza', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Vaccination and Immunization', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Epidemics', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Centers for Disease Control and Prevention', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Melbourne (Australia)', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-09-19T19:00:14+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Australia', 'byline': {'original': 'By Adam Baidawi', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Baidawi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/a249a99d-6810-575d-87fb-5c18440ec8d5', 'word_count': 691, 'uri': 'nyt://article/a249a99d-6810-575d-87fb-5c18440ec8d5'}, {'abstract': 'What if your most important experiences could live on after you die?', 'web_url': 'https://www.nytimes.com/2017/09/19/opinion/the-remembering-machine.html', 'snippet': 'What if your most important experiences could live on after you die?', 'lead_paragraph': 'Growing up in Toronto in the 1980s, I had a connection to Holocaust history that was direct, visceral and human. Each year, Holocaust survivors came to my school to talk about what they had experienced during the war. It wasn’t unusual for these survivors to be the grandparents of a classmate. Some of them had just begun telling their stories for the first time. I thought of my own grandparents, survivors from Poland who eventually immigrated to Montreal. They hardly ever spoke to me about what happened to them and the family members they lost. It was too painful for them to tell, and I was too afraid to ask.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '116 Cameras', 'kicker': 'Op-Docs', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'War Crimes, Genocide and Crimes Against Humanity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Shoah Foundation', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Poland', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-09-19T19:00:29+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Davina Pardo', 'person': [{'firstname': 'Davina', 'middlename': None, 'lastname': 'Pardo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7388e215-a4c3-5e24-b16a-9594751d4563', 'word_count': 391, 'uri': 'nyt://article/7388e215-a4c3-5e24-b16a-9594751d4563'}, {'abstract': 'To write “Nomadland,” Jessica Bruder spent three years traveling and working alongside grandparents and others living in school buses and vans seeking seasonal work.', 'web_url': 'https://www.nytimes.com/2017/09/19/books/review-nomadland-jessica-bruder.html', 'snippet': 'To write “Nomadland,” Jessica Bruder spent three years traveling and working alongside grandparents and others living in school buses and vans seeking seasonal work.', 'lead_paragraph': 'As far as human inventions go, retirement is shockingly recent, and proving fragile. A fringe idea until the 20th century — and one that outraged many — it took tenuous hold in the United States in the 1930s, during the Great Depression. Today, only 17 percent of Americans imagine they will be able to afford to stop working someday.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/arts/20bookbruder3/20bookbruder3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/20/arts/20bookbruder3/20bookbruder3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/arts/20bookbruder3/20bookbruder3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/arts/20bookbruder3/20bookbruder3-superJumbo.jpg', 'height': 1200, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/20/arts/20bookbruder3/20bookbruder3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/20/arts/20book