17Arctic-1/17Arctic-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/17/us/17Arctic-1/17Arctic-1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/17/us/17Arctic-1/17Arctic-1-superJumbo.jpg', 'height': 1199, 'width': 1799, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Trump and Arctic Drilling', 'kicker': 'Letter', 'content_kicker': None, 'print_headline': 'Trump and Arctic Drilling', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Offshore Drilling and Exploration', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ARCTIC NATIONAL WILDLIFE REFUGE', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-09-25T17:31:22+0000', 'document_type': 'article', 'news_desk': 'Letters', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/7d0b212e-2462-5bad-bf6b-a4159fff5112', 'word_count': 207, 'uri': 'nyt://article/7d0b212e-2462-5bad-bf6b-a4159fff5112'}, {'abstract': 'We chose the gesture purposefully. Our bodies were like flags flown at half-mast to mark a tragedy.', 'web_url': 'https://www.nytimes.com/2017/09/25/opinion/colin-kaepernick-football-protests.html', 'snippet': 'We chose the gesture purposefully. Our bodies were like flags flown at half-mast to mark a tragedy.', 'lead_paragraph': 'In early 2016, I began paying attention to reports about the incredible number of unarmed black people being killed by the police. The posts on social media deeply disturbed me, but one in particular brought me to tears: the killing of Alton Sterling in my hometown Baton Rouge, La. This could have happened to any of my family members who still live in the area. I felt furious, hurt and hopeless. I wanted to do something, but didn’t know what or how to do it. All I knew for sure is that I wanted it to be as respectful as possible.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/insider/25reidSub/25reidSub-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/27/insider/25reidSub/25reidSub-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/insider/25reidSub/25reidSub-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/insider/25reidSub/25reidSub-articleLarge.jpg', 'height': 423, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/27/insider/25reidSub/25reidSub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 423}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/insider/25reidSub/25reidSub-jumbo.jpg', 'height': 722, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/27/insider/25reidSub/25reidSub-superJumbo.jpg', 'height': 1445, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Eric Reid: Why Colin Kaepernick and I Decided to Take a Knee', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, '