ges/2017/09/12/world/12Barcelona1/12Barcelona1-sub-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/12/world/12Barcelona1/12Barcelona1-sub-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Protest in Catalonia Adds to Pressure Before Independence Vote', 'kicker': None, 'content_kicker': None, 'print_headline': 'Protest in Barcelona Adds Pressure Before Vote on Catalan Independence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Barcelona (Spain)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Catalonia (Spain)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Referendums', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'vis-photo', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-09-11T21:14:07+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Raphael Minder', 'person': [{'firstname': 'Raphael', 'middlename': None, 'lastname': 'Minder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7749682a-c324-5bc3-842e-b2cf01a33336', 'word_count': 700, 'uri': 'nyt://article/7749682a-c324-5bc3-842e-b2cf01a33336'}, {'abstract': 'The latest from the Harry & Ida team, Delmonico’s celebrates its 180th anniversary, and a new way to make meatballs.', 'web_url': 'https://www.nytimes.com/2017/09/11/dining/harry-and-idas-luncheonette-delmonicos-restaurant.html', 'snippet': 'The latest from the Harry & Ida team, Delmonico’s celebrates its 180th anniversary, and a new way to make meatballs.', 'lead_paragraph': 'Will and Julie Horowitz, a brother-and-sister team, have opened a financial district offshoot of Harry & Ida’s Meat & Supply, their grocery and casual dining spot in the East Village with an Old World point of view and an emphasis on local, homemade smoked and pickled foods. This branch, called Harry & Ida’s Luncheonette (the name refers to the Horowitzes’ great-grandparents), is more spacious and serves plates priced at less than $15. “We take ideas from our heritage,” Mr. Horowitz said. “Uptown, we did the meat thing, but, here, it’s more about vegetables.” You’ll still find Mr. Horowitz’s succulent pastrami, but he is also preparing turnip-noodle kasha varnishkes, carrot tsimmes with urfa chiles and lime, and smoked apricot ras-el-hanout chicken, all available to eat in or to take out as single portions or by the pound. Pickles, sauerkraut and other items often rely on vegetable discards, like mushroom stems and the outer leaves of cabbage. Stale babka is used in burnt-sugar babka soft-serve: Harry & Ida’s Luncheonette, 11 Park Place (Church Street), 917-409-0028, meatandsupplyco.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/13/dining/13Burner6/13Burner6-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/13/dining/13Burner6/13Burner6-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/13/dining/13Burner6/13Burner6-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank