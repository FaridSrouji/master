 2, 'major': 'N'}], 'pub_date': '2017-09-15T12:00:02+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'byline': {'original': 'By Daniel M. Gold', 'person': [{'firstname': 'Daniel', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f235987-96c9-54f0-9b58-96f70412a220', 'word_count': 168, 'uri': 'nyt://article/0f235987-96c9-54f0-9b58-96f70412a220'}, {'abstract': 'Jaap van Zweden, the next music director, opens the season with contemporary music and Mahler.', 'web_url': 'https://www.nytimes.com/2017/09/15/arts/music/new-york-philharmonic-philip-glass-jaap-van-zweden.html', 'snippet': 'Jaap van Zweden, the next music director, opens the season with contemporary music and Mahler.', 'lead_paragraph': 'His official title is still Music Director Designate, but for the musicians of the New York Philharmonic he’s the new boss: Jaap van Zweden, the Dutch conductor who will take over the reins of the city’s most storied ensemble, tests the waters with a pair of concerts comprising Mahler and Philip Glass. Critics who fretted over his lackadaisical embrace of contemporary music may be heartened to see Mr. van Zweden start the new season with a New York premiere of the Concerto for Two Pianos and Orchestra by Mr. Glass, who has long been cold-shouldered by the Philharmonic.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/17/arts/17GUIDE5/17GUIDE5-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/17/arts/17GUIDE5/17GUIDE5-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, '