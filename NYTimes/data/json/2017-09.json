mages/2017/09/12/world/12Nations/12Nations-jumbo.jpg', 'height': 666, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/12/world/12Nations/12Nations-superJumbo.jpg', 'height': 1331, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'After U.S. Compromise, Security Council Strengthens North Korea Sanctions', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.N. Compromise Tightens Clamp On North Korea', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'North Korea', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Weapons', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Nuclear Tests', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Security Council (UN)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ARMS CONTROL AND LIMITATION AND DISARMAMENT', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Haley, Nikki R', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 12, 'major': 'N'}], 'pub_date': '2017-09-11T16:07:45+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Somini Sengupta', 'person': [{'firstname': 'Somini', 'middlename': None, 'lastname': 'Sengupta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3f08e98-9979-5491-bfef-bb3a197aca62', 'word_count': 1352, 'uri': 'nyt://article/c3f08e98-9979-5491-bfef-bb3a197aca62'}, {'abstract': 'Paxil was approved following large clinical trials. But two suicides recorded in the placebo group should not have been counted, an F.D.A. reviewer wrote.', 'web_url': 'https://www.nytimes.com/2017/09/11/well/live/suicide-data-incorrectly-reported-in-drug-trials-suit-claims.html', 'snippet': 'Paxil was approved following large clinical trials. But two suicides recorded in the placebo group should not have been counted, an F.D.A. reviewer wrote.', 'lead_paragraph': 'For many years GlaxoSmithKline and its predecessor, SmithKline Beecham, marketed Paxil as an antidepressant that would reduce the risk of suicide in depressed patients. The results of the company’s clinical trials, presented to the Food and Drug Administration in 1989, suggested Paxil was far safer than a placebo.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/11/science/well-paxil-side/well-paxil-side-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/09/11/science/well-paxil-side/well-paxil-side-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/11/science/well-paxil-side/well-paxil-side-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/09/11/science/well-paxil-side/well-paxil-side-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/09/11/science/well-pax