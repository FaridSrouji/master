es/2017/10/08/travel/08HOURS-SONOMA3/08HOURS-SONOMA3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/08/travel/08HOURS-SONOMA3/08HOURS-SONOMA3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/08/travel/08HOURS-SONOMA3/08HOURS-SONOMA3-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/10/08/travel/08HOURS-SONOMA3/08HOURS-SONOMA3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/08/travel/08HOURS-SONOMA3/08HOURS-SONOMA3-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/08/travel/08HOURS-SONOMA3/08HOURS-SONOMA3-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '36 Hours in Sonoma County, Calif.', 'kicker': '36 Hours', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Sonoma County (Calif)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-09-28T09:00:03+0000', 'document_type': 'multimedia', 'news_desk': 'Travel', 'section_name': 'Travel', 'byline': {'original': 'By AMY THOMAS', 'person': [{'firstname': 'Amy', 'middlename': None, 'lastname': 'THOMAS', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/11a7bae2-d37f-54ec-bfec-fccd93ac3734', 'word_count': 0, 'uri': 'nyt://interactive/11a7bae2-d37f-54ec-bfec-fccd93ac3734'}, {'abstract': 'Trickle-down economics that works, at least on TV.', 'web_url': 'https://www.nytimes.com/2017/09/28/magazine/letter-of-recommendation-shark-tank.html', 'snippet': 'Trickle-down economics that works, at least on TV.', 'lead_paragraph': 'When I was 10 or so, my mom took me to a Fourth of July barbecue so we could celebrate America in our traditional family way — at her Howard Zinn-reading grad-student friend’s apartment, where most of the other guests were aspiring screenwriters. The America we celebrated was one that encouraged protest and strived for justice, peace and equality. My lasting memory of the party came after dark, after the fireworks, after the hot dogs, when the host brought out a tiny American flag and set fire to it. He handed it to me. I was mesmerized, enchanted. I held the small wooden pole and watched the sacred symbol of America burn. It was the mid-’80s, and Ronald Reagan was a hated capitalist pig in our household.', 'print_section': 'MM', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/magazine/01mag-01lor-copy/01mag-01lor-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/10/01/magazine/01mag-01lor-copy/01mag-01lor-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/magazine/01mag-01lor-copy/01mag-01lor-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/10/01/magazin