: [], 'headline': {'main': '1892: Narrow Escape for the Warship Plassy', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Ships and Shipping', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'England', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-03-09T15:25:45+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5efac6bb-3a24-56d1-a0dc-4335c0775787', 'word_count': 358, 'uri': 'nyt://article/5efac6bb-3a24-56d1-a0dc-4335c0775787'}, {'abstract': 'The National Endowment for the Arts gave $14.5 million to 419 organizations in New York City in the last fiscal year. The federal program could be cut under the Trump administration.', 'web_url': 'https://www.nytimes.com/2017/03/09/nyregion/national-endowment-for-the-arts-new-york.html', 'snippet': 'The National Endowment for the Arts gave $14.5 million to 419 organizations in New York City in the last fiscal year. The federal program could be cut under the Trump administration.', 'lead_paragraph': 'New York City sees itself as the cultural capital of the nation — if not the world — but its artistic community is suddenly vulnerable to budget cuts in Washington, where the administration of President Trump is considering eliminating the National Endowment for the Arts, which provides millions of dollars each year to groups in the city.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/10/nyregion/10NYCARTS/10NYCARTS-thumbStandard