a', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Referendums', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Catalonia (Spain)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mas, Artur (1956- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Great Britain Withdrawal from EU (Brexit)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Sturgeon, Nicola', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Scotland', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-03-13T17:01:31+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Raphael Minder', 'person': [{'firstname': 'Raphael', 'middlename': None, 'lastname': 'Minder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d71cc5c1-2776-5978-b866-ee5d58a903d4', 'word_count': 567, 'uri': 'nyt://article/d71cc5c1-2776-5978-b866-ee5d58a903d4'}, {'abstract': 'A new counter at Le District serves potatoes that yearn for mayo or a poutine makeover.', 'web_url': 'https://www.nytimes.com/2017/03/13/dining/french-fries-le-district-bar-a-frites-nyc.html', 'snippet': 'A new counter at Le District serves potatoes that yearn for mayo or a poutine makeover.', 'lead_paragraph': 'An appropriate new addition to Le District, the French market in Battery Park City, is a French fry counter. Hand-cut fries are cooked to order, emerging hot and crisp with a soft interior. They are served with an array of dipping sauces, including several mayonnaise variations and Maille French mustard on tap. The fries can be plated as poutine, the French Canadian indulgence with cheese curds and gravy, or as a topping for a nice portion of beef Bourguignon. Beer and wine are also served: Fries, $5.45 to $8.95, Bar à Frites, Le District, Brookfield Place, 225 Liberty Street (West Street), 212-981-8588, ledistrict.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/15/dining/15BURNER-FRIES/15BURNER-FRIES-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/15/dining/15BURNER-FRIES/15BURNER-FRIES-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/15/dining/15BURNER-FRIES/15BURNER-FRIES-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/15/dining/15BURNER-FRIES/15BURNER-FRIES-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/15/dining/15BURNER-FRIES/15BURNER-FRIES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 800}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/15/dining/15BURNER-FRIES/15BURNER-FRIES-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/15/dining/15BURNER-FRIES/15BURNER-FRIES-superJumbo.jpg', 'height': 2048, 'width': 1536, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'French Fries Ready to Dip in Lower Manhattan', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Snack: Truly French 