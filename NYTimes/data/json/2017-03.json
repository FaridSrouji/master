 seem to intersect in this work.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/19/arts/19GUIDE2/19GUIDE2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/19/arts/19GUIDE2/19GUIDE2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/19/arts/19GUIDE2/19GUIDE2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/19/arts/19GUIDE2/19GUIDE2-articleLarge.jpg', 'height': 421, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/19/arts/19GUIDE2/19GUIDE2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 421}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/19/arts/19GUIDE2/19GUIDE2-jumbo.jpg', 'height': 718, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/19/arts/19GUIDE2/19GUIDE2-superJumbo.jpg', 'height': 1436, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'International Street Cannibals, Feasting on Schoenberg', 'kicker': None, 'content_kicker': None, 'print_headline': 'Classical; ‘Cannibals’ Feast on Schoenberg', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Schoenberg, Arnold', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value'