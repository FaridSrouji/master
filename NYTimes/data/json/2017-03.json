me': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A ‘Sanctuary City’ Seizes the Moment, and the Name', 'kicker': 'Editorial Observer', 'content_kicker': None, 'print_headline': 'A ‘Sanctuary City’ Seizes the Moment, and the Name', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Santa Ana (Calif)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Illegal Immigration', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Immigration and Customs Enforcement (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-03-03T08:21:24+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Lawrence Downes', 'person': [{'firstname': 'Lawrence', 'middlename': None, 'lastname': 'Downes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/914e4db4-4d33-59b2-b722-dcc67bc87d6f', 'word_count': 858, 'uri': 'nyt://article/914e4db4-4d33-59b2-b722-dcc67bc87d6f'}, {'abstract': 'I credit President Trump — not that he seems any more evolved than the first earthworms now appearing in the cold soil of my garden.', 'web_url': 'https://www.nytimes.com/2017/03/03/opinion/a-great-new-accidental-renaissance.html', 'snippet': 'I credit President Trump — not that he seems any more evolved than the first earthworms now appearing in the cold soil of my garden.', 'lead_paragraph': 'My friend Sam laughed when I told him I was going to spend my Saturday at a “Search for Meaning” festival at a Jesuit college in the heart of seriously secular Seattle. He assumed, as I did, that a bare handful of the usual search-for-meaning suspects would be straining minutiae while still clinging to the meaninglessness of it all.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/03/opinion/03eganWeb/03eganWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/03/opinion/03eganWeb/03eganWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/03/opinion/03eganWeb/03eganWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/03/opinion/03eganWeb/03eganWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/03/opinion/03eganWeb/03eganWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/03/opinion/03eganWeb/03eganWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/03/opinion/03eganWeb/03eganWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Great New Accidental Renaissance', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of the Press', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Courts and the Judiciary', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Saturday Night Live (TV Program)', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-03-03T08:21:25+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0c024874-78e9-59e8-982d-1ef4de8f5c23', 'word_count': 810, 'uri': 'nyt://article/0c024874-78e9-59e8-982d-1ef4de8f5c23'}, {'abstract': 'The rich are the only ones who could be truly free in his vision of the country.', 'web_url': 'https://www.nytimes.com/2017/03/03/opinion/paul-ryans-misguided-sense-of-freedom.html', 'snippet': 'The rich are the only ones who could be truly free in his vision of the country.', 'lead_paragraph': 'In his first address to Congress, President Trump made many sweeping pledges, but one of them was familiar to anyone who listened to him campaign. He said that he was “calling on this Congress to repeal and replace Obamacare” and demanding “reforms that expand choice, increase access, lower costs and, at the same time, provide better health care.”', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/03/opinion/03covert/03covert-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/03/opinion/03covert/03covert-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/03/opinion/0