redit': None, 'type': 'image', 'url': 'images/2017/03/27/world/australia/australia-sky/australia-sky-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cyclone Debbie Strikes Queensland in Australia With Full Fury', 'kicker': None, 'content_kicker': None, 'print_headline': 'Cyclone Barrels Toward Australia’s Northeast Coast', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cyclones', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Bureau of Meteorology (Australia)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Queensland (Australia)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Weather', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricanes and Tropical Storms', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'vis-multimedia', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-03-27T06:41:55+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Australia', 'byline': {'original': 'By Jacqueline Williams', 'person': [{'firstname': 'Jacqueline', 'middlename': None, 'lastname': 'Williams', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/19a16ed3-b48e-5ea4-af6c-b598faf823da', 'word_count': 608, 'uri': 'nyt://article/19a16ed3-b48e-5ea4-af6c-b598faf823da'}, {'abstract': 'Since taking office on June 30, Rodrigo Duterte of the Philippines has made it open season on drug dealers and users, whose killings have been documented by brave and dedicated local journalists.', 'web_url': 'https://lens.blogs.nytimes.com/2017/03/27/dutertes-war-on-drugs-through-a-local-photographers-eyes/', 'snippet': 'Since taking office on June 30, Rodrigo Duterte of the Philippines has made it open season on drug dealers and users, whose killings have been documented by brave and dedicated local journalists.', 'lead_paragraph': '“When a President Says ‘I’ll Kill You’” is a Times documentary on the deadly crusade led by President Rodrigo Duterte of the Philippines that he has called “a war on drugs.” The film features Raffy Lerma, a photojournalist for The Philippine Daily Inquirer who has tirelessly worked to tell the story of the the killings. Andrew Glazer, a senior video producer for The Times, recounts some of his experiences making the documentary.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Duterte’s War on Drugs Through a Local Photographer’s Eyes', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Police', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Duterte, Rodrigo', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Lerma, Raffy', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Manila (Philippines)', 'rank': 9, 'major': 'N'}], 'pub_date': '2017-03-27T07:00:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Andrew Glazer', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Glazer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/78141bec-64b7-51e6-acac-b380a36f6f3f', 'word_count': 823, 'uri': 'nyt://article/78141bec-64b7-51e6-acac-b380a36f6f3f'}, {'abstract': 'We were surprised by Donald Trump because we assumed both humans and history were driven by reason.', 'web_url': 'https://www.nytimes.com/2017/03/27/opinion/our-delight-in-destruction.html', 'snippet': 'We were surprised by Donald Trump because we assumed both humans and history were driven by reason.', 'lead_paragraph': '“I, for example,” says the nameless narrator in Fyodor Dostoevsky’s “Notes From Underground (1864),” “would not be the least bit surprised if suddenly, out of the blue, amid the universal future reasonableness, some gentleman of ignoble or, better, of retrograde and jeering physiognomy, should emerge, set his arms akimbo, and say to us all: ‘Well, gentlemen, why don’t we reduce all this reasonableness to dust with one good kick, for the sole purpose of sending all these logarithms to the devil and living once more according to our own stupid will!’ That would still be nothing, but what is offensive is that he’d be sure to find followers: that’s how man is arranged.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/27/opinion/27stoneWeb/27stoneWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/27/opinion/27stoneWeb/27stoneWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/27/opinion/27stoneWeb/27stoneWeb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/27/opinion/27stoneWeb/27stoneWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/27/opinion/27stoneWeb/27stoneWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/27/opinion/27stoneWeb/27stoneWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/27/opinion/27stoneWeb/27stoneWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Our Delight in Destruction', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dostoyevsky, Fyodor', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-03-27T07:20:24+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Costica Bradatan', 'person': [{'firstname': 'Costica', 'middlename': None, 'lastname': 'Bradatan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/315150b2-58d1-5d0d-b79d-6860f36b424b', 'word_count': 1315, 'uri': 'nyt://article/315150b2-58d1-5d0d-b79d-6860f36b424b'}, {'abstract': 'A Vietnam vet writes that veterans need our support to help them live more normal lives.', 'web_url': 'https://www.nytimes.com/2017/03/27/opinion/help-for-veterans.html', 'snippet': 'A Vietnam vet writes that veterans need our support to help them live more normal lives.', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/12/opinion/sunday/12sun1/