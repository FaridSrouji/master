ge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Toronto Schools to Cease Field Trips to U.S.', 'kicker': None, 'content_kicker': None, 'print_headline': 'School Trips From Toronto to the U.S. Will Cease', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Toronto (Ontario)', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-03-24T23:17:56+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Craig S. Smith', 'person': [{'firstname': 'Craig', 'middlename': 'S.', 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/31327d48-8103-5e0e-a89b-a933bc1cad6c', 'word_count': 897, 'uri': 'nyt://article/31327d48-8103-5e0e-a89b-a933bc1cad6c'}, {'abstract': 'A group of young people at the memorial stripped naked, slaughtered a sheep and chained themselves together. The police are trying to figure out why.', 'web_url': 'https://www.nytimes.com/2017/03/24/world/europe/poland-auschwitz-nazi-stunt-sheep.html', 'snippet': 'A group of young people at the memorial stripped naked, slaughtered a sheep and chained themselves together. The police are trying to figure out why.', 'lead_paragraph': 'WARSAW — Nearly a dozen people in their 20s gathered beside the entrance to the Auschwitz memorial on Friday afternoon, slaughtered a sheep, stripped naked and chained themselves together. A fireworks device was set off in the nearby parking lot.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'cre