or': 'N'}], 'pub_date': '2017-03-28T10:54:26+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Paul Mozur', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Mozur', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3cac6fac-6b79-5e96-b09a-8ccb253d664d', 'word_count': 713, 'uri': 'nyt://article/3cac6fac-6b79-5e96-b09a-8ccb253d664d'}, {'abstract': '“The Inheritance” is about five siblings (out of six) who inherited a genetic mutation that leads to early-onset Alzheimer’s.', 'web_url': 'https://www.nytimes.com/2017/03/28/books/tell-us-5-things-about-your-book-one-familys-war-against-alzheimers.html', 'snippet': '“The Inheritance” is about five siblings (out of six) who inherited a genetic mutation that leads to early-onset Alzheimer’s.', 'lead_paragraph': 'Imagine knowing you’ll get Alzheimer’s before you get old. The six children of Galen and Gail DeMoe were born with a 50 percent chance of inheriting a genetic mutation that would, with certainty, lead to early-onset Alzheimer’s. Five of them ended up with the gene. Niki Kapsambelis’s “The Inheritance” combines a history of Alzheimer’s — its first discovery, the challenges in diagnosing it and the thus-far fruitless efforts to treat it — with the story of the DeMoes, who have dedicated themselves to the scientific cause of combating the disease. Below, Kapsambelis tells us about the inspiration for the book, what she learned while writing it and more.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/28/books/28inheritance/28inheritance-jumbo.jpg', 'height': 800, 'width': 530, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit