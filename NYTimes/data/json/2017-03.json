21:13+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Timothy Egan', 'person': [{'firstname': 'Timothy', 'middlename': None, 'lastname': 'Egan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/0904b931-a849-5655-af77-d3b5fd28c878', 'word_count': 846, 'uri': 'nyt://article/0904b931-a849-5655-af77-d3b5fd28c878'}, {'abstract': 'American life has secularized and grand political ideologies have fallen away, but moral conflict has only intensified.', 'web_url': 'https://www.nytimes.com/2017/03/31/opinion/the-strange-persistence-of-guilt.html', 'snippet': 'American life has secularized and grand political ideologies have fallen away, but moral conflict has only intensified.', 'lead_paragraph': 'In 1981 the philosopher Alasdair MacIntyre opened his book “After Virtue” with a passage that is now famous. Imagine if we lost the theoretical coherence of science. Imagine if we still used scientific words like neutrino and atomic weight, but had no overall framework to explain how they fit together.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/31/opinion/31brooksWeb/31brooksWeb-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/31/opinion/31brooksWeb/31brooksWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/31/opinion/31brooksWeb/31brooksWeb-jumbo.jpg', 'height': 673, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/31/opinion/