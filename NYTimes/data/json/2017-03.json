s', 'value': 'Faithfull, Marianne', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Living Theater', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-03-09T21:48:06+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Glenn Kenny', 'person': [{'firstname': 'Glenn', 'middlename': None, 'lastname': 'Kenny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/46ac7867-a1eb-5737-b6b6-2f2ba7703b8f', 'word_count': 262, 'uri': 'nyt://article/46ac7867-a1eb-5737-b6b6-2f2ba7703b8f'}, {'abstract': 'A lesson pairing a scene from the classic young adult novel — turning 50 this spring — with an article about gangs on Chicago’s South Side.', 'web_url': 'https://www.nytimes.com/2017/03/09/learning/lesson-plans/text-to-text-the-outsiders-and-bored-broke-and-armed.html', 'snippet': 'A lesson pairing a scene from the classic young adult novel — turning 50 this spring — with an article about gangs on Chicago’s South Side.', 'lead_paragraph': 'Browse all our Text to Text lesson plans.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/22/us/00chicagogangs-4/00chicagogangs-4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/12/22/us/00chicagogangs-4/00chicagogangs-4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/22/us/00chicagogangs-4/00chicagogangs-4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/12/22/us/00chicagogangs-4/00ch