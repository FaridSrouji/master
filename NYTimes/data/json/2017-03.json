ate': '2017-03-31T16:24:31+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Robert Frank', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Frank', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1de44ea1-e923-5747-92f7-5844fe585270', 'word_count': 1174, 'uri': 'nyt://article/1de44ea1-e923-5747-92f7-5844fe585270'}, {'abstract': 'Did Americans in positions of power betray their country? We need to know, as soon as possible.', 'web_url': 'https://www.nytimes.com/2017/03/31/opinion/trump-is-right-give-michael-flynn-immunity.html', 'snippet': 'Did Americans in positions of power betray their country? We need to know, as soon as possible.', 'lead_paragraph': 'Michael T. Flynn, the retired general who served a brief month as President Trump’s national security adviser, wants to make a deal. He is seeking immunity from prosecution in exchange for testifying on the Trump campaign’s possible coordination with Russia. Instead of categorically rejecting Mr. Flynn’s offer, as the Senate Intelligence Committee appears to have done today, at least for the moment, both houses of Congress and federal prosecutors should carefully review Flynn’s proffered testimony and the details of the immunity deal and then make a decision.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/31/opinion/31eisenWeb/31eisenWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/31/opinion/31eisenWeb/31eisenWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/31/opinion/31eisenWeb/31eisenWeb-jumbo.jp