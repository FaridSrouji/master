lson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/925434e6-58f8-53ad-93c3-ffd6caf3945c', 'word_count': 787, 'uri': 'nyt://article/925434e6-58f8-53ad-93c3-ffd6caf3945c'}, {'abstract': 'Sally Quinn has decided to sell the fabled East Hampton house whose occupants have been the subject of both a documentary and a Broadway musical.', 'web_url': 'https://www.nytimes.com/2017/03/02/fashion/news/grey-gardens-real-estate-sally-quinn-summer-home-sale.html', 'snippet': 'Sally Quinn has decided to sell the fabled East Hampton house whose occupants have been the subject of both a documentary and a Broadway musical.', 'lead_paragraph': 'EAST HAMPTON, N.Y. — On a recent afternoon, Sally Quinn walked through Grey Gardens, her fabled summer home, one that has been the subject of both a documentary film and a Broadway musical, and passed by a glass menagerie of tiny kittens. The figurines had once belonged to Edith Bouvier Beale, better known as Little Edie, a woman of many cats, who for years lived in the house with her mother, known as Big Edie. Both were former socialites and relatives of Jacqueline Kennedy Onassis.', 'print_section': 'D', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/fashion/02GREYGARDENS/02GREYGARDENS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/02/fashion/02GREYGARDENS/02GREYGARDENS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/fashion/02GREYGARDENS/02GREYGARDENS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/fashion/02GREYGARDENS/02GREYGARDENS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/02/fashion/02GREYGARDENS/02GREYGARDENS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/fashion/02GREYGARDENS/02GREYGARDENS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/fashion/02GREYGARDENS/02GREYGARDENS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Want to Live in Grey Gardens? It Can Be Yours for $20 Million', 'kicker': None, 'content_kicker': None, 'print_headline': 'Parting With Grey Gardens', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Quinn, Sally', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Beale, Edith Bouvier', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Historic Buildings and Sites', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'East Hampton (NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-03-02T08:29:27+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Katie Rogers', 'person': [{'firstname': 'Katie', 'middlename': None, 'lastname': 'Rogers', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b9cf108d-a6fe-5297-bf00-bb8d88756872', 'word_count': 1486, 'uri': 'nyt://article/b9cf108d-a6fe-5297-bf00-bb8d88756872'}, {'abstract': 'An immigration researcher explains what’s really going on.', 'web_url': 'https://www.nytimes.com/2017/03/02/opinion/are-immigrants-causing-a-swedish-crime-wave.html', 'snippet': 'An immigration researcher explains what’s really going on.', 'lead_paragraph': 'Sweden has accepted more refugees on a per-capita basis than other Western nations in recent years. President Trump and his supporters say that this has led to increased crime and other problems in that country and argue that this is a reason the United States should accept fewer immigrants, especially those coming from the Middle East. Official data show that Sweden has not seen a spike in crime, though the influx has heightened anti-immigrant sentiment there. To better understand that country’s experience, I spoke to Henrik Emilsson, an international immigration researcher at Malmö University. The interview has been edited and condensed.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/opinion/01bajaj-TNweb/02bajaj-TNweb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/02/opinion/01bajaj-TNweb/02bajaj-TNweb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/opinion/01bajaj-TNweb/02bajaj-TNweb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/02/opinion/01bajaj-TNweb/02bajaj-TNweb-articleLarge.jpg', 'height': 451, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/02/opinion/01bajaj-TNweb/02bajaj-TNweb-articleLarge.jp