kelley-slide-BX8S-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-BX8S/08tmag-kelley-slide-BX8S-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside (and Under) “Mobile Homestead”', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-03-08T16:06:37+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/607e1b55-a071-5a88-aee0-35b9c2827625', 'word_count': 0, 'uri': 'nyt://slideshow/607e1b55-a071-5a88-aee0-35b9c2827625'}, {'abstract': 'The artist’s dream of a mobile gallery, a replica of his childhood home, is a compelling gift to Detroit. More fascinating is what lies beneath. ', 'web_url': 'https://www.nytimes.com/2017/03/08/t-magazine/art/mike-kelley-mobile-homestead.html', 'snippet': 'The artist’s dream of a mobile gallery, a replica of his childhood home, is a compelling gift to Detroit. More fascinating is what lies beneath. ', 'lead_paragraph': 'THERE IS A GLISTENING white ranch-style house on a small grassy lot behind the Museum of Contemporary Art Detroit, adjacent to the institution’s gravel parking lot. It is architecturally generic, like countless other homes scattered across this part of Michigan, and yet it also happens to be a work of art, the last major piece by the artist Mike Kelley. “Mobile Homestead” — a to-scale recreation of the house where Kelley grew up in Westland, a suburb 30 minutes from Detroit — is open to the public, a community exhibition space managed by the museum. Scarcely seen, though, is what sits far below it: an intricate underground lair often referred to, in a remarkable understatement, as “the basement.” Kelley planned on using it himself as a project space before committing suicide in 2012.', 'print_section': 'M2', 'print_page': '140', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-K22P/08tmag-kelley-slide-K22P-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-K22P/08tmag-kelley-slide-K22P-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-K22P/08tmag-kelley-slide-K22P-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-K22P/08tmag-kelley-slide-K22P-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-K22P/08tmag-kelley-slide-K22P-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-K22P/08tmag-kelley-slide-K22P-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/08/t-magazine/08tmag-kelley-slide-K22P/08tmag-kelley-slide-K22P-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Mike Ke