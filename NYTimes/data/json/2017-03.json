elchair', 'kicker': 'Disability', 'content_kicker': None, 'print_headline': 'TKT', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Disabilities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Subways', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Infrastructure (Public Works)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-03-29T07:20:49+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Sasha Blair-Goldensohn', 'person': [{'firstname': 'Sasha', 'middlename': None, 'lastname': 'Blair-Goldensohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/cbe3026e-4a13-5dee-9f95-9f34e93f16cd', 'word_count': 1113, 'uri': 'nyt://article/cbe3026e-4a13-5dee-9f95-9f34e93f16cd'}, {'abstract': 'Texas is condemning intellectually disabled people using an outdated and unscientific test. The justices were right to strike it down.', 'web_url': 'https://www.nytimes.com/2017/03/29/opinion/the-supreme-court-keeps-tinkering-with-death.html', 'snippet': 'Texas is condemning intellectually disabled people using an outdated and unscientific test. The justices were right to strike it down.', 'lead_paragraph': 'It’s been more than two decades since Justice Harry Blackmun renounced the death penalty, calling it a “failed” experiment and writing that “I no longer shall tinker with the machinery of death.” By refusing to stop the use of capital punishment, the Supreme Court has consigned itself to tinkering with the death machine, trying in vain to make a barbaric, irrational system appear predictable and just.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/0