10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/26/nyregion/26ALBUM1/26ALBUM1-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/26/nyregion/26ALBUM1/26ALBUM1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/26/nyregion/26ALBUM1/26ALBUM1-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/26/nyregion/26ALBUM1/26ALBUM1-superJumbo.jpg', 'height': 1359, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/26/nyregion/26ALBUM1/26ALBUM1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/26/nyregion/26ALBUM1/26ALBUM1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/26/nyregion/26ALBUM1/26ALBUM1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Magnum Photographers’ View of Midcentury New York', 'kicker': 'Album', 'content_kicker': None, 'print_headline': 'Midcentury City', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Magnum Photos', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-03-23T22:22:18+0000', 'document_type': 'article', 'news_desk': 'Metropolitan', 'section_na