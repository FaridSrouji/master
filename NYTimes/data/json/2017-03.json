 York Times', 'multimedia': [], 'headline': {'main': 'Mother and Son, Separated During South Sudan’s Civil War, Make Contact', 'kicker': 'Notebook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Middle East and Africa Migrant Crisis', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Kenya', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'South Sudan', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-03-30T17:25:08+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Lynsey Addario', 'person': [{'firstname': 'Lynsey', 'middlename': None, 'lastname': 'Addario', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a8803d92-5ddb-51b5-8a60-8486d671baac', 'word_count': 1889, 'uri': 'nyt://article/a8803d92-5ddb-51b5-8a60-8486d671baac'}, {'abstract': 'Should the Democrats filibuster? Or boycott the vote? Or accept Judge Neil Gorsuch because “they could do worse”?', 'web_url': 'https://www.nytimes.com/2017/03/30/opinion/democrats-options-as-the-supreme-court-vote-nears.html', 'snippet': 'Should the Democrats filibuster? Or boycott the vote? Or accept Judge Neil Gorsuch because “they could do worse”?', 'lead_paragraph': 'To the Editor:', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/30/opinion/31gorsuchWeb/00LgorsuchWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/30/opinion/31gorsuchWeb/00LgorsuchWeb-articl