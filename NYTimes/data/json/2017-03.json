perJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/20/arts/21DRAKE1/21DRAKE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/20/arts/21DRAKE1/21DRAKE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/20/arts/21DRAKE1/21DRAKE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: On Drake’s ‘More Life,’ the Creator Meets the Curator', 'kicker': None, 'content_kicker': None, 'print_headline': 'Meet Drake the Curator', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Drake (Rapper)', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'More Life (Album)', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-03-20T15:22:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b6cfaf6b-7f71-5775-92a9-25180f139d2e', 'word_count': 1027, 'uri': 'nyt://article/b6cfaf6b-7f71-5775-92a9-25180f139d2e'}, {'abstract': 'A new exhibition shows some of the work of John Donohue, a former New Yorker editor, who draws city architecture.', 'web_url': 'https://www.nytimes.com/2017/03/20/dining/art-all-the-restaurants-in-new-york-john-donohue.html', 'snippet': 'A new exhibition shows some of the work of John Donohue, a former New Yorker editor, who draws city architecture.', 'lead_paragraph': 'Calling his drawing project “All the Restaurants in New York” is “intentionally hyperbolic,” said John Donohue, a former New Yorker editor and cartoonist. But since it takes him only about 20 minutes to make each pen-and-ink sketch of a restaurant facade, he figures he can make short work recording many of them. He has been at it since January. Each print is available in a signed edition of 365, and a selection is on display in Brooklyn, where they sell for $100 ($95 online). Mr. Donohue donates some of the proceeds to hunger-relief charities: “All the Restaurants in New York,” through June 20, Powerhouse on 8th, 1111 Eighth Avenue (11th Street), Park Slope, Brooklyn, 718-666-3049, powerhouseon8th.com, alltherestaurants.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/22/dining/22BURNER-ART/22BURNER-ART-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/22/dining/22BURNER-ART/22BURNER-ART-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/22/dining/22BURNER-ART/22BURNER-ART-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/22/dining/22BURNER-ART/22BURNER-ART-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/22/dining/22BURNER-ART/22BURNER-ART-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/22/dining/22BURNER-ART/22BURNER-ART-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/22/dining/22BURNER-ART/22BURNER-ART-superJumbo.jpg', 'height': 1302, 'width': 1955, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'One Man’s Mission to Sketch New York Restaurants', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Admire: A Pen-and-Ink Record  of New York’s Restaurants', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Donohue, John (Cartoonist)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cartoons and Cartoonists', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-03-20T15:28:45+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8341632c-03f5-5611-9890-c68a671d63f8', 'word_count': 117, 'uri': 'nyt://article/8341632c-03f5-5611-9890-c68a671d63f8'}, {'abstract': 'Ms. Brown’s choreography, showcased primarily in New York, helped shape generations of modern dance creators into the 21st century.', 'web_url': 'https://www.nytimes.com/2017/03/20/arts/dance/trisha-brown-dead-modern-dance-choreographer.html', 'snippet': 'Ms. Brown’s choreography, showcased primarily in New York, helped shape generations of modern dance creators into the 21st century.', 'lead_paragraph': 'Trisha Brown, the choreographer and exemplar of the founding generation of American postmodern dance, died on Saturday in San Antonio. She was 80.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/21/arts/21brown-obit-1/21brown-obit-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/21/arts/21brown-obit-1/21brown-obit-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/21/arts/21brown-obit-1/21brown-obit-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/21/arts/21brown-obit-1/21brown-obit-1-articleLarge.jpg', 'height': 510, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/21/arts/21brown-obit-1/21brown-obit-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 510}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/21/arts/21brown-obit-1/21brown-obit-1-jumbo.jpg', 'height': 871, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/21/arts/21brown-obit-1/21brown-obit-1-superJumbo.jpg', 'height': 1741, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Trisha Brown, Choreographer and Pillar of American Postmodern Dance, Dies at 80', 'kicker': None, 'content_kicker': None, 'print_headline': 'Trisha Brown Dies at 80; Cerebral Choreographer and a Postmodern Pil