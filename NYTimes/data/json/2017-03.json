largewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/13/opinion/13pubedWeb/13pubedWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/13/opinion/13pubedWeb/13pubedWeb-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/13/opinion/13pubedWeb/13pubedWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/13/opinion/13pubedWeb/13pubedWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/13/opinion/13pubedWeb/13pubedWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Opinions Worth Savoring, With No Trump in Sight', 'kicker': 'The Public Editor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-03-13T20:19:17+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Public Editor', 'byline': {'original': 'By Liz Spayd', 'person': [{'firstname': 'Liz', 'middlename': None, 'lastname': 'Spayd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/5433fe28-6c71-5397-8c13-2009cae06d70', 'word_count': 628, 'uri': 'nyt://article/5433fe28-6c71-5397-8c13-2009cae06d70'}, {'abstract': 'Political discourse in the United States is at a boiling point, and nowhere is t