eview: ‘Mean Dreams’ Presents Lovers on the Lam With Quiet Skill', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mean Dreams', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Mean Dreams (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Morlando, Nathan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Paxton, Bill', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-03-16T21:12:37+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Andy Webster', 'person': [{'firstname': 'Andy', 'middlename': None, 'lastname': 'Webster', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c352f5f2-f131-5834-90cb-71acb3876510', 'word_count': 249, 'uri': 'nyt://article/c352f5f2-f131-5834-90cb-71acb3876510'}, {'abstract': 'Our guide to the city’s best classical music and opera.', 'web_url': 'https://www.nytimes.com/2017/03/16/arts/music/classical-music-in-nyc-this-week.html', 'snippet': 'Our guide to the city’s best classical music and opera.', 'lead_paragraph': 'Our guide to the city’s best classical music and opera.', 'print_section': 'C', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/17/arts/17LISTINGSCLASSICAL/17LISTINGSCLASSICAL-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/03/17/arts/17LISTINGSCLASSICAL/17LISTINGSCLASSICAL-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/17/arts/17LISTINGSCLASSICAL/17LISTINGSCLASSICAL-jumbo.jpg', 'height': 614, 'width