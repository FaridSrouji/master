e': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/11/arts/07bomba1/07bomba1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/09/11/arts/07bomba1/07bomba1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/11/arts/07bomba1/07bomba1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bomba Estéreo Strives to Save the Planet and Soothe the Heart', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bomba Estéreo Blends Heart and Planet', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Personal Profile', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Bomba Estereo (Music Group)', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Deja (Album)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mejia, Simon', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Colombia', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Saumet, Liliana', 'rank': 7, 'major': 'N'}], 'pub_date': '2021-09-07T20:33:14+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Jon Pareles', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Pareles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cebb3612-eba8-5618-9e7f-af67c5e0ecfb', 'word_count': 1316, 'uri': 'nyt://article/cebb3612-eba8-5618-9e7f-af67c5e0ecfb'}, {'abstract': 'Everything is covered in an encyclopedic new book by Matteo Zed, an Italian spirits expert.', 'web_url': 'https://www.nytimes.com/2021/09/07/dining/big-book-of-amaro.html', 'snippet': 'Everything is covered in an encyclopedic new book by Matteo Zed, an Italian spirits expert.', 'lead_paragraph': 'In an encyclopedic new book, the Italian amari expert Matteo Zed covers the spirit, the bitter drink as old as monasteries and made new in Brooklyn. Amari are sipped as digestivos, aperitivos and in cocktails. He tells their history, describes the 50 botanicals often used when making them, gives an idea of their styles and sorts them into categories. There’s an amaro renaissance going on worldwide and he helps it along, with his favorite ways to enjoy the spirit. There are descriptions of more than 200 Italian brands, a fascinating region-by-region and bottle-by-bottle survey, followed by a handful of amari from other countries. The book supplies recipes for cocktails using amari and a few dishes made with them, all beautifully photographed.', 'print_section': 'D', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/08/dining/06Burner-book/06Burner-book-articleLarge.jpg', 'height': 256, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/08/dining/06Burner-book/06Burner-book-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 256}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/08/dining/06Burner-book/06Burner-book-jumbo.jpg', 'height': 437, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/08/dining/06Burner-book/06Burner-book-superJumbo.jpg', 'height': 874, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption