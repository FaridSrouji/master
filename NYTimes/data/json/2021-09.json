'keywords': [{'name': 'organizations', 'value': 'Liberal Democratic Party (Japan)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elections', 'rank': 3, 'major': 'N'}], 'pub_date': '2021-09-28T20:00:11+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Motoko Rich', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9914f226-7a45-5f54-b2fa-2e3b34dd91e1', 'word_count': 973, 'uri': 'nyt://article/9914f226-7a45-5f54-b2fa-2e3b34dd91e1'}, {'abstract': 'The filmmaker has been quietly making small, eerie collages on newsprint for 20 years, with faces switched onto other bodies. Now they’re finally on view.', 'web_url': 'https://www.nytimes.com/2021/09/28/arts/design/jim-jarmusch-collages.html', 'snippet': 'The filmmaker has been quietly making small, eerie collages on newsprint for 20 years, with faces switched onto other bodies. Now they’re finally on view.', 'lead_paragraph': 'Jim Jarmusch likes removing the heads. He likes to swap the heads of world leaders with Picassos or Basquiats, or simply excise them entirely, leaving a head-shaped void. A man with a coyote’s head rides in the back of a car, rather dejected. Warhol’s head is a favorite motif: twin Andys in sunglasses standing stoically in a tunnel; Warhol’s head grafted onto a state official striding a tarmac; a man slouched in a chair, one of the artist’s Brillo boxes fixed where his head should be.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28jimjarmusch-1/28jimjarmusch-1-articleLarge.jpg', 'height': 754, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/28/arts/28jimjarmusch-1/28jimjarmusch-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 754}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28jimjarmusch-1/28jimjarmusch-1-jumbo.jpg', 'height': 1024, 'width': 815, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28jimjarmusch-1/28jimjarmusch-1-superJumbo.jpg', 'height': 2048, 'width': 1629, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28jimjarmusch-1/28jimjarmusch-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/09/28/arts/28jimjarmusch-1/28jimjarmusch-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28jimjarmusch-1/28jimjarmusch-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jim Jarmusch’s Collages Are Ready for Their Close-Up', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Content Type: Personal Profile', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Newspapers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jarmusch, Jim', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'James Fuentes Gallery (Manhattan, NY)', 'rank': 5, 'major': 'N'}], 'pub_date': '2021-09-28T20:10:20+0000', 'document_type': 'article', 'news_desk'