ons', 'value': 'Steube, W Gregory (1978- )', 'rank': 8, 'major': 'N'}], 'pub_date': '2021-09-30T15:52:51+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Carl Hulse', 'person': [{'firstname': 'Carl', 'middlename': None, 'lastname': 'Hulse', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/049d48d1-ec97-5184-b30d-345852e6fda6', 'word_count': 376, 'uri': 'nyt://article/049d48d1-ec97-5184-b30d-345852e6fda6'}, {'abstract': 'Telling the truth about the 45th president now doesn’t make up for enabling him then.', 'web_url': 'https://www.nytimes.com/2021/09/30/opinion/stephanie-grisham-trump-book.html', 'snippet': 'Telling the truth about the 45th president now doesn’t make up for enabling him then.', 'lead_paragraph': 'I did not and will not crack open the cover of Stephanie Grisham’s White House memoir, but yesterday I read sneak peeks and synopses of it, and there was a moment — a horrifying moment — when I warmed to her. It was when I learned that Grisham, the White House press secretary from July 2019 to April 2020, used the book to characterize Jared Kushner as “Rasputin in a slim-fitting suit.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/30/opinion/30bruni2/30bruni2-articleLarge.jpg', 'height': 544, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/30/opinion/30bruni2/30bruni2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 544}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/30/opinion/30bruni2/30bruni2-jumbo.jpg', 'height': 929, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'ca