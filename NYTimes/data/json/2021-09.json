e': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2021-09-19T10:33:07+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Remy Tumin', 'person': [{'firstname': 'Remy', 'middlename': None, 'lastname': 'Tumin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/09bc5923-adfb-51ba-9493-f824a4c7880a', 'word_count': 1349, 'uri': 'nyt://article/09bc5923-adfb-51ba-9493-f824a4c7880a'}, {'abstract': 'Nicholas Britell’s scores — for “Succession,” “Moonlight” and “The Underground Railroad,” among others — suggest whole new ways of writing for film and television.', 'web_url': 'https://www.nytimes.com/2021/09/19/podcasts/the-daily/the-sunday-read-the-composer-at-the-frontier-of-movie-music.html', 'snippet': 'Nicholas Britell’s scores — for “Succession,” “Moonlight” and “The Underground Railroad,” among others — suggest whole new ways of writing for film and television.', 'lead_paragraph': 'You have almost certainly heard Nicholas Britell’s music, even if you don’t know his name. More than any other contemporary composer, he appears to have the whole of music history at his command, shifting easily between vocabularies, often in the same film.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Sunday Read: ‘The Composer at the Frontier of Movie Music’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'audio-positive-happy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Britell, Nicholas (1980- )', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Succession (TV Program)', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Moonlight (Movie)', 'rank': 5, 'major': 'N'}, {'name