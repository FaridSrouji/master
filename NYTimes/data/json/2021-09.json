audiocontainer/74760bc9-1d23-5911-9119-d4da5677b41e'}, {'abstract': 'Monmouth University Poll released its findings the same day the Supreme Court added hearings on a Mississippi abortion case.', 'web_url': 'https://www.nytimes.com/2021/09/20/us/politics/abortion-poll.html', 'snippet': 'Monmouth University Poll released its findings the same day the Supreme Court added hearings on a Mississippi abortion case.', 'lead_paragraph': 'A majority of Americans disapproves of the Supreme Court’s recent decision to allow a ban on most abortions to take effect in Texas, with key aspects of the law — such as empowering private citizens to enforce it through lawsuits — proving overwhelmingly unpopular, according to a national poll released on Monday.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/20/us/politics/20political-briefing-abortion-texas1/merlin_194459211_b06b887e-8a5b-46d5-997f-9bc668147821-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/20/us/politics/20political-briefing-abortion-texas1/merlin_194459211_b06b887e-8a5b-46d5-997f-9bc668147821-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/20/us/politics/20political-briefing-abortion-texas1/merlin_194459211_b06b887e-8a5b-46d5-997f-9bc668147821-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/20/us/politics/20political-briefing-abortion-texas1/merlin_194459211_b06b887e-8a5b-46d5-997f-9bc668147821-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption':