imedia/05sp-design-bumkrooms-web1/merlin_193403469_57fdbbe0-27dc-4dd6-88b3-17e514c3dd02-superJumbo.jpg', 'height': 1895, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/05/multimedia/05sp-design-bumkrooms-web1/05sp-design-bumkrooms-web1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/09/05/multimedia/05sp-design-bumkrooms-web1/05sp-design-bumkrooms-web1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/05/multimedia/05sp-design-bumkrooms-web1/05sp-design-bumkrooms-web1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bunk Rooms Climb the Social Ladder', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bunk Rooms Get a Higher Profile', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Beds and Bedding', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 2, 'major': 'N'}], 'pub_date': '2021-09-02T09:00:19+0000', 'document_type': 'article', 'news_desk': 'SpecialSections', 'section_name': 'Style', 'byline': {'original': 'By Eve M. Kahn', 'person': [{'firstname': 'Eve', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/65c3c60c-f0bb-55b5-8af0-5762773176c2', 'word_count': 854, 'uri': 'nyt://article/65c3c60c-f0bb-55b5-8af0-5762773176c2'}, {'abstract': 'Nail-biting new crime fiction from Amy Stewart, Craig Nova, Catherine Dang and Karen Cleveland.', 'web_url': 'https://www.nytimes.com/2021/09/02/arts/new-mysteries-and-crime-fiction.html', 'snippet': 'Nail-biting new crime fiction from Amy Stewart, Craig Nova, Catherine Dang and Karen Cleveland.', 'lead_paragraph': 'In her ongoing historical mystery series, now seven books strong, Amy Stewart has embellished the lives of the real Kopp sisters, Constance, Norma and Fleurette. The first book, “Girl Waits With Gun,” drew on an actual crime (and Constance’s role as one of the country’s first female deputy sheriffs), but Stewart has since let her imagination roam. MISS KOPP INVESTIGATES (Mariner, 295 pp., paper, $15.99) — set in 1919 — sees Norma returned from overseas wartime duty, Constance about to embark on a new career with the Bureau of Investigation, as the F.B.I. was then called, and Fleurette, her theater dreams dashed after a case of scarlet fever, finding new ways to employ her talents.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/05/books/review/05Crime/05Crime-articleLarge.jpg', 'height': 951, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/05/books/review/05Crime/05Crime-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 951}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/05/books/review/05Crime/05Crime-jumbo.jpg', 'height': 1024, 'width': 646, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/05/books/review/05Crime/05Crime-superJumbo.jpg', 'height': 2048, 'width': 1292, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/05/books/review/05Crime/05Crime-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStan