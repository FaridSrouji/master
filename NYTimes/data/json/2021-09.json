rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28popcast/merlin_193478700_913d6f7d-7b18-4da2-8e4e-ace9bb3ba64b-articleLarge.jpg', 'height': 784, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/28/arts/28popcast/merlin_193478700_913d6f7d-7b18-4da2-8e4e-ace9bb3ba64b-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 784}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28popcast/merlin_193478700_913d6f7d-7b18-4da2-8e4e-ace9bb3ba64b-jumbo.jpg', 'height': 1024, 'width': 784, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28popcast/merlin_193478700_913d6f7d-7b18-4da2-8e4e-ace9bb3ba64b-superJumbo.jpg', 'height': 2000, 'width': 1530, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28popcast/28popcast-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/09/28/arts/28popcast/28popcast-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/28/arts/28popcast/28popcast-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bringing Aaliyah Into the Streaming Era', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rhythm and Blues (Music)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Blackground Entertainment', 'rank': 2, 'major': 'N'}, {'na