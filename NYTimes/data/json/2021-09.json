o-v8.jpg', 'height': 671, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/03/opinion/01kennedy-new/01kennedy-new-superJumbo-v8.jpg', 'height': 1343, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/03/opinion/01kennedy-new/01kennedy-new-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/09/03/opinion/01kennedy-new/01kennedy-new-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/03/opinion/01kennedy-new/01kennedy-new-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Robert Kennedy Was My Dad. His Assassin Doesn’t Deserve Parole.', 'kicker': 'Guest Essay', 'content_kicker': None, 'print_headline': 'My Father’s Assassin Doesn’t Deserve Parole', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sirhan, Sirhan B', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Probation and Parole', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kennedy, Robert Francis', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Assassinations and Attempted Assassinations', 'rank': 4, 'major': 'N'}], 'pub_date': '2021-09-01T19:22:47+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Rory Kennedy', 'person': [{'firstname': 'Rory', 'middlename': None, 'lastname': 'Kennedy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'n