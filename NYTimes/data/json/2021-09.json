 'Putin, Vladimir V', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Dokuchaev, Dmitry A', 'rank': 11, 'major': 'N'}], 'pub_date': '2021-09-09T17:05:09+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Julian E. Barnes', 'person': [{'firstname': 'Julian', 'middlename': 'E.', 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4d57030-9b51-56a3-a46a-8222e81c19c1', 'word_count': 1040, 'uri': 'nyt://article/d4d57030-9b51-56a3-a46a-8222e81c19c1'}, {'abstract': 'Compensating for a postponed museum retrospective, an exciting gallery show revisits the painter’s late figurative style.', 'web_url': 'https://www.nytimes.com/2021/09/09/arts/design/philip-guston-review.html', 'snippet': 'Compensating for a postponed museum retrospective, an exciting gallery show revisits the painter’s late figurative style.', 'lead_paragraph': 'Hauser & Wirth, the gallery that has represented the estate of Philip Guston since 2015, has leapt unto the breach. In lieu of “Philip Guston Now,” the enormous, widely anticipated retrospective set to tour to four museums on both sides of the Atlantic that was abruptly postponed last September, Hauser & Wirth has mounted a powerful exhibition of 18 of the late paintings that are the crowning achievement of Abstract Expressionism’s greatest apostate.', 'print_section': 'C', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/10/arts/09guston-review1/09guston-review1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/10/arts/09guston-review1/09guston-review1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'ra