ple', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Haiti', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Texas', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Petito, Gabrielle', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Missing Persons', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 10, 'major': 'N'}], 'pub_date': '2021-09-23T00:51:45+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Charles M. Blow', 'person': [{'firstname': 'Charles', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/22d0b83d-d2d0-53d4-a802-601d3c4ddb16', 'word_count': 902, 'uri': 'nyt://article/22d0b83d-d2d0-53d4-a802-601d3c4ddb16'}, {'abstract': '“The hardworking warehouse employees who have helped sustain us during these unprecedented times should not have to risk injury or face punishment,” Gov. Gavin Newsom said.', 'web_url': 'https://www.nytimes.com/2021/09/22/business/newsom-amazon-labor-bill.html', 'snippet': '“The hardworking warehouse employees who have helped sustain us during these unprecedented times should not have to risk injury or face punishment,” Gov. Gavin Newsom said.', 'lead_paragraph': 'Gov. Gavin Newsom of California on Wednesday signed a bill that restricts warehouse employers from setting productivity quotas that prevent workers from taking breaks or following health and safety laws. The new law could alter Amazon’s labor practices.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/22/business/22amazon-newsom/merlin_164921727_4a898def-ac0f-4fd