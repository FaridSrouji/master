: 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/30/books/29BOOKPINKER1/29BOOKPINKER1-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 859}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/30/books/29BOOKPINKER1/29BOOKPINKER1-jumbo.png', 'height': 1024, 'width': 716, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/30/books/29BOOKPINKER1/29BOOKPINKER1-superJumbo.png', 'height': 2048, 'width': 1432, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/30/books/29BOOKPINKER1/29BOOKPINKER1-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/09/30/books/29BOOKPINKER1/29BOOKPINKER1-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/30/books/29BOOKPINKER1/29BOOKPINKER1-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In ‘Rationality,’ Steven Pinker Sticks Up (Again) for Reason’s Role in Human Progress', 'kicker': None, 'content_kicker': None, 'print_headline': 'Going to Bat for Reason and Its Image Problem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'Rationality: What It Is, Why It Seems Scarce, Why It Matters (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pinker, Steven', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2021-09-29T09:00:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Bo