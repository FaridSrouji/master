ifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e53c273e-a904-5c7e-ae7b-24b11f0642d0', 'word_count': 1129, 'uri': 'nyt://article/e53c273e-a904-5c7e-ae7b-24b11f0642d0'}, {'abstract': 'This domestic thriller from Netflix is painfully dumb and laughably obvious.', 'web_url': 'https://www.nytimes.com/2021/09/22/movies/intrusion-review.html', 'snippet': 'This domestic thriller from Netflix is painfully dumb and laughably obvious.', 'lead_paragraph': 'In the simplest terms, “Intrusion” is about a woman who begins to think that her husband may be up to something sinister. The movie makes it immediately obvious, however, that her husband really is up to something sinister, because he’s always prowling around suspiciously, with ominous music playing pretty much whenever he’s onscreen. But this is a feature-length thriller, and it needs to buy some time and build suspense, so the faithful wife is obliged to be very, very obtuse and draw some very foolish conclusions. It’s an exercise in watching someone have the world’s slowest revelation.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/25/arts/intrusion1/intrusion1-articleLarge.jpg', 'height': 329, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/25/arts/intrusion1/intrusion1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 329}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/25/arts/intrusion1/intrusion1-jumbo.jpg', 'height': 562, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/25/arts/intrusion1/intrusion1-superJumbo.jpg', 'height': 1124, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/25/arts/intrusion1/intrusion1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2021/09/25/arts/intrusion1/intrusion1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/25/arts/intrusion1/intrusion1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Intrusion’ Review: We’re All Trying to Find the Guy Who Did This', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tracking a Sinister Process, From Beginning to End', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pinto, Freida', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Marshall-Green, Logan', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Salky, Adam', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Intrusion (Movie)', 'rank': 5, 'major': 'N'}], 'pub_date': '2021-09-22T11:00:03+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'By Calum Marsh', 'person': [{'firstname': 'Calum', 'middlename': None, 'lastname': 'Marsh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/be4add44-4e1c-514a-906f-12b330bf8b94', 'word_count': 310, 'uri': 'nyt://article/be4add44-4e1c-514a-906f-12b330bf8b94'}, {'abstract': 'The brand’s latest version of the classic design, characterized by hand-twisted gold roping, also features white and autumnal diamonds.', 'web_url': 'https://www.nytimes.com/2021/09/22/t-magazine/tiffany-necklace.html', 'snippet': 'The brand’s latest version of the classic design, characterized by hand-twisted gold roping, also features white and autumnal diamonds.', 'lead_paragraph': 'The Alsatian-born mid-20th-century jewelry designer Jean Schlumberger, who began his career creating surrealist buttons and costume jewelry for the Paris-based couturier Elsa Schiaparelli, spent nearly 30 years at Tiffany & Co. There, in a mezzanine atelier and salon within the American house’s Fifth Avenue flagship, he crafted fanciful gem-encrusted bijoux inspired by flora and fauna — sea horses, parrots, jellyfish — for such clients as Elizabeth Taylor, Bunny Mellon and Jacqueline Kennedy Onassis. But he also produced structurally complex works, including the Fringe Necklace from 1956. Over the years, this collar, which evokes ancient Greek adornments with its hand-twisted gold roping dotted with gemstones, has been frequently iterated by Tiffany. Its most recent interpretation is crafted in 18-karat yellow gold with 65 autumnal diamonds and 50 white diamonds, set in platinum so the stones appear to float above the piece’s radiating braided elements — a fitting tribute to Schlumberger’s technical prowess and expansive imagination. Tiffany & Co. Jean Schlumberger Autumnal Diamond Fringe Necklace, price on request, (800)\u2009518-5555.', 'print_section': 'M2', 'print_page': '102', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2021/09/22/t-magazine/22tmag-tiffanynecklace-slide-09ED-copy/22tmag-tiffanynecklace-slide-09ED-copy-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2021/09/22/t-magazine/22tmag-tiffanynecklace-slide-09ED-copy/22tmag-tiffanynecklace-slide-09ED-copy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 