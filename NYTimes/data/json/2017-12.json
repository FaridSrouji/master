d8-dea24c2a7241-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/28/world/28USBriefing-amcore2/merlin_131671166_268df9ad-e310-4160-aed8-dea24c2a7241-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/world/28USBriefing-amcore2/28USBriefing-amcore2-jumbo-v2.jpg', 'height': 188, 'width': 624, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/world/28USBriefing-amcore2/28USBriefing-amcore2-superJumbo-v2.jpg', 'height': 188, 'width': 624, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/world/28USBriefing-amcore2/28USBriefing-amcore2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/28/world/28USBriefing-amcore2/28USBriefing-amcore2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/world/28USBriefing-amcore2/28USBriefing-amcore2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Kabul, Roy Moore, Cannabis: Your Thursday Briefing', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-12-28T10:33:25+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Chris Stanford', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Stanford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/8e455097-e74d-5ef4-9826-81691b2876f3', 'word_count': 1203, 'uri': 'nyt://article/8e455097-e74d-5ef4-9826-81691b2876f3'}, {'abstract': 'They served together, and were wounded together twice.', 'web_url': 'https://www.nytimes.com/2017/12/28/opinion/chuck-hagel-vietnam-brother.html', 'snippet': 'They served together, and were wounded together twice.', 'lead_paragraph': 'Fifty years ago this month, I landed at Tan Son Nhut Airport near Saigon in the Republic of Vietnam. I recall the bus ride taking us from Travis Air Force Base in California to board the plane. The bus was full of young innocent Army privates, having no idea what awaited us in this faraway Southeast Asian land. At 21, I was one of the oldest on the bus of 19-year-olds. One memory of that trip that has never faded was the large boombox radios that many of the troops carried with them. The songs that blared out from those music boxes during my tour included Otis Redding’s “Dock of the Bay” and Aretha Franklin’s “Respect.” I would hear those songs and others for the next 12 months in Vietnam. Music was a defining part of our Vietnam experience. Music was our lifeline.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/opinion/28Vietnam-Hagel/28Vietnam-Hagel-jumbo.jpg', 'height': 225, 'width': 300, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/opinion/28Vietnam-Hagel/28Vietnam-Hagel-superJumbo.jpg', 'height': 225, 'width': 300, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/opinion/28Vietnam-Hagel/28Vietnam-Hagel-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/28/opinion/28Vietnam-Hagel/28Vietnam-Hagel-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/opinion/28Vietnam-Hagel/28Vietnam-Hagel-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Chuck Hagel: Serving in Vietnam — With My Brother', 'kicker': "Vietnam '67", 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Vietnam War', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Vietnam', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hagel, Chuck', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-12-28T10:45:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Chuck Hagel', 'person': [{'firstname': 'Chuck', 'middlename': None, 'lastname': 'Hagel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/09544b48-bdcb-516a-bf55-b9c907e106d4', 'word_count': 1079, 'uri': 'nyt://article/09544b48-bdcb-516a-bf55-b9c907e106d4'}, {'abstract': 'Ferguson’s debtors’ prisons devastated its black community. The attorney general wants to keep it that way.', 'web_url': 'https://www.nytimes.com/2017/12/28/opinion/sessions-says-to-courts-go-ahead-jail-people-because-theyre-poor.html', 'snippet': 'Ferguson’s debtors’ prisons devastated its black community. The attorney general wants to keep it that way.', 'lead_paragraph': 'Last week, Attorney General Jeff Sessions retracted an Obama-era guidance to state courts that was meant to end debtors’ prisons, where people who are too poor to pay fines are sent. This practice is blatantly unconstitutional, and the guidance had helped jump-start reform around the country. Its withdrawal is the latest sign that the federal government is retreating from protecting civil rights for the most vulnerable among us.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/opinion/27bainsWeb/27bainsWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/27/opinion/27bainsWeb/27bainsWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/opinion/27bainsWeb/27bainsWeb-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/opinion/27bainsWeb/27bainsWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/opinion/27bainsWeb/27bainsWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/27/opinion/27bainsWeb/27bainsWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/opinion/27bainsWeb/27bainsWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sessio