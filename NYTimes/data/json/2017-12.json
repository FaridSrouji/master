ork Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/blogs/08-lens-lange-slide-PN8E/08-lens-lange-slide-PN8E-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/02/08/blogs/08-lens-lange-slide-PN8E/08-lens-lange-slide-PN8E-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/blogs/08-lens-lange-slide-PN8E/08-lens-lange-slide-PN8E-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/blogs/08-lens-lange-slide-PN8E/08-lens-lange-slide-PN8E-articleLarge.jpg', 'height': 481, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/02/08/blogs/08-lens-lange-slide-PN8E/08-lens-lange-slide-PN8E-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 481}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/blogs/08-lens-lange-slide-PN8E/08-lens-lange-slide-PN8E-jumbo.jpg', 'height': 821, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/02/08/blogs/08-lens-lange-slide-PN8E/08-lens-lange-slide-PN8E-superJumbo.jpg', 'height': 1641, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Teaching Japanese-American Internment Using Primary Resources', 'kicker': 'U.S. History', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-12-08T01:33:06+0000', 'document_type': 'artic