2a2b-56a4-bcae-2aa86554b59d'}, {'abstract': 'A cold-pressed grapeseed oil from Salute Santé is light, neutral and also kosher.', 'web_url': 'https://www.nytimes.com/2017/12/04/dining/cold-pressed-grapeseed-oil-hanukkah.html', 'snippet': 'A cold-pressed grapeseed oil from Salute Santé is light, neutral and also kosher.', 'lead_paragraph': 'I’ve always preferred grapeseed oil for frying Hanukkah latkes, in part because it has a high smoke point (485 degrees) and is a light, neutral oil. Salute Santé — a Napa, Calif., company that has been producing grapeseed oils for more than 20 years — has added a new feature to its basic version: It’s now cold pressed, the better to retain properties like antioxidants. It is also kosher: Cold-pressed grapeseed oil, 1 liter (33.8 ounces), $14.95; half-liter (16.9 ounces), $9.95; five liters (169 ounces), $55; Salute Santé, 707-251-3900, grapeseedoil.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06BURNEROIL-1512085317050/06BURNEROIL-1512085317050-articleLarge.jpg', 'height': 720, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/06/dining/06BURNEROIL-1512085317050/06BURNEROIL-1512085317050-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 720}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06BURNEROIL-1512085317050/06BURNEROIL-1512085317050-jumbo.jpg', 'height': 1024, 'width': 854, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06BURNEROIL-1512085317050/06BURNEROIL-1512085317050-superJumbo.jpg', 'height': 1400, 'width': 1167, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06BURNEROIL-1512085317050/06BURNEROIL-1512085317050-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/06/dining/06BURNEROIL-1512085317050/06BURNEROIL-1512085317050-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06BURNEROIL-1512085317050/06BURNEROIL-1512085317050-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Oil for Hanukkah Latkes', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Fry: For Making Latkes, A Cold-Pressed Option', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Oils and Fats', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Napa (Calif)', 'rank': 2, 'major': 'N'}], 'pub_date': '2017-12-04T17:31:19+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/af894881-7eb8-55c9-a253-6c3c7f5cf283', 'word_count': 113, 'uri': 'nyt://article/af894881-7eb8-55c9-a253-6c3c7f5cf283'}, {'abstract': 'Murphy’s Beans n’ Dreams gives Midtown students practical sales experience.', 'web_url': 'https://www.nytimes.com/2017/12/04/dining/coffee-shop-midtown-murphys-beans-n-dreams.html', 'snippet': 'Murphy’s Beans n’ Dreams gives Midtown students practical sales experience.', 'lead_paragraph': 'A pop-up coffee shop in Midtown Manhattan is a practice session for students at the Food and Finance High School. Murphy’s Beans n’ Dreams is named for Richard Murphy, a founder of the school, who died in 2013. It offers students a chance to set up and run a commercial enterprise with profits going toward a scholarship fund. Support comes from Joe Coffee and Orwasher’s, among others. The cafe will sell breakfast pastries, sandwiches, coffee and tea. A kickoff party on Dec. 11 from 6 to 8 p.m. is open to the public ($10, tickets from 501auctions.com); the shop will open for business Tuesday morning: Murphy’s Beans n’ Dreams, Dec. 12 to 15, 7 to 11 a.m., Food and Finance High School, 525 West 50th Street (10th Avenue).', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06burnershop/merlin_130612754_30526419-5455-4a14-b190-a7ea1ab346b9-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/06/dining/06burnershop/merlin_130612754_30526419-5455-4a14-b190-a7ea1ab346b9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06burnershop/merlin_130612754_30526419-5455-4a14-b190-a7ea1ab346b9-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06burnershop/merlin_130612754_30526419-5455-4a14-b190-a7ea1ab346b9-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/06/dining/06burnershop/06burnershop-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 