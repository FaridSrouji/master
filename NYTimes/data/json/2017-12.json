 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90de740b-f36d-560b-8f68-94f02dabbf9c', 'word_count': 121, 'uri': 'nyt://article/90de740b-f36d-560b-8f68-94f02dabbf9c'}, {'abstract': 'An all-purpose workhorse from northern Italy also holds pasta bakes and moussaka.', 'web_url': 'https://www.nytimes.com/2017/12/29/dining/pan-lagostina-lasagnera.html', 'snippet': 'An all-purpose workhorse from northern Italy also holds pasta bakes and moussaka.', 'lead_paragraph': 'Lagostina, an Italian cookware company in the Piedmont region, was started in 1901 as a tin-plating factory. Today the company specializes in handmade cookware like this new lasagnera, a stainless steel pan designed for lasagna and the other savory dishes like moussaka and enchiladas that the season demands. It has a cherry wood cover: Lagostina Lasagnera, $199.95, Williams Sonoma stores, williams-sonoma.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/03/dining/03Burnerpan/03Burnerpan-articleLarge.jpg', 'height': 449, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/01/03/dining/03Burnerpan/03Burnerpan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 449}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/03/dining/03Burnerpan/03Burnerpan-jumbo.jpg', 'height': 766, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/03/dining/03Burnerpan/03Burnerpan-superJumbo.jpg', 'height': 1531, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/01/03/dining/03Bur