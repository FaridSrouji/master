irstname': 'Adam', 'middlename': None, 'lastname': 'Goldman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6c3b9543-afea-5a84-8030-383ab3b445bc', 'word_count': 788, 'uri': 'nyt://article/6c3b9543-afea-5a84-8030-383ab3b445bc'}, {'abstract': 'Doug Jones, a former prosecutor, defeated scandal-scarred Roy S. Moore for the Senate seat once held by Attorney General Jeff Sessions.', 'web_url': 'https://www.nytimes.com/2017/12/12/us/politics/alabama-senate-race-winner.html', 'snippet': 'Doug Jones, a former prosecutor, defeated scandal-scarred Roy S. Moore for the Senate seat once held by Attorney General Jeff Sessions.', 'lead_paragraph': 'BIRMINGHAM, Ala. — Doug Jones, a Democratic former prosecutor who mounted a seemingly quixotic Senate campaign in the face of Republican dominance here, defeated his scandal-scarred opponent, Roy S. Moore, after a brutal campaign marked by accusations of sexual abuse and child molestation against the Republican.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13dc-alabama-top-sub-copy/13dc-alabama-top-sub-articleLarge-v4.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/13/us/13dc-alabama-top-sub-copy/13dc-alabama-top-sub-articleLarge-v4.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13dc-alabama-top-sub-copy/13dc-alabama-top-sub-jumbo-v4.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13dc-alabama-top-sub-copy/13dc-alabama-top-sub-superJumbo-v4.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13dc-alabama-top-sub-copy/13dc-alabama-top-sub-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/13/us/13dc-alabama-top-sub-copy/13dc-alabama-top-sub-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13dc-alabama-top-sub-copy/13dc-alabama-top-sub-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Once a Long Shot, Democrat Doug Jones Wins Alabama Senate Race', 'kicker': None, 'content_kicker': None, 'print_headline': 'Democrat Wins Pivotal Alabama Senate Seat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ALABAMA', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Moore, Roy S', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Doug (1954- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-12-13T03:25:54+0000', 'document_type': 'article', 'news_desk': 'Washington', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Alexander Burns and Jonathan Martin', 'person': [{'firstname': 'Alexander', 'middlename': None, 'lastname': 'Burns', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/db32ac76-8b78-5847-b310-069746a992fd', 'word_count': 1602, 'uri': 'nyt://article/db32ac76-8b78-5847-b310-069746a992fd'}, {'abstract': 'As a prosecutor and defense lawyer, Mr. Jones played a role in some of his state’s biggest cases, putting him in a position to make electoral history.', 'web_url': 'https://www.nytimes.com/2017/12/12/us/doug-jones-alabama.html', 'snippet': 'As a prosecutor and defense lawyer, Mr. Jones played a role in some of his state’s biggest cases, putting him in a position to make electoral history.', 'lead_paragraph': 'BIRMINGHAM, Ala. — The fact that Alabama’s voters have sent a Democrat to the Senate for the first time since Howell Heflin retired in 1997 is a stunner, exceeded in incredibility only by the events that led to it — not least, that the Republican candidate, Roy S. Moore, saw his already prodigious history of controversy grow during the campaign to include allegations that he had molested teenagers.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13jones1-sub/13jones1-sub-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/13/us/13jones1-sub/13jones1-sub-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13jones1-sub/13jones1-sub-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/13/us/13jones1-sub/13jones1-sub-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'su