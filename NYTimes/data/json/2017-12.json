.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/14/us/15Sheriff/15Sheriff-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Alabama Sheriff, a Mystery Check and a Blogger Who Cried Foul', 'kicker': None, 'content_kicker': None, 'print_headline': 'A $150,000 Check and a Sheriff’s Broad Domain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sheriffs', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Franklin, Ana (Morgan County, Ala, Sheriff)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Whistle-Blowers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Embezzlement', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Morgan County (Ala)', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-12-14T19:13:08+0000', 'document_type': 'article', 'news_desk': 'Investigative', 'section_name': 'U.S.', 'byline': {'original': 'By Walt Bogdanich and Grace Ashford', 'person': [{'firstname': 'Walt', 'middlename': None, 'lastname': 'Bogdanich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Grace', 'middlename': None, 'lastname': 'Ashford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8036c1f9-98eb-5d6a-8312-13f9843b8d5f', 'word_count': 4083, 'uri': 'nyt://article/8036c1f9-98eb-5d6a-8312-13f9843b8d5f'}, {'abstract': 'The American filmmaker chases down clues and tries to exorcise demons as he tackles the biggest case of his career.', 'web_url': 'https://www.nytimes.com/2017/12/14/movies/wormwood-review-errol-morris-peter-sarsgaard.html', 'snippet': 'The American filmmaker chases down clues and tries to exorcise demons as he tackles the biggest case of his career.', 'lead_paragraph': '“Wormwood,” Errol Morris’s new movie — a hybrid of documentary and fictional techniques drawn from blurred passages in the historical record — circles around a single painful, mysterious fact. On a November night in 1953, Frank Olson, a civilian scientist who worked at a United States Army research laboratory near Frederick, Md., died after falling from a hotel-room window in Manhattan.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/15/arts/15WORMWOOD/15WORMWOOD-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/15/arts/15WORMWOOD/15WORMWOOD-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/15/arts/15WORMWOOD/15WORMWOOD-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/15/arts/15WORMWOOD/15WORMWOOD-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/15/arts/15WORMWOOD/15WORMWOOD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/15/arts/15WORMWOOD/15WORMWOOD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/15/arts/15WORMWOOD/15WORMWOOD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘Wormwood’ Confirms That Errol Morris Is Our Great Cinematic Sleuth', 'kicker': None, 'content_kicker': None, 'print_headline': 'Careful. The Truth Is Slippery.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Wormwood (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Morris, Errol', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'LSD (Lysergic Acid Diethylamide)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Sarsgaard, Peter', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 7, 'major': 'N'}], 'pub_date': '2017-12-14T19:20:42+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By A.O. Scott', 'person': [{'firstname': 'A.', 'middlename': 'O.', 'lastname': 'Scott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/55c98262-79fe-574f-8392-bfa7f15d662f', 'word_count': 866, 'uri': 'nyt://article/55c98262-79fe-574f-8392-bfa7f15d662f'}, {'abstract': 'Closed opportunities, dwindling role models and more on the scandals roiling our society.', 'web_url': 'https://www.nytimes.com/2017/12/14/us/how-one-harasser-can-rob-a-generation-of-women.html', 'snippet': 'Closed opportunities, dwindling role models and more on the scandals roiling our society.', 'lead_paragraph': 'As the sexual misconduct scandals continue to unfold, our gender team is providing updates and analysis in a new newsletter. Today, Amanda Taub shares a personal reflection on how harassment’s consequences reach far beyond the immediate victims, in a piece that originally ran in the Interpreter. Sign up HERE to receive future installments of