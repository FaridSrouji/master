rl': 'images/2017/12/06/world/06USBriefing-Amcore2/06USBriefing-Fire-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Jerusalem, Harvey Weinstein, Christine Keeler: Your Wednesday Briefing', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-12-06T10:28:39+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Chris Stanford', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Stanford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/feb72c62-7a43-510e-8bd8-855d11b0e510', 'word_count': 1191, 'uri': 'nyt://article/feb72c62-7a43-510e-8bd8-855d11b0e510'}, {'abstract': 'The places with the most opportunity used to attract the most new residents, in a cycle of fast-growing cities and rising prosperity. But no more.', 'web_url': 'https://www.nytimes.com/2017/12/06/upshot/what-happened-to-the-american-boomtown.html', 'snippet': 'The places with the most opportunity used to attract the most new residents, in a cycle of fast-growing cities and rising prosperity. But no more.', 'lead_paragraph': 'Chicago in 1850 was a muddy frontier town of barely 30,000 people. Within two decades, it was 10 times that size. Within another two decades, that number had tripled. By 1910, Chicago — hog butcher for the world, headquarters of Montgomery Ward, the nerve center of the nation’s rail network — had more than two million residents.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/08/upshot/08sky1/up-boomtown-articleLarge.jpg', 'height': 800, 'width': 600, 'subType': 'xlarge', 'crop_nam