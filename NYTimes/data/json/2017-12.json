t_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-12-29T10:00:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b59499b-215e-5548-9836-c14c54ab4be2', 'word_count': 480, 'uri': 'nyt://article/7b59499b-215e-5548-9836-c14c54ab4be2'}, {'abstract': 'Readers respond to reviews in previous issues.', 'web_url': 'https://www.nytimes.com/2017/12/29/books/review/letters-to-the-editor.html', 'snippet': 'Readers respond to reviews in previous issues.', 'lead_paragraph': 'To the Editor:', 'print_section': 'BR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Letters to the Editor', 'kicker': None, 'content_kicker': None, 'print_headline': 'Letters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-12-29T10:00:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Letter', '_id': 'nyt://article/8383be12-731d-52a5-aaca-f7fa649a6842', 'word_count': 285, 'uri': 'nyt://article/8383be12-731d-52a5-aaca-f7fa649a6842'}, {'abstract': 'The photographer explains how this year’s photo essay came together.', 'web_url': 'https://www.nytimes.com/2017/12/29/magazine/behind-the-lens-of-the-things-they-loved.html', 'snippet': 'The photographer explains how this year’s photo essay came together.', 'lead_paragraph': 'I had heard of the “anniversary effect,” or the pain of a traumatic event returning as its calendar date comes back around. My father died on Dec. 16, 2016, so my own anniversary effect was in full swing when I began this project. At each door, I was met by a person who had stepped up when needed — who had recently lost someone but hadn’t yet finished taking care of them. After a while, I stopped being surprised by everyone’s sense of humor and warm, present, tense clarity of purpose: I related to it. It was the common denominator with everyone I met, probably because it is the prerequisite — or perhaps the reward — for being the person who steps up before and after a loss. Each circumstance was different, but my intention was to honor each absence by describing vitality and presence wherever I could find it.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/magazine/31mag-tltl-chuck-berry/31mag-tltl-check-berry-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/31/magazine/31mag-tltl-chuck-berry/31mag-tltl-check-berry-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/magazine/31mag-tltl-chuck-berry/31mag-tltl-check-berry-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/magazine/31mag-tltl-chuck-berry/31mag-tltl-check-berry-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/magazine/31mag-tltl-chuck-berry/31mag-tltl-chuck-berry-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/31/magazine/31mag-tltl-chu