icker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-12-18T10:39:25+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Chris Stanford', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Stanford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/9712362c-6dd2-5e61-8c00-e298cede2b04', 'word_count': 1235, 'uri': 'nyt://article/9712362c-6dd2-5e61-8c00-e298cede2b04'}, {'abstract': 'Surviving a painful, near-fatal illness should have made me intensely grateful for ordinary life. It didn’t.', 'web_url': 'https://www.nytimes.com/2017/12/18/opinion/gratitude-sickness-health.html', 'snippet': 'Surviving a painful, near-fatal illness should have made me intensely grateful for ordinary life. It didn’t.', 'lead_paragraph': 'I remember staring up at the ceiling from the dentist’s chair as a child and wondering with genuine perplexity, “How am I here again?” It seemed as if I had awakened there, wholly present to the undeniable reality of a cavity filling or tooth pulling. The days that had passed between dental visits were nothing more than a dreamlike filler. Only in the chair did real life flare back into being, the drill keeping me relentlessly awake to the present moment. In the grip of pain, a tinge of anger would arise. How had I let all those carefree days slip past me in what felt like an instant?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18stoneWeb/18stoneWeb-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/18/opinion/18stoneWeb/18stoneWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18stoneWeb/18stoneWeb-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18stoneWeb/18stoneWeb-superJumbo.jpg', 'height': 1368, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18stoneWeb/18stoneWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/18/opinion/18stoneWeb/18stoneWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18stoneWeb/18stoneWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gratitude: In Sickness and Health', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Philosophy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Buddhism', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bone Cancer', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-12-18T10:45:12+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Philip S. Garrity', 'person': [{'firstname': 'Philip', 'middlename': 'S.', 'lastname': 'Garrity', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/7881f1e6-92b9-54a9-9bbb-1a71e4db1707', 'word_count': 1018, 'uri': 'nyt://article/7881f1e6-92b9-54a9-9bbb-1a71e4db1707'}, {'abstract': 'The administration seems to believe that if researchers can’t say “transgender,” then transgender Americans don’t exist.', 'web_url': 'https://www.nytimes.com/2017/12/18/opinion/trump-cdc-transgender.html', 'snippet': 'The administration seems to believe that if researchers can’t say “transgender,” then transgender Americans don’t exist.', 'lead_paragraph': 'In case you were keeping score at home: In Donald Trump’s America, you’re allowed to refuse to make me a cake, because pastry is free speech. But if you’re a researcher studying medicine at the leading national public health institute of the United States, you can’t say “science-based” in a budget request.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18boylanWeb/18boylanWeb-articleLarge.jpg', 'height': 417, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/18/opinion/18boylanWeb/18boylanWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 417}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18boylanWeb/18boylanWeb-jumbo.jpg', 'height': 711, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18boylanWeb/18boylanWeb-superJumbo.jpg', 'height': 1422, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/18/opinion/18boylanWeb/18boylanWeb-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/18/opinion/18boylanWeb/18boylanWeb-thumbStandard-v2.jpg', 'thumbnailwidth': 75