: '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Jews and Judaism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Synagogues', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ANTI-SEMITISM', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Aftonbladet', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Gothenburg (Sweden)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Stockholm (Sweden)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-12-14T20:40:44+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paulina Neuding', 'person': [{'firstname': 'Paulina', 'middlename': None, 'lastname': 'Neuding', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/582430b0-1ea4-5b77-ba30-dd6c375ec311', 'word_count': 1322, 'uri': 'nyt://article/582430b0-1ea4-5b77-ba30-dd6c375ec311'}, {'abstract': 'Suggested reading from critics and editors at The New York Times.', 'web_url': 'https://www.nytimes.com/2017/12/14/books/review/10-new-books-we-recommend-this-week.html', 'snippet': 'Suggested reading from critics and editors at The New York Times.', 'lead_paragraph': 'We start this week’s list of recommendations with the rare timely book that begins in an ancient era: Mary Beard’s “Women & Power: A Manifesto.” Beard opens her slender but powerful book by writing: “I want to start very near the beginning of the tradition of Western literature, and its first recorded example of a man telling a woman to ‘shut up.’ ” The scene she is talking about takes place in the “Odyssey.” And how’s this for timing? Our list this week also includes a new translation of Homer’s epic by Emily Wilson, the first woman to translate the work into English. Among the other books also included below: a new history of hoaxes, a posthumous collection of essays by Oliver Sacks and an astronaut’s memoir of time spent in space.', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/17/books/review/17ed-covers/17ed-covers-articleLarge.jpg', 'height': 295, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/17/books/review/17ed-covers/17ed-covers-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 295}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/17/books/review/17ed-covers/17ed-covers-jumbo.jpg', 'height': 307, 'width': 625, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/17/books/review/17ed-covers/17ed-covers-superJumbo.jpg', 'height': 307, 'width': 625, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/17/books/review/17ed-covers/17ed-covers-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/17/books/review/17ed-covers/17ed-covers-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': '10 New Books We Recommend This Week', 'kicker': 'Editors’ Choice', 'content_kicker': None, 'print_headline': 'Staff Picks From the Book Review', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-12-14T20:45:04+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Boo