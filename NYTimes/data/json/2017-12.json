 York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/03/opinion/sunday/03hoagland/03hoagland-articleLarge.jpg', 'height': 393, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/03/opinion/sunday/03hoagland/03hoagland-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 393}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/03/opinion/sunday/03hoagland/03hoagland-jumbo.jpg', 'height': 670, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/03/opinion/sunday/03hoagland/03hoagland-superJumbo.jpg', 'height': 1340, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/03/opinion/sunday/03hoagland/03hoagland-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/03/opinion/sunday/03hoagland/03hoagland-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/03/opinion/sunday/03hoagland/03hoagland-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Starving Lands', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'The Starving Lands', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Famine', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Sudan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value