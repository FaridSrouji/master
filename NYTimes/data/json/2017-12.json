nion', 'byline': {'original': 'By Rick Hamlin', 'person': [{'firstname': 'Rick', 'middlename': None, 'lastname': 'Hamlin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/779a3fcf-f268-5150-a4f1-5095c738df8c', 'word_count': 846, 'uri': 'nyt://article/779a3fcf-f268-5150-a4f1-5095c738df8c'}, {'abstract': 'Education Secretary Betsy DeVos said her department would start granting loan forgiveness for students bilked by for-profit colleges.', 'web_url': 'https://www.nytimes.com/2017/12/21/us/politics/for-profit-universities-debt-relief-devos.html', 'snippet': 'Education Secretary Betsy DeVos said her department would start granting loan forgiveness for students bilked by for-profit colleges.', 'lead_paragraph': 'Thousands of students who say they have been swindled by predatory for-profit universities will soon learn whether their loans will be forgiven by the Education Department, but under a new Trump administration policy, some students who expected full loan forgiveness may only receive partial relief.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/22/us/22DC-BORROWERS/22DC-BORROWERS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/22/us/22DC-BORROWERS/22DC-BORROWERS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/22/us/22DC-BORROWERS/22DC-BORROWERS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/22/us/22DC-BORROWERS/22DC-BORROWERS-superJumbo.jpg', 'h