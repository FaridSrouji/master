 'organization': '', 'rank': 1}, {'firstname': 'Nick', 'middlename': None, 'lastname': 'Cumming-Bruce', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0597fbeb-449f-53b2-ae32-de5223ee5be2', 'word_count': 528, 'uri': 'nyt://article/0597fbeb-449f-53b2-ae32-de5223ee5be2'}, {'abstract': 'Bats and frogs and salamanders have all been hit hard by white nose syndrome and chytrid fungi. Now scientists are warning that snakes worldwide are at risk from a new fungal disease.', 'web_url': 'https://www.nytimes.com/2017/12/20/science/snakes-fungus.html', 'snippet': 'Bats and frogs and salamanders have all been hit hard by white nose syndrome and chytrid fungi. Now scientists are warning that snakes worldwide are at risk from a new fungal disease.', 'lead_paragraph': 'One of the first hints that yet another fungal disease that could devastate wildlife was emerging in the United States came in 2006 with a report that an isolated winter den of timber rattlesnakes in New Hampshire had suffered a population crash.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/26/science/26SNAKES1/21SNAKES1-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/26/science/26SNAKES1/21SNAKES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/26/science/26SNAKES1/21SNAKES1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/26/science/26SNAKES1/21SNAKES1-superJumbo.jpg', 'height': 1363, 'width': 204