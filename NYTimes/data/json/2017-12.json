ng', 'kicker': None, 'content_kicker': None, 'print_headline': 'Your Evening Briefing', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2017-12-26T22:42:24+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Karen Zraick and Sandra Stevenson', 'person': [{'firstname': 'Karen', 'middlename': None, 'lastname': 'Zraick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Sandra', 'middlename': None, 'lastname': 'Stevenson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/45449eb2-e9b8-5801-9247-0de2748d960a', 'word_count': 937, 'uri': 'nyt://article/45449eb2-e9b8-5801-9247-0de2748d960a'}, {'abstract': 'Pausing to take a closer look at someone who has become a fixture.', 'web_url': 'https://www.nytimes.com/2017/12/26/nyregion/metropolitan-diary-always-running.html', 'snippet': 'Pausing to take a closer look at someone who has become a fixture.', 'lead_paragraph': 'Dear Diary:', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Always Running', 'kicker': 'Metropolitan Diary', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Stern College for Women', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Guards', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2017-12-26T23:00:01+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Shoshy Ciment', 'person': [{'firstname': 'Shoshy', 'middlename': None, 'lastname': 'Ciment', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fad7ea57-ae4f-5b3b-9b94-444ec28342e0', 'word_count': 224, 'uri': 'nyt://article/fad7ea57-ae4f-5b3b-9b94-444ec28342e0'}, {'abstract': 'Efforts by Republicans to chip away at the Affordable Care Act, culminating in the repeal of the individual mandate, have left behind a more government-focused health program.', 'web_url': 'https://www.nytimes.com/2017/12/26/us/politics/republicans-trump-affordable-care-act-obamacare.html', 'snippet': 'Efforts by Republicans to chip away at the Affordable Care Act, culminating in the repeal of the individual mandate, have left behind a more government-focused health program.', 'lead_paragraph': 'WASHINGTON — The Affordable Care Act was conceived as a mix of publicly funded health care and privately purchased insurance, but Republican attacks, culminating this month in the death of a mandate that most Americans have insurance, are shifting the balance, giving the government a larger role than Democrats ever anticipated.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/us/27dchealth-alpha/27dchealth-alpha-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/27/us/27dchealth-alpha/27dchealth-alpha-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/us/27dchealth-alpha/27dchealth-alpha-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/us/27dchealth-alpha/27dchealth-alpha-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thu