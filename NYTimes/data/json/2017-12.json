': 'subject', 'value': "Women's Rights", 'rank': 3, 'major': 'N'}], 'pub_date': '2017-12-22T10:00:05+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'U.S.', 'byline': {'original': 'By Yousur Al-Hlou, Guglielmo Mattioli and Neeti Upadhye', 'person': [{'firstname': 'Yousur', 'middlename': None, 'lastname': 'Al-Hlou', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Guglielmo', 'middlename': None, 'lastname': 'Mattioli', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Neeti', 'middlename': None, 'lastname': 'Upadhye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/2f951a67-074c-51f0-8b6e-279030957532', 'word_count': 0, 'uri': 'nyt://video/2f951a67-074c-51f0-8b6e-279030957532'}, {'abstract': 'Don’t stall in the “premovement phase.” Don’t hole up in a bathroom.', 'web_url': 'https://www.nytimes.com/2017/12/22/magazine/how-to-escape-a-burning-building.html', 'snippet': 'Don’t stall in the “premovement phase.” Don’t hole up in a bathroom.', 'lead_paragraph': '“Don’t wait until you see smoke or flames,” says Margrethe Kobes, a senior researcher at the Institute for Safety in the Netherlands who studies how psychology and building design affect human behavior during fires. For one project, she offered subjects a stay in a four-star hotel. After conducting some sham experiments, everyone went to bed only to be awakened before dawn by a call from the front desk telling them the building was on fire. This, of course, was the real experiment. “In a fire, you need to evacuate quickly, but that’s not what we see,” Kobes says. Instead, people put on their shoes, got dressed, searched for their keys and repeatedly peered out their door into the hallway. Stalling before exiting is what evacuation researchers call the “premovement phase.” Don’t prolong it.', 'print_section': 'MM', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/magazine/24mag-tip/24mag-24tip-t_CA0-articleLarge.png', 'height': 1042, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/24/magazine/24mag-tip/24mag-24tip-t_CA0-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 1042}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/magazine/24mag-tip/24mag-24tip-t_CA0-jumbo.png', 'height': 1024, 'width': 590, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/magazine/24mag-tip/24mag-24tip-t_CA0-superJumbo.png', 'height': 1956, 'width': 1126, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/magazine/24mag-tip/24mag-tip-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/24/magazine/24mag-tip/24mag-tip-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/magazine/24mag-tip/24mag-tip-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How to Escape a Burning Building', 'kicker': 'Tip', 'content_kicker': None, 'print_headline': 'How to Escape a Burning Building', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fires and Firefighters', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-12-22T10:00:09+0000', 'document_type': 'article', 'news_desk': 