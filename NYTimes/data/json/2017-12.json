ia/28xp-india-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/28/us/28xp-india/28xp-india-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/03/28/us/28xp-india/28xp-india-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/03/28/us/28xp-india/28xp-india-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '19 Acts of Heroism in 2017', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Terrorism', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'School Shootings and Armed Attacks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hurricanes and Tropical Storms', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Altruism', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Two Thousand Seventeen', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-12-19T00:03:16+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By Millie Tran and Daniel Victor', 'person': [{'firstname': 'Millie', 'middlename': None, 'lastname': 'Tran', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Daniel', 'middlename': None, 'lastname': 'Victor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/da151230-9668-575b-b1ed-a9e293d450a1', 'word_count': 1187, 'uri': 'nyt://article/da151230-9668-575b-b1ed-a9e293d450a1'}, {'abstract': 'Bitcoin may be in a bubble, but it is part of a much bigger trend that is here to stay: a shift in trust from government to technology.', 'web_url': 'https://www.nytimes.com/2017/12/18/opinion/bitcoin-boom-technology-trust.html', 'snippet': 'Bitcoin may be in a bubble, but it is part of a much bigger trend that is here to stay: a shift in trust from government to technology.', 'lead_paragraph': 'You don’t need brilliant financial analysis skills to notice that Bitcoin is in a bubble. It has grown in value from about 39 cents to over $18,000 in just eight years and recently attracted broad media attention by doubling in just a few days. The conventional wisdom had been that illegal and illicit transactions — buying drugs or transferring money out of Argentina — accounted for much of Bitcoin’s value. Today the mainstream view sees mere greed and speculation.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/05/opinion/tim-wu/tim-wu-articleLarge-v4.jpg', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/04/05/opinion/tim-wu/tim-wu-articleLarge-v4.jpg', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/05/opinion/tim-wu/tim-wu-jumbo-v4.jpg', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/05/opinion/tim-wu/tim-wu-superJumbo-v4.jpg', 'height': 667, 'width': 1334, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/04/05/opinion/tim-wu/tim-wu-thumbStandard-v4.jpg', 'height': 75, 'width':