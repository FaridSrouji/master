rticle/cd38b301-5b30-598d-ac21-43d57d426776'}, {'abstract': 'Leading the organization Memorial, Mr. Roginsky, a former political prisoner, documented state persecution during the Soviet period and after.', 'web_url': 'https://www.nytimes.com/2017/12/23/obituaries/arseny-roginsky-russian-human-rights-leader-is-dead-at-71.html', 'snippet': 'Leading the organization Memorial, Mr. Roginsky, a former political prisoner, documented state persecution during the Soviet period and after.', 'lead_paragraph': 'MOSCOW — Arseny Roginsky, the longtime leader of the Russian human rights organization Memorial and a Soviet-era dissident who documented the victims of state persecution during the Cold War and after, died on Monday in Tel Aviv. He was 71.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/23/obituaries/23roginsky2/23roginsky2-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/23/obituaries/23roginsky2/23roginsky2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/23/obituaries/23roginsky2/23roginsky2-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/23/obituaries/23roginsky2/23roginsky2-superJumbo.jpg', 'height': 1200, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/23/obituaries/23roginsky2/23roginsky2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/23/obituaries/23roginsky2/23roginsky2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/23/obituaries/23roginsky2/23roginsky2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Arseny Roginsky, Russian Human Rights Leader, Is Dead at 71', 'kicker': None, 'content_kicker': None, 'print_headline': 'Arseny Roginsky, 71, A Preserver of Names Amid Persecution, Dies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Roginsky, Arseny (1946-2017)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Human Rights and Human Rights Violations', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Memorial', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 5, 'major': 'N'}], 'pub_date': '2017-12-23T21:20:35+0000', 'document_type': 'article', 'news_desk': 'Obits', 'section_name': 'Obituaries', 'byline': {'original': 'By Matthew Luxmoore', 'person': [{'firstname': 'Matthew', 'middlename': None, 'lastname': 'Luxmoore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/731ae95a-eca5-5104-bea8-81e73839e274', 'word_count': 1234, 'uri': 'nyt://article/731ae95a-eca5-5104-bea8-81e73839e274'}, {'abstract': 'Even after escaping Myanmar, survivors of rape and other trauma find themselves still vulnerable and commodified in the brokenness of refugee life.', 'web_url': 'https://www.nytimes.com/2017/12/23/world/asia/rohingya-women-abuse-myanmar.html', 'snippet': 'Even after escaping Myanmar, survivors of rape and other trauma find themselves still vulnerable and commodified in the brokenness of refugee life.', 'lead_paragraph': 'KUTUPALONG, Bangladesh — Rahima’s father never wanted her out of his sight. She and her sister were too young, too pretty, too vulnerable to be trusted among the men of her village in western Myanmar, not to mention the soldiers who roamed the region.', 'print_section': 'A', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/world/24rohingya-women/00rohingya-women-2sub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/24/world/24rohingya-women/00rohingya-women-2sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/world/24rohingya-women/00rohingya-women-2sub-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/world/24rohingya-women/00rohingya-women-2sub-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/world/24rohingya-women/00rohingya-women-2sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/24/world/24rohingya-women/00rohingya-women-2sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/24/world/24rohingya-women/00rohingya-women-2sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘I’m