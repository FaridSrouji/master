n/09boyd/09boyd-superJumbo.jpg', 'height': 1800, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/09/opinion/09boyd/09boyd-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/09/opinion/09boyd/09boyd-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/09/opinion/09boyd/09boyd-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Don’t Give Kids Holiday Gifts That Can Spy on Them', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'Don’t Give Kids Gifts That Spy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gifts', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computer Security', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Espionage and Intelligence Services', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Toys', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Holidays and Special Occasions', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Cyberwarfare and Defense', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Home Automation and Smart Homes', 'rank': 8, 'major': 'N'}], 'pub_date': '2017-12-09T01:21:41+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Ashley Boyd', 'person': [{'firstname': 'Ashley', 'middlename': None, 'lastname': 'Boyd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/e0044540-a3fd-507b-8801-d36d90a32dd1', 'word_count': 876, 'uri': 'nyt://article/e0044540-a3fd-507b-8801-d36d90a32dd1'}, {'abstract': 'In the early days of creating the social network, we were at the mercy of internet providers. They could easily have killed the company.', 'web_url': 'https://www.nytimes.com/2017/12/08/opinion/facebook-net-neutrality.html', 'snippet': 'In the early days of creating the social network, we were at the mercy of internet providers. They could easily have killed the company.', 'lead_paragraph': 'My first glimpse of a world without strong protections for net neutrality was in 2004, when I was part of the team that created Facebook. Though it’s hard to imagine now, TheFacebook (as it was called at the time) was just a fledgling college social network, growing school by school. Some colleges didn’t like Facebook, and because they functioned as their students’ internet providers, they would simply block the site.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/09/opinion/09mccollum/09mccollum-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/09/opinion/09mccollum/09mccollum-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/09/opinion/09mccollum/09mccollum-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/09/opinion/09mccollum/09mccollum-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/09/opinion/09mccollum/09mccollum-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/09/opinion/09mccollum/09mccollum-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/09/opinion/09mccollum/09mccollum-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What Facebook Taught Me About Net Neutrality', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Net Neutrality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Computers and the Internet', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Protection', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Facebook Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-12-09T01:25:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Mccollum', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Mccollum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/d79d765d-0f76-5e79-aa74-69e25aff7b32', 'word_count': 786, 'uri': 'nyt://article/d79d765d-0f76-5e79-aa74-69e25aff7b32'}, {'abstract': 'Seven major league teams made the final round in the bidding, and then the 23-year-old Ohtani made his decision. The losers included the Mariners, Dodgers and Cubs.', 'web_url': 'https://www.nytimes.com/2017/12/08/sports/baseball/ohtani-angels-babe-ruth.html', 'snippet': 'Seven major league teams made the final round in the bidding, and then the 23-year-old Ohtani made his decision. The losers included the Mariners, Dodgers