ype': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why No One Knows What Will Happen in Alabama', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ALABAMA', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Moore, Roy S', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Doug (1954- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-12-12T10:33:05+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Nate Cohn', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Cohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ea708754-90bd-545f-8317-634c00277f4f', 'word_count': 1452, 'uri': 'nyt://article/ea708754-90bd-545f-8317-634c00277f4f'}, {'abstract': 'As rates of anxiety, suicidal thoughts, depression and substance abuse soar, a national network of counselors offers intervention 24 hours a day.', 'web_url': 'https://www.nytimes.com/2017/12/12/opinion/a-crisis-line-that-calms-with-texting-and-data.html', 'snippet': 'As rates of anxiety, suicidal thoughts, depression and substance abuse soar, a national network of counselors offers intervention 24 hours a day.', 'lead_paragraph': 'Right now, algorithms are scouring vast data sets to determine the news you’ll be exposed to today on social media, the advertisements that will appear alongside your search results and what you’ll end up being charged for your next car ride. But can algorithms be used to address more urgent social and individual problems, like how to build trust or provide effective care? Can algorithms be used to increase the love and kindness in the world?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Crisis Line That Calms With Texting and Data', 'kicker': 'Fixes', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Depression (Mental)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Anxiety and Stress', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Text Messaging', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Connecticut', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Western States (US)', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-12-12T10:45:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Bornstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Bornstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/478545a1-5069-519c-9d4e-f9ff91b3e10e', 'word_count': 1752, 'uri': 'nyt://article/478545a1-5069-519c-9d4e-f9ff91b3e10e'}, {'abstract': 'An oversupply of pollution permits threatens the state’s efforts to reduce greenhouse gas emissions.', 'web_url': 'https://www.nytimes.com/2017/12/12/opinion/california-climate-program-emissions.html', 'snippet': 'An oversupply of pollution permits threatens the state’s efforts to reduce greenhouse gas emissions.', 'lead_paragraph': 'San Francisco — Gov. Jerry Brown of California and lawmakers in Sacramento pulled off a huge political feat last summer when they renewed one of the state’s premier climate programs. The governor sought a two-thirds majority to insulate the program from legal challenges, and he got there by winning support from eight Republican lawmakers.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/12/opinion/12gillis1/12gillis1-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/12/opinion/12gillis1/12gillis1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/12/opinion/12gillis1/12gillis1-jumbo.jpg', 'height': 684, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/12/opinion/12gillis1/12gillis1-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/12/opinion/12gillis1/12gillis1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/12/opinion/12gillis1/12gillis1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/12/opinion/12gillis1/12gillis1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Landmark California Climate Program Is in Jeopardy', 'kicker': 'Op-Ed Contributors', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Greenhouse Gas Emissions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Carbon Caps and Emissions Trading Programs', 'rank': 2, 'major': 'N'}, {'name':