LastPage-Sorel/31LastPage-Sorel-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 548}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/books/review/31LastPage-Sorel/31LastPage-Sorel-jumbo.jpg', 'height': 935, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/books/review/31LastPage-Sorel/31LastPage-Sorel-superJumbo.jpg', 'height': 1870, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/books/review/31LastPage-Sorel/31LastPage-Sorel-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/31/books/review/31LastPage-Sorel/31LastPage-Sorel-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/books/review/31LastPage-Sorel/31LastPage-Sorel-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How the Literary Heavyweights of the 1960s Reacted to Vietnam', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-12-29T10:00:24+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Edward Sorel', 'person': [{'firstname': 'Edward', 'middlename': None, 'lastname': 'Sorel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3f00384b-85a9-5a3a-a1a0-5e3ec9431f56', 'word_count': 16, 'uri': 'nyt://article/3f00384b-85a9-5a3a-a1a0-5e3ec9431f56'}, {'abstract': 'Calvin Trillin reflects on the idioms lost in the age of the smartphone.', 'web_url': 'https://www.nytimes.com/2017/12/29/books/review/idioms-language-smartphone.html', 'snippet': 'Calvin Trillin reflects on the idioms lost in the age of the smartphone.', 'lead_paragraph': 'I was on the subway, watching a teenager text on his smartphone, when I realized that the idiom “all thumbs” might be doomed. I’ve had any number of such moments — what some people would call “ah-ha” moments — on the subway lately. A day or so before the “all thumbs” revelation, I was reminded once again that I am what used to be called “getting on in years”: I was standing in a crowded car when my eye happened to catch the eye of an attractive young woman who was seated in front of me. She smiled. I smiled. I was on my way to thinking that maybe she had me confused with George Clooney — a mix-up that, I’ll admit, does not occur on a regular basis. Then she smiled again, and offered me her seat.', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/books/review/31Trillin-SUB01/31Trillin-SUB01-articleLarge.jpg', 'height': 922, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/31/books/review/31Trillin-SUB01/31Trillin-SUB01-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 922}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/books/review/31Trillin-SUB01/31Trillin-SUB01-jumbo.jpg', 'height': 1024, 'width': 667, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/boo