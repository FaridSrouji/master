y-articleLarge.jpg', 'height': 594, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/31/opinion/sunday/31gay/31gay-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 594}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/opinion/sunday/31gay/31gay-jumbo.jpg', 'height': 1013, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/opinion/sunday/31gay/31gay-superJumbo.jpg', 'height': 1733, 'width': 1751, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/opinion/sunday/31gay/31gay-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/31/opinion/sunday/31gay/31gay-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/31/opinion/sunday/31gay/31gay-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Ask Roxane: Is It Too Late to Follow My Dreams?', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': 'Is It Too Late to Follow My Dreams?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}], 'pub_date': '2017-12-30T19:30:02+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Roxane Gay', 'person': [{'firstname': 'Roxane', 'middlename': None, 'lastname': 'Gay', 'qualifier': None, 'title': None, 'role': 'reported', 'orga