ndard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/08/arts/08hollow1/08hollow1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Hollow in the Land,’ a Headstrong Woman’s Search for Answers', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hollow in the Land', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Hollow in the Land (Movie)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Agron, Dianna', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Corkle, Scooter', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-12-07T12:00:02+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Monica Castillo', 'person': [{'firstname': 'Monica', 'middlename': None, 'lastname': 'Castillo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0908437b-b5a8-5bdf-9ba4-8581b561a5e7', 'word_count': 241, 'uri': 'nyt://article/0908437b-b5a8-5bdf-9ba4-8581b561a5e7'}, {'abstract': 'A toxic mother-son bond drives Rupert Jones’s glum British psychodrama.', 'web_url': 'https://www.nytimes.com/2017/12/07/movies/kaleidoscope-review.html', 'snippet': 'A toxic mother-son bond drives Rupert Jones’s glum British psychodrama.', 'lead_paragraph': '“Kaleidoscope,” a glum British tower-block drama, would seem to possess all the elements of a potent psychological thriller. A pernicious bond between the middle-aged Carl (Toby Jones, credibly crushed) and his manipulative mother, Aileen (the grand Anne Reid, passively domineering). A cinematographer (Philipp Blaubach) who pries menace from the mundane and makes even the most generic urban architecture radiate disquiet. And a despondent production design that renders Carl’s drab council flat in shades of bilious green and burial-plot brown.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/08/arts/08kaleidoscope1/08kaleidoscope1-articleLarge-v2.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/08/arts/08kaleidoscope1/08kaleidoscope1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/08/arts/08kaleidoscope1/08kaleidoscope1-jumbo-v2.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/08/arts/08kaleidoscope1/08kaleidoscope1-superJumbo-v2.jpg', 'height': 1363, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/08/arts/08kaleidoscope1/08kaleidoscope1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/08/arts/08kaleidoscope1/08kaleidoscope1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/08/arts/08kaleidoscope1/08kaleidoscope1-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: If It’s Not One Thing, It’s Your Mother in ‘Kaleidoscope’', 'kicker': None, 'content_kicker': None, 'print_h