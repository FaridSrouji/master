 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tax Credits, Deductions and Exemptions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Taxes (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Property Taxes', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Internal Revenue Service', 'rank': 4, 'major': 'N'}], 'pub_date': '2017-12-28T01:46:48+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Casselman', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Casselman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8ea0d901-8a97-5038-aad9-cd4648583293', 'word_count': 639, 'uri': 'nyt://article/8ea0d901-8a97-5038-aad9-cd4648583293'}, {'abstract': 'Stop-and-frisk has been drastically reduced, but officers still need to be more accountable.', 'web_url': 'https://www.nytimes.com/2017/12/27/opinion/reforms-rein-in-police-harassment-now-more-is-needed.html', 'snippet': 'Stop-and-frisk has been drastically reduced, but officers still need to be more accountable.', 'lead_paragraph': 'New York City’s police commissioner, James O’Neill, showed admirable candor in a recent training video when he admitted that the department had “overused and sometimes misused” its stop-and-frisk program in past years — particularly in minority neighborhoods. He has also embraced the reforms ordered by a federal judge who ruled five years ago that the program had violated constitutional guarantees against unreasonable search and seizure and discriminated against black and Latino citizens, who were disproportionately targeted for unjustified stops.', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/28/opinio