value': 'Sedaris, Amy', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Dinello, Paul', 'rank': 6, 'major': 'N'}], 'pub_date': '2017-12-08T15:32:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By James Poniewozik', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Poniewozik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/657db306-6fba-5e0c-9a4b-2db8032bca18', 'word_count': 738, 'uri': 'nyt://article/657db306-6fba-5e0c-9a4b-2db8032bca18'}, {'abstract': 'Trying to pretend that the parties are the same is deeply destructive.', 'web_url': 'https://www.nytimes.com/2017/12/08/opinion/facts-have-a-well-known-liberal-bias.html', 'snippet': 'Trying to pretend that the parties are the same is deeply destructive.', 'lead_paragraph': 'There are two central facts about 21st-century U.S. politics. First, we suffer from asymmetric polarization: the Republican Party has become an extremist institution with little respect for traditional norms of any kind. Second, mainstream media – still the source of most political information for the great majority of Americans – haven’t been able to come to grips with this reality. Even in the age of Trump, they try desperately to be “balanced”, which in practice means bending over backwards to say undeserved nice things about Republicans and take undeserved swipes at Democrats.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/12/opinion/120817krugmanblog1-sub/merlin_129198956_bb2d9f7a-6c95-4d80-8d67-06dbc1e15c70-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/12/opinion/120817krugmanblog1-sub/merlin_129198956_bb2d9f7a-6c95