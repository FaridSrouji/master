': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/arts/30tosca-recording4/30tosca-recording4-articleLarge.jpg', 'height': 438, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2017/12/27/arts/30tosca-recording4/30tosca-recording4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 438}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/arts/30tosca-recording4/30tosca-recording4-jumbo.jpg', 'height': 748, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/arts/30tosca-recording4/30tosca-recording4-superJumbo.jpg', 'height': 1496, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/arts/30tosca-recording4/30tosca-recording4-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2017/12/27/arts/30tosca-recording4/30tosca-recording4-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2017/12/27/arts/30tosca-recording4/30tosca-recording4-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Best Opera Recording Ever Is Maria Callas Singing ‘Tosca.’ Hear Why.', 'kicker': None, 'content_kicker': None, 'print_headline': 'A ’53 Recording Of ‘Tosca’ Soars Like No Other', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Metrop