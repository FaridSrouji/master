tasy', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-09-26T17:39:40+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/2adf4e91-4bf2-5f2e-8b01-b1338c9a9f3f', 'word_count': 0, 'uri': 'nyt://slideshow/2adf4e91-4bf2-5f2e-8b01-b1338c9a9f3f'}, {'abstract': 'Li Yang of the brand Quetsche, who has worked previously for Dior and Maison Martin Margiela, finds inspiration in cartoons.', 'web_url': 'https://www.nytimes.com/2016/09/26/t-magazine/fashion/quetsche-li-yang-clothing-brand.html', 'snippet': 'Li Yang of the brand Quetsche, who has worked previously for Dior and Maison Martin Margiela, finds inspiration in cartoons.', 'lead_paragraph': 'Li Yang had no interest in being a fashion designer when he was growing up in the industrial city of Changchun, China. He liked science best at school — and though he would play after class in his mother’s clothing factory, where she manufactured mass-market apparel, he read Japanese manga, never fashion magazines. The feminine figures he sketched resembled Hayao Miyazaki’s Princess Nausicaä, heroine of the post-apocalyptic tale “Nausicaä of the Valley of the Wind” — not the typical elongated croquis of fashion illustrations.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Brand to Know: A Line of Deconstructed Unisex Pieces, Inspired by Fantasy', 'kicker': 'On the Verge', 'content_kicker': None, 'print_headline': 'A New Line Inspired by Sci-Fi', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cavanagh, Alice', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'valu