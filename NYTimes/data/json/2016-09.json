me': 'persons', 'value': 'Waldstein, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tennis', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Open (Tennis)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Donaldson, Jared (1996- )', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ARGENTINA', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Goffin, David', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-01T17:51:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/533dc00d-5292-59d6-b0cd-7d073733b3be', 'word_count': 1014, 'uri': 'nyt://article/533dc00d-5292-59d6-b0cd-7d073733b3be'}, {'abstract': 'T spent a morning with the real-life all-female crew that stars in — and inspired — Miu Miu’s latest dreamy “Women’s Tales” short film.', 'web_url': 'https://www.nytimes.com/2016/09/01/t-magazine/entertainment/miu-miu-skateboarding-crystal-moselle-womens-tales.html', 'snippet': 'T spent a morning with the real-life all-female crew that stars in — and inspired — Miu Miu’s latest dreamy “Women’s Tales” short film.', 'lead_paragraph': 'Crystal Moselle, the director most recently of the feature “The Wolfpack,” first spotted Nina Moran and Rachelle Vinberg on the G train, skateboards in tow. They swapped information on the platform. “I was talking mad loud, and I noticed she was peeping us, but everybody peeps when you’re a girl with a board on the train,” Moran says. “We gave her our email because we’re real. We waited to see if she was.” To the girls’ surprise, Moselle reached out — and spent the next few months getting to know their all- female skateboard crew that also includes Ardelia Lovelace, Jules Lorenzo, Kabrina Adams and Ajani Russell.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/01/t-magazine/fashion/miu-miu-slide-3A9E/miu-miu-slide-3A9E-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/01/t-magazine/fashion/miu-miu-slide-3A9E/miu-miu-slide-3A9E-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/01/t-magazine/fashion/miu-miu-slide-3A9E/miu-miu-slide-3A9E-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/01/t-magazine/fashion/miu-miu-slide-3A9E/miu-miu-slide-3A9E-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/01/t-magazine/fashion/miu-miu-slide-3A9E/miu-miu-slide-3A9E-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/01/t-magazine/fashion/miu-miu-slide-3A9E/miu-miu-slide-3A9E-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/01/t-magazine/fashion/miu-miu-slide-3A9E/miu-miu-slide-3A9E-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Day at the Park With Fashion’s Favorite Girl Skateboarders', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Day in the Life; Girls on Wheels', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Skateboarding', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Miu Miu (Fashion Label)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Moselle, Crystal', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-01T17:52:50+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'subsection_name': 'Fashion & Beauty', 'byline': {'original': 'By Kat Herriman', 'person': [{'firstname': 'Kat', 'middlename': None, 'lastname': 'Herriman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f59dca72-663b-5899-878e-8d1976c4f718', 'word_count': 619, 'uri': 'nyt://article/f59dca72-663b-5899-878e-8d1976c4f718'}, {'abstract': '“Dancer,” a documentary by Steven Cantor, depicts the contradictions and anomalies that have made Mr. Polunin a controversial figure in the ballet world.', 'web_url': 'https://www.nytimes.com/2016/09/04/arts/dance/sergei-polunin-ballets-bad-boy-has-a-change-of-heart.html', 'snippet': '“Dancer,” a documentary by Steven Cantor, depicts the contradictions and anomalies that have made Mr. Polunin a controversial figure in the ballet world.', 'lead_paragraph': 'LONDON — The first image is of a man kneeling in a misty white light, his head bowed, his tattoo-covered, muscular torso swaying rhythmically, side to side. Then we see an opera house, the audience arriving, musicians warming up. Backstage, the dancer — Sergei Polunin — in makeup and costume, is in his dressing room, taking various pills and potions. “Soon I am going to be so high,” he says gleefully, doing quick jumps to warm up, in front of a mirror.', 'print_section': 'AR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/04/arts/04DANCEFILM/04DANCEFILM-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/04/arts/04DANCEFILM/04DANCEFILM-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 337}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/04/arts/04DANCEFILM/04DANCEFILM-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/04/arts/04DANCEFILM/04DANCEFILM-superJumbo.jpg', 'height': 922, 'width': 1640, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/04/arts/04DANCEFILM/04DANCEFILM-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/04/arts/04DANCEFILM/04DANCEFILM-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/04/arts/04DANCEFILM/04DANCEFILM-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sergei Polunin, Ballet’s Bad Boy, Has a Change of Heart', 'kicker': None, 'content_kicker': None, 'print_headline': 'Ballet’s Bad Boy Has a Change of Heart', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sulcas, Roslyn', 'rank': 2, 'major': 'N