odern warfare.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/09/business/10Norwayfacebook-web04/10Norwayfacebook-web04-articleLarge.jpg', 'height': 452, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/09/business/10Norwayfacebook-web04/10Norwayfacebook-web04-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 452}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/09/business/10Norwayfacebook-web04/10Norwayfacebook-web04-jumbo.jpg', 'height': 772, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/09/business/10Norwayfacebook-web04/10Norwayfacebook-web04-superJumbo.jpg', 'height': 1544, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/09/business/10Norwayfacebook-web04/10Norwayfacebook-web04-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/09/business/10Norwayfacebook-web04/10Norwayfacebook-web04-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/09/business/10Norwayfacebook-web04/10Norwayfacebook-web04-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Facebook Restores Iconic Vietnam War Photo It Censored for Nudity', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Accidental Gatekeeper', 'name': None, 'seo': None, 'sub': None}