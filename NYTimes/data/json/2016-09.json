York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/travel/02Montana2/02Montana2-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/02/travel/02Montana2/02Montana2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/travel/02Montana2/02Montana2-jumbo.jpg', 'height': 661, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/travel/02Montana2/02Montana2-superJumbo.jpg', 'height': 1323, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/travel/02Montana2/02Montana2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/02/travel/02Montana2/02Montana2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/travel/02Montana2/02Montana2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Family Returns to Montana ‘Ruts’ and a Million-Dollar View', 'kicker': 'Frugal Family', 'content_kicker': None, 'print_headline': 'A Return to Montana, and Panoramic Vistas', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Moon, Freda', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Flathead Lake (Mont)', 'rank': 3, 'major