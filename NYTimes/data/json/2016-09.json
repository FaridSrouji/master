ion': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/26/opinion/26stoneWeb/26stoneWeb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/26/opinion/26stoneWeb/26stoneWeb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/26/opinion/26stoneWeb/26stoneWeb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I’m Black. Does America Have a Plan for My Life?', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Blacks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Tulsa (Okla)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-26T07:23:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Chris Lebron', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Lebron', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/200d9269-d155-5af6-aea4-b6f5b11aec27', 'word_count': 1404, 'uri': 'nyt://article/200d9269-d155-5af6-aea4-b6f5b11aec27'}, {'abstract': 'It’s even worse than you think.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/09/26/the-falsity-of-false-equivalence/', 'snippet': 'It’s even worse than you think.', 'lead_paragraph': 'If Donald Trump becomes president, the news media will bear a large share of the blame. I know some (many) journalists are busy denying responsibility, but this is absurd, and I think they know it. As Nick Kristof says, polls showing that the public considers Hillary Clinton, a minor fibber at most, less trustworthy than a pathological liar is prima facie evidence of massive media failure.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Falsity of False Equivalence', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-09-26T07:51:51+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d8c602fc-cb20-5910-8e98-d30622e89504', 'word_count': 586, 'uri': 'nyt://article/d8c602fc-cb20-5910-8e98-d30622e89504'}, {'abstract': 'A half-century after the founding of the Black Panthers, rank-and-file members of the revolutionary black nationalist group reflect on their experiences.', 'web_url': 'https://lens.blogs.nytimes.com/2016/09/26/stories-from-the-black-panthers-unfinished-revolution/', 'snippet': 'A half-century after the founding of the Black Panthers, rank-and-file members of the revolutionary black nationalist group reflect on their experiences.', 'lead_paragraph': 'In “The Black Panthers: Portraits From an Unfinished Revolution,” the photographer Bryan Shih and the historian Yohuru R. Williams tell the rarely heard stories of the rank-and-file members of the organization through portraits, interviews and scholarly essays. Fifty years after the Black Panthers’ founding, in October 1966, the volume, published by Nation Books, goes beyond charismatic leaders like Huey P. Newton, Bobby Seale and Eldridge Cleaver and allows the group’s members to reflect on their personal experiences. Below are portraits by Mr. Shih, along with short biographies as they appear in the book and audio excerpts of the testimonies.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Stories From the Black Panthers’ Unfinished Revolution', 'kicker': 'Lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Black Panther Party', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-09-26T08:00:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/71952b99-cd2e-50d5-8dfe-066e0a02aee1', 'word_count': 773, 'uri': 'nyt://article/71952b99-cd2e-50d5-8dfe-066e0a02aee1'}, {'abstract': 'What changes has climate change brought to the Arctic and how has tourism in the area changed as a result?', 'web_url': 'https://www.nytimes.com/2016/09/26/learning/questions-for-where-ice-once-crushed-ships-open-water-beckons.html', 'snippet': 'What changes has climate change brought to the Arctic and how has tourism in the area changed as a result?', 'lead_paragraph': 'Article: Where Ice Once Crushed Ships, Open Water Beckons', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/25/opinion/sunday/25revkin2SUB/25revkin2SUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/25/opinion/sunday/25revkin2SUB/25revkin2SUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit'