glocations', 'value': 'France', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-09-19T15:55:53+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Aurelien Breeden', 'person': [{'firstname': 'Aurelien', 'middlename': None, 'lastname': 'Breeden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96ef6a6e-cfdb-5314-a353-8d7999a16da2', 'word_count': 461, 'uri': 'nyt://article/96ef6a6e-cfdb-5314-a353-8d7999a16da2'}, {'abstract': 'Mrs. Clinton stressed her national security credentials and measured her words, and Mr. Trump sounded a note of furious alarm about Saturday’s attacks in New York and New Jersey.', 'web_url': 'https://www.nytimes.com/2016/09/20/us/politics/donald-trump-hillary-clinton.html', 'snippet': 'Mrs. Clinton stressed her national security credentials and measured her words, and Mr. Trump sounded a note of furious alarm about Saturday’s attacks in New York and New Jersey.', 'lead_paragraph': 'A suspect in a bombing was still at large Monday morning, his motives and intentions unknown — but Hillary Clinton and Donald J. Trump were already racing to seize the political upper hand.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Bombings, Hillary Clinton and Donald Trump Clash Over Terrorism', 'kicker': None, 'content_kicker': None, 'print_headline': 'Candidates Clash on Terrorism', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Confessore, Nicholas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Clinton, Hillary Rodham', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Burns, Alexander', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Chelsea, Ma