ection_name': 'Americas', 'byline': {'original': 'By Nicholas Casey', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Casey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cb6e76b4-5de1-5c77-bab8-99d2dbea70bf', 'word_count': 306, 'uri': 'nyt://article/cb6e76b4-5de1-5c77-bab8-99d2dbea70bf'}, {'abstract': 'Israel’s prime minister is determined to head off any new effort to try to dictate terms of a settlement of the longstanding conflict with the Palestinians.', 'web_url': 'https://www.nytimes.com/2016/09/23/world/middleeast/benjamin-netanyahu-israel-unga-2016-united-nations.html', 'snippet': 'Israel’s prime minister is determined to head off any new effort to try to dictate terms of a settlement of the longstanding conflict with the Palestinians.', 'lead_paragraph': 'For Benjamin Netanyahu, the brash prime minister of Israel, there are few audiences more skeptical than the world leaders he will face at the United Nations General Assembly on Thursday. But if his international peers are not all that fond of him, it is fair to say the feeling is mutual.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/world/xxun-netanyahu/xxun-netanyahu-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/18/world/xxun-netanyahu/xxun-netanyahu-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/world/xxun-netanyahu/xxun-netanyahu-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/world/xxun-n