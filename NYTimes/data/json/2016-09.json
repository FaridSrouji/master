sons', 'value': 'Trump, Donald J', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Holt, Lester (1959- )', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-27T04:11:47+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/7cd1da5f-8b4f-5092-a0fc-9666507db59d', 'word_count': 657, 'uri': 'nyt://article/7cd1da5f-8b4f-5092-a0fc-9666507db59d'}, {'abstract': 'The first presidential debate was a lot like the presidential race itself: largely devoid of a way for voters to know who was sticking to the facts.', 'web_url': 'https://www.nytimes.com/2016/09/27/us/politics/assertions-hofstra-debate.html', 'snippet': 'The first presidential debate was a lot like the presidential race itself: largely devoid of a way for voters to know who was sticking to the facts.', 'lead_paragraph': 'It did not come from the moderator, Lester Holt of NBC, or from Hillary Clinton. Often the closest thing to fact-checking to occur during Monday’s presidential debate was the low, blaring honk of Donald J. Trump’s voice: “Wrong!”', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/27/us/27debate-jp1-sub2/27debate-jp1-sub2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/27/us/27debate-jp1-sub2/27debate-jp1-sub2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/27/us/27debate-jp1-sub2/27debate-jp1-sub2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_