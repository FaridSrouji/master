ld/middleeast/13Syria-web/13Syria-web-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/13/world/middleeast/13Syria-web/13Syria-web-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Syria Is Calmer but Cautious as Cease-Fire Begins', 'kicker': None, 'content_kicker': None, 'print_headline': 'Syria Is Calmer but Cautious as Cease-Fire Begins', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Syria', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Assad, Bashar al-', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Daraya (Syria)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Al Nusra Front', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Islamic State in Iraq and Syria (ISIS)', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Kerry, John', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Lavrov, Sergey V', 'rank': 11, 'major': 'N'}], 'pub_date': '2016-09-12T15:39:28+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Anne Barnard and Rick Gladstone', 'person': [{'firstname': 'Anne', 'middlename': None, 'lastname': 'Barnard', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Rick', 'middlename': None, 'lastname': 'Gladstone', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2b4dc2d9-e31c-5713-902e-9655a19997ef', 'word_count': 932, 'uri': 'nyt://article/2b4dc2d9-e31c-5713-902e-9655a19997ef'}, {'abstract': 'From the archives of the International Herald Tribune: Fingerprints prove prisoner’s guilt in London court, September 1916.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2016/09/12/1916-fingerprints-prove-prisoners-guilt/', 'snippet': 'From the archives of the International Herald Tribune: Fingerprints prove prisoner’s guilt in London court, September 1916.', 'lead_paragraph': 'LONDON — ‘‘Science has proved beyond any reasonable doubt that you are guilty,’’ said Judge Atherley Jones at the Old Bailey yesterday [Sept. 11], when sentencing Andrew Scarloli, aged 24, a newsvendor, to twelve months’ hard labor for breaking into Sadlers Wells Theatre and stealing Treasury notes and about £43. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/13/blogs/13oldiht-1916-atherleyjones/13oldiht-1916-atherleyjones-articleLarge.jpg', 'height': 844, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/13/blogs/13oldiht-1916-atherleyjones/13oldiht-1916-atherleyjones-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 844}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/13/blogs/13oldiht-1916-atherleyjones/13oldiht-1916-atherleyjones-jumbo.jpg', 'height': 985, 'width': 700, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/13/blogs/13oldiht-1916-atherleyjones/13oldiht-1916-atherleyjones-superJumbo.jpg', 'height': 985, 'width': 700, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/13/blogs/13oldiht-1916-atherleyjones/13oldiht-1916-atherleyjones-thumbStandard.jpg',