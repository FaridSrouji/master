ubject', 'value': 'Batteries', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fowler, Susanne', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Lithium (Metal)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Samsung Electronics Co', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Samsung Group', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Smartphones', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Recalls and Bans of Products', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-09-02T15:51:21+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Susanne Fowler and Paul Mozur', 'person': [{'firstname': 'Susanne', 'middlename': None, 'lastname': 'Fowler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Paul', 'middlename': None, 'lastname': 'Mozur', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/6adc176e-2061-556d-b857-7309d36c9c89', 'word_count': 452, 'uri': 'nyt://article/6adc176e-2061-556d-b857-7309d36c9c89'}, {'abstract': '“Icons of Modern Art” at the Louis Vuitton Foundation will include paintings by Picasso, Matisse and Gauguin, among others, from the collection of Sergei Shchukin.', 'web_url': 'https://www.nytimes.com/2016/09/04/arts/design/a-bridge-from-moscow-to-paris-130-works-of-modern-art.html', 'snippet': '“Icons of Modern Art” at the Louis Vuitton Foundation will include paintings by Picasso, Matisse and Gauguin, among others, from the collection of Sergei Shchukin.', 'lead_paragraph': 'PARIS — Some cities mark time by natural events — the year of the earthquake, the flood, the tsunami, the hurricane. But Parisians, being Parisian, tend to tell time by landmark exhibitions: “Paris-Moscow 1900-1930” at the Pompidou Center in 1979, the Cézanne retrospective at the G