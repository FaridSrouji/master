dard', 'legacy': {'thumbnail': 'images/2016/09/20/opinion/20brooksSub/20brooksSub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20brooksSub/20brooksSub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20brooksSub/20brooksSub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/20/opinion/20brooksSub/20brooksSub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20brooksSub/20brooksSub-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20brooksSub/20brooksSub-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Dignity and Sadness in the Working Class', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'An Economic Survival Story', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Factories and Manufacturing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Suburbs', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-20T07:21:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By David Brooks', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Brooks', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/beffda7c-7532-53d2-9e0b-c40d5f423582', 'word_count': 811, 'uri': 'nyt://article/beffda7c-7532-53d2-9e0b-c40d5f423582'}, {'abstract': 'With cohousing, communities are designed and organized for families to depend on one another.', 'web_url': 'https://www.nytimes.com/2016/09/20/opinion/modern-housing-with-village-virtues.html', 'snippet': 'With cohousing, communities are designed and organized for families to depend on one another.', 'lead_paragraph': 'Working families in the United States have many struggles today: expensive child care, not enough time to cook healthy meals, disconnection from nature, a sense of social isolation — what the sociologist Robert Putnam famously called “bowling alone” — and more. Older Americans, a booming population, often end up segregated generationally and in dire need of care and companionship.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20fixesWeb/20fixesWeb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/20/opinion/20fixesWeb/20fixesWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20fixesWeb/20fixesWeb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20fixesWeb/20fixesWeb-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_n