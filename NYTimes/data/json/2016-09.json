reenwich Village or the Lower East Side.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30FAIRALT/30FAIRALT-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/30/arts/30FAIRALT/30FAIRALT-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30FAIRALT/30FAIRALT-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30FAIRALT/30FAIRALT-articleLarge.jpg', 'height': 429, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/30/arts/30FAIRALT/30FAIRALT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 429}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30FAIRALT/30FAIRALT-jumbo.jpg', 'height': 732, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30FAIRALT/30FAIRALT-superJumbo.jpg', 'height': 1429, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'World’s Fair, and Queens, in the Meadows Festival Spotlight', 'kicker': None, 'content_kicker': None, 'print_headline': 'Borough Pride Takes the Stage in Queens', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Rap and Hip-Hop', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Citi Field (Queens, NY)', 'rank': 2, 'majo