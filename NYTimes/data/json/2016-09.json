document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'By Susan Dominus', 'person': [{'firstname': 'Susan', 'middlename': None, 'lastname': 'Dominus', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4d03338e-7b6d-5dc6-a8fa-46cc25d5126f', 'word_count': 904, 'uri': 'nyt://article/4d03338e-7b6d-5dc6-a8fa-46cc25d5126f'}, {'abstract': 'Technology has helped make them more sustainable than at any time in history.', 'web_url': 'https://www.nytimes.com/2016/09/25/opinion/sunday/why-industrial-farms-are-good-for-the-environment.html', 'snippet': 'Technology has helped make them more sustainable than at any time in history.', 'lead_paragraph': 'Stillwater, Okla. — There is much to like about small, local farms and their influence on what we eat. But if we are to sustainably deal with problems presented by population growth and climate change, we need to look to the farmers who grow a majority of the country’s food and fiber.', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/25/sunday-review/25Lusk/25Lusk-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/25/sunday-review/25Lusk/25Lusk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/25/sunday-review/25Lusk/25Lusk-jumbo.jpg', 'height': 662, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/25/sunday-review/25Lusk/25Lusk-superJumbo.jpg', 'height': 1324, 'width': 2048, 'subType': 'superJumbo', 'crop