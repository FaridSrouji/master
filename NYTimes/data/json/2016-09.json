: 'image', 'url': 'images/2016/10/02/books/review/02Anderson/02Anderson-articleLarge.jpg', 'height': 387, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/02/books/review/02Anderson/02Anderson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 387}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/books/review/02Anderson/02Anderson-jumbo.jpg', 'height': 660, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/books/review/02Anderson/02Anderson-superJumbo.jpg', 'height': 1054, 'width': 1635, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'American Apartheid: A Georgia County Drove Out All Its Black Citizens in 1912', 'kicker': 'Nonfiction', 'content_kicker': None, 'print_headline': 'American Apartheid', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Phillips, Patrick (1970- )', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Blood at the Root: A Racial Cleansing in America (Book)', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-09-28T09:00:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Carol Anderson', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Anderson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bc72b490-daae-5df6-85fb-aa2ea5339a06', 'word_count': 1212, 'uri': 'nyt://article/bc72b490-daae-5df6-85fb-aa2ea5339a06'}, {'abstract': 'In the midst of a national crisis of police violence, Baltimore’s state’s attorney gambled that prosecuting six officers for the death of Freddie Gray would help heal her city. She lost much more than just the case.', 'web_url': 'https://www.nytimes.com/2016/10/02/magazine/marilyn-mosby-freddie-gray-baltimore.html', 'snippet': 'In the midst of a national crisis of police violence, Baltimore’s state’s attorney gambled that prosecuting six officers for the death of Freddie Gray would help heal her city. She lost much more than just the case.', 'lead_paragraph': 'A little before 7 the other night, the prosecutor Marilyn Mosby stopped by my house in Baltimore for dinner. She was coming straight from work in one of her customary gray pantsuits, and because I was already nursing a beer, she took off her jacket with a sigh and poured herself a glass of white wine. Then we stepped onto the back deck to throw a few burgers on the grill. This being a September evening, you might imagine the yard in raking light and breezy autumnal aspect, but it was actually pretty swampy, the oppressive tonnage of summer humidity not yet given way to season’s end, so as soon as the burgers looked about done, we ferried them inside and settled at the island in my kitchen to eat. After a few minutes, Mosby’s husband, Nick, who sits on the City Council, knocked on my front door, let himself in and wandered through the house to join us. He took a seat two chairs down from Marilyn, leaving an empty one between them.', 'print_section': 'MM', 'print_page': '43', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02mosby1/02mosby1-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/02/magazine/02mosby1/02mosby1-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02mosby1/02mosby1-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02mosby1/02mosby1-articleLarge-v3.jpg', 'height': 667, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/02/magazine/02mosby1/02mosby1-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 667}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02mosby1/02mosby1-jumbo-v3.jpg', 'height': 1024, 'width': 922, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02mosby1/02mosby1-superJumbo-v3.jpg', 'height': 1333, 'width': 1200, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Baltimore vs. Marilyn Mosby', 'kicker': 'Feature', 'content_kicker': None, 'print_headline': 'Baltimore vs. Marilyn Mosby', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hylton, Wil S', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Mosby, Marilyn J (1980- )', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Gray, Freddie (1989-2015)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Baltimore (Md)', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Mosby, Nick J', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-09-28T09:00:07+0000', 'document_type': 'article', 'news_