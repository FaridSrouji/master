: [{'firstname': 'Courtney', 'middlename': 'E.', 'lastname': 'Martin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/00b1bda7-2f60-5736-8f1a-8785088ae495', 'word_count': 1726, 'uri': 'nyt://article/00b1bda7-2f60-5736-8f1a-8785088ae495'}, {'abstract': 'Ignore the xenophobia. Newcomers make New York, Paris and London healthier and more vibrant.', 'web_url': 'https://www.nytimes.com/2016/09/20/opinion/our-immigrants-our-strength.html', 'snippet': 'Ignore the xenophobia. Newcomers make New York, Paris and London healthier and more vibrant.', 'lead_paragraph': 'World leaders are gathering in New York this week for the United Nations General Assembly, and at the top of their agenda sits a refugee crisis that has reached a level of urgency not seen since World War II. The United Nations Summit for Refugees and Migrants and President Obama’s Leaders’ Summit on Refugees represent a watershed moment that is putting a global spotlight on the need for an effective response to a growing humanitarian crisis.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20deblasioWeb/20deblasioWeb-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/20/opinion/20deblasioWeb/20deblasioWeb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20deblasioWeb/20deblasioWeb-jumbo.jpg', 'height': 597, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/opinion/20deblasioWeb/20deblasioWeb-superJumbo.