 for more than a century on cotton paper, now comes in polymer, a thin, flexible plastic film that makes it more resistant to criminals.', 'web_url': 'https://www.nytimes.com/2016/09/14/business/international/britain-unveils-new-5-pound-note-in-bid-to-foil-counterfeiters.html', 'snippet': 'The bill, printed for more than a century on cotton paper, now comes in polymer, a thin, flexible plastic film that makes it more resistant to criminals.', 'lead_paragraph': 'LONDON — It can withstand a spin cycle in a washing machine filled with extremely hot water. It can be eaten by mischievous toddlers or pet hamsters without causing lethal indigestion. It can fend off wily criminals with tiny lettering visible only under a microscope.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/14/business/14FIVER1/14FIVER1-articleLarge.jpg', 'height': 413, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/14/business/14FIVER1/14FIVER1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 413}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/14/business/14FIVER1/14FIVER1-jumbo.jpg', 'height': 704, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/14/business/14FIVER1/14FIVER1-superJumbo.jpg', 'height': 1409, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/14/business/14FIVER1/14FIVER1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/14/business/14FIVER1/14FIVER1-thumbStand