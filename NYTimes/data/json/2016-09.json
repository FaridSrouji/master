/2016/09/30/blogs/30iht-retrospective-sultan/30iht-retrospective-sultan-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/30/blogs/30iht-retrospective-sultan/30iht-retrospective-sultan-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/blogs/30iht-retrospective-sultan/30iht-retrospective-sultan-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/blogs/30iht-retrospective-sultan/30iht-retrospective-sultan-articleLarge.jpg', 'height': 813, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/30/blogs/30iht-retrospective-sultan/30iht-retrospective-sultan-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 813}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/blogs/30iht-retrospective-sultan/30iht-retrospective-sultan-jumbo.jpg', 'height': 976, 'width': 720, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/blogs/30iht-retrospective-sultan/30iht-retrospective-sultan-superJumbo.jpg', 'height': 976, 'width': 720, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': '1916: Sultan of Egypt Keeps Faith in Britain', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Social Conditions and Trends', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Egypt', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Gr