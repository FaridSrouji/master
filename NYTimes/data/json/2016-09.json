PPN/08tmag-gary-perweiler-slide-7PPN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 750}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/08/t-magazine/art/08tmag-gary-perweiler-slide-7PPN/08tmag-gary-perweiler-slide-7PPN-jumbo.jpg', 'height': 1024, 'width': 820, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/08/t-magazine/art/08tmag-gary-perweiler-slide-7PPN/08tmag-gary-perweiler-slide-7PPN-superJumbo.jpg', 'height': 2048, 'width': 1639, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/08/t-magazine/art/08tmag-gary-perweiler-slide-7PPN/08tmag-gary-perweiler-slide-7PPN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/08/t-magazine/art/08tmag-gary-perweiler-slide-7PPN/08tmag-gary-perweiler-slide-7PPN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/08/t-magazine/art/08tmag-gary-perweiler-slide-7PPN/08tmag-gary-perweiler-slide-7PPN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Gary Perweiler’s Commercial Photos, Reimagined as Fine Art', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-09-08T20:23:29+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'subsection_name': 'Art', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/37393f42-a8ee-5c86-b285-8f3457b73c6c', 'word_count': 0, 'uri': 'nyt://slideshow/37393f42-a8ee-5c86-b285-8f3457b73c6c'}, {'abstract': 'In a new show, Alex Perweiler resurrects — and newly contextualizes — images his father took for advertising clients in the ’70s, ’80s and ’90s.', 'web_url': 'https://www.nytimes.com/2016/09/08/t-magazine/art/gary-perweiler-ad-photos.html', 'snippet': 'In a new show, Alex Perweiler resurrects — and newly contextualizes — images his father took for advertising clients in the ’70s, ’80s and ’90s.', 'lead_paragraph': 'All of the photos in Gary Perweiler’s upcoming show, “Commercial Archive (Transparencies),” were originally shot for commercial clients in the ’70s, ’80s and ’90s. Today, the images have been resurrected by the photographer’s son, Alex Perweiler, who designed and directed the exhibition with his father. “For several years,” Alex explains, “I’d been thinking a lot about what would happen if these images were rerouted outside the space they were created for, advertising. I have always felt that his images were so artfully designed, produced and in many cases made statements that went far beyond anything he was thinking about in the short period of time he had to get an image done for a client.” Displayed for the first time in a gallery setting, the large archive has been beautifully brought back to life after many decades in the dark. The crispness and tonality of Gary’s work in the exhibition marks it as belonging to another, much simpler era of photography — but there’s a freshness and nostalgia to the images that register as current and purposeful.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Second Life of One Photographer’s Ad Images', 'kicker': 'Viewfinder', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Photography', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Art', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVER