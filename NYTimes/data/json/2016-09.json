organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a88a8f71-6591-52de-a757-7f36ffb624f6', 'word_count': 1095, 'uri': 'nyt://article/a88a8f71-6591-52de-a757-7f36ffb624f6'}, {'abstract': 'Gov. Andrew M. Cuomo signed legislation that reopens the claims period; it will now run until Sept. 11, 2018.', 'web_url': 'https://www.nytimes.com/2016/09/13/nyregion/period-for-ground-zero-workers-to-seek-compensation-is-extended.html', 'snippet': 'Gov. Andrew M. Cuomo signed legislation that reopens the claims period; it will now run until Sept. 11, 2018.', 'lead_paragraph': 'New York State is extending the period for workers and volunteers to seek medical benefits and lost wages resulting from their involvement in the rescue and recovery operations in Lower Manhattan after the attack on Sept. 11, 2001.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Period for Ground Zero Workers to Seek Compensation Is Extended', 'kicker': None, 'content_kicker': None, 'print_headline': 'Filing Dates for Workers at 9/11 Site Are Extended', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World Trade Center (Manhattan, NY)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'James Zadroga 9-11 Health and Compensation Act', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Environmental Protection Agency', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'September 11 (2001)', 'rank': 8, 'major': 'N'}], 'pub_date': '2016-09-13T00:52:29+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Marc Santora', 'person': [{'firstname': 'Marc', 'midd