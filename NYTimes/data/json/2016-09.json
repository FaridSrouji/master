 None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/29/sports/29SCULLYweb1/29SCULLYweb1-articleLarge.jpg', 'height': 479, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/29/sports/29SCULLYweb1/29SCULLYweb1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 479}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/29/sports/29SCULLYweb1/29SCULLYweb1-jumbo.jpg', 'height': 818, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/29/sports/29SCULLYweb1/29SCULLYweb1-superJumbo.jpg', 'height': 1636, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Beyond Baseball, Vin Scully Leaves Behind an Archive of Oddities', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Voice of the Dodgers, but Game for Anything', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Scully, Vin', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Dodgers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Radio', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Archives and Records', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-09-28T09:00:08+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Richard Sandomir', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': 'Sandomir', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f3ab4410-1396-5d52-b29c-b0f188c3a02b', 'word_count': 1620, 'uri': 'nyt://article/f3ab4410-1396-5d52-b29c-b0f188c3a02b'}, {'abstract': 'The Republican strategist on how being an anti-Trumper has affected her personal life, what it will take to rebuild the party and more.', 'web_url': 'https://www.nytimes.com/2016/10/02/magazine/ana-navarro-wants-republicans-to-stand-up-to-trump.html', 'snippet': 'The Republican strategist on how being an anti-Trumper has affected her personal life, what it will take to rebuild the party and more.', 'lead_paragraph': 'You and the other anti-Trump Republicans have been embraced by a lot of liberals because of the gusto with which you’ve gone after Trump. Does that feel a little strange for you? It’s very mercurial. The liberals love you until you say something critical about Hillary Clinton. People have a complete inability to see the flaws in their candidates. God forbid you criticize the blurred lines between the Clinton philanthropy business and political worlds.', 'print_section': 'MM', 'print_page': '62', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02talk/02talk-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/10/02/magazine/02talk/02talk-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02talk/02talk-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/10/02/magazine/02talk/02talk-articleLarge-v3.jpg', 'height': 1019, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/10/02/magazine/02talk/02talk-articleLarge-v3.jp