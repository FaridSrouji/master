azine/16tmag-aimee-slide-J3KE/16tmag-aimee-slide-J3KE-superJumbo.jpg', 'height': 1527, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/t-magazine/16tmag-aimee-slide-J3KE/16tmag-aimee-slide-J3KE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/16/t-magazine/16tmag-aimee-slide-J3KE/16tmag-aimee-slide-J3KE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/t-magazine/16tmag-aimee-slide-J3KE/16tmag-aimee-slide-J3KE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Anya Hindmarch’s Curated Works for Sotheby’s', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-09-17T15:16:42+0000', 'document_type': 'multimedia', 'news_desk': 'T Magazine', 'section_name': 'T Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/e186c4b7-e110-5069-8d34-0405609f9e4a', 'word_count': 0, 'uri': 'nyt://slideshow/e186c4b7-e110-5069-8d34-0405609f9e4a'}, {'abstract': 'In London, Anya Hindmarch has curated contemporary works for an upcoming sale at Sotheby’s.', 'web_url': 'https://www.nytimes.com/2016/09/16/t-magazine/anya-hindmarch-sothebys-auction-london-fashion-week.html', 'snippet': 'In London, Anya Hindmarch has curated contemporary works for an upcoming sale at Sotheby’s.', 'lead_paragraph': '“Art has always been a big part of my life. It’s something that I’ve constantly engaged with and loved — starting with Fiorucci graphics,” says Anya Hindmarch, the sparkly, one-woman powerhouse behind her eponymous British clothing and accessories line. Ahead of her runway bonanza in London this Sunday, the designer has collaborated with the art auction house Sotheby’s to curate a one-off sale of contemporary works, each handpicked by Hindmarch, and spanning from the postwar period to the present day. “I could easily lose myself to the art world,” admits the Royal Academy Trustee, who applies her trademark playfulness to the role of curator, even decorating the exhibition space of the historic auction house with speech-bubble emojis. “Working on this project has been like a little bit of me-time in the run-up to the show.” On view now at Sotheby’s on New Bond Street, there are sculptural Wolfgang Tillmans, tiny textural Gerhard Richters — and one rare and riotous hot pink Keith Haring that’s currently the top lot. The refreshing common denominator? Fun! For an insight into Hindmarch’s selection, click through the slideshow below.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/t-magazine/16tmag-aimee-slide-MKZZ/16tmag-aimee-slide-MKZZ-articleLarge.jpg', 'height': 409, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/16/t-magazine/16tmag-aimee-slide-MKZZ/16tmag-aimee-slide-MKZZ-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 409}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/t-magazine/16tmag-aimee-slide-MKZZ/16tmag-aimee-slide-MKZZ-jumbo.jpg', 'height': 698, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/t-magazine/16tmag-aimee-slide-MKZZ/16tmag-aimee-slide-MKZZ-superJumbo.jpg', 'height': 1396, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype