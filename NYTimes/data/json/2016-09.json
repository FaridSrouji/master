ews_desk': 'Metropolitan', 'section_name': 'New York', 'byline': {'original': 'By Kerri MacDonald', 'person': [{'firstname': 'Kerri', 'middlename': None, 'lastname': 'MacDonald', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ee19b8dd-6c00-55da-b5cc-263059dbce01', 'word_count': 304, 'uri': 'nyt://article/ee19b8dd-6c00-55da-b5cc-263059dbce01'}, {'abstract': 'An official volume produced by the National September 11 Memorial Museum offers an armchair tour of the museum in Lower Manhattan.', 'web_url': 'https://www.nytimes.com/2016/09/04/nyregion/curating-9-11-relics-one-page-at-a-time.html', 'snippet': 'An official volume produced by the National September 11 Memorial Museum offers an armchair tour of the museum in Lower Manhattan.', 'lead_paragraph': 'Summer unofficially ends on a Monday that is meant to glorify organized labor, but in New York, the day’s festivities focus more on celebrating West Indian heritage. Unionized workers unwilling to interrupt the holiday weekend for a parade will stage their own march five days later, which will be followed by the third of September’s tributes, the anniversary of 9/11.', 'print_section': 'MB', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/04/nyregion/04BOOKSHELFSUB/04BOOKSHELFSUB-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/04/nyregion/04BOOKSHELFSUB/04BOOKSHELFSUB-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/04/nyregion/04BOOKSHELFSUB/04BOOKSHELFSUB-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, 