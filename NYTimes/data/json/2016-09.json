, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dilution of Doctrine', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Dilution of Doctrine', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Douthat, Ross G', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Kaine, Timothy M', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Same-Sex Marriage, Civil Unions and Domestic Partnerships', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Francis', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-17T18:30:27+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/577c6345-a258-5ffb-b93c-682231866264', 'word_count': 819, 'uri': 'nyt://article/577c6345-a258-5ffb-b93c-682231866264'}, {'abstract': 'The procrastinator is both contemplator and man of action, which is the worst thing to be.', 'web_url': 'https://www.nytimes.com/2016/09/18/opinion/why-do-anything.html', 'snippet': 'The procrastinator is both contemplator and man of action, which is the worst thing to be.', 'lead_paragraph': 'Have you heard the story of the architect from Shiraz who designed the world’s most beautiful mosque? No one had ever conjured up such a design. It was breathtakingly daring yet well-proportioned, divinely sophisticated, yet radiating a distinctly human warmth. Those who saw the plans were awe-struck.', 'print_section': 'SR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/opinion/sunday/18stone/18stone-articleLarge.jpg', 'height': 440, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/18/opinion/sunday/18stone/18stone-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 440}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/opinion/sunday/18stone/18stone-jumbo.jpg', 'height': 750, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/opinion/sunday/18stone/18stone-superJumbo.jpg', 'height': 1501, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/opinion/sunday/18stone/18stone-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/18/opinion/sunday/18stone/18stone-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/opinion/sunday/18stone/18stone-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why Do Anything? A Meditation on Procrastination', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': 'Why Do Anything?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bradatan, Costica', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Procrastination', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Religion and Belief', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philosophy', 'rank': 4, 'major': 'N'}], 'pub_date': '2016-09-17T18:30:28+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Costica Bradatan', 'person': [{'firstname': 'Costica', 'middlename': None, 'lastname': 'Bradatan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/17260f5f-ff4b-5773-9483-ce64e9d398c1', 'word_count': 1269, 'uri': 'nyt://article/17260f5f-ff4b-5773-9483-ce64e9d398c1'}, {'abstract': 'We need to rescue globalization not just from its populist critics but also from its cheerleaders.', 'web_url': 'https://www.nytimes.com/2016/09/18/opinion/sunday/put-globalization-to-work-for-democracies.html', 'snippet': 'We need to rescue globalization not just from its populist critics but also from its cheerleaders.', 'lead_paragraph': 'A Chinese student once described his country’s globalization strategy to me. China, he said, opened a window to the world economy, but placed a screen on it. The country got the fresh air it needed — nearly 700 million people have been lifted from extreme poverty since the early 1980s — but kept mosquitoes out.', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/opinion/sunday/18rodrik/18rodrik-articleLarge.jpg', 'height': 388, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/18/opinion/sunday/18rodrik/18rodrik-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 388}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/18/opinion/sunday/18rodrik/18rodrik-jumbo.jpg', 'height': 662, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'typ