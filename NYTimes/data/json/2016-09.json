, 'width': 1978, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Manhattan Blast Suspect Arrested', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chelsea, Manhattan Bombing (2016)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rahimi, Ahmad Khan', 'rank': 2, 'major': 'N'}], 'pub_date': '2016-09-19T15:29:20+0000', 'document_type': 'multimedia', 'news_desk': 'National', 'section_name': 'New York', 'byline': {'original': 'By MEGAN SPECIA', 'person': [{'firstname': 'Megan', 'middlename': None, 'lastname': 'SPECIA', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/bb2593c1-90c4-5081-97a2-92818f658cdc', 'word_count': 0, 'uri': 'nyt://video/bb2593c1-90c4-5081-97a2-92818f658cdc'}, {'abstract': 'What is popular in fashion right now where you live? Which looks do you like? Which looks do you dislike?', 'web_url': 'https://www.nytimes.com/2016/09/19/learning/fashion-weeks-street-style.html', 'snippet': 'What is popular in fashion right now where you live? Which looks do you like? Which looks do you dislike?', 'lead_paragraph': 'Last week was Fashion Week in New York City. Here are some looks seen on the street outside the shows. Which are your favorites?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fashion Week’s Street Style', 'kicker': 'Picture Prompts', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-09-19T15:34:37+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Katherine Schulten', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/cb5e7b34-76e3-5cc7-9188-8bfec0e8ce48', 'word_count': 72, 'uri': 'nyt://article/cb5e7b34-76e3-5cc7-9188-8bfec0e8ce48'}, {'abstract': '“The Gefilte Manifesto” and “Le Marais” go well beyond the usual brisket or roast chicken.', 'web_url': 'https://www.nytimes.com/2016/09/21/dining/cookbooks-rosh-hashanah-le-marais-gefilte-manifesto.html', 'snippet': '“The Gefilte Manifesto” and “Le Marais” go well beyond the usual brisket or roast chicken.', 'lead_paragraph': 'Sometimes all it takes is one recipe to justify a new cookbook. The chicken soup in “The Gefilte Manifesto” uses chicken parts that you brown before making the soup, something I have never done. But it works, enhancing depth and color in the broth. The whole point of the book, by the founders of the Gefilteria, the inventive online Jewish food company and caterer, is reworking traditional kosher Ashkenazi cooking and preparing dishes from scratch, with recipes like an inspired kimchi-stuffed cabbage. There’s even a recipe for kosher kimchi. But the so-called apple strudel, while easy and tasty, is a deep-dish pie, not a strudel at all. Another new approach to your Rosh Hashana dinner (the observance starts the evening of Oct. 2) may come from the kosher New York steakhouse Le Marais. Consider recipes for duck cassoulet, coq au vin, slow-roasted lamb shoulder or veal braciole from this new book instead of the usual brisket or roast chicken. The chef, Mark Hennessey, explains various steak cuts and how he adapts French recipes so they conform to the kashrut: “The Gefilte Manifesto: New Recipes for Old World Jewish Foods,” by Jeffrey Yoskowitz and Liz Alpern (Flatiron Books, $35), and “Le Marais: A Rare Steakhouse … Well Done,” by Mark Hennessey and Jose Meirelles (Gefen Publishing, $29.95).', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-BOOKS/21BURNER-BOOKS-articleLarge.jpg', 'height': 335, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/21/dining/21BURNER-BOOKS/21BURNER-BOOKS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 335}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-BOOKS/21BURNER-BOOKS-jumbo.jpg', 'height': 572, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-BOOKS/21BURNER-BOOKS-superJumbo.jpg', 'height': 1145, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-BOOKS/21BURNER-BOOKS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/21/dining/21BURNER-BOOKS/21BURNER-BOOKS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-BOOKS/21BURNER-BOOKS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Two Cookbooks Offer Fresh Approaches for Rosh Hashana', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Consult: Fresh Approaches for Rosh Hashana', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Le Marais: A Rare Steakhouse . . . Well Done (Book)', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Gefilte Manifesto: New Recipes for Old World Jewish Foods (Book)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Rosh Hashana', 'rank': 5, 'major': 'N'}], 'pub_date': '2016-09-19T15:37:23+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d5f6731b-6ff4-5bae-998b-f81aa6c88610', 'word_count': 216, 'uri': 'nyt://article/d5f6731b-6ff4-5bae-998b-f81aa6c88610'}, {'abstract': 'A former math professor runs the kitchen at Drunken Dumpling in the East Village.', 'web_url': 'https://www.nytimes.com/2016/09/21/dining/drunken-dumpling-restaurant.html', 'snippet': 'A former math professor runs the kitchen at Drunken Dumpling in the East Village.', 'lead_paragraph': 'When it comes to xiao long bao, better known as soup dumplings, few practitioners of the craft have the expertise of Qihui Guan, a diminutive, grandmotherly chef who put in plenty of time at Joe’s Shanghai in Chinatown. Now this former math professor is running the tiny kitchen of this new East Village dumpling house for her son, Yuan Lee, with three other cooks. It’s a constant traffic jam as they turn out baskets of handmade dumplings for the restaurant’s 26 seats and fill takeout orders. The soup dumplings include a pillow-size monster served with a straw for sucking the broth. Pot stickers, notable for their delicate wrappers, have fillings like chicken with cashews, beef with cilantro and mixed organic vegetables that rely on local farms for ingredients, making this yet another farm-to-table Chinese restaurant: Drunken Dumpling, 137 First Avenue (Ninth Street), 212-982-8882, drunkendumplingny.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-DUMPLING/21BURNER-DUMPLING-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/21/dining/21BURNER-DUMPLING/21BURNER-DUMPLING-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-DUMPLING/21BURNER-DUMPLING-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-DUMPLING/21BURNER-DUMPLING-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/21/dining/21BURNER-DUMPLING/21BURNER-DUMPLING-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-DUMPLING/21BURNER-DUMPLING-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/21/dining/21BURNER-DUMPLING/21BURNER-DUMPLING-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Soup Dumplings With an Expert’s Touch', 'kicker': 'Front Burner', 'content_kicker': None, 'print_headline': 'To Savor: Soup Dumplings  With an Expert’s Touch', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Dru