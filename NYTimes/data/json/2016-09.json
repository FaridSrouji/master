one, 'credit': None, 'type': 'image', 'url': 'images/2016/09/20/science/20BRODY/20BRODY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Don’t Take Osteoarthritis Lying Down', 'kicker': 'Personal Health', 'content_kicker': None, 'print_headline': 'Don’t Take Osteoarthritis Lying Down', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Osteoarthritis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brody, Jane E', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Knees', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Obesity', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Weight', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Elderly', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'ARTHRITIS', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-09-19T10:02:23+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Well', 'subsection_name': 'Live', 'byline': {'original': 'By Jane E. Brody', 'person': [{'firstname': 'Jane', 'middlename': 'E.', 'lastname': 'Brody', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed3b2654-def0-5a56-8742-ab15c917427d', 'word_count': 1093, 'uri': 'nyt://article/ed3b2654-def0-5a56-8742-ab15c917427d'}, {'abstract': 'Democracies are undermined by the growing belief the system is rigged in favor of elites.', 'web_url': 'https://www.nytimes.com/2016/09/20/opinion/the-age-of-distrust.html', 'snippet': 'Democracies are undermined by the growing belief the system is rigged in favor of elites.', 'lead_paragraph': 'ATHENS — I have a profound respect for the intelligence of the voter. Winston Churchill is often quoted as saying that the best argument against democracy is a five-minute conversation with the average voter, but more important is what he actually said in the House of Commons on Oct. 31, 1944: “At the bottom of all the tributes paid to democracy is the little man, walking into the little booth, with a little pencil, making a little cross on a little bit of paper — no amount of rhetoric or voluminous discussion can possibly palliate the overwhelming importance of that point.”', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/19/opinion/20cohen-B/20cohen-B-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/19/opinion/20cohen-B/20cohen-B-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/19/opinion/20cohen-B/20cohen-B-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/19/opinion/20cohen-B/20cohen-B-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/19/opinion/20cohen-B/20cohen-B-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/19/opinion/20cohen-B/20cohen-B-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/19/opinion/20cohen-B/20cohen-B-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Age of Distrust', 'kicker': 'Op-Ed Columnist', 'content_