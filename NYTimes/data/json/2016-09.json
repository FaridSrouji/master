 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-09-09T17:00:28+0000', 'document_type': 'multimedia', 'news_desk': 'Arts', 'section_name': 'Arts', 'byline': {'original': 'Compiled by LOUIS LUCERO II', 'person': [{'firstname': 'Louis', 'middlename': 'Lucero', 'lastname': 'II', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/41156ca3-b295-5183-8e38-ab5adf4b29e0', 'word_count': 0, 'uri': 'nyt://interactive/41156ca3-b295-5183-8e38-ab5adf4b29e0'}, {'abstract': 'Maybe Matt Lauer did us a favor.', 'web_url': 'https://krugman.blogs.nytimes.com/2016/09/09/is-the-fever-finally-breaking/', 'snippet': 'Maybe Matt Lauer did us a favor.', 'lead_paragraph': 'The last month has been a disgraceful time for the news media, with headline after headline, news report after news report on supposed Clinton scandals that were obvious nothingburgers — as the Washington Post, I’m happy to say, has now acknowledged. All of this created an “aura of scandal” around Clinton, even though, as Greg Sargent notes, voters couldn’t come up with specifics when pressed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is The Fever Finally Breaking?', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2016-09-09T17:02:11+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/79f84487-ff97-5ca4-83bb-ed12333eaa39', 'word_count': 385, 'uri': 'nyt://article/79f84487-ff97-5ca4-83bb-ed12333eaa39'}, {'abstract': 'Police officers had been responding to a 911 call when Mr. Nojay, a Republican from the Rochester area, shot himself on Friday.', 'web_url': 'https://www.nytimes.com/2016/09/10/nyregion/bill-nojay-rochester-assemblyman-dies.html', 'snippet': 'Police officers had been responding to a 911 call when Mr. Nojay, a Republican from the Rochester area, shot himself on Friday.', 'lead_paragraph': 'The Bill Nojay Show always started the same way: martial music, crowned with a menacing voice-over that offered a grim portrait of the State of New York — its government, its criminals and its “intolerable tax burden.”', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/10/nyregion/10NOJAY1/10NOJAY1-articleLarge.jpg', 'height': 832, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/10/nyregion/10NOJAY1/10NOJAY1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 832}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/10/nyregion/10NOJAY1/10NOJAY1-jumbo.jpg', 'height': 917, 'width': 661, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/10/nyregion/10NOJAY1/10NOJAY1-superJumbo.jpg', 'height': 917, 'width': 661, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/10/nyregion/10NOJAY1/10NOJAY1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/10/nyregion/10NOJAY1/10NOJAY1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/10/nyregion/10NOJAY1/10NOJAY1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bill Nojay, Upstate Assemblyman, Dies After Shooting Himself at a Cemetery', 'kicker': None, 'content_kicker': None, 'print_headline': 'Assemblyman Kills Himself at a Cemetery in Rochester', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Nojay, Bill', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Fatalities)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Suicides and Suicide Attempts', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Rochester (NY)', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Embezzlement', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 9, 'major': 'N'}], 'pub_date': '2016-09-09T17:05:10+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Vivian Yee', 'person': [{'firstname': 'Vivian', 'middlename': None, 'lastname': 'Yee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/25ef623a-59f8-54f0-b5f3-d19e648ebfca', 'word_count': 959, 'uri': 'nyt://article/25ef623a-59f8-54f0-b5f3-d19e648ebfca'}, {'abstract': 'Jack London is best known for classics like “The Call of the Wild,” but he also took remarkable photographs during his travels around the world.', 'web_url': 'https://www.nytimes.com/2016/09/11/books/review/jack-london-photographs.html', 'snippet': 'Jack London is best known for classics like “The Call of the Wild,” but he also took remarkable photographs during his travels around the world.', 'lead_paragraph': 'Jack London’s classic “The Call of the Wild,” published in 1903, imagined the harsh life of a dog. But London also witnessed human suffering close to home and on travels throughout the world, chronicling them in his famous words and in less famous but remarkable photographs.', 'print_section': 'BR', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/11/books/review/11OPENBOOK/11OPENBOOK-articleLarge-v2.jpg', 'height': 460, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/11/books/review/11OPENBOOK/11OPENBOOK-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 460}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/11/books/review/11OPENBOOK/11OPENBOOK-jumbo-v2.jpg', 'height': 785, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/11/books/review/11OPENBOOK/11OPENBOOK-superJumbo-v2.jpg', 'height': 1117, 'width': 1458, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/11/books/review/11OPENBOOK/11OPENBOOK-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/11/books/review/11OPENBOOK/11OPENBOOK-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/11/books/review/11OPENBOOK/11OPENBOOK-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Different View of London', 'kicker': 'Open Book', 'content_kicker': None, 'print_he