ption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30AMANDA/30AMANDA-articleLarge.jpg', 'height': 847, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/30/arts/30AMANDA/30AMANDA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 847}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30AMANDA/30AMANDA-jumbo.jpg', 'height': 1024, 'width': 726, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/30/arts/30AMANDA/30AMANDA-superJumbo.jpg', 'height': 1646, 'width': 1166, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'Review: In ‘Amanda Knox,’ a Murder and Journalism Run Amok', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Knox, Amanda', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Amanda Knox (Movie)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Murders, Attempted Murders and Homicides', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Blackhurst, Rod (1980- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'McGinn, Brian (1984- )', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-09-29T20:49:38+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Jeannette Catsoulis', 'person': [{'firstname': 'Jeannette', 'middlename': None, 'lastname': 'Catsoulis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c42cd879-ab3c-