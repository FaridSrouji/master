p_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Moments of Giants Glory: What Alzheimer’s Couldn’t Steal', 'kicker': 'Essay', 'content_kicker': None, 'print_headline': 'A Team’s Dominant Run, and a Mother’s Long Descent', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'San Francisco Giants', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': "Alzheimer's Disease", 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Superstitions', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'World Series', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-23T09:00:05+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Conor Dougherty', 'person': [{'firstname': 'Conor', 'middlename': None, 'lastname': 'Dougherty', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/52f10e59-387d-58a7-b7e0-af48ba61ebfc', 'word_count': 979, 'uri': 'nyt://article/52f10e59-387d-58a7-b7e0-af48ba61ebfc'}, {'abstract': 'Ahmad Khan Rahami, who is charged in a two-state bombing spree, was flagged for extra screening when he returned from traveling abroad, but his travels did not raise any immediate alarm.', 'web_url': 'https://www.nytimes.com/2016/09/24/nyregion/how-ahmad-khan-rahami-passed-through-a-net-meant-to-thwart-terrorists.html', 'snippet': 'Ahmad Khan Rahami, who is charged in a two-state bombing spree, was flagged for extra screening when he returned from traveling abroad, but his travels did not raise any immediate alarm.', 'lead_paragraph': 'WASHINGTON — To an amateur eye, Ahmad Khan Rahami’s travel history might appear to be a red flag: He had traveled to Pakistan, the home of Al Qaeda, four times between 2005 and 2014. The last time he stayed for a year.', 'print_s