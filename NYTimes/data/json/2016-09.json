imes', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/business/16db-indebt/16db-indebt-articleLarge.jpg', 'height': 405, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/16/business/16db-indebt/16db-indebt-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 405}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/business/16db-indebt/16db-indebt-jumbo.jpg', 'height': 690, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/business/16db-indebt/16db-indebt-superJumbo.jpg', 'height': 1381, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/business/16db-indebt/16db-indebt-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/16/business/16db-indebt/16db-indebt-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/16/business/16db-indebt/16db-indebt-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lack of Planning Hampers Hanjin Shipping Bankruptcy', 'kicker': 'In Debt', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Hanjin Shipping Co', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Bankruptcies', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'South Korea', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-09-15T13:17:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'DealBook', 'byline': {'original': 'By Stephen J. Lubben', 'person': [{'firstname': 'Stephen', 'middlename': 'J.', 'lastname': 'Lubben', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8fdeff92-f9f8-5d25-a9ec-70a2032300d2', 'word_count': 321, 'uri': 'nyt://article/8fdeff92-f9f8-5d25-a9ec-70a2032300d2'}, {'abstract': 'From the archives of the International Herald Tribune: Argentina passes a resolution to declare the German Ambassador Edmund von Thermann persona non grata in September 1941.', 'web_url': 'https://iht-retrospective.blogs.nytimes.com/2016/09/15/1941-effort-to-oust-nazi-envoy/', 'snippet': 'From the archives of the International Herald Tribune: Argentina passes a resolution to declare the German Ambassador Edmund von Thermann persona non grata in September 1941.', 'lead_paragraph': 'BUENOS AIRES — Argentina’s Chamber of Deputies approved tonight [Sept. 15], by a vote of 79 to 1, a resolution of censure stating that the German Ambassador, Baron Edmund von Thermann, ‘‘has exceeded his functions and abused diplomatic privileges.’’ The committee has contended that Thermann and his staff have helped to direct and finance totalitarian penetration in Argentina. It has urged that Thermann be declared persona non grata, and it sponsored the motion approved today, after cloakroom polls had indicated that the Chamber would refuse to back it up in that contention. — New York Herald Tribune, Sept. 16, 1941', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '1941: Effort to Oust Nazi Envoy', 'kicker': 'IHT Retrospective', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'ARGENTINA', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Buenos Aires (Argentina)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 3, 'major': 'N'}], 'pub_date': '2016-09-15T13:20:27+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'byline': {'original': 'By International Herald Tribune', 'person': [{'firstname': 'International', 'middlename': 'Herald', 'lastname': 'Tribune', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/afdd3fb4-6392-56f2-98fe-3ff0b345cf29', 'word_count': 100, 'uri': 'nyt://article/afdd3fb4-6392-56f2-98fe-3ff0b345cf29'}, {'abstract': 'Ms. Bland was found dead in a jail cell in Waller County, Tex., after her arrest during a traffic stop in 2015. Her family disputed the authorities’ report that she had committed suicide.', 'web_url': 'https://www.nytimes.com/2016/09/16/us/sandra-bland-family-settlement-19-million-lawsuit.html', 'snippet': 'Ms. Bland was found dead in a jail cell in Waller County, Tex., after her arrest during a traffic stop in 2015. Her family disputed the authorities’ report that she had committed suicide.', 'lead_paragraph': 'The family of Sandra Bland, the woman who Texas officials  said committed suicide in jail last year after her arrest during a traffic stop, has agreed to a $1.9 million settlement in their wrongful-death civil suit, the family’s lawyer said on Thursday. But state and county officials said there was no final agreement.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/15/us/16xp-bland/16xp-bland-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/15/us/16xp-bland/16xp-bland-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 