ame': 'glocations', 'value': 'San Francisco (Calif)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Arnold, Laura and John, Foundation', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Crime and Criminals', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2016-09-17T03:16:12+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/ba8e26a6-6730-56e2-a561-8a3f50be796c', 'word_count': 465, 'uri': 'nyt://article/ba8e26a6-6730-56e2-a561-8a3f50be796c'}, {'abstract': 'Some of the women who took part in a New York Times/CBS News poll were called to talk further about the challenges they face today.', 'web_url': 'https://www.nytimes.com/2016/09/17/us/politics/womens-rights-voices-poll-inequality-clinton.html', 'snippet': 'Some of the women who took part in a New York Times/CBS News poll were called to talk further about the challenges they face today.', 'lead_paragraph': 'The latest New York Times/CBS News poll took a reading on the attitudes of American women on a range of topics, from politics to opportunities in the workplace to their overall level of satisfaction in life. We called back a number of them to talk further and also consulted some experts about the challenges facing women today. Here are some of their voices.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'From Women, Skepticism About Marriage and a Hunger for Workplace Equality', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2016', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 3, 'maj