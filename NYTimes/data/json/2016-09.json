': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Arts and Antiquities Looting', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Assn of Art Museum Directors', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Malevich, Kasimir', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-09-16T22:02:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Doreen Carvajal', 'person': [{'firstname': 'Doreen', 'middlename': None, 'lastname': 'Carvajal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/514a22a5-8299-5787-8f4b-1d201cf04b9e', 'word_count': 626, 'uri': 'nyt://article/514a22a5-8299-5787-8f4b-1d201cf04b9e'}, {'abstract': 'The video-sharing app Musical.ly seems to be popular with children well under the age of 13, which leads to questions over how to monitor young people on the web.', 'web_url': 'https://www.nytimes.com/2016/09/17/business/media/a-social-network-frequented-by-children-tests-the-limits-of-online-regulation.html', 'snippet': 'The video-sharing app Musical.ly seems to be popular with children well under the age of 13, which leads to questions over how to monitor young people on the web.', 'lead_paragraph': 'In the folklore of the start-up world, few figures loom larger than the teenager. Teenagers see the future, set trends and spend money, or compel parents to spend it for them. Their behavior has become an obsession for entrepreneurs.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'ima