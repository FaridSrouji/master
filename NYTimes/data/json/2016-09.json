bLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/23/sports/23GOLFCOURSES1/23GOLFCOURSES1-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/23/sports/23GOLFCOURSES1/23GOLFCOURSES1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/23/sports/23GOLFCOURSES1/23GOLFCOURSES1-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/23/sports/23GOLFCOURSES1/23GOLFCOURSES1-superJumbo.jpg', 'height': 1370, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}], 'headline': {'main': 'If the 18th Hole Isn’t Made for TV, Make It the 9th', 'kicker': None, 'content_kicker': None, 'print_headline': 'Need a Better 18th Hole?  Just Use the Ninth Instead', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Borden, Sam', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'PGA Tour Inc', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Ryder Cup (Golf)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'PGA Championship', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 7, 'major': 'N'}], 'pub_date': '2016-09-23T19:39:10+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/019b6076-0c6a-5bc8-9334-06e1146e8761', 'word_count': 1110, 'uri': 'nyt://article/019b6076-0c6a-5bc8-9334-06e1146e8761'}, {'abstract': 'Two months after refusing to endorse Mr. Trump at the G.O.P. convention, the senator said he had decided to vote for the nominee after “searching my own conscience.”', 'web_url': 'https://www.nytimes.com/2016/09/24/us/politics/ted-cruz-donald-trump.html', 'snippet': 'Two months after refusing to endorse Mr. Trump at the G.O.P. convention, the senator said he had decided to vote for the nominee after “searching my own conscience.”', 'lead_paragraph': 'Senator Ted Cruz said on Friday that he would vote for Donald J. Trump for president, two months after Mr. Cruz pointedly declined to endorse his former rival in a speech at the Republican National Convention.', 'print_section': 'A', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/24/us/24fd-cruz/24fd-cruz-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2016/09/24/us/24fd-cruz/24fd-cruz-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/24/us/24fd-cruz/24fd-cruz-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}, {'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2016/09/24/us/24fd-cruz/24fd-cruz-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2016/09/24/us/24fd-cruz/24fd-cruz-articleLarge.jpg', 'xlargewidth': 600, 