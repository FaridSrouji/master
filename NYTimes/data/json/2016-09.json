1f7-473c-59d5-a5a3-59705d455d28', 'word_count': 0, 'uri': 'nyt://slideshow/08ecc1f7-473c-59d5-a5a3-59705d455d28'}, {'abstract': 'The filmmakers Ira Sachs and Kirsten Johnson, both of whom have movies out now, are co-parents to four-year-old twins — along with Sachs’s husband.', 'web_url': 'https://www.nytimes.com/2016/09/15/t-magazine/entertainment/kirsten-johnson-cameraperson-ira-sachs.html', 'snippet': 'The filmmakers Ira Sachs and Kirsten Johnson, both of whom have movies out now, are co-parents to four-year-old twins — along with Sachs’s husband.', 'lead_paragraph': 'When the filmmaker Kirsten Johnson travels for work, she often hears the same question: “Who are your kids with?” And she always has the same answer: “They’re with their married parents.” Johnson, who has filmed documentaries for Michael Moore and Laura Poitras, among others, is the co-parent of the 4-year-old twins Felix and Viva with the painter Boris Torres and the filmmaker Ira Sachs, who share an apartment next door to her in Manhattan. Their family, as the three are quick to make clear, is not a communal experiment, but rather more of a collaboration: As creative individuals each of whom wanted children, they have found a way to navigate the complicated work-life balance in ways that suit all their needs.', 'print_section': 'ST', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'At Home With a Very Modern, Very Artistic Family', 'kicker': None, 'content_kicker': None, 'print_headline': 'Home Life; A Very Modern, Very Artistic Family', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Work-Life Balance', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Kirsten (1965- )', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sachs, Ira', 'rank': 5, 'major': 'N'