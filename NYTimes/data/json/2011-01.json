': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/28/arts/28SUNDANCE-span/SUNDANCE-1-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/28/arts/28SUNDANCE-span/SUNDANCE-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/28/arts/28SUNDANCE-span/SUNDANCE-1-jumbo.jpg', 'height': 598, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/28/arts/28SUNDANCE-span/SUNDANCE-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/28/arts/28SUNDANCE-span/SUNDANCE-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Turns Out Sundance Thrives on More Than Just Money', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Turns Out Sundance Thrives On More Than Just Money', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sundance Film Festival (Park City, Utah)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-27T22:58:22+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/eb034f27-1ce8-5800-aff1-8159aa2c4477', 'word_count': 1516, 'uri': 'nyt://article/eb034f27-1ce8-5800-aff1-8159aa2c4477'}, {'abstract': 'The private equity-backed Florida lender joins a wave of companies going public this week.', 'web_url': 'https://dealbook.nytimes.com/2011/01/27/bankunited-prices-i-p-o-at-27/', 'snippet': 'The private equity-backed Florida lender joins a wave of companies going public this week.', 'lead_paragraph': 'BankUnited is set on Friday to become the latest company to exceed expectations with its public stock offering.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'BankUnited Prices I.P.O. at $27 a Share', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Initial Public Offerings', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'BankUnited', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-27T22:59:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Ben Protess and Michael J. de la Merced', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Protess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/a56cdb7b-e688-5b61-affe-18f27e339471', 'word_count': 611, 'uri': 'nyt://article/a56cdb7b-e688-5b61-affe-18f27e339471'}, {'abstract': 'Charif Souki, chief of Cheniere Energy, envisions a network of terminals exporting cheap American natural gas to Europe and Asia.', 'web_url': 'https://www.nytimes.com/2011/01/28/business/economy/28gas.html', 'snippet': 'Charif Souki, chief of Cheniere Energy, envisions a network of terminals exporting cheap American natural gas to Europe and Asia.', 'lead_paragraph': 'CAMERON PARISH, La. \x97 The oil patch is a world of risk takers, but few are as daring as Charif Souki, the chairman and chief executive of Cheniere Energy. ', 'print_sec