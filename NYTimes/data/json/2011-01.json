': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/4a489630-37e6-5653-8def-c3a8e9ed7b1c', 'word_count': 700, 'uri': 'nyt://article/4a489630-37e6-5653-8def-c3a8e9ed7b1c'}, {'abstract': 'Live analysis and coverage of the N.F.C. wild-card game between the Green Bay Packers and the Philadelphia Eagles.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/01/09/live-analysis-packers-at-eagles/', 'snippet': 'Live analysis and coverage of the N.F.C. wild-card game between the Green Bay Packers and the Philadelphia Eagles.', 'lead_paragraph': 'Live analysis and coverage of the N.F.C. wild-card game between the Green Bay Packers and the Philadelphia Eagles. This game is a rematch of a Week 1 meeting won by Green Bay, a game that marked both the beginning and the end of the Kevin Kolb era in Philadelphia. To say things have changed since then for the Eagles and for Kolb’s replacement, Michael Vick, would be a massive understatement.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Final: Packers 21, Eagles 16', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Philadelphia Eagles', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-09T21:04:46+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Andrew Das', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Das', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/de0d522d-5732-5539-8001-9d4fe8d59957', 'word_count': 2244, 'uri': 'nyt://article/de0d522d-5732-5539-8001-9d4fe8d59957'}, {'abstract':