': 'nyt://article/35981726-cabd-5b54-906e-1619a79ba91d', 'word_count': 485, 'uri': 'nyt://article/35981726-cabd-5b54-906e-1619a79ba91d'}, {'abstract': 'Defense Secretary Robert M. Gates arrived in Tokyo a day after a visit to China, during which China tested a new stealth jet fighter.', 'web_url': 'https://www.nytimes.com/2011/01/13/world/asia/13military.html', 'snippet': 'Defense Secretary Robert M. Gates arrived in Tokyo a day after a visit to China, during which China tested a new stealth jet fighter.', 'lead_paragraph': 'TOKYO \x97 Defense Secretary Robert M. Gates arrived in Tokyo on Wednesday night for talks with Prime Minister Naoto Kan and foreign and defense officials focusing on North Korea’s nuclear program as well as Mr. Gates’s new assessment that Pyongyang would have a missile capable of hitting the United States within five years. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/13/world/13military-cnd-inline1/13military-cnd-inline1-jumbo.jpg', 'height': 668, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/13/world/13military-cnd-inline1/13military-cnd-inline1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/13/world/13military-cnd-inline1/13military-cnd-inline1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Gates in Tokyo for Talks on North Korea', 'kicker': None, 'content_kicker': None, 'print_headline': 'Gates in Tokyo for Talks on North Korea', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'North Korea', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank