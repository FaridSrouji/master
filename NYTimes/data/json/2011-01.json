 None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/3552fcaa-cb7c-55a2-9262-95a046b26801', 'word_count': 836, 'uri': 'nyt://article/3552fcaa-cb7c-55a2-9262-95a046b26801'}, {'abstract': 'In his first State of the State speech, Gov. Andrew M. Cuomo wisely chucked lofty rhetoric and vague promises in favor of a stark analysis of New York’s dismal plight.', 'web_url': 'https://www.nytimes.com/2011/01/06/opinion/06thu1.html', 'snippet': 'In his first State of the State speech, Gov. Andrew M. Cuomo wisely chucked lofty rhetoric and vague promises in favor of a stark analysis of New York’s dismal plight.', 'lead_paragraph': ' Past New York governors usually leaned on lofty rhetoric and vague promises as they gave their annual State of the State speeches in the stuffy halls of the Legislature. Gov. Andrew Cuomo wisely chucked all that on Wednesday in favor of a stark analysis of New York’s dismal plight.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Governor Cuomo’s New York', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Governor Cuomo’s New York', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'State of the State Message (NYS)', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Budgets and Budgeting', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'State Legislatures', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-06T04:35:42+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/43098b5e-aacf-5946-bdfe-50930f9ff89d', 'word_count': 621, 'uri': 'nyt://article/43098b5e-aacf-5946-bdfe-50930f9ff89d'}, {'abstract': 'Nearly a year after the earthquake in Haiti, what people really need isn’t charity but livelihoods. Here’s an example of how an organization is turning Haitians into entrepreneurs.', 'web_url': 'https://www.nytimes.com/2011/01/06/opinion/06kristof.html', 'snippet': 'Nearly a year after the earthquake in Haiti, what people really need isn’t charity but livelihoods. Here’s an example of how an organization is turning Haitians into entrepreneurs.', 'lead_paragraph': 'Nearly a year after the earthquake in Haiti, more than one million people are still living in tents and reconstruction has barely begun \x97 and that’s a useful reminder of the limitations of charity and foreign aid. ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-articleLarge-v2.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-articleLarge-v2.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-jumbo-v2.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-superJumbo-v2.png', 'height': 1000, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/03/opinion/nicholas-kristof/nicholas-kristof-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail'