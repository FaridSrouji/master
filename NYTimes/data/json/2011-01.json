NO-jumbo.jpg', 'height': 1024, 'width': 631, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/20/sports/PAVANO/PAVANO-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/20/sports/PAVANO/PAVANO-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Yankees’ Consideration of Carl Pavano Seemed Unthinkable', 'kicker': None, 'content_kicker': None, 'print_headline': 'IT SEEMED UNTHINKABLE, DIDN’T IT?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Pettitte, Andy', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Pavano, Carl', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Baseball', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-20T03:04:19+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Mark Viera', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Viera', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d0ef0153-c0b4-54b6-b812-acb221d96d4e', 'word_count': 219, 'uri': 'nyt://article/d0ef0153-c0b4-54b6-b812-acb221d96d4e'}, {'abstract': 'Even though a few Democrats and Republicans will be sitting next to each other during the State of the Union speech, a wide and deep aisle between the parties remains.', 'web_url': 'https://www.nytimes.com/2011/01/20/opinion/20thu1.html', 'snippet': 'Even though a few Democrats and Republicans will be sitting next to each other during the State of the Union speech, a wide and deep aisle between the parties remains.', 'lead_paragraph': 'A few Congressional Democrats and Republicans will be sitting next to each other on Tuesday night during the State of the Union address, straying from their glowering bunkers on opposite sides of the aisle. It’s a lovely idea, intended to show that ideological divisions do not require personal rancor. But it is essentially a gesture to the cameras, and it should not obscure what remains a wide and fundamentally deep aisle between the parties.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Beyond the Happy Visuals', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Beyond the Happy Visuals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Democratic Party', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-20T03:09:15+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://article/11b0621d-701a-5fe5-94ca-ceffe846b400', 'word_count': 615, 'uri': 'nyt://article/11b0621d-701a-5fe5-94ca-ceffe846b400'}, {'abstract': 'In a 7-0 victory over Toronto, Marian Gaborik ended his scoring slump with four goals, the most by a Ranger in 10 years.', 'web_url': 'https://www.nytimes.com/2011/01/20/sports/hockey/20nhl.html', 'snippet': 'In a 7-0 victory over Toronto, Marian Gaborik ended his scoring slump with four goals, the most by a Ranger in 10 years.', 'lead_paragraph': ' The Rangers had to take the bad with the good from Wednesday night’s 7-0 rout of the Toronto Maple Leafs at Madison Square Garden. 