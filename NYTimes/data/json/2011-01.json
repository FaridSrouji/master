o': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2012', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Daley, William M', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-06T16:58:16+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Michael D. Shear and Jackie Calmes', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/020ba106-8946-5f77-8c53-77428dc35656', 'word_count': 1079, 'uri': 'nyt://article/020ba106-8946-5f77-8c53-77428dc35656'}, {'abstract': 'As an exclusivity agreement between Apple and AT&T comes to a close, the wireless carrier begins forming new partnerships with a broader circle of handset makers.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2011/01/06/att-readies-its-post-iphone-strategy/', 'snippet': 'As an exclusivity agreement between Apple and AT&T comes to a close, the wireless carrier begins forming new partnerships with a broader circle of handset makers.', 'lead_paragraph': ' LAS VEGAS — AT&T’s agreement with Apple to be the exclusive distributor of the iPhone in the United States may be drawing to a close, but the nation’s second-largest wireless carrier has no plans to be left empty-handed when it ends.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'AT&T Readies Its Post-iPhone Strategy', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Telephones and Telecommunications', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'AT&T Inc', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-06T17:05:35+0000', 'document_type': 'ar