mes', 'multimedia': [], 'headline': {'main': 'Just One Look | Proenza Schouler Pre-Fall Collection', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hernandez, Lazaro', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McCollough, Jack', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Schouler, Proenza', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-19T19:30:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alix Browne', 'person': [{'firstname': 'Alix', 'middlename': None, 'lastname': 'Browne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/657d37b5-126b-5857-b377-fb8ef989ab5b', 'word_count': 91, 'uri': 'nyt://article/657d37b5-126b-5857-b377-fb8ef989ab5b'}, {'abstract': 'Blackstone Departure| Apple Swag| Comcast’s Regulatory Win', 'web_url': 'https://dealbook.nytimes.com/2011/01/19/buzz-tracker-12/', 'snippet': 'Blackstone Departure| Apple Swag| Comcast’s Regulatory Win', 'lead_paragraph': 'Goldman’s Golden Elite: Theo Francis of Footnoted.com, who helped DealBook crunch data on Goldman Sachs’ partnership, has more on the firm’s “curious hybrid.”  Footnoted.com', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Buzz Tracker', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-19T19:35:40+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization'