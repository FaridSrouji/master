et/25vatech-casket-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/us/25vatech-casket/25vatech-casket-jumbo.jpg', 'height': 676, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/us/25vatech-casket/25vatech-casket-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/25/us/25vatech-casket/25vatech-casket-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Tucson Attack Reawakens Pain From Virginia Tech', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Life Haunted by the Ghosts of a Massacre', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grief (Emotions)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Virginia Polytechnic Institute and State University', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Nowak, Jerzy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'School Shootings', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Tucson Shooting (2011)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Couture-Nowak, Jocelyne', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-01-24T17:26:21+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Katharine Q. Seelye', 'person': [{'firstname': 'Katharine', 'middlename': 'Q.', 'lastname': 'Seelye', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6712582d-252b-5b3f-b685-17ba901b180c', 'word_count': 1374, 'uri': 'nyt://article/6712582d-252b-5b3f-b685-17ba901b180c'}, {'abstract': 'The original play, in which Death takes on human form, has been presented on Broadway and in films that have starred Frederic March and Brad Pitt.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/01/24/whistling-past-the-graveyard-a-musical-version-of-death-takes-a-holiday/', 'snippet': 'The original play, in which Death takes on human form, has been presented on Broadway and in films that have starred Frederic March and Brad Pitt.', 'lead_paragraph': 'Looks like it might be time for the Grim Reaper to put down his scythe and pick up a pitch pipe. A musical version of “Death Takes a Holiday,” the much-revived Alberto Casella play that tries to put a human face on the relentless pale rider, is being prepared by a team of creative heavyweights who will bring it to life for the Roundabout Theater Company this summer. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Whistling Past the Graveyard: A Musical Version of ‘Death Takes a Holiday’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Roundabout Theater Co', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-24T17:27:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/a39f2b45-8fd1-5eff-a2e3-05a5605025ed', 'word_count': 231, 'uri': 'nyt://article/a39f2b45-8fd1-5eff-a2e3-05a5605025ed'}, {'abstract': 'Internal Palestinian documents leaked to Al Jazeera show a split between the public and private faces of negotiation.', 'web_url': 'https://www.nytimes.com/2011/01/25/world/middleeast/25mideast.html', 'snippet': 'Internal Palestinian documents leaked to Al Jazeera show a split between the public and private faces of negotiation.', 'lead_paragraph': 'JERUSALEM \x97 Israeli-Palestinian peace talks over the past 17 years have operated at two levels, one public, the other behind closed doors. To the world and their own people, each side spoke of sacred, nonnegotiable demands, while in the Jerusalem hotel suites where the officials met those very demands were under negotiation.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/world/25mideast_337-span/MIDEAST-1-articleLarge.jpg', 'height': 330, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/25/world/25mideast_337-span/MIDEAST-1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 330}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/world/25mideast_337-span/MIDEAST-1-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Documents Open a Door on Mideast Peace Talks', 'kicker': 'News Analysis', 'content_kicker': None, 'print_headline': 'Leaked Documents Open a Door on Mideast Peace Talks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'International Relations', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ABBAS, MAHMOUD', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Jerusalem (Israel)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'West Bank', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Palestinian Authority', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'AL JAZEERA', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 8, 'maj