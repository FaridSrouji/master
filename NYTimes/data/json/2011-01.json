ame': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-28T01:21:24+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Fernanda Santos', 'person': [{'firstname': 'Fernanda', 'middlename': None, 'lastname': 'Santos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90245d4d-3657-5f22-9736-1d27d7ab53d6', 'word_count': 608, 'uri': 'nyt://article/90245d4d-3657-5f22-9736-1d27d7ab53d6'}, {'abstract': 'The states’ financial problems have many investors shying away from municipal bonds. The federal situation may be even more troublesome.', 'web_url': 'https://www.nytimes.com/2011/01/28/business/28views.html', 'snippet': 'The states’ financial problems have many investors shying away from municipal bonds. The federal situation may be even more troublesome.', 'lead_paragraph': 'The budget shortfalls gripping many states have rattled the $3 trillion municipal bond market. Yet even with unfunded pensions added, their debt burdens are dwarfed by those of the federal government. There are big structural differences, but the evidence suggests investors should worry less about munis and more about Treasuries.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'If Munis Are Perilous, What About Treasuries?', 'kicker': 'Reuters Breakingviews', 'content_kicker': None, 'print_headline': 'Muni Bonds\nVs. Treasuries', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Government Bonds', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank':