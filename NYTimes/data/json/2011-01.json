ct', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Rooney, Dan', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Steelers', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-22T01:09:13+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e547f40b-2f3a-53ed-92eb-80410039b84d', 'word_count': 491, 'uri': 'nyt://article/e547f40b-2f3a-53ed-92eb-80410039b84d'}, {'abstract': 'A commissioner who protected low- and middle-income homes when the real-estate market collapsed is taking a private-sector job.', 'web_url': 'https://www.nytimes.com/2011/01/22/nyregion/22cestero.html', 'snippet': 'A commissioner who protected low- and middle-income homes when the real-estate market collapsed is taking a private-sector job.', 'lead_paragraph': 'Rafael E. Cestero, who as commissioner of the city Department of Housing Preservation and Development had the task of protecting and building low-cost housing during the real estate crash, will leave his job in March for a private-sector post, the mayor’s office announced on Friday. ', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'City’s Housing Chief, Advocate for Affordability, Is Resigning', 'kicker': None, 'content_kicker': None, 'print_headline': 'City’s Housing Chief, Advocate\nFor Affordability, Is Resigning', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Cestero, Rafael E', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Change