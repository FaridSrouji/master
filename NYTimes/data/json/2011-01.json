ust', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Detroit, Toyota Vows to Earn Trust', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Toyoda, Akio', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Toyota Motor Corp', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'North American International Auto Show', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-11T02:59:56+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Nick Bunkley', 'person': [{'firstname': 'Nick', 'middlename': None, 'lastname': 'Bunkley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a427c95c-0452-5287-b24e-ca8349683435', 'word_count': 813, 'uri': 'nyt://article/a427c95c-0452-5287-b24e-ca8349683435'}, {'abstract': 'ESPN proceeded with its regular pregame programming of the national title game in Glendale, Ariz., despite the shootings on Saturday in Tucson.', 'web_url': 'https://www.nytimes.com/2011/01/11/sports/ncaafootball/11sandomir.html', 'snippet': 'ESPN proceeded with its regular pregame programming of the national title game in Glendale, Ariz., despite the shootings on Saturday in Tucson.', 'lead_paragraph': 'ESPN proceeded with its regular pregame programming before Oregon and Auburn played Monday night in the Bowl Championship Series title game in Glendale, Ariz., despite the shootings on Saturday in Tucson that left 6 dead and 14 wounded.', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Shootings’ Wake, ESPN Sticks to Script', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Shootings’ Wake, ESPN Sticks to Script', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', '