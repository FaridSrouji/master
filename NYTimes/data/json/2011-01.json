'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b8b5f9d8-847f-5a88-bf77-9446274fa63d', 'word_count': 1291, 'uri': 'nyt://article/b8b5f9d8-847f-5a88-bf77-9446274fa63d'}, {'abstract': 'Portuguese officials said the successful auction vindicated their plan to finance debt through the markets rather than ask for help from Europe’s rescue fund.', 'web_url': 'https://www.nytimes.com/2011/01/13/business/global/13euro.html', 'snippet': 'Portuguese officials said the successful auction vindicated their plan to finance debt through the markets rather than ask for help from Europe’s rescue fund.', 'lead_paragraph': 'Portugal won some breathing room Wednesday with a better-than-expected bond auction that fueled a rise in global stock markets and led the government to reaffirm its stance against accepting a bailout.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/13/business/Euro/Euro-jumbo.jpg', 'height': 1024, 'width': 941, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Bond Sale a Success in Portugal', 'kicker': None, 'content_kicker': None, 'print_headline': 'Bond Sale A Success In Portugal', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Portugal', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Euro (Currency)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-12T11:50:00+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Global Business', 'byline': {'