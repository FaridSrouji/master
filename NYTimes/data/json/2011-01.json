ce': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dining Calendar', 'kicker': None, 'content_kicker': None, 'print_headline': 'Calendar', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-26T02:37:21+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Florence Fabricant', 'person': [{'firstname': 'Florence', 'middlename': None, 'lastname': 'Fabricant', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/2ea9d03f-58bc-526b-9a4b-ee8963d9c3b8', 'word_count': 219, 'uri': 'nyt://article/2ea9d03f-58bc-526b-9a4b-ee8963d9c3b8'}, {'abstract': 'Mr. Eichinger, a prominent force in the German film industry, worked on films including “The NeverEnding Story” and “Downfall.”', 'web_url': 'https://www.nytimes.com/2011/01/26/arts/26eichinger.html', 'snippet': 'Mr. Eichinger, a prominent force in the German film industry, worked on films including “The NeverEnding Story” and “Downfall.”', 'lead_paragraph': 'Bernd Eichinger, a German screenwriter and producer who made films in Germany and Hollywood, including the children’s fairy tale “The NeverEnding Story,” the “Resident Evil” series derived from video games, and “Downfall,” a movie about the last days of the Third Reich that raised hackles for humanizing Adolf Hitler, died in Los Angeles on Monday. He was 61.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/26/arts/EICHINGER2obit/EICHINGER2obit-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/26/arts/EICHINGER2obit/EICHINGER2obit-thumbStandard.jpg', 'height': 75, 'width': 