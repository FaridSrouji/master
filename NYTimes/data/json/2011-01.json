tname': 'Hal', 'middlename': None, 'lastname': 'Ersner-Hershfield', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/d5834bdf-d6b2-5d89-ae19-022b46552c92', 'word_count': 513, 'uri': 'nyt://article/d5834bdf-d6b2-5d89-ae19-022b46552c92'}, {'abstract': 'The 112th Congress is officially in session. Here are some other events to look forward to this year.', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/01/05/day-1-let-the-festivities-begin/', 'snippet': 'The 112th Congress is officially in session. Here are some other events to look forward to this year.', 'lead_paragraph': 'David Brooks: Gail, this is going to be a fantastic year. Did you know the Chernobyl nuclear plant is going to be re-opened for official tours this month? Did you know that General Motors will run a Super Bowl ad for the first time in three years, ending our long national nightmare? Did you know that in June, Boston will host an “extreme sailing” event with huge catamarans that can go faster than the wind?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Day 1: Let the Festivities Begin', 'kicker': 'The Conversation', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Palin, Sarah', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Romney, Mitt', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Republican Party', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Senate', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-01-05T17:39:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By David Brooks and Gail Collins', 'person