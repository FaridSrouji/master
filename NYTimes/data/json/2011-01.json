}, 'keywords': [{'name': 'subject', 'value': 'Playoff Games', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Steelers', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-21T01:37:41+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Greg Bishop', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a280a49b-abc2-5b0d-8506-495ee3fb67e6', 'word_count': 727, 'uri': 'nyt://article/a280a49b-abc2-5b0d-8506-495ee3fb67e6'}, {'abstract': 'Mr. Picerni appeared in more than 60 movies and 450 television shows, but he was best known as Eliot Ness’s right-hand man.', 'web_url': 'https://www.nytimes.com/2011/01/21/arts/television/21picerni.html', 'snippet': 'Mr. Picerni appeared in more than 60 movies and 450 television shows, but he was best known as Eliot Ness’s right-hand man.', 'lead_paragraph': 'Paul Picerni, a prolific television and screen actor best known as Agent Eliot Ness’s right-hand man in the hit 1960s series “The Untouchables,” died on Jan. 12 at his home in Llano, Calif. He was 88.', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/21/opinion/21porciniimg/21porciniimg-jumbo.jpg', 'height': 681, 'width': 561, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/21/opinion/21porciniimg/21porciniimg-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_na