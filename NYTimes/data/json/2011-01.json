683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06book-span/06book-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/06/garden/06book-span/06book-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Selling a Book by Its Cover', 'kicker': 'Design Notebook', 'content_kicker': None, 'print_headline': 'Selling a Book by Its Cover', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-06T00:00:25+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Penelope Green', 'person': [{'firstname': 'Penelope', 'middlename': None, 'lastname': 'Green', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7bc6972d-08fd-58b8-b2bd-4d26c35595b8', 'word_count': 2078, 'uri': 'nyt://article/7bc6972d-08fd-58b8-b2bd-4d26c35595b8'}, {'abstract': 'Total national health spending grew by 4 percent in 2009, the slowest rate of increase in 50 years.', 'web_url': 'https://www.nytimes.com/2011/01/06/health/06health.html', 'snippet': 'Total national health spending grew by 4 percent in 2009, the slowest rate of increase in 50 years.', 'lead_paragraph': 'WASHINGTON \x97 Total national health spending grew by 4 percent in 2009, the slowest rate of increase in 50 years, as people lost their jobs, lost health insurance and deferred medical care, the federal government reported on Wednesday.', 'print_section': 'A', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/us/SUB-HEALTH/SUB-HEALTH-jumbo.jpg', 'height': 763, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/us/SUB-HEALTH/SUB-HEALTH-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/06/us/SUB-HEALTH/SUB-HEALTH-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Health Spending Rose in ’09, but at Low Rate', 'kicker': None, 'content_kicker': None, 'print_headline': 'Health Spending Rose In ’09, but at Low Rate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Consumer Behavior', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Health Insurance and Managed Care', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-06T00:01:26+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Health', 'byline': {'original': 'By Robert Pear', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Pear', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4380ce7f-16e2-507e-b200-4414ec5b18df', 'word_count': 971, 'uri': 'nyt://article/4380ce7f-16e2-507e-b200-4414ec5b18df'}, {'abstract': 'Vin Weber, a former Republican representative and now a prominent Washington lobbyist, talked about the new Republican majority in the House.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2011/01/05/ten-questions-for-vin-weber/', 'snippet': 'Vin Weber, a former Republican representative and now a prominent Washington lobbyist, talked about the new Republican majority in the House.', 'lead_paragraph': 'Vin Weber was in the vanguard of conservative change before some Tea Party activists were born; he won a House seat from Minnesota in the 1980 Republican revolution led by then-President Ronald Reagan. He worked alongside Newt Gingrich in the years-long effort to break the Democrats’ grip on the House. Now a prominent Washington lobbyist, he spoke with John Harwood of The Times and CNBC about the new Republican majority in the House. Here’s a condensed, edited version of their conversation:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Ten Questions for Vin Weber', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Boehner, John A', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weber, Vin', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-06T00:02:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By John Harwood', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Harwood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/9f01eac2-829e-5da9-b8ce-8e42f85d4092', 'word_count': 951, 'uri': 'nyt://article/9f01eac2-829e-5da9-b8ce-8e42f85d4092'}, {'abstract': 'A Beautiful Mess, a new shop in the 1950s-era Whizin Market Square, offers a diverse assortment of objects.', 'web_url': 'https://www.nytimes.com/2011/01/06/garden/06OPEN.html', 'snippet': 'A Beautiful Mess, a new shop in the 1950s-era Whizin Market Square, offers a diverse assortment of objects.', 'lead_paragraph': 'A Beautiful Mess, a new shop in the 1950s-era Whizin Market Square, 10 miles from Malibu, Calif., is an antiques collective. But not a typical one, said Kymberley Fraser, who opened it with six other antiques dealers, all women. A diverse collection of items is mixed to form a cohesive look. There are furnishings created from recycled finds by the Junk Girls; pieces by the designer Marilyn Thompson; primitive American objects from the dealer Karen Chambers; French and American pieces from the designer Victoria Stoehr; American antiques from the dealers Leah Cox and Tina O’Flaherty; and items from Ms. Fraser, like an ottoman ($1,800) and wing chair ($2,600) covered in antique German hemp-linen grain bags, above, and a willow basket ($89), left.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06open-span/06open-span-articleLarge.jpg', 'height': 355, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/06/garden/06open-span/06open-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 355}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06open-span/CURRENTS-B-jumbo.jpg', 'height': 535, 'width': 800, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06open-span/06open-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/06/garden/06open-span/06open-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'An Antiques Collective Opens Outside Malibu', 'kicker': 'Currents | Open', 'content_kicker': None, 'print_headline': 'An Antiques Shop Styled, Not Jumbled', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ANTIQUES', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-06T00:05:26+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Donna Paul', 'person': [{'firstname': 'Donna', 'middlename': None, 'lastname': 'Paul', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/52b75e6b-f799-5099-af8a-7141c9810775', 'word_count': 138, 'uri': 'nyt://article/52b75e6b-f799-5099-af8a-7141c9810775'}, {'abstract': 'A new product from California Faucets’ StyleDrain line was designed to mimic ocean waves.', 'web_url': 'https://www.nytimes.com/2011/01/06/garden/06fixtures.html', 'snippet': 'A new product from California Faucets’ StyleDrain line was designed to mimic ocean waves.', 'lead_paragraph': 'Wave, a shower drain cover from California Faucets’s new StyleDrain line, was created by Christine Miller Kelly, an artist and industrial designer in Palo Alto, Calif. Ms. Kelly, who was a student at California College of the Arts in San Francisco at the time, had two goals: “To mimic the rhythmic pattern that water makes in the ocean” in an abstract design with “a contemporary, geometric line,” she said. And “to make sure that the opening wasn’t so big that someone’s toe gets stuck.”', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06fixtures-span/06fixtures-span-articleLarge.jpg', 'height': 336, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/06/garden/06fixtures-span/06fixtures-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 336}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': Non