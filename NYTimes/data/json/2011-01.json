://article/90f9e018-dfc5-5e6f-a1d0-ba29919582be'}, {'abstract': 'A seemingly innocuous seasonal salutation leaves some people agitated.', 'web_url': 'https://www.nytimes.com/2011/01/07/nyregion/07nyc.html', 'snippet': 'A seemingly innocuous seasonal salutation leaves some people agitated.', 'lead_paragraph': 'You have probably said them or heard them dozens of times this past week, three little words that form the season’s main greeting: Happy New Year. What could be more innocuous?', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Greeting the New Year for Too Long', 'kicker': 'NYC', 'content_kicker': None, 'print_headline': 'Greeting The New Year For Too Long', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Customs, Etiquette and Manners', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'New Year', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-07T01:27:13+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Clyde Haberman', 'person': [{'firstname': 'Clyde', 'middlename': None, 'lastname': 'Haberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7477d6af-d3d4-548a-9089-9b5319d0b7ce', 'word_count': 770, 'uri': 'nyt://article/7477d6af-d3d4-548a-9089-9b5319d0b7ce'}, {'abstract': 'A Florida deep-sea treasure hunting company is using classified cables in its legal battle over who owns $500 million of gold and silver retrieved in 2007 from the wreckage of a Spanish galleon.', 'web_url': 'https://www.nytimes.com/2011/01/07/us/07treasure.html', 'snippet': 'A Florida deep-sea treasure hunting company is using classified cables in its legal battle over who owns $500 million of gold and silver retrieved in 2007 from the wreckage of a Spanish galleon.', 'lead_paragraph': 'ATLANTA — The latest twi