name': 'Sam', 'middlename': None, 'lastname': 'Dolnick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/123d575b-d9ed-5a81-869c-28aa24b31704', 'word_count': 1293, 'uri': 'nyt://article/123d575b-d9ed-5a81-869c-28aa24b31704'}, {'abstract': 'The Fall/Winter 2011 men’s collection from Burberry at Milan Fashion Week.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2011/01/15/now-streaming-burberry/', 'snippet': 'The Fall/Winter 2011 men’s collection from Burberry at Milan Fashion Week.', 'lead_paragraph': 'The Fall/Winter 2011 men’s collection from Burberry at Milan Fashion Week.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Now Screening | Burberry', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-15T15:50:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By T Magazine', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/33e1afbf-53fb-51bf-aeac-4a07cde545df', 'word_count': 16, 'uri': 'nyt://article/33e1afbf-53fb-51bf-aeac-4a07cde545df'}, {'abstract': 'Jokes from TV comedy show monologues.', 'web_url': 'https://www.nytimes.com/2011/01/16/weekinreview/16laugh.html', 'snippet': 'Jokes from TV comedy show monologues.', 'lead_paragraph': 'JAY LENO', 'print_section': 'WK', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Laugh Lines', 'kicker': None, 'content_kicker': None, 'print_headline': 'LAUGH LINES', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-15T16:10:57+0000', 'document_type': 'article', 'news_desk': 'WeekInReview', 'section_name': 'Week in Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1789ba1-311d-5855-9bb1-96b7879f8fd9', 'word_count': 229, 'uri': 'nyt://article/f1789ba1-311d-5855-9bb1-96b7879f8fd9'}, {'abstract': '66: The percentage increase in the individual income tax rate approved in Illinois last week.', 'web_url': 'https://www.nytimes.com/2011/01/16/weekinreview/16primenumber.html', 'snippet': '66: The percentage increase in the individual income tax rate approved in Illinois last week.', 'lead_paragraph': '66: The percentage increase in the individual income tax rate approved by Illinois lawmakers last week. The business tax rate will also rise, by 46 percent. Illinois is facing a deficit of $13 billion and a plummeting bond rating. “Our state was careening towards bankruptcy and fiscal insolvency,” Gov. Patrick J. Quinn said. Neighboring states welcomed the news. Wisconsin promptly issued a call to businesses in Illinois to move north, resurrecting an old slogan, “Escape to Wisconsin.”', 'print_section': 'WK', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Prime Number', 'kicker': None, 'content_kicker': None, 'print_headline': 'PRIME NUMBER', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-15T16:12:56+0000', 'document_type': 'article', 'news_desk': 'WeekInReview', 'section_name': 'Week in Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d69d1c66-6c33-5a34-a7b7-46d609a4433f', 'word_count': 77, 'uri': 'nyt://article/d69d1c66-6c33-5a34-a7b7-46d609a4433f'}, {'abstract': 'A report from the early days of Wikipedia, which turned 10 years old this month.', 'web_url': 'https://www.nytimes.com/2011/01/16/weekinreview/16backthen.html', 'snippet': 'A report from the early days of Wikipedia, which turned 10 years old this month.', 'lead_paragraph': 'Wikipedia, the free online encyclopedia written and updated by thousands of volunteers around the world, turned 10 years old this month. Today, with 3.5 million articles in English, it is the first stop for tens of millions of people looking for information. But its success was uncertain in its early days, as Peter Meyers reported in The Times in September 2001: ', 'print_section': 'WK', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/17/weekinreview/BACKTHEN/BACKTHEN-jumbo.jpg', 'height': 1024, 'width': 1010, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/17/weekinreview/BACKTHEN/BACKTHEN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/17/weekinreview/BACKTHEN/BACKTHEN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Back Then: 2001', 'kicker': None, 'content_kicker': None, 'print_headline': 'BACK THEN: 2001', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-15T16:14:50+0000', 'document_type': 'article', 'news_desk': 'WeekInReview', 'section_name': 'Week in Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/303a3372-b123-5de2-9507-77301eb1520f', 'word_count': 129, 'uri': 'nyt://article/303a3372-b123-5de2-9507-77301eb1520f'}, {'abstract': 'The Himalayan Kingdom of Bhutan banned the sale of tobacco in 2005. Now enforcement is getting serious.', 'web_url': 'https://www.nytimes.com/2011/01/16/weekinreview/16grist.html', 'snippet': 'The Himalayan Kingdom of Bhutan banned the sale of tobacco in 2005. Now enforcement is getting serious.', 'lead_paragraph': ' The Himalayan Kingdom of Bhutan banned the sale of tobacco in 2005 in its drive to become the world’s first smoke-free nation. But the effort has made little headway against smugglers from neighboring India. So now the Buddhist nation is getting tough, according to Reuters. A police dog is being trained to sniff out tobacco, and authorities have been empowered to enter homes in search of illegal cigarettes. Sentences of up to five years await shopkeepers caught selling tobacco and smokers unable to provide customs receipts for imported cigarettes. Smoking in private is not illegal, but smokers may only import 200 cigarettes a month. Widespread grumbling has accompanied the crackdown. “It’s a new year. And I have a New Year’s wish: that the first person to be caught and jailed under the Tobacco Control Act is a member of parliament,” wrote Tshering Tobgay, the opposition leader, on his popular blog. ', 'print_section': 'WK', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'If You Smoke, Don’t Vacation in This Kingdom', 'kicker': 'Grist', 'content_kicker': None, 'print_headline': 'If You Smoke, Don’t Vacation In This Kingdom', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-15T16:18:08+0000', 'document_type': 'article', 'news_desk': 'WeekInReview', 'section_name': 'Week in Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/43af02b9-8ab1-5263-a87f-d224abfce28e', 'word_count': 152, 'uri': 'nyt://article/43af02b9-8ab1-5263-a87f-d224abfce28e'}, {'abstract': 'Workers: still productive.', 'web_url': 'https://krugman.blogs.nytimes.com/2011/01/15/zirp-and-zmp/', 'snippet': 'Workers: still productive.', 'lead_paragraph': 'From my point of view, the current slump is just about what we should have expected given that we had a nasty financial crisis and continue to have a lot of over-leveraged players in the system. Ken Rogoff once said that the United States is having a “garden-variety severe financial crisis” — indeed, anyone who read Reinhart and Rogoff on the aftermath of crises more or less expected a prolonged period of weak employment. And I’ve been warning about a protracted liquidity trap, in which even a zero interest rate policy (ZIRP) isn’t enough to raise demand sufficiently, for more than a decade.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'ZIRP and ZMP', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-15T16:18:37+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/5bbb6abc-8c46-5b4a-a0fb-e242cc87240b', 'word_count': 449, 'uri': 'nyt://article/5bbb6abc-8c46-5b4a-a0fb-e242cc87240b'}, {'abstract': 'Three converts, the first under a new structure created by the Catholic Church, will lead a group preparing for conversion at Easter.', 'web_url': 'https://www.nytimes.com/2011/01/16/world/europe/16vatican.html', 'snippet': 'Three converts, the first under a new structure created by the Catholic Church, will lead a group preparing for conversion at Easter.', 'lead_paragraph': 'ROME \x97 The Vatican on Saturday welcomed the first group of traditionalist Anglicans who plan to convert to Roman Catholicism through a new structure the Vatican created to facilitate such group conversions.', 'print_section': 'A', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Vatican Welcomes First Anglicans Converting Under New Rules', 'kicker': None, 'content_kicker': None, 'print_headline': 'Vatican Welcomes First Anglicans Converting Under New Rules', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'n