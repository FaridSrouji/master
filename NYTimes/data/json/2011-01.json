seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Genzyme Corp', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sanofi-Aventis S.A', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-08T01:36:01+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/74db6375-908b-53bd-bec7-1975b6cb5fe7', 'word_count': 275, 'uri': 'nyt://article/74db6375-908b-53bd-bec7-1975b6cb5fe7'}, {'abstract': 'Joe McKnight’s rookie season with the Jets has not gone the way he thought, but he is slowly learning his role on the team.', 'web_url': 'https://www.nytimes.com/2011/01/09/sports/football/09mcknight.html', 'snippet': 'Joe McKnight’s rookie season with the Jets has not gone the way he thought, but he is slowly learning his role on the team.', 'lead_paragraph': 'FLORHAM PARK, N.J. \x97 Joe McKnight, the Jets’ rookie running back, got to pack his equipment into a green duffel bag for the team’s trip to Indianapolis on Friday, and he seemed to be perfectly fine not knowing how much he will get to play against the Colts on Saturday night.', 'print_section': 'SP', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/09/sports/Y-MCKNIGHT1/Y-MCKNIGHT1-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/09/sports/Y-MCKNIGHT1/Y-MCKNIGHT1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/09/sports/Y-MCKNIGHT1/Y-MCKNIGHT1-jumbo.jpg', 