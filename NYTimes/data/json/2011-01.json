': [{'name': 'subject', 'value': 'Defective Products', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Defibrillators', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Decisions and Verdicts', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Scientific Corporation', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-14T01:25:19+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Bloomberg News', 'person': [{'firstname': 'Bloomberg', 'middlename': None, 'lastname': 'News', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fa2b2ef7-401f-58c3-83c4-299d30d720d1', 'word_count': 260, 'uri': 'nyt://article/fa2b2ef7-401f-58c3-83c4-299d30d720d1'}, {'abstract': 'Sophia Chinemerem Eze went from an elite honors program at Brooklyn College to a psychiatric ward after complaining to college security about her roommates.', 'web_url': 'https://www.nytimes.com/2011/01/14/nyregion/14camera.html', 'snippet': 'Sophia Chinemerem Eze went from an elite honors program at Brooklyn College to a psychiatric ward after complaining to college security about her roommates.', 'lead_paragraph': 'She had come to New York from Nigeria after being admitted to the City University of New York’s most elite honors program, which gives students full tuition, a laptop and a $7,500 stipend.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Former Student Sues College Over Stay in a Mental Ward', 'kicker': None, 'content_kicker': None, 'print_headline': 'Former Student Sues College Over Stay in a Mental Ward', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Suits and Litigation', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Brooklyn College, City University of New York', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-14T01:29:08+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Lisa W. Foderaro', 'person': [{'firstname': 'Lisa', 'middlename': 'W.', 'lastname': 'Foderaro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/82effcc5-f833-5404-a993-9423fcbfe048', 'word_count': 768, 'uri': 'nyt://article/82effcc5-f833-5404-a993-9423fcbfe048'}, {'abstract': 'Let’s raise the bar for New York City taxi design.', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/01/13/all-tomorrows-taxis/', 'snippet': 'Let’s raise the bar for New York City taxi design.', 'lead_paragraph': 'Sometime early this year, New York City’s taxi and limousine commission will announce the winner of its “Taxi of Tomorrow” competition. Or it won’t. The project was begun in 2007, and in December 2009 a “request for proposals” went out to automotive manufacturers and designers. The bar wasn’t set all that high: the Taxi of Tomorrow was meant to be “safe, fuel-efficient, accessible, durable, and comfortable.” A look at the three finalists announced in November 2010 confirms they are perhaps all of those things. They are also, well, dull. Boxy. Lacking in imagination. (Not that New York’s current cab, the Ford Crown Victoria, was one to inspire much.)', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'All Tomorrow’s Taxis', 'kicker': 'Allison Arieff', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Environment', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Taxicabs and Taxicab Drivers', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-14T01:30:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Allison Arieff', 'person': [{'firstname': 'Allison', 'middlename': None, 'lastname': 'Arieff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/83887de7-88c0-568a-a2e8-e33f4654737c', 'word_count': 604, 'uri': 'nyt://article/83887de7-88c0-568a-a2e8-e33f4654737c'}, {'abstract': 'Though President Obama spoke to our desire for reconciliation, the truth is that we are a deeply divided nation and are likely to remain so.', 'web_url': 'https://www.nytimes.com/2011/01/14/opinion/14krugman.html', 'snippet': 'Though President Obama spoke to our desire for reconciliation, the truth is that we are a deeply divided nation and are likely to remain so.', 'lead_paragraph': 'On Wednesday, President Obama called on Americans to “expand our moral imaginations, to listen to each other more carefully, to sharpen our instincts for empathy, and remind ourselves of all the ways our hopes and dreams are bound together.” Those were beautiful words; they spoke to our desire for reconciliation. ', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'height': 300, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 300}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/04/02/opinion/paul-krugman/paul-krugman-jumbo.png', 'height': 512, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'ur