'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/6d99f066-db1f-578e-863c-0091aa050438', 'word_count': 825, 'uri': 'nyt://article/6d99f066-db1f-578e-863c-0091aa050438'}, {'abstract': 'Duane Clarridge, who was indicted for lying to Congress about his role in the Iran-Contra scandal, doesn’t seem to have learned any lessons.', 'web_url': 'https://www.nytimes.com/2011/01/25/opinion/25tue3.html', 'snippet': 'Duane Clarridge, who was indicted for lying to Congress about his role in the Iran-Contra scandal, doesn’t seem to have learned any lessons.', 'lead_paragraph': 'Duane Clarridge burst onto the public stage in the mid-1980s for his role in the Iran-Contra scandal. The scheme involved selling weapons to Iran and using the proceeds to fund rebels trying to overthrow the Nicaraguan government. A career officer in the Central Intelligence Agency, Mr. Clarridge, known to virtually everyone as Dewey, was indicted for lying to Congress about the operation but was pardoned by President George H.W. Bush before his trial was finished.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'He Never Left', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'He Never Left', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clarridge, Duane R', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Espionage', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Central Intelligence Agency', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-25T03:53:22+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Editorial', '_id': 'nyt://ar