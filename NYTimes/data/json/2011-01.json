, 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-15T17:00:43+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/788f2d1a-5664-5501-87d9-30fdb7fb1a77', 'word_count': 227, 'uri': 'nyt://article/788f2d1a-5664-5501-87d9-30fdb7fb1a77'}, {'abstract': 'If any improper acts take place during games, the N.F.L. will take comments from the past week into account when determining disciplinary action.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/01/15/teams-warned-to-keep-trash-talk-off-the-field/', 'snippet': 'If any improper acts take place during games, the N.F.L. will take comments from the past week into account when determining disciplinary action.', 'lead_paragraph': 'Think the recent trash-talking between the Jets and the Patriots was all good fun? ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Teams Warned to Keep Trash Talk Off the Field', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Football League', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New England Patriots', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-15T17:01:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_materia