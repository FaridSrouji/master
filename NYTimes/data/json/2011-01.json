'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/be8a0e76-3466-5898-bd8b-f5e0606f59c5', 'word_count': 419, 'uri': 'nyt://article/be8a0e76-3466-5898-bd8b-f5e0606f59c5'}, {'abstract': 'A rush to match the fund-raising muscle of private schools has put public colleges in an awkward stance: expanding development staffs while cutting from academic programs.', 'web_url': 'https://www.nytimes.com/2011/01/16/education/16college.html', 'snippet': 'A rush to match the fund-raising muscle of private schools has put public colleges in an awkward stance: expanding development staffs while cutting from academic programs.', 'lead_paragraph': 'As state legislatures cut back support for higher education, public colleges and universities across the country are turning to their alumni, hat in hand, as never before — hiring consultants, hunting down graduates and mobilizing student phone banks to raise private money in amounts they once thought impossible.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Amid Cuts, Public Colleges Step Up Appeals to Alumni', 'kicker': None, 'content_kicker': None, 'print_headline': 'Amid Cuts, Public Colleges Step Up Appeals to Alumni', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Budgets and Budgeting', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Finances', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Colleges and Universities', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Philanthropy', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-16T03:02:27+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'Education', 'byline': {'original': 'By Lisa W. Foderaro', 'person': [{'firstname': 'Lisa', 'middlename': 'W.', 'lastname': 'Foderaro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/80ca7c79-558a-5e45-9668-5877aea5c4b1', 'word_count': 1306, 'uri': 'nyt://article/80ca7c79-558a-5e45-9668-5877aea5c4b1'}, {'abstract': 'Mrs. Gibson narrated more than 1,100 books, including “Middlemarch” (31 hours, 7 minutes) and “Anna Karenina” (36 hours, 7 minutes).', 'web_url': 'https://www.nytimes.com/2011/01/16/arts/16gibson.html', 'snippet': 'Mrs. Gibson narrated more than 1,100 books, including “Middlemarch” (31 hours, 7 minutes) and “Anna Karenina” (36 hours, 7 minutes).', 'lead_paragraph': 'Flo Gibson, who for decades read soothingly to Americans as they toiled at the gym, behind the wheel or over housework, died on Jan. 7 at her home in Washington. Mrs. Gibson, the universally acknowledged grande dame of audiobooks, was 86.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/16/16gibsonimg/16gibsonimg-jumbo.jpg', 'height': 1024, 'width': 686, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/16/16gibsonimg/16gibsonimg-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/16/16gibsonimg/16gibsonimg-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Flo Gibson, Grande Dame of Audiobooks, Dies at 86', 'kicker': None, 'content_kicker': None, 'print_headline': 'Flo Gibson, Grande Dame of Audiobooks, Dies at 86', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recordings and Downloads (Audio)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Audiobooks', 'rank'