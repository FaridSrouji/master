icle/fc80bb05-8db7-57eb-95f0-321400646344'}, {'abstract': 'Representative Gabrielle Giffords’s treatment began in the parking lot where she was shot, and will continue for months, even years.', 'web_url': 'https://www.nytimes.com/2011/01/10/health/10medical.html', 'snippet': 'Representative Gabrielle Giffords’s treatment began in the parking lot where she was shot, and will continue for months, even years.', 'lead_paragraph': 'WASHINGTON \x97 The bullet that a gunman fired into Representative Gabrielle Giffords’s head on Saturday morning in Arizona went straight through the left side of her brain, entering the back of her skull and exiting the front.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/10/us/MEDICAL/MEDICAL-jumbo.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/10/us/MEDICAL/MEDICAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/10/us/MEDICAL/MEDICAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Treating an Injured Brain Is a Long, Uncertain Process', 'kicker': None, 'content_kicker': None, 'print_headline': 'Treating an Injured Brain Is a Long, Uncertain Process', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Brain', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Giffords, Gabrielle', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'University Medical Center', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Tucson (Ariz)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value':