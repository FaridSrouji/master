e': 'Middle East', 'byline': {'original': 'By Ethan Bronner', 'person': [{'firstname': 'Ethan', 'middlename': None, 'lastname': 'Bronner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c1d977de-8d22-582e-aa3e-11992f9531ee', 'word_count': 365, 'uri': 'nyt://article/c1d977de-8d22-582e-aa3e-11992f9531ee'}, {'abstract': 'Why we need more members in the lower chamber of Congress.', 'web_url': 'https://www.nytimes.com/2011/01/24/opinion/24conley.html', 'snippet': 'Why we need more members in the lower chamber of Congress.', 'lead_paragraph': 'WITH the Senate preparing to debate filibuster reform, now is a good time to consider a similarly daunting challenge to democratic representation in the House: its size. It’s been far too long since the House expanded to keep up with population growth and, as a result, it has lost touch with the public and been overtaken by special interests.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/24/opinion/24oped_art/24oped_art-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/24/opinion/24oped_art/24oped_art-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/24/opinion/24oped_art/24oped_art-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Build a Bigger House', 'kicker': 'Op-Ed Contributors', 'content_kicker': None, 'print_headline': 'Build a Bigger House', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Redistricting and Reapportionment', 'rank': 1, 'major': 'N'