/25FUEL-jumbo.jpg', 'height': 655, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/business/25FUEL/25FUEL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/25/business/25FUEL/25FUEL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Alternative Fuels Don’t Benefit the Military, a RAND Report Says', 'kicker': None, 'content_kicker': None, 'print_headline': 'Alternative Fuels Don’t Benefit the Military, a RAND Report Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Rand Corp', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Alternative and Renewable Energy', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-25T05:16:16+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Energy & Environment ', 'byline': {'original': 'By Tom Zeller Jr', 'person': [{'firstname': 'Tom', 'middlename': None, 'lastname': 'Zeller', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/09dc249a-b537-51d9-a2d6-a37b891b55e2', 'word_count': 1067, 'uri': 'nyt://article/09dc249a-b537-51d9-a2d6-a37b891b55e2'}, {'abstract': 'In tracing and chasing obscure jazz records from the field’s earliest days, Mr. Rust set the standard for all of modern discography.', 'web_url': 'https://www.nytimes.com/2011/01/25/arts/music/25rust.html', 'snippet': 'In tracing and chasing obscure jazz records from the field’s earliest days, Mr. Rust set the standard for all of modern discography.', 'lead_paragraph': 'Brian Rust, a discographic detecti