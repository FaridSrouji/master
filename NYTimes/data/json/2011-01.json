12b-59cd-5281-9fb7-11d7d60d230a', 'word_count': 0, 'uri': 'nyt://slideshow/46ecc12b-59cd-5281-9fb7-11d7d60d230a'}, {'abstract': 'Siddha Yoga masters from Japan and India will offer a series of teachings in New York this month.', 'web_url': 'https://cityroom.blogs.nytimes.com/2011/01/03/2-yoga-masters-to-lead-new-york-workshops/', 'snippet': 'Siddha Yoga masters from Japan and India will offer a series of teachings in New York this month.', 'lead_paragraph': 'For two yoga masters trained in the Himalayas, the path toward world peace leads straight through New York.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '2 Yoga Masters to Lead New York Workshops', 'kicker': 'City Room', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-03T18:40:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By Shane Dixon Kavanaugh', 'person': [{'firstname': 'Shane', 'middlename': 'Dixon', 'lastname': 'Kavanaugh', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/d94f34c8-733d-5fea-918d-02b1bfc02e6c', 'word_count': 481, 'uri': 'nyt://article/d94f34c8-733d-5fea-918d-02b1bfc02e6c'}, {'abstract': 'Experts keep telling us to eat more fish \x97 but who can afford it? This week’s recipes provide a solution to the problem by combining seafood with pasta. Today: pasta with beet greens and tuna.', 'web_url': 'https://www.nytimes.com/2011/01/03/health/nutrition/03recipehealth.html', 'snippet': 'Experts keep telling us to eat more fish \x97 but who can afford it? This week’s recipes provide a solution to the problem by combining seafood with pasta. Today: pasta with beet greens and tuna.', 'lead_paragraph': 'While researching the cooking of Sicily some years ago, I spent an afternoon with a chef who had a small restaurant in Palermo, where I watched him take a single piece of tuna and turn it into a pasta sauce that fed four of us. Mediterranean cooks, I knew, have a knack for making meals from small amounts of animal protein. Italians often accomplish this by combining pasta and seafood. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/03/health/03HEALTHYRECIPE/03HEALTHYRECIPE-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/03/health/03HEALTHYRECIPE/03HEALTHYRECIPE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/03/health/03HEALTHYRECIPE/03HEALTHYRECIPE-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/03/health/03HEALTHYRECIPE/03HEALTHYRECIPE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/03/health/03HEALTHYRECIPE/03HEALTHYRECIPE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'For Seafood on a Budget, Just Add Pasta', 'kicker': 'Recipes For Health', 'content_kicker': None, 'print_headline': 'For Seafood on a Budget, Just Add Pasta', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Recipes', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pasta', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-03T18:52:13+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'subsection_name': 'Fitness & Nutrition', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fbb8b06c-0bbb-519c-8869-14a62e415b9a', 'word_count': 671, 'uri': 'nyt://article/fbb8b06c-0bbb-519c-8869-14a62e415b9a'}, {'abstract': 'In the Times’s Oscar issue, the movie critics single out Natalie Portman, Christian Bale and Colin Firth for praise.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2011/01/03/oscar-worthy-performances-for-your-consideration/', 'snippet': 'In the Times’s Oscar issue, the movie critics single out Natalie Portman, Christian Bale and Colin Firth for praise.', 'lead_paragraph': 'Rounding out the Bagger’s day of “things you may have missed in The New York Times” – give us a break, we’re probably suffering from social jet lag – is the awards season best-ofs from our colleagues. A. O. Scott praises Natalie Portman in “Black Swan,” for “participating in the invention of a new kind of screen performance.” As Nina, the unraveling ballerina, she inverts Method acting to tell a story about the artistic interplay of “instinct and technique” – which is, at its heart, what the movie is about. Manohla Dargis writes that in one minute of screen time, Christian Bale summons his character’s entire life in “The Fighter.” Stephen Holden calls Colin Firth’s performance as a stammering monarch in “The King’s Speech” “a tour de force of body language concentrated on the eyes and mouth.” And Larry Rohter takes stock of the humbleness of Javier Bardem in “Biutiful.” There’s all that and more, including the critics’ lists of those they think should be nominated. Worth catching up while we recover/wrangle some outside material. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Oscar-Worthy Performances, for Your Consideration', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bale, Christian', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bardem, Javier', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Firth, Colin', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Portman, Natalie', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-03T18:52:26+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/49448746-f8a4-5684-9627-fd478e230e02', 'word_count': 177, 'uri': 'nyt://article/49448746-f8a4-5684-9627-fd478e230e02'}, {'abstract': 'A panel the Supreme Court set up said it would issue rulings within two weeks on complaints of election abuse in September’s vote.', 'web_url': 'https://www.nytimes.com/2011/01/04/world/asia/04kabul.html', 'snippet': 'A panel the Supreme Court set up said it would issue rulings within two weeks on complaints of election abuse in September’s vote.', 'lead_paragraph': 'KABUL, Afghanistan \x97 A five-judge panel set up last week by Afghanistan’s Supreme Court said Monday that it would issue rulings within two weeks on hundreds of complaints of election abuse in September’s national vote, in time for President Hamid Karzai to keep his promise to seat a new Parliament by Jan. 20.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/04/world/04kabulspan-cnd/04kabulspan-cnd-jumbo.jpg', 'height': 729, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption'