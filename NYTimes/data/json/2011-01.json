ype': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/26/business/Verizon/Verizon-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Verizon’s Earnings Fall Short of Expectations, but Growth in Wireless Users Is Strong', 'kicker': None, 'content_kicker': None, 'print_headline': 'Verizon’s Earnings Fall Short of Expectations, but Growth in Wireless Users Is Strong', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Verizon Communications Inc', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Company Reports', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-25T13:08:59+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'byline': {'original': 'By Jenna Wortham', 'person': [{'firstname': 'Jenna', 'middlename': None, 'lastname': 'Wortham', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a5a30d2d-a90a-5f64-82d5-5bf4dc65bfab', 'word_count': 712, 'uri': 'nyt://article/a5a30d2d-a90a-5f64-82d5-5bf4dc65bfab'}, {'abstract': 'Scientists are pursuing ideas about how a drastic decline of sea ice in the Arctic might be playing a role in a pattern of frigid temperatures, snow and ice at points south.', 'web_url': 'https://green.blogs.nytimes.com/2011/01/25/frigid-winters-and-the-polar-vortex/', 'snippet': 'Scientists are pursuing ideas about how a drastic decline of sea ice in the Arctic might be playing a role in a pattern of frigid temperatures, snow and ice at points south.', 'lead_paragraph': 'In Tuesday’s paper, I write about the weakening of the polar vortex that keeps cold air penned up in the Arctic, a change that has contributed to two bitter winters in a row in Europe and the United States. In the piece, I mentioned that several scientists were pursuing ideas about how the drastic decline of sea ice in the Arctic might be playing a role in this pattern.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Frigid Winters and the Polar Vortex', 'kicker': 'Green', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Global Warming', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Ice', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Weather', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'ARCTIC REGIONS', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-01-25T13:12:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Science', 'subsection_name': 'Environment', 'byline': {'original': 'By Justin Gillis', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Gillis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/02f3bc67-f180-50e2-a242-27e712439dba', 'word_count': 256, 'uri': 'nyt://article/02f3bc67-f180-50e2-a242-27e712439dba'}, {'abstract': 'I spotted two examples in one day of a hypercorrective “whom” — that is, “whom” used mistakenly in a relative clause where good old “who” was called for. Sometimes writers or editors, wary of using a colloquial “who” when formal writing demands “whom,” err in the other direction.', 'web_url': 'https://topics.blogs.nytimes.com/2011/01/25/too-many-whoms/', 'snippet': 'I spotted two examples in one day of a hypercorrective “whom” — that is, “whom” used mistakenly in a relative clause where good old “who” was called for. Sometimes writers or editors, wary of using a colloquial “who” when formal writing demands “w...', 'lead_paragraph': 'Notes from the newsroom on grammar, usage and style. (Some frequently asked questions are here.)', 'so