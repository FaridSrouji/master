 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/08/us/SUB-JP-DALEY/SUB-JP-DALEY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/08/us/SUB-JP-DALEY/SUB-JP-DALEY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/08/us/SUB-JP-DALEY/SUB-JP-DALEY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Obama’s Top Aide a Tough, Decisive Negotiator', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obama’s Top Aide a Tough, Decisive Negotiator', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Daley, William M', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-08T02:43:53+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Sheryl Gay Stolberg', 'person': [{'firstname': 'Sheryl', 'middlename': 'Gay', 'lastname': 'Stolberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6cea1365-ad38-5bc3-baff-fdbf7d30171d', 'word_count': 1261, 'uri': 'nyt://article/6cea1365-ad38-5bc3-baff-fdbf7d30171d'}, {'abstract': 'Pockets of greenery are the latest battleground in the dispute between residents and a university that says it needs to grow.', 'web_url': 'https://www.nytimes.com/2011/01/08/nyregion/08metjournal.html', 'snippet': 'Pockets of greenery are the latest battleground in the dispute between residents and a university that says it needs to grow.', 'lead_paragraph': 'All together, the seven strips of greenery hardly seem substantial enough to amount to a park. Someone unfamiliar with Greenwich Village might pass them by as ornamental to their adjoining buildings, like extra-wide hedges. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/08/nyregion/METJOURNAL/METJOURNAL-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/08/nyregion/METJOURNAL/METJOURNAL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/08/nyregion/METJOURNAL/METJOURNAL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Just 7 Strips of Green, or a Park Worth Fighting For?', 'kicker': 'Greenwich Village Journal', 'content_kicker': None, 'print_headline': '7 Strips of Green, Or a Park Worth Fighting For?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Parks and Other Recreation Areas', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York University', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Greenwich Village (NYC)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-08T02:44:32+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joseph Berger', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'Berger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/90f1e87f-7b7b-5036-93df