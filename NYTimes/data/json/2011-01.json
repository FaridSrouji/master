1, 'major': 'N'}, {'name': 'subject', 'value': 'Housing and Real Estate', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-07T22:06:13+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Marcelle S. Fischler', 'person': [{'firstname': 'Marcelle', 'middlename': 'S.', 'lastname': 'Fischler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d70e3a15-f7ef-563f-9ce3-087ea183801a', 'word_count': 786, 'uri': 'nyt://article/d70e3a15-f7ef-563f-9ce3-087ea183801a'}, {'abstract': 'For marketing genius, you cannot beat two companies competing in the market for electronic cigarettes.', 'web_url': 'https://gadgetwise.blogs.nytimes.com/2011/01/07/electronic-cigarettes-yes/', 'snippet': 'For marketing genius, you cannot beat two companies competing in the market for electronic cigarettes.', 'lead_paragraph': 'LAS VEGAS — The Consumer Electronics Show is big. Even if you have a great product, you have to come up with a way to stand out from the crowd. Standard approaches include: building the biggest booth, providing your female employees with the least amount of clothing and serving the freest lunch.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Electronic Cigarettes? Yes!', 'kicker': 'Gadgetwise', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'International Consumer Electronics Show', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-07T22:06:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Joshua Brustein', 'person': [{'firstname': 'Joshua', 'middlename': None, 'lastname': 'Brustein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/f370b32c-8736-54c1-8870-d12d85cccccc', 'word_count': 157, 'uri': 'nyt://article/f370b32c-8736-54c1-8870-d12d85cccccc'}, {'abstract': 'Many of the problems Rudy Giuliani encountered in his failed 2008 bid for the Republican nomination would still be in his way in 2012 — and then some.', 'web_url': 'https://fivethirtyeight.blogs.nytimes.com/2011/01/07/if-giuliani-is-back-it-wont-be-by-popular-demand/', 'snippet': 'Many of the problems Rudy Giuliani encountered in his failed 2008 bid for the Republican nomination would still be in his way in 2012 — and then some.', 'lead_paragraph': 'Let’s not indulge in any equivocation: Mayor Rudy Giuliani’s 2008 presidential campaign was a flop. Though he was an early front-runner in national surveys of potential Republican primary voters, Mr. Giuliani placed a distant sixth in the Iowa caucus, fourth in the New Hampshire primary, sixth again in both Michigan and South Carolina and then, finally, a distant third in Florida, a state where he had allocated much of his resources. Mr. Giuliani then dropped out of the race and endorsed John McCain.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'If Giuliani Is Back, It Won’t Be By Popular Demand', 'kicker': 'FiveThirtyEight', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-07T22:07:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Nate Silver', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Silver', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/9565c4bd-f42b-5449-ba08-a4c2bb3b1e57', 'word_count': 965, 'uri': 'nyt://article/9565c4bd-f42b-5449-ba08-a4c2bb3b1e57'}, {'abstract': 'About two weeks ago a major snowstorm caught New York off guard. On Friday, the city was ready, but the weather didn’t measure up.', 'web_url': 'https://www.nytimes.com/2011/01/08/nyregion/08snow.html', 'snippet': 'About two weeks ago a major snowstorm caught New York off guard. On Friday, the city was ready, but the weather didn’t measure up.', 'lead_paragraph': 'Snowmageddon Two it was not.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/08/nyregion/SNOW/SNOW-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/08/nyregion/SNOW/SNOW-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/08/nyregion/SNOW/SNOW-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/08/nyregion/SNOW/SNOW-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/08/nyregion/SNOW/SNOW-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Snowstorm That Wasn’t Finds City Well Prepared', 'kicker': None, 'content_kicker': None, 'print_headline': 'Snowstorm That Wasn’t Finds a City Well Prepared', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bloomberg, Michael R', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Snow and Snowstorms', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}], 'pub_date': 