_material': 'News', '_id': 'nyt://article/7abaab5a-acf0-51ef-b8f0-22abbe2e3812', 'word_count': 795, 'uri': 'nyt://article/7abaab5a-acf0-51ef-b8f0-22abbe2e3812'}, {'abstract': 'Running back Michael Turner is a key element in the Falcons’ offense.', 'web_url': 'https://www.nytimes.com/2011/01/15/sports/football/15turner.html', 'snippet': 'Running back Michael Turner is a key element in the Falcons’ offense.', 'lead_paragraph': 'FLOWERY BRANCH, Ga. \x97 The contents of the Atlanta Falcons’ game plan against the Green Bay Packers do not have to be complicated. It should really be a simple procedure: hand the ball to running back Michael Turner, spring him to the second level of the defense against one-on-one tacklers, and enjoy the bounty.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/15/sports/15turner-web1/15turner-web1-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/15/sports/15turner-web1/15turner-web1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/15/sports/15turner-web1/15turner-web1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'As Turner Soars So Do the Falcons', 'kicker': None, 'content_kicker': None, 'print_headline': 'As Turner Soars So Do the Falcons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'National Football League', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Atlanta Falcons', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Turner, Michael', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-14T16:06:00+000