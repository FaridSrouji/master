s/y-fast-1/y-fast-1-jumbo.jpg', 'height': 645, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/sports/y-fast-1/y-fast-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/25/sports/y-fast-1/y-fast-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Steelers and Packers: Flawed but Super', 'kicker': 'N.F.L. Fast Forward', 'content_kicker': None, 'print_headline': 'Two Wins Reflect Up-and-Down Seasons', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Pittsburgh Steelers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-24T16:54:08+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Judy Battista', 'person': [{'firstname': 'Judy', 'middlename': None, 'lastname': 'Battista', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a0447cac-f6f6-5a00-b89c-79022f7b7c2d', 'word_count': 825, 'uri': 'nyt://article/a0447cac-f6f6-5a00-b89c-79022f7b7c2d'}, {'abstract': 'Chicago will take a long time to shake the image of quarterback Jay Cutler leaving the N.F.C. title game with a knee injury but not looking hurt.', 'web_url': 'https://www.nytimes.com/2011/01/25/sports/football/25leading.html', 'snippet': 'Chicago will take a long time to shake the image of quarterback Jay Cutler leaving the N.F.C. title game with a knee injury but not looking hurt.', 'lead_paragraph': 'If ever there was an advertisement for the value of a good public image, Bears quarterback Jay Cutler is it. You could design an entire college public relations course about what happened to Cutler on Sunday: leaving Sunday’s N.F.C. championship game with a knee injury, Cutler did not appear hurt at all. He walked along the sideline. He put on that oversize football overcoat, stood there and looked bored. He never limped. Trainers were not fussing over him. He wasn’t offering advice to his replacements or cheering his defense. The back story was Cutler having spent his five N.F.L. seasons crafting his image as aloof, arrogant, indifferent to the world outside his own skull. The result on Sunday: instant vilification.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/sports/25leading1/25leading1-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/sports/25leading1/25leading1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/25/sports/25leading1/25leading1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Criticizing Cutler', 'kicker': 'Leading Off', 'content_kicker': None, 'print_headline': 'Questioning Cutler’s Toughness', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rodgers, Aaron', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Urlacher, Brian', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Roethlisberger, Ben', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Peppers, Julius', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 