inic on Lancaster Avenue. ', 'print_section': 'A', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/22/us/23doctor-span/23doctor-span-articleLarge.jpg', 'height': 364, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/22/us/23doctor-span/23doctor-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 364}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/22/us/23doctor-span/DOCTOR-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/22/us/23doctor-span/23doctor-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/22/us/23doctor-span/23doctor-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Squalid Abortion Clinic Escaped State Oversight', 'kicker': None, 'content_kicker': None, 'print_headline': 'Squalid Abortion Clinic Escaped State Oversight', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Women and Girls', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Malpractice', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ABORTION', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gosnell, Kermit', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-01-22T22:39:02+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original'