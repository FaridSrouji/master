thumbnailheight': 75}}], 'headline': {'main': 'A Sconce Made of Twisted Vines', 'kicker': 'Currents | Lighting', 'content_kicker': None, 'print_headline': 'Twisted Vines That Almost Make Themselves Into Sculpture', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Lighting', 'rank': 1, 'major': 'N'}], 'pub_date': '2011-01-06T00:05:27+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d1f036b-87cc-561f-a1c1-838c120a785b', 'word_count': 127, 'uri': 'nyt://article/9d1f036b-87cc-561f-a1c1-838c120a785b'}, {'abstract': 'The designers Georgia Tapert Howe and Caroline Cummings Rafferty looked for pieces that can do double duty in small apartments.', 'web_url': 'https://www.nytimes.com/2011/01/06/garden/06shop.html', 'snippet': 'The designers Georgia Tapert Howe and Caroline Cummings Rafferty looked for pieces that can do double duty in small apartments.', 'lead_paragraph': 'FOR those who have vowed to put their homes in order in 2011, Georgia Tapert Howe and Caroline Cummings Rafferty may be just the ticket. In 2008 these two longtime friends founded Carolina George, a line of furniture in which most of the pieces serve more than one purpose.', 'print_section': 'D', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06shop-span/06shop-span-articleLarge.jpg', 'height': 343, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/06/garden/06shop-span/06shop-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 343}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06shop-span/SHOP-jumbo.jpg', 'height': 865, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06shop-span/06shop-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/06/garden/06shop-span/06shop-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Multifunctional Furniture', 'kicker': 'Shopping With the Carolina George Designers', 'content_kicker': None, 'print_headline': 'Earning Their Space', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shopping and Retail', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Furniture', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Interior Design and Furnishings', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-06T00:05:27+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Rima Suqi', 'person': [{'firstname': 'Rima', 'middlename': None, 'lastname': 'Suqi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/e400d36b-c6d8-5ea2-80f7-f5edc80c6b30', 'word_count': 419, 'uri': 'nyt://article/e400d36b-c6d8-5ea2-80f7-f5edc80c6b30'}, {'abstract': 'Bjarke Ingels, who has designed mountain-like structures in Copenhagen, is working on a project for the Durst Organization in New York.', 'web_url': 'https://www.nytimes.com/2011/01/06/garden/06qna.html', 'snippet': 'Bjarke Ingels, who has designed mountain-like structures in Copenhagen, is working on a project for the Durst Organization in New York.', 'lead_paragraph': 'Bjarke Ingels, a 36-year-old Danish architect, completed the striking 8 House (below) in Copenhagen late last year. A sustainable, mixed-use project of more than 650,000 square feet, with nearly 500 apartments — the largest private development ever built in Denmark — it is shaped, literally, like a figure eight. Among its more unusual features is a looping public pathway (also in the shape of an eight) that reaches from the street to the 10th floor.', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06qa1/QA-1-jumbo.jpg', 'height': 1024, 'width': 733, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06qa1/06qa1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/06/garden/06qa1/06qa1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Danish Architect Brings His Mountain-Making Ideas to New York', 'kicker': 'Currents | Q&A', 'content_kicker': None, 'print_headline': 'A Danish Architect Brings His Mountain-Making Ideas to New York', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ARCHITECTURE', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Durst Organization', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-06T00:05:27+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Sally McGrane', 'person': [{'firstname': 'Sally', 'middlename': None, 'lastname': 'McGrane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/e9fbdbca-0144-527b-933c-8d7367895fdc', 'word_count': 864, 'uri': 'nyt://article/e9fbdbca-0144-527b-933c-8d7367895fdc'}, {'abstract': 'Anisha Ghosh of Saffron Marigold makes cotton bedspreads, curtains, table linens and shower curtains in bright colors inspired by her native India.', 'web_url': 'https://www.nytimes.com/2011/01/06/garden/06goods.html', 'snippet': 'Anisha Ghosh of Saffron Marigold makes cotton bedspreads, curtains, table linens and shower curtains in bright colors inspired by her native India.', 'lead_paragraph': 'Some of Anisha Ghosh’s customers are drawn to her linens because the prints remind them of college, when practically every bed was covered with an Indian bedspread. But those bedspreads were often mass-produced prints in drab colors — nothing like the designs for cotton bedspreads, curtains, table linens and shower curtains created by Saffron Marigold, Ms. Ghosh’s company. Some of the prints (like Spice Route, left) are an interpretation of traditional patterns from her native India, while others (like Lavender Dreams, sprigs on a cream background) are purely her own.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06decor-span/06decor-span-articleLarge.jpg', 'height': 363, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/06/garden/06decor-span/06decor-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 363}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06decor-span/CURRENTS-D-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/06/garden/06decor-span/06decor-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail'