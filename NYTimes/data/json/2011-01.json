id', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/7494eb12-e404-507f-9dc5-c57b0a0973f0', 'word_count': 302, 'uri': 'nyt://article/7494eb12-e404-507f-9dc5-c57b0a0973f0'}, {'abstract': 'The union files an unfair labor practice charge.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2011/01/11/dancers-union-objects-to-city-ballets-plan-for-touring-troupe/', 'snippet': 'The union files an unfair labor practice charge.', 'lead_paragraph': '4:20 p.m. | Updated The dancers union has moved to block efforts by New York City Ballet to establish a smaller touring ensemble, saying it violates their labor contract. The union, the American Guild of Musical Artists, said that\xa0City Ballet\xa0was required to ask its permission if it wanted to tour with anything less than the entire company. City Ballet failed to ask permission, the guild said.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dancers Union Objects to City Ballet’s Plan for Touring Troupe', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Martins, Peter', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'AMERICAN GUILD OF MUSICAL ARTISTS', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-11T18:35:45+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Daniel J. Wakin', 'person': [{'firstname': 'Daniel', 'middlename': 'J.', 'lastname': 'Wakin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/bca150f7-41a6-5370-b7a0-257a1f03d13c', 'word_count': 285, 'uri': 'nyt://article/bca150f7-41a6-5370-b7a0-257a1f03d13c'}, {'abs