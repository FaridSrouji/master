iar. ', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/13/us/SURVIVORS-1/SURVIVORS-1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/13/us/SURVIVORS-1/SURVIVORS-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/13/us/SURVIVORS-1/SURVIVORS-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Flashbacks and Lingering Questions for Survivors', 'kicker': None, 'content_kicker': None, 'print_headline': 'For Survivors, Flashbacks and Questions That Visit at Night', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Tucson (Ariz)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Tucson Shooting (2011)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Giffords, Gabrielle', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-13T02:09:19+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Sam Dolnick', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Dolnick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bd774b4f-6fe7-5470-8514-70ee71a0b143', 'word_count': 1362, 'uri': 'nyt://article/bd774b4f-6fe7-5470-8514-70ee71a0b143'}, {'abstract': 'Dr. Peter Rhee’s daily briefings put a human face on the medically complicated discussions about the Tucson shooting victims’ recovery.', 'web_url': 'https://www.nytimes.com/2011/01/13/us/13rhee.html', 'snippet': 'Dr. Peter Rhee’s daily briefings put a human face on the medically complicated discussions about the Tucson shooting victims’ recovery.', 'lead_paragraph': 'TUCSON \x97 Dr. Peter Rhee steps before a bank of television cameras each morning to tell the world the latest on the progress of Congresswoman Gabrielle Giffords. He uses phrases like “101 percent chance of survival” and seems to take a certain pride in saying that medically, “bullets are easy, car crashes are hard.” ', 'print_section': 'A', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/13/us/sub-RHEE/sub-RHEE-jumbo.jpg', 'height': 701, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/13/us/sub-RHEE/sub-RHEE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/13/us/sub-RHEE/sub-RHEE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Surgeon and Sudden Celebrity, and Trying to Balance the Roles', 'kicker': None, 'content_kicker': None, 'print_headline': 'Surgeon and Sudden Celebrity, And Trying to Balance the Roles', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Giffords, Gabrielle', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'University Medical Center', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Tucson (Ariz)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Doctors', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Tucson Shooting (2011)', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-01-13T02:10:38+0000', 'document_type': 'article', 'news_desk': 'N