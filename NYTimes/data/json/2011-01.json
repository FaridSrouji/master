lename': None, 'lastname': 'Wu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/f878be18-ef21-5aab-8de3-0655efd0175a', 'word_count': 730, 'uri': 'nyt://article/f878be18-ef21-5aab-8de3-0655efd0175a'}, {'abstract': 'Why did Mexico send an envoy to meet with President-elect Lincoln in Springfield?', 'web_url': 'https://opinionator.blogs.nytimes.com/2011/01/17/lincolns-mexican-visitor/', 'snippet': 'Why did Mexico send an envoy to meet with President-elect Lincoln in Springfield?', 'lead_paragraph': 'Matias Romero arrived in Springfield, Ill. on the evening of Jan. 18, 1861. Though late in the day, he figured it would be easy to find a room in this sleepy midwestern town. But there were no rooms available at his first choice, the American Hotel, or anywhere else: all the hotels in town were full of friends, patronage seekers and the merely curious who had come to meet President-elect Lincoln. Travelers packed into guesthouses three to a room with strangers sharing beds, while others settled for sleeper cars parked in the rail yard. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-disunion/opinionator-pog-disunion-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Lincoln’s Mexican Visitor', 'kicker': 'Disunion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Civil War (US) (1861-65)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Lincoln, Abraham', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Walker, William', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-01-18T04:00:48+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By William Moss Wilson', 'person': [{'firstname': 'William', 'middlename': 'Moss', 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/6570135a-734c-5ade-b248-d36207a184b2', 'word_count': 1407, 'uri': 'nyt://article/6570135a-734c-5ade-b248-d36207a184b2'}, {'abstract': 'A step-by-step guide for the Jets to reach the Super Bowl and then win it.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/01/17/the-wheels-are-turning-for-the-jets/', 'snippet': 'A step-by-step guide for the Jets to reach the Super Bowl and then win it.', 'lead_paragraph': 'This season the Jets were 1-2 against the other three teams still alive in the postseason. In their final two games, the Jets can get the upper hand on Pittsburgh and then prevail over either Green Bay or Chicago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Wheels Are Turning for the Jets', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Bears', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Jets', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Steelers', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-01-18T04:19:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Mike Tanier', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Tanier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/541f7a54-25f6-58b8-819c-a8353301f91b', 'word_count': 606, 'uri': 'nyt://article/541f7a54-25f6-58b8-819c-a8353301f91b'}, {'abstract': 'The Packers’ James Starks may be running a little harder than usual against the Bears on Sunday.', 'web_url': 'https://fifthdown.blogs.nytimes.com/2011/01/17/the-day-the-bears-snubbed-james-starks/', 'snippet': 'The Packers’ James Starks may be running a little harder than usual against the Bears on Sunday.', 'lead_paragraph': 'On its face it’s a mismatch: Packers running back James Starks, who rushed for 101 yards during the regular season, against the Bears’ No. 2-ranked run defense, which allowed only 34 in Sunday’s win over the Seahawks.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Day the Bears Snubbed James Starks', 'kicker': 'The Fifth Down', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Football', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chicago Bears', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Green Bay Packers', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-18T04:25:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Andrew Das', 'pers