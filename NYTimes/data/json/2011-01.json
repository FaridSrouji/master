: None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-18T17:14:38+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/3574d1ec-3110-53dc-8a9c-cd3aedc37660', 'word_count': 283, 'uri': 'nyt://article/3574d1ec-3110-53dc-8a9c-cd3aedc37660'}, {'abstract': 'Cal Worthington might not ride elephants on his TV commercials any more, but his love of the spotlight, like his Stetson hat, is still firmly in place.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/01/18/as-car-industry-evolves-a-90-year-old-cowboy-abides/', 'snippet': 'Cal Worthington might not ride elephants on his TV commercials any more, but his love of the spotlight, like his Stetson hat, is still firmly in place.', 'lead_paragraph': 'Cal Worthington, the California auto dealer whose “My Dog Spot” television ads made him a cultural icon and something of a celebrity, turned 90 recently. He continues to appear on television, wearing his trademark Stetson and loud Western wear, hawking used cars and extolling their “low, low prices.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'As Car Industry Evolves, a 90-Year-Old Cowboy Abides', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'California', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-18T17:15:14+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Jerry Garrett', 'person': [{'firstname': 'Jerry', 'middlename': None, 'las