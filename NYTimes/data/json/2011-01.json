le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/ee956415-cd8a-566c-bce2-fceb600ae89d', 'word_count': 0, 'uri': 'nyt://video/ee956415-cd8a-566c-bce2-fceb600ae89d'}, {'abstract': 'Though the Mulleavy sisters designed the ballet costumes for “Black Swan,” they were not the credited designers on the film.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2011/01/28/an-oscar-snub-for-designing-women/', 'snippet': 'Though the Mulleavy sisters designed the ballet costumes for “Black Swan,” they were not the credited designers on the film.', 'lead_paragraph': 'LOS ANGELES— If you’ve seen Kate and Laura Mulleavy, the sisters behind the fashion line Rodarte, discussing how they painstakingly hand-crafted all the ballet costumes for “Black Swan” — spending months making multiple versions of the feather-bedecked white and black swan tutus, going through fitting after fitting as the body of their hard-training star, Natalie Portman, changed – you may wonder why they were not nominated for a costume design Oscar. The Bagger wondered too, especially after we donned one of the outfits (the bad guy’s, of course).', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'An Oscar Snub for Designing Women', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mulleavy, Kate', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mulleavy, Laura', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Portman, Natalie', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-28T21:27:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/69db269c-0607-5925-9593-9c95b68d9fcf', 'word_count': 229, 'uri': 'nyt://article/69db269c-0607-5925-9593-9c95b68d9fcf'}, {'abstract': 'Massey Energy disputed government findings that poor practices led to a mine blast in West Virginia last year.', 'web_url': 'https://www.nytimes.com/2011/01/29/us/29mine.html', 'snippet': 'Massey Energy disputed government findings that poor practices led to a mine blast in West Virginia last year.', 'lead_paragraph': 'WASHINGTON \x97 The company that operates a West Virginia coal mine on Friday disputed a preliminary federal finding that poor mining practices and improper equipment maintenance led to an explosion that killed 29 miners last year.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mine Operator Says That Huge Seep Caused Blast', 'kicker': None, 'content_kicker': None, 'print_headline': 'Disputing U.S. Findings, West Virginia Mine Operator Says Blast Wasn’t Its Fault', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Accidents and Safety', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Upper Big Branch Mine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Mines and Mining', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Coal', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Massey Energy Co', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'West Virginia', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Explosions', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-01-28T21:31:01+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By John M. Broder', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': '