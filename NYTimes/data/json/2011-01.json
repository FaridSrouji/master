://article/d2b91f2d-0603-52d1-9ae9-ceb58c10fa7f'}, {'abstract': 'The country’s leader promised to create more jobs but also quell the riots over poverty and unemployment.', 'web_url': 'https://www.nytimes.com/2011/01/11/world/africa/11tunisia.html', 'snippet': 'The country’s leader promised to create more jobs but also quell the riots over poverty and unemployment.', 'lead_paragraph': 'CAIRO \x97 The Tunisian government ordered the closing of all schools and universities in the country on Monday until further notice in an attempt to quell escalating riots over poverty and unemployment. ', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/11/11Tunisia-span/11Tunisia-span-articleLarge.jpg', 'height': 315, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/11/11Tunisia-span/11Tunisia-span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 315}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/11/11Tunisia-span/11Tunisia-span-jumbo.jpg', 'height': 695, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/11/11Tunisia-span/11Tunisia-span-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/11/11Tunisia-span/11Tunisia-span-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Amid Rioting, Tunisia Closes Universities', 'kicker': None, 'content_kicker': None, 'print_headline': 'Amid Rioting, Tunisia Closes Universities And Schools', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Shutdowns (Institutional)', 'rank': 1, 'major': 'N'}, {'name'