mbo.jpg', 'height': 670, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/22/us/JP-OBAMA/JP-OBAMA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/22/us/JP-OBAMA/JP-OBAMA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Obama Sends Pro-Business Signal With Adviser Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Obama Names\nG.E. Chairman\nTo Fiscal Panel', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Economic Recovery Advisory Board', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Immelt, Jeffrey R', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'General Electric Co', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-21T19:27:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': 'By Sheryl Gay Stolberg', 'person': [{'firstname': 'Sheryl', 'middlename': 'Gay', 'lastname': 'Stolberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f15d176a-0809-59dc-8031-86e1dfa464e8', 'word_count': 1112, 'uri': 'nyt://article/f15d176a-0809-59dc-8031-86e1dfa464e8'}, {'abstract': 'The suit, in which a tentative settlement has been reached, claimed that the hybrid’s high-intensity discharge headlights worked only intermittently and then failed.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/01/21/toyota-prius-headlight-failure-sparks-class-action-suit/', 'snippet': 'The suit, in which a tentative settlement has been reached, claimed that the hybrid’s high-intensity discharge headlights worked only intermittently and then failed.', 'lead_paragraph': 'About 220,000 Toyota Priuses are included in the tentative settlement of a class-action suit in which claimants say their hybrids’ high-intensity discharge headlights function intermittently and then fail.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Toyota Prius Headlight Failure Sparks Class-Action Suit', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobile Safety Features and Defects', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recalls and Bans of Products', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Highway Traffic Safety Administration', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Toyota Motor Corp', 'rank': 4, 'major': 'N'}], 'pub_date': '2011-01-21T19:40:33+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Christopher Jensen', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Jensen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/23ce52ef-69af-5e07-ad6a-659e3bf1f433', 'word_count': 615, 'uri': 'nyt://article/23ce52ef-69af-5e07-ad6a-659e3bf1f433'}, {'abstract': 'The oxygen of publicity remains vital, even in an era when everyone has access to the digital megaphones of Twitter, Facebook and YouTube.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/01/21/this-is-not-a-post-about-sarah-palin/', 'snippet': 'The oxygen of publicity remains vital, even in an era when everyone has access to the digital megaphones of Twitter, Facebook and YouTube.', 'lead_paragraph': 'Updated | 5:10 p.m. The news that Osama bin Laden, or someone impersonating him, released a new audio message on Friday has been greeted with as little fanfare as reports on Thursday that Terry Jones, the pastor of a Florida microchurch, was denied permission to enter Britain to address 30 fans of his work.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'This Is Not a Post About Sarah Palin', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-21T19:43:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/e3a481ab-ac07-5680-b782-147fa7d14fd7', 'word_count': 1000, 'uri': 'nyt://article/e3a481ab-ac07-5680-b782-147fa7d14fd7'}, {'abstract': 'The New Orleans Hornets are no longer the league’s hottest team, but they’ve remained successful with a continued commitment to defense.', 'web_url': 'https://offthedribble.blogs.nytimes.com/2011/01/21/hornets-staying-relevant-with-defense/', 'snippet': 'The New Orleans Hornets are no longer the league’s hottest team, but they’ve remained successful with a continued commitment to defense.', 'lead_paragraph': 'The N.B.A. season is not unlike the lunar cycle in that it exists as a series of phases during which portions of the whole rotate through periods of high visibility. Teams essentially take turns in a position of prominence, while the rest of the league goes about its business in semi-obscurity. The news media’s obsession with up-to-the-minute sports coverage (which is the chicken and which is the egg I’ll leave you to decide) and basketball fans hungry for the hottest team in the game have created a system that anoints kings for a day, if only so they can be dethroned and replaced in short order.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hornets Staying Relevant With Defense', 'kicker': 'Off the Dribble', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Basketball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Ariza, Trevor', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Green, Willie', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Okafor, Emeka', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Paul, Chris', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'WEST, DAVID', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'New Orleans Hornets', 'rank': 7, 'major': 'N'}], 'pub_date': '2011-01-21T19:45:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'byline': {'original': 'By Rob Mahoney', 'person': [{'firstname': 'Rob', 'middlename': None, 'lastname': 'Mahoney', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/f9274caa-dc18-5371-99b5-1702c56c48ae', 'word_count': 837, 'uri': 'nyt://article/f9274caa-dc18-5371-99b5-1702c56c48ae'}, {'abstract': 'With new shops and restaurants, and most recently a low-rise complex called Marunouchi Brick Square, Tokyo’s Marunouchi district is no longer just for office workers.', 'web_url': 'https://www.nytimes.com/slideshow/2011/01/23/travel/0123-surfacing-slideshow.html', 'snippet': 'With new shops and restaurants, and most recently a low-rise complex called Marunouchi Brick Square, Tokyo’s Marunouchi district is no longer just for office workers.', 'lead_paragraph': 'With new shops and restaurants, and most recently a low-rise complex called Marunouchi Brick Square, Tokyo’s Marunouchi district is no longer just for office workers.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'ima