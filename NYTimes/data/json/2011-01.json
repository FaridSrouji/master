/27ROW-A/Z-ROW-A-jumbo.jpg', 'height': 1024, 'width': 554, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/27/fashion/27ROW-A/Z-ROW-A-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/27/fashion/27ROW-A/Z-ROW-A-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Filmmaker’s View of the Runway', 'kicker': 'Front Row', 'content_kicker': None, 'print_headline': 'A Filmmaker’s View of the Runway', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cassavetes, Zoe R', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Johnson Publishing', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Recordings and Downloads (Video)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Beauty', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Prada, Miuccia', 'rank': 6, 'major': 'N'}], 'pub_date': '2011-01-26T21:15:52+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'Fashion & Style', 'byline': {'original': 'By Eric Wilson', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Wilson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7b668f20-912c-5221-a9d5-d883b25106c6', 'word_count': 558, 'uri': 'nyt://article/7b668f20-912c-5221-a9d5-d883b25106c6'}, {'abstract': 'A team hopes its upcoming record attempt on the Bonneville Salt Flats will highlight an overlooked propulsion system.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/01/26/steam-powered-racer-to-make-run-at-land-speed-record/', 'snippet': 'A team hopes its upcoming record attempt on the Bonneville Salt Flats will highlight an overlooked propulsion system.', 'lead_paragraph': 'On Tuesday, Cyclone Power Technologies of Pompano Beach, Fla., announced that it would attempt to break the land-speed record for an unlikely race class: steam cars.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Steam-Powered Racer to Make Run at Land-Speed Record', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Engines', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-26T21:16:52+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Paul Stenquist', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Stenquist', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/6e286b81-4bf9-592e-936f-c081e8cd83c3', 'word_count': 372, 'uri': 'nyt://article/6e286b81-4bf9-592e-936f-c081e8cd83c3'}, {'abstract': 'The Cohen Media Group, the distributor of foreign-language Oscar hopeful “Outside the Law,” faces the well-oiled machine of Sony Pictures Classics.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2011/01/26/the-david-in-the-foreign-language-race/', 'snippet': 'The Cohen Media Group, the distributor of foreign-language Oscar hopeful “Outside the Law,” faces the well-oiled machine of Sony Pictures Classics.', 'lead_paragraph': 'To look at the companies behind the five films nominated for best foreign-language film is to see a study in contrasts. At one extreme is Sony Pictures Classics, which has a long and savvy history of discovering, distributing and marketing Oscar nominees and winners, among them “The Lives of Others.” This year it has corralled two of the five slots: the Danish entry “In A Better World” and “Incendies” from Canada.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The David in the Foreign-Language Race', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Bouchareb, Rachid', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Sony Pictures Entertainment', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-26T21:20:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Larry Rohter', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Rohter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/aaa58a71-9ba3-50b0-9f9d-9fe1f71f2a18', 'word_count': 600, 'uri': 'nyt://article/aaa58a71-9ba3-50b0-9f9d-9fe1f71f2a18'}, {'abstract': 'A UConn donor has demanded that the university return $3 million in donations because he is unhappy that the football team’s new coach was hired without his input.', 'web_url': 'https://thequad.blogs.nytimes.com/2011/01/26/what-does-a-donors-money-buy-at-uconn/', 'snippet': 'A UConn donor has demanded that the university return $3 million in donations because he is unhappy that the football team’s new coach was hired without his input.', 'lead_paragraph': 'The University of Connecticut finds itself in a very public fight with a major donor to its football program, who has demanded the return of $3 million in donations because he is furious that he was not consulted enough on the search for a new coach.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Does a Donor’s Money Buy at UConn?', 'kicker': 'The Quad', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Coaches and Managers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'College Athletics', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Edsall, Randy', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Connecticut', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-26T21:28:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Pro Basketball', 'byline': {'original': 'By Andrew Das', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Das', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/7d2fa597-e140-5e08-9954-3f99f4b17ced', 'word_count': 486, 'uri': 'nyt://article/7d2fa597-e140-5e08-9954-3f99f4b17ced'}, {'abstract': 'Jared L. Loughner researched assassins, the death penalty and solitary confinement online before the shooting.', 'web_url': 'https://www.nytimes.com/2011/01/27/us/27loughner.html', 'snippet': 'Jared L. Loughner researched assassins, the death penalty and solitary confinement online before the shooting.', 'lead_paragraph': 'TUCSON — Jared L. Loughner, the man accused of opening fire outside a Tucson supermarket on Jan. 8 in what the authorities consider an attempted political assassination, researched famous assassins, the death penalty and solitary confinement on the Internet before the shooting, an official close to the investigation said Wednesday.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tucson Suspect Studied Assassins, Officials Say', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tucson', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tucson Shooting (2011)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Loughner, Jared Lee', 'rank': 2, 'major': 'N'}], 'pub_date': '2011-01-26T21:31:16+0000', 'document_type': 'article', 'news_desk': 'National', 'section_