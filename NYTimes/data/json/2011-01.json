lifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c2570820-6f58-5a30-bcfb-2e69e8893272', 'word_count': 631, 'uri': 'nyt://article/c2570820-6f58-5a30-bcfb-2e69e8893272'}, {'abstract': 'After Israeli soldiers expressed regrets about their part in Israel’s invasion of Gaza in 2008 on film, the woman they spoke to said she received threatening calls and messages.', 'web_url': 'https://thelede.blogs.nytimes.com/2011/01/27/israeli-journalist-reports-death-threats-over-gaza-war-film/', 'snippet': 'After Israeli soldiers expressed regrets about their part in Israel’s invasion of Gaza in 2008 on film, the woman they spoke to said she received threatening calls and messages.', 'lead_paragraph': 'Nurit Kedar, an Israeli documentary filmmaker, told Channel 4 News of Britain on Thursday that she had received death threats following the broadcast of her latest film, a report on Israeli soldiers who expressed regrets over their own conduct during the war in Gaza two years ago.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Israeli Journalist Reports Death Threats Over Gaza War Film', 'kicker': 'The Lede', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-27T22:40:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Blogs', 'byline': {'original': 'By Robert Mackey', 'person': [{'firstname': 'Robert', 'middlename': None, 'lastname': 'Mackey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/80e6f7cc-5bbb-5e81-bce4-fdb94610f204', 'word_count': 357, 'uri': 'nyt://article/80e6f7cc-5bbb-5e81-bce4-fdb94610f204'}, {'abstract': 'As I watched David Parsons’s “Sleep Study” on Wednesday night at the Joyce Theater, I felt a growing sense of incredulity.', 'web_url': 'https://www.nytimes.com/2011/01/28/arts/dance/28parsons.html', 'snippet': 'As I watched David Parsons’s “Sleep Study” on Wednesday night at the Joyce Theater, I felt a growing sense of incredulity.', 'lead_paragraph': 'As I watched David Parsons’s “Sleep Study” on Wednesday night at the Joyce Theater, I felt a growing sense of incredulity. This 1987 piece has a single conceit: six dancers roll around the floor \x97 curling up, stretching out, piling over one another \x97 while a seventh sleeps motionless at the front of the stage, waking at the final moment. If the piece had been conceived by my third grader’s dance class and presented at the end-of-year school recital, my indulgent smile would have faded after five minutes. ', 'print_section': 'C', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/28/arts/28PARSONS-span/PARSONS-articleLarge.jpg', 'height': 350, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2011/01/28/arts/28PARSONS-span/PARSONS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 350}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/28/arts/28PARSONS-span/PARSONS-jumbo.jpg', 'height': 628, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/28/arts/28PARSONS-span/PARSONS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/28/arts/28PARSONS-span/PARSONS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Works to Challenge an Audience, or Not', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Works to Challenge an Audience, or Not', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Parsons, David', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Joyce Theater', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-27T22:41:14+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/099adc93-5099-5c9d-a689-b748f8380708', 'word_count': 609, 'uri': 'nyt://article/099adc93-5099-5c9d-a689-b748f8380708'}, {'abstract': 'An American Songbook concert focused on the upbeat qualities that fortify many of the pieces in the George and Ira Gershwin catalog.', 'web_url': 'https://www.nytimes.com/2011/01/28/arts/music/28rob.html', 'snippet': 'An American Songbook concert focused on the upbeat qualities that fortify many of the pieces in the George and Ira Gershwin catalog.', 'lead_paragraph': 'An unquenchable joie de vivre buoyed by an antic humor that wells up like spring water: the impulse to feel good is a driving force in the songs of George and Ira Gershwin, perhaps more so than in the work of any other major 20th-century songwriting team. No wonder everyone loves the Gershwins.', 'print_section': 'C', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Cheeriness of Those Gershwin Boys', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'The Cheeriness of Those Gershwin Boys', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Clark, Victoria', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'American Songbook (Music Series)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Fis