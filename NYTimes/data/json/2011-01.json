, 'thumbnailheight': 75}}], 'headline': {'main': 'Daniel Bell, Ardent Appraiser of Politics, Economics and Culture, Dies at 91', 'kicker': None, 'content_kicker': None, 'print_headline': 'Daniel Bell, Ardent Appraiser of Politics, Economics and Culture, Dies at 91', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Writing and Writers', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sociology', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-26T02:46:12+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Michael T. Kaufman', 'person': [{'firstname': 'Michael', 'middlename': 'T.', 'lastname': 'Kaufman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/12706da2-3bd0-5776-b987-e8087e0ed6fc', 'word_count': 1346, 'uri': 'nyt://article/12706da2-3bd0-5776-b987-e8087e0ed6fc'}, {'abstract': 'Four young researchers joined Michelle Obama for the president’s State of the Union address, including one who used nanotechnology for a cancer treatment.', 'web_url': 'https://www.nytimes.com/2011/01/26/science/26light.html', 'snippet': 'Four young researchers joined Michelle Obama for the president’s State of the Union address, including one who used nanotechnology for a cancer treatment.', 'lead_paragraph': 'The presence of Amy Chyao, a 16-year-old from Richardson, Tex., in Michelle Obama’s box during the State of the Union speech puts a spotlight, as it were, on using nanotechnology and light to kill cancer. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Nanotechnology Gets Star Turn at Speech', 'kicker': None, 'content_kicker': None, 'print_headline': 'Nanotechnology Gets Star Turn at Speech', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Research', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Nanotechnology', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Michelle', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'State of the Union Message (US)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-26T02:52:47+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Science', 'byline': {'original': 'By Kenneth Chang', 'person': [{'firstname': 'Kenneth', 'middlename': None, 'lastname': 'Chang', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8b90be6f-6864-57bd-a1c7-576cebe96e08', 'word_count': 386, 'uri': 'nyt://article/8b90be6f-6864-57bd-a1c7-576cebe96e08'}, {'abstract': 'Is this puzzle within our reach?', 'web_url': 'https://wordplay.blogs.nytimes.com/2011/01/25/mile/', 'snippet': 'Is this puzzle within our reach?', 'lead_paragraph': 'WEDNESDAY’S PUZZLE — The last time we saw David Murchie was in 2005, when he made his debut with a very punny offering (Across Lite, Solution). Today, he’s back with a fun grid that is straightforward in terms of fill, but has some tricky cluing. All in all, a typical Wednesday puzzle, but watch out: Mr. Murchie says we may not be as on target as we think. You’ll have to finish the puzzle to see what I mean.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Wednesday: As Good as a Mile', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2011-01-26T03:00:03+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Deb Amlen', 'person': [{'firstname': 'Deb', 'middlename': None, 'lastname': 'Amlen', 'qualifier': None, 'title': None, 'role': 'reported', 'org