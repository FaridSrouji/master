uri': 'nyt://article/734b7437-85e1-5f57-a40a-ef4e6fdf258b'}, {'abstract': '“The Song Continues,” a festival organized by Carnegie Hall and the Marilyn Horne Foundation, concluded with a recital of promising young singers at Zankel Hall.', 'web_url': 'https://www.nytimes.com/2011/01/25/arts/music/25song.html', 'snippet': '“The Song Continues,” a festival organized by Carnegie Hall and the Marilyn Horne Foundation, concluded with a recital of promising young singers at Zankel Hall.', 'lead_paragraph': 'In February 1961, Marilyn Horne, a young mezzo-soprano, made her Carnegie Hall debut in Bellini’s “Beatrice di Tenda” opposite a rising Australian soprano named Joan Sutherland. The debut was unexpected: the production’s final two performances were moved to Carnegie because of the extraordinary demand for tickets after its premiere at Town Hall.', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/arts/SONG1/SONG1-jumbo.jpg', 'height': 731, 'width': 783, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/25/arts/SONG1/SONG1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/25/arts/SONG1/SONG1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'A Celebration of the Song Recital, and of the Potential of 4 Young Voices', 'kicker': 'Music Review', 'content_kicker': None, 'print_headline': 'A Celebration of the Song Recital, And of the Potential of 4 Young Voices', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Horne, Marilyn', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Carne