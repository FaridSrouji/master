ticle/ede050ae-f9af-5828-a087-da90615fc08e'}, {'abstract': 'Pakistan’s refusal to attack militants in an area on its northwest border has made it easier for American drones to strike them.', 'web_url': 'https://www.nytimes.com/2011/01/18/world/asia/18terror.html', 'snippet': 'Pakistan’s refusal to attack militants in an area on its northwest border has made it easier for American drones to strike them.', 'lead_paragraph': 'WASHINGTON \x97 Pakistan’s refusal to attack militants in a notorious sanctuary on its northwest border may have created a magnet there for hundreds of Islamic fighters seeking a safe haven where they can train and organize attacks against NATO forces in Afghanistan. But theirs is a congregation in the cross hairs.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/18/world/JP-TERROR/JP-TERROR-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/18/world/JP-TERROR/JP-TERROR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2011/01/18/world/JP-TERROR/JP-TERROR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Pakistan’s Failure to Hit Militant Sanctuary Has Positive Side for U.S.', 'kicker': None, 'content_kicker': None, 'print_headline': 'Pakistan’s Failure to Hit Militant Sanctuary Has Positive Side for U.S.', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Taliban', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Drones (Pilotless Planes)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'v