wards Season', 'byline': {'original': 'By Michael Cieply and Brooks Barnes', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cieply', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e2d778d4-a63f-53ea-bc0e-9be0179ce9f3', 'word_count': 1213, 'uri': 'nyt://article/e2d778d4-a63f-53ea-bc0e-9be0179ce9f3'}, {'abstract': 'A marketing campaign for Wheat Thins surprises fans of the product, which is shunning the term “cracker” in favor of “snack.”', 'web_url': 'https://www.nytimes.com/2011/01/05/business/media/05adco.html', 'snippet': 'A marketing campaign for Wheat Thins surprises fans of the product, which is shunning the term “cracker” in favor of “snack.”', 'lead_paragraph': 'LIKE ready-made pie crusts, crackers are marketed not just on their merits but also on what consumers put on them, so packages often show crackers topped with artfully arranged cheese, diced vegetables and dip. ', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2011/01/05/business/adco/adco-jumbo.jpg', 'height': 766, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}], 'headline': {'main': 'Don’t Call It a Cracker: Wheat Thins Prefers to Be Billed as a Snack', 'kicker': 'Advertising', 'content_kicker': None, 'print_headline': 'Don’t Call It a Cracker: Wheat Thins Prefers To Be Billed as a Snack', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Crackers', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Kraft Foods Inc', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 3, 'maj