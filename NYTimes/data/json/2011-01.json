ajor': 'N'}], 'pub_date': '2011-01-21T00:11:12+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': '', '_id': 'nyt://article/1b86ee50-183b-5a49-b136-22802d2dd48a', 'word_count': 258, 'uri': 'nyt://article/1b86ee50-183b-5a49-b136-22802d2dd48a'}, {'abstract': 'With sovereign bond yields so low and Brazilian inflation flaring up, bond buyers interested in Brazil could be better off lending to Petrobras.', 'web_url': 'https://www.nytimes.com/2011/01/21/business/21views.html', 'snippet': 'With sovereign bond yields so low and Brazilian inflation flaring up, bond buyers interested in Brazil could be better off lending to Petrobras.', 'lead_paragraph': 'Petrobras, Brazil’s energy giant, will pay bond investors about a percentage point more in yield than the government that controls it. With sovereign bond yields so low and Brazilian inflation flaring up, bond buyers interested in the South American country could be better off lending to its oil-backed corporate proxy.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Risks and Rewards of Petrobras', 'kicker': 'Reuters Breakingviews', 'content_kicker': None, 'print_headline': 'The Riskiness of Petrobras', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Economy', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Brazil', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Petroleo Brasileiro SA Petrobras', 'rank': 3, 'major': 'N'}], 'pub_date': '2011-01-21T00:17:34+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Agnes T. Crane and James Pethokoukis', 'person': [{'firstname': 'Agnes', 'middlename': 'T.', 'lastname': 'Crane', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'James', 'middlename': None, 'lastname': 'Pethokoukis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6a69d18-ef65-5155-8c0d-31e8c52a3c43', 'word_count': 715, 'uri': 'nyt://article/f6a69d18-ef65-5155-8c0d-31e8c52a3c43'}, {'abstract': 'The measures were undertaken to make room for new hybrid and electric-drive vehicles, the Japanese automaker said on Thursday.', 'web_url': 'https://wheels.blogs.nytimes.com/2011/01/20/mitsubishi-to-discontinue-eclipse-and-galant/', 'snippet': 'The measures were undertaken to make room for new hybrid and electric-drive vehicles, the Japanese automaker said on Thursday.', 'lead_paragraph': 'Looking to jump-start its stalled American car sales and meet environmental targets around the world, Mitsubishi is placing a big bet on electricity. Under a global plan announced Thursday, the company plans to offer six new plug-in hybrid and battery-electric models by 2015.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Mitsubishi to Discontinue Eclipse and Galant', 'kicker': 'Wheels', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Automobiles', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electric Vehicles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Hybrid Vehicles', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Mitsubishi Corporation', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Illinois', 'rank': 5, 'major': 'N'}], 'pub_date': '2011-01-21T00:22:44+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Automobiles', 'byline': {'original': 'By Lawrence Ulrich', 'p