nk': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Ragusa, Michele', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Sandberg, Andy', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Corcoran, Charlie', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Edwards, Greg (Playwright)', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'Craving for Travel (Play)', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-01-27T21:17:52+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/2e3fd315-eb7e-5ed8-924f-982e3abcd07b', 'word_count': 433, 'uri': 'nyt://article/2e3fd315-eb7e-5ed8-924f-982e3abcd07b'}, {'abstract': 'A man accused of making forged copies of a sculpture by Jasper Johns pleaded guilty on Monday to federal wire fraud charges.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/01/27/foundry-owner-accused-of-forging-johns-sculptures-pleads-guilty-to-wire-fraud/', 'snippet': 'A man accused of making forged copies of a sculpture by Jasper Johns pleaded guilty on Monday to federal wire fraud charges.', 'lead_paragraph': 'A Queens foundry owner who was accused of trying to sell fake Jasper Johns works for millions of dollars pleaded guilty on Monday to three counts of wire fraud in Manhattan federal court, according to The Associated Press. In 1990, Mr. Johns had entrusted Brian Ramnarine, the owner of Empire Bronze Art Foundry, to make a wax cast of the mold for his 1960 metallic collage “Flag.” Mr. Ramnarine kept the mold and was accused of secretly creating copies of Mr. Johns’s work that he later tried to sell as originals. Mr. Ramnarine, who was in the middle of a trial, made a deal with federal prosecutors that he would not challenge any sentence of 10 years or less in prison. Last week, Mr. Johns took a turn on the witness stand, testifying that he had cut ties with Mr. Ramnarine after seeing a copy of his sculpture. “I was shown the cast of a flag I had never authorized,” he told the court. “And it had come from Brian.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Foundry Owner Accused of Forging Johns’s Sculptures Pleads Guilty to Wire Fraud', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Frauds and Swindling', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Johns, Jasper', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Ramnarine, Brian', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Queens (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-27T21:20:11+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patricia Cohen', 'person': [{'firstname': 'Patricia', 'middlename': None, 'lastname': 'Cohen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/fd2c8f78-6dd2-55fc-961b-7217a1ce6ccb', 'word_count': 171, 'uri': 'nyt://article/fd2c8f78-6dd2-55fc-961b-7217a1ce6ccb'}, {'abstract': 'Photos from Ukraine, the Philippines, Thailand and Syria.', 'web_url': 'https://lens.blogs.nytimes.com/2014/01/27/pictures-of-the-day-ukraine-and-elsewhere-11/', 'snippet': 'Photos from Ukraine, the Philippines, Thailand and Syria.', 'lead_paragraph': 'Photos from Ukraine, the Philippines, Thailand and Syria.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'ur