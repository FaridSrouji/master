pe': 'image', 'url': 'images/2014/01/19/arts/19WORLD1_SPAN/19WORLD1-jumbo.jpg', 'height': 1024, 'width': 775, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/arts/19WORLD1_SPAN/19WORLD1-superJumbo.jpg', 'height': 2048, 'width': 1549, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/arts/19WORLD1_SPAN/19WORLD1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/19/arts/19WORLD1_SPAN/19WORLD1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/arts/19WORLD1_SPAN/19WORLD1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Great Music for the Great War', 'kicker': None, 'content_kicker': None, 'print_headline': 'Great Music for the Great War', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World War I (1914-18)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, Michael', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Classical Music', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-16T20:16:35+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Michael Cooper', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cooper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5ff0729b-fee1-5cbf-b035-36a115dfd39f', 'word_count': 1503, 'uri': 'nyt://article/5ff0729b-fee1-5cbf-b035-36a115dfd39f'}, {'abstract': 'The Belgian designer teamed up with the American artist, an old friend, to design a one-off collection under a new label.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/01/16/perfect-pairing-raf-simonss-colorful-collaboration-with-sterling-ruby-for-fallwinter-2014/', 'snippet': 'The Belgian designer teamed up with the American artist, an old friend, to design a one-off collection under a new label.', 'lead_paragraph': 'Last night, the Belgian designer Raf Simons and the Los Angeles artist Sterling Ruby presented their collaborative fall/winter 2014 collection in a gutted raw space just off the Place Vendome in Paris. “We have done the whole thing together,” Simons said backstage about creating the label Raf Simons/Sterling Ruby with his friend of nine years. The two met through a gallerist when Simons first purchased a piece of Ruby’s art, and collaborated several years ago on a capsule collection of denim jeans and jackets. For this one-off set of designs for the label, which was presented in place of Simons’s eponymous line, Ruby decked out the runway with his signature large-scale sculptures. Shaped like red-white-and-blue fangs dripping from the ceilings, the artwork set the scene for the colorful clothes: khaki trench coats artfully appliquéd with brightly colored fabric strips and various articles emblazoned with words like “father” and “Abu Lang,” which Ruby explained stood for the phrase “abusive language.” “We loaded a lot of things into the clothing, both in terms of iconography and also our own path,” Ruby added. The pieces spattered with color were the most literal references to their craft — a real artist’s wardrobe.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Raf Simons’s Colorful Collaboration With Sterling Ruby for Fall/Winter 2014', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Paris Fashion Week', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ruby, Sterling', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Simons, Raf', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-16T20:16:38+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Bruce Pask', 'person': [{'firstname': 'Bruce', 'middlename': None, 'lastname': 'Pask', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4feec0ef-f267-5f5e-946b-c8bfc23c2c2c', 'word_count': 202, 'uri': 'nyt://article/4feec0ef-f267-5f5e-946b-c8bfc23c2c2c'}, {'abstract': 'Michelin has developed a tire for wet roads with channels that grow wider and hidden rain grooves that emerge as the tire is used.', 'web_url': 'https://www.nytimes.com/2014/01/19/automobiles/autoshow/a-tire-that-evolves-as-it-wears.html', 'snippet': 'Michelin has developed a tire for wet roads with channels that grow wider and hidden rain grooves that emerge as the tire is used.', 'lead_paragraph': 'DETROIT — As your tires wear, their ability to maintain grip on wet roads diminishes with reduced tread depth. Michelin has developed a tire that counters the effects of wear with channels that grow wider, and hidden rain grooves that emerge as the tire is used, along with a special rubber compound for wet conditions. ', 'print_section': 'AU', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/tire2/tire2-articleLarge.jpg', 'height': 802, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/19/automobiles/tire2/tire2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 802}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/tire2/tire2-jumbo.jpg', 'height': 1024, 'width': 766, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/tire2/tire2-superJumbo.jpg', 'height': 2048, 'width': 1532, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/tire2/tire2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/19/automobiles/tire2/tire2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/tire2/tire2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Tire That Evolves as It Wears', 'kicker': 'Technology', 'content_kicker': None, 'print_headline': 'A Tire That Evolves as It Wears', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tires', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'North American International Auto Show', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Michelin Group', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-16T20:18:44+0000', 'document_type': 'article', 'news_desk': 'Automobiles', 'section_name': 'Automobiles', 'subsection_name': 'Automobiles', 'byline': {'original': 'By Eric Tingwall', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Tingwall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5d209571-36d0-5da8-9c85-bfa74f14b41e', 'word_count': 679, 'uri': 'nyt://article/5d209571-36d0-5da8-9c85-bfa74f14b41e'}, {'abstract': 'At the whiff of a threat, a generation growing up in the shadow of Columbine and Sandy Hook is trained to snap off the lights, lock the doors and take refuge in corners and closets.', 'web_url': 'https://www.nytimes.com/2014/01/17/us/in-age-of-school-shootings-lockdown-drills-are-the-new-duck-and-cover.html', 'snippet': 'At the whiff of a threat, a generation growing up in the shadow of Columbine and Sandy Hook is trained to snap off the lights, lock the doors and take refuge in corners and closets.', 'lead_paragraph': 'The bomb threat was just a hoax, but officials at Hebron High School near Dallas took no chances: School officials called the police and locked down the school this week. Separately, a middle school 2,000 miles away in Washington State went on lockdown after a student brought a toy gun to class.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/us/Lockdown-111/Lockdown-articleLarge.jpg', 'height': 520, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/17/us/Lockdown-111/Lockdown-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 520}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/us/Lockdown-111/Lockdown-jumbo.jpg', 'height': 888, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/us/Lockdown-111/Lockdown-superJumbo.jpg', 'height': 1147, 'width': 1323, 'subType': 'superJumbo', 'crop_name': 'su