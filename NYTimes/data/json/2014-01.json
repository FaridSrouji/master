le': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Rebecca', 'middlename': None, 'lastname': 'Smith-Bindman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/aa6d065b-fda1-599a-8b3a-27d87123e064', 'word_count': 938, 'uri': 'nyt://article/aa6d065b-fda1-599a-8b3a-27d87123e064'}, {'abstract': 'American Bridge 21st Century, a well-funded organization that rakes up muck on Republican politicians, is sparing no expense to investigate the bridge scandal involving Gov. Chris Christie.', 'web_url': 'https://www.nytimes.com/2014/01/31/nyregion/anti-republican-group-digs-into-lane-closings.html', 'snippet': 'American Bridge 21st Century, a well-funded organization that rakes up muck on Republican politicians, is sparing no expense to investigate the bridge scandal involving Gov. Chris Christie.', 'lead_paragraph': 'The roster of organizations seeking documents related to the scheme to tie up traffic near the George Washington Bridge includes many of the usual suspects: newspapers, local broadcasters and TV networks.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Anti-Republican Group Digs Into Lane Closings', 'kicker': None, 'content_kicker': None, 'print_headline': 'Anti-Republican Group Digs Into Lane Closings', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'American Bridge 21st Century', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'McGeehan, Patrick', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, Christopher J', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Fort Lee (NJ)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Audio Recordings and Downloads', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'George Washington Bridge', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New Jersey', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-31T02:29:50+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Patrick McGeehan', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'McGeehan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f9abacab-083d-5407-966a-70610e3df7e3', 'word_count': 356, 'uri': 'nyt://article/f9abacab-083d-5407-966a-70610e3df7e3'}, {'abstract': 'President Obama should devote the remainder of his term to building governing structures for future presidents for years to come.', 'web_url': 'https://www.nytimes.com/2014/01/31/opinion/brooks-the-opportunity-coalition.html', 'snippet': 'President Obama should devote the remainder of his term to building governing structures for future presidents for years to come.', 'lead_paragraph': 'President Obama can spend the remainder of his term planting a few more high-tech hubs, working on reforming the patent law and doing the other modest things he mentioned in his State of the Union address. And if he did that, he might do some marginal good, and he would manage the stately decline of his presidency during its final few years.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2010/09/16/opinion/Brooks_New/Brooks_New-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2010/09/16/opinion/Brooks_New/Brooks_New-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2010/09/16/opinion/Brooks_New/Brooks_New-jumbo-v2.jpg', 'height': 500, 'width': 350, 'subType': 'jumbo', 'crop_nam