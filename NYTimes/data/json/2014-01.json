'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/228e35a5-a2f0-5bd9-b24d-bb0a215e23df', 'word_count': 745, 'uri': 'nyt://article/228e35a5-a2f0-5bd9-b24d-bb0a215e23df'}, {'abstract': 'Michael Poventud’s conviction for the attempted murder and attempted robbery of a Bronx cabdriver was reversed after he spent nine years in prison, but he pleaded guilty to a lesser charge.', 'web_url': 'https://www.nytimes.com/2014/01/17/nyregion/despite-a-guilty-plea-a-ruling-allows-a-man-to-sue-new-york-city.html', 'snippet': 'Michael Poventud’s conviction for the attempted murder and attempted robbery of a Bronx cabdriver was reversed after he spent nine years in prison, but he pleaded guilty to a lesser charge.', 'lead_paragraph': 'A federal appeals court ruled on Thursday that a man whose 1998 conviction for the attempted murder and attempted robbery of a Bronx livery cab driver was reversed but who later pleaded guilty to a lesser charge could still sue the city for violating his rights.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Despite a Guilty Plea, a Ruling Allows a Man to Sue New York City', 'kicker': None, 'content_kicker': None, 'print_headline': 'Despite Guilty Plea After Reversed Conviction, Court Rules That Man Can Sue City', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'False Arrests, Convictions and Imprisonments', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Poventud, Michael', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-17T03:31:31+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Benjamin Weiser', 'person': [{'firstname': 'Benjamin', 'middlename': None, 'lastname': 'Weiser', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ea5c814b-2593-58dc-90da-bd54755248b8', 'word_count': 619, 'uri': 'nyt://article/ea5c814b-2593-58dc-90da-bd54755248b8'}, {'abstract': 'British police officers, acting on intelligence information, arrested two women in London on Thursday on suspicion of terrorism offenses.', 'web_url': 'https://www.nytimes.com/2014/01/17/world/europe/british-police-arrest-2-women-in-terror-inquiry.html', 'snippet': 'British police officers, acting on intelligence information, arrested two women in London on Thursday on suspicion of terrorism offenses.', 'lead_paragraph': ' British police officers, acting on intelligence information, arrested two women in London on Thursday on suspicion of terrorism offenses. One was arrested at Heathrow Airport as she was preparing to fly to Istanbul, carrying a “large quantity of cash,” the police said. The second was arrested in northwest London on charges of “suspicion of being involved in the commission, preparation and instigation of acts of terrorism.” The British are carefully monitoring citizens who are trying to travel to Syria to fight or get training with radical Islamic groups or who return from there, usually through Turkey. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'British Police Arrest 2 Women in Terror Inquiry', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'Britain: Arrests in Terror Inquiry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Terrorism', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Erlanger, Steven', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Heathrow Airport (London)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-17T03:33:34+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Steven Erlanger', 'person': [{'firstname': 'Steven', 'middlename': None, 'lastname': 'Erlanger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/83b6b473-90e7-5dee-838e-a9a49f52c79c', 'word_count': 96, 'uri': 'nyt://article/83b6b473-90e7-5dee-838e-a9a49f52c79c'}, {'abstract': 'A scholar known for his criticism of the discrimination against Uighurs, a predominantly Muslim ethnic group, has been detained by the police, his wife said.', 'web_url': 'https://www.nytimes.com/2014/01/17/world/asia/china-uighur-scholar-detained.html', 'snippet': 'A scholar known for his criticism of the discrimination against Uighurs, a predominantly Muslim ethnic group, has been detained by the police, his wife said.', 'lead_paragraph': ' A Uighur scholar known for his criticism of the discrimination against Uighurs, a predominantly Muslim ethnic group, has been detained by the police, his wife said Thursday. The scholar, Ilham Tohti, a professor at Minzu University of China, was taken into custody when 30 to 40 police officers raided his Beijing apartment on Wednesday, said his wife, Guzaili Nu’er. Mr. Tohti, 44, has been one of a few intellectuals willing to speak publicly about what critics call shortcomings in the Communist Party’s management of the Uighur homeland in northwest China. A Foreign Ministry spokesman, Hong Lei, said at a regular news briefing on Thursday that Mr. Tohti had been “suspected of breaking the law,” Reuters reported. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'China: Uighur Scholar Detained', 'kicker': 'World Briefing | Asia', 'content_kicker': None, 'print_headline': 'China: Uighur Scholar Detained', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Tohti, Ilham', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Uighurs (Chinese Ethnic Group)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Discrimination', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-17T03:38:07+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'Brief', '_id': 'nyt://article/d13d6ef9-7d8e-56aa-aab7-3f7527078453', 'word_count': 116, 'uri': 'nyt://article/d13d6ef9-7d8e-56aa-aab7-3f7527078453'}, {'abstract': 'Turkish officials on Thursday reassigned 20 prosecutors working on a corruption inquiry that has targeted the inner circle of Prime Minister Recep Tayyip Erdogan.', 'web_url': 'https://www.nytimes.com/2014/01/17/world/europe/turkey-prosecutors-in-corruption-inquiry-reassigned.html', 'snippet': 'Turkish officials on Thursday reassigned 20 prosecutors working on a corruption inquiry that has targeted the inner circle of Prime Minister Recep Tayyip Erdogan.', 'lead_paragraph': ' The Turkish Supreme Board of Judges and Prosecutors on Thursday reassigned 20 high-ranking prosecutors working on a corruption inquiry that has targeted the inner circle of Prime Minister Recep Tayyip Erdogan. The reassignments included the chief prosecutor of Istanbul, who has led the inquiry, the biggest threat to Mr. Erdogan since he came to power a decade ago. It was the latest move in Mr. Erdogan’s attempt to quash the inquiry. He has called the investigation a plot against him and his party, which faces three elections in the next 18 months. ', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Turkey: Prosecutors in Corruption Inquiry Reassigned', 'kicker': 'World Briefing | Europe', 'content_kicker': None, 'print_headline': 'Turkey: Prosecutors Reassigned', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Erdogan, Recep Tayyip', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Yeginsu, Ceylan', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Turkey', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Corruption (Institutional)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-17T03:42:03+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Ceylan Yeginsu', 'person': [{'firstname': 'Ceylan', 'middlename': None, 'lastname': 'Yeginsu', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Brief', '_id': 'nyt://article/f1794c7d-eb94-5e20-9ae7-69e654fbe61a', 'word_count': 92, 'uri': 'nyt://article/f1794c7d-eb94-5e20-9ae7-69e654fbe61a'}, {'abstract': 'The residents of 9 Bleecker Street in Manhattan, a bastion of social activism for 40 years, are being forced to move because of foreclosure proceedings.', 'web_url': 'https://www.nytimes.com/2014/01/17/nyregion/emptying-a-building-long-home-to-activists.html', 'snippet': 'The residents of 9 Bleecker Street in Manhattan, a bastion of social activism for 40 years, are being forced to move because of foreclosure proceedings.', 'lead_paragraph': 'The three-story brick building at 9 Bleecker Street in Lower Manhattan, long a celebrated bastion of countercultural activity, was in a state of transitional disarray.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image'