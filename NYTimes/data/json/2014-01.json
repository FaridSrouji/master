5c-eb00-5d59-a0c6-23f0859994a8', 'word_count': 1207, 'uri': 'nyt://article/5de0055c-eb00-5d59-a0c6-23f0859994a8'}, {'abstract': 'Jaguar is using three British actors known for their roles as villains to give its F-Type coupe a sophisticated cool factor at the biggest ad event of the American calendar.', 'web_url': 'https://www.nytimes.com/2014/01/14/business/media/dastardly-british-and-brand-new-to-the-super-bowl.html', 'snippet': 'Jaguar is using three British actors known for their roles as villains to give its F-Type coupe a sophisticated cool factor at the biggest ad event of the American calendar.', 'lead_paragraph': 'PAUL REVERE is recalled for shouting — whether or not he really did — “The British are coming! The British are coming!” Repeat that another time and you will summarize the plot of the first commercial that Jaguar will run during a Super Bowl.', 'print_section': 'B', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/14/business/Adco/Adco-articleLarge.jpg', 'height': 380, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/14/business/Adco/Adco-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/14/business/Adco/Adco-jumbo.jpg', 'height': 648, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/14/business/Adco/Adco-superJumbo.jpg', 'height': 1296, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/14/business/Adco/Adco-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/14/business/Adco/Adco-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/14/business/Adco/Adco-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dastardly, British and Brand New to the Super Bowl', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dastardly, British and Brand New to the Super Bowl', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Elliott, Stuart', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Jaguar Land Rover', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Strong, Mark', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hiddleston, Tom', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Kingsley, Ben', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-01-14T02:04:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Stuart Elliott', 'person': [{'firstname': 'Stuart', 'middlename': None, 'lastname': 'Elliott', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7360595c-9141-583c-80d8-b7fb53325c55', 'word_count': 912, 'uri': 'nyt://article/7360595c-9141-583c-80d8-b7fb53325c55'}, {'abstract': 'A new decision from a federal bankruptcy judge is a potential game-changer in endless lawsuits.', 'web_url': 'https://www.nytimes.com/2014/01/14/opinion/nocera-the-asbestos-scam-part-2.html', 'snippet': 'A new decision from a federal bankruptcy judge is a potential game-changer in endless lawsuits.', 'lead_paragraph': 'Six weeks ago, I wrote a column about a ridiculous lawsuit being brought by Carolyn McCarthy, a congresswoman from Long Island. A smoker for most of her life, McCarthy has lung cancer. Yet her lawyers claimed that it was her “exposure” to asbestos, through the work clothes of her father and brother, both boilermakers, that triggered her cancer. Though McCarthy certainly deserves our sympathy as she fights cancer, it is hard to see her lawsuit as anything but an undeserved money grab — and the latest twist in asbestos litigation, the longest running tort in American history, with no end in sight.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/opinion/Nocera_New/Nocera_New-jumbo-v2.jpg', 'height': 975, 'width': 850, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/opinion/Nocera_New/Nocera_New-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/01/27/opinion/Nocera_New/Nocera_New-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/01/27/opinion/Nocera_New/Nocera_New-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Asbestos Scam, Part 2', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'The Asbestos Scam, Part 2', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'A