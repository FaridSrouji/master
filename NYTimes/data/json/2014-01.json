gs/scuttlebot/scuttlebot-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Today’s Scuttlebot: A World of Bitcoins and Unicorns, and the Anniversary of the iPhone', 'kicker': 'Bits', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-09T23:45:49+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/a5dc6e3c-ac90-5f14-92cc-9e7ce8298c6d', 'word_count': 257, 'uri': 'nyt://article/a5dc6e3c-ac90-5f14-92cc-9e7ce8298c6d'}, {'abstract': 'The number of Democrats and Republicans on the list was about even, with a median net worth of $1,008,767 for 2012, according to the analysis.', 'web_url': 'https://www.nytimes.com/2014/01/10/us/politics/more-than-half-the-members-of-congress-are-millionaires-analysis-finds.html', 'snippet': 'The number of Democrats and Republicans on the list was about even, with a median net worth of $1,008,767 for 2012, according to the analysis.', 'lead_paragraph': 'WASHINGTON — It is hardly the kind of news that lawmakers in Congress would want to highlight during a week when unemployment benefits expired for more than a million Americans. But Congress has achieved something of a milestone. ', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Half of Congress Members Are Millionaires, Report Says ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Half of Congress Members Are Millionaires, Report Says', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Economic Conditions and Trends', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'House of Representatives', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'High Net Worth Individuals', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-09T23:46:02+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Eric Lipton', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Lipton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dd2929e9-7b38-5bd3-a8ad-6df2583a36d5', 'word_count': 493, 'uri': 'nyt://article/dd2929e9-7b38-5bd3-a8ad-6df2583a36d5'}, {'abstract': 'Keeping a toddler away from someone else’s TV; regretting some teenage nastiness, decades later; when a friend doesn’t want your help.', 'web_url': 'https://www.nytimes.com/2014/01/12/fashion/Tech-vs-Tyke-social-qs.html', 'snippet': 'Keeping a toddler away from someone else’s TV; regretting some teenage nastiness, decades later; when a friend doesn’t want your help.', 'lead_paragraph': 'Unlike almost everyone we know, my husband and I do not allow our 3-year-old to watch TV or movies, or use smartphones, tablets or other devices. We feel that “screen time” is unhealthy, and so far, the policy has worked for our family. I avoid this topic with other parents because our choice implies a negative judgment about their choices. If the TV comes on at someone else’s house, we quietly excuse ourselves. But what should I say when another parent asks me about this directly?', 'print_section': 'ST', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tech vs. Tyke', 'kicker': None, 'content_kicker': None, 'print_headline': 'Tech vs. Tyke', 'name': None, 'seo': None, 'sub': None