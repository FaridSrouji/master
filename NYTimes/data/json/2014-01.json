ighting.', 'print_section': 'A', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Rebels Seize Portions of Strategic City in South Sudan', 'kicker': None, 'content_kicker': None, 'print_headline': 'Rebels Seize Portions of Strategic City in South Sudan', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kulish, Nicholas', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'South Sudan', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': "Sudan People's Liberation Army", 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Kiir Mayardit, Salva', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Machar, Riek', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Ethiopia', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Refugees and Displaced Persons', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-01T10:00:13+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Africa', 'byline': {'original': "By Nicholas Kulish and Isma'il Kushkush", 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kulish', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': "Isma'il", 'middlename': None, 'lastname': 'Kushkush', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7933c6b7-1942-508c-89ac-dfed2407dbd1', 'word_count': 891, 'uri': 'nyt://article/7933c6b7-1942-508c-89ac-dfed2407dbd1'}, {'abstract': 'Right-wing parties work across borders – to undermine the European Union.', 'web_url': 'https://www.nytimes.com/2014/01/02/opinion/europeans-united-in-hating-europe.html', 'snippet': 'Right-wing parties work across borders – to undermine the European Union.', 'lead_paragraph': 'LONDON — It may seem bizarre that two far-right, nationalist politicians — Ma