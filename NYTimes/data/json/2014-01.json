s/WINTER/WINTER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 474}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/20/sports/WINTER/WINTER-jumbo.jpg', 'height': 808, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/20/sports/WINTER/WINTER-superJumbo.jpg', 'height': 1616, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/20/sports/WINTER/WINTER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/20/sports/WINTER/WINTER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/20/sports/WINTER/WINTER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'U.S. Snowboarding Olympians Include Siblings', 'kicker': None, 'content_kicker': None, 'print_headline': 'U.S. Picks a Veteran Team for the Halfpipe in Sochi', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2014)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Snowboarding', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gold, Taylor', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gold, Arielle', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-20T02:21:51+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By John Branch', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Branch', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aa26ff2b-1948-51ac-957c-d511cc320b5b', 'word_count': 712, 'uri': 'nyt://article/aa26ff2b-1948-51ac-957c-d511cc320b5b'}, {'abstract': 'Aaron Kushner, publisher of The Orange County Register, has been playing hardball against distressed competitors and lustily grabbing for a bigger footprint.', 'web_url': 'https://www.nytimes.com/2014/01/20/business/media/publisher-stumbles-in-wild-chase-for-growth.html', 'snippet': 'Aaron Kushner, publisher of The Orange County Register, has been playing hardball against distressed competitors and lustily grabbing for a bigger footprint.', 'lead_paragraph': 'Timing matters when it comes to news. I had been reading about Aaron Kushner’s audacious strategy to invest in journalism ever since he bought The Orange County Register in 2012 for about $50 million and the assumption of $110 million in pension obligations. After years of covering layoffs, I wanted to write a different kind of tale about newspapers.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/20/business/carrjump1/carrjump1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/20/business/carrjump1/carrjump1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/20/business/carrjump1/carrjump1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/20/business/carrjump1/carrjump1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'super