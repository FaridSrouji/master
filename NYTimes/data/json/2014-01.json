th-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/health/29recipehealth/29recipehealth-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cabbage and Parmesan Soup With Barley', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Cabbage', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-27T15:31:56+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'recipe', '_id': 'nyt://article/55246e17-e7cc-58cb-b03d-4a23bc58360a', 'word_count': 379, 'uri': 'nyt://article/55246e17-e7cc-58cb-b03d-4a23bc58360a'}, {'abstract': 'A rich-tasting Eastern European pastry that isn’t rich at all.', 'web_url': 'https://www.nytimes.com/2014/01/30/health/cabbage-pirozhki.html', 'snippet': 'A rich-tasting Eastern European pastry that isn’t rich at all.', 'lead_paragraph': 'Of all the different fillings for the small oval Russian pies called pirozhki, cabbage has always been my favorite. The filling is a simple mixture of onions and cabbage, cooked in butter (traditionally in much more than I use here), until soft and sweet but not browned, then seasoned with dill, salt and pepper, and enriched with chopped hard-boiled eggs. I sometimes add a little ricotta to the mix. Traditional pirozhki dough is a rich pastry made with butter and sour cream. I tried my yeasted whole wheat olive oil pastry and it worked beautifully.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/health/30recipehealth/30recipehealth-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/30/health/30recipehealth/30recipehealth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/health/30recipehealth/30recipehealth-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/health/30recipehealth/30recipehealth-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/health/30recipehealth/30recipehealth-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/30/health/30recipehealth/30recipehealth-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/health/30recipehealth/30recipehealth-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cabbage Pirozhki', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value'