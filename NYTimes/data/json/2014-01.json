: None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gangs', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Archibold, Randal C', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Drug Abuse and Traffic', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Knights Templar', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Mexico', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Apatzingan (Mexico)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-17T01:25:56+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Randal C. Archibold', 'person': [{'firstname': 'Randal', 'middlename': 'C.', 'lastname': 'Archibold', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aca87fde-6146-5f75-9b18-1ebe8ea34bf9', 'word_count': 1015, 'uri': 'nyt://article/aca87fde-6146-5f75-9b18-1ebe8ea34bf9'}, {'abstract': 'Simple lace-up shoes get a lift with the addition of a modest platform.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/01/16/threes-a-trend-thick-soles-for-sleek-silhouettes/', 'snippet': 'Simple lace-up shoes get a lift with the addition of a modest platform.', 'lead_paragraph': 'The recent rise of the straightforward, unadorned black lace-up shoe has accompanied the growing turn toward minimalism in men’s wear, helping to balance the proportions of an outfit. But it’s the simple shoes with a heavier, thicker sole — less a ’70s revival and more a new platform style this season — that stand out this season. In Paris, Pierre Hardy presented a beautifully refined pair of double-soled shoes in two contrasting black leathers. He explained that they weren’t quite high enough during the first round of sampling, so he had to go back to the factory for a little retooling. “We can all use a little bit of height,” he said, smiling. In Milan, the platform lace-ups at Marni were a bit chunkier, giving a little extra lift. And monochromatic polka dots were applied to some of the thick soles at Jil Sander, adding some nice surface interest and texture.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/t-magazine/16trend-platforms-pask/16trend-platforms-pask-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/16/t-magazine/16trend-platforms-pask/16trend-platforms-pask-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/t-magazine/16trend-platforms-pask/16trend-platforms-pask-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/t-magazine/16trend-platforms-pask/16trend-platforms-pask-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/t-magazine/16trend-platforms-pask/16trend-platforms-pask-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/16/t-magazine/16trend-platforms-pask/16trend-platforms-pask-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/t-magazine/16trend-platforms-pask/16trend-platforms-pask-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thu