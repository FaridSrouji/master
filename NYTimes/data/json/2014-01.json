mes', 'multimedia': [], 'headline': {'main': 'Winter Olympians to Follow on Instagram', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2014)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Instagram Inc', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Ligety, Ted', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Hendrickson, Sarah', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'White, Shaun', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Lolo', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-31T20:06:40+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Talya Minsberg', 'person': [{'firstname': 'Talya', 'middlename': None, 'lastname': 'Minsberg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/87b6a4b4-f4de-5898-ab94-0d49416bfb95', 'word_count': 1168, 'uri': 'nyt://article/87b6a4b4-f4de-5898-ab94-0d49416bfb95'}, {'abstract': 'A three-day discussion of issues that ended Friday did not result in concrete decisions on pressing matters facing lawmakers.', 'web_url': 'https://www.nytimes.com/2014/02/01/us/politics/conference-offers-no-clear-path-forward-for-house-republicans.html', 'snippet': 'A three-day discussion of issues that ended Friday did not result in concrete decisions on pressing matters facing lawmakers.', 'lead_paragraph': 'CAMBRIDGE, Md. — House Republicans ended a three-day retreat here united in their division. They agreed they wanted to “go big” with a midterm election agenda that would give voters a clear choice, and not simply be a campaign focused on their criticism of President Obama.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'After Meeting, Republicans Seem Unsure of Way Forward', 'kicker': None, 'content_kicker': None, 'print_headline': 'After Meeting, Republicans Seem Unsure of Way Forward', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Republican Party', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Patient Protection and Affordable Care Act (2010)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'National Debt (US)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Tax Credits, Deductions and Exemptions', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-31T20:07:06+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Jonathan Weisman', 'person': [{'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Weisman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/555d178e-ab54-5fc2-9b72-0f702990d4be', 'word_count': 651, 'uri': 'nyt://article/555d178e-ab54-5fc2-9b72-0f702990d4be'}, {'abstract': 'A day in the life of armed America.', 'web_url': 'https://nocera.blogs.nytimes.com/2014/01/31/the-gun-report-january-31-2014/', 'snippet': 'A day in the life of armed America.', 'lead_paragraph': 'On Jan. 6, Todd Kuchman and his brother, Jaye, founders of the Denver-based Advanced Ballistic Concepts, launched the multiple impact bullet, a 3-shots-in-1 round that splits into several fragments. Meant for self-defense, the shrapnel is held together by a Y-shaped ballistic-strength fiber, which makes for better accuracy than a shotgun’s blast of pellets, thus minimizing the chances of hitting unintended people or things. The company’s slogans include, “Because you can’t afford to miss” and “First hit advantage is everything!”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/opinion/bullets/bullets-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/31/opinion/bullets/bullets-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/opinion/bullets/bullets-jumbo.jpg', 'height': 600, 'width': 800, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/opinion/bullets/bullets-superJumbo.jpg', 'height': 600, 'width': 800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/opinion/bullets/bullets-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/31/opinion/bullets/bullets-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/opinion/bullets/bullets-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Gun Report: January 31, 2014', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-31T20:07:57+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Mascia', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname':