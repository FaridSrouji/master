s/2014/01/19/automobiles/19detroit/19detroit-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/19detroit/19detroit-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/19detroit/19detroit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/19/automobiles/19detroit/19detroit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/automobiles/19detroit/19detroit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Outside Convention Hall, New Cars Often Aren’t on the Mind', 'kicker': 'Detroit Auto Show', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Detroit (Mich)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'North American International Auto Show', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Bankruptcies', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-18T05:14:42+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Automobiles', 'subsection_name': 'Automobiles', 'byline': {'original': 'By Mary M. Chapman', 'person': [{'firstname': 'Mary', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ace96ba7-8530-51b0-a30d-aeae52d395e3', 'word_count': 1019, 'uri': 'nyt://article/ace96ba7-8530-51b0-a30d-aeae52d395e3'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/01/18/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '9 P.M. (Showtime) SILVER LININGS PLAYBOOK (2012) Pat Solatano (Bradley Cooper, above), who has returned to the home of his parents (Jacki Weaver and Robert De Niro) after eight months in a mental institution, following a violent crime, tries to tackle the world — and reclaim his estranged wife, Nikki, who took out a restraining order against him — through a physical and psychological regimen he created while locked away. Then he meets Tiffany (Jennifer Lawrence), a heartbreaker who persuades Pat that she can circumvent the law by passing a letter from him to Nikki — if only he’ll enter a dance contest with her. Soon, she is leading, and he is following. “For all its high-flying zaniness, the movie has the sting of life, and its humor feels dredged up from the same dark, boggy place from which Samuel Beckett extracted his yuks,” Manohla Dargis wrote in The New York Times about this best picture Oscar nominee directed by David O. Russell, which also earned nominations for Mr. Cooper, Ms. Weaver and Mr. De Niro, and a win for Ms. Lawrence. “\xa0‘Silver Linings Playbook’ is crammed with people talking and shouting and weeping and also yielding to what are sometimes called boundary issues but which here turn out to be the mad, loving scrambling of people finding and saving one another,” Ms. Dargis added. “These are characters who get in one another’s faces and occasionally punch a loved one right in the kisser. They must go on, they can’t go on, but together they do.”', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Saturday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-18T06:00:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/e275dd8f-64ad-5c08-a566-f6f7b7fe27d4', 'word_count': 738, 'uri': 'nyt://article/e275dd8f-64ad-5c08-a566-f6f7b7fe27d4'}, {'abstract': 'Kabul during the Afghan war was never violent as Baghdad during the Iraq war. But as coalition forces leave, international workers here feel more vulnerable.', 'web_url': 'https://www.nytimes.com/2014/01/19/world/asia/afghanistan-restaurant-attack.html', 'snippet': 'Kabul during the Afghan war was never violent as Baghdad during the Iraq war. But as coalition forces leave, international workers here feel more vulnerable.', 'lead_paragraph': 'KABUL, Afghanistan — As country director for the International Monetary Fund, Wabel Abdallah spent years navigating the shoals of scandal in Afghanistan’s financial sector. Vadim Nazarov, a top political officer at the United Nations, dedicated himself over the past nine years to looking for a peaceful solution to the Afghan war. Dhamender Singh Phangurha, a British candidate in the coming elections for the European Parliament, was here on a consulting contract.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/world/SUB-AFGHANISTAN-2a/SUB-AFGHANISTAN-2-1390061401518-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/19/world/SUB-AFGHANISTAN-2a/SUB-AFGHANISTAN-2-1