}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Butterworth, Jez', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jackman, Hugh', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-17T16:36:05+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Patrick Healy', 'person': [{'firstname': 'Patrick', 'middlename': None, 'lastname': 'Healy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ce2a4080-cafd-58a3-9b8a-6638b5d6ba89', 'word_count': 338, 'uri': 'nyt://article/ce2a4080-cafd-58a3-9b8a-6638b5d6ba89'}, {'abstract': 'Nancy Horan’s second historical novel reimagines another tempestuous love story.', 'web_url': 'https://www.nytimes.com/2014/01/19/books/review/under-the-wide-and-starry-sky-by-nancy-horan.html', 'snippet': 'Nancy Horan’s second historical novel reimagines another tempestuous love story.', 'lead_paragraph': 'Nancy Horan’s first novel, “Loving Frank,” explored the tangled personal life of Frank Lloyd Wright. Now, in her second, she takes a deep, long look at the intimate history of yet another creative man. This time, the action is viewed from two perspectives — those of Robert Louis Stevenson and (even more so) of his American wife, Fanny Van de Grift Osbourne, who hopes to be a painter or a writer herself. “Under the Wide and Starry Sky” is at once a classic artistic bildungsroman and a retort to the genre, a novel that shows how love and marriage can simultaneously offer inspiration and encumbrance, especially when the more successful partner believes that, as far as artists go, “a family could tolerate only one.” The Stevensons’ story is full of morbidity and sacrifice, chronicling losses and gains — and, of course, the writing of classics like “Treasure Island,” “Dr. Jekyll and Mr. Hyde” and “Kidnapped,” none of which, Horan suggests, would have been possible without Fanny Stevenson’s careful nurturing of her husband.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/books/review/19cokal/19cokal-articleLarge.jpg', 'height': 382, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/19/books/review/19cokal/19cokal-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 382}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/books/review/19cokal/19cokal-jumbo.jpg', 'height': 651, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/books/review/19cokal/19cokal-superJumbo.jpg', 'height': 773, 'width': 1215, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/books/review/19cokal/19cokal-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/19/books/review/19cokal/19cokal-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/books/review/19cokal/19cokal-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Sickness and in Health', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Sickness and in Health', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Horan, Nancy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', '