type_of_material': 'Review', '_id': 'nyt://article/36a2d88e-7339-51e4-b3bb-7533a189401e', 'word_count': 541, 'uri': 'nyt://article/36a2d88e-7339-51e4-b3bb-7533a189401e'}, {'abstract': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'web_url': 'https://www.nytimes.com/2014/01/13/business/treasury-auctions-set-for-the-week-of-jan-13.html', 'snippet': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'lead_paragraph': 'The Treasury’s schedule of financing this week includes Monday’s regular weekly auction of new three- and six-month bills and an auction of four-week bills on Tuesday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Treasury Auctions Set for the Week of Jan. 13', 'kicker': None, 'content_kicker': None, 'print_headline': 'Treasury Auctions Set for This Week', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'States (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Credit and Debt', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-12T22:42:39+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Economy', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4cfe813d-1362-5ee4-bdf2-0f6e62c21ffc', 'word_count': 387, 'uri': 'nyt://article/4cfe813d-1362-5ee4-bdf2-0f6e62c21ffc'}, {'abstract': '“Chozen,” an animated comedy on FX, follows the adventures of a gay white rapper after he leaves prison.', 'web_url': 'https://www.nytimes.com/2014/01/13/arts/television/chozen-an-animated-series-on-fx-features-bobby-moynihan.html', 'snippet': '“Chozen,” an animated comedy on FX, follows the adventures of a gay white rapper after he leaves prison.', 'lead_paragraph': 'Animation is best suited for what might not be believable, even if seen. And our era of extreme progressivism notwithstanding, the idea of a gay white hip-hop thug still remains, for many, the stuff of fantasy.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/chozen/chozen-articleLarge.jpg', 'height': 338, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/arts/chozen/chozen-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/chozen/chozen-jumbo.jpg', 'height': 577, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/chozen/chozen-superJumbo.jpg', 'height': 1075, 'width': 1907, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/chozen/chozen-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/13/arts/chozen/chozen-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/chozen/chozen-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Not Just Another Ex-Con Hoping for Hip-Hop Glory', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Not Just Another Ex-Con Hoping for Hip-Hop Glory', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'FX (TV Network)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Moynihan, Bobby', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-12T22:43:35+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Jon Caramanica', 'person': [{'firstname': 'Jon', 'middlename': None, 'lastname': 'Caramanica', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8f341522-b31a-56ef-8b65-b55484cd8acc', 'word_count': 409, 'uri': 'nyt://article/8f341522-b31a-56ef-8b65-b55484cd8acc'}, {'abstract': 'The illusionist Andrew Mayne combines small pranks with his tricks on this new A&E show.', 'web_url': 'https://www.nytimes.com/2014/01/13/arts/television/dont-trust-andrew-mayne-on-ae.html', 'snippet': 'The illusionist Andrew Mayne combines small pranks with his tricks on this new A&E show.', 'lead_paragraph': 'Some skills aren’t particularly television friendly, and magic, especially the small-scale kind like the card trick, is one of them. If you’re not witnessing it live at fairly close range, you have to take it on faith that something magical happened, and that no camera manipulation was involved. ', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/mayne/mayne-articleLarge.jpg', 'height': 477, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/arts/mayne/mayne-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 477}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/mayne/mayne-jumbo.jpg', 'height': 814, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/mayne/mayne-superJumbo.jpg', 'height': 834, 'width': 1049, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/mayne/mayne-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/13/arts/mayne/mayne-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/mayne/mayne-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Now You See the Motorcycle, Now You Don’t', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'Now You See the Motorcycle, Now You Don’t', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Magic and Magicians', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'ARTS & ENTERTAINMENT NETWORK', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Mayne, Andrew', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-12T22:45:13+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/68bcaeff-9b16-59d6-b697-6f4941dab1e5', 'word_count': 238, 'uri': 'nyt://article/68bcaeff-9b16-59d6-b697-6f4941dab1e5'}, {'abstract': 'JPMorgan Chase and Wells Fargo, set to report fourth-quarter results on Tuesday, will kick off a flurry of bank earnings, and Intel will post its fourth-quarter results.', 'web_url': 'https://www.nytimes.com/2014/01/13/business/economic-reports-for-the-week-of-jan-13.html', 'snippet': 'JPMorgan Chase and Wells Fargo, set to report fourth-quarter results on Tuesday, will kick off a flurry of bank earnings, and Intel will post its fourth-quarter results.', 'lead_paragraph': 'BANK EARNINGS JPMorgan Chase and Wells Fargo, set to report fourth-quarter results on Tuesday, will kick off a flurry of bank earnings. The banking giants, analysts say, will most likely face sluggish demand from borrowers whose appetite for refinancing has been sapped by rising rates. For JPMorgan Chase, the nation’s largest bank, the quarterly report comes after a string of costly government settlements, prompting analysts to predict that high legal costs could hamper profit. All told, JPMorgan will have paid some $20 billion to resolve government investigations in the last 12 months alone. ', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Economic Reports for the Week of Jan. 13', 'kicker': None, 'content_kicker': None, 'print_headline': 'Looking Ahead', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Company Reports', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'JPMorgan Chase & Company', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Wells Fargo & Company', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Intel Corporation', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-12T22:47:44+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/140de9d1-fdba-5b10-b7b9-b99ad5dd3cd4', 'word_count': 232, 'uri': 'nyt://article/140de9d1-fdba-5b10-b7b9-b99ad5dd3cd4'}, {'abstract': '“El Año en Que Nací (The Year I Was Born)” examines Chile’s tumultuous history through the eyes of artists born during Augusto Pinochet’s rule.', 'web_url': 'https://www.nytimes.com/2014/01/13/theater/the-year-i-was-born-at-la-mamas-ellen-stewart-theater.html', 'snippet': '“El Año en Que Nací (The Year I Was Born)” examines Chile’s tumultuous history through the eyes of artists born during Augusto Pinochet’s rule.', 'lead_paragraph': 'Among indicators of an actor’s commitment, here’s an impressive one: sticks with a production despite a parent refusing contact as a result. Such (spoiler alert) has been the consequence for Viviana Hernández in “El Año en Que Nací (The Year I Was Born),” a play by the Argentine director Lola Arias playing at La MaMa as part of the Public Theater’s Under the Radar Festival. It makes sense that Ms. Hernández would stay; she is, after all, telling the story of her life in this production, in which nine Chileans, born between 1976 and 1984, knit together a history both sweeping and deeply intimate. ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/BORN/BORN-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/arts/BORN/BORN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/BORN/BORN-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/BORN/BORN-superJumbo.jpg', 'height': 1369, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/BORN/BORN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/13/arts/BORN/BORN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/BORN/BORN-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Talking About Their (Iron-Fisted) Generation', 'kicker': 'Theater Review', 'content_kicker': None, 'print_headline': 'Talking About Their (Iron-Fisted) Generation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'La Rocco, Claudia', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Under the Radar Festival', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Chile', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Arias, Lola', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Public Theater', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-12T22:49:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Theater', 'byline': {'original': 'By Claudia La Rocco', 'person': [{'firstname': 'Claudia', 'middlename': None, 'lastname': 'La Rocco', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8f1fd4d8-3f91-581f-8631-07ba3ff4238a', 'word_count': 335, 'uri': 'nyt://article/8f1fd4d8-3f91-581f-8631-07ba3ff4238a'}, {'abstract': '“Revolutionary,” by Alex Myers, is a novel based on the true story of a woman who fought as a man in the Revolutionary War.', 'web_url': 'https://www.nytimes.com/2014/01/13/books/in-revolutionary-by-alex-myers-a-woman-fights-as-a-man.html', 'snippet': '“Revolutionary,” by Alex Myers, is a novel based on the true story of a woman who fought as a man in the Revolutionary War.', 'lead_paragraph': 'Deborah Samson is 22 and free of indenture, but addicted to adventure. She has left the church, and yet she is a believer of sorts, in independence for the American colonies and for herself. She recoils at orders to serve at table, and yet she yearns to serve in arms. ', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/book/book-articleLarge.jpg', 'height': 667, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/arts/book/book-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 667}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/book/book-jumbo.jpg', 'height': 1024, 'width': 922, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/book/book-superJumbo.jpg', 'height': 1088, 'width': 979, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/book/book-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/13/arts/book/book-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/book/book-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Personal Revolution Is Set Amid an Epic One', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Personal Revolution Is Set Amid an Epic One', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Revolutionary War, American (1775-83)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Myers, Alex', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-12T22:52:22+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Books', 'byline': {'original': 'By David M. Shribman', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/57560ed5-9ffa-59f5-90b6-37d3fbf2ddf8', 'word_count': 1031, 'uri': 'nyt://article/57560ed5-9ffa-59f5-90b6-37d3fbf2ddf8'}, {'abstract': 'The Bronx Opera Company opened its 47th season on Saturday with “The Rivals,” a 2002 comic opera by Kirke Mechem.', 'web_url': 'https://www.nytimes.com/2014/01/13/arts/music/bronx-opera-companys-the-rivals-at-the-kaye-playhouse.html', 'snippet': 'The Bronx Opera Company opened its 47th season on Saturday with “The Rivals,” a 2002 comic opera by Kirke Mechem.', 'lead_paragraph': 'At a time when opportunities for gifted emerging opera composers blazing all manner of new stylistic trails appear to be proliferating, there’s something to be said for a company willing to go to bat for fresh pieces by veteran creators working in conventional modes. Not long ago, that company likely would have been the Dicapo Opera, which performed an estimable service in championing composers like Thomas Pasatieri, Tobias Picker and Conrad Susa.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/rivals/rivals-articleLarge.jpg', 'height': 376, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/arts/rivals/rivals-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 376}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/rivals/rivals-jumbo.jpg', 'height': 641, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/rivals/rivals-superJumbo.jpg', 'height': 1282, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/rivals/rivals-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/13/arts/rivals/rivals-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/rivals/rivals-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Playing Composer, of Course, to Impress', 'kicker': 'Opera Review', 'content_kicker': None, 'print_headline': 'Playing Composer, of Course, to Impress', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mechem, Kirke', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Bronx Opera Company', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-12T22:54:24+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Steve Smith', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7a975349-02df-5659-89fe-d92be213a621', 'word_count': 519, 'uri': 'nyt://article/7a975349-02df-5659-89fe-d92be213a621'}, {'abstract': 'In an appreciation, Questlove, a founder of the Roots, talks about the influence Amiri Baraka had on him.', 'web_url': 'https://www.nytimes.com/2014/01/13/arts/music/questlove-reflects-on-amiri-baraka.html', 'snippet': 'In an appreciation, Questlove, a founder of the Roots, talks about the influence Amiri Baraka had on him.', 'lead_paragraph': 'I’m not the right age for Amiri Baraka, not exactly. Or rather: I’m not the right age to have seen his changes as they happened. Mr. Baraka, who died last week at 79, passed through so many different phases, from middle-class kid in Newark to aspiring Beat poet to founder of the Black Arts movement to leftist activist to academic. For me, he arrived as an author looking back, already armed with his own self-reflection: He published his memoir, “The Autobiography of LeRoi Jones,” in 1984, when I was in high school, though the book didn’t make its way into my hands or my brain until a few years after that.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/jpbaraka/jpbaraka-articleLarge.jpg', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/arts/jpbaraka/jpbaraka-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/jpbaraka/jpbaraka-jumbo.jpg', 'height': 679, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/jpbaraka/jpbaraka-superJumbo.jpg', 'height': 1358, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/jpbaraka/jpbaraka-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/13/arts/jpbaraka/jpbaraka-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/arts/jpbaraka/jpbaraka-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Baraka, Inspiration Came With Provocation', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Baraka, Inspiration Came With Provocation', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Poetry and Poets', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Questlove', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Baraka, Amiri', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Questlove', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Thompson, Ahmir (Questlove)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-12T22:57:27+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Questlove', 'person': [{'firstname': 'Questlove', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_ma