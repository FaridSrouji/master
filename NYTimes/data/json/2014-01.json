ew York Times', 'multimedia': [], 'headline': {'main': 'If Justin Bieber Weren’t Famous', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Deportation', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Bieber, Justin', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-23T19:29:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew Rosenthal', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Rosenthal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/471f8b69-d85b-514e-87c9-5be9789836ad', 'word_count': 404, 'uri': 'nyt://article/471f8b69-d85b-514e-87c9-5be9789836ad'}, {'abstract': 'President Obama will send his annual budget to Congress on March 4.', 'web_url': 'https://thecaucus.blogs.nytimes.com/2014/01/23/administration-is-finalizing-budget/', 'snippet': 'President Obama will send his annual budget to Congress on March 4.', 'lead_paragraph': 'President Obama will send his annual budget to Congress on March 4, about a month late because of lawmakers’ tardy agreement on the current fiscal year’s federal spending.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Administration Is Finalizing Budget', 'kicker': 'The Caucus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Office of Management and Budget (US)', 'rank': 4, 'major': 'N'}],