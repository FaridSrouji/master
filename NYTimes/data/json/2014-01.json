nt_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McDonnell, Robert F', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Jonnie R Sr', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Virginia', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-22T22:35:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Francis X. Clines', 'person': [{'firstname': 'Francis', 'middlename': 'X.', 'lastname': 'Clines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9da424b9-1452-52a2-bf8d-b72f4d326c0e', 'word_count': 286, 'uri': 'nyt://article/9da424b9-1452-52a2-bf8d-b72f4d326c0e'}, {'abstract': 'Only three teams entered the women’s under-26 trial in Atlanta at the beginning of this month.', 'web_url': 'https://www.nytimes.com/2014/01/23/crosswords/bridge/the-womens-under-26-trial-for-world-youth-teams.html', 'snippet': 'Only three teams entered the women’s under-26 trial in Atlanta at the beginning of this month.', 'lead_paragraph': 'Only three teams entered the women’s under-26 trial in Atlanta at the beginning of this month. A round robin eliminated one, and the other two played a 96-board match to determine the American entry in the World Youth Teams Championships.', 'print_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/23/arts/23cards-1/23cards-1-jumbo.jpg', 'height': 664, 'width': 331, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/23/arts/23cards-1/23cards-1-superJumbo.jpg', 'height': 664, 'width': 331, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'lega