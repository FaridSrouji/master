edia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/dbpix-target/dbpix-target-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/28/business/dbpix-target/dbpix-target-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/dbpix-target/dbpix-target-jumbo.jpg', 'height': 680, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/dbpix-target/dbpix-target-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/dbpix-target/dbpix-target-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/28/business/dbpix-target/dbpix-target-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/dbpix-target/dbpix-target-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Adding Up the Costs of Data Breaches', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Computer Security', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Credit Cards', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Customer Relations', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cyberattacks and Hackers', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Identity Theft', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Shopping and Retail', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Blumenthal, Richard', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Michaels Stores Inc', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Neiman Marcus Group', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'Target Corporation', 'rank': 10, 'major': 'N'}, {'name': 'organizations', 'value': 'World Economic Forum', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Eastern Europe', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 14, 'major': 'N'}], 'pub_date': '2014-01-28T14:16:18+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Peter J. Henning', 'person': [{'firstname': 'Peter', 'middlename': 'J.', 'lastname': 'Henning', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9bc727ce-ae6a-583a-81a9-1d39441b9afc', 'word_count': 903, 'uri': 'nyt://article/9bc727ce-ae6a-583a-81a9-1d39441b9afc'}, {'abstract': 'A new Marais hot spot serves multicourse meals of sweet (and not-so-sweet) treats.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/01/28/food-matters-a-paris-restaurant-where-dessert-is-whats-for-dinner/', 'snippet': 'A new Marais hot spot serves multicourse meals of sweet (and not-so-sweet) treats.', 'lead_paragraph': '“It’s time to rethink the conventions of a meal,” says the French restauranteur Philippe Baranes. That’s just what he’s done with Paris’s first all-desserts restaurant, Dessance — the name is a neologism that combines ‘dessert’ with the French word for birth, ‘naissance’ — which recently opened in a 17th-century townhouse in the city’s Marais district. “Some people find it confusing or even disturbing, but there’s no reason a dish can’t be savory and sweet at the same time,” he says. “My idea was to break the cloisonnéd way in which we think about food.” The menu at Dessance doesn’t run toward the pastries, cakes and tarts that a desserts-only concept might imply, but rather offers a small but intriguing collection of dishes that can be eaten as both desserts and main courses, including, for example, a surprising combination of violet-colored vitelotte potato purée with raw and poached apples, arugula and marjoram granité.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/t-magazine/28dessance-lobrano1/28dessiance-lobrano1-articleLarge.jpg', 'height': 773, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/28/t-magazine/28dessance-lobrano1/28dessiance-lobrano1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 773}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/t-magazine/28dessance-lobrano1/28dessiance-lobrano1-jumbo.jpg', 'height': 1024, 'width': 795, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/t-magazine/28dessance-lobrano1/28dessiance-lobrano1-superJumbo.jpg', 'height': 2048, 'width': 1590, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/t-magazine/28dessance-lobrano1/28dessiance-lobrano1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/28/t-magazine/28dessance-lobrano1/28dessiance-lobrano1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/t-magazine/28dessance-lobrano1/28dessiance-lobrano1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Food Matters | A Paris Restaurant Where Dessert Is What’s for Dinner', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Paris (France)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-01-28T14:37:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alec Lobrano', 'person': [{'firstname': 'Alec', 'middlename': None, 'lastname': 'Lobrano', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9df148a2-372a-52e4-a0c8-4a7079e990f8', 'word_count': 634, 'uri': 'nyt://article/9df148a2-372a-52e4-a0c8-4a7079e990f8'}, {'abstract': 'Filmmakers are invited to submit music videos for one of three recently released songs to win a prize of $10,000.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/01/28/tribeca-film-festival-starts-a-music-video-contest/', 'snippet': 'Filmmakers are invited to submit music videos for one of three recently released songs to win a prize of $10,000.', 'lead_paragraph': 'The Tribeca Film Festival is collaborating with Genero, a company that makes connections between musicians and filmmakers on a contest that it is calling “Tribeca Interactive & Interlude: A Music Film Challenge.” The idea: make a music video for one of three recently released songs — Damon Albarn’s “Heavy Seas of Love,” Aloe Blacc’s “Ticking Bomb” or Ellie Goulding’s “Dead in the Water.” The prize, one for each song, is $10,000 and a trip to New York to attend the festival, which runs April 16 to 27. And the videos will be used in the promotional campaigns for the recordings.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tribeca Film Festival Starts a Music Video Contest', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tribeca Film Festival (NYC)', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-01-28T15:00:00+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ab4e014e-2dcb-5910-8269-23cae9011f32', 'word_count': 279, 'uri': 'nyt://article/ab4e014e-2dcb-5910-8269-23cae9011f32'}, {'abstract': 'The Royal Bank of Scotland will reduce the range of foreign exchange benchmarks it offers to clients amid investigations by regulators into whether traders at some of the world’s largest banks colluded to manipulate the $5-trillion-a-day currency markets.', 'web_url': 'https://dealbook.nytimes.com/2014/01/28/r-b-s-to-reduce-foreign-exchange-benchmark-offerings/', 'snippet': 'The Royal Bank of Scotland will reduce the range of foreign exchange benchmarks it offers to clients amid investigations by regulators into whether traders at some of the world’s largest banks colluded to manipulate the $5-trillion-a-day currency ...', 'lead_paragraph': 'LONDON – The Royal Bank of Scotland said on Tuesday that it would reduce the range of foreign exchange benchmarks it offers to clients who trade currency markets.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/