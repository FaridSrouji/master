umbo-v2.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/02/world/02Israel2/02Israel2-superJumbo-v2.jpg', 'height': 1152, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/02/world/02Israel2/02Israel2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/02/world/02Israel2/02Israel2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/02/world/02Israel2/02Israel2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sticking Point in Peace Talks: Recognition of a Jewish State', 'kicker': 'Memo From Jerusalem', 'content_kicker': None, 'print_headline': 'Sticking Point in Peace Talks: Recognition of a Jewish State', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rudoren, Jodi', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Israel', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Netanyahu, Benjamin', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Palestinians', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Jerusalem (Israel)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-02T04:55:44+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Jodi Rudoren', 'person': [{'firstname': 'Jodi', 'middlename': None, 'lastname': 'Rudoren', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8b539b41-8bf7-53b9-a4c7-4127aac8c96b', 'word_count': 1277, 'uri': 'nyt://article/8b539b41-8bf7-53b9-a4c7-4127aac8c96b'}, {'abstract': 'Even as Mario Testino pays tribute to the traditional costumes of his native country, a number of current designers are taking cue from Peru’s style legacy.', 'web_url': 'https://www.nytimes.com/2014/01/02/t-magazine/peruvian-style-gets-a-contemporary-update.html', 'snippet': 'Even as Mario Testino pays tribute to the traditional costumes of his native country, a number of current designers are taking cue from Peru’s style legacy.', 'lead_paragraph': 'Mario Testino isn’t the only notable celebrating Peruvian style right now. In his exhibition “Alta Moda,” on view now through March 29 at the Queen Sofia Spanish Institute in New York, the fashion photographer celebrates the country’s early ornate fashion with a series of images of its traditional costumes. Meanwhile, fashion designers are adding to the country’s style legacy, taking cues from early and modern Peruvian artisans. Saturated colors, rich textures and intricate detailing have become urban-jungle-friendly thanks to a slew of ready-to-wear pieces and accessories, like Chloé’s nubby boucle sheath in playful pastels and Tabitha Simmons’s multicolored Peruvian silk espadrilles. Pom poms, tassels and beads appear on many of the playful accessories, including a knit bag from Mochila and a handmade clutch from the Muzungu Sisters, which could almost pass for souvenirs from a trip to Machu Picchu.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/02/t-magazine/02market-barsamian/02market-barsamian-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/02/t-magazine/