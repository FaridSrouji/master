'major': 'N'}], 'pub_date': '2014-01-14T02:16:25+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Middle East', 'byline': {'original': 'By Mark Landler and Jonathan Weisman', 'person': [{'firstname': 'Mark', 'middlename': None, 'lastname': 'Landler', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jonathan', 'middlename': None, 'lastname': 'Weisman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad2c8813-ab0b-5694-9213-509640b58441', 'word_count': 1107, 'uri': 'nyt://article/ad2c8813-ab0b-5694-9213-509640b58441'}, {'abstract': 'The Supreme Court left a good ruling alone when it let stand the rejection of Arizona’s 20-week abortion ban.', 'web_url': 'https://www.nytimes.com/2014/01/14/opinion/abortion-rights-a-good-ruling-stands.html', 'snippet': 'The Supreme Court left a good ruling alone when it let stand the rejection of Arizona’s 20-week abortion ban.', 'lead_paragraph': 'The Supreme Court made a good call, announced on Monday, not to review a 2013 ruling by the United States Court of Appeals for the Ninth Circuit, which struck down Arizona’s 20-week abortion ban as unconstitutional. For women in Arizona, the appellate ruling is critically important in protecting their reproductive rights. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Abortion Rights: A Good Ruling Stands', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'They Left a Good Ruling Alone', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'ARIZONA', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-14T02:16:43+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/b3293f8b-1b48-5858-878d-3188ffc376c2', 'word_count': 347, 'uri': 'nyt://article/b3293f8b-1b48-5858-878d-3188ffc376c2'}, {'abstract': 'The Supreme Court should uphold sensible buffer zones at health clinics.', 'web_url': 'https://www.nytimes.com/2014/01/14/opinion/abortion-rights-uphold-buffer-zones.html', 'snippet': 'The Supreme Court should uphold sensible buffer zones at health clinics.', 'lead_paragraph': 'Abortion is one of the most emotionally fraught issues in American society, and public discussion often turns into an attack on the women who choose to exercise their constitutionally protected rights. ', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Abortion Rights: Uphold Buffer Zones', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Abortion Rights Before the Court', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Massachusetts', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-14T02:21:18+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/7005