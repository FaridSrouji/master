e New York Times', 'multimedia': [], 'headline': {'main': 'Is It Love, or Stockholm Syndrome?', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Is It Love, or Stockholm Syndrome?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Reitman, Jason', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Winslet, Kate', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Brolin, Josh', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Maguire, Tobey', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Labor Day (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-30T23:07:19+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/53211601-0142-5da5-8248-f06ac8abeb9d', 'word_count': 731, 'uri': 'nyt://article/53211601-0142-5da5-8248-f06ac8abeb9d'}, {'abstract': 'Questions about laundry equipment; an heir’s access to a deceased shareholder’s apartment; and who pays for window replacement in a co-op.', 'web_url': 'https://www.nytimes.com/2014/02/02/realestate/why-cant-i-have-a-washing-machine.html', 'snippet': 'Questions about laundry equipment; an heir’s access to a deceased shareholder’s apartment; and who pays for window replacement in a co-op.', 'lead_paragraph': 'Ask Real Estate is a new weekly online column that answers questions from across the New York region. Submit yours to realestateqa@nytimes.com.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/realestate/02ask-image/02ask-image-articleLarge-v2.jpg',