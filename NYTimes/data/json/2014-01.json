': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/business/Fed/Fed-articleLarge.jpg', 'height': 361, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/30/business/Fed/Fed-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 361}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/business/Fed/Fed-jumbo.jpg', 'height': 616, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/business/Fed/Fed-superJumbo.jpg', 'height': 1231, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/business/Fed/Fed-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/30/business/Fed/Fed-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/business/Fed/Fed-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Citing Growth, Fed Again Cuts Monthly Bond Purchases', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fed Again Scales Back Purchases of Bonds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Appelbaum, Binyamin', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Federal Reserve System', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Treasury Department', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Bernanke, Ben S', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Quantitative Easing', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-29T19:08:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Binyamin Appelbaum', 'person': [{'firstname': 'Binyamin', 'middlename': None, 'lastname': 'Appelbaum', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c8882b2f-0517-55fa-9a4f-b2884c3ddd6c', 'word_count': 1311, 'uri': 'nyt://article/c8882b2f-0517-55fa-9a4f-b2884c3ddd6c'}, {'abstract': 'A day in the life of armed America.', 'web_url': 'https://nocera.blogs.nytimes.com/2014/01/29/the-gun-report-january-29-2014/', 'snippet': 'A day in the life of armed America.', 'lead_paragraph': '• Having a gun range on your property is legal in Florida, thanks to a 1987 law allowing anyone to fire anything they want on their own land. Doug Varrieur, who has turned the front yard of his home on Big Pine Key into a makeshift range, was looking for a way to teach his eyesight-impaired wife how to shoot her self-defense pistol without the inconvenience of going to a commercial gun range, “which is 50 miles round trip, costs $45 an hour and is enclosed in a building with people shooting around you that you don’t know,” he told the Miami Herald. The only rules to discharging firearms on residential property are that you can’t fire over a paved public road, highway or street, or occupied dwelling.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/opinion/target-practice/target-practice-articleLarge.jpg', 'height': 406, 'width': 600, 'subType': 'xlarge', '