a.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/arts/04opera_cap2/04opera_cap2-articleLarge.jpg', 'height': 420, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/04/arts/04opera_cap2/04opera_cap2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 420}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/arts/04opera_cap2/04opera_cap2-jumbo.jpg', 'height': 717, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/arts/04opera_cap2/04opera_cap2-superJumbo.jpg', 'height': 1434, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/arts/04opera_cap2/04opera_cap2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/04/arts/04opera_cap2/04opera_cap2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/arts/04opera_cap2/04opera_cap2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Otto Schenk’s Opera Stagings Still at Home in Vienna', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'In Vienna, Otto Schenk Still Reigns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Vienna State Opera', 'rank': 2, 'major': 'N'}, {'name