e': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'State of the State Message (NYS)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McKinley, Jesse', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Taxation', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Education (K-12)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-01-08T20:57:29+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Susanne Craig and Jesse McKinley', 'person': [{'firstname': 'Susanne', 'middlename': None, 'lastname': 'Craig', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Jesse', 'middlename': None, 'lastname': 'McKinley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e7ac2d1e-0650-5246-8638-a4805c32e696', 'word_count': 980, 'uri': 'nyt://article/e7ac2d1e-0650-5246-8638-a4805c32e696'}, {'abstract': 'Space games hark back to the origins of video gaming and show off the amazing graphics of a modern smartphone and tablet.', 'web_url': 'https://www.nytimes.com/2014/01/09/technology/personaltech/gloriously-lost-in-space-games.html', 'snippet': 'Space games hark back to the origins of video gaming and show off the amazing graphics of a modern smartphone and tablet.', 'lead_paragraph': 'There are games apps, and there are games apps. Some gamers like the imagination in fantasy games, some thrill to gory shoot-’em-ups, others love the wonderfully named MMORPGs (massively multiplayer online role-playing games). Each genre has unique characteristics.', 'print_section': 'B', 'print_page': '7', 'source': 'The Ne