'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5f4b9b2c-6b0f-5c61-8748-9e9a14d572d0', 'word_count': 136, 'uri': 'nyt://article/5f4b9b2c-6b0f-5c61-8748-9e9a14d572d0'}, {'abstract': 'A study finds that the music of Bruno Mars was illegally downloaded nearly 6 million times in 2013.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/01/02/bruno-mars-tops-illegal-download-chart/', 'snippet': 'A study finds that the music of Bruno Mars was illegally downloaded nearly 6 million times in 2013.', 'lead_paragraph': 'It is a dubious distinction, as chart listings go, and no doubt an infuriating one: Bruno Mars was the musician whose work was illegally downloaded the most in 2013, according to a study that was prepared by Musicmetric. The company, based in London, analyzes consumer behavior, and its report has been published in Billboard.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Bruno Mars Tops Illegal Download Chart', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mars, Bruno', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Rihanna', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Daft Punk (Music Group)', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-02T18:57:35+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Allan Kozinn', 'person': [{'firstname': 'Allan', 'middlename': None, 'lastname': 'Kozinn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/64918849-ba31-56d8-9e6d-95cd6d86a25f', 'word_count': 156, 'uri': 'nyt://article/64918849-ba31-56d8-9e6d-95cd6d86a25f'}, {'abstract': 'Warfare between plants and insects is responsible for remarka