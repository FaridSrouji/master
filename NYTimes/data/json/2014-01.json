5, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/30/sports/hockey/30trainer-1/30trainer-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/sports/hockey/30trainer-1/30trainer-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Trainer and Father, Supporting Both Sides of a Rivalry', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Trainer and Father, Supporting Both Sides of a Rivalry', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Montreal Canadiens', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Bruins', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lucic, Milan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gallagher, Ian', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gallagher, Brendan', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-29T16:07:53+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Dhiren Mahiban', 'person': [{'firstname': 'Dhiren', 'middlename': None, 'lastname': 'Mahiban', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f43d1d74-607c-58a9-a33e-632a1027fa62', 'word_count': 762, 'uri': 'nyt://article/f43d1d74-607c-58a9-a33e-632a1027fa62'}, {'abstract': 'More thoughts on liberalism and the decline of marriage.', 'web_url': 'https://douthat.blogs.nytimes.com/2014/01/29/social-liberalism-as-class-warfare/', 'snippet': 'More thoughts on liberalism and the decline of marriage.', 'lead_paragraph': 'My\xa0Sunday column\xa0tried to take the ongoing debate over marriage and upward mobility in a slightly different direction, by prodding social liberals to acknowledge the ways in which their own ideological vision and its victories – legal and cultural both – have played a role in the married, two-parent family’s decline. I don’t think my argument has won many converts, but rather than respond to the responses right now\xa0I wanted to highlight one of the arguments that inspired the column in the first place:\xa0This essay from Steve Randy Waldman\xa0(the brother, I believe, of the novelist Adelle Waldman, familiar to my readers from an earlier round of\xa0kulturdebating), which makes the case that “marriage promotion” as social conservatives often describe it is “a destructive cargo cult,” with altars and rings standing in for the runways and tarmacs that World War II-era South Sea Islanders allegedly built in the hopes of attracting military airplanes.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Social Liberalism as Class Warfare', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dating and Courtship', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Divorce, Separations and Annulments', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Income Inequality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Marriages', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Sex', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Cyrus, Miley', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Murray, Charles', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Queen Latifah', 'rank': 10, 'major': 'N'}, {'name': 'persons', 'value': 'Thicke, Robin', 'rank': 11, 'major': 'N'}, {'name': 'persons', 'value': 'Waldman, Adelle', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 13, 'major': 'N'}], 'pub_date': '2014-01-29T16:14:32+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/35bdb0fd-6a8f-5625-afc4-4bf0dc324e13', 'word_count': 4030, 'uri': 'nyt://article/35bdb0fd-6a8f-5625-afc4-4bf0dc324e13'}, {'abstract': 'The top United Nations diplomat overseeing the talks, Lakhdar Brahimi, said that he expected little progress in the final few days of talks.', 'web_url': 'https://www.nytimes.com/2014/01/30/world/middleeast/syria-peace-talks.html', 'snippet': 'The top United Nations diplomat overseeing the talks, Lakhdar Brahimi, said that he expected little progress in the final few days of talks.', 'lead_paragraph': 'GENEVA — After five days of deadlock and dispute in the Syrian peace talks, opposition negotiators on Wednesday seized on hints of government willingness to discuss political transition as evidence of progress. Yet the United Nations mediator dampened expectations, saying he did not anticipate any substantial result from the current round of talks, which are scheduled to end Friday.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/world/Syria/Syria-articleLarge-v2.jpg', 'height': 396, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/30/world/Syria/Syria-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 396}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 't