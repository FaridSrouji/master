': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/28/sports/MERSEYSIDE/MERSEYSIDE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/sports/MERSEYSIDE/MERSEYSIDE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Friendly Derby? Well, Everton-Liverpool Is Friendlier', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Friendly Derby? Well, Maybe Friendlier', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Soccer', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Borden, Sam', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Liverpool (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Everton (Soccer Team)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'England', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-28T01:31:13+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Sam Borden', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Borden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04b794d8-629d-5f4f-a3c7-671e7d54d7c6', 'word_count': 1108, 'uri': 'nyt://article/04b794d8-629d-5f4f-a3c7-671e7d54d7c6'}, {'abstract': 'Activists protesting antigay policies in Russia have tried to turn Olympic promotions by major companies to their own purposes.', 'web_url': 'https://www.nytimes.com/2014/01/28/business/media/activists-try-to-hijack-promotions-by-sponsors-of-sochi-olympics.html', 'snippet': 'Activists protesting antigay policies in Russia have tried to turn Olympic promotions by major companies to their own purposes.', 'lead_paragraph': 'IT is the closest thing to a sure bet in advertising — associating with the Olympic athletes who train for years with the chance of winning a gold medal. And corporations are paying big money to align themselves with the Olympians competing at next month’s Winter Olympics in Sochi.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/Adco/Adco-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/28/business/Adco/Adco-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/Adco/Adco-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/Adco/Adco-superJumbo.jpg', 'height': 1364, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/Adco/Adco-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/28/business/Adco/Adco-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/business/Adco/Adco-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Activists Try to Hijack Promotions by Sponsors of Sochi Olympics', 'kicker': None, 'content_kicker': None, 'pr