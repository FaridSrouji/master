me': 'persons', 'value': 'Forte, Will', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'National Board of Review of Motion Pictures', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-07T13:30:31+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melena Ryzik', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/96de2ed0-1d7f-5c24-96ef-32cbb2c747fa', 'word_count': 616, 'uri': 'nyt://article/96de2ed0-1d7f-5c24-96ef-32cbb2c747fa'}, {'abstract': 'The insider trading trial of the former SAC trader Mathew Martoma begins. | Activist investors seen in more positive light. | Chief executives and the beauty premium. | A bond trader departs Morgan Stanley.', 'web_url': 'https://dealbook.nytimes.com/2014/01/07/morning-agenda-trial-begins-for-former-sac-trader/', 'snippet': 'The insider trading trial of the former SAC trader Mathew Martoma begins. | Activist investors seen in more positive light. | Chief executives and the beauty premium. | A bond trader departs Morgan Stanley.', 'lead_paragraph': 'Prosecutors had long hoped Mathew Martoma, a former portfolio manager at SAC Capital Advisors, would provide the missing link in their pursuit of the hedge fund’s owner, Steven A. Cohen. Instead, the insider trading case prosecutors never thought would happen is going to trial, Matthew Goldstein and Ben Protess write in DealBook. Prosecutors first confronted Mr. Martoma in November 2011, asking him to cooperate in their long-running investigation of Mr. Cohen, and they have continued to press him in a number of meetings since. But Mr. Martoma has baffled officials by refusing to cooperate against the boss who fired him in 2010.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Trial Begins for Former SAC Trader', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-07T13:36:22+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Sydney Ember', 'person': [{'firstname': 'Sydney', 'middlename': None, 'lastname': 'Ember', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed104c57-0d04-5581-b98b-968effcbd4ab', 'word_count': 2228, 'uri': 'nyt://article/ed104c57-0d04-5581-b98b-968effcbd4ab'}, {'abstract': 'The Scottish designer talks about his winter 2014 men’s wear collection and plans for a London opening this summer.', 'web_url': 'https://www.nytimes.com/2014/01/08/fashion/In-London-Christopher-Kane-To-Open-His-First-Store.html', 'snippet': 'The Scottish designer talks about his winter 2014 men’s wear collection and plans for a London opening this summer.', 'lead_paragraph': 'LONDON — Christopher Kane is getting ready to open his first store this summer on London’s Mount Street, a shopping area that already has drawn the fashion houses of Balenciaga, Lanvin, Marc Jacobs and Christian Louboutin, as well as Nicholas Kirkwood shoes and Stephen Webster jewelry.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/fashion/08inyt-fkane08-inline/08inyt-fkane08-inline-articleLarge-v2.jpg', 'height': 926, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/08/fashion/08inyt-fkane08-inline/08inyt-fkane08-inline-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 926}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/fashion/08inyt-fkane08-inline/08inyt-fkane08-inline-jumbo-v2.jpg', 'height': 1024, 'width': 664, 'subType