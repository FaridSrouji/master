main': 'Fiat’s Challenge Is to Improve Performance in Italy and Asia', 'kicker': None, 'content_kicker': None, 'print_headline': 'Fiat’s Challenge Is to Improve Performance in Italy and Asia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Fiat SpA', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Chrysler Group LLC', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-02T22:38:14+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By David Jolly', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Jolly', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3481ed37-fe18-58d2-a2d0-ab49be45864f', 'word_count': 923, 'uri': 'nyt://article/3481ed37-fe18-58d2-a2d0-ab49be45864f'}, {'abstract': 'At Trinity Wall Street, a performance of Rachmaninoff’s Vespers, a work that touched even its composer.', 'web_url': 'https://www.nytimes.com/2014/01/03/arts/music/clarion-choir-in-rachmaninoffs-vespers.html', 'snippet': 'At Trinity Wall Street, a performance of Rachmaninoff’s Vespers, a work that touched even its composer.', 'lead_paragraph': 'Even the most gifted composers have been insecure about the merit of their works, with Rachmaninoff among the self-doubting contingent. But he felt confident about his glorious Vespers; after the first performance in 1915, he was so moved he told the singers that he could never imagine having written such a piece, even in his dreams. ', 'print_section': 'C', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/03/arts/03SUBVESPERS_SPAN/03SUBVESPERS_