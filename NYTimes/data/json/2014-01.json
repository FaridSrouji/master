: '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2f9394ec-2fbe-5795-8570-08347c33f172', 'word_count': 1014, 'uri': 'nyt://article/2f9394ec-2fbe-5795-8570-08347c33f172'}, {'abstract': 'A comprehensive tree survey finds that big old trees continue to grow at a rapid pace.', 'web_url': 'https://dotearth.blogs.nytimes.com/2014/01/15/if-old-humans-grew-like-old-trees-stand-back/', 'snippet': 'A comprehensive tree survey finds that big old trees continue to grow at a rapid pace.', 'lead_paragraph': 'There’s a fascinating paper in Nature finding that big trees continue to grow fast even as they grow old. This makes them particularly valuable as carbon sinks, but it also leads to some fun “what if” thoughts, as summarized nicely by a United States Geological Survey news release, excerpted below.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'If Old Humans Grew Like Old Trees, Stand Back', 'kicker': 'Dot Earth', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Biology and Biochemistry', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Carbon Dioxide', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Environment', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Forests and Forestry', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Trees and Shrubs', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Nature (Journal)', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'United States Geological Survey', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'British Columbia (Canada)', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-01-15T19:43:40+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Andrew C. Revkin', 'person': [{'firstname': 'Andrew', 'middlename': 'C.', 'lastname': 'Revkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c12262b3-7ce9-5987-bc6c-8b5745b732d5', 'word_count': 385, 'uri': 'nyt://article/c12262b3-7ce9-5987-bc6c-8b5745b732d5'}, {'abstract': 'A law setting a 35-foot buffer zone around reproductive-health clinics is under review.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/01/15/supreme-court-justices-try-to-measure-35-feet/', 'snippet': 'A law setting a 35-foot buffer zone around reproductive-health clinics is under review.', 'lead_paragraph': 'The First Amendment protects the speech of short, elderly women and large and intimidating men equally, but you would be forgiven for thinking otherwise after oral arguments before the Supreme Court Wednesday morning. The case was McCullen v. Coakley, a challenge to a Massachusetts law setting a 35-foot buffer zone around reproductive-health clinics where abortions are performed.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Abortion-Free Speech Case, Justices Pull Out Tape Measure', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ABORTION', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Freedom of Speech and Expression', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'McCullen, Eleanor', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Scalia, Antonin', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Sotomayor, Sonia', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Supreme Court (US)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-15T19:57:15+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Jesse Wegman', 'person': [{'firstname': 'Jesse', 'middlename': None, 'lastname': 'Wegman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/080c1252-4d1f-52a3-a718-d405c2e9a69c', 'word_count': 756, 'uri': 'nyt://article/080c1252-4d1f-52a3-a718-d405c2e9a69c'}, {'abstract': 'The National Governors Association blamed political gridlock for the stymieing of numerous federal initiatives needed by the states, noting that its requests for 2013 and 2014 were nearly identical.', 'web_url': 'https://www.nytimes.com/2014/01/16/us/politics/from-governors-to-congress-a-blunt-message-do-something.html', 'snippet': 'The National Governors Association blamed political gridlock for the stymieing of numerous federal initiatives needed by the states, noting that its requests for 2013 and 2014 were nearly identical.', 'lead_paragraph': 'WASHINGTON — The nation’s governors criticized Congress on Wednesday for the political gridlock that they said had stymied passage of almost every federal initiative most needed by the states, and reiterated their calls for help from Washington.', 'print_section': 'A', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/us/STATES/STATES-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/15/us/STATES/STATES-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/us/STATES/STATES-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/us/STATES/STATES-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', '