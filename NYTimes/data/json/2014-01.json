ht': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Battle for Survival May Yield the Rain Forest’s Diversity', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Biodiversity', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Flowers and Plants', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Forests and Forestry', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Science and Technology', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-02T19:01:05+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Carl Zimmer', 'person': [{'firstname': 'Carl', 'middlename': None, 'lastname': 'Zimmer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/04549aae-7d2f-5e13-af85-be68354c783e', 'word_count': 1031, 'uri': 'nyt://article/04549aae-7d2f-5e13-af85-be68354c783e'}, {'abstract': 'The editorial page editor tells the public editor how the editorial came about.', 'web_url': 'https://publiceditor.blogs.nytimes.com/2014/01/02/weeks-in-the-making-an-editorial-on-snowden-may-go-beyond-what-is-realistic/', 'snippet': 'The editorial page editor tells the public editor how the editorial came about.', 'lead_paragraph': 'Most newspaper editorials don’t generate a great deal of heat. Even fewer can be considered newsworthy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Weeks in the Making, an Editorial on Snowden May Go ‘Beyond What Is Realistic’', 'kicker': 'The Public Editor&#039;s Journal', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Snowden, Edward J', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Times', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-01-02T19:10:51+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Margaret Sullivan', 'person': [{'firstname': 'Margaret', 'middlename': None, 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/11737d67-a211-52b5-ba95-1f5037a69205', 'word_count': 567, 'uri': 'nyt://article/11737d67-a211-52b5-ba95-1f5037a69205'}, {'abstract': 'A 36-year-old brought to the country from Mexico as a child can be admitted to the state bar, the California Supreme Court said. But, under federal law, no law firm can legally hire him.', 'web_url': 'https://www.nytimes.com/2014/01/03/us/immigrant-in-us-illegally-may-practice-law-california-court-rules.html', 'snippet': 'A 36-year-old brought to the country from Mexico as a child can be admitted to the state bar, the California Supreme Court said. But, under federal law, no law firm can legally hire him.', 'lead_paragraph': 'LOS ANGELES — As a teenager in Northern California, Sergio Garcia worked in the almond fields and in a grocery store, earning his way through college and then law school. He passed the California bar exam on his first try, something just half of all candidates do. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/03/us/03court_span/03court_span-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/03/us/03court_span/03court_span-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/03/us/03court_span/03court_span-jumbo.jpg', 'height': 683, 'width': 1024, 'subTy