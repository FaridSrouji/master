'}, {'name': 'glocations', 'value': 'Japan', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'ADVERTISING AND MARKETING', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-09T22:55:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Hiroko Tabuchi', 'person': [{'firstname': 'Hiroko', 'middlename': None, 'lastname': 'Tabuchi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b90574d0-592e-5144-8ee0-0668e9f38d1b', 'word_count': 903, 'uri': 'nyt://article/b90574d0-592e-5144-8ee0-0668e9f38d1b'}, {'abstract': '“Enlisted,” a Fox sitcom making its debut Friday, centers on three brothers stationed at the same backwater base in Florida.', 'web_url': 'https://www.nytimes.com/2014/01/10/arts/television/enlisted-a-fox-sitcom-set-on-an-army-base-in-florida.html', 'snippet': '“Enlisted,” a Fox sitcom making its debut Friday, centers on three brothers stationed at the same backwater base in Florida.', 'lead_paragraph': 'Any man who was of a devil-may-care age in 1981 will, if interrogated long enough, eventually drop his intellectual facade and affirm that the greatest movie of all time is not “Citizen Kane” but “Stripes,” the boot-camp comedy from that year starring Bill Murray and Harold Ramis. “Enlisted,” a Fox sitcom that begins on Friday night, really, really wants to be “Stripes,” but it has none of its panache. Where “Stripes” was full of memorable misfits, “Enlisted” is full of mismatched ones.', 'print_section': 'C', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/10/arts/10ENLISTED_SPAN/ENLISTED-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2