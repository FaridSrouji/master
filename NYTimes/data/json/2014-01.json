 None, 'lastname': 'Oppenheimer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/33c6254d-1ed9-5966-b0ef-b69e8634da98', 'word_count': 1125, 'uri': 'nyt://article/33c6254d-1ed9-5966-b0ef-b69e8634da98'}, {'abstract': 'How “Whiplash” came to agree to take the early spot at the festival.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2014/01/17/sundance-the-politics-of-picking-an-opening-night-film/', 'snippet': 'How “Whiplash” came to agree to take the early spot at the festival.', 'lead_paragraph': 'PARK CITY, Utah – Opening night at the Sundance Film Festival, always on a Thursday, has recently been reserved for the premiere of an extra-arty film. One longtime attendee calls it the “gay Eskimo” slot: a picture that tries so hard to be original that it ends up being completely uncommercial.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/whiplash/whiplash-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/17/arts/whiplash/whiplash-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/whiplash/whiplash-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/whiplash/whiplash-superJumbo.jpg', 'height': 1200, 'width': 1800, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/whiplash/whiplash-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/17/arts/whiplash/whiplash-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/whiplash/whiplash-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sundance: The Politics of Picking an Opening-Night Film', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Sundance Film Festival (Park City, Utah)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Chazelle, Damien', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, John', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Teller, Miles', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-17T18:27:19+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Brooks Barnes', 'person': [{'firstname': 'Brooks', 'middlename': None, 'lastname': 'Barnes', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0ea7baac-64fc-50a3-bc58-3ed6986292ee', 'word_count': 559, 'uri': 'nyt://article/0ea7baac-64fc-50a3-bc58-3ed6986292ee'}, {'abstract': 'Victoria & Albert Museum will make a copy of a list of “degenerate art” seized by the Nazis available online to the public starting at the end of January.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/01/17/victoria-and-albert-museum-to-publish-nazi-era-degenerate-art-inventory-online/', 'snippet': 'Victoria & Albert Museum will make a copy of a list of “degenerate art” seized by the Nazis available online to the public starting at the end of January.', 'lead_paragraph': 'BERLIN — Britain’s Victoria and Albert Museum, the holder of the only known complete inventory of modern works reviled by the Nazis and confiscated from German museums in 1937 to 1938, will make a copy of the list available online starting at the end of January.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Victoria and Albert Museum to Publish Nazi-Era ‘Degenerate Art’ Inventory Online', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Holocaust and the Nazi Era', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'World War II (1939-45)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gurlitt, Cornelius', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Victoria and Albert Museum', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Berlin (Germany)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 8, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-01-17T18:35:54+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Melissa Eddy', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Eddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f1f0508c-a5ae-5e2d-9658-3d0f8627f199', 'word_count': 419, 'uri': 'nyt://article/f1f0508c-a5ae-5e2d-9658-3d0f8627f199'}, {'abstract': 'The couple dated for five years, starting in college, then were apart for six before reconnecting.', 'web_url': 'https://www.nytimes.com/2014/01/19/fashion/weddings/a-reunion-that-was-a-long-time-coming.html', 'snippet': 'The couple dated for five years, starting in college, then were apart for six before reconnecting.', 'lead_paragraph': 'Sundays were the hardest day of the week for Peter Tiboris.', 'print_section': 'ST', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/fashion/weddings/19VOWS1_SPAN/19VOWS1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/19/fashion/weddings/19VOWS1_SPAN/19VOWS1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/fashion/weddings/19VOWS1_SPAN/19VOWS1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/fashion/weddings/19VOWS1_SPAN/19VOWS1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/fashion/weddings/19VOWS1_SPAN/19VOWS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/19/fashion/weddings/19VOWS1_SPAN/19VOWS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/fashion/weddings/19VOWS1_SPAN/19VOWS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Reunion That Was a Long Time Coming', 'kicker': 'Vows: Christy Ely and Peter Tiboris', 'content_kicker': None, 'print_headline': 'A Reunion That Was a Long Time Coming', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Weddings and Engagements', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Vows (Times Column)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Tiboris, Peter', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-01-17T18:41:35+0000', 'document_type': 'article', 'news_desk': 'Society', 'section_name': 'Fashion & Style', 'subsection_name': 'Weddings', 'byline': {'original': 'By Devan Sipher', 'person': [{'firstname': 'Devan', 'middlename': None, 'lastname': 'Sipher', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4f03faab-9fed-5c7b-8a8e-951f948c9a12', 'word_count': 1495, 'uri': 'nyt://article/4f03faab-9fed-5c7b-8a8e-951f948c9a12'}, {'abstract': 'Ms. Mantel, the author of the bestselling historical novels “Wolf Hall” and “Bring Up the Bodies,” will release a collection of short stories called “The Assassination of Margaret Thatcher.”', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/01/17/hilary-mantels-next-book-is-a-story-collection/', 'snippet': 'Ms. Mantel, the author of the bestselling historical novels “Wolf Hall” and “Bring Up the Bodies,” will release a collection of short stories called “The Assassination of Margaret Thatcher.”', 'lead_paragraph': "Hilary Mantel, the author of the bestselling historical novels “Wolf Hall” and “Bring Up the Bodies,” has written a collection of short stories that will be released in September, her publisher said. The book, “The Assassination of Margaret Thatcher,” was acquired by Henry Holt in the United States and 4th Estate in Britain. Nicholas Pearson, the publishing director of 4th Estate, said in a statement: “A new book from Hilary Mantel is a treat. Where her last two novels explore how modern England was forged, ‘The Assassination of Margaret Thatcher’ shows us the country we have become.'” Ms. Mantel won the Man Booker Prize in both 2012 and 2009.", 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Hilary Mantel’s Next Book Is a Story Collection', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mantel, Hilary', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-01-17T18:42:41+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Julie Bosman', 'person': [{'firstname': 'Julie', 'middlename': None, 'lastname': 'Bosman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1114bba4-6c69-5901-ac49-9301f7db912b', 'word_count': 109, 'uri': 'nyt://article/1114bba4-6c69-5901-ac49-9301f7db912b'}, {'abstract': 'The Upper East Side building, priced at $14.5 million, features arched doorways and an oak balustrade, carry-overs from the its era as a stable.', 'web_url': 'https://www.nytimes.com/slideshow/2014/01/19/realestate/20140119-EXCLUSIVE.html', 'snippet': 'The Upper East Side building, priced at $14.5 million, features arched doorways and an oak balustrade, carry-overs from the its era as a stable.', 'lead_paragraph': 'The Upper East Side building, priced at $14.5 million, features arched doorways and an oak balustrade, carry-overs from the its era as a stable.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/19/realestate/20140119-EXCLUSIVE-slide-NJR5/20140119-EXCLUSIVE-slide-NJR5-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/19/realestate/20140119-EXCLUSIVE-slide-NJR5/20140119-EXCLUSIVE-slide-NJR5-articleLarge.jpg', 'xlarg