ocument_type': 'article', 'news_desk': '', 'section_name': 'New York', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/778d386a-0c4a-5cbb-ab33-7a789839d842', 'word_count': 105, 'uri': 'nyt://article/778d386a-0c4a-5cbb-ab33-7a789839d842'}, {'abstract': 'A surprisingly honest reply.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/01/03/in-praise-of-art-laffer/', 'snippet': 'A surprisingly honest reply.', 'lead_paragraph': 'No, really. Business Insider contacted him about his 2009 warning that soaring inflation and interest rates were just around the corner — and he not only admits that he was wrong, he admits that his error signified something wrong with his overall economic model:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Praise of Art Laffer', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-03T21:25:21+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4bbe14e2-97c9-5a9b-9ed8-d6dc9120120a', 'word_count': 173, 'uri': 'nyt://article/4bbe14e2-97c9-5a9b-9ed8-d6dc9120120a'}, {'abstract': 'The Israeli military said the teenager was one of a group of people who vandalized the fence between Israel and Gaza and ignored warnings to move back.', 'web_url': 'https://www.nytimes.com/2014/01/04/world/middleeast/palestinian-teenager-dies-of-wounds.html', 'snippet': 'The Israeli military said the teenager was one of a group of people who vandalized the fence between Israel and Gaza and ignored warnings to move back.', 'lead_paragraph': 'JERU