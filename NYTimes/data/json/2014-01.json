': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/d3039b30-35cc-5550-8ccc-89f7af40e4a8', 'word_count': 0, 'uri': 'nyt://video/d3039b30-35cc-5550-8ccc-89f7af40e4a8'}, {'abstract': 'Mr. Camp was a leader of the American Indian Movement who led the first wave of the 1973 operation to seize Wounded Knee in South Dakota.', 'web_url': 'https://www.nytimes.com/2014/01/09/us/carter-camp-american-indian-leader-dies-at-72.html', 'snippet': 'Mr. Camp was a leader of the American Indian Movement who led the first wave of the 1973 operation to seize Wounded Knee in South Dakota.', 'lead_paragraph': 'On Dec. 29, 1890, United States cavalry, in the last battle of the American Indian wars, massacred as many as 350 Lakota Sioux at Wounded Knee in South Dakota. Three generations later, Carter Camp, a 32-year-old Indian militant, retaliated.', 'print_section': 'B', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/09/us/CAMP-obit/CAMP-obit-articleLarge.jpg', 'height': 960, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/09/us/CAMP-obit/CAMP-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 960}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/09/us/CAMP-obit/CAMP-obit-jumbo.jpg', 'height': 1024, 'width': 640, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/09/us/CAMP-obit/CAMP-obit-superJumbo.jpg', 'height': 1760, 'width': 1100, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/201