ubject', 'value': 'Deaths (Obituaries)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Newsday', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Village Voice', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Boston Herald', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Pulitzer Prizes', 'rank': 9, 'major': 'N'}, {'name': 'organizations', 'value': 'University of Vermont', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-01-05T01:45:11+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By James Barron', 'person': [{'firstname': 'James', 'middlename': None, 'lastname': 'Barron', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/497ec387-9f78-530c-b6fd-67a5710326f6', 'word_count': 818, 'uri': 'nyt://article/497ec387-9f78-530c-b6fd-67a5710326f6'}, {'abstract': 'The Colts trailed, 38-10, early in the third quarter but stormed back behind Andrew Luck, who threw for 443 yards and 4 scores, to beat the Chiefs in an A.F.C. wild-card game.', 'web_url': 'https://www.nytimes.com/2014/01/05/sports/football/overwhelmed-early-colts-overcome-chiefs.html', 'snippet': 'The Colts trailed, 38-10, early in the third quarter but stormed back behind Andrew Luck, who threw for 443 yards and 4 scores, to beat the Chiefs in an A.F.C. wild-card game.', 'lead_paragraph': 'INDIANAPOLIS — The ball flew from the arms of Indianapolis running back Donald Brown, and with it, perhaps, went the Colts’ season. The ball bounced, though, off the back of an offensive lineman and then, like a trained dog, returned to the feet of quarterback Andrew Luck. He scooped it up, hopped and lunged, arms outstretched, into the end zone for a fourth-quarter touchdown.', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', '