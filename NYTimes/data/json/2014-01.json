'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Wilson', 'middlename': None, 'lastname': 'ANDREWS', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}, {'firstname': 'Alicia', 'middlename': None, 'lastname': 'PARLAPIANO', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 4}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/871e63b2-8813-532d-8e94-a1ee0f4c66c6', 'word_count': 0, 'uri': 'nyt://interactive/871e63b2-8813-532d-8e94-a1ee0f4c66c6'}, {'abstract': 'A remembrance of Sam Berns, who died this past Friday from complications related to a rare genetic disorder, progeria.', 'web_url': 'https://6thfloor.blogs.nytimes.com/2014/01/13/the-short-exuberant-life-of-sam-berns/', 'snippet': 'A remembrance of Sam Berns, who died this past Friday from complications related to a rare genetic disorder, progeria.', 'lead_paragraph': 'Judging from media appearances last year that brought him a kind of celebrity — first as the subject of an HBO documentary, then as a speaker at a TEDx conference — Sam Berns seemed to be far healthier than anyone could have anticipated back in 2005, when I wrote about him for the magazine. My article focused on his mother’s search for a cure for his disease, progeria, a rare genetic disorder that makes children seem to age before your eyes, with damage to organ systems — particularly the heart, skin and bones — usually seen only in the very old.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/magazine/13-sam-berns/13-sam-berns-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/magazine/13-sam-berns/13-sam-berns-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit'