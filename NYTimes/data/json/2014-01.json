ard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/26/books/review/0126-bks-COVER/0126-bks-COVER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/0126-bks-COVER/0126-bks-COVER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Deep Reader', 'kicker': None, 'content_kicker': None, 'print_headline': 'Deep Reader', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'My Life in Middlemarch (Book)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Oates, Joyce Carol', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mead, Rebecca', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Eliot, George', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-23T22:31:16+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joyce Carol Oates', 'person': [{'firstname': 'Joyce', 'middlename': 'Carol', 'lastname': 'Oates', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/360904a0-556c-5a1c-96b6-d4e6a680eaf3', 'word_count': 1765, 'uri': 'nyt://article/360904a0-556c-5a1c-96b6-d4e6a680eaf3'}, {'abstract': 'The Parthenon is our shrine to Western civilization, but what did it mean to those who made it?', 'web_url': 'https://www.nytimes.com/2014/01/26/books/review/the-parthenon-enigma-by-joan-breton-connelly.html', 'snippet': 'The Parthenon is our shrine to Western civilization, but what did it mean to those who made it?', 'lead_paragraph': 'The myths of Greek antiquity are shot through with stories of murder, rape, incest and cannibalism. On Mount Lykaion (“wolf mountain”) in Arcadia, annual traditions honoring Zeus re-enacted a seminal rite of human sacrifice. In Plato’s “Republic,” the casual observation is made that in Athens anyone who wished to injure an enemy could commission a magician to cast a harmful spell; “for with their incantations and magic formulas they say they can persuade the gods to serve their will.” Similarly, archaeologists have discovered grotesque little voodoo-like figures bristling with spikes, and curse tablets that were inscribed with malevolent prayers during this Golden Age of humanism and reason. Spirits and dark ancestral memories haunted the landscape of enlightened Athens.', 'print_section': 'BR', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26ALEXANDER/26ALEXANDER-articleLarge.jpg', 'height': 275, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/26/books/review/26ALEXANDER/26ALEXANDER-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 275}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26ALEXANDER/26ALEXANDER-jumbo.jpg', 'height': 469, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26ALEXANDER/26ALEXANDER-superJumbo.jpg', 'height': 938, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26ALEXANDER/26ALEXANDER-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard