.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Image of the Day: January 13', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Bay of Bengal', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-01-13T15:51:13+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By The New York Times', 'person': [], 'organization': 'The New York Times'}, 'type_of_material': 'News', '_id': 'nyt://article/219a8350-dc7c-5180-9242-431d80bd798d', 'word_count': 1, 'uri': 'nyt://article/219a8350-dc7c-5180-9242-431d80bd798d'}, {'abstract': 'A colorful ragout that works on its own or over rice.', 'web_url': 'https://www.nytimes.com/2014/01/13/health/carrot-squash-and-potato-ragout-with-thai-flavors.html', 'snippet': 'A colorful ragout that works on its own or over rice.', 'lead_paragraph': 'This is inspired by a recipe in Patricia Wells’s “Vegetable Harvest.” The flavors are both sweet and pungent. Serve it on its own or over rice; Thai purple sticky rice looks particularly pretty against the orange vegetables but any type of rice will do. I’m very happy serving this over brown rice.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/14/science/13recipehealth1/13recipehealth1-articleLarge.jpg', 'height': 402, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/14/science/13recipehealth1/13recipehealth1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 402}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/14/science/13recipehealth1/13recipehealth1-jumbo.jpg', 'height': 686, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'j