ubject', 'value': 'Sikhs and Sikhism', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Golden Temple (Amritsar, India)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'AMRITSAR (INDIA)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-14T21:14:52+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Stephen Castle', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Castle', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/2bbdaa34-950a-594a-bcb5-ef4f453ffe6d', 'word_count': 472, 'uri': 'nyt://article/2bbdaa34-950a-594a-bcb5-ef4f453ffe6d'}, {'abstract': 'A response to Matt Yglesias on the potential for a meaningful pro-marriage agenda.', 'web_url': 'https://douthat.blogs.nytimes.com/2014/01/14/is-marriage-promotion-possible/', 'snippet': 'A response to Matt Yglesias on the potential for a meaningful pro-marriage agenda.', 'lead_paragraph': 'Now that there’s actually some slight movement in the Republican Party in the direction suggested by “Grand New Party,”\xa0\xa0the book I co-authored with Reihan Salam\xa0way back in the misty days of 2007-2008, I suppose I should be grateful to Slate’s Matt Yglesias for doing his part to make our ideas seem as reactionary as possible. In a post accusing conservatives of having a “phantom agenda” on marriage promotion, Yglesias raises the question of how, exactly, a movement usually suspicious of government’s effectiveness expects the state to somehow intervene effectively in people’s most intimate decisions, and then offers the following reading of our book:', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Is Marriage Promotion Possible?', 'kicker': 'Ross Douthat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-14T21:16:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Ross Douthat', 'person': [{'firstname': 'Ross', 'middlename': None, 'lastname': 'Douthat', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9a28c9e-1129-5aa9-a5ab-86d20b31af3c', 'word_count': 1063, 'uri': 'nyt://article/e9a28c9e-1129-5aa9-a5ab-86d20b31af3c'}, {'abstract': 'Yascha Mounk’s book about growing up Jewish in Germany is a help in trying to understand that country’s perverse, absurd love for its Jews.', 'web_url': 'https://www.nytimes.com/2014/01/15/books/how-yascha-mounk-grew-up-a-stranger-in-my-own-country.html', 'snippet': 'Yascha Mounk’s book about growing up Jewish in Germany is a help in trying to understand that country’s perverse, absurd love for its Jews.', 'lead_paragraph': 'Yascha Mounk’s book about growing up Jewish in Germany, “Stranger in My Own Country,” is rickety, not fully assembled, more the frame of a book than the sanded and stained product. Mr. Mounk is a young graduate student at Harvard, born in 1982, and his book is learned but at times not so wise.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/arts/jpbook/jpbook-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/15/arts/jpbook/jpbook-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/arts/jpbook/jpbook-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank'