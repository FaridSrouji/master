, different sides to many stories.', 'print_section': 'C', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/17ANGOLA_SPAN/ANGOLA-articleLarge.jpg', 'height': 392, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/17/arts/17ANGOLA_SPAN/ANGOLA-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 392}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/17ANGOLA_SPAN/ANGOLA-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/17ANGOLA_SPAN/ANGOLA-superJumbo.jpg', 'height': 1337, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/17ANGOLA_SPAN/ANGOLA-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/17/arts/17ANGOLA_SPAN/ANGOLA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/17/arts/17ANGOLA_SPAN/ANGOLA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tripped Up by Crises on the Path to His Opus', 'kicker': 'Dance Review', 'content_kicker': None, 'print_headline': 'Tripped Up by Crises on the Path to His Opus', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Dancing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Xido, Jeremy', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-