native to Performance Reviews', 'kicker': 'You&#039;re the Boss', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Executives and Management (Theory)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Performance Evaluations (Labor)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Small Business', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-30T12:00:09+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'subsection_name': 'Entrepreneurship', 'byline': {'original': 'By Josh Patrick', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Patrick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/40fb8cca-f768-5958-a16f-3535d44371de', 'word_count': 710, 'uri': 'nyt://article/40fb8cca-f768-5958-a16f-3535d44371de'}, {'abstract': 'The social network is introducing Paper, a visually focused iPhone application that makes it easier for a user to scan a news feed and discover new content on the service.', 'web_url': 'https://bits.blogs.nytimes.com/2014/01/30/facebook-unveils-new-tool-to-read-posts-and-news/', 'snippet': 'The social network is introducing Paper, a visually focused iPhone application that makes it easier for a user to scan a news feed and discover new content on the service.', 'lead_paragraph': ' Users of Apple’s iPhone are about to get a new way to browse their Facebook feeds and find other interesting articles that have been posted on the service: a visually focused application called Paper.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/30/technology/30bits-fbpaper/30bits-fbpaper-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'ima