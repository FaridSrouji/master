[{'firstname': 'Floyd', 'middlename': None, 'lastname': 'Norris', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/915148f0-36da-54d5-8a20-7f60f3c54aef', 'word_count': 1219, 'uri': 'nyt://article/915148f0-36da-54d5-8a20-7f60f3c54aef'}, {'abstract': '“The Shadows Took Shape,” an exhibition in Harlem looking at the visual side of Afrofuturism, is featuring special tours this weekend, including events specifically for children.', 'web_url': 'https://www.nytimes.com/2014/01/24/nyregion/the-look-of-afrofuturism-in-harlem.html', 'snippet': '“The Shadows Took Shape,” an exhibition in Harlem looking at the visual side of Afrofuturism, is featuring special tours this weekend, including events specifically for children.', 'lead_paragraph': 'A certain strain of late-20th-century pop music, pioneered by artists like Sun Ra, George Clinton and Lee (Scratch) Perry, drew on science fiction, electronic instruments and experiences of racial marginalization to forge an aesthetic called Afrofuturism.', 'print_section': 'C', 'print_page': '33', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The Look of Afrofuturism in Harlem', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Look of Afrofuturism in Harlem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Harlem (Manhattan, NY)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Studio Museum in Harlem', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-23T22:21:27+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'New York', 'byline': {'original': 'By A. C. Lee', 'person': [{'firstname': 'A.', 'middlename': 'C.', 'lastname': 'Lee', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_materi