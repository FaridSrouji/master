-thumb/26OPM-thumb-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/26/magazine/26OPM-thumb/26OPM-thumb-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/magazine/26OPM-thumb/26OPM-thumb-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Anti-Snuggle Task Force', 'kicker': 'The One-Page Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-24T16:07:09+0000', 'document_type': 'multimedia', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/817350f1-3ce0-5005-a956-6924e44619dc', 'word_count': 0, 'uri': 'nyt://interactive/817350f1-3ce0-5005-a956-6924e44619dc'}, {'abstract': 'Conjoined twins, a spate of murders and the legacy of South African apartheid all factor into Chris Abani’s Las Vegas thriller.', 'web_url': 'https://www.nytimes.com/2014/01/26/books/review/chris-abanis-secret-history-of-las-vegas.html', 'snippet': 'Conjoined twins, a spate of murders and the legacy of South African apartheid all factor into Chris Abani’s Las Vegas thriller.', 'lead_paragraph': 'Given the extraordinary truth of Las Vegas, a city that began after all as a glint in a mobster’s eye, you might wonder what possible iniquities are stored up in a novel purporting to tell its secret history. Is it, perhaps, a double-bluff, in which the real life of the city is one of stable communities and spiritual growth — Marilynne Robinson’s “Gilead” with slot machines?', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26THEROUX/26THEROUX-articleLarge.jpg', 'height': 670, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/26/books/review/26THEROUX/26THEROUX-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 670}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26THEROUX/26THEROUX-jumbo.jpg', 'height': 1024, 'width': 918, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26THEROUX/26THEROUX-superJumbo.jpg', 'height': 2048, 'width': 1835, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26THEROUX/26THEROUX-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/26/books/review/26THEROUX/26THEROUX-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26THEROUX/26THEROUX-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Unreconciled', 'kicker': None, 'content_kicker': None, 'print_headline': 'Unreconciled', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Abani, Chris', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-24T16:07:12+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Marcel Theroux', 'person': [{'firstname': 'Marcel', 'middlename': None, 'lastname': 'Theroux', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0f9f57af-c7df-5319-a1f0-c4a581970665', 'word_count': 1210, 'uri': 'nyt://article/0f9f57af-c7df-5319-a1f0-c4a581970665'}, {'abstract': 'Roddy Doyle’s Jimmy Rabbitte reappears, dealing with cancer, mortality and love.', 'web_url': 'https://www.nytimes.com/2014/01/26/books/review/the-guts-by-roddy-doyle.html', 'snippet': 'Roddy Doyle’s Jimmy Rabbitte reappears, dealing with cancer, mortality and love.', 'lead_paragraph': 'Roddy Doyle’s new novel, “The Guts,” begins with a conversation about Facebook. Jimmy Rabbitte, the hero of Doyle’s 1987 novel, “The Commitments,” and a key figure in that book’s two successors, “The Snapper” and “The Van,” sits in a pub with his father, Jimmy Sr. The two men are arguing (or simply talking; it can be difficult to tell in Doyle’s starkly profane dialect), and the son explains social networking thus to his dad: “It’s like a club but yeh have your own room, for the people yeh want to meet. Except there’s no room an’ yeh meet no one. Unless yeh want to.” For a moment, perhaps, we think we know what to expect: a rambunctious comedy about aging musicians, working-class life, rock ’n’ roll, something fundamentally upbeat, because that’s what Doyle does. Even his darker books — “The Woman Who Walked Into Doors,” say, that raw tale of a woman’s abuse at the hands of her alcoholic husband — have a way of seeming spry, sunny underneath their patina of hardscrabble realism. So we’re ready for the comedy of crusty \xadmiddle-aged Jimmy and his father navigating the dubious world of text messaging and mobile phones (after all, we haven’t seen them fleshed out in a novel since the 1990 of “The Van”). But the younger Jimmy has something else on his mind.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/0126-bks-SPEKTOR/0126-bks-SPEKTOR-articleLarge.jpg', 'height': 695, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/26/books/review/0126-bks-SPEKTOR/0126-bks-SPEKTOR-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 695}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/0126-bks-SPEKTOR/0126-bks-SPEKTOR-jumbo.jpg', 'height': 1024, 'width': 885, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/0126-bks-SPEKTOR/0126-bks-SPEKTOR-superJumbo.jpg', 'height': 1649, 'width': 1424, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/0126-bks-SPEKTOR/0126-bks-SPEKTOR-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/26/books/review/0126-bks-SPEKTOR/0126-bks-SPEKTOR-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/0126-bks-SPEKTOR/0126-bks-SPEKTOR-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Commitment', 'kicker': None, 'content_kicker': None, 'print_headline': 'Commitment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Doyle, Roddy', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-24T16:07:34+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Matthew Specktor', 'person': [{'firstname': 'Matthew', 'middlename': None, 'lastname': 'Specktor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9c2dbdff-d021-50ec-a0eb-5063f167e4f6', 'word_count': 1237, 'uri': 'nyt://article/9c2dbdff-d021-50ec-a0eb-5063f167e4f6'}, {'abstract': 'Wendy Lesser on the delights of a lifetime with books.', 'web_url': 'https://www.nytimes.com/2014/01/26/books/review/why-i-read-by-wendy-lesser.html', 'snippet': 'Wendy Lesser on the delights of a lifetime with books.', 'lead_paragraph': 'For writers, literature is a talent show: Those with the most talent win. Readers are more fortunate: Everybody wins. Quality reading exercises the crucial dialogue with yourself, the dialogue you must undergo to become yourself, to know where on the vista of existence you can place your own identity and awareness.', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26GIRALDI/26GIRALDI-articleLarge.jpg', 'height': 370, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/26/books/review/26GIRALDI/26GIRALDI-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 370}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26GIRALDI/26GIRALDI-jumbo.jpg', 'height': 632, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/books/review/26GIRALDI/26GIRALDI-superJumbo.jpg', 'height': 1263, '