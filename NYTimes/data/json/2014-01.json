jor': 'N'}], 'pub_date': '2014-01-03T12:00:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Technology', 'byline': {'original': 'By David Streitfeld', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Streitfeld', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/85b2c5a2-caed-582e-a1e6-a1fa9907734f', 'word_count': 685, 'uri': 'nyt://article/85b2c5a2-caed-582e-a1e6-a1fa9907734f'}, {'abstract': 'From philo-Semitism to wanting to move on, a nation struggles with its past.', 'web_url': 'https://www.nytimes.com/2014/01/04/opinion/sunday/german-jewish-and-neither.html', 'snippet': 'From philo-Semitism to wanting to move on, a nation struggles with its past.', 'lead_paragraph': 'Laupheim, a small town in southern Germany, once boasted a large Jewish community and named a prominent street after one of its Jewish sons: Carl Laemmle, who went on to found Universal Studios. But all of that changed in the 1930s. By 1992, when I started fifth grade, Laemmle’s name had long since been removed from the map, and my mother and I were the only Jews in town.', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/opinion/sunday/04mounk/04mounk-articleLarge.jpg', 'height': 534, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/04/opinion/sunday/04mounk/04mounk-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 534}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/opinion/sunday/04mounk/04mounk-jumbo.jpg', 'height': 911, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/opinion/sunday/04mounk/04mounk-superJumbo.jpg', 'height': 1822, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/opinion/sunday/04mounk/04mounk-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/04/opinion/sunday/04mounk/04mounk-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/04/opinion/sunday/04mounk/04mounk-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'German, Jewish and Neither', 'kicker': 'Opinion', 'content_kicker': None, 'print_headline': 'German, Jewish and Neither', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mounk, Yascha', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Jews and Judaism', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Germany', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-03T12:18:30+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Yascha Mounk', 'person': [{'firstname': 'Yascha', 'middlename': None, 'lastname': 'Mounk', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/b9267476-3e42-5196-9b60-2af99f61fa3f', 'word_count': 2091, 'uri': 'nyt://article/b9267476-3e42-5196-9b60-2af99f61fa3f'}, {'abstract': 'These omnivores have always been among our favorite subjects for sheer, sputtering nonsense.', 'web_url': 'https://www.nytimes.com/2014/01/04/opinion/sunday/piranhas-a-true-fish-story.html', 'snippet': 'These omnivores have always been among our favorite subjects for sheer, sputtering nonsense.', 'lead_paragraph': 'In the languid news week after Christmas, hungry media outlets swarmed over a report of piranhas attacking swimmers on a river in Argentina. “Massive Piranha Attack” cried The New York Post. “70 Christmas Day Bathers Are Savaged” added The Daily Mail, promising “the truth about the fish with a bite more powerful than a T. rex.” ABC News called it a “Christmas Day feeding frenzy.” In fact, the injuries ranged from minor cuts to at least one missing finger part — not exactly as newsworthy as, say, the 800,000 Americans who require medical treatment for dog bites each year. ', 'print_section': 'SR', 'print_page': '5', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/07/02/opinion/richard-conniff/richard-conniff-articleLarge-v4.png', 'height': 583, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/07/02/opinion/richard-conniff/richard-conniff-articleLarge-v4.png', 'xlargewidth': 600, 'xlargeheight': 583}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/07/02/opinion/richard-conniff/richard-conniff-jumbo-v4.png', 'height': 667, 'width': 687, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/07/02/opinion/richard-conniff/richard-conniff-superJumbo-v4.png', 'height': 667, 'width': 687, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/07/02/opinion/richard-conniff/richard-conniff-thumbStandard-v4.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/07/02/opinion/ric