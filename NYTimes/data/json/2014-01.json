e': 'organizations', 'value': 'Auburn University', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Winston, Jameis', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'BCS National Championship', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-07T05:50:52+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'College Football', 'byline': {'original': 'By Greg Bishop', 'person': [{'firstname': 'Greg', 'middlename': None, 'lastname': 'Bishop', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/97995b99-4c00-5996-8f1e-368da6b58bf6', 'word_count': 1099, 'uri': 'nyt://article/97995b99-4c00-5996-8f1e-368da6b58bf6'}, {'abstract': 'The measure is expected to fall to a Republican filibuster.', 'web_url': 'https://www.nytimes.com/2014/01/07/us/politics/senate-postpones-vote-on-unemployment-benefits.html', 'snippet': 'The measure is expected to fall to a Republican filibuster.', 'lead_paragraph': 'Senate leaders on Monday night abruptly postponed a vote to take up a measure extending expired unemployment benefits. Senator Harry Reid of Nevada, the majority leader, was about to call the vote when the Senate’s No. 2 Republican, John Cornyn of Texas, accused him of manufacturing a political issue by holding a vote with 17 senators absent, mostly because of weather delays. Mr. Reid than gruffly asked for consent to postpone it until Tuesday morning. The measure is expected to fall to a Republican filibuster.\xa0 ', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Senate Postpones Vote on Unemployment Benefits', 'kicker': 'National Briefing | Washington', 'content_kicker': None, 'print_headline': 'Senate Postpones Vote on Unemployment Benefits', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Reid, Harry', 'rank': 