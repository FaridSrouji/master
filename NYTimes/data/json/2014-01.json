organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/38410e86-1c35-53ed-bce3-01ec2b787423', 'word_count': 800, 'uri': 'nyt://article/38410e86-1c35-53ed-bce3-01ec2b787423'}, {'abstract': 'Small businesses can use tools on Facebook to track customers from ad to website, and target audiences more precisely.', 'web_url': 'https://www.nytimes.com/2014/01/16/business/smallbusiness/with-revamped-advertising-program-facebook-aims-to-compete-with-google.html', 'snippet': 'Small businesses can use tools on Facebook to track customers from ad to website, and target audiences more precisely.', 'lead_paragraph': 'Last June, Facebook released a tracking pixel, a snippet of code that allows advertisers to track customers who come to their websites from Facebook ads. For Amy Norman, co-chief executive officer of Little Passports, the pixel was a game-changer.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/business/smallbusiness/16sbiz/16sbiz-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/16/business/smallbusiness/16sbiz/16sbiz-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/business/smallbusiness/16sbiz/16sbiz-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/business/smallbusiness/16sbiz/16sbiz-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/1