o': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (Pre-School)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Children and Childhood', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Cuomo, Andrew M', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'New York State', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-01-21T01:56:29+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/24d7816d-e962-5a39-a2e3-2dbd3bf694c9', 'word_count': 570, 'uri': 'nyt://article/24d7816d-e962-5a39-a2e3-2dbd3bf694c9'}, {'abstract': 'If the Broncos win the Super Bowl, Peyton Manning could be granted iconic status in two cities, something rarely achieved in the N.F.L.', 'web_url': 'https://www.nytimes.com/2014/01/21/sports/football/manning-is-on-the-verge-of-the-sublime.html', 'snippet': 'If the Broncos win the Super Bowl, Peyton Manning could be granted iconic status in two cities, something rarely achieved in the N.F.L.', 'lead_paragraph': 'DENVER — Peyton Manning may not need another Super Bowl victory to solidify his place in football history, although his lingering detractors might suggest otherwise. But if there is debate about whether Manning’s legacy could use a boost, there is no doubt that a defeat of the Seattle Seahawks in Super Bowl XLVIII will elevate him to an unparalleled position in the game.', 'print_section': 'B', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': N