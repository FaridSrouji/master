/multimedia/tmag-aitken-glynn/tmag-aitken-glynn-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/multimedia/tmag-aitken-glynn/tmag-aitken-glynn-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Source | Liz Glynn', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-30T23:15:07+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'Doug Aitken', 'person': [{'firstname': 'Doug', 'middlename': None, 'lastname': 'Aitken', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/1fbeae22-3f22-5098-985f-39ac00c5e4c2', 'word_count': 0, 'uri': 'nyt://video/1fbeae22-3f22-5098-985f-39ac00c5e4c2'}, {'abstract': 'The documentary “Tim’s Vermeer” tracks one inventor’s bid to determine whether the Dutch master had used optical devices to paint “The Music Lesson” and his own effort to recreate it.', 'web_url': 'https://www.nytimes.com/2014/01/31/movies/tims-vermeer-chronicles-an-attempt-to-make-one.html', 'snippet': 'The documentary “Tim’s Vermeer” tracks one inventor’s bid to determine whether the Dutch master had used optical devices to paint “The Music Lesson” and his own effort to recreate it.', 'lead_paragraph': '“Tim’s Vermeer” is a little documentary that tracks how one man’s love turned into revenge. The title figure — well, one, anyway — is Tim Jenison, a scientist, inventor and restless hobbyist with deep pockets and famous friends, including Penn Jillette, who produced the movie, and Teller, who directed. In the 1980s, Mr. Jenison founded NewTek, a hardware and software company that scored an early success with the creation of Video Toaster, an affordable desktop video-production tool. Since then, this autodidact, now in his late 50s, has done this and that, including embarking on a multiyear odyssey to discover whether the movie’s other, better-known, subject, the Dutch master Johannes Vermeer (1632-75), used any kind of optical tools when he created his extraordinary paintings. ', 'print_section': 'C', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Dutch Masterwork, Under Reconstruction', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Dutch Masterwork, Under Reconstruction', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Jenison, Tim', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jillette, Penn', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': "Tim's Vermeer (Movie)", 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Teller', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-30T23:17:14+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Manohla Dargis', 'person': [{'firstname': 'Manohla', 'middlename': None, 'lastname': 'Dargis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3368649f-4129-5b30-9111-9025eb86700d', 'word_count': 765, 'uri': 'nyt://article/3368649f-4129-5b30-9111-9025eb86700d'}, {'abstract': 'A couple’s Japanese period paintings, collected on instinct and put in context by a wise curator, are on view at the Metropolitan Museum of Art.', 'web_url': 'https://www.nytimes.com/2014/01/31/arts/design/a-cascade-of-petals-from-the-mets-japanese-collection.html', 'snippet': 'A couple’s Japanese period paintings, collected on instinct and put in context by a wise curator, are on view at the Metropolitan Museum of Art.', 'lead_paragraph': 'The Japanese galleries at the Metropolitan Museum have been pulling crowds since John T. Carpenter became curator in 2011. He has taken the permanent collection, shaken it up, threaded it through with strategic loans and, like a good teacher, unfurled it logically around graspable themes. Who could resist a show that tells the art history of a complex culture, as Mr. Carpenter did last year, entirely in images of birds? ', 'print_section': 'C', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'It Started With a $2 Poster', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'It Started With a $2 Poster', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cotter, Holland', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Museum of Art', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Feinberg, Robert', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Feinberg, Betsy', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-30T23:17:47+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Holland Cotter', 'person': [{'firstname': 'Holland', 'middlename': None, 'lastname': 'Cotter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/55fb24f0-dcc9-5f3e-bf6d-408152b8ab67', 'word_count': 1391, 'uri': 'nyt://article/55fb24f0-dcc9-5f3e-bf6d-408152b8ab67'}, {'abstract': 'Box, the online storage and document-sharing company, was able to file its I.P.O. paperwork confidentially because of the JOBS Act, a law meant to make it easier for companies to go public.', 'web_url': 'https://dealbook.nytimes.com/2014/01/30/box-an-online-storage-start-up-is-said-to-file-for-an-i-p-o/', 'snippet': 'Box, the online storage and document-sharing company, was able to file its I.P.O. paperwork confidentially because of the JOBS Act, a law meant to make it easier for companies to go public.', 'lead_paragraph': 'Updated, 7:21 p.m. | Box, an online storage and document-sharing provider, has filed confidential paperwork to go public, a person briefed on the matter said on Thursday.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/business/dbpix-box/dbpix-box-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/31/business/dbpix-box/dbpix-box-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/business/dbpix-box/dbpix-box-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/business/dbpix-box/dbpix-box-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/business/dbpix-box/dbpix-box-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/31/business/dbpix-box/dbpix-box-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/31/business/dbpix-box/dbpix-box-thum