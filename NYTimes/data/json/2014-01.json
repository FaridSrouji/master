thumbnail': 'images/2014/01/25/nyregion/burial-1-LN/burial-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/25/nyregion/burial-1-LN/burial-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '6 Q’s About the News | South Bronx Students May Have Found Site of Slave Burial Ground', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-28T09:30:23+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c9a8c50e-36a4-53b0-bbe4-364d8ac1024d', 'word_count': 131, 'uri': 'nyt://article/c9a8c50e-36a4-53b0-bbe4-364d8ac1024d'}, {'abstract': 'A modern manufacturing morality tale in which workers and management came together to save an American icon.', 'web_url': 'https://www.nytimes.com/2014/02/02/magazine/building-a-harley-faster.html', 'snippet': 'A modern manufacturing morality tale in which workers and management came together to save an American icon.', 'lead_paragraph': 'While working the line at Harley-Davidson’s factory in York, Pa., Mark Dettinger noticed a small problem. The plastic piece that held electrical parts to the front of a motorcycle, a piece about the size of a hardcover book, wasn’t fitting correctly. Every time a new bike came down the line, it took a few extra shoves to push it into place. In fact, it took an extra 1.2 seconds. But Dettinger, who had spent some 20 years at the York plant, knew that every second counted. With 400 motorcycles built each shift, on two shifts a day, an extra 1.2 seconds per bike added up to 2,200 lost bikes annually. Millions could be lost in revenue. Maybe it wasn’t such a small problem.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/02economy/mag-02Economy-t_CA0-articleLarge.jpg', 'height': 435, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/02/02/magazine/02economy/mag-02Economy-t_CA0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 435}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/02economy/mag-02Economy-t_CA0-jumbo.jpg', 'height': 743, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/02economy/mag-02Economy-t_CA0-superJumbo.jpg', 'height': 1350, 'width': 1860, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/02economy/mag-02Economy-t_CA0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/02/02/magazine/02economy/mag-02Economy-t_CA0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/02economy/mag-02Economy-t_CA0-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Building a Harley Faster', 'kicker': None, 'content_kicker': None, 'print_headline': 'High on the Hog', 'name': None, 'seo': None, 'sub