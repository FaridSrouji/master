150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Swipe at Traditional Banking at a Forum Illuminating Bitcoin', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': 'A Swipe at Traditional Banking at a Forum on Bitcoin’s Future', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-28T21:09:36+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By Nathaniel Popper', 'person': [{'firstname': 'Nathaniel', 'middlename': None, 'lastname': 'Popper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a80550b5-6dc1-59b9-8b6f-1ab9388cf1aa', 'word_count': 647, 'uri': 'nyt://article/a80550b5-6dc1-59b9-8b6f-1ab9388cf1aa'}, {'abstract': 'Lawyers for Prince filed suit against 22 Internet users who posted links to file-sharing sites on Facebook or in blogs.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/01/28/prince-files-lawsuit-over-links-to-music-file-sharing-sites/', 'snippet': 'Lawyers for Prince filed suit against 22 Internet users who posted links to file-sharing sites on Facebook or in blogs.', 'lead_paragraph': 'Prince Rogers Nelson — the artist known as the artist formerly known as Prince — has filed a lawsuit in Federal District Court in San Francisco against 22 Internet users who, the singer’s lawyers say, are responsible for posting links to unauthorized recordings of his concerts. The filing, which was first reported on Torrent Freak, a website devoted to file sharing and copyright issues, describes the 22 bloggers as part of a network who used their blogs and Facebook pages to distribute the recordings. Prince hopes to recover $1 million from each. Only two of the 22 — Dan Chodera and Karina Jindrova — are listed by their real names. The others are listed by Internet handles like PurpleHouse2, PurpleKissTwo and TheUltimateBootlegExperience. ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/arts/29arts1/29arts1-articleLarge.jpg', 'height': 245, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/29/arts/29arts1/29arts1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 245}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/arts/29arts1/29arts1-jumbo.jpg', 'height': 419, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/arts/29arts1/29arts1-superJumbo.jpg', 'height': 682, 'width': 1668, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/arts/29arts1/29arts1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/29/arts/29arts1/29arts1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/arts/29arts1/29arts1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Prince Files Lawsuit Over Links to Music File-Sharing Sites', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': 'Prince Files Suit Over Links to File-Sharing Sites', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Audio Recordings and Downloads', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Suits and Litigation (Civil)', 'rank': 2, 'major': '