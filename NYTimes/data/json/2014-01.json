tion': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3877946e-3b0f-5e68-a2e5-3fd35a40ddde', 'word_count': 254, 'uri': 'nyt://article/3877946e-3b0f-5e68-a2e5-3fd35a40ddde'}, {'abstract': 'History shows that the reality of governing nearly always gives the lie to the I-can-square-the-circle formulations that winning candidates take to the White House.', 'web_url': 'https://www.nytimes.com/2014/01/17/us/politics/on-spying-obamas-woes-echo-those-of-past-presidents.html', 'snippet': 'History shows that the reality of governing nearly always gives the lie to the I-can-square-the-circle formulations that winning candidates take to the White House.', 'lead_paragraph': 'WASHINGTON — In his first Inaugural Address, President Obama stirred liberals by proclaiming that “we reject as false the choice between our safety and our ideals.”', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Spying, Woes of Obama Echo Those of Past Presidents', 'kicker': 'Political Memo', 'content_kicker': None, 'print_headline': 'On Spying, Woes of Obama Echo Those of Past Presidents', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Obama, Barack', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Harwood, John', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Presidents and Presidency (US)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Agency', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Espionage and Intelligence Services', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-01-16T17:22:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By John Harwood', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Harwood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/606fe294-13d6-5eaa-bfcd-0cd3464efd6a', 'word_count': 852, 'uri': 'nyt://article/606fe294-13d6-5eaa-bfcd-0cd3464efd6a'}, {'abstract': 'The main character in “The Act of Killing” tells the director an Oscar nomination would be an honor for both him and his country.', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2014/01/16/a-death-squad-leader-feels-honored/', 'snippet': 'The main character in “The Act of Killing” tells the director an Oscar nomination would be an honor for both him and his country.', 'lead_paragraph': 'The director Joshua Oppenheimer was at his father’s home outside Washington, D.C., when he got the news that his documentary, “The Act of Killing,” had received an Oscar nomination in the best feature documentary category. But he wasn’t just with his family when the announcement was made: watching with him on Skype from the other side of the world were members of the Indonesian crew that at some personal risk, helped him make his ground-breaking film about the mass killings carried out by the Indonesian armed forces and paramilitary death squads in the 1960s.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Death-Squad Leader Feels Honored', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Oppenheimer, Joshua', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-01-16T17:23:25+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Arts', 'byline': {'original': 'By Larry Rohter', 'person': [{'firstname': 'Larry', 'middlename': None, 'lastname': 'Rohter', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'orga