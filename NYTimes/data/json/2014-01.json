major': 'N'}, {'name': 'organizations', 'value': 'AKAMAI TECHNOLOGIES INC', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'General Catalyst Partners', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-30T13:07:59+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Business Day', 'byline': {'original': 'By William Alden', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Alden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/829cb539-f093-5b83-ace2-f2d53201446e', 'word_count': 305, 'uri': 'nyt://article/829cb539-f093-5b83-ace2-f2d53201446e'}, {'abstract': 'Alfonso and Jonas Cuarón recall the disastrous test screening for “Gravity” that led to audience suggestions for improvements. Among the ideas: add an alien or create a love story between the lead astronaut and mission control', 'web_url': 'https://carpetbagger.blogs.nytimes.com/2014/01/30/gravity-and-the-directors-contest/', 'snippet': 'Alfonso and Jonas Cuarón recall the disastrous test screening for “Gravity” that led to audience suggestions for improvements. Among the ideas: add an alien or create a love story between the lead astronaut and mission control', 'lead_paragraph': 'Major industry awards like those handed out by the Screen Actors Guild and the Producers Guild usually offer clues to the eventual best picture Oscar winner. But with “American Hustle,” “12 Years a Slave” and “Gravity” each collecting a big precursor prize, it’s turned into a three-way race. That was confirmed when the Directors Guild honored “Gravity” and its filmmaker, Alfonso Cuarón, a prize he couldn’t have expected after one disastrous test screening.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': '‘Gravity’ and the Directors’ Contest', 'kicker': 'Carpetbagger', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, '