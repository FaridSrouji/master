es/2014/01/15/business/bankiapic/bankiapic-superJumbo.jpg', 'height': 1317, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/business/bankiapic/bankiapic-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/15/business/bankiapic/bankiapic-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/15/business/bankiapic/bankiapic-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': "Bailed-Out Bankia Is Symbol of Spain's Financial Revival", 'kicker': None, 'content_kicker': None, 'print_headline': "Bailed-Out Bankia Is Symbol of Spain's Financial Revival", 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Bankia SA', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Spain', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Madrid (Spain)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Euro (Currency)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-14T23:42:41+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Raphael Minder', 'person': [{'firstname': 'Raphael', 'middlename': None, 'lastname': 'Minder', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8f86b00c-78d1-59ab-bec6-132a7e78ec81', 'word_count': 1362, 'uri': 'nyt://article/8f86b00c-78d1-59ab-bec6-132a7e78ec81'}, {'abstract': 'In “Brand New Ancients,” part of the Under the Radar festival, Kate Tempest looks for majesty and mystery in ordinary lives.', 'web_url': 'https://www.nytimes.com/2014/01/16/theater/brand-new-ancients-stars-kate-tempest-in-a-tragic-tale.html', 'snippet': 'In “Brand New Ancients,” part of the Under the Radar festival, Kate Tempest looks for majesty and mystery in ordinary lives.', 'lead_paragraph': 'The gold-plated cliché that a picture is worth a thousand words is flipped on its head in “Brand New Ancients,” the thrillingly good, genre-bending show from the young British writer and performer Kate Tempest, at St. Ann’s Warehouse through Sunday. As Ms. Tempest’s gorgeous streams of words flow out, they conjure a story so vivid it’s as if you had a state-of-the-art Blu-ray player stuffed into your brain, projecting image after image that sears itself into your consciousness. Both as writer and performer, Ms. Tempest stitches together words with such animate grace that language acquires an almost tactile quality, and the drama she unfolds — of betrayal, disappointment and violence among a handful of not especially special London dwellers — soars to operatic dimensions.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/arts/16TEMPEST/16TEMPEST-articleLarge.jpg', 'height': 431, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/16/arts/16TEMPEST/16TEMPEST-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 431}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/16/arts/16TEMPEST/16TEMPEST-jumbo.jpg', 'height': 736, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJu