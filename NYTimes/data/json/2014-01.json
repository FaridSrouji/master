', 'url': 'images/2014/01/09/nyregion/COUNCIL-sub/COUNCIL-sub-articleLarge.jpg', 'height': 422, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/09/nyregion/COUNCIL-sub/COUNCIL-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 422}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/09/nyregion/COUNCIL-sub/COUNCIL-sub-jumbo.jpg', 'height': 720, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/09/nyregion/COUNCIL-sub/COUNCIL-sub-superJumbo.jpg', 'height': 1440, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/09/nyregion/COUNCIL-sub/COUNCIL-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/09/nyregion/COUNCIL-sub/COUNCIL-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/09/nyregion/COUNCIL-sub/COUNCIL-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mayoral Ally Elected Speaker, Furthering City’s Liberal Shift', 'kicker': None, 'content_kicker': None, 'print_headline': 'Mayoral Ally Elected Speaker, Furthering City’s Liberal Shift', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mark-Viverito, Melissa', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'City Council (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank