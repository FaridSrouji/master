, 'major': 'N'}, {'name': 'subject', 'value': 'Olive Oil', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-01-25T21:43:56+0000', 'document_type': 'multimedia', 'news_desk': 'Opinion', 'section_name': 'Opinion', 'byline': {'original': 'By NICHOLAS BLECHMAN', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'BLECHMAN', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/627f45d8-bd77-5462-ac6c-3e4dfa122063', 'word_count': 0, 'uri': 'nyt://interactive/627f45d8-bd77-5462-ac6c-3e4dfa122063'}, {'abstract': 'Several high-powered Russian tycoons, including the Nets owner Mikhail D. Prokhorov, have lent their expertise and money to winter sports teams in anticipation of the Winter Olympics.', 'web_url': 'https://www.nytimes.com/2014/01/26/sports/olympics/deep-pocket-russians-adopt-teams-chasing-gold.html', 'snippet': 'Several high-powered Russian tycoons, including the Nets owner Mikhail D. Prokhorov, have lent their expertise and money to winter sports teams in anticipation of the Winter Olympics.', 'lead_paragraph': 'Not long ago, Russia’s once-heralded biathlon program was in tatters. The team was plagued with doping violations. It was losing big competitions to countries it expected to beat, like Belarus and Kazakhstan. A top biathlon official was convicted of trying to arrange the murder of a local governor. ', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/sports/oligarch/oligarch-articleLarge.jpg', 'height': 237, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/26/sports/oligarch/oligarch-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 237}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/sports/oligarch/oligarch-jumbo.jpg', 'height': 404, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/sports/oligarch/oligarch-superJumbo.jpg', 'height': 808, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/sports/oligarch/oligarch-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/26/sports/oligarch/oligarch-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/26/sports/oligarch/oligarch-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Russians With Deep Pockets Adopt Teams Going for Gold', 'kicker': None, 'content_kicker': None, 'print_headline': 'Russians With Deep Pockets Adopt Teams Going for Gold', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Olympic Games (2014)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dolnick, Sam', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Biathlon', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Russia', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Prokhorov, Mikhail D', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Putin, Vladimir V', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-25T21:51:17+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Olympics', 'byline': {'original': 'By Sam Dolnick', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Dolnick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/799a7b99-4b2c-5360-a767-861074f738e5', 'word_count': 1390, 'uri': 'nyt://article/799a7b99-4b2c-5360-a767-861074f738e5'}, {'abstract': 'Readers comment on my column about inequality before the law–as encountered, for example, by a man whom the police wrongly believed was hiding drugs internally.', 'web_url': 'https://kristof.blogs.nytimes.com/2014/01/25/readers-enemas-and-inequality/', 'snippet': 'Readers comment on my column about inequality before the law–as encountered, for example, by a man whom the police wrongly believed was hiding drugs internally.', 'lead_paragraph': 'My Sunday column is about a man whom the police thought might be hiding drugs internally. After a series of forced rectal exams, x-rays, enemas and a colonoscopy, the police decided their hunch had been wrong. But more broadly, the column is about the way society has drawn tradeoffs in the last few decades so as to empower security over liberty, even when (as in the drug war and mass incarceration missteps) they haven’t done much to boost security. And in the final analysis, this seems to me to be a matter of profound social inequality. With President Obama’s State of the Union Address reportedly planning to focus on economic inequality, we tend to see the issue through the prism of wealth and income, and obviously that’s important. But inequality in America has other dimensions, not least how we’re treated by the criminal justice system.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Readers, Enemas and Inequality', 'kicker': 'Nicholas Kristof', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-25T21:53:34+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ed4561d0-9f38-57b9-a6bd-60b782f50a67', 'word_count': 265, 'uri': 'nyt://article/ed4561d0-9f38-57b9-a6bd-60b782f50a67'}, {'abstract': 'The elaborate plans for snow removal before or during Super Bowl XLVIII at MetLife Stadium, if necessary, stem from a dangerous and embarrassing scene at Giants Stadium on Dec. 23, 1995.', 'web_url': 'https://www.nytimes.com/2014/01/26/sports/football/snowballs-at-giants-stadium-and-then-arrests.html', 'snippet': 'The elaborate plans for snow removal before or during Super Bowl XLVIII at MetLife Stadium, if necessary, stem from a dangerous and embarrassing scene at Giants Stadium on Dec. 23, 1995.', 'lead_paragraph': 'The elaborate plans for snow removal before or during Super Bowl XLVIII at MetLife Stadium, if necessary, stem from a dangerous and embarrassing scene at Giants Stadium on Dec. 23, 1995, during the Giants’ 27-17 loss to the San Diego Chargers.', 'print_section': 'SP', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Snowballs at Giants Stadium, and Then Arrests', 'kicker': None, 'content_kicker': None, 'print_headline': 'Snowballs at Giants Stadium, and Then Arrests', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Snow and Snowstorms', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'MetLife Stadium (NJ)', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Giants', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-25T21:56:57+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Pro Football', 'byline': {'original': 'By Da