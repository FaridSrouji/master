credit': None, 'type': 'image', 'url': 'images/2014/01/12/magazine/12cover_text/12cover_text-articleLarge.jpg', 'height': 730, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/12/magazine/12cover_text/12cover_text-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 730}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/magazine/12cover_text/12cover_text-jumbo.jpg', 'height': 1024, 'width': 843, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/magazine/12cover_text/12cover_text-superJumbo.jpg', 'height': 2048, 'width': 1685, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/magazine/12cover_text/12cover_text-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/12/magazine/12cover_text/12cover_text-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/magazine/12cover_text/12cover_text-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Reply All: The 1.12.14 Issue', 'kicker': 'Letters', 'content_kicker': None, 'print_headline': 'The 1.12.14 Issue', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-24T16:00:14+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8dbd9f45-6416-54be-86a2-401c697ba94f', 'word_count': 637, 'uri': 'nyt://article/8dbd9f45-6416-54be-86a2-401c697ba94f'}, {'abstract': 'Sisters act; shuttle tact.', 'web_url': 'https://www.nytimes.com/2014/01/26/magazine/discrimination-at-the-barber-shop.html', 'snippet': 'Sisters act; shuttle tact.', 'lead_paragraph': 'I am a woman with a short, boyish hairstyle. Is it unfair that I am charged more for a haircut than a man with similarly short hair? Different prices for different genders seems to me like a sexist relic from a less enlightened time. When I called local salons to find a new stylist (mine moved away), many of them balked when I said I should be charged the men’s rate because I have short hair. Many salons claim that “it has always been done that way.” This seems like a very bad excuse for an antiquated and discriminatory policy. YUKI MURATA, SANTA FE, N.M.', 'print_section': 'MM', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'height': 1316, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/02/02/magazine/ethicist/ethicist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1316}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-jumbo.jpg', 'height': 1024, 'width': 467, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-superJumbo.jpg', 'height': 2048, 'width': 934, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/02/02/magazine/ethicist/ethicist-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thum