images/2014/01/21/sports/BRONCOS1-LN/BRONCOS1-superJumbo.jpg', 'height': 1276, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/21/sports/BRONCOS1-LN/BRONCOS1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/21/sports/BRONCOS1-LN/BRONCOS1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/21/sports/BRONCOS1-LN/BRONCOS1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Weekly News Quiz | Jan. 14-Jan. 20, 2014', 'kicker': 'The Learning Network', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-21T19:01:17+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Education', 'byline': {'original': 'By Katherine Schulten', 'person': [{'firstname': 'Katherine', 'middlename': None, 'lastname': 'Schulten', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d29e92dc-4fd5-5882-91e9-5cc8509d455a', 'word_count': 56, 'uri': 'nyt://article/d29e92dc-4fd5-5882-91e9-5cc8509d455a'}, {'abstract': 'To toast her 93rd birthday, the Broadway icon brought down the house in a show with the cabaret performer Justin Vivian Bond.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/01/21/after-hours-at-town-hall-a-chance-to-shamelessly-worship-the-indomitable-carol-channing/', 'snippet': 'To toast her 93rd birthday, the Broadway icon brought down the house in a show with the cabaret performer Justin Vivian Bond.', 'lead_paragraph': 'Gay men of a certain age have strong feelings about Broadway divas, who modeled an outsize swagger in an era when they themselves couldn’t. Of all the give-’em-heck floorboard belters in this particular canon, few have attained the sainted status of Carol Channing, the blond-mopped, lisping “Hello Dolly” icon who turns 93 next week with her stage brio intact. When she was helped onstage last night at Town Hall for a special birthday tribute, grinning widely and wearing a white bouclé jacket and slacks, the cavernous house, packed mostly with middle-aged and older gay men, jumped to its feet and, for 10 minutes straight, released the sort of primal roar that might have accompanied a winning Superbowl pass.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/21/t-magazine/21channing-murphy/21channing-murphy-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/21/t-magazine/21channing-murphy/21channing-murphy-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/21/t-magazine/21channing-murphy/21channing-murphy-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/21/t-magazine/21channing-murphy/21channing-murphy-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/21/t-magazine/21channing-murphy/21channing-murphy-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/21/t-magazine/21channing-murphy/2