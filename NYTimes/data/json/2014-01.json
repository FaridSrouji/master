ht': 380}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/dining/29BOWL_SPAN/29BOWL-jumbo.jpg', 'height': 649, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/dining/29BOWL_SPAN/29BOWL-superJumbo.jpg', 'height': 1298, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/dining/29BOWL_SPAN/29BOWL-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/29/dining/29BOWL_SPAN/29BOWL-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/29/dining/29BOWL_SPAN/29BOWL-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'All This and a Bag of Chips', 'kicker': None, 'content_kicker': None, 'print_headline': 'All This and a Bag of Chips', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Sifton, Sam', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Super Bowl', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Holidays and Special Occasions', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-01-27T22:48:02+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/87f9c647-6e9d-5def-b24a-269c0847638c', 'word_count': 796, 'uri': 'nyt://article/87f9c647-6e9d-5def-b24a-269c0847638c'}, {'abstract': 'On Thursday night he spoke to a closed-door meeting of the American Israel Public Affairs Committee.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/01/27/so-much-for-mayor-deblasios-transparency-pledge/', 'snippet': 'On Thursday night he spoke to a closed-door meeting of the American Israel Public Affairs Committee.', 'lead_paragraph': 'For a guy who ran on a platform of transparency, inclusiveness and progressive new thinking, it hasn’t taken New York Mayor Bill de Blasio long to clam up.\xa0 On Thursday night he spoke to a closed-door meeting of the American Israel Public Affairs Committee, the leading pro-Israel lobbying group. The event, at the New York Hilton in Manhattan, was not listed on the mayor’s public schedule and a reporter who tried to attend was escorted away by AIPAC security staff.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'So Much for Mayor de Blasio’s Transparency Pledge', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-01-27T22:49:20+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Carol Giacomo', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Giacomo', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3dbb64e7-4da2-5e1d-8262-f19906086ee8', 'word_count': 390, 'uri': 'nyt://article/3dbb64e7-4da2-5e1d-8262-f19906086ee8'}, {'abstract': 'The video game Assassin’s Creed: Liberation, now available on several platforms, takes on slavery and liberation in the 18th century.', 'web_url': 'https://www.nytimes.com/2014/01/28/arts/video-games/assassins-creed-liberation-examines-colonial-blacks.html', 'snippet': 'The video game Assassin’s Creed: Liberation, now available on several platforms, takes on slavery and liberation in the 18th century.', 'lead_paragraph': 'In what sounds like a joke by a stand-up comic — Chris Rock? Dave Chappelle? — with a fondness for PlayStation, the greatest black heroine in the history of video games was forced to live for more than a year in the ghetto of Sony’s faltering hand-held console, the Vita.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/arts/liberation/liberation-articleLarge.jpg', 'height': 339, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/28/arts/liberation/liberation-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 339}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/arts/liberation/liberation-jumbo.jpg', 'height': 578, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/arts/liberation/liberation-superJumbo.jpg', 'height': 1080, 'width': 1914, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/28/arts/liberation/liberation-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/28/arts/liberation/liberation-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'ur