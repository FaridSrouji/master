 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Greece, Elites Are Starting to Feel the Pain', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Greece, Elites Are Starting To to Feel the Pain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Greece', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'European Sovereign Debt Crisis (2010- )', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Corruption (Institutional)', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-01-16T10:25:57+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Europe', 'byline': {'original': 'By Niki Kitsantonis', 'person': [{'firstname': 'Niki', 'middlename': None, 'lastname': 'Kitsantonis', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e24f80f0-6506-5175-a020-8fec88ed2a13', 'word_count': 1071, 'uri': 'nyt://article/e24f80f0-6506-5175-a020-8fec88ed2a13'}, {'abstract': 'Also on the Minute, a widening Air Force scandal and the fate of “Alpha House.”', 'web_url': 'https://www.nytimes.com/news/minute/2014/01/16/times-minute-mutts-at-westminster/', 'snippet': 'Also on the Minute, a widening Air Force scandal and the fate of “Alpha House.”', 'lead_paragraph': 'In the Video', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Times Minute | Mutts Take On Westminster', 'kicker': 'The New York Times News Minute', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-01-16T10:27:29+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'Multimedia/Photos', 'byline': {'original': 'By Quyn Do', 'person': [{'firstname': 'Quyn', 'middlename': None, 'lastname': 'Do', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8099fd95-5832-5a40-81ea-a5331774c136', 'word_count': 23, 'uri': 'nyt://article/8099fd95-5832-5a40-81ea-a5331774c136'}, {'abstract': 'What are your sleep habits? Do you feel that you generally get enough sleep every night?', 'web_url': 'https://learning.blogs.nytimes.com/2014/01/16/how-much-of-a-priority-do-you-make-sleep-in-your-life/', 'snippet': 'What are your sleep habits? Do you feel that you generally get enough sleep every night?', 'lead_paragraph': 'You may feel as if there just isn’t enough time in the day to get a good night’s sleep. To get everything done that you need and want to do, you end up going to bed too late and then waking up too early. Or you may think sleep is something you don’t mess around with, and no matter what, you make sure to get your eight hours or more every night. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/sunday-review/12SLEEP-LN/12SLEEP-articleLarge.jpg', 'height': 736, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/12/sunday-review/12SLEEP-LN/12SLEEP-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 736}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/sunday-review/12SLEEP-LN/12SLEEP-jumbo.jpg', 'height': 1024, 'width': 835, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/sunday-review/12SLEEP-LN/12SLEEP-superJumbo.jpg', 'height': 2048, 'width': 1669, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/sunday-review/12SLEEP-LN/12SLEEP-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType