cker': None, 'content_kicker': None, 'print_headline': 'Trade Show Bounces Back, AlongWith the Economy', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Golf', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Conventions, Fairs and Trade Shows', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-01-25T04:47:56+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Golf', 'byline': {'original': 'By Lisa D. Mickey', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/dea67354-79e3-5183-b3a1-6cc6705a1b27', 'word_count': 846, 'uri': 'nyt://article/dea67354-79e3-5183-b3a1-6cc6705a1b27'}, {'abstract': 'Miguel Mejia-Ramos said he had attacked his wife and, not having car seats, stabbed his daughters rather than flee with them, according to court papers.', 'web_url': 'https://www.nytimes.com/2014/01/25/nyregion/a-fit-of-jealousy-a-lack-of-child-car-seats-and-then-three-deadly-stabbings.html', 'snippet': 'Miguel Mejia-Ramos said he had attacked his wife and, not having car seats, stabbed his daughters rather than flee with them, according to court papers.', 'lead_paragraph': 'After killing his wife in a jealous rage, officials said, Miguel Mejia-Ramos went over to his two young daughters, still lying in their beds at the family’s home in Queens. His intention, he would tell detectives, was to spare the children.', 'print_section': 'A', 'print_page': '14', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/25/nyregion/mejia-2/mejia-2-jumbo.jpg', 'height': 422, 'width': 304, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'ur