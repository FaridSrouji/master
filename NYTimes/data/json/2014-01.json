th': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/t-magazine/08toutain-lobrano/08toutain-lobrano-jumbo-v3.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/t-magazine/08toutain-lobrano/08toutain-lobrano-superJumbo-v3.jpg', 'height': 1333, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/t-magazine/08toutain-lobrano/08toutain-lobrano-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/08/t-magazine/08toutain-lobrano/08toutain-lobrano-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/t-magazine/08toutain-lobrano/08toutain-lobrano-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Food Matters | A Peek Inside the Hottest New Restaurant in Paris', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Restaurants', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'France', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-01-08T18:36:58+0000', 'document_type': 'article', 'news_desk': '', 'section_name': 'T Magazine', 'byline': {'original': 'By Alec Lobrano', 'person': [{'firstname': 'Alec', 'middlename': None, 'lastname': 'Lobrano', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d80ad7e-101f-57a0-aa7e-2e2bbf8db3e9', 'word_count': 524, 'uri': 'nyt://article/9d80ad7e-101f-57a0-aa7e-2e2bbf8db3e9'}, {'abstract': 'The German finance minister defends his country’s approach, even as Berlin finds itself at odds with much of Europe over a bank rescue system.', 'web_url': 'https://www.nytimes.com/2014/01/09/business/international/us-treasury-secretary-urges-germany-to-do-more-on-banks-and-economy.html', 'snippet': 'The German finance minister defends his country’s approach, even as Berlin finds itself at odds with much of Europe over a bank rescue system.', 'lead_paragraph': 'BERLIN — Jacob J. Lew, the U.S. Treasury secretary, urged Germany and its European partners on Wednesday to take even bolder steps in terms of banking reform, as his German counterpart, Wolfgang Schäuble, defended the complicated and still incomplete blueprint agreed to by European finance ministers in December.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'U.S. Treasury Secretary Urges Germany to Do More on Banks and Economy', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'International Trade and World Market', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'European Union', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Lew, Jacob J', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Schauble, Wolfgang', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Europe', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-08T18:40:00+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Melissa Eddy', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Eddy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8aaf54ba-32ec-5b23-ad04-c68898e7a216', 'word_count': 842, 'uri': 'nyt://article/8aaf54ba-32ec-5b23-ad04-c68898e7a216'}, {'abstract': 'Sheldon Best, the star of Atlantic Theater’s “The Loneliness of the Long Distance Runner,” speaks about his niche as an athletic actor.', 'web_url': 'https://www.nytimes.com/2014/01/12/theater/sheldon-best-of-loneliness-of-the-long-distance-runner.html', 'snippet': 'Sheldon Best, the star of Atlantic Theater’s “The Loneliness of the Long Distance Runner,” speaks about his niche as an athletic actor.', 'lead_paragraph': 'Sheldon Best did his share of slashing in the play “Alice in Slasherland” and even more punching in “Sucker Punch.” Now, in Roy Williams’s modernization of the 1959 short story “The Loneliness of the Long Distance Runner,” Mr. Best is making good on yet another titular promise of physical exertion.', 'print_section': 'AR', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/arts/12SNAPSHOT/12SNAPSHOT-articleLarge.jpg', 'height': 981, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/12/arts/12SNAPSHOT/12SNAPSHOT-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 981}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/arts/12SNAPSHOT/12SNAPSHOT-jumbo.jpg', 'height': 1024, 'width': 627, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/arts/12SNAPSHOT/12SNAPSHOT-superJumbo.jpg', 'height': 2048, 'width': 1253, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/arts/12SNAPSHOT/12SNAPSHOT-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/12/arts/12SNAPSHOT/12SNAPSHOT-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/12/arts/12SNAPSHOT/12SNAPSHOT-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Steps of a Stage Career, Taken at a Run', 'kicker': 'Snapshot | Sheldon Best', 'content_kicker': None, 'print_headline': 'Steps of a Stage Career, Taken at a Run', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Grode, Eric', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Theater', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Atlantic Theater Co', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Williams, Roy', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Best, Sheldon', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Loneliness of the Long Distance Runner (Play)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-01-08T18:44:24+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Theater', 'byline': {'original': 'By Eric Grode', 'person': [{'firstname': 'Eric', 'middlename': None, 'lastname': 'Grode', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8870d2a4-4c9d-5439-8d22-165a93cfad45', 'word_count': 618, 'uri': 'nyt://article/8870d2a4-4c9d-5439-8d22-165a93cfad45'}, {'abstract': 'The show, which is inspired by the late rapper but is not a biographical treatment of his life, is scheduled to open on June 19.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/01/08/tupac-shakur-musical-sets-broadway-opening-date/', 'snippet': 'The show, which is inspired by the late rapper but is not a biographical treatment of his life, is scheduled to open on June 19.', 'lead_paragraph': '“Holler if Ya Hear Me,” a new musical inspired by the work of rapper Tupac Shakur, will begin performances on Broadway at the Palace Theater on May 26, the producers said on Wednesday. The $8 million production is not a musical biography about Shakur, who died in a drive-by shooting in 1996 at the age of 25; rather, the producers said in a statement, it is an original story about “friendship, family, revenge, change and hope” as poor urban residents struggle against challenges in their lives. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/arts/08artsbeat-tupac/08artsbeat-tupac-articleLarge.jpg', 'height': 413, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/08/arts/08artsbeat-tupac/08artsbeat-tupac-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 413}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/arts/08artsbeat-tupac/08artsbeat-tupac-jumbo.jpg', 'height': 705, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/arts/08artsbeat-tupac/08artsbeat-tupac-superJumbo.jpg', 'height': 1232, 'width': 1790, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/08/arts/08artsbeat-tupac/08artsbeat-tupac-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/01/08/arts/08artsbeat-tupac/08artsbeat-tupac-thumbStanda