jor': 'N'}], 'pub_date': '2014-01-13T00:26:14+0000', 'document_type': 'multimedia', 'news_desk': 'Culture', 'section_name': 'Movies', 'subsection_name': 'Awards Season', 'byline': {'original': 'Melena Ryzik and Shern Sharma', 'person': [{'firstname': 'Melena', 'middlename': None, 'lastname': 'Ryzik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Shern', 'middlename': None, 'lastname': 'Sharma', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/0c2ff8e7-8e30-553f-81cd-9a34074e41e9', 'word_count': 0, 'uri': 'nyt://video/0c2ff8e7-8e30-553f-81cd-9a34074e41e9'}, {'abstract': 'The case exemplifies a glaring failure in the American-led nation-building effort here: weak government institutions are often staffed by unqualified officials.', 'web_url': 'https://www.nytimes.com/2014/01/13/world/asia/afghan-police-often-derided-face-another-drawback-missing-pay.html', 'snippet': 'The case exemplifies a glaring failure in the American-led nation-building effort here: weak government institutions are often staffed by unqualified officials.', 'lead_paragraph': 'KABUL, Afghanistan — Outgunned by the Taliban and often derided by some as little more than uniformed thieves, police officers in Afghanistan do not have an easy job. But in recent months, their lives have gotten even tougher: Afghanistan’s police officers have not been paid since November, and some have not seen a paycheck since October.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/01/13/world/AFGHANISTAN/AFGHANISTAN-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/01/13/world/AFGHANISTAN/AFGHANISTAN-articleLarge.jpg', 'xlargewidth': 60