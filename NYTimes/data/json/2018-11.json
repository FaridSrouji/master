.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/17/opinion/18BAIRD/merlin_146837520_6fbfc1b0-1d00-4250-b1f5-bbc94d7e454c-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/18BAIRD/merlin_146837520_6fbfc1b0-1d00-4250-b1f5-bbc94d7e454c-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/18BAIRD/merlin_146837520_6fbfc1b0-1d00-4250-b1f5-bbc94d7e454c-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/18BAIRD/18BAIRD-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/17/opinion/18BAIRD/18BAIRD-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/18BAIRD/18BAIRD-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Your Fake Australian Accent Is Terrible, Mate', 'kicker': None, 'content_kicker': None, 'print_headline': 'Your Fake Australian Accent Is Terrible, Mate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Voice and Speech', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'English Language', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Jackman, Hugh', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Australia', 'rank': 4, 'major': 'N'}], 'pub_date': '2018-11