_section': 'C', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/arts/30goodswimmer1/merlin_147454476_afdcbb0c-1dc3-4c1e-9bc5-235d0422caa2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/30/arts/30goodswimmer1/merlin_147454476_afdcbb0c-1dc3-4c1e-9bc5-235d0422caa2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/arts/30goodswimmer1/merlin_147454476_afdcbb0c-1dc3-4c1e-9bc5-235d0422caa2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/arts/30goodswimmer1/merlin_147454476_afdcbb0c-1dc3-4c1e-9bc5-235d0422caa2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/arts/30goodswimmer1/30goodswimmer1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/30/arts/30goodswimmer1/30goodswimmer1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/arts/30goodswimmer1/30goodswimmer1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘The Good Swimmer’ Stays Out of the Deep End', 'kicker': None, 'content_kicker': None, 'print_headline': 'Staying Out of the Deep End', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'n