umbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/04/books/review/04Freedman/04Freedman-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Race and Class and Youth Football in Brownsville, Brooklyn', 'kicker': 'Nonfiction', 'content_kicker': None, 'print_headline': 'End Run', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Never Ran, Never Will: Boyhood and Football in a Changing American Inner City (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Samaha, Albert', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Brownsville (Brooklyn, NY)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Football', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Youth', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-11-02T09:00:06+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Samuel G. Freedman', 'person': [{'firstname': 'Samuel', 'middlename': 'G.', 'lastname': 'Freedman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/23375e26-71db-5282-9553-87a4213616b0', 'word_count': 769, 'uri': 'nyt://article/23375e26-71db-5282-9553-87a4213616b0'}, {'abstract': 'A journal entry prompted Corinna da Fonseca-Wollheim to seek out the novels of Irmgard Keun, once dubbed the “It Girl” of German literature.', 'web_url': 'https://www.nytimes.com/2018/11/02/books/review/irmgard-keun-gilgi.html', 'snippet': 'A journal entry prompted Corinna da Fonseca-Wollheim to seek out the novels of Irmgard Keun, once dubbed the “It Girl” of German literature.', 'lead_paragraph': 'I first came across the name “Gilgi” on a page of my grandmother Käthe’s diary from 1932, tucked between mentions of “Shanghai Express” with Marlene Dietrich and a performance by the Jewish cabaret star Dela Lipinskaja. “Such courage!” Käthe wrote, of the character Gilgi. I was curious for any glimpse into my grandmother’s mind during this chapter of her life when she was an expressionist dancer in Hamburg and sported boyish haircuts and berets. She had recently fallen in love with my grandfather Hermann and was summoning the courage to divorce her husband. From Wikipedia I learned that “Gilgi” was the first novel by a writer named Irmgard Keun (1905-82), who had been the It Girl of the German literary scene in the final years of the Weimar Republic. Intrigued, I ordered a copy.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/04/books/review/04Fonseca-Wollheim/merlin_145445832_0cb521cf-c4c3-4e7b-8ebf-38b2924636fa-articleLarge.jpg', 'height': 830, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/04/books/review/04Fonseca-Wollheim/merlin_145445832_0cb521cf-c4c3-4e7b-8ebf-38b2924636fa-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 830}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/04/books/review/04Fonseca-Wollheim/merlin_145445832_0cb521cf-c4c3-4e7b-8ebf-38b2924636fa-jumbo.jpg', 'height': 1024, 'width': 740, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/04/books/review/04Fonseca-Wollheim/merlin_145445832_0cb521cf-c4c3-4e7b-8ebf-38b2924636fa-superJumbo.jpg', 'height': 2048, 'width': 1480, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/04/books/review/04Fonseca-Wollheim/merlin_145445832_0cb521cf-c4c3-4e7b-8ebf-38b2924636fa-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/04/books/review/04Fonseca-Wollheim/merlin_145445832_0cb521cf-c4c3-4e7b-8ebf-38b2924636fa-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/04/books/review/04Fonseca-Wollheim/merlin_145445832_0cb521cf-c4c3-4e7b-8ebf-38b2924636fa-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How a Grandmother’s Diary Led to a Long-Lost Literary Gem', 'kicker': 'Reconsideration', 'content_kicker': None, 'print_headline': 'Discovering a Long-Lost Literary Gem', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Gilgi (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Keun, Irmgard (1905-82)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-11-02T09:00:06+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8beff767-298c-5608-9829-33da7698bb62', 'word_count': 1301, 'uri': 'nyt://article/8beff767-298c-5608-9829-33da7698bb62'}, {'abstract': 'What causes do you, as a student, support now — with either your money or your time and effort?', 'web_url': 'https://www.nytimes.com/2018/11/02/learning/if-you-had-an-extra-billion-dollars-what-cause-would-you-support-with-your-philanthropy.html', 'snippet': 'What causes do you, as a student, support now — with either your money or your time and effort?', 'lead_paragraph': 'For most of us, it’s hard to imagine being a billionaire. But let’s say you built yourself your dream home, took that ideal vacation and bought a fancy car — or five — and yet you still had plenty of money to help make the world a better place. What cause or causes would you support with your extra billion dollars?', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/31/opinion/31wyss1/merlin_135378924_8f614be2-0a42-4b8d-a48c-52ccf23ef930-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/10/31/opinion/31wyss1/merlin_135378924_8f614be2-0a42-4b8d-a48c-52ccf23ef930-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/31/opinion/31wyss1/merlin_135378924_8f614be2-0a42-4b8d-a48c-52ccf23ef930-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/31/opinion/31wyss1/merlin_135378924_8f614be2-0a42-4b8d-a48c-52ccf23ef930-superJumbo.jpg', 'height': 1361, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/31/opinion/31wyss1/31wyss1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/10/31/opinion/31wyss1/31wyss1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/10/31/opinion/31wyss1/31wyss1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'If You Had an Extra Billion Dollars, What Cause Would You Support With Your Philanthropy?', 'kicker': 'Student Opinion', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-11-02T09:00:06+0000', 'document_type': 'article', 'news_desk': 'Learning', 'section_name': 'The Learning Network', 'byline': {'original': 'By Michael Gonchar', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Gonchar', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf051c2e-d2b7-581d-a23f-756b9cabca11', 'word_count': 643, 'uri': 'nyt://article/bf051c2e-d2b7-581d-a23f-756b9cabca11'}, {'abstract': 'The doctor, Fatima Cody Stanford, was on a flight to Boston on Tuesday when she helped a fellow passenger who was distressed. Two flight attendants questioned whether she was a doctor.', 'web_url': 'https://www.nytimes.com/2018/11/02/us/delta-black-doctor-racial-profiling.html', 'snippet': 'The doctor, Fatima Cody Stanford, was on a flight to Boston on Tuesday when she helped a fellow passenger who was distressed. Two flight attendants questioned whether she was a doctor.', 'lead_paragraph': 'Dr. Fatima Cody Stanford was on a Delta flight from Indianapolis to Boston on Tuesday when she noticed the woman next to her showing signs of distress. So Dr. Stanford did what she was trained to do in more than a decade of experience as a doctor — she began to assist her.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/03/business/03xp-doctor-1/03xp-doctor-1-articleLar