k': 4, 'major': 'N'}], 'pub_date': '2018-11-29T14:01:20+0000', 'document_type': 'article', 'news_desk': 'RealEstate', 'section_name': 'Real Estate', 'byline': {'original': 'By Stefanos Chen', 'person': [{'firstname': 'Stefanos', 'middlename': None, 'lastname': 'Chen', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/620eff4a-465a-5a36-b31d-311b4fad3358', 'word_count': 104, 'uri': 'nyt://article/620eff4a-465a-5a36-b31d-311b4fad3358'}, {'abstract': 'A ProPublica team investigated the death of a young black man in Weirton, W. Va., and the firing of a police officer who did not shoot his gun.', 'web_url': 'https://www.nytimes.com/2018/11/29/lens/weirton-police-shooting-propublica.html', 'snippet': 'A ProPublica team investigated the death of a young black man in Weirton, W. Va., and the firing of a police officer who did not shoot his gun.', 'lead_paragraph': 'Deadly police shootings are an unfortunate staple of American journalism. I’ve covered a bunch of them in my time as a newspaperman, as both a reporter and an editor: Sixty-six-year-old Eleanor Bumpurs, killed by a white cop in the Bronx; 13-year-old Nicholas Heyward Jr., armed only with a toy gun, shot dead by a black officer while playing cops and robbers in a Brooklyn housing project. Then there was Ray Cannon, a newly married white cop, shot between the eyes by a black teenager during a stickup in a bicycle shop; or Omar Edwards, a black cop who was a star running back on the Police Department’s football team, killed by a white colleague as Officer Edwards, in plain clothes and with pistol drawn, chased a thief down a Harlem street.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/29/lens/29Weirton1/29Weirton1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/29/lens/29Weirton1/29Weirton1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/29/lens/29Weirton1/29Weirton1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/29/lens/29Weirton1/29Weirton1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/29/lens/29Weirton1/29Weirton1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/29/lens/29Weirton1/29Weirton1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/29/lens/29Weirton1/29Weirton1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Images From the Aftermath of a Rust Belt Police Shooting', 'kicker': 'lens', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Mental Health and Disorders', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Mader, Stephen', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Weirton (W Va)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Firearms', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-11-29T14:05:45+0000', 'document_type': 'article', 'news_desk': 'Photo', 'section_name': 'Lens', 'byline': {'original': '