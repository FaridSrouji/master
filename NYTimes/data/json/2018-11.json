jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/arts/10salon-art1/10salon-art1-superJumbo.jpg', 'height': 827, 'width': 1219, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/arts/10salon-art1/10salon-art1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/10/arts/10salon-art1/10salon-art1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/arts/10salon-art1/10salon-art1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Salon Art + Design, a Fair With Wit, Cheek, History', 'kicker': 'Exhibition Review', 'content_kicker': None, 'print_headline': 'A Fair With Wit, Cheek and History', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Furniture', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Design', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'ARMORIES', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Park Avenue Armory (Manhattan, NY)', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Wright, Frank Lloyd', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Denmark', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'South Africa', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'Salon Art + Design (Exhibit)', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-11-09T18:39:22+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Joseph Giovannini', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'Giovannini', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/96df8115-78ce-51d3-9ddc-0645b20d9464', 'word_count': 971, 'uri': 'nyt://article/96df8115-78ce-51d3-9ddc-0645b20d9464'}, {'abstract': 'A cross between fondue and potato purée, this sweet, beautifully autumnal dish is sure to warm you from the inside.', 'web_url': 'https://www.nytimes.com/2018/11/09/dining/sweet-potato-aligot.html', 'snippet': 'A cross between fondue and potato purée, this sweet, beautifully autumnal dish is sure to warm you from the inside.', 'lead_paragraph': 'In a perfect French pommes aligot, it’s hard to know where the potatoes end and the cheese begins. A molten, creamy mass of potatoes permeated with mountain cheeses, aligot combines the stretchy pull of fondue with the silky suppleness of potato purée. Soft, gooey and eminently soothing, it’s just the thing to make on an icy, dark day, or at least, when it feels that way deep in your soul.', 'print_section': 'D', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/14/dining/14appe1/merlin_146213454_990d6204-c0c9-484d-ac9d-d8e70276580e-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/14/dining/14appe1/merlin_146213454_990d6204-c0c9-484d-ac9d-d8e70276580e-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/14/dining/14appe1/merlin_146213454_990d6204-c0c9-484d-ac9d-d8e70276580e-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank