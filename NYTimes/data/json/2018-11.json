o', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/opinion/19opdoc-chicken-img/19opdoc-chicken-img-superJumbo-v2.jpg', 'height': 1024, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/opinion/19opdoc-chicken-img/19opdoc-chicken-img-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/23/opinion/19opdoc-chicken-img/19opdoc-chicken-img-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/opinion/19opdoc-chicken-img/19opdoc-chicken-img-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Tungrus and the Chicken From Hell', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chickens', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Families and Family Life', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Pets', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Mumbai (India)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-11-19T20:05:25+0000', 'document_type': 'multimedia', 'news_desk': '', 'section_name': 'Opinion', 'byline': {'original': 'By Rishi Chandna', 'person': [{'firstname': 'Rishi', 'middlename': None, 'lastname': 'Chandna', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/8b5e4140-913e-50d6-9e16-9ff3ef9f99b4', 'word_count': 0, 'uri': 'nyt://video/8b5e4140-913e-50d6-9e16-9ff3ef9f99b4'}, {'abstract': 'A cautionary tale about the epic power struggle between humans and poultry.', 'web_url': 'https://www.nytimes.com/2018/11/19/opinion/tungrus-and-the-chicken-from-hell-india.html', 'snippet': 'A cautionary tale about the epic power struggle between humans and poultry.', 'lead_paragraph': 'Mumbai, India, where I live, is a constant clash of contradictions. You have elders who grew up in villages living with their cosmopolitan children, villagers who have moved to work in the city, and city folk who crave rustic weekend getaways. Different perspectives collide and breed tension, even within households. In this cross section of humanity, few things are considered too bizarre to be off limits, and the mundane parts of daily life can intersect with the insane.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Tungrus and the Chicken From Hell ', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Chickens', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Mumbai (India)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Vegetarianism', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Pets', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Meat', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-11-19T20:07:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Rishi Chandna', 'person': [{'firstname': 'Rishi', 'middlename': None, 'lastname': 'Chandna', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/f2dc5a7c-5962-5264-8d21-cb558aaec73b', 'word_count': 382, 'uri': 'nyt://article/f2dc5a7c-5962-5264-8d21-cb558aaec73b'}, {'abstract': 'Lance Mason, a former judge in Cuyahoga County and a top Democratic state lawmaker, was taken into custody after his wife, Aisha Fr