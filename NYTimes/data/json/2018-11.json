': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Who’s the Real American Psycho?', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Who’s the Real American Psycho?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Iraq War (2003-11)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Bale, Christian', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'McKay, Adam', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cheney, Dick', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Vice (Movie)', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Halliburton Company', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-11-10T19:30:01+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Maureen Dowd', 'person': [{'firstname': 'Maureen', 'middlename': None, 'lastname': 'Dowd', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/c751f88b-39ae-58d8-8bb7-2131624b5a64', 'word_count': 924, 'uri': 'nyt://article/c751f88b-39ae-58d8-8bb7-2131624b5a64'}, {'abstract': 'I add the leaf of the cocoyam plant to dried mudfish, mushrooms and snails, and think of my indomitable ancestors. ', 'web_url': 'https://www.nytimes.com/2018/11/10/opinion/sunday/slow-cooking-history.html', 'snippet': 'I add the leaf of the cocoyam plant to dried mudfish, mushrooms and snails, and think of my indomitable ancestors. ', 'lead_paragraph': 'Fufu is boiled green plantains and cassava, pounded in a wooden mortar to a distinct pum-pum-pum beat. Fufu, the way I like it, comes out a warm yellow, with specks of black from the plantain seeds. But fufu on its own is bland. Fufu is both food and utensil, and strong enough to scoop up soup. Ghanaians eat it with palm soup, groundnut soup, a tomato soup called light soup or ebunuebunu, green soup. Adventurous eaters go for a combination of all four, known as nkatenkontobenkwan. But I am a purist. Ebunuebunu is my favorite.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/14/opinion/sunday/11attah/merlin_146588169_4979f70a-89c8-4f6f-84c0-8b538f469542-articleLarge.jpg', 'height': 452, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/14/opinion/sunday/11attah/merlin_146588169_4979f70a-89c8-4f6f-84c0-8b538f469542-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 452}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/14/opinion/sunday/11attah/merlin_146588169_4979f70a-89c8-4f6f-84c0-8b538f469542-jumbo.jpg', 'height': 771, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/14/opinion/sunday/11attah/merlin_146588169_4979f70a-89c8-4f6f-84c0-8b538f469542-superJumbo.jpg', 'height': 1445, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/14/opinion/sunday/11attah/11attah-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/14/opinion/sunday/11attah/11attah-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/14/opinion/sunday/11attah/11attah-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Slow-Cooking History ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Slow-Cooking History', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'AFRICA', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Soups', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Food', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Local Food', 'rank': 5, 'major': 'N'}], 'pub_date': '2018-11-10T19:30:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Ayesha Harruna Attah', 'person': [{'firstname': 'Ayesha', 'middlename': 'Harruna', 'lastname': 'Attah', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/2d74639d-a8fb-585c-a402-ed135701df05', 'word_count': 1201, 'uri': 'nyt://article/2d74639d-a8fb-585c-a402-ed135701df05'}, {'abstract': 'Two years of progressive organizing built the blue wave.', 'web_url': 'https://www.nytimes.com/2018/11/10/opinion/sunday/democrats-resistance-women-georgia-trump.html', 'snippet': 'Two years of progressive organizing built the blue wave.', 'lead_paragraph': 'In April 2017, progressives across America turned toward Georgia’s Sixth District for the race to fill the House seat vacated by Tom Price, who’d become President Trump’s (short-lived) secretary of health and human services. That affluent, highly educated district in Atlanta’s northern suburbs had been solidly Republican for decades; Newt Gingrich had held it for 20 years, and Price won his 2016 election by more than 23 percentage points. But Trump had prevailed there only narrowly, and Democrats dreamed of using the special election to rebuke him.', 'print_section': 'SR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subt