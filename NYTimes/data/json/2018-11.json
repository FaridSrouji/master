olitically engaged work of metafiction.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/09/books/review/1209-BKS-COVER_Sub01/1209-BKS-COVER_Sub01-articleLarge.gif', 'height': 528, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/09/books/review/1209-BKS-COVER_Sub01/1209-BKS-COVER_Sub01-articleLarge.gif', 'xlargewidth': 600, 'xlargeheight': 528}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/09/books/review/1209-BKS-COVER_Sub01/1209-BKS-COVER_Sub01-jumbo.gif', 'height': 902, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/09/books/review/1209-BKS-COVER_Sub01/1209-BKS-COVER_Sub01-superJumbo.jpg', 'height': 1824, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/09/books/review/1209-BKS-COVER_Sub01/1209-BKS-COVER_Sub01-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/12/09/books/review/1209-BKS-COVER_Sub01/1209-BKS-COVER_Sub01-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/09/books/review/1209-BKS-COVER_Sub01/1209-BKS-COVER_Sub01-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The 10 Best Books of 2018', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'm