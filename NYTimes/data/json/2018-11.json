 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/arts/23dcartroundup-traylor1/merlin_146981355_4542e963-960b-472b-b694-8b947bf401fa-articleLarge.jpg', 'height': 738, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/23/arts/23dcartroundup-traylor1/merlin_146981355_4542e963-960b-472b-b694-8b947bf401fa-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 738}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/arts/23dcartroundup-traylor1/merlin_146981355_4542e963-960b-472b-b694-8b947bf401fa-jumbo.jpg', 'height': 1024, 'width': 832, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/arts/23dcartroundup-traylor1/merlin_146981355_4542e963-960b-472b-b694-8b947bf401fa-superJumbo.jpg', 'height': 2048, 'width': 1664, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/arts/23dcartroundup-traylor1/23dcartroundup-traylor1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/23/arts/23dcartroundup-traylor1/23dcartroundup-traylor1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/23/arts/23dcartroundup-traylor1/23dcartroundup-traylor1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Indelible Impressions From 3 Shows in Washington', 'kicker': None, 'content_kicker': None, 'print_headline': 'Making Impressions in the Capital', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{