sons', 'value': 'Bajtlik, Jan', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-11-09T18:09:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Brian Floca', 'person': [{'firstname': 'Brian', 'middlename': None, 'lastname': 'Floca', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/38d68549-47f7-55d4-9f9e-8a1cfab24764', 'word_count': 1200, 'uri': 'nyt://article/38d68549-47f7-55d4-9f9e-8a1cfab24764'}, {'abstract': 'The death of her brother in police custody has turned Ilaria Cucchi into a prominent and admired rights activist. But the sprawling case continues to grind through the courts.', 'web_url': 'https://www.nytimes.com/2018/11/09/world/europe/ilaria-cucchi-brother-italy.html', 'snippet': 'The death of her brother in police custody has turned Ilaria Cucchi into a prominent and admired rights activist. But the sprawling case continues to grind through the courts.', 'lead_paragraph': 'ROME — Before her brother Stefano died in the prison wing of a Rome hospital on Oct. 22, 2009, Ilaria Cucchi lived what she described as a “normalissima” life, as a model wife and working mother of two.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/world/10cucchi-print/merlin_146563440_a21f880d-eece-4792-ae79-cd0a5cb8fad5-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/10/world/10cucchi-print/merlin_146563440_a21f880d-eece-4792-ae79-cd0a5cb8fad5-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/world/10cucchi-print/merlin_1465