', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/books/review/18Crime/merlin_146417136_31ae3d43-2297-48a3-bca6-8e72f2b02087-articleLarge.jpg', 'height': 375, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/18/books/review/18Crime/merlin_146417136_31ae3d43-2297-48a3-bca6-8e72f2b02087-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 375}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/books/review/18Crime/merlin_146417136_31ae3d43-2297-48a3-bca6-8e72f2b02087-jumbo.jpg', 'height': 639, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/books/review/18Crime/merlin_146417136_31ae3d43-2297-48a3-bca6-8e72f2b02087-superJumbo.jpg', 'height': 1278, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/books/review/18Crime/18Crime-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/18/books/review/18Crime/18Crime-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/books/review/18Crime/18Crime-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Puzzles and Paradoxes: Marilyn Stasio’s Latest Crime Column', 'kicker': 'Crime', 'content_kicker': None, 'print_headline': 'The Devil Is in the Details', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and