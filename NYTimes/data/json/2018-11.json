: 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/arts/10arts1/22fabre2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/10/arts/10arts1/22fabre2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/arts/10arts1/22fabre2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Cloud Lingers Over Jan Fabre’s Show at N.Y.U. Amid Sexual Harassment Complaints', 'kicker': None, 'content_kicker': None, 'print_headline': 'N.Y.U. Asked to Address Claims Against Artist', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': '#MeToo Movement', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Sexual Harassment', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Skirball Center for the Performing Arts', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Fabre, Jan', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Belgium', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-11-09T18:29:17+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Dance', 'byline': {'original': 'By Alex Marshall', 'person': [{'firstname': 'Alex', 'middlename': None, 'lastname': 'Marshall', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9771d26b-d2b9-544d-af24-02d50ed9f62a', 'word_count': 496, 'uri': 'nyt://article/9771d26b-d2b9-544d-af24-02d50ed9f62a'}, {'abstract': '“The Letter for the King,” by the Dutch author Tonke Dragt, gets a new English edition 56 years after it first appeared. It’s a straightforward story with buckets of charm on its side.', 'web_url': 'https://www.nytimes.com/2018/11/09/books/review/tongke-dragt-letter-for-the-king.html', 'snippet': '“The Letter for the King,” by the Dutch author Tonke Dragt, gets a new English edition 56 years after it first appeared. It’s a straightforward story with buckets of charm on its side.', 'lead_paragraph': 'Whether or not it is an entirely admirable thing, it is certainly an arresting thing that Tonke Dragt’s THE LETTER FOR THE KING (Pushkin Children’s Books, 512 pp., paper, $15.95; ages 10 and up), newly republished in English in a translation by Laura Watkinson, has as literal a title as has ever been imagined by an author for an adventure story. We expect the titles of children’s classics to be deliberately intriguing, marked by an unexpected metaphysical juxtaposition — a witch meets a wardrobe — or at least to suggest an intriguing concept, time wrinkling or a philosopher’s stone sought. But Dragt’s book promises to be about a letter, for some king, and that is exactly its chief and only matter. The question is if it can be delivered or not.', 'print_section': 'BR', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/books/review/11-BKS-Gopnik-Sub/11-BKS-Gopnik-Sub-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/11/books/review/11-BKS-Gopnik-Sub/11-BKS-Gopnik-Sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/books/review/11-BKS-Gopnik-Sub/11-BKS-Gopnik-Sub-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/books/review/11-BKS-Gopnik-Sub/11-BKS-Gopnik-Sub-superJumbo.jpg', 'height': 1108, 'width': 1662, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/books/review/11-BKS-Gopnik-Sub/11-BKS-Gopnik-Sub-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/11/books/review/11-BKS-Gopnik-Sub/11-BKS-Gopnik-Sub-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/books/review/11-BKS-Gopnik-Sub/11-BKS-Gopnik-Sub-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Can a Simple, Classic European Fantasy Win Over Jaded American Kids? This One Just Might', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Novels / Dutch Treat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Letter for the King (Book)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dragt, Tonke', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-11-09T18:33:33+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Adam Gopnik', 'person': [{'firstname': 'Adam', 'middlename': None, 'lastname': 'Gopnik', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/29b0925a-3ab3-582d-835b-11e7f2487d29', 'word_count': 964, 'uri': 'nyt://article/29b0925a-3ab3-582d-835b-11e7f2487d29'}, {'abstract': 'The protests in cities across the country came after the president replaced former Attorney General Jeff Sessions with Matthew G. Whitaker, a Trump loyalist and vocal critic of Mr. Mueller.', 'web_url': 'https://www.nytimes.com/2018/11/09/us/mueller-protests.html', 'snippet': 'The protests in cities across the country came after the president replaced former Attorney General Jeff Sessions with Matthew G. Whitaker, a Trump loyalist and vocal critic of Mr. Mueller.', 'lead_paragraph': 'Thousands of people protested across the country on Thursday in support of the inquiry led by Robert S. Mueller III, the special counsel investigating Russian interference in the 2016 election, just one day after President Trump shook up the agency overseeing it.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Thousands Protest in Support of Mueller Inquiry', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mueller, Robert S III', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Russian Interference in 2016 US Elections and Ties to Trump Associates', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests and Riots', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Appointments and Executive Changes', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Sessions, Jefferson B III', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Whitaker, Matthew G', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-11-09T18:37:41+0000', 'document_type': 'article', 'news_desk': 'Express', 'section_name': 'U.S.', 'byline': {'original': 'By Niraj Chokshi', 'person': [{'firstname': 'Niraj', 'middlename': None, 'lastname': 'Chokshi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e9d24af9-3c89-5c63-b968-2557998a4cf6', 'word_count': 255, 'uri': 'nyt://article/e9d24af9-3c89-5c63-b968-2557998a4cf6'}, {'abstract': 'Uncertainty reigned in Florida as three key races neared possible recounts amid continuing questions over ballot counting.', 'web_url': 'https://www.nytimes.com/2018/11/09/us/florida-ballots-recount-scott-nelson-gillum-desantis.html', 'snippet': 'Uncertainty reigned in Florida as three key races neared possible recounts amid continuing questions over ballot counting.', 'lead_paragraph': 'LAUDERHILL, Fla. — The election that must not be named, the one that scarred Florida’s collective psyche 18 years ago, came back to haunt the state on Friday, a specter of competing lawsuits, rowdy protests and disputed ballots in Tuesday’s vote that inescapably harkened back to the political drama of 2000.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/us/10florida-01alt-promo/10florida-01alt-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/10/us/10florida-01alt-promo/10florida-01alt-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/us/10florida-01alt-promo/10florida-01alt-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/us/10florida-01alt-promo/10florida-01alt-superJumbo-v2.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/us/10florida-01alt-promo/10florida-01alt-thumbStandard.jpg', 'height': 7