legacy': {}}], 'headline': {'main': 'George Soros, Yemen, Google: Your Thursday Briefing', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-11-01T09:35:30+0000', 'document_type': 'article', 'news_desk': 'NYTNow', 'section_name': 'Briefing', 'byline': {'original': 'By Chris Stanford', 'person': [{'firstname': 'Chris', 'middlename': None, 'lastname': 'Stanford', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/0e8771bb-e293-58cb-91b2-0014cc82c35a', 'word_count': 1332, 'uri': 'nyt://article/0e8771bb-e293-58cb-91b2-0014cc82c35a'}, {'abstract': 'The president has reclaimed the formula that made the landslide victories of the Nixon and Reagan years possible. ', 'web_url': 'https://www.nytimes.com/2018/11/01/opinion/donald-trump-reagan-nixon-midterms.html', 'snippet': 'The president has reclaimed the formula that made the landslide victories of the Nixon and Reagan years possible. ', 'lead_paragraph': 'Donald Trump’s conservative critics have one last hope: defeat. If Republicans suffer humiliating defeats in the midterm elections, they suggest, President Trump will get the blame. Influential donors and grass-roots Republicans will turn on him, and the party will get back to normal. Not so long ago this was the party of Paul Ryan and free trade. This was the party of George W. Bush and compassionate conservatism. This was a party whose self-performed autopsy after the 2012 election called for more minority outreach. After Mr. Trump, why can’t the Republicans be that party again?', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/01/opinion/01mccarthy/merlin_146015085_e0c0ec52-91e2-467f-a02a-1df93f4e9e4a-articleLarge.jpg', 'height'