, {'abstract': 'Want to share photos this holiday season (and other times)? We have recommendations for cards, photo books, and photo printing services.', 'web_url': 'https://www.nytimes.com/2018/11/13/smarter-living/wirecutter/best-online-photo-printing-holidays.html', 'snippet': 'Want to share photos this holiday season (and other times)? We have recommendations for cards, photo books, and photo printing services.', 'lead_paragraph': 'Smartphones have made it easy to share photos with family and friends, but the images are often ephemeral — soon buried in text strings or inboxes. Digital printing services offer evergreen options, from cards to individual prints to curated albums. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/13/smarter-living/wc-photoprinting/wc-photoprinting-articleLarge.png', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/13/smarter-living/wc-photoprinting/wc-photoprinting-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/13/smarter-living/wc-photoprinting/wc-photoprinting-jumbo.png', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/13/smarter-living/wc-photoprinting/wc-photoprinting-superJumbo.png', 'height': 1354, 'width': 2030, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/13/smarter-living/wc-photoprinting/wc-photoprinting-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/13/smarter-living