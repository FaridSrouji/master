type': 'article', 'news_desk': 'Corrections', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/b53fc9f8-269e-5645-863e-524f18aae9c6', 'word_count': 473, 'uri': 'nyt://article/b53fc9f8-269e-5645-863e-524f18aae9c6'}, {'abstract': 'The company’s Electron rocket carried a batch of small commercial satellites from a launchpad in New Zealand, a harbinger of a major transformation to the space business.', 'web_url': 'https://www.nytimes.com/2018/11/10/science/rocket-lab-launch.html', 'snippet': 'The company’s Electron rocket carried a batch of small commercial satellites from a launchpad in New Zealand, a harbinger of a major transformation to the space business.', 'lead_paragraph': 'A small rocket from a little-known company lifted off Sunday from the east coast of New Zealand, carrying a clutch of tiny satellites. That modest event — the first commercial launch by a U.S.-New Zealand company known as Rocket Lab — could mark the beginning of a new era in the space business, where countless small rockets pop off from spaceports around the world. This miniaturization of rockets and spacecraft places outer space within reach of a broader swath of the economy.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/12/science/12smallrocket/merlin_146653521_cde4b31d-06e0-4a17-835d-e1a18e196671-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/12/science/12smallrocket/merlin_146653521_cde4b31d-06e0-4a17-835d-e1a18e196671-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/12/science/12smallrocket/merlin_146653521_cde4b31d-06e0-4a17-835d-e1a18e196671-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/12/science/12smallrocket/merlin_146653521_cde4b31d-06e0-4a17-835d-e1a18e196671-superJumbo.jpg', 'height': 1091, 'width': 1637, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/12/science/12smallrocket/12smallrocket-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/12/science/12smallrocket/12smallrocket-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/12/science/12smallrocket/12smallrocket-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Rocket Lab’s Modest Launch Is Giant Leap for Small Rocket Business', 'kicker': None, 'content_kicker': None, 'print_headline': 'Space Launch Firms Start Small Today To Go Big Tomorrow', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Rocket Lab', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Private Spaceflight', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Rocket Science and Propulsion', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Satellites', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Space and Astronomy', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New Zealand', 'rank': 6, 'major': 'N'}], 'pub_date': '2018-11-11T00:52:53+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Kenneth Chang', 'person': [{'firstname': 'Kenneth', 'middlename'