.jpg', 'xlargewidth': 600, 'xlargeheight': 338}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/02/arts/02theyllloveme-1/merlin_146055894_786bc30a-3d08-4a30-a2cb-a8a2014c0be0-jumbo.jpg', 'height': 576, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/02/arts/02theyllloveme-1/merlin_146055894_786bc30a-3d08-4a30-a2cb-a8a2014c0be0-superJumbo.jpg', 'height': 1080, 'width': 1920, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/02/arts/02theyllloveme-1/02theyllloveme-1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/02/arts/02theyllloveme-1/02theyllloveme-1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/02/arts/02theyllloveme-1/02theyllloveme-1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Review: ‘They’ll Love Me When I’m Dead’ Documents Orson Welles’s Last Film', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Legend Behind The Scenes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': "They'll Love Me When I'm Dead (Movie)", 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Neville, Morgan', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Other Side of the Wind (Movie)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Welles, Orson', 'rank': 5, 'major': 'N'}], 'pub_date': '2