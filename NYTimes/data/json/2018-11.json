ings/18Endings-articleLarge.gif', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/18/arts/18Endings/18Endings-articleLarge.gif', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/arts/18Endings/18Endings-jumbo.gif', 'height': 768, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/arts/18Endings/18Endings-superJumbo.gif', 'height': 768, 'width': 768, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/arts/18Endings/18Endings-thumbStandard.gif', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/18/arts/18Endings/18Endings-thumbStandard.gif', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/arts/18Endings/18Endings-thumbLarge.gif', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The End of Endings', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'Curse of the Never-Ending Story', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Social Media', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Avengers: Infinity War (Movie)', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Harry Potter (Book)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Roseanne (TV Program)', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Murphy Brown (TV Program)', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Gilmore Girls (TV Program)', 'rank': 8, 'major': 'N'}, {'name': 'creative_works', 'value': 'Will & Grace (TV Program)', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-11-15T09:00:07+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'byline': {'original': 'By Amanda Hess', 'person': [{'firstname': 'Amanda', 'middlename': None, 'lastname': 'Hess', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c8aa7e06-4710-5e37-b16a-a6ab3e2382b8', 'word_count': 1467, 'uri': 'nyt://article/c8aa7e06-4710-5e37-b16a-a6ab3e2382b8'}, {'abstract': 'The British botanist Anna Atkins published her evocative cyanotypes of algae and seaweed 175 years ago. Now, the New York Public Library is celebrating her innovation.', 'web_url': 'https://www.nytimes.com/2018/11/15/arts/design/she-needed-no-camera-to-make-the-first-book-of-photographs.html', 'snippet': 'The British botanist Anna Atkins published her evocative cyanotypes of algae and seaweed 175 years ago. Now, the New York Public Library is celebrating her innovation.', 'lead_paragraph': 'The plants are white as ghosts, and they float in fields as sharply blue as the waters off Dover. Each one is a little miracle, their neuron-like roots winding across the page, their leaves revealing every branching vein. These are photographs, produced only with the light of the sun and an amateur’s chemistry set. There was no precedent for them in the early 1840s — when a woman invented the photobook.', 'print_section': 'C', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/16/arts/16blueprint6/merlin_146222526_6aba8b32-8ba7-424e-851b-e8bfc7