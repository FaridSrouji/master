s': [{'name': 'persons', 'value': 'Ghosn, Carlos', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Kelly, Greg (Nissan Executive)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Nissan Motor Co', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Japan', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Renault SA', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Saikawa, Hiroto', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Automobiles', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Executive Compensation', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Ethics and Official Misconduct', 'rank': 9, 'major': 'N'}], 'pub_date': '2018-11-21T12:06:11+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Motoko Rich and Liz Alderman', 'person': [{'firstname': 'Motoko', 'middlename': None, 'lastname': 'Rich', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Liz', 'middlename': None, 'lastname': 'Alderman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ad745b13-3054-57eb-8f34-22ee9e68099e', 'word_count': 1140, 'uri': 'nyt://article/ad745b13-3054-57eb-8f34-22ee9e68099e'}, {'abstract': 'Decades after the movement flourished, its female practitioners are at long last being recognized.', 'web_url': 'https://www.nytimes.com/2018/11/21/t-magazine/female-land-artists.html', 'snippet': 'Decades after the movement flourished, its female practitioners are at long last being recognized.', 'lead_paragraph': 'IN 1972, 350 women working in the visual arts descended upon the Corcoran Gallery of Art in Washington, D.C., to protest and discuss the male-dominated art world and, as reported by The Times, “male discrimination against the exhibition of women’s art in museums and galleries ... and the prejudices of the press and critics against women’s art.” Here, the painter Alice Neel was booed after suggesting that pregnant women should take a break from making art. Judy Chicago discussed defining a kind of art based on “the nature of female identity.” Agnes Denes, who had begun what became a little-seen but much-admired 1969 installation in upstate New York that involved planting rice in a field and covering the surrounding trees in chains, was in attendance as well. She was applauded when she denounced a “vaginal sensibility” and proclaimed, “The only inner space I recognize is where my brain is — and my soul.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/21/t-magazine/21tmag-femalelandartists-slide-XJBX/21tmag-femalelandartists-slide-XJBX-articleLarge.jpg', 'height': 419, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/21/t-magazine/21tmag-femalelandartists-slide-XJBX/21tmag-femalelandartists-slide-XJBX-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 419}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/21/t-magazine/21tmag-femalelandartists-slide-XJBX/21tmag-femalelandartists-slide-XJBX-jumbo.jpg', 'height': 715, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/21/t-magazine/21tmag-femalelandartists-slide-XJBX/21tmag-femalelandartists-slide-XJBX-superJumbo.jpg', 'height': 1396, 'width': 1998, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/21/t-magazine/21tmag-femalelandartists-slide-XJBX/21tmag-femalelandartists-slide-XJBX-thumbStandard-v2.jpg', 'height': 75, 'w