/16COOKING-JELLYDOUGHNUTS/16COOKING-JELLYDOUGHNUTS-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/16/dining/16COOKING-JELLYDOUGHNUTS/16COOKING-JELLYDOUGHNUTS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2015/11/16/dining/16COOKING-JELLYDOUGHNUTS/16COOKING-JELLYDOUGHNUTS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2015/11/16/dining/16COOKING-JELLYDOUGHNUTS/16COOKING-JELLYDOUGHNUTS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What to Cook This Weekend', 'kicker': 'What to Cook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}], 'pub_date': '2018-11-30T15:30:01+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Food', 'byline': {'original': 'By Sam Sifton', 'person': [{'firstname': 'Sam', 'middlename': None, 'lastname': 'Sifton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0bd8bb3c-406b-5ba0-abee-7e7226f9736c', 'word_count': 567, 'uri': 'nyt://article/0bd8bb3c-406b-5ba0-abee-7e7226f9736c'}, {'abstract': 'Our romance columnist, Jaime Green, picks her fall favorites.', 'web_url': 'https://www.nytimes.com/2018/11/30/books/review/sophie-jordan-beautiful-sinner.html', 'snippet': 'Our romance columnist, Jaime Green, picks her fall favorites.', 'lead_paragraph': 'Romance is both loved and derided for its formulaic nature. It is comfort, escapism and reassurance in a troubling world. It is generic in the truest sense, a genre defined and constrained by a handful of conventions. The heart of every romance is a love story, and by the last page of the book the lovers wind up together, happily ever after or at least “happily for now.” (Less codified but no less crucial is that no children or pets are harmed. This is a place for happy endings, after all.) These rules give rise to a rich variety of stories, but they are constraints nonetheless. Here are four recent books that either test the boundaries or occupy the essential core of what a romance novel is.', 'print_section': 'BR', 'print_page': '48', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/books/review/02Romance/merlin_147050586_c21e40b9-740a-48f5-a26a-fca69bc2b5ed-articleLarge.jpg', 'height': 623, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/12/02/books/review/02Romance/merlin_147050586_c21e40b9-740a-48f5-a26a-fca69bc2b5ed-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 623}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/books/review/02Romance/merlin_147050586_c21e40b9-740a-48f5-a26a-fca69bc2b5ed-jumbo.jpg', 'height': 1024, 'width': 986, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/books/review/02Romance/merlin_147050586_c21e40b9-740a-48f5-a26a-fca69bc2b5ed-superJumbo.jpg', 'height': 2048, 'width': 1971, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/12/02/books/review/02Romance/02Romance-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': '