: [{'firstname': 'Mimi', 'middlename': None, 'lastname': 'Swartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/fe375683-9dc2-5197-89b0-d3b28706de48', 'word_count': 902, 'uri': 'nyt://article/fe375683-9dc2-5197-89b0-d3b28706de48'}, {'abstract': 'The midterm elections set up a divided Congress, with a Democratic House and a Republican Senate. Here’s a quick civics lesson about what that means.', 'web_url': 'https://www.nytimes.com/2018/11/07/us/politics/house-senate-difference-control.html', 'snippet': 'The midterm elections set up a divided Congress, with a Democratic House and a Republican Senate. Here’s a quick civics lesson about what that means.', 'lead_paragraph': 'As the prospect of a divided Congress looms, many people have turned to Google in a frantic search for answers about what, exactly, the midterm election results will mean.', 'print_section': 'F', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/08/us/politics/08xp-housesenate1-sub/merlin_146478945_f4c6e6db-48bf-4774-9ba2-a8d640f680d4-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/08/us/politics/08xp-housesenate1-sub/merlin_146478945_f4c6e6db-48bf-4774-9ba2-a8d640f680d4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/08/us/politics/08xp-housesenate1-sub/merlin_146478945_f4c6e6db-48bf-4774-9ba2-a8d640f680d4-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/08/us/politics/08xp-housesenate1-sub/merlin_146478945