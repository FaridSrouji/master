person': [{'firstname': 'Glenn', 'middlename': None, 'lastname': 'Kenny', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5384ac20-73ba-54aa-96a8-63f5ff7a0220', 'word_count': 266, 'uri': 'nyt://article/5384ac20-73ba-54aa-96a8-63f5ff7a0220'}, {'abstract': 'Elliot has trained patiently to be “Santa’s first non-reindeer reindeer.” Moviegoing audiences might not show the same patience.', 'web_url': 'https://www.nytimes.com/2018/11/29/movies/elliot-the-littlest-reindeer-review.html', 'snippet': 'Elliot has trained patiently to be “Santa’s first non-reindeer reindeer.” Moviegoing audiences might not show the same patience.', 'lead_paragraph': 'One message of “Elliot: The Littlest Reindeer,” a feel-good animated feature about a miniature horse who competes to join Santa’s sleigh-driving team, is that character counts. And one great character-building test is to ask your child to sit patiently through “Elliot: The Littlest Reindeer.” It’s a test most adults will fail.', 'print_section': 'C', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/movies/30elliot/30elliot-articleLarge-v2.jpg', 'height': 255, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/30/movies/30elliot/30elliot-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 255}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/movies/30elliot/30elliot-jumbo-v2.jpg', 'height': 436, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/30/movies/30elliot/30elliot-superJumbo-v2.jpg', 'height': 872, 'width': 2048, 'subType': 'superJumbo', 'crop_n