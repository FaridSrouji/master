humbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '30 of Our Best Thanksgiving Side Dishes', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-11-03T14:30:01+0000', 'document_type': 'article', 'news_desk': 'Dining', 'section_name': 'Admin', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6b7543a9-6eab-5283-9e15-dd6f832fc320', 'word_count': 34, 'uri': 'nyt://article/6b7543a9-6eab-5283-9e15-dd6f832fc320'}, {'abstract': 'Republicans have grown increasingly pessimistic about holding the House, as polls show a number of incumbents lagging well below 50 percent. G.O.P. leaders are more hopeful about the Senate.', 'web_url': 'https://www.nytimes.com/2018/11/03/us/politics/elections-trump-congress.html', 'snippet': 'Republicans have grown increasingly pessimistic about holding the House, as polls show a number of incumbents lagging well below 50 percent. G.O.P. leaders are more hopeful about the Senate.', 'lead_paragraph': 'LOS LUNAS, N.M. — The tumultuous 2018 midterm campaign, shaped by conflicts over race and identity and punctuated by tragedy, barreled through its final weekend as voters prepared to deliver a verdict on the first half of President Trump’s term, with Republicans bracing for losses in the House and state capitals but hopeful they would prevail in Senate races in areas where Mr. Trump is popular.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/04/us/politics/04midterms1/merlin_146225367_f61fb5d8-726c-4144-92f6-627fb92d0f04-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/04/us/politics/04mid