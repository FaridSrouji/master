': 'images/2018/11/25/travel/25bacocktails-01/merlin_146398356_65542166-fd7a-4dae-b95e-b6461d30188f-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/travel/25bacocktails-01/merlin_146398356_65542166-fd7a-4dae-b95e-b6461d30188f-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/travel/25bacocktails-01/merlin_146398356_65542166-fd7a-4dae-b95e-b6461d30188f-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/travel/25bacocktails-01/merlin_146398356_65542166-fd7a-4dae-b95e-b6461d30188f-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/25/travel/25bacocktails-01/merlin_146398356_65542166-fd7a-4dae-b95e-b6461d30188f-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/travel/25bacocktails-01/merlin_146398356_65542166-fd7a-4dae-b95e-b6461d30188f-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Finding the Perfect Cocktail in Buenos Aires ', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Thirst for Buenos Aires', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Bars and Nightclubs', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Travel and Vacations', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'ARGENTINA', 'rank': 3, 'major': 'N'}, {'name': 'glocations', '