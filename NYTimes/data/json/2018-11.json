8bc4-dd6f-596b-8b1f-9b408f8c8300', 'word_count': 738, 'uri': 'nyt://article/84578bc4-dd6f-596b-8b1f-9b408f8c8300'}, {'abstract': 'Quotation of the Day for Saturday, November 24, 2018.', 'web_url': 'https://www.nytimes.com/2018/11/23/todayspaper/quotation-of-the-day-a-brexit-no-one-likes-but-many-can-live-with.html', 'snippet': 'Quotation of the Day for Saturday, November 24, 2018.', 'lead_paragraph': '“We compromise in an Eeyorish, grumpy, vaguely stoical way. And we complain, constantly. But only to each other. We rarely address our complaints to anyone who might be in a position to resolve them. That’s kind of what I was expecting with Brexit.”', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Quotation of the Day: A Brexit No One Likes, but Many Can Live With', 'kicker': None, 'content_kicker': None, 'print_headline': 'Quote of the Day', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-11-24T03:20:47+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Today’s Paper', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Quote', '_id': 'nyt://article/24e6d20f-3dea-563f-8907-caad24949185', 'word_count': 64, 'uri': 'nyt://article/24e6d20f-3dea-563f-8907-caad24949185'}, {'abstract': 'Corrections appearing in print on Saturday, November 24, 2018.', 'web_url': 'https://www.nytimes.com/2018/11/24/pageoneplus/no-corrections-november-24-2018.html', 'snippet': 'Corrections appearing in print on Saturday, November 24, 2018.', 'lead_paragraph': 'No corrections appeared in print on Saturday, November 24, 2018.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'No Corrections: November 24, 2018', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2018-11-24T03:22:13+0000', 'document_type': 'article', 'news_desk': 'Corrections', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Correction', '_id': 'nyt://article/423ee04d-5948-5adf-93f6-9fcc3499d9c8', 'word_count': 74, 'uri': 'nyt://article/423ee04d-5948-5adf-93f6-9fcc3499d9c8'}, {'abstract': 'Mr. McNair, who was awarded the franchise that became the Texans, gave to many charitable causes. More recently, he was criticized for remarks about national anthem protests.', 'web_url': 'https://www.nytimes.com/2018/11/23/obituaries/bob-mcnair-dead.html', 'snippet': 'Mr. McNair, who was awarded the franchise that became the Texans, gave to many charitable causes. More recently, he was criticized for remarks about national anthem protests.', 'lead_paragraph': 'Bob McNair, a transplanted Texan who built an energy empire and earned a fortune that he would spend on an N.F.L. team as well as philanthropic and political causes, died on Friday at his home in Houston. He was 81.', 'print_section': 'A', 'print_page': '26', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/science/25xp-mcnair-obit1/merlin_147234876_63c898f8-2f2e-4b92-846e-88c566beea22-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/25/science/25xp-mcnair-obit1/merlin_147234876_63c898f8-2f2e-4b92-846e-88c566beea22-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/science/25xp-mcnair-obit1/merlin_147234876_63c898f8-2f2e-4b92-846e-88c566beea22-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/science/25xp-mcnair-obit1/merlin_147234876_63c898f8-2f2e-4b92-846e