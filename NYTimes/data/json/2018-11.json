icker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Agard, Erik (Crossword Constructor)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Crossword Puzzles', 'rank': 2, 'major': 'N'}], 'pub_date': '2018-11-17T16:30:01+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Caitlin Lovinger', 'person': [{'firstname': 'Caitlin', 'middlename': None, 'lastname': 'Lovinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d4fd2afc-6504-5c88-a72e-0669cbda5009', 'word_count': 574, 'uri': 'nyt://article/d4fd2afc-6504-5c88-a72e-0669cbda5009'}, {'abstract': 'The struggle over who should teach in the Ocean Hill-Brownsville district of Brooklyn 50 years ago changed the trajectory of modern liberalism.', 'web_url': 'https://www.nytimes.com/2018/11/17/opinion/teachers-strike-liberals-ocean-hill-brownsville.html', 'snippet': 'The struggle over who should teach in the Ocean Hill-Brownsville district of Brooklyn 50 years ago changed the trajectory of modern liberalism.', 'lead_paragraph': 'On Nov. 17, 1968, Albert Shanker, a tough Queens-bred union president, stood next to New York City’s patrician mayor, John Lindsay, to announce a settlement to a crippling teacher strike that had thrown a million students out of New York City public schools for weeks on end. The divisive strike laid bare long simmering tensions within American liberalism over unions, education and race. Almost a half-century later, the evolution in liberal attitudes that the strike symbolized created vulnerabilities that a very different son of Queens, Donald Trump, exploited in his rise to the presidency.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/17KAHLENBERG/merlin_48592838_3fa2a222-10ab-4b66-81a2-00352f2dfe86-articleLarge.jpg', 'height': 403, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/17/opinion/17KAHLENBERG/merlin_48592838_3fa2a222-10ab-4b66-81a2-00352f2dfe86-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 403}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/17KAHLENBERG/merlin_48592838_3fa2a222-10ab-4b66-81a2-00352f2dfe86-jumbo.jpg', 'height': 688, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/17KAHLENBERG/merlin_48592838_3fa2a222-10ab-4b66-81a2-00352f2dfe86-superJumbo.jpg', 'height': 1375, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/17KAHLENBERG/17KAHLENBERG-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/17/opinion/17KAHLENBERG/17KAHLENBERG-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/17/opinion/17KAHLENBERG/17KAHLENBERG-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A School Strike That Never Quite Ended', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Education (K-12)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Teachers and School Employees', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Strikes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Education', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Liberalism (US Politics)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lipset, Seymour Martin', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'Brownsville (Brooklyn, NY)', 'rank': 8, 'major': 'N'}], 'pub_date': '2018-11-17T16:30:04+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Richard D. Kahlenberg', 'person': [{'firstname': 'Richard', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/735aa7b8-3c64-5213-969f-c900bd399d26', 'word_count': 1277, 'uri': 'nyt://article/735aa7b8-3c64-5213-969f-c900bd399d26'}, {'abstract': 'Even though moderate Democrats helped propel the party in the midterm elections, influential donors suggested that their priority in 2020 would be to back progressive appeals in Sun Belt states.', 'web_url': 'https://www.nytimes.com/2018/11/17/us/politics/democratic-donors-2020.html', 'snippet': 'Even though moderate Democrats helped propel the party in the midterm elections, influential donors suggested that their priority in 2020 would be to back progressive appeals in Sun Belt states.', 'lead_paragraph': 'WASHINGTON — As the debate rages among Democrats about how best to position the party to defeat President Trump in 2020, many big donors are signaling early support for expanding and firing up the party’s liberal base rather than backing centrist appeals targeting the Rust Belt.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/18/us/politics/18dc-donate1-print/merlin_145810332_2c7bd9d2-7be9-4bb8-a6bd-2