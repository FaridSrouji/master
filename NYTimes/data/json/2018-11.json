or': 'N'}, {'name': 'persons', 'value': 'Nordwall, Steve', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Robinson, Wes', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Gooden, Linda R', 'rank': 10, 'major': 'N'}], 'pub_date': '2018-11-07T20:30:19+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Marc Tracy', 'person': [{'firstname': 'Marc', 'middlename': None, 'lastname': 'Tracy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/51d1d640-78d2-5ff6-9de4-9b7801853531', 'word_count': 954, 'uri': 'nyt://article/51d1d640-78d2-5ff6-9de4-9b7801853531'}, {'abstract': 'The remains of Brent Taylor, who served in the military and as a mayor, arrived home, appropriately, on Election Day, ', 'web_url': 'https://www.nytimes.com/2018/11/07/opinion/major-brent-taylor-mayor-soldier-utah.html', 'snippet': 'The remains of Brent Taylor, who served in the military and as a mayor, arrived home, appropriately, on Election Day, ', 'lead_paragraph': 'Brent Taylor, the mayor of North Ogden, Utah, and a major in the National Guard, was killed in Afghanistan on Saturday on his fourth deployment to a war zone. As Americans headed to the polls early Tuesday, Jennie Taylor, his wife and the mother of his seven children, was at Dover Air Force Base in Delaware to meet his remains. Their two oldest sons were by her side. “It seems only fitting that Brent, who in death now represents something so much greater than any of our own individual lives,” she said, “has come home to U.S. soil in a flag-draped casket on our Election Day.” Major Taylor, 39, had guided several large infrastructure improvements as mayor since 2013. In his final Facebook post, in late October, Major Taylor, a Republican, said that he hoped “everyone back home exercises their precious right to vote” and said that whether Republicans or Democrats win, “We all remember that we have far more as Americans that unites us than divides us.” ', 'print_section': 'A', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/07/opinion/07taylorWeg/07taylorWeg-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/07/opinion/07taylorWeg/07taylorWeg-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/07/opinion/07taylorWeg/07taylorWeg-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/07/opinion/07taylorWeg/07taylorWeg-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/07/opinion/07taylorWeg/07taylorWeg-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/07/opinion/07taylorWeg/07taylorWeg-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/07/opinion/07taylorWeg/07taylorWeg-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Patriot Returns', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Patriot Returns', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 1, 'major': 'N'}, {'name': 'organizatio