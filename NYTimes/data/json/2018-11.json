idth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/10/arts/10composer1/10composer1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'At 80, Joan Tower Says Great Music Comes ‘in the Risks’', 'kicker': None, 'content_kicker': None, 'print_headline': 'Becoming a Force While Trying to Avoid Disaster', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Sawdust (Brooklyn, NY, Performance Space)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Tower, Joan', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-11-09T16:37:37+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By William Robin', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Robin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d58e6b7d-c893-5632-9d3e-faae8d443bef', 'word_count': 1054, 'uri': 'nyt://article/d58e6b7d-c893-5632-9d3e-faae8d443bef'}, {'abstract': 'This is about much more than Trump. ', 'web_url': 'https://www.nytimes.com/2018/11/09/opinion/sunday/nancy-pelosi-congress-midterms.html', 'snippet': 'This is about much more than Trump. ', 'lead_paragraph': 'Many Democrats are salivating over the prospect of using their new House majority to investigate President Trump. The more important constitutional question is whether they will use it to legislate and reassert congressional authority that has lain dormant for decades. They now control the most powerful and representative institution of government. House members wield the power to inhibit policies they oppose and to leverage that authority to insist on those they favor. Democrats should act like it rather than orienting themselves around the presidency as though it, and Mr. Trump, were the be-all and end-all of American politics.', 'print_section': 'SR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/opinion/11Weiner2/11Weiner2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/11/opinion/11Weiner2/11Weiner2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/opinion/11Weiner2/11Weiner2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/opinion/11Weiner2/11Weiner2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/opinion/11Weiner2/11Weiner2-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/11/opinion/11Weiner2/11Weiner2-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/11/opinion/11Weiner2/11Weiner2-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Nancy Pelosi’s First Order of Business Should Be to Reclaim the Power of the House', 'kicker': None, 'content_kicker': None, 'print_headline': 'This Is About Much More Than Trump', 'name'