iarty2/05bookmoriarty2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Sinister Doings at a Luxury Spa? Must Be a New Liane Moriarty Novel', 'kicker': 'Books of The Times', 'content_kicker': None, 'print_headline': 'Sinister Doings at a Luxury Spa', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Moriarty, Liane', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Nine Perfect Strangers (Book)', 'rank': 3, 'major': 'N'}], 'pub_date': '2018-11-05T22:59:10+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Books', 'byline': {'original': 'By Janet Maslin', 'person': [{'firstname': 'Janet', 'middlename': None, 'lastname': 'Maslin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/658f203d-ccd1-50d5-b5e5-124c02a40eb8', 'word_count': 879, 'uri': 'nyt://article/658f203d-ccd1-50d5-b5e5-124c02a40eb8'}, {'abstract': 'Corporations, lobbyists and interest groups are increasingly using public records laws as weapons in dealing with academic work they do not like.', 'web_url': 'https://www.nytimes.com/2018/11/05/us/politics/freedom-of-information-requests.html', 'snippet': 'Corporations, lobbyists and interest groups are increasingly using public records laws as weapons in dealing with academic work they do not like.', 'lead_paragraph': 'WASHINGTON — Dennis J. Ventry Jr., a law professor at the University of California, Davis, drew the ire of tax preparation companies like Intuit and H&R Block this summer by criticizing a deal they have to provide a free tax filing service through the Internal Revenue Service.', 'print_section': 'A', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', '