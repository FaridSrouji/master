25network-adapt2-promo-thumbStandard-v3.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2018/11/25/arts/25network-adapt2-promo/25network-adapt2-promo-thumbStandard-v3.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/arts/25network-adapt2-promo/25network-adapt2-promo-thumbLarge-v3.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': '‘Network’ in an Age of Fake News and Fury', 'kicker': None, 'content_kicker': None, 'print_headline': 'A ‘Network’ for a New Era', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Theater', 'rank': 1, 'major': 'N'}, {'name': 'creative_works', 'value': 'Network (Play)', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Chayefsky, Paddy', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cranston, Bryan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Goldwyn, Tony', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Hall, Lee', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'van Hove, Ivo', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Maslany, Tatiana', 'rank': 8, 'major': 'N'}], 'pub_date': '2018-11-21T05:31:03+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Theater', 'byline': {'original': 'By Dave Itzkoff', 'person': [{'firstname': 'Dave', 'middlename': None, 'lastname': 'Itzkoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/992f3387-24fd-5b97-8ebc-50cbb8e5906c', 'word_count': 2353, 'uri': 'nyt://article/992f3387-24fd-5b97-8ebc-50cbb8e5906c'}, {'abstract': 'The Emmy-winning actor, who won accolades in London for playing a deranged anchorman in “Network,” isn’t so sure his character is wrongheaded.', 'web_url': 'https://www.nytimes.com/2018/11/21/theater/bryan-cranston-network-broadway.html', 'snippet': 'The Emmy-winning actor, who won accolades in London for playing a deranged anchorman in “Network,” isn’t so sure his character is wrongheaded.', 'lead_paragraph': 'As Howard Beale, the mad prophet of the airwaves in Broadway’s “Network,” Bryan Cranston spends eight shows a week inveighing against “the depression, and the inflation and the defense budget and crime in the street … and the Russians,” urging his viewers to get as livid as he is and threatening to blow his brains out on live TV. Even when measured against Mr. Cranston’s previous work on “Breaking Bad” and “All the Way,” that’s a lot of rage that the actor has had to channel on a regular basis (dating back to the play’s original run last year at London’s National Theater).', 'print_section': 'AR', 'print_page': '9', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/arts/25cranston/merlin_146897109_e1f6682f-7471-4fd7-8f13-a0be1b6cc854-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2018/11/25/arts/25cranston/merlin_146897109_e1f6682f-7471-4fd7-8f13-a0be1b6cc854-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/arts/25cranston/merlin_146897109_e1f6682f-7471-4fd7-8f13-a0be1b6cc854-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2018/11/25/arts/25cranston/merlin_146897109_e1f6682f-7471-4fd7-8f13-a0be1b6cc854-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legac