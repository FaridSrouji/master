-5d4a01f8d6c8'}, {'abstract': 'After becoming the first female rider to guide a horse to victory in the Kentucky Oaks in 2012, Rosie Napravnik matched the feat in a four-and-a-half-length victory Friday.', 'web_url': 'https://www.nytimes.com/2014/05/03/sports/aboard-untapable-jockey-napravnik-wins-a-second-oaks.html', 'snippet': 'After becoming the first female rider to guide a horse to victory in the Kentucky Oaks in 2012, Rosie Napravnik matched the feat in a four-and-a-half-length victory Friday.', 'lead_paragraph': 'LOUISVILLE, Ky. — After a blunder at the starting gate unnerved the fillies and unseated a few jockeys Friday, Rosie Napravnik displayed the kind of steady nerves that allowed her to make history two years ago in the Kentucky Oaks.', 'print_section': 'D', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Aboard Untapable, Jockey Napravnik Wins a Second Oaks', 'kicker': None, 'content_kicker': None, 'print_headline': 'Aboard Untapable, Jockey Napravnik Wins a Second Oaks', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Horse Racing', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hoppert, Melissa', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Kentucky Oaks Horse Race', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Kentucky Derby', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Churchill Downs Inc', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Napravnik, Rosie', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Jockeys, Drivers and Trainers', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-03T02:12:10+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Melissa Hoppert', 'person': [{'firstname': 'Melissa', 'middlename': None, 'lastname': 'Hoppert', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, '