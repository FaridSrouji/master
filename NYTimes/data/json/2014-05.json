oks/review/25SUBRUBIN/25SUBRUBIN-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/25SUBRUBIN/25SUBRUBIN-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/25/books/review/25SUBRUBIN/25SUBRUBIN-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/25SUBRUBIN/25SUBRUBIN-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Things She Carries', 'kicker': None, 'content_kicker': None, 'print_headline': 'The Things She Carries', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rubin, Alissa Johannsen', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Hoffman, Cara', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-23T14:41:43+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Alissa J. Rubin', 'person': [{'firstname': 'Alissa', 'middlename': 'J.', 'lastname': 'Rubin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/59ce9747-c8d7-504d-87f5-c188998276b8', 'word_count': 645, 'uri': 'nyt://article/59ce9747-c8d7-504d-87f5-c188998276b8'}, {'abstract': 'A student moves to her parents’ cabin to finish a dissertation.', 'web_url': 'https://www.nytimes.com/2014/05/25/books/review/off-course-by-michelle-huneven.html', 'snippet': 'A student moves to her parents’ cabin to finish a dissertation.', 'lead_paragraph': 'A doctoral dissertation not getting written is never just a doctoral dissertation not getting written. It’s always a stand-in for something more consequential (take it from a former grad student who knows). But when we encounter Cressida (Cress) Hartley, the protagonist of Michelle Huneven’s fourth novel, “Off Course,” she doesn’t realize this yet. In fact, she has just persuaded her parents to allow her to live in their vacation cabin in California’s Sierra Nevada for “three months free and clear,” so that she can “bang . . . out” her dissertation in economics. The 28-year-old, high-achieving Cress comes from cautious, stingy stock, a foundation that gives her a natural aptitude for her field: Her father is a “traumatized victim of the Great Depression,” and his “fears and obsessions had imprinted her with thought patterns that, superficially at least, were indistinguishable from the mind-set of a trained economist: What is given up to get this? What is the true cost? Whose self-interest is going to \xadprevail?” ', 'print_section': 'BR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-FRY/0525-bks-FRY-articleLarge.jpg', 'height': 672, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/25/books/review/0525-bks-FRY/0525-bks-FRY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 672}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-FRY/0525-bks-FRY-jumbo.jpg', 'height': 1024, 'width': 915, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-FRY/0525-bks-FRY-superJumbo.jpg', 'height': 1343, 'width': 1199, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-FRY/0525-bks-FRY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/25/books/review/0525-bks-FRY/0525-bks-FRY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-FRY/0525-bks-FRY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Writer’s Retreat', 'kicker': None, 'content_kicker': None, 'print_headline': 'Writer’s Retreat', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fry, Naomi', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Huneven, Michelle', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-23T14:41:44+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Naomi Fry', 'person': [{'firstname': 'Naomi', 'middlename': None, 'lastname': 'Fry', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/6219eefb-426b-5767-b0a8-5b3f836091a8', 'word_count': 690, 'uri': 'nyt://article/6219eefb-426b-5767-b0a8-5b3f836091a8'}, {'abstract': 'A “novel-from-life” by the author of “Girl, Interrupted.”', 'web_url': 'https://www.nytimes.com/2014/05/25/books/review/cambridge-by-susanna-kaysen.html', 'snippet': 'A “novel-from-life” by the author of “Girl, Interrupted.”', 'lead_paragraph': 'It’s not that the protagonist of Susanna Kaysen’s novel “Cambridge,” a 1950s elementary-school student also named Susanna, is trying to be difficult. It’s just that getting in the way of herself and others comes so naturally. Bright, sensitive and deeply neurotic, Susanna sees “malevolence” in certain toilets and thinks, as she shucks corn in advance of a dinner with adored family friends, “Something about corn was sad.” Visiting famous monuments sends her into an existential tailspin, and by the time she’s 9 she’s already mourning her lost youth. At school, she’s bored and disdainful. When her sixth-grade teacher gives examples of solids, liquids and gases, Susanna raises her hand to ask, “What about mayonnaise?” ', 'print_section': 'BR', 'print_page': '19', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-Sittenfeld/0525-bks-Sittenfeld-articleLarge.jpg', 'height': 392, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/25/books/review/0525-bks-Sittenfeld/0525-bks-Sittenfeld-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 392}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-Sittenfeld/0525-bks-Sittenfeld-jumbo.jpg', 'height': 669, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-Sittenfeld/0525-bks-Sittenfeld-superJumbo.jpg', 'height': 1328, 'width': 2032, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/books/review/0525-bks-Sittenfeld/0525-bks-Sittenfeld-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'l