: None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ciuraru, Carmela', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Enia, Davide', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Feldman, Joshua Max', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Jones, Wendy', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Thompson, Ted (Author)', 'rank': 9, 'major': 'N'}, {'name': 'creative_works', 'value': 'The Land of Steady Habits (Book)', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-05-02T14:30:34+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Carmela Ciuraru', 'person': [{'firstname': 'Carmela', 'middlename': None, 'lastname': 'Ciuraru', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ddbc83e6-2eef-5f93-bebb-124475fe3a6c', 'word_count': 1025, 'uri': 'nyt://article/ddbc83e6-2eef-5f93-bebb-124475fe3a6c'}, {'abstract': 'Paperback books of particular interest.', 'web_url': 'https://www.nytimes.com/2014/05/04/books/review/paperback-row.html', 'snippet': 'Paperback books of particular interest.', 'lead_paragraph': 'ROBERT OPPENHEIMER: A Life Inside the Center, by Ray Monk. (Anchor, $20.) Monk emphasizes Oppenheimer’s psychological complexity and his contributions to physics as he brings the “father of the atomic bomb” vividly to life — from his tenure as the director of the Los Alamos laboratory to his exile under McCarthyite anti-Communism. THE GIRLS OF ATOMIC CITY: The Untold Story of the Women Who Helped Win World War II, by Denise Kiernan. (Touchstone/Simon & Schuster, $16.) In 1945, the town of Oak Ridge, Tenn., had 75,000 residents and used more electricity than New York City. As Kiernan explains in this engaging history, Oak Ridge was home to the Manhattan Project’s top-secret uranium enrichment facilities, staffed by young women who learned the true nature of their work only after the first bomb fell on Hiroshima.', 'print_section': 'BR', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Paperback Row', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-05-02T14:30:51+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Ihsan Taylor', 'person': [{'firstname': 'Ihsan', 'middlename': None, 'lastname': 'Taylor', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/ea58a552-417b-5a95-ab6f-4c04f7987a88', 'word_count': 494, 'uri': 'nyt://article/ea58a552-417b-5a95-ab6f-4c04f7987a88'}, {'abstract': 'Recently reviewed books of particular interest.', 'web_url': 'https://www.nytimes.com/2014/05/04/books/review/editors-choice.html', 'snippet': 'Recently reviewed books of particular interest.', 'lead_paragraph': 'FORCING THE SPRING: Inside the Fight for Marriage Equality,  by Jo Becker. (Penguin Press, $29.95.) A fly-on-the-wall account of the 2013 Supreme Court case that led to the overturn of California’s ban on same-sex marriage.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Editors’ Choice', 'kicker': None, 'content_kicker': None, 'print_headline': 'Editors’ Choice | Recent Books of Particular Interest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-05-02T14:31:00+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'List', '_id': 'nyt://article/041ed4c3-6914-576b-8b1d-d74012c6915b', 'word_count': 253, 'uri': 'nyt://article/041ed4c3-6914-576b-8b1d-d74012c6915b'}, {'abstract': 'Populations close to chemical facilities are disproportionately black and Latino.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/05/02/facts-figures-environmental-racism/', 'snippet': 'Populations close to chemical facilities are disproportionately black and Latino.', 'lead_paragraph': 'Three environmental organizations released a study Thursday on the demographics of the 134 million U.S. residents living with the danger or “vulnerability” zones of 3,433 chemical facilities, and the 3.8 million living with the “fenceline” zones closest to potential harm, with the least time to react in the event of a catastrophe.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Facts & Figures: Environmental Racism', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-02T14:33:09+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By The Editors', 'person': [], 'organization': 'The Editors'}, 'type_of_material': 'News', '_id': 'nyt://article/b26e296b-0c6f-5169-8a8e-89cce1b1121a', 'word_count': 92, 'uri': 'nyt://article/b26e296b-0c6f-5169-8a8e-89cce1b1121a'}, {'abstract': 'A fascinating, if partial, portrait of Louisa Catherine Adams, the uncommonly courageous wife of John Quincy Adams.', 'web_url': 'https://www.nytimes.com/2014/05/04/books/review/louisa-catherine-by-margery-m-heffron.html', 'snippet': 'A fascinating, if partial, portrait of Louisa Catherine Adams, the uncommonly courageous wife of John Quincy Adams.', 'lead_paragraph': 'All she did was dab a little rouge on her cheeks to disguise her wan complexion and provide a rosy contrast to the black gown she would wear. But her husband strongly disapproved. Grabbing a towel, he pulled her onto his knee and wiped her face clean. It did not matter to John Quincy Adams that Queen Louise of Prussia had given his wife the cosmetic and expected it to be used. ', 'print_section': 'BR', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04ANDERSON/04ANDERSON-articleLarge.jpg', 'height': 765, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/04/books/review/04ANDERSON/04ANDERSON-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 765}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04ANDERSON/04ANDERSON-jumbo.jpg', 'height': 1024, 'width': 804, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04ANDERSON/04ANDERSON-superJumbo.jpg', 'height': 2048, 'width': 1607, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04ANDERSON/04ANDERSON-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/04/books/review/04ANDERSON/04ANDERSON-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04ANDERSON/04ANDERSON-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Adventures of a Somebody', 'kicker': None, 'content_kicker': None, 'print_headline': 'Adventures of a Somebody', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Adams, Louisa Catherine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Heffron, Margery M', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-02T14:36:04+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Virginia DeJohn Anderson', 'person': [{'firstname': 'Virginia', 'middlename': 'Dejohn', 'lastname': 'Anderson', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c682d698-8401-53ed-8e2b-a4c444b99ec7', 'word_count': 1219, 'uri': 'nyt://article/c682d698-8401-53ed-8e2b-a4c444b99ec7'}, {'abstract': 'An essayist examines job and population loss in the Midwest.', 'web_url': 'https://www.nytimes.com/2014/05/04/books/review/the-hard-way-on-purpose-by-david-giffels.html', 'snippet': 'An essayist examines job and population loss in the Midwest.', 'lead_paragraph': 'What does the essayist David Giffels have in common with LeBron James, Chrissie Hynde, the Professional Bowlers Association and Devo? They all originated in the Rubber Capital of the World. Born at the end of the baby boom in a city cloaked in smoke, Giffels came of age just as Goodrich, Firestone and General Tire were high-tailing it out of Akron, Ohio, chasing nonunion labor and sunnier climes. Almost a third of the city’s population fled after the closures, along with the pop stars, the bowling association and, most crushingly, LeBron. But Giffels stuck around to document every empty Main Street storefront and every piece of the region’s postindustrial detritus, down to a dirty diaper frozen atop a Lake Erie swell.', 'print_section': 'BR', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04SUBMACY/04SUBMACY-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/04/books/review/04SUBMACY/04SUBMACY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04SUBMACY/04SUBMACY-jumbo.jpg', 'height': 1024, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04SUBMACY/04SUBMACY-superJumbo.jpg', 'height': 1791, 'width': 1791, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04SUBMACY/04SUBMACY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/04/books/review/04SUBMACY/04SUBMACY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04SUBMACY/04SUBMACY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Blight and Flight', 'kicker': None, 'content_kicker': None, 'print_headline': 'Blight and Flight', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Macy, Beth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Giffels, David', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-02T14:36:29+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Beth Macy', 'person': [{'firstname': 'Beth', 'middlename': None, 'lastname': 'Macy', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b6fea452-e423-577c-a242-3f5676cc0983', 'word_count': 648, 'uri': 'nyt://article/b6fea452-e423-577c-a242-3f5676cc0983'}, {'abstract': 'In midlife, the protagonist of Julia Glass’s novel embarks on a search for the parent he never knew.', 'web_url': 'https://www.nytimes.com/2014/05/04/books/review/and-the-dark-sacred-night-by-julia-glass.html', 'snippet': 'In midlife, the protagonist of Julia Glass’s novel embarks on a search for the parent he never knew.', 'lead_paragraph': 'The lost or unknown parent tantalizes from behind the drape. The child cast off or left behind spins absence into myth. Most of us are given little to imagine about our mothers and fathers; they stand squarely before us on their fallen arches. We know from whom we got our own flat feet. The forsaken child, though, can hope for better, also that a bit of the mystery has been passed on to him, a secret compartment holding an untapped talent, an innate courage, a sensitive nature. And, against the evidence, love may also wait.', 'print_section': 'BR', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/0504-bks-Anshaw/0504-bks-Anshaw-articleLarge.jpg', 'height': 360, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/04/books/review/0504-bks-Anshaw/0504-bks-Anshaw-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 360}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/0504-bks-Anshaw/0504-bks-Anshaw-jumbo.jpg', 'height': 614, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/0504-bks-Anshaw/0504-bks-Anshaw-superJumbo.jpg', 'height': 1228, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/0504-bks-Anshaw/0504-bks-Anshaw-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/04/books/review/0504-bks-Anshaw/0504-bks-Anshaw-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/0504-bks-Anshaw/0504-bks-Anshaw-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Are You My Father?', 'kicker': None, 'content_kicker': None, 'print_headline': 'Are You My Father?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Anshaw, Carol', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Glass, Julia', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-02T14:37:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Carol Anshaw', 'person': [{'firstname': 'Carol', 'middlename': None, 'lastname': 'Anshaw', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/32d4d90c-1097-59c9-b2ce-12ea7d548fa6', 'word_count': 1151, 'uri': 'nyt://article/32d4d90c-1097-59c9-b2ce-12ea7d548fa6'}, {'abstract': 'A newly translated novel traces the mental breakdown of a code-cracking genius in revolutionary-era China.', 'web_url': 'https://www.nytimes.com/2014/05/04/books/review/decoded-by-mai-jia.html', 'snippet': 'A newly translated novel traces the mental breakdown of a code-cracking genius in revolutionary-era China.', 'lead_paragraph': 'Mai Jia is the pen name of Jiang Benhu, perhaps the most widely read writer you’ve never heard of. Jiang enrolled in a military college in China in 1981 and stayed in the Chinese Army after graduation, writing and editing. Since returning to civilian life in 1997, he has produced a number of novels with military intelligence themes that have sold millions of copies. Some have been made into popular television productions and films. Today Jiang is president of the state-sponsored writers’ association in Zhejiang Province.', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04LINK/04LINK-articleLarge.jpg', 'height': 638, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/04/books/review/04LINK/04LINK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 638}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04LINK/04LINK-jumbo.jpg', 'height': 870, 'width': 818, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/books/review/04LINK/04LINK-superJumbo.jpg', 'height': 870, 'width': 818, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/0