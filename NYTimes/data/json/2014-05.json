, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Shale', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Natural Gas', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Hydraulic Fracturing', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mines and Mining', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Great Britain', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-23T14:36:48+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'International Business', 'byline': {'original': 'By Stanley Reed', 'person': [{'firstname': 'Stanley', 'middlename': None, 'lastname': 'Reed', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/08c0bc1f-4234-558f-8634-ca7ac4d424c4', 'word_count': 938, 'uri': 'nyt://article/08c0bc1f-4234-558f-8634-ca7ac4d424c4'}, {'abstract': 'The third installment of Karl Ove Knausgaard’s six-volume autobiographical novel.', 'web_url': 'https://www.nytimes.com/2014/05/25/books/review/book-3-of-my-struggle-by-karl-ove-knausgaard.html', 'snippet': 'The third installment of Karl Ove Knausgaard’s six-volume autobiographical novel.', 'lead_paragraph': 'On Page 92 of the slate-gray third volume of the six-part Norwegian novel “My Struggle,” by Karl Ove Knausgaard — an autobiographical work that offers detailed accounts of events like the teenage Karl Ove trying to sneak alcohol to a New Year’s party (Book 1), the paternal Karl Ove attending a children’s birthday party (Book 2) and the child Karl Ove eating, on two different occasions, cornflakes (Book 3) — we learn that the headmaster of Karl Ove’s grade school was a diver who discovered a slave ship sunk off Norway’s coast in 1768. ', 'print_section': 'BR', 'print_page': '13', 'source': 'The New York Time