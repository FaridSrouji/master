12/garden/12events/12events-jumbo.jpg', 'height': 398, 'width': 798, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/12/garden/12events/12events-superJumbo.jpg', 'height': 398, 'width': 798, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/12/garden/12events/12events-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/12/garden/12events/12events-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/12/garden/12events/12events-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Not Just Flowers, but How They Got There', 'kicker': 'Currents: Events', 'content_kicker': None, 'print_headline': 'Not Just Flowers, but How They Got There', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Flowers and Plants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Landscaping', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Cultural Landscape Foundation, The', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-12T20:12:22+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d1f2afb1-36f8-57f3-99e5-9bf228c39be3', 'word_count': 230, 'uri': 'nyt://article/d1f2afb1-36f8-57f3-99e5-9bf228c39be3'}, {'abstract': 'At John Derian, the graphic linocut prints, ink drawings and watercolors of Hugo Guinness.', 'web_url': 'https://www.nytimes.com/2014/05/15/garden/the-everyday-in-a-frame.html', 'snippet': 'At John Derian, the graphic linocut prints, ink drawings and watercolors of Hugo Guinness.', 'lead_paragraph': 'Decorating blogs swoon over Hugo Guinness’s graphic black-and-white depictions of ordinary objects. Anna Wintour collects his work. Kate Spade hung his prints of spriggy flowers in her Fifth Avenue boutique. Wes Anderson, a friend of the artist, used Mr. Guinness’s rendition of men’s briefs on the set of “The Royal Tenenbaums” to help establish the film’s quirky mood. ', 'print_section': 'D', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/garden/15QNA1/15QNA1-articleLarge-v2.jpg', 'height': 569, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/15/garden/15QNA1/15QNA1-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 569}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/garden/15QNA1/15QNA1-jumbo-v2.jpg', 'height': 971, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/garden/15QNA1/15QNA1-superJumbo-v2.jpg', 'height': 1942, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/garden/15QNA1/15QNA1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/15/garden/15QNA1/15QNA1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank'