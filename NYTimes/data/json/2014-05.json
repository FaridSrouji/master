': 'images/2014/05/23/sports/SOCCER/SOCCER-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/23/sports/SOCCER/SOCCER-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Donovan Dropped From U.S. World Cup Team', 'kicker': None, 'content_kicker': None, 'print_headline': 'Donovan Dropped From U.S. World Cup Team', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World Cup 2014 (Soccer)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Donovan, Landon', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': "United States Men's National Soccer Team", 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Klinsmann, Jurgen', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-22T22:12:41+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jeré Longman', 'person': [{'firstname': 'Jeré', 'middlename': None, 'lastname': 'Longman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b8f5b5dc-370a-518e-b441-8d01f316e6e3', 'word_count': 880, 'uri': 'nyt://article/b8f5b5dc-370a-518e-b441-8d01f316e6e3'}, {'abstract': 'Six exhibitions at the New Museum rely heavily on ears, including pieces by the Icelandic artist Ragnar Kjartansson, the Italian Roberto Cuoghi and the French Camille Henrot.', 'web_url': 'https://www.nytimes.com/2014/05/23/arts/design/aural-installations-take-over-new-museum.html', 'snippet': 'Six exhibitions at the New Museum rely heavily on ears, including pieces by the Icelandic artist Ragnar Kjartansson, the Italian Roberto Cuoghi and the French Camille Henrot.', 'lead_paragraph': 'The New Museum is alive with the sound of music, as well as talking, chanting, spitting, electronic tics and sputters and, occasionally, the tinkling of 47 small bronze bells. Its six current exhibitions all involve sound. One is almost nothing but sound. This loose, fluctuating connection illuminates some of the many roles sound plays in contemporary art while allowing the shows to, well, amplify one another in unexpected ways. It also mitigates the museum’s dark, awkwardly proportioned galleries.', 'print_section': 'C', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Sounds of All but Silence', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'Sounds of All but Silence', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Art', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New Museum of Contemporary Art', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Kjartansson, Ragnar', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Cuoghi, Roberto', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Henrot, Camille', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-22T22:17:24+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Roberta Smith', 'person': [{'firstname': 'Roberta', 'middlename': None, 'lastname': 'Smith', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c7859c0e-b073-502d-8824-bc7f4ba4f5e7', 'word_count': 1234, 'uri': 'nyt://article/c7859c0e-b073-502d-8824-bc7f4ba4f5e7'}, {'abstract': 'Marieke van der Velden is a pool photographer. Not the designated shooter, but one who photographs swimming holes – from deluxe to decrepit – around the wo