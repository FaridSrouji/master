jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/14/sports/CITY--YANKEES-2/CITY--YANKEES-2-superJumbo.jpg', 'height': 1360, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/14/sports/CITY--YANKEES-2/CITY--YANKEES-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/14/sports/CITY--YANKEES-2/CITY--YANKEES-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/14/sports/CITY--YANKEES-2/CITY--YANKEES-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'On a Long Night at Yankee Stadium, the Mets Look Right at Home', 'kicker': 'Mets 12, Yankees 7', 'content_kicker': None, 'print_headline': 'On a Long Night at Yankee Stadium, the Mets Look Right at Home', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Nuno, Vidal', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Granderson, Curtis', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Murphy, Daniel (1985- )', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-14T04:10:47+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Zach Schonbrun', 'person': [{'firstname': 'Zach', 'middlename': None, 'lastname': 'Schonbrun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/083826c3-c566-55c3-9e10-8e8cddfad75c', 'word_count': 952, 'uri': 'nyt://article/083826c3-c566-55c3-9e10-8e8cddfad75c'}, {'abstract': 'Does the success of “Capital in the Twenty-First Century” mean that the traditional Democratic economic agenda is dead?', 'web_url': 'https://www.nytimes.com/2014/05/14/opinion/edsall-thomas-piketty-and-his-critics.html', 'snippet': 'Does the success of “Capital in the Twenty-First Century” mean that the traditional Democratic economic agenda is dead?', 'lead_paragraph': 'Many on the left see the popularity of Thomas Piketty’s new book, “Capital in the Twenty-First Century,” as a sign of hope, but both optimists and pessimists share a belief more telling than Piketty’s success: the idea that the traditional Democratic economic agenda is dead.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/edsall-circular/edsall-circular-jumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/edsall-circular/edsall-circular-superJumbo-v2.png', 'height': 228, 'width': 228, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/edsall-circular/edsall-circular-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/01/opinion/edsall-circular/edsall-circular-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/01/opinion/edsall-circular/edsall-circular-thumbLarge-v4.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Thomas Piketty and His Critics', 'kicker': 'Contributing Op-Ed Writer', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Income Inequality', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Taxation', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Capital in the Twenty-First Century (Book)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Piketty, Thomas', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Income', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Liberalism (US Politics)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-14T04:14:45+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By Thomas B. Edsall', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/73bd653c-92b7-5fc8-be72-ef5d2675f16e', 'word_count': 1551, 'uri': 'nyt://article/73bd653c-92b7-5fc8-be72-ef5d2675f16e'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/05/14/arts/television/whats-on-wednesday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '7:30 A.M. (FX Movie Channel) STANLEY AND LIVINGSTONE (1939) In the first of two African adventures directed by Henry King, Henry Stanley (Spencer Tracy), a reporter for The New York Herald, travels to Zanzibar in search of the long-missing British missionary Dr. David Livingstone (Cedric Hardwicke). Writing in The New York Times, Bosley Crowther called the lavish production — which helped to immortalize the famous greeting “Dr. Livingstone, I presume” — “intelligent and restrained and dignified.” In “The Snows of Kilimanjaro” (1952), at 9:30, adapted from the short story by Ernest Hemingway, an author (Gregory Peck, above with Susan Hayward) seriously wounded in a hunting accident reflects on the love (Ava Gardner) he lost and the novel he never wrote. Mr. King and the producer Darryl Zanuck “have made a picture that constantly fascinates the eye and stimulates the emotions in small, isolated ways,” Mr. Crowther wrote in The Times. He added: “The shots of wild animals in Africa — elephants, lions, rhinoceroses, giraffes and all manner of lesser creatures — are as magnificent and exciting as any yet, and the atmosphere and beauty of a safari under the snowy peak of Kilimanjaro are superb. Especially one sequence in close-up of a swimming herd of hippopotamuses goes down in this reviewer’s notebook as the best one of game we’ve ever seen.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Wednesday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Wednesday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-14T04:16:00+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/6890335d-b651-5681-8d10-1f8b137739c9', 'word_count': 743, 'uri': 'nyt://article/6890335d-b651-5681-8d10-1f8b137739c9'}, {'abstract': 'The dispute has unleashed some of the worst civil unrest in recent years in Vietnam and has prompted what appears to have been a news media blackout by the government.', 'web_url': 'https://www.nytimes.com/2014/05/14/world/asia/anger-grows-in-vietnam-over-dispute-with-china.html', 'snippet': 'The dispute has unleashed some of the worst civil unrest in recent years in Vietnam and has prompted what appears to have been a news media blackout by the government.', 'lead_paragraph': 'HANOI, Vietnam — Thousands of workers rampaged through an industrial area in southern Vietnam on Tuesday in what reportedly began as protests against China’s stationing of an oil rig in disputed waters off of Vietnam’s coast.  The riots were some of the worst civil unrest in recent years and appear to have prompted \xa0restraints on the local media by Vietnam’s authoritarian government. An article about the protests that was posted online by a Vietnamese state newspaper on Tuesday was removed by Wednesday morning.  The Chinese Embassy in Hanoi issued a notice on Wednesday that urged Chinese living in Vietnam to “minimize unnecessary outings.”  A staff member at the Chutex Garment Factory north of Ho Chi Minh City said 8,000 to 10,000 workers were involved in the rampage at his factory.  “They burned the office,” said the staff member who agreed to speak on condition that his name not be used. The rioters “burned everything, all of the materials, computers, machines.”  Police units and fire fighters arrived at the factory Tuesday and “disbanded,” the rioters, he said. On Wednesday morning police “captured” around 15 to 20 men who were attempting to loot the premises, he said.  The Chutex factory, located in Song Than Industrial Park 2 in southern Binh Duong Province, is described on its web site as one of the largest garment exporters in Vietnam. Chutex International, the parent company, was founded by a Taiwanese garment executive.  It is unclear why rioters targeted a factory linked to Taiwan. Media in Hong Kong said \xa0workers might not have been distinguishing between mainland China and Taiwan, a self-governing island which also has claims to territory in the South China Sea.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Anger Grows in Vietnam Over Dispute With China', 'kicker': None, 'content_kicker': None, 'print_headline': 'Anger Grows in Vietnam in Dispute With China', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Vietnam', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Fuller, Thomas', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'China', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Offshore Drilling and Exploration', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Oil (Petroleum) and Gasoline', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Ships and Shipping', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'International Relations', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'South China Sea', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-05-14T04:21:22+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Mike Ives and Thomas Fuller', 'person': [{'firstname': 'Mike', 'middlename': None, 'lastname': 'Ives', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/68eba058-9a3c-5b9c-b61c-d846f339c9a3', 'word_count': 881, 'uri': 'nyt://article/68eba058-9a3c-5b9c-b61c-d846f339c9a3'}, {'abstract': 'Corrections appearing in print on May 14, 2014.', 'web_url': 'https://www.nytimes.com/2014/05/14/pageoneplus/corrections-may-14-2014.html', 'snippet': 'Corrections appearing in print on May 14, 2014.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '2', 'source': 'The New York T