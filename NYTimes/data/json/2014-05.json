me': 'glocations', 'value': 'New York City', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-14T04:01:08+0000', 'document_type': 'multimedia', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'Stephen Farrell', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Farrell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/d74abc6f-6bda-5268-a25c-bf5f0900701a', 'word_count': 0, 'uri': 'nyt://video/d74abc6f-6bda-5268-a25c-bf5f0900701a'}, {'abstract': 'Architecture and artifacts from the Sept. 11 memorial and museum.', 'web_url': 'https://www.nytimes.com/2014/05/18/magazine/where-the-twin-towers-stood.html', 'snippet': 'Architecture and artifacts from the Sept. 11 memorial and museum.', 'lead_paragraph': 'The Sept. 11 memorial and museum’s location at ground zero in Lower Manhattan is one of its most notable features, according to Steven M. Davis, a partner at Davis Brody Bond, the lead architects for the museum. “If you think about the notion of a traditional museum as an icon which contains exhibits, here we have the inverse,” Davis says. “These are exhibits that are in fact the icon.” The museum opens to survivors and victims’ families on May 15; the public can visit starting May 21. In designing the space, which extends 70 feet below the memorial plaza, Davis says he wanted the experience to be physical — visitors enter by descending a ramp, as if drawn by gravity — but also heavy with symbolism and emotion. How does he hope people will feel when they leave? “Optimistic about the future,” he says. “That we have the wherewithal as a society to create positive results from negative events.” Julie Bosman', 'print_section': 'MM', 'print_page': '43', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Where the Twin Towers Stood', 'kicker': None, 'content_kicker': None, 'print_headline': 'Hallowed Ground', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World Trade Center (Manhattan, NY)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Monuments and Memorials (Structures)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'September 11 (2001)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Museums', 'rank': 6, 'major': 'N'}, {'name': 'glocations', 'value': 'Manhattan (NYC)', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'National September 11 Memorial and Museum', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-05-14T04:01:09+0000', 'document_type': 'article', 'news_desk': 'Magazine', 'section_name': 'Magazine', 'byline': {'original': 'Photographs by Andrew Moore', 'person': [{'firstname': 'Photographs', 'middlename': 'Andrew', 'lastname': 'Moore', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8c0a8dee-14aa-5dc0-8cc8-1d9bf43de614', 'word_count': 194, 'uri': 'nyt://article/8c0a8dee-14aa-5dc0-8cc8-1d9bf43de614'}, {'abstract': 'On the Minute, the congressional career of John Conyers Jr. is in jeopardy after a half-century; a former Israeli prime minister is going to prison; and secrets of a stovetop steak.', 'web_url': 'https://www.nytimes.com/video/multimedia/100000002879382/times-minute-john-conyers-mistake.html', 'snippet': 'On the Minute, the congressional career of John Conyers Jr. is in jeopardy after a half-century; a former Israeli prime minister is going to prison; and secrets of a stovetop steak.', 'lead_paragraph': 'On the Minute, the congressional career of John Conyers Jr. is in jeopardy after a half-century; a former Israeli prime minister is going to prison; and secrets of a stovetop steak.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': Non