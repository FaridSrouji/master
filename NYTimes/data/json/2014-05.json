/2014/05/18/world/18laos1/18laos1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/18/world/18laos1/18laos1-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/18/world/18laos1/18laos1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/18/world/18laos1/18laos1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/18/world/18laos1/18laos1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Air Crash in Laos Kills Top Officials for Security', 'kicker': None, 'content_kicker': None, 'print_headline': 'Air Crash in Laos Kills Top Officials for Security', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fuller, Thomas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Aviation Accidents and Safety', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Lao Airlines', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Laos', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-17T04:41:05+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/89cfb00d-2334-59e7-bb6f-57b9cdcf3a52', 'word_count': 439, 'uri': 'nyt://article/89cfb00d-2334-59e7-bb6f-57b9cdcf3a52'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/05/17/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (Lifetime) RETURN TO ZERO (2014) Maggie (Minnie Driver) and Aaron (Paul Adelstein, above with Ms. Driver) try to resume their picture-perfect existence after their son is stillborn, but can’t escape their grief in this drama based on the personal experiences of the writer and director, Sean Hanish. They cope through denial, escape and alcohol, but when Maggie discovers that Aaron is having an affair with a colleague (Sarah Jones), she decides to end the marriage. But just as she believes that she is ready to move on, she discovers that she’s pregnant. Alfred Molina portrays Aaron’s brusque father and boss; Kathy Baker is Maggie’s mother. And Connie Nielsen plays the doctor who, having experienced a similar loss, helps Maggie and Aaron begin their lives anew.', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s on Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Saturday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-17T05:00:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/803c8cf9-9abf-51d9-b2a4-cfe17dc42a3a', 'word_count': 753, 'uri': 'nyt://article/803c8cf9-9abf-51d9-b2a4-cfe17dc42a3a'}, {'abstract': 'Theories abound for the Indian National Congress’s reversal of fortunes, but workers gathered at the party headquarters during the vote count said the culture of the leadership had changed.', 'web_url': 'https://india.blogs.nytimes.com/2014/05/17/congresss-rank-and-file-lament-demise-of-party-once-beloved/', 'snippet': 'Theories abound for the Indian National Congress’s reversal of fortunes, but workers gathered at the party headquarters during the vote count said the culture of the leadership had changed.', 'lead_paragraph': 'The leafy boulevard leading up to the Indian National Congress party’s headquarters in the Lutyens’ Delhi neighborhood was deserted early in the afternoon on Friday. Trends in voting were becoming more apparent, and it did not look good for the party that governs the central government. With time, it only looked worse.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Congress’s Rank and File Lament Demise of Party Once Beloved', 'kicker': 'India Ink', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Elections', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Politics and Government', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Voting and Voters', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Gandhi, Indira', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Gandhi, Rahul', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Gandhi, Sonia', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Singh, Pal', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Bharatiya Janata Party', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Indian National Congress', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Delhi (India)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Madhya Pradesh (India)', 'rank': 12, 'major': 'N'}, {'name': 'glocations', 'value': 'New Delhi (India)', 'rank': 13, 'major': 'N'}, {'name': 'glocations', 'value': 'Uttar Pradesh State (India)', 'rank': 14, 'major': 'N'}], 'pub_date': '2014-05-17T06:04:13+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Suhasini Raj', 'person': [{'firstname': 'Suhasini', 'middlename': None, 'lastname': 'Raj', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/827f513c-ed1d-5a43-ba4a-0933c5420bde', 'word_count': 733, 'uri': 'nyt://article/827f513c-ed1d-5a43-ba4a-0933c5420bde'}, {'abstract': 'This week, Joe discusses Fannie and Freddie.', 'web_url': 'https://nocera.blogs.nytimes.com/2014/05/17/joe-on-wnycs-money-talking-2/', 'snippet': 'This week, Joe discusses Fannie and Freddie.', 'lead_paragraph': 'There are big changes in store for Fannie Mae and Freddie Mac, the government-run mortgage financing giants that guarantee about two-thirds of all U.S. home loans. The new head of the agency that oversees the companies wants them to continue to play a major role in the housing market. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/16/opinion/fannie/fannie-jumbo.jpg', 'height': 394, 'width': 592, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/16/opinion/fannie/fannie-superJumbo.jpg', 'height': 394, 'width': 592, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/16/opinion/fannie/fannie-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/16/opinion/fannie/fannie-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/16/opinion/fannie/fannie-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Joe on WNYC’s Money Talking', 'kicker': 'Joe Nocera', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-17T07:00:48+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Jennifer Mascia', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Mascia', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c3fb34bf-773f-55b6-9e25-f6113d323a3e', 'word_count': 78, 'uri': 'nyt://article/c3fb34bf-773f-55b6-9e25-f6113d323a3e'}, {'abstract': 'Japanification by the numbers.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/05/17/secular-stagnation-in-the-euro-area/', 'snippet': 'Japanification by the numbers.', 'lead_paragraph': 'Most discussion about the possibility of secular stagnation has focused on US data, partly because most of the new secular stagnationists are American, partly because the data are easier to work with. But as Izabella Kaminska and James Mackintosh point out, the euro area seems closer to Japanification than the US. So are there structural changes in Europe that arguably will lead to persistently lower demand unless offset by policy?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Secular Stagnation in the Euro Area', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-17T07:03:49+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bcf2b858-647d-52d0-acfe-dd6f57b56c72', 'word_count': 292, 'uri': 'nyt://article/bcf2b858-647d-52d0-acfe-dd6f57b56c72'}, {'abstract': 'What we know about monetary shocks.', 'web_url': 'https://krugman.blogs.nytimes.com/2014/05/17/interest-rates-and-inflation-and-evidence/', 'snippet': 'What we know about monetary shocks.', 'lead_paragraph': 'Just a brief belated note on the “neo-Fisherite” view that lower interest rates lead to lower inflation, which has produced some surprising diffidence from economists you would expect to ridicule it; why doesn’t this debate emphasize the large empirical literature on the effects of monetary shocks?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Interest Rates and Inflation and Evidence', 'kicker': 'Paul Krugman', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-17T07:18:54+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Paul Krugman', 'person': [{'firstname': 'Paul', 'middlename': None, 'lastname': 'Krugman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9cbcec22-ee9f-502c-81c1-5525c9fd9e60', 'word_count': 255, 'uri': 'nyt://article/9cbcec22-ee9f-502c-81c1-5525c9fd9e60'}, {'abstract': 'Sixty years after the Supreme Court outlawed segregation, many schools remain divided by race. A ProPublica project in Tuscaloosa, Ala., had teenagers document the realities of resegregated schools.', 'web_url': 'https://lens.blogs.nytimes.com/2014/05/17/bridging-the-racial-divide-in-tuscaloosa-s