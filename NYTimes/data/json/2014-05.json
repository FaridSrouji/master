one, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parties (Social)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-05-02T22:02:20+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': 'By BILL CUNNINGHAM', 'person': [{'firstname': 'Bill', 'middlename': None, 'lastname': 'CUNNINGHAM', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/95aec1f5-46fa-5734-aeff-c50a4ac9fc1c', 'word_count': 0, 'uri': 'nyt://interactive/95aec1f5-46fa-5734-aeff-c50a4ac9fc1c'}, {'abstract': 'Listings of this summer’s releases.', 'web_url': 'https://www.nytimes.com/2014/05/04/movies/summer-movie-release-schedule.html', 'snippet': 'Listings of this summer’s releases.', 'lead_paragraph': 'Yes, Scarlett Johansson wakes up with superpowers and takes no prisoners, but the season isn’t totally about would-be action blockbusters. Philip Seymour Hoffman gifts us with two posthumous performances, as a blue-collar American loser and as a powerful German spy. Documentaries explore a dizzying range of topics, including legal marijuana, the war in Afghanistan, breast-feeding and the Koch brothers. And climate change rears its plot-driving head, ready to replace midcentury nuclear testing as the villain in sci-fi and futurist fantasies.', 'print_section': 'AR', 'print_page': '35', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Summer Movie Release Schedule', 'kicker': None, 'content_kicker': None, 'print_headline': 'Witches, Monsters and Men in Tights', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Gates, Anita', 'rank': 2, 'major': 'N'}], 'pub_d