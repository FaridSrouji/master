rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9d49b9ad-e7d8-5273-9522-c2705691b170', 'word_count': 906, 'uri': 'nyt://article/9d49b9ad-e7d8-5273-9522-c2705691b170'}, {'abstract': 'Progressive orders like the Sisters of St. Joseph, who revolutionized the treatment of imprisoned women in New York, received particular scrutiny.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/05/08/why-are-american-nuns-under-vatican-scrutiny/', 'snippet': 'Progressive orders like the Sisters of St. Joseph, who revolutionized the treatment of imprisoned women in New York, received particular scrutiny.', 'lead_paragraph': 'The 57,000 American women who are working among the needy as Catholic nuns received some words of encouragement this week from a German cardinal, dubbed “the pope’s theologian” because of his close friendship with Pope Francis. “I am also considered suspect!” Cardinal Walter Kasper, an outspoken liberal church writer, said at Fordham University on Monday. He was alluding to a Vatican investigation into “the quality of the life” at women’s religious institutes — code for Rome-appointed busybodies probing nuns for feminist influences and traces of heresy.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Why Are American Nuns Under Vatican Scrutiny?', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Nuns', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Francis', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Leadership Conference of Women Religious', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Roman Catholic Church', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-08T19:38:46+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Francis X. Clines', 'person': [{'firstname': 'Francis', 'middlename': 'X.', 'lastname': 'Clines', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/daba7690-06ea-5ee1-b117-bce27a4bd2d1', 'word_count': 390, 'uri': 'nyt://article/daba7690-06ea-5ee1-b117-bce27a4bd2d1'}, {'abstract': 'My mother’s unexpected appearance at a moment when I needed her more than I knew was more than luck.', 'web_url': 'https://parenting.blogs.nytimes.com/2014/05/08/a-mothers-instinct-a-daughters-need/', 'snippet': 'My mother’s unexpected appearance at a moment when I needed her more than I knew was more than luck.', 'lead_paragraph': 'A little over a decade ago, I made the mistake of taking my mother out to dinner on Mother’s Day. The restaurant’s high ceilings contributed to its poor acoustics, and the servers ran around with a frenetic energy typical of the other days of the year I avoid restaurants, like Valentine’s Day and New Year’s Eve. The clanging of dishes interrupted us midsentence, and occasionally, a baby wailed from the other side of the room. It was the type of environment my mother and I avoid with precision, and yet, there we were, regaling in Mother’s Day splendor with all the other people who mistakenly felt obligated to eat out.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/us/motherlode-valley/motherlode-valley-jumbo.png', 'height': 307, 'width': 593, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/us/motherlode-valley/motherlode-valley-superJumbo.png', 'height': 307, 'width': 593, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/us/motherlode-valley/motherlode-valley-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/08/us/motherlode-valley/motherlode-valley-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/us/motherlode-valley/motherlode-valley-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Mother’s Instinct, a Daughter’s Need', 'kicker': 'Motherlode', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': "Mother's Day", 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-05-08T19:40:09+0000', 'document_type': 'article', 'news_desk': 'Styles', 'section_name': 'U.S.', 'byline': {'original': 'By Ana Homayoun', 'person': [{'firstname': 'Ana', 'middlename': None, 'lastname': 'Homayoun', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e817912a-4fed-5d23-8471-4188b094ae6f', 'word_count': 962, 'uri': 'nyt://article/e817912a-4fed-5d23-8471-4188b094ae6f'}, {'abstract': 'A scene from “Rosemary’s Baby,” with Zoe Saldana and Patrick J. Adams.', 'web_url': 'https://www.nytimes.com/video/arts/television/100000002869875/clip-8216rosemary8217s-baby8217.html', 'snippet': 'A scene from “Rosemary’s Baby,” with Zoe Saldana and Patrick J. Adams.', 'lead_paragraph': 'A scene from “Rosemary’s Baby,” with Zoe Saldana and Patrick J. Adams.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/multimedia/rosemarys-baby-clip/rosemarys-baby-clip-articleLarge.jpg', 'height': 337, 'width': 600, 'subType': 'xlarge', 'c