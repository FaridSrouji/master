role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'John', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b4c3b703-2fd0-5565-bf57-2f9b67be095e', 'word_count': 1985, 'uri': 'nyt://article/b4c3b703-2fd0-5565-bf57-2f9b67be095e'}, {'abstract': 'If genuine, the video would be the first public glimpse of the girls since they were seized on April 14 from a school in Nigeria’s far northeast.', 'web_url': 'https://www.nytimes.com/2014/05/13/world/africa/boko-haram-video-kidnapped-nigerian-girls.html', 'snippet': 'If genuine, the video would be the first public glimpse of the girls since they were seized on April 14 from a school in Nigeria’s far northeast.', 'lead_paragraph': 'MAIDUGURI, Nigeria — The fears have been mounting for weeks: that the girls have been sold, married off, spirited across international borders, and perhaps even killed. Their fate has become the focus of intense international concern, with Michelle Obama holding up a placard appealing for their safe return and governments across the globe pledging to help track them down.', 'print_section': 'A', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/world/13NIGERIA/13NIGERIA-articleLarge-v3.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/13/world/13NIGERIA/13NIGERIA-articleLarge-v3.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/world/13NIGERIA/13NIGERIA-jumbo-v3.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image