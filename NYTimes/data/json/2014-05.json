.jpg', 'height': 500, 'width': 600, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/crosswords/crunched-charms1/crunched-charms1-superJumbo.jpg', 'height': 500, 'width': 600, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/crosswords/crunched-charms1/crunched-charms1-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/20/crosswords/crunched-charms1/crunched-charms1-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}], 'headline': {'main': 'Dave Auckly’s Crunched Charms', 'kicker': 'Wordplay', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Creativity', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Mathematics', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Puzzles', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-26T16:00:19+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Crosswords & Games', 'byline': {'original': 'By Gary Antonick', 'person': [{'firstname': 'Gary', 'middlename': None, 'lastname': 'Antonick', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6035ebba-adca-584a-8217-0a94b0c4428f', 'word_count': 887, 'uri': 'nyt://article/6035ebba-adca-584a-8217-0a94b0c4428f'}, {'abstract': 'A new gallery opening this summer will include an Ikea soft today, a 3-D printed gun and a pair of jeans acquired after the collapse of a factory in Bangladesh.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/05/26/victoria-albert-museum-starts-rapid-response-collecting/', 'snippet': 'A new gallery opening this summer will include an Ikea soft today, a 3-D printed gun and a pair of jeans acquired after the collapse of a factory in Bangladesh.', 'lead_paragraph': 'LONDON — Museums tend to take the long view when it comes to acquiring works, but the Victoria & Albert Museum here has announced that a new gallery opening this summer will be dedicated to “rapid response collecting.” That means the kind of items that can mostly be bought without having an acquisitions committee meeting. ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Victoria & Albert Museum Starts ‘Rapid Response Collecting’', 'kicker': 'ArtsBeat', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-26T16:06:02+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'byline': {'original': 'By Roslyn Sulcas', 'person': [{'firstname': 'Roslyn', 'middlename': None, 'lastname': 'Sulcas', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3d4dbb83-ed66-5178-bdd0-7d36a28de992', 'word_count': 278, 'uri': 'nyt://article/3d4dbb83-ed66-5178-bdd0-7d36a28de992'}, {'abstract': 'Cloud computing companies fear that a Reagan-era law governing access to email and other data is causing an image problem in the United States and hurting business.', 'web_url': 'https://www.nytimes.com/2014/05/27/us/technology-firms-press-congress-to-tighten-privacy-law.html', 'snippet': 'Cloud computing companies fear that a Reagan-era law governing access to email and other data is causing an image problem in the United States and hurting business.', 'lead_paragraph': 'WASHINGTON — A law that allows the government to read email and cloud-stored data over six months old without a search warrant is under attack from technology companies, trade associations and lobbying groups, which are pressing Congress to tighten privacy protections. Federal investigators have used the law to view content hosted by third-party providers for civil and criminal lawsuits, in some cases without giving notice to the individual being investigated.', 'print_section': 'A', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/27PRIVACY/27PRIVACY-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/26/us/27PRIVACY/27PRIVACY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/27PRIVACY/27PRIVACY-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/27PRIVACY/27PRIVACY-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/27PRIVACY/27PRIVACY-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/26/us/27PRIVACY/27PRIVACY-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/27PRIVACY/27PRIVACY-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Technology Companies Are Pressing Congress to Bolster Privacy Protections', 'kicker': None, 'content_kicker': None, 'print_headline': 'Technology Companies Are Pressing Congress to Bolster Privacy Protections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Schneider, Elena', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Electronic Communications Privacy Act', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Privacy', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cloud Computing', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Securities and Exchange Commission', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-26T16:11:41+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Elena Schneider', 'person': [{'firstname': 'Elena', 'middlename': None, 'lastname': 'Schneider', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a6c3b599-5f5f-5878-8918-6dbd211d1ab3', 'word_count': 1110, 'uri': 'nyt://article/a6c3b599-5f5f-5878-8918-6dbd211d1ab3'}, {'abstract': 'A satisfying dinner that can be put together in 10 minutes.', 'web_url': 'https://www.nytimes.com/2014/05/26/health/grilled-gorgonzola-and-beet-green-sandwich.html', 'snippet': 'A satisfying dinner that can be put together in 10 minutes.', 'lead_paragraph': 'This dish is the one that inspired me to devote a week of Recipes for Health to toaster-oven vegetable and grilled cheese sandwiches. I made it one night after a day preparing enough quiche to feed 80 for a book signing. When I got home I had still more quiches to make in my own kitchen, and the last thing I wanted to do was cook dinner for myself.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/27/science/26recipehealth/26recipehea