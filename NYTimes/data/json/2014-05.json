, 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/23/science/23flies/23flies-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/23/science/23flies/23flies-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/23/science/23flies/23flies-superJumbo.jpg', 'height': 1080, 'width': 1620, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/23/science/23flies/23flies-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/23/science/23flies/23flies-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/23/science/23flies/23flies-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Even Fruit Flies Need a Moment to Think It Over', 'kicker': None, 'content_kicker': None, 'print_headline': 'Insect Behavior: We Really Do Have the Brain of a Fruit Fly', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Quenqua, Douglas', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fruit Flies', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Intelligence and Intelligence Tests (IQ)', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'DasGupta, Shamik', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Miesenbock, Gero', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Brain', 'rank': 6, 'major': 'N'}, {'name': 'organizations', 'value': 'Science (Journal)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-22T18:00:19+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Douglas Quenqua', 'person': [{'firstname': 'Douglas', 'middlename': None, 'lastname': 'Quenqua', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0d62e37e-b4f7-55e7-9260-80524c440e64', 'word_count': 635, 'uri': 'nyt://article/0d62e37e-b4f7-55e7-9260-80524c440e64'}, {'abstract': 'DNA analysis in a new study suggests that the common ancestor of ratites continued to fly even after the supercontinent Gondwana split into pieces.', 'web_url': 'https://www.nytimes.com/2014/05/23/science/a-theory-on-how-flightless-birds-spread-across-the-world-they-flew-there.html', 'snippet': 'DNA analysis in a new study suggests that the common ancestor of ratites continued to fly even after the supercontinent Gondwana split into pieces.', 'lead_paragraph': 'Just a few centuries ago, Madagascar was home to a monstrous creature called the elephant bird. It towered as high as nine feet. Weighing as much as 600 pounds, it was the heaviest bird known to science. You’d need 160 chicken eggs to equal the volume of a single elephant bird egg.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/23/science/23zimmer-2/23zimmer-2-articleLarge.jpg', 'height': 807, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/23/science/23zimmer-2/23zimmer-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 807}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/23/science/23zimmer-2/23zimmer-2-jumbo.jpg', 'height': 1024, 'width': 762, 'subType': 'jumb