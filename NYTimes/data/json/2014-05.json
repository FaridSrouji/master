url': 'images/2014/05/15/business/MACHINE/MACHINE-jumbo.jpg', 'height': 1024, 'width': 732, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/business/MACHINE/MACHINE-superJumbo.jpg', 'height': 2048, 'width': 1463, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/business/MACHINE/MACHINE-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/15/business/MACHINE/MACHINE-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/business/MACHINE/MACHINE-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'How Young Is Too Young for a Digital Presence?', 'kicker': None, 'content_kicker': None, 'print_headline': 'How Young Is Too Young for a Digital Presence?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Babies and Infants', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-15T01:08:43+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Technology', 'subsection_name': 'Personal Tech', 'byline': {'original': 'By Molly Wood', 'person': [{'firstname': 'Molly', 'middlename': None, 'lastname': 'Wood', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/50c57fe6-ee3f-5271-a3d8-16cf2bd013ac', 'word_count': 952, 'uri': 'nyt://article/50c57fe6-ee3f-5271-a3d8-16cf2bd013ac'}, {'abstract': 'Clive Goodman, former royalty editor of The News of the World, said that he had listened to the voice mails of the former Kate Middleton, Prince William and Prince Harry.', 'web_url': 'https://www.nytimes.com/2014/05/15/world/europe/britain-former-editor-testifies-on-hacking-of-royals.html', 'snippet': 'Clive Goodman, former royalty editor of The News of the World, said that he had listened to the voice mails of the former Kate Middleton, Prince William and Prince Harry.', 'lead_paragraph': ' The long-running trial of the former tabloid editors Rebekah Brooks and Andy Coulson heard testimony on Wednesday that The News of the World had hacked the cellphones of the royal family and its closest associates. Clive Goodman, former royalty editor of the newspaper, which is now defunct, said that before his arrest and conviction for illegal eavesdropping in 2006 he listened to the voice mails of the former Kate Middleton 155 times, of Prince William 35 times and of Prince Harry nine times. Prince William is in line to become king, and Ms. Middleton, now his wife, was then his girlfriend. Mr. Goodman is charged with conspiring to pay officials for royal phone directories, and he said he had not previously disclosed his hacking of royal telephones because the police had never asked him. Earlier in the trial he testified that he had hacked only aides working for the royals, and he has been promised by the prosecution that he will not be further charged for hacking. ', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Britain: Former Editor Testifies on Hacking of Royals', 'kicker': 'World Briefing', 'content_kicker': None, 'print_headline': 'Britain: Former Editor Testifies on Hacking of Royals', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Erlanger, Steven', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Goodman, 