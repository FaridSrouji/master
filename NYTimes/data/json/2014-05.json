'AR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Garage Rock’s Latest Nerve Center', 'kicker': None, 'content_kicker': None, 'print_headline': 'Garage Rock’s Latest Nerve Center', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Music', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Burger Records', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-16T14:00:01+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Ben Ratliff', 'person': [{'firstname': 'Ben', 'middlename': None, 'lastname': 'Ratliff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7d76e10e-c715-5e33-97e9-af07e79944ab', 'word_count': 1585, 'uri': 'nyt://article/7d76e10e-c715-5e33-97e9-af07e79944ab'}, {'abstract': 'Buildings are creating amenities for market-rate tenants only, leaving regulated renters out in the cold.', 'web_url': 'https://www.nytimes.com/2014/05/18/realestate/rent-regulated-tenants-excluded-from-amenities.html', 'snippet': 'Buildings are creating amenities for market-rate tenants only, leaving regulated renters out in the cold.', 'lead_paragraph': 'When a playroom opened in Michael Reilly’s Upper West Side building two years ago, he asked the concierge for a key to the space so his toddler could play there. The concierge’s answer stunned him: It was out of bounds to him and his child. ', 'print_section': 'RE', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/18/realestate/18cover/18cover-articleLarge.jpg', 'height': 364, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/18/realestate/18cover/18cover-articleLarge.jpg', '