 'United States Defense and Military Forces', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'AFGHANISTAN', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States International Relations', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-28T00:36:57+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/8c94f92a-13a1-5965-84c6-a0a67f4914ab', 'word_count': 611, 'uri': 'nyt://article/8c94f92a-13a1-5965-84c6-a0a67f4914ab'}, {'abstract': 'The father of a victim in Friday’s shooting rampage in Isla Vista, Calif., has a message for his elected representatives: “Get to work and do something.”', 'web_url': 'https://www.nytimes.com/2014/05/28/opinion/as-congress-sleeps-more-people-die.html', 'snippet': 'The father of a victim in Friday’s shooting rampage in Isla Vista, Calif., has a message for his elected representatives: “Get to work and do something.”', 'lead_paragraph': 'Richard Martinez has a message for the politicians who have been calling to express condolences on the death of his son, Christopher Michaels-Martinez, in the massacre of six people in Isla Vista, Calif., on Friday: “I don’t care about your sympathy,” he said. “Get to work and do something.”', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'As Congress Sleeps, More People Die', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'As Congress Sleeps, More People Die ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Isla Vista, Calif, Massacre (2014)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 2, 'major'