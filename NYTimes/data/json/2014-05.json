/2014/11/12/opinion/krugman-circular/krugman-circular-jumbo-v5.jpg', 'height': 1008, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-superJumbo-v5.jpg', 'height': 1852, 'width': 1881, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbStandard-v5.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbStandard-v5.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/11/12/opinion/krugman-circular/krugman-circular-thumbLarge-v7.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Springtime for Bankers', 'kicker': 'Op-Ed Columnist', 'content_kicker': None, 'print_headline': 'Springtime for Bankers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Geithner, Timothy F', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Krugman, Paul', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Subprime Mortgage Crisis', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Recession and Depression', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 7, 'major': 'N'}, {'name': 'creative_works', 'value': 'Stress Test: Reflections on Financial Crises (Book)', 'rank': 8, 'major': 'N'}], '