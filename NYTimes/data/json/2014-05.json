ualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Question', '_id': 'nyt://article/a1a59eeb-bb07-5f8e-b390-7f05323fcee1', 'word_count': 585, 'uri': 'nyt://article/a1a59eeb-bb07-5f8e-b390-7f05323fcee1'}, {'abstract': 'A poll found strong support for the Democratic view on two crucial issues.', 'web_url': 'https://takingnote.blogs.nytimes.com/2014/05/19/a-preference-for-republicans-gun-control-and-immigration-reform/', 'snippet': 'A poll found strong support for the Democratic view on two crucial issues.', 'lead_paragraph': 'The new Politico poll of likely voters in swing states and competitive districts isn’t all that bad for Democrats.\xa0Yes, the poll found that respondents would prefer to vote for a generic Republican over a generic Democrat, 41 percent to 34 percent. It also found that they’re not happy with Barack Obama: 59 percent said they disapproved of his job performance as president.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Preference for Republicans, Gun Control and Immigration Reform', 'kicker': 'Taking Note', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Gun Control', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Immigration and Emigration', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-19T20:45:26+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Juliet Lapidos', 'person': [{'firstname': 'Juliet', 'middlename': None, 'lastname': 'Lapidos', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d1f60bae-2e97-5dd0-b653-a26e92bccedb', 'word_count': 212, 'uri': 'nyt://article/d1f60bae-2e97-5dd0-b653-a26e92bccedb'}, {'abstract': 'Kate Baldwin’s program reprises some of her Broadway moments as well as unfulfilled dreams.', 'web_url': 'https://www.nytimes.com/2014/05/20/arts/music/kate-baldwin-shows-her-range-at-54-below.html', 'snippet': 'Kate Baldwin’s program reprises some of her Broadway moments as well as unfulfilled dreams.', 'lead_paragraph': 'Could Kate Baldwin, the redheaded firecracker who detonated in the 2009 Broadway revival of “Finian’s Rainbow” have been a rock star? That possibility was broached on Friday evening at 54 Below, where Ms. Baldwin opened her new cabaret show with bright, peppy rendition of Ian Axel’s “Rockstar!,” an insanely catchy “what if?” song whose narrator gazes fancifully into the future.', 'print_section': 'C', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/BALDWIN/BALDWIN-articleLarge.jpg', 'height': 411, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/20/arts/BALDWIN/BALDWIN-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 411}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/BALDWIN/BALDWIN-jumbo.jpg', 'height': 701, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/BALDWIN/BALDWIN-superJumbo.jpg', 'height': 1401, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/BALDWIN/BALDWIN-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/20/arts/BALDWIN/BALDWIN-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailhei