/01/books/review/01JACOBS/01JACOBS-superJumbo.jpg', 'height': 2048, 'width': 710, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01JACOBS/01JACOBS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/01/books/review/01JACOBS/01JACOBS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01JACOBS/01JACOBS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Dress-Up', 'kicker': None, 'content_kicker': None, 'print_headline': 'Dress-Up', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Przybyszewski, Linda', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-30T14:47:50+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Alexandra Jacobs', 'person': [{'firstname': 'Alexandra', 'middlename': None, 'lastname': 'Jacobs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/42186920-91c1-57f7-bc3d-3e1b61d39450', 'word_count': 1175, 'uri': 'nyt://article/42186920-91c1-57f7-bc3d-3e1b61d39450'}, {'abstract': 'A collection of Mary Ellen Mark’s photos from Mexico and India.', 'web_url': 'https://www.nytimes.com/2014/06/01/books/review/man-and-beast-by-mary-ellen-mark.html', 'snippet': 'A collection of Mary Ellen Mark’s photos from Mexico and India.', 'lead_paragraph': 'Over the last 50 years, Mary Ellen Mark has photographed twins, clowns, patients in a mental hospital, Ku Klux Klan members and Liza Minnelli. She likes to look at people who are used to being looked at, and she uses her camera like Wonder Woman’s golden lasso — as a truth-telling device that peels performance from personality. In one of her most famous photographs, “Tiny” (1983), a Seattle street kid poses in her Halloween costume: a little black dress, little black gloves and a hat with a netted veil. It’s the daintiness of Tiny’s dress combined with her defiance that gives the photograph its charge. Tough Tiny looks afraid.', 'print_section': 'BR', 'print_page': '43', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01SEHGAL1/01SEHGAL1-articleLarge.jpg', 'height': 606, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/01/books/review/01SEHGAL1/01SEHGAL1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 606}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01SEHGAL1/01SEHGAL1-jumbo.jpg', 'height': 1024, 'width': 1014, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01SEHGAL1/01SEHGAL1-superJumbo.jpg', 'height': 1800, 'width': 1781, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01SEHGAL1/01SEHGAL1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/01/books/review/01SEHGAL1/01SEHGAL1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01SEHGAL1/01SEHGAL1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Captured Obsessions', 'kicker': None, 'content_kicker': None, 'print_headline': 'Captured Obsessions', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sehgal, Parul', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Mark, Mary Ellen', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Photography', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-30T14:48:38+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Parul Sehgal', 'person': [{'firstname': 'Parul', 'middlename': None, 'lastname': 'Sehgal', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/b5c432c0-befc-59f4-aa05-4cdf74d235ad', 'word_count': 653, 'uri': 'nyt://article/b5c432c0-befc-59f4-aa05-4cdf74d235ad'}, {'abstract': 'Susan Rieger’s epistolary first novel tells the story of a bitter uncoupling.', 'web_url': 'https://www.nytimes.com/2014/06/01/books/review/the-divorce-papers-by-susan-rieger.html', 'snippet': 'Susan Rieger’s epistolary first novel tells the story of a bitter uncoupling.', 'lead_paragraph': 'According to the oft-repeated statistic, roughly half of all marriages in this country end in divorce — which makes “The Divorce Papers,” Susan Rieger’s epistolary first novel about one couple’s messy split, certainly relatable. But how many people want to relive the emotions of a marriage’s demise, from the initial shock to the ensuing despair, fury and vengeance?', 'print_section