/dbpix-schwartz1/dbpix-schwartz1-jumbo.jpg', 'height': 554, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/business/dbpix-schwartz1/dbpix-schwartz1-superJumbo.jpg', 'height': 1108, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/business/dbpix-schwartz1/dbpix-schwartz1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/17/business/dbpix-schwartz1/dbpix-schwartz1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/business/dbpix-schwartz1/dbpix-schwartz1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Freedom of Boundaries', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Sleep', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Los Angeles Police Department', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-05-16T18:33:31+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Tony Schwartz', 'person': [{'firstname': 'Tony', 'middlename': None, 'lastname': 'Schwartz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/72c5d65c-373e-5ca9-8955-0318ace900a5', 'word_count': 856, 'uri': 'nyt://article/72c5d65c-373e-5ca9-8955-0318ace900a5'}, {'abstract': 'The Kenyan president, Uhuru Kenyatta, urged citizens to 