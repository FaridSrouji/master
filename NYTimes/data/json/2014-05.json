qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62be88a3-8532-5def-a1ec-d617d23f71d7', 'word_count': 1100, 'uri': 'nyt://article/62be88a3-8532-5def-a1ec-d617d23f71d7'}, {'abstract': 'Leading members of Thailand’s largest political party surrendered themselves to the military on Friday, a day after the head of the army overthrew the country’s elected government.', 'web_url': 'https://www.nytimes.com/2014/05/24/world/asia/thailand.html', 'snippet': 'Leading members of Thailand’s largest political party surrendered themselves to the military on Friday, a day after the head of the army overthrew the country’s elected government.', 'lead_paragraph': 'BANGKOK — Former Prime Minister Yingluck Shinawatra and leading members of Thailand’s deposed government surrendered to the military on Friday after being summoned by the generals now leading the country.', 'print_section': 'A', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Thai Military Detains Ousted Leaders as Coup Sets Off Small Acts of Protest ', 'kicker': None, 'content_kicker': None, 'print_headline': 'Thai Military Detains Ousted Leaders as Coup Sets Off Small Acts of Protest', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Thailand', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Fuller, Thomas', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': "Coups D'Etat and Attempted Coups D'Etat", 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Defense and Military Forces', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Yingluck Shinawatra', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Demonstrations, Protests, and Riots', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-23T10:57:30+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Thomas Fuller', 'person': [{'firstname': 'Thomas', 'middlename': None, 'lastname': 'Fuller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/38477106-e0a3-5f8d-86f3-db952cb2e95f', 'word_count': 692, 'uri': 'nyt://article/38477106-e0a3-5f8d-86f3-db952cb2e95f'}, {'abstract': 'In this Insider series, On Our Walls, we’ll take you inside the building and share with you images, as well as some context, from the photographers who made them and the editors who worked on them.', 'web_url': 'https://www.nytimes.com/times-insider/2014/05/23/on-our-walls/', 'snippet': 'In this Insider series, On Our Walls, we’ll take you inside the building and share with you images, as well as some context, from the photographers who made them and the editors who worked on them.', 'lead_paragraph': 'The walls of The New York Times headquarters on Eighth Avenue are decorated with news images from the past. Prints by photojournalists hang throughout the building. In this Insider series, On Our Walls, we’ll take you inside the building to see the photographs — many of them rich in history — and the stories behind them.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/21/blogs/EstrinWTC/EstrinWTC-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/21/blogs/EstrinWTC/EstrinWTC-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/21/blogs/EstrinWTC/EstrinWTC-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/201