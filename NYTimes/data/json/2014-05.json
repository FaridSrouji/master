905-5066-9199-afd457c47a30'}, {'abstract': 'A successful crowdfunding campaign has ended a plan by the San Diego Opera to close its doors.', 'web_url': 'https://www.nytimes.com/2014/05/20/arts/music/san-diego-opera-raises-money-to-remain-open.html', 'snippet': 'A successful crowdfunding campaign has ended a plan by the San Diego Opera to close its doors.', 'lead_paragraph': 'The San Diego Opera, which was left for dead in March when its board of directors voted to shut it down after 49 years, citing dwindling ticket sales and philanthropic support, will live to see its 50th-anniversary season after all, the company announced on Monday.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'San Diego Opera Raises Money to Remain Open', 'kicker': None, 'content_kicker': None, 'print_headline': 'San Diego Opera Raises Money to Remain Open', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Opera', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Cooper, Michael', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'San Diego Opera', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-19T20:34:05+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Michael Cooper', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': 'Cooper', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/38619b94-d196-5593-bbc2-4712c1d5a276', 'word_count': 390, 'uri': 'nyt://article/38619b94-d196-5593-bbc2-4712c1d5a276'}, {'abstract': 'The pianist Jeremy Denk performs Mozart’s Rondo in F (K. 494).', 'web_url': 'https://www.nytimes.com/video/arts/music/100000002889612/in-performance-jeremy-denk.html', 'snippet': 'The pianist Jeremy Denk performs Mozart’s Rondo in F (K. 494).', 'lead_paragr