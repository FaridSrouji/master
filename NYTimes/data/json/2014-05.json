th-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/science/19recipehealth/19recipehealth-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Blueberry or Blackberry Compote With Yogurt or Ricotta', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Fruit', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-19T16:26:04+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/f6e57dbe-f9f7-5737-8991-439e4746c448', 'word_count': 387, 'uri': 'nyt://article/f6e57dbe-f9f7-5737-8991-439e4746c448'}, {'abstract': 'Topped with oats and quinoa flour, this old-fashioned cake is no longer traditional at all.', 'web_url': 'https://www.nytimes.com/2014/05/20/health/whole-grain-blueberry-buckle.html', 'snippet': 'Topped with oats and quinoa flour, this old-fashioned cake is no longer traditional at all.', 'lead_paragraph': 'A buckle is an old-fashioned cake that has a crumble topping and fruit that makes the batter buckle, or sink, as it bakes. Or at least that’s what all the recipes I’ve read say is supposed to happen. When I made the cake the blueberries didn’t really cause it to buckle at all, they just formed a layer on top of the cake. This is now a favorite dessert. It’s not traditional at all, as I use whole-wheat flour, and oats and quinoa flour in the topping.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/science/20recipehealth/20recipehealth-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/20/science/20recipehealth/20recipehealth-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/science/20recipehealth/20recipehealth-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/science/20recipehealth/20recipehealth-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/science/20recipehealth/20recipehealth-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/20/science/20recipehealth/20recipehealth-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/science/20recipehealth/20recipehealth-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Whole-Grain Blueberry Buckle', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Cooking and Cookbooks', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Recipes', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Diet and Nutrition', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Cakes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Blueberries', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-19T16:26:47+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Martha Rose Shulman', 'person': [{'firstname': 'Martha', 'middlename': 'Rose', 'lastname': 'Shulman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/ab6be558-90e4-5206-9c1f-bec8e98e3f7f', 'word_count': 560, 'uri': 'nyt://article/ab6be558-90e4-5206-9c1f-bec8e98e3f7f'}, {'abstract': 'Anger over what local residents call the mine’s unbridled expansion represents the latest instance of hostility toward China by Asian neighbors.', 'web_url': 'https://www.nytimes.com/2014/05/20/world/asia/anti-china-resentment-flares-over-myanmar-mine.html', 'snippet': 'Anger over what local residents call the mine’s unbridled expansion represents the latest instance of hostility toward China by Asian neighbors.', 'lead_paragraph': 'BANGKOK — A flare-up of resilient hostility toward China among its neighbors has infected central Myanmar, where a Chinese company operating a copper mine has local residents seething over what they call the operator’s arrogance and the project’s seemingly unbridled expansion plans.', 'print_section': 'A', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Resentment of China Spreading in Myanmar', 'kicker': None, 'content_kicker': None, 'print_headline': 'Resentment of China Spreading in Myanmar', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Myanmar', 'rank': 1, 'major': 'N'}, {'name': 'persons',