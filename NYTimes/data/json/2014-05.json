 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8b3c3713-e269-5c5d-89d3-f69bdc4dfa6f', 'word_count': 771, 'uri': 'nyt://article/8b3c3713-e269-5c5d-89d3-f69bdc4dfa6f'}, {'abstract': 'The administration of President Goodluck Jonathan has been shockingly slow and inept at addressing the mass kidnappings of scores of schoolgirls.', 'web_url': 'https://www.nytimes.com/2014/05/07/opinion/nigerias-stolen-girls.html', 'snippet': 'The administration of President Goodluck Jonathan has been shockingly slow and inept at addressing the mass kidnappings of scores of schoolgirls.', 'lead_paragraph': 'Three weeks after their horrifying abduction in Nigeria, 276 of the more than 300 girls who were taken from a school by armed militants are still missing, possibly sold into slavery or married off. Nigerian security forces apparently do not know where the girls are and the country’s president, Goodluck Jonathan, has been shockingly slow and inept at addressing this monstrous crime. ', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Nigeria’s Stolen Girls', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Nigeria’s Stolen Girls', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Kidnapping', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Boko Haram', 'rank': 2, 'major': 'N'}, {'name': 'glocations', 'value': 'Nigeria', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Jonathan, Goodluck', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Shekau, Abubakar', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Terrorism', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Women and Girls', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-05-06T23:55:33+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/4a703972-521a-5f9d-b77f-43a40158f791', 'word_count': 510, 'uri': 'nyt://article/4a703972-521a-5f9d-b77f-43a40158f791'}, {'abstract': 'Stanford became the first major university to lend support to a nationwide campaign to rid endowments and pension funds of fossil fuel investments.', 'web_url': 'https://www.nytimes.com/2014/05/07/education/stanford-to-purge-18-billion-endowment-of-coal-stock.html', 'snippet': 'Stanford became the first major university to lend support to a nationwide campaign to rid endowments and pension funds of fossil fuel investments.', 'lead_paragraph': 'Stanford University announced Tuesday that it would divest its $18.7 billion endowment of stock in coal-mining companies, becoming the first major university to lend support to a nationwide campaign to purge endowments and pension funds of fossil fuel investments.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/07/us/STANFORD/STANFORD-articleLarge-v2.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/07/us/STANFORD/STANFORD-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/07/us/STANFORD/STANFORD-jumbo-v2.jpg', 'height': 665, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/07/us/STANFORD/STANFORD-superJumbo-v2.jpg', 'height': 1329, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit':