gory for progressive religious bodies.', 'print_section': 'A', 'print_page': '15', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/us/RELIGION/RELIGION-articleLarge.jpg', 'height': 416, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/17/us/RELIGION/RELIGION-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 416}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/us/RELIGION/RELIGION-jumbo.jpg', 'height': 710, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/us/RELIGION/RELIGION-superJumbo.jpg', 'height': 1420, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/us/RELIGION/RELIGION-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/17/us/RELIGION/RELIGION-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/17/us/RELIGION/RELIGION-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Humanist Foundation Reaches Out to Religious Groups, Testing a Divide', 'kicker': None, 'content_kicker': None, 'print_headline': 'Humanist Foundation Reaches Out to Religious Groups, Testing a Divide', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McGowan, Dale', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Freedman, Samuel G', 'rank': 2, 'major': 'N'}, {