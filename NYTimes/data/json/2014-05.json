'subsection_name': 'Europe', 'byline': {'original': 'By William Yardley', 'person': [{'firstname': 'William', 'middlename': None, 'lastname': 'Yardley', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/3ebffab3-28dd-58c6-982e-219f62f02212', 'word_count': 781, 'uri': 'nyt://article/3ebffab3-28dd-58c6-982e-219f62f02212'}, {'abstract': 'Ms. Cummings was a participant in a federal lawsuit that accused The New York Times of racial discrimination in hiring and promotional practices.', 'web_url': 'https://www.nytimes.com/2014/05/14/business/media/judith-cummings-chief-of-a-bureau-for-the-times-dies-at-68.html', 'snippet': 'Ms. Cummings was a participant in a federal lawsuit that accused The New York Times of racial discrimination in hiring and promotional practices.', 'lead_paragraph': 'Judith Cummings, who was the first black woman to head a national news bureau for The New York Times, serving as chief correspondent in Los Angeles from 1985 to 1988, was found dead on May 6 at her home in Detroit. She was 68.', 'print_section': 'B', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/14/business/CUMMINGS-obit/CUMMINGS-obit-articleLarge.jpg', 'height': 880, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/14/business/CUMMINGS-obit/CUMMINGS-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 880}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/14/business/CUMMINGS-obit/CUMMINGS-obit-jumbo.jpg', 'height': 1024, 'width': 698, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/14/business/CUMMINGS-obit/CUMMIN