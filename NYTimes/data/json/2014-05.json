ype': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2012/02/29/health/29well_diagnosis/29well_diagnosis-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Think Like a Doctor: 18-Year Rash Solved!', 'kicker': 'Well', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'ALLERGIES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Hands', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Skin', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Sunlight', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Ultraviolet Light', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-02T19:59:18+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Health', 'byline': {'original': 'By Lisa Sanders, M.D', 'person': [{'firstname': 'Lisa', 'middlename': None, 'lastname': 'Sanders', 'qualifier': 'M.D', 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/14384ea4-043c-503a-a1e3-f04d26c49f72', 'word_count': 1469, 'uri': 'nyt://article/14384ea4-043c-503a-a1e3-f04d26c49f72'}, {'abstract': 'We have decades of evidence telling us how to lift living standards for the middle class and the poor.', 'web_url': 'https://www.nytimes.com/2014/05/03/upshot/inequality-is-not-inevitable.html', 'snippet': 'We have decades of evidence telling us how to lift living standards for the middle class and the poor.', 'lead_paragraph': 'We have been living with rising income inequality for so long — in good times and bad, under Republican presidents and Democratic ones — that it has come to seem inevitable. But inequality is not inevitable. Many societies, including the United States, have found ways to reduce inequality and lift living standards for the middle class and the poor.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/upshot/03inequality/03inequality-articleLarge.png', 'height': 384, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/03/upshot/03inequality/03inequality-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 384}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/upshot/03inequality/03inequality-jumbo.png', 'height': 655, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/upshot/03inequality/03inequality-superJumbo.png', 'height': 1310, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/upshot/03inequality/03inequality-thumbStandard.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/03/upshot/03inequality/03inequality-thumbStandard.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/upshot/03inequality/03inequality-thumbLarge.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inequality Is Not Inevitable', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': No