/07UP-BagsSub/07UP-BagsSub-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/07/upshot/07UP-BagsSub/07UP-BagsSub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/07/upshot/07UP-BagsSub/07UP-BagsSub-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/07/upshot/07UP-BagsSub/07UP-BagsSub-superJumbo.jpg', 'height': 1362, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/07/upshot/07UP-BagsSub/07UP-BagsSub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/07/upshot/07UP-BagsSub/07UP-BagsSub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/07/upshot/07UP-BagsSub/07UP-BagsSub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Why You Should Pay Frontier’s Carry-On Bag Fee', 'kicker': 'Airline Economics', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prices (Fares, Fees and Rates)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-05-09T10:58:14+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Josh Barro', 'person': [{'firstname': 'Josh', 'middlename': None, 'lastname': 'Barro', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/c262189b-4946-52f1-9941-725302f31f29', 'word_count': 672, 'uri': 'nyt://article/c262189b-4946-52f1-9941-725302f31f29'}, {'abstract': 'Pamela Paul discussed the decisions made on a weekly basis at The Times’s Book Review, and the thinking behind this week’s cover.', 'web_url': 'https://www.nytimes.com/times-insider/2014/05/09/coming-up-in-the-book-review/', 'snippet': 'Pamela Paul discussed the decisions made on a weekly basis at The Times’s Book Review, and the thinking behind this week’s cover.', 'lead_paragraph': 'One of the biggest decisions we make every week at the Book Review is: What will be on the cover? Most weeks, there is a standout novel or work of nonfiction or an extremely commanding review by a prominent author or critic that demands attention. Stephen King on Donna Tartt’s “Goldfinch,” for example. Barbara Kingsolver on Elizabeth Gilbert’s “Signature of All Things.” Or we group a few books together, as we did last week with three biographies about James Madison, John Quincy Adams and Louisa Catherine Adams.Occasionally, we run a theme issue, like one we did in April on money or one last year that looked at writing about sex. This week, we did something slightly different. While we didn’t create an entire issue around a theme, we decided to highlight six new books on the cover that took on the subcontinent as their subject matter. These spring releases really stood out: Rana Dasgupta’s “Capital,” John Keay’s “Midnight’s Descendants,” Ramachandra Guha’s “Gandhi Before India,” Saadat Hasan Manto’s “Bombay Stories,” Anand Giridharadas’s “True American” and Amitava Kumar’s “Matter of Rats.”', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/blogs/bookreview/bookreview-articleLarge.jpg', 'height': 655, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/08/blogs/bookreview/bookreview-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 655}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/blogs/bookreview/bookreview-jumbo.jpg', 'height': 1024, 'width': 939, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/blogs/bookreview/bookreview-superJumbo.jpg', 'height': 1800, 'width': 1650, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/blogs/bookreview/bookreview-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/08/blogs/bookreview/bookreview-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/blogs/bookreview/bookreview-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Coming Up in the Book Review', 'kicker': 'Times Insider', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Boo, Katherine', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Dasgupta, Rana', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Deb, Siddhartha', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Faleiro, Sonia', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Giridharadas, Anand', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Guha, Ramachandra', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value'