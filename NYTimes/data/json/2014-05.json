major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Video Releases (Entertainment)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Cartoons and Cartoonists', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'DVD (Digital Versatile Disc)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Kaufman, Millard', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hubley, John', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Video Recordings, Downloads and Streaming', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-05-30T12:59:23+0000', 'document_type': 'article', 'news_desk': 'Arts&Leisure', 'section_name': 'Movies', 'subsection_name': 'DVD', 'byline': {'original': 'By J. Hoberman', 'person': [{'firstname': 'J.', 'middlename': None, 'lastname': 'Hoberman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6f34b7d9-e6d1-51a6-bdc0-7442947a4a69', 'word_count': 1332, 'uri': 'nyt://article/6f34b7d9-e6d1-51a6-bdc0-7442947a4a69'}, {'abstract': 'Talitha, a London-based collection embroidered by hand in India, offers chic statement pieces with exotic design influences.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/05/30/a-new-line-luxe-bohemian-wear-talitha/', 'snippet': 'Talitha, a London-based collection embroidered by hand in India, offers chic statement pieces with exotic design influences.', 'lead_paragraph': 'At a time when fashion moves at an ever-more-rapid speed, Talitha — a London-based label founded in 2013 by the fashion editor Kim Hersov and the textile entrepreneur Shon Randhawa — offers a welcome change of pace. With an emphasis on traditional Indian craftsmanship, exceptional fabrics and fuss-free silhouettes, it provides an elevated vision of bohemian chic. From kimono wrap jackets to hand-embroidered peasant blouses, butter-soft suede capes and block-printed tunics with tassel adornments, each piece is designed with longevity in mind.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/t-magazine/30talitha-rigg/30talitha-rigg-articleLarge.jpg', 'height': 343, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/30/t-magazine/30talitha-rigg/30talitha-rigg-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 343}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/t-magazine/30talitha-rigg/30talitha-rigg-jumbo.jpg', 'height': 585, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/t-magazine/30talitha-rigg/30talitha-rigg-superJumbo.jpg', 'height': 1170, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/t-magazine/30talitha-rigg/30talitha-rigg-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/30/t-magazine/30talitha-rigg/30talitha-rigg-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/t-magazine/30talitha-rigg/30talitha-rigg-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Luxe Bohemian Wear, Just in Time for Summer', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-05-30T13:00:12+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Natalie Rigg', 'person': [{'firstname': 'Natalie', 'middlename': None, 'lastname': 'Rigg', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0efe39b7-268c-551f-a74f-8e07ca18d84f', 'word_count': 301, 'uri': 'nyt://article/0efe39b7-268c-551f-a74f-8e07ca18d84f'}, {'abstract': 'Companies are beginning to use synthetic biology in producing cosmetics and household cleansers, but there is reluctance in how much to publicize it.', 'web_url': 'https://www.nytimes.com/2014/05/31/business/biofuel-tools-applied-to-household-soaps.html', 'snippet': 'Companies are beginning to use synthetic biology in producing cosmetics and household cleansers, but there is reluctance in how much to publicize it.', 'lead_paragraph': 'Consumer products containing ingredients made using an advanced form of engineering known as synthetic biology are beginning to show up more often on grocery and department store shelves.', 'print_section': 'B', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/business/31soap-pic2/31soap-pic2-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/31/business/31soap-pic2/31soap-pic2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/business/31soap-pic2/31soap-pic2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/business/31soap-pic2/31soap-pic2-superJ