onator-pog-thestone/opinionator-pog-thestone-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 600}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-thestone/opinionator-pog-thestone-jumbo.png', 'height': 1000, 'width': 1000, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-thestone/opinionator-pog-thestone-superJumbo.png', 'height': 1000, 'width': 1000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-thestone/opinionator-pog-thestone-thumbStandard-v2.png', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/04/25/opinion/opinionator-pog-thestone/opinionator-pog-thestone-thumbStandard-v2.png', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/04/25/opinion/opinionator-pog-thestone/opinionator-pog-thestone-thumbLarge-v2.png', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Life Beyond ‘Do What You Love’', 'kicker': 'The Stone', 'content_kicker': None, 'print_headline': 'A Life Beyond ‘Do What You Love’', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Careers and Professions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Education', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Labor and Jobs', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-17T18:30:19+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Gordon Marino', 'person': [{'firstname': 'Gordon', 'middlename': None, 'lastname': 'Marino', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/337d0ed7-9489-525f-aa8c-cbca4ca199d4', 'word_count': 1093, 'uri': 'nyt://article/337d0ed7-9489-525f-aa8c-cbca4ca199d4'}, {'abstract': 'Congress seems frightened of the political fallout that would come from making much-needed cuts in the defense budget.', 'web_url': 'https://www.nytimes.com/2014/05/18/opinion/sunday/the-house-ducks-on-defense.html', 'snippet': 'Congress seems frightened of the political fallout that would come from making much-needed cuts in the defense budget.', 'lead_paragraph': 'The Pentagon has for too long been in denial about the changes it will have to make in a world of declining resources, skyrocketing personnel costs and changing global threats. This year, however, Defense Secretary Chuck Hagel presented a more realistic, though still insufficient, cost-saving budget. Yet Congress seems firmly stuck in the past, loyal to campaign donors and frightened, as always, about local political fallout from closing excess military bases, modifying military compensation, reducing troop levels and cutting nonessential or older weapons.', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'The House Ducks on Defense', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'The House Ducks on Defense', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Defense Department', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Federal Budget (US)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Defense and Military Forces', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Hagel, Chuck', 'rank': 5, '