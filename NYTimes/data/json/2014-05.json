None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/c563faef-7770-5276-9545-6fbc4a8d822a', 'word_count': 0, 'uri': 'nyt://video/c563faef-7770-5276-9545-6fbc4a8d822a'}, {'abstract': 'The recently redesigned app from the Central Park Conservancy, the nonprofit that runs the park, is more informational than functional, full of historical trivia about the park’s many attractions.', 'web_url': 'https://www.nytimes.com/2014/05/25/nyregion/finding-central-parks-hidden-gems.html', 'snippet': 'The recently redesigned app from the Central Park Conservancy, the nonprofit that runs the park, is more informational than functional, full of historical trivia about the park’s many attractions.', 'lead_paragraph': 'I’ve been visiting Central Park regularly since I moved to New York three years ago, but I remain a total novice when it comes to navigating within it. I’ve only intermittently been able to find a beautiful fountain I once stumbled upon, and I was hoping that the recently redesigned app from the Central Park Conservancy, the nonprofit group that runs the park, could help.', 'print_section': 'MB', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/nyregion/25APPCITY/25APPCITY-articleLarge-v2.jpg', 'height': 592, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/25/nyregion/25APPCITY/25APPCITY-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 592}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/nyregion/25APPCITY/25APPCITY-jumbo-v2.jpg', 'height': 1010, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/25/nyregi