turday.', 'print_section': 'B', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/sports/yPREAKNESS/yPREAKNESS-articleLarge.jpg', 'height': 613, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/15/sports/yPREAKNESS/yPREAKNESS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 613}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/sports/yPREAKNESS/yPREAKNESS-jumbo.jpg', 'height': 1024, 'width': 1002, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/sports/yPREAKNESS/yPREAKNESS-superJumbo.jpg', 'height': 2015, 'width': 1971, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/sports/yPREAKNESS/yPREAKNESS-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/15/sports/yPREAKNESS/yPREAKNESS-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/sports/yPREAKNESS/yPREAKNESS-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Derby Victor a Heavy, and Heavier, Preakness Favorite', 'kicker': None, 'content_kicker': None, 'print_headline': 'Derby Champion a Heavier Favorite', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Horse Racing', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Triple Crown (Horse Racing)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Preakness Stakes', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Kentucky Derby', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'California Chrome (Race Horse)', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Coburn, Steve', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Martin, Perry', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Sherman, Art', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-05-15T01:07:24+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Joe Drape', 'person': [{'firstname': 'Joe', 'middlename': None, 'lastname': 'Drape', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e58e6540-e086-560d-a5cd-daf7680c1498', 'word_count': 642, 'uri': 'nyt://article/e58e6540-e086-560d-a5cd-daf7680c1498'}, {'abstract': 'The Pentagon needs to address its unfounded prohibition on transgender people.', 'web_url': 'https://www.nytimes.com/2014/05/15/opinion/discrimination-in-the-military.html', 'snippet': 'The Pentagon needs to address its unfounded prohibition on transgender people.', 'lead_paragraph': 'Three years after the demise of “don’t ask, don’t tell,” an estimated 15,000 members of the military still must lie about themselves in order to go on risking their lives for their country. When Congress eliminated the law against gay men and lesbians serving openly in the military, the Pentagon left in place an equally unfounded prohibition on transgender people.', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Discrimination in the Military', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Discrimination in the Military', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Transgender and Transsexual', 'rank': 1, 'major':