'}, {'name': 'subject', 'value': 'AIRLINES AND AIRPLANES', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'AIRPORTS', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'London (England)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-03T16:32:47+0000', 'document_type': 'article', 'news_desk': 'SundayBusiness', 'section_name': 'Business Day', 'byline': {'original': 'By Anna Bernasek', 'person': [{'firstname': 'Anna', 'middlename': None, 'lastname': 'Bernasek', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e4d38046-a07a-5453-bd21-d8aaf92802c8', 'word_count': 336, 'uri': 'nyt://article/e4d38046-a07a-5453-bd21-d8aaf92802c8'}, {'abstract': 'Cycling in New York City is better than it has ever been.', 'web_url': 'https://www.nytimes.com/2014/05/04/opinion/sunday/learning-to-love-bikers.html', 'snippet': 'Cycling in New York City is better than it has ever been.', 'lead_paragraph': 'THIRTY-TWO THOUSAND bicyclists are expected to ride in the annual Five Boro Bike Tour in New York City this morning. About half the registrants are from out of state and won’t be familiar with riding in the city. They’ll be getting their dose of it on its best day, when cyclists seize thoroughfares like Avenue of the Americas and the Belt Parkway from quotidian traffic terrors like the garbage truck and the wide-turning bus.', 'print_section': 'SR', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Learning to Love Bikers', 'kicker': 'Dispatch', 'content_kicker': None, 'print_headline': 'Learning to Love Bikers', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'New York City', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weber, Bruce', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Bicycles and Bicycling', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-03T16:37:13+000