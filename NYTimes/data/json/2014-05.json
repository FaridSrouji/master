: [{'name': 'persons', 'value': 'Pollack, Andrew', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Prostate Cancer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Tests (Medical)', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-15T01:02:09+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Andrew Pollack', 'person': [{'firstname': 'Andrew', 'middlename': None, 'lastname': 'Pollack', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/5c517bc1-ee8e-52e1-88cd-58cb6bc43479', 'word_count': 752, 'uri': 'nyt://article/5c517bc1-ee8e-52e1-88cd-58cb6bc43479'}, {'abstract': 'Extreme racial disparities in the arrest statistics for low-level possession make it imperative that the city take a closer look.', 'web_url': 'https://www.nytimes.com/2014/05/15/opinion/no-slowdown-in-unfair-marijuana-arrests.html', 'snippet': 'Extreme racial disparities in the arrest statistics for low-level possession make it imperative that the city take a closer look.', 'lead_paragraph': 'When Mayor Bill de Blasio took office in January, community groups and juvenile justice advocates hoped that his administration would significantly decrease the numbers of black and Latino young people who are unfairly — and in some cases, illegally — arrested and dragged through the court system for possession of tiny amounts of marijuana. But a new analysis of state arrest data by a nonprofit called the Marijuana Arrest Research Project, which studies police policy, suggests that the de Blasio administration is on track to equal the more than 28,600 low-level marijuana arrests that were made under Michael Bloomberg in 2013. The administration needs to review Police Department policy to make sure these arrests are necessary and being fairly made. ', 'print_section': 'A', 'print_page': '28', 'source': 'The New York Times', '