None, 'lastname': 'Traister', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/fbffe104-44d2-5e7d-b62b-c1ed819f142d', 'word_count': 706, 'uri': 'nyt://article/fbffe104-44d2-5e7d-b62b-c1ed819f142d'}, {'abstract': 'Shares of France’s largest bank end down 2.4 percent over concerns that potential huge penalties exacted by authorities in the United States could undermine the bank’s capital strength.', 'web_url': 'https://dealbook.nytimes.com/2014/05/30/bnp-paribas-shares-fall-on-fine-fears/', 'snippet': 'Shares of France’s largest bank end down 2.4 percent over concerns that potential huge penalties exacted by authorities in the United States could undermine the bank’s capital strength.', 'lead_paragraph': 'Updated, 12:32 p.m. | ', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'BNP Paribas Shares Fall on Fine Fears', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Embargoes and Sanctions', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Fines (Penalties)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Regulation and Deregulation of Industry', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'BNP Paribas', 'rank': 5, 'major': 'N'}, {'name': 'organizations', 'value': 'Justice Department', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-30T14:53:37+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Dealbook', 'person': [{'firstname': 'Dealbook', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/895d3fc9-ab2c-5575-b6e0-7d0b29e1f8f2', 'word_count': 411, 'uri': 'nyt://article/895d3fc9-ab2c-5575-b6e0-7d0b29e1f8f2'}, {'abstract': 'Tom Zoellner sets off on a series of railway adventures in an attempt to recapture the power and poetry of train travel.', 'web_url': 'https://www.nytimes.com/2014/06/01/books/review/tom-zoellners-train.html', 'snippet': 'Tom Zoellner sets off on a series of railway adventures in an attempt to recapture the power and poetry of train travel.', 'lead_paragraph': 'In an era of railway mediocrity, epitomized by Amtrak, it’s easy to forget that train travel was once a romantic adventure. Riding the rails to Boston in 1924, George Gershwin listened to the roar of the steam engine and the turn of the wheels and found the inspiration for “Rhapsody in Blue,” his hymn to urbanizing, Jazz Age America. “It was on the train, with its steely rhythms, its rattle-ty bang, that is so often so stimulating to a composer,” he told a biographer, describing the moment of creation. “I frequently hear music in the very heart of the noise.” W. C. Handy and other African-American musicians heard a similar sound on the Illinois Central, the Midwestern line that spirited them away from the Deep South on the Great Migration that began during World War I. They married the whistle and drone of the locomotive to the plaintive chants of sharecroppers and invented the “city blues.” Steve Goodman, a little-known composer, was inspired by a \xadjourney on the same line to write a dirge that became one of the anthems of the Vietnam War era — “The City of New \xadOrleans.”', 'print_section': 'BR', 'print_page': '54', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01HAMMER/01HAMMER-articleLarge-v2.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/01/books/review/01HAMMER/01HAMMER-articleLarge-v2.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01HAMMER/01HAMMER-jumbo-v2.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01HAMMER/01HAMMER-superJumbo-v2.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01HAMMER/01HAMMER-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/01/books/review/01HAMMER/01HAMMER-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01HAMMER/01HAMMER-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Journey by Rail', 'kicker': None, 'content_kicker': None, 'print_headline': 'Journey by Rail', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Hammer, Joshua', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Zoellner, Tom', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Railroads', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-30T14:53:43+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Joshua Hammer', 'person': [{'firstname': 'Joshua', 'middlename': None, 'lastname': 'Hammer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/bb68fe1b-8358-54ca-8aa0-59a00565a14f', 'word_count': 1244, 'uri': 'nyt://article/bb68fe1b-8358-54ca-8aa0-59a00565a14f'}, {'abstract': 'A collection of Christopher Buckley’s work includes historical spoofs, riffs about family life and literary criticism.', 'web_url': 'https://www.nytimes.com/2014/06/01/books/review/but-enough-about-you-by-christopher-buckley.html', 'snippet': 'A collection of Christopher Buckley’s work includes historical spoofs, riffs about family life and literary criticism.', 'lead_paragraph': 'Christopher Buckley begins his new collection, “But Enough About You,” with an essay about the perils of being known as a humorist, the fear that people brand him as “trivial” and believe that what he and his literary forebears do is easy. “Well, only five paragraphs in and already wallowing in self-pity,” he writes. “We just can’t get no respect.” ', 'print_section': 'BR', 'print_page': '55', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Not Just Laughs', 'kicker': None, 'content_kicker': None, 'print_headline': 'Not Just Laughs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Buckley, Christopher', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-30T14:53:53+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Meryl Gordon', 'person': [{'firstname': 'Meryl', 'middlename': None, 'lastname': 'Gordon', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9a3d9d6a-b2b5-50e7-9b14-6eb84ad9a4bf', 'word_count': 641, 'uri': 'nyt://article/9a3d9d6a-b2b5-50e7-9b14-6eb84ad9a4bf'}, {'abstract': 'Britain’s ambassador to Cuba has appealed to soccer fans in that country to support England in the World Cup.', 'web_url': 'https://www.nytimes.com/2014/05/31/sports/soccer/countdown-to-2014-world-cup-in-brazil-day-13.html', 'snippet': 'Britain’s ambassador to Cuba has appealed to soccer fans in that country to support England in the World Cup.', 'lead_paragraph': 'The 2014 World Cup begins on June 12, when Brazil plays Croatia in the opening match. Reporters and editors for The Times will count down to the start of the tournament each day with a short capsule of news and interesting tidbits.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/sports/soccer/31brazil13a/31brazil13a-articleLarge.jpg', 'height': 417, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/31/sports/soccer/31brazil13a/31brazil13a-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 417}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/sports/soccer/31brazil13a/31brazil13a-jumbo.jpg', 'height': 712, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/sports/soccer/31brazil13a/31brazil13a-superJumbo.jpg', 'height': 1424, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/sports/soccer/31brazil13a/31brazil13a-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/31/sports/soccer/31brazil13a/31brazil13a-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/31/sports/soccer/31brazil13a/31brazil13a-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Countdown to 2014 World Cup in Brazil: Day 13', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'World Cup 2014 (Soccer)', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Cuba', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Soccer', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Cole, Timothy', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-30T14:55:11+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Soccer', 'byline': {'original': 'By Jack Bell', 'person': [{'firstname': 'Jack', 'middlename': None, 'lastname': 'Bell', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0b9f13b7-548e-5bb9-98fb-0509e144b9de', 'word_count': 594, 'uri': 'nyt://article/0b9f13b7-548e-5bb9-98fb-0509e144b9de'}, {'abstract': 'Daniel Schulman, whose biography of the politically influential Koch brothers is No. 17 on the extended hardcover nonfiction list, says, “I think it’s important, historically, to know who they are.”', 'web_url': 'https://www.nytimes.com/2014/06/08/books/review/inside-the-list.html', 'snippet': 'Daniel Schulman, whose biography of the politically influential Koch brothers is No. 17 on the extended hardcover nonfiction list, says, “I think it’s important, historically, to know who they are.”', 'lead_paragraph': 'Hemingway on the Stoop: Near the beginning of “Sons of Wichita,” his biography of the politically influential Koch brothers — it’s No. 17 on the extended hardcover nonfiction list — Daniel Schulman describes the conservative beliefs of the family patriarch, the industrialist Fred Koch. “Father was paranoid about Communism, let’s put it that way,” his son David Koch once told New York magazine, in a quote Schulman cites. Fred’s views filtered down to at least one of his four sons: Charles, the second-oldest and now the chief executive of Koch Industries, spent most of a blind date in the early 1960s railing against the evils of Communism, according to the biography. (“I ended up leaving early and walking home,” his date says.) Charles also let his politics spill over into literary criticism. Schulman, a senior editor at Mother Jones, reports that when a family friend showed up at the Koch house in the 1960s with a copy of “The Sun Also Rises,” Charles eyed the book apprehensively and finally asked the visitor to leave it outside.', 'print_section': 'BR', 'print_page': '34', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01list-img/01list-img-jumbo.jpg', 'height': 450, 'width': 457, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01list-img/01list-img-superJumbo.jpg', 'height': 450, 'width': 457, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01list-img/01list-img-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/01/books/review/01list-img/01list-img-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01list-img/01list-img-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-05-30T14:56:21+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4cce90d7-6051-5fa8-902d-7aa99a2ac29f', 'word_count': 481, 'uri': 'nyt://article/4cce90d7-6051-5fa8-902d-7aa99a2ac29f'}, {'abstract': 'In Mona Simpson’s sixth novel, a young boy’s spying yields knowledge about the precarious state of his family.', 'web_url': 'https://www.nytimes.com/2014/06/01/books/review/casebook-by-mona-simpson.html', 'snippet': 'In Mona Simpson’s sixth novel, a young boy’s spying yields knowledge about the precarious state of his family.', 'lead_paragraph': 'The word “spying” now brings to mind boundless digital nets trawling the ether for millions of emails at a time, but Miles Adler-Hart, the young protagonist of Mona Simpson’s sixth novel, practices snooping the old-school way. He plants a walkie-talkie in his parents’ bedroom. He eavesdrops on therapy sessions through a heating vent. He listens to phone conversations by carefully picking up a landline in the next room.', 'print_section': 'BR', 'print_page': '42', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/books/review/01williams/01williams-articleLarge.jpg', 'height': 647, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/01/books/review/01wil