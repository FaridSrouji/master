', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6f1e44b3-f48b-5570-aada-c6501643fd5a', 'word_count': 541, 'uri': 'nyt://article/6f1e44b3-f48b-5570-aada-c6501643fd5a'}, {'abstract': 'At the Obama administration’s request, House leaders revised a bill that limits the government’s bulk collection of phone records, spurring several civil liberties groups to withdraw support for the bill.', 'web_url': 'https://www.nytimes.com/2014/05/21/us/politics/changes-to-surveillance-bill-stoke-anger.html', 'snippet': 'At the Obama administration’s request, House leaders revised a bill that limits the government’s bulk collection of phone records, spurring several civil liberties groups to withdraw support for the bill.', 'lead_paragraph': 'WASHINGTON — Leaders of both parties in the House of Representatives, at the Obama administration’s request, have changed a surveillance overhaul bill that restricts the power of the government to obtain Americans’ records in bulk.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Changes to Surveillance Bill Stoke Anger', 'kicker': None, 'content_kicker': None, 'print_headline': 'Changes to Surveillance Bill Stoke Anger', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Savage, Charlie', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Agency', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Surveillance of Citizens by Government', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'United States Politics and Government', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Law and Legislation', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'USA PATRIOT Act', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-21T01:17:43+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Charlie Savage', 'person': [{'firstname': 'Charlie', 'middlename': None, 'lastname': 'Savage', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3b733050-ca43-57bc-a77e-445731d83af6', 'word_count': 757, 'uri': 'nyt://article/3b733050-ca43-57bc-a77e-445731d83af6'}, {'abstract': 'The testimony seemed to run contrary to Gov. Chris Christie’s statements in the lane-closing scandal that Mayor Mark Sokolich had never been on his “radar screen.”', 'web_url': 'https://www.nytimes.com/2014/05/21/nyregion/ex-aide-tells-of-tabs-kept-on-mayor-of-fort-lee.html', 'snippet': 'The testimony seemed to run contrary to Gov. Chris Christie’s statements in the lane-closing scandal that Mayor Mark Sokolich had never been on his “radar screen.”', 'lead_paragraph': 'TRENTON — The administration of Gov. Chris Christie worked to cultivate Fort Lee’s mayor for at least a year and a half before lanes were closed at the George Washington Bridge in an act of political retribution, according to testimony from a former aide to the governor on Tuesday.', 'print_section': 'A', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/21/nyregion/CHRISTIE-promo/CHRISTIE-articleLarge.jpg', 'height': 472, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/21/nyregion/CHRISTIE-promo/CHRISTIE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 472}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/21/nyregion/CHRISTIE-promo/CHRISTIE-jumbo.jpg', 'height': 806, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/21/nyregion/