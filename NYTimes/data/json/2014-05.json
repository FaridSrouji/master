o', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/t-magazine/11travel-edletter/11travel-edletter-superJumbo.jpg', 'height': 1322, 'width': 1763, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/t-magazine/11travel-edletter/11travel-edletter-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/11/t-magazine/11travel-edletter/11travel-edletter-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/t-magazine/11travel-edletter/11travel-edletter-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Simple Pleasures', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Travel and Vacations', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-05-09T23:00:16+0000', 'document_type': 'article', 'news_desk': 'TStyle', 'section_name': 'T Magazine', 'byline': {'original': 'By Deborah Needleman', 'person': [{'firstname': 'Deborah', 'middlename': None, 'lastname': 'Needleman', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/3b467d34-3185-52d1-92dd-57d5ae85f1d3', 'word_count': 364, 'uri': 'nyt://article/3b467d34-3185-52d1-92dd-57d5ae85f1d3'}, {'abstract': 'Making its first trip to the United States more than four centuries after its creation, Parmigianino’s renowned, beguiling portrait of a turbaned woman will go on view Tuesday.', 'web_url': 'https://www.nytimes.com/2014/05/11/arts/design/who-is-that-lady-in-the-painting.html', 'snippet': 'Making its first trip to the United States more than four centuries after its creation, Parmigianino’s renowned, beguiling portrait of a turbaned woman will go on view Tuesday.', 'lead_paragraph': 'Making its first trip to the United States more than four centuries after its creation, Parmigianino’s renowned, beguiling portrait of a turbaned woman — known since the early 18th century as “Schiava Turca,” or the Turkish slave, from 1531-34 — will go on view Tuesday at the Frick Collection, bringing along the question that has long trailed it: Who was she? Almost certainly neither Turkish nor a slave, an identification that came about in error because of her exotic costume. Some have wondered whether the woman was real at all or maybe just a feminine ideal dreamed up by the painter. But Aimee Ng, a research associate at the Frick and the show’s curator, has a new theory based on subtle clues in the portrait: that she might have been Veronica Gambara, an accomplished poet in Parmigianino’s circle.', 'print_section': 'AR', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/arts/11GUIDE4/11GUIDE4-articleLarge.jpg', 'height': 770, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/11/arts/11GUIDE4/11GUIDE4-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 770}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/arts/11GUIDE4/11GUIDE4-jumbo.jpg', 'height': 1024, 'width': 799, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/arts/11GUIDE4/11GUIDE4-superJumbo.jpg', 'height': 2048, 'width': 1597, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {