/sports/SUB-yankees2/SUB-yankees2-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/SUB-yankees2/SUB-yankees2-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/SUB-yankees2/SUB-yankees2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/13/sports/SUB-yankees2/SUB-yankees2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/SUB-yankees2/SUB-yankees2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Queens Bombers Rally to Beat the Yankees', 'kicker': 'Mets 9, Yankees 7', 'content_kicker': None, 'print_headline': 'Queens Bombers Rally to Beat the Yankees', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Waldstein, David', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Granderson, Curtis', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Beltran, Carlos', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Colon, Bartolo', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Kuroda, Hiroki', 'rank': 8, 'major': 'N'}], 'pub_date': '2014-05-13T04:27:41+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By David Waldstein', 'person': [{'firstname': 'David', 'middlename': None, 'lastname': 'Waldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/9a036611-6288-54e9-849e-6746454792ec', 'word_count': 912, 'uri': 'nyt://article/9a036611-6288-54e9-849e-6746454792ec'}, {'abstract': 'Mr. Christie inherited the Glyndebourne Opera Festival and squired it to modern international renown, broadening its audience and building a new opera house.', 'web_url': 'https://www.nytimes.com/2014/05/13/arts/design/george-christie-dies-at-79-steward-of-his-familys-glyndebourne-legacy.html', 'snippet': 'Mr. Christie inherited the Glyndebourne Opera Festival and squired it to modern international renown, broadening its audience and building a new opera house.', 'lead_paragraph': 'It is a truth universally acknowledged that a married man in possession of a good fortune, boundless determination and a wife who is a singer must be in want of an opera house.', 'print_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/arts/CHRISTIE-1-obit/CHRISTIE-1-obit-articleLarge.jpg', 'height': 913, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/15/arts/CHRISTIE-1-obit/CHRISTIE-1-obit-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 913}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/arts/CHRISTIE-1-obit/CHRISTIE-1-obit-jumbo.jpg', 'height': 1024, 'width': 674, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/arts/CHRISTIE-1-obit/CHRISTIE-1-obit-superJumbo.jpg', 'height': 2048, 'width': 1347, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/arts/CHRISTIE-1-obit/CHRISTIE-1-obit-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/15/arts/CHRISTIE-1-obit/CHRISTIE-1-obit-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/15/arts/CHRISTIE-1-obit/CHRISTIE-1-obit-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'George Christie Dies at 79; Steward of His Family’s Opera Legacy', 'kicker': None, 'content_kicker': None, 'print_headline': 'George Christie of Glyndebourne, Steward of Opera Legacy, Dies at 79', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Fox, Margalit', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Christie, George', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Glyndebourne Festival', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Deaths (Obituaries)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-13T04:28:59+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Art & Design', 'byline': {'original': 'By Margalit Fox', 'person': [{'firstname': 'Margalit', 'middlename': None, 'lastname': 'Fox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Obituary (Obit)', '_id': 'nyt://article/a07ad035-954e-5472-8675-2139019a7bfa', 'word_count': 1256, 'uri': 'nyt://article/a07ad035-954e-5472-8675-2139019a7bfa'}, {'abstract': 'The struggling outfielder Curtis Granderson hit a timely home run to help the Mets beat his old team in the series opener at Yankee Stadium.', 'web_url': 'https://www.nytimes.com/2014/05/13/sports/baseball/struggling-granderson-has-his-say-for-a-night.html', 'snippet': 'The struggling outfielder Curtis Granderson hit a timely home run to help the Mets beat his old team in the series opener at Yankee Stadium.', 'lead_paragraph': 'Curtis Granderson stepped into the batter’s box for the Mets in the sixth inning Monday, to a mixture of boos and polite applause from the Yankee Stadium crowd. He drew a 3-0 count, leaned over the plate and calmly sent a Hiroki Kuroda sinker into the right-field seats for a two-run homer. It was a familiar sight, Granderson rounding the bases here in his usual trot. ', 'print_section': 'B', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/granderson/granderson-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/13/sports/granderson/granderson-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/granderson/granderson-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/granderson/granderson-superJumbo.jpg', 'height': 1267, 'width': 1901, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/granderson/granderson-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/13/sports/granderson/granderson-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/sports/granderson/granderson-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Struggling Granderson Has His Say for a Night', 'kicker': None, 'content_kicker': None, 'print_headline': 'Struggling Granderson Has His Say for a Night', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Granderson, Curtis', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Free Agents (Sports)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-13T04:32:27+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Tim Rohan', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'Rohan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/26e05940-2be1-5ff8-a2b9-98cbe45b4a68', 'word_count': 747, 'uri': 'nyt://article/26e05940-2be1-5ff8-a2b9-98cbe45b4a68'}, {'abstract': 'President José Mujica’s visit to the White House came as the South American country seeks new markets for its commodities exports.', 'web_url': 'https://www.nytimes.com/2014/05/13/world/americas/uruguayan-leader-meets-with-obama-to-talk-trade-and-human-rights.html', 'snippet': 'President José Mujica’s visit to the White House came as the South American country seeks new markets for its commodities exports.', 'lead_paragraph': 'URUGUAY — President José Mujica of Uruguay met with President Obama in Washington on Monday, pointing to the strengthening ties between the United States and the South American nation, which is advancing an array of socially liberal legislation, including the legalization of same-sex marriage and abortion. True to his laid-back style, Mr. Mujica, a 78-year-old former guerrilla who has farmed chrysanthemums for a living, did not wear a tie to the White House. The leaders discussed opportunities to expand trade as Uruguay, a small ranching nation of 3.3 million people, seeks new markets for its commodities exports. Mr. Obama also referred to the influence of Mr. Mujica in connection to human rights issues in Latin America. Curiously, the two leaders did not publicly refer to Uruguay’s pioneering legalization of marijuana, a sweeping measure that went into effect last week. Focusing on common ground between Uruguay and the United States, Mr. Mujica, a former livestock minister, said, “I embrace all agriculturalists of this nation.”', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Uruguayan Leader Meets With Obama to Talk Trade and Human Rights', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Mujica, Jose', 'rank': 1, 'major': 'N'}, {'name': 'glocations', 'value': 'Uruguay', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Obama, Barack', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'International Trade and World Market', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-13T04:42:25+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Americas', 'byline': {'original': 'By Simon Romero', 'person': [{'firstname': 'Simon', 'middlename': None, 'lastname': 'Romero', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d58d9af9-ae02-5418-ad69-cec333fd459a', 'word_count': 161, 'uri': 'n