rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Supreme Courts (State)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Hudson, Robin', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Hudson, Robin E', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-05-05T20:53:16+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Erik Eckholm', 'person': [{'firstname': 'Erik', 'middlename': None, 'lastname': 'Eckholm', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/29687620-7501-58f9-8a99-874c6c16d96c', 'word_count': 1172, 'uri': 'nyt://article/29687620-7501-58f9-8a99-874c6c16d96c'}, {'abstract': 'The chic children’s wear retailer toasts its new New York flagship with a limited-edition collection — and an Aurélie Bidermann-designed bracelet that both kids and adults can wear.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/05/05/in-store-bonpoint-soho-libery-aurelie-bidermann-charity/', 'snippet': 'The chic children’s wear retailer toasts its new New York flagship with a limited-edition collection — and an Aurélie Bidermann-designed bracelet that both kids and adults can wear.', 'lead_paragraph': 'Bonpoint, the Paris-based purveyor of chic children’s wear, will debut a new flagship store in New York’s SoHo tomorrow. In celebration of the opening, the brand’s creative director Christine Innamorato has designed a special “SoHo 2014″ capsule collection, which includes Liberty-print dresses — the designs for 12 of which were sourced from the Bonpoint archive — and bags, brooches, swimsuits, as well as soaps and candles that come packaged inside Liberty-print bags. And as an added incentive for the parents of chic tykes, Innamorato teamed up with the jewelry designer Aurélie Bidermann to create a limited-edition 18-karat gold and lacquer bracelet, featuring Bonpoint’s signature cherry logo, that adjusts to fit both children and adults. A portion of the profits from sales of the bracelet and capsule items will be donated to New Yorkers for Children.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05bonpoint-bobb/05bonpoint-bobb-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/05/t-magazine/05bonpoint-bobb/05bonpoint-bobb-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05bonpoint-bobb/05bonpoint-bobb-jumbo.jpg', 'height': 682, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05bonpoint-bobb/05bonpoint-bobb-superJumbo.jpg', 'height': 1333, 'width': 2000, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05bonpoint-bobb/05bonpoint-bobb-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/05/t-magazine/05bonpoint-bobb/05bonpoint-bobb-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05bonpoint-bobb/05bonpoint-bobb-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Store | Bonpoint Arrives in SoHo With a Capsule and a Collaboration', 'kicker': 'T Magazine', 'content_kicker': None, 'print_headline': '