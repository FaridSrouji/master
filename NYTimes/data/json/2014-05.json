14/05/11/books/review/0511-bks--Short/0511-bks--Short-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks--Short/0511-bks--Short-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Memoirs', 'kicker': 'The Shortlist', 'content_kicker': None, 'print_headline': 'Memoirs', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Ruta, Domenica', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'creative_works', 'value': 'Exodus: A Memoir (Book)', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Stadiem, William', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Dokoupil, Tony', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Feldman, Deborah', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Lansky, Sandra', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-05-09T15:55:13+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Domenica Ruta', 'person': [{'firstname': 'Domenica', 'middlename': None, 'lastname': 'Ruta', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b28e2920-7860-5924-815f-5b24eec22a54', 'word_count': 1099, 'uri': 'nyt://article/b28e2920-7860-5924-815f-5b24eec22a54'}, {'abstract': 'A novel recounts a parent’s descent into mental illness.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/nothing-holds-back-the-night-by-delphine-de-vigan.html', 'snippet': 'A novel recounts a parent’s descent into mental illness.', 'lead_paragraph': 'In her wrenching new book, a memoir camouflaged as a novel, the prominent French writer Delphine de Vigan sets out to “write my mother,” tracing the life of the woman she calls Lucile Poirier from her early childhood just after World War II to her suicide in 2008 at the age of 61. Woven into this dark tale is the equally absorbing story of a daughter’s quest to research and imagine an elusive woman in order to get close to her, even though her very essence embodied distance: “For all of us, Lucile — her gentleness and her aggression — remains a mystery.” The difficulty de Vigan has in describing her mother, she confesses, “is not so far removed from the distress we felt as children and teenagers when she disappeared.” Which she did, dramatically, in a series of manic episodes, beginning in her early 30s.', 'print_section': 'BR', 'print_page': '31', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11LKLINE/11LKLINE-articleLarge.jpg', 'height': 1034, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/11/books/review/11LKLINE/11LKLINE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 1034}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11LKLINE/11LKLINE-jumbo.jpg', 'height': 1024, 'width': 595, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11LKLINE/11LKLINE-superJumbo.jpg', 'height': 1198, 'width': 695, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11LKLINE/11LKLINE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/11/books/review/11LKLINE/11LKLINE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11LKLINE/11LKLINE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Mother in Absentia', 'kicker': None, 'content_kicker': None, 'print_headline': 'A Mother in Absentia', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'de Vigan, Delphine', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T15:55:27+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Nancy Kline', 'person': [{'firstname': 'Nancy', 'middlename': None, 'lastname': 'Kline', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/0f7a2a01-fac0-569f-9982-89ad79c268c3', 'word_count': 612, 'uri': 'nyt://article/0f7a2a01-fac0-569f-9982-89ad79c268c3'}, {'abstract': 'Greg Iles, whose thriller “Natchez Burning” enters the hardcover fiction list at No. 2, reworked the novel after a car crash that left him in a coma for eight days.', 'web_url': 'https://www.nytimes.com/2014/05/18/books/review/inside-the-list.html', 'snippet': 'Greg Iles, whose thriller “Natchez Burning” enters the hardcover fiction list at No. 2, reworked the novel after a car crash that left him in a coma for eight days.', 'lead_paragraph': 'Life’s Too Short: Greg Iles’s thriller “Natchez Burning,” about racism and murder in the Jim Crow South, is his first new novel in five years. That’s a long time between books for a writer whose previous best sellers arrived as regularly as the Olympics, every two years or so. But Iles has a good excuse. In 2011, when he was putting the finishing touches on an earlier version of “Natchez Burning,” he was in a car crash that tore his aorta, left him in a coma for eight days and resulted in the loss of his right leg below the knee. The accident, along with the death of his father a year earlier, inspired him to have another go at his novel. “I realized that life was too short to pull any punches,” Iles told The Greenville News in South Carolina earlier this month. “I decided there was no room in this book for formula and fluff. The story had to be handled with appropriate gravitas. I had to deal with it not only the way it deserved but in a way that would make my father proud.” The reworked “Natchez Burning” — which enters the hardcover fiction list at No. 2 — clocks in at almost 800 pages, and is the first of a planned trilogy. Among other things, it explores the role of social elites in allowing racism to thrive. “The white lower middle class and lower class did not commit those acts of violence in a vacuum,” Iles told The Greenville News. “They had been given tacit approval by the upper levels of white society.” Nor, he said, is such racism restricted to the past. “Look at the scandal over the comments by the Clippers’ owner,” he said, referring to Donald Sterling. “The legacy of slavery is the greatest psychic wound in the American character. We still haven’t fully dealt with it, and I think it’ll take another lifetime to deal with it.”', 'print_section': 'BR', 'print_page': '30', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11Iles/11Iles-jumbo.jpg', 'height': 262, 'width': 271, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11Iles/11Iles-superJumbo.jpg', 'height': 262, 'width': 271, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11Iles/11Iles-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/11/books/review/11Iles/11Iles-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/11Iles/11Iles-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Inside the List', 'kicker': None, 'content_kicker': None, 'print_headline': 'Inside the List', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}], 'pub_date': '2014-05-09T15:56:24+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Gregory Cowles', 'person': [{'firstname': 'Gregory', 'middlename': None, 'lastname': 'Cowles', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/51be714b-026c-59b5-8f0a-8cea2c32fcb1', 'word_count': 525, 'uri': 'nyt://article/51be714b-026c-59b5-8f0a-8cea2c32fcb1'}, {'abstract': 'Three picture books send children off on a journey through the four seasons.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/secrets-of-the-seasons-and-more.html', 'snippet': 'Three picture books send children off on a journey through the four seasons.', 'lead_paragraph': 'The seasons of the year tell a tale that resonates deep inside us. No matter where you start in the calendar, the passing of the seasons presents a beginning, middle and end that is hard-wired to our emotional metabolism. This applies equally to adults and children. A year is a drama in four acts. With a plot like that, you don’t even need a story.', 'print_section': 'BR', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Lithgow-2-sub/0511-bks-Lithgow-2-sub-articleLarge.jpg', 'height': 747, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/11/books/review/0511-bks-Lithgow-2-sub/0511-bks-Lithgow-2-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 747}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Lithgow-2-sub/0511-bks-Lithgow-2-sub-jumbo.jpg', 'height': 1024, 'width': 823, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Lithgow-2-sub/0511-bks-Lithgow-2-sub-superJumbo.jpg', 'height': 1202, 'width': 966, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Lithgow-2-sub/0511-bks-Lithgow-2-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/11/books/review/0511-bks-Lithgow-2-sub/0511-bks-Lithgow-2-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Lithgow-2-sub/0511-bks-Lithgow-2-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'All Year Round', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'All Year Round', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Sweet, Melissa', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Janeczko, Paul B', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Muth, Jon J', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Zoehfeld, Kathleen Weidner', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Lamont, Priscilla', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-05-09T15:56:56+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By John Lithgow', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Lithgow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3c0df97c-4d2f-578b-923a-16bff77c4771', 'word_count': 934, 'uri': 'nyt://article/3c0df97c-4d2f-578b-923a-16bff77c4771'}, {'abstract': 'Can “Betty Cornell’s Teen-Age Popularity Guide” get you through the eighth grade? Maya Van Wagenen gives it a try.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/maya-van-wagenens-popular.html', 'snippet': 'Can “Betty Cornell’s Teen-Age Popularity Guide” get you through the eighth grade? Maya Van Wagenen gives it a try.', 'lead_paragraph': 'When you’re in middle school, you’re a mess. It’s a world of boys with wispy mustaches and bro-tanks revealing an absence of armpit hair. They make comments like “Damn, that girl is sexy” in cracked voices stuck in the transition between too high and too deep. It’s even worse for girls. The moment they get to middle school they start putting on makeup, and they put it on wrong. Growth spurts make them tall and goofy; acne arrives along with a period they are not sure how to manage. At that exact moment, they develop a dream — more of an obsession, really: to be popular. This is when the pain begins.', 'print_section': 'BR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/Apatow/Apatow-articleLarge.jpg', 'height': 521, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/11/books/review/Apatow/Apatow-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 521}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/Apatow/Apatow-jumbo.jpg', 'height': 664, 'width': 764, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/Apatow/Apatow-superJumbo.jpg', 'height': 664, 'width': 764, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/Apatow/Apatow-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/11/books/review/Apatow/Apatow-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/Apatow/Apatow-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Grand Experiment', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Grand Experiment', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Van Wagenen, Maya', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-09T15:57:12+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Maude Apatow', 'person': [{'firstname': 'Maude', 'middlename': None, 'lastname': 'Apatow', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/51e6e823-6e80-5811-aeae-87cc2b07d489', 'word_count': 667, 'uri': 'nyt://article/51e6e823-6e80-5811-aeae-87cc2b07d489'}, {'abstract': 'Four teenagers enjoy summer on a private retreat until a mysterious accident changes everything.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/we-were-liars-by-e-lockhart.html', 'snippet': 'Four teenagers enjoy summer on a private retreat until a mysterious accident changes everything.', 'lead_paragraph': 'A patrician New England clan decamps to their private island off Martha’s Vineyard for the summer. Of the dozen or so Sinclair family members in residence, “No one is a criminal. No one is an addict. No one is a failure.” Three lies, the first of many, provide an irresistible premise for this ticking bomb of a novel by E. Lockhart.', 'print_section': 'BR', 'print_page': '17', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Fantasy Island', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Fantasy Island', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Lockhart, E', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T15:57:17+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Meg Rosoff', 'person': [{'firstname': 'Meg', 'middlename': None, 'lastname': 'Rosoff', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3f332c9a-72c0-51b0-b919-f06963e61252', 'word_count': 798, 'uri': 'nyt://article/3f332c9a-72c0-51b0-b919-f06963e61252'}, {'abstract': 'Last year 66 seniors shared their college application essays that addressed class and money, and four were published. Here’s where the four students are now.', 'web_url': 'https://www.nytimes.com/2014/05/10/your-money/an-update-on-the-4-students-whose-college-essays-were-featured.html', 'snippet': 'Last year 66 seniors shared their college application essays that addressed class and money, and four were published. Here’s where the four students are now.', 'lead_paragraph': 'In response to a request from Ron Lieber, the Your Money columnist, asking high school seniors to share their college application essays that covered the subjects of money, class, working or the economy, 66 students last year submitted their work. We picked four to run online. Here’s an update on the students we featured in the column last May.', 'print_section': 'B', 'print_page': '6', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/09/business/10updates-composite/10updates-composite-articleLarge.jpg', 'height': 356, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/09/business/10updates-composite/10updates-composite-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 356}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/09/business/10updates-composite/10updates-composite-jumbo.jpg', 'height': 400, 'width': 675, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/09/business/10updates-composite/10updates-composite-superJumbo.jpg', 'height': 400, 'width': 675, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/09/business/10updates-composite/10updates-composite-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/09/business/10updates-composite/10updates-composite-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/09/business/10updates-composite/10updates-composite-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'An Update on 4 Students After a College Year', 'kicker': None, 'content_kicker': None, 'print_headline': 'An Update on 4 Students After a College Year', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Colleges and Universities', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Personal Finances', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'ADMISSIONS STANDARDS', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-09T15:57:48+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Your Money', 'byline': {'original': 'By Ron Lieber', 'person': [{'firstname': 'Ron', 'middlename': None, 'lastname': 'Lieber', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/19efeaad-dfe2-588b-a2be-067f6376a16e', 'word_count': 551, 'uri': 'nyt://article/19efeaad-dfe2-588b-a2be-067f6376a16e'}, {'abstract': 'After a premature death, a teenager returns to life when his cryogenically frozen head is transplanted.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/noggin-by-john-corey-whaley.html', 'snippet': 'After a premature death, a teenager returns to life when his cryogenically frozen head is transplanted.', 'lead_paragraph': 'As far as I can recall — and it’s been a while — being a teenager is confusing. You have to wrestle with all sorts of \xadissues related to your identity, and the biggest struggle is simply feeling comfortable in your skin. That’s why the premise of John Corey Whaley’s young adult novel “Noggin” — outlandish as it is — has such wonderful resonance. It takes the idea of being alienated from your own body and makes it literal.', 'print_section': 'BR', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Out-of-Body Experience', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Out-of-Body Experience', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Jacobs, A J', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Whaley, John Corey', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T15:58:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By A. J. Jacobs', 'person': [{'firstname': 'A.', 'middlename': 'J.', 'lastname': 'Jacobs', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/c9f3d61c-1fec-5e2d-b360-00c9df4c5972', 'word_count': 747, 'uri': 'nyt://article/c9f3d61c-1fec-5e2d-b360-00c9df4c5972'}, {'abstract': 'Basketball-playing twins find challenges to their relationship on and off the court in Kwame Alexander’s verse novel.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/the-crossover-by-kwame-alexander.html', 'snippet': 'Basketball-playing twins find challenges to their relationship on and off the court in Kwame Alexander’s verse novel.', 'lead_paragraph': 'Josh and JB are twins, double trouble on the basketball court, almost 13 years old. When we first encounter them in Kwame Alexander’s beautifully measured novel of life and lines, “The Crossover,” they are deep into a year when everything changes. The story is written in verse, but have no fear: Here, poetry is in service to the interior and exterior worlds of Josh, who plays forward to JB’s shooting guard. Besides being an inch taller and the one with dreadlocks to his neck, Josh is also the brother with the larger vocabulary — by the novel’s end, he will define 12 important words and terms.', 'print_section': 'BR', 'print_page': '21', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Heart of a Champion', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Heart of a Champion', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'creative_works', 'value': 'The Crossover (Book)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Alexander, Kwame', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-09T15:58:43+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Cornelius Eady', 'person': [{'firstname': 'Cornelius', 'middlename': None, 'lastname': 'Eady', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8fa592e7-dfdc-5a51-bb55-76061cf8af4b', 'word_count': 685, 'uri': 'nyt://article/8fa592e7-dfdc-5a51-bb55-76061cf8af4b'}, {'abstract': 'From lullabies to tall tales and animal menageries, these books explore the magic and mystery of nighttime.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/margaret-wise-browns-goodnight-songs-and-more.html', 'snippet': 'From lullabies to tall tales and animal menageries, these books explore the magic and mystery of nighttime.', 'lead_paragraph': 'I don’t know about yours, but my bedtime reading does not generally — ever, actually — include books about falling asleep. This should seem strange only to young children, for whom the provision of books about sleeping and not sleeping has captured a large slice of the picture book market. Dr. Robert Needlman, who revised and updated Dr. Benjamin Spock’s “Baby and Child Care,” once told me that the purpose of bedtime stories is to give the imagination a kind of way station between wakefulness and sleep that facilitates an easier slip into unconsciousness. (We were talking about young children, but I think this goes for all of us.) So books for bedtime, sure. But why about? Four new books, swaddled in practically identical shades of sleepy-time blue, attempt to make a case for the genre. Some do a better job than others.', 'print_section': 'BR', 'print_page': '22', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Sutton-3-sub/0511-bks-Sutton-3-sub-articleLarge.jpg', 'height': 571, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/11/books/review/0511-bks-Sutton-3-sub/0511-bks-Sutton-3-sub-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 571}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Sutton-3-sub/0511-bks-Sutton-3-sub-jumbo.jpg', 'height': 974, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Sutton-3-sub/0511-bks-Sutton-3-sub-superJumbo.jpg', 'height': 1634, 'width': 1717, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Sutton-3-sub/0511-bks-Sutton-3-sub-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/11/books/review/0511-bks-Sutton-3-sub/0511-bks-Sutton-3-sub-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/11/books/review/0511-bks-Sutton-3-sub/0511-bks-Sutton-3-sub-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Slumber Party', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Slumber Party', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Margaret Wise', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Sakai, Komako', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-09T15:59:02+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Roger Sutton', 'person': [{'firstname': 'Roger', 'middlename': None, 'lastname': 'Sutton', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/7280988b-9992-53a2-9055-5c119c6123dd', 'word_count': 971, 'uri': 'nyt://article/7280988b-9992-53a2-9055-5c119c6123dd'}, {'abstract': 'A sociable girl tries to help her older sibling overcome her shyness in this middle-grade novel.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/ava-and-pip-by-carol-weston.html', 'snippet': 'A sociable girl tries to help her older sibling overcome her shyness in this middle-grade novel.', 'lead_paragraph': 'In literature, as in life, sisters are always compared with one another. There’s the smart one and the pretty one. The shy one and the one who gets invited everywhere. Older sisters are supposed to know better, while younger ones are usually up to something. Little sisters tend to feel left out. Who can forget Amy March tossing Jo’s manuscript into the fire because she wasn’t invited to the play? Or Ramona Quimby baking her doll into \xadBeezus’ birthday cake?', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Little Sister, Big Plans', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Little Sister, Big Plans', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Sullivan, J Courtney', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Weston, Carol', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T15:59:15+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By J. Courtney Sullivan', 'person': [{'firstname': 'J.', 'middlename': 'Courtney', 'lastname': 'Sullivan', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/77bcccd3-02b9-5611-b370-4984d0982730', 'word_count': 760, 'uri': 'nyt://article/77bcccd3-02b9-5611-b370-4984d0982730'}, {'abstract': 'In a middle-grade novel, two friends search for Communists rumored to be living in their town.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/megan-frazer-blakemores-spy-catchers-of-maple-hill.html', 'snippet': 'In a middle-grade novel, two friends search for Communists rumored to be living in their town.', 'lead_paragraph': 'The year might be 1953, but in Megan Frazer Blakemore’s “The Spy Catchers of Maple Hill,” Hazel Kaplansky has to put up with the same baloney that many a contemporary fifth grader faces. She’s sick of dealing with mean-girl bullies and getting stuck playing the triangle in music class. The brainy and impulsive girl thinks that if she exposes the new town gravedigger as a Communist, everyone from her inattentive parents to Senator McCarthy himself will recognize her as the heroine she’s meant to be.', 'print_section': 'BR', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Seeing Reds', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Seeing Reds', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Blakemore, Megan Frazer', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-09T15:59:28+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Chelsey Philpot', 'person': [{'firstname': 'Chelsey', 'middlename': None, 'lastname': 'Philpot', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/9817cc6f-1e6f-5a9c-96f0-43c48982a9b6', 'word_count': 737, 'uri': 'nyt://article/9817cc6f-1e6f-5a9c-96f0-43c48982a9b6'}, {'abstract': 'When the $35 billion merger of Publicis and Omnicom was announced, it served as a showcase for the rise of boutique investment banks like Moelis & Company. Now, the deal will cost Moelis in more ways than one.', 'web_url': 'https://dealbook.nytimes.com/2014/05/09/collapse-of-ad-giants-merger-deals-blow-to-moelis/', 'snippet': 'When the $35 billion merger of Publicis and Omnicom was announced, it served as a showcase for the rise of boutique investment banks like Moelis & Company. Now, the deal will cost Moelis in more ways than one.', 'lead_paragraph': 'When Moelis & Company began wooing prospective investors for its initial public offering earlier this year, one of its main talking points was its presence on big deals.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/10/business/dbpix-moelist/dbpix-moelist-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/10/business/dbpix-moelist/dbpix-moelist-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/10/business/dbpix-moelist/dbpix-moelist-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/10/business/dbpix-moelist/dbpix-moelist-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/10/business/dbpix-moelist/dbpix-moelist-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/10/business/dbpix-moelist/dbpix-moelist-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/10/business/dbpix-moelist/dbpix-moelist-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Collapse of Ad Giants’ Merger Deals Blow to Moelis', 'kicker': 'DealBook', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mergers, Acquisitions and Divestitures', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Moelis & Co', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Omnicom Group Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Publicis Groupe', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'Rothschild, N M, & Sons Ltd', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-09T16:00:45+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': 'By Michael J. de la Merced', 'person': [{'firstname': 'Michael', 'middlename': 'J.', 'lastname': 'de la Merced', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8a411f5c-d9da-5845-bae1-cf131faa471e', 'word_count': 386, 'uri': 'nyt://article/8a411f5c-d9da-5845-bae1-cf131faa471e'}, {'abstract': 'Evacuated from London during World War II, L. M. Elliott’s young heroes endure the culture shock of life in rural America.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/across-a-war-tossed-sea-by-l-m-elliott.html', 'snippet': 'Evacuated from London during World War II, L. M. Elliott’s young heroes endure the culture shock of life in rural America.', 'lead_paragraph': 'The experiences of children evacuated from London to rural England during the Blitz are familiar to fiction readers, thanks in large part to C. S. Lewis’s Narnia chronicles and, more recently, Michelle Magorian’s “Good Night, Mr. Tom.” Less well known is the story of the thousands of children who were sent across the ocean to live with American families. L. M. Elliott brings these reluctant immigrants to our attention in “Across a War-Tossed Sea,” an engaging but uneven tale of two English brothers, Charles and Wesley, who find themselves dispatched to a Virginia farm in 1943.', 'print_section': 'BR', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'While the Battle Rages On', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'While the Battle Rages On', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Elliott, L M', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T16:00:59+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By John Boyne', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Boyne', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d0751c70-a2bf-5e89-b63b-29e36c6c30c4', 'word_count': 716, 'uri': 'nyt://article/d0751c70-a2bf-5e89-b63b-29e36c6c30c4'}, {'abstract': 'Fire-breathing dragons, stirred up by human industry, terrorize a small town in this young adult tale set in modern-day Ontario.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/the-story-of-owen-by-e-k-johnston.html', 'snippet': 'Fire-breathing dragons, stirred up by human industry, terrorize a small town in this young adult tale set in modern-day Ontario.', 'lead_paragraph': 'Listen! Long have we known of the dangers of carbon emissions. But even those of us who believe human activity is forever damaging the climate find it difficult to change our everyday behavior, because the real cost of a short drive to the grocery store just doesn’t register.', 'print_section': 'BR', 'print_page': '25', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Where There’s Smoke', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'Where There’s Smoke', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Kois, Dan', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Johnston, E K', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T16:01:49+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Dan Kois', 'person': [{'firstname': 'Dan', 'middlename': None, 'lastname': 'Kois', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3e58360f-1ef5-5834-a3e7-d79202e101b5', 'word_count': 717, 'uri': 'nyt://article/3e58360f-1ef5-5834-a3e7-d79202e101b5'}, {'abstract': 'Rick Atkinson adapts his best-selling account of the Normandy invasion for readers in the middle grades.', 'web_url': 'https://www.nytimes.com/2014/05/11/books/review/d-day-by-rick-atkinson-with-kate-waters.html', 'snippet': 'Rick Atkinson adapts his best-selling account of the Normandy invasion for readers in the middle grades.', 'lead_paragraph': 'On the morning of May 5, 1944, 146 Allied generals, admirals, officers and staff members filed past military policemen into the chilly auditorium of St. Paul’s School in London. German bombs had blown out 700 of the school’s windows; its students had been evacuated to the countryside. The military men sat on hard benches with overcoats buttoned, blankets on laps. Gen. Dwight D. Eisenhower, standing before a 30-foot-wide plaster relief map of the coast of Normandy, announced that if anyone saw a problem with the plan the group was about to hear, he should speak up. “I have no sympathy with anyone,” he said, “whatever his station, who will not brook criticism.” Then the “wiry, elfin” British Gen. Bernard L. Montgomery began, “in his reedy voice, each word as sharply creased as his trousers,” to describe the invasion intended to mortally wound Hitler’s Third Reich.', 'print_section': 'BR', 'print_page': '24', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'One Morning in June', 'kicker': 'Children’s Books', 'content_kicker': None, 'print_headline': 'One Morning in June', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Atkinson, Rick', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Waters, Kate', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T16:02:05+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Steve Sheinkin', 'person': [{'firstname': 'Steve', 'middlename': None, 'lastname': 'Sheinkin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/69e4c612-5e9a-5ada-b424-3ca4c4b5e990', 'word_count': 709, 'uri': 'nyt://article/69e4c612-5e9a-5ada-b424-3ca4c4b5e990'}, {'abstract': 'Plus deleting old Passbook cards on your iPhone.', 'web_url': 'https://www.nytimes.com/2014/05/09/technology/personaltech/what-it-means-when-google-verifies-an-app.html', 'snippet': 'Plus deleting old Passbook cards on your iPhone.', 'lead_paragraph': 'Q. When Google “verifies” apps during installation on an Android device, what is it doing?', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What It Means When Google ‘Verifies’ an App', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mobile Applications', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Android (Operating System)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Google Inc', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Apple Inc', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-09T16:05:03+0000', 'document_type': 'article', 'news_desk': 'Business', 'section