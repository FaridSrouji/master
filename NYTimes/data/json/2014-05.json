on/05METGALARIHANNA/05METGALARIHANNA-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/fashion/05METGALARIHANNA/05METGALARIHANNA-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Met Gala Red Carpet Arrivals', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Fashion and Apparel', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Museum of Art', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Costume Institute', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Parties (Social)', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-05T22:14:37+0000', 'document_type': 'multimedia', 'news_desk': 'Fashion & Style', 'section_name': 'Fashion & Style', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Interactive Feature', '_id': 'nyt://interactive/0b4c3649-5706-53e2-bc48-0c877b365179', 'word_count': 0, 'uri': 'nyt://interactive/0b4c3649-5706-53e2-bc48-0c877b365179'}, {'abstract': 'At an intimate signing at Curve’s NoHo boutique, the duo behind Rodarte unveiled a special edition of their 2011 tome, “Rodarte, Catherine Opie, Alec Soth,” with covers hand-painted by the artist Rebekah Miles.', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/05/05/rodarte-catherine-opie-alec-soth-kate-laura-mulleavy-rebekah-miles-book-curve/', 'snippet': 'At an intimate signing at Curve’s NoHo boutique, the duo behind Rodarte unveiled a special edition of their 2011 tome, “Rodarte, Catherine Opie, Alec Soth,” with covers hand-painted by the artist Rebekah Miles.', 'lead_paragraph': 'When Nevena Borissova, the owner of Curve — a boutique with locations in Miami, Los Angeles, San Francisco and New York — set out to host an event celebrating Rodarte‘s fall collection, she approached Kate and Laura Mulleavy, the sisters behind the label, to help her think outside the rack. The trio came up with the idea of putting a new twist on the 2011 book they created with the fine-art photographers Catherine Opie and Alec Soth. The Mulleavys then called on their friend, the artist and ceramist Rebekah Miles, to create 27 new individually hand-painted covers, which were unveiled yesterday at an intimate book signing at Curve’s NoHo location. “It’s something that she does really beautifully,” says Laura Mulleavy of Miles’s book-jacket paintings.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05rodarte-binlot/05rodarte-binlot-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/05/t-magazine/05rodarte-binlot/05rodarte-binlot-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05rodarte-binlot/05rodarte-binlot-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05rodarte-binlot/05rodarte-binlot-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/05/t-magazine/05rodarte-binlot/05rodarte-binlot-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/05/t-magazine/05rodarte-binlot/05rodarte-binlot-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumb