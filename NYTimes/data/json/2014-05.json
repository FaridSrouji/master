': None}, 'keywords': [{'name': 'subject', 'value': 'Classical Music', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Brown, Michael (Pianist)', 'rank': 2, 'major': 'N'}], 'pub_date': '2014-05-11T05:57:54+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Vivien Schweitzer', 'person': [{'firstname': 'Vivien', 'middlename': None, 'lastname': 'Schweitzer', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/5400bf0d-f51c-5fde-b6fb-225f902f9ba9', 'word_count': 378, 'uri': 'nyt://article/5400bf0d-f51c-5fde-b6fb-225f902f9ba9'}, {'abstract': 'Corrections appearing in print on May 11, 2014.', 'web_url': 'https://www.nytimes.com/2014/05/11/pageoneplus/corrections-may-11-2014.html', 'snippet': 'Corrections appearing in print on May 11, 2014.', 'lead_paragraph': 'FRONT PAGE', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Corrections: May 11, 2014', 'kicker': None, 'content_kicker': None, 'print_headline': 'Corrections', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-11T06:05:34+0000', 'document_type': 'article', 'news_desk': 'Summary', 'section_name': 'Corrections', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/55fe7de7-2460-558d-a2b5-e32651e5447b', 'word_count': 1050, 'uri': 'nyt://article/55fe7de7-2460-558d-a2b5-e32651e5447b'}, {'abstract': 'Asean members declined to point fingers at the region’s top trade partner, while in Vietnam there are also divisions over how to handle China’s forceful maritime assertiveness.', 'web_url': 'https://www.nytimes.com/2014/05/12/world/asia/vietnam.html', 'snippet': 'Asean members declined to point fingers at the region’s top trade partner, while in Vietnam there are also div