inion', 'byline': {'original': 'By Vikas Bajaj', 'person': [{'firstname': 'Vikas', 'middlename': None, 'lastname': 'Bajaj', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e26c7b00-51c7-57f9-8b02-52e7111896e5', 'word_count': 376, 'uri': 'nyt://article/e26c7b00-51c7-57f9-8b02-52e7111896e5'}, {'abstract': 'Massimo Vignelli, who died Tuesday in Manhattan, created a distinctive, Modernist aesthetic.', 'web_url': 'https://www.nytimes.com/slideshow/2014/05/27/business/2014-05-27-Vignelli-SS.html', 'snippet': 'Massimo Vignelli, who died Tuesday in Manhattan, created a distinctive, Modernist aesthetic.', 'lead_paragraph': 'Massimo Vignelli, who died Tuesday in Manhattan, created a distinctive, Modernist aesthetic.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/27/business/2014-0527-Vignelli-SS-01/2014-0527-Vignelli-SS-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/27/business/2014-0527-Vignelli-SS-01/2014-0527-Vignelli-SS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/27/business/2014-0527-Vignelli-SS-01/2014-0527-Vignelli-SS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/27/business/2014-0527-Vignelli-SS-01/2014-0527-Vignelli-SS-superJumbo.jpg', 'height': 1367, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/27/business/2014-0527-Vignelli-SS-01/2014-0527