 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/dc4c7813-1699-5c3d-9542-50316f32b65c', 'word_count': 818, 'uri': 'nyt://article/dc4c7813-1699-5c3d-9542-50316f32b65c'}, {'abstract': 'The economist doesn’t give an inch on the methodology for his book on inequality.', 'web_url': 'https://www.nytimes.com/2014/05/30/upshot/thomas-piketty-responds-to-criticism-of-his-data.html', 'snippet': 'The economist doesn’t give an inch on the methodology for his book on inequality.', 'lead_paragraph': 'Six days after The Financial Times launched an attack on the data behind Thomas Piketty’s much-debated tome on inequality, “Capital in the Twenty-First Century,” Mr. Piketty has offered his first detailed response to the newspaper’s criticism.', 'print_section': 'B', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/upshot/30UP-Piketty/30UP-Piketty-articleLarge.jpg', 'height': 464, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/30/upshot/30UP-Piketty/30UP-Piketty-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 464}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/upshot/30UP-Piketty/30UP-Piketty-jumbo.jpg', 'height': 791, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/upshot/30UP-Piketty/30UP-Piketty-superJumbo.jpg', 'height': 1291, 'width': 1671, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/30/upshot/30UP-Piketty/30UP-Piketty-thumbStandard.jpg', 'height': 75, 'widt