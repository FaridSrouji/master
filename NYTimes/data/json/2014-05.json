': 'subject', 'value': 'Railroad Accidents and Safety', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Subways', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Metropolitan Transportation Authority', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Woodside (Queens, NY)', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Queens (NYC)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-04T18:23:11+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Joseph Goldstein', 'person': [{'firstname': 'Joseph', 'middlename': None, 'lastname': 'Goldstein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/6d7d8751-c93e-561e-b8d7-a1b7a97857df', 'word_count': 400, 'uri': 'nyt://article/6d7d8751-c93e-561e-b8d7-a1b7a97857df'}, {'abstract': 'More than 125 others were injured when the train’s engine and four of its 20 cars derailed after they emerged from a tunnel in the Raigad district.', 'web_url': 'https://www.nytimes.com/2014/05/05/world/asia/train-derails-in-india.html', 'snippet': 'More than 125 others were injured when the train’s engine and four of its 20 cars derailed after they emerged from a tunnel in the Raigad district.', 'lead_paragraph': 'NEW DELHI — A passenger train traveling through the Western Ghats mountain range on a route connecting Mumbai and Goa in western India derailed on Sunday, killing at least 18 people and injuring more than 125 others.', 'print_section': 'A', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Train Derails in India, Killing at Least 18', 'kicker': None, 'content_kicker': None, 'print_headline': 'Train Derails in India, Killing at Least 18', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'India', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': '