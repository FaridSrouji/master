ges/2014/05/07/blogs/20140507-lens-cohen-slide-5Y2P/20140507-lens-cohen-slide-5Y2P-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Pictures on the Street? It’s Complicated', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-07T22:55:59+0000', 'document_type': 'multimedia', 'news_desk': 'Blogs', 'section_name': 'Blogs', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'Slideshow', '_id': 'nyt://slideshow/a6ad6a57-f2a6-5e03-99fe-54803411ebc6', 'word_count': 0, 'uri': 'nyt://slideshow/a6ad6a57-f2a6-5e03-99fe-54803411ebc6'}, {'abstract': 'An unattractive hallway makes the foyer inside your apartment even more important.', 'web_url': 'https://www.nytimes.com/2014/05/08/garden/what-can-i-do-about-our-buildings-ugly-corridors.html', 'snippet': 'An unattractive hallway makes the foyer inside your apartment even more important.', 'lead_paragraph': 'Q. Our apartment building has ugly corridors. Is there anything we can do to make a better first impression on buyers?', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Can I Do About Our Building’s Ugly Corridors?', 'kicker': 'Currents: Market Ready', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'McKeough, Tim', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Home Repairs and Improvements', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-07T22:56:41+0000', 'document_type': 'article', 'news_desk': 'Home', 'section_name': 'Home & Garden', 'byline': {'original': 'By Tim McKeough', 'person': [{'firstname': 'Tim', 'middlename': None, 'lastname': 'McKeough', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/8f38da71-6e48-5775-87a1-50a25bc2719f', 'word_count': 460, 'uri': 'nyt://article/8f38da71-6e48-5775-87a1-50a25bc2719f'}, {'abstract': 'Reissued furniture by Oscar Niemeyer and Jorge Zalszupin will soon be available in the United States.', 'web_url': 'https://www.nytimes.com/2014/05/08/garden/all-angles-and-curves.html', 'snippet': 'Reissued furniture by Oscar Niemeyer and Jorge Zalszupin will soon be available in the United States.', 'lead_paragraph': 'Starting next week, furniture by Oscar Niemeyer and Jorge Zalszupin, two of Brazil’s most-celebrated architects,\xa0will be available in the United States, through Espasso, a design gallery in TriBeCa.\xa0The re-editions include items that Mr. Niemeyer, who died in 2012 at the age of 104, designed in the 1970s with his daughter Anna Maria Niemeyer, including the Rio rocking chaise ($38,400), and Alta armchair and ottoman ($28,450 for both). Espasso will also offer 20 pieces designed\xa0in the 1960s\xa0by the now-91-year-old Mr. Zalszupin, including his Circa bench ($17,800) and delicately curving Brasiliana armchair ($10,250). The pieces will be displayed at Espasso from May 14 to June 3, and will be for sale, then and after, along with a new monograph, “Jorge Zalszupin: Design Moderno” ($80), by Maria Cecilia Loschiavo dos Santos. Espasso is at 38 North Moore Street (Hudson Street). Information: 212-219-0017 or espasso.com.', 'print_section': 'D', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/08/garden/08CURRFURNITURE/08CURRFURNITURE-articleLarge-v2.jpg', 'height': 335, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/08/garden/08CURRFURNITURE/08CURRFURNITURE-articleLarge-v2.jpg', 'xlargewidth': 600, 