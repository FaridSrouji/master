: None}, 'keywords': [{'name': 'subject', 'value': 'Hockey, Ice', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Pittsburgh Penguins', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Rangers', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Bylsma, Dan', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Crosby, Sidney', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Malkin, Evgeni', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'Lundqvist, Henrik', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'McDonagh, Ryan', 'rank': 8, 'major': 'N'}, {'name': 'persons', 'value': 'Girardi, Dan', 'rank': 9, 'major': 'N'}, {'name': 'persons', 'value': 'Stralman, Anton', 'rank': 10, 'major': 'N'}], 'pub_date': '2014-05-02T19:08:48+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Hockey', 'byline': {'original': 'By Jeff Z. Klein', 'person': [{'firstname': 'Jeff', 'middlename': 'Z.', 'lastname': 'Klein', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4d818d80-c7d7-5d12-aa9b-74d710822cb3', 'word_count': 658, 'uri': 'nyt://article/4d818d80-c7d7-5d12-aa9b-74d710822cb3'}, {'abstract': 'The lo-fi songstress Alice Boman debuts a new track from her forthcoming “EP II.”', 'web_url': 'https://tmagazine.blogs.nytimes.com/2014/05/02/alice-boman-sweden-singer-songwriter-new-song-over/', 'snippet': 'The lo-fi songstress Alice Boman debuts a new track from her forthcoming “EP II.”', 'lead_paragraph': 'Alice Boman wrote and recorded her new song, “Over,” alone in her apartment in Malmo, Sweden. “I didn’t know it was going to be released,” she says of the hauntingly spare recording, which will appear on her new release, “EP II,” out June 3 via the Control Group. This intimate, lo-fi approach is characteristic of the soft-spoken singer-songwriter’s work. Her first EP, last year’s “Skisser” (Swedish for “sketches”), earned raves for its minimal arrangements and simple, heartbreaking lyrics. She tried to capture the same magic with “EP II,” cutting more tracks at home and, at one point, holing up in a cabin in the Swedish woods to record her ethereal sounds. The rustic setting — Boman says she had to trek to a neighbor’s to fetch water each day — proved a fitting backdrop for the 26-year-old’s elegiac, if oddly uplifting, tunes. “It was beautiful,” she says.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/02/t-magazine/02Oloizia_Boman/02Oloizia_Boman-articleLarge.jpg', 'height': 401, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/02/t-magazine/02Oloizia_Boman/02Oloizia_Boman-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 401}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/02/t-magazine/02Oloizia_Boman/02Oloizia_Boman-jumbo.jpg', 'height': 685, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/02/t-magazine/02Oloizia_Boman/02Oloizia_Boman-superJumbo.jpg', 'height': 1370, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/02/t-magazine/02Oloizia_Boman/02Oloizia_Boman-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/02/t-magazine/02Oloizia_Boman/02Oloizia_Boman-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/02/t-maga