ons. “Big Bad Bubble," by Adam Rubin with illustrations by Daniel Salmieri, and “Rules of Summer,” by Shaun Tan, imagine alien landscapes inhabited by monstrous creatures. Whether they strike a chord with — or terrify — children depends very much upon the child.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/28/books/28childrens-2/28childrens-2-articleLarge.jpg', 'height': 273, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/28/books/28childrens-2/28childrens-2-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 273}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/28/books/28childrens-2/28childrens-2-jumbo.jpg', 'height': 466, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/28/books/28childrens-2/28childrens-2-superJumbo.jpg', 'height': 931, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/28/books/28childrens-2/28childrens-2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/28/books/28childrens-2/28childrens-2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/28/books/28childrens-2/28childrens-2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Monsters, Updated', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': 