ated buildings. ', 'print_section': 'WE', 'print_page': '11', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/nyregion/01ARTSWE1/01ARTSWE1-articleLarge.jpg', 'height': 333, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/01/nyregion/01ARTSWE1/01ARTSWE1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 333}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/nyregion/01ARTSWE1/01ARTSWE1-jumbo.jpg', 'height': 569, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/nyregion/01ARTSWE1/01ARTSWE1-superJumbo.jpg', 'height': 1138, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/nyregion/01ARTSWE1/01ARTSWE1-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/06/01/nyregion/01ARTSWE1/01ARTSWE1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/nyregion/01ARTSWE1/01ARTSWE1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'All Paths Lead to Illumination', 'kicker': 'Art Review', 'content_kicker': None, 'print_headline': 'All Paths Lead to Illumination', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Vassar College', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Loeb, Frances Lehman, Art Center', 'rank': 3, 'major': 'N'}, {'name': 