ITY-METS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/sports/SUB-CITY-METS/SUB-CITY-METS-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/sports/SUB-CITY-METS/SUB-CITY-METS-superJumbo.jpg', 'height': 1366, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/sports/SUB-CITY-METS/SUB-CITY-METS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/03/sports/SUB-CITY-METS/SUB-CITY-METS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/03/sports/SUB-CITY-METS/SUB-CITY-METS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Mets’ Streak of Quality Starts Is Disappearing Into Thin Air at Coors Field', 'kicker': 'Rockies 10, Mets 3', 'content_kicker': None, 'print_headline': 'Mets’ Streak of Quality Starts Is Disappearing Into Thin Air at Coors Field', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Colorado Rockies', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Mets', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Wheeler, Zack', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-03T04:18:01+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Justin Felisko', 'person': [{'firstname': 'Justin', 'middlename': None, 'lastname': 'Felisko', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e208f8fe-1036-5b48-8595-2d147fb898d2', 'word_count': 911, 'uri': 'nyt://article/e208f8fe-1036-5b48-8595-2d147fb898d2'}, {'abstract': 'Television highlights.', 'web_url': 'https://www.nytimes.com/2014/05/03/arts/television/whats-on-saturday.html', 'snippet': 'Television highlights.', 'lead_paragraph': '8 P.M. (HBO) WE’RE THE MILLERS (2013) A drug dealer (Jason Sudeikis) in trouble with his boss (Ed Helms) recruits a stripper (Jennifer Aniston) and a couple of street urchins (Will Poulter and Emma Roberts, above, with Mr. Sudeikis and Ms. Aniston) to impersonate an all-American family known as the Millers. Their mission: to transport a few tons of marijuana from Mexico to Denver in their camper. And in no time at all, they’re caring about one another more than they want to admit. “\xa0‘We’re the Millers,’ a loose, halfheartedly raunchy, occasionally hilarious new comedy, is about a lot of different things; it’s the usual grab bag of jokes about drugs and body parts,” A. O. Scott wrote in The New York Times. “But what really drives the movie is its own search for something to make fun of, and for a comic style that can feel credibly naughty while remaining ultimately safe and affirmative.” Nick Offerman and Kathryn Hahn play the Fitzgeralds, R.V. enthusiasts with a teenage daughter who “are beyond square, which is to say that they are stranger, kinkier and more interestingly individual” than the Millers — and funnier as actors, too — Mr. Scott added. “A movie about the Fitzgeralds would have been more rewarding than ‘We’re the Millers,’ and also much riskier.” ', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What’s On Saturday', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Saturday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-03T05:00:01+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Kathryn Shattuck', 'person': [{'firstname': 'Kathryn', 'middlename': None, 'lastname': 'Shattuck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Schedule', '_id': 'nyt://article/02c7660e-e430-5bae-8abc-eb4502f098a6', 'word_count': 718, 'uri': 'nyt://article/02c7660e-e430-5bae-8abc-eb4502f098a6'}, {'abstract': 'At the restaurant Equus, part of the Castle Hotel and Spa, in Tarrytown, diners will find a menu that offers delights, as heralded in the amuse-bouche.', 'web_url': 'https://www.nytimes.com/2014/05/04/nyregion/a-review-of-equus-in-tarrytown.html', 'snippet': 'At the restaurant Equus, part of the Castle Hotel and Spa, in Tarrytown, diners will find a menu that offers delights, as heralded in the amuse-bouche.', 'lead_paragraph': 'Born too late, our country is short on castles. Nineteenth-century wealth on the East Coast built instead many Victorian Gothic mansions, some of them on the breezy, wooded land of the Hudson Valley. In Westchester a few still stand, like Lyndhurst and Glenview. ', 'print_section': 'WE', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/nyregion/04DINEWE3/04DINEWE3-articleLarge.jpg', 'height': 399, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/04/nyregion/04DINEWE3/04DINEWE3-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 399}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/nyregion/04DINEWE3/04DINEWE3-jumbo.jpg', 'height': 681, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/nyregion/04DINEWE3/04DINEWE3-superJumbo.jpg', 'height': 1361, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/nyregion/04DINEWE3/04DINEWE3-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/04/nyregion/04DINEWE3/04DINEWE3-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/04/nyregion/04DINEWE3/04DINEWE3-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Seasonal Dishes, and Romance, in a Castle', 'kicker': 'Dining Review | Westchester', 'content_kicker': None, 'print_headline': 'Seasonal Dishes, and Romance, in a Castle', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'glocations', 'value': 'Tarrytown (NY)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Restaurants', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Equus (Tarrytown, NY, Restaurant)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Castle Hotel & Spa (Tarrytown, NY)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Palaces and Castles', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-03T05:14:11+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By M. H. Reed', 'person': [], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/3c209465-f476-50d7-8c39-d4c2eae7f391', 'word_count': 571, 'uri': 'nyt://article/3c209465-f476-50d7-8c39-d4c2eae7f391'}, {'abstract': 'Joe Girardi became the sixth skipper to manage 1,000 games for the Yankees in Friday’s 14-inning loss to Tampa Bay, a contest that included a wild double play in the 12th and Derek Jeter’s first 0-for-7 game.', 'web_url': 'https://www.nytimes.com/2014/05/03/sports/baseball/a-milestone-game-for-girardi-lacks-a-celebratory-or-quick-ending.html', 'snippet': 'Joe Girardi became the sixth skipper to manage 1,000 games for the Yankees in Friday’s 14-inning loss to Tampa Bay, a contest that included a wild double play in the 12th and Derek Jeter’s first 0-for-7 game.', 'lead_paragraph': 'Entering Friday, only five managers in the 114 seasons of the Yankees franchise had accumulated at least 1,000 games on the bench. Despite all their success, the Yankees have also employed managers who were either not good enough to last very long, or simply had fallen in the way of a cantankerous and impatient owner like George Steinbrenner, who would fire someone at the slightest hint of failure.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'A Milestone for Girardi in a Game With a Bit of Everything', 'kicker': 'Rays 10, Yankees 5 (14 Innings)', 'content_kicker': None, 'print_headline': 'A Milestone for Girardi in a Game With a Bit of Everything ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Tampa Bay Rays', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Yankees', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Girardi, Joe', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-03T05:17:54+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Baseball', 'byline': {'original': 'By Jorge Arangure Jr', 'person': [{'firstname': 'Jorge', 'middlename': None, 'lastname': 'Arangure', 'qualifier': 'Jr', 'title': None, 'role': 'reported', 'organizati