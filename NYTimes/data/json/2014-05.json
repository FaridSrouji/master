e': 'subject', 'value': 'Genetics and Heredity', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-05T21:40:38+0000', 'document_type': 'article', 'news_desk': 'Science', 'section_name': 'Science', 'byline': {'original': 'By Henry Fountain', 'person': [{'firstname': 'Henry', 'middlename': None, 'lastname': 'Fountain', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/d101785c-295e-5964-acbd-c098344d1d53', 'word_count': 1245, 'uri': 'nyt://article/d101785c-295e-5964-acbd-c098344d1d53'}, {'abstract': 'A forecasting model at The Washington Post gives the G.O.P. a far better chance of retaking the Senate than our model does. What accounts for the difference?', 'web_url': 'https://www.nytimes.com/2014/05/06/upshot/new-election-model-machinery-a-look-under-the-hood.html', 'snippet': 'A forecasting model at The Washington Post gives the G.O.P. a far better chance of retaking the Senate than our model does. What accounts for the difference?', 'lead_paragraph': 'John Sides, Ben Highton and Eric McGhee of The Monkey Cage have started Election Lab, a Senate forecasting model at The Washington Post. Their model gives Republicans more than an 80 percent chance of retaking the Senate; that’s much more than the 54 percent chance that Leo, The Upshot’s Senate model, gives the G.O.P.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'New Election Model Machinery: A Look Under the Hood', 'kicker': 'Midterm Calculus', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Elections, Senate', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Polls and Public Opinion', 'rank': 3, 'major': 'N'}], 'pub_date': '2014-05-05T21:43:12+0000', 'document_type': 'article', 'news_desk': 'Upshot', 'section_name': 'The Upshot', 'byline': {'original': 'By Nate Cohn, Josh Katz and Amanda Cox', 'person': [{'firstname': 'Nate', 'middlename': None, 'lastname': 'Cohn', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}, {'firstname': 'Josh', 'middlename': None, 'lastname': 'Katz', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 2}, {'firstname': 'Amanda', 'middlename': None, 'lastname': 'Cox', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 3}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/bf291fdc-ddc4-57ec-bf05-6f224161c01a', 'word_count': 415, 'uri': 'nyt://article/bf291fdc-ddc4-57ec-bf05-6f224161c01a'}, {'abstract': 'John Luther Adams talks about the genesis of “Become Ocean,” to be performed on Tuesday at Carnegie Hall, and other environmentally themed works.', 'web_url': 'https://www.nytimes.com/2014/05/06/arts/music/a-new-york-premiere-for-john-luther-adamss-become-ocean.html', 'snippet': 'John Luther Adams talks about the genesis of “Become Ocean,” to be performed on Tuesday at Carnegie Hall, and other environmentally themed works.', 'lead_paragraph': 'John Luther Adams has never been inside the main auditorium of Carnegie Hall. It’s not a fact that distinguishes him greatly in his hometown, Fairbanks, Alaska, where he has lived for four decades. There Mr. Adams, now 61, was first known as an environmental activist who helped secure passage of the Alaska Lands Act in 1980, before dedicating himself full time to music and building a small but fervent following as a composer of hypnotically immersive musical landscapes. But when Mr. Adams attends his first concert in Carnegie Hall’s Stern Auditorium on Tuesday, he will be in the unusual position of doing so as a newly minted Pulitzer Prize laureate hearing his winning work, “Become Ocean,” played there for the first time.', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/adams/adams-articleLarge.jpg', 'height': 394, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/06/arts/adams/adams-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 394}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/adams/adams-jumbo.jpg', 'height': 672, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/adams/adams-superJumbo.jpg', 'height': 1344, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/adams/adams-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/06/arts/adams/adams-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/adams/adams-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'A Composer Attuned to the Earth’s Swirling Motion', 'kicker': 'Critic’s Notebook', 'content_kicker': None, 'print_headline': 'A Composer Attuned to the Earth&#8217;s Swirling Motion ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'da Fonseca-Wollheim, Corinna', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Music', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Adams, John Luther', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Carnegie Hall', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-05T21:43:53+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Music', 'byline': {'original': 'By Corinna da Fonseca-Wollheim', 'person': [{'firstname': '', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/45995204-c010-5972-9d38-f20eca13419b', 'word_count': 1134, 'uri': 'nyt://article/45995204-c010-5972-9d38-f20eca13419b'}, {'abstract': 'The Hanging Gardens of Babylon, as an episode of the PBS series “Secrets of the Dead” investigates, may have actually been in Nineveh, in modern-day Iraq.', 'web_url': 'https://www.nytimes.com/2014/05/06/arts/television/secrets-of-the-dead-seeks-ancient-gardens.html', 'snippet': 'The Hanging Gardens of Babylon, as an episode of the PBS series “Secrets of the Dead” investigates, may have actually been in Nineveh, in modern-day Iraq.', 'lead_paragraph': 'This is the time of year when weekend gardeners peer into the neighbors’ yards for confirmation of their own superiority or inadequacy. But practically every gardener will feel unworthy upon viewing Tuesday’s episode of the PBS series “Secrets of the Dead.” ', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/06SECRETS/06SECRETS-articleLarge.jpg', 'height': 332, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/06/arts/06SECRETS/06SECRETS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 332}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/06SECRETS/06SECRETS-jumbo.jpg', 'height': 566, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/06SECRETS/06SECRETS-superJumbo.jpg', 'height': 754, 'width': 1363, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/06SECRETS/06SECRETS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/06/arts/06SECRETS/06SECRETS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/06SECRETS/06SECRETS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'In Search of a Lost Wonder, Off the Rivers of Babylon', 'kicker': 'Television Review', 'content_kicker': None, 'print_headline': 'In Search of a Lost Wonder, Off the Rivers of Babylon', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'organizations', 'value': 'Public Broadcasting Service', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'Babylon (Iraq)', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Iraq', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Nineveh (Iraq)', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Secrets of the Dead (TV Program)', 'rank': 7, 'major': 'N'}], 'pub_date': '2014-05-05T21:45:42+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Neil Genzlinger', 'person': [{'firstname': 'Neil', 'middlename': None, 'lastname': 'Genzlinger', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/8230dee0-9e58-5c7e-94a6-0c6a87e4e7b2', 'word_count': 295, 'uri': 'nyt://article/8230dee0-9e58-5c7e-94a6-0c6a87e4e7b2'}, {'abstract': '“Cherry Smoke,” staged by the Working Theater company, describes the hard lives and limited options facing a boxer and his girlfriend in western Pennsylvania.', 'web_url': 'https://www.nytimes.com/2014/05/06/theater/cherry-smoke-by-james-mcmanus-at-urban-stages.html', 'snippet': '“Cherry Smoke,” staged by the Working Theater company, describes the hard lives and limited options facing a boxer and his girlfriend in western Pennsylvania.', 'lead_paragraph': 'In James McManus’s overwrought “Cherry Smoke,” Fish (Vayu O’Donnell) is an amateur boxer with what his brother, Duffy (Patrick Carroll), describes as a “serious lunatic streak.” On a set — sandbags, red stucco, ruined tires — resembling an apocalyptic desert but meant to suggest western Pennsylvania, Fish cycles from back-alley bouts to prison stints to riverside encounters with his guileless girlfriend Cherry (Molly Carden). An exploited child-woman, she is prone to statements like, “There useta be a bluebird in my heart, but it flew away.” She also describes a form of birth control so violent it provokes laughter.', 'print_section': 'C', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/06CHERRY/06CHERRY-articleLarge.jpg', 'height': 376, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/06/arts/06CHERRY/06CHERRY-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 376}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/06/arts/06CHERRY/06CHERRY-jumbo.jpg', 'height': 641, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image',