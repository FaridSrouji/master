orts/01clarey1/01clarey1-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/sports/01clarey1/01clarey1-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'You Can’t Tell the Tennis Stars’ Coaches Without a Scorecard', 'kicker': None, 'content_kicker': None, 'print_headline': 'You Need a Scorecard to Tally the Coaches', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Tennis', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Clarey, Christopher', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'French Open (Tennis)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Coaches and Managers', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-31T21:03:18+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'subsection_name': 'Tennis', 'byline': {'original': 'By Christopher Clarey', 'person': [{'firstname': 'Christopher', 'middlename': None, 'lastname': 'Clarey', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/1aee2576-f646-5fbd-a3d0-5d4c07aea683', 'word_count': 1342, 'uri': 'nyt://article/1aee2576-f646-5fbd-a3d0-5d4c07aea683'}, {'abstract': 'Readers comment on my column about the crimes against humanity targeting the Rohingya of Myanmar.', 'web_url': 'https://kristof.blogs.nytimes.com/2014/05/31/with-the-rohingya-in-myanmar/', 'snippet': 'Readers comment on my column about the crimes against humanity targeting the Rohingya of Myanmar.', 'lead_paragraph': 'My Sunday column, from some remote villages in Myanmar, looks at the ethnic cleansing and crimes against humanity being perpetrated against the Rohingya minority there. Some scholars call it genocide, and it arguably does meet the definition in the 1948 convention. But it’s not comparable to the mass murders in Rwanda, Darfur, Armenia or of course the Holocaust, so maybe ethnic cleansing is a better term in this case.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'With the Rohingya in Myanmar', 'kicker': 'Nicholas Kristof', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-31T21:14:50+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Nicholas Kristof', 'person': [{'firstname': 'Nicholas', 'middlename': None, 'lastname': 'Kristof', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/62596e43-7c96-5958-a3d0-13438e66214e', 'word_count': 195, 'uri': 'nyt://article/62596e43-7c96-5958-a3d0-13438e66214e'}, {'abstract': 'I’ll Have Another has settled in at a Japanese breeding farm, two years after an injury cost him a shot at a Triple Crown.', 'web_url': 'https://www.nytimes.com/2014/06/01/sports/ill-have-another-former-triple-crown-contender-settles-in-at-a-japanese-farm.html', 'snippet': 'I’ll Have Another has settled in at a Japanese breeding farm, two years after an injury cost him a shot at a Triple Crown.', 'lead_paragraph': 'NIIKAPPU-GUN, Japan — It was just after noon on a recent day at Big Red Farm, one of Japan’s largest horse breeders, time for Hiroshi Kimura to take the 5-year-old stallion I’ll Have Another for a walk.', 'print_section': 'SP', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/06/01/sports/another1/another1-articleLarge.jpg', 'height': 434, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/06/01/sports/another1/another1-articleLarge.