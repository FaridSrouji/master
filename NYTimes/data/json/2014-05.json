 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Clip: ‘Korengal’', 'kicker': None, 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [], 'pub_date': '2014-05-30T01:33:41+0000', 'document_type': 'multimedia', 'news_desk': 'Culture', 'section_name': 'Movies', 'byline': {'original': 'Saboteur Media', 'person': [{'firstname': 'Saboteur', 'middlename': None, 'lastname': 'Media', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Video', '_id': 'nyt://video/d4c1557e-1c43-517f-a398-e3e957480ae5', 'word_count': 0, 'uri': 'nyt://video/d4c1557e-1c43-517f-a398-e3e957480ae5'}, {'abstract': 'In “Korengal,” a sequel to the documentary “Restrepo,” American soldiers contemplate their past battle experiences in a valley in Afghanistan.', 'web_url': 'https://www.nytimes.com/2014/05/30/movies/in-korengal-us-soldiers-recall-their-time-in-afghanistan.html', 'snippet': 'In “Korengal,” a sequel to the documentary “Restrepo,” American soldiers contemplate their past battle experiences in a valley in Afghanistan.', 'lead_paragraph': 'How boring is a soldier’s life in the mountains of Afghanistan during the lulls between firefights? A serviceman interviewed in “Korengal,” the sequel to the 2010 documentary “Restrepo,” recalls that one day he and his Army buddies spent “five or six hours” arguing who would win in a fight between George Clooney and Fabio.', 'print_section': 'C', 'print_page': '8', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Haunted by Combat, Yet Missing the Brethren', 'kicker': 'Movie Review', 'content_kicker': None, 'print_headline': 'Haunted by Combat, Yet Missing the Brethren', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Movies', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Documentary Films and Programs', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Afghanistan War (2001- )', 'rank': 3, 'major': 'N'}, {'name': 'persons', 'value': 'Junger, Sebastian', 'rank': 4, 'major': 'N'}, {'name': 'creative_works', 'value': 'Korengal (Movie)', 'rank': 5, 'major': 'N'}, {'name': 'creative_works', 'value': 'Restrepo (Movie)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-30T01:37:07+0000', 'document_type': 'article', 'news_desk': 'Weekend', 'section_name': 'Movies', 'byline': {'original': 'By Stephen Holden', 'person': [{'firstname': 'Stephen', 'middlename': None, 'lastname': 'Holden', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d03788d4-466f-55ae-be70-df5a625c8f95', 'word_count': 406, 'uri': 'nyt://article/d03788d4-466f-55ae-be70-df5a625c8f95'}, {'abstract': 'Comptroller Thomas P. DiNapoli says in a report to be released on Friday that the economic benefits from expanded gambling in New York may be uneven.', 'web_url': 'https://www.nytimes.com/2014/05/30/nyregion/in-report-comptroller-is-cautious-on-casinos.html', 'snippet': 'Comptroller Thomas P. DiNapoli says in a report to be released on Friday that the economic benefits from expanded gambling in New York may be uneven.', 'lead_paragraph': 'ALBANY — Sounding a cautionary note about expanded gambling in New York State, Comptroller Thomas P. DiNapoli warns in a new report that casino complexes planned for upstate will face stiff regional competition and that much of the new revenue anticipated from the casinos will come from New Yorkers, not necessarily from out-of-state visitors.', 'print_section': 'A', 'print_page': '23', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'In Report, State Comptroller Is Cautious About Benefits of Casinos', 'kicker': None, 'content_kicker': None, 'print_headline': 'In Report, Comptroller Is Cautious on Casinos', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'valu