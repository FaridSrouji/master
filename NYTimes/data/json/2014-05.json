lace to hide.” ', 'print_section': 'C', 'print_page': '1', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/arts/BOOK/BOOK-articleLarge.jpg', 'height': 952, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/13/arts/BOOK/BOOK-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 952}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/arts/BOOK/BOOK-jumbo.jpg', 'height': 1024, 'width': 646, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/arts/BOOK/BOOK-superJumbo.jpg', 'height': 2048, 'width': 1292, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/arts/BOOK/BOOK-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/13/arts/BOOK/BOOK-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/13/arts/BOOK/BOOK-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Snowden’s Story, Behind the Scenes', 'kicker': None, 'content_kicker': None, 'print_headline': 'Snowden’s Story, Behind the Scenes', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Greenwald, Glenn', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Snowden, Edward J', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Books and Literature', 'rank': 4, 'major': 'N'}, {'name': 'organizations', 'value': 'National Security Ag