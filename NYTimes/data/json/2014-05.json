rint_section': 'A', 'print_page': '27', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'What Housing Recovery?', 'kicker': 'Op-Ed Contributor', 'content_kicker': None, 'print_headline': 'What Housing Recovery?', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Mortgages', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Dreier, Peter', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Banking and Financial Institutions', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Foreclosures', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Real Estate and Housing (Residential)', 'rank': 7, 'major': 'N'}, {'name': 'glocations', 'value': 'United States', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Hispanic-Americans', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-05-08T23:16:05+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'byline': {'original': 'By Peter Dreier', 'person': [{'firstname': 'Peter', 'middlename': None, 'lastname': 'Dreier', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/eee85810-dac7-5e49-a56f-ac61cb8e4a54', 'word_count': 887, 'uri': 'nyt://article/eee85810-dac7-5e49-a56f-ac61cb8e4a54'}, {'abstract': '“Farmland,” a documentary by James Moll, profiles six family farms and the young people who now run them.', 'web_url': 'https://www.nytimes.com/2014/05/09/movies/farmland-focuses-on-a-new-generation-of-farmers.html', 'snippet': '“Farmland,” a documentary by James Moll, profiles six family farms and the young people who now run them.', 'lea