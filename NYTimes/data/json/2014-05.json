'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/46d6b584-3cbf-572f-919b-c1b91604ab04', 'word_count': 1218, 'uri': 'nyt://article/46d6b584-3cbf-572f-919b-c1b91604ab04'}, {'abstract': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'web_url': 'https://www.nytimes.com/2014/05/26/business/treasury-auctions-for-the-week-of-may-26.html', 'snippet': 'The following tax-exempt fixed-income issues are scheduled for pricing this week.', 'lead_paragraph': 'The Treasury’s schedule of financing this week includes auctions of new three- and six-month bills on Tuesday, after the market closure on Memorial Day, as well as an additional auction of two-year notes on Tuesday. There will also be auctions of four-week bills, one-year bills, two-year floating rate notes and five-year notes on Wednesday, and seven-year notes on Thursday.', 'print_section': 'B', 'print_page': '2', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Treasury Auctions for the Week of May 26', 'kicker': None, 'content_kicker': None, 'print_headline': 'Treasury Auctions Set for This Week', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Credit and Debt', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Stocks and Bonds', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Income Tax', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Auctions', 'rank': 4, 'major': 'N'}], 'pub_date': '2014-05-26T01:07:00+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/36f3a079-2d39-5017-93fe-dcb6c272ded5', 'word_count': 279, 'uri': 'nyt://article/36f3a079-2d39-5017-93fe-dcb6c272ded5'}, {'abstract': 'Elliot O. Rodger was able to create a stash of weapons and ammunition, despite having struggled with mental health issues for years.', 'web_url': 'https://www.nytimes.com/2014/05/26/us/even-in-a-state-with-restrictive-laws-gunman-amassed-weapons-and-ammunition.html', 'snippet': 'Elliot O. Rodger was able to create a stash of weapons and ammunition, despite having struggled with mental health issues for years.', 'lead_paragraph': 'ISLA VISTA, Calif. — Even in California, with some of the strictest gun control laws in the country, Elliot O. Rodger was able to amass a stash of weapons and ammunition, despite having struggled with mental health issues for years.', 'print_section': 'A', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/GUNS/GUNS-articleLarge.jpg', 'height': 369, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/26/us/GUNS/GUNS-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 369}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/GUNS/GUNS-jumbo.jpg', 'height': 629, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/GUNS/GUNS-superJumbo.jpg', 'height': 1258, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/GUNS/GUNS-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/26/us/GUNS/GUNS-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/us/GUNS/GUNS-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Even in a State With Restrictive Laws, Gunman Amassed Weapons and Ammunition', 'kicker': None, 'content_kicker': None, 'print_headline': 'Even in a State With Restrictive Laws, Amassing Weapons and Ammunition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Rodger, Elliot O', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Murders and Attempted Murders', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Isla Vista, Calif, Massacre (2014)', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Gun Control', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'Isla Vista (Calif)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-26T01:09:00+0000', 'document_type': 'article', 'news_desk': 'National', 'section_name': 'U.S.', 'byline': {'original': 'By Jennifer Medina', 'person': [{'firstname': 'Jennifer', 'middlename': None, 'lastname': 'Medina', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/980b79e6-db85-5d46-b357-0e8bb91b136f', 'word_count': 1082, 'uri': 'nyt://article/980b79e6-db85-5d46-b357-0e8bb91b136f'}, {'abstract': 'The Police Department is running another counterterrorism program that singles out Muslims in a problematic way, this time to recruit them as informants.', 'web_url': 'https://www.nytimes.com/2014/05/26/opinion/muslims-and-the-nypd.html', 'snippet': 'The Police Department is running another counterterrorism program that singles out Muslims in a problematic way, this time to recruit them as informants.', 'lead_paragraph': 'New York City’s police commissioner, William Bratton, made the right decision last month when he said he would disband a unit used by his predecessor, Raymond Kelly, to spy on law-abiding Muslims as they worshiped or patronized businesses in their communities. Beyond proving useless for intelligence purposes, the Demographics Unit undermined the fight against terrorism by alienating Muslims who were understandably angry about being singled out, not for illegal conduct but because of their religious affiliation. ', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Muslims and the N.Y.P.D.', 'kicker': 'Editorial', 'content_kicker': None, 'print_headline': 'Muslims and the N.Y.P.D. ', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Informers', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Police Department (NYC)', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Muslims and Islam', 'rank': 3, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Editorials', 'rank': 5, 'major': 'N'}], 'pub_date': '2014-05-26T01:09:43+0000', 'document_type': 'article', 'news_desk': 'Editorial', 'section_name': 'Opinion', 'byline': {'original': 'By The Editorial Board', 'person': [], 'organization': 'The Editorial Board'}, 'type_of_material': 'Editorial', '_id': 'nyt://article/4afeb7aa-2994-5efd-a125-5c9462099814', 'word_count': 534, 'uri': 'nyt://article/4afeb7aa-2994-5efd-a125-5c9462099814'}, {'abstract': 'Two multiplexes in the Bronx were closed to be converted to retail space in the past year, leaving a borough of 1.4 million inhabitants with only two theaters.', 'web_url': 'https://www.nytimes.com/2014/05/26/nyregion/options-dwindle-for-bronx-residents-trying-to-escape-to-the-movies.html', 'snippet': 'Two multiplexes in the Bronx were closed to be converted to retail space in the past year, leaving a borough of 1.4 million inhabitants with only two theaters.', 'lead_paragraph': 'If the Bronx were a city, it would rank about sixth in population in the United States, its 1.4 million inhabitants making it near the same size as Philadelphia, Phoenix or San Antonio. But one glaring difference is especially relevant with the arrival of Memorial Day, the semiofficial start of the summer movie season: Film lovers there have to plan more and travel farther to see their favorite blockbuster.', 'print_section': 'A', 'print_page': '20', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/nyregion/26BRONXMOVIE1_COMBO/26BRONXMOVIE1_COMBO-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/26/nyregion/26BRONXMOVIE1_COMBO/26BRONXMOVIE1_COMBO-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/nyregion/26BRONXMOVIE1_COMBO/26BRONXMOVIE1_COMBO-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/nyregion/26BRONXMOVIE1_COMBO/26BRONXMOVIE1_COMBO-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/nyregion/26BRONXMOVIE1_COMBO/26BRONXMOVIE1_COMBO-thumbStandard-v2.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/26/nyregion/26BRONXMOVIE1_COMBO/26BRONXMOVIE1_COMBO-thumbStandard-v2.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/nyregion/26BRONXMOVIE1_COMBO/26BRONXMOVIE1_COMBO-thumbLarge-v2.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Options Dwindle for Bronx Residents Trying to Escape to the Movies', 'kicker': None, 'content_kicker': None, 'print_headline': 'Options Dwindle for Bronx Residents Trying to Escape to the Movies', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Real Estate (Commercial)', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Miller, Stuart', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'National Assn of Theater Owners', 'rank': 4, 'major': 'N'}, {'name': 'glocations', 'value': 'Bronx (NYC)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Theaters (Buildings)', 'rank': 6, 'major': 'N'}], 'pub_date': '2014-05-26T01:12:09+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Stuart Miller', 'person': [{'firstname': 'Stuart', 'middlename': None, 'lastname': 'Miller', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e2b6beec-8885-5c90-a576-b3a26370242c', 'word_count': 882, 'uri': 'nyt://article/e2b6beec-8885-5c90-a576-b3a26370242c'}, {'abstract': 'The three- to five-minute shorts — a team effort of Paul G. Allen and Morgan Spurlock, the director of “Super Size Me” — will explain concepts like markets, money, and debt and credit.', 'web_url': 'https://www.nytimes.com/2014/05/26/business/media/the-economy-explored-on-film.html', 'snippet': 'The three- to five-minute shorts — a team effort of Paul G. Allen and Morgan Spurlock, the director of “Super Size Me” — will explain concepts like markets, money, and debt and credit.', 'lead_paragraph': 'LOS ANGELES — A new film series from Morgan Spurlock and the Microsoft co-founder Paul G. Allen boils down to this: It’s the economy, stupid, and many Americans are stupid about the economy.', 'print_section': 'B', 'print_page': '4', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/business/spurlock/spurlock-articleLarge.jpg', 'height': 929, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/26/business/spurlock/spurlock-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 929}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/business/spurlock/spurlock-jumbo.jpg', 'height': 1024, 'width': 662, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/business/spurlock/spurlock-superJumbo.jpg', 'height': 2048, 'width': 1323, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/business/spurlock/spurlock-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/26/business/spurlock/spurlock-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/26/business/spurlock/spurlock-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'The Economy, Explored on Film', 'kicker': 'Media Decoder', 'content_kicker': None, 'print_headline': 'The Economy, Explored on Film', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Spurlock, Morgan', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'ALLEN, PAUL G', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Web-Original Programming', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'United States Economy', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Document