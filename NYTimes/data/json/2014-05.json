': 'N'}, {'name': 'subject', 'value': 'Infant Mortality', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Stillbirth', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Lancet, The (Journal)', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Save the Children', 'rank': 9, 'major': 'N'}, {'name': 'glocations', 'value': 'Bangalore (India)', 'rank': 10, 'major': 'N'}, {'name': 'glocations', 'value': 'India', 'rank': 11, 'major': 'N'}, {'name': 'glocations', 'value': 'Karnataka (India)', 'rank': 12, 'major': 'N'}], 'pub_date': '2014-05-20T15:40:27+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'World', 'subsection_name': 'Asia Pacific', 'byline': {'original': 'By Malavika Vyawahare', 'person': [{'firstname': 'Malavika', 'middlename': None, 'lastname': 'Vyawahare', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/b433671a-09bc-5505-83db-89603082b375', 'word_count': 997, 'uri': 'nyt://article/b433671a-09bc-5505-83db-89603082b375'}, {'abstract': 'Researchers found that smokers were more likely to quit if they used electronic cigarettes rather than therapies like nicotine patches or gum.', 'web_url': 'https://www.nytimes.com/2014/05/21/health/study-gives-e-cigarettes-edge-in-helping-smokers-quit.html', 'snippet': 'Researchers found that smokers were more likely to quit if they used electronic cigarettes rather than therapies like nicotine patches or gum.', 'lead_paragraph': 'A large study in England has found that smokers trying to quit were substantially more likely to succeed if they used electronic cigarettes than over-the-counter therapies such as nicotine patches or gum. These results offered encouraging but not definitive evidence in the contentious debate about the risks and benefits of these increasingly popular smoking devices.', 'print_section': 'A', 'print_page': '3', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'Study Gives E-Cigarettes Edge in Helping Smokers Quit', 'kicker': None, 'content_kicker': None, 'print_headline': 'Study Gives E-Cigarettes Edge in Helping Smokers Quit', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'E-Cigarettes', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Tavernise, Sabrina', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Research', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Nicotine', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Drugs (Pharmaceuticals)', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Smoking and Tobacco', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Medicine and Health', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'West, Robert', 'rank': 8, 'major': 'N'}, {'name': 'organizations', 'value': 'Addiction (Journal)', 'rank': 9, 'major': 'N'}], 'pub_date': '2014-05-20T15:56:40+0000', 'document_type': 'article', 'news_desk': 'Foreign', 'section_name': 'Health', 'byline': {'original': 'By Sabrina Tavernise', 'person': [{'firstname': 'Sabrina', 'middlename': None, 'lastname': 'Tavernise', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/a74ca8b1-0434-5fd0-bf39-c21ca53c6f30', 'word_count': 878, 'uri': 'nyt://article/a74ca8b1-0434-5fd0-bf39-c21ca53c6f30'}, {'abstract': 'The film used some 250 canines to tell its tale from the point of view of the mixed-breed Hagen.', 'web_url': 'https://artsbeat.blogs.nytimes.com/2014/05/20/cannes-film-festival-the-dogs-of-white-god/', 'snippet': 'The film used some 250 canines to tell its tale from the point of view of the mixed-breed Hagen.', 'lead_paragraph': 'Fur flies and blood flows in “White God,” a fierce and beautiful Hungarian parable about a girl, her dog, and the uprising that’s sparked after they are separated. Directed by Kornel Mundruczo, 39, the movie is being presented in Un Certain Regard, a section of the Cannes Film Festival for work that tends to be more adventurous than that in the main competition. Such is the case with “White God,” which goes from melodrama to hallucination after the girl’s father throws the dog into the streets. As she searches for the male dog, Hagen, he takes up with other strays (including a scene-nipping Jack Russell), escapes from dog-pound baddies and ends up doped up with sharpened teeth in a fighting pit. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/whitegod/whitegod-articleLarge.jpg', 'height': 389, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/05/20/arts/whitegod/whitegod-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 389}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/whitegod/whitegod-jumbo.jpg', 'height': 663, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/whitegod/whitegod-superJumbo.jpg', 'height': 1327, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/05/20/arts/whitegod/whitegod-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/05/20/arts/whitegod/whitegod-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'cred