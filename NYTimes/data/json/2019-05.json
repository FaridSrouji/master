print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12loose/merlin_154640418_a03128bf-23cc-4481-a3b8-0b2ee4bd3e52-articleLarge.jpg', 'height': 395, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/12/opinion/sunday/12loose/merlin_154640418_a03128bf-23cc-4481-a3b8-0b2ee4bd3e52-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 395}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12loose/merlin_154640418_a03128bf-23cc-4481-a3b8-0b2ee4bd3e52-jumbo.jpg', 'height': 675, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12loose/merlin_154640418_a03128bf-23cc-4481-a3b8-0b2ee4bd3e52-superJumbo.jpg', 'height': 1349, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12loose/12loose-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/12/opinion/sunday/12loose/12loose-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12loose/12loose-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Trying to Outsmart My Wife’s Morning Sickness', 'kicker': None, 'content_kicker': None, 'print_headline': 'Food That My Wife Won’t Hate', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Morning Sickness', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Pregnancy and Childbirth', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': "Mother's Day", 'rank': 3, 'major': 'N'}], 'pub_date': '2019-05-11T18:46:43+0000', 'document_type': 'article', 'news_desk': 'OpEd', 'section_name': 'Opinion', 'subsection_name': 'Sunday Review', 'byline': {'original': 'By Brad Austin', 'person': [{'firstname': 'Brad', 'middlename': None, 'lastname': 'Austin', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/a2d86530-16e5-553f-8ec5-1e809b4996c3', 'word_count': 602, 'uri': 'nyt://article/a2d86530-16e5-553f-8ec5-1e809b4996c3'}, {'abstract': 'That style of motivation could help in the classroom, too.', 'web_url': 'https://www.nytimes.com/2019/05/11/opinion/sunday/math-teaching-football.html', 'snippet': 'That style of motivation could help in the classroom, too.', 'lead_paragraph': 'Growing up, I thought math class was something to be endured, not enjoyed. I disliked memorizing formulas and taking tests, all for the dull goal of getting a good grade. In elementary school, my mind wandered so much during class that I sometimes didn’t respond when I was called on, and I resisted using the rote techniques we were taught to use to solve problems. One of my teachers told my mother that I was “slow” and should repeat a grade. ', 'print_section': 'SR', 'print_page': '10', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12urschel/merlin_154640388_5b3df20f-1471-4761-8cbc-64183b68689c-articleLarge.jpg', 'height': 600, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/12/opinion/sunday/12urschel/merlin_154640388_5b3df20f-1471-4761-8cbc-64183b68689c-articleLarge.jpg', 'xlargewidth': 600, 'xla