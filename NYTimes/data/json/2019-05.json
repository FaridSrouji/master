lture', 'section_name': 'Food', 'byline': {'original': 'By Tejal Rao', 'person': [{'firstname': 'Tejal', 'middlename': None, 'lastname': 'Rao', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/512b369f-50eb-54b9-ae73-43931e32290b', 'word_count': 918, 'uri': 'nyt://article/512b369f-50eb-54b9-ae73-43931e32290b'}, {'abstract': 'Regulators denied an application for a $1 billion natural gas pipeline that environmentalists said would set back the fight against climate change.', 'web_url': 'https://www.nytimes.com/2019/05/15/nyregion/williams-pipeline-gas-energy.html', 'snippet': 'Regulators denied an application for a $1 billion natural gas pipeline that environmentalists said would set back the fight against climate change.', 'lead_paragraph': 'In a major victory for environmental activists, New York regulators on Wednesday rejected the construction of a heavily disputed, nearly $1 billion natural gas pipeline, even as business leaders and energy companies warned that the decision could devastate the state’s economy and bring a gas moratorium to New York City and Long Island.', 'print_section': 'A', 'print_page': '18', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/nyregion/16pipeline1-print/14pipeline1-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/16/nyregion/16pipeline1-print/14pipeline1-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/nyregion/16pipeline1-print/14pipeline1-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type':