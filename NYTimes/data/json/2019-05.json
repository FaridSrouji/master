eadline': {'main': 'Four Years After Beau Biden’s Death, His Father Bonds With Voters in Pain', 'kicker': None, 'content_kicker': None, 'print_headline': 'Biden’s Personal History of Loss and Grief Connects With Voters in Pain', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'persons', 'value': 'Biden, Joseph R Jr', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Biden, Joseph R III', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Voting and Voters', 'rank': 4, 'major': 'N'}, {'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 5, 'major': 'N'}, {'name': 'subject', 'value': 'Primaries and Caucuses', 'rank': 6, 'major': 'N'}, {'name': 'subject', 'value': 'Death and Dying', 'rank': 7, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 8, 'major': 'N'}], 'pub_date': '2019-05-30T09:00:09+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': 'By Katie Glueck', 'person': [{'firstname': 'Katie', 'middlename': None, 'lastname': 'Glueck', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/216c2f53-95bb-5537-8b97-8510d6d1147a', 'word_count': 1416, 'uri': 'nyt://article/216c2f53-95bb-5537-8b97-8510d6d1147a'}, {'abstract': 'I couldn’t understand why I was able to move on from my traumatic experiences until I joined a PTSD study.', 'web_url': 'https://www.nytimes.com/2019/05/30/magazine/ptsd-combat-veterans.html', 'snippet': 'I couldn’t understand why I was able to move on from my traumatic experiences until I joined a PTSD study.', 'lead_paragraph': 'A few years ago, my husband, Chris, who survived four deployments to Iraq and Afghanistan, was killed by an avalanche in Colorado. I am an Army veteran who was deployed to combat zones twice, in 2005 and 2008, without any serious lingering psychological ramifications. But I thought my husband’s death, that New Year’s Eve day, would be the final trigger for post-traumatic stress disorder; it would be what sent me over the edge.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/30/magazine/30atwar-ptsdstudy_2/bf99f1ac7bf64d6389d403e2ee468ea6-articleLarge.jpg', 'height': 450, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/30/magazine/30atwar-ptsdstudy_2/bf99f1ac7bf64d6389d403e2ee468ea6-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 450}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/30/magazine/30atwar-ptsdstudy_2/bf99f1ac7bf64d6389d403e2ee468ea6-jumbo.jpg', 'height': 768, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/30/magazine/30atwar-ptsdstudy_2/bf99f1ac7bf64d6389d403e2ee468ea6-superJumbo.jpg', 'height': 1524, 'width': 2032, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/30/magazine/30atwar-ptsdstudy_2/30atwar-ptsdstudy_2-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/30/magazine/30atwar-ptsdstudy_2/30atwar-ptsdstudy_2-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/30/magazine/30atwar-ptsdstudy_2/30atwar-ptsdstudy_2-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'I’