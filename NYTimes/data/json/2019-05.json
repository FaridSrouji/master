: 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/08/t-magazine/fashion/detacher-slide-X96V/detacher-slide-X96V-articleLarge.jpg', 'height': 900, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/08/t-magazine/fashion/detacher-slide-X96V/detacher-slide-X96V-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 900}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/08/t-magazine/fashion/detacher-slide-X96V/detacher-slide-X96V-jumbo.jpg', 'height': 1024, 'width': 683, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/08/t-magazine/fashion/detacher-slide-X96V/detacher-slide-X96V-superJumbo.jpg', 'height': 2048, 'width': 1366, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/08/t-magazine/fashion/detacher-slide-X96V/detacher-slide-X96V-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/08/t-magazine/fashion/detacher-slide-X96V/detacher-slide-X96V-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/08/t-magazine/fashion/detacher-slide-X96V/detacher-slide-X96V-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Bidding Farewell to a Beloved New York Clothing Line', 'kicker': None, 'content_kicker': None, 'print_headline': 'Farewell; Her Version of the 1990s Comes to a Close', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': '