le': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'briefing', '_id': 'nyt://article/13082f1f-5bae-5ace-a731-1ffb68311349', 'word_count': 1690, 'uri': 'nyt://article/13082f1f-5bae-5ace-a731-1ffb68311349'}, {'abstract': 'The administration is seeking to undermine or discard research showing the most dire risks of inaction on climate change.', 'web_url': 'https://www.nytimes.com/2019/05/28/us/politics/trump-climate-change.html', 'snippet': 'The administration is seeking to undermine or discard research showing the most dire risks of inaction on climate change.', 'lead_paragraph': 'Good Tuesday morning, and welcome back after the long weekend. Here are some of the stories making news in Washington and politics today.', 'source': 'The New York Times', 'multimedia': [], 'headline': {'main': 'On Politics: Trump Hardens Attack on Climate Science', 'kicker': None, 'content_kicker': None, 'print_headline': 'Morning Edition', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'United States Politics and Government', 'rank': 1, 'major': 'N'}], 'pub_date': '2019-05-28T04:37:18+0000', 'document_type': 'article', 'news_desk': 'Politics', 'section_name': 'U.S.', 'subsection_name': 'Politics', 'byline': {'original': '', 'person': [], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/54d7f4e9-fae2-5f16-be85-c5b3cdfd1dae', 'word_count': 458, 'uri': 'nyt://article/54d7f4e9-fae2-5f16-be85-c5b3cdfd1dae'}, {'abstract': 'A documentary about Beto O’Rourke’s Senate campaign debuts on HBO. And a new musical competition airs on NBC.', 'web_url': 'https://www.nytimes.com/2019/05/28/arts/television/whats-on-tv-tuesday-running-with-beto-songland.html', 'snippet': 'A documentary about Beto O’Rourke’s Senate campaign debuts on HBO. And a new musical competition airs on NBC.', 'lead_paragraph': 'RUNNING WITH BETO (2019) 8 p.m. on HBO; stream on HBO platforms. As the United States looks ahead toward the 2020 presidential election, this new documentary looks back at 2018, when the Texas Democrat Beto O’Rourke burst onto the political scene to challenge the Republican incumbent Ted Cruz for his seat in the Senate. (Cruz came out on top in a narrow victory.) Directed by David Modigliani, this fly-on-the-wall film follows O’Rourke for a year as he leads a grass-roots campaign, visits all 254 counties in the state and welcomes voters into his life with quirky social media strategies. The Times critic James Poniewozik wrote that the documentary is “an example of the very of-the-moment challenge of running for office in the Trump era. To pitch yourself as a president, you must first prove yourself as a show.”', 'print_section': 'C', 'print_page': '7', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/28/arts/28tvcol-running/d368d8e8716f43b08058e50c063500ed-articleLarge.jpg', 'height': 476, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/28/arts/28tvcol-running/d368d8e8716f43b08058e50c063500ed-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 476}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/28/arts/28tvcol-running/d368d8e8716f43b08058e50c063500ed-jumbo.jpg', 'height': 813, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/28/arts/28tvcol-running/d368d8e8716f43b08058e50c063500ed-superJumbo.jpg', 'height': 1625, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/28/arts/28tvcol-running/28tvcol-running-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/28/arts/28tvcol-running/28tvcol-running-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/28/arts/28tvcol-running/28tvcol-running-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'What’s on TV Tuesday: ‘Running With Beto’ and ‘Songland’', 'kicker': None, 'content_kicker': None, 'print_headline': 'What’s On Tuesday', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Television', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Movies', 'rank': 2, 'major': 'N'}], 'pub_date': '2019-05-28T05:00:06+0000', 'document_type': 'article', 'news_desk': 'Culture', 'section_name': 'Arts', 'subsection_name': 'Television', 'byline': {'original': 'By Sara Aridi', 'person': [{'firstname': 'Sara', 'middlename': None, 'lastname': 'Aridi', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/4d614738-4ed0-5b5b-bc0c-89c1856bbfad', 'word_count': 476, 'uri': 'nyt://article/4d614738-4ed0-5b5b-bc0c-89c1856bbfad'}, {'abstract': 'Property scams start from the top here, and cut across political divides.', 'web_url': 'https://www.nytimes.com/2019/05/28/opinion/pakistan-property-land-boom.html', 'snippet': 'Property scams start from the top here, and cut across political divides.', 'lead_paragraph': 'KARACHI, Pakistan — Pakistan is in the middle of an unusual property boom. Developers grab large tracts of land, stealing them outright or occupying them, advertise mega development projects and then buy off regulators with the money they raise selling some of the land they dubiously claim. Poor people who have lived in their homes for generations are served eviction notices and v