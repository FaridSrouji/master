n': [{'firstname': 'Taffy', 'middlename': None, 'lastname': 'Brodesser-Akner', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/e5e09b65-a154-5e70-bc83-a28d9bb7efd0', 'word_count': 4224, 'uri': 'nyt://article/e5e09b65-a154-5e70-bc83-a28d9bb7efd0'}, {'abstract': 'John Singleton put black lives on the big screen.', 'web_url': 'https://www.nytimes.com/2019/05/14/style/john-singleton-black-film-movies.html', 'snippet': 'John Singleton put black lives on the big screen.', 'lead_paragraph': 'For those of us who grew up black in the 1980s, going to the movies meant picking a character to identify with and pretending that person was black. It was a great era for film: There was “The Breakfast Club” and “Ferris Bueller’s Day Off,” “Back to the Future” and “Top Gun.” But black people were almost entirely invisible in those worlds. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/14/fashion/14genx-blackfilms-X-v2/e3ca463882cf4e5faa4ce6b3ee961c67-articleLarge.jpg', 'height': 400, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/14/fashion/14genx-blackfilms-X-v2/e3ca463882cf4e5faa4ce6b3ee961c67-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 400}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/14/fashion/14genx-blackfilms-X-v2/e3ca463882cf4e5faa4ce6b3ee961c67-jumbo.jpg', 'height': 683, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/14/fashion/14genx-blackfilms-X-v2/e3ca463882cf4e5faa4ce6b3ee961c67-superJumbo.jpg', 'height': 1365, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank