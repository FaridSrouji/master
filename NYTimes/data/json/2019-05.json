13_ef57be05-4adc-44c2-97fb-0acb311697f9-articleLarge.jpg', 'height': 809, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/06/23/books/review/23Mandel/merlin_156241413_ef57be05-4adc-44c2-97fb-0acb311697f9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 809}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/23/books/review/23Mandel/merlin_156241413_ef57be05-4adc-44c2-97fb-0acb311697f9-jumbo.jpg', 'height': 1024, 'width': 760, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/23/books/review/23Mandel/merlin_156241413_ef57be05-4adc-44c2-97fb-0acb311697f9-superJumbo.jpg', 'height': 2048, 'width': 1519, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/23/books/review/23Mandel/23Mandel-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/06/23/books/review/23Mandel/23Mandel-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/06/23/books/review/23Mandel/23Mandel-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Love at First Sight and Other Disasters: Stories From Karen Russell', 'kicker': 'Fiction', 'content_kicker': None, 'print_headline': 'Love at First Sight and Other Disasters', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Books and Literature', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Russell, Karen (1981- )', 'rank': 2, 'major': 'N'}, {'name': 'creative_works', 'value': 'Orange World (Book)', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-05-17T09:00:01+0000', 'document_type': 'article', 'news_desk': 'BookReview', 'section_name': 'Books', 'subsection_name': 'Book Review', 'byline': {'original': 'By Emily St. John Mandel', 'person': [{'firstname': 'Emily', 'middlename': None, 'lastname': 'St', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Review', '_id': 'nyt://article/d1820d0d-6992-5ab7-8fa8-6f97606816f7', 'word_count': 1172, 'uri': 'nyt://article/d1820d0d-6992-5ab7-8fa8-6f97606816f7'}, {'abstract': 'The loss punches you in the face, sneaks away but peeps around a corner to stare at you blankly, punches you in the face again, vacuums your emotions until you’re numb, and repeats.', 'web_url': 'https://www.nytimes.com/2019/05/17/well/family/welcome-to-the-freak-show-becoming-an-orphan-in-my-20s.html', 'snippet': 'The loss punches you in the face, sneaks away but peeps around a corner to stare at you blankly, punches you in the face again, vacuums your emotions until you’re numb, and repeats.', 'lead_paragraph': '“And then you get turned into ashes!” the little girl howled, incredulous. Soon the other 6-year-olds were laughing hysterically, too. I looked around the circular table as we cut shapes from colorful paper and drew with glitter markers. These children had all lost loved ones: a grandparent, a sibling, mostly a parent. Twice a month we made art and talked around grief. My role was to facilitate their conversation, let them lead. So when they started joking about cremation, I laughed, too. It felt good, actually. And, I mean, cremation was kind of hilarious.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/15/science/00TIESORPHAN/merlin_154872810_715b4ea7-e481-4a8b-9e11-95fc5386390b-articleLarge.jpg', 'height': 424, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/15/science/00TIESORPHAN/merlin_154872810_715b4ea7-e481-4a8b-9e11-95fc5386390b-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 424}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/15/science/00TIESORPHAN/merlin_154872810_715b4ea7-e481-4a8b-9e11-95fc5386390b-jumbo.jpg', 'height': 724, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/15/science/00TIESORPHAN/merlin_154872810_715b4ea7-e481-4a8b-9e11-95fc5386390b-superJumbo.jpg', 'height': 1448, 'width': 2048, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/15/science/00TIESORPHAN/merlin_154872810_715b4ea7-e481-4a8b-9e11-95fc5386390b-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/15/science/00TIESORPHAN/merlin_154872810_715b4ea7-e481-4a8b-9e11-95fc5386390b-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/15/science/00TIESORPHAN/merlin_154872810_715b4ea7-e481-4a8b-9e11-95fc5386390b-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Welcome to the Freak Show: Becoming an Orphan in My 20s', 'kicker': 'Ties', 'content_kicker': None, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Grief (Emotion)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Orphans and Orphanages', 'rank': 2, 'major': 'N'}, {'name': 'subject', 'value': 'Parenting', 'rank': 3, 'major': 'N'}, {'name':