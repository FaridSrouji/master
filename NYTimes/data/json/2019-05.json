': None}, 'keywords': [{'name': 'subject', 'value': 'Stonewall Riots (1969)', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'Social Media', 'rank': 2, 'major': 'N'}, {'name': 'persons', 'value': 'Johnson, Marsha P (1945-92)', 'rank': 3, 'major': 'N'}], 'pub_date': '2019-05-31T09:00:04+0000', 'document_type': 'article', 'news_desk': 'SpecialSections', 'section_name': 'U.S.', 'byline': {'original': "By Shane O'Neill", 'person': [{'firstname': 'Shane', 'middlename': None, 'lastname': "O'Neill", 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/0f3ef313-0d80-58b8-8d7c-f836161d8386', 'word_count': 851, 'uri': 'nyt://article/0f3ef313-0d80-58b8-8d7c-f836161d8386'}, {'abstract': 'People who use binders report symptoms like back and chest pain, overheating and shortness of breath.', 'web_url': 'https://www.nytimes.com/2019/05/31/well/transgender-teens-binders.html', 'snippet': 'People who use binders report symptoms like back and chest pain, overheating and shortness of breath.', 'lead_paragraph': 'It used to be that when a 13-year-old wanted a binder for school, it meant a trip to Staples. For today’s tweens and teens who identify as gender-nonconforming or transgender, shopping for a binder may mean a compression undergarment worn to flatten breasts. ', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/well/00binders1/5411fdb6d1184f1cb56c0fcacdb62399-articleLarge.png', 'height': 398, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/16/well/00binders1/5411fdb6d1184f1cb56c0fcacdb62399-articleLarge.png', 'xlargewidth': 600, 'xlargeheight': 398}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/16/well/00binders1/5411fdb6d1184f1cb56c0fcacdb62399-jum