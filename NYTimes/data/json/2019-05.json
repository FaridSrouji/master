eled on the hippie emporiums of yore.', 'print_section': 'F', 'print_page': '12', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/09/style/09sp-cannabis1-promo/09sp-cannabis1-promo-articleLarge-v4.jpg', 'height': 847, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/09/style/09sp-cannabis1-promo/09sp-cannabis1-promo-articleLarge-v4.jpg', 'xlargewidth': 600, 'xlargeheight': 847}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/09/style/09sp-cannabis1-promo/09sp-cannabis1-promo-jumbo-v4.jpg', 'height': 1024, 'width': 726, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/09/style/09sp-cannabis1-promo/09sp-cannabis1-promo-superJumbo-v4.jpg', 'height': 2048, 'width': 1451, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/09/style/09sp-cannabis1-promo/09sp-cannabis1-promo-thumbStandard-v4.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/09/style/09sp-cannabis1-promo/09sp-cannabis1-promo-thumbStandard-v4.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/09/style/09sp-cannabis1-promo/09sp-cannabis1-promo-thumbLarge-v4.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'Design’s New Leaf', 'kicker': None, 'content_kicker': None, 'print_headline': 'Design’s New Leaf', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Marijuana', 'ra