al': 'By John Urschel', 'person': [{'firstname': 'John', 'middlename': None, 'lastname': 'Urschel', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'Op-Ed', '_id': 'nyt://article/b0129b5f-60d4-51fe-b845-eca278125a5c', 'word_count': 988, 'uri': 'nyt://article/b0129b5f-60d4-51fe-b845-eca278125a5c'}, {'abstract': 'An Irish-American story about how we choose the history we hand down.', 'web_url': 'https://www.nytimes.com/2019/05/11/opinion/sunday/ireland-america-tradition.html', 'snippet': 'An Irish-American story about how we choose the history we hand down.', 'lead_paragraph': 'There are different ways to read the resonant phrase “the invention of tradition,” coined by the great Marxist historian Eric Hobsbawm many years ago. One reading is debunking, skeptical, emphasizing the artificiality of all traditions, the extent to which all cultural narratives flatten or caricature the past.', 'print_section': 'SR', 'print_page': '13', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12Douthat/67b41c0d4004481c9975b891126066f9-articleLarge.jpg', 'height': 530, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/12/opinion/sunday/12Douthat/67b41c0d4004481c9975b891126066f9-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 530}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12Douthat/67b41c0d4004481c9975b891126066f9-jumbo.jpg', 'height': 905, 'width': 1024, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/12/opinion/sunday/12Douthat/67b41c0d4004481c9975b891126066f9-superJumbo.jpg', 'height': 1809, 'width': 2048, 'subType': 'superJumb