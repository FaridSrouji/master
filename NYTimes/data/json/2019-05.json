'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Presidential Election of 2020', 'rank': 1, 'major': 'N'}, {'name': 'subject', 'value': 'News and News Media', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Fox News Channel', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Democratic Party', 'rank': 4, 'major': 'N'}, {'name': 'persons', 'value': 'Buttigieg, Pete (1982- )', 'rank': 5, 'major': 'N'}, {'name': 'persons', 'value': 'Wallace, Chris (1947- )', 'rank': 6, 'major': 'N'}, {'name': 'creative_works', 'value': 'Fox & Friends (TV Program)', 'rank': 7, 'major': 'N'}, {'name': 'persons', 'value': 'Trump, Donald J', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Television', 'rank': 9, 'major': 'N'}], 'pub_date': '2019-05-20T22:57:36+0000', 'document_type': 'article', 'news_desk': 'Business', 'section_name': 'Business Day', 'subsection_name': 'Media', 'byline': {'original': 'By Michael M. Grynbaum', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/441c3d2a-47ce-524d-9ca0-89999cd3e441', 'word_count': 1065, 'uri': 'nyt://article/441c3d2a-47ce-524d-9ca0-89999cd3e441'}, {'abstract': 'He’s not just on a winning streak. He has utterly changed how the game is played.', 'web_url': 'https://www.nytimes.com/2019/05/20/opinion/james-holzhauer-jeopardy.html', 'snippet': 'He’s not just on a winning streak. He has utterly changed how the game is played.', 'lead_paragraph': 'When I call my parents in New York, I know not to bother them between 7 and 7:30 p.m. That’s sacrosanct “Jeopardy!” time, and for decades, my mother has kept a weeknight appointment with Alex Trebek.', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/20/opinion/20Price/me