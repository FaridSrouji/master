ne, 'print_headline': '', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'UEFA Champions League (Soccer)', 'rank': 1, 'major': 'N'}, {'name': 'organizations', 'value': 'Liverpool (Soccer Team)', 'rank': 2, 'major': 'N'}, {'name': 'organizations', 'value': 'Tottenham Hotspur (Soccer Team)', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'Real Madrid (Soccer Team)', 'rank': 4, 'major': 'N'}], 'pub_date': '2019-05-09T16:43:36+0000', 'document_type': 'article', 'news_desk': 'Sports', 'section_name': 'Sports', 'byline': {'original': 'By Victor Mather', 'person': [{'firstname': 'Victor', 'middlename': None, 'lastname': 'Mather', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/aea4312c-0df4-52f2-a588-38aedeff3a09', 'word_count': 695, 'uri': 'nyt://article/aea4312c-0df4-52f2-a588-38aedeff3a09'}, {'abstract': 'Working out of her Zurich studio, Sonnhild Kestler makes clothing and objects inspired by travel, folklore and even her own history.', 'web_url': 'https://www.nytimes.com/2019/05/09/t-magazine/sonnhild-kestler.html', 'snippet': 'Working out of her Zurich studio, Sonnhild Kestler makes clothing and objects inspired by travel, folklore and even her own history.', 'lead_paragraph': 'SIX DAYS A WEEK (unless it’s snowing), the Swiss textile designer Sonnhild Kestler rides her black Ciao moped west across Zurich, from the wooded residential neighborhood of Zurichberg — where she lives in a green-shuttered 1914 apartment building with her partner, Arthur David, a visual artist — toward the Limmat River. She has navigated the city this way for 35 years, a clutch of reusable striped shopping bags fanning out from her handlebars or a large roll of fabric balanced precariously across her thighs. Invariably, she’s making her way either to her printing studio, on the second floor of a former weaving factory that backs onto the river in the industrial area of Höngg, or to Thema Selection, an influential fashion boutique in the city’s Old Town where she maintains a vibrant shop-within-a-shop stocked with her wares: handcrafted dresses, pillows, scarves and home goods screen-printed with gleeful, kaleidoscopic patterns.', 'print_section': 'M2', 'print_page': '49', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/07/t-magazine/07tmag-kestler-slide-AZD0/07tmag-kestler-slide-AZD0-articleLarge.jpg', 'height': 801, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2019/05/07/t-magazine/07tmag-kestler-slide-AZD0/07tmag-kestler-slide-AZD0-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 801}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/07/t-magazine/07tmag-kestler-slide-AZD0/07tmag-kestler-slide-AZD0-jumbo.jpg', 'height': 1024, 'width': 768, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/07/t-magazine/07tmag-kestler-slide-AZD0/07tmag-kestler-slide-AZD0-superJumbo.jpg', 'height': 2048, 'width': 1535, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/07/t-magazine/07tmag-kestler-slide-AZD0/07tmag-kestler-slide-AZD0-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2019/05/07/t-magazine/07tmag-kestler-slide-AZD0/07tmag-kestler-slide-AZD0-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2019/05/07/t-magazine/07tmag-kestler-slide-AZD0/07tmag-kestl