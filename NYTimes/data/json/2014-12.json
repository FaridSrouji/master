': 'persons', 'value': 'Garner, Eric', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Bill', 'rank': 3, 'major': 'N'}, {'name': 'subject', 'value': 'Police Brutality, Misconduct and Shootings', 'rank': 5, 'major': 'N'}, {'name': 'glocations', 'value': 'New York City', 'rank': 6, 'major': 'N'}, {'name': 'persons', 'value': 'de Blasio, Dante', 'rank': 7, 'major': 'N'}, {'name': 'subject', 'value': 'Minorities', 'rank': 8, 'major': 'N'}, {'name': 'subject', 'value': 'Blacks', 'rank': 9, 'major': 'N'}, {'name': 'subject', 'value': 'Black People', 'rank': 10, 'major': 'N'}, {'name': 'subject', 'value': 'Race and Ethnicity', 'rank': 11, 'major': 'N'}], 'pub_date': '2014-12-04T03:11:08+0000', 'document_type': 'article', 'news_desk': 'Metro', 'section_name': 'New York', 'byline': {'original': 'By Michael M. Grynbaum and Nikita Stewart', 'person': [{'firstname': 'Michael', 'middlename': None, 'lastname': '', 'qualifier': None, 'title': None, 'role': 'reported', 'organization': '', 'rank': 1}], 'organization': None}, 'type_of_material': 'News', '_id': 'nyt://article/7925a2a0-c042-557e-abf2-51e7dd07b973', 'word_count': 705, 'uri': 'nyt://article/7925a2a0-c042-557e-abf2-51e7dd07b973'}, {'abstract': 'Harvey admitted he had been “stubborn” for pushing the front office to allow him to return by the end of last season, and seemed receptive to the idea of an innings limit in 2015.', 'web_url': 'https://www.nytimes.com/2014/12/04/sports/baseball/mlb-roundup.html', 'snippet': 'Harvey admitted he had been “stubborn” for pushing the front office to allow him to return by the end of last season, and seemed receptive to the idea of an innings limit in 2015.', 'lead_paragraph': 'In what has become an almost biweekly occurrence since the fall of 2013, Matt Harvey updated reporters Wednesday about the progress of his recovery from Tommy John surgery and his expectations for a successful comeback in 2015. ', 'print_section': 'B', 'print_page': '16', 'source': 'The New York Times', 'multimedia': [{'rank': 0, 'subtype': 'xlarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/sports/CITY-BASE/CITY-BASE-articleLarge.jpg', 'height': 638, 'width': 600, 'subType': 'xlarge', 'crop_name': 'articleLarge', 'legacy': {'xlarge': 'images/2014/12/04/sports/CITY-BASE/CITY-BASE-articleLarge.jpg', 'xlargewidth': 600, 'xlargeheight': 638}}, {'rank': 0, 'subtype': 'jumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/sports/CITY-BASE/CITY-BASE-jumbo.jpg', 'height': 1024, 'width': 963, 'subType': 'jumbo', 'crop_name': 'jumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'superJumbo', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/sports/CITY-BASE/CITY-BASE-superJumbo.jpg', 'height': 2048, 'width': 1926, 'subType': 'superJumbo', 'crop_name': 'superJumbo', 'legacy': {}}, {'rank': 0, 'subtype': 'thumbnail', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/sports/CITY-BASE/CITY-BASE-thumbStandard.jpg', 'height': 75, 'width': 75, 'subType': 'thumbnail', 'crop_name': 'thumbStandard', 'legacy': {'thumbnail': 'images/2014/12/04/sports/CITY-BASE/CITY-BASE-thumbStandard.jpg', 'thumbnailwidth': 75, 'thumbnailheight': 75}}, {'rank': 0, 'subtype': 'thumbLarge', 'caption': None, 'credit': None, 'type': 'image', 'url': 'images/2014/12/04/sports/CITY-BASE/CITY-BASE-thumbLarge.jpg', 'height': 150, 'width': 150, 'subType': 'thumbLarge', 'crop_name': 'thumbLarge', 'legacy': {}}], 'headline': {'main': 'After a Season of Pushing to Return, Mets’ Matt Harvey Details a Patient Plan for 2015', 'kicker': 'Roundup', 'content_kicker': None, 'print_headline': 'After a Season of Pushing to Return, Harvey Details a Patient Plan for 2015', 'name': None, 'seo': None, 'sub': None}, 'keywords': [{'name': 'subject', 'value': 'Baseball', 'rank': 1, 'major': 'N'}, {'name': 'persons', 'value': 'Harvey, Matt', 'rank': 3, 'major': 'N'}, {'name': 'organizations', 'value': 'New York Met